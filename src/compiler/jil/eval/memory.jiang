#doc(module)
    一次 JIL 求值的逻辑存储，地址不是宿主指针。帧存储与显式分配的存储分别结束生命周期。
    聚合字段保持稳定身份，复制不复制引用目标；结果导出时才固化为不可变编译期值。
#end

alias token = import "../../syntax/token.jiang";
alias compiler_store = import "../../store.jiang";
alias source = import "../../source.jiang";
alias qid = import "../../id.jiang";
alias value = import "../../sema/comptime/value.jiang";
alias sem = import "../../sema/model.jiang";
alias types = import "../../sema/type.jiang";
alias database = import "../../db.jiang";
alias layout = import "../../layout.jiang";
alias list = import "../../support/list.jiang";
alias map = import "../../support/map.jiang";
alias integer = import "./integer.jiang";
alias jil = import "../model.jiang";

public enum BorrowContext { function, method, nominal, }

public enum CellData: Copyable {
    uninitialized,
    inactive,
    scalar(value.ComptimeValueData),
    aggregate(Int start, Int count),
    reference(Int target),
    element_reference(Int storage, Int first, Int index),
    null_pointer,
    function(jil.MonoItem),
    reflected_module(qid.ModuleId),
    reflected_package(qid.PackageId),
    reflected_recursive_declarations(qid.ModuleId),
    reflected_definition(qid.DefId definition, qid.TypeId? owner_type),
    reflected_declarations(qid.DefId? owner, Bool public_only, Bool generic_parameters, qid.TypeId? owner_type),
    reflected_type(qid.TypeId),
    reflected_domain(types.DomainEffect),
    reflected_contract(types.LifetimeContract, Bool receiver),
    reflected_nominal_contract(qid.DefId),
    reflected_flow(types.LifetimeFlow, BorrowContext),
    reflected_borrow_path(types.LifetimePath, BorrowContext),
    reflected_constraint(qid.DefId owner, Int index, qid.TypeId? owner_type),
    reflected_pattern(sem.NodeId, qid.TypeId? owner_type),
    reflected_life_binding(qid.DefId owner, Int index),
    reflected_lifetime_expression(sem.LifetimeExpressionData),
    reflected_lifetime_path(sem.LifetimeName),
    reflected_regions(qid.DefId owner, qid.TypeId? owner_type, Int target),
    reflected_region(qid.DefId owner, Int index, qid.TypeId? owner_type),
    reflected_constant(value.ComptimeValue, qid.DefId? binding),
    reflected_parameter(qid.DefId function, Int index, qid.TypeId? owner_type),
    reflected_import(qid.ModuleId source, Int index),
    reflected_export(qid.ModuleId module, Int index),
    resource(source.SourceId),
}

public struct Cell: Copyable {
    public qid.TypeId type_id;
    public CellData data;
    public Bool alive;
    public Bool read_only;
}

#doc 分配来源仅用于执行器统计，不影响值、地址或语义事实身份。
public enum AllocationKind { temporary, frame, local, copy, aggregate, heap, reflection, }

#doc 槽位持有值及所属执行作用域；代次只用于地址有效性，不参与语义类型身份。
struct Slot: Copyable {
    public Cell cell!;
    public Int generation;
    public AllocationKind kind;
    public Int scope!;
    public Int previous!;
    public Int next!;
}

public struct Memory: Movable {
    list.ArrayList<Slot> cells!;
    list.ArrayList<Int> scopes!;
    Int free_hint! = 0;
    Int generation! = 0;
    // true 表示动态元素序列，false 表示单值分配；不复制元素 TypeId。
    map.WyHashMap<Int, Bool> heap_roots!;
    map.WyHashMap<qid.SymbolId, Int> strings!;
    map.WyHashMap<value.ComptimeValue, Int> constants!;
    public Int limit;
    public Int[7] allocations!;
    public Int[7] live_by_kind!;
    public Int[7] peak_by_kind!;
    Int frame_bytes! = 0;
    public Int live_cells! = 0;
    public Int peak_live_cells! = 0;
    public Bool allocation_failed!;

    public init(self, Int limit = 67108864) {
        assert(limit >= 8 * Int$.size());
        self.cells = list.ArrayList<Slot>();
        self.scopes = list.ArrayList<Int>();
        self.scopes.add(-1);
        self.heap_roots = map.WyHashMap<Int, Bool>();
        self.strings = map.WyHashMap<qid.SymbolId, Int>();
        self.constants = map.WyHashMap<value.ComptimeValue, Int>();
        self.limit = limit;
        self.allocations = [0, 0, 0, 0, 0, 0, 0];
        self.live_by_kind = [0, 0, 0, 0, 0, 0, 0];
        self.peak_by_kind = [0, 0, 0, 0, 0, 0, 0];
        self.allocation_failed = false;
    }

    #doc 地址低 32 位是槽位，高 31 位是分配代次；连续字段共享代次，保留 JIL 的字段偏移。
    public Cell get(self, Int address) {
        Slot& slot = self.cells.ref_at(address & 4294967295);
        if (slot.generation == (address >> 32) && slot.scope >= 0) { return slot.cell; }
        return Cell(type_id = slot.cell.type_id, data = .uninitialized, alive = false, read_only = false);
    }

    public Int current_scope(self) { return self.scopes.len() - 1; }

    public Int? begin_scope(Self&! self) {
        if (self.scopes.len() == self.scopes.cap()
            && self.retained_bytes() + self.scopes.cap() * Int$.size() > self.limit) {
            self.allocation_failed = true;
            return null;
        }
        self.scopes.add(-1);
        return self.current_scope();
    }

    #doc 作用域链只包含当前存活的槽位；循环复用不会累积历史地址或释放记录。
    public Void end_scope(Self&! self) {
        Int scope = self.current_scope();
        assert(scope > 0);
        while (self.scopes.get(scope) >= 0) {
            Int index = self.scopes.get(scope);
            self.set_live((self.cells.ref_at(index).generation << 32) + index, false);
        }
        self.scopes.pop();
    }

    Void unlink(Self&! self, Int index) {
        Int previous = self.cells.ref_at(index).previous;
        Int next = self.cells.ref_at(index).next;
        Int scope = self.cells.ref_at(index).scope;
        if (previous >= 0) { self.cells.mut_ref_at(previous).next = next; }
        else { self.scopes.set(scope, next); }
        if (next >= 0) { self.cells.mut_ref_at(next).previous = previous; }
    }

    Void link(Self&! self, Int index, Int scope) {
        Int next = self.scopes.get(scope);
        self.cells.mut_ref_at(index).scope = scope;
        self.cells.mut_ref_at(index).previous = -1;
        self.cells.mut_ref_at(index).next = next;
        if (next >= 0) { self.cells.mut_ref_at(next).previous = index; }
        self.scopes.set(scope, index);
    }

    #doc 转交值的存储树，不转交借用目标；调用返回不能延长被调用者局部变量的生命期。
    public Void transfer(Self&! self, Int address, Int scope) {
        Cell cell = self.get(address);
        assert(cell.alive);
        Int index = address & 4294967295;
        if (self.cells.ref_at(index).scope != scope) {
            self.unlink(index);
            self.link(index, scope);
        }
        if (cell.data is .aggregate(start, count)) {
            Int field! = 0;
            while (field < count) { self.transfer(start + field, scope); field += 1; }
        }
    }

    #doc 预算按容器保留容量计算，包含地址及作用域元数据；执行步数由执行器独立限制。
    public Int retained_bytes(self) {
        return self.cells.cap() * Slot$.size() + self.scopes.cap() * Int$.size() + self.frame_bytes
            + self.heap_roots.retained_bytes() + self.strings.retained_bytes() + self.constants.retained_bytes();
    }

    public Bool reserve_frame(Self&! self, Int locals) {
        Int bytes = locals * Int$.size();
        if (bytes > self.limit - self.retained_bytes()) { self.allocation_failed = true; return false; }
        self.frame_bytes += bytes;
        return true;
    }

    public Void release_frame(Self&! self, Int locals) { self.frame_bytes -= locals * Int$.size(); }

    Bool has_capacity(Self&! self, Int count) {
        if (count >= 0 && count <= self.limit / Slot$.size()) { return true; }
        self.allocation_failed = true;
        return false;
    }

    public Int? allocate(Self&! self, qid.TypeId type_id) {
        return self.allocate(type_id, .temporary);
    }

    public Int? allocate(Self&! self, qid.TypeId type_id, AllocationKind kind) {
        return self.allocate_in(type_id, kind, self.current_scope());
    }

    public Int? allocate_in(Self&! self, qid.TypeId type_id, AllocationKind kind, Int scope) {
        return self.allocate_range(type_id, 1, kind, scope);
    }

    #doc 优先复用连续空槽，只有真实保留空间增长才消耗预算；代次耗尽时拒绝分配，绝不回绕。
    Int? allocate_range(Self&! self, qid.TypeId type_id, Int count, AllocationKind kind, Int scope) {
        if (!self.has_capacity(count) || self.generation == 2147483647) {
            self.allocation_failed = true;
            return null;
        }
        Int start! = self.free_hint;
        Int index! = start;
        while (index < self.cells.len() && index - start < count) {
            if (self.cells.ref_at(index).scope >= 0) { start = index + 1; }
            index += 1;
        }
        Int end = start + count;
        Int capacity! = self.cells.cap();
        if (capacity == 0) { capacity = 8; }
        while (capacity < end) { capacity *= 2; }
        if (capacity > 4294967295 || self.retained_bytes()
            + (capacity - self.cells.cap()) * Slot$.size() > self.limit) {
            self.allocation_failed = true;
            return null;
        }
        self.generation += 1;
        Int address = (self.generation << 32) + start;
        index = start;
        while (index < end) {
            Slot slot = Slot(
                cell = Cell(type_id = type_id, data = .uninitialized, alive = true, read_only = false),
                generation = self.generation, kind = kind, scope = scope, previous = -1, next = -1
            );
            if (index < self.cells.len()) { self.cells.set(index, slot); }
            else { self.cells.add(slot); }
            self.link(index, scope);
            index += 1;
        }
        if (start == self.free_hint) { self.free_hint = end; }
        while (self.free_hint < self.cells.len() && self.cells.ref_at(self.free_hint).scope >= 0) {
            self.free_hint += 1;
        }
        self.allocations[Int(kind)] += count;
        self.live_by_kind[Int(kind)] += count;
        if (self.live_by_kind[Int(kind)] > self.peak_by_kind[Int(kind)]) {
            self.peak_by_kind[Int(kind)] = self.live_by_kind[Int(kind)];
        }
        self.live_cells += count;
        if (self.live_cells > self.peak_live_cells) { self.peak_live_cells = self.live_cells; }
        return address;
    }

    Void set_cell(Self&! self, Int address, Cell cell) {
        assert(self.get(address).alive);
        self.cells.mut_ref_at(address & 4294967295).cell = cell;
    }

    #doc JIL 显式分配的根不随调用帧退出失效；只有 free 可以释放它及其子字段。
    public Int? allocate_heap(Self&! self, qid.TypeId type_id) {
        Int extra = self.heap_roots.reserved_bytes(1) - self.heap_roots.retained_bytes();
        if (self.retained_bytes() + extra > self.limit) { self.allocation_failed = true; return null; }
        self.heap_roots.reserve(1);
        guard self.allocate_in(type_id, .heap, 0) is .some(address) else { return null; }
        self.heap_roots.set(address, false);
        return address;
    }

    #doc free 只结束一次活跃分配，不执行析构；析构顺序完全由已经展开的 JIL 决定。
    public Bool release_heap(Self&! self, Int address) {
        if (!self.heap_roots.has(address) || !self.get(address).alive) { return false; }
        self.set_live(address, false);
        self.heap_roots.remove(address);
        return true;
    }

    #doc 动态分配保留元素类型和实际数量，不为运行时长度制造新的语义数组类型。
    public Int? allocate_heap_sequence(Self&! self, qid.TypeId element, Int count) {
        if (count < 0) { return null; }
        if (!self.has_capacity(count) || !self.has_capacity(count + 1)) { return null; }
        guard self.allocate_heap(element) is .some(root) else { return null; }
        if (!self.allocate_array(root, element, count)) { self.release_heap(root); return null; }
        self.heap_roots.set(root, true);
        return root;
    }

    #doc
        从存储来源恢复元素类型，包括没有子元素的空序列；动态数组元素不能再被拆成标量元素。
    #end
    public qid.TypeId sequence_element_type(self, compiler_store.CompilerStore& store, Int storage) {
        qid.TypeId stored_type = self.get(storage).type_id;
        if (self.heap_roots.get(storage) is .some(sequence)) {
            if (sequence$.get()) { return stored_type; }
        }
        if (store.types.get(stored_type).data is .array_type(array)) { return array.element; }
        return stored_type;
    }

    #doc 元素指针保留所属存储及偏移；允许尾后地址，但解引用必须落在存储内。
    public Int? element_reference(Self&! self, qid.TypeId type_id, Int storage, Int index) {
        Cell root = self.get(storage);
        if (!root.alive) { return null; }
        guard root.data is .aggregate(first, count) else { return null; }
        if (index < 0 || index > count) { return null; }
        guard self.allocate(type_id) is .some(pointer) else { return null; }
        self.set_data(pointer, .element_reference(storage, first, index));
        return pointer;
    }

    #doc first 是本次元素存储的身份；原数组 move 后重新初始化不能复活旧指针。
    public Bool sequence_live(self, Int storage, Int first) {
        Cell root = self.get(storage);
        if (!root.alive) { return false; }
        if (root.data is .aggregate(start, _)) { return start == first; }
        return false;
    }

    public Int? sequence_element(self, Int storage, Int first, Int index) {
        if (!self.sequence_live(storage, first)) { return null; }
        Cell root = self.get(storage);
        guard root.data is .aggregate(start, count) else { return null; }
        if (index < 0 || index >= count) { return null; }
        return start + index;
    }

    public Int? scalar(Self&! self, value.ComptimeValue scalar) {
        guard self.allocate(scalar.type_id) is .some(address) else { return null; }
        self.set_data(address, .scalar(scalar.data));
        return address;
    }

    public Int? reference(Self&! self, qid.TypeId type_id, Int target) {
        if (!self.get(target).alive) { return null; }
        guard self.allocate(type_id) is .some(address) else { return null; }
        self.set_data(address, .reference(target));
        return address;
    }

    public Int? null_pointer(Self&! self, qid.TypeId type_id) {
        guard self.allocate(type_id) is .some(address) else { return null; }
        self.set_data(address, .null_pointer);
        return address;
    }

    public Void set_data(Self&! self, Int address, CellData data) {
        Cell cell = self.get(address);
        self.set_cell(address, Cell(type_id = cell.type_id, data = data, alive = cell.alive, read_only = cell.read_only));
    }

    public Void set_live(Self&! self, Int address, Bool alive) {
        assert(!alive);
        Cell cell = self.get(address);
        if (!cell.alive) { return; }
        self.clear_value(address);
        Int index = address & 4294967295;
        self.unlink(index);
        self.cells.mut_ref_at(index).scope = -1;
        self.cells.mut_ref_at(index).cell = Cell(
            type_id = cell.type_id, data = .uninitialized, alive = false, read_only = false
        );
        if (index < self.free_hint) { self.free_hint = index; }
        self.live_cells -= 1;
        self.live_by_kind[Int(self.cells.ref_at(index).kind)] -= 1;
    }

    #doc move/drop 消耗值但保留 local 的存储期；释放子字段后旧元素指针立即失效。
    public Void clear_value(Self&! self, Int address) {
        Cell cell = self.get(address);
        if (!cell.alive) { return; }
        if (cell.data is .aggregate(start, count)) {
            Int index! = 0;
            while (index < count) { self.set_live(start + index, false); index += 1; }
        }
        self.set_cell(address, Cell(
            type_id = cell.type_id, data = .uninitialized, alive = true, read_only = cell.read_only
        ));
    }

    public Bool initialized(self, Int address) {
        Cell cell = self.get(address);
        if (!cell.alive || cell.data is .uninitialized || cell.data is .inactive) { return false; }
        if (cell.data is .aggregate(start, count)) {
            Int index! = 0;
            while (index < count) {
                if (!(self.get(start + index).data is .inactive) && !self.initialized(start + index)) { return false; }
                index = index + 1;
            }
        }
        return true;
    }

    public Int? clone(Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int source) {
        if (!self.initialized(source)) { return null; }
        guard self.allocate(self.get(source).type_id, .copy) is .some(target) else { return null; }
        if (!self.copy_into(store, query, target, source)) { return null; }
        return target;
    }

    #doc 只消费当前语句的临时值；新目标可以接收字段树，已有稳定字段继续原地复制。
    public Bool consume_into(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int target, Int source
    ) {
        Cell input = self.get(source);
        Cell output = self.get(target);
        if (source == target || self.current_scope() == 0 || !input.alive || !output.alive || output.read_only
            || self.cells.ref_at(source & 4294967295).scope != self.current_scope()
            || !store.types.same_type_ignoring_mutability(input.type_id, output.type_id)) {
            return self.copy_into(store, query, target, source);
        }
        if (!(input.data is .aggregate(_, _))) { return self.copy_into(store, query, target, source); }
        if (!(output.data is .uninitialized) && !self.has_inactive_fields(target)) {
            return self.copy_into(store, query, target, source);
        }
        self.clear_value(target);
        guard input.data is .aggregate(start, count) else { assert(false); return false; }
        Int scope = self.cells.ref_at(target & 4294967295).scope;
        Int index! = 0;
        while (index < count) { self.transfer(start + index, scope); index += 1; }
        self.set_data(source, .uninitialized);
        self.set_data(target, input.data);
        return true;
    }

    public Bool copy_into(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int target, Int source
    ) {
        Cell cell = self.get(source);
        if (!cell.alive || !self.get(target).alive) { return false; }
        // 可变性已经由 typecheck/borrow 检查；存储拷贝比较值形状，不要求非驻留 TypeId 相同。
        if (!store.types.same_type_ignoring_mutability(cell.type_id, self.get(target).type_id)) { return false; }
        if (target == source) { return true; }
        if (self.get(target).read_only) { return false; }
        if (cell.data is .aggregate(start, count)) {
            if (self.has_inactive_fields(source) || self.has_inactive_fields(target)) { self.clear_value(target); }
            if (!self.ensure_aggregate(store, query, target)) { return false; }
            guard self.get(target).data is .aggregate(target_start, target_count) else { return false; }
            if (target_count != count) { return false; }
            Int index! = 0;
            while (index < count) {
                if (!self.copy_into(store, query, target_start + index, start + index)) { return false; }
                index = index + 1;
            }
            return true;
        }
        if (cell.data is .inactive) { self.clear_value(target); }
        self.set_data(target, cell.data);
        return true;
    }

    #doc 切换 sum 的值时重建 payload 存储，不能让旧变体中的逻辑地址复活。
    Bool has_inactive_fields(self, Int address) {
        guard self.get(address).data is .aggregate(start, count) else { return false; }
        Int index! = 0;
        while (index < count) {
            if (self.get(start + index).data is .inactive) { return true; }
            index = index + 1;
        }
        return false;
    }

    #doc 构造 tagged sum 时只初始化选中 payload；0 表示没有 payload，非选中槽不可读取。
    public Bool select_payload(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, Int active
    ) {
        if (!self.ensure_aggregate(store, query, address)) { return false; }
        guard self.get(address).data is .aggregate(start, count) else { return false; }
        if (active < 0 || active >= count) { return false; }
        Int index! = 1;
        while (index < count) {
            if (index != active) { self.set_data(start + index, .inactive); }
            index = index + 1;
        }
        return true;
    }

    public Bool ensure_aggregate(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int address
    ) {
        Cell cell = self.get(address);
        if (!cell.alive) { return false; }
        if (cell.data is .aggregate(_, _)) { return true; }
        if (!(cell.data is .uninitialized)) { return false; }
        if (store.types.get(cell.type_id).data is .array_type(array)) {
            if (array.count_param != null) { return false; }
            return self.allocate_array(address, array.element, types.array_storage_count(array));
        }
        layout.LayoutId layout_id = database.layout_of_type(query$.mut_ref(), store$.ref(), cell.type_id);
        if (database.layout_has_errors(query$.ref())) { return false; }
        layout.TypeLayout shape = query.layout.store().layout(layout_id);
        if (shape.kind != .aggregate && shape.kind != .zero_sized) { return false; }
        guard self.allocate_range(cell.type_id, shape.fields.length, .aggregate,
            self.cells.ref_at(address & 4294967295).scope) is .some(start) else { return false; }
        Int index! = 0;
        while (index < shape.fields.length) {
            self.set_cell(start + index, Cell(type_id = shape.fields[index].field_type,
                data = .uninitialized, alive = true, read_only = false));
            index = index + 1;
        }
        self.set_data(address, .aggregate(start, shape.fields.length));
        return true;
    }

    #doc vtable 值本身是指针，静态表的存储字段由 JIL initializer 给出，不使用指针值的 layout。
    public Bool allocate_static_fields(Self&! self, Int address, jil.StaticField[]& fields) {
        Cell cell = self.get(address);
        if (!cell.alive || !(cell.data is .uninitialized)) { return false; }
        guard self.allocate_range(cell.type_id, fields.length, .aggregate,
            self.cells.ref_at(address & 4294967295).scope) is .some(start) else { return false; }
        Int index! = 0;
        while (index < fields.length) {
            self.set_cell(start + index, Cell(type_id = fields[index].type_id,
                data = .uninitialized, alive = true, read_only = false));
            index += 1;
        }
        self.set_data(address, .aggregate(start, fields.length));
        return true;
    }

    Bool allocate_array(Self&! self, Int address, qid.TypeId element, Int count) {
        if (count < 0 || !self.has_capacity(count)) { return false; }
        guard self.allocate_range(element, count, .aggregate,
            self.cells.ref_at(address & 4294967295).scope) is .some(start) else { return false; }
        self.set_data(address, .aggregate(start, count));
        return true;
    }

    public Int? child(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int address, Int index
    ) {
        if (!self.ensure_aggregate(store, query, address)) { return null; }
        guard self.get(address).data is .aggregate(start, count) else { return null; }
        if (index < 0 || index >= count) { return null; }
        return start + index;
    }

    public Int? field(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, qid.DefId field_def
    ) {
        qid.TypeId type_id = self.get(address).type_id;
        layout.LayoutId id = database.layout_of_type(query$.mut_ref(), store$.ref(), type_id);
        layout.TypeLayout shape = query.layout.store().layout(id);
        Int index! = 0;
        while (index < shape.fields.length) {
            if (shape.fields[index].field_def == field_def) { return self.child(store, query, address, index); }
            index = index + 1;
        }
        return null;
    }

    #doc 复用同一不可变语义值的只读存储，避免反复反射读取积累永久副本。
    public Int? import_constant(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, value.ComptimeValue value
    ) {
        if (self.constants.get(value) is .some(address)) { return address$.get(); }
        Int extra = self.constants.reserved_bytes(1) - self.constants.retained_bytes();
        if (self.retained_bytes() + extra > self.limit) { self.allocation_failed = true; return null; }
        self.constants.reserve(1);
        guard self.import_value(store, query, value) is .some(address) else { return null; }
        self.freeze(address);
        self.constants.set(value, address);
        return address;
    }

    public Int? import_value(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, value.ComptimeValue source
    ) {
        if (source.data is .null_pointer) { return self.null_pointer(source.type_id); }
        if (source.data is .string_value(symbol)) { return self.import_string(store, query, source.type_id, symbol); }
        guard self.allocate(source.type_id) is .some(address) else { return null; }
        if (source.data is .optional_value(payload)) {
            return self.import_optional(store, query, address, payload);
        }
        if (source.data is .enum_value(case_def, payload)) {
            return self.import_enum(store, query, address, case_def, payload);
        }
        if (source.data is .error_union_value(is_error, payload)) {
            Int active! = 1;
            if (is_error) { active = 2; }
            if (!self.select_payload(store, query, address, active)) { return null; }
            guard self.child(store, query, address, 0) is .some(tag) else { return null; }
            self.set_data(tag, .scalar(.bool_value(is_error)));
            return self.import_payload(store, query, address, active, payload);
        }
        if (source.data is .struct_value(aggregate)) {
            Int index! = 0;
            while (index < store.comptime_store.field_count(aggregate)) {
                value.ComptimeAggregateField field = store.comptime_store.field_at(aggregate, index);
                guard self.field(store, query, address, field.field_def) is .some(target) else { return null; }
                if (!self.import_into(store, query, target, field.value)) { return null; }
                index = index + 1;
            }
            if (!self.ensure_aggregate(store, query, address)) { return null; }
            // Domain 的编译期配置不携带 executor；与 export_struct 对称恢复隐藏 owner 的空状态。
            if (store.resolve.core_traits.domain_trait is .some(domain_trait)) {
                qid.DefId owner = store.types.named_type_def(source.type_id)$.some();
                if (store.model.def_has_direct_trait(owner, domain_trait)) {
                    guard self.get(address).data is .aggregate(start, count) else { return null; }
                    self.set_data(start + count - 1, .null_pointer);
                }
            }
            return address;
        }
        if (source.data is .tuple_value(aggregate)) { return self.import_items(store, query, address, aggregate); }
        if (source.data is .array_value(aggregate)) {
            if (store.types.get(source.type_id).data is .handle_type(handle) && handle.kind == .slice) {
                return self.import_slice(store, query, address, handle.element, aggregate);
            }
            return self.import_items(store, query, address, aggregate);
        }
        self.set_data(address, .scalar(source.data));
        return address;
    }

    #doc 导入 optional 时恢复 tag 与有效 payload，不构造非选中字段的占位值。
    Int? import_optional(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, value.ComptimeAggregateId payload
    ) {
        Int count = store.comptime_store.item_count(payload);
        if (!self.select_payload(store, query, address, count)) { return null; }
        guard self.child(store, query, address, 0) is .some(tag) else { return null; }
        self.set_data(tag, .scalar(.bool_value(count == 1)));
        if (count == 0) { return address; }
        guard self.child(store, query, address, 1) is .some(target) else { return null; }
        value.ComptimeValue item = store.comptime_store.item_at(payload, 0);
        if (!self.import_into(store, query, target, item)) { return null; }
        return address;
    }

    #doc enum 按 case 身份恢复目标布局中的选中槽位，tag 使用目标整数类型。
    Int? import_enum(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, qid.DefId case_def, value.ComptimeAggregateId payload
    ) {
        guard self.field(store, query, address, case_def) is .some(target) else { return null; }
        guard self.get(address).data is .aggregate(start, _) else { return null; }
        Int active = target - start;
        if (!self.select_payload(store, query, address, active)) { return null; }
        guard store.typeck.enum_case_value(case_def) is .some(tag) else { return null; }
        guard integer.from_bits(store, query, self.get(start).type_id, UInt64(tag)) is .some(tag_value)
            else { return null; }
        self.set_data(start, .scalar(tag_value.data));
        return self.import_payload(store, query, address, active, payload);
    }

    #doc tagged sum 驻留一个完整 payload，导入时由所选字段恢复省略的 TypeId。
    Int? import_payload(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, Int active, value.ComptimeAggregateId payload
    ) {
        guard self.child(store, query, address, active) is .some(target) else { return null; }
        value.ComptimeValue item = store.comptime_store.item_at(payload, 0);
        if (!self.import_into(store, query, target, item)) { return null; }
        return address;
    }

    #doc 接口值省略内部 TypeId，按目标字段补类型；已有类型的参数仍必须通过 copy 的类型检查。
    Bool import_into(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int target, value.ComptimeValue source
    ) {
        qid.TypeId type_id! = source.type_id;
        if (type_id == store.types.invalid_type()) { type_id = self.get(target).type_id; }
        value.ComptimeValue typed = value.ComptimeValue(type_id = type_id, data = source.data);
        guard self.import_value(store, query, typed) is .some(imported) else { return false; }
        return self.copy_into(store, query, target, imported);
    }

    #doc 字符串共享含末尾 NUL 的只读字节；描述符仍是普通可复制的 JIL 值。
    public Int? import_string(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, qid.SymbolId symbol
    ) {
        if (store.types.get(type_id).data is .array_type(array)) {
            return self.import_string_array(store, query, type_id, array, symbol);
        }
        guard store.types.get(type_id).data is .handle_type(handle) else { return null; }
        if (!store.types.same_type(handle.element, store.types.uint8_type())) { return null; }
        guard self.string_storage(store, symbol) is .some(root) else { return null; }
        if (handle.kind == .raw_pointer) { return self.element_reference(type_id, root, 0); }
        if (handle.kind != .slice) { return null; }
        guard self.allocate(type_id) is .some(result) else { return null; }
        guard self.child(store, query, result, 0) is .some(pointer) else { return null; }
        guard self.child(store, query, result, 1) is .some(length) else { return null; }
        guard self.get(root).data is .aggregate(first, _) else { assert(false); return null; }
        self.set_data(pointer, .element_reference(root, first, 0));
        self.set_data(length, .scalar(.uint_value(UInt64(store.symbols.text_length(symbol)))));
        return result;
    }

    Int? string_storage(Self&! self, compiler_store.CompilerStore& store, qid.SymbolId symbol) {
        if (self.strings.get(symbol) is .some(root)) { return root$.get(); }
        Int extra = self.strings.reserved_bytes(1) - self.strings.retained_bytes();
        if (self.retained_bytes() + extra > self.limit) { self.allocation_failed = true; return null; }
        self.strings.reserve(1);
        Int length = store.symbols.text_length(symbol);
        if (!self.has_capacity(length) || !self.has_capacity(length + 2)) { return null; }
        qid.TypeId byte_type = store.types.uint8_type();
        guard self.allocate(byte_type) is .some(root) else { return null; }
        if (!self.allocate_array(root, byte_type, length + 1)) { return null; }
        guard self.get(root).data is .aggregate(first, count) else { assert(false); return null; }
        Int index! = 0;
        while (index < count) {
            UInt64 byte! = UInt64(0);
            if (index < length) { byte = UInt64(store.symbols.text_byte_at(symbol, index)); }
            self.set_data(first + index, .scalar(.uint_value(byte)));
            index = index + 1;
        }
        self.freeze(root);
        self.strings.set(symbol, root);
        return root;
    }

    #doc 冻结当前值的存储树，不沿借用引用冻结其他分配；局部复制仍具有独立的可写存储。
    public Void freeze(Self&! self, Int address) {
        Int index = address & 4294967295;
        if (self.cells.ref_at(index).scope != 0) { self.unlink(index); self.link(index, 0); }
        Cell cell = self.get(address);
        if (cell.data is .aggregate(start, count)) {
            Int index! = 0;
            while (index < count) { self.freeze(start + index); index = index + 1; }
        }
        self.set_cell(address, Cell(type_id = cell.type_id, data = cell.data, alive = cell.alive, read_only = true));
    }

    #doc 字符串构造定长数组时复制字节；数组值不共享字面量的只读权限。
    Int? import_string_array(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, types.ArrayType array, qid.SymbolId symbol
    ) {
        if (!store.types.same_type(array.element, store.types.uint8_type())) { return null; }
        Int length = store.symbols.text_length(symbol);
        if (length > array.count) { return null; }
        guard self.allocate(type_id) is .some(root) else { return null; }
        if (!self.ensure_aggregate(store, query, root)) { return null; }
        Int index! = 0;
        while (index < types.array_storage_count(array)) {
            UInt64 byte! = UInt64(0);
            if (index < length) { byte = UInt64(store.symbols.text_byte_at(symbol, index)); }
            if (index == array.count && types.sentinel_has(array.sentinel)) {
                byte = types.sentinel_value(array.sentinel);
            }
            guard self.child(store, query, root, index) is .some(target) else { return null; }
            self.set_data(target, .scalar(.uint_value(byte)));
            index = index + 1;
        }
        return root;
    }

    Int? import_items(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, value.ComptimeAggregateId aggregate
    ) {
        if (!self.ensure_aggregate(store, query, address)) { return null; }
        Int index! = 0;
        while (index < store.comptime_store.item_count(aggregate)) {
            value.ComptimeValue value = store.comptime_store.item_at(aggregate, index);
            guard self.child(store, query, address, index) is .some(target) else { return null; }
            if (!self.import_into(store, query, target, value)) { return null; }
            index = index + 1;
        }
        return address;
    }

    #doc 静态字符串切片按字节导出；其他引用及聚合中的引用不能以原始编译期地址逃逸。
    public value.ComptimeValue? export_value(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query, Int address
    ) {
        if (!self.initialized(address)) { return null; }
        Cell cell = self.get(address);
        if (cell.data is .null_pointer) {
            return value.ComptimeValue(type_id = cell.type_id, data = .null_pointer);
        }
        if (cell.data is .scalar(data)) { return value.ComptimeValue(type_id = cell.type_id, data = data); }
        guard cell.data is .aggregate(start, count) else { return null; }
        if (store.types.get(cell.type_id).data is .optional(_)) {
            return self.export_optional(store, query, cell.type_id, start);
        }
        if (store.types.get(cell.type_id).data is .error_union(_)) {
            return self.export_error_union(store, query, cell.type_id, start);
        }
        if (store.types.get(cell.type_id).data is .handle_type(handle) && handle.kind == .slice) {
            if (store.types.same_type(handle.element, store.types.uint8_type())) {
                return self.export_string(store, cell.type_id, start);
            }
            if (handle.sentinel != null) { return null; }
            return self.export_slice(store, query, cell.type_id, start);
        }
        if (store.types.get(cell.type_id).data is .named(named)) {
            if (store.model.def_enum_has_payload_variants(named.def_id)) {
                return self.export_enum(store, query, cell.type_id, start);
            }
            return self.export_struct(store, query, cell.type_id, start, count);
        }
        list.ArrayList<value.ComptimeValue> items! = list.ArrayList<value.ComptimeValue>();
        Int index! = 0;
        while (index < count) {
            guard self.export_value(store, query, start + index) is .some(item) else { return null; }
            items.add(item);
            index = index + 1;
        }
        if (store.types.get(cell.type_id).data is .array_type(_)) {
            return store.comptime_store.array_value(cell.type_id, items.slice());
        }
        if (store.types.get(cell.type_id).data is .tuple_type(_)) {
            return store.comptime_store.tuple_value(cell.type_id, items.slice());
        }
        return null;
    }

    #doc optional 仅导出选中 payload；some(none) 和 none 是两个不同的不可变值。
    value.ComptimeValue? export_optional(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, Int start
    ) {
        guard self.get(start).data is .scalar(tag_data) else { return null; }
        guard tag_data is .bool_value(present) else { return null; }
        list.ArrayList<value.ComptimeValue> payload! = list.ArrayList<value.ComptimeValue>();
        if (present) {
            guard self.export_value(store, query, start + 1) is .some(item) else { return null; }
            payload.add(item);
        }
        return store.comptime_store.optional_value(type_id, payload.slice());
    }

    #doc error union 的 tag 决定唯一可导出的分支，未选中字段始终保持不活跃。
    value.ComptimeValue? export_error_union(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, Int start
    ) {
        guard self.get(start).data is .scalar(tag_data) else { return null; }
        guard tag_data is .bool_value(is_error) else { return null; }
        Int active! = 1;
        if (is_error) { active = 2; }
        guard self.export_value(store, query, start + active) is .some(payload) else { return null; }
        return store.comptime_store.error_union_value(type_id, is_error, payload);
    }

    #doc enum 的数值 tag 转回稳定的 case 身份，仅固化该 case 的完整 payload。
    value.ComptimeValue? export_enum(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, Int start
    ) {
        guard self.get(start).data is .scalar(tag_data) else { return null; }
        value.ComptimeValue tag = value.ComptimeValue(type_id = self.get(start).type_id, data = tag_data);
        guard integer.bits(tag) is .some(bits) else { return null; }
        layout.LayoutId id = database.layout_of_type(query$.mut_ref(), store$.ref(), type_id);
        layout.TypeLayout shape = query.layout.store().layout(id);
        Int index! = 1;
        while (index < shape.fields.length) {
            guard shape.fields[index].field_def is .some(case_def) else { return null; }
            guard store.typeck.enum_case_value(case_def) is .some(case_tag) else { return null; }
            if (bits == UInt64(case_tag)) {
                guard self.export_value(store, query, start + index) is .some(payload) else { return null; }
                return store.comptime_store.enum_value(type_id, case_def, payload);
            }
            index = index + 1;
        }
        return null;
    }

    #doc 只读序列以元素值导出，不保留执行器地址；可写或失效的借用仍禁止逃逸。
    value.ComptimeValue? export_slice(Self&! self, compiler_store.CompilerStore&! store,
        database.QueryEngine&! query, qid.TypeId type_id, Int start) {
        guard self.get(start + 1).data is .scalar(length_data) else { return null; }
        guard length_data is .uint_value(bits) else { return null; }
        list.ArrayList<value.ComptimeValue> items! = list.ArrayList<value.ComptimeValue>();
        if (self.get(start).data is .null_pointer && bits == 0) {
            return store.comptime_store.array_value(type_id, items.slice());
        }
        guard self.get(start).data is .element_reference(root, first, offset) else { return null; }
        if (!self.sequence_live(root, first) || !self.get(root).read_only) { return null; }
        guard self.get(root).data is .aggregate(_, available) else { return null; }
        if (offset < 0 || offset > available || bits > UInt64(available - offset)) { return null; }
        Int index! = 0;
        while (index < Int(bits)) {
            guard self.export_value(store, query, first + offset + index) is .some(item) else { return null; }
            items.add(item);
            index = index + 1;
        }
        return store.comptime_store.array_value(type_id, items.slice());
    }

    #doc 从序列常量恢复只读元素存储和普通切片描述符，字段类型由目标元素类型补全。
    Int? import_slice(Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        Int address, qid.TypeId element, value.ComptimeAggregateId aggregate) {
        Int count = store.comptime_store.item_count(aggregate);
        qid.TypeId array_type = store.types.array_type(element, count, token.Span());
        guard self.allocate(array_type) is .some(root) else { return null; }
        if (self.import_items(store, query, root, aggregate) == null) { return null; }
        self.freeze(root);
        guard self.child(store, query, address, 0) is .some(pointer) else { return null; }
        guard self.child(store, query, address, 1) is .some(length) else { return null; }
        guard self.get(root).data is .aggregate(first, _) else { return null; }
        self.set_data(pointer, .element_reference(root, first, 0));
        self.set_data(length, .scalar(.uint_value(UInt64(count))));
        return address;
    }

    #doc 生成输出读取仍然存活的字节切片；复制内容，不让切片地址逃逸出本轮逻辑内存。
    public list.ArrayList<UInt8>? read_byte_slice(
        Self&! self, compiler_store.CompilerStore&! store, Int address
    ) {
        if (!self.initialized(address)) { return null; }
        guard self.get(address).data is .aggregate(start, count) else { return null; }
        if (count != 2) { return null; }
        return self.read_string_bytes(store, start, false);
    }

    #doc 只读字面量的子切片导出为字节符号；普通借用不自动变成静态值。
    value.ComptimeValue? export_string(
        Self&! self, compiler_store.CompilerStore&! store, qid.TypeId type_id, Int start
    ) {
        guard self.read_string_bytes(store, start, true) is .some(bytes) else { return null; }
        qid.SymbolId symbol = store.symbols.intern(bytes.slice());
        return value.ComptimeValue(type_id = type_id, data = .string_value(symbol));
    }

    list.ArrayList<UInt8>? read_string_bytes(
        Self&! self, compiler_store.CompilerStore&! store, Int start, Bool require_read_only
    ) {
        guard self.get(start + 1).data is .scalar(length_data) else { return null; }
        guard length_data is .uint_value(bits) else { return null; }
        if (self.get(start).data is .null_pointer && bits == 0) { return list.ArrayList<UInt8>(); }
        guard self.get(start).data is .element_reference(root, first, offset) else { return null; }
        if (!self.sequence_live(root, first) || (require_read_only && !self.get(root).read_only)) { return null; }
        if (!store.types.same_type(self.sequence_element_type(store, root), store.types.uint8_type())) { return null; }
        guard self.get(root).data is .aggregate(_, available) else { assert(false); return null; }
        if (bits > UInt64(available - offset)) { return null; }
        Int length = Int(bits);
        list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>(length);
        Int index! = 0;
        while (index < length) {
            guard self.get(first + offset + index).data is .scalar(byte_data) else { return null; }
            guard byte_data is .uint_value(byte) else { return null; }
            bytes.add(UInt8(byte));
            index = index + 1;
        }
        return bytes;
    }

    value.ComptimeValue? export_struct(
        Self&! self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        qid.TypeId type_id, Int start, Int count
    ) {
        layout.LayoutId id = database.layout_of_type(query$.mut_ref(), store$.ref(), type_id);
        layout.TypeLayout shape = query.layout.store().layout(id);
        list.ArrayList<value.ComptimeAggregateField> fields! = list.ArrayList<value.ComptimeAggregateField>();
        Int index! = 0;
        while (index < count) {
            guard shape.fields[index].field_def is .some(field_def) else {
                // Domain 的编译器管理 owner 槽不属于语义字段；只允许未创建运行期 owner 的空状态。
                guard store.resolve.core_traits.domain_trait is .some(domain_trait) else { return null; }
                guard store.types.named_type_def(type_id) is .some(owner) else { return null; }
                if (index != count - 1 || !store.model.def_has_direct_trait(owner, domain_trait)
                    || !(self.get(start + index).data is .null_pointer)) { return null; }
                index = index + 1;
                continue;
            }
            guard self.export_value(store, query, start + index) is .some(item) else { return null; }
            fields.add(value.ComptimeAggregateField(field_def = field_def, value = item));
            index = index + 1;
        }
        return store.comptime_store.struct_value(type_id, fields.slice());
    }
}
