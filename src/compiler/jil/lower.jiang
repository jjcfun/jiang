#doc(module)
    Semantic Model 到 JIL lowering 的稳定入口；阶段外通过此处发布已检查的语义结果。
#end

alias context = import "../context.jiang";
alias jil = import "./model.jiang";
alias module_graph = import "../resolve/module_graph.jiang";
alias sem_store = import "../sema/model/store.jiang";
alias typeck_store = import "../sema/type_check/store.jiang";
alias package = import "./lower/package.jiang";
alias qid = import "../id.jiang";
alias sem = import "../sema/model.jiang";
alias compiler_store = import "../store.jiang";
alias database = import "../db.jiang";
alias system_target = import "../system/target.jiang";
alias diagnostic = import "../diagnostic.jiang";
alias references = import "./references.jiang";
alias comptime_value = import "../sema/comptime/value.jiang";
alias function = import "./lower/function.jiang";

public alias TemplateAsyncDependency = function.TemplateAsyncDependency;
public alias template_async_dependencies = function.template_async_dependencies;

#doc 继续关闭新增静态结果带来的运行期引用，不重新遍历所有源码声明。
public Void close_runtime_references(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    Int global_cursor, Int item_cursor) {
    package.close_runtime_references(ctx, graph, global_cursor, item_cursor);
}

#doc 将已检查的初始化模型填入对应 JIL 全局存储，不反向请求语义分析。
public Bool ensure_checked_global(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    jil.GlobalId global_id, comptime_value.ComptimeValue? evaluated = null) {
    return package.ensure_checked_global(ctx, graph, global_id, evaluated);
}

#doc 发布已求出的表达式实例值，不请求语义分析或执行 JIL。
public jil.GlobalId? materialize_eval_result(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph, jil.Store&! output,
    jil.FunctionId expression, Int instance, comptime_value.ComptimeValue value
) {
    return package.materialize_eval_result(store, query, output_kind, graph, output, expression, instance, value);
}

#doc 仅准备已检查实例所需的派生元数据，不在 lowering 中反向请求 Sema。
public Bool ensure_eval_metadata(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph, jil.Store&! output,
    jil.MonoItem item, references.References& dependencies
) {
    return package.ensure_eval_metadata(store, query, output_kind, graph, output, item, dependencies);
}

public jil.FunctionId? ensure_expression(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph,
    jil.Store&! output, sem.NodeId root, qid.TypeId result_type
) {
    return package.ensure_expression(store, query, output_kind, graph, output, root, result_type);
}

public Bool ensure_checked_source_function(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph,
    jil.Store&! output, qid.DefId function_def
) {
    return package.ensure_checked_source_function(store, query, output_kind, graph, output, function_def);
}

public jil.FunctionId? ensure_expression(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, jil.Store&! output,
    sem.NodeId root, qid.TypeId result_type
) {
    return package.ensure_expression(ctx, graph, output, root, result_type);
}

public Void lower_package_into(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! output
) {
    package.lower_package_into(ctx, ctx.store.model$.ref(), ctx.store.typeck$.ref(), graph, output);
}

#doc 整包调用方复用相同的引用发现与派生步骤；两步之间需要 Sema 时由编译层分别调用。
public Void lower_package_into(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    begin_runtime_package(ctx, graph);
    if (!ctx.jil.program.has_errors()) { finish_runtime_package(ctx, graph); }
}

#doc 先发布初始运行期需求，允许编译层按需补齐引用的语义 body。
public Void begin_runtime_package(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    if (ctx.store.model.has_errors() || ctx.store.typeck.has_errors()) {
        ctx.jil.program.mark_error();
        return;
    }
    package.begin_runtime_package(ctx, graph);
}

#doc body 闭包就绪后完成协程派生；不在 JIL 中调用 Sema。
public Void finish_runtime_package(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    package.finish_runtime_package(ctx, graph);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, graph);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    sem_store.Store& sem_store,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, sem_store, typeck, graph);
}

public Void lower_drop_references(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! output,
    Int mono_item_cursor
) {
    package.lower_drop_references(ctx, graph, output, mono_item_cursor);
}

public Void lower_drop_references(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph,
    jil.Store&! output, Int mono_item_cursor
) {
    package.lower_drop_references(store, query, output_kind, graph, output, mono_item_cursor);
}
