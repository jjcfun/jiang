public Void lower_package_into(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! output
) {
    package.lower_package_into(ctx, ctx.store.model$.ref(), ctx.store.typeck$.ref(), graph, output);
}

// 最终 sweep 继续填充本轮编译中 eval 已使用的 JIL，不转移或复制其 ownership。
public Void lower_package_into(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    assert(!ctx.jil.program.is_frozen());
    if (!ctx.jil.program.has_query_identity()) {
        ctx.jil.program.bind_query_identity(ctx.query.allocate_jil_store_identity());
    }
    ctx.jil.program.main_domain_def = ctx.store.resolve.core_values.main_domain;
    if (ctx.store.model.has_errors() || ctx.store.typeck.has_errors()) {
        ctx.jil.program.mark_error();
        return;
    }
    qid.SymbolId closure_env_symbol = ctx.store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    package.lower_package_into(
        ctx.store$.ref(), ctx.query.source_jil$.ref(), ctx.query.trait_vtable$.ref(),
        ctx.query.lifetime_shape$.mut_ref(), ctx.query.jil_instance$.ref(), ctx.query.layout$.mut_ref(), ctx.output,
        ctx.store.model$.ref(), ctx.store.typeck$.ref(), graph, closure_env_symbol,
        ctx.jil$.mut_ref(), diagnostics$.mut_ref()
    );
    ctx.store.diagnostics.append(diagnostics$.move());
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, graph);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    sem_store.Store& sem_store,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, sem_store, typeck, graph);
}

