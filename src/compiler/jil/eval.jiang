        }
        if (self.store.resolve.core_functions.reflect_decl_location is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_declaration(function_def, args, span, .location); }
        }
        if (self.store.resolve.core_functions.reflect_decl_members is .some(builtin)) {
