#doc(module)
    编译期 JIL 执行入口；仅消费已经检查的 JIL、实例绑定和 target facts，不回读 AST/Sema 表达式。
    执行标量、聚合、引用、locals、CFG 和直接调用；未支持的操作明确失败，不调用旧解释器。
#end

alias extension_matcher = import "../sema/generic/extension.jiang";
alias sem = import "../sema/model.jiang";
alias source = import "../source.jiang";
alias set = import "../support/set.jiang";
alias context = import "../context.jiang";
alias compiler_store = import "../store.jiang";
alias qid = import "../id.jiang";
alias jil = import "./model.jiang";
alias reader_api = import "./instance_reader.jiang";
alias callable_abi = import "./callable_abi.jiang";
alias drop_projection = import "./drop_projection.jiang";
alias bindings = import "../sema/generic/bindings.jiang";
alias value = import "../sema/comptime/value.jiang";
alias types = import "../sema/type.jiang";
alias drop = import "../sema/drop.jiang";
alias list = import "../support/list.jiang";
alias map = import "../support/map.jiang";
alias diagnostic = import "../diagnostic.jiang";
alias token = import "../syntax/token.jiang";
alias database = import "../db.jiang";
alias layout = import "../layout.jiang";
alias frame_api = import "./eval/frame.jiang";
alias integer = import "./eval/integer.jiang";
alias floating = import "./eval/floating.jiang";
alias memory_api = import "./eval/memory.jiang";
alias system_env = import "../system/env.jiang";
alias system_io = import "../system/io.jiang";
alias output_api = import "../generate/output.jiang";
alias cache_identity = import "../artifact/cache_identity.jiang";
alias artifact_cache = import "../artifact/cache.jiang";
alias location_query = import "../db/source_location.jiang";
alias key_builder = import "../artifact/object_key_builder.jiang";
alias object_key = import "../artifact/object_key.jiang";
alias qkey = import "../incremental/key.jiang";
import std;

public value.ComptimeValue? evaluate_function(
    context.CompilerContext&! ctx,
    jil.Store& program,
    qid.DefId function_def,
    types.GenericArg[]& generic_args,
    value.ComptimeValue[]& args,
    Int step_quota = 10000,
    Int depth_limit = 128
) {
    return evaluate_function(ctx.store$.mut_ref(), ctx.query$.mut_ref(), program,
        function_def, generic_args, args, step_quota, depth_limit);
}

public value.ComptimeValue? evaluate_function(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& program, qid.DefId function_def, types.GenericArg[]& generic_args, value.ComptimeValue[]& args,
    Int step_quota = 10000, Int depth_limit = 128
) {
    Executor executor! = Executor(store, query, program, step_quota, depth_limit);
    return executor.evaluate(function_def, generic_args, args);
}

#doc 只执行已准备的生成入口；模块句柄直接进入本轮逻辑内存，不经过可持久化的常量值。
public Bool evaluate_generator(context.CompilerContext&! ctx, qid.DefId function_def, qid.ModuleId root) {
    output_api.Outputs outputs! = output_api.Outputs();
    return evaluate_generator(ctx, function_def, root, outputs$.mut_ref());
}

#doc 执行成功才转移暂存产物；执行器本身不发布文件，不向普通编译期求值开放写入能力。
public Bool evaluate_generator(
    context.CompilerContext&! ctx, qid.DefId function_def, qid.ModuleId root, output_api.Outputs&! outputs,
    UInt8[]& cache_root = "", qkey.Fingerprint128? implementation = null
) {
    Executor executor! = Executor(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.jil$.ref(), 1000000, 128);
    executor.cache_root = std.String.from_valid_utf8(cache_root);
    if (implementation is .some(key)) { executor.implementation_key = key; }
    Bool success = executor.evaluate_generator(function_def, root);
    executor.report_memory_stats();
    if (!success) { return false; }
    outputs$.set(executor.outputs$.move());
    return true;
}

public value.ComptimeValue? evaluate_expression(
    context.CompilerContext&! ctx, jil.Store& program, jil.FunctionId expression,
    types.GenericArg[]& generic_args, Int step_quota = 10000, Int depth_limit = 128
) {
    return evaluate_expression(ctx.store$.mut_ref(), ctx.query$.mut_ref(), program, expression,
        generic_args, step_quota, depth_limit);
}

public value.ComptimeValue? evaluate_expression(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& program, jil.FunctionId expression,
    types.GenericArg[]& generic_args, Int step_quota = 10000, Int depth_limit = 128
) {
    Executor executor! = Executor(store, query, program, step_quota, depth_limit);
    return executor.evaluate_expression(expression, generic_args);
}

#doc 普通求值可交出缺失的声明 metadata；编排恢复事实后重试，执行预算跨重试延续。
public enum Evaluation: Copyable {
    value(value.ComptimeValue result),
    metadata(qid.DefId target, Int remaining_steps),
}

public Evaluation? evaluate_expression_step(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query, jil.Store& program,
    jil.FunctionId expression, types.GenericArg[]& generic_args, Int steps
) {
    Executor executor! = Executor(store, query, program, steps, 128);
    executor.request_metadata = true;
    _ result = executor.evaluate_expression(expression, generic_args);
    if (executor.pending_metadata is .some(target)) { return Evaluation.metadata(target, executor.steps); }
    if (result is .some(value)) { return Evaluation.value(value); }
    return null;
}

public Evaluation? evaluate_function_step(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query, jil.Store& program,
    qid.DefId function, types.GenericArg[]& generic_args, value.ComptimeValue[]& args, Int steps
) {
    Executor executor! = Executor(store, query, program, steps, 128);
    executor.request_metadata = true;
    _ result = executor.evaluate(function, generic_args, args);
    if (executor.pending_metadata is .some(target)) { return Evaluation.metadata(target, executor.steps); }
    if (result is .some(value)) { return Evaluation.value(value); }
    return null;
}

alias ModuleProperty = database.ModuleProperty;
enum ExportProperty { name, target, source, location, }
enum ImportProperty { source, target, visibility, wildcard, name, location, }
enum DeclarationProperty { name, module, visibility, location, members, generics, type, const_flag, equal, definition, }
enum FunctionProperty { contract, domain, result, receiver, async_flag, unsafe_flag, has_body, parameter_count, parameter_at, }
enum ContractProperty { type, count, at, source, target, root, projection_count, projection_at, }
enum ParameterProperty { name, type, default_value, equal, }
enum TypeProperty { equal, mutable_flag, parameters, }

@region(a, b)
struct Executor: Movable {
    @life(a)
    compiler_store.CompilerStore&! store;
    @life(a)
    database.QueryEngine&! query;
    @life(b)
    jil.Store& program;
    Int steps!;
    Int depth!;
    Int depth_limit;
    Int initial_type_count;
    Bool failed!;
    Bool generating! = false;
    Bool request_metadata! = false;
    qid.DefId? pending_metadata! = null;
    qid.ModuleId? generator_module! = null;
    qid.ModuleId? reflection_root! = null;
    set.HashSet<source.SourceId> resources!;
    Int resource_bytes! = 0;
    std.String cache_root!;
    qkey.Fingerprint128 implementation_key! = qkey.Fingerprint128();
    Int cache_bytes! = 0;
    output_api.Outputs outputs!;
    memory_api.Memory memory!;
    map.WyHashMap<Int, Int> globals!;

    init(self, compiler_store.CompilerStore&! store, database.QueryEngine&! query,
        jil.Store& program, Int steps, Int depth_limit) {
        self.store = store;
        self.query = query;
        self.program = program;
        self.steps = steps;
        self.depth = 0;
        self.depth_limit = depth_limit;
        self.initial_type_count = self.store.types.types.next_id().to_index();
        self.failed = false;
        self.memory = memory_api.Memory();
        self.outputs = output_api.Outputs();
        self.cache_root = std.String.from_valid_utf8("");
        self.resources = set.HashSet<source.SourceId>();
        self.globals = map.WyHashMap<Int, Int>();
    }

    value.ComptimeValue? evaluate(
        Self&! self, qid.DefId function_def, types.GenericArg[]& generic_args, value.ComptimeValue[]& args
    ) {
        self.reflection_root = self.store.defs.get(function_def).module_id;
        list.ArrayList<Int> addresses! = list.ArrayList<Int>(args.length);
        Int index! = 0;
        while (index < args.length) {
            guard self.memory.import_value(self.store, self.query, args[index]) is .some(address) else {
                self.fail(function_def, token.Span(), "comptime_invalid_argument",
                    "cannot import value into eval memory");
                return null;
            }
            addresses.add(address);
            index = index + 1;
        }
        guard self.call(function_def, generic_args, addresses.slice(), token.Span()) is .some(result) else {
            return null;
        }
        return self.export_result(function_def, result);
    }

    #doc 调用者已验证入口签名，句柄参数的类型取自已检查签名，执行期间不触发 Sema。
    Bool evaluate_generator(Self&! self, qid.DefId function_def, qid.ModuleId root) {
        guard self.store.typeck.def_type(function_def) is .some(function_type) else { return false; }
        guard self.store.types.get(function_type).data is .function_type(signature) else { return false; }
        if (signature.params.length != 1 || signature.result != self.store.types.unit_type()) { return false; }
        guard self.memory.allocate(signature.params[0]) is .some(argument) else { return false; }
        self.memory.set_data(argument, .reflected_module(root));
        self.generating = true;
        self.reflection_root = root;
        self.generator_module = self.store.defs.get(function_def).module_id;
        self.query.begin_generation(self.store.resolve.module_ref(self.generator_module$.some()).source_id);
        list.ArrayList<Int> args! = list.ArrayList<Int>();
        args.add(argument);
        list.ArrayList<types.GenericArg> generics! = list.ArrayList<types.GenericArg>();
        return self.call(function_def, generics.slice(), args.slice(), token.Span()) != null;
    }

    value.ComptimeValue? evaluate_expression(
        Self&! self, jil.FunctionId expression, types.GenericArg[]& generic_args
    ) {
        jil.Function function = self.program.program.function(expression);
        qid.DefId owner = jil.function_provenance_def(function.origin);
        self.reflection_root = self.store.defs.get(owner).module_id;
        if (!self.program_ready()
            || !self.store.borrowck.generated_function_checked(expression.to_index())) {
            self.fail(owner, function.span, "comptime_function_not_ready",
                "JIL expression must be lowered and borrow checked before eval");
            return null;
        }
        bindings.GenericBindings empty! = bindings.GenericBindings();
        bindings.GenericBindings concrete! = bindings.bindings_for_instance(
            self.store.defs$.ref(), self.store.model$.ref(), self.store.types$.ref(),
            owner, generic_args, empty$.ref()
        );
        reader_api.bind_eval_constants(self.store$.ref(), self.program.program$.ref(), owner, concrete$.mut_ref());
        list.ArrayList<Int> args! = list.ArrayList<Int>();
        guard self.execute(function, concrete, args.slice()) is .some(result) else { return null; }
        return self.export_result(owner, result);
    }

    value.ComptimeValue? export_result(Self&! self, qid.DefId function_def, Int result) {
        guard self.memory.export_value(self.store, self.query, result) is .some(value) else {
            self.fail(function_def, token.Span(), "comptime_value_not_materializable",
                "eval result contains an address or unsupported value that cannot escape compilation");
            return null;
        }
        return value;
    }

    Int? call(
        Self&! self, qid.DefId function_def, types.GenericArg[]& generic_args,
        Int[]& args, token.Span span, qid.TypeId? expected_result = null
    ) {
        if (!self.ready(function_def, span)) { return null; }
        if (self.store.resolve.core_functions.reflect_decl_generics is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_declaration(function_def, args, span, .generics); }
        }
        if (self.store.resolve.core_functions.reflect_decl_const is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_declaration(function_def, args, span, .const_flag); }
        }
        if (self.store.resolve.core_functions.reflect_decl_type is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_declaration(function_def, args, span, .type); }
        }
        if (self.store.resolve.core_functions.reflect_type_members is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_members(function_def, args, span); }
        }
        if (self.store.resolve.core_functions.reflect_decl_definition is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_declaration(function_def, args, span, .definition); }
        }
        if (self.store.resolve.core_functions.reflect_type_of is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_known_type(function_def, generic_args, args, span); }
        }
        if (self.store.resolve.core_functions.reflect_type_kind is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_structure(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_type_number is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_structure(function_def, args, span, 1); }
        }
        if (self.store.resolve.core_functions.reflect_type_element is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_structure(function_def, args, span, 2); }
        }
        if (self.store.resolve.core_functions.reflect_type_definition is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_structure(function_def, args, span, 3); }
        }
        if (self.store.resolve.core_functions.reflect_type_parameter is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type_structure(function_def, args, span, 4); }
        }
        if (self.store.resolve.core_functions.reflect_type_sentinel is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_sentinel(function_def, args); }
        }
        if (self.store.resolve.core_functions.reflect_argument_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_arguments(function_def, args, span, false); }
        }
        if (self.store.resolve.core_functions.reflect_argument_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_arguments(function_def, args, span, true); }
        }
        if (self.store.resolve.core_functions.reflect_constant_type is .some(builtin)) {
            if (function_def == builtin) {
                return self.reflect_constant(function_def, generic_args, args, span, 0, expected_result);
            }
        }
        if (self.store.resolve.core_functions.reflect_constant_parameter is .some(builtin)) {
            if (function_def == builtin) {
                return self.reflect_constant(function_def, generic_args, args, span, 1, expected_result);
            }
        }
        if (self.store.resolve.core_functions.reflect_constant_binding is .some(builtin)) {
            if (function_def == builtin) {
                return self.reflect_constant(function_def, generic_args, args, span, 2, expected_result);
            }
        }
        if (self.store.resolve.core_functions.reflect_constant_read is .some(builtin)) {
            if (function_def == builtin) {
                return self.reflect_constant(function_def, generic_args, args, span, 3, expected_result);
            }
        }
        if (self.store.resolve.core_functions.reflect_type_equal is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type(function_def, args, span, .equal); }
        }
        if (self.store.resolve.core_functions.reflect_type_mutable is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type(function_def, args, span, .mutable_flag); }
        }
        if (self.store.resolve.core_functions.reflect_type_has_parameters is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_type(function_def, args, span, .parameters); }
        }
        if (self.store.resolve.core_functions.reflect_function_result is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .result); }
        }
        if (self.store.resolve.core_functions.reflect_function_receiver is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .receiver); }
        }
        if (self.store.resolve.core_functions.reflect_function_async is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .async_flag); }
        }
        if (self.store.resolve.core_functions.reflect_function_unsafe is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .unsafe_flag); }
        }
        if (self.store.resolve.core_functions.reflect_function_domain is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .domain); }
        }
        if (self.store.resolve.core_functions.reflect_type_domain is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_domain(function_def, args, 0); }
        }
        if (self.store.resolve.core_functions.reflect_domain_type is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_domain(function_def, args, 1); }
        }
        if (self.store.resolve.core_functions.reflect_domain_binding is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_domain(function_def, args, 2); }
        }
        if (self.store.resolve.core_functions.reflect_domain_equal is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_domain(function_def, args, 3); }
        }
        if (self.store.resolve.core_functions.reflect_decl_regions is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_type_regions is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 1); }
        }
        if (self.store.resolve.core_functions.reflect_region_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 2); }
        }
        if (self.store.resolve.core_functions.reflect_region_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 3); }
        }
        if (self.store.resolve.core_functions.reflect_region_name is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 4); }
        }
        if (self.store.resolve.core_functions.reflect_region_shape is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 5); }
        }
        if (self.store.resolve.core_functions.reflect_region_default is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 6); }
        }
        if (self.store.resolve.core_functions.reflect_region_sources is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 7); }
        }
        if (self.store.resolve.core_functions.reflect_region_equal is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_regions(function_def, args, span, 8); }
        }
        if (self.store.resolve.core_functions.reflect_life_explicit is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_lifetime(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_function_contract is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_function(function_def, args, span, .contract); }
        }
        if (self.store.resolve.core_functions.reflect_type_contract is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .type); }
        }
        if (self.store.resolve.core_functions.reflect_contract_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .count); }
        }
        if (self.store.resolve.core_functions.reflect_contract_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .at); }
        }
        if (self.store.resolve.core_functions.reflect_flow_source is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .source); }
        }
        if (self.store.resolve.core_functions.reflect_flow_target is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .target); }
        }
        if (self.store.resolve.core_functions.reflect_borrow_root is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .root); }
        }
        if (self.store.resolve.core_functions.reflect_borrow_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .projection_count); }
        }
        if (self.store.resolve.core_functions.reflect_borrow_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_contract(function_def, args, span, .projection_at); }
        }
        if (self.store.resolve.core_functions.reflect_nominal_contract is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_nominal_lifetime(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_region_path_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_nominal_lifetime(function_def, args, span, 1); }
        }
        if (self.store.resolve.core_functions.reflect_region_path_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_nominal_lifetime(function_def, args, span, 2); }
        }
        if (self.store.resolve.core_functions.reflect_pattern_error is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 13); }
        }
        if (self.store.resolve.core_functions.reflect_extension_target is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_extension(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_extension_trait_type is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_extension(function_def, args, span, 1); }
        }
        if (self.store.resolve.core_functions.reflect_extension_unsafe is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_extension(function_def, args, span, 2); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_count is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 0); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_at is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 1); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_type is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 2); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_parameter is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 3); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_name is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 4); }
        }
        if (self.store.resolve.core_functions.reflect_constraint_value is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 5); }
        }
        if (self.store.resolve.core_functions.reflect_pattern_shape is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 6); }
        }
        if (self.store.resolve.core_functions.reflect_pattern_element is .some(builtin)) {
            if (function_def == builtin) { return self.reflect_constraint(function_def, args, span, 7); }
        }
        if (self.store.resolve.core_functions.reflect_pattern_definition is .some(builtin)) {
