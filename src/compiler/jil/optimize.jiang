// JIL 优化阶段的稳定入口。
//
// 这里编排依赖 Jiang 语义事实的优化；通用指令选择和目标相关优化仍交给 backend。
// 任一 CFG mutation 后都立即重算分析，调用方不能继续消费旧 facts。

alias context = import "../context.jiang";
alias compiler_store = import "../store.jiang";
alias database = import "../db.jiang";
alias jil = import "./model.jiang";
alias tail_recursion = import "./optimize/tail_recursion.jiang";

public tail_recursion.Statistics optimize_package(
    context.CompilerContext&! ctx,
    jil.Store&! store
) {
    return tail_recursion.optimize_package(ctx, store);
}

public tail_recursion.Statistics optimize_package(
    compiler_store.CompilerStore& semantic_store, database.LayoutQuery&! layouts, jil.Store&! store
) {
    return tail_recursion.optimize_package(semantic_store, layouts, store);
}
