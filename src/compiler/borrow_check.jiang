// 借用检查阶段入口，验证 JIL 上的 move、loan、lifetime 与 drop safety。
//
// borrow_check 消费已经 lower 完成的 JIL、type check side table 和
// layout cache。这里不重新 resolve/type check，也不从 JIL 推导 layout。

alias context = import "./context.jiang";
alias database = import "./db.jiang";
alias diagnostic = import "./diagnostic.jiang";
alias diagnostic_helper = import "./diagnostic/helper.jiang";
alias qid = import "./id.jiang";
alias jil = import "./jil.jiang";
alias checker = import "./borrow_check/checker.jiang";
alias borrow_store = import "./borrow_check/store.jiang";
alias store_api = import "./store.jiang";
alias string_support = import "./support/string.jiang";
alias system_io = import "./system/io.jiang";
import std;

public Bool run_package(context.CompilerContext&! ctx, jil.Store& jil_store, Bool timing_enabled) {
    return run_package(ctx.store$.mut_ref(), ctx.query$.mut_ref(), jil_store, timing_enabled);
}

public borrow_store.BorrowCheckStore^ check_package(context.CompilerContext&! ctx, jil.Store& jil_store) {
    return check_package(ctx.store$.mut_ref(), ctx.query$.mut_ref(), jil_store);
}

public Bool check_source_function(
    context.CompilerContext&! ctx, jil.Store& jil_store,
    borrow_store.BorrowCheckStore&! results, qid.DefId function_def
) {
    return check_source_function(ctx.store$.mut_ref(), ctx.query$.mut_ref(), jil_store, results, function_def);
}

public Bool check_package_into(
    context.CompilerContext&! ctx, jil.Store& jil_store, borrow_store.BorrowCheckStore&! results
) {
    return check_package_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), jil_store, results);
}

public Bool run_package(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store,
    Bool timing_enabled
) {
    if (!jil_store.program.has_query_identity()) {
        checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
        borrow_store.BorrowCheckStore^ uncached = check_package_impl(
            store, query, jil_store, timing_enabled, timing$.mut_ref()
        );
        print_timing(store$.ref(), timing_enabled, timing);
        return uncached.accepted();
    }
    if (store.owns_borrow_check_result(jil_store.program.query_identity)) {
        if (!store.borrowck.covers_program(jil_store.program$.ref())
            || jil_store.program.has_errors() || store.typeck.has_errors()
            || database.layout_has_errors(query$.ref())) {
            checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
            diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
            check_functions_readonly(
                store, query, jil_store, store.borrowck$.mut_ref(), null, timing_enabled,
                timing$.mut_ref(), diagnostics$.mut_ref()
            );
            store.diagnostics.append(diagnostics$.move());
            print_timing(store$.ref(), timing_enabled, timing);
        }
        return store.borrow_check_result_accepted();
    }
    checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
    borrow_store.BorrowCheckStore^ results = check_package_impl(
        store, query, jil_store, timing_enabled, timing$.mut_ref()
    );
    print_timing(store$.ref(), timing_enabled, timing);
    Bool accepted = results.accepted();
    store.publish_borrow_check_result(
        jil_store.program.query_identity,
        results
    );
    return accepted;
}

public borrow_store.BorrowCheckStore^ check_package(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store
) {
    checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
    return check_package_impl(store, query, jil_store, false, timing$.mut_ref());
}

// eval 只检查当前入口与调用依赖；共享 Program 中其他入口可能仍在递归准备。
public Bool run_function(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store, jil.FunctionTarget root
) {
    assert(jil_store.program.has_query_identity());
    if (!store.owns_borrow_check_result(jil_store.program.query_identity)) {
        store.publish_borrow_check_result(jil_store.program.query_identity,
            new borrow_store.BorrowCheckStore(true));
    }
    checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    Bool accepted = check_functions_readonly(
        store, query, jil_store, store.borrowck$.mut_ref(), root, false,
        timing$.mut_ref(), diagnostics$.mut_ref()
    );
    store.diagnostics.append(diagnostics$.move());
    return accepted;
}

borrow_store.BorrowCheckStore^ check_package_impl(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store,
    Bool timing_enabled,
    checker.BorrowCheckTiming&! timing
) {
    // BorrowCheckStore 后续会保存 loans/dataflow facts，按指针返回避免
    // 阶段边界复制大表，也避开当前 stage1 对含表结构体返回值的复制问题。
    borrow_store.BorrowCheckStore^ results! = new borrow_store.BorrowCheckStore(
        jil_store.program.ok && store.typeck.ok && !database.layout_has_errors(query$.ref())
    );
    check_functions(store, query, jil_store, results$.mut_ref(), null, timing_enabled, timing);
    return results;
}

// 调用者持有同一 Program 的结果表，执行前先发布 root 的 JIL/语义依赖。
public Bool check_source_function(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store,
    borrow_store.BorrowCheckStore&! results,
    qid.DefId function_def
) {
    checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
    jil.FunctionTarget root = .source(function_def);
    return check_functions(store, query, jil_store, results, root, false, timing$.mut_ref());
}

public Bool check_package_into(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store,
    borrow_store.BorrowCheckStore&! results
) {
    checker.BorrowCheckTiming timing! = checker.BorrowCheckTiming();
    return check_functions(store, query, jil_store, results, null, false, timing$.mut_ref());
}

Bool check_functions(
    store_api.CompilerStore&! store, database.QueryEngine&! query,
    jil.Store& jil_store,
    borrow_store.BorrowCheckStore&! results,
    jil.FunctionTarget? root,
    Bool timing_enabled,
    checker.BorrowCheckTiming&! timing
) {
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    Bool accepted = check_functions_readonly(
        store, query, jil_store, results, root, timing_enabled, timing, diagnostics$.mut_ref()
    );
    store.diagnostics.append(diagnostics$.move());
    return accepted;
}

Bool check_functions_readonly(
    store_api.CompilerStore& store, database.QueryEngine&! query,
    jil.Store& jil_store, borrow_store.BorrowCheckStore&! results, jil.FunctionTarget? root,
    Bool timing_enabled, checker.BorrowCheckTiming&! timing, diagnostic.DiagnosticStore&! diagnostics
) {
    if (results.has_errors() && results.checked) { return false; }
    if (jil_store.program.has_errors() || store.typeck.has_errors()
        || database.layout_has_errors(query$.ref())) { results.mark_error(); }
    if (!results.has_errors()) {
        {
            checker.PackageBorrowChecker package_checker! = checker.PackageBorrowChecker(
                store$.ref(),
                query$.mut_ref(),
                results$.mut_ref(),
                diagnostics$.mut_ref(),
                timing_enabled
            );
            if (root is .some(target)) {
                package_checker.check_function(jil_store, target);
            } else {
                package_checker.check_store(jil_store);
            }
            timing.add(package_checker.timing);
        }
    }
    if (results.has_errors()) {
        diagnostic_helper.add_package_error(
            diagnostics,
            "borrow check failed",
            "borrow_check_failed"
        );
        results.mark_checked();
    }
    return results.accepted();
}

Void print_timing(
    store_api.CompilerStore& store,
    Bool enabled,
    checker.BorrowCheckTiming timing
) {
    if (!enabled) { return; }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("borrow_functions=");
    builder.append(timing.functions);
    builder.append_valid_utf8(" borrow_block_visits=");
    builder.append(timing.block_visits);
    builder.append_valid_utf8(" borrow_active_loan_facts=");
    builder.append(timing.active_loan_facts);
    builder.append_valid_utf8(" borrow_max_active_loans=");
    builder.append(timing.max_active_loans);
    builder.append_valid_utf8(" borrow_slowest_def=");
    builder.append(timing.slowest_def);
    if (timing.slowest_def >= 0) {
        qid.DefId slowest_def = qid.DefId(timing.slowest_def);
        if (store.defs.has(slowest_def)) {
            builder.append_valid_utf8(" borrow_slowest_name=");
            builder.append_valid_utf8(store.symbols.text(store.defs.get(slowest_def).name.symbol));
        }
    }
    builder.append_valid_utf8(" borrow_slowest_ms=");
    builder.append(timing.slowest_function_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_slowest_blocks=");
    builder.append(timing.slowest_blocks);
    builder.append_valid_utf8(" borrow_slowest_locals=");
    builder.append(timing.slowest_locals);
    builder.append_valid_utf8(" borrow_slowest_move_paths=");
    builder.append(timing.slowest_move_paths);
    builder.append_valid_utf8(" borrow_slowest_loans=");
    builder.append(timing.slowest_loans);
    builder.append_valid_utf8(" borrow_slowest_region_value_loans=");
    builder.append(timing.slowest_region_value_loans);
    builder.append_valid_utf8(" borrow_move_paths_ms=");
    builder.append(timing.move_paths_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_liveness_facts_ms=");
    builder.append(timing.liveness_facts_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_liveness_solve_ms=");
    builder.append(timing.liveness_solve_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_dataflow_ms=");
    builder.append(timing.dataflow_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_dataflow_clone_ms=");
    builder.append(timing.dataflow_clone_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_dataflow_check_ms=");
    builder.append(timing.dataflow_check_ns / UInt64(1000000));
    builder.append_valid_utf8(" borrow_dataflow_merge_ms=");
    builder.append(timing.dataflow_merge_ns / UInt64(1000000));
    system_io.stderr().write_all(builder.slice());
    system_io.stderr().write_all("\n");
}
