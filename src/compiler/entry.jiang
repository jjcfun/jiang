#doc(module)
    编译入口的角色及稳定编码，由语法、语义和产物读写共享；名称解析与入口契约由对应阶段检查。
#end

public enum Kind {
    main,
    lang,
    generate,
}

public Int persistent_tag(Kind? kind) {
    guard kind is .some(value) else { return 0; }
    switch (value) {
        .main => { return 1; }
        .lang => { return 2; }
        .generate => { return 3; }
    }
}

public Kind? from_persistent_tag(Int tag) {
    if (tag == 1) { return Kind.main; }
    if (tag == 2) { return Kind.lang; }
    if (tag == 3) { return Kind.generate; }
    return null;
}
