#doc(module)
    解析包身份、本地依赖和具名生成任务；生成配置严格校验，不加载未选择任务的源码。
#end

alias list = import "../support/list.jiang";
alias fs = import "../system/fs.jiang";
alias ident = import "../support/ident.jiang";
alias string = import "../support/string.jiang";
import std;

@region(a)
public struct PackageDependency: Copyable {
    @life(a)
    public UInt8[]& name;

    @life(a)
    public UInt8[]& path;
}

enum Section: Copyable {
    unknown,
    package_fields,
    dependencies,
    generate(Int index),
    lang(Int index),
}

@region(a)
public struct GenerateTask: Copyable {
    @life(a)
    public UInt8[]& name;
    @life(a)
    public UInt8[]& module!;
    @life(a)
    public UInt8[]& root!;

    public init(self, UInt8[]& name) {
        self.name = name;
        self.module = "";
        self.root = "";
    }
}

#doc name 为空时表示 Provider 自身声明，其余为 host 对直接依赖别名的整组覆盖。
@region(a)
public struct LangExtensions: Copyable {
    @life(a)
    public UInt8[]& name;
    @life(a)
    public UInt8[]& extensions!;

    public init(self, UInt8[]& name) { self.name = name; self.extensions = ""; }
}

@region(a)
public struct PackageManifest: Movable {
    @life(a)
    public UInt8[]& name!;
    public std.String root!;
    @life(a)
    public UInt8[]& version!;

    @life(a)
    public UInt8[]& package_type!;
    @life(a)
    public list.ArrayList<PackageDependency> dependencies!;
    @life(a)
    public list.ArrayList<GenerateTask> generate_tasks!;
    @life(a)
    public list.ArrayList<LangExtensions> lang_extensions!;
    public Bool ok!;
    @life(a)
    public UInt8[]& error!;

    public init(self, UInt8[]& package_dir) {
        self.name = basename(package_dir);
        self.root = "";
        self.version = "";
        self.package_type = "lib";
        self.dependencies = list.ArrayList<PackageDependency>();
        self.generate_tasks = list.ArrayList<GenerateTask>();
        self.lang_extensions = list.ArrayList<LangExtensions>();
        self.ok = true;
        self.error = "";
    }

    #doc 空名查询 Provider 声明；别名查询 host 覆盖，空结果表示未配置。
    public UInt8[]& extensions_for(self, UInt8[]& name) {
        Int index! = 0;
        while (index < self.lang_extensions.len()) {
            LangExtensions mapping = self.lang_extensions.get(index);
            if (string.equal(mapping.name, name)) { return mapping.extensions; }
            index = index + 1;
        }
        return "";
    }

    public UInt8[]& dependency_path(self, UInt8[]& name) {
        Int index! = 0;
        while (index < self.dependencies.len()) {
            PackageDependency dependency = self.dependencies.get(index);
            if (string.equal(dependency.name, name)) {
                return dependency.path;
            }
            index = index + 1;
        }
        return "";
    }
}

@life()
public PackageManifest parse(UInt8[]& package_dir, UInt8[]& text) {
    PackageManifest manifest! = PackageManifest(package_dir);

    Section section! = .unknown;
    Int line_start! = 0;
    while (line_start <= text.length) {
        Int line_end! = line_start;
        Bool escaped_newline! = false;
        while (line_end < text.length && text[line_end] != UInt8(10)) {
            if (line_end + 1 < text.length && text[line_end] == UInt8(92) && text[line_end + 1] == UInt8(110)) {
                escaped_newline = true;
                break;
            }
            line_end = line_end + 1;
        }

        UInt8[]& line = trim(strip_comment(text[line_start..line_end]));
        if (escaped_newline) {
            line_start = line_end + 2;
        } else {
            line_start = line_end + 1;
        }

        if (line.length == 0) {
            continue;
        }
        if (is_section_header(line)) {
            section = parse_section(manifest$.mut_ref(), line[1..line.length - 1]);
            if (!manifest.ok) { return manifest; }
            continue;
        }

        if (line.length >= 9 && string.equal(line[0..9], "[generate")) {
            manifest.ok = false;
            manifest.error = "invalid generate section header";
            return manifest;
        }
        if (line.length >= 5 && string.equal(line[0..5], "[lang")) {
            manifest.ok = false;
            manifest.error = "invalid lang section header";
            return manifest;
        }
        parse_line(manifest$.mut_ref(), section, line);
        if (!manifest.ok) {
            return manifest;
        }
    }

    Int task_index! = 0;
    while (task_index < manifest.generate_tasks.len()) {
        if (manifest.generate_tasks.get(task_index).module.length == 0) {
            manifest.ok = false;
            manifest.error = "generate task requires module";
            return manifest;
        }
        task_index = task_index + 1;
    }
    if (!validate_lang_extensions(manifest$.mut_ref())) { return manifest; }
    if (!ident.is_ident_name(manifest.name)) {
        manifest.ok = false;
        manifest.error = "package name must follow identifier rules";
        return manifest;
    }
    if (manifest.root.byte_length() == 0) {
        std.StringBuilder builder! = std.StringBuilder();
        builder.append_valid_utf8(manifest.name);
        builder.append(".jiang");
        manifest.root = builder.into_string();
    }
    if (!package_type_valid(manifest.package_type)) {
        manifest.ok = false;
        manifest.error = "package type is invalid";
        return manifest;
    }
    return manifest;
}

public Path manifest_path(UInt8[]& package_dir) {
    return std.path.join(package_dir, "package.ini");
}

public PackageManifest read(UInt8[]& package_dir) {
    Path package_ini = manifest_path(package_dir);
    UInt8[]&? loaded = fs.read_all(package_ini.bytes());
    guard loaded is .some(text) else {
        PackageManifest manifest! = PackageManifest(package_dir);
        manifest.ok = false;
        manifest.error = "failed to read package.ini";
        return manifest;
    }
    return parse(package_dir, text);
}

public Bool exists(UInt8[]& package_dir) {
    Path path = manifest_path(package_dir);
    return fs.read_all(path.bytes()) != null;
}

public UInt8[]& find_enclosing_dir(UInt8[]& source_path) {
    UInt8[]& dir! = std.path.dirname(source_path);
    while (true) {
        if (dir.length == 0) {
            if (exists(".")) { return "."; }
            return "";
        }
        if (exists(dir)) {
            return dir;
        }
        UInt8[]& parent = std.path.dirname(dir);
        if (string.equal(parent, dir)) {
            return "";
        }
        dir = parent;
    }
    return "";
}

public Path root_file_path(UInt8[]& package_dir, PackageManifest& manifest) {
    Path joined = std.path.join(package_dir, manifest.root.bytes());
    return std.path.normalize(joined.bytes());
}

Section parse_section(PackageManifest&! manifest, UInt8[]& name) {
    if (string.equal(name, "lang")) { return parse_lang_section(manifest, ""); }
    if (name.length >= 5 && string.equal(name[0..5], "lang.")) {
        UInt8[]& alias_name = name[5..name.length];
        if (!ident.is_ident_name(alias_name)) {
            manifest.ok = false;
            manifest.error = "lang override requires a dependency alias";
            return .unknown;
        }
        return parse_lang_section(manifest, alias_name);
    }
    if (string.equal(name, "package")) { return .package_fields; }
    if (string.equal(name, "dependencies")) { return .dependencies; }
    if (string.equal(name, "generate")) {
        manifest.ok = false;
        manifest.error = "generate section requires a task name";
        return .unknown;
    }
    if (name.length < 9 || !string.equal(name[0..9], "generate.")) { return .unknown; }
    UInt8[]& task_name = name[9..name.length];
    if (!ident.is_ident_name(task_name)) {
        manifest.ok = false;
        manifest.error = "generate task name must follow identifier rules";
        return .unknown;
    }
    Int index! = 0;
    while (index < manifest.generate_tasks.len()) {
        if (string.equal(manifest.generate_tasks.get(index).name, task_name)) {
            manifest.ok = false;
            manifest.error = "duplicate generate task";
            return .unknown;
        }
        index = index + 1;
    }
    manifest.generate_tasks.add(GenerateTask(task_name));
    return .generate(index);
}

Void parse_line(PackageManifest&! manifest, Section section, UInt8[]& line) {
    Int eq_index = find_equal(line);
    if (eq_index < 0) {
        if (section is .lang(_)) {
            manifest.ok = false;
            manifest.error = "lang entry requires key = value";
        }
        if (section is .generate(_)) {
            manifest.ok = false;
            manifest.error = "generate entry requires key = value";
        }
        return;
    }
    UInt8[]& key = trim(line[0..eq_index]);
    UInt8[]& value = trim(unquote(trim(line[eq_index + 1..line.length])));
    if (section is .package_fields) { parse_package_entry(manifest, key, value); return; }
    if (section is .dependencies) { parse_dependency_entry(manifest, key, value); return; }
    if (section is .generate(index)) { parse_generate_entry(manifest, index, key, value); }
    if (section is .lang(index)) { parse_lang_entry(manifest, index, key, value); }
}

Void parse_generate_entry(PackageManifest&! manifest, Int index, UInt8[]& key, UInt8[]& value) {
    if (!string.equal(key, "module") && !string.equal(key, "root")) {
        manifest.ok = false;
        manifest.error = "unknown generate task field";
        return;
    }
    if (!path_text_valid(value)) {
        manifest.ok = false;
        manifest.error = "generate task path is invalid";
        return;
    }
    GenerateTask task! = manifest.generate_tasks.get(index);
    Bool duplicate = if (string.equal(key, "module")) { task.module.length != 0 } else { task.root.length != 0 };
    if (duplicate) {
        manifest.ok = false;
        manifest.error = "duplicate generate task field";
        return;
    }
    if (string.equal(key, "module")) { task.module = value; } else { task.root = value; }
    manifest.generate_tasks.set(index, task);
}

Void parse_package_entry(PackageManifest&! manifest, UInt8[]& key, UInt8[]& value) {
    if (string.equal(key, "name")) {
        if (!ident.is_ident_name(value)) {
            manifest.ok = false;
            manifest.error = "package name must follow identifier rules";
            return;
        }
        manifest.name = value;
        return;
    }
    if (string.equal(key, "root")) {
        if (!path_text_valid(value)) {
            manifest.ok = false;
            manifest.error = "package root path is invalid";
            return;
        }
        manifest.root = try std.String.from_utf8(value) catch {
            manifest.ok = false;
            manifest.error = "package root path must be valid UTF-8";
            return;
        };
        return;
    }
    if (string.equal(key, "version")) {
        if (!version_text_valid(value)) {
            manifest.ok = false;
            manifest.error = "package version is invalid";
            return;
        }
        manifest.version = value;
        return;
    }
    if (string.equal(key, "type")) {
        if (!package_type_valid(value)) {
            manifest.ok = false;
            manifest.error = "package type is invalid";
            return;
        }
        manifest.package_type = value;
    }
}

Void parse_dependency_entry(PackageManifest&! manifest, UInt8[]& key, UInt8[]& value) {
    if (!ident.is_ident_name(key)) {
        manifest.ok = false;
        manifest.error = "dependency name must follow identifier rules";
        return;
    }
    if (!path_text_valid(value)) {
        manifest.ok = false;
        manifest.error = "dependency path is invalid";
        return;
    }
    manifest.dependencies.add(PackageDependency (name: key, path: value));
}

Bool is_section_header(UInt8[]& line) {
    return line.length >= 2 && line[0] == UInt8(91) && line[line.length - 1] == UInt8(93);
}

Int find_equal(UInt8[]& line) {
    Int index! = 0;
    while (index < line.length) {
        if (line[index] == UInt8(61)) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

UInt8[]& trim(UInt8[]& text) {
    Int start! = 0;
    Int end! = text.length;
    while (start < end && is_space(text[start])) {
        start = start + 1;
    }
    while (end > start && is_space(text[end - 1])) {
        end = end - 1;
    }
    return text[start..end];
}

UInt8[]& strip_comment(UInt8[]& text) {
    Int index! = 0;
    while (index < text.length) {
        if (text[index] == UInt8(35) || text[index] == UInt8(59)) {
            return text[0..index];
        }
        index = index + 1;
    }
    return text;
}

UInt8[]& unquote(UInt8[]& text) {
    if (text.length >= 2 && text[0] == UInt8(34) && text[text.length - 1] == UInt8(34)) {
        return text[1..text.length - 1];
    }
    if (
        text.length >= 4
        && text[0] == UInt8(92)
        && text[1] == UInt8(34)
        && text[text.length - 2] == UInt8(92)
        && text[text.length - 1] == UInt8(34)
    ) {
        return text[2..text.length - 2];
    }
    return text;
}

Bool path_text_valid(UInt8[]& path) {
    if (path.length == 0) {
        return false;
    }
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == UInt8(92)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool version_text_valid(UInt8[]& text) {
    if (text.length == 0) {
        return false;
    }
    Int index! = 0;
    while (index < text.length) {
        UInt8 ch = text[index];
        if (!is_alpha_num(ch) && ch != UInt8(46) && ch != UInt8(95) && ch != UInt8(43) && ch != UInt8(45)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool package_type_valid(UInt8[]& text) {
    return string.equal(text, "bin") || string.equal(text, "lib") || string.equal(text, "lang");
}

Bool is_space(UInt8 value) {
    return value == UInt8(32) || value == UInt8(9) || value == UInt8(13);
}

Bool is_alpha_num(UInt8 value) {
    if (value >= UInt8(48) && value <= UInt8(57)) {
        return true;
    }
    if (value >= UInt8(65) && value <= UInt8(90)) {
        return true;
    }
    return value >= UInt8(97) && value <= UInt8(122);
}

UInt8[]& basename(UInt8[]& path) {
    Int end! = path.length;
    while (end > 1 && path[end - 1] == UInt8(47)) {
        end = end - 1;
    }

    Int start! = 0;
    Int index! = 0;
    while (index < end) {
        if (path[index] == UInt8(47)) {
            start = index + 1;
        }
        index = index + 1;
    }
    return path[start..end];
}

#doc 扩展名列表只保留原始 manifest 的借用，供校验与 Provider 注册共用分隔规则。
@life()
public list.ArrayList<UInt8[]&> split_extensions(UInt8[]& text) {
    list.ArrayList<UInt8[]&> parts! = list.ArrayList<UInt8[]&>();
    Int start! = 0;
    Int index! = 0;
    while (index <= text.length) {
        if (index == text.length || text[index] == UInt8(44)) {
            parts.add(trim(text[start..index]));
            start = index + 1;
        }
        index = index + 1;
    }
    return parts;
}

Section parse_lang_section(PackageManifest&! manifest, UInt8[]& name) {
    Int index! = 0;
    while (index < manifest.lang_extensions.len()) {
        if (string.equal(manifest.lang_extensions.get(index).name, name)) {
            manifest.ok = false;
            manifest.error = "duplicate lang section";
            return .unknown;
        }
        index = index + 1;
    }
    manifest.lang_extensions.add(LangExtensions(name));
    return .lang(index);
}

Void parse_lang_entry(PackageManifest&! manifest, Int index, UInt8[]& key, UInt8[]& value) {
    if (!string.equal(key, "extensions")) {
        manifest.ok = false;
        manifest.error = "unknown lang field";
        return;
    }
    if (manifest.lang_extensions.get(index).extensions.length != 0) {
        manifest.ok = false;
        manifest.error = "duplicate lang extensions field";
        return;
    }
    if (!extensions_valid(value)) {
        manifest.ok = false;
        manifest.error = "invalid or duplicate lang extension; jiang is reserved";
        return;
    }
    LangExtensions mapping! = manifest.lang_extensions.get(index);
    mapping.extensions = value;
    manifest.lang_extensions.set(index, mapping);
}

Bool extensions_valid(UInt8[]& value) {
    list.ArrayList<UInt8[]&> parts = split_extensions(value);
    Int index! = 0;
    while (index < parts.len()) {
        UInt8[]& part = parts.get(index);
        if (!ident.is_ident_name(part) || string.equal(part, "jiang")) { return false; }
        Int previous! = 0;
        while (previous < index) {
            if (string.equal(parts.get(previous), part)) { return false; }
            previous = previous + 1;
        }
        index = index + 1;
    }
    return true;
}

Bool validate_lang_extensions(PackageManifest&! manifest) {
    Int index! = 0;
    while (index < manifest.lang_extensions.len()) {
        LangExtensions mapping = manifest.lang_extensions.get(index);
        if (mapping.extensions.length == 0) {
            manifest.ok = false;
            manifest.error = "lang section requires extensions";
            return false;
        }
        if (mapping.name.length == 0 && !string.equal(manifest.package_type, "lang")) {
            manifest.ok = false;
            manifest.error = "provider extensions require package type lang";
            return false;
        }
        if (mapping.name.length != 0 && manifest.dependency_path(mapping.name).length == 0) {
            manifest.ok = false;
            manifest.error = "lang override requires a declared dependency";
            return false;
        }
        index = index + 1;
    }
    return true;
}
