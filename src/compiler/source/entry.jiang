#doc(module)
    加载源码或包入口身份；原生包保留配置目录，重复编译时据此重新求值并选择 root。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias fs = import "../system/fs.jiang";
alias package_load = import "./package_load.jiang";
alias resolver_api = import "../resolve/module_resolver.jiang";
alias analysis = import "../analysis.jiang";
alias source = import "../source.jiang";
alias store_api = import "../store.jiang";
alias string = import "../support/string.jiang";
import std;

public struct Entry: Movable {
    public source.SourceId source_id;
    public UInt8[]^ text!;
    public Bool ok!;

    public init(self, source.SourceId source_id, UInt8[]^ text, Bool ok) {
        self.source_id = source_id;
        self.text = text;
        self.ok = ok;
    }

}

public struct PackageHandle: Movable {
    public Path root_path;
    public std.String configuration_directory;
    public Bool ok!;

    public init(self, Path root_path, Bool ok, UInt8[]& configuration_directory = "") {
        self.root_path = root_path;
        self.configuration_directory = std.String.from_valid_utf8(configuration_directory);
        self.ok = ok;
    }
}

public PackageHandle load_package(context.CompilerContext&! ctx, UInt8[]& input_path) {
    if (package_load.exists(input_path)) {
        resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(analysis.evaluate_source_expression,
            ctx.lang_cache_dir.bytes(), null, false, ctx.lang_mode);
        return package_load.load(ctx, resolver$.mut_ref(), input_path);
    }
    if (fs.dir_exists(input_path)) {
        diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(),
            "package directory requires package.jiang", "package_configuration_missing");
        return PackageHandle(Path(""), false);
    }
    return PackageHandle(std.path.normalize(input_path), true);
}

public Entry read_root(context.CompilerContext&! ctx, PackageHandle& package) {
    if (!package.ok) { return Entry(source.SourceId(), empty_text(), false); }
    UInt8[]& root_text = package.root_path.bytes();
    guard ctx.store.sources.load_path_text(root_text) is .some(loaded) else {
        std.String message = string.concat("failed to read source file: ", root_text);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            message.bytes(),
            "source_file_not_found"
        );
        return Entry(source.SourceId(), empty_text(), false);
    }
    UInt8[]^ text! = loaded;
    store_api.CompilerStore&! store = ctx.store$.mut_ref();
    source.SourceId source_id = store.intern_source_path(
        root_text,
        text[..]
    );
    return Entry(source_id, text$.move(), true);
}

UInt8[]^ empty_text() {
    std.StringBuilder builder = std.StringBuilder();
    return builder.into_slice();
}
