#doc(module)
    可选阶段测量与统一 stderr 报告。关闭统计时不读取时钟；不影响阶段调度与结果。
#end
alias time = import "../system/time.jiang";
alias io = import "../system/io.jiang";
import std;

public UInt64 start(Bool enabled) {
    if (!enabled) { return UInt64(0); }
    return time.monotonic_time_ns();
}

public UInt64 report(Bool enabled, UInt8[]& stage, UInt64 started) {
    if (!enabled) { return UInt64(0); }
    UInt64 finished = time.monotonic_time_ns();
    std.StringBuilder line! = std.StringBuilder();
    line.append("profile_stage=");
    line.append(stage);
    line.append(" elapsed_us=");
    line.append((finished - started) / UInt64(1000));
    line.append("\n");
    io.stderr().write_all(line.slice());
    return finished;
}
