// Arena 管理编译器阶段内的字节块，并只向调用方暴露稳定的分配地址。

import list = "./list.jiang";

struct ArenaBlock: Copyable {
    UInt8*! data!;
    Int capacity!;
    Int used!;

    init(self, Int capacity) {
        self.data = unsafe {
            UInt8$.alloc(capacity)
        };
        self.capacity = capacity;
        self.used = 0;
    }
}

public struct Arena: Movable {
    list.ArrayList<ArenaBlock> blocks!;
    Int current_index!;
    Int block_size!;

    public init(self) {
        self.blocks = list.ArrayList<ArenaBlock>();
        self.current_index = -1;
        self.block_size = 4096;
    }

    public Void reset(Self&! self) {
        Int index! = 0;
        while (index < self.blocks.len()) {
            ArenaBlock&! block = self.blocks.mut_ref_at(index);
            block.used = 0;
            index = index + 1;
        }
        if (self.blocks.len() == 0) {
            self.current_index = -1;
            return;
        }
        self.current_index = 0;
    }

    ArenaBlock create_block(self, Int capacity) {
        return ArenaBlock(capacity);
    }

    Int align_up(self, Int value, Int align) {
        assert(value >= 0 && align > 0);
        if (align <= 1) {
            return value;
        }

        Int remainder! = value % align;
        if (remainder == 0) {
            return value;
        }
        return self.checked_add(value, align - remainder);
    }

    Int checked_add(self, Int left, Int right) {
        assert(left >= 0 && right >= 0);
        Int result = left + right;
        assert(result >= left);
        return result;
    }

    Int checked_multiply(self, Int left, Int right) {
        assert(left >= 0 && right >= 0);
        if (left == 0 || right == 0) {
            return 0;
        }
        Int result = left * right;
        assert(result > 0 && result / left == right);
        return result;
    }

    Int max_int(self, Int left, Int right) {
        if (left > right) {
            return left;
        }
        return right;
    }

    Bool block_fits(self, ArenaBlock& block, Int size, Int align) {
        Int start! = self.align_up(block.used, align);
        if (start > block.capacity) {
            return false;
        }
        return size <= block.capacity - start;
    }
    ArenaBlock&! ensure_block(Self&! self, Int size, Int align) {
        Int index! = self.current_index;
        if (index < 0) {
            index = 0;
        }

        while (index < self.blocks.len()) {
            ArenaBlock candidate = self.blocks.get(index);
            if (self.block_fits(candidate$.ref(), size, align)) {
                self.current_index = index;
                return self.blocks.mut_ref_at(index);
            }
            index = index + 1;
        }

        Int capacity! = self.max_int(self.block_size, self.checked_add(size, align));
        ArenaBlock block = self.create_block(capacity);
        self.blocks.add(block);
        self.current_index = self.blocks.len() - 1;
        return self.blocks.mut_ref_at(self.current_index);
    }

    // allocation 只修改 allocator metadata，已返回的地址永不移动或改写。
    // Arena 不实现 Sendable，因此这里的内部可变性不会跨 Domain 并发访问。
    public UInt8*! alloc_bytes(self, Int size, Int align) {
        Self&! owner = unsafe { self$.ptr()$.as(Self&!) };
        return owner.alloc_bytes_mut(size, align);
    }

    UInt8*! alloc_bytes_mut(Self&! self, Int size, Int align) {
        Int actual_size! = size;
        Int actual_align! = align;

        if (actual_size <= 0) {
            actual_size = 1;
        }
        if (actual_align <= 0) {
            actual_align = 1;
        }
        assert(actual_align <= UInt8$.max_align());

        ArenaBlock&! block = self.ensure_block(actual_size, actual_align);
        Int start! = self.align_up(block.used, actual_align);
        block.used = self.checked_add(start, actual_size);
        UInt8*! result = unsafe {
            block.data[start]$.ptr()$.as(UInt8*!)
        };
        return result;
    }

    public T*! alloc<T>(self) {
        UInt8*! bytes = self.alloc_bytes(T$.size(), T$.align());
        return unsafe {
            bytes$.as(T*!)
        };
    }

    public T*! create<T>(self, T value) {
        UInt8*! bytes = self.alloc_bytes(T$.size(), T$.align());
        T*! slot = unsafe {
            bytes$.as(T*!)
        };
        slot$.set(value);
        return slot;
    }

    @life(return: self & value)
    public T& create_ref<T>(self, T value) {
        T*! slot = self.create(value);
        return unsafe { slot$.as(T&) };
    }

    public T*! alloc_array<T>(self, Int count) {
        if (count <= 0) {
            return null;
        }
        Int byte_size = self.checked_multiply(T$.size(), count);
        UInt8*! bytes = self.alloc_bytes(byte_size, T$.align());
        return unsafe {
            bytes$.as(T*!)
        };
    }

    public Int used_bytes(self) {
        Int total! = 0;
        Int index! = 0;
        while (index < self.blocks.len()) {
            total = total + self.blocks.get(index).used;
            index = index + 1;
        }
        return total;
    }

    public Int reserved_bytes(self) {
        Int total! = 0;
        Int index! = 0;
        while (index < self.blocks.len()) {
            total = total + self.blocks.get(index).capacity;
            index = index + 1;
        }
        return total;
    }

    deinit(self) {
        Int index! = 0;
        while (index < self.blocks.len()) {
            ArenaBlock& block = self.blocks.ref_at(index);
            unsafe {
                block.data?$.dealloc();
            }
            index = index + 1;
        }
    }
}
