#doc(module)
    将所选 package 生成配置解析为拥有独立路径的任务；只定位输入与生成器，不加载语义或执行代码。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias options_api = import "../driver/options.jiang";
alias manifest_api = import "../source/package_manifest.jiang";
alias source_entry = import "../source/entry.jiang";
alias ident = import "../support/ident.jiang";
alias string = import "../support/string.jiang";
import std;

public struct Task: Movable {
    public Path input;
    public Path generator;
    public Path output;

    public init(self, Path input, Path generator, Path output) {
        self.input = input;
        self.generator = generator;
        self.output = output;
    }
}

#doc 显式源码覆盖配置 root；配置路径相对包目录，CLI 路径相对工作目录，依赖别名始终属于输入包。
public Task? select(
    context.CompilerContext&! ctx, source_entry.PackageHandle& package, options_api.CompileOptions& options
) {
    Bool package_input = manifest_api.exists(options.input_path);
    UInt8[]& package_dir = manifest_api.find_enclosing_dir(package.root_path.bytes());
    if (package_input) {
        manifest_api.PackageManifest manifest = manifest_api.read(options.input_path);
        return select_manifest(ctx, options.input_path, manifest$.ref(), package, options, true);
    }
    if (package_dir.length != 0) {
        manifest_api.PackageManifest manifest = manifest_api.read(package_dir);
        return select_manifest(ctx, package_dir, manifest$.ref(), package, options, false);
    }
    if (options.generate_name.length != 0) {
        fail(ctx, "named generation requires package.ini");
        return null;
    }
    if (options.generator.length == 0) {
        fail(ctx, "generation requires a configured task or --generator");
        return null;
    }
    source_entry.PackageHandle generator = source_entry.load_package(ctx, options.generator);
    if (!generator.ok) { return null; }
    return Task(std.path.normalize(package.root_path.bytes()), generator.root_path$.move(), output_path(".", "default", options));
}

#doc 只选择一个具名配置，不隐式组合多个任务；入口覆盖仍需明确多配置中的输入 root。
public Task? select_manifest(
    context.CompilerContext&! ctx, UInt8[]& package_dir, manifest_api.PackageManifest& manifest,
    source_entry.PackageHandle& package, options_api.CompileOptions& options, Bool package_input
) {
    if (!manifest.ok) { fail(ctx, manifest.error); return null; }
    Int selected! = -1;
    Int index! = 0;
    while (index < manifest.generate_tasks.len()) {
        if (string.equal(manifest.generate_tasks.get(index).name, options.generate_name)) { selected = index; }
        index = index + 1;
    }
    if (options.generate_name.length != 0 && selected < 0) {
        fail(ctx, "unknown generate task name");
        return null;
    }
    if (options.generate_name.length == 0 && manifest.generate_tasks.len() > 1) {
        fail(ctx, "multiple generate tasks require --name");
        return null;
    }
    if (selected < 0 && manifest.generate_tasks.len() == 1) { selected = 0; }
    UInt8[]& module! = options.generator;
    UInt8[]& name! = "default";
    Path input! = std.path.normalize(package.root_path.bytes());
    if (selected >= 0) {
        manifest_api.GenerateTask task = manifest.generate_tasks.get(selected);
        name = task.name;
        if (module.length == 0) { module = task.module; }
        if (package_input && task.root.length != 0) { input = std.path.join(package_dir, task.root); }
    }
    if (module.length == 0) {
        fail(ctx, "generation requires a configured task or --generator");
        return null;
    }
    guard generator_path(ctx, package_dir, manifest, module, options.generator.length != 0) is .some(generator) else {
        return null;
    }
    return Task(input, generator, output_path(package_dir, name, options));
}

#doc 标识符只表示依赖别名；路径可指定源码或包目录，依赖包使用自己的 root。
Path? generator_path(
    context.CompilerContext&! ctx, UInt8[]& package_dir, manifest_api.PackageManifest& manifest,
    UInt8[]& module, Bool cli_path
) {
    Path path! = std.path.normalize(module);
    if (ident.is_ident_name(module)) {
        UInt8[]& dependency = manifest.dependency_path(module);
        if (dependency.length == 0) { fail(ctx, "unknown generator dependency alias"); return null; }
        path = std.path.join(package_dir, dependency);
    } else if (!cli_path) {
        path = std.path.join(package_dir, module);
    }
    source_entry.PackageHandle loaded = source_entry.load_package(ctx, path.bytes());
    if (!loaded.ok) { return null; }
    return loaded.root_path$.move();
}

Path output_path(UInt8[]& package_dir, UInt8[]& name, options_api.CompileOptions& options) {
    if (options.output_path.length != 0) { return std.path.normalize(options.output_path); }
    Path generated = std.path.join(package_dir, "build/generated");
    return std.path.join(generated.bytes(), name);
}

Void fail(context.CompilerContext&! ctx, UInt8[]& message) {
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(), message, "generate_configuration_invalid");
}
