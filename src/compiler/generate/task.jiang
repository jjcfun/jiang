#doc(module)
    解析本包默认入口及命名生成器来源；输入固定为本包 root，不加载语义或执行代码。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias options_api = import "../driver/options.jiang";
alias manifest_api = import "../source/package_manifest.jiang";
alias source_entry = import "../source/entry.jiang";
alias string = import "../support/string.jiang";
import std;

public struct Task: Movable {
    public Path input;
    public Path generator;
    public Path output;

    public init(self, Path input, Path generator, Path output) {
        self.input = input;
        self.generator = generator;
        self.output = output;
    }
}

#doc 默认使用本包 root；命名入口引用依赖或内部文件，同名生成配置优先于 Lang 别名。
public Task? select(
    context.CompilerContext&! ctx, source_entry.PackageHandle& package, options_api.CompileOptions& options
) {
    UInt8[]& package_dir = manifest_api.find_enclosing_dir(package.root_path.bytes());
    if (package_dir.length == 0) {
        fail(ctx, "generation requires a package root");
        return null;
    }
    manifest_api.PackageManifest manifest = manifest_api.read(package_dir);
    if (!manifest.ok) { fail(ctx, manifest.error); return null; }
    Path input = manifest_api.root_file_path(package_dir, manifest$.ref());
    Path generator! = std.path.normalize(input.bytes());
    if (options.generate_name.length != 0) {
        UInt8[]& dependency! = "";
        UInt8[]& module! = "";
        for task in manifest.generate_tasks.slice() {
            if (string.equal(task.name, options.generate_name)) {
                dependency = task.package; module = task.module;
            }
        }
        if (dependency.length == 0 && module.length == 0) {
            for lang in manifest.lang_extensions.slice() {
                if (string.equal(lang.name, options.generate_name)) {
                    dependency = if lang.package.length != 0 { lang.package } else { lang.name };
                }
            }
        }
        if (dependency.length == 0 && module.length == 0) {
            fail(ctx, "unknown generate alias; declare it in package.ini");
            return null;
        }
        Path path = std.path.join(package_dir,
            if dependency.length != 0 { manifest.dependency_path(dependency) } else { module });
        if (dependency.length != 0 && !manifest_api.exists(path.bytes())) {
            fail(ctx, "generator dependency requires package.ini");
            return null;
        }
        if (module.length != 0) {
            Path local = std.path.normalize(module);
            UInt8[]& bytes = local.bytes();
            if (std.path.is_absolute(bytes) || string.equal(bytes, "..")
                || (bytes.length >= 3 && string.equal(bytes[0..3], "../")) || manifest_api.exists(path.bytes())) {
                fail(ctx, "generator module must be a file inside the package");
                return null;
            }
        }
        source_entry.PackageHandle loaded = source_entry.load_package(ctx, path.bytes());
        if (!loaded.ok) { return null; }
        generator = loaded.root_path$.move();
    }
    Path output = if options.output_path.length != 0 { std.path.normalize(options.output_path) }
        else { std.path.join(package_dir, "build/generated") };
    return Task(input, generator, output);
}

Void fail(context.CompilerContext&! ctx, UInt8[]& message) {
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(), message, "generate_configuration_invalid");
}
