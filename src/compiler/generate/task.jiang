#doc(module)
    解析本包默认入口及命名生成器来源；输入固定为本包 root，不加载语义或执行代码。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias options_api = import "../driver/options.jiang";
alias source_entry = import "../source/entry.jiang";
alias package_load = import "../source/package_load.jiang";
alias qid = import "../id.jiang";
alias value = import "../sema/comptime/value.jiang";
alias string = import "../support/string.jiang";
import std;

public struct Task: Movable {
    public Path input;
    public Path generator;
    public Path output;

    public init(self, Path input, Path generator, Path output) {
        self.input = input;
        self.generator = generator;
        self.output = output;
    }
}

#doc 从已求值包信息选择默认或命名入口；生成始终以显式加载的包 root 为输入。
public Task? select(
    context.CompilerContext&! ctx, source_entry.PackageHandle& package, options_api.CompileOptions& options
) {
    if (package.configuration_directory.byte_length() == 0) {
        fail(ctx, "generation requires an explicitly loaded package");
        return null;
    }
    UInt8[]& directory = package.configuration_directory.bytes();
    _ symbol = ctx.store.symbols.intern(directory);
    _ owner = ctx.store.resolve.package_for_dir(symbol)$.some();
    _ declaration = ctx.store.resolve.package_ref(owner).configuration_info$.some();
    _ info = ctx.store.comptime_store.const_value(declaration)$.some();
    Path generator! = Path(package.root_path.bytes());
    if (options.generate_name.length > 0) {
        guard native_generator(ctx, owner, directory, info, options.generate_name) is .some(path) else { return null; }
        generator = path;
    }
    Path output = if options.output_path.length > 0 { std.path.normalize(options.output_path) }
        else { std.path.join(directory, "build/generated") };
    return Task(Path(package.root_path.bytes()), generator, output);
}

Void fail(context.CompilerContext&! ctx, UInt8[]& message) {
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(), message, "generate_configuration_invalid");
}

Path? native_generator(context.CompilerContext&! ctx, qid.PackageId owner, UInt8[]& directory,
    value.ComptimeValue info, UInt8[]& name) {
    _ task = named_configuration(ctx, info, "generate", name);
    _ mapping = if task != null { task } else { named_configuration(ctx, info, "lang", name) };
    guard mapping is .some(configuration) else {
        fail(ctx, "unknown generate alias; declare it in package.jiang");
        return null;
    }
    _ dependency = package_load.string_field(ctx, configuration, "package")$.some();
    if (task is .some(selected)) {
        _ module = package_load.string_field(ctx, selected, "module")$.some();
        if (ctx.store.symbols.text(module).length > 0) {
            return std.path.join(directory, ctx.store.symbols.text(module));
        }
    }
    _ dependency_name = if ctx.store.symbols.text(dependency).length > 0 { dependency }
        else { ctx.store.symbols.intern(name) };
    guard ctx.store.resolve.package_dependency(owner, dependency_name) is .some(record) else {
        fail(ctx, "generator requires a declared package dependency");
        return null;
    }
    _ target = ctx.store.resolve.package_for_dir(record.path_symbol)$.some();
    return Path(ctx.store.symbols.text(ctx.store.resolve.package_ref(target).root_path));
}

value.ComptimeValue? named_configuration(context.CompilerContext& ctx,
    value.ComptimeValue info, UInt8[]& section, UInt8[]& name) {
    _ values = package_load.field(ctx, info, section)$.some();
    guard values.data is .array_value(items) else { return null; }
    Int index! = 0;
    while (index < ctx.store.comptime_store.item_count(items)) {
        _ item = ctx.store.comptime_store.item_at(items, index);
        _ symbol = package_load.string_field(ctx, item, "name")$.some();
        if (string.equal(ctx.store.symbols.text(symbol), name)) { return item; }
        index = index + 1;
    }
    return null;
}
