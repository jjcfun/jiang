// LLVM 后端稳定入口，接收最终 JIL 并组织 LLVM-specific lowering。
//
// 这个目录是唯一允许承载 LLVM-specific lowering 的地方。上层 backend 只关心
// JIL/package 级输入和 BackendResult；真实 LLVM C binding 只能通过 ffi.jiang
// 访问，不能散落到 pipeline/JIL/layout 或 backend facade。

import context = "../context.jiang";
import diagnostic = "../diagnostic.jiang";
import jil = "../jil.jiang";
import attributes = "../jil/analysis/attributes.jiang";
import codegen_unit = "./codegen_unit.jiang";
import symbol = "./symbol.jiang";
import list = "../support/list.jiang";
import ffi = "./llvm/ffi.jiang";
import llvm_lower = "./llvm/lower.jiang";
import std;

public alias ObjectUnit = llvm_lower.ObjectUnit;

public std.String llvm_version_text() {
    return ffi.llvm_version_text();
}

@life()
public UInt8[]& default_target_triple_text() {
    return ffi.default_target_triple_text();
}

public Void initialize_supported_targets() {
    ffi.initialize_supported_targets();
}

public Bool emit(context.CompilerContext&! ctx, jil.Store& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return false;
    }
    if (!llvm_lower.lower_module(ctx, store)) {
        return false;
    }
    if (ctx.query.layout.has_errors()) {
        return false;
    }
    return store.program.ok;
}

public Bool emit_object(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple,
    Bool position_independent
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return false;
    }
    if (!llvm_lower.emit_object_file(
            ctx,
            store,
            output_path,
            opt_level,
            pass_pipeline,
            link_libc,
            target_triple,
            position_independent
        )
    ) {
        return false;
    }
    if (ctx.query.layout.has_errors()) {
        return false;
    }
    return store.program.ok;
}

public Bool emit_object_for_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    attributes.Mode attribute_mode,
    list.ArrayList<jil.FunctionId>& shared_runtime_functions,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!llvm_lower.emit_object_unit_file(
        ctx,
        store,
        unit,
        attribute_mode,
        shared_runtime_functions,
        output_path,
        opt_level,
        pass_pipeline,
        link_libc,
        target_triple
    )) {
        return false;
    }
    if (ctx.query.layout.has_errors()) {
        return false;
    }
    return store.program.ok;
}

public ObjectUnit^? prepare_object_for_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    attributes.Mode attribute_mode,
    list.ArrayList<jil.FunctionId>& shared_runtime_functions,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    guard llvm_lower.prepare_object_unit(
        ctx,
        store,
        unit,
        attribute_mode,
        shared_runtime_functions,
        output_path,
        opt_level,
        pass_pipeline,
        link_libc,
        target_triple
    ) is .some(object_unit) else {
        return null;
    }
    if (ctx.query.layout.has_errors() || !store.program.ok) { return null; }
    return object_unit;
}

public Bool emit_llvm_ir(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol key", "llvm_duplicate_symbol_key");
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol name", "llvm_duplicate_symbol_name");
        return false;
    }
    if (!llvm_lower.emit_llvm_ir_file(ctx, store, output_path, link_libc, target_triple)) {
        add_codegen_error(ctx, "llvm ir file emission failed", "llvm_ir_emit_failed");
        return false;
    }
    if (ctx.query.layout.has_errors()) {
        add_codegen_error(ctx, "layout error during llvm emission", "llvm_layout_error");
        return false;
    }
    if (!store.program.ok) {
        add_codegen_error(ctx, "JIL store has errors during llvm emission", "llvm_jil_store_error");
    }
    return store.program.ok;
}

@life()
public UInt8[]&? emit_llvm_ir_text(
    context.CompilerContext&! ctx,
    jil.Store& store,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol key", "llvm_duplicate_symbol_key");
        return null;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol name", "llvm_duplicate_symbol_name");
        return null;
    }
    guard llvm_lower.emit_llvm_ir_text(ctx, store, link_libc, target_triple) is .some(text) else {
        add_codegen_error(ctx, "llvm ir text emission failed", "llvm_ir_text_emit_failed");
        return null;
    }
    if (ctx.query.layout.has_errors()) {
        add_codegen_error(ctx, "layout error during llvm emission", "llvm_layout_error");
        return null;
    }
    if (!store.program.ok) {
        add_codegen_error(ctx, "JIL store has errors during llvm emission", "llvm_jil_store_error");
        return null;
    }
    return text;
}

Void add_codegen_error(context.CompilerContext&! ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
