// JIL terminator -> LLVM terminator instruction lowering。
//
// terminator 是 CFG 的唯一出口。本文件只负责 block 之间的跳转、return、
// call terminator 等控制流指令，表达式值统一委托给 value helper。

import jil = "../../jil.jiang";
import instance_reader = "../../jil/instance_reader.jiang";
import qid = "../../id.jiang";
import diagnostic = "../../diagnostic.jiang";
import source = "../../source.jiang";
import source_map = "../../diagnostic/source_map.jiang";
import layout = "../../layout.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import string_support = "../../support/string.jiang";
import symbol = "../symbol.jiang";
import backend_abi = "../abi.jiang";
import sema_drop = "../../sema/drop.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_abi = "./abi.jiang";
import llvm_state = "./state.jiang";
import llvm_place = "./place.jiang";
import llvm_type = "./type.jiang";
import llvm_value = "./value.jiang";
import std;

struct LoweredCallTarget: Movable {
    ffi.Value value;
    backend_abi.FunctionAbi abi!;

    init(self, ffi.Value value, backend_abi.FunctionAbi abi) {
        self.value = value;
        self.abi = abi;
    }
}

public Bool lower_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    backend_abi.FunctionAbi& function_abi,
    ffi.Value llvm_function,
    jil.Terminator& terminator,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (terminator.kind is .goto_term(goto_term)) {
        return ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), blocks.get(goto_term.target.to_index())));
    }
    if (terminator.kind is .branch_term(branch_term)) {
        return lower_branch_terminator(state, output, body, branch_term, blocks, local_slots);
    }
    if (terminator.kind is .switch_term(switch_term)) {
        return lower_switch_terminator(state, output, body, switch_term, blocks, local_slots);
    }
    if (terminator.kind is .call_term(ref _ call_term)) {
        return lower_call_terminator(state, output, body, call_term, blocks, local_slots);
    }
    if (terminator.kind is .return_term(return_term)) {
        return lower_return_terminator(state, output, body, function_abi, llvm_function, return_term, local_slots);
    }
    if (terminator.kind is .unreachable_term(_)) {
        return ffi.value_valid(ffi.builder_build_unreachable(state.builder$.ref()));
    }
    if (terminator.kind is .assert_term(assert_term)) {
        return lower_assert_terminator(
            state, output, body, llvm_function, terminator.span, assert_term, blocks, local_slots
        );
    }
    if (terminator.kind is .drop_term(drop_term)) {
        return lower_semantic_drop_terminator(
            state, output, body, llvm_function, drop_term, blocks, local_slots
        );
    }
    if (terminator.kind is .suspend_pending_term(_)) {
        return ffi.value_valid(ffi.builder_build_unreachable(state.builder$.ref()));
    }
    return ffi.value_valid(ffi.builder_build_unreachable(state.builder$.ref()));
}

Bool lower_semantic_drop_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    jil.DropTerminator drop_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId type_id = state.type_id(
        llvm_place.place_type(state, body, drop_term.place)
    );
    qid.TypeId canonical_type =
        state.ctx.store.types.canonical_substitution_type(type_id);
    ffi.Value pointer = llvm_place.lower_place_pointer(
        state, output, body, drop_term.place, local_slots
    );
    if (!ffi.value_valid(pointer)) { return false; }
    if (drop_term.projection_flags.length == 0) {
        if (!lower_drop_glue_call(state, output, canonical_type, pointer)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_br(
            state.builder$.ref(), blocks.get(drop_term.target.to_index())
        ));
    }
    list.ArrayList<DropFieldStep> path! = list.ArrayList<DropFieldStep>();
    if (projection_flag_for_drop_path(drop_term, path$.ref()) is .some(root_flag)) {
        if (!lower_flagged_partial_drop_field(
            state,
            output,
            body,
            llvm_function,
            drop_term,
            canonical_type,
            pointer,
            root_flag,
            drop_path_has_descendant(drop_term, path$.ref()),
            path$.mut_ref(),
            local_slots
        )) { return false; }
        return ffi.value_valid(ffi.builder_build_br(
            state.builder$.ref(), blocks.get(drop_term.target.to_index())
        ));
    }
    if (!drop_path_has_descendant(drop_term, path$.ref())) {
        if (!lower_drop_glue_call(state, output, canonical_type, pointer)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_br(
            state.builder$.ref(), blocks.get(drop_term.target.to_index())
        ));
    }
    if (!lower_partial_drop_fields(
        state,
        output,
        body,
        llvm_function,
        drop_term,
        canonical_type,
        pointer,
        path$.mut_ref(),
        local_slots
    )) { return false; }
    return ffi.value_valid(ffi.builder_build_br(
        state.builder$.ref(), blocks.get(drop_term.target.to_index())
    ));
}

struct DropFieldStep: Copyable {
    qid.DefId? field_def;
    Int field_index;
}

Bool lower_partial_drop_fields(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    jil.DropTerminator drop_term,
    qid.TypeId owner_type,
    ffi.Value owner_pointer,
    list.ArrayList<DropFieldStep>&! path,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (!partial_drop_type_is_expandable(state, owner_type)) {
        return lower_drop_glue_call(state, output, owner_type, owner_pointer);
    }
    layout.TypeLayout owner_layout = llvm_type.layout_for_type(state, owner_type);
    Int field_index! = 0;
    while (field_index < owner_layout.fields.length) {
        layout.FieldLayout field = owner_layout.fields[field_index];
        guard drop_type_needs_runtime(state, output, field.field_type)
            is .some(needs_drop) else { return false; }
        if (!needs_drop) {
            field_index = field_index + 1;
            continue;
        }
        path.add(DropFieldStep(field_def: field.field_def, field_index: field_index));
        Bool lowered = lower_partial_drop_field(
            state,
            output,
            body,
            llvm_function,
            drop_term,
            owner_type,
            owner_pointer,
            field,
            field_index,
            path,
            local_slots
        );
        path.pop();
        if (!lowered) { return false; }
        field_index = field_index + 1;
    }
    return true;
}

Bool lower_partial_drop_field(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    jil.DropTerminator drop_term,
    qid.TypeId owner_type,
    ffi.Value owner_pointer,
    layout.FieldLayout field,
    Int field_index,
    list.ArrayList<DropFieldStep>&! path,
    list.ArrayList<ffi.Value>& local_slots
) {
    jil.Place? flag = projection_flag_for_drop_path(drop_term, path$.ref());
    Bool has_descendant = drop_path_has_descendant(drop_term, path$.ref());
    ffi.Value field_pointer = llvm_place.lower_layout_field_pointer(
        state, output, owner_pointer, owner_type, field_index
    );
    if (!ffi.value_valid(field_pointer)) { return false; }
    if (flag is .some(flag_place)) {
        return lower_flagged_partial_drop_field(
            state,
            output,
            body,
            llvm_function,
            drop_term,
            field.field_type,
            field_pointer,
            flag_place,
            has_descendant,
            path,
            local_slots
        );
    }
    if (has_descendant) {
        return lower_partial_drop_fields(
            state,
            output,
            body,
            llvm_function,
            drop_term,
            field.field_type,
            field_pointer,
            path,
            local_slots
        );
    }
    return lower_drop_glue_call(state, output, field.field_type, field_pointer);
}

Bool lower_flagged_partial_drop_field(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    jil.DropTerminator drop_term,
    qid.TypeId field_type,
    ffi.Value field_pointer,
    jil.Place flag_place,
    Bool has_descendant,
    list.ArrayList<DropFieldStep>&! path,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value condition = llvm_place.lower_place_value(
        state, output, body, flag_place, local_slots
    );
    ffi.BasicBlock drop_block = ffi.context_append_block(
        state.llvm_context$.ref(), llvm_function, "partial.drop"
    );
    ffi.BasicBlock continue_block = ffi.context_append_block(
        state.llvm_context$.ref(), llvm_function, "partial.drop.continue"
    );
    if (!ffi.value_valid(condition)
        || !ffi.block_valid(drop_block)
        || !ffi.block_valid(continue_block)
    ) { return false; }
    if (!ffi.value_valid(ffi.builder_build_cond_br(
        state.builder$.ref(), condition, drop_block, continue_block
    ))) { return false; }
    ffi.builder_position_at_end(state.builder$.ref(), drop_block);
    Bool lowered! = false;
    if (has_descendant) {
        lowered = lower_partial_drop_fields(
            state,
            output,
            body,
            llvm_function,
            drop_term,
            field_type,
            field_pointer,
            path,
            local_slots
        );
    } else {
        lowered = lower_drop_glue_call(state, output, field_type, field_pointer);
    }
    if (!lowered) { return false; }
    if (!ffi.value_valid(ffi.builder_build_br(
        state.builder$.ref(), continue_block
    ))) { return false; }
    ffi.builder_position_at_end(state.builder$.ref(), continue_block);
    return true;
}

Bool lower_drop_glue_call(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    qid.TypeId type_id,
    ffi.Value pointer
) {
    qid.TypeId canonical_type =
        state.ctx.store.types.canonical_substitution_type(state.type_id(type_id));
    guard drop_type_needs_runtime(state, output, canonical_type)
        is .some(needs_drop) else { return false; }
    if (!needs_drop) { return true; }
    guard state.store.program.drop_glue(canonical_type) is .some(glue_id) else {
        add_backend_error(
            output,
            "semantic drop glue was not generated",
            "llvm_semantic_drop_glue_missing"
        );
        return false;
    }
    jil.Function& glue = state.store.program.functions.ref_at(glue_id.to_index());
    backend_abi.FunctionAbi call_abi! = backend_abi.classify_jil_body(
        state.ctx, glue.body$.ref()
    );
    if (call_abi.result.kind != .none || call_abi.params.len() != 1) {
        add_backend_error(output, "invalid semantic drop glue ABI", "llvm_semantic_drop_glue_abi");
        return false;
    }
    std.String name = symbol.function_symbol_name(state.ctx, state.store, glue);
    ffi.Type function_type = llvm_abi.function_type(state, call_abi$.ref());
    ffi.Value callee! = ffi.module_get_function(state.module$.ref(), name.bytes());
    if (!ffi.value_valid(callee)) {
        callee = ffi.module_add_function(state.module$.ref(), name.bytes(), function_type);
        llvm_abi.add_function_attributes(state, callee, call_abi$.ref());
    }
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
    backend_abi.AbiArg param_abi = call_abi.params.get(0);
    if (param_abi.kind != .none) {
        ffi.Value arg! = pointer;
        if (param_abi.kind != .indirect) {
            ffi.Type value_type = llvm_type.lower_type(state, canonical_type);
            if (!ffi.type_valid(value_type)) { return false; }
            arg = ffi.builder_build_load(state.builder$.ref(), value_type, pointer);
        }
        if (!ffi.value_valid(arg)) {
            add_backend_error(
                output,
                "failed to lower semantic drop glue argument",
                "llvm_semantic_drop_glue_call"
            );
            return false;
        }
        args.add(arg);
    }
    ffi.Value call = ffi.builder_build_call(
        state.builder$.ref(), function_type, callee, args$.ref()
    );
    if (!ffi.value_valid(call)) {
        add_backend_error(output, "failed to build semantic drop glue call", "llvm_semantic_drop_glue_call");
        return false;
    }
    llvm_abi.add_call_attributes(state, call, call_abi$.ref());
    return true;
}

Bool? drop_type_needs_runtime(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    qid.TypeId type_id
) {
    qid.TypeId concrete = state.type_id(type_id);
    guard state.ctx.query.layout.store().drop_category_for_type(concrete)
        is .some(category) else {
        add_backend_error(
            output,
            "semantic drop type was not prepared",
            "llvm_semantic_drop_type_not_prepared"
        );
        return null;
    }
    return sema_drop.drop_category_needs_runtime_drop(category);
}

Bool partial_drop_type_is_expandable(
    llvm_state.LowerState& state,
    qid.TypeId type_id
) {
    types.TypeInfo info = state.ctx.store.types.get(state.type_id(type_id));
    if (info.data is .array_type(_)) { return true; }
    if (info.data is .tuple_type(_)) { return true; }
    if (info.data is .closure_environment_type(_)) { return true; }
    guard info.data is .named(named) else { return false; }
    return state.ctx.store.defs.get(named.def_id).kind == .struct_def;
}

@life(return: drop_term.a)
jil.Place? projection_flag_for_drop_path(
    jil.DropTerminator drop_term,
    list.ArrayList<DropFieldStep>& path
) {
    Int index! = 0;
    while (index < drop_term.projection_flags.length) {
        jil.DropProjectionFlag flag = drop_term.projection_flags[index];
        if (drop_path_matches_place(drop_term.place, path, flag.place, true)) {
            return flag.flag;
        }
        index = index + 1;
    }
    return null;
}

Bool drop_path_has_descendant(
    jil.DropTerminator drop_term,
    list.ArrayList<DropFieldStep>& path
) {
    Int index! = 0;
    while (index < drop_term.projection_flags.length) {
        if (drop_path_matches_place(
            drop_term.place,
            path,
            drop_term.projection_flags[index].place,
            false
        )) { return true; }
        index = index + 1;
    }
    return false;
}

Bool drop_path_matches_place(
    jil.Place root,
    list.ArrayList<DropFieldStep>& path,
    jil.Place candidate,
    Bool exact
) {
    if (!drop_place_base_equal(root, candidate)) { return false; }
    Int expected_length = root.projection.length + path.len();
    if (candidate.projection.length < expected_length) { return false; }
    if (exact && candidate.projection.length != expected_length) { return false; }
    if (!exact && candidate.projection.length == expected_length) { return false; }
    Int index! = 0;
    while (index < root.projection.length) {
        if (!drop_place_elem_equal(root.projection[index], candidate.projection[index])) {
            return false;
        }
        index = index + 1;
    }
    index = 0;
    while (index < path.len()) {
        if (!drop_field_step_matches(
            path.get(index), candidate.projection[root.projection.length + index]
        )) { return false; }
        index = index + 1;
    }
    return true;
}

Bool drop_place_base_equal(jil.Place lhs, jil.Place rhs) {
    if (lhs.base is .local(lhs_local)) {
        if (rhs.base is .local(rhs_local)) { return lhs_local == rhs_local; }
        return false;
    }
    guard lhs.base is .global(lhs_global) else { return false; }
    guard rhs.base is .global(rhs_global) else { return false; }
    return lhs_global.id == rhs_global.id;
}

Bool drop_field_step_matches(DropFieldStep step, jil.PlaceElem candidate) {
    if (step.field_def is .some(field_def)) {
        if (candidate is .field_projection(field)) {
            return field.field_def == field_def;
        }
        return false;
    }
    if (candidate is .constant_index_projection(field)) {
        return field.offset == step.field_index;
    }
    if (candidate is .frame_field_projection(field)) {
        return field.field_index == step.field_index;
    }
    return false;
}

Bool drop_place_elem_equal(jil.PlaceElem lhs, jil.PlaceElem rhs) {
    if (lhs is .deref_projection(lhs_value)) {
        if (rhs is .deref_projection(rhs_value)) {
            return lhs_value.raw_pointer == rhs_value.raw_pointer;
        }
        return false;
    }
    if (lhs is .field_projection(lhs_value)) {
        if (rhs is .field_projection(rhs_value)) {
            return lhs_value.field_def == rhs_value.field_def;
        }
        return false;
    }
    if (lhs is .frame_field_projection(lhs_value)) {
        if (rhs is .frame_field_projection(rhs_value)) {
            return lhs_value.field_index == rhs_value.field_index;
        }
        return false;
    }
    if (lhs is .index_projection(lhs_value)) {
        if (rhs is .index_projection(rhs_value)) {
            return lhs_value.index_local == rhs_value.index_local;
        }
        return false;
    }
    if (lhs is .constant_index_projection(lhs_value)) {
        if (rhs is .constant_index_projection(rhs_value)) {
            return lhs_value.offset == rhs_value.offset;
        }
        return false;
    }
    guard lhs is .subslice_projection(lhs_value) else { return false; }
    guard rhs is .subslice_projection(rhs_value) else { return false; }
    return lhs_value.from == rhs_value.from && lhs_value.to == rhs_value.to;
}

Bool lower_branch_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.BranchTerminator branch_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value condition = llvm_value.lower_operand(state, output, body, branch_term.condition, local_slots);
    if (!ffi.value_valid(condition)) {
        return false;
    }
    return ffi.value_valid(
        ffi.builder_build_cond_br(
            state.builder$.ref(),
            condition,
            blocks.get(branch_term.then_target.to_index()),
            blocks.get(branch_term.else_target.to_index())
        )
    );
}

Bool lower_switch_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.SwitchTerminator switch_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value discriminator = llvm_value.lower_operand(
        state,
        output,
        body,
        switch_term.discriminator,
        local_slots
    );
    if (!ffi.value_valid(discriminator)) {
        return false;
    }
    ffi.Value switch_value = ffi.builder_build_switch(
        state.builder$.ref(),
        discriminator,
        blocks.get(switch_term.default_target.to_index()),
        switch_term.cases.length
    );
    if (!ffi.value_valid(switch_value)) {
        return false;
    }
    Int index! = 0;
    while (index < switch_term.cases.length) {
        jil.SwitchCase switch_case = switch_term.cases[index];
        ffi.Value case_value = llvm_value.lower_const(state, output, switch_case.value);
        if (!ffi.value_valid(case_value)) {
            return false;
        }
        ffi.switch_add_case(switch_value, case_value, blocks.get(switch_case.target.to_index()));
        index = index + 1;
    }
    return true;
}

Bool lower_call_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_term.callee is .domain_enqueue(enqueue)) {
        return lower_domain_enqueue_call(state, output, body, call_term, enqueue, blocks, local_slots);
    }
    if (call_term.callee is .dynamic_domain_enqueue(enqueue)) {
        return lower_dynamic_domain_enqueue_call(state, output, body, call_term, enqueue, blocks, local_slots);
    }
    if (lower_builtin_direct_call(
        state, output, body, call_term, blocks, local_slots
    ) is .some(lowered)) {
        return lowered;
    }
    guard lower_call_target(
        state, output, body, call_term.callee, local_slots
    ) is .some(target) else {
        std.String message = call_callee_lower_error_message(
            state, body, call_term.callee
        );
        add_backend_error(output, message.bytes(), "llvm_call_callee_lower_failed");
        return false;
    }
    ffi.Value callee = target.value;
    backend_abi.FunctionAbi call_abi = target.abi;
    if (call_term.args.length != call_abi.params.len()) {
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("call ABI arity mismatch: operands ");
        builder.append(Int(call_term.args.length));
        builder.append(", parameters ");
        builder.append(call_abi.params.len());
        builder.append(", callee ");
        builder.append_valid_utf8(call_callee_error_message(state, call_term.callee).bytes());
        add_backend_error(
            output,
            builder.into_string().bytes(),
            "llvm_call_abi_arity_mismatch"
        );
        return false;
    }
    list.ArrayList<ffi.Value> args! = lower_call_args(state, output, body, call_term, call_abi$.ref(), local_slots);
    if (args.len() != call_abi.llvm_param_count()) {
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("failed to lower call arguments: lowered ");
        builder.append(args.len());
        builder.append(", expected ");
        builder.append(call_abi.llvm_param_count());
        builder.append(", JIL operands ");
        builder.append(Int(call_term.args.length));
        builder.append(", caller FunctionId ");
        builder.append(body.id.to_index());
        builder.append(", callee ");
        std.String callee_message = call_callee_error_message(
            state, call_term.callee
        );
        builder.append_valid_utf8(callee_message.bytes());
        add_backend_error(output, builder.into_string().bytes(), "llvm_call_args_lower_failed");
        return false;
    }
    qid.TypeId result_type = call_abi.result.type_id;
    ffi.Type function_type = llvm_abi.function_type(state, call_abi$.ref());
    if (!ffi.type_valid(function_type)) {
        add_backend_error(output, "failed to lower call function type", "llvm_call_type_lower_failed");
        return false;
    }
    ffi.Value result = ffi.builder_build_call(state.builder$.ref(), function_type, callee, args$.ref());
    if (!ffi.value_valid(result)) {
        add_backend_error(output, "failed to build llvm call", "llvm_call_build_failed");
        return false;
    }
    llvm_abi.add_call_attributes(state, result, call_abi$.ref());
    if (!store_call_result(
            state, output, body, call_term.destination, result,
            result_type, call_abi$.ref(), local_slots
        )
    ) {
        add_backend_error(output, "failed to store call result", "llvm_call_result_store_failed");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), blocks.get(call_term.target.to_index())));
}

Bool? lower_builtin_direct_call(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    guard call.callee is .direct_function(function_ref) else { return null; }
    instance_reader.ResolvedCallee resolved = llvm_value.resolved_callee(
        state, function_ref
    );
    guard resolved.builtin is .some(builtin) else { return null; }
    guard resolved.dispatch_type is .some(receiver_type) else { return false; }
    ffi.Value value!;
    if (builtin == .equality) {
        if (call.args.length != 2) { return false; }
        value = llvm_value.lower_builtin_equality(
            state,
            output,
            body,
            call.args[0],
            call.args[1],
            receiver_type,
            local_slots
        );
    } else {
        if (call.args.length != 1) { return false; }
        value = lower_builtin_contiguous_call(
            state, output, body, call, builtin, receiver_type, local_slots
        );
    }
    if (!ffi.value_valid(value)) { return false; }
    ffi.Value destination = llvm_place.lower_place_pointer(
        state, output, body, call.destination, local_slots
    );
    if (!ffi.value_valid(destination)
        || !ffi.value_valid(ffi.builder_build_store(
            state.builder$.ref(), value, destination
        ))) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(
        state.builder$.ref(), blocks.get(call.target.to_index())
    ));
}

ffi.Value lower_builtin_contiguous_call(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call,
    instance_reader.InstanceBuiltin builtin,
    qid.TypeId receiver_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (builtin == .contiguous_pointer) {
        return llvm_value.lower_operand(
            state, output, body, call.args[0], local_slots
        );
    }
    if (builtin != .contiguous_length) { return ffi.Value(); }
    guard builtin_contiguous_array_type(state, receiver_type)
        is .some(array_type) else { return ffi.Value(); }
    qid.TypeId result_type = llvm_place.place_type(
        state, body, call.destination
    );
    ffi.Type int_type = llvm_type.lower_type(state, result_type);
    if (!ffi.type_valid(int_type)) { return ffi.Value(); }
    return ffi.const_int(int_type, UInt64(array_type.count));
}

types.ArrayType? builtin_contiguous_array_type(
    llvm_state.LowerState& state,
    qid.TypeId receiver_type
) {
    types.TypeInfo receiver = state.ctx.store.types.get(receiver_type);
    guard receiver.data is .handle_type(handle) else { return null; }
    types.TypeInfo value = state.ctx.store.types.get(handle.element);
    guard value.data is .array_type(array_type) else { return null; }
    return array_type;
}

Bool lower_domain_enqueue_call(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call_term,
    jil.DomainEnqueueCallee enqueue,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_term.args.length != 1) {
        add_backend_error(output, "domain enqueue requires one context operand", "llvm_domain_enqueue_arity");
        return false;
    }
    ffi.Value context_value = llvm_value.lower_operand(state, output, body, call_term.args[0], local_slots);
    ffi.Value resume = llvm_value.lower_operand(state, output, body, enqueue.resume, local_slots);
    UInt8[]& symbol! = "__jiang_runtime_task_request_static";
    if (enqueue.handoff) { symbol = "__jiang_runtime_task_handoff_static"; }
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(4);
    params.add(pointer_type);
    params.add(pointer_type);
    params.add(pointer_type);
    params.add(pointer_type);
    ffi.Type runtime_type = ffi.function_type(
        ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
    );
    ffi.Value runtime! = ffi.module_get_function(state.module$.ref(), symbol);
    if (!ffi.value_valid(runtime)) {
        runtime = ffi.module_add_function(state.module$.ref(), symbol, runtime_type);
    }
    ffi.Value executor = llvm_value.lower_domain_executor(
        state,
        jil.DomainExecutorRvalue (
            domain_def: enqueue.domain_def,
            domain_kind: enqueue.domain_kind
        )
    );
    if (!ffi.value_valid(context_value) || !ffi.value_valid(resume)
        || !ffi.value_valid(runtime) || !ffi.value_valid(executor)
    ) {
        add_backend_error(output, "failed to lower domain enqueue operands", "llvm_domain_enqueue_operand");
        return false;
    }
    ffi.Value task! = ffi.const_null(pointer_type);
    if (enqueue.task is .some(task_operand)) {
        task = llvm_value.lower_operand(state, output, body, task_operand, local_slots);
    }
    if (!ffi.value_valid(task)) { return false; }
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(4);
    args.add(executor);
    args.add(task);
    args.add(context_value);
    args.add(resume);
    ffi.Value call = ffi.builder_build_call(state.builder$.ref(), runtime_type, runtime, args$.ref());
    if (!ffi.value_valid(call)) {
        add_backend_error(output, "failed to call domain enqueue runtime", "llvm_domain_enqueue_call");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), blocks.get(call_term.target.to_index())));
}

Bool lower_dynamic_domain_enqueue_call(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call_term,
    jil.DynamicDomainEnqueueCallee enqueue,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_term.args.length != 1) {
        add_backend_error(output, "domain enqueue requires one context operand", "llvm_domain_enqueue_arity");
        return false;
    }
    if (local_handoff_can_musttail(state, body, call_term, enqueue)) {
        return lower_local_handoff_musttail(state, output, body, call_term, enqueue, local_slots);
    }
    ffi.Value context_value = llvm_value.lower_operand(state, output, body, call_term.args[0], local_slots);
    ffi.Value executor = llvm_value.lower_operand(state, output, body, enqueue.executor, local_slots);
    ffi.Value resume = llvm_value.lower_operand(state, output, body, enqueue.resume, local_slots);
    UInt8[]& symbol = dynamic_enqueue_symbol(enqueue);
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(4);
    params.add(pointer_type);
    params.add(pointer_type);
    params.add(pointer_type);
    params.add(pointer_type);
    ffi.Type runtime_type = ffi.function_type(
        ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
    );
    ffi.Value runtime! = ffi.module_get_function(state.module$.ref(), symbol);
    if (!ffi.value_valid(runtime)) {
        runtime = ffi.module_add_function(state.module$.ref(), symbol, runtime_type);
    }
    if (!ffi.value_valid(context_value)) {
        add_backend_error(output, "failed to lower dynamic enqueue context", "llvm_domain_enqueue_context");
        return false;
    }
    if (!ffi.value_valid(executor)) {
        add_backend_error(output, "failed to lower dynamic enqueue executor", "llvm_domain_enqueue_executor");
        return false;
    }
    if (!ffi.value_valid(resume)) {
        add_backend_error(output, "failed to lower dynamic enqueue resume", "llvm_domain_enqueue_resume");
        return false;
    }
    if (!ffi.value_valid(runtime)) {
        add_backend_error(output, "dynamic enqueue runtime is not declared", "llvm_domain_enqueue_runtime");
        return false;
    }
    ffi.Value task! = ffi.const_null(pointer_type);
    if (enqueue.task is .some(task_operand)) {
        task = llvm_value.lower_operand(state, output, body, task_operand, local_slots);
    }
    if (!ffi.value_valid(task)) { return false; }
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(4);
    args.add(executor);
    args.add(task);
    args.add(context_value);
    args.add(resume);
    ffi.Value call = ffi.builder_build_call(state.builder$.ref(), runtime_type, runtime, args$.ref());
    if (!ffi.value_valid(call)) {
        add_backend_error(output, "failed to call dynamic domain enqueue runtime", "llvm_domain_enqueue_call");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), blocks.get(call_term.target.to_index())));
}

Bool local_handoff_can_musttail(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.CallTerminator& call_term,
    jil.DynamicDomainEnqueueCallee enqueue
) {
    if (enqueue.mode != .local || !enqueue.handoff) { return false; }
    if (!call_can_tail_return(
            state, body, call_term, state.ctx.store.types.unit_type()
        )
    ) {
        return false;
    }
    instance_reader.InstanceReader reader = instance_reader.InstanceReader(
        state.ctx.store$.ref(), state.bindings$.ref()
    );
    backend_abi.FunctionAbi caller = backend_abi.classify_jil_instance(
        state.ctx, reader$.ref(), body
    );
    if (caller.result.kind != .none || caller.params.len() != 1) { return false; }
    backend_abi.AbiArg context = caller.params.get(0);
    if (context.kind != .direct) { return false; }
    types.TypeInfo info = llvm_type.type_info(state, context.type_id);
    guard info.data is .handle_type(handle) else { return false; }
    return handle.kind == .raw_pointer;
}

Bool lower_local_handoff_musttail(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call_term,
    jil.DynamicDomainEnqueueCallee enqueue,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value context = llvm_value.lower_operand(
        state, output, body, call_term.args[0], local_slots
    );
    ffi.Value resume = llvm_value.lower_operand(state, output, body, enqueue.resume, local_slots);
    if (!ffi.value_valid(context) || !ffi.value_valid(resume)) {
        add_backend_error(output, "failed to lower local handoff target", "llvm_local_handoff_target");
        return false;
    }
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
    params.add(pointer_type);
    ffi.Type resume_type = ffi.function_type(
        ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
    );
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
    args.add(context);
    ffi.Value call = ffi.builder_build_call(
        state.builder$.ref(), resume_type, resume, args$.ref()
    );
    if (!ffi.value_valid(call)) {
        add_backend_error(output, "failed to build local handoff", "llvm_local_handoff_call");
        return false;
    }
    // confined handoff 已持有同一 executor lease，runtime helper 只会再次
    // 间接调用该 continuation。直接 musttail 保留语义并保证递归 SCC 常量栈。
    ffi.value_set_must_tail_call(call);
    return ffi.value_valid(ffi.builder_build_return_void(state.builder$.ref()));
}

UInt8[]& dynamic_enqueue_symbol(jil.DynamicDomainEnqueueCallee enqueue) {
    if (enqueue.mode == .local) {
        if (enqueue.handoff) { return "__jiang_runtime_task_handoff_local"; }
        return "__jiang_runtime_task_request_local";
    }
    if (enqueue.handoff) { return "__jiang_runtime_task_handoff"; }
    return "__jiang_runtime_task_request";
}

Bool call_can_tail_return(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.CallTerminator& call_term,
    qid.TypeId result_type
) {
    if (state.type_id(result_type) != state.ctx.store.types.unit_type()) { return false; }
    qid.TypeId body_result = body.locals[body.return_local.to_index()].type_id;
    if (state.type_id(body_result) != state.ctx.store.types.unit_type()) { return false; }
    jil.Block target = body.blocks[call_term.target.to_index()];
    if (!block_is_codegen_empty(target)) { return false; }
    return target.terminator.kind is .return_term(_);
}

Bool block_is_codegen_empty(jil.Block block) {
    Int index! = 0;
    while (index < block.statements.length) {
        jil.StatementKind kind = block.statements[index].kind;
        if (!(kind is .storage_live_stmt(_))
            && !(kind is .storage_dead_stmt(_))
            && !(kind is .forget_stmt(_))
            && !(kind is .exclusive_stmt(_))
            && !(kind is .task_consume_stmt(_))
            && !(kind is .task_region_start_stmt(_))
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool lower_assert_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    std.jiang.syntax.Span span,
    jil.AssertTerminator assert_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value condition = llvm_value.lower_operand(state, output, body, assert_term.condition, local_slots);
    if (!ffi.value_valid(condition)) {
        return false;
    }
    ffi.BasicBlock target = blocks.get(assert_term.target.to_index());
    ffi.BasicBlock fail_block = ffi.context_append_block(
        state.llvm_context$.ref(),
        llvm_function,
        "assert_fail"
    );
    if (!ffi.block_valid(fail_block)) {
        return false;
    }
    if (!build_assert_branch(state, output, assert_term.expected, condition, target, fail_block)) {
        return false;
    }
    ffi.builder_position_at_end(state.builder$.ref(), fail_block);
    ffi.Value location = lower_assert_location(state, span, assert_term);
    if (!ffi.value_valid(location)) { return false; }
    ffi.Value message = lower_assert_message(
        state,
        output,
        body,
        assert_term,
        local_slots
    );
    if (!ffi.value_valid(message)) { return false; }
    if (!call_assert_fail(state, location, message)) { return false; }
    ffi.Value trap = ffi.module_get_intrinsic(state.module$.ref(), "llvm.trap");
    if (!ffi.value_valid(trap)) { return false; }
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>();
    if (!ffi.value_valid(ffi.builder_build_call(
            state.builder$.ref(),
            ffi.global_value_type(trap),
            trap,
            args$.ref()
        ))) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_unreachable(state.builder$.ref()));
}

ffi.Value lower_assert_message(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AssertTerminator assert_term,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (assert_term.message is .some(message)) {
        ffi.Value slice = llvm_value.lower_operand(state, output, body, message, local_slots);
        if (!ffi.value_valid(slice)) { return ffi.Value(); }
        return ffi.builder_build_extract_value(state.builder$.ref(), slice, 0);
    }
    return lower_assert_c_string(state, "");
}

ffi.Value lower_assert_location(
    llvm_state.LowerState& state,
    std.jiang.syntax.Span span,
    jil.AssertTerminator assert_term
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("assertion failed at ");
    if (assert_term.source_id is .some(source_id)) {
        UInt8[]& name = state.ctx.store.sources.entry(source_id).name();
        if (name.length == 0) { builder.append("<unknown>"); }
        else { builder.append_valid_utf8(name); }
        if (state.ctx.store.sources.has_source(source_id)) {
            source.Source& loaded = state.ctx.store.sources.get(source_id);
            diagnostic.SourcePosition position = source_map.position_at_snapshot(loaded, span.start, .utf8);
            builder.append(":");
            builder.append(position.line + 1);
            builder.append(":");
            builder.append(position.character + 1);
        }
    } else {
        builder.append("<unknown>");
    }
    return lower_assert_c_string(state, builder.into_string().bytes());
}

ffi.Value lower_assert_c_string(llvm_state.LowerState& state, UInt8[]& text) {
    unsafe {
        UInt8*! bytes! = UInt8$.alloc(text.length + 1);
        Int index! = 0;
        while (index < text.length) {
            bytes[index] = text[index];
            index = index + 1;
        }
        bytes[text.length] = 0;
        ffi.Value value = ffi.builder_build_global_string_ptr(
            state.builder$.ref(),
            bytes$.as(UInt8*)
        );
        bytes$.dealloc();
        return value;
    }
}

Bool call_assert_fail(llvm_state.LowerState& state, ffi.Value location, ffi.Value message) {
    ffi.Value function! = ffi.module_get_function(state.module$.ref(), "__jiang_assert_fail");
    if (!ffi.value_valid(function)) {
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(2);
        params.add(ffi.context_pointer_type(state.llvm_context$.ref()));
        params.add(ffi.context_pointer_type(state.llvm_context$.ref()));
        ffi.Type function_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()),
            params$.ref()
        );
        function = ffi.module_add_function(state.module$.ref(), "__jiang_assert_fail", function_type);
    }
    if (!ffi.value_valid(function)) { return false; }
    ffi.Type function_type = ffi.global_value_type(function);
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(2);
    args.add(location);
    args.add(message);
    return ffi.value_valid(ffi.builder_build_call(
        state.builder$.ref(), function_type, function, args$.ref()
    ));
}

Bool build_assert_branch(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    Bool expected,
    ffi.Value condition,
    ffi.BasicBlock target,
    ffi.BasicBlock fail_block
) {
    if (expected) {
        return ffi.value_valid(ffi.builder_build_cond_br(state.builder$.ref(), condition, target, fail_block));
    }
    return ffi.value_valid(ffi.builder_build_cond_br(state.builder$.ref(), condition, fail_block, target));
}

ffi.Value lower_call_callee(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallCallee callee,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (callee is .indirect_operand(operand)) {
        return llvm_value.lower_operand(state, output, body, operand, local_slots);
    }
    if (callee is .domain_enqueue(enqueue)) {
        return llvm_value.lower_operand(state, output, body, enqueue.resume, local_slots);
    }
    if (callee is .dynamic_domain_enqueue(enqueue)) {
        return llvm_value.lower_operand(state, output, body, enqueue.resume, local_slots);
    }
    return ffi.Value();
}

LoweredCallTarget? lower_call_target(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallCallee callee,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (callee is .direct_function(function_ref)) {
        if (state.instance_is_identity() && function_ref.dispatch_type == null) {
            return lower_concrete_direct_call_target(
                state, output, function_ref
            );
        }
        instance_reader.ResolvedCallee resolved = llvm_value.resolved_callee(
            state, function_ref
        );
        jil.FunctionRef concrete = llvm_value.concrete_function_ref(
            state, function_ref, resolved$.ref()
        );
        return lower_concrete_direct_call_target(state, output, concrete);
    }
    ffi.Value value = lower_call_callee(
        state, output, body, callee, local_slots
    );
    if (!ffi.value_valid(value)) { return null; }
    backend_abi.FunctionAbi abi = classify_call_abi_for_callee(
        state, body, callee
    );
    return LoweredCallTarget(value, abi);
}

LoweredCallTarget? lower_concrete_direct_call_target(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.FunctionRef concrete
) {
    ffi.Value value = llvm_value.ensure_concrete_function_for_ref(
        state, output, concrete
    );
    if (!ffi.value_valid(value)) { return null; }
    backend_abi.FunctionAbi abi = backend_abi.classify_function_type(
        state.ctx, concrete.type_id
    );
    return LoweredCallTarget(value, abi);
}

std.String call_callee_lower_error_message(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.CallCallee callee
) {
    if (callee is .direct_function(_)) {
        return "failed to lower direct function call callee";
    }
    guard callee is .indirect_operand(operand) else {
        return "failed to lower call callee";
    }
    if (operand is .const_operand(_)) {
        return "failed to lower const indirect call callee";
    }
    if (operand is .function_operand(_)) {
        return "failed to lower function indirect call callee";
    }
    if (operand is .global_operand(_)) {
        return "failed to lower global indirect call callee";
    }
    if (operand is .global_address_operand(_)) {
        return "failed to lower global-address indirect call callee";
    }
    if (operand is .copy_operand(copy)) {
        qid.TypeId type_id = llvm_place.place_type(state, body, copy.place);
        types.TypeInfo info = llvm_type.type_info(state, type_id);
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("failed to lower copy indirect call callee: type ");
        builder.append(type_id.to_index());
        if (info.data is .function_type(function_type)) {
            if (function_type.kind == .raw) { builder.append(" is raw function"); }
            else { builder.append(" is closure function"); }
        } else {
            builder.append(" is not a function");
        }
        return builder.into_string();
    }
    if (operand is .move_operand(_)) {
        return "failed to lower move indirect call callee";
    }
    return "failed to lower out indirect call callee";
}

std.String call_callee_error_message(llvm_state.LowerState& state, jil.CallCallee callee) {
    if (callee is .indirect_operand(_)) {
        return "indirect call callee is not a declared function";
    }
    if (callee is .domain_enqueue(_)) {
        return "domain enqueue resume function is not callable";
    }
    if (callee is .dynamic_domain_enqueue(_)) {
        return "dynamic domain enqueue resume function is not callable";
    }
    guard callee is .direct_function(function_value) else {
        return "call callee is not a function reference";
    }
    instance_reader.ResolvedCallee resolved = llvm_value.resolved_callee(
        state, function_value
    );
    jil.FunctionRef concrete = llvm_value.concrete_function_ref(
        state, function_value, resolved$.ref()
    );
    symbol.BackendSymbolKey key =
        symbol.symbol_key_for_function_ref(state.ctx, state.store, concrete, false);
    std.String symbol_name = symbol.symbol_name(key);
    qid.DefId provenance_def = jil.function_target_provenance_def(concrete.target);
    qid.SymbolId name = state.ctx.store.defs.get(provenance_def).name.symbol;
    UInt8[]& source_name = state.ctx.store.symbols.text(name);
    std.String message! =
        call_callee_message_with_args(state, symbol_name.bytes(), source_name, concrete.args);
    if (resolved.dispatch_type is .some(dispatch_type)) {
        message = append_text(message, " dispatch_type=");
        std.StringBuilder type_text! = std.StringBuilder();
        type_text.append(dispatch_type.to_index());
        message = append_text(message, type_text.into_string().bytes());
        message = append_text(message, " bindings=");
        std.StringBuilder binding_text! = std.StringBuilder();
        binding_text.append(state.bindings.len());
        message = append_text(message, binding_text.into_string().bytes());
    }
    if (concrete.target is .source(source_def)) {
        message = append_instance_lookup(state, message, source_def, concrete.args);
    }
    return append_call_callee_owner(state, message, provenance_def);
}

std.String append_instance_lookup(
    llvm_state.LowerState& state,
    std.String message,
    qid.DefId function_def,
    types.GenericArg[]& args
) {
    std.String result! = append_text(message, " instance=");
    guard state.store.program.existing_function_instance_identity(
        function_def, args
    ) is .some(identity) else {
        return append_text(result, "missing");
    }
    std.StringBuilder identity_text! = std.StringBuilder();
    identity_text.append(identity);
    result = append_text(result, identity_text.into_string().bytes());
    if (!state.store.program.is_source_instance(identity)) {
        result = append_text(result, " function=missing");
    }
    return result;
}

std.String append_call_callee_owner(
    llvm_state.LowerState& state,
    std.String message,
    qid.DefId function_def
) {
    guard state.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
        return message;
    }
    qid.SymbolId owner_name = state.ctx.store.defs.get(owner_def).name.symbol;
    std.String with_owner = append_text(message, " owner=");
    return append_text(with_owner, state.ctx.store.symbols.text(owner_name));
}

std.String call_callee_message_with_args(
    llvm_state.LowerState& state,
    UInt8[]& symbol_name,
    UInt8[]& source_name,
    types.GenericArg[]& args
) {
    std.String message! = call_callee_base_message(symbol_name, source_name);
    if (args.length == 0) { return message; }
    message = append_text(message, " type_args=");
    Int index! = 0;
    Bool first! = true;
    while (index < args.length) {
        if (args[index] is .type_arg(value)) {
            if (!first) { message = append_text(message, ","); }
            message = append_text(message, type_arg_message_text(state, value.value));
            first = false;
        }
        index = index + 1;
    }
    return message;
}

std.String call_callee_base_message(UInt8[]& symbol_name, UInt8[]& source_name) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("call callee is not declared: ");
    builder.append_valid_utf8(symbol_name);
    builder.append(" ");
    builder.append_valid_utf8(source_name);
    return builder.into_string();
}

std.String append_text(std.String prefix, UInt8[]& text) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix.bytes());
    builder.append_valid_utf8(text);
    return builder.into_string();
}

UInt8[]& type_arg_message_text(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = llvm_type.type_info(state, type_id);
    if (info.data is .named(named)) {
        qid.SymbolId symbol = state.ctx.store.defs.get(named.def_id).name.symbol;
        return state.ctx.store.symbols.text(symbol);
    }
    return "type";
}

Void add_backend_error(
    llvm_state.LowerOutput&! output,
    UInt8[]& message,
    UInt8[]& code
) {
    output.add_diagnostic(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

list.ArrayList<ffi.Value> lower_call_args(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CallTerminator& call_term,
    backend_abi.FunctionAbi& call_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(call_abi.llvm_param_count());
    if (call_abi.result.is_indirect()) {
        ffi.Value result_pointer = llvm_place.lower_place_pointer(
            state, output, body, call_term.destination, local_slots
        );
        if (!ffi.value_valid(result_pointer)) {
            return args;
        }
        args.add(result_pointer);
    }
    Int index! = 0;
    while (index < call_term.args.length) {
        backend_abi.AbiArg param_abi = call_abi.params.get(index);
        if (param_abi.kind == .none) {
            index = index + 1;
            continue;
        }
        jil.Operand& operand = call_term.args[index]$.ref();
        ffi.Value arg = lower_call_arg(state, output, body, operand, param_abi, local_slots);
        if (!ffi.value_valid(arg)) {
            add_call_arg_error(output, operand);
            return args;
        }
        args.add(arg);
        index = index + 1;
    }
    return args;
}

ffi.Value lower_call_arg(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand& operand,
    backend_abi.AbiArg param_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, output, body, out_operand.place, local_slots);
    }
    if (param_abi.kind == .indirect) {
        // indirect 参数的 ABI 形态是指针，传入 place 指针即可；临时 rvalue 才需要
        // 先落到 stack slot。
        return lower_indirect_call_arg(state, output, body, operand, param_abi.type_id, local_slots);
    }
    if (should_pass_reference_place_pointer(state, body, operand, param_abi.type_id)) {
        guard operand_place(operand) is .some(place) else {
            return lower_call_arg_value(state, output, body, operand, local_slots);
        }
        return llvm_place.lower_place_pointer(state, output, body, place, local_slots);
    }
    return lower_call_arg_value(state, output, body, operand, local_slots);
}

ffi.Value lower_indirect_call_arg(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand& operand,
    qid.TypeId param_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand_place(operand) is .some(place)) {
        ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, place, local_slots);
        if (!ffi.value_valid(pointer)) {
            add_backend_error(
                output,
                "failed to lower indirect LLVM call argument place",
                "llvm_indirect_call_arg_place_lower_failed"
            );
        }
        return pointer;
    }
    ffi.Value value = lower_call_arg_value(state, output, body, operand, local_slots);
    if (!ffi.value_valid(value)) {
        return ffi.Value();
    }
    ffi.Type value_type = llvm_type.lower_type(state, param_type);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    ffi.Value temp = ffi.builder_build_alloca(state.builder$.ref(), value_type);
    if (!ffi.value_valid(temp)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), value, temp))) {
        return ffi.Value();
    }
    return temp;
}

ffi.Value lower_call_arg_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand& operand,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .const_operand(const_value)) {
        return llvm_value.lower_const(state, output, const_value);
    }
    if (operand is .function_operand(function_value)) {
        return llvm_value.function_value_for_ref(state, output, function_value);
    }
    if (operand is .global_operand(global_value)) {
        return llvm_value.global_value_for_ref(state, global_value);
    }
    if (operand is .global_address_operand(global_value)) {
        return llvm_value.global_address_for_ref(state, global_value);
    }
    if (operand is .trait_vtable_operand(vtable)) {
        return llvm_value.lower_trait_vtable_operand(state, vtable);
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.lower_place_value(state, output, body, copy_operand.place, local_slots);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.lower_place_value(state, output, body, move_operand.place, local_slots);
    }
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, output, body, out_operand.place, local_slots);
    }
    return ffi.Value();
}

Bool should_pass_reference_place_pointer(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.Operand& operand,
    qid.TypeId param_type
) {
    if (!type_is_reference(state, param_type)) {
        return false;
    }
    if (type_is_reference(state, call_arg_operand_type(state, body, operand))) {
        return false;
    }
    return operand_place(operand) != null;
}

qid.TypeId call_arg_operand_type(llvm_state.LowerState& state, jil.Body& body, jil.Operand& operand) {
    if (operand is .const_operand(const_value)) {
        return const_value.type_id;
    }
    if (operand is .function_operand(function_value)) {
        return function_value.type_id;
    }
    if (operand is .global_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .global_address_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .trait_vtable_operand(vtable)) {
        return vtable.type_id;
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.place_type(state, body, copy_operand.place);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.place_type(state, body, move_operand.place);
    }
    return state.ctx.store.types.invalid_type();
}

jil.Place? operand_place(jil.Operand& operand) {
    if (operand is .copy_operand(copy_operand)) {
        return copy_operand.place;
    }
    if (operand is .move_operand(move_operand)) {
        return move_operand.place;
    }
    if (operand is .out_operand(out_operand)) {
        return out_operand.place;
    }
    return null;
}

Bool type_is_reference(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = llvm_type.type_info(state, type_id);
    guard info.data is .handle_type(handle) else { return false; }
    return handle.kind == .reference;
}

Void add_call_arg_error(
    llvm_state.LowerOutput&! output,
    jil.Operand& operand
) {
    if (operand is .const_operand(_)) {
        add_backend_error(output, "failed to lower LLVM const call argument", "llvm_call_const_arg_lower_failed");
        return;
    }
    if (operand is .copy_operand(_)) {
        add_backend_error(output, "failed to lower LLVM copy call argument", "llvm_call_copy_arg_lower_failed");
        return;
    }
    if (operand is .move_operand(_)) {
        add_backend_error(output, "failed to lower LLVM move call argument", "llvm_call_move_arg_lower_failed");
        return;
    }
    if (operand is .out_operand(_)) {
        add_backend_error(output, "failed to lower LLVM out call argument", "llvm_call_out_arg_lower_failed");
        return;
    }
    if (operand is .function_operand(_)) {
        add_backend_error(output, "failed to lower LLVM function call argument", "llvm_call_function_arg_lower_failed");
        return;
    }
    if (operand is .global_operand(_)) {
        add_backend_error(output, "failed to lower LLVM global call argument", "llvm_call_global_arg_lower_failed");
        return;
    }
    if (operand is .global_address_operand(_)) {
        add_backend_error(
            output,
            "failed to lower LLVM global address call argument",
            "llvm_call_global_address_arg_lower_failed"
        );
        return;
    }
    add_backend_error(output, "failed to lower LLVM call argument", "llvm_call_arg_lower_failed");
}

backend_abi.FunctionAbi classify_call_abi_for_callee(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.CallCallee callee
) {
    if (callee is .direct_function(function_ref)) {
        return classify_function_ref_abi(state, function_ref);
    }
    if (callee is .indirect_operand(operand)
        && operand is .function_operand(function_ref)) {
        return classify_function_ref_abi(state, function_ref);
    }
    qid.TypeId function_type_id = state.type_id(
        call_callee_type(state, body, callee)
    );
    return backend_abi.classify_function_type(
        state.ctx, function_type_id
    );
}

backend_abi.FunctionAbi classify_function_ref_abi(
    llvm_state.LowerState& state,
    jil.FunctionRef function_ref
) {
    if (state.instance_is_identity() && function_ref.dispatch_type == null) {
        return backend_abi.classify_function_type(
            state.ctx, function_ref.type_id
        );
    }
    instance_reader.ResolvedCallee resolved = llvm_value.resolved_callee(
        state, function_ref
    );
    jil.FunctionRef concrete = llvm_value.concrete_function_ref(
        state, function_ref, resolved$.ref()
    );
    return backend_abi.classify_function_type(
        state.ctx, concrete.type_id
    );
}

qid.TypeId call_callee_type(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.CallCallee callee
) {
    if (callee is .direct_function(function_ref)) {
        return function_ref.type_id;
    }
    if (callee is .indirect_operand(operand)) {
        return llvm_value.operand_type(state, body, operand);
    }
    if (callee is .domain_enqueue(enqueue)) {
        return llvm_value.operand_type(state, body, enqueue.resume);
    }
    if (callee is .dynamic_domain_enqueue(enqueue)) {
        return llvm_value.operand_type(state, body, enqueue.resume);
    }
    return state.ctx.store.types.invalid_type();
}

Bool store_call_result(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Place destination,
    ffi.Value result,
    qid.TypeId result_type,
    backend_abi.FunctionAbi& call_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_abi.result.is_indirect()) {
        return true;
    }
    if (llvm_type.type_is_unit_or_never(state, result_type)
        || !llvm_type.type_has_abi_value(state, result_type)
    ) {
        return true;
    }
    ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, destination, local_slots);
    if (!ffi.value_valid(pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), result, pointer));
}

Bool lower_return_terminator(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    backend_abi.FunctionAbi& function_abi,
    ffi.Value llvm_function,
    jil.ReturnTerminator return_term,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (return_term.implicit_unit) {
        return ffi.value_valid(ffi.builder_build_return_void(state.builder$.ref()));
    }
    qid.TypeId return_type = local_type(state, body, body.return_local);
    if (function_abi.result.kind == .none || !llvm_type.type_has_abi_value(state, return_type)) {
        return ffi.value_valid(ffi.builder_build_return_void(state.builder$.ref()));
    }
    if (function_abi.result.is_indirect()) {
        return lower_indirect_return_value(state, output, body, llvm_function, local_slots);
    }
    return lower_return_value(state, output, body, local_slots);
}

Bool lower_indirect_return_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    ffi.Value llvm_function,
    list.ArrayList<ffi.Value>& local_slots
) {
    jil.LocalDecl return_local = body.locals[body.return_local.to_index()];
    ffi.Value source_pointer = local_slots.get(return_local.id.to_index());
    if (!ffi.value_valid(source_pointer)) {
        add_backend_error(
            output,
            "failed to lower LLVM indirect return source",
            "llvm_indirect_return_source_lower_failed"
        );
        return false;
    }
    ffi.Value return_pointer = ffi.function_param(llvm_function, 0);
    // sret 返回值同样是调用方提供的指针，按布局字节复制 return local。
    if (!copy_return_bytes(state, output, return_local.type_id, source_pointer, return_pointer)) {
        add_backend_error(output, "failed to copy LLVM indirect return value", "llvm_indirect_return_copy_failed");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_return_void(state.builder$.ref()));
}

Bool copy_return_bytes(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    qid.TypeId type_id,
    ffi.Value source_pointer,
    ffi.Value destination_pointer
) {
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type size_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    Int align = llvm_type.layout_align(state, type_id);
    return ffi.value_valid(ffi.builder_build_memcpy(
            state.builder$.ref(),
            destination_pointer,
            align,
            source_pointer,
            align,
            size
        )
    );
}

Bool lower_return_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    list.ArrayList<ffi.Value>& local_slots
) {
    jil.LocalDecl return_local = body.locals[body.return_local.to_index()];
    ffi.Value llvm_value = llvm_place.lower_local_load(state, return_local, local_slots);
    if (!ffi.value_valid(llvm_value)) {
        add_backend_error(output, "failed to load LLVM return value", "llvm_return_value_load_failed");
        return false;
    }
    if (!ffi.value_valid(ffi.builder_build_return(state.builder$.ref(), llvm_value))) {
        add_backend_error(output, "failed to build LLVM return", "llvm_return_build_failed");
        return false;
    }
    return true;
}

qid.TypeId local_type(llvm_state.LowerState& state, jil.Body& body, jil.LocalId local_id) {
    return state.type_id(body.locals[local_id.to_index()].type_id);
}
