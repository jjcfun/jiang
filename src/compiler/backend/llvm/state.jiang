// LLVM lowering 共享状态。
//
// type/place/value/terminator lowering 都需要访问同一组 LLVM handle。
// 这些 helper 本身不拥有状态，只通过 LowerState 读取编译上下文并发出 LLVM C API 调用。

import context = "../../context.jiang";
import diagnostic = "../../diagnostic.jiang";
import jil = "../../jil.jiang";
import qid = "../../id.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import system_memory = "../../system/memory.jiang";
import ffi = "./ffi.jiang";
import std;

@region(a, b, c)
public struct LowerState: Movable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(b)
    public jil.Store& store;
    public ffi.Context llvm_context;
    public ffi.Module module;
    public ffi.Builder builder;
    public ffi.Value current_function;
    @life(c)
    public system_memory.Allocator allocator;
    public generic_bindings.GenericBindings bindings!;
    Bool has_bindings!;

    public init(self,
        context.CompilerContext& ctx,
        jil.Store& store,
        ffi.Context llvm_context,
        ffi.Module module,
        ffi.Builder builder,
        ffi.Value current_function,
        system_memory.Allocator allocator,
        generic_bindings.GenericBindings bindings
    ) {
        self.ctx = ctx;
        self.store = store;
        self.llvm_context = llvm_context;
        self.module = module;
        self.builder = builder;
        self.current_function = current_function;
        self.allocator = allocator;
        self.has_bindings = bindings.len() > 0;
        self.bindings = bindings;
    }

    public qid.TypeId type_id(self, qid.TypeId value) {
        if (!self.has_bindings) { return value; }
        if (!self.ctx.store.types.type_needs_substitution(value)) { return value; }
        if (self.bindings.type_substitution(value) is .some(concrete)) {
            return concrete;
        }
        return generic_bindings.substitute_type(
            self.ctx.store.types$.ref(), value, self.bindings$.ref()
        );
    }

    public Bool instance_is_identity(self) {
        return !self.has_bindings;
    }
}

@region(a)
public struct LowerOutput: Movable {
    public map.WyHashMap<Int, Int> declared_function_indexes!;
    public list.ArrayList<ffi.Value> declared_function_values!;
    public table.MultiTable<UInt64, Int> lowered_function_name_indexes!;
    public list.ArrayList<std.String> lowered_function_names!;
    public list.ArrayList<ffi.Value> declared_external_function_values!;
    public map.WyHashMap<qid.SymbolId, Int> declared_external_function_indexes!;
    public map.WyHashMap<qid.SymbolId, Int> external_function_indexes!;
    public list.ArrayList<ffi.Value> external_function_values!;
    @life(a)
    public diagnostic.DiagnosticStore diagnostics!;

    public init(self) {
        self.declared_function_indexes = map.WyHashMap<Int, Int>();
        self.declared_function_values = list.ArrayList<ffi.Value>();
        self.lowered_function_name_indexes = table.MultiTable<UInt64, Int>();
        self.lowered_function_names = list.ArrayList<std.String>();
        self.declared_external_function_values = list.ArrayList<ffi.Value>();
        self.declared_external_function_indexes = map.WyHashMap<qid.SymbolId, Int>();
        self.external_function_indexes = map.WyHashMap<qid.SymbolId, Int>();
        self.external_function_values = list.ArrayList<ffi.Value>();
        self.diagnostics = diagnostic.DiagnosticStore();
    }

    public ffi.Value? declared_function(self, jil.MonoItem item) {
        guard self.declared_function_indexes.get(jil.mono_item_identity(item))
            is .some(index) else { return null; }
        return self.declared_function_values.get(index$.get());
    }

    public Void bind_declared_function(
        Self&! self,
        jil.MonoItem item,
        ffi.Value value
    ) {
        Int identity = jil.mono_item_identity(item);
        if (self.declared_function_indexes.has(identity)) { return; }
        Int index = self.declared_function_values.len();
        self.declared_function_values.add(value);
        self.declared_function_indexes.set(identity, index);
    }

    public Bool function_name_was_lowered(self, UInt8[]& name) {
        table.MultiTableCursor cursor! =
            self.lowered_function_name_indexes.first(hash.hash_bytes(name));
        while (cursor.valid()) {
            Int index = self.lowered_function_name_indexes.get(cursor);
            if (string.equal(self.lowered_function_names.ref_at(index).bytes(), name)) {
                return true;
            }
            cursor = self.lowered_function_name_indexes.next(cursor);
        }
        return false;
    }

    public Void mark_function_name_lowered(Self&! self, std.String name) {
        UInt64 name_hash = hash.hash_bytes(name.bytes());
        Int name_index = self.lowered_function_names.len();
        self.lowered_function_names.add(name);
        self.lowered_function_name_indexes.add(name_hash, name_index);
    }

    public Void add_diagnostic(Self&! self, diagnostic.Diagnostic value) {
        self.diagnostics.add(value);
    }
}
