// JIL -> LLVM C API lowering。
//
// 这里不再维护 backend 自己的 LLVM IR 中间层。LLVM module、type、
// value 和 builder 已经由 LLVM C API 表达；本层只负责把 JIL facts 映射
// 成必要的 LLVM calls。

import context = "../../context.jiang";
import diagnostic = "../../diagnostic.jiang";
import jil = "../../jil.jiang";
import jil_analysis = "../../jil/analysis.jiang";
import qid = "../../id.jiang";
import types = "../../sema/type.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import system_memory = "../../system/memory.jiang";
import backend_abi = "../abi.jiang";
import codegen_unit = "../codegen_unit.jiang";
import symbol = "../symbol.jiang";
import llvm_abi = "./abi.jiang";
import ffi = "./ffi.jiang";
import llvm_place = "./place.jiang";
import llvm_state = "./state.jiang";
import llvm_terminator = "./terminator.jiang";
import llvm_type = "./type.jiang";
import llvm_value = "./value.jiang";
import instance_reader = "../../jil/instance_reader.jiang";
import type_requirements = "../../jil/type_requirements.jiang";
import std;

// 独立 LLVM object 拥有自己的 LLVM Context 和 Module。它在当前 CGU 完成 pass
// 和 object emission 后立即释放，不跨 CGU 保留 CompilerStore 或 JIL 状态。
public struct ObjectUnit: Movable {
    ffi.Context llvm_context!;
    ffi.Module module!;
    std.String output_path;
    std.String pass_pipeline;
    std.String target_triple;
    Int opt_level;

    init(self,
        ffi.Context llvm_context,
        ffi.Module module,
        UInt8[]& output_path,
        Int opt_level,
        UInt8[]& pass_pipeline,
        UInt8[]& target_triple
    ) {
        self.llvm_context = llvm_context;
        self.module = module;
        self.output_path = std.String.from_valid_utf8(output_path);
        self.pass_pipeline = std.String.from_valid_utf8(pass_pipeline);
        self.target_triple = std.String.from_valid_utf8(target_triple);
        self.opt_level = opt_level;
    }

    public Bool emit(Self&! self) {
        Bool ok = ffi.module_emit_object(
            self.module$.ref(),
            self.output_path.bytes(),
            self.opt_level,
            self.pass_pipeline.bytes(),
            self.target_triple.bytes(),
            false
        );
        self.dispose();
        return ok;
    }

    Void dispose(Self&! self) {
        ffi.module_dispose(self.module$.mut_ref());
        ffi.context_dispose(self.llvm_context$.mut_ref());
    }

    deinit(self) {
        self.dispose();
    }
}

public Bool lower_module(context.CompilerContext&! ctx, jil.Store& store) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        .semantic,
        true,
        "default-target"
    );
    Bool ok = lowerer.lower_module(store);
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return ok;
}

public Bool emit_object_file(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple,
    Bool position_independent
) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        object_attribute_mode(opt_level),
        link_libc,
        target_triple
    );
    Bool ok = lowerer.emit_object_file(
        store,
        output_path,
        opt_level,
        pass_pipeline,
        position_independent
    );
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return ok;
}

jil_analysis.attributes.Mode object_attribute_mode(Int opt_level) {
    if (opt_level <= 0) { return .conservative; }
    return .semantic;
}

public Bool emit_object_unit_file(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    jil_analysis.attributes.Mode attribute_mode,
    list.ArrayList<jil.FunctionId>& shared_runtime_functions,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        attribute_mode,
        link_libc,
        target_triple
    );
    Bool ok = lowerer.emit_object_unit_file(
        store,
        unit,
        shared_runtime_functions,
        output_path,
        opt_level,
        pass_pipeline
    );
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return ok;
}

public ObjectUnit^? prepare_object_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    jil_analysis.attributes.Mode attribute_mode,
    list.ArrayList<jil.FunctionId>& shared_runtime_functions,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        attribute_mode,
        link_libc,
        target_triple
    );
    Bool ok = lowerer.lower_unit(store, unit, shared_runtime_functions);
    Bool has_errors = lowerer.output.diagnostics.has_errors();
    if (!ok || has_errors) {
        lowerer.dispose();
        diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
        ctx.store.diagnostics.append(diagnostics);
        return null;
    }
    ObjectUnit^ result = lowerer.take_object_unit(output_path, opt_level, pass_pipeline);
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return result;
}

public Bool emit_llvm_ir_file(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        .semantic,
        link_libc,
        target_triple
    );
    Bool ok = lowerer.emit_llvm_ir_file(store, output_path);
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return ok;
}

@life()
public UInt8[]&? emit_llvm_ir_text(
    context.CompilerContext&! ctx,
    jil.Store& store,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer lowerer! = LlvmLowerer(
        ctx,
        store,
        .semantic,
        link_libc,
        target_triple
    );
    UInt8[]&? text = lowerer.emit_llvm_ir_text(store);
    diagnostic.DiagnosticStore diagnostics = lowerer.finish_diagnostics();
    ctx.store.diagnostics.append(diagnostics);
    return text;
}

@region(a, b, c, d)
struct LlvmLowerer: Movable {
    @life(a)
    context.CompilerContext&! ctx;
    @life(b)
    jil.Store& store;
    jil_analysis.attributes.Mode attribute_mode;
    ffi.Context llvm_context!;
    ffi.Module module!;
    ffi.Builder builder!;
    @life(d)
    llvm_state.LowerOutput output!;
    @life(c)
    system_memory.Allocator allocator;
    @life(c)
    UInt8[]& target_triple!;
    Bool link_libc!;

    init(
        self,
        context.CompilerContext&! ctx,
        jil.Store& store,
        jil_analysis.attributes.Mode attribute_mode,
        Bool link_libc,
        UInt8[]& target_triple
    ) {
        self.ctx = ctx;
        self.store = store;
        self.attribute_mode = attribute_mode;
        self.output = llvm_state.LowerOutput();
        self.link_libc = link_libc;
        self.llvm_context = ffi.Context();
        self.module = ffi.Module(self.llvm_context$.ref(), "jiang_module");
        self.target_triple = self.effective_target_triple(target_triple);
        ffi.module_set_target_text(self.module$.ref(), self.target_triple);
        if (!ffi.module_set_target_data_layout_text(self.module$.ref(), self.target_triple)) {
            self.add_codegen_error("failed to initialize LLVM target data layout", "llvm_target_data_layout_failed");
        }
        self.builder = ffi.Builder(self.llvm_context$.ref());
        self.allocator = system_memory.allocator(link_libc);
    }

    @life(return: self.d)
    diagnostic.DiagnosticStore finish_diagnostics(Self self!) {
        return self.output.diagnostics.take();
    }

    ObjectUnit^ take_object_unit(
        Self&! self,
        UInt8[]& output_path,
        Int opt_level,
        UInt8[]& pass_pipeline
    ) {
        ffi.builder_dispose(self.builder$.mut_ref());
        ObjectUnit^ result = new ObjectUnit(
            self.llvm_context,
            self.module,
            output_path,
            opt_level,
            pass_pipeline,
            self.target_triple
        );
        self.module.raw = null;
        self.llvm_context.raw = null;
        return result;
    }

    @life(return: target_triple)
    UInt8[]& effective_target_triple(self, UInt8[]& target_triple) {
        if (target_triple.length == 0 || string.equal(target_triple, "default-target")) {
            return ffi.default_target_triple_text();
        }
        return target_triple;
    }

    Bool lower_module(Self&! self, jil.Store& store) {
        Bool ok = self.lower_store(store);
        self.dispose();
        return ok;
    }

    Bool emit_object_file(
        Self&! self,
        jil.Store& store,
        UInt8[]& output_path,
        Int opt_level,
        UInt8[]& pass_pipeline,
        Bool position_independent
    ) {
        Bool ok! = self.lower_store(store);
        if (ok) {
            ok = ffi.module_emit_object(
                self.module$.ref(),
                output_path,
                opt_level,
                pass_pipeline,
                self.target_triple,
                position_independent
            );
        }
        self.dispose();
        return ok;
    }

    Bool emit_object_unit_file(Self&! self,
        jil.Store& store,
        codegen_unit.CodegenUnit& unit,
        list.ArrayList<jil.FunctionId>& shared_runtime_functions,
        UInt8[]& output_path,
        Int opt_level,
        UInt8[]& pass_pipeline
    ) {
        Bool ok! = self.lower_unit(store, unit, shared_runtime_functions);
        if (ok) {
            ok = ffi.module_emit_object(
                self.module$.ref(),
                output_path,
                opt_level,
                pass_pipeline,
                self.target_triple,
                false
            );
        }
        self.dispose();
        return ok;
    }

    Bool emit_llvm_ir_file(Self&! self, jil.Store& store, UInt8[]& output_path) {
        Bool ok! = self.lower_store(store);
        if (ok) {
            ok = ffi.module_emit_llvm_ir(self.module$.ref(), output_path);
            if (!ok) {
                self.add_codegen_error("LLVM failed to write IR file", "llvm_write_ir_failed");
            }
        } else {
            self.add_codegen_error("LLVM lowering failed before writing IR", "llvm_lowering_failed");
        }
        self.dispose();
        return ok;
    }

    @life()
    UInt8[]&? emit_llvm_ir_text(Self&! self, jil.Store& store) {
        Bool ok! = self.lower_store(store);
        if (!ok) {
            self.add_codegen_error("LLVM lowering failed before writing IR", "llvm_lowering_failed");
            self.dispose();
            return null;
        }
        UInt8[]&? text = ffi.module_llvm_ir_text(self.module$.ref());
        if (text == null) {
            self.add_codegen_error("LLVM failed to print IR", "llvm_print_ir_failed");
        }
        self.dispose();
        return text;
    }

    Bool lower_unit(
        Self&! self,
        jil.Store& store,
        codegen_unit.CodegenUnit& unit,
        list.ArrayList<jil.FunctionId>& shared_runtime_functions
    ) {
        // 独立 object 只拥有当前 unit 的 body，其他函数由引用 lowering 按需声明。
        if (!self.declare_unit_functions(store, unit, shared_runtime_functions)
            || !self.declare_store_globals_for_unit(store, unit)
        ) {
            return false;
        }
        Int index! = 0;
        while (index < unit.functions.len()) {
            jil.MonoItem item = unit.functions.get(index);
            jil.Function function = codegen_unit.codegen_function(
                self.ctx, store, item
            );
            if (!self.should_lower_function(function$.ref())) {
                index = index + 1;
                continue;
            }
            if (!self.lower_function(item, function$.ref())) {
                self.add_function_codegen_error(
                    function$.ref(),
                    "failed to lower LLVM function body",
                    "llvm_function_body_lower_failed"
                );
                return false;
            }
            index = index + 1;
        }
        if (self.should_emit_linux_no_libc_runtime() && self.unit_contains_language_entry(store, unit)) {
            return self.lower_linux_no_libc_runtime();
        }
        return true;
    }

    Bool unit_contains_language_entry(self, jil.Store& store, codegen_unit.CodegenUnit& unit) {
        Int index! = 0;
        while (index < unit.functions.len()) {
            jil.Function function = codegen_unit.codegen_function(
                self.ctx, store, unit.functions.get(index)
            );
            if (function.is_language_entry) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool lower_store(Self&! self, jil.Store& store) {
        if (!self.declare_store_functions(store)
            || !self.declare_store_globals(store)
        ) {
            return false;
        }

        Int index! = 0;
        while (index < store.program.source_instance_count()) {
            Int identity = store.program.source_instance_identity_at(index);
            jil.MonoItem item = jil.source_instance_mono_item(identity);
            jil.Function function = codegen_unit.codegen_function(
                self.ctx,
                store,
                item
            );
            if (self.should_lower_function(function$.ref())
                && !self.lower_function(item, function$.ref())
            ) {
                self.add_function_codegen_error(
                    function$.ref(),
                    "failed to lower LLVM source instance body",
                    "llvm_source_instance_body_lower_failed"
                );
                return false;
            }
            qid.DefId source_def = store.program.function_instance_at(identity).def_id;
            if (!self.lower_source_resume(store, identity, source_def, .standard)
                || !self.lower_source_resume(store, identity, source_def, .confined)
                || !self.lower_source_resume(
                    store, identity, source_def, .run_to_completion
                )
            ) { return false; }
            index = index + 1;
        }
        index = 0;
        while (index < store.program.functions.len()) {
            jil.Function& function = store.program.functions.ref_at(index);
            jil.MonoItem item = jil.generated_function_mono_item(function.id);
            if (!self.should_lower_function(function)) {
                index = index + 1;
                continue;
            }
            Bool ok = self.lower_function(item, function);
            if (!ok) {
                self.add_function_codegen_error(
                    function,
                    "failed to lower LLVM function body",
                    "llvm_function_body_lower_failed"
                );
                return false;
            }
            index = index + 1;
        }
        if (self.should_emit_linux_no_libc_runtime()) {
            return self.lower_linux_no_libc_runtime();
        }
        return true;
    }

    Bool lower_source_resume(
        Self&! self,
        jil.Store& store,
        Int identity,
        qid.DefId source_def,
        jil.CoroutineResumeMode mode
    ) {
        if (!store.program.has_source_resume_template(source_def, mode)) { return true; }
        jil.Function resume = codegen_unit.codegen_function(
            self.ctx, store, jil.source_resume_mono_item(identity, mode)
        );
        if (!self.should_lower_function(resume$.ref())) { return true; }
        jil.MonoItem item = jil.source_resume_mono_item(identity, mode);
        if (self.lower_function(item, resume$.ref())) { return true; }
        self.add_function_codegen_error(
            resume$.ref(),
            "failed to lower LLVM source resume instance body",
            "llvm_source_resume_body_lower_failed"
        );
        return false;
    }

    Bool should_lower_function(self, jil.Function& function) {
        if (function.is_external) { return false; }
        return !function.is_coroutine
            || function.is_coroutine_resume
            || function.is_coroutine_completion;
    }

    Bool should_emit_linux_no_libc_runtime(self) {
        if (self.link_libc) {
            return false;
        }
        return string.equal(self.target_triple, "x86_64-unknown-linux-gnu");
    }

    Bool lower_linux_no_libc_runtime(Self&! self) {
        if (!self.lower_linux_no_libc_malloc()) {
            return false;
        }
        if (!self.lower_linux_no_libc_free()) {
            return false;
        }
        return self.lower_linux_no_libc_extendhfsf2();
    }

    Bool lower_linux_no_libc_malloc(Self&! self) {
        Int pointer_bits = self.ctx.query.layout.target().pointer_size * 8;
        ffi.Type size_type = ffi.context_int_type(self.llvm_context$.ref(), pointer_bits);
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(size_type);
        ffi.Type fn_type = ffi.function_type(ffi.context_pointer_type(self.llvm_context$.ref()), params$.ref());
        ffi.Value function = self.runtime_function("__jiang_malloc", fn_type);
        if (!ffi.value_valid(function)) {
            self.add_codegen_error("failed to declare Linux no-libc malloc", "llvm_linux_malloc_declare_failed");
            return false;
        }
        return self.lower_linux_no_libc_null_pointer_function(function);
    }

    Bool lower_linux_no_libc_free(Self&! self) {
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(ffi.context_pointer_type(self.llvm_context$.ref()));
        ffi.Type fn_type = ffi.function_type(ffi.context_void_type(self.llvm_context$.ref()), params$.ref());
        ffi.Value function = self.runtime_function("__jiang_free", fn_type);
        if (!ffi.value_valid(function)) {
            self.add_codegen_error("failed to declare Linux no-libc free", "llvm_linux_free_declare_failed");
            return false;
        }
        return self.lower_linux_no_libc_void_function(function);
    }

    Bool lower_linux_no_libc_extendhfsf2(Self&! self) {
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(ffi.context_int_type(self.llvm_context$.ref(), 16));
        ffi.Type fn_type = ffi.function_type(ffi.context_float_type(self.llvm_context$.ref()), params$.ref());
        ffi.Value function = self.runtime_function("__extendhfsf2", fn_type);
        if (!ffi.value_valid(function)) {
            self.add_codegen_error("failed to declare Linux no-libc half helper", "llvm_linux_half_declare_failed");
            return false;
        }
        return self.lower_linux_no_libc_zero_float_function(function);
    }

    ffi.Value runtime_function(self, UInt8[]& name, ffi.Type function_type) {
        ffi.Value existing = ffi.module_get_function(self.module$.ref(), name);
        if (ffi.value_valid(existing)) {
            return existing;
        }
        return ffi.module_add_function(self.module$.ref(), name, function_type);
    }

    Bool lower_linux_no_libc_null_pointer_function(self, ffi.Value function) {
        ffi.BasicBlock block = ffi.context_append_block(self.llvm_context$.ref(), function, "entry");
        if (!ffi.block_valid(block)) {
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), block);
        ffi.Type pointer_type = ffi.context_pointer_type(self.llvm_context$.ref());
        return ffi.value_valid(ffi.builder_build_return(self.builder$.ref(), ffi.const_null(pointer_type)));
    }

    Bool lower_linux_no_libc_void_function(self, ffi.Value function) {
        ffi.BasicBlock block = ffi.context_append_block(self.llvm_context$.ref(), function, "entry");
        if (!ffi.block_valid(block)) {
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), block);
        return ffi.value_valid(ffi.builder_build_return_void(self.builder$.ref()));
    }

    Bool lower_linux_no_libc_zero_float_function(self, ffi.Value function) {
        ffi.BasicBlock block = ffi.context_append_block(self.llvm_context$.ref(), function, "entry");
        if (!ffi.block_valid(block)) {
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), block);
        ffi.Type float_type = ffi.context_float_type(self.llvm_context$.ref());
        return ffi.value_valid(ffi.builder_build_return(self.builder$.ref(), ffi.const_real(float_type, 0.0)));
    }

    Bool declare_store_globals(Self&! self, jil.Store& store) {
        Bool ok! = ffi.context_valid(self.llvm_context$.ref())
            && ffi.module_valid(self.module$.ref())
            && ffi.builder_valid(self.builder$.ref());
        Int index! = 0;
        while (ok && index < store.program.globals.len()) {
            jil.Global& global = store.program.globals.ref_at(index);
            ffi.Value value = self.declare_global(global, !global.is_external);
            ok = ffi.value_valid(value);
            if (!ok) {
                self.add_codegen_error("failed to declare LLVM global", "llvm_global_declare_failed");
            }
            index = index + 1;
        }
        return ok;
    }

    Bool declare_store_globals_for_unit(
        Self&! self,
        jil.Store& store,
        codegen_unit.CodegenUnit& unit
    ) {
        Bool ok! = true;
        Int index! = 0;
        while (ok && index < unit.globals.len()) {
            jil.Global& global = store.program.globals.ref_at(unit.globals.get(index).to_index());
            index = index + 1;
            ok = ffi.value_valid(self.declare_global(global, true));
        }
        if (!ok) {
            self.add_codegen_error("failed to declare LLVM global", "llvm_global_declare_failed");
        }
        return ok;
    }

    ffi.Value declare_global(Self&! self, jil.Global& global, Bool owns_definition) {
        llvm_state.LowerState state! = self.lower_state();
        ffi.Type value_type = self.global_storage_type(state$.ref(), global);
        if (!ffi.type_valid(value_type)) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to lower LLVM global type",
                "llvm_global_type_lower_failed"
            );
            return ffi.Value();
        }
        std.String name = symbol.global_symbol_name_for_global(self.ctx, self.store, global);
        ffi.Value llvm_global! = ffi.module_get_global(self.module$.ref(), name.bytes());
        if (!ffi.value_valid(llvm_global)) {
            llvm_global = ffi.module_add_global(self.module$.ref(), name.bytes(), value_type);
        }
        if (!ffi.value_valid(llvm_global)) {
            return ffi.Value();
        }
        if (owns_definition && global.initializer is .some(initializer)) {
            ffi.Value value = llvm_value.lower_static_value(
                state$.ref(), self.output$.mut_ref(), initializer, global.type_id
            );
            if (!ffi.value_valid(value)) {
                add_codegen_error_to(
                    self.output$.mut_ref(),
                    "failed to lower LLVM global initializer",
                    "llvm_global_initializer_lower_failed"
                );
                return ffi.Value();
            }
            ffi.global_set_initializer(llvm_global, value);
        } else if (owns_definition) {
            ffi.global_set_initializer(llvm_global, ffi.const_null(value_type));
        }
        ffi.global_set_constant(llvm_global, global.read_only);
        return llvm_global;
    }

    ffi.Type global_storage_type(self, llvm_state.LowerState& state, jil.Global& global) {
        if (global.initializer is .some(initializer)) {
            if (initializer is .aggregate(_)) {
                if (llvm_type.is_trait_vtable_type(state, global.type_id)) {
                    return llvm_type.trait_vtable_storage_type(state, global.type_id);
                }
            }
        }
        return llvm_type.lower_type(state, global.type_id);
    }

    Bool declare_store_functions(Self&! self, jil.Store& store) {
        Bool ok! = ffi.context_valid(self.llvm_context$.ref())
            && ffi.module_valid(self.module$.ref())
            && ffi.builder_valid(self.builder$.ref());
        Int index! = 0;
        while (ok && index < store.program.source_instance_count()) {
            Int identity = store.program.source_instance_identity_at(index);
            jil.MonoItem item = jil.source_instance_mono_item(identity);
            jil.Function function = codegen_unit.codegen_function(
                self.ctx,
                store,
                item
            );
            ffi.Value llvm_function = self.declare_function(function$.ref());
            ok = ffi.value_valid(llvm_function);
            if (ok) { self.output.bind_declared_function(item, llvm_function); }
            if (!ok) {
                self.add_function_codegen_error(
                    function$.ref(),
                    "failed to declare LLVM source instance",
                    "llvm_source_instance_declare_failed"
                );
            }
            qid.DefId source_def = store.program.function_instance_at(identity).def_id;
            ok = ok && self.declare_source_resume(
                store, identity, source_def, .standard
            );
            ok = ok && self.declare_source_resume(
                store, identity, source_def, .confined
            );
            ok = ok && self.declare_source_resume(
                store, identity, source_def, .run_to_completion
            );
            index = index + 1;
        }
        index = 0;
        while (ok && index < store.program.functions.len()) {
            jil.Function& function = store.program.functions.ref_at(index);
            jil.MonoItem item = jil.generated_function_mono_item(function.id);
            ffi.Value llvm_function = self.declare_function(function$.ref());
            ok = ffi.value_valid(llvm_function);
            if (ok) { self.output.bind_declared_function(item, llvm_function); }
            if (!ok) {
                self.add_function_codegen_error(
                    function$.ref(),
                    "failed to declare LLVM function",
                    "llvm_function_declare_failed"
                );
            }
            index = index + 1;
        }
        return ok;
    }

    Bool declare_source_resume(
        Self&! self,
        jil.Store& store,
        Int identity,
        qid.DefId source_def,
        jil.CoroutineResumeMode mode
    ) {
        if (!store.program.has_source_resume_template(source_def, mode)) { return true; }
        jil.MonoItem item = jil.source_resume_mono_item(identity, mode);
        jil.Function resume = codegen_unit.codegen_function(
            self.ctx, store, item
        );
        ffi.Value llvm_function = self.declare_function(resume$.ref());
        if (ffi.value_valid(llvm_function)) {
            self.output.bind_declared_function(item, llvm_function);
            return true;
        }
        self.add_function_codegen_error(
            resume$.ref(),
            "failed to declare LLVM source resume instance",
            "llvm_source_resume_declare_failed"
        );
        return false;
    }

    Bool declare_unit_functions(
        Self&! self,
        jil.Store& store,
        codegen_unit.CodegenUnit& unit,
        list.ArrayList<jil.FunctionId>& shared_runtime_functions
    ) {
        Int index! = 0;
        while (index < unit.functions.len()) {
            jil.MonoItem item = unit.functions.get(index);
            jil.Function function = codegen_unit.codegen_function(
                self.ctx, store, item
            );
            ffi.Value llvm_function = self.declare_function(function$.ref());
            if (!ffi.value_valid(llvm_function)) {
                self.add_function_codegen_error(
                    function$.ref(),
                    "failed to declare LLVM function",
                    "llvm_function_declare_failed"
                );
                return false;
            }
            self.output.bind_declared_function(item, llvm_function);
            self.add_unit_monomorph_linkage(unit, function$.ref(), llvm_function);
            index = index + 1;
        }
        return self.declare_shared_runtime_functions(store, shared_runtime_functions);
    }

    Bool declare_shared_runtime_functions(
        Self&! self,
        jil.Store& store,
        list.ArrayList<jil.FunctionId>& shared_runtime_functions
    ) {
        Int index! = 0;
        while (index < shared_runtime_functions.len()) {
            jil.FunctionId function_id = shared_runtime_functions.get(index);
            jil.Function& function = store.program.functions.ref_at(function_id.to_index());
            jil.MonoItem item = jil.generated_function_mono_item(function_id);
            index = index + 1;
            if (self.output.declared_function(item) != null) { continue; }
            ffi.Value llvm_function = self.declare_function(function);
            if (!ffi.value_valid(llvm_function)) {
                self.add_function_codegen_error(
                    function,
                    "failed to declare shared runtime function",
                    "llvm_runtime_function_declare_failed"
                );
                return false;
            }
            self.output.bind_declared_function(item, llvm_function);
        }
        return true;
    }

    Void add_unit_monomorph_linkage(
        self,
        codegen_unit.CodegenUnit& unit,
        jil.Function& function,
        ffi.Value llvm_function
    ) {
        if (!unit.weak_monomorph_definitions) { return; }
        ffi.value_set_link_once_odr_linkage(llvm_function);
    }

    Void dispose(Self&! self) {
        ffi.builder_dispose(self.builder$.mut_ref());
        ffi.module_dispose(self.module$.mut_ref());
        ffi.context_dispose(self.llvm_context$.mut_ref());
    }

    ffi.Value declare_function(Self&! self, jil.Function& function) {
        if (symbol.function_uses_source_abi_symbol(self.ctx, function)) {
            return self.declare_external_function(function);
        }
        return self.declare_new_function(function);
    }

    ffi.Value declare_external_function(Self&! self, jil.Function& function) {
        qid.DefId provenance_def = jil.function_provenance_def(function.origin);
        qid.SymbolId symbol_id = self.ctx.store.defs.get(provenance_def).name.symbol;
        if (self.output.declared_external_function_indexes.get(symbol_id) is .some(index)) {
            return self.output.declared_external_function_values.get(index$.get());
        }

        ffi.Value llvm_function = self.declare_new_function(function);
        if (ffi.value_valid(llvm_function)) {
            Int function_index = self.output.declared_external_function_values.len();
            self.output.declared_external_function_values.add(llvm_function);
            self.output.declared_external_function_indexes.set(
                symbol_id, function_index
            );
        }
        return llvm_function;
    }

    ffi.Value declare_new_function(Self&! self, jil.Function& function) {
        jil.Body& body = function.body$.ref();
        jil_analysis.attributes.FunctionFacts attribute_facts =
            jil_analysis.attributes.facts_for_function(
                self.ctx, function$.get(), self.attribute_mode
            );
        llvm_state.LowerState state! = self.lower_state_for_function(function);
        instance_reader.InstanceReader reader = instance_reader.InstanceReader(
            self.ctx.store$.ref(), state.bindings$.ref()
        );
        backend_abi.FunctionAbi function_abi! = backend_abi.classify_jil_instance(
            self.ctx, reader$.ref(), body
        );
        ffi.Type function_type = llvm_abi.function_type(state$.ref(), function_abi$.ref());
        if (!ffi.type_valid(function_type)) {
            add_function_codegen_error_to(
                state.ctx,
                state.store,
                self.output$.mut_ref(),
                function,
                "failed to lower LLVM function ABI type",
                "llvm_function_abi_type_lower_failed"
            );
            return ffi.Value();
        }
        std.String name = self.function_symbol_name(function);
        ffi.Value llvm_function! = ffi.module_get_function(self.module$.ref(), name.bytes());
        if (ffi.value_valid(llvm_function)
            && !ffi.type_equal(ffi.global_value_type(llvm_function), function_type)) {
            add_function_codegen_error_to(
                state.ctx,
                state.store,
                self.output$.mut_ref(),
                function,
                "duplicate LLVM function symbol has an incompatible ABI",
                "llvm_function_symbol_abi_mismatch"
            );
            return ffi.Value();
        }
        if (!ffi.value_valid(llvm_function)) {
            llvm_function = ffi.module_add_function(self.module$.ref(), name.bytes(), function_type);
        }
        if (ffi.value_valid(llvm_function)) {
            llvm_abi.add_function_attributes(state$.ref(), llvm_function, function_abi$.ref());
            llvm_abi.add_proven_parameter_attributes(
                state$.ref(),
                llvm_function,
                function_abi$.ref(),
                attribute_facts$.ref()
            );
            self.add_inline_attribute(function, llvm_function);
            self.add_naked_attribute(function, llvm_function);
            self.add_internal_linkage(function, name.bytes(), llvm_function);
        }
        return llvm_function;
    }

    Void add_inline_attribute(self, jil.Function& function, ffi.Value llvm_function) {
        if (!function.inline_always) { return; }
        ffi.function_add_enum_attribute(self.llvm_context$.ref(), llvm_function, -1, "alwaysinline");
    }

    Void add_naked_attribute(self, jil.Function& function, ffi.Value llvm_function) {
        if (!function.naked) { return; }
        ffi.function_add_enum_attribute(self.llvm_context$.ref(), llvm_function, -1, "naked");
    }

    Void add_internal_linkage(
        self,
        jil.Function& function,
        UInt8[]& name,
        ffi.Value llvm_function
    ) {
        if (!self.function_is_local_variant(function)) {
            return;
        }
        ffi.value_set_internal_linkage(llvm_function);
    }

    Bool function_is_local_variant(self, jil.Function& function) {
        guard jil.function_generated_origin(function.origin) is .some(origin) else { return false; }
        if (origin.kind == .coroutine_resume_confined) { return true; }
        if (origin.kind == .coroutine_resume_rtc) { return true; }
        return origin.kind == .serial_completion;
    }

    std.String function_symbol_name(self, jil.Function& function) {
        return symbol.function_symbol_name(self.ctx, self.store, function);
    }

    Bool lower_function(
        Self&! self,
        jil.MonoItem item,
        jil.Function& function
    ) {
        std.String name = self.function_symbol_name(function);
        if (self.output.function_name_was_lowered(name.bytes())) {
            return true;
        }
        guard self.output.declared_function(item) is .some(llvm_function)
            else { return false; }
        if (!self.lower_body(function, llvm_function)) {
            return false;
        }
        self.output.mark_function_name_lowered(name);
        return true;
    }

    Bool lower_body(Self&! self,
        jil.Function& function,
        ffi.Value llvm_function
    ) {
        jil.Body& body = function.body$.ref();
        llvm_state.LowerState state! =
            self.lower_body_state_for_function(function, llvm_function);
        instance_reader.InstanceReader reader = instance_reader.InstanceReader(
            self.ctx.store$.ref(), state.bindings$.ref()
        );
        if (body.blocks.length == 0) {
            return true;
        }
        backend_abi.FunctionAbi function_abi! = backend_abi.classify_jil_instance(
            self.ctx, reader$.ref(), body
        );
        ffi.BasicBlock prologue = ffi.context_append_block(
            self.llvm_context$.ref(),
            llvm_function,
            "entry"
        );
        if (!ffi.block_valid(prologue)) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to create LLVM function prologue",
                "llvm_prologue_create_failed"
            );
            return false;
        }
        list.ArrayList<ffi.BasicBlock> blocks! = self.create_basic_blocks(body, llvm_function);
        if (blocks.len() != body.blocks.length) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to create LLVM basic blocks",
                "llvm_block_create_failed"
            );
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), prologue);
        list.ArrayList<ffi.Value> local_slots! = self.allocate_local_slots(
            state$.ref(), body
        );
        if (local_slots.len() != body.locals.length) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to allocate LLVM local slots",
                "llvm_local_slot_alloc_failed"
            );
            return false;
        }
        if (!self.store_function_params(
            state$.ref(), body, function_abi$.ref(), llvm_function, local_slots$.ref()
        )) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to store LLVM function parameters",
                "llvm_param_store_failed"
            );
            return false;
        }
        if (!ffi.value_valid(ffi.builder_build_br(self.builder$.ref(), blocks.get(body.entry.to_index())))) {
            add_codegen_error_to(
                self.output$.mut_ref(),
                "failed to branch from LLVM prologue",
                "llvm_prologue_branch_failed"
            );
            return false;
        }
        FunctionEmitter emitter! = FunctionEmitter(
            self.llvm_context,
            self.module,
            self.builder,
            self.output$.mut_ref()
        );
        return emitter.lower_blocks(
            state$.ref(), body, function_abi$.ref(), llvm_function, blocks$.ref(),
            local_slots$.ref()
        );
    }

    list.ArrayList<ffi.BasicBlock> create_basic_blocks(self, jil.Body& body, ffi.Value llvm_function) {
        list.ArrayList<ffi.BasicBlock> blocks! = list.ArrayList<ffi.BasicBlock>(body.blocks.length);
        Int index! = 0;
        while (index < body.blocks.length) {
            ffi.BasicBlock block = ffi.context_append_block(
                self.llvm_context$.ref(),
                llvm_function,
                "bb"
            );
            if (!ffi.block_valid(block)) {
                return blocks;
            }
            blocks.add(block);
            index = index + 1;
        }
        return blocks;
    }

    Bool store_function_params(
        self,
        llvm_state.LowerState& state,
        jil.Body& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int llvm_index! = 0;
        if (function_abi.result.is_indirect()) {
            llvm_index = 1;
        }
        Int source_param_index! = 0;
        Int local_index! = 0;
        while (local_index < body.locals.length) {
            jil.LocalDecl local = body.locals[local_index];
            if (local.kind == .param) {
                backend_abi.AbiArg param_abi = function_abi.params.get(source_param_index);
                if (param_abi.kind == .direct) {
                    ffi.Value param = ffi.function_param(llvm_function, llvm_index);
                    if (!self.store_local_value(local, local_slots, param)) { return false; }
                    llvm_index = llvm_index + 1;
                } else if (param_abi.kind == .indirect) {
                    ffi.Value param = ffi.function_param(llvm_function, llvm_index);
                    if (!self.store_indirect_param(
                        state, local, local_slots, param
                    )) { return false; }
                    llvm_index = llvm_index + 1;
                }
                source_param_index = source_param_index + 1;
            }
            local_index = local_index + 1;
        }
        return true;
    }

    Bool store_indirect_param(
        self,
        llvm_state.LowerState& state,
        jil.LocalDecl local,
        list.ArrayList<ffi.Value>& local_slots,
        ffi.Value param_pointer
    ) {
        ffi.Value pointer = local_slots.get(local.id.to_index());
        if (!ffi.value_valid(pointer)) {
            return false;
        }
        // indirect 参数在 LLVM ABI 中已经是指针；本地 slot 需要拷贝参数指向的
        // 实际对象，不能先 load 成聚合值再 store。
        return copy_pointer_bytes(
            state, param_pointer, pointer, state.type_id(local.type_id)
        );
    }

    Bool store_local_value(self,
        jil.LocalDecl local,
        list.ArrayList<ffi.Value>& local_slots,
        ffi.Value value
    ) {
        if (!ffi.value_valid(value)) {
            return false;
        }
        ffi.Value pointer = local_slots.get(local.id.to_index());
        if (!ffi.value_valid(pointer)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), value, pointer));
    }

    list.ArrayList<ffi.Value> allocate_local_slots(
        self,
        llvm_state.LowerState& state,
        jil.Body& body
    ) {
        list.ArrayList<ffi.Value> values! = list.ArrayList<ffi.Value>(body.locals.length);
        Int index! = 0;
        while (index < body.locals.length) {
            ffi.Value slot = self.allocate_local_slot(state, body.locals[index]);
            if (!ffi.value_valid(slot)) {
                return values;
            }
            values.add(slot);
            index = index + 1;
        }
        return values;
    }

    ffi.Value allocate_local_slot(
        self,
        llvm_state.LowerState& state,
        jil.LocalDecl local
    ) {
        qid.TypeId type_id = state.type_id(local.type_id);
        if (!llvm_type.type_has_abi_value(state, type_id)) {
            return ffi.const_null(ffi.context_pointer_type(state.llvm_context$.ref()));
        }
        ffi.Type type = llvm_type.lower_type(state, type_id);
        if (!ffi.type_valid(type)) {
            return ffi.Value();
        }
        return ffi.builder_build_alloca(self.builder$.ref(), type);
    }

}

@region(a)
struct FunctionEmitter: Movable {
    ffi.Context llvm_context;
    ffi.Module module;
    ffi.Builder builder;
    @life(a)
    llvm_state.LowerOutput&! output;

    init(
        self,
        ffi.Context llvm_context,
        ffi.Module module,
        ffi.Builder builder,
        llvm_state.LowerOutput&! output
    ) {
        self.llvm_context = llvm_context;
        self.module = module;
        self.builder = builder;
        self.output = output;
    }

    // JIL 是 place-based、非 SSA。LLVM lowering 的 baseline 先把 local
    // 映射为 stack slot，assignment 生成 store，operand 生成 load。
    Bool lower_statements(Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        ffi.Value llvm_function,
        jil.Block& block,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int index! = 0;
        while (index < block.statements.length) {
            if (!self.lower_statement(
                state,
                body,
                llvm_function,
                block.statements[index]$.ref(),
                local_slots
            )) {
                self.add_statement_lower_error(block.statements[index]$.ref());
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Void add_statement_lower_error(Self&! self, jil.Statement& statement) {
        if (statement.kind is .atomic_store_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM atomic store", "llvm_atomic_store_lower_failed");
            return;
        }
        if (statement.kind is .executor_leave_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM executor leave", "llvm_executor_leave_lower_failed");
            return;
        }
        if (statement.kind is .task_suspend_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM task suspend", "llvm_task_suspend_lower_failed");
            return;
        }
        if (statement.kind is .task_complete_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM task completion", "llvm_task_complete_lower_failed");
            return;
        }
        if (statement.kind is .task_wait_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM task wait", "llvm_task_wait_lower_failed");
            return;
        }
        if (statement.kind is .task_release_stmt(_)) {
            self.add_codegen_error("failed to lower LLVM task release", "llvm_task_release_lower_failed");
            return;
        }
        if (statement.kind is .task_owner_release_stmt(_)) {
            self.add_codegen_error(
                "failed to lower LLVM task owner release",
                "llvm_task_owner_release_lower_failed"
            );
            return;
        }
        if (statement.kind is .set_discriminant_stmt(_)) {
            self.add_codegen_error(
                "failed to lower LLVM discriminant store",
                "llvm_set_discriminant_lower_failed"
            );
        }
    }

    Bool lower_blocks(Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        list.ArrayList<ffi.BasicBlock>& blocks,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int index! = 0;
        while (index < body.blocks.length) {
            ffi.builder_position_at_end(self.builder$.ref(), blocks.get(index));
            if (!self.lower_statements(
                state, body, llvm_function, body.blocks[index]$.ref(), local_slots
            )) {
                return false;
            }
            if (!self.lower_terminator(
                state,
                body,
                function_abi,
                llvm_function,
                body.blocks[index].terminator$.ref(),
                blocks,
                local_slots
            )) {
                self.add_terminator_lower_error(
                    body.blocks[index].terminator$.ref()
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Void add_terminator_lower_error(
        Self&! self,
        jil.Terminator& terminator
    ) {
        if (terminator.kind is .call_term(_)) {
            self.add_codegen_error(
                "failed to lower LLVM call terminator",
                "llvm_call_terminator_lower_failed"
            );
            return;
        }
        if (terminator.kind is .drop_term(_)) {
            self.add_codegen_error(
                "failed to lower LLVM drop terminator",
                "llvm_drop_terminator_lower_failed"
            );
            return;
        }
        if (terminator.kind is .suspend_pending_term(_)) {
            self.add_codegen_error(
                "failed to lower LLVM suspend terminator",
                "llvm_suspend_terminator_lower_failed"
            );
            return;
        }
        self.add_codegen_error(
            "failed to lower LLVM terminator",
            "llvm_terminator_lower_failed"
        );
    }

    Bool lower_statement(Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        ffi.Value llvm_function,
        jil.Statement& statement,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (statement.kind is .assign_stmt(ref _ assign_stmt)) {
            if (!self.lower_assign(state, body, assign_stmt, local_slots)) {
                self.add_codegen_error("failed to lower LLVM assignment", "llvm_assign_lower_failed");
                return false;
            }
            return true;
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            ffi.Value pointer = llvm_place.lower_place_pointer(
                state, self.output$.mut_ref(), body, atomic_store.destination, local_slots
            );
            ffi.Value value = llvm_value.lower_operand(
                state, self.output$.mut_ref(), body, atomic_store.value, local_slots
            );
            if (atomic_store.mode == .coroutine_local) {
                return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), value, pointer));
            }
            return ffi.value_valid(ffi.builder_build_atomic_store(
                state.builder$.ref(),
                value,
                pointer,
                llvm_value.atomic_ordering(atomic_store.ordering)
            ));
        }
        if (statement.kind is .executor_leave_stmt(executor_leave)) {
            ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
            list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(2);
            params.add(pointer_type);
            params.add(pointer_type);
            ffi.Type runtime_type = ffi.function_type(
                ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
            );
            ffi.Value runtime = self.runtime_function(
                "__jiang_runtime_executor_leave", runtime_type
            );
            if (!ffi.value_valid(runtime)) { return false; }
            list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(2);
            args.add(llvm_place.lower_local_load(
                state, body.locals[executor_leave.executor.to_index()], local_slots
            ));
            args.add(llvm_place.lower_local_load(
                state, body.locals[executor_leave.previous_context.to_index()], local_slots
            ));
            return ffi.value_valid(ffi.builder_build_call(
                state.builder$.ref(), runtime_type, runtime, args$.ref()
            ));
        }
        if (statement.kind is .task_suspend_stmt(suspend)) {
            return self.lower_task_suspend(state, body, suspend, local_slots);
        }
        if (statement.kind is .task_complete_stmt(complete)) {
            return self.lower_task_complete(state, body, complete, local_slots);
        }
        if (statement.kind is .storage_live_stmt(_)) {
            return true;
        }
        if (statement.kind is .storage_dead_stmt(_)) {
            return true;
        }
        if (statement.kind is .drop_initialized_stmt(_)) {
            return true;
        }
        if (statement.kind is .forget_stmt(_)) {
            return true;
        }
        if (statement.kind is .exclusive_stmt(_)) {
            return true;
        }
        if (statement.kind is .task_consume_stmt(_)) {
            return true;
        }
        if (statement.kind is .task_region_start_stmt(_)) {
            return true;
        }
        if (statement.kind is .capture_bind_stmt(_)) {
            return true;
        }
        if (statement.kind is .task_wait_stmt(wait)) {
            ffi.Value pointer = llvm_place.lower_place_pointer(
                state, self.output$.mut_ref(), body, wait.state, local_slots
            );
            if (!ffi.value_valid(pointer)) { return false; }
            if (wait.wake) { return self.lower_task_wake(pointer); }
            ffi.Value expected = llvm_value.lower_operand(
                state, self.output$.mut_ref(), body, wait.expected, local_slots
            );
            return self.lower_task_wait(pointer, expected);
        }
        if (statement.kind is .task_release_stmt(release)) {
            return self.lower_task_release(state, body, llvm_function, release, local_slots);
        }
        if (statement.kind is .task_owner_release_stmt(release)) {
            return self.lower_task_owner_release(state, body, release.pointer, local_slots);
        }
        if (statement.kind is .set_discriminant_stmt(set_discriminant)) {
            return llvm_value.lower_set_discriminant(
                state,
                self.output$.mut_ref(),
                body,
                set_discriminant,
                local_slots
            );
        }
        self.add_codegen_error("unsupported JIL statement in LLVM lowering", "llvm_statement_unsupported");
        return false;
    }

    Bool lower_task_suspend(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.TaskSuspendStatement suspend,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value task_value = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: suspend.task)),
            local_slots
        );
        UInt8[]& runtime_name! = "__jiang_runtime_task_suspend";
        if (suspend.mode == .local) {
            runtime_name = "__jiang_runtime_task_suspend_local";
        }
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(pointer_type);
        ffi.Type runtime_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
        );
        ffi.Value runtime = self.runtime_function(runtime_name, runtime_type);
        if (!ffi.value_valid(task_value) || !ffi.value_valid(runtime)) { return false; }
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
        args.add(task_value);
        return ffi.value_valid(ffi.builder_build_call(state.builder$.ref(), runtime_type, runtime, args$.ref()));
    }

    Bool lower_task_complete(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.TaskCompleteStatement complete,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value task_value = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: complete.task)),
            local_slots
        );
        UInt8[]& runtime_name! = "__jiang_runtime_task_complete";
        if (complete.owner_lifecycle) {
            runtime_name = "__jiang_runtime_task_owner_complete";
        }
        if (!complete.owner_lifecycle && complete.mode == .local) {
            runtime_name = "__jiang_runtime_task_complete_local";
        }
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(pointer_type);
        ffi.Type runtime_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
        );
        ffi.Value runtime = self.runtime_function(runtime_name, runtime_type);
        if (!ffi.value_valid(task_value) || !ffi.value_valid(runtime)) { return false; }
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
        args.add(task_value);
        return ffi.value_valid(ffi.builder_build_call(
            state.builder$.ref(), runtime_type, runtime, args$.ref()
        ));
    }

    Bool lower_task_wait(self, ffi.Value state_pointer, ffi.Value expected) {
        ffi.Type int64_type = ffi.context_int_type(self.llvm_context$.ref(), 64);
        ffi.Type pointer_type = ffi.context_pointer_type(self.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(2);
        params.add(pointer_type);
        params.add(int64_type);
        ffi.Type function_type = ffi.function_type(
            ffi.context_void_type(self.llvm_context$.ref()), params$.ref()
        );
        ffi.Value function = self.runtime_function("__jiang_system_thread_wait_word", function_type);
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(2);
        args.add(state_pointer);
        args.add(expected);
        return ffi.value_valid(ffi.builder_build_call(
            self.builder$.ref(), function_type, function, args$.ref()
        ));
    }

    Bool lower_task_wake(self, ffi.Value state_pointer) {
        ffi.Type pointer_type = ffi.context_pointer_type(self.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(pointer_type);
        ffi.Type function_type = ffi.function_type(
            ffi.context_void_type(self.llvm_context$.ref()), params$.ref()
        );
        ffi.Value function = self.runtime_function("__jiang_system_thread_wake_word", function_type);
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
        args.add(state_pointer);
        return ffi.value_valid(ffi.builder_build_call(
            self.builder$.ref(), function_type, function, args$.ref()
        ));
    }

    Bool lower_task_release(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        ffi.Value llvm_function,
        jil.TaskReleaseStatement release,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value task_pointer = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: release.task_pointer)),
            local_slots
        );
        if (!ffi.value_valid(task_pointer)) { return false; }
        ffi.BasicBlock release_block = ffi.context_append_block(
            state.llvm_context$.ref(), llvm_function, "task.release.present"
        );
        ffi.BasicBlock continue_block = ffi.context_append_block(
            state.llvm_context$.ref(), llvm_function, "task.release.absent"
        );
        if (!ffi.block_valid(release_block) || !ffi.block_valid(continue_block)) { return false; }
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        ffi.Value is_null = ffi.builder_build_icmp(
            state.builder$.ref(), 32, task_pointer, ffi.const_null(pointer_type)
        );
        if (!ffi.value_valid(is_null)) { return false; }
        if (!ffi.value_valid(ffi.builder_build_cond_br(
            state.builder$.ref(), is_null, continue_block, release_block
        ))) { return false; }
        ffi.builder_position_at_end(state.builder$.ref(), release_block);
        if (!self.lower_owned_task_release(
            state, body, llvm_function, release, local_slots
        )) { return false; }
        if (!ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), continue_block))) { return false; }
        ffi.builder_position_at_end(state.builder$.ref(), continue_block);
        return true;
    }

    Bool lower_owned_task_release(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        ffi.Value llvm_function,
        jil.TaskReleaseStatement release,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (!self.lower_task_result_drop(state, body, llvm_function, release, local_slots)) {
            self.add_codegen_error(
                "failed to lower LLVM task result drop",
                "llvm_task_result_drop_lower_failed"
            );
            return false;
        }
        if (!self.lower_task_frame_release(state, body, release, local_slots)) {
            self.add_codegen_error(
                "failed to lower LLVM task frame release",
                "llvm_task_frame_release_lower_failed"
            );
            return false;
        }
        if (release.storage.reclaim == .self_owned) {
            return self.lower_task_allocation_release(state, body, release.task_pointer, local_slots);
        }
        if (release.storage.allocation != .heap) { return true; }
        return self.lower_task_owner_consumed(state, body, release.task_pointer, local_slots);
    }

    Bool lower_task_owner_consumed(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.Place task_pointer,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value pointer = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: task_pointer)),
            local_slots
        );
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(pointer_type);
        ffi.Type runtime_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
        );
        ffi.Value runtime = self.runtime_function(
            "__jiang_runtime_task_owner_consumed",
            runtime_type
        );
        if (!ffi.value_valid(pointer) || !ffi.value_valid(runtime)) { return false; }
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
        args.add(pointer);
        return ffi.value_valid(ffi.builder_build_call(
            state.builder$.ref(), runtime_type, runtime, args$.ref()
        ));
    }

    Bool lower_task_owner_release(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.Place pointer_place,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value pointer = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: pointer_place)),
            local_slots
        );
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
        params.add(pointer_type);
        ffi.Type runtime_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()), params$.ref()
        );
        ffi.Value runtime = self.runtime_function(
            "__jiang_runtime_task_owner_release",
            runtime_type
        );
        if (!ffi.value_valid(pointer) || !ffi.value_valid(runtime)) { return false; }
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
        args.add(pointer);
        return ffi.value_valid(ffi.builder_build_call(
            state.builder$.ref(), runtime_type, runtime, args$.ref()
        ));
    }

    Bool lower_task_frame_release(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.TaskReleaseStatement release,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (release.storage.frame != .heap) { return true; }
        ffi.Value pointer = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: release.frame)),
            local_slots
        );
        if (!ffi.value_valid(pointer)) { return false; }
        return ffi.value_valid(llvm_value.lower_heap_pointer_free(state, self.output$.mut_ref(), pointer));
    }

    Bool lower_task_allocation_release(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.Place task_pointer,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Value pointer = llvm_value.lower_operand(
            state,
            self.output$.mut_ref(),
            body,
            jil.copy_operand_value(jil.CopyOperand (place: task_pointer)),
            local_slots
        );
        if (!ffi.value_valid(pointer)) { return false; }
        return ffi.value_valid(llvm_value.lower_heap_pointer_free(state, self.output$.mut_ref(), pointer));
    }

    Bool lower_task_result_drop(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        ffi.Value llvm_function,
        jil.TaskReleaseStatement release,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (release.result_consumed) { return true; }
        ffi.Value completed_pointer = llvm_place.lower_place_pointer(
            state, self.output$.mut_ref(), body, release.state, local_slots
        );
            ffi.Type completed_type = llvm_type.lower_type(
                state, state.ctx.store.types.int_type()
            );
        if (!ffi.value_valid(completed_pointer) || !ffi.type_valid(completed_type)) { return false; }
        ffi.Value completed!;
        if (release.storage.sync == .concurrent) {
            completed = ffi.builder_build_atomic_load(
                state.builder$.ref(), completed_type, completed_pointer, Int32(4)
            );
        } else {
            completed = ffi.builder_build_load(
                state.builder$.ref(), completed_type, completed_pointer
            );
        }
        ffi.Value should_drop = ffi.builder_build_icmp(
            state.builder$.ref(), 32, completed, ffi.const_int(completed_type, 1)
        );
        ffi.BasicBlock drop_block = ffi.context_append_block(
            state.llvm_context$.ref(), llvm_function, "task.result.drop"
        );
        ffi.BasicBlock continue_block = ffi.context_append_block(
            state.llvm_context$.ref(), llvm_function, "task.result.drop.continue"
        );
        if (!ffi.value_valid(should_drop)
            || !ffi.block_valid(drop_block)
            || !ffi.block_valid(continue_block)
        ) {
            return false;
        }
        if (!ffi.value_valid(ffi.builder_build_cond_br(
            state.builder$.ref(), should_drop, drop_block, continue_block
        ))) { return false; }
        ffi.builder_position_at_end(state.builder$.ref(), drop_block);
        if (!self.lower_initialized_task_result_drop(state, body, release, local_slots)) { return false; }
        if (!ffi.value_valid(ffi.builder_build_br(state.builder$.ref(), continue_block))) { return false; }
        ffi.builder_position_at_end(state.builder$.ref(), continue_block);
        return true;
    }

    Bool lower_initialized_task_result_drop(
        Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.TaskReleaseStatement release,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
        ffi.Value drop_function = llvm_value.function_value_for_ref(state, self.output$.mut_ref(), release.result_drop);
        ffi.Value result_pointer = llvm_place.lower_place_pointer(
            state, self.output$.mut_ref(), body, release.result, local_slots
        );
        if (!ffi.value_valid(drop_function) || !ffi.value_valid(result_pointer)) { return false; }
        list.ArrayList<ffi.Type> parameter_types! = list.ArrayList<ffi.Type>(1);
        parameter_types.add(pointer_type);
        ffi.Type function_type = ffi.function_type(
            ffi.context_void_type(state.llvm_context$.ref()), parameter_types$.ref()
        );
        list.ArrayList<ffi.Value> arguments! = list.ArrayList<ffi.Value>(1);
        arguments.add(result_pointer);
        return ffi.value_valid(ffi.builder_build_call(
            state.builder$.ref(), function_type, drop_function, arguments$.ref()
        ));
    }

    Bool lower_assign(Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        jil.AssignStatement& assign_stmt,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        qid.TypeId result_type = llvm_place.place_type(state, body, assign_stmt.destination);
        if (llvm_value.lower_closure_into_place(
                state,
                self.output$.mut_ref(),
                body,
                assign_stmt.value$.ref(),
                assign_stmt.destination,
                local_slots
            )
        ) {
            return true;
        }
        // 大 struct/payload-enum/optional 的赋值优先直接写入目标 place。这样可以保留
        // layout 计算出的真实字节布局，避免 LLVM aggregate value 在大 payload 上
        // 产生不可靠的按值 load/store。
        if (llvm_value.lower_optional_into_place(
                state,
                self.output$.mut_ref(),
                body,
                assign_stmt.value$.ref(),
                assign_stmt.destination,
                local_slots,
                result_type
            )
        ) {
            return true;
        }
        if (llvm_value.lower_aggregate_into_place(
                state,
                self.output$.mut_ref(),
                body,
                assign_stmt.value$.ref(),
                assign_stmt.destination,
                local_slots
            )
        ) {
            return true;
        }
        if (lower_place_copy_assign(
                state, self.output$.mut_ref(), body, assign_stmt, result_type, local_slots
            )
        ) {
            return true;
        }
        ffi.Value value = llvm_value.lower_rvalue(
            state,
            self.output$.mut_ref(),
            body,
            assign_stmt.value$.ref(),
            local_slots,
            result_type
        );
        if (!llvm_type.type_has_abi_value(state, result_type)) {
            return true;
        }
        if (!ffi.value_valid(value)) {
            self.add_assign_rvalue_error(assign_stmt.value$.ref());
            return false;
        }
        ffi.Value pointer = llvm_place.lower_place_pointer(
            state,
            self.output$.mut_ref(),
            body,
            assign_stmt.destination,
            local_slots
        );
        if (!ffi.value_valid(pointer)) {
            self.add_codegen_error("failed to lower LLVM assignment destination", "llvm_assign_place_lower_failed");
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), value, pointer));
    }

    Void add_assign_rvalue_error(Self&! self, jil.Rvalue& value) {
        if (value is .use_value(use_value)) {
            self.add_use_rvalue_error(use_value.value);
            return;
        }
        if (value is .binary_value(_)) {
            self.add_codegen_error("failed to lower LLVM binary rvalue", "llvm_binary_rvalue_lower_failed");
            return;
        }
        if (value is .cast_value(_)) {
            self.add_codegen_error("failed to lower LLVM cast rvalue", "llvm_cast_rvalue_lower_failed");
            return;
        }
        if (value is .inline_asm_value(_)) {
            self.add_codegen_error("failed to lower LLVM inline asm rvalue", "llvm_inline_asm_rvalue_lower_failed");
            return;
        }
        if (value is .domain_executor_value(_)) {
            self.add_codegen_error(
                "failed to lower LLVM domain executor rvalue",
                "llvm_domain_executor_rvalue_lower_failed"
            );
            return;
        }
        if (value is .runtime_domain_executor_value(_)) {
            self.add_codegen_error(
                "failed to lower LLVM runtime domain executor rvalue",
                "llvm_runtime_domain_executor_rvalue_lower_failed"
            );
            return;
        }
        if (value is .scheduled_continuation_resume_value(_)) {
            self.add_codegen_error(
                "failed to lower LLVM scheduled continuation resume rvalue",
                "llvm_scheduled_continuation_resume_rvalue_lower_failed"
            );
            return;
        }
        if (value is .executor_enter_value(_)) {
            self.add_codegen_error(
                "failed to lower LLVM executor enter rvalue",
                "llvm_executor_enter_rvalue_lower_failed"
            );
            return;
        }
        if (value is .current_executor_value(_)) {
            self.add_codegen_error(
                "unresolved current executor reached LLVM lowering",
                "llvm_current_executor_rvalue_lower_failed"
            );
            return;
        }
        if (value is .current_task_value(_)) {
            self.add_codegen_error(
                "unresolved current task reached LLVM lowering",
                "llvm_current_task_rvalue_lower_failed"
            );
            return;
        }
        if (value is .coroutine_frame_alloc_value(_)) {
            self.add_codegen_error(
                "failed to lower LLVM coroutine frame allocation",
                "llvm_coroutine_frame_alloc_rvalue_lower_failed"
            );
            return;
        }
        if (value is .aggregate_value(_)) {
            self.add_codegen_error("failed to lower LLVM aggregate rvalue", "llvm_aggregate_rvalue_lower_failed");
            return;
        }
        if (value is .closure_value(_)) {
            self.add_codegen_error("failed to lower LLVM closure rvalue", "llvm_closure_rvalue_lower_failed");
            return;
        }
        if (value is .optional_value(_)) {
            self.add_codegen_error("failed to lower LLVM optional rvalue", "llvm_optional_rvalue_lower_failed");
            return;
        }
        if (value is .error_union_value(_)) {
            self.add_codegen_error("failed to lower LLVM error union rvalue", "llvm_error_union_rvalue_lower_failed");
            return;
        }
        self.add_codegen_error("failed to lower LLVM assignment rvalue", "llvm_assign_rvalue_lower_failed");
    }

    Void add_use_rvalue_error(Self&! self, jil.Operand operand) {
        if (operand is .const_operand(const_value)) {
            self.add_const_operand_error(const_value.value);
            return;
        }
        if (operand is .copy_operand(_)) {
            self.add_codegen_error("failed to lower LLVM copy operand", "llvm_copy_operand_lower_failed");
            return;
        }
        if (operand is .move_operand(_)) {
            self.add_codegen_error("failed to lower LLVM move operand", "llvm_move_operand_lower_failed");
            return;
        }
        if (operand is .function_operand(_)) {
            self.add_codegen_error("failed to lower LLVM function operand", "llvm_function_operand_lower_failed");
            return;
        }
        if (operand is .global_address_operand(_)) {
            self.add_codegen_error(
                "failed to lower LLVM global address operand",
                "llvm_global_address_operand_lower_failed"
            );
            return;
        }
        self.add_codegen_error("failed to lower LLVM use rvalue", "llvm_use_rvalue_lower_failed");
    }

    Void add_const_operand_error(Self&! self, jil.ConstValue value) {
        if (jil.string_const_value(value) is .some(_)) {
            self.add_codegen_error("failed to lower LLVM string const", "llvm_string_const_lower_failed");
            return;
        }
        if (jil.int_const_value(value) is .some(_)) {
            self.add_codegen_error("failed to lower LLVM int const", "llvm_int_const_lower_failed");
            return;
        }
        if (jil.is_null_const_value(value)) {
            self.add_codegen_error("failed to lower LLVM null const", "llvm_null_const_lower_failed");
            return;
        }
        self.add_codegen_error("failed to lower LLVM const operand", "llvm_const_operand_lower_failed");
    }

    Bool lower_terminator(Self&! self,
        llvm_state.LowerState& state,
        jil.Body& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        jil.Terminator& terminator,
        list.ArrayList<ffi.BasicBlock>& blocks,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        return llvm_terminator.lower_terminator(
            state,
            self.output$.mut_ref(),
            body,
            function_abi,
            llvm_function,
            terminator,
            blocks,
            local_slots
        );
    }

    ffi.Value runtime_function(self, UInt8[]& name, ffi.Type function_type) {
        ffi.Value existing = ffi.module_get_function(self.module$.ref(), name);
        if (ffi.value_valid(existing)) { return existing; }
        return ffi.module_add_function(self.module$.ref(), name, function_type);
    }

    Void add_codegen_error(Self&! self, UInt8[]& message, UInt8[]& code) {
        add_codegen_error_to(self.output, message, code);
    }

}

extend LlvmLowerer {

    @life(return: (self.a, self.b, self.c))
    llvm_state.LowerState lower_state(Self&! self) {
        return llvm_state.LowerState(
            self.ctx,
            self.store,
            self.llvm_context,
            self.module,
            self.builder,
            ffi.Value(),
            self.allocator,
            generic_bindings.GenericBindings()
        );
    }

    @life(return: (self.a, self.b, self.c))
    llvm_state.LowerState lower_state_for_function(
        Self&! self,
        jil.Function& function
    ) {
        generic_bindings.GenericBindings bindings! =
            backend_abi.bindings_for_jil_function(self.ctx, function);
        return llvm_state.LowerState(
            self.ctx,
            self.store,
            self.llvm_context,
            self.module,
            self.builder,
            ffi.Value(),
            self.allocator,
            bindings
        );
    }

    @life(return: (self.a, self.b, self.c))
    llvm_state.LowerState lower_body_state_for_function(
        Self&! self,
        jil.Function& function,
        ffi.Value llvm_function
    ) {
        generic_bindings.GenericBindings bindings! =
            backend_abi.bindings_for_jil_function(self.ctx, function);
        self.prepare_function_type_substitutions(function, bindings$.mut_ref());
        return llvm_state.LowerState(
            self.ctx,
            self.store,
            self.llvm_context,
            self.module,
            self.builder,
            llvm_function,
            self.allocator,
            bindings
        );
    }

    Void prepare_function_type_substitutions(
        Self&! self,
        jil.Function& function,
        generic_bindings.GenericBindings&! bindings
    ) {
        if (!(function.origin is .source(_)) || function.args.length == 0) { return; }
        list.ArrayList<qid.TypeId> raw_types =
            type_requirements.collect_function_types(self.ctx.store$.ref(), function);
        backend_abi.prepare_type_substitutions(
            self.ctx, raw_types$.ref(), bindings
        );
    }

    Void add_codegen_error(Self&! self, UInt8[]& message, UInt8[]& code) {
        add_codegen_error_to(self.output$.mut_ref(), message, code);
    }

    Void add_function_codegen_error(
        Self&! self,
        jil.Function& function,
        UInt8[]& message,
        UInt8[]& code
    ) {
        add_function_codegen_error_to(
            self.ctx,
            self.store,
            self.output$.mut_ref(),
            function,
            message,
            code
        );
    }

    diagnostic.SourceRange def_source_range(self, qid.DefId def_id) {
        guard self.ctx.store.source_map.def_span(def_id) is .some(loc) else {
            return diagnostic.SourceRange();
        }
        guard loc.source_id is .some(source_id) else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, loc.span);
    }
}

Void add_codegen_error_to(
    llvm_state.LowerOutput&! output,
    UInt8[]& message,
    UInt8[]& code
) {
    output.diagnostics.add(diagnostic.Diagnostic(
        .error,
        .codegen,
        diagnostic.DiagnosticCode(code),
        diagnostic.SourceRange(),
        message
    ));
}

Void add_function_codegen_error_to(
    context.CompilerContext& ctx,
    jil.Store& store,
    llvm_state.LowerOutput&! output,
    jil.Function& function,
    UInt8[]& message,
    UInt8[]& code
) {
    std.String function_name = symbol.function_symbol_name(ctx, store, function);
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(message);
    builder.append(": ");
    builder.append_valid_utf8(function_name.bytes());
    std.String detail = builder.into_string();
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    qid.DefId def_id = jil.function_provenance_def(function.origin);
    if (ctx.store.source_map.def_span(def_id) is .some(loc)) {
        if (loc.source_id is .some(source_id)) {
            range = diagnostic.SourceRange(source_id, loc.span);
        }
    }
    output.diagnostics.add(diagnostic.Diagnostic(
        .error,
        .codegen,
        diagnostic.DiagnosticCode(code),
        range,
        detail.bytes()
    ));
}

Bool lower_place_copy_assign(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AssignStatement& assign_stmt,
    qid.TypeId result_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (!llvm_type.type_has_abi_value(state, result_type)) { return false; }
    guard assign_stmt.value is .use_value(use_value) else { return false; }
    if (use_value.value is .copy_operand(copy_operand)) {
        return copy_place_bytes(
            state, output, body, copy_operand.place, assign_stmt.destination, result_type, local_slots
        );
    }
    if (use_value.value is .move_operand(move_operand)) {
        return copy_place_bytes(
            state, output, body, move_operand.place, assign_stmt.destination, result_type, local_slots
        );
    }
    return false;
}

Bool copy_place_bytes(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Place source,
    jil.Place destination,
    qid.TypeId type_id,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value source_pointer = llvm_place.lower_place_pointer(
        state, output, body, source, local_slots
    );
    if (!ffi.value_valid(source_pointer)) { return false; }
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(
        state, output, body, destination, local_slots
    );
    if (!ffi.value_valid(destination_pointer)) { return false; }
    return copy_pointer_bytes(state, source_pointer, destination_pointer, type_id);
}

Bool copy_pointer_bytes(
    llvm_state.LowerState& state,
    ffi.Value source_pointer,
    ffi.Value destination_pointer,
    qid.TypeId type_id
) {
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type size_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    Int align = llvm_type.layout_align(state, type_id);
    return ffi.value_valid(ffi.builder_build_memcpy(
        state.builder$.ref(), destination_pointer, align, source_pointer, align, size
    ));
}
