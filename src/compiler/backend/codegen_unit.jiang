// Backend codegen unit 的通用分组。
//
// 这里不做 LLVM lowering，也不读写 object 文件。它只把 Store 中的
// function definition 分成后续可以独立 emission/cache 的 unit。

import context = "../context.jiang";
import jil = "../jil.jiang";
import qid = "../id.jiang";
import hash = "../support/hash.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import symbol = "./symbol.jiang";
import reference_closure = "./reference_closure.jiang";
import std;

public import * = "./codegen_unit/model.jiang";

public CodegenUnitSet build_codegen_units(context.CompilerContext& ctx, jil.Store& store) {
    CodegenUnitSet units! = CodegenUnitSet();
    table.MultiTable<UInt64, jil.MonoItem> emitted! =
        table.MultiTable<UInt64, jil.MonoItem>();
    add_source_instances(ctx, store, units$.mut_ref(), emitted$.mut_ref());
    add_generated_functions(ctx, store, units$.mut_ref(), emitted$.mut_ref());
    assign_globals(ctx, store, units$.mut_ref());
    ensure_parsed_source_units(ctx, units$.mut_ref());
    reference_closure.assign(ctx, store, units$.mut_ref());
    return units;
}

Void add_source_instances(
    context.CompilerContext& ctx,
    jil.Store& store,
    CodegenUnitSet&! units,
    table.MultiTable<UInt64, jil.MonoItem>&! emitted
) {
    Int index! = 0;
    while (index < store.program.source_instance_count()) {
        Int identity = store.program.source_instance_identity_at(index);
        jil.MonoItem item = jil.source_instance_mono_item(identity);
        jil.Function function = codegen_function(ctx, store, item);
        add_codegen_function(
            ctx,
            store,
            units,
            emitted,
            item,
            function$.ref()
        );
        qid.DefId source_def = store.program.function_instance_at(identity).def_id;
        add_source_resume(
            ctx, store, units, emitted, identity, source_def, .standard
        );
        add_source_resume(
            ctx, store, units, emitted, identity, source_def, .confined
        );
        add_source_resume(
            ctx, store, units, emitted, identity, source_def, .run_to_completion
        );
        index = index + 1;
    }
}

Void add_source_resume(
    context.CompilerContext& ctx,
    jil.Store& store,
    CodegenUnitSet&! units,
    table.MultiTable<UInt64, jil.MonoItem>&! emitted,
    Int identity,
    qid.DefId source_def,
    jil.CoroutineResumeMode mode
) {
    if (!store.program.has_source_resume_template(source_def, mode)) { return; }
    jil.MonoItem item = jil.source_resume_mono_item(identity, mode);
    jil.Function function = codegen_function(ctx, store, item);
    add_codegen_function(ctx, store, units, emitted, item, function$.ref());
}

Void add_generated_functions(
    context.CompilerContext& ctx,
    jil.Store& store,
    CodegenUnitSet&! units,
    table.MultiTable<UInt64, jil.MonoItem>&! emitted
) {
    Int index! = 0;
    while (index < store.program.functions.len()) {
        jil.Function& function = store.program.functions.ref_at(index);
        // Program.functions 只保存编译器派生 body。coroutine completion 为了稳定
        // 符号保留 source provenance，不能再用 origin kind 判断是否属于该表。
        add_codegen_function(
            ctx,
            store,
            units,
            emitted,
            jil.generated_function_mono_item(function.id),
            function
        );
        index = index + 1;
    }
}

Void add_codegen_function(
    context.CompilerContext& ctx,
    jil.Store& store,
    CodegenUnitSet&! units,
    table.MultiTable<UInt64, jil.MonoItem>&! emitted,
    jil.MonoItem codegen_function,
    jil.Function& function
) {
    if (!function_has_codegen_body(function)) { return; }
    if (has_stable_function_instance(ctx, store, emitted$.ref(), function)) { return; }
    if (!requires_demand_owner(function)
        && !interface_only_source_function(ctx, function)) {
        units.add_function(unit_key_for_function(ctx, function), codegen_function);
    }
    std.String name = symbol.function_symbol_name(ctx, store, function);
    emitted.add(hash.hash_bytes(name.bytes()), codegen_function);
}

// 原始 coroutine function 只描述异步入口，不拥有 backend body；真正生成的是
// resume/completion function。不能为这种声明建立 object definition，否则链接
// 计划会把同一 stable symbol 误判为已由当前 shard 覆盖。
Bool function_has_codegen_body(jil.Function& function) {
    if (function.is_external) { return false; }
    return !function.is_coroutine
        || function.is_coroutine_resume
        || function.is_coroutine_completion;
}

Bool interface_only_source_function(
    context.CompilerContext& ctx,
    jil.Function& function
) {
    qid.DefId provenance_def = jil.function_provenance_def(function.origin);
    guard ctx.store.defs.get(provenance_def).module_id is .some(module_id) else {
        return false;
    }
    return ctx.store.resolve.module_ref(module_id).interface_only;
}

// Global 在 planning 时一次性归属 source unit；后续 fingerprint 和 LLVM lowering
// 直接消费 unit.globals，不再各自扫描完整 global 表。
Void assign_globals(
    context.CompilerContext& ctx,
    jil.Store& store,
    CodegenUnitSet&! units
) {
    Int index! = 0;
    while (index < store.program.globals.len()) {
        jil.Global& global = store.program.globals.ref_at(index);
        index = index + 1;
        if (global.is_external) { continue; }
        qid.ModuleId module_id = symbol.global_module_id(ctx, global)$.some();
        if (ctx.store.resolve.module_ref(module_id).interface_only) { continue; }
        qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
        units.add_global(
            CodegenUnitKey(.source_unit, package_id.to_index(), module_id.to_index()),
            global.id
        );
    }
}

// 每个已解析源码都需要 source work product。即使没有 definition，空 object
// 也用于证明 `.ji` 对应的 debug body coverage，避免下一轮被强制回源。
Void ensure_parsed_source_units(
    context.CompilerContext& ctx,
    CodegenUnitSet&! units
) {
    Int index! = 0;
    while (index < ctx.store.resolve.modules.len()) {
        qid.ModuleId module_id = qid.ModuleId.from_index(index);
        if (!ctx.store.resolve.module_ref(module_id).interface_only) {
            qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
            units.ensure_unit(CodegenUnitKey(
                .source_unit,
                package_id.to_index(),
                module_id.to_index()
            ));
        }
        index = index + 1;
    }
}

// session-local TypeId 可能重复表示同一 concrete instance；按稳定符号只保留一个 definition。
Bool has_stable_function_instance(
    context.CompilerContext& ctx,
    jil.Store& store,
    table.MultiTable<UInt64, jil.MonoItem>& emitted,
    jil.Function& function
) {
    std.String name = symbol.function_symbol_name(ctx, store, function);
    table.MultiTableCursor cursor! = emitted.first(hash.hash_bytes(name.bytes()));
    while (cursor.valid()) {
        jil.Function previous = codegen_function(ctx, store, emitted.get(cursor));
        std.String previous_name = symbol.function_symbol_name(
            ctx, store, previous$.ref()
        );
        if (string.equal(previous_name.bytes(), name.bytes())) {
            return symbol.same_stable_function_instance(
                ctx, store, previous$.ref(), function
            );
        }
        cursor = emitted.next(cursor);
    }
    return false;
}

public CodegenUnitKey unit_key_for_function(
    context.CompilerContext& ctx,
    jil.Function& function
) {
    symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function);
    if (function.args.length > 0) {
        return CodegenUnitKey(
            .monomorph_unit,
            key.package_index,
            key.module_index
        );
    }

    return CodegenUnitKey(
        .source_unit,
        key.package_index,
        key.module_index
    );
}
