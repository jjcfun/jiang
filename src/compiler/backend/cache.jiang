// 后端 artifact cache 目录准备。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import artifact_path = "../artifact/path.jiang";
import driver_options = "../driver/options.jiang";
import string_support = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import std;

// 确保需要 object cache 的 emit 模式有 cache 目录。check/llvm-ir 不产生 object，
// 因此不创建 artifact 目录。
public Bool prepare_artifact_cache(
    context.CompilerContext&! ctx,
    driver_options.EmitKind emit,
    UInt8[]& artifact_cache_dir
) {
    if (emit == .check_only || emit == .llvm_ir) {
        return true;
    }
    UInt8[]^ object_dir = artifact_path.object_dir(artifact_cache_dir);
    if (!system_fs.create_dirs(object_dir[..])) {
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("failed to create artifact cache directory: ");
        builder.append_valid_utf8(object_dir[..]);
        std.String message = builder.into_string();
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            message,
            "cache_dir_failed"
        );
        return false;
    }
    if (emit != .dynamic_library) {
        return true;
    }
    UInt8[]^ lang_dir = artifact_path.lang_dir(artifact_cache_dir);
    if (system_fs.create_dirs(lang_dir[..])) {
        return true;
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("failed to create lang artifact cache directory: ");
    builder.append_valid_utf8(lang_dir[..]);
    std.String message = builder.into_string();
    diagnostic_helper.add_package_error(
        ctx.store.diagnostics$.mut_ref(),
        message,
        "cache_dir_failed"
    );
    return false;
}
