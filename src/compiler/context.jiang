// Shared compiler context for one compilation session.

#doc(module)
    # Overview

    定义一次 compilation 共享的状态，包括语义 store、增量查询、目标平台和输出模式。
#end

alias compiler_store = import "./store.jiang";
alias db = import "./db.jiang";
alias compiler_layout = import "./layout.jiang";
alias system_target = import "./system/target.jiang";
alias driver_options = import "./driver/options.jiang";
alias qid = import "./id.jiang";
alias map = import "./support/map.jiang";
import std;
alias jil = import "./jil.jiang";

#doc 持有一次 compilation 的共享状态，并在多轮编译之间复用增量存储。
public struct CompilerContext: Movable {
    public compiler_store.CompilerStore^ store!;
    public db.QueryEngine query!;
    public jil.Store^ jil!;
    public system_target.TargetInfo target!;
    public system_target.BuildOutputKind output!;
    public Bool release_mode!;

    public Bool build_lang_dylibs! = false;
    public Bool lang_provider_build! = false;
    public std.String lang_cache_dir! = "build/cache";
    public std.String lang_compiler_version! = "";
    public std.String lang_compiler_build! = "";
    public std.String lang_linker_path! = "";
    public driver_options.CompileMode lang_mode! = .debug;
    public map.WyHashMap<qid.SymbolId, UInt64> lang_fingerprints! = map.WyHashMap<qid.SymbolId, UInt64>();

    #doc 保存本轮 Provider 构建参数；缓存根不随被解析源码的 context key 递归嵌套。
    public Void configure_lang_build(Self&! self, driver_options.CompileOptions& options) {
        self.build_lang_dylibs = true;
        self.lang_cache_dir = std.String.from_valid_utf8(options.artifact_cache_dir);
        self.lang_compiler_version = std.String.from_valid_utf8(options.compiler_version);
        self.lang_compiler_build = std.String.from_valid_utf8(options.compiler_build);
        self.lang_linker_path = std.String.from_valid_utf8(options.linker_path);
        self.lang_mode = options.mode;
        self.set_release_mode(options.mode == .release);
    }

    #doc 为依赖分析或嵌套构建继承宿主参数、活动 Provider 链及调用方 overlay。
    public Void inherit_lang_build(Self&! self, Self& parent, UInt8[]& root_path) {
        self.build_lang_dylibs = parent.build_lang_dylibs;
        self.lang_cache_dir = std.String.from_valid_utf8(parent.lang_cache_dir.bytes());
        self.lang_compiler_version = std.String.from_valid_utf8(parent.lang_compiler_version.bytes());
        self.lang_compiler_build = std.String.from_valid_utf8(parent.lang_compiler_build.bytes());
        self.lang_linker_path = std.String.from_valid_utf8(parent.lang_linker_path.bytes());
        self.lang_mode = parent.lang_mode;
        self.set_release_mode(parent.lang_mode == .release);
        Int index! = 0;
        while (index < parent.store.lang_build_roots.len()) {
            self.store.lang_build_roots.add(
                std.String.from_valid_utf8(parent.store.lang_build_roots.ref_at(index).bytes()));
            index = index + 1;
        }
        self.store.push_lang_build(root_path);
        self.store.sources.inherit_overlays(parent.store.sources$.ref());
    }

    #doc 使用 host target 创建 compiler context。
    public init(self) {
        self.store = new compiler_store.CompilerStore();
        self.query = db.QueryEngine();
        self.jil = new jil.Store(true);
        self.target = system_target.host_target();
        self.output = .executable;
        self.release_mode = false;
        self.configure_target_layout();
    }

    #doc 使用指定 target 创建 compiler context。
    public init(self, system_target.TargetInfo target) {
        self.store = new compiler_store.CompilerStore();
        self.query = db.QueryEngine();
        self.jil = new jil.Store(true);
        self.target = target;
        self.output = .executable;
        self.release_mode = false;
        self.configure_target_layout();
    }

    #doc 更新目标平台，并同步对应的数据布局。
    public Void set_target(Self&! self, system_target.TargetInfo target) {
        self.target = target;
        self.configure_target_layout();
    }

    #doc 设置当前 compilation 是否使用 release 模式。
    public Void set_release_mode(Self&! self, Bool release_mode) {
        self.release_mode = release_mode;
    }

    #doc 开始新一轮 compilation，推进 store generation 并清空本轮 query cache。
    public Void begin_compilation(Self&! self) {
        self.store.begin_compilation();
        self.query.reset();
        self.lang_fingerprints.clear();
        self.jil = new jil.Store(true);
    }

    Void configure_target_layout(Self&! self) {
        compiler_layout.TargetLayout target_layout! = compiler_layout.TargetLayout();
        if (self.target.arch == .wasm32) {
            target_layout.pointer_size = 4;
            target_layout.pointer_align = 4;
            target_layout.int_align = 4;
        }
        self.query.layout.set_target(target_layout);
    }

}
