#doc(module)
    生成入口的资源读取与输出能力；资源保留本轮快照，全部输出仅在入口成功返回后发布。
#end

alias traits = import "traits.jiang";
alias reflect = import "reflect.jiang";

#doc 暂存完整字节；每轮最多 4096 个文件及 64 MiB，重复路径、目录冲突和超限使本次生成失败。
public Void write(UInt8[]& path, UInt8[]& data) { generate_write(path, data); }

#doc 显式读取局部产物；用途与输入指纹之外自动纳入生成器实现和编译配置，未命中返回 null。
@life()
public UInt8[]&? cache_read(UInt8[]& purpose, reflect.Fingerprint input) {
    return generate_cache_read(purpose, input);
}

#doc 原子提交完整内容，失败返回 false；同 key 首个提交保留，命中内容仍需显式 write 才成为输出。
public Bool cache_write(UInt8[]& purpose, reflect.Fingerprint input, UInt8[]& data) {
    return generate_cache_write(purpose, input, data);
}

@life()
extern [builtin] UInt8[]&? generate_cache_read(UInt8[]& purpose, reflect.Fingerprint input);
extern [builtin] Bool generate_cache_write(UInt8[]& purpose, reflect.Fingerprint input, UInt8[]& data);

extern [builtin] Void generate_write(UInt8[]& path, UInt8[]& data);

#doc 本轮资源快照句柄；资源内容进入源码存储，句柄不可物化到运行期。
public struct Resource: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }

    @life()
    public UInt8[]& bytes(self) { return generate_resource_bytes(self$.get()); }

    #doc 将当前资源快照显式纳入产物 key；只包含内容，与对 bytes() 求指纹一致。
    public reflect.Fingerprint fingerprint(self) { return reflect.Fingerprint.of(self.bytes()); }
}

#doc 读取相对生成器入口文件的资源；每轮不同快照合计最多 64 MiB，重复读取复用快照，不扩展模块集合。
public Resource read(UInt8[]& path) { return generate_read(path); }

extern [builtin] Resource generate_read(UInt8[]& path);
@life()
extern [builtin] UInt8[]& generate_resource_bytes(Resource resource);
