extern [builtin] Constraint reflect_constraint_at(Decl declaration, Int index);
extern [builtin] Type reflect_constraint_type<C>(C constraint, Int role);
extern [builtin] GenericParameter reflect_constraint_parameter(ConstTypeConstraint constraint);
@life()
extern [builtin] UInt8[]& reflect_constraint_name(AssociatedEquality constraint);
extern [builtin] ConstraintValue reflect_constraint_value<C>(C constraint, Int role);
extern [builtin] TypePatternShape reflect_pattern_shape(TypePattern pattern);
extern [builtin] ConstraintValue reflect_pattern_element<P>(P pattern);
extern [builtin] Decl reflect_pattern_definition(NamedTypePattern pattern);
extern [builtin] Int reflect_pattern_arg_count(NamedTypePattern pattern);
extern [builtin] ConstraintValue reflect_pattern_arg_at(NamedTypePattern pattern, Int index);
extern [builtin] Int reflect_pattern_layer(LayerTypePattern pattern);
@life()
extern [builtin] PatternExtent reflect_pattern_extent<P>(P pattern, Int role);

