extern [builtin] Int reflect_type_number(Type type, Int property);
extern [builtin] Type reflect_type_element(Type type, Int role, Int index);
extern [builtin] Decl reflect_type_definition(Type type);
extern [builtin] GenericParameter reflect_type_parameter(Type type);

