#doc(module)
    定义级编译期内省的公共句柄；由编译器提供身份，生成器不接触内部模型或宿主地址。
#end

alias traits = import "traits.jiang";

#doc 可持久化的 128 位内容指纹；算法由编译器缓存版本约束，不用作密码学认证。
public struct Fingerprint: traits.Copyable, traits.Equatable, traits.Hashable {
    public UInt64 low;
    public UInt64 high;

    #doc 对完整字节求指纹，包含空字节及零字节；不把内存地址或目标指针宽度计入结果。
    public Fingerprint of(UInt8[]& bytes) { return reflect_fingerprint_bytes(bytes); }

    #doc 有序组合两个完整指纹；用于逐项纳入产物依赖，交换顺序或改变分组会改变结果。
    public Fingerprint combine(self, Fingerprint other) { return reflect_fingerprint_combine(self$.get(), other); }

    public Bool equal(Self& lhs, Self& rhs) { return lhs.low == rhs.low && lhs.high == rhs.high; }
    public Void hash<H: traits.Hasher>(self, H&! hasher) { hasher.write(self.low); hasher.write(self.high); }
}

extern [builtin] Fingerprint reflect_fingerprint_bytes(UInt8[]& bytes);
extern [builtin] Fingerprint reflect_fingerprint_combine(Fingerprint lhs, Fingerprint rhs);

#doc 本轮生成的输入模块；只能由编译器创建，查询结果的有效期为本轮执行。
public struct Module: traits.Copyable, traits.Equatable {
    UInt identity;

    init(self, UInt identity) { self.identity = identity; }

    #doc 读取模块的源码名称；返回编译器所有的只读字节。
    @life()
    public UInt8[]& name(self) { return reflect_module_name(self$.get()); }

    #doc 模块自身的规范化 Markdown；没有文档时返回 null。
    @life()
    public UInt8[]&? documentation(self) { return reflect_module_documentation(self$.get()); }

    #doc 包内文件返回相对路径，其他文件保留规范化源路径；virtual 来源保留原名称。
    @life()
    public UInt8[]& path(self) { return reflect_module_path(self$.get()); }
    public Package package(self) { return reflect_module_package(self$.get()); }
    public SourceKind source_kind(self) {
        return if reflect_module_is_virtual(self$.get()) { .virtual } else { .file };
    }
    #doc 整份原始输入的来源范围；Lang 展开不把模块来源替换为 Provider 文件。
    @life()
    public Location location(self) { return reflect_module_location(self$.get()); }

    public Bool equal(Self& lhs, Self& rhs) { return reflect_module_equal(lhs$.get(), rhs$.get()); }

    #doc 直接导入边，保留重复绑定和外包目标；外包节点的内部导入不可查询。
    public Imports imports(self) { return Imports(self$.get()); }

    #doc 模块自身与直接声明的定义内容，不包含导入模块的内容；外包模块只读取公开声明。
    public Fingerprint fingerprint(self) { return reflect_module_fingerprint(self$.get()); }

    public Declarations declarations(self) { return reflect_module_declarations(self$.get()); }
    public Metadata<M> meta<M>(self) { return Metadata<M>(.module(self$.get()), false); }
    public Bool has_meta<M>(self) { return self.meta<M>().len() != 0; }
}

#doc root 所在输入包内的可达模块视图；不包含生成器额外导入的模块，可重复遍历。
public Modules modules(Module root) { return Modules(root); }

public struct Modules: traits.Copyable, traits.Sequence {
    Module root;

    init(self, Module root) { self.root = root; }

    public Int len(self) { return reflect_module_count(self.root); }
    public Module get(self, Int index) { return reflect_module_at(self.root, index); }

    associated Element = Module;
    associated Iter = ModuleIterator;

    public ModuleIterator make_iterator(self) { return ModuleIterator(self$.get()); }
}

#doc 每次遍历独立保存游标；返回模块句柄，不复制定义数据。
public struct ModuleIterator: traits.Copyable, traits.Iterator {
    Modules view;
    Int index! = 0;

    init(self, Modules view) { self.view = view; }

    associated Element = Module;

    public Module? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        Module result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}

@life()
extern [builtin] UInt8[]& reflect_module_name(Module module);
extern [builtin] Bool reflect_module_equal(Module lhs, Module rhs);
extern [builtin] Int reflect_module_count(Module root);
extern [builtin] Module reflect_module_at(Module root, Int index);

#doc 来源类别与名称分开表示；相同名称的文件和 virtual 输入不是同一种来源。
public enum SourceKind: traits.Copyable { file, virtual, }

#doc 本轮包身份，不以包名称判等；不能物化或借此枚举外包内部模块。
public struct Package: traits.Copyable, traits.Equatable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    @life()
    public UInt8[]& name(self) { return reflect_package_name(self$.get()); }
    public Bool equal(Self& lhs, Self& rhs) { return reflect_package_equal(lhs$.get(), rhs$.get()); }
}

@life()
extern [builtin] UInt8[]& reflect_module_path(Module module);
extern [builtin] Package reflect_module_package(Module module);
extern [builtin] Bool reflect_module_is_virtual(Module module);
@life()
extern [builtin] Location reflect_module_location(Module module);
@life()
extern [builtin] UInt8[]& reflect_package_name(Package package);
extern [builtin] Bool reflect_package_equal(Package lhs, Package rhs);

public enum Visibility: traits.Copyable { private_visibility, public_visibility, }

@region(a)
public enum ImportBinding: traits.Copyable {
    @life(a)
    named(UInt8[]& name),
    wildcard,
    unbound,
}

#doc 普通来源数据：字节范围以及从 1 开始的行和 UTF-8 字节列；source 为原始源码名称。
@region(a)
public struct Location: traits.Copyable {
    @life(a)
    public UInt8[]& source;
    public Int offset;
    public Int length;
    public Int line;
    public Int column;

    #doc 只组合来源名称、字节范围及行列，与编译器来源查询使用同一指纹。
    public Fingerprint fingerprint(self) {
        return reflect_location_fingerprint(self.source, UInt64(self.offset), UInt64(self.length),
            UInt64(self.line), UInt64(self.column));
    }
}

#doc 单条生效导入的只读句柄；同一目标可经不同声明产生多条边。
public struct Import: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }

    public Module source(self) { return reflect_import_source(self$.get()); }
    public Module target(self) { return reflect_import_target(self$.get()); }

    public Visibility visibility(self) {
        return if reflect_import_public(self$.get()) { .public_visibility } else { .private_visibility };
    }

    @life()
    public ImportBinding binding(self) {
        if (reflect_import_wildcard(self$.get())) { return .wildcard; }
        UInt8[]& name = reflect_import_name(self$.get());
        if (name.length == 0) { return .unbound; }
        return .named(name);
    }

    @life()
    public Location location(self) { return reflect_import_location(self$.get()); }
}

public struct Imports: traits.Copyable, traits.Sequence {
    Module module;
    init(self, Module module) { self.module = module; }

    public Int len(self) { return reflect_import_count(self.module); }
    public Import get(self, Int index) { return reflect_import_at(self.module, index); }

    associated Element = Import;
    associated Iter = ImportIterator;
    public ImportIterator make_iterator(self) { return ImportIterator(self$.get()); }
}

public struct ImportIterator: traits.Copyable, traits.Iterator {
    Imports view;
    Int index! = 0;
    init(self, Imports view) { self.view = view; }

    associated Element = Import;
    public Import? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        Import result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}

extern [builtin] Int reflect_import_count(Module module);
extern [builtin] Import reflect_import_at(Module module, Int index);
extern [builtin] Module reflect_import_source(Import item);
extern [builtin] Module reflect_import_target(Import item);
extern [builtin] Bool reflect_import_public(Import item);
extern [builtin] Bool reflect_import_wildcard(Import item);
@life()
extern [builtin] UInt8[]& reflect_import_name(Import item);
@life()
extern [builtin] Location reflect_import_location(Import item);

#doc 声明按类别携带只读句柄；共同属性在 Decl 上查询，不暴露编译器内部的分类编号。
public enum Decl: traits.Copyable, traits.Equatable {
    function(Function),
    struct_decl(Struct),
    enum_decl(Enum),
    trait_decl(Trait),
    alias_decl(Alias),
    variable(Variable),
    field(Field),
    variant(Variant),
    associated_type(AssociatedType),
    generic_parameter(GenericParameter),
    extension(Extension);

    @life()
    public UInt8[]& name(self) { return reflect_decl_name(self$.get()); }
    #doc 声明自身的规范化 Markdown；实例沿用原声明，不继承成员或引用类型的文档。
    @life()
    public UInt8[]&? documentation(self) { return reflect_decl_documentation(self$.get()); }
    public Module module(self) { return reflect_decl_module(self$.get()); }
    #doc 定义及其拥有的成员内容；不展开引用类型或函数体，具体实例包含其替换环境。
    public Fingerprint fingerprint(self) { return reflect_decl_fingerprint(self$.get()); }
    public Metadata<M> meta<M>(self) { return Metadata<M>(.declaration(self$.get()), false); }
    public Bool has_meta<M>(self) { return self.meta<M>().len() != 0; }
    public Visibility visibility(self) {
        return if reflect_decl_public(self$.get()) { .public_visibility } else { .private_visibility };
    }
    @life()
    public Location location(self) { return reflect_decl_location(self$.get()); }
    public Declarations members(self) { return reflect_decl_members(self$.get()); }
    #doc 去除具体类型的替换环境，返回原始声明；原始声明调用时保持不变。
    public Decl definition(self) { return reflect_decl_definition(self$.get()); }
    public Declarations generic_parameters(self) { return reflect_decl_generics(self$.get()); }
    public Regions regions(self) { return reflect_decl_regions(self$.get()); }
    public Constraints constraints(self) { return Constraints(self$.get()); }
    public LifetimeBindings lifetime_bindings(self) { return LifetimeBindings(self$.get()); }
    public Bool equal(Self& lhs, Self& rhs) { return reflect_decl_equal(lhs$.get(), rhs$.get()); }
}

#doc 直接拥有的声明视图，保留源码顺序；不沿类型引用或函数 body 遍历。
public struct Declarations: traits.Copyable, traits.Sequence {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Int len(self) { return reflect_declaration_count(self$.get()); }
    public Decl get(self, Int index) { return reflect_declaration_at(self$.get(), index); }
    associated Element = Decl;
    associated Iter = DeclarationIterator;
    public DeclarationIterator make_iterator(self) { return DeclarationIterator(self$.get()); }
}

public struct DeclarationIterator: traits.Copyable, traits.Iterator {
    Declarations view;
    Int index! = 0;
    init(self, Declarations view) { self.view = view; }
    associated Element = Decl;
    public Decl? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        Decl result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}

public struct Function: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    #doc 一次读取函数定义签名；参数仍是只读视图，字段复用共同语义查询，不查询函数体或契约。
    public FunctionSignature signature(self) {
        Receiver receiver = switch reflect_function_receiver(self$.get()) {
            0 => .none, 1 => .borrowed, 2 => .mutable_borrowed, else => .owned,
        };
        return FunctionSignature(parameters: Parameters(self$.get()), result: reflect_function_result(self$.get()),
            receiver: receiver, is_async: reflect_function_async(self$.get()),
            is_unsafe: reflect_function_unsafe(self$.get()), has_body: reflect_function_has_body(self$.get()),
            domain: reflect_function_domain(self$.get()));
    }
    public LifetimeContract lifetime_contract(self) { return reflect_function_contract(self$.get()); }
}

#doc 函数签名的结构化结果；保留类型及参数视图句柄，仅在本轮编译期查询中有效。
public struct FunctionSignature: traits.Copyable {
    public Parameters parameters;
    public Type result;
    public Receiver receiver;
    public Bool is_async;
    public Bool is_unsafe;
    public Bool has_body;
    public Domain? domain;
}

#doc 函数调度域的规范绑定身份；私有外包绑定不公开声明，仍可比较身份并查询其类型。
public struct Domain: traits.Copyable, traits.Equatable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Type type(self) { return reflect_domain_type(self$.get()); }
    public Decl? binding(self) { return reflect_domain_binding(self$.get()); }
    public Bool equal(Self& lhs, Self& rhs) { return reflect_domain_equal(lhs$.get(), rhs$.get()); }
}
extern [builtin] Domain? reflect_function_domain(Function function);
extern [builtin] Domain? reflect_type_domain(Type type);
extern [builtin] Type reflect_domain_type(Domain domain);
extern [builtin] Decl? reflect_domain_binding(Domain domain);
extern [builtin] Bool reflect_domain_equal(Domain lhs, Domain rhs);

public struct Struct: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public LifetimeContract lifetime_contract(self) { return reflect_nominal_contract(.struct_decl(self$.get())); }
}

public struct Enum: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public LifetimeContract lifetime_contract(self) { return reflect_nominal_contract(.enum_decl(self$.get())); }
}

public struct Trait: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
}

public struct Alias: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
}

public struct Variable: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Type type(self) { return reflect_decl_type(.variable(self$.get())); }
    public Bool is_const(self) { return reflect_decl_const(.variable(self$.get())); }
}

public struct Field: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Type type(self) { return reflect_decl_type(.field(self$.get())); }
}

public struct Variant: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    #doc 返回 payload 类型；无 payload 为 Void，具体 enum 实参按成员环境替换。
    public Type payload_type(self) { return reflect_decl_type(.variant(self$.get())); }
}

public struct AssociatedType: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
}

public struct GenericParameter: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Type type(self) { return reflect_decl_type(.generic_parameter(self$.get())); }
    public Bool is_const(self) { return reflect_decl_const(.generic_parameter(self$.get())); }
}

public struct Extension: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    #doc 扩展目标保留原声明的泛型参数及结构，不枚举满足条件的具体类型。
    public TypePattern target(self) { return reflect_extension_target(self$.get()); }
    #doc 返回该扩展声明实现的 trait；纯成员扩展返回空值，关联绑定另从 constraints 查询。
    public Type? trait_type(self) { return reflect_extension_trait_type(self$.get()); }
    public Bool is_unsafe(self) { return reflect_extension_unsafe(self$.get()); }
}

extern [builtin] TypePattern reflect_extension_target(Extension declaration);
extern [builtin] Type? reflect_extension_trait_type(Extension declaration);
extern [builtin] Bool reflect_extension_unsafe(Extension declaration);

extern [builtin] Declarations reflect_module_declarations(Module module);
extern [builtin] Declarations reflect_decl_members(Decl declaration);
extern [builtin] Int reflect_declaration_count(Declarations view);
extern [builtin] Decl reflect_declaration_at(Declarations view, Int index);
@life()
extern [builtin] UInt8[]& reflect_decl_name(Decl declaration);
extern [builtin] Module reflect_decl_module(Decl declaration);
extern [builtin] Bool reflect_decl_public(Decl declaration);
@life()
extern [builtin] Location reflect_decl_location(Decl declaration);
extern [builtin] Bool reflect_decl_equal(Decl lhs, Decl rhs);

#doc 类型句柄保留已检查的语义类型及泛型实参；别名归一，比较包含可变性，不可物化到运行期。
public struct Type: traits.Copyable, traits.Equatable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Bool equal(Self& lhs, Self& rhs) { return reflect_type_equal(lhs$.get(), rhs$.get()); }
    public Bool is_mutable(self) { return reflect_type_mutable(self$.get()); }
    public Bool has_parameters(self) { return reflect_type_has_parameters(self$.get()); }
    #doc 按结构模式匹配；组成部分沿用语义类型句柄，外包私有名义类型保持 opaque。
    public TypeShape shape(self) {
        return switch reflect_type_kind(self$.get()) {
            1 => .never, 2 => .void_type, 3 => .boolean, 4 => .character,
            5 => .integer(IntegerType(bits: reflect_type_number(self$.get(), 0),
                signed: reflect_type_number(self$.get(), 1) != 0)),
            6 => .floating(FloatType(bits: reflect_type_number(self$.get(), 0))),
            7 => .nominal(NominalType(self$.get())),
            8 => .optional(reflect_type_element(self$.get(), 0, 0)),
            9 => .error_union(ErrorUnionType(self$.get())),
            10 => .handle(HandleType(self$.get())),
            11 => .array(ArrayType(self$.get())),
            12 => .slice(SliceType(self$.get())),
            13 => .tuple(Types(self$.get())),
            14 => .function(FunctionType(self$.get())),
            15 => .task(reflect_type_element(self$.get(), 0, 0)),
            16 => .parameter(reflect_type_parameter(self$.get())),
            else => .opaque,
        };
    }
    #doc 直接声明成员按当前类型实参替换；无声明成员的类型返回空视图，不沿引用类型展开。
    public Declarations members(self) { return reflect_type_members(self$.get()); }
}

#doc 已知类型的局部反射允许普通 comptime 使用；结果句柄仅属于本轮编译期执行。
public Type type_of<T>() { return reflect_type_of<T>(); }

#doc 隐式 receiver 独立于显式参数列表，按源码的借用／移动规则描述。
public enum Receiver { none, borrowed, mutable_borrowed, owned, }

#doc 参数视图只引用所属函数；不创建或复制参数声明模型，也不枚举 body locals。
public struct Parameters: traits.Copyable, traits.Sequence {
    Function function;
    init(self, Function function) { self.function = function; }
    public Int len(self) { return reflect_parameter_count(self.function); }
    public Parameter get(self, Int index) { return reflect_parameter_at(self.function, index); }
    associated Element = Parameter;
    associated Iter = ParameterIterator;
    public ParameterIterator make_iterator(self) { return ParameterIterator(self$.get()); }
}

public struct ParameterIterator: traits.Copyable, traits.Iterator {
    Parameters view;
    Int index! = 0;
    init(self, Parameters view) { self.view = view; }
    associated Element = Parameter;
    public Parameter? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        Parameter result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}

public struct Parameter: traits.Copyable, traits.Equatable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    @life()
    public UInt8[]& name(self) { return reflect_parameter_name(self$.get()); }
    public Type type(self) { return reflect_parameter_type(self$.get()); }
    public Bool has_default(self) { return reflect_parameter_default(self$.get()); }
    public Bool equal(Self& lhs, Self& rhs) { return reflect_parameter_equal(lhs$.get(), rhs$.get()); }
}

extern [builtin] Declarations reflect_decl_generics(Decl declaration);
extern [builtin] Type reflect_decl_type(Decl declaration);
extern [builtin] Type reflect_type_of<T>();
extern [builtin] Bool reflect_type_equal(Type lhs, Type rhs);
extern [builtin] Bool reflect_type_mutable(Type type);
extern [builtin] Bool reflect_type_has_parameters(Type type);
extern [builtin] Type reflect_function_result(Function function);
extern [builtin] Int reflect_function_receiver(Function function);
extern [builtin] Bool reflect_function_async(Function function);
extern [builtin] Bool reflect_function_unsafe(Function function);
extern [builtin] Bool reflect_function_has_body(Function function);
extern [builtin] Int reflect_parameter_count(Function function);
extern [builtin] Parameter reflect_parameter_at(Function function, Int index);
@life()
extern [builtin] UInt8[]& reflect_parameter_name(Parameter parameter);
extern [builtin] Type reflect_parameter_type(Parameter parameter);
extern [builtin] Bool reflect_parameter_default(Parameter parameter);
extern [builtin] Bool reflect_parameter_equal(Parameter lhs, Parameter rhs);

extern [builtin] Bool reflect_decl_const(Decl declaration);

extern [builtin] Declarations reflect_type_members(Type type);
extern [builtin] Decl reflect_decl_definition(Decl declaration);

@life()
extern [builtin] UInt8[]&? reflect_module_documentation(Module module);
@life()
extern [builtin] UInt8[]&? reflect_decl_documentation(Decl declaration);

#doc 文档与 metadata 所附着的定义目标；模式匹配后使用各自的查询 API。
public enum Target: traits.Copyable {
    module(Module),
    declaration(Decl);

    public Metadata<M> meta<M>(self) { return Metadata<M>(self$.get(), false); }
    public Bool has_meta<M>(self) { return self.meta<M>().len() != 0; }

    @life()
    public UInt8[]&? documentation(self) {
        switch self$.get() {
            .module(item) => { return item.documentation(); },
            .declaration(item) => { return item.documentation(); },
        }
    }
}

#doc 每次附着保留目标、只读值及原始位置；重复标签不会合并。
@region(a)
public struct MetadataEntry<M>: traits.Copyable {
    public Target target;
    @life(a)
    public M& value;
    @life(a)
    public Location location;
}

#doc 同包可达模块和声明的精确类型筛选；不沿引用类型遍历。
public Metadata<M> with_meta<M>(Module root) { return Metadata<M>(.module(root), true); }

#doc 只保存查询范围；元素索引缓存和附着值由共同语义查询持有。
public struct Metadata<M>: traits.Copyable, traits.Sequence {
    Target target;
    Bool recursive;
    init(self, Target target, Bool recursive) { self.target = target; self.recursive = recursive; }
    public Int len(self) { return reflect_meta_count<M>(self.target, self.recursive); }
    @life()
    public MetadataEntry<M> get(self, Int index) { return reflect_meta_at<M>(self.target, self.recursive, index); }
    associated Element = MetadataEntry<M>;
    associated Iter = MetadataIterator<M>;
    public MetadataIterator<M> make_iterator(self) { return MetadataIterator<M>(self$.get()); }
}

public struct MetadataIterator<M>: traits.Copyable, traits.Iterator {
    Metadata<M> view;
    Int index! = 0;
    init(self, Metadata<M> view) { self.view = view; }
    associated Element = MetadataEntry<M>;
    @life(return: self)
    public MetadataEntry<M>? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        MetadataEntry<M> result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}

