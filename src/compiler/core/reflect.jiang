    init(self, UInt identity) { self.identity = identity; }
    public ConstraintValue subject(self) { return reflect_constraint_value(self$.get(), 0); }
    public ConstraintValue value(self) { return reflect_constraint_value(self$.get(), 1); }
}
public struct AssociatedEquality: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Type subject(self) { return reflect_constraint_type(self$.get(), 0); }
    public Type trait_type(self) { return reflect_constraint_type(self$.get(), 2); }
    @life()
    public UInt8[]& name(self) { return reflect_constraint_name(self$.get()); }
    public ConstraintValue value(self) { return reflect_constraint_value(self$.get(), 1); }
}
public enum ConstraintValue: traits.Copyable {
    type(Type), constant(Constant), pattern(TypePattern), literal(LiteralPattern),
}
#doc 上下文类型尚未确定的 const 字面量模式；保留源值，具体匹配时再按实际参数类型验证。
public struct LiteralPattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    @life()
    public LiteralPatternValue value(self) { return reflect_literal_value(self$.get()); }
}
@region(a)
public enum LiteralPatternValue: traits.Copyable {
    integer(UInt64 bits, Bool signed_value), floating(Float64 value), boolean(Bool value), character(UInt32 value),
    @life(a) string(UInt8[]& value),
    null_value, unit,
}
@life()
extern [builtin] LiteralPatternValue reflect_literal_value(LiteralPattern pattern);
#doc 类型模式保留通配符与结构；exact 表示已经解析的完整类型，不把通配符编码为 invalid Type。
public struct TypePattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public TypePatternShape shape(self) { return reflect_pattern_shape(self$.get()); }
}
public enum TypePatternShape: traits.Copyable {
    wildcard, exact(Type), named(NamedTypePattern), layer(LayerTypePattern), array(ArrayTypePattern),
    error_union(ErrorUnionTypePattern), opaque,
}
public struct ErrorUnionTypePattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public ConstraintValue value(self) { return reflect_pattern_element(self$.get()); }
    public ConstraintValue? error(self) { return reflect_pattern_error(self$.get()); }
}
extern [builtin] ConstraintValue? reflect_pattern_error(ErrorUnionTypePattern pattern);
public struct NamedTypePattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public Decl definition(self) { return reflect_pattern_definition(self$.get()); }
    public PatternArguments arguments(self) { return PatternArguments(self$.get()); }
}
public struct PatternArguments: traits.Copyable, traits.Sequence {
    NamedTypePattern pattern;
    init(self, NamedTypePattern pattern) { self.pattern = pattern; }
    public Int len(self) { return reflect_pattern_arg_count(self.pattern); }
    public ConstraintValue get(self, Int index) { return reflect_pattern_arg_at(self.pattern, index); }
    associated Element = ConstraintValue;
    associated Iter = PatternArgumentIterator;
    public PatternArgumentIterator make_iterator(self) { return PatternArgumentIterator(self$.get()); }
}
public struct PatternArgumentIterator: traits.Copyable, traits.Iterator {
    PatternArguments view;
    Int index! = 0;
    init(self, PatternArguments view) { self.view = view; }
    associated Element = ConstraintValue;
    public ConstraintValue? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        ConstraintValue result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}
public enum PatternLayerKind { optional_type, mutable_type, reference, owner_pointer, raw_pointer, slice, }
public struct LayerTypePattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public ConstraintValue element(self) { return reflect_pattern_element(self$.get()); }
    public PatternLayerKind kind(self) {
        return switch reflect_pattern_layer(self$.get()) {
            0 => .optional_type, 1 => .mutable_type, 2 => .reference,
            3 => .owner_pointer, 4 => .raw_pointer, else => .slice,
        };
    }
    @life()
    public PatternExtent sentinel(self) { return reflect_pattern_extent(self$.get(), 1); }
}
public struct ArrayTypePattern: traits.Copyable {
    UInt identity;
    init(self, UInt identity) { self.identity = identity; }
    public ConstraintValue element(self) { return reflect_pattern_element(self$.get()); }
    @life()
    public PatternExtent length(self) { return reflect_pattern_extent(self$.get(), 0); }
    @life()
    public PatternExtent sentinel(self) { return reflect_pattern_extent(self$.get(), 1); }
}
#doc 模式中的长度与 sentinel 保留字面量种类或声明中的符号名称，不执行额外求值。
@region(a)
public enum PatternExtent: traits.Copyable {
    absent, wildcard, integer(UInt64 value), character(UInt32 value), boolean(Bool value),
    @life(a) named(UInt8[]& name),
}
