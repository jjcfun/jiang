#doc 类型的结构分类；内部闭包环境、任务状态和外包私有类型不公开结构。
public enum TypeShape: traits.Copyable {
    opaque, never, void_type, boolean, character,
    integer(IntegerType), floating(FloatType), nominal(NominalType), parameter(GenericParameter),
    optional(Type), error_union(ErrorUnionType), handle(HandleType), array(ArrayType), slice(SliceType),
    tuple(Types), function(FunctionType), task(Type),
}
public struct IntegerType: traits.Copyable { public Int bits; public Bool signed; }
public struct FloatType: traits.Copyable { public Int bits; }
public struct NominalType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public Decl definition(self) { return reflect_type_definition(self.type); }
    public GenericArguments arguments(self) { return GenericArguments(self.type); }
    public Regions regions(self) { return reflect_type_regions(self.type); }
    public LifetimeContract lifetime_contract(self) { return reflect_nominal_contract(self.definition()); }
}
public struct ErrorUnionType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public Type value(self) { return reflect_type_element(self.type, 0, 0); }
    public Type error(self) { return reflect_type_element(self.type, 0, 1); }
}
public enum HandleKind: traits.Copyable { reference, owner, raw, slice, }
public struct HandleType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public HandleKind kind(self) {
        return switch reflect_type_number(self.type, 2) {
            0 => .reference, 1 => .owner, 2 => .raw, else => .slice,
        };
    }
    public Type element(self) { return reflect_type_element(self.type, 0, 0); }
    public Constant? sentinel(self) { return reflect_type_sentinel(self.type); }
}
public enum ArrayLength: traits.Copyable { known(Int), parameter(GenericParameter), }
public struct ArrayType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public Type element(self) { return reflect_type_element(self.type, 0, 0); }
    public Constant? sentinel(self) { return reflect_type_sentinel(self.type); }
    public ArrayLength length(self) {
        if (reflect_type_number(self.type, 4) != 0) { return .parameter(reflect_type_parameter(self.type)); }
        return .known(reflect_type_number(self.type, 3));
    }
}
public struct SliceType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public Type element(self) { return reflect_type_element(self.type, 0, 0); }
    public Constant? sentinel(self) { return reflect_type_sentinel(self.type); }
}
#doc 元组元素或函数类型参数的只读视图；不复制类型数组，重复遍历各自保存游标。
public struct Types: traits.Copyable, traits.Sequence {
    Type owner;
    init(self, Type owner) { self.owner = owner; }
    public Int len(self) { return reflect_type_number(self.owner, 5); }
    public Type get(self, Int index) { return reflect_type_element(self.owner, 0, index); }
    associated Element = Type;
    associated Iter = TypeIterator;
    public TypeIterator make_iterator(self) { return TypeIterator(self$.get()); }
}
public struct TypeIterator: traits.Copyable, traits.Iterator {
    Types view;
    Int index! = 0;
    init(self, Types view) { self.view = view; }
    associated Element = Type;
    public Type? next(Self&! self) {
        if (self.index >= self.view.len()) { return null; }
        Type result = self.view.get(self.index);
        self.index = self.index + 1;
        return result;
    }
}
public enum FunctionKind: traits.Copyable { raw, closure, }
public enum CallOwnership: traits.Copyable { borrowed, consuming, }
public struct FunctionType: traits.Copyable {
    Type type;
    init(self, Type type) { self.type = type; }
    public Types parameters(self) { return Types(self.type); }
    public Domain? domain(self) { return reflect_type_domain(self.type); }
    public LifetimeContract lifetime_contract(self) { return reflect_type_contract(self.type); }
    public Type result(self) { return reflect_type_element(self.type, 1, 0); }
    public Bool is_async(self) { return reflect_type_number(self.type, 6) != 0; }
    public Bool is_unsafe(self) { return reflect_type_number(self.type, 7) != 0; }
    public FunctionKind kind(self) {
        return if reflect_type_number(self.type, 8) == 0 { .raw } else { .closure };
    }
    public CallOwnership ownership(self) {
        return if reflect_type_number(self.type, 9) == 0 { .borrowed } else { .consuming };
    }
}
