// 长驻编译服务的外层 session。
//
// CompilerSession 持有可复用 CompilerContext，并负责 target 配置与每轮 compilation
// 的入口边界；persistent incremental state 保留在 context.store 中。

#doc(module)
    ### Overview

    `CompilerSession` 是 CLI、测试和未来 LSP 共用的长驻编译入口。

    - source overlay 可以重复更新，不需要重建整个 session；
    - 每次 compile 都建立新的 compilation generation；
    - diagnostics 和只读 semantic queries 从同一个 context 读取。
#end

alias compiler_context = import "./context.jiang";
alias diagnostic = import "./diagnostic.jiang";
alias diagnostic_helper = import "./diagnostic/helper.jiang";
alias diagnostic_source_map = import "./diagnostic/source_map.jiang";
alias driver_options = import "./driver/options.jiang";
alias pipeline = import "./pipeline.jiang";
alias service = import "./service.jiang";
alias source = import "./source.jiang";
alias source_entry = import "./source/entry.jiang";
alias token = import "./syntax/token.jiang";
import std;

#doc
    持有可复用 compiler context 的长驻编译会话。

    同一个 session 可以加载一次 package，再配合 `set_source` 和 `compile_loaded`
    完成多轮增量编译。
#end
public struct CompilerSession: Movable {
    compiler_context.CompilerContext ctx!;

    #doc 创建使用 host target 的空编译会话。
    public init(self) {
        self.ctx = compiler_context.CompilerContext();
    }

    #doc 设置或替换一个内存 source overlay，并返回稳定的 `SourceId`。
    public source.SourceId set_source(Self&! self, UInt8[]& path, UInt8[]& text) {
        return self.ctx.store.sources.set_overlay(path, text);
    }

    #doc 移除指定路径的 source overlay；不存在时返回 `false`。
    public Bool clear_source(Self&! self, UInt8[]& path) {
        return self.ctx.store.sources.clear_overlay(path);
    }

    #doc 从 `CompileOptions.input_path` 加载 package 并执行一次完整 compilation。
    public Void compile(Self&! self, driver_options.CompileOptions& options) {
        if (!self.configure(options)) { return; }
        pipeline.compile(self.ctx$.mut_ref(), options);
    }

    #doc 加载 package 入口身份，供后续多轮 `compile_loaded` 复用。
    public source_entry.PackageHandle load_package(Self&! self, UInt8[]& input_path) {
        self.ctx.store.diagnostics.clear();
        return source_entry.load_package(self.ctx$.mut_ref(), input_path);
    }

    #doc
        编译已经加载的 package。

        该方法仍会读取最新 overlay，并重新建立本轮 module、semantic 和 type-check facts。
    #end
    public Void compile_loaded(
        Self&! self,
        source_entry.PackageHandle& package,
        driver_options.CompileOptions& options
    ) {
        if (!self.configure(options)) { return; }
        pipeline.compile_loaded_package(self.ctx$.mut_ref(), package, options);
    }

    #doc 返回 incremental store 当前的 compilation generation。
    public Int generation(self) {
        return self.ctx.store.incremental.generation;
    }

    #doc 借用当前 session 累积的诊断集合。
    public diagnostic.DiagnosticStore& diagnostics(self) {
        return self.ctx.store.diagnostics$.ref();
    }

    #doc 将当前 source 快照中的字节范围映射为 LSP 默认的 UTF-16 行列范围。
    public diagnostic.SourceRange? lsp_range(self, source.SourceId id, token.Span span) {
        if (!self.ctx.store.sources.has_source(id)) { return null; }
        source.Source& record = self.ctx.store.sources.get(id);
        diagnostic.SourcePosition start = diagnostic_source_map.position_at_snapshot(record, span.start, .utf16);
        diagnostic.SourcePosition end = diagnostic_source_map.position_at_snapshot(record, span.end(), .utf16);
        return diagnostic.SourceRange(id, span, start, end);
    }

    #doc 将当前源码快照的 UTF-16 位置映射为字节偏移。
    public Int? lsp_offset(self, source.SourceId id, Int line, Int character) {
        if (!self.ctx.store.sources.has_source(id)) { return null; }
        return diagnostic_source_map.byte_offset_at_snapshot(self.ctx.store.sources.get(id), line, character);
    }

    #doc 限定符号请求的光标位置，避免从包含空白的父表达式误取定义。
    public Bool lsp_identifier_at(self, source.SourceId id, Int offset) {
        if (!self.ctx.store.sources.has_source(id)) { return false; }
        UInt8[]& text = self.ctx.store.sources.get(id).text$.ref();
        if (offset < 0 || offset >= text.length) { return false; }
        UInt8 byte = text[offset];
        return (byte >= UInt8(65) && byte <= UInt8(90))
            || (byte >= UInt8(97) && byte <= UInt8(122))
            || (byte >= UInt8(48) && byte <= UInt8(57))
            || byte == UInt8(95) || byte >= UInt8(128);
    }

    #doc 返回 file source 的规范路径，供编辑器协议定位跨文件声明。
    public std.String? source_path(self, source.SourceId id) {
        if (!self.ctx.store.sources.has(id)) { return null; }
        guard self.ctx.store.sources.entry(id).key is .file(path) else { return null; }
        std.String value = try std.String.from_utf8(path) catch { return null; };
        return value;
    }

    #doc 创建绑定到当前 semantic state 的只读查询入口。
    public service.CompilerQueries queries(self) {
        return service.CompilerQueries(self.ctx.store$.ref());
    }

    Bool configure(Self&! self, driver_options.CompileOptions& options) {
        driver_options.BuildContextResult result! =
            driver_options.build_context(options, self.ctx$.mut_ref());
        if (result.ok) { return true; }
        self.ctx$.mut_ref().begin_compilation();
        diagnostic_helper.add_package_error(
            self.ctx.store.diagnostics$.mut_ref(),
            result.message.bytes(),
            result.code
        );
        return false;
    }
}
