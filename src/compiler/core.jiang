// 编译器 core 模块源码。
//
// module graph 会先于用户 root 加载这个入口。这里保持为较小的聚合文件；
// 各个 core 领域仍放在相邻文件中。

public alias * = import "core/primitives.jiang";
public alias * = import "core/traits.jiang";
public alias * = import "core/executor.jiang";
public alias * = import "core/contiguous.jiang";
public alias * = import "core/value.jiang";
public alias atomic = import "core/atomic.jiang";
public alias mutex = import "core/mutex.jiang";
public alias coroutine = import "core/coroutine.jiang";
public alias reflect = import "core/reflect.jiang";
public alias generate = import "core/generate.jiang";
