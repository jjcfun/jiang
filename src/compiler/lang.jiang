#doc(module)
    Lang package 的 Provider 准备与调用入口；按实际源码归属加载清单，无清单输入使用空注册表。
#end

alias context = import "./context.jiang";
alias source_ji = import "./artifact/source_ji.jiang";
alias driver_options = import "./driver/options.jiang";

public alias abi = import "./lang/abi.jiang";
public alias dylib_builder = import "./lang/dylib_builder.jiang";
public alias registry = import "./lang/registry.jiang";
public alias registry_builder = import "./lang/registry_builder.jiang";
public alias runtime = import "./lang/runtime.jiang";
public alias wrapper = import "./lang/wrapper.jiang";

public struct PrepareResult: Movable {
    registry_builder.BuildResult result!;

    public init(self, registry_builder.BuildResult result) {
        self.result = result;
    }

    public Bool ok(self) {
        return self.result.ok;
    }

    public registry.Registry&! registry_mut_ref(Self&! self) {
        return self.result.registry$.mut_ref();
    }
}

public PrepareResult prepare_for_root(
    context.CompilerContext&! ctx,
    UInt8[]& root_path,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir
) {
    UInt64 compiler_version_hash = source_ji.artifact_version_hash(options.compiler_version);
    registry_builder.BuildResult result! = registry_builder.build_for_source_path(
        ctx,
        root_path,
        artifact_cache_dir,
        compiler_version_hash,
        options.mode
    );
    if (!result.ok) {
        return PrepareResult(result);
    }
    if (!dylib_builder.ensure_configured(ctx, result.registry$.ref())) {
        result.ok = false;
    }
    return PrepareResult(result);
}
