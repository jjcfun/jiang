#doc(module)
    包产物指纹读取实际加载的模块闭包；导入表达式与 Lang 源文件复用普通解析和按需求值流程。
#end

alias context = import "../context.jiang";
alias analysis = import "../analysis.jiang";
alias qid = import "../id.jiang";
alias resolve_store = import "../resolve/store.jiang";
alias resolver_api = import "../resolve/module_resolver.jiang";
alias module_graph = import "../resolve/module_graph.jiang";
alias package_load = import "../source/package_load.jiang";
alias source_entry = import "../source/entry.jiang";
alias syntax = import "../syntax.jiang";
alias lang_entry = import "../lang/entry.jiang";
alias lang = import "../lang.jiang";
alias source_ji = import "./source_ji.jiang";
alias hash = import "../support/hash.jiang";
alias set = import "../support/set.jiang";
import std;

#doc 原生 Provider 从显式包目录建立实现闭包，配置与 root 共用同一 resolver。
public UInt64 from_registered(context.CompilerContext&! ctx, qid.PackageId package) {
    _ record = ctx.store.resolve.package_ref(package);
    return from_input(ctx, ctx.store.symbols.text(record.dir_path), ctx.store.symbols.text(record.root_path),
        record.kind == .lang);
}

UInt64 from_input(context.CompilerContext&! ctx, UInt8[]& input, UInt8[]& root, Bool provider) {
    _ key = ctx.store.symbols.intern(root);
    if (ctx.build_lang_dylibs && ctx.lang_fingerprints.get(key) is .some(cached)) { return cached$.get(); }
    context.CompilerContext inputs! = context.CompilerContext();
    inputs.inherit_lang_build(ctx, root);
    UInt64 result = prepare_source_closure(inputs$.mut_ref(), input, provider);
    if (inputs.store.diagnostics.has_errors()) {
        lang.wrapper.add_build_diagnostics(ctx, inputs$.mut_ref());
        return UInt64(0);
    }
    ctx.store.sources.import_file_inputs(inputs.store.sources$.ref());
    if (ctx.build_lang_dylibs) { ctx.lang_fingerprints.set(key, result); }
    return result;
}

UInt64 prepare_source_closure(context.CompilerContext&! ctx, UInt8[]& input, Bool provider) {
    UInt64 version = source_ji.artifact_version_hash(ctx.lang_compiler_version.bytes());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(analysis.evaluate_source_expression,
        ctx.lang_cache_dir.bytes(), version, false, ctx.lang_mode);
    source_entry.PackageHandle package = if package_load.exists(input) {
        package_load.load(ctx, resolver$.mut_ref(), input)
    } else { source_entry.load_package(ctx, input) };
    if (!package.ok) { return UInt64(0); }
    UInt8[]& root_path = package.root_path.bytes();
    source_entry.Entry entry! = source_entry.read_root(ctx, package$.ref());
    if (!entry.ok) { return UInt64(0); }
    lang.registry_builder.BuildResult providers! = lang.registry_builder.build_for_source_path(
        ctx, root_path, ctx.lang_cache_dir.bytes(), version, ctx.lang_mode);
    if (!providers.ok || !lang.dylib_builder.ensure_configured(ctx, providers.registry$.ref())) { return UInt64(0); }
    syntax.SyntaxResult parsed! = syntax.parse_source_with_lang(ctx, entry.text[..], entry.source_id,
        providers.registry$.mut_ref());
    if (parsed.has_errors()) { return UInt64(0); }
    if (provider && lang_entry.find(ctx, parsed.unit$.ref()) == null) { return UInt64(0); }
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx, parsed.take_unit());
    if (!resolver.prepare_root_entry_environment(ctx, graph$.mut_ref())) { return UInt64(0); }
    if (!resolver.ensure_root_entry_model(ctx, graph$.mut_ref())) { return UInt64(0); }
    resolver.seal_module_graph(ctx, graph$.mut_ref());
    if (!graph.ok) { return UInt64(0); }
    if (!resolver.lower_module_graph_to_model(ctx, graph$.ref())) { return UInt64(0); }
    if (!analysis.check_model_package(ctx, graph$.ref())) { return UInt64(0); }
    hash.WyHasher hasher! = hash.WyHasher();
    set.HashSet<qid.PackageId> visited! = set.HashSet<qid.PackageId>();
    Int index! = 0;
    while (index < ctx.store.resolve.packages.len()) {
        hash_package(ctx, hasher$.mut_ref(), qid.PackageId(index), visited$.mut_ref());
        index = index + 1;
    }
    // Provider 的动态库身份包含其自己的实现闭包；不再次解析未被普通 import 加载的 Provider。
    index = 0;
    while (index < ctx.store.resolve.packages.len()) {
        resolve_store.PackageRecord& record = ctx.store.resolve.package_ref(qid.PackageId(index));
        if (record.lang_info_ref() is .some(info)) {
            hasher.write(ctx.store.symbols.text(record.dir_path));
            hasher.write(ctx.store.symbols.text(info.dylib_path));
        }
        index = index + 1;
    }
    return hasher.finish();
}

public UInt64 from_package(context.CompilerContext&! ctx, qid.PackageId package_id) {
    hash.WyHasher hasher! = hash.WyHasher();
    set.HashSet<qid.PackageId> visited! = set.HashSet<qid.PackageId>();
    hash_package(ctx, hasher$.mut_ref(), package_id, visited$.mut_ref());
    return hasher.finish();
}

Void hash_package(
    context.CompilerContext&! ctx,
    hash.WyHasher&! hasher,
    qid.PackageId package_id,
    set.HashSet<qid.PackageId>&! visited
) {
    if (visited.has(package_id)) { return; }
    visited.add(package_id);
    resolve_store.PackageRecord& record = ctx.store.resolve.package_ref(package_id);
    hasher.write("package");
    hasher.write(Int(record.kind));
    hasher.write(ctx.store.symbols.text(record.dir_path));
    hasher.write(ctx.store.symbols.text(record.root_path));
    Int index! = 0;
    while (index < record.modules.len()) {
        _ module = ctx.store.resolve.module_ref(record.modules.get(index));
        ctx.store.sources.entry(module.source_id).key.hash(hasher);
        hasher.write(ctx.store.sources.content_hash(module.source_id));
        index = index + 1;
    }
    index = 0;
    while (index < record.dependencies.len()) {
        _ dependency = record.dependencies.get(index);
        hasher.write(ctx.store.symbols.text(dependency.alias_symbol));
        hasher.write(ctx.store.symbols.text(dependency.path_symbol));
        if (ctx.store.resolve.package_for_dir(dependency.path_symbol) is .some(dependency_id)) {
            hash_package(ctx, hasher, dependency_id, visited);
        }
        index = index + 1;
    }
}
