#doc(module)
    计算源码解析上下文；普通源码内容不切换缓存目录，包映射及 Lang Provider 实现闭包参与语法失效。
#end

alias context = import "../context.jiang";
alias package_fingerprint = import "./package_fingerprint.jiang";
alias package_manifest = import "../source/package_manifest.jiang";
alias qkey = import "../incremental/key.jiang";
alias blake3 = import "../support/blake3.jiang";
alias list = import "../support/list.jiang";
alias string = import "../support/string.jiang";
import std;

public qkey.Fingerprint128 fingerprint_for_source_path(UInt8[]& source_path) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    UInt8[]& package_dir = package_manifest.find_enclosing_dir(source_path);
    if (package_dir.length == 0) {
        append_standalone_context(bytes$.mut_ref(), source_path);
        return fingerprint(bytes$.ref());
    }
    list.ArrayList<std.String> visited! = list.ArrayList<std.String>();
    append_package_context(bytes$.mut_ref(), package_dir, visited$.mut_ref());
    return fingerprint(bytes$.ref());
}

#doc 在 manifest 配置指纹上加入 Lang Provider 实现闭包，复用现有 package artifact 指纹。
public qkey.Fingerprint128 fingerprint_for_source_path(context.CompilerContext&! ctx, UInt8[]& source_path) {
    qkey.Fingerprint128 configuration = fingerprint_for_source_path(source_path);
    UInt8[]& package_dir = package_manifest.find_enclosing_dir(source_path);
    if (package_dir.length == 0) { return configuration; }
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    append_uint64(bytes$.mut_ref(), configuration.low);
    append_uint64(bytes$.mut_ref(), configuration.high);
    list.ArrayList<std.String> visited! = list.ArrayList<std.String>();
    append_provider_context(ctx, bytes$.mut_ref(), package_dir, visited$.mut_ref(), true);
    if (bytes.len() == 16) { return configuration; }
    return fingerprint(bytes$.ref());
}

Void append_provider_context(
    context.CompilerContext&! ctx, list.ArrayList<UInt8>&! bytes,
    UInt8[]& package_dir, list.ArrayList<std.String>&! visited, Bool root = false
) {
    Path normalized = std.path.normalize(package_dir);
    if (contains_path(visited, normalized.bytes())) { return; }
    visited.add(std.String.from_valid_utf8(normalized.bytes()));
    package_manifest.PackageManifest manifest = package_manifest.read(normalized.bytes());
    if (!manifest.ok) { return; }
    if (!root && string.equal(manifest.package_type, "lang")) {
        Path provider_root = package_manifest.root_file_path(normalized.bytes(), manifest$.ref());
        if (ctx.store.lang_build_active(provider_root.bytes())) { return; }
        append_text(bytes, normalized.bytes());
        append_uint64(bytes, package_fingerprint.from_manifest(ctx, normalized.bytes(), manifest$.ref()));
        return;
    }
    Int index! = 0;
    while (index < manifest.dependencies.len()) {
        Path dependency = std.path.join(normalized.bytes(), manifest.dependencies.get(index).path);
        append_provider_context(ctx, bytes, dependency.bytes(), visited);
        index = index + 1;
    }
}

Void append_standalone_context(list.ArrayList<UInt8>&! bytes, UInt8[]& source_path) {
    Path normalized = std.path.normalize(source_path);
    append_text(bytes, "standalone");
    append_text(bytes, std.path.dirname(normalized.bytes()));
}

Void append_package_context(
    list.ArrayList<UInt8>&! bytes,
    UInt8[]& package_dir,
    list.ArrayList<std.String>&! visited
) {
    Path normalized = std.path.normalize(package_dir);
    if (contains_path(visited, normalized.bytes())) {
        append_text(bytes, "cycle");
        append_text(bytes, normalized.bytes());
        return;
    }
    visited.add(std.String.from_valid_utf8(normalized.bytes()));
    package_manifest.PackageManifest manifest = package_manifest.read(normalized.bytes());
    append_text(bytes, "package");
    append_text(bytes, normalized.bytes());
    if (!manifest.ok) {
        append_text(bytes, "invalid");
        return;
    }
    append_manifest(bytes, normalized.bytes(), manifest$.ref(), visited);
}

Void append_manifest(
    list.ArrayList<UInt8>&! bytes,
    UInt8[]& package_dir,
    package_manifest.PackageManifest& manifest,
    list.ArrayList<std.String>&! visited
) {
    append_text(bytes, manifest.name);
    append_text(bytes, manifest.root.bytes());
    append_text(bytes, manifest.version);
    append_text(bytes, manifest.package_type);
    append_uint64(bytes, UInt64(manifest.lang_extensions.len()));
    Int mapping_index! = 0;
    while (mapping_index < manifest.lang_extensions.len()) {
        package_manifest.LangExtensions mapping = manifest.lang_extensions.get(mapping_index);
        append_text(bytes, mapping.name);
        _ extensions = package_manifest.split_extensions(mapping.extensions);
        append_uint64(bytes, UInt64(extensions.len()));
        Int extension_index! = 0;
        while (extension_index < extensions.len()) {
            append_text(bytes, extensions.get(extension_index));
            extension_index = extension_index + 1;
        }
        mapping_index = mapping_index + 1;
    }
    append_uint64(bytes, UInt64(manifest.dependencies.len()));
    Int index! = 0;
    while (index < manifest.dependencies.len()) {
        package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
        Path joined = std.path.join(package_dir, dependency.path);
        Path dependency_dir = std.path.normalize(joined.bytes());
        append_text(bytes, dependency.name);
        append_text(bytes, dependency_dir.bytes());
        append_package_context(bytes, dependency_dir.bytes(), visited);
        index = index + 1;
    }
}

Bool contains_path(list.ArrayList<std.String>& visited, UInt8[]& path) {
    Int index! = 0;
    while (index < visited.len()) {
        if (std.path.equal(visited.ref_at(index).bytes(), path)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

qkey.Fingerprint128 fingerprint(list.ArrayList<UInt8>& bytes) {
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes.slice());
    return qkey.Fingerprint128(digest.a, digest.b);
}

Void append_text(list.ArrayList<UInt8>&! bytes, UInt8[]& text) {
    append_uint64(bytes, UInt64(text.length));
    Int index! = 0;
    while (index < text.length) {
        bytes.add(text[index]);
        index = index + 1;
    }
}

Void append_uint64(list.ArrayList<UInt8>&! bytes, UInt64 value) {
    UInt64 remaining! = value;
    Int index! = 0;
    while (index < 8) {
        bytes.add(UInt8(remaining & UInt64(255)));
        remaining = remaining >> 8;
        index = index + 1;
    }
}
