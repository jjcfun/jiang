#doc(module)
    计算源码解析上下文；普通源码内容不切换缓存目录，包映射及 Lang Provider 实现闭包参与语法失效。
#end

alias context = import "../context.jiang";
alias package_fingerprint = import "./package_fingerprint.jiang";
alias package_load = import "../source/package_load.jiang";
alias object_key_builder = import "./object_key_builder.jiang";
alias qid = import "../id.jiang";
alias set = import "../support/set.jiang";
alias qkey = import "../incremental/key.jiang";
alias blake3 = import "../support/blake3.jiang";
alias list = import "../support/list.jiang";
import std;

public qkey.Fingerprint128 fingerprint_for_source_path(UInt8[]& source_path) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    append_standalone_context(bytes$.mut_ref(), source_path);
    return fingerprint(bytes$.ref());
}

#doc 已登记包的配置值和 Lang Provider 实现闭包共同决定解析上下文。
public qkey.Fingerprint128 fingerprint_for_source_path(context.CompilerContext&! ctx, UInt8[]& source_path) {
    if (package_load.registered_for_path(ctx, source_path) is .some(package)) {
        list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
        set.HashSet<qid.PackageId> visited! = set.HashSet<qid.PackageId>();
        append_registered_context(ctx, bytes$.mut_ref(), package, visited$.mut_ref(), true);
        return fingerprint(bytes$.ref());
    }
    return fingerprint_for_source_path(source_path);
}

#doc 原生配置使用普通常量指纹及已登记依赖；语法 Provider 另计实现闭包，不再查找上层 INI。
Void append_registered_context(context.CompilerContext&! ctx, list.ArrayList<UInt8>&! bytes,
    qid.PackageId package, set.HashSet<qid.PackageId>&! visited, Bool root = false) {
    if (visited.has(package)) { return; }
    visited.add(package);
    _ record = ctx.store.resolve.package_ref(package);
    append_text(bytes, "native-package");
    append_text(bytes, ctx.store.symbols.text(record.dir_path));
    append_text(bytes, ctx.store.symbols.text(record.root_path));
    guard record.configuration_info is .some(declaration) else { return; }
    _ info = ctx.store.comptime_store.const_value(declaration)$.some();
    _ value = object_key_builder.stable_comptime_value_fingerprint(ctx.store$.ref(), info);
    append_uint64(bytes, value.low);
    append_uint64(bytes, value.high);
    if (!root && record.kind == .lang && !ctx.store.lang_build_active(ctx.store.symbols.text(record.root_path))) {
        append_uint64(bytes, package_fingerprint.from_registered(ctx, package));
        return;
    }
    Int index! = 0;
    while (index < ctx.store.resolve.package_ref(package).dependencies.len()) {
        _ dependency = ctx.store.resolve.package_ref(package).dependencies.get(index);
        append_text(bytes, ctx.store.symbols.text(dependency.alias_symbol));
        append_text(bytes, ctx.store.symbols.text(dependency.path_symbol));
        _ target = ctx.store.resolve.package_for_dir(dependency.path_symbol)$.some();
        append_registered_context(ctx, bytes, target, visited);
        index = index + 1;
    }
}

Void append_standalone_context(list.ArrayList<UInt8>&! bytes, UInt8[]& source_path) {
    Path normalized = std.path.normalize(source_path);
    append_text(bytes, "standalone");
    append_text(bytes, std.path.dirname(normalized.bytes()));
}

qkey.Fingerprint128 fingerprint(list.ArrayList<UInt8>& bytes) {
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes.slice());
    return qkey.Fingerprint128(digest.a, digest.b);
}

Void append_text(list.ArrayList<UInt8>&! bytes, UInt8[]& text) {
    append_uint64(bytes, UInt64(text.length));
    Int index! = 0;
    while (index < text.length) {
        bytes.add(text[index]);
        index = index + 1;
    }
}

Void append_uint64(list.ArrayList<UInt8>&! bytes, UInt64 value) {
    UInt64 remaining! = value;
    Int index! = 0;
    while (index < 8) {
        bytes.add(UInt8(remaining & UInt64(255)));
        remaining = remaining >> 8;
        index = index + 1;
    }
}
