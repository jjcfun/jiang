#doc(module)
    编译器产物缓存的内容读写及显式清理；内容按完整 key 原子发布，调用方负责输入依赖的组合。
#end

alias system_fs = import "../system/fs.jiang";
alias artifact_path = import "./path.jiang";
alias qkey = import "../incremental/key.jiang";
import std;

#doc 打开完整内容即命中，不校验输出修改；文件句柄由调用者持有，读取大小限制由消费能力决定。
public system_fs.File? open_content(UInt8[]& root, qkey.Fingerprint128 key) {
    _ path = artifact_path.content_path(root, key);
    if (!system_fs.file_exists(path[..])) { return null; }
    return system_fs.open(path[..]);
}

#doc 同 key 首个成功提交保留；锁内复查命中，临时文件关闭后原子发布，失败不留下半写产物。
public Bool store_content(UInt8[]& root, qkey.Fingerprint128 key, UInt8[]& bytes) {
    _ path = artifact_path.content_path(root, key);
    _ lock_path = artifact_path.content_lock_path(root, key);
    if (!system_fs.create_dirs(std.path.dirname(path[..]))
        || !system_fs.create_dirs(std.path.dirname(lock_path[..]))) { return false; }
    guard system_fs.acquire_file_lock(lock_path[..]) is .some(lock) else { return false; }
    if (open_content(root, key) != null) { return true; }
    _ temporary = artifact_path.temporary_artifact_path(path[..], ".tmp.");
    if (!system_fs.write_all(temporary[..], bytes)) {
        system_fs.remove_file(temporary[..]);
        return false;
    }
    if (system_fs.atomic_replace(temporary[..], path[..])) { return true; }
    system_fs.remove_file(temporary[..]);
    return false;
}


public enum CleanResult {
    cleaned,
    unsafe_path,
    failed,
}

public CleanResult clean(UInt8[]& root) {
    if (!clean_path_is_safe(root)) { return .unsafe_path; }
    if (system_fs.remove_tree(root)) { return .cleaned; }
    return .failed;
}

Bool clean_path_is_safe(UInt8[]& path) {
    Int segment_count! = 0;
    Int index! = 0;
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment(path, index);
        if (start == index) { continue; }
        if (segment_is_dot(path[start..index])) { return false; }
        segment_count = segment_count + 1;
    }
    return segment_count > 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && is_separator(path[index])) {
        index = index + 1;
    }
    return index;
}

Int scan_segment(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && !is_separator(path[index])) {
        index = index + 1;
    }
    return index;
}

Bool is_separator(UInt8 value) {
    return value == UInt8(47) || value == UInt8(92);
}

Bool segment_is_dot(UInt8[]& segment) {
    if (segment.length == 1 && segment[0] == UInt8(46)) { return true; }
    return segment.length == 2
        && segment[0] == UInt8(46)
        && segment[1] == UInt8(46);
}
