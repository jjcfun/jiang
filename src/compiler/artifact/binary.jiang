#doc(module)
    Artifact section 共用的小端二进制读写，负责基础值编码和读取边界。
    各 section 自行定义格式标签及语义校验，指纹沿用原有字节序列。
#end
alias list = import "../support/list.jiang";
alias blake3 = import "../support/blake3.jiang";
alias qid = import "../id.jiang";
alias qkey = import "../incremental/key.jiang";
alias interner = import "../resolve/interner.jiang";

@region(a)
public struct Writer: Movable {
    @life(a)
    list.ArrayList<UInt8>&! bytes;
    public init(self, list.ArrayList<UInt8>&! bytes) {
        self.bytes = bytes;
    }

    public Void write_bytes(Self&! self, UInt8[]& data) {
        Int index! = 0;
        while (index < data.length) {
            self.bytes.add(data[index]);
            index = index + 1;
        }
    }

    public Void write_bool(Self&! self, Bool value) {
        if (value) {
            self.bytes.add(1);
            return;
        }
        self.bytes.add(0);
    }

    public Void write_int(Self&! self, Int value) {
        self.write_uint64(UInt64(value));
    }

    public Void write_uint64(Self&! self, UInt64 value) {
        UInt64 current! = value;
        Int index! = 0;
        while (index < 8) {
            self.bytes.add(UInt8(current & 255));
            current = current >> 8;
            index = index + 1;
        }
    }

    public Void write_stable_id(Self&! self, qkey.StableSymbolId stable_id) {
        self.write_uint64(stable_id.low);
        self.write_uint64(stable_id.high);
    }

    public Void write_symbol(Self&! self, interner.SymbolStore& symbols, qid.SymbolId symbol) {
        UInt8[]& text = symbols.text(symbol);
        self.write_int(text.length);
        self.write_bytes(text);
    }

    public Void write_optional_symbol(Self&! self, interner.SymbolStore& symbols, qid.SymbolId? symbol) {
        self.write_bool(symbol != null);
        if (symbol is .some(value)) { self.write_symbol(symbols, value); }
    }

    public qkey.Fingerprint128 finish(self) {
        blake3.Blake3Hash digest = blake3.blake3_hash(self.bytes.slice());
        return qkey.Fingerprint128(digest.a, digest.b);
    }
}

@region(a)
public struct Reader: Copyable {
    @life(a)
    UInt8[]& bytes;
    Int offset!;

    public init(self, UInt8[]& bytes) {
        self.bytes = bytes;
        self.offset = 0;
    }

    public Int remaining(self) { return self.bytes.length - self.offset; }

    public Bool finished(self) {
        return self.offset == self.bytes.length;
    }

    public Bool read_magic(Self&! self, UInt8[]& text) {
        guard self.read_bytes(text.length) is .some(bytes) else { return false; }
        return bytes_equal(bytes, text);
    }

    public Int? read_int(Self&! self) {
        guard self.read_uint64() is .some(value) else { return null; }
        return Int(value);
    }

    public UInt64? read_uint64(Self&! self) {
        guard self.read_bytes(8) is .some(bytes) else { return null; }
        UInt64 value! = 0;
        Int index! = 7;
        while (index >= 0) {
            value = value << 8;
            value = value | UInt64(bytes[index]);
            index = index - 1;
        }
        return value;
    }

    public qkey.StableSymbolId? read_stable_id(Self&! self) {
        guard self.read_uint64() is .some(low) else { return null; }
        guard self.read_uint64() is .some(high) else { return null; }
        return qkey.StableSymbolId(low, high);
    }

    public qkey.Fingerprint128? read_fingerprint(Self&! self) {
        guard self.read_uint64() is .some(low) else { return null; }
        guard self.read_uint64() is .some(high) else { return null; }
        return qkey.Fingerprint128(low, high);
    }

    public UInt8[]&? read_bytes(Self&! self, Int length) {
        if (length < 0) {
            return null;
        }
        if (length > self.bytes.length - self.offset) {
            return null;
        }
        Int start = self.offset;
        self.offset = self.offset + length;
        return self.bytes[start..self.offset];
    }

    public UInt8[]&? read_bytes_with_length(Self&! self) {
        guard self.read_int() is .some(length) else { return null; }
        return self.read_bytes(length);
    }

    public qid.SymbolId? read_symbol(Self&! self, interner.SymbolStore&! symbols) {
        guard self.read_int() is .some(length) else { return null; }
        guard self.read_bytes(length) is .some(text) else { return null; }
        return symbols.intern(text);
    }

    public qid.SymbolId? read_optional_symbol(Self&! self, interner.SymbolStore&! symbols) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_symbol(symbols);
    }

    public qkey.StableSymbolId? read_optional_stable_id(Self&! self) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_stable_id();
    }

    public qkey.Fingerprint128? read_optional_fingerprint(Self&! self) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_fingerprint();
    }

    public Bool? read_bool(Self&! self) {
        guard self.read_bytes(1) is .some(bytes) else { return null; }
        return bytes[0] != 0;
    }
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

