#doc(module)
    源码缓存中的规范化 Markdown 以稳定声明身份保存，包含同包私有文档，不包含函数 body 内声明。
    文档 section 独立校验，不参与语义接口和目标代码指纹；可见性由反射查询边界执行。
#end

alias context = import "../context.jiang";
alias interner = import "../resolve/interner.jiang";
alias ji = import "./ji_file.jiang";
alias list = import "../support/list.jiang";
alias object_hash = import "./object_hash.jiang";
alias qid = import "../id.jiang";
alias qkey = import "../incremental/key.jiang";
alias source_artifact = import "./source.jiang";

public struct DeclarationDoc: Copyable {
    public qkey.StableSymbolId stable_id;
    public qid.SymbolId markdown;

    public init(self, qkey.StableSymbolId stable_id, qid.SymbolId markdown) {
        self.stable_id = stable_id;
        self.markdown = markdown;
    }
}

// extension 没有单独的 Def owner；ordinal 对应该 module interface 中的
// extension group 顺序，避免为文档引入第二套 declaration identity。
public struct ExtensionDoc: Copyable {
    public Int ordinal;
    public qid.SymbolId markdown;

    public init(self, Int ordinal, qid.SymbolId markdown) {
        self.ordinal = ordinal;
        self.markdown = markdown;
    }
}

public struct Documentation: Movable {
    public qid.SymbolId? module_markdown!;
    public list.ArrayList<DeclarationDoc> declarations!;
    public list.ArrayList<ExtensionDoc> extensions!;

    public init(self) {
        self.module_markdown = null;
        self.declarations = list.ArrayList<DeclarationDoc>();
        self.extensions = list.ArrayList<ExtensionDoc>();
    }

    public qid.SymbolId? declaration(self, qkey.StableSymbolId identity) {
        Int first! = 0;
        Int end! = self.declarations.len();
        while (first < end) {
            Int middle = first + (end - first) / 2;
            DeclarationDoc candidate = self.declarations.get(middle);
            if (candidate.stable_id == identity) { return candidate.markdown; }
            if (stable_id_less(candidate.stable_id, identity)) { first = middle + 1; }
            else { end = middle; }
        }
        return null;
    }

    public Bool empty(self) {
        return self.module_markdown == null
            && self.declarations.empty()
            && self.extensions.empty();
    }

    public Void add_declaration(Self&! self, DeclarationDoc declaration) {
        Int index! = 0;
        while (index < self.declarations.len()) {
            DeclarationDoc current = self.declarations.get(index);
            if (stable_id_less(declaration.stable_id, current.stable_id)) { break; }
            index = index + 1;
        }
        self.declarations.add(declaration);
        Int cursor! = self.declarations.len() - 1;
        while (cursor > index) {
            DeclarationDoc previous = self.declarations.get(cursor - 1);
            self.declarations.set(cursor, previous);
            cursor = cursor - 1;
        }
        self.declarations.set(index, declaration);
    }

    public Void add_extension(Self&! self, ExtensionDoc extension) {
        self.extensions.add(extension);
    }
}

public Documentation collect(context.CompilerContext& ctx, qid.ModuleId module_id) {
    Documentation result! = Documentation();
    result.module_markdown = ctx.store.model.module_doc(module_id);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    collect_owned_docs(ctx, module_id, module_def, result$.mut_ref());
    collect_extension_docs(ctx, module_id, result$.mut_ref());
    return result;
}

Void collect_owned_docs(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    qid.DefId owner_def,
    Documentation&! result
) {
    if (!ctx.store.model.has_def(owner_def)) { return; }
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(owner_def)) {
        qid.DefId member_def = ctx.store.model.def_member_at(owner_def, index);
        if (ctx.store.model.extension_group_for_member(member_def) == null) {
            collect_doc_tree(ctx, module_id, member_def, result);
        }
        index = index + 1;
    }
}

Void collect_doc_tree(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    qid.DefId def_id,
    Documentation&! result
) {
    if (ctx.store.defs.get(def_id).module_id != module_id) { return; }
    if (ctx.store.model.declaration_doc(def_id) is .some(markdown)
        && ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)
    ) {
        result.add_declaration(DeclarationDoc(stable_id, markdown));
    }
    if (!ctx.store.model.has_function_signature(def_id)) {
        collect_owned_docs(ctx, module_id, def_id, result);
    }
}

Void collect_extension_docs(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    Documentation&! result
) {
    Int index! = 0;
    Int ordinal! = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (ctx.store.model.extension_group_module(index) == module_id) {
            if (ctx.store.model.extension_doc(index) is .some(markdown)) {
                result.add_extension(ExtensionDoc(ordinal, markdown));
            }
            collect_extension_member_docs(ctx, module_id, index, result);
            ordinal = ordinal + 1;
        }
        index = index + 1;
    }
}

Void collect_extension_member_docs(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    Int group_index,
    Documentation&! result
) {
    Int index! = 0;
    while (index < ctx.store.model.extension_member_count(group_index)) {
        collect_doc_tree(
            ctx,
            module_id,
            ctx.store.model.extension_member_at(group_index, index),
            result
        );
        index = index + 1;
    }
}

public ji.JiSectionPayload? payload(context.CompilerContext& ctx, qid.ModuleId module_id) {
    Documentation docs = collect(ctx, module_id);
    if (docs.empty()) { return null; }
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    qkey.Fingerprint128 fingerprint! = qkey.Fingerprint128();
    {
        Writer writer! = Writer(bytes$.mut_ref());
        writer.write_bytes("jiang.documentation.v2");
        writer.write_optional_symbol(ctx.store.symbols$.ref(), docs.module_markdown);
        writer.write_int(docs.declarations.len());
        Int index! = 0;
        while (index < docs.declarations.len()) {
            DeclarationDoc declaration = docs.declarations.get(index);
            writer.write_stable_id(declaration.stable_id);
            writer.write_symbol(ctx.store.symbols$.ref(), declaration.markdown);
            index = index + 1;
        }
        writer.write_int(docs.extensions.len());
        index = 0;
        while (index < docs.extensions.len()) {
            ExtensionDoc extension = docs.extensions.get(index);
            writer.write_int(extension.ordinal);
            writer.write_symbol(ctx.store.symbols$.ref(), extension.markdown);
            index = index + 1;
        }
        fingerprint = object_hash.hash_bytes(bytes.slice());
    }
    return ji.JiSectionPayload(.documentation, bytes, fingerprint);
}

public Documentation? decode(interner.SymbolStore&! symbols, UInt8[]& bytes) {
    Reader reader! = Reader(bytes);
    if (!reader.read_magic("jiang.documentation.v2")) { return null; }
    guard reader.read_bool() is .some(has_module_markdown) else { return null; }
    Documentation result! = Documentation();
    if (has_module_markdown) {
        guard reader.read_symbol(symbols) is .some(module_markdown) else { return null; }
        result.module_markdown = module_markdown;
    }
    guard reader.read_int() is .some(count) else { return null; }
    if (count < 0) { return null; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_stable_id() is .some(stable_id) else { return null; }
        guard reader.read_symbol(symbols) is .some(markdown) else { return null; }
        if (!result.declarations.empty()) {
            DeclarationDoc previous = result.declarations.get(result.declarations.len() - 1);
            if (!stable_id_less(previous.stable_id, stable_id)) { return null; }
        }
        result.declarations.add(DeclarationDoc(stable_id, markdown));
        index = index + 1;
    }
    guard reader.read_int() is .some(extension_count) else { return null; }
    if (extension_count < 0) { return null; }
    index = 0;
    while (index < extension_count) {
        guard reader.read_int() is .some(ordinal) else { return null; }
        if (ordinal < 0) { return null; }
        guard reader.read_symbol(symbols) is .some(markdown) else { return null; }
        if (!result.extensions.empty()) {
            ExtensionDoc previous = result.extensions.get(result.extensions.len() - 1);
            if (previous.ordinal >= ordinal) { return null; }
        }
        result.extensions.add(ExtensionDoc(ordinal, markdown));
        index = index + 1;
    }
    if (!reader.finished()) { return null; }
    return result;
}

public Documentation? read_from_ji(
    interner.SymbolStore&! symbols,
    source_artifact.SourceArtifactCache&! cache,
    UInt8[]& path
) {
    guard ji.read_ji_layout(path) is .some(layout) else { return null; }
    UInt64 read_started = cache.section_timing_start();
    UInt8[]&? section = ji.read_ji_section(path, layout$.ref(), .documentation);
    Int length! = 0;
    if (layout.sections.find(.documentation) is .some(entry)) {
        length = entry.length;
    }
    cache.record_section_read(.documentation, length, read_started);
    guard section is .some(bytes) else { return null; }
    UInt64 decode_started = cache.section_timing_start();
    Documentation? result = decode(symbols, bytes);
    cache.record_section_decode(.documentation, decode_started);
    return result;
}

Bool stable_id_less(qkey.StableSymbolId lhs, qkey.StableSymbolId rhs) {
    if (lhs.low != rhs.low) { return lhs.low < rhs.low; }
    return lhs.high < rhs.high;
}

@region(a)
struct Writer: Movable {
    @life(a)
    list.ArrayList<UInt8>&! bytes;

    init(self, list.ArrayList<UInt8>&! bytes) {
        self.bytes = bytes;
    }

    Void write_bytes(Self&! self, UInt8[]& value) {
        Int index! = 0;
        while (index < value.length) {
            self.bytes.add(value[index]);
            index = index + 1;
        }
    }

    Void write_int(Self&! self, Int value) {
        self.write_uint64(UInt64(value));
    }

    Void write_uint64(Self&! self, UInt64 value) {
        UInt64 current! = value;
        Int index! = 0;
        while (index < 8) {
            self.bytes.add(UInt8(current & UInt64(255)));
            current = current >> 8;
            index = index + 1;
        }
    }

    Void write_stable_id(Self&! self, qkey.StableSymbolId stable_id) {
        self.write_uint64(stable_id.low);
        self.write_uint64(stable_id.high);
    }

    Void write_symbol(Self&! self, interner.SymbolStore& symbols, qid.SymbolId symbol) {
        UInt8[]& text = symbols.text(symbol);
        self.write_int(text.length);
        self.write_bytes(text);
    }

    Void write_optional_symbol(
        Self&! self,
        interner.SymbolStore& symbols,
        qid.SymbolId? symbol
    ) {
        if (symbol is .some(value)) {
            self.bytes.add(UInt8(1));
            self.write_symbol(symbols, value);
            return;
        }
        self.bytes.add(UInt8(0));
    }

}

@region(a)
struct Reader: Copyable {
    @life(a)
    UInt8[]& bytes;
    Int offset!;

    init(self, UInt8[]& bytes) {
        self.bytes = bytes;
        self.offset = 0;
    }

    Bool finished(self) {
        return self.offset == self.bytes.length;
    }

    Bool read_magic(Self&! self, UInt8[]& value) {
        guard self.read_bytes(value.length) is .some(actual) else { return false; }
        if (actual.length != value.length) { return false; }
        Int index! = 0;
        while (index < value.length) {
            if (actual[index] != value[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Int? read_int(Self&! self) {
        guard self.read_uint64() is .some(value) else { return null; }
        return Int(value);
    }

    UInt64? read_uint64(Self&! self) {
        guard self.read_bytes(8) is .some(value) else { return null; }
        UInt64 result! = 0;
        Int index! = 7;
        while (index >= 0) {
            result = (result << 8) | UInt64(value[index]);
            index = index - 1;
        }
        return result;
    }

    qkey.StableSymbolId? read_stable_id(Self&! self) {
        guard self.read_uint64() is .some(low) else { return null; }
        guard self.read_uint64() is .some(high) else { return null; }
        return qkey.StableSymbolId(low, high);
    }

    qid.SymbolId? read_symbol(Self&! self, interner.SymbolStore&! symbols) {
        guard self.read_int() is .some(length) else { return null; }
        guard self.read_bytes(length) is .some(text) else { return null; }
        return symbols.intern(text);
    }

    Bool? read_bool(Self&! self) {
        guard self.read_bytes(1) is .some(flag) else { return null; }
        if (flag[0] == UInt8(0)) { return false; }
        if (flag[0] == UInt8(1)) { return true; }
        return null;
    }

    UInt8[]&? read_bytes(Self&! self, Int length) {
        if (length < 0 || self.offset > self.bytes.length) { return null; }
        if (length > self.bytes.length - self.offset) { return null; }
        Int start = self.offset;
        self.offset = self.offset + length;
        return self.bytes[start..self.offset];
    }
}
