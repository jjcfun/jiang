#doc(module)
    编译期值与持久接口值之间的共同转换，不依赖声明加载流程或执行器。
    声明引用使用 stable id，聚合恢复进入既有 ComptimeStore；缺失引用或无效子值使整个值恢复失败。
    此处只转换 payload，类型由调用方的声明签名或持久类型记录恢复，不计算另一套指纹。
#end
alias store_api = import "../store.jiang";
alias source_artifact = import "./source.jiang";
alias comptime_value = import "../sema/comptime/value.jiang";
alias qid = import "../id.jiang";
alias list = import "../support/list.jiang";

@life()
public source_artifact.InterfaceConstValue to_interface(
    store_api.CompilerStore& store,
    comptime_value.ComptimeValue value
) {
    if (value.data is .null_pointer) { return source_artifact.InterfaceConstValue(data = .null_pointer); }
    if (value.data is .unit_value) {
        return source_artifact.InterfaceConstValue(data = .unit_value());
    }
    if (value.data is .bool_value(bool_value)) {
        return source_artifact.InterfaceConstValue(data = .bool_value(bool_value));
    }
    if (value.data is .int_value(int_value)) {
        return source_artifact.InterfaceConstValue(data = .int_value(int_value));
    }
    if (value.data is .uint_value(uint_value)) {
        return source_artifact.InterfaceConstValue(data = .uint_value(uint_value));
    }
    if (value.data is .char_value(char_value)) {
        return source_artifact.InterfaceConstValue(data = .char_value(char_value));
    }
    if (value.data is .float_bits(float_bits)) {
        return source_artifact.InterfaceConstValue(data = .float_bits(float_bits));
    }
    if (value.data is .string_value(string_value)) {
        return source_artifact.InterfaceConstValue(data = .string_value(string_value));
    }
    if (value.data is .symbol_value(symbol_value)) {
        return source_artifact.InterfaceConstValue(data = .symbol_value(symbol_value));
    }
    if (value.data is .enum_case_value(case_def)) {
        guard store.incremental.stable_id_for_def(case_def) is .some(stable_id) else {
            return source_artifact.InterfaceConstValue(data = .invalid());
        }
        return source_artifact.InterfaceConstValue(data = .enum_case_value(stable_id));
    }
    if (value.data is .struct_value(aggregate)) {
        guard interface_const_fields(store, aggregate) is .some(fields) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .struct_value(fields));
    }
    if (value.data is .tuple_value(aggregate)) {
        guard interface_const_values(store, aggregate) is .some(items) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .tuple_value(items));
    }
    if (value.data is .array_value(aggregate)) {
        guard interface_const_values(store, aggregate) is .some(items) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .array_value(items));
    }
    if (value.data is .optional_value(aggregate)) {
        guard interface_const_values(store, aggregate) is .some(items) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .optional_value(items));
    }
    if (value.data is .enum_value(case_def, aggregate)) {
        guard store.incremental.stable_id_for_def(case_def) is .some(stable_id) else {
            return source_artifact.InterfaceConstValue(data = .invalid());
        }
        guard interface_const_values(store, aggregate) is .some(items) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .enum_value(stable_id, items));
    }
    if (value.data is .error_union_value(is_error, aggregate)) {
        guard interface_const_values(store, aggregate) is .some(items) else {
            return source_artifact.InterfaceConstValue(data = .invalid);
        }
        return source_artifact.InterfaceConstValue(data = .error_union_value(is_error, items));
    }
    return source_artifact.InterfaceConstValue(data = .invalid());
}

@life()
source_artifact.InterfaceConstFieldValue[]&? interface_const_fields(
    store_api.CompilerStore& store,
    comptime_value.ComptimeAggregateId aggregate
) {
    unsafe {
        Int count = store.comptime_store.field_count(aggregate);
        source_artifact.InterfaceConstFieldValue*! values = unsafe {
            source_artifact.InterfaceConstFieldValue$.alloc(count)
        };
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeAggregateField field =
                store.comptime_store.field_at(aggregate, index);
            guard store.incremental.stable_id_for_def(field.field_def) is .some(stable_id) else { return null; }
            source_artifact.InterfaceConstValue item = to_interface(store, field.value);
            if (item.data is .invalid) { return null; }
            values[index] = source_artifact.InterfaceConstFieldValue(field_stable_id = stable_id, value = item);
            index = index + 1;
        }
        return values[0..count];
    }
}

@life()
source_artifact.InterfaceConstValue[]&? interface_const_values(
    store_api.CompilerStore& store,
    comptime_value.ComptimeAggregateId aggregate
) {
    unsafe {
        Int count = store.comptime_store.item_count(aggregate);
        source_artifact.InterfaceConstValue*! values = unsafe {
            source_artifact.InterfaceConstValue$.alloc(count)
        };
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeValue item = store.comptime_store.item_at(aggregate, index);
            source_artifact.InterfaceConstValue encoded = to_interface(store, item);
            if (encoded.data is .invalid) { return null; }
            values[index] = encoded;
            index = index + 1;
        }
        return values[0..count];
    }
}

#doc 恢复完整 payload；未知声明及无效子值不发布为成功的常量。
public comptime_value.ComptimeValue? from_interface(
    store_api.CompilerStore&! store,
    source_artifact.InterfaceConstValue value
) {
    qid.TypeId type_id = store.types.invalid_type();
    if (value.data is .null_pointer) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .null_pointer);
    }
    if (value.data is .unit_value) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .unit_value());
    }
    if (value.data is .bool_value(bool_value)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .bool_value(bool_value));
    }
    if (value.data is .int_value(int_value)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .int_value(int_value));
    }
    if (value.data is .uint_value(uint_value)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .uint_value(uint_value));
    }
    if (value.data is .char_value(char_value)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .char_value(char_value));
    }
    if (value.data is .float_bits(float_bits)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .float_bits(float_bits));
    }
    if (value.data is .string_value(string_value)) {
        return comptime_value.ComptimeValue(
            type_id = type_id,
            data = .string_value(string_value)
        );
    }
    if (value.data is .symbol_value(symbol_value)) {
        return comptime_value.ComptimeValue(type_id = type_id, data = .symbol_value(symbol_value));
    }
    if (value.data is .enum_case_value(stable_id)) {
        guard store.incremental.current_def_for_stable(stable_id) is .some(case_def) else {
            return null;
        }
        return comptime_value.ComptimeValue(type_id = type_id, data = .enum_case_value(case_def));
    }
    if (value.data is .struct_value(fields)) {
        list.ArrayList<comptime_value.ComptimeAggregateField> values! =
            list.ArrayList<comptime_value.ComptimeAggregateField>(fields.length);
        Int index! = 0;
        while (index < fields.length) {
            guard store.incremental.current_def_for_stable(fields[index].field_stable_id)
                is .some(field_def) else { return null; }
            guard from_interface(store, fields[index].value) is .some(field_value) else { return null; }
            values.add(comptime_value.ComptimeAggregateField(field_def = field_def, value = field_value));
            index = index + 1;
        }
        return store.comptime_store.struct_value(type_id, values.slice());
    }
    if (value.data is .tuple_value(items)) {
        guard comptime_values_from_interface(store, items) is .some(values) else { return null; }
        return store.comptime_store.tuple_value(type_id, values.slice());
    }
    if (value.data is .array_value(items)) {
        guard comptime_values_from_interface(store, items) is .some(values) else { return null; }
        return store.comptime_store.array_value(type_id, values.slice());
    }
    if (value.data is .optional_value(items)) {
        if (items.length > 1) { return null; }
        guard comptime_values_from_interface(store, items) is .some(values) else { return null; }
        return store.comptime_store.optional_value(type_id, values.slice());
    }
    if (value.data is .enum_value(case_stable_id, items)) {
        guard store.incremental.current_def_for_stable(case_stable_id) is .some(case_def)
            else { return null; }
        if (items.length != 1) { return null; }
        guard from_interface(store, items[0]) is .some(payload) else { return null; }
        return store.comptime_store.enum_value(type_id, case_def, payload);
    }
    if (value.data is .error_union_value(is_error, items)) {
        if (items.length != 1) { return null; }
        guard from_interface(store, items[0]) is .some(payload) else { return null; }
        return store.comptime_store.error_union_value(type_id, is_error, payload);
    }
    return null;
}

list.ArrayList<comptime_value.ComptimeValue>? comptime_values_from_interface(
    store_api.CompilerStore&! store,
    source_artifact.InterfaceConstValue[]& items
) {
    list.ArrayList<comptime_value.ComptimeValue> values! =
        list.ArrayList<comptime_value.ComptimeValue>(items.length);
    Int index! = 0;
    while (index < items.length) {
        guard from_interface(store, items[index]) is .some(item) else { return null; }
        values.add(item);
        index = index + 1;
    }
    return values;
}
