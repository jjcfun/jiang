#doc(module) 处理 LSP 在 stdio 上的 Content-Length 帧边界；消息正文始终按字节计数。

alias io = import "../system/io.jiang";
alias list = import "../support/list.jiang";
import std;

const Int max_header_bytes = 8192;
const Int max_message_bytes = 16777216;

#doc 读取一条完整 LSP 消息；EOF 或无效帧返回 null。
public UInt8[]^? read_message() {
    list.ArrayList<UInt8> header! = list.ArrayList<UInt8>();
    UInt8[1] byte! = [UInt8(0)];
    while (header.len() < max_header_bytes) {
        guard io.read_stdin(byte[..]) is .some(count) else { return null; }
        if (count == 0) { return null; }
        header.add(byte[0]);
        Int length = header.len();
        if (length >= 4 && header.get(length - 4) == UInt8(13) && header.get(length - 3) == UInt8(10)
            && header.get(length - 2) == UInt8(13) && header.get(length - 1) == UInt8(10)) {
            guard content_length(header.slice()) is .some(body_length) else { return null; }
            return read_body(body_length);
        }
    }
    return null;
}

#doc 将 UTF-8 JSON 正文作为一条 LSP 消息写到 stdout。
public Bool write_message(UInt8[]& body) {
    std.StringBuilder header! = std.StringBuilder();
    header.append("Content-Length: ");
    header.append(body.length);
    header.append("\r\n\r\n");
    _ output = io.stdout();
    return output.write_all(header.slice()) && output.write_all(body);
}

Int? content_length(UInt8[]& header) {
    Int line_start! = 0;
    Int? found! = null;
    Int index! = 0;
    while (index + 1 < header.length) {
        if (header[index] == UInt8(13) && header[index + 1] == UInt8(10)) {
            if (index == line_start) { break; }
            UInt8[]& line = header[line_start..index];
            UInt8[]& prefix = "Content-Length:";
            if (starts_with_ascii_case_insensitive(line, prefix)) {
                if (found != null) { return null; }
                found = parse_length(line[prefix.length..line.length]);
                if (found == null) { return null; }
            }
            index = index + 2;
            line_start = index;
        } else {
            index = index + 1;
        }
    }
    return found;
}

Bool starts_with_ascii_case_insensitive(UInt8[]& line, UInt8[]& prefix) {
    if (line.length < prefix.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        UInt8 byte! = line[index];
        if (byte >= UInt8(65) && byte <= UInt8(90)) { byte = byte + UInt8(32); }
        UInt8 expected! = prefix[index];
        if (expected >= UInt8(65) && expected <= UInt8(90)) { expected = expected + UInt8(32); }
        if (byte != expected) { return false; }
        index = index + 1;
    }
    return true;
}

Int? parse_length(UInt8[]& text) {
    Int index! = 0;
    while (index < text.length && (text[index] == UInt8(32) || text[index] == UInt8(9))) {
        index = index + 1;
    }
    if (index == text.length) { return null; }
    Int result! = 0;
    Int digits! = 0;
    while (index < text.length && text[index] >= UInt8(48) && text[index] <= UInt8(57)) {
        Int digit = Int(text[index]) - 48;
        if (result > (max_message_bytes - digit) / 10) { return null; }
        result = result * 10 + digit;
        digits = digits + 1;
        index = index + 1;
    }
    if (digits == 0) { return null; }
    while (index < text.length && (text[index] == UInt8(32) || text[index] == UInt8(9))) {
        index = index + 1;
    }
    if (index != text.length || result == 0) { return null; }
    return result;
}

UInt8[]^? read_body(Int length) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(length);
        Int offset! = 0;
        while (offset < length) {
            guard io.read_stdin(bytes[offset..length]) is .some(count) else {
                bytes$.dealloc();
                return null;
            }
            if (count == 0) {
                bytes$.dealloc();
                return null;
            }
            offset = offset + count;
        }
        return bytes[0..length]$.as(UInt8[]^);
    }
}
