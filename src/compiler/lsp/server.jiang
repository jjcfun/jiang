#doc(module)
    维护单个 LSP 连接的文档版本与 CompilerSession；按 package 入口同步检查并发布诊断。
#end

alias diagnostic = import "../diagnostic.jiang";
alias options = import "../driver/options.jiang";
alias qid = import "../id.jiang";
alias session = import "../session.jiang";
alias service = import "../service.jiang";
alias source = import "../source.jiang";
alias source_map = import "../source/source_map.jiang";
alias env = import "../system/env.jiang";
alias fs = import "../system/fs.jiang";
alias list = import "../support/list.jiang";
alias string = import "../support/string.jiang";
alias json = import "./json.jiang";
alias transport = import "./transport.jiang";
import std;

struct Document: Movable {
    std.String uri;
    std.String path;
    source.SourceId source_id;
    Int version!;
    Bool open!;
    std.String? published_diagnostics!;
    Int? completion_offset!;
    Int completion_version!;
    Int completion_generation!;
    std.String? completion_response!;

    init(self, std.String uri, std.String path, source.SourceId source_id, Int version) {
        self.uri = uri;
        self.path = path;
        self.source_id = source_id;
        self.version = version;
        self.open = true;
        self.published_diagnostics = null;
        self.completion_offset = null;
        self.completion_version = 0;
        self.completion_generation = 0;
        self.completion_response = null;
    }
}

#doc 保存一个 package 入口已解析的源码身份；失败检查保留此前的依赖以避免漏失效。
struct RootSources: Movable {
    std.String input;
    list.ArrayList<source.SourceId> sources!;

    init(self, std.String input) {
        self.input = input;
        self.sources = list.ArrayList<source.SourceId>();
    }

    Bool contains(self, source.SourceId source_id) {
        Int index! = 0;
        while (index < self.sources.len()) {
            if (self.sources.get(index) == source_id) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void update(Self&! self, list.ArrayList<source.SourceId>& current, Bool complete) {
        if (complete) { self.sources.clear(); }
        Int index! = 0;
        while (index < current.len()) {
            source.SourceId source_id = current.get(index);
            if (!self.contains(source_id)) { self.sources.add(source_id); }
            index = index + 1;
        }
    }
}

struct Server: Movable {
    session.CompilerSession compiler!;
    list.ArrayList<Document> documents!;
    list.ArrayList<RootSources> roots!;
    std.String? checked_path!;
    Bool initialized!;
    Bool shutdown!;

    init(self) {
        self.compiler = session.CompilerSession();
        self.documents = list.ArrayList<Document>();
        self.roots = list.ArrayList<RootSources>();
        self.checked_path = null;
        self.initialized = false;
        self.shutdown = false;
    }

    #doc 处理一条完整 JSON-RPC 消息；收到 exit 后返回 false。
    Bool handle(Self&! self, UInt8[]& message) {
        guard json.parse(message) is .some(root) else {
            self.write_error("null", -32700, "Parse error");
            return true;
        }
        if (root.kind != .object) {
            self.write_error("null", -32600, "Invalid Request");
            return true;
        }
        guard root.field("jsonrpc") is .some(version) else { return self.invalid_request(root); }
        guard version.as_string() is .some(protocol) else { return self.invalid_request(root); }
        if (!string.equal(protocol.bytes(), "2.0")) { return self.invalid_request(root); }
        guard root.field("method") is .some(method_value) else { return self.invalid_request(root); }
        guard method_value.as_string() is .some(method) else { return self.invalid_request(root); }
        json.Value? id = root.field("id");
        if (string.equal(method.bytes(), "initialize")) {
            if (id is .some(request_id)) { self.initialize(request_id); }
            return true;
        }
        if (string.equal(method.bytes(), "exit")) { return false; }
        if (string.equal(method.bytes(), "shutdown")) {
            self.shutdown = true;
            if (id is .some(request_id)) { self.write_result(request_id.raw(), "null"); }
            return true;
        }
        if (!self.initialized || self.shutdown) {
            if (id is .some(request_id)) { self.write_error(request_id.raw(), -32002, "Server not initialized"); }
            return true;
        }
        if (string.equal(method.bytes(), "initialized")) { return true; }
        guard root.field("params") is .some(params) else {
            if (id is .some(request_id)) { self.write_error(request_id.raw(), -32602, "Invalid params"); }
            return true;
        }
        if (string.equal(method.bytes(), "textDocument/didOpen")) { self.did_open(params); }
        else if (string.equal(method.bytes(), "textDocument/didChange")) { self.did_change(params); }
        else if (string.equal(method.bytes(), "textDocument/didSave")) { self.did_save(params); }
        else if (string.equal(method.bytes(), "textDocument/didClose")) { self.did_close(params); }
        else if (string.equal(method.bytes(), "textDocument/definition") && id is .some(request_id)) {
            self.semantic_request(request_id, params, false);
        }
        else if (string.equal(method.bytes(), "textDocument/hover") && id is .some(request_id)) {
            self.semantic_request(request_id, params, true);
        }
        else if (string.equal(method.bytes(), "textDocument/completion") && id is .some(request_id)) {
            self.completion_request(request_id, params);
        }
        else if (id is .some(request_id)) { self.write_error(request_id.raw(), -32601, "Method not found"); }
        return true;
    }

    Bool invalid_request(Self&! self, json.Value root) {
        UInt8[]& id! = "null";
        if (root.field("id") is .some(request_id)) { id = request_id.raw(); }
        self.write_error(id, -32600, "Invalid Request");
        return true;
    }

    Void initialize(Self&! self, json.Value id) {
        if (self.initialized) {
            self.write_error(id.raw(), -32600, "Already initialized");
            return;
        }
        self.initialized = true;
        std.StringBuilder result! = std.StringBuilder();
        result.append("{\"capabilities\":{\"positionEncoding\":\"utf-16\",");
        result.append("\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":true},");
        result.append("\"definitionProvider\":true,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]}},");
        result.append("\"serverInfo\":{\"name\":\"Jiang\",\"version\":\"0.6.0\"}}");
        self.write_result(id.raw(), result.slice());
    }

    Void did_open(Self&! self, json.Value params) {
        guard params.field("textDocument") is .some(text_document) else { return; }
        guard text_document.field("uri") is .some(uri_value) else { return; }
        guard uri_value.as_string() is .some(uri) else { return; }
        guard file_path(uri.bytes()) is .some(path) else { return; }
        guard text_document.field("text") is .some(text_value) else { return; }
        guard text_value.as_string() is .some(text) else { return; }
        guard text_document.field("version") is .some(version_value) else { return; }
        guard version_value.as_int() is .some(version) else { return; }
        if (self.document_index(uri.bytes()) is .some(index) && self.documents.ref_at(index).open
            && version <= self.documents.ref_at(index).version) { return; }
        self.clear_completion_results();
        source.SourceId source_id = self.compiler.set_source(path.bytes(), text.bytes());
        std.String changed_path = std.String.from_valid_utf8(path.bytes());
        self.checked_path = null;
        if (self.document_index(uri.bytes()) is .some(index)) {
            Document&! document = self.documents.mut_ref_at(index);
            document.version = version;
            document.open = true;
            document.published_diagnostics = null;
        } else {
            self.documents.add(Document(uri, path, source_id, version));
        }
        self.recheck_open_documents(source_id, changed_path.bytes());
    }

    Void did_change(Self&! self, json.Value params) {
        guard params.field("textDocument") is .some(text_document) else { return; }
        guard text_document.field("uri") is .some(uri_value) else { return; }
        guard uri_value.as_string() is .some(uri) else { return; }
        guard self.document_index(uri.bytes()) is .some(index) else { return; }
        if (!self.documents.ref_at(index).open) { return; }
        guard text_document.field("version") is .some(version_value) else { return; }
        guard version_value.as_int() is .some(version) else { return; }
        if (version <= self.documents.ref_at(index).version) { return; }
        guard params.field("contentChanges") is .some(changes) else { return; }
        guard changes.item(0) is .some(change) else { return; }
        if (change.field("range") != null || changes.item(1) != null) { return; }
        guard change.field("text") is .some(text_value) else { return; }
        guard text_value.as_string() is .some(text) else { return; }
        self.clear_completion_results();
        std.String path = std.String.from_valid_utf8(self.documents.ref_at(index).path.bytes());
        self.compiler.set_source(path.bytes(), text.bytes());
        self.checked_path = null;
        Document&! document = self.documents.mut_ref_at(index);
        document.version = version;
        document.published_diagnostics = null;
        self.recheck_open_documents(self.documents.ref_at(index).source_id, path.bytes());
    }

    #doc 保存时执行完整检查，补发需要 JIL 与借用分析的诊断。
    Void did_save(Self&! self, json.Value params) {
        guard params.field("textDocument") is .some(text_document) else { return; }
        guard text_document.field("uri") is .some(uri_value) else { return; }
        guard uri_value.as_string() is .some(uri) else { return; }
        guard self.document_index(uri.bytes()) is .some(index) else { return; }
        if (!self.documents.ref_at(index).open) { return; }
        std.String path = std.String.from_valid_utf8(self.documents.ref_at(index).path.bytes());
        self.recheck_open_documents(self.documents.ref_at(index).source_id, path.bytes(), false);
    }

    Void did_close(Self&! self, json.Value params) {
        guard params.field("textDocument") is .some(text_document) else { return; }
        guard text_document.field("uri") is .some(uri_value) else { return; }
        guard uri_value.as_string() is .some(uri) else { return; }
        guard self.document_index(uri.bytes()) is .some(index) else { return; }
        if (!self.documents.ref_at(index).open) { return; }
        self.clear_completion_results();
        std.String path = std.String.from_valid_utf8(self.documents.ref_at(index).path.bytes());
        self.compiler.clear_source(path.bytes());
        self.checked_path = null;
        self.documents.mut_ref_at(index).open = false;
        self.publish_empty(uri.bytes(), null);
        self.recheck_open_documents(self.documents.ref_at(index).source_id, path.bytes());
    }

    Int? document_index(self, UInt8[]& uri) {
        Int index! = 0;
        while (index < self.documents.len()) {
            if (string.equal(self.documents.ref_at(index).uri.bytes(), uri)) { return index; }
            index = index + 1;
        }
        return null;
    }

    #doc 源码 overlay 变化后丢弃各文档响应；import 依赖可能跨文档失效。
    Void clear_completion_results(Self&! self) {
        Int index! = 0;
        while (index < self.documents.len()) {
            self.documents.mut_ref_at(index).completion_response = null;
            index = index + 1;
        }
    }

    #doc 只重查包含变更源码的入口；package 配置变化保守重查所有打开入口。
    Void recheck_open_documents(
        Self&! self, source.SourceId changed, UInt8[]& path, Bool frontend_only = true
    ) {
        std.String changed_input = self.compilation_input(path);
        Bool configuration_changed = is_package_configuration(path);
        Int index! = 0;
        while (index < self.documents.len()) {
            if (!self.documents.ref_at(index).open) { index = index + 1; continue; }
            std.String input = self.compilation_input(self.documents.ref_at(index).path.bytes());
            if (!self.earlier_open_input(index, input.bytes())
                && (configuration_changed || string.equal(input.bytes(), changed_input.bytes())
                    || self.root_contains_source(input.bytes(), changed))) {
                self.check_input_with_mode(input.bytes(), frontend_only);
                self.publish_input_documents(index, input.bytes(), frontend_only);
            }
            index = index + 1;
        }
    }

    Bool root_contains_source(self, UInt8[]& input, source.SourceId source_id) {
        Int index! = 0;
        while (index < self.roots.len()) {
            RootSources& root = self.roots.ref_at(index);
            if (string.equal(root.input.bytes(), input)) { return root.contains(source_id); }
            index = index + 1;
        }
        return false;
    }

    Void record_root_sources(Self&! self, UInt8[]& input) {
        list.ArrayList<source.SourceId> current = self.compiler.compilation_sources();
        Bool complete = !self.compiler.diagnostics().has_errors();
        Int index! = 0;
        while (index < self.roots.len()) {
            RootSources&! root = self.roots.mut_ref_at(index);
            if (string.equal(root.input.bytes(), input)) {
                root.update(current$.ref(), complete);
                return;
            }
            index = index + 1;
        }
        RootSources root! = RootSources(std.String.from_valid_utf8(input));
        root.update(current$.ref(), complete);
        self.roots.add(root$.move());
    }

    Bool earlier_open_input(self, Int index, UInt8[]& input) {
        Int previous! = 0;
        while (previous < index) {
            if (self.documents.ref_at(previous).open) {
                std.String earlier = self.compilation_input(self.documents.ref_at(previous).path.bytes());
                if (string.equal(earlier.bytes(), input)) { return true; }
            }
            previous = previous + 1;
        }
        return false;
    }

    Void publish_input_documents(Self&! self, Int start, UInt8[]& input, Bool frontend_only = true) {
        list.ArrayList<Int> detached! = list.ArrayList<Int>();
        Path configuration = std.path.join(input, "package.jiang");
        Int member! = start;
        while (member < self.documents.len()) {
            Document& document = self.documents.ref_at(member);
            if (!document.open) { member = member + 1; continue; }
            std.String member_input = self.compilation_input(document.path.bytes());
            if (!string.equal(member_input.bytes(), input)) { member = member + 1; continue; }
            if (!string.equal(input, document.path.bytes())
                && !string.equal(configuration.bytes(), document.path.bytes())
                && !self.compiler.source_in_compilation(document.source_id)) {
                detached.add(member);
            } else {
                self.publish_diagnostics(member);
            }
            member = member + 1;
        }
        Int detached_index! = 0;
        while (detached_index < detached.len()) {
            Int document_index = detached.get(detached_index);
            self.check_input_with_mode(self.documents.ref_at(document_index).path.bytes(), frontend_only);
            self.publish_diagnostics(document_index);
            detached_index = detached_index + 1;
        }
    }

    Void check_document(Self&! self, UInt8[]& path, source.SourceId source_id) {
        std.String input = self.compilation_input(path);
        self.check_input(input.bytes());
        if (!string.equal(input.bytes(), path) && !self.compiler.source_in_compilation(source_id)) {
            self.check_input(path);
        }
    }

    Void check_input(Self&! self, UInt8[]& input) {
        self.check_input_with_mode(input, true);
    }

    Void check_input_with_mode(Self&! self, UInt8[]& input, Bool frontend_only) {
        if (frontend_only && self.checked_path is .some(ref _ checked)
            && string.equal(checked.bytes(), input)) { return; }
        options.CompileOptions check! = options.CompileOptions(.check_only, input, "");
        check.frontend_only = frontend_only;
        self.compiler.compile(check$.ref());
        self.checked_path = std.String.from_valid_utf8(input);
        self.record_root_sources(input);
    }

    #doc 使用最近的 package.jiang 目录；独立源码仍以自身路径编译。
    std.String compilation_input(self, UInt8[]& path) {
        Path directory! = std.path.normalize(std.path.dirname(path));
        while (true) {
            Path configuration = std.path.join(directory.bytes(), "package.jiang");
            if (fs.file_exists(configuration.bytes())) {
                return std.String.from_valid_utf8(directory.bytes());
            }
            Path parent = std.path.normalize(std.path.dirname(directory.bytes()));
            if (string.equal(parent.bytes(), directory.bytes())) { break; }
            directory = parent;
        }
        return std.String.from_valid_utf8(path);
    }

    #doc 基于当前 overlay 编译请求文档，再读取这一轮的语义事实。
    Void semantic_request(Self&! self, json.Value id, json.Value params, Bool hover) {
        guard params.field("textDocument") is .some(text_document) else { self.invalid_params(id); return; }
        guard text_document.field("uri") is .some(uri_value) else { self.invalid_params(id); return; }
        guard uri_value.as_string() is .some(uri) else { self.invalid_params(id); return; }
        guard params.field("position") is .some(position) else { self.invalid_params(id); return; }
        guard position.field("line") is .some(line_value) else { self.invalid_params(id); return; }
        guard line_value.as_int() is .some(line) else { self.invalid_params(id); return; }
        guard position.field("character") is .some(character_value) else { self.invalid_params(id); return; }
        guard character_value.as_int() is .some(character) else { self.invalid_params(id); return; }
        if (line < 0 || character < 0) { self.invalid_params(id); return; }
        guard self.document_index(uri.bytes()) is .some(index) else { self.write_result(id.raw(), "null"); return; }
        if (!self.documents.ref_at(index).open) { self.write_result(id.raw(), "null"); return; }
        std.String path = std.String.from_valid_utf8(self.documents.ref_at(index).path.bytes());
        source.SourceId source_id = self.documents.ref_at(index).source_id;
        self.check_document(path.bytes(), source_id);
        guard self.compiler.lsp_offset(source_id, line, character) is .some(offset) else {
            self.write_result(id.raw(), "null");
            return;
        }
        if (!self.compiler.lsp_identifier_at(source_id, offset)) {
            self.write_result(id.raw(), "null");
            return;
        }
        std.String result = if (hover) {
            self.hover_result(source_id, offset)
        } else {
            self.definition_result(source_id, offset)
        };
        self.write_result(id.raw(), result.bytes());
    }

    #doc 从本轮解析与语义事实返回光标处的基础名称补全。
    Void completion_request(Self&! self, json.Value id, json.Value params) {
        guard params.field("textDocument") is .some(text_document) else { self.invalid_params(id); return; }
        guard text_document.field("uri") is .some(uri_value) else { self.invalid_params(id); return; }
        guard uri_value.as_string() is .some(uri) else { self.invalid_params(id); return; }
        guard params.field("position") is .some(position) else { self.invalid_params(id); return; }
        guard position.field("line") is .some(line_value) else { self.invalid_params(id); return; }
        guard line_value.as_int() is .some(line) else { self.invalid_params(id); return; }
        guard position.field("character") is .some(character_value) else { self.invalid_params(id); return; }
        guard character_value.as_int() is .some(character) else { self.invalid_params(id); return; }
        if (line < 0 || character < 0) { self.invalid_params(id); return; }
        guard self.document_index(uri.bytes()) is .some(index) else { self.write_result(id.raw(), "[]"); return; }
        if (!self.documents.ref_at(index).open) { self.write_result(id.raw(), "[]"); return; }
        std.String path = std.String.from_valid_utf8(self.documents.ref_at(index).path.bytes());
        source.SourceId source_id = self.documents.ref_at(index).source_id;
        guard self.compiler.lsp_offset(source_id, line, character) is .some(offset) else {
            self.write_result(id.raw(), "[]");
            return;
        }
        Document& document = self.documents.ref_at(index);
        if (document.completion_offset is .some(cached_offset) && cached_offset == offset
            && document.completion_version == document.version
            && document.completion_generation == self.compiler.generation()
            && document.completion_response is .some(ref cached)) {
            self.write_result(id.raw(), cached.bytes());
            return;
        }
        self.check_document(path.bytes(), source_id);
        std.String result! = self.completion_result(source_id, offset);
        if (string.equal(result.bytes(), "[]")) {
            if (self.compiler.source_text(source_id) is .some(original)) {
                if (completion_at_dot(original.bytes(), offset)) {
                    std.StringBuilder probe! = std.StringBuilder();
                    probe.append(original.bytes()[0..offset]);
                    probe.append("__jiang_lsp_probe__");
                    if (completion_at_line_end(original.bytes(), offset)) { probe.append(";"); }
                    probe.append(original.bytes()[offset..]);
                    self.compiler.set_source(path.bytes(), probe.slice());
                    self.checked_path = null;
                    self.check_document(path.bytes(), source_id);
                    result = self.completion_result(source_id, offset);
                    self.compiler.set_source(path.bytes(), original.bytes());
                    self.checked_path = null;
                }
            }
        }
        Document&! updated = self.documents.mut_ref_at(index);
        updated.completion_offset = offset;
        updated.completion_version = updated.version;
        updated.completion_generation = self.compiler.generation();
        updated.completion_response = std.String.from_valid_utf8(result.bytes());
        self.write_result(id.raw(), result.bytes());
    }

    std.String completion_result(Self&! self, source.SourceId source_id, Int offset) {
        list.ArrayList<qid.DefId> definitions = self.compiler.completion_defs(source_id, offset);
        service.CompilerQueries queries = self.compiler.queries();
        std.StringBuilder result! = std.StringBuilder();
        result.append("[");
        Int candidate! = 0;
        while (candidate < definitions.len()) {
            if (candidate > 0) { result.append(","); }
            qid.DefId def_id = definitions.get(candidate);
            std.String label = queries.completion_label(def_id);
            result.append("{\"label\":");
            json.append_string(result$.mut_ref(), label.bytes());
            result.append(",\"kind\":");
            result.append(queries.completion_kind(def_id));
            if (queries.declaration_detail(def_id) is .some(detail)) {
                result.append(",\"detail\":");
                json.append_string(result$.mut_ref(), detail.bytes());
            }
            if (queries.declaration_documentation(def_id) is .some(documentation)) {
                result.append(",\"documentation\":{\"kind\":\"markdown\",\"value\":");
                json.append_string(result$.mut_ref(), documentation.bytes());
                result.append("}");
            }
            result.append("}");
            candidate = candidate + 1;
        }
        result.append("]");
        return std.String.from_valid_utf8(result.slice());
    }

    Void invalid_params(Self&! self, json.Value id) {
        self.write_error(id.raw(), -32602, "Invalid params");
    }

    std.String definition_result(self, source.SourceId source_id, Int offset) {
        service.CompilerQueries queries = self.compiler.queries();
        guard queries.definition_at(source_id, offset) is .some(def_id) else { return "null"; }
        guard queries.definition_span(def_id) is .some(location) else { return "null"; }
        guard location.source_id is .some(target_id) else { return "null"; }
        guard self.compiler.lsp_range(target_id, location.span) is .some(range) else { return "null"; }
        guard self.uri_for_source(target_id) is .some(uri) else { return "null"; }
        std.StringBuilder result! = std.StringBuilder();
        result.append("{\"uri\":");
        json.append_string(result$.mut_ref(), uri.bytes());
        result.append(",\"range\":{");
        append_position(result$.mut_ref(), "start", range.start);
        result.append(",");
        append_position(result$.mut_ref(), "end", range.end);
        result.append("}}");
        return result.into_string();
    }

    std.String hover_result(self, source.SourceId source_id, Int offset) {
        service.CompilerQueries queries = self.compiler.queries();
        guard queries.definition_at(source_id, offset) is .some(def_id) else { return "null"; }
        guard queries.declaration_detail(def_id) is .some(preview) else { return "null"; }
        std.StringBuilder result! = std.StringBuilder();
        if (queries.declaration_documentation(def_id) is .some(documentation)) {
            std.StringBuilder contents! = std.StringBuilder();
            contents.append("```jiang\n");
            contents.append_valid_utf8(preview.bytes());
            contents.append("\n```\n\n");
            contents.append_valid_utf8(documentation.bytes());
            result.append("{\"contents\":{\"kind\":\"markdown\",\"value\":");
            json.append_string(result$.mut_ref(), contents.slice());
            result.append("}}");
            return result.into_string();
        }
        result.append("{\"contents\":{\"kind\":\"plaintext\",\"value\":");
        json.append_string(result$.mut_ref(), preview.bytes());
        result.append("}}");
        return result.into_string();
    }

    std.String? uri_for_source(self, source.SourceId source_id) {
        Int index! = 0;
        while (index < self.documents.len()) {
            Document& document = self.documents.ref_at(index);
            if (document.open && document.source_id == source_id) {
                return std.String.from_valid_utf8(document.uri.bytes());
            }
            index = index + 1;
        }
        guard self.compiler.source_path(source_id) is .some(path) else { return null; }
        Path absolute! = std.path.normalize(path.bytes());
        if (!absolute.is_absolute()) {
            guard env.get("PWD") is .some(cwd) else { return null; }
            absolute = std.path.join(cwd[..], absolute.bytes());
        }
        std.StringBuilder uri! = std.StringBuilder();
        uri.append("file://");
        UInt8[]& bytes = absolute.bytes();
        UInt8[]& digits = "0123456789ABCDEF";
        index = 0;
        while (index < bytes.length) {
            UInt8 byte = bytes[index];
            if ((byte >= UInt8(65) && byte <= UInt8(90))
                || (byte >= UInt8(97) && byte <= UInt8(122))
                || (byte >= UInt8(48) && byte <= UInt8(57))
                || byte == UInt8(45) || byte == UInt8(46) || byte == UInt8(95)
                || byte == UInt8(126) || byte == UInt8(47)) {
                uri.append_valid_utf8(bytes[index..index + 1]);
            } else {
                UInt8[3] escaped = [UInt8(37), digits[Int(byte) / 16], digits[Int(byte) % 16]];
                uri.append_valid_utf8(escaped[..]);
            }
            index = index + 1;
        }
        return uri.into_string();
    }

    Void publish_diagnostics(Self&! self, Int document_index) {
        Document& document = self.documents.ref_at(document_index);
        std.StringBuilder diagnostics! = std.StringBuilder();
        diagnostics.append("[");
        Int index! = 0;
        Bool first! = true;
        while (index < self.compiler.diagnostics().len()) {
            diagnostic.Diagnostic& item = self.compiler.diagnostics().get(index);
            index = index + 1;
            if (item.range.source_id is .some(id) && id != document.source_id) { continue; }
            if (!first) { diagnostics.append(","); }
            first = false;
            self.append_diagnostic(diagnostics$.mut_ref(), item);
        }
        diagnostics.append("]");
        if (document.published_diagnostics is .some(ref _ previous)
            && string.equal(previous.bytes(), diagnostics.slice())) { return; }
        std.StringBuilder body! = std.StringBuilder();
        body.append("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{");
        body.append("\"uri\":");
        json.append_string(body$.mut_ref(), document.uri.bytes());
        body.append(",\"version\":");
        body.append(document.version);
        body.append(",\"diagnostics\":");
        body.append(diagnostics.slice());
        body.append("}}");
        transport.write_message(body.slice());
        self.documents.mut_ref_at(document_index).published_diagnostics = diagnostics.into_string();
    }

    Void append_diagnostic(self, std.StringBuilder&! body, diagnostic.Diagnostic& item) {
        diagnostic.SourceRange range! = item.range;
        if (item.range.source_id is .some(id)) {
            if (self.compiler.lsp_range(id, item.range.span) is .some(mapped)) { range = mapped; }
        }
        body.append("{\"range\":{");
        append_position(body, "start", range.start);
        body.append(",");
        append_position(body, "end", range.end);
        body.append("},\"severity\":");
        body.append(diagnostic.lsp_severity_code(item.severity));
        body.append(",\"code\":");
        if (item.code.kind == .numeric) { body.append(item.code.number); }
        else { json.append_string(body, item.code.text); }
        body.append(",\"source\":");
        json.append_string(body, item.source_name);
        body.append(",\"message\":");
        json.append_string(body, item.message.bytes());
        body.append("}");
    }

    Void publish_empty(Self&! self, UInt8[]& uri, Int? version) {
        std.StringBuilder body! = std.StringBuilder();
        body.append("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{");
        body.append("\"uri\":");
        json.append_string(body$.mut_ref(), uri);
        if (version is .some(current)) {
            body.append(",\"version\":");
            body.append(current);
        }
        body.append(",\"diagnostics\":[]}}");
        transport.write_message(body.slice());
    }

    Void write_result(Self&! self, UInt8[]& id, UInt8[]& result) {
        std.StringBuilder body! = std.StringBuilder();
        body.append("{\"jsonrpc\":\"2.0\",\"id\":");
        body.append_valid_utf8(id);
        body.append(",\"result\":");
        body.append_valid_utf8(result);
        body.append("}");
        transport.write_message(body.slice());
    }

    Void write_error(Self&! self, UInt8[]& id, Int code, UInt8[]& message) {
        std.StringBuilder body! = std.StringBuilder();
        body.append("{\"jsonrpc\":\"2.0\",\"id\":");
        body.append_valid_utf8(id);
        body.append(",\"error\":{\"code\":");
        body.append(code);
        body.append(",\"message\":");
        json.append_string(body$.mut_ref(), message);
        body.append("}}");
        transport.write_message(body.slice());
    }
}

#doc package 配置可能改变入口和依赖解析，编辑它时保守失效所有打开入口。
Bool is_package_configuration(UInt8[]& path) {
    Path normalized = std.path.normalize(path);
    Path configuration = std.path.join(std.path.dirname(normalized.bytes()), "package.jiang");
    return string.equal(normalized.bytes(), configuration.bytes());
}

Bool completion_at_dot(UInt8[]& text, Int offset) {
    if (offset < 1 || offset > text.length) { return false; }
    Int start! = offset;
    while (start > 0 && completion_identifier_byte(text[start - 1])) { start = start - 1; }
    return start > 0 && text[start - 1] == UInt8(46);
}

Bool completion_at_line_end(UInt8[]& text, Int offset) {
    Int index! = offset;
    while (index < text.length && (text[index] == UInt8(32) || text[index] == UInt8(9))) {
        index = index + 1;
    }
    return index == text.length || text[index] == UInt8(10) || text[index] == UInt8(13);
}

Bool completion_identifier_byte(UInt8 byte) {
    return (byte >= UInt8(65) && byte <= UInt8(90))
        || (byte >= UInt8(97) && byte <= UInt8(122))
        || (byte >= UInt8(48) && byte <= UInt8(57))
        || byte == UInt8(95) || byte >= UInt8(128);
}

Void append_position(std.StringBuilder&! body, UInt8[]& name, diagnostic.SourcePosition position) {
    json.append_string(body, name);
    body.append(":{\"line\":");
    body.append(position.line);
    body.append(",\"character\":");
    body.append(position.character);
    body.append("}");
}

std.String? file_path(UInt8[]& uri) {
    UInt8[]& prefix = "file://";
    if (uri.length < prefix.length) { return null; }
    Int index! = 0;
    while (index < prefix.length) {
        if (uri[index] != prefix[index]) { return null; }
        index = index + 1;
    }
    if (uri.length > index && uri[index] != UInt8(47)) {
        UInt8[]& localhost = "localhost";
        if (uri.length < index + localhost.length + 1) { return null; }
        Int offset! = 0;
        while (offset < localhost.length) {
            if (uri[index + offset] != localhost[offset]) { return null; }
            offset = offset + 1;
        }
        index = index + localhost.length;
    }
    if (index >= uri.length || uri[index] != UInt8(47)) { return null; }
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    while (index < uri.length) {
        UInt8 byte! = uri[index];
        if (byte == UInt8(63) || byte == UInt8(35)) { return null; }
        if (byte == UInt8(37)) {
            if (index + 2 >= uri.length) { return null; }
            guard hex_digit(uri[index + 1]) is .some(high) else { return null; }
            guard hex_digit(uri[index + 2]) is .some(low) else { return null; }
            byte = UInt8(high * 16 + low);
            index = index + 2;
        }
        if (byte == UInt8(0)) { return null; }
        bytes.add(byte);
        index = index + 1;
    }
    std.String path = try std.String.from_utf8(bytes.slice()) catch { return null; };
    return path;
}

Int? hex_digit(UInt8 byte) {
    if (byte >= UInt8(48) && byte <= UInt8(57)) { return Int(byte) - 48; }
    if (byte >= UInt8(65) && byte <= UInt8(70)) { return Int(byte) - 55; }
    if (byte >= UInt8(97) && byte <= UInt8(102)) { return Int(byte) - 87; }
    return null;
}

#doc 在 stdio 上服务一个 LSP 连接；按协议 exit 状态返回进程退出码。
public Int run() {
    Server server! = Server();
    while (true) {
        guard transport.read_message() is .some(message) else { break; }
        if (!server.handle(message[..])) { break; }
    }
    if (server.shutdown) { return 0; }
    return 1;
}
