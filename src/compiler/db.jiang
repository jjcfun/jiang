// db 查询层稳定入口。
//
// 查询层实现按组件拆分在 db/ 目录；外部通过本入口使用
// QueryEngine / QueryCache 等公开 API。

public alias * = import "./db/query_cache.jiang";
public alias * = import "./db/collection_cache.jiang";
public alias * = import "./db/source_location.jiang";
public alias * = import "./db/query_engine.jiang";
public alias * = import "./db/layout_query.jiang";
public alias * = import "./db/module_interface.jiang";
public alias * = import "./db/module_model.jiang";
public alias * = import "./db/object_unit.jiang";
public alias * = import "./db/build_target.jiang";
public alias * = import "./db/source_import_summary.jiang";
public alias * = import "./db/stable_fingerprint.jiang";
public alias * = import "./db/type_check_body.jiang";
public alias * = import "./db/type_check_node.jiang";
public alias * = import "./db/type_check_def.jiang";
public alias * = import "./db/type_check_signature.jiang";
public alias * = import "./db/trait_dependency.jiang";
public alias * = import "./db/type_lifetime_shape.jiang";
public alias * = import "./db/trait_satisfaction.jiang";
public alias * = import "./db/const_definition.jiang";
public alias * = import "./db/jil_body.jiang";
public alias * = import "./db/trait_vtable.jiang";
public alias * = import "./db/jil_analysis.jiang";
public alias * = import "./db/declaration_observation.jiang";

public alias * = import "./db/declaration.jiang";

alias module_graph = import "./db/module_graph.jiang";
public alias ModuleProperty = module_graph.ModuleProperty;

alias documentation = import "./db/documentation.jiang";
public alias DocumentationTarget = documentation.DocumentationTarget;

alias metadata = import "./db/metadata.jiang";
public alias MetadataScope = metadata.MetadataScope;
public alias MetadataAttachment = metadata.MetadataAttachment;
