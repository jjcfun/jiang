// 编译流水线负责串联 source、syntax、resolve、sema、lower、backend。

#doc(module)
    ### Overview

    从 package/source 输入依次执行 syntax、resolve、type check、borrow check、JIL 与 backend 阶段。
#end

import context = "./context.jiang";
import database = "./db.jiang";
import diagnostic = "./diagnostic.jiang";
import diagnostic_helper = "./diagnostic/helper.jiang";
import qkey = "./incremental/key.jiang";
import source_ji = "./artifact/source_ji.jiang";
import artifact_path = "./artifact/path.jiang";
import cache_identity = "./artifact/cache_identity.jiang";
import import_context = "./artifact/import_context.jiang";
import object_key_builder = "./artifact/object_key_builder.jiang";
import backend = "./backend.jiang";
import borrow_check = "./borrow_check.jiang";
import driver_options = "./driver/options.jiang";
import lang = "./lang.jiang";
import jil_pipeline = "./jil/pipeline.jiang";
import jil = "./jil.jiang";
import resolve = "./resolve/module_resolver.jiang";
import module_graph = "./resolve/module_graph.jiang";
import syntax = "./syntax.jiang";
import type_check = "./sema/type_check.jiang";
import source_entry = "./source/entry.jiang";
import source = "./source.jiang";
import system_fs = "./system/fs.jiang";
import system_io = "./system/io.jiang";
import system_target = "./system/target.jiang";
import system_time = "./system/time.jiang";
import string = "./support/string.jiang";
import std;

// 编译器唯一公开入口。driver 负责把命令行整理成 CompileOptions，
// pipeline 只按 options 串联 source 到 backend 的阶段。
#doc 从 options 指定的输入加载 package，并执行一次 compilation。
public Void compile(context.CompilerContext&! ctx, driver_options.CompileOptions& options) {
    ctx.output = build_output_kind(options.emit);
    ctx.begin_compilation();
    source_entry.PackageHandle package! = source_entry.load_package(ctx, options.input_path);
    if (!package.ok) {
        return;
    }
    compile_loaded_package_after_begin(ctx, package$.ref(), options);
}

// 已加载 package 的重复执行入口。PackageHandle 只保存入口身份；每轮仍读取最新
// source overlay，并重建当前 compilation 的 module/semantic/type facts。
#doc 对已经加载的 package 执行新一轮 compilation，并读取最新 source overlay。
public Void compile_loaded_package(
    context.CompilerContext&! ctx,
    source_entry.PackageHandle& package,
    driver_options.CompileOptions& options
) {
    ctx.output = build_output_kind(options.emit);
    ctx.begin_compilation();
    compile_loaded_package_after_begin(ctx, package, options);
}

Void compile_loaded_package_after_begin(
    context.CompilerContext&! ctx,
    source_entry.PackageHandle& package,
    driver_options.CompileOptions& options
) {
    source_entry.Entry entry! = source_entry.read_root(ctx, package);
    if (!entry.ok) {
        return;
    }
    compile_package_with_emit(
        ctx,
        entry.source_id,
        package.root_path.bytes(),
        entry.text$.ref(),
        options
    );
    publish_layout_diagnostics(ctx);
}

Void publish_layout_diagnostics(context.CompilerContext&! ctx) {
    diagnostic.DiagnosticStore diagnostics = ctx.query.layout.take_diagnostics();
    ctx.store.diagnostics.append(diagnostics$.move());
}

// package 编译主干。这个函数只编排阶段顺序和早停条件；
// 具体语义检查、JIL 改写和 backend lowering 必须留在各自阶段内。
Void compile_package_with_emit(
    context.CompilerContext&! ctx,
    source.SourceId source_id,
    UInt8[]& root_path,
    UInt8[]& source_text,
    driver_options.CompileOptions& options
) {
    if (!backend.validate_output_request(ctx, options)) {
        return;
    }
    ctx.store.artifacts.enable_timing(options.jil_stats);
    UInt64 stage_started! = system_time.monotonic_time_ns();
    UInt64 compiler_version_hash = source_artifact_version_hash(options.compiler_version);
    std.String target_cache_key = system_target.build_cache_key(ctx.target$.ref(), ctx.output);
    std.String toolchain_version = backend.llvm_version_text();
    cache_identity.ContextKey context_key = cache_identity.context_key(
        object_key_builder.compiler_fingerprint(options.compiler_build),
        object_key_builder.language_version_fingerprint(options.compiler_version),
        object_key_builder.target_fingerprint(target_cache_key.bytes()),
        object_key_builder.toolchain_fingerprint(toolchain_version.bytes()),
        object_key_builder.backend_profile_fingerprint(options.mode),
        import_context.fingerprint_for_source_path(root_path)
    );
    UInt8[]^ context_root = artifact_path.context_cache_root(
        options.artifact_cache_dir,
        context_key
    );
    std.String artifact_cache_dir = std.String.from_valid_utf8(context_root[..]);
    UInt8[]^ package_source_base =
        cache_identity.absolute_path(std.path.dirname(root_path));
    system_fs.FileLock build_lock! = system_fs.FileLock();
    if (options.emit == .executable) {
        qkey.Fingerprint128 target_identity =
            cache_identity.build_target_identity(options.input_path);
        qkey.Fingerprint128 invocation = cache_identity.build_invocation_fingerprint(
            options.output_path,
            options.linker_path,
            options.link_args$.ref()
        );
        database.BuildTargetKey target_key = database.BuildTargetKey(
            target_identity,
            context_key.fingerprint,
            invocation
        );
        if (database.build_target_is_no_op(
            ctx.query$.ref(),
            target_key,
            artifact_cache_dir.bytes(),
            package_source_base[..],
            options.output_path
        )) {
            ctx.store.object_artifacts.record_no_op_hit();
            if (options.artifact_stats) {
                print_artifact_stats(ctx);
            }
            return;
        }
        UInt8[]^ lock_dir = artifact_path.lock_dir(artifact_cache_dir.bytes());
        if (!system_fs.create_dirs(lock_dir[..])) {
            diagnostic_helper.add_package_error(
                ctx.store.diagnostics$.mut_ref(),
                "failed to create artifact lock directory",
                "artifact_lock_directory_failed"
            );
            return;
        }
        UInt8[]^ lock_path = artifact_path.target_build_lock_path(
            artifact_cache_dir.bytes(),
            target_identity
        );
        guard system_fs.acquire_file_lock(lock_path[..]) is .some(held_lock) else {
            diagnostic_helper.add_package_error(
                ctx.store.diagnostics$.mut_ref(),
                "failed to acquire target build lock",
                "target_build_lock_failed"
            );
            return;
        }
        build_lock = held_lock;
        if (database.build_target_is_no_op(
            ctx.query$.ref(),
            target_key,
            artifact_cache_dir.bytes(),
            package_source_base[..],
            options.output_path
        )) {
            ctx.store.object_artifacts.record_no_op_hit();
            if (options.artifact_stats) {
                print_artifact_stats(ctx);
            }
            return;
        }
    }
    lang.PrepareResult lang_registry! = lang.prepare_for_root(
        ctx,
        root_path,
        options,
        artifact_cache_dir.bytes()
    );
    if (!lang_registry.ok()) {
        return;
    }
    ctx.store.artifacts.record_source_parse();
    syntax.SyntaxResult syntax_result! = syntax.parse_source_with_lang(
        ctx,
        source_text,
        source_id,
        lang_registry.registry_mut_ref()
    );
    if (syntax_result.has_errors()) {
        return;
    }
    stage_started = print_jil_stage_if_enabled(options, "parse_done", stage_started);
    // release 仍需完整 package body；debug 只有在 `.jbuild` 覆盖对应
    // source/monomorph object 时才允许 clean source 保持 interface-only。
    Bool debug_incremental = options.emit == .executable && options.mode == .debug;
    Bool use_source_artifacts = options.emit == .check_only || debug_incremental;
    resolve.ModuleResolver resolver! = resolve.ModuleResolver(
        artifact_cache_dir.bytes(),
        compiler_version_hash,
        use_source_artifacts,
        options.mode,
        options.jil_stats
    );
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx, syntax_result.take_unit());
    if (!graph.ok) {
        return;
    }
    if (debug_incremental) {
        database.require_debug_source_products(
            ctx.query$.ref(),
            ctx.store.source_dependencies$.mut_ref(),
            artifact_cache_dir.bytes(),
            cache_identity.build_target_identity(options.input_path),
            context_key.fingerprint
        );
    }
    stage_started = print_jil_stage_if_enabled(options, "graph_done", stage_started);
    lang.PrepareResult graph_lang_registry! = lang.prepare_for_package(
        ctx,
        graph.package_id,
        options,
        artifact_cache_dir.bytes()
    );
    if (!graph_lang_registry.ok()) {
        return;
    }
    if (!resolver.lower_module_graph_to_model(ctx, graph$.ref())) {
        return;
    }
    if (options.jil_stats) {
        print_model_timing(resolver.model_timing());
    }
    stage_started = print_jil_stage_if_enabled(options, "model_done", stage_started);
    // declaration fingerprint 只读取已固化 Semantic Model。先发布后检查，
    // trait 等稳定查询才能在真实读取点记录 declaration 级依赖。
    if (use_source_artifacts) {
        resolver.fingerprint_module_graph_model(ctx, graph$.ref());
    }
    if (!type_check.check_model_package(ctx, graph$.ref())) {
        return;
    }
    stage_started = print_jil_stage_if_enabled(options, "type_check_done", stage_started);
    // release 和普通 object 输出不会从 source `.ji` 恢复语义，也不使用细粒度
    // interface fingerprint；避免为不会被读取的 interface 增加全包构造开销。
    if (use_source_artifacts) {
        resolver.finalize_module_graph_model(ctx, graph$.ref());
    }
    stage_started = print_jil_stage_if_enabled(options, "front_end_done", stage_started);
    jil.Store^ lowered! = jil_pipeline.lower_package(
        ctx,
        graph$.ref(),
        options.verify_jil
    );
    stage_started = print_jil_stage_if_enabled(options, "lower_done", stage_started);
    if (lowered.program.has_errors()) {
        return;
    }
    if (!borrow_check.run_package(ctx, lowered$.ref(), options.jil_stats)) {
        return;
    }
    stage_started = print_jil_stage_if_enabled(options, "borrow_done", stage_started);
    jil_pipeline.elaborate_drops(
        ctx,
        graph$.ref(),
        lowered$.mut_ref(),
        options.verify_jil
    );
    if (lowered.program.has_errors()) {
        return;
    }
    jil_pipeline.optimize_for_backend(
        ctx,
        lowered$.mut_ref(),
        options.verify_jil
    );
    if (lowered.program.has_errors()) {
        return;
    }
    if (options.jil_stats) {
        stage_started = print_jil_stage("drop_done", stage_started);
        print_jil_stats(lowered$.ref());
    }
    Bool backend_failed = backend.emit_package(
        ctx,
        lowered$.ref(),
        options,
        artifact_cache_dir.bytes(),
        context_key.fingerprint,
        package_source_base[..]
    ).has_errors();
    if (backend_failed) {
        if (options.artifact_stats) {
            print_artifact_stats(ctx);
        }
        return;
    }
    if (use_source_artifacts) {
        database.publish_declaration_observations(
            ctx.query$.ref(),
            ctx.store.artifacts$.mut_ref()
        );
        source_ji.write_package_source_artifact_cache(
            ctx,
            graph$.ref(),
            artifact_cache_dir.bytes(),
            options.compiler_version
        );
    }
    stage_started = print_jil_stage_if_enabled(options, "backend_done", stage_started);
    stage_started = print_jil_stage_if_enabled(options, "artifact_done", stage_started);
    if (options.artifact_stats) {
        print_artifact_stats(ctx);
    }
}

system_target.BuildOutputKind build_output_kind(driver_options.EmitKind emit) {
    if (emit == .check_only) { return .check_only; }
    if (emit == .llvm_ir) { return .llvm_ir; }
    if (emit == .object_file) { return .object_file; }
    if (emit == .dynamic_library) { return .dynamic_library; }
    return .executable;
}

Void print_model_timing(resolve.ModelTiming timing) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("model_prepare_ms=");
    builder.append(timing.prepare_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_freshness_ms=");
    builder.append(timing.freshness_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_bindings_ms=");
    builder.append(timing.bindings_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_skeletons_ms=");
    builder.append(timing.skeletons_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_declarations_ms=");
    builder.append(timing.declarations_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_facts_ms=");
    builder.append(timing.facts_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_bodies_ms=");
    builder.append(timing.bodies_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_store_ms=");
    builder.append(timing.store_ns / UInt64(1000000));
    builder.append_valid_utf8(" model_finalize_ms=");
    builder.append(timing.finalize_ns / UInt64(1000000));
    system_fs.File error_output! = system_io.stderr();
    error_output.write_all(builder.slice());
    error_output.write_all("\n");
}

UInt64 print_jil_stage_if_enabled(
    driver_options.CompileOptions& options,
    UInt8[]& name,
    UInt64 started
) {
    if (options.jil_stats) { return print_jil_stage(name, started); }
    return started;
}

UInt64 print_jil_stage(UInt8[]& name, UInt64 started) {
    UInt64 finished = system_time.monotonic_time_ns();
    UInt64 elapsed_ms! = UInt64(0);
    if (finished >= started) {
        elapsed_ms = (finished - started) / UInt64(1000000);
    }
    system_fs.File error_output! = system_io.stderr();
    error_output.write_all("jil_stage=");
    error_output.write_all(name);
    error_output.write_all(" elapsed_ms=");
    std.StringBuilder elapsed! = std.StringBuilder();
    elapsed.append(elapsed_ms);
    error_output.write_all(elapsed.slice());
    error_output.write_all("\n");
    return finished;
}

Void print_jil_stats(jil.Store& store) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("jil_source_functions=");
    builder.append(store.program.source_function_count());
    builder.append_valid_utf8(" jil_functions=");
    builder.append(store.program.functions.len());
    builder.append_valid_utf8(" jil_arena_used_bytes=");
    builder.append(store.storage.arena.used_bytes());
    builder.append_valid_utf8(" jil_arena_reserved_bytes=");
    builder.append(store.storage.arena.reserved_bytes());
    system_fs.File error_output! = system_io.stderr();
    error_output.write_all(builder.slice());
    error_output.write_all("\n");
}

Void print_artifact_stats(context.CompilerContext& ctx) {
    Int signature_l2_restores = ctx.query.def_signature_l2_restores();
    Int body_l2_restores = ctx.query.def_body_l2_restores();
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("artifact_interface_hit=");
    builder.append(ctx.store.artifacts.stats.interface_hit);
    builder.append_valid_utf8(" artifact_interface_miss=");
    builder.append(ctx.store.artifacts.stats.interface_missing);
    builder.append_valid_utf8(" artifact_interface_stale=");
    builder.append(ctx.store.artifacts.stats.interface_stale);
    builder.append_valid_utf8(" artifact_section_reads=");
    builder.append(ctx.store.artifacts.stats.section_reads);
    builder.append_valid_utf8(" artifact_section_mb=");
    builder.append(ctx.store.artifacts.stats.section_bytes / (1024 * 1024));
    builder.append_valid_utf8(" artifact_section_read_ms=");
    builder.append(ctx.store.artifacts.stats.section_read_ns / UInt64(1000000));
    builder.append_valid_utf8(" artifact_section_decode_ms=");
    builder.append(ctx.store.artifacts.stats.section_decode_ns / UInt64(1000000));
    builder.append_valid_utf8(" artifact_interface_read_ms=");
    builder.append(ctx.store.artifacts.stats.interface_read_ns / UInt64(1000000));
    builder.append_valid_utf8(" artifact_interface_decode_ms=");
    builder.append(ctx.store.artifacts.stats.interface_decode_ns / UInt64(1000000));
    builder.append_valid_utf8(" artifact_parsed_sources=");
    builder.append(ctx.store.artifacts.stats.parsed_sources);
    builder.append_valid_utf8(" artifact_source_dirty=");
    builder.append(ctx.store.source_dependencies.source_dirty_count());
    builder.append_valid_utf8(" artifact_dependency_candidates=");
    builder.append(ctx.store.source_dependencies.marked_dependency_candidate_count());
    builder.append_valid_utf8(" artifact_object_hit=");
    builder.append(ctx.store.object_artifacts.stats.hit_count());
    builder.append_valid_utf8(" artifact_object_miss=");
    builder.append(ctx.store.object_artifacts.stats.missing_count());
    builder.append_valid_utf8(" artifact_object_stale=");
    builder.append(ctx.store.object_artifacts.stats.stale_count());
    builder.append_valid_utf8(" artifact_emitted_units=");
    builder.append(ctx.store.object_artifacts.stats.emitted_units);
    builder.append_valid_utf8(" artifact_reused_units=");
    builder.append(ctx.store.object_artifacts.stats.reused_units);
    builder.append_valid_utf8(" artifact_linked_objects=");
    builder.append(ctx.store.object_artifacts.stats.linked_objects);
    builder.append_valid_utf8(" artifact_no_op_hits=");
    builder.append(ctx.store.object_artifacts.stats.no_op_hits);
    builder.append_valid_utf8(" query_def_signature_l2=");
    builder.append(signature_l2_restores);
    builder.append_valid_utf8(" query_def_body_l2=");
    builder.append(body_l2_restores);
    system_fs.File error_output! = system_io.stderr();
    error_output.write_all(builder.slice());
    error_output.write_all("\n");
}

// source interface 的版本 hash 统一委托给 artifact 层，pipeline 不定义格式。
UInt64 source_artifact_version_hash(UInt8[]& compiler_version) {
    return source_ji.artifact_version_hash(compiler_version);
}
