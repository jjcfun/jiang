#doc(module)
    各阶段共用的诊断构造和关联位置追加，不保存编译阶段状态。
#end

alias diagnostic = import "../diagnostic.jiang";
alias string = import "../support/string.jiang";
import std;

#doc 只为本次调用中新产生的指定诊断附加上下文；已缓存失败不会重复追加关联位置。
public Void add_related_since(
    diagnostic.DiagnosticStore&! store, Int begin, UInt8[]& code,
    diagnostic.SourceRange range, UInt8[]& message
) {
    Int index! = begin;
    while (index < store.len()) {
        diagnostic.Diagnostic&! item = store.items.mut_ref_at(index);
        index = index + 1;
        if (!string.equal(item.code.text, code)) { continue; }
        Bool repeated! = false;
        if (!item.related.empty()) {
            diagnostic.DiagnosticRelatedInformation& last = item.related.ref_at(item.related.len() - 1);
            repeated = last.range.source_id == range.source_id
                && last.range.span.start == range.span.start && last.range.span.end() == range.span.end()
                && string.equal(last.message.bytes(), message);
        }
        if (!repeated) {
            item.add_related(diagnostic.DiagnosticRelatedInformation(range, message));
        }
    }
}

public Void add_package_error(diagnostic.DiagnosticStore&! store, UInt8[]& message, UInt8[]& code) {
    store.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

public Void add_package_error(diagnostic.DiagnosticStore&! store, std.String message, UInt8[]& code) {
    store.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message.bytes()
        )
    );
}

public Void add_warning(
    diagnostic.DiagnosticStore&! store,
    diagnostic.SourceRange range,
    UInt8[]& message,
    UInt8[]& code
) {
    store.add(
        diagnostic.Diagnostic(
            .warning,
            .package,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}
