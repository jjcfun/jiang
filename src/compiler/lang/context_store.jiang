#doc(module)
    一轮编译持有的语言对象；按实际语言身份复用，并在释放上下文后关闭动态库。
#end

import std;
alias qid = import "../id.jiang";
alias dylib = import "../system/dylib.jiang";
alias list = import "../support/list.jiang";

struct Entry: Movable {
    // 字段逆序析构：必须先销毁语言对象，再关闭其动态库。
    dylib.Library library;
    qid.SymbolId key;
    std.jiang.syntax.Language.Any^ language;

    init(self, qid.SymbolId key, std.jiang.syntax.Language.Any^ language, Void* library) {
        self.library = dylib.Library(library);
        self.key = key;
        self.language = language;
    }
}

public struct ContextStore: Movable {
    list.ArrayList<Entry> entries!;

    public init(self) { self.entries = list.ArrayList<Entry>(); }

    public Int len(self) { return self.entries.len(); }

    public Int? find(self, qid.SymbolId key) {
        Int index! = 0;
        while (index < self.entries.len()) {
            if (self.entries.ref_at(index).key == key) { return index; }
            index = index + 1;
        }
        return null;
    }

    public Int add(Self&! self, qid.SymbolId key, std.jiang.syntax.Language.Any^ language, Void* library = null) {
        Int index = self.entries.len();
        self.entries.add(Entry(key, language, library));
        return index;
    }

    @life(return: self)
    public std.jiang.syntax.Language.Any& ref_at(self, Int index) {
        _ entry = self.entries.ref_at(index);
        return entry.language$.ref();
    }
}
