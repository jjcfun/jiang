#doc(module)
    从当前包直接依赖构建 Provider 注册表，应用 Provider 扩展名及本包覆盖，并校验有效映射冲突。
#end

alias backend = import "../backend.jiang";
alias context = import "../context.jiang";
alias package_artifact = import "../artifact/package_artifact.jiang";
alias package_fingerprint = import "../artifact/package_fingerprint.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias driver_options = import "../driver/options.jiang";
alias package_load = import "../source/package_load.jiang";
alias value = import "../sema/comptime/value.jiang";
alias qid = import "../id.jiang";
alias hash = import "../support/hash.jiang";
alias system_target = import "../system/target.jiang";
alias abi = import "./abi.jiang";
alias registry = import "./registry.jiang";
alias store = import "../resolve/store.jiang";
import std;

public struct BuildResult: Movable {
    // 本次发现的所有自定义语法 provider。
    public registry.Registry registry!;

    // 包信息或 provider 校验产生错误时为 false。
    public Bool ok!;

    public init(self, registry.Registry registry, Bool ok) {
        self.registry = registry;
        self.ok = ok;
    }
}

public BuildResult build_for_source_path(
    context.CompilerContext&! ctx,
    UInt8[]& source_path,
    UInt8[]& artifact_cache_dir,
    UInt64 compiler_version_hash,
    driver_options.CompileMode mode
) {
    if (package_load.registered_for_path(ctx, source_path) is .some(package)) {
        if (ctx.store.resolve.package_ref(package).configuration_info == null) { return empty_result(); }
        return build_for_registered(ctx, package, artifact_cache_dir, compiler_version_hash, mode);
    }
    return empty_result();
}

BuildResult empty_result() {
    return BuildResult(registry.Registry(), true);
}

UInt8[]^ provider_artifact_path(context.CompilerContext&! ctx, UInt8[]& artifact_cache_dir,
    UInt64 package_hash, UInt64 compiler_version_hash, driver_options.CompileMode mode) {
    // provider dylib cache key 同时包含 provider package 指纹、编译器版本、
    // wrapper ABI 版本、目标平台和编译模式。
    system_target.TargetInfo host = system_target.host_target();
    String target_key = system_target.cache_key(host$.ref());
    hash.WyHasher compiler! = hash.WyHasher();
    compiler.write(compiler_version_hash);
    compiler.write(ctx.lang_compiler_build.bytes());
    compiler.write(ctx.lang_linker_path.bytes());
    std.String toolchain = backend.llvm_version_text();
    compiler.write(toolchain.bytes());
    package_artifact.PackageArtifactKey key! = package_artifact.PackageArtifactKey(
        .lang_provider_dynamic_library,
        package_hash,
        compiler.finish(),
        UInt64(abi.wrapper_version()),
        target_key.bytes(),
        mode
    );
    return package_artifact.artifact_path_for(
        if (ctx.build_lang_dylibs) { ctx.lang_cache_dir.bytes() } else { artifact_cache_dir },
        key$.ref(),
        dynamic_library_extension()
    );
}

@life()
UInt8[]& dynamic_library_extension() {
    system_target.TargetInfo host = system_target.host_target();
    if (host.os == .linux) {
        return ".so";
    }
    if (host.os == .windows) {
        return ".dll";
    }
    return ".dylib";
}

public Bool dependency_is_lang(context.CompilerContext&! ctx, qid.PackageId package_id, qid.SymbolId alias_symbol) {
    // 给语法/resolve 调用方判断某个依赖别名是否代表 lang provider。
    guard ctx.store.resolve.package_dependency(package_id, alias_symbol) is .some(dependency) else {
        return false;
    }
    return dependency_record_is_lang(ctx, dependency);
}

public Bool dependency_exists(context.CompilerContext&! ctx, qid.PackageId package_id, qid.SymbolId alias_symbol) {
    return ctx.store.resolve.package_dependency(package_id, alias_symbol) != null;
}

Bool dependency_record_is_lang(context.CompilerContext&! ctx, store.PackageDependencyRecord dependency) {
    guard ctx.store.resolve.package_for_dir(dependency.path_symbol) is .some(package) else { return false; }
    return ctx.store.resolve.package_ref(package).kind == .lang;
}

Void add_registry_error(context.CompilerContext&! ctx, UInt8[]& message, UInt8[]& code) {
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(), message, code);
}

#doc 从已求值配置合并直接依赖和语言别名；Provider 构建仍复用现有动态库缓存。
BuildResult build_for_registered(context.CompilerContext&! ctx, qid.PackageId package,
    UInt8[]& cache, UInt64 version, driver_options.CompileMode mode) {
    registry.Registry providers! = registry.Registry();
    _ definition = ctx.store.resolve.package_ref(package).configuration_info$.some();
    _ info = ctx.store.comptime_store.const_value(definition)$.some();
    _ languages = package_load.field(ctx, info, "lang")$.some();
    guard languages.data is .array_value(mappings) else { return BuildResult(providers, false); }
    Int index! = 0;
    while (index < ctx.store.resolve.package_ref(package).dependencies.len()) {
        _ dependency = ctx.store.resolve.package_ref(package).dependencies.get(index);
        _ target = ctx.store.resolve.package_for_dir(dependency.path_symbol)$.some();
        Bool mapped! = false;
        Int mapping_index! = 0;
        while (mapping_index < ctx.store.comptime_store.item_count(mappings)) {
            _ mapping = ctx.store.comptime_store.item_at(mappings, mapping_index);
            mapping_index = mapping_index + 1;
            _ name = package_load.string_field(ctx, mapping, "name")$.some();
            _ source = package_load.string_field(ctx, mapping, "package")$.some();
            if (ctx.store.symbols.text(name).length == 0) { continue; }
            _ alias_symbol = if ctx.store.symbols.text(source).length > 0 { source } else { name };
            if (alias_symbol != dependency.alias_symbol) { continue; }
            mapped = true;
            if (!add_registered(ctx, providers$.mut_ref(), target, name, mapping, cache, version, mode)) {
                return BuildResult(providers, false);
            }
        }
        if (!mapped && !add_registered(ctx, providers$.mut_ref(), target, dependency.alias_symbol,
            null, cache, version, mode)) { return BuildResult(providers, false); }
        index = index + 1;
    }
    if (!providers.extensions_unique()) {
        add_registry_error(ctx, "conflicting lang source extensions", "lang_extension_conflict");
        return BuildResult(providers, false);
    }
    return BuildResult(providers, true);
}

Bool add_registered(context.CompilerContext&! ctx, registry.Registry&! providers,
    qid.PackageId package, qid.SymbolId name, value.ComptimeValue? mapping,
    UInt8[]& cache, UInt64 version, driver_options.CompileMode mode) {
    if (ctx.store.resolve.package_ref(package).kind != .lang) {
        providers.add_non_lang_dependency(ctx.store.symbols.text(name));
        return true;
    }
    if (providers.find(ctx.store.symbols.text(name)) != null) {
        add_registry_error(ctx, "conflicting lang aliases", "lang_alias_conflict");
        return false;
    }
    _ root = ctx.store.resolve.package_ref(package).root_path;
    std.String dylib! = "";
    if (!ctx.store.lang_build_active(ctx.store.symbols.text(root))) {
        Int errors = ctx.store.diagnostics.error_count;
        UInt64 package_hash = package_fingerprint.from_registered(ctx, package);
        if (ctx.store.diagnostics.error_count != errors) { return false; }
        UInt8[]^ path = provider_artifact_path(ctx, cache, package_hash, version, mode);
        dylib = std.String.from_valid_utf8(path[..]);
    }
    _ path = ctx.store.symbols.intern(dylib.bytes());
    ctx.store.resolve.package_mut_ref(package).set_lang_info(
        store.LangPackageInfo(path, root, abi.wrapper_version(), true));
    providers.add(ctx.store.symbols.text(name), package);
    registry.LangDependency&! provider = providers.find_mut_ref(ctx.store.symbols.text(name))$.some();
    if (mapping is .some(override_mapping) && append_extensions(ctx, provider, override_mapping)) { return true; }
    _ definition = ctx.store.resolve.package_ref(package).configuration_info$.some();
    _ info = ctx.store.comptime_store.const_value(definition)$.some();
    _ languages = package_load.field(ctx, info, "lang")$.some();
    guard languages.data is .array_value(mappings) else { return false; }
    Int index! = 0;
    while (index < ctx.store.comptime_store.item_count(mappings)) {
        _ own = ctx.store.comptime_store.item_at(mappings, index);
        _ own_name = package_load.string_field(ctx, own, "name")$.some();
        if (ctx.store.symbols.text(own_name).length == 0) {
            append_extensions(ctx, provider, own);
            break;
        }
        index = index + 1;
    }
    return true;
}

Bool append_extensions(context.CompilerContext& ctx, registry.LangDependency&! provider, value.ComptimeValue mapping) {
    _ extensions = package_load.field(ctx, mapping, "extensions")$.some();
    guard extensions.data is .array_value(items) else { return false; }
    if (ctx.store.comptime_store.item_count(items) == 0) { return false; }
    provider.extensions.clear();
    Int index! = 0;
    while (index < ctx.store.comptime_store.item_count(items)) {
        _ item = ctx.store.comptime_store.item_at(items, index);
        guard item.data is .string_value(text) else { return false; }
        provider.extensions.add(std.String.from_valid_utf8(ctx.store.symbols.text(text)));
        index = index + 1;
    }
    return true;
}
