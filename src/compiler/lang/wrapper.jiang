#doc(module)
    在 Provider root 的私有编译会话内附加 ABI 工厂，保留原文件路径、包身份和普通可见性。
#end

alias context = import "../context.jiang";
alias diagnostic = import "../diagnostic.jiang";
alias entry = import "./entry.jiang";
alias string = import "../support/string.jiang";
alias map = import "../support/map.jiang";
alias source_store = import "../source/store.jiang";
alias source = import "../source.jiang";
alias syntax = import "../syntax.jiang";
alias ast = import "../syntax/ast.jiang";
import std;

#doc 在原始 root 解析完成后追加 Jiang 工厂；DSL 不解析生成的后缀，工厂保留 root 私有可见性。
public Bool append_factory(context.CompilerContext&! ctx, ast.AstUnit&! unit) {
    guard entry.find(ctx, unit) is .some(name) else { return false; }
    std.String path = std.String.from_valid_utf8(ctx.store.sources.entry(unit.source_id).name());
    Int start = ctx.store.sources.get(unit.source_id).text.length;
    std.String std_alias = fresh_identifier(ctx, "___jiang_lang_std");
    std.String factory_name = fresh_identifier(ctx, "___jiang_lang_provider_create");
    std.String constructor_name = fresh_identifier(ctx, "___jiang_lang_block_create");
    std.String entry_name = fresh_identifier(ctx, "___jiang_lang_entry_type");
    std.StringBuilder generated! = std.StringBuilder();
    generated.append_valid_utf8(ctx.store.sources.get(unit.source_id).text$.ref());
    generated.append("\nalias ");
    generated.append_valid_utf8(std_alias.bytes());
    generated.append(" = import std;\n@life()\n");
    generated.append_valid_utf8(entry_name.bytes());
    generated.append(" ");
    generated.append_valid_utf8(constructor_name.bytes());
    generated.append("() { return ");
    generated.append_valid_utf8(entry_name.bytes());
    generated.append("(); }\n@life()\n@link_symbol(\"jiang_lang_provider_create\")\npublic ");
    generated.append_valid_utf8(std_alias.bytes());
    generated.append(".jiang.syntax.Language.Any^ ");
    generated.append_valid_utf8(factory_name.bytes());
    generated.append("(");
    generated.append_valid_utf8(std_alias.bytes());
    generated.append(".jiang.syntax.Session& session) {\n    return ");
    generated.append_valid_utf8(std_alias.bytes());
    generated.append(".jiang.syntax.Language$.new(");
    generated.append_valid_utf8(std_alias.bytes());
    generated.append(".jiang.syntax.LanguageAdapter<");
    generated.append_valid_utf8(entry_name.bytes());
    generated.append(", ");
    generated.append_valid_utf8(entry_name.bytes());
    generated.append(".LangContext>(");
    generated.append_valid_utf8(entry_name.bytes());
    generated.append(".create_context(session), ");
    generated.append_valid_utf8(constructor_name.bytes());
    generated.append("));\n}\n");
    ctx.store.sources.set_overlay(path.bytes(), generated.slice());
    Int first_node = unit.nodes.len();
    if (!syntax.append_native_declarations(ctx, unit, generated.slice(), start)) { return false; }
    _ placeholder = ctx.store.symbols.intern(entry_name.bytes());
    // 构造目标直接绑定解析出的入口符号，不要求 Lang 产生的名字能重新打印为 Jiang token。
    Int index! = first_node;
    while (index < unit.nodes.len()) {
        ast.AstNode node = unit.nodes.get(index);
        if (node.data is .name(identifier) && identifier.symbol_id == placeholder) {
            unit.nodes.set(index, ast.AstNode(span = node.span, data = .name(ast.NameData(symbol_id = name))));
        }
        index = index + 1;
    }
    return true;
}

std.String fresh_identifier(context.CompilerContext& ctx, UInt8[]& prefix) {
    Int suffix! = 0;
    while (true) {
        std.StringBuilder candidate! = std.StringBuilder();
        candidate.append_valid_utf8(prefix);
        if (suffix != 0) { candidate.append("_"); candidate.append(suffix); }
        if (ctx.store.symbols.find(candidate.slice()) == null) { return candidate.into_string(); }
        suffix = suffix + 1;
    }
    return "";
}

#doc 复制子会话诊断并重映射所有来源；消息、标签、修复和顺序保持不变。
public Void add_build_diagnostics(context.CompilerContext&! ctx, context.CompilerContext&! provider_ctx) {
    map.WyHashMap<source.SourceId, source.SourceId> sources! = map.WyHashMap<source.SourceId, source.SourceId>();
    Int index! = 0;
    while (index < provider_ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic copied = copy_diagnostic(ctx, provider_ctx.store.sources$.mut_ref(),
            sources$.mut_ref(), provider_ctx.store.diagnostics.get(index));
        ctx.store.diagnostics.add(copied);
        index = index + 1;
    }
}

@life(return: ctx)
diagnostic.Diagnostic copy_diagnostic(
    context.CompilerContext&! ctx,
    source_store.SourceStore&! original,
    map.WyHashMap<source.SourceId, source.SourceId>&! sources,
    diagnostic.Diagnostic& item
) {
    // code 与旧 source_name 是借用文本，必须迁入调用方持有的字符串存储。
    _ code = ctx.store.symbols.intern(item.code.text);
    _ name = ctx.store.symbols.intern(item.source_name);
    diagnostic.DiagnosticCode copied_code = if (item.code.kind == .numeric) {
        diagnostic.DiagnosticCode(number = item.code.number)
    } else { diagnostic.DiagnosticCode(ctx.store.symbols.text(code)) };
    diagnostic.Diagnostic copied! = diagnostic.Diagnostic(item.severity, item.category, copied_code,
        remap_range(ctx.store.sources$.mut_ref(), original, sources, item.range), item.message.bytes(),
        ctx.store.symbols.text(name));
    Int index! = 0;
    while (index < item.labels.len()) {
        diagnostic.DiagnosticLabel& label = item.labels.ref_at(index);
        copied.add_label(diagnostic.DiagnosticLabel(label.style,
            remap_range(ctx.store.sources$.mut_ref(), original, sources, label.range), label.message.bytes()));
        index = index + 1;
    }
    index = 0;
    while (index < item.related.len()) {
        diagnostic.DiagnosticRelatedInformation& related = item.related.ref_at(index);
        copied.add_related(diagnostic.DiagnosticRelatedInformation(
            remap_range(ctx.store.sources$.mut_ref(), original, sources, related.range), related.message.bytes()));
        index = index + 1;
    }
    index = 0;
    while (index < item.tags.len()) {
        copied.add_tag(item.tags.get(index));
        index = index + 1;
    }
    index = 0;
    while (index < item.fixes.len()) {
        copied.add_fix(copy_fix(ctx.store.sources$.mut_ref(), original, sources, item.fixes.ref_at(index)));
        index = index + 1;
    }
    return copied;
}

diagnostic.DiagnosticFix copy_fix(
    source_store.SourceStore&! target,
    source_store.SourceStore&! original,
    map.WyHashMap<source.SourceId, source.SourceId>&! sources,
    diagnostic.DiagnosticFix& fix
) {
    diagnostic.DiagnosticFix copied! = diagnostic.DiagnosticFix(fix.title.bytes(), fix.applicability);
    Int index! = 0;
    while (index < fix.edits.len()) {
        diagnostic.TextEdit& edit = fix.edits.ref_at(index);
        copied.add_edit(diagnostic.TextEdit(edit.kind, remap_range(target, original, sources, edit.range),
            edit.replacement.bytes()));
        index = index + 1;
    }
    return copied;
}

diagnostic.SourceRange remap_range(
    source_store.SourceStore&! target,
    source_store.SourceStore&! original,
    map.WyHashMap<source.SourceId, source.SourceId>&! sources,
    diagnostic.SourceRange range
) {
    guard range.source_id is .some(id) else { return range; }
    if (sources.get(id) is .some(mapped)) {
        return diagnostic.SourceRange(mapped$.get(), range.span, range.start, range.end);
    }
    source.SourceId mapped = target.import_snapshot(original, id);
    sources.set(id, mapped);
    return diagnostic.SourceRange(mapped, range.span, range.start, range.end);
}
