#doc(module)
    按包内依赖别名注册 Lang Provider 和独立源文件扩展名；映射与动态库句柄均由本次注册表持有。
#end

alias dylib = import "../system/dylib.jiang";
alias list = import "../support/list.jiang";
alias qid = import "../id.jiang";
alias string = import "../support/string.jiang";
import std;

public struct LangDependency: Movable {
    public std.String dependency_name;

    public qid.PackageId package_id;

    public list.ArrayList<std.String> extensions!;

    // Opaque dynamic library handle returned by the platform loader.
    public Void* dylib_handle!;

    // Opaque address of the fixed wrapper constructor symbol.
    public Void* create_pointer!;

    public init(self, UInt8[]& dependency_name, qid.PackageId package_id) {
        self.dependency_name = std.String.from_valid_utf8(dependency_name);
        self.package_id = package_id;
        self.extensions = list.ArrayList<std.String>();
        self.extensions.add(std.String.from_valid_utf8(dependency_name));
        self.dylib_handle = null;
        self.create_pointer = null;
    }

    public Bool loaded(self) {
        return self.dylib_handle != null && self.create_pointer != null;
    }

    public Void close(Self&! self) {
        if (self.dylib_handle != null) {
            dylib.close_handle(self.dylib_handle);
        }
        self.dylib_handle = null;
        self.create_pointer = null;
    }

    deinit(self) {
        self.close();
    }
}

public struct Registry: Movable {
    list.ArrayList<LangDependency> providers!;

    list.ArrayList<std.String> non_lang_dependencies!;

    public init(self) {
        self.providers = list.ArrayList<LangDependency>();
        self.non_lang_dependencies = list.ArrayList<std.String>();
    }

    public Int len(self) {
        return self.providers.len();
    }

    public Bool empty(self) {
        return self.providers.empty();
    }

    public Void add(Self&! self, UInt8[]& dependency_name, qid.PackageId package_id) {
        self.providers.add(LangDependency(dependency_name, package_id));
    }

    public Void add_non_lang_dependency(Self&! self, UInt8[]& dependency_name) {
        self.non_lang_dependencies.add(std.String.from_valid_utf8(dependency_name));
    }

    public Bool has_dependency(self, UInt8[]& dependency_name) {
        return self.find(dependency_name) != null || self.has_non_lang_dependency(dependency_name);
    }

    public Bool has_non_lang_dependency(self, UInt8[]& dependency_name) {
        Int index! = 0;
        while (index < self.non_lang_dependencies.len()) {
            if (string.equal(self.non_lang_dependencies.ref_at(index).bytes(), dependency_name)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public LangDependency&? find_ref(self, UInt8[]& dependency_name) {
        Int index! = 0;
        while (index < self.providers.len()) {
            LangDependency& provider = self.providers.ref_at(index);
            if (string.equal(provider.dependency_name.bytes(), dependency_name)) {
                return provider;
            }
            index = index + 1;
        }
        return null;
    }

    public LangDependency&!? find_mut_ref(Self&! self, UInt8[]& dependency_name) {
        Int index! = 0;
        while (index < self.providers.len()) {
            LangDependency&! provider = self.providers.mut_ref_at(index);
            if (string.equal(provider.dependency_name.bytes(), dependency_name)) {
                return provider;
            }
            index = index + 1;
        }
        return null;
    }

    public qid.PackageId? find(self, UInt8[]& dependency_name) {
        guard self.find_ref(dependency_name) is .some(provider) else {
            return null;
        }
        return provider.package_id;
    }

    #doc 查找扩展名对应的直接依赖；注册表构建阶段负责拒绝冲突。
    public LangDependency&? for_extension(self, UInt8[]& extension) {
        Int index! = 0;
        while (index < self.providers.len()) {
            LangDependency& provider = self.providers.ref_at(index);
            Int part! = 0;
            while (part < provider.extensions.len()) {
                if (string.equal(provider.extensions.ref_at(part).bytes(), extension)) { return provider; }
                part = part + 1;
            }
            index = index + 1;
        }
        return null;
    }

    #doc 不允许扩展名被多个 Provider 接管，原生 jiang 扩展名也不可覆盖。
    public Bool extensions_unique(self) {
        Int index! = 0;
        while (index < self.providers.len()) {
            LangDependency& provider = self.providers.ref_at(index);
            Int part! = 0;
            while (part < provider.extensions.len()) {
                UInt8[]& extension = provider.extensions.ref_at(part).bytes();
                if (string.equal(extension, "jiang")) { return false; }
                guard self.for_extension(extension) is .some(owner) else { return false; }
                if (!string.equal(owner.dependency_name.bytes(), provider.dependency_name.bytes())) { return false; }
                part = part + 1;
            }
            index = index + 1;
        }
        return true;
    }

    public LangDependency& ref_at(self, Int index) {
        return self.providers.ref_at(index);
    }

}
