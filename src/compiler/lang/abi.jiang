#doc(module)
    Lang 动态库的私有版本与固定构造入口；版本同时约束 Provider 调用及 Parser factory 操作。
    Provider 作者实现标准语法接口，不接触这些符号或操作编号。
#end

public UInt32 wrapper_version() {
    return 29;
}

@life()
public UInt8[]& create_symbol() {
    return "jiang_lang_provider_create";
}

@life()
public UInt8[]& macos_export_link_arg() {
    // Mach-O 的 linker 名称包含 C ABI 前导下划线；provider 只公开固定构造入口。
    return "-Wl,-exported_symbol,_jiang_lang_provider_create";
}

@life()
public UInt8[]& linux_bind_local_link_arg() {
    // ELF provider 的内部引用必须绑定到本产物，不能被先加载的旧版本抢占。
    return "-Wl,-Bsymbolic";
}
