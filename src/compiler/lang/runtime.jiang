#doc(module)
    Lang Provider 的扫描与解析调用边界；每个 invocation 保留实际 Provider 包身份。
    Parser 只构造声明，模块加载与类型检查由后续编译阶段推进。
#end

alias ast = import "../syntax/ast.jiang";
alias abi = import "./abi.jiang";
alias block = import "./block.jiang";
alias dylib = import "../system/dylib.jiang";
alias qid = import "../id.jiang";
alias registry = import "./registry.jiang";
alias source = import "../source.jiang";
alias store = import "../resolve/store.jiang";
alias store_api = import "../store.jiang";
alias string_support = import "../support/string.jiang";
alias syntax_builder = import "../syntax/builder.jiang";
alias syntax_diagnostics = import "../syntax/diagnostics.jiang";
alias package_provider = import "../../lang/package/provider.jiang";
alias asm_provider = import "../../lang/asm/provider.jiang";
alias doc_provider = import "../../lang/doc/provider.jiang";
import std;

public enum CallStatus {
    ok,
    error,
    not_loaded,
    unsupported_version,
    invalid_request,
    not_implemented,
}

public struct ParseIntoResult: Copyable {
    public CallStatus status;

    public ast.AstId? root;
    public Int role;

    public init(self, CallStatus status, ast.AstId? root, Int role) {
        self.status = status;
        self.root = root;
        self.role = role;
    }

    public ParseIntoResult ok(ast.AstId root, Int role) {
        return ParseIntoResult(.ok, root, role);
    }

    public ParseIntoResult failure(CallStatus status) {
        return ParseIntoResult(status, null, -1);
    }
}

public struct ScanBlockResult: Copyable {
    public CallStatus status;

    public std.jiang.syntax.ScanResult scan_result;

    public init(self, CallStatus status, std.jiang.syntax.ScanResult scan_result) {
        self.status = status;
        self.scan_result = scan_result;
    }

    public ScanBlockResult ok(std.jiang.syntax.ScanResult scan_result) {
        return ScanBlockResult(.ok, scan_result);
    }

    public ScanBlockResult failure(
        CallStatus status,
        std.jiang.syntax.ScanResult scan_result
    ) {
        return ScanBlockResult(status, scan_result);
    }
}

public ScanBlockResult scan_block(
    store_api.CompilerStore&! compiler_store,
    registry.LangDependency&! dependency,
    qid.PackageId provider_id,
    block.LangBlock&! lang_block,
    std.jiang.syntax.ScanResult fallback
) {
    guard compiler_store.resolve.package_ref(provider_id).lang_info_ref() is .some(info_ref) else {
        return ScanBlockResult.failure(.not_loaded, scan_error(fallback));
    }
    if (info_ref.wrapper_version != abi.wrapper_version()) {
        return ScanBlockResult.failure(.unsupported_version, scan_error(fallback));
    }
    qid.SymbolId dylib_path = info_ref.dylib_path;
    if (!lang_block.has_provider_instance()) {
        Int index!;
        if (compiler_store.lang_contexts.find(dylib_path) is .some(existing)) {
            index = existing;
        } else {
            if (!ensure_loaded(compiler_store, dependency, dylib_path, lang_block)) {
                return ScanBlockResult.failure(.not_loaded, scan_error(fallback));
            }
            std.jiang.syntax.Session session = unsafe {
                std.jiang.syntax.Session(compiler_store$.ptr()$.as(Void*), session_intern)
            };
            _ language = call_create_entry(dependency.create_pointer, session$.ref());
            index = compiler_store.lang_contexts.add(dylib_path, language, dependency.dylib_handle);
            dependency.dylib_handle = null;
        }
        lang_block.set_provider(create_instance(compiler_store.lang_contexts.ref_at(index)));
    }
    std.jiang.syntax.Invocation.Any&! provider_ref = lang_block.provider$.mut_ref();
    syntax_builder.SyntaxInvocation&! invocation = lang_block.invocation$.mut_ref();
    std.jiang.syntax.SyntaxCallbacks&! syntax = lang_block.syntax_context$.mut_ref();
    invocation.provider_package = provider_id;
    invocation.begin_scan(compiler_store, .lexer);
    std.jiang.syntax.ScanResult result = provider_ref.scan(lang_block.input, syntax);
    invocation.end_call();
    if (result.status == .error) {
        return ScanBlockResult.failure(.error, scan_error(result));
    }
    return ScanBlockResult.ok(result);
}

std.jiang.syntax.ScanResult scan_error(std.jiang.syntax.ScanResult fallback) {
    return std.jiang.syntax.ScanResult.error(fallback.body_span);
}

public ParseIntoResult parse_into(
    store_api.CompilerStore&! compiler_store,
    ast.AstUnit&! unit,
    block.LangBlock&! lang_block
) {
    if (lang_block.scan_result.status == .error) {
        return ParseIntoResult.failure(.invalid_request);
    }
    std.jiang.syntax.Invocation.Any&! provider_ref = lang_block.provider$.mut_ref();
    syntax_builder.SyntaxInvocation&! invocation = lang_block.invocation$.mut_ref();
    std.jiang.syntax.SyntaxCallbacks&! syntax = lang_block.syntax_context$.mut_ref();
    Int node_mark = unit.nodes.len();
    Int child_mark = unit.children.len();
    Int diagnostic_mark = compiler_store.diagnostics.len();
    invocation.begin_parse(compiler_store, unit, .parser, lang_block.entry_kind);
    std.jiang.syntax.Ast provider_ast = provider_ref.parse(lang_block.input, syntax);
    std.jiang.syntax.SyntaxCallbacks& finish_context = lang_block.syntax_context$.ref();
    Bool finished = std.jiang.syntax.finish_ast(finish_context, provider_ast);
    ast.AstId? result = invocation.take_result();
    Int role = invocation.result_role;
    invocation.end_call();
    if (!finished || result == null || compiler_store.diagnostics.len() != diagnostic_mark) {
        unit.nodes.truncate(node_mark);
        unit.children.truncate(child_mark);
        return ParseIntoResult.failure(.invalid_request);
    }
    guard result is .some(root) else { return ParseIntoResult.failure(.invalid_request); }
    return ParseIntoResult.ok(root, role);
}

Bool ensure_loaded(
    store_api.CompilerStore&! compiler_store,
    registry.LangDependency&! dependency,
    qid.SymbolId dylib_path_symbol,
    block.LangBlock&! lang_block
) {
    store.PackageRecord& provider = compiler_store.resolve.package_ref(dependency.package_id);
    if (compiler_store.lang_build_active(compiler_store.symbols.text(provider.root_path))) {
        syntax_diagnostics.add_error(compiler_store,
            syntax_builder.source_id_from_std(lang_block.input.source.source_id),
            .lexer, lang_block.full_span, "lang_provider_load_cycle",
            "lang provider source requires a provider already being prepared");
        return false;
    }
    if (dependency.loaded()) {
        return true;
    }
    UInt8[]& dylib_path = compiler_store.symbols.text(dylib_path_symbol);
    if (dylib_path.length == 0) {
        return false;
    }
    guard dylib.open(dylib_path) is .some(opened) else {
        report_dlopen_error(compiler_store, lang_block, dylib_path);
        return false;
    }

    dylib.Library library! = opened;
    Void* create_pointer = library.symbol(abi.create_symbol());
    if (create_pointer == null) {
        report_dlsym_error(compiler_store, lang_block, dylib_path, abi.create_symbol());
        library.close();
        return false;
    }
    dependency.dylib_handle = library.handle;
    dependency.create_pointer = create_pointer;
    library.owns = false;
    return true;
}

Void report_dlopen_error(
    store_api.CompilerStore&! compiler_store,
    block.LangBlock&! lang_block,
    UInt8[]& dylib_path
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("failed to load lang provider dynamic library: ");
    builder.append_valid_utf8(dylib_path);
    UInt8[]& error = dylib.last_error();
    if (error.length > 0) {
        builder.append(": ");
        builder.append_valid_utf8(error);
    }
    std.String message = builder.into_string();
    syntax_diagnostics.add_error(
        compiler_store,
        syntax_builder.source_id_from_std(lang_block.input.source.source_id),
        .lexer,
        lang_block.full_span,
        "lang_provider_dlopen_failed",
        message.bytes()
    );
}

Void report_dlsym_error(
    store_api.CompilerStore&! compiler_store,
    block.LangBlock&! lang_block,
    UInt8[]& dylib_path,
    UInt8[]& symbol
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("lang provider dynamic library is missing symbol: ");
    builder.append_valid_utf8(symbol);
    builder.append(" in ");
    builder.append_valid_utf8(dylib_path);
    UInt8[]& error = dylib.last_error();
    if (error.length > 0) {
        builder.append(": ");
        builder.append_valid_utf8(error);
    }
    std.String message = builder.into_string();
    syntax_diagnostics.add_error(
        compiler_store,
        syntax_builder.source_id_from_std(lang_block.input.source.source_id),
        .lexer,
        lang_block.full_span,
        "lang_provider_symbol_missing",
        message.bytes()
    );
}

public std.jiang.syntax.SymbolId session_intern(Void* state, UInt8[]& text) {
    store_api.CompilerStore&! store = unsafe { state$.as(store_api.CompilerStore&!) };
    return std.jiang.syntax.SymbolId(store.symbols.intern(text).to_index());
}

@life()
std.jiang.syntax.Language.Any^ call_create_entry(Void* entry_pointer, std.jiang.syntax.Session& session) {
    RawFn<std.jiang.syntax.Language.Any^, std.jiang.syntax.Session&> entry = unsafe {
        entry_pointer$.as(RawFn<std.jiang.syntax.Language.Any^, std.jiang.syntax.Session&>)
    };
    return entry(session);
}

#doc 内置语言与动态语言共用编译周期缓存；内置身份不与动态库路径混用。
public std.jiang.syntax.Invocation.Any^ builtin_provider(store_api.CompilerStore&! store, Int kind) {
    _ key = store.symbols.intern(if kind == 0 { "builtin:package" } else if kind == 1 { "builtin:asm" } else { "builtin:doc" });
    Int index!;
    if (store.lang_contexts.find(key) is .some(found)) {
        index = found;
    } else {
        std.jiang.syntax.Session session = unsafe {
            std.jiang.syntax.Session(store$.ptr()$.as(Void*), session_intern)
        };
        _ language = builtin_language(kind, session$.ref());
        index = store.lang_contexts.add(key, language);
    }
    return create_instance(store.lang_contexts.ref_at(index));
}

@life()
std.jiang.syntax.Language.Any^ builtin_language(Int kind, std.jiang.syntax.Session& session) {
    if (kind == 0) {
        return std.jiang.syntax.Language$.new(
            std.jiang.syntax.LanguageAdapter<package_provider.Provider, package_provider.Provider.LangContext>(
                package_provider.Provider.create_context(session), create_package));
    }
    if (kind == 1) {
        return std.jiang.syntax.Language$.new(
            std.jiang.syntax.LanguageAdapter<asm_provider.Provider, asm_provider.Provider.LangContext>(
                asm_provider.Provider.create_context(session), create_asm));
    }
    return std.jiang.syntax.Language$.new(
        std.jiang.syntax.LanguageAdapter<doc_provider.Provider, std.jiang.syntax.EmptyLangContext>(
            doc_provider.Provider.create_context(session), create_doc));
}

@life()
package_provider.Provider create_package() { return package_provider.Provider(); }
@life()
asm_provider.Provider create_asm() { return asm_provider.Provider(); }
@life()
doc_provider.Provider create_doc() { return doc_provider.Provider(); }

#doc 调用语言工厂得到独立拥有的块实例；上下文指针的有效期由编译周期持有关系保证。
@life()
std.jiang.syntax.Invocation.Any^ create_instance(std.jiang.syntax.Language.Any& language) {
    return unsafe { language.create() };
}
