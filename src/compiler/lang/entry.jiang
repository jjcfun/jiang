#doc(module)
    解析期发现 Provider root 的具名入口；完整类型和构造契约由随后 Sema 检查。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias ast = import "../syntax/ast.jiang";
alias qid = import "../id.jiang";

#doc 只扫描 root 直接声明，不依赖固定类型名、public 导出或完整语义分析。
public qid.SymbolId? find(context.CompilerContext&! ctx, ast.AstUnit& unit) {
    guard unit.root is .some(root_id) else { return null; }
    guard ast.root_data(unit.get(root_id).data) is .some(root) else { return null; }
    qid.SymbolId? found! = null;
    if (!find_in_items(ctx, unit, root.items, found$.mut_ref())) { return null; }
    if (found == null) {
        add_error(ctx, "lang package root has no @entry(lang) declaration", "lang_provider_missing");
    }
    return found;
}

Bool find_in_items(
    context.CompilerContext&! ctx, ast.AstUnit& unit, ast.AstRange items, qid.SymbolId?&! found
) {
    Int index! = 0;
    while (index < items.length) {
        ast.AstNode node = unit.get(unit.child_at(items, index));
        index = index + 1;
        if (node.data is .root(group)) {
            if (!find_in_items(ctx, unit, group.items, found)) { return false; }
            continue;
        }
        guard node.data is .top_level_decl(declaration) else { continue; }
        Int attribute_index! = 0;
        while (attribute_index < declaration.attributes.length) {
            ast.AstNode attribute = unit.get(unit.child_at(declaration.attributes, attribute_index));
            attribute_index = attribute_index + 1;
            guard attribute.data is .entry_attribute(mark) else { continue; }
            if (mark.kind != .lang) { continue; }
            if (found$.get() != null) {
                add_error(ctx, "multiple @entry(lang) declarations in provider root", "duplicate_entry");
                return false;
            }
            guard unit.get(declaration.body).data is .nominal_decl(type_decl) else {
                add_error(ctx, "@entry(lang) requires a concrete type declaration", "entry_type_mismatch");
                return false;
            }
            guard unit.get(type_decl.name).data is .name(name) else { return false; }
            found$.set(name.symbol_id);
        }
    }
    return true;
}

Void add_error(context.CompilerContext&! ctx, UInt8[]& message, UInt8[]& code) {
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(), message, code);
}
