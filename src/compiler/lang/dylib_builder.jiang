#doc(module)
    从 Provider 原包及会话内 ABI 适配函数构建动态库，入口可以保持私有。
#end

alias context = import "../context.jiang";
alias diagnostic_helper = import "../diagnostic/helper.jiang";
alias driver_options = import "../driver/options.jiang";
alias pipeline = import "../pipeline.jiang";
alias system_fs = import "../system/fs.jiang";
alias system_target = import "../system/target.jiang";
alias store = import "../resolve/store.jiang";
alias abi = import "./abi.jiang";
alias registry = import "./registry.jiang";
alias wrapper = import "./wrapper.jiang";
alias string = import "../support/string.jiang";
import std;

#doc 解析当前文件前，使用本编译会话的宿主配置准备其 Provider。
public Bool ensure_configured(context.CompilerContext&! ctx, registry.Registry& providers) {
    if (!ctx.build_lang_dylibs) { return true; }
    return ensure_provider_dylibs(ctx, providers, ctx.lang_cache_dir.bytes(), ctx.lang_compiler_version.bytes(),
        ctx.lang_compiler_build.bytes(), ctx.lang_linker_path.bytes(), ctx.lang_mode);
}

public Bool ensure_provider_dylibs(
    context.CompilerContext&! ctx,
    registry.Registry& providers,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    Int index! = 0;
    while (index < providers.len()) {
        registry.LangDependency& dependency = providers.ref_at(index);
        if (!ensure_provider_dylib(
                ctx,
                dependency,
                artifact_cache_dir,
                compiler_version,
                compiler_build,
                linker_path,
                mode
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool ensure_provider_dylib(
    context.CompilerContext&! ctx,
    registry.LangDependency& dependency,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    store.PackageRecord& provider = ctx.store.resolve.package_ref(dependency.package_id);
    guard provider.lang_info_ref() is .some(lang_info) else {
        return true;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    UInt8[]& source_path = ctx.store.symbols.text(lang_info.source_path);
    if (dylib_path.length == 0 || source_path.length == 0) {
        return true;
    }
    if (lang_info.cacheable && system_fs.file_exists(dylib_path)) {
        return true;
    }
    return build_provider_dylib(
        ctx,
        dependency,
        artifact_cache_dir,
        compiler_version,
        compiler_build,
        linker_path,
        mode
    );
}

Bool build_provider_dylib(
    context.CompilerContext&! ctx,
    registry.LangDependency& dependency,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    store.PackageRecord& provider = ctx.store.resolve.package_ref(dependency.package_id);
    guard provider.lang_info_ref() is .some(lang_info) else {
        return true;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    if (!system_fs.create_dirs(std.path.dirname(dylib_path))) {
        diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(),
            "failed to create lang provider output directory", "lang_provider_output_directory_failed");
        return false;
    }
    UInt8[]& provider_root = ctx.store.symbols.text(lang_info.source_path);
    context.CompilerContext provider_ctx! = context.CompilerContext();
    provider_ctx.inherit_lang_build(ctx, provider_root);
    provider_ctx.lang_provider_build = true;
    driver_options.CompileOptions options! = provider_compile_options(
        provider_ctx$.ref(),
        dylib_path,
        provider_root,
        artifact_cache_dir,
        compiler_version,
        compiler_build,
        linker_path,
        mode
    );
    pipeline.compile(provider_ctx$.mut_ref(), options$.ref());
    if (provider_dylib_built(ctx, provider_ctx$.ref(), provider)) {
        return true;
    }
    if (!provider_ctx.store.diagnostics.has_errors()) {
        add_missing_output_error(provider_ctx$.mut_ref(), options$.ref());
    }
    add_build_error(ctx, provider_ctx$.mut_ref(), dependency);
    return false;
}

Void add_missing_output_error(context.CompilerContext&! provider_ctx, driver_options.CompileOptions& options) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("lang provider dynamic library was not created: output=");
    builder.append_valid_utf8(options.output_path);
    builder.append_valid_utf8(", target=");
    builder.append_valid_utf8(options.target_triple);
    builder.append_valid_utf8(", linker=");
    builder.append_valid_utf8(options.linker_path);
    std.String message = builder.into_string();
    diagnostic_helper.add_package_error(
        provider_ctx.store.diagnostics$.mut_ref(),
        message,
        "lang_provider_output_missing"
    );
}

@life(
    return: ctx
        & dylib_path
        & provider_root
        & artifact_cache_dir
        & compiler_version
        & compiler_build
        & linker_path
)
driver_options.CompileOptions provider_compile_options(
    context.CompilerContext& ctx,
    UInt8[]& dylib_path,
    UInt8[]& provider_root,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    UInt8[]& target_triple = ctx.target.requested_triple.bytes();
    driver_options.CompileOptions options! = driver_options.CompileOptions(
        .dynamic_library,
        provider_root,
        dylib_path,
        artifact_cache_dir,
        target_triple,
        compiler_version,
        mode
    );
    options.linker_path = linker_path;
    options.compiler_build = compiler_build;
    options.link_libc = ctx.target.link_libc;
    append_provider_link_args(options$.mut_ref(), ctx.target$.ref());
    return options;
}

Void append_provider_link_args(
    driver_options.CompileOptions&! options,
    system_target.TargetInfo& target
) {
    if (target.os == .host || target.os == .macos) {
        options.add_link_arg(abi.macos_export_link_arg());
        return;
    }
    if (target.os == .linux) {
        options.add_link_arg(abi.linux_bind_local_link_arg());
    }
}

Bool provider_dylib_built(
    context.CompilerContext& ctx,
    context.CompilerContext& provider_ctx,
    store.PackageRecord& provider
) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        return false;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    return !provider_ctx.store.diagnostics.has_errors() && system_fs.file_exists(dylib_path);
}

Void add_build_error(
    context.CompilerContext&! ctx,
    context.CompilerContext&! provider_ctx,
    registry.LangDependency& dependency
) {
    wrapper.add_build_diagnostics(ctx, provider_ctx);
    diagnostic_helper.add_package_error(
        ctx.store.diagnostics$.mut_ref(),
        string.concat("failed to build lang provider dynamic library: ", dependency.dependency_name.bytes()).bytes(),
        "lang_provider_build_failed"
    );
}
