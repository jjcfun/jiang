#doc(module)
    macOS/Linux hosted 入口，初始化共享启动状态及调度器后调用 Jiang main。
#end

alias startup = import "../startup.jiang";
alias scheduler = import "../../runtime/scheduler.jiang";

extern Int __jiang_main();

@link_symbol("main")
Int32 hosted_entry(Int32 argc, UInt8** argv) {
    startup.startup_state = startup.StartupState(startup.ProgramArguments(Int(argc), argv));
    if (!scheduler.initialize()) { return Int32(70); }
    Int result = __jiang_main();
    scheduler.shutdown();
    return Int32(result);
}
