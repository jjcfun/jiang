#doc(module)
    不带调度器集成的 hosted 入口，保存进程参数并调用 Jiang main。
#end

alias startup = import "../startup.jiang";

extern Int __jiang_main();

@link_symbol("main")
Int32 hosted_entry(Int32 argc, UInt8** argv) {
    startup.startup_state = startup.StartupState(startup.ProgramArguments(Int(argc), argv));
    return Int32(__jiang_main());
}
