#doc(module)
    WASI 入口，从 WASI 参数接口构造共享启动状态并调用 Jiang main。
#end

alias startup = import "../startup.jiang";
alias wasi_libc = import "../os/wasi/libc.jiang";

extern Int __jiang_main();

@link_symbol("__main_void")
Int32 wasi_entry() {
    init_startup_state();
    return Int32(__jiang_main());
}

#doc 读取 WASI 的 argc/argv；失败时保留空启动参数。
Void init_startup_state() {
    UInt32 argc! = 0;
    UInt32 argv_buf_size! = 0;
    UInt16 sizes_error = unsafe {
        wasi_libc.__wasi_args_sizes_get(
            argc$.ptr()$.as(UInt32*),
            argv_buf_size$.ptr()$.as(UInt32*)
        )
    };
    if (sizes_error != UInt16(0)) {
        startup.startup_state = startup.StartupState();
        return;
    }
    unsafe {
        UInt8**! argv = UInt8*$.alloc(Int(argc) + 1);
        UInt8*! argv_buf = UInt8$.alloc(Int(argv_buf_size) + 1);
        UInt16 args_error = wasi_libc.__wasi_args_get(argv$.as(UInt8**), argv_buf$.as(UInt8*));
        if (args_error != UInt16(0)) {
            startup.startup_state = startup.StartupState();
            return;
        }
        argv[Int(argc)] = null;
        argv_buf[Int(argv_buf_size)] = 0;
        startup.startup_state = startup.StartupState(startup.ProgramArguments(Int(argc), argv$.as(UInt8**)));
    }
}
