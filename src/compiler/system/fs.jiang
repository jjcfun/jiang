// src/compiler/system 私有层的 filesystem provider 边界。
//
// 这里暴露编译器需要的文件系统语义，不暴露 fopen/fread/fwrite 等 libc 形状。
// `./os/provider.jiang` 通过 comptime 根据当前 target 选择具体 OS provider。

import provider = "./os/provider.jiang";
import fs_error = "./fs_error.jiang";
import list = "../support/list.jiang";

public alias FileMetadata = provider.FileMetadata;
public alias FileError = fs_error.FileError;

// 独占或借用一个 target file handle。File 不可复制；move 转移唯一 owner。
public struct File: Movable {
    Int32 fd!;
    Bool owns!;

    init(self, Int32 fd, Bool owns) {
        self.fd = fd;
        self.owns = owns;
    }

    // 返回当前 handle 是否仍可使用。
    public Bool is_open(self) {
        return self.fd >= 0;
    }

    // 自动清理只能采用不抛错的 close；需要处理关闭失败的公开调用应走
    // std.File.close() -> close_checked()。
    deinit(self) {
        self.close();
    }

    // 读取全部 bytes；handle 已关闭或 provider 失败时返回 null。
    @life()
    public UInt8[]&? read_all(self) {
        if (!self.is_open()) {
            return null;
        }
        return provider.read_file_all(self.fd);
    }

    // std facade 使用的 owning/errorable 入口；成功结果负责释放读取 buffer。
    public UInt8[]^@FileError read_all_owned(self) {
        if (!self.is_open()) { throw FileError.closed; }
        guard provider.read_file_all_owned(self.fd) is .some(bytes) else {
            throw provider.last_file_error();
        }
        return bytes;
    }

    // 从 offset 读取至多 length 个 bytes；参数无效、handle 已关闭或 provider 失败时返回 null。
    @life()
    public UInt8[]&? read_at(self, Int offset, Int length) {
        if (!self.is_open() || offset < 0 || length < 0) {
            return null;
        }
        return provider.read_file_at(self.fd, offset, length);
    }

    public UInt8[]^@FileError read_at_owned(self, Int offset, Int length) {
        if (!self.is_open()) { throw FileError.closed; }
        if (offset < 0 || length < 0) { throw FileError.invalid_argument; }
        guard provider.read_file_at_owned(self.fd, offset, length) is .some(bytes) else {
            throw provider.last_file_error();
        }
        return bytes;
    }

    // 写入全部 bytes；handle 已关闭或 provider 未完成写入时返回 false。
    @inline
    public Bool write_all(self, UInt8[]& bytes) {
        if (!self.is_open()) {
            return false;
        }
        return provider.write_file_all(self.fd, bytes);
    }

    public Void@FileError write_all_checked(self, UInt8[]& bytes) {
        if (!self.is_open()) { throw FileError.closed; }
        if (!provider.write_file_all(self.fd, bytes)) { throw provider.last_file_error(); }
    }

    public FileMetadata@FileError metadata_checked(self) {
        if (!self.is_open()) { throw FileError.closed; }
        guard provider.file_metadata(self.fd) is .some(metadata) else {
            throw provider.last_file_error();
        }
        return metadata;
    }

    // 关闭 owned handle 并失效 File；重复调用没有副作用。
    // owns=false 的 stdout/stderr 等借用 handle 只让当前 File 失效，不关闭进程 fd。
    // provider close 的结果在自动析构路径不可传播；无论结果如何都先失效本地状态，
    // 防止 fd 已被系统复用后发生二次关闭。
    public Void close(Self&! self) {
        if (self.owns && self.is_open()) {
            provider.close_file(self.fd);
        }
        self.fd = Int32(-1);
        self.owns = false;
    }

    // 显式 close 报告 provider failure；无 owner 或已经关闭时仍保持幂等成功。
    // 即使 provider close 失败也会先失效本地状态，再把保存的错误返回给调用方。
    public Void@FileError close_checked(Self&! self) {
        Bool failed! = false;
        FileError error! = FileError.io;
        if (self.owns && self.is_open() && !provider.close_file(self.fd)) {
            error = provider.last_file_error();
            failed = true;
        }
        self.fd = Int32(-1);
        self.owns = false;
        if (failed) { throw error; }
    }
}

// system provider 使用的构造边界；std.fs 不导出此函数。
public File file_from_handle(Int32 fd, Bool owns) {
    return File(fd, owns);
}

public File@FileError open_checked(UInt8[]& path) {
    guard provider.open_read(path) is .some(fd) else { throw provider.last_file_error(); }
    return File(fd, true);
}

public File@FileError create_checked(UInt8[]& path) {
    guard provider.open_write(path) is .some(fd) else { throw provider.last_file_error(); }
    return File(fd, true);
}

public FileError last_file_error() {
    return provider.last_file_error();
}

public list.ArrayList<UInt8[]^>@FileError list_dir_checked(UInt8[]& path) {
    provider.list_dir(path)
}

// hosted compiler 的跨进程 advisory lock。锁文件只提供同步，不保存
// artifact 状态；进程退出或 FileLock deinit 时由 OS 自动释放。
public struct FileLock: Movable {
    Int32 fd!;
    Bool owns!;

    public init(self) {
        self.fd = Int32(-1);
        self.owns = false;
    }

    public init(self, Int32 fd) {
        self.fd = fd;
        self.owns = true;
    }

    deinit(self) {
        self.release();
    }

    public Void release(Self&! self) {
        if (self.owns) {
            provider.release_file_lock(self.fd);
        }
        self.fd = Int32(-1);
        self.owns = false;
    }
}

public File? open(UInt8[]& path) {
    guard provider.open_read(path) is .some(fd) else { return null; }
    return File(fd, true);
}

public File? create(UInt8[]& path) {
    guard provider.open_write(path) is .some(fd) else { return null; }
    return File(fd, true);
}

@life()
public UInt8[]&? read_all(UInt8[]& path) {
    guard open(path) is .some(opened) else { return null; }
    File file! = opened;
    UInt8[]&? text = file.read_all();
    file.close();
    return text;
}

public UInt8[]^? read_all_owned(UInt8[]& path) {
    guard open(path) is .some(opened) else { return null; }
    File file! = opened;
    UInt8[]^ bytes = try file.read_all_owned() catch { return null; };
    file.close();
    return bytes;
}

@life()
public UInt8[]&? read_at(UInt8[]& path, Int offset, Int length) {
    guard open(path) is .some(opened) else { return null; }
    File file! = opened;
    UInt8[]&? bytes = file.read_at(offset, length);
    file.close();
    return bytes;
}

public Bool write_all(UInt8[]& path, UInt8[]& bytes) {
    guard create(path) is .some(created) else { return false; }
    File file! = created;
    Bool ok = file.write_all(bytes);
    file.close();
    return ok;
}

public Bool exists(UInt8[]& path) {
    return provider.exists(path);
}

public Bool file_exists(UInt8[]& path) {
    return provider.file_exists(path);
}

public Int? file_size(UInt8[]& path) {
    guard open(path) is .some(opened) else { return null; }
    File file! = opened;
    Int? size = provider.file_size(file.fd);
    file.close();
    return size;
}

public FileMetadata? file_metadata(UInt8[]& path) {
    guard open(path) is .some(opened) else { return null; }
    File file! = opened;
    FileMetadata? metadata = provider.file_metadata(file.fd);
    file.close();
    return metadata;
}

public Bool dir_exists(UInt8[]& path) {
    return provider.dir_exists(path);
}

public Bool create_dir(UInt8[]& path) {
    return provider.create_dir(path);
}

public Bool create_dirs(UInt8[]& path) {
    return provider.create_dirs(path);
}

public Bool copy_file(UInt8[]& from_path, UInt8[]& to_path) {
    guard read_all(from_path) is .some(bytes) else {
        return false;
    }
    return write_all(to_path, bytes);
}

// 用同一文件系统内的 rename 发布完整文件。调用方必须先把临时文件写在
// 目标目录中；成功返回后，目标路径只会指向完整的新文件。
public Bool atomic_replace(UInt8[]& temporary_path, UInt8[]& final_path) {
    return provider.atomic_replace(temporary_path, final_path);
}

public Bool remove_file(UInt8[]& path) {
    return provider.remove_file(path);
}

// 删除由编译器拥有的目录树。调用方必须先验证目标确实是自己管理的
// artifact/cache 根，不能把任意用户路径直接传入。
public Bool remove_tree(UInt8[]& path) {
    return provider.remove_tree(path);
}

public FileLock? acquire_file_lock(UInt8[]& path) {
    guard provider.acquire_file_lock(path) is .some(fd) else { return null; }
    return FileLock(fd);
}

public Int process_id() {
    return provider.process_id();
}
