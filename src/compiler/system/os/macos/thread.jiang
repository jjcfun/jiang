#doc(module) pthread 共享实现所需的 Darwin 分配、地址等待及主事件循环唤醒。

alias c = import "./libc.jiang";

Void* main_dispatch_queue! = null;

public Void initialize_main_thread() {
    Void* process = unsafe { c.dlopen(null, Int32(1)) };
    if (process == null) { return; }
    main_dispatch_queue = unsafe { c.dlsym(process, "_dispatch_main_q"$.ptr()$.as(UInt8*)) };
    unsafe { c.dlclose(process); }
}

#doc 仅桥接系统主事件循环，普通队列和工作线程完全由 pthread 实现。
public Void wake_main_queue(RawFn<Void, Void*> drain) {
    if (main_dispatch_queue == null) { return; }
    unsafe { c.dispatch_async_f(main_dispatch_queue, null, drain$.as(Void*)); }
}

public UInt8* allocate_storage(Int size) {
    return unsafe { c.malloc_zone_malloc(c.malloc_default_zone(), size) };
}

public UInt8* reallocate_storage(UInt8* pointer, Int size) {
    return unsafe { c.malloc_zone_realloc(c.malloc_default_zone(), pointer, size) };
}

public Void deallocate_storage(UInt8* pointer) {
    unsafe { c.malloc_zone_free(c.malloc_default_zone(), pointer); }
}

public Void wait_word_once(Int*! pointer, Int expected, Bool main) {
    UInt32 timeout = if main { UInt32(1000) } else { UInt32(0) };
    unsafe { c.__ulock_wait(UInt32(1), pointer$.as(Void*), UInt64(expected), timeout); }
}

public Void wake_word(Int*! pointer) {
    unsafe { c.__ulock_wake(UInt32(257), pointer$.as(Void*), UInt64(0)); }
}
