#doc(module) pthread 共享实现所需的 hosted Linux 分配与 futex 地址等待。

import build;
alias c = import "./libc.jiang";

public Void initialize_main_thread() {}
public Void wake_main_queue(RawFn<Void, Void*> drain) {}

public UInt8* allocate_storage(Int size) {
    return unsafe { UInt8$.alloc(size) };
}

public UInt8* reallocate_storage(UInt8* pointer, Int size) {
    return unsafe { c.realloc(pointer, size) };
}

public Void deallocate_storage(UInt8* pointer) {
    unsafe { pointer$.dealloc(); }
}

public Void wait_word_once(Int*! pointer, Int expected, Bool main) {
    Int64[2] timeout = [0, 1000000];
    Int timeout_pointer = if main { unsafe { timeout$.ptr()$.as(Int) } } else { 0 };
    unsafe { c.syscall(futex_number(), pointer$.as(Int), 128, expected, timeout_pointer, 0, 0); }
}

public Void wake_word(Int*! pointer) {
    unsafe { c.syscall(futex_number(), pointer$.as(Int), 129, 2147483647, 0, 0, 0); }
}

Int futex_number() {
    return if (build.target.arch == .x86_64) { 202 } else { 98 };
}
