// src/compiler/system 私有层中当前进程可用 CPU 数的跨平台查询入口。

import build;

comptime {
    if (build.target.os == .macos) {
        import target = "./os/macos/cpu.jiang";
    } else if (build.target.os == .linux && build.target.link_libc) {
        import target = "./os/linux/cpu.jiang";
    } else {
        import target = "./os/unsupported/cpu.jiang";
    }
}

// 返回当前进程可使用的 CPU 数；平台无法查询时至少返回 1。
public UInt32 available_count() {
    return target.available_count();
}
