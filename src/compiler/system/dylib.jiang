// src/compiler/system 私有层的 hosted dynamic library loader。

import provider = "./os/provider.jiang";

public struct Library: Movable {
    // Opaque platform dynamic library handle.
    public Void* handle!;

    // Whether this wrapper is responsible for closing the handle.
    public Bool owns!;

    public init(self, Void* handle) {
        self.handle = handle;
        self.owns = true;
    }

    public Bool loaded(self) {
        return self.handle != null;
    }

    public Void* symbol(self, UInt8[]& name) {
        if (!self.loaded()) {
            return null;
        }
        return provider.dynamic_library_symbol(self.handle, name);
    }

    public Void close(Self&! self) {
        if (self.owns && self.loaded()) {
            provider.dynamic_library_close(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    deinit(self) {
        self.close();
    }
}

public Library? open(UInt8[]& path) {
    Void* handle = provider.dynamic_library_open(path);
    if (handle == null) {
        return null;
    }
    return Library(handle);
}

public Bool close_handle(Void* handle) {
    if (handle == null) {
        return false;
    }
    return provider.dynamic_library_close(handle);
}

@life()
public UInt8[]& last_error() {
    guard provider.dynamic_library_error() is .some(message) else {
        return "";
    }
    return message[..];
}
