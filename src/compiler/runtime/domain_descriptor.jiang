// compiler 与 runtime 共用的 type-erased Domain/Executor ABI。
//
// descriptor 只描述语言级 kind、concrete Executor storage 和三个生命周期
// trampoline；平台 Queue、线程与 coroutine frame 均不进入该稳定边界。

public struct DomainDescriptor: Copyable {
    public Int domain_kind;
    public Int executor_size;
    public Int executor_alignment;
    public Void* create;
    public Void* enqueue;
    public Void* destroy;
}
