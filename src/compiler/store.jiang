#doc(module)
    编译会话持有的跨阶段事实集合，以及嵌套 Provider 的活动构建链。
#end

alias lang_contexts = import "./lang/context_store.jiang";

alias cache_identity = import "./artifact/cache_identity.jiang";
alias list = import "./support/list.jiang";
alias map = import "./support/map.jiang";
alias syntax_ast = import "./syntax/ast.jiang";
import std;
alias source_map = import "./source/source_map.jiang";
alias sem_store = import "./sema/model/store.jiang";
alias def = import "./resolve/def.jiang";
alias interner = import "./resolve/interner.jiang";
alias store = import "./resolve/store.jiang";
alias source_store = import "./source/store.jiang";
alias source = import "./source.jiang";
alias artifact = import "./artifact/source.jiang";
alias object_artifact = import "./artifact/object.jiang";
alias source_graph = import "./incremental/source_graph.jiang";
alias incremental_store = import "./incremental/symbol_store.jiang";
alias builtin = import "./builtin.jiang";
alias diagnostic = import "./diagnostic.jiang";
alias types = import "./sema/type.jiang";
alias typeck_store = import "./sema/type_check/store.jiang";
alias comptime_store = import "./sema/comptime/store.jiang";
alias borrow_store = import "./borrow_check/store.jiang";

/// 单个 SourceId 的最近一次成功解析；节点仅引用跨轮稳定的 SourceId 与 SymbolId。
struct ParsedSource: Movable {
    UInt64 content_hash;
    syntax_ast.AstUnit unit!;

    init(self, UInt64 content_hash, syntax_ast.AstUnit unit) {
        self.content_hash = content_hash;
        self.unit = unit;
    }
}

public struct CompilerStore: Movable {
    public lang_contexts.ContextStore lang_contexts! = lang_contexts.ContextStore();
    public diagnostic.DiagnosticStore diagnostics!;
    public source_store.SourceStore sources!;
    public source_map.SourceMap source_map!;
    public interner.SymbolStore symbols!;
    public builtin.BuiltinSymbols builtin_symbols!;
    public def.DefStore defs!;
    public types.TypeStore types!;
    public typeck_store.TypeCheckStore typeck!;
    public comptime_store.ComptimeStore comptime_store!;
    public store.ResolveStore resolve!;
    public sem_store.Store model!;
    public borrow_store.BorrowCheckStore^ borrowck!;
    Int borrowck_store_identity!;
    public artifact.SourceArtifactCache artifacts!;
    public object_artifact.ObjectArtifactCache object_artifacts!;
    public source_graph.SourceDependencyGraph source_dependencies!;
    public incremental_store.IncrementalSymbolStore incremental!;
    map.WyHashMap<source.SourceId, ParsedSource> parsed_sources!;

    public list.ArrayList<std.String> lang_build_roots! = list.ArrayList<std.String>();

    public Void push_lang_build(Self&! self, UInt8[]& root_path) {
        UInt8[]^ absolute = cache_identity.absolute_path(root_path);
        self.lang_build_roots.add(std.String.from_valid_utf8(absolute[..]));
    }

    public Bool lang_build_active(self, UInt8[]& root_path) {
        UInt8[]^ absolute = cache_identity.absolute_path(root_path);
        Int index! = 0;
        while (index < self.lang_build_roots.len()) {
            if (std.path.equal(self.lang_build_roots.ref_at(index).bytes(), absolute[..])) { return true; }
            index = index + 1;
        }
        return false;
    }

    public init(self) {
        self.diagnostics = diagnostic.DiagnosticStore();
        self.sources = source_store.SourceStore();
        self.source_map = source_map.SourceMap();
        self.symbols = interner.SymbolStore();
        self.builtin_symbols = builtin.BuiltinSymbols();
        self.defs = def.DefStore();
        self.types = types.TypeStore();
        self.typeck = typeck_store.TypeCheckStore();
        self.comptime_store = comptime_store.ComptimeStore();
        self.resolve = store.ResolveStore();
        self.model = sem_store.Store();
        self.borrowck = new borrow_store.BorrowCheckStore(false);
        self.borrowck_store_identity = -1;
        self.artifacts = artifact.SourceArtifactCache();
        self.object_artifacts = object_artifact.ObjectArtifactCache();
        self.source_dependencies = source_graph.SourceDependencyGraph();
        self.incremental = incremental_store.IncrementalSymbolStore();
        self.parsed_sources = map.WyHashMap<source.SourceId, ParsedSource>();
        self.init_builtin_compilation_state();
    }

    /// 内容未变时复制已解析的 Jiang AST，避免重新词法分析和解析依赖源码。
    public syntax_ast.AstUnit? cached_syntax(self, source.SourceId source_id, UInt64 content_hash) {
        guard self.cached_syntax_ref(source_id, content_hash) is .some(unit) else { return null; }
        return unit.copy_syntax();
    }

    /// 借用当前快照的语法事实，供编辑器查询路径等没有语义 definition 的节点。
    public syntax_ast.AstUnit&? cached_syntax_ref(self, source.SourceId source_id, UInt64 content_hash) {
        guard self.parsed_sources.get(source_id) is .some(cached) else { return null; }
        if (cached.content_hash != content_hash) { return null; }
        return cached.unit$.ref();
    }

    /// 只保存成功解析且不依赖 Lang Provider 的语法结果。
    public Void store_syntax(Self&! self, source.SourceId source_id, UInt64 content_hash, syntax_ast.AstUnit& unit) {
        self.parsed_sources.set(source_id, ParsedSource(content_hash, unit.copy_syntax()));
    }

    // 开始新一轮 package 编译时，保留 sources/symbols/artifacts/incremental，
    // 重建所有 session-local 语义表。这样同一个 CompilerContext 可以服务
    // 多轮编译，而不会复用旧 DefId/NodeId/TypeId。
    public Void begin_compilation(Self&! self) {
        self.sources.begin_generation();
        self.lang_contexts = lang_contexts.ContextStore();
        self.diagnostics.clear();
        self.incremental.begin_generation();
        self.artifacts.reset_stats();
        self.object_artifacts.reset_stats();
        self.source_dependencies = source_graph.SourceDependencyGraph();
        self.source_map = source_map.SourceMap();
        self.defs = def.DefStore();
        self.types = types.TypeStore();
        self.typeck = typeck_store.TypeCheckStore();
        self.comptime_store = comptime_store.ComptimeStore();
        self.resolve = store.ResolveStore();
        self.model = sem_store.Store();
        self.borrowck = new borrow_store.BorrowCheckStore(false);
        self.borrowck_store_identity = -1;
        self.init_builtin_compilation_state();
    }

    public Void publish_borrow_check_result(
        Self&! self,
        Int store_identity,
        borrow_store.BorrowCheckStore^ result
    ) {
        assert(store_identity >= 0);
        self.borrowck = result;
        self.borrowck_store_identity = store_identity;
    }

    public source.SourceId intern_source_path(
        Self&! self,
        UInt8[]& path,
        UInt8[]& text
    ) {
        return self.sources.intern_path(path, text);
    }

    public Bool owns_borrow_check_result(self, Int store_identity) {
        return self.borrowck_store_identity == store_identity;
    }

    public Bool borrow_check_result_accepted(self) {
        return self.borrowck.accepted();
    }

    Void init_builtin_compilation_state(Self&! self) {
        self.builtin_symbols.load(self.symbols$.mut_ref());
        builtin.init_builtins(
            self.symbols$.mut_ref(),
            self.defs$.mut_ref(),
            self.resolve$.mut_ref(),
            self.model$.mut_ref(),
            self.source_map$.mut_ref(),
            self.types$.mut_ref(),
            self.incremental$.mut_ref()
        );
    }
}
