// 跨阶段共享的 session-local handle。
//
// 能跨阶段传递的 ID 统一定义在这里；阶段私有数组下标留在该阶段内部文件。

import std;
import "./support/traits.jiang";
import core_traits = "./core/traits.jiang";

public alias SymbolId = std.jiang.syntax.SymbolId;

public struct PackageId: Copyable, traits.Indexable, Hashable, Equatable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public PackageId from_index(Int index) {
        return PackageId(index);
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.index));
    }

    public Bool equal(PackageId& lhs, PackageId& rhs) {
        return lhs.index == rhs.index;
    }
}

