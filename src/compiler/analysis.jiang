#doc(module)
    编译级语义与求值编排：沿声明 ensure 和 JIL 实例索引推进依赖，不先封闭 source graph。
    向 resolver/typecheck 提供求值能力，串联 lowering、borrow/drop 与执行；不解释表达式或实现类型规则。
#end

alias token = import "./syntax/token.jiang";
alias context = import "./context.jiang";
alias qid = import "./id.jiang";
alias resolver_api = import "./resolve/module_resolver.jiang";
alias module_graph = import "./resolve/module_graph.jiang";
alias jil = import "./jil.jiang";
alias lower = import "./jil/lower.jiang";
alias references = import "./jil/references.jiang";
alias executor = import "./jil/eval.jiang";
alias borrow = import "./borrow_check.jiang";
alias bindings_api = import "./sema/generic/bindings.jiang";
alias types = import "./sema/type.jiang";
alias value = import "./sema/comptime/value.jiang";
alias list = import "./support/list.jiang";
alias set = import "./support/set.jiang";
alias sem = import "./sema/model.jiang";
alias def = import "./resolve/def.jiang";
alias diagnostics = import "./sema/diagnostics.jiang";
alias type_check = import "./sema/type_check.jiang";
alias drop_elaborate = import "./jil/drop_elaborate.jiang";
alias verifier = import "./jil/verifier.jiang";
alias type_requirements = import "./jil/type_requirements.jiang";
alias instance_reader = import "./jil/instance_reader.jiang";
alias diagnostic_helper = import "./diagnostic/helper.jiang";
alias diagnostic_api = import "./diagnostic.jiang";
alias query_cache = import "./db/query_cache.jiang";
alias source_map = import "./source/source_map.jiang";
alias model_template = import "./artifact/model_template.jiang";
alias source_artifact = import "./artifact/source.jiang";
alias metadata_artifact = import "./artifact/metadata.jiang";
alias database = import "./db.jiang";
alias fingerprint = import "./incremental/fingerprint.jiang";
alias qkey = import "./incremental/key.jiang";
alias object_key = import "./artifact/object_key.jiang";
alias key_builder = import "./artifact/object_key_builder.jiang";

#doc
    源码表达式共用一个求值入口；条件和 alias 由调用方传入期望类型，resolver 不依赖 JIL。
#end
public value.ComptimeValue? evaluate_source_expression(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, sem.NodeId root, qid.TypeId expected
) {
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    return evaluate_model_expression(ctx, resolver, graph, root, args.slice(), expected);
}

#doc
    已发现模型的检查入口由编译层接入求值，Sema 本身只调用提供的回调。
#end
public qid.TypeId? check_expression(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    sem.NodeId root, qid.TypeId? expected = null
) {
    return type_check.check_expression(ctx, graph.root_module,
        { [ref graph] eval_ctx, node, target => evaluate_checked_expression(eval_ctx, graph, node, target) },
        root, expected);
}

public Bool ensure_declaration_checked(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, qid.DefId def_id
) {
    return type_check.ensure_declaration_checked(ctx, graph.root_module,
        { [ref graph] eval_ctx, node, target => evaluate_checked_expression(eval_ctx, graph, node, target) }, def_id);
}

public Bool ensure_body_checked(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, qid.DefId def_id
) {
    if (!restore_declaration_body(ctx, def_id)) { return false; }
    return type_check.ensure_body_checked(ctx, graph.root_module,
        { [ref graph] eval_ctx, node, target => evaluate_checked_expression(eval_ctx, graph, node, target) }, def_id);
}

public Bool check_model_package(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    if (!type_check.check_model_package(ctx, graph,
        { [ref graph] eval_ctx, node, target => evaluate_checked_expression(eval_ctx, graph, node, target) })) {
        return false;
    }
    return prepare_metadata(ctx, graph);
}

#doc metadata 与 const 共用类型检查、JIL 和物化；求值完成后才进入独立生成阶段。
Bool prepare_metadata(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    Int module_index! = 0;
    while (module_index < graph.module_count()) {
        qid.ModuleId module = graph.module_at(module_index);
        module_index = module_index + 1;
        _ record = ctx.store.resolve.module_ref(module);
        if (record.interface_only && !ctx.query.metadata.prepared(record.def_id)
            && !metadata_artifact.prepare(ctx, module)) {
            _ source = ctx.store.resolve.module_ref(module).source_id;
            diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), source_map.SourceLoc(source, token.Span()),
                "cached metadata is unavailable", "metadata_cache_unavailable");
            return false;
        }
    }
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId> evaluate =
        { [ref graph] eval_ctx, expression => evaluate_checked_expression(eval_ctx, graph, expression) };
    Int index! = 0;
    while (index < ctx.query.metadata.len()) {
        if (!evaluate_metadata_attachment(ctx, index, evaluate$.ref())) {
            return false;
        }
        index = index + 1;
    }
    module_index = 0;
    while (module_index < graph.module_count()) {
        ctx.query.metadata.mark_module_ready(graph.module_at(module_index));
        module_index = module_index + 1;
    }
    return true;
}

#doc 缓存恢复通过统一编排准备实际观察的语义事实，签名和标签共用现有求值能力边界。
public Bool prepare_observed_fact(context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, qid.DefId target, source_artifact.ObservationAspect aspect
) {
    if (aspect == .metadata) {
        if (!prepare_metadata_target(ctx, resolver, graph, target)) { return false; }
        _ module = ctx.store.defs.get(target).module_id$.some();
        _ source_id = ctx.store.resolve.module_ref(module).source_id;
        if (!ctx.store.sources.ensure_source(source_id)) { return false; }
        ctx.store.sources.ensure_line_starts(source_id);
        return true;
    }
    return prepare_type_models(ctx, resolver, graph, target);
}

#doc 每条附着共用同一求值状态；按需读取和最终 sweep 均在这里发布普通常量值。
Bool evaluate_metadata_attachment(context.CompilerContext&! ctx, Int index,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId>& evaluate
) {
    _ attachment = ctx.query.metadata.get(index);
    if (attachment.value != null) { return true; }
    if (!ctx.query.metadata.begin_evaluation(index)) {
        _ module = ctx.store.defs.get(attachment.target).module_id$.some();
        _ source = ctx.store.resolve.module_ref(module).source_id;
        diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), source_map.SourceLoc(source, attachment.span),
            "metadata depends on its own unfinished value", "metadata_dependency_cycle");
        return false;
    }
    Int diagnostic_begin = ctx.store.diagnostics.len();
    guard attachment.origin is .source(_, expression) else {
        ctx.query.metadata.cancel_evaluation(index);
        return false;
    }
    guard evaluate(ctx$.mut_ref(), expression) is .some(result) else {
        ctx.query.metadata.cancel_evaluation(index);
        report_metadata_failure(ctx, attachment.target, attachment.span, diagnostic_begin);
        return false;
    }
    if (!ctx.store.comptime_store.is_data_value(result)) {
        ctx.query.metadata.cancel_evaluation(index);
        _ module = ctx.store.defs.get(attachment.target).module_id$.some();
        _ source = ctx.store.resolve.module_ref(module).source_id;
        diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), source_map.SourceLoc(source, attachment.span),
            "metadata requires data without namespace values or unbound parameters",
            "meta_requires_materializable_data");
        return false;
    }
    ctx.query.metadata.publish(index, result);
    return true;
}

#doc 仅准备实际读取的目标；持久化恢复仍由同一 metadata section 发布到同一 QueryEngine。
Bool prepare_metadata_target(context.CompilerContext&! ctx, qid.DefId target,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId> evaluate
) {
    if (ctx.query.metadata.ready(ctx.store$.ref(), target)) { return true; }
    _ module = ctx.store.defs.get(target).module_id$.some();
    _ record = ctx.store.resolve.module_ref(module);
    if (record.interface_only && !ctx.query.metadata.module_ready(module)) {
        if (!metadata_artifact.prepare(ctx, module)) { return metadata_unavailable(ctx, target); }
    }
    if (!ctx.query.metadata.prepared(target)) {
        if (ctx.store.defs.get(target).kind == .generic_param_def) { ctx.query.metadata.prepare(target); }
        else { return metadata_unavailable(ctx, target); }
    }
    Int index! = 0;
    while (index < ctx.query.metadata.count(target)) {
        Int attachment = ctx.query.metadata.attachment_index(target, index);
        if (!evaluate_metadata_attachment(ctx, attachment, evaluate$.ref())) { return false; }
        index = index + 1;
    }
    return true;
}

Bool metadata_unavailable(context.CompilerContext&! ctx, qid.DefId target) {
    source_map.SourceLoc location! = source_map.SourceLoc(token.Span());
    if (ctx.store.source_map.def_span(target) is .some(found)) { location = found; }
    diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), location,
        "metadata declaration has not been prepared", "comptime_dependency_not_ready");
    return false;
}

Bool prepare_metadata_target(context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, qid.DefId target
) {
    _ module = ctx.store.defs.get(target).module_id$.some();
    if (!ctx.query.metadata.prepared(target) && !ctx.store.resolve.module_ref(module).interface_only) {
        if (ctx.store.defs.get(target).kind == .module_def) {
            if (!resolver.ensure_module_metadata(ctx, graph, module)) { return metadata_unavailable(ctx, target); }
        } else if (!resolver.ensure_declaration_signature(ctx, graph, target)) {
            return metadata_unavailable(ctx, target);
        }
    }
    return prepare_metadata_target(ctx, target,
        { [ref! resolver, ref! graph] eval_ctx, expression =>
            evaluate_checked_expression(eval_ctx, resolver, graph, expression) });
}

#doc 执行器先结束借用再交出依赖；仅普通求值重试，累计预算不因准备新事实而重置。
value.ComptimeValue? execute_with_metadata(context.CompilerContext&! ctx,
    Fn<executor.Evaluation?, context.CompilerContext&!, Int> execute,
    Fn<Bool, context.CompilerContext&!, qid.DefId> prepare
) {
    Int steps! = 10000;
    while (true) {
        guard execute(ctx$.mut_ref(), steps) is .some(result) else { return null; }
        if (result is .value(value)) { return value; }
        guard result is .metadata(target, remaining) else { return null; }
        steps = remaining;
        if (!prepare(ctx$.mut_ref(), target)) { return null; }
    }
    return null;
}

value.ComptimeValue? execute_prepared_expression(context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph, jil.FunctionId expression, types.GenericArg[]& args
) {
    return execute_with_metadata(ctx,
        { [expression, ref args] eval_ctx, steps =>
            executor.evaluate_expression_step(eval_ctx.store$.mut_ref(), eval_ctx.query$.mut_ref(),
                eval_ctx.jil$.ref(), expression, args, steps) },
        { [ref graph] eval_ctx, target => prepare_metadata_target(eval_ctx, target,
            { [ref graph] nested_ctx, root => evaluate_checked_expression(nested_ctx, graph, root) }) });
}

value.ComptimeValue? execute_prepared_expression(context.CompilerContext&! ctx,
    resolver_api.ModuleResolver&! resolver, module_graph.ModuleGraph&! graph,
    jil.FunctionId expression, types.GenericArg[]& args
) {
    return execute_with_metadata(ctx,
        { [expression, ref args] eval_ctx, steps =>
            executor.evaluate_expression_step(eval_ctx.store$.mut_ref(), eval_ctx.query$.mut_ref(),
                eval_ctx.jil$.ref(), expression, args, steps) },
        { [ref! resolver, ref! graph] eval_ctx, target => prepare_metadata_target(eval_ctx, resolver, graph, target) });
}

#doc 保留实际失败位置及调用链，并说明当前求值由 metadata 触发。
Void report_metadata_failure(context.CompilerContext&! ctx, qid.DefId target, token.Span span, Int begin) {
    _ module = ctx.store.defs.get(target).module_id$.some();
    _ source = ctx.store.resolve.module_ref(module).source_id;
    if (!ctx.store.diagnostics.has_errors()) {
        diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), source_map.SourceLoc(source, span),
            "metadata requires a concrete compile-time value", "meta_requires_comptime_value");
        return;
    }
    Int index! = begin;
    while (index < ctx.store.diagnostics.len()) {
        ctx.store.diagnostics.items.mut_ref_at(index).add_related(diagnostic_api.DiagnosticRelatedInformation(
            diagnostic_api.SourceRange(source, span), "while evaluating @meta at compile time"));
        index = index + 1;
    }
}

#doc 按真实函数或全局初始化需求恢复持久模型；签名存在并不等于声明是外部定义。
Bool restore_declaration_body(context.CompilerContext&! ctx, qid.DefId def_id) {
    if (ctx.store.model.has_body(def_id)) { return restore_callable_lambdas(ctx, def_id); }
    sem.DeclKind kind = ctx.store.model.def_ref(def_id).decl.kind;
    Bool runtime_global = kind == .global_decl && !ctx.store.model.def_is_const(def_id);
    if (kind != .function_decl && kind != .init_decl && kind != .deinit_decl && !runtime_global) { return true; }
    if (ctx.store.model.def_ref(def_id).decl.extern_kind != .none) { return true; }
    // 只有声明提供实现时才需要恢复 body；纯签名声明继续由正常检查和外部调用规则处理。
    if (!runtime_global && !ctx.store.model.function_has_body_definition(def_id)) { return true; }
    if (runtime_global && ctx.store.model.declaration_sema_state(def_id) == .body_ready) {
        qid.ModuleId module_id = ctx.store.defs.get(def_id).module_id$.some();
        if (!ctx.store.resolve.module_ref(module_id).interface_only) { return true; }
    }
    if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable)) {
        if (ctx.store.artifacts.take_generic_template(stable) is .some(template)) {
            Bool restored = model_template.decode_body(ctx.store$.mut_ref(), def_id, template.payload.slice());
            if (restored) {
                database.invalidate_type_check_body(ctx.query$.ref(), def_id);
                ctx.store.incremental.set_body_fingerprint(stable, template.body_fingerprint);
                ctx.query.invalidate_def_fingerprints(stable);
                ctx.query.restore_def_fingerprints(stable,
                    ctx.store.incremental.signature_fingerprint(stable), template.body_fingerprint);
            }
            ctx.store.artifacts.store_generic_template(template);
            if (restored) { return restore_callable_lambdas(ctx, def_id); }
        }
    }
    diagnostic_helper.add_package_error(ctx.store.diagnostics$.mut_ref(),
        "required declaration body is unavailable", "required_declaration_body_unavailable");
    return false;
}

#doc lambda 是外层 body 的词法组成部分；捕获分析前恢复其模型，不推进同级普通函数。
Bool restore_callable_lambdas(context.CompilerContext&! ctx, qid.DefId owner) {
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(owner)) {
        qid.DefId member = ctx.store.model.def_member_at(owner, index);
        index = index + 1;
        if (!ctx.store.model.def_is_lambda_function(member)) { continue; }
        if (!restore_declaration_body(ctx, member)) { return false; }
    }
    return true;
}

#doc
    将 body 检查与 lowering 分开调用；执行所需的依赖闭包和 borrow/drop 由求值请求继续准备。
#end
public Bool ensure_source_function(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, jil.Store&! output, qid.DefId function_def
) {
    assert(!output.program.is_frozen());
    assert(ctx.store.model.has_def(function_def));
    assert(ctx.store.model.has_function_signature(function_def));
    if (output.program.has_errors()) { return false; }
    if (!ensure_body_checked(ctx, graph, function_def)) {
        output.program.mark_error();
        return false;
    }
    return lower.ensure_checked_source_function(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, output, function_def
    );
}

#doc 常量类型依赖可先于 initializer 检查请求求值；只补齐 root 检查，callee body 仍按需推进。
public value.ComptimeValue? evaluate_checked_expression(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, sem.NodeId root, qid.TypeId? expected = null
) {
    if (ctx.store.typeck.node_type(root) == null
        && check_expression(ctx, graph, root, expected) == null) { return null; }
    qid.TypeId? result! = expected;
    if (result == null) { result = ctx.store.typeck.node_type(root); }
    guard result is .some(result_type) else { return null; }
    guard lower.ensure_expression(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, ctx.jil$.mut_ref(), root, result_type
    ) is .some(expression) else { return null; }
    if (expression_requires_instance(ctx, expression)) { return null; }
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    if (!prepare_graph_eval(ctx, graph, .generated_function(expression), args.slice(), false)) { return null; }
    return execute_prepared_expression(ctx, graph, expression, args.slice());
}

#doc 已发现 graph 的递归求值准备入口，与带 resolver 的入口共享实例结果状态和执行器。
Bool prepare_graph_eval(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    jil.MonoItem root, types.GenericArg[]& args, Bool require_all_args = true) {
    return prepare_eval_dependencies(ctx, root, args,
        { [ref graph] eval_ctx, item, bindings =>
            if (item is .source_instance(identity)) {
                qid.DefId function_def = eval_ctx.jil.program.function_instance_at(identity).def_id;
                if (!prepare_eval_source(eval_ctx, graph, function_def)) { return null; }
            }
            if (reflected_definition(eval_ctx, item) is .some(definition)) {
                if (!type_check.ensure_declaration_checked(eval_ctx, graph.root_module,
                    { [ref graph] nested_ctx, node, target =>
                        evaluate_checked_expression(nested_ctx, graph, node, target) }, definition, true)) {
                    return null;
                }
            }
            prepare_eval_metadata(eval_ctx, graph, item, bindings,
                { [ref graph] nested_ctx, expression, instance, arguments =>
                    if (!prepare_graph_eval(nested_ctx, graph, .generated_function(expression), arguments)) {
                        return false;
                    }
                    guard execute_prepared_expression(nested_ctx, graph, expression, arguments)
                        is .some(result) else { return false; }
                    publish_eval_result(nested_ctx, graph, expression, instance, result)
                })
        }, require_all_args
    ) != null;
}

#doc 持有 resolver 的调用方允许求值继续发现模型；TypeCheck 仅借用此调用方提供的回调。
public value.ComptimeValue? evaluate_checked_expression(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, sem.NodeId root, qid.TypeId? expected = null
) {
    if (ctx.store.typeck.node_type(root) == null) {
        if (type_check.check_expression(ctx, graph.root_module,
            { [ref! resolver, ref! graph] eval_ctx, node, target =>
                evaluate_checked_expression(eval_ctx, resolver, graph, node, target) },
            root, expected) == null) { return null; }
    }
    qid.TypeId? result! = expected;
    if (result == null) { result = ctx.store.typeck.node_type(root); }
    guard result is .some(result_type) else { return null; }
    guard lower.ensure_expression(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, ctx.jil$.mut_ref(), root, result_type
    ) is .some(expression) else { return null; }
    if (expression_requires_instance(ctx, expression)) { return null; }
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    if (prepare_resolved_eval(ctx, resolver, graph, .generated_function(expression), args.slice(), false) == null) {
        return null;
    }
    return execute_prepared_expression(ctx, resolver, graph, expression, args.slice());
}

#doc 反射类型的实参属于当前求值实例；准备仅针对名义定义，不把类型句柄解释成目标内存。
qid.DefId? reflected_definition(context.CompilerContext& ctx, jil.MonoItem item) {
    guard ctx.store.resolve.core_functions.reflect_type_of is .some(builtin) else { return null; }
    guard item is .source_instance(identity) else { return null; }
    _ instance = ctx.jil.program.function_instance_at(identity);
    if (instance.def_id != builtin || instance.args.length != 1) { return null; }
    guard instance.args[0] is .type_arg(argument) else { return null; }
    guard ctx.store.types.get(argument.value).data is .named(named) else { return null; }
    def.DefKind kind = ctx.store.defs.get(named.def_id).kind;
    if (kind != .struct_def && kind != .enum_def && kind != .trait_def) { return null; }
    return named.def_id;
}

#doc 内部 const 请求尚无实例实参时只探测依赖，不将合法模板诊断为具体化失败。
Bool expression_requires_instance(context.CompilerContext& ctx, jil.FunctionId expression) {
    jil.Function function = ctx.jil.program.function(expression);
    bindings_api.GenericBindings bindings! = bindings_api.GenericBindings();
    if (type_requirements.expression_concrete_failure(
        ctx.store$.ref(), function, bindings$.ref(), false
    ) != null) { return true; }
    references.References dependencies = references.collect_function_refs(function);
    return !dependencies.eval_expressions.empty();
}

#doc
    每轮先结束递归 Sema/lowering，再借用 JIL 做 borrow/drop；表达式实参贯穿依赖准备与验证。
#end
qkey.Fingerprint128? prepare_eval_dependencies(
    context.CompilerContext&! ctx, jil.MonoItem root, types.GenericArg[]& root_args,
    Fn<references.References?, context.CompilerContext&!, jil.MonoItem, bindings_api.GenericBindings&> prepare_item,
    Bool require_all_args = true, Bool implementation_key = false
) {
    bindings_api.GenericBindings expression_bindings! = bindings_api.GenericBindings();
    if (root is .generated_function(id)) {
        bindings_api.GenericBindings empty! = bindings_api.GenericBindings();
        qid.DefId owner = jil.function_provenance_def(ctx.jil.program.function(id).origin);
        expression_bindings = bindings_api.bindings_for_instance(
            ctx.store.defs$.ref(), ctx.store.model$.ref(), ctx.store.types$.ref(), owner, root_args, empty$.ref()
        );
        instance_reader.bind_eval_constants(ctx.store$.ref(), ctx.jil.program$.ref(),
            owner, expression_bindings$.mut_ref());
    }
    qid.DefId use_owner = switch root {
        .source_instance(identity) => ctx.jil.program.function_instance_at(identity).def_id,
        .source_resume_instance(resume) => ctx.jil.program.function_instance_at(resume.identity).def_id,
        .generated_function(id) => jil.function_provenance_def(ctx.jil.program.function(id).origin),
    };
    list.ArrayList<jil.MonoItem> pending! = list.ArrayList<jil.MonoItem>();
    set.HashSet<Int> seen! = set.HashSet<Int>();
    set.HashSet<Int> seen_globals! = set.HashSet<Int>();
    list.ArrayList<jil.GlobalId> globals! = list.ArrayList<jil.GlobalId>();
    append_eval_item(root, pending$.mut_ref(), seen$.mut_ref());
    Int prepared! = 0;
    Int dropped! = 0;
    while (dropped < pending.len()) {
        while (prepared < pending.len()) {
            jil.MonoItem item = pending.get(prepared);
            guard prepare_item(ctx$.mut_ref(), item, expression_bindings$.ref()) is .some(dependencies) else {
                return null;
            }
            qid.DefId target = switch item {
                .source_instance(identity) => ctx.jil.program.function_instance_at(identity).def_id,
                .source_resume_instance(resume) => ctx.jil.program.function_instance_at(resume.identity).def_id,
                .generated_function(id) => jil.function_provenance_def(ctx.jil.program.function(id).origin),
            };
            database.observe_def_body(ctx.query$.ref(), ctx.store$.ref(), use_owner, target);
            append_eval_dependencies(ctx, dependencies, pending$.mut_ref(),
                seen$.mut_ref(), seen_globals$.mut_ref(), globals$.mut_ref(), implementation_key);
            prepared = prepared + 1;
        }
        if (!check_eval_borrows(ctx, pending.slice(), dropped)) { return null; }
        while (dropped < prepared) {
            jil.MonoItem item = pending.get(dropped);
            if (!prepare_eval_drops(
                ctx, item, expression_bindings$.ref(), pending$.mut_ref(), seen$.mut_ref(),
                seen_globals$.mut_ref(), globals$.mut_ref(), implementation_key
            )) { return null; }
            dropped = dropped + 1;
        }
    }
    Int index! = 0;
    while (index < pending.len()) {
        jil.MonoItem item = pending.get(index);
        index = index + 1;
        if (item is .generated_function(id) && jil.function_is_eval_expression(ctx.jil.program.function(id).origin)) {
            if (!verifier.verify_expression(ctx.store$.mut_ref(), ctx.jil$.mut_ref(), id,
                expression_bindings$.ref(), require_all_args)) { return null; }
            continue;
        }
        if (!verifier.verify_instance(ctx.store$.mut_ref(), ctx.jil$.mut_ref(), item, .drop_output)) { return null; }
    }
    if (implementation_key) {
        return prepared_implementation_fingerprint(ctx$.mut_ref(), pending.slice(), globals.slice());
    }
    return qkey.Fingerprint128();
}

Bool prepare_eval_source(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, qid.DefId function_def
) {
    if (!ensure_body_checked(ctx, graph, function_def)) { return false; }
    return lower.ensure_checked_source_function(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, ctx.jil$.mut_ref(), function_def
    );
}

Bool check_eval_borrows(context.CompilerContext&! ctx, jil.MonoItem[]& items, Int begin) {
    Int index! = begin;
    while (index < items.length) {
        jil.MonoItem item = items[index];
        index = index + 1;
        jil.FunctionTarget target!;
        if (item is .source_instance(identity)) {
            target = .source(ctx.jil.program.function_instance_at(identity).def_id);
        } else {
            guard item is .generated_function(id) else { assert(false); return false; }
            qid.DefId owner = jil.function_provenance_def(ctx.jil.program.function(id).origin);
            target = .generated(jil.GeneratedFunctionTarget(id = id, provenance_def = owner));
        }
        if (!borrow.run_function(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.jil$.ref(), target)) { return false; }
    }
    return true;
}

Bool prepare_eval_drops(
    context.CompilerContext&! ctx, jil.MonoItem item, bindings_api.GenericBindings& expression_bindings,
    list.ArrayList<jil.MonoItem>&! pending, set.HashSet<Int>&! seen, set.HashSet<Int>&! seen_globals,
    list.ArrayList<jil.GlobalId>&! globals, Bool implementation_key
) {
    list.ArrayList<jil.FunctionId> glues! = list.ArrayList<jil.FunctionId>();
    if (item is .source_instance(identity)) {
        glues = drop_elaborate.prepare_instance_drop_glues(
            ctx.store$.ref(), ctx.query.layout$.mut_ref(), ctx.jil.storage$.ref(),
            ctx.jil.program$.mut_ref(), ctx.jil.drop_elaboration$.mut_ref(), identity
        );
    } else if (item is .generated_function(id)) {
        if (jil.function_is_eval_expression(ctx.jil.program.function(id).origin)) {
            glues = drop_elaborate.prepare_expression_drop_glues(
                ctx.store$.ref(), ctx.query.layout$.mut_ref(), ctx.jil.storage$.ref(),
                ctx.jil.program$.mut_ref(), ctx.jil.drop_elaboration$.mut_ref(), id, expression_bindings
            );
        } else {
            drop_elaborate.prepare_function_drops(
                ctx.store$.ref(), ctx.query.layout$.mut_ref(), ctx.jil.storage$.ref(),
                ctx.jil.program$.mut_ref(), ctx.jil.drop_elaboration$.mut_ref(), id
            );
            append_eval_references(ctx, item, expression_bindings, pending, seen,
                seen_globals, globals, implementation_key);
        }
    }
    Int index! = 0;
    while (index < glues.len()) {
        append_eval_item(.generated_function(glues.get(index)), pending, seen);
        index = index + 1;
    }
    return !ctx.jil.program.has_errors() && !ctx.query.layout.has_errors();
}

Void append_eval_item(jil.MonoItem item, list.ArrayList<jil.MonoItem>&! pending, set.HashSet<Int>&! seen) {
    Int identity = jil.mono_item_identity(item);
    if (seen.has(identity)) { return; }
    seen.add(identity);
    pending.add(item);
}

Void append_eval_references(
    context.CompilerContext&! ctx, jil.MonoItem item, bindings_api.GenericBindings& expression_bindings,
    list.ArrayList<jil.MonoItem>&! pending, set.HashSet<Int>&! seen, set.HashSet<Int>&! seen_globals,
    list.ArrayList<jil.GlobalId>&! globals, Bool implementation_key
) {
    references.References dependencies = collect_eval_references(ctx, item, expression_bindings);
    append_eval_dependencies(ctx, dependencies, pending, seen, seen_globals, globals, implementation_key);
}

#doc 先准备局部编译期值，再以完整绑定发现调用及元数据依赖；无求值依赖时只遍历一次。
references.References? prepare_eval_metadata(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, jil.MonoItem item,
    bindings_api.GenericBindings& expression_bindings,
    Fn<Bool, context.CompilerContext&!, jil.FunctionId, Int, types.GenericArg[]&> compute_value
) {
    references.References dependencies! = collect_eval_references(ctx, item, expression_bindings);
    if (!dependencies.eval_expressions.empty()) {
        if (!prepare_eval_values(ctx, item, expression_bindings, dependencies$.mut_ref(), compute_value)) {
            return null;
        }
        list.ArrayList<jil.GlobalId> globals = dependencies.globals.take();
        dependencies = collect_eval_references(ctx, item, expression_bindings);
        Int index! = 0;
        while (index < globals.len()) {
            dependencies.globals.add(globals.get(index));
            index = index + 1;
        }
    }
    if (!lower.ensure_eval_metadata(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output,
        graph, ctx.jil$.mut_ref(), item, dependencies$.ref())) { return null; }
    return dependencies;
}

#doc 以表达式模板实参替换当前绑定形成规范实例键，递归求值不持有 Program 的可变借用。
Bool prepare_eval_values(context.CompilerContext&! ctx, jil.MonoItem item,
    bindings_api.GenericBindings& expression_bindings, references.References&! dependencies,
    Fn<Bool, context.CompilerContext&!, jil.FunctionId, Int, types.GenericArg[]&> compute_value) {
    if (dependencies.eval_expressions.empty()) { return true; }
    bindings_api.GenericBindings bindings! = bindings_api.GenericBindings();
    bindings_api.GenericBindings& concrete! = expression_bindings;
    if (item is .source_instance(identity)) {
        jil.InstanceKey instance = ctx.jil.program.function_instance_at(identity);
        bindings = bindings_api.bindings_for_instance(ctx.store.defs$.ref(), ctx.store.model$.ref(),
            ctx.store.types$.ref(), instance.def_id, instance.args, expression_bindings);
        concrete = bindings$.ref();
    }
    Int index! = 0;
    while (index < dependencies.eval_expressions.len()) {
        jil.FunctionId expression = dependencies.eval_expressions.get(index);
        index = index + 1;
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        qid.DefId owner;
        {
            jil.Function function = ctx.jil.program.function(expression);
            owner = jil.function_provenance_def(function.origin);
            instance_reader.InstanceReader reader = instance_reader.InstanceReader(ctx.store$.ref(), concrete);
            args = reader.generic_args(function.args);
        }
        Int instance = ctx.jil.program.function_instance_identity(ctx.jil.storage$.ref(), owner, args.slice());
        query_cache.QueryCacheState<jil.GlobalId?> state = ctx.jil.program.request_eval_result(expression, instance);
        if (state is .ready(result)) {
            if (result == null) { return false; }
            dependencies.globals.add(result$.some());
            continue;
        }
        if (state is .evaluating) {
            source_map.SourceLoc loc = eval_expression_location(ctx$.ref(), expression);
            diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), loc,
                "constant expression depends on its own evaluation", "comptime_dependency_cycle");
            return false;
        }
        Int diagnostic_begin = ctx.store.diagnostics.len();
        if (!compute_value(ctx$.mut_ref(), expression, instance, args.slice())) {
            ctx.jil.program.fail_eval_result(expression, instance);
            report_const_eval_failure(ctx, expression, diagnostic_begin);
            return false;
        }
        dependencies.globals.add(ctx.jil.program.eval_result_global(expression, instance)$.some());
    }
    return true;
}

#doc 补齐运行期 body、const 与异步模板依赖；只为模板准备 body 不将其标记为运行期发射根。
public Bool prepare_runtime_eval(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    Int cursor! = 0;
    Int global_cursor! = 0;
    Int template_cursor! = 0;
    while (cursor < ctx.jil.program.mono_item_count() || global_cursor < ctx.jil.program.runtime_global_count()
        || template_cursor < ctx.jil.program.source_function_count()) {
        Int previous_items = ctx.jil.program.mono_item_count();
        Int previous_globals = ctx.jil.program.runtime_global_count();
        while (cursor < previous_items) {
            jil.MonoItem item = ctx.jil.program.mono_item_at(cursor);
            if (item is .source_instance(identity)) {
                qid.DefId target = ctx.jil.program.function_instance_at(identity).def_id;
                if (!ctx.jil.program.has_source_function(target)) {
                    if (!prepare_eval_source(ctx, graph, target)) { return false; }
                    lower.close_runtime_references(ctx, graph, previous_globals, cursor);
                    if (ctx.jil.program.has_errors()) { return false; }
                }
            }
            cursor = cursor + 1;
            jil.Function function;
            if (item is .source_instance(identity)) {
                function = ctx.jil.program.source_function(ctx.jil.program.function_instance_at(identity).def_id);
            } else {
                guard item is .generated_function(id) else { assert(false); return false; }
                function = ctx.jil.program.function(id);
            }
            // 此处只消费 eval 表达式与静态 global 身份；普通 callee 的实例绑定已由引用发现处理。
            // eval 表达式自身的泛型绑定仍由 prepare_eval_values 按当前实例计算。
            references.References dependencies! = references.collect_function_refs(function);
            if (dependencies.eval_expressions.empty()) { continue; }
            bindings_api.GenericBindings empty! = bindings_api.GenericBindings();
            if (!prepare_eval_values(ctx, item, empty$.ref(), dependencies$.mut_ref(),
                { [ref graph] eval_ctx, expression, instance, args =>
                    if (!prepare_graph_eval(eval_ctx, graph, .generated_function(expression), args)) { return false; }
                    guard execute_prepared_expression(eval_ctx, graph, expression, args)
                        is .some(result) else { return false; }
                    publish_eval_result(eval_ctx, graph, expression, instance, result)
                })) { return false; }
            Int index! = 0;
            while (index < dependencies.globals.len()) {
                jil.GlobalId global = dependencies.globals.get(index);
                qid.TypeId type_id = ctx.jil.program.globals.get(global.to_index()).type_id;
                if (!(ctx.store.types.get(type_id).data is .unit)) {
                    ctx.jil.program.mark_runtime_global(global);
                }
                index = index + 1;
            }
            lower.close_runtime_references(ctx, graph, ctx.jil.program.runtime_global_count(), cursor - 1);
            if (ctx.jil.program.has_errors()) { return false; }
        }
        Int global_begin = global_cursor;
        while (global_cursor < ctx.jil.program.runtime_global_count()) {
            jil.GlobalId id = ctx.jil.program.runtime_global_at(global_cursor);
            global_cursor = global_cursor + 1;
            if (!prepare_runtime_global(ctx, graph, id)) { return false; }
        }
        if (global_cursor > global_begin) {
            lower.close_runtime_references(ctx, graph, global_begin, previous_items);
            if (ctx.jil.program.has_errors()) { return false; }
        }
        while (template_cursor < ctx.jil.program.source_function_count()) {
            list.ArrayList<lower.TemplateAsyncDependency> dependencies = lower.template_async_dependencies(
                ctx.jil.program.source_function_at(template_cursor));
            template_cursor = template_cursor + 1;
            Int index! = 0;
            while (index < dependencies.len()) {
                qid.DefId target = dependencies.get(index).target_def;
                index = index + 1;
                if (ctx.jil.program.has_source_function(target)) { continue; }
                if (!prepare_eval_source(ctx, graph, target)) { return false; }
            }
        }
    }
    return true;
}

#doc
    调用方已完成初始借用检查。drop 新发现的普通 body 由编译层恢复并检查，
    依赖闭包稳定后才验证最终 JIL；JIL pass 不反向调用 Sema。
#end
public Bool prepare_runtime_drops(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    Bool verify_output) {
    while (true) {
        Int items = ctx.jil.program.mono_item_count();
        Int globals = ctx.jil.program.runtime_global_count();
        drop_elaborate.elaborate_package(ctx.store$.mut_ref(), ctx.query.layout$.mut_ref(), ctx.jil$.mut_ref());
        if (ctx.jil.program.has_errors()) { return false; }
        lower.lower_drop_references(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output,
            graph, ctx.jil$.mut_ref(), items);
        if (ctx.jil.program.has_errors()) { return false; }
        if (items == ctx.jil.program.mono_item_count() && globals == ctx.jil.program.runtime_global_count()) {
            return verifier.verify(ctx.store$.mut_ref(), ctx.jil$.mut_ref(), .drop_output, verify_output);
        }
        Int templates = ctx.jil.program.source_function_count();
        if (!prepare_runtime_eval(ctx, graph)) { return false; }
        if (templates != ctx.jil.program.source_function_count()) {
            lower.finish_runtime_package(ctx, graph);
            if (ctx.jil.program.has_errors() || !prepare_runtime_eval(ctx, graph)) { return false; }
        }
        if (!borrow.run_package(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.jil$.ref(), false)) { return false; }
    }
    return false;
}

#doc 全局存储沿用静态初始化；非字面量复用 JIL 求值与 borrow/drop，不将求值 helper 加入发射根。
Bool prepare_runtime_global(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, jil.GlobalId id) {
    jil.Global global = ctx.jil.program.globals.get(id.to_index());
    if (global.is_external || global.read_only) { return true; }
    guard global.origin is .source(owner) else { return true; }
    if (!ensure_body_checked(ctx, graph, owner) || !lower.ensure_checked_global(ctx, graph, id)) { return false; }
    if (ctx.jil.program.globals.get(id.to_index()).initializer != null) { return true; }
    guard ctx.store.model.body_root(owner) is .some(root) else { return true; }
    value.ComptimeValue? result = evaluate_checked_expression(ctx, graph, root, global.type_id);
    if (result != null && lower.ensure_checked_global(ctx, graph, id, result)) { return true; }
    source_map.SourceLoc loc! = source_map.SourceLoc(global.span);
    if (ctx.store.source_map.def_span(owner) is .some(location)) { loc = location; }
    diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), loc,
        "global initializer must produce a static comptime value", "global_initializer_not_constant");
    return false;
}

#doc 已完成求值的结果经共同 lowering 发布；执行方保留其 resolver 或已发现 graph 的准备权限。
Bool publish_eval_result(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    jil.FunctionId expression, Int instance, value.ComptimeValue result) {
    return lower.materialize_eval_result(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output,
        graph, ctx.jil$.mut_ref(), expression, instance, result) != null;
}

#doc 编译表达式的位置来自 JIL 的来源声明和表达式 span，不依赖临时 AST。
source_map.SourceLoc eval_expression_location(context.CompilerContext& ctx, jil.FunctionId expression) {
    jil.Function function = ctx.jil.program.function(expression);
    qid.DefId owner = jil.function_provenance_def(function.origin);
    source_map.SourceLoc loc! = source_map.SourceLoc(function.span);
    if (ctx.store.defs.get(owner).module_id is .some(module_id)) {
        loc = source_map.SourceLoc(ctx.store.resolve.module_ref(module_id).source_id, function.span);
    }
    return loc;
}

#doc const 初始化要求覆盖依赖准备、借用检查和执行失败；循环附加实际失败表达式的位置。
Void report_const_eval_failure(context.CompilerContext&! ctx, jil.FunctionId expression, Int begin) {
    source_map.SourceLoc loc = eval_expression_location(ctx$.ref(), expression);
    if (loc.source_id is .some(source_id)) {
        diagnostic_helper.add_related_since(ctx.store.diagnostics$.mut_ref(), begin,
            "comptime_dependency_cycle", diagnostic_api.SourceRange(source_id, loc.span),
            "while evaluating comptime expression");
    }
    diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), loc,
        "const initializer must produce a comptime value", "const_initializer_not_constant");
}

references.References collect_eval_references(
    context.CompilerContext& ctx, jil.MonoItem item, bindings_api.GenericBindings& expression_bindings
) {
    bindings_api.GenericBindings empty! = bindings_api.GenericBindings();
    references.References dependencies!;
    if (item is .source_instance(identity)) {
        jil.InstanceKey instance = ctx.jil.program.function_instance_at(identity);
        bindings_api.GenericBindings bindings! = bindings_api.bindings_for_instance(
            ctx.store.defs$.ref(), ctx.store.model$.ref(), ctx.store.types$.ref(),
            instance.def_id, instance.args, empty$.ref()
        );
        instance_reader.bind_eval_constants(ctx.store$.ref(), ctx.jil.program$.ref(),
            instance.def_id, bindings$.mut_ref());
        dependencies = references.collect_instance_function_refs(
            ctx.store$.ref(), bindings$.ref(), ctx.jil.program.source_function(instance.def_id)
        );
    } else {
        guard item is .generated_function(id) else { assert(false); return references.References(); }
        jil.Function function = ctx.jil.program.function(id);
        if (jil.function_is_eval_expression(function.origin)) {
            dependencies = references.collect_instance_function_refs(ctx.store$.ref(), expression_bindings, function);
        } else {
            dependencies = references.collect_instance_function_refs(ctx.store$.ref(), empty$.ref(), function);
        }
    }
    return dependencies;
}

Void append_eval_dependencies(
    context.CompilerContext&! ctx, references.References dependencies!,
    list.ArrayList<jil.MonoItem>&! pending, set.HashSet<Int>&! seen, set.HashSet<Int>&! seen_globals,
    list.ArrayList<jil.GlobalId>&! globals, Bool implementation_key
) {
    append_eval_function_references(ctx, dependencies$.ref(), pending, seen);
    Int closure_index! = 0;
    while (closure_index < dependencies.functions.len()) {
        references.FunctionReference& reference = dependencies.functions.ref_at(closure_index);
        if (reference.closure is .some(closure)) {
            guard ctx.jil.program.closure_vtable_global(closure.lambda_def, reference.args.slice(),
                closure.environment_storage == .heap) is .some(id) else { assert(false); return; }
            dependencies.globals.add(id);
        }
        closure_index = closure_index + 1;
    }
    Int table_index! = 0;
    while (table_index < dependencies.raw_fn_vtables.len()) {
        qid.TypeId raw_type = dependencies.raw_fn_vtables.get(table_index);
        guard ctx.jil.program.raw_fn_vtable_global(raw_type) is .some(id) else { assert(false); return; }
        dependencies.globals.add(id);
        table_index = table_index + 1;
    }
    Int global_cursor! = 0;
    table_index = 0;
    while (table_index < dependencies.trait_vtables.len()) {
        jil.TraitVTableRef reference = dependencies.trait_vtables.get(table_index);
        guard ctx.jil.program.trait_vtable_global(reference.key) is .some(id) else { assert(false); return; }
        dependencies.globals.add(id);
        table_index = table_index + 1;
    }
    while (global_cursor < dependencies.globals.len()) {
        jil.GlobalId id = dependencies.globals.get(global_cursor);
        global_cursor = global_cursor + 1;
        if (seen_globals.has(id.to_index())) { continue; }
        seen_globals.add(id.to_index());
        if (implementation_key) { globals.add(id); }
        references.References children = references.collect_global_refs(ctx.jil.program.globals.get(id.to_index()));
        append_eval_function_references(ctx, children$.ref(), pending, seen);
        Int index! = 0;
        while (index < children.globals.len()) {
            dependencies.globals.add(children.globals.get(index));
            index = index + 1;
        }
    }
}

#doc 普通函数和静态表中的函数引用共用求值队列，静态表遍历不改变运行期发射根。
Void append_eval_function_references(
    context.CompilerContext&! ctx, references.References& dependencies,
    list.ArrayList<jil.MonoItem>&! pending, set.HashSet<Int>&! seen
) {
    Int index! = 0;
    while (index < dependencies.functions.len()) {
        references.FunctionReference& dependency = dependencies.functions.ref_at(index);
        Int identity = ctx.jil.program.function_instance_identity(
            ctx.jil.storage$.ref(), dependency.def_id, dependency.args.slice()
        );
        append_eval_item(.source_instance(identity), pending, seen);
        index = index + 1;
    }
    index = 0;
    while (index < dependencies.generated_functions.len()) {
        append_eval_item(.generated_function(dependencies.generated_functions.get(index)), pending, seen);
        index = index + 1;
    }
}

public value.ComptimeValue? evaluate_function(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph,
    qid.DefId function_def, types.GenericArg[]& generic_args, value.ComptimeValue[]& args
) {
    if (!prepare_function(ctx, resolver, graph, function_def, generic_args)) { return null; }
    return execute_with_metadata(ctx,
        { [function_def, ref generic_args, ref args] eval_ctx, steps =>
            executor.evaluate_function_step(eval_ctx.store$.mut_ref(), eval_ctx.query$.mut_ref(),
                eval_ctx.jil$.ref(), function_def, generic_args, args, steps) },
        { [ref! resolver, ref! graph] eval_ctx, target => prepare_metadata_target(eval_ctx, resolver, graph, target) });
}

#doc 表达式只检查本次 root，不借由 owner body check 提前执行或发布整个 const initializer。
public value.ComptimeValue? evaluate_expression(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph,
    sem.NodeId root, types.GenericArg[]& generic_args, qid.TypeId? expected = null
) {
    if (!resolver.ensure_declaration_model(ctx, graph, root.owner_def)) { return null; }
    return evaluate_model_expression(ctx, resolver, graph, root, generic_args, expected);
}

#doc 已由 resolve 发布的独立表达式可以属于 module，不要求 owner 是带 body 的普通声明。
public value.ComptimeValue? evaluate_model_expression(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver, module_graph.ModuleGraph&! graph,
    sem.NodeId root, types.GenericArg[]& generic_args, qid.TypeId? expected = null
) {
    if (!prepare_type_models(ctx, resolver, graph, root.owner_def)) { return null; }
    guard type_check.check_expression(ctx, graph.root_module,
        { [ref! resolver, ref! graph] eval_ctx, node, target =>
            evaluate_checked_expression(eval_ctx, resolver, graph, node, target) },
        root, expected
    ) is .some(result_type) else { return null; }
    guard lower.ensure_expression(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, ctx.jil$.mut_ref(), root, result_type
    ) is .some(expression) else { return null; }
    if (prepare_resolved_eval(ctx, resolver, graph, .generated_function(expression), generic_args) == null) { return null; }
    return execute_prepared_expression(ctx, resolver, graph, expression, generic_args);
}

#doc 生成入口沿普通求值路径准备一次，并直接取该次准备的执行闭包指纹。
public qkey.Fingerprint128? prepare_function_implementation(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, qid.DefId function_def, types.GenericArg[]& generic_args
) {
    Int root = ctx.jil.program.function_instance_identity(ctx.jil.storage$.ref(), function_def, generic_args);
    return prepare_resolved_eval(ctx, resolver, graph, .source_instance(root), generic_args, true, true);
}

#doc 可达顺序由既有依赖收集器确定；不遍历整包或其他求值任务已经生成的 JIL。
qkey.Fingerprint128 prepared_implementation_fingerprint(
    context.CompilerContext&! ctx, jil.MonoItem[]& items, jil.GlobalId[]& globals
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>();
    list.ArrayList<qid.TypeId> layouts! = list.ArrayList<qid.TypeId>();
    for item in items {
        jil.Function function;
        if (item is .source_instance(identity)) {
            function = instance_reader.source_instance_function(ctx.store$.ref(), ctx.jil.program$.ref(), identity);
            _ definition = ctx.jil.program.function_instance_at(identity).def_id;
            parts.add(ctx.query.checked_signature_fingerprint(ctx.store$.ref(), definition)$.some());
        } else {
            guard item is .generated_function(id) else { assert(false); return qkey.Fingerprint128(); }
            function = ctx.jil.program.function(id);
        }
        parts.add(fingerprint.jil_function_fingerprint(ctx$.ref(), ctx.jil$.ref(), function, true));
        _ required = type_requirements.collect_function_types(ctx.store$.ref(), ctx.jil$.ref(), item);
        for type in required.slice() { layouts.add(type); }
    }
    for global in globals {
        layouts.add(ctx.jil.program.globals.get(global.to_index()).type_id);
        parts.add(fingerprint.jil_global_fingerprint(ctx$.ref(), ctx.jil.program$.ref(),
            ctx.jil.program.globals.get(global.to_index())));
    }
    parts.add(key_builder.stable_type_layout_hash(ctx, layouts.slice()));
    return object_key.combine_fingerprints(UInt64(163), parts$.ref());
}

public Bool prepare_function(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph,
    qid.DefId function_def, types.GenericArg[]& generic_args
) {
    Int root = ctx.jil.program.function_instance_identity(ctx.jil.storage$.ref(), function_def, generic_args);
    return prepare_resolved_eval(ctx, resolver, graph, .source_instance(root), generic_args) != null;
}

qkey.Fingerprint128? prepare_resolved_eval(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, jil.MonoItem root, types.GenericArg[]& root_args,
    Bool require_all_args = true, Bool implementation_key = false
) {
    return prepare_eval_dependencies(ctx, root, root_args,
        { [ref! resolver, ref! graph] eval_ctx, item, bindings =>
            if (item is .source_instance(identity)) {
                qid.DefId function_def = eval_ctx.jil.program.function_instance_at(identity).def_id;
                if (!prepare_eval_source(eval_ctx, resolver, graph, function_def)) { return null; }
            }
            if (reflected_definition(eval_ctx, item) is .some(definition)) {
                if (!prepare_type_models(eval_ctx, resolver, graph, definition)) { return null; }
            }
            prepare_eval_metadata(eval_ctx, graph, item, bindings,
                { [ref! resolver, ref! graph] nested_ctx, expression, instance, arguments =>
                    if (prepare_resolved_eval(nested_ctx, resolver, graph,
                        .generated_function(expression), arguments) == null) { return false; }
                    guard execute_prepared_expression(nested_ctx, resolver, graph, expression, arguments)
                        is .some(result) else { return false; }
                    publish_eval_result(nested_ctx, graph, expression, instance, result)
                })
        }, require_all_args, implementation_key
    );
}

#doc resolver 权限只用于准备源码依赖，派生元数据继续由 JIL lowering 负责。
Bool prepare_eval_source(
    context.CompilerContext&! eval_ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, qid.DefId function_def
) {
    if (!resolver.ensure_declaration_model(eval_ctx, graph, function_def)) { return false; }
    if (!restore_declaration_body(eval_ctx, function_def)) { return false; }
    if (!prepare_type_models(eval_ctx, resolver, graph, function_def)) { return false; }
    if (!type_check.ensure_body_checked(eval_ctx, graph.root_module,
        { [ref! resolver, ref! graph] nested_ctx, node, target =>
            evaluate_checked_expression(nested_ctx, resolver, graph, node, target)
        }, function_def
    )) { return false; }
    return lower.ensure_checked_source_function(
        eval_ctx.store$.mut_ref(), eval_ctx.query$.mut_ref(), eval_ctx.output,
        graph, eval_ctx.jil$.mut_ref(), function_def
    );
}

#doc
    为 typecheck 准备字段、被调用函数签名及其类型；这些声明不能只有名字 skeleton。
    只遍历本次依赖的 Semantic Model 节点，不扫描源文件 AST，也不请求 callee/member body。
#end
public Bool prepare_type_models(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, qid.DefId root
) {
    list.ArrayList<qid.DefId> pending! = list.ArrayList<qid.DefId>();
    set.HashSet<qid.DefId> visited! = set.HashSet<qid.DefId>();
    pending.add(root);
    Int cursor! = 0;
    while (cursor < pending.len()) {
        qid.DefId current = pending.get(cursor);
        cursor = cursor + 1;
        if (visited.has(current) || !ctx.store.model.has_def(current)) { continue; }
        visited.add(current);
        if (requires_signature(ctx.store.defs.get(current).kind)
            && ctx.store.model.declaration_sema_state(current) == .skeleton) {
            if (!resolver.ensure_declaration_signature(ctx, graph, current)) {
                if (!ctx.store.diagnostics.has_errors()) {
                    source_map.SourceLoc location! = source_map.SourceLoc(token.Span());
                    if (ctx.store.source_map.def_span(current) is .some(found)) { location = found; }
                    diagnostics.add_error_at_loc(ctx.store.diagnostics$.mut_ref(), location,
                        "eval type dependency has no available declaration signature", "comptime_dependency_not_ready");
                }
                return false;
            }
        }
        // const 和字段默认值属于定义数据；仅有签名时，缺失的 initializer 不能被当成源码没有提供。
        Bool initializer = ctx.store.defs.get(current).kind == .field_def
            || (ctx.store.model.def_decl_kind(current) == .global_decl && ctx.store.model.def_is_const(current));
        if (initializer) {
            if (!resolver.ensure_declaration_model(ctx, graph, current)) { return false; }
        }
        collect_type_model_dependencies(ctx, current, pending$.mut_ref());
    }
    // 字段/成员签名先全部发布；约束检查随后复用最终 sweep 的入口，不能边发现边封存不完整结论。
    cursor = pending.len();
    while (cursor > 0) {
        cursor = cursor - 1;
        qid.DefId current = pending.get(cursor);
        if (!ctx.store.model.has_def(current) || !requires_signature(ctx.store.defs.get(current).kind)) { continue; }
        if (!type_check.ensure_declaration_checked(ctx, graph.root_module,
            { [ref! resolver, ref! graph] eval_ctx, node, target =>
                evaluate_checked_expression(eval_ctx, resolver, graph, node, target)
            },
            current
        )) { return false; }
    }
    return true;
}

Bool requires_signature(def.DefKind kind) {
    return kind == .alias_def || kind == .struct_def || kind == .enum_def || kind == .trait_def
        || kind == .function_def || kind == .init_def || kind == .deinit_def || kind == .global_def
        || kind == .field_def || kind == .enum_case_def || kind == .associated_type_def;
}

Void collect_type_model_dependencies(
    context.CompilerContext& ctx, qid.DefId current, list.ArrayList<qid.DefId>&! pending
) {
    sem.Def& model = ctx.store.model.def_ref(current);
    if (model.decl.alias_target is .some(target)) { pending.add(target); }
    Int index! = 0;
    while (index < model.nodes.len()) {
        sem.Node node = model.nodes.get(index);
        if (node.data is .named_type_ref(named)) { pending.add(named.def_id); }
        if (node.data is .name_ref(name)) {
            if (name is .def_ref(target)) { pending.add(target); }
        }
        index = index + 1;
    }
    index = 0;
    def.DefKind owner_kind = ctx.store.defs.get(current).kind;
    if (owner_kind != .struct_def && owner_kind != .enum_def && owner_kind != .enum_case_def
        && owner_kind != .trait_def) { return; }
    while (index < model.members.len()) {
        qid.DefId member = model.members.get(index);
        pending.add(member);
        index = index + 1;
    }
}
