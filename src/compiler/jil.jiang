// JIL 阶段的稳定入口。
//
// 外部阶段只从这里读取 JIL 数据模型；具体模型声明和 pass 实现保留在 jil/ 目录。

public alias * = import "./jil/model/id.jiang";
public alias * = import "./jil/model/place.jiang";
public alias * = import "./jil/model/coroutine.jiang";
public alias * = import "./jil/model/value.jiang";
public alias * = import "./jil/model/control_flow.jiang";
public alias * = import "./jil/model/program.jiang";
public alias * = import "./jil/model/store.jiang";
