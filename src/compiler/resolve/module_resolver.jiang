// 模块级 resolve 驱动。
//
// ModuleResolver 负责 graph 完成后的 declaration/Semantic Model lowering。
// ModuleGraphBuilder 负责 module shell 创建和 import target discovery；
// NameResolver 只处理已经有 ModuleId/NamespaceId 的单个文件。

alias context = import "../context.jiang";
alias db = import "../db.jiang";
alias artifact = import "../artifact/source.jiang";
alias cache_identity = import "../artifact/cache_identity.jiang";
alias artifact_path = import "../artifact/path.jiang";
alias interface_builder = import "../artifact/interface_builder.jiang";
alias driver_options = import "../driver/options.jiang";
alias source_fingerprint = import "../artifact/source_fingerprint.jiang";
alias source_ji = import "../artifact/source_ji.jiang";
alias incremental_fingerprint = import "../incremental/fingerprint.jiang";
alias source_graph = import "../incremental/source_graph.jiang";
alias system_time = import "../system/time.jiang";
alias sem = import "../sema/model.jiang";
alias comptime_value = import "../sema/comptime/value.jiang";
alias qid = import "../id.jiang";
alias qkey = import "../incremental/key.jiang";
alias source = import "../source.jiang";
alias package_load = import "../source/package_load.jiang";
alias list = import "../support/list.jiang";
alias map = import "../support/map.jiang";
alias set = import "../support/set.jiang";
alias string = import "../support/string.jiang";
alias table = import "../support/table.jiang";
alias ast = import "../syntax/ast.jiang";
alias token = import "../syntax/token.jiang";
alias def = import "./def.jiang";
alias diagnostics = import "./diagnostics.jiang";
alias reference_resolver = import "./reference_resolver.jiang";
alias model_lower = import "./model_lower.jiang";
alias interface_loader = import "./interface_loader.jiang";
alias module_graph = import "./module_graph.jiang";
alias module_graph_builder = import "./module_graph_builder.jiang";
alias name_resolver = import "./name_resolver.jiang";
alias namespace = import "./namespace.jiang";
alias resolve_state = import "./state.jiang";
alias store = import "./store.jiang";
import std;

// 仅在 --jil-stats 下累计 interface 恢复各子阶段，用于定位增量构建热点。
public struct ModelTiming: Copyable {
    public UInt64 prepare_ns! = UInt64(0);
    public UInt64 freshness_ns! = UInt64(0);
    public UInt64 bindings_ns! = UInt64(0);
    public UInt64 skeletons_ns! = UInt64(0);
    public UInt64 declarations_ns! = UInt64(0);
    public UInt64 facts_ns! = UInt64(0);
    public UInt64 bodies_ns! = UInt64(0);
    public UInt64 store_ns! = UInt64(0);
    public UInt64 finalize_ns! = UInt64(0);

    public Void add_prepare(Self&! self, UInt64 elapsed) { self.prepare_ns = self.prepare_ns + elapsed; }
    public Void add_freshness(Self&! self, UInt64 elapsed) { self.freshness_ns = self.freshness_ns + elapsed; }
    public Void add_bindings(Self&! self, UInt64 elapsed) { self.bindings_ns = self.bindings_ns + elapsed; }
    public Void add_skeletons(Self&! self, UInt64 elapsed) { self.skeletons_ns = self.skeletons_ns + elapsed; }
    public Void add_declarations(Self&! self, UInt64 elapsed) {
        self.declarations_ns = self.declarations_ns + elapsed;
    }
    public Void add_facts(Self&! self, UInt64 elapsed) { self.facts_ns = self.facts_ns + elapsed; }
    public Void add_bodies(Self&! self, UInt64 elapsed) { self.bodies_ns = self.bodies_ns + elapsed; }
    public Void add_store(Self&! self, UInt64 elapsed) { self.store_ns = self.store_ns + elapsed; }
    public Void add_finalize(Self&! self, UInt64 elapsed) { self.finalize_ns = self.finalize_ns + elapsed; }
}

// 跨 graph discovery、lang preparation 和 model lowering 保存的 owned state。
// CompilerContext 只由每次操作创建的 ModuleResolvePhase 临时借用。
public struct ModuleResolver: Movable {
    RawFn<comptime_value.ComptimeValue?, context.CompilerContext&!, ModuleResolver&!,
        module_graph.ModuleGraph&!, sem.NodeId, qid.TypeId> evaluate_expression;
    RawFn<Bool, context.CompilerContext&!, ModuleResolver&!,
        module_graph.ModuleGraph&!, qid.DefId, artifact.ObservationAspect>?
        prepare_observed_fact;
    map.WyHashMap<source.SourceId, ast.AstUnit> asts!;
    map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState> module_states!;
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs!;
    map.WyHashMap<qid.DefId, ast.AstId> declaration_items!;
    map.WyHashMap<qid.DefId, ast.AstId> declaration_containers!;
    set.HashSet<qid.ModuleId> extension_skeletons!;
    std.String artifact_cache_dir!;
    UInt64 compiler_version_hash;
    Bool use_source_artifacts!;
    qid.PackageId? required_source_package!;
    Bool core_declarations_bound!;
    Bool timing_enabled;
    ModelTiming timing!;
    driver_options.CompileMode mode;

    public init(self,
        RawFn<comptime_value.ComptimeValue?, context.CompilerContext&!, ModuleResolver&!,
            module_graph.ModuleGraph&!, sem.NodeId, qid.TypeId> evaluate_expression,
        UInt8[]& artifact_cache_dir = "build/cache",
        UInt64? compiler_version_hash = null,
        Bool use_source_artifacts = true,
        driver_options.CompileMode? mode = null,
        Bool timing_enabled = false,
        RawFn<Bool, context.CompilerContext&!, ModuleResolver&!,
            module_graph.ModuleGraph&!, qid.DefId, artifact.ObservationAspect>?
            prepare_observed_fact = null
    ) {
        self.evaluate_expression = evaluate_expression;
        self.prepare_observed_fact = prepare_observed_fact;
        self.asts = map.WyHashMap<source.SourceId, ast.AstUnit>();
        self.module_states = map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();
        self.declaration_items = map.WyHashMap<qid.DefId, ast.AstId>();
        self.declaration_containers = map.WyHashMap<qid.DefId, ast.AstId>();
        self.extension_skeletons = set.HashSet<qid.ModuleId>();
        self.artifact_cache_dir = std.String.from_valid_utf8(artifact_cache_dir);
        if (compiler_version_hash is .some(hash)) {
            self.compiler_version_hash = hash;
        } else {
            self.compiler_version_hash = source_ji.artifact_version_hash(
                driver_options.compiler_version()
            );
        }
        self.use_source_artifacts = use_source_artifacts;
        self.required_source_package = null;
        self.core_declarations_bound = false;
        self.timing_enabled = timing_enabled;
        self.timing = ModelTiming();
        if (mode is .some(compile_mode)) {
            self.mode = compile_mode;
        } else {
            self.mode = .debug;
        }
    }

    #doc 包信息求值后接入正式缓存上下文，重新核验源码状态而不重建声明和常量。
    public Void configure_source_artifacts(Self&! self, context.CompilerContext&! ctx,
        UInt8[]& directory, Bool enabled) {
        self.artifact_cache_dir = std.String.from_valid_utf8(directory);
        self.use_source_artifacts = enabled;
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        module_graph_builder.ModuleGraphBuilder builder! = phase.graph_builder();
        builder.refresh_source_dependencies();
    }

    public Void add_ast(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.asts.set(source_id, unit);
    }

    // 文档工具需要当前 package 的精确 source span；依赖 package 仍可恢复 interface。
    public Void require_source_package(Self&! self, qid.PackageId package_id) {
        self.required_source_package = package_id;
    }

    public module_graph.ModuleGraph^ build_module_graph(
        Self&! self,
        context.CompilerContext&! ctx,
        ast.AstUnit unit
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.build_module_graph(unit);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.build_module_graph_for_source(source_id);
    }

    public module_graph.ModuleGraph^ begin_module_graph(
        Self&! self,
        context.CompilerContext&! ctx,
        ast.AstUnit unit
    ) {
        source.SourceId source_id = unit.source_id;
        self.add_ast(unit);
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.begin_module_graph_for_source(source_id);
    }

    public Void seal_module_graph(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        phase.seal_module_graph(graph);
    }

    public Bool prepare_root_entry_environment(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.prepare_root_entry_environment(graph);
    }

    // 正常编译在封闭全部 import 之前先请求 root main 的 signature。
    // signature 中实际读取的 import 会通过同一 graph 立即展开；最终 seal
    // 只补齐未使用 import，保证完整源码验证语义不变。
    public Bool ensure_root_entry_signature(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_root_entry_signature(graph);
    }

    public Bool ensure_root_entry_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_root_entry_model(graph);
    }

    public Bool lower_module_graph_to_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.lower_module_graph_to_model(graph);
    }

    public ModelTiming model_timing(self) {
        return self.timing;
    }

    public Void fingerprint_module_graph_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        phase.fingerprint_module_graph_model(graph);
    }

    public Void finalize_module_graph_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        phase.finalize_module_graph_model(graph);
    }

    public Bool ensure_module_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_module_model(graph, module_id);
    }

    // 只推进一个顶层 declaration 的 reference resolve 和 Semantic Model
    // lowering；CLI 的完整编译仍由 lower_module_graph_to_model 做最终 sweep。
    public Bool ensure_declaration_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph,
        qid.DefId def_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_declaration_model(graph, def_id);
    }

    public Bool ensure_module_metadata(Self&! self, context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph, qid.ModuleId module
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_module_metadata(graph, module);
    }

    public Bool ensure_declaration_signature(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph,
        qid.DefId def_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_declaration_signature(graph, def_id);
    }

    public qid.ModuleId ensure_module(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_module(source_id);
    }

    public qid.ModuleId ensure_declarations(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_declarations(source_id);
    }

    public Bool ensure_import_target(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id,
        Int import_index
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_import_target(graph, module_id, import_index);
    }
}

@region(a, b)
struct ModuleResolvePhase: Movable {
    @life(a)
    context.CompilerContext&! ctx;

    @life(b)
    ModuleResolver&! owner;

    init(self,
        context.CompilerContext&! ctx,
        ModuleResolver&! owner
    ) {
        self.ctx = ctx;
        self.owner = owner;
    }

    public Void add_ast(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.owner.asts.set(source_id, unit);
    }

    module_graph_builder.ModuleGraphBuilder graph_builder(Self&! self) {
        return module_graph_builder.ModuleGraphBuilder(
            self.ctx$.mut_ref(),
            self.owner.asts$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref(),
            self.owner.declaration_items$.mut_ref(),
            self.owner.declaration_containers$.mut_ref(),
            self.owner.artifact_cache_dir.bytes(),
            self.owner.compiler_version_hash,
            self.owner.use_source_artifacts,
            self.owner.mode
        );
    }

    // 构建实际 import 闭包；条件任务按需请求语义模型和 JIL，普通 body 留给后续查询。
    // 图可以包含 package dependency，但不在这里混入 package-level 构建调度。
    public module_graph.ModuleGraph^ build_module_graph(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.add_ast(unit);
        return self.build_module_graph_for_source(source_id);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(
        Self&! self,
        source.SourceId source_id
    ) {
        module_graph.ModuleGraph^ graph! = self.begin_module_graph_for_source(source_id);
        self.seal_module_graph(graph$.mut_ref());
        return graph;
    }

    public module_graph.ModuleGraph^ begin_module_graph_for_source(
        Self&! self,
        source.SourceId source_id
    ) {
        {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.ensure_root_package();
        }
        Bool standard_ready = self.ensure_standard_package();
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        module_graph.ModuleGraph^ graph! = builder.begin_module_graph_for_source(source_id);
        if (!standard_ready) { graph.mark_error(); }
        return graph;
    }

    #doc 隐式标准库先取得独立包身份；初始化自身时复用已登记的包，保留调用方的 root。
    Bool ensure_standard_package(Self&! self) {
        UInt8[]^ directory = cache_identity.absolute_path("src/std");
        qid.SymbolId symbol = self.ctx.store.symbols.intern(directory[..]);
        if (self.ctx.store.resolve.package_for_dir(symbol) != null) { return true; }
        qid.PackageId? root = self.ctx.store.resolve.root_package;
        _ standard = package_load.load(self.ctx, self.owner, directory[..]);
        self.ctx.store.resolve.root_package = root;
        if (standard.ok) {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.refresh_source_dependencies();
        }
        return standard.ok;
    }

    public Void seal_module_graph(Self&! self, module_graph.ModuleGraph&! graph) {
        // seal 也可独立调用；条件求值前必须先建立 core/prelude 的语义环境。
        if (!self.prepare_root_entry_environment(graph)) { graph.ok = false; return; }
        {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.prepare_graph_roots(graph);
        }
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.ctx.store.resolve.module_ref(module_id).has_comptime) {
                source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
                self.ensure_declarations(source_id);
                if (!self.prepare_module_comptime(graph, module_id)) { graph.ok = false; return; }
                if (!self.ensure_module_expression_aliases(graph, module_id)) { graph.ok = false; return; }
            }
            Int import_index! = 0;
            while (import_index < self.ctx.store.resolve.module_ref(module_id).imports.len()) {
                if (!self.ensure_import_target(graph, module_id, import_index)) { graph.ok = false; return; }
                import_index = import_index + 1;
            }
            {
                module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
                builder.write_import_summary(module_id);
            }
            index = index + 1;
        }
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        builder.finish_module_graph(graph);
    }

    #doc 封闭模块图前发现表达式 alias 选中的模块，避免在固定的源码调度之外新增依赖。
    Bool ensure_module_expression_aliases(
        Self&! self, module_graph.ModuleGraph&! graph, qid.ModuleId module_id
    ) {
        qid.DefId owner = self.ctx.store.resolve.module_ref(module_id).def_id;
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        Int index! = 0;
        while (index < self.ctx.store.model.def_member_count(owner)) {
            qid.DefId member = self.ctx.store.model.def_member_at(owner, index);
            index = index + 1;
            if (self.ctx.store.defs.get(member).kind != .alias_def) { continue; }
            guard self.owner.declaration_items.get(member) is .some(item) else { continue; }
            Bool expression! = false;
            {
                guard self.owner.asts.get(source_id) is .some(unit) else { continue; }
                guard unit.get(item$.get()).data is .top_level_decl(top) else { continue; }
                guard unit.get(top.body).data is .alias_decl(alias_decl) else { continue; }
                guard alias_decl.target is .some(target) else { continue; }
                expression = name_resolver.alias_expression(unit.get(target).data);
            }
            if (expression && !self.ensure_declaration_signature(graph, member)) { return false; }
        }
        return true;
    }

    public Bool prepare_root_entry_environment(
        Self&! self,
        module_graph.ModuleGraph&! graph
    ) {
        {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.prepare_query_environment(graph);
        }
        if (self.ctx.store.resolve.core_module is .some(core_module)) {
            source.SourceId core_source = self.ctx.store.resolve.module_ref(core_module).source_id;
            {
                module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
                builder.ensure_declarations(core_source);
            }
            Int import_count = self.ctx.store.resolve.module_ref(core_module).imports.len();
            Int index! = 0;
            while (index < import_count) {
                if (self.ensure_lookup_import_target(graph, core_module, index) == null) {
                    return false;
                }
                index = index + 1;
            }
            self.bind_core_declarations_if_ready();
            if (!self.prepare_module_comptime(graph, core_module)) { return false; }
            self.bind_core_declarations();
            if (!self.ensure_module_expression_aliases(graph, core_module)) { return false; }
            self.bind_core_declarations();
        }
        if (self.ctx.store.resolve.std_prelude_module is .some(std_module)) {
            source.SourceId std_source = self.ctx.store.resolve.module_ref(std_module).source_id;
            {
                module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
                builder.ensure_declarations(std_source);
            }
            if (!self.prepare_module_comptime(graph, std_module)) { return false; }
            self.bind_std_prelude_aliases();
        }
        if (!graph.ok || self.ctx.store.model.has_errors()) { return false; }
        qid.ModuleId root_module = graph.root_module;
        return self.prepare_module_comptime(graph, root_module);
    }

    // Semantic Model lowering 分两段：
    // 1. 对 graph 内所有 module 收 declaration。这里写入的是 DefStore /
    //    namespace/export facts，并为每个 DefId 建 Def skeleton；还没有
    //    function/global body nodes。
    // 2. 所有 module 的 namespace 都完整后，再 resolve body references，
    //    并把每个 definition 的 body 写入对应 Def 的 def-local node 表。
    public Bool lower_module_graph_to_model(Self&! self, module_graph.ModuleGraph& graph) {
        if (!graph.ok) {
            return false;
        }
        module_graph.ModuleGraph query_graph! = module_graph.ModuleGraph(
            graph.package_id,
            graph.root_module,
            true
        );
        source_graph.SourceSchedule schedule! = self.ctx.store.source_dependencies.schedule();
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> source_modules =
            self.source_module_index(graph);
        if (schedule.node_count() != graph.module_count()) {
            return self.lower_module_graph_without_source_schedule(
                graph,
                query_graph$.mut_ref()
            );
        }

        Int begin! = 0;
        Int component! = 0;
        while (component < schedule.component_count()) {
            Int end = schedule.component_end(component);
            if (!self.lower_source_component(
                schedule$.ref(),
                source_modules$.ref(),
                query_graph$.mut_ref(),
                begin,
                end
            )) {
                return false;
            }
            begin = end;
            component = component + 1;
        }
        UInt64 finalize_started = self.timing_start();
        self.load_module_graph_interface_aliases(graph, true);
        self.load_module_graph_interface_templates(graph);
        self.add_timing_finalize(self.timing_elapsed(finalize_started));
        if (self.ctx.store.model.has_errors()) { return false; }
        self.add_core_builtin_type_constraints();
        return true;
    }

    Bool lower_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        module_graph.ModuleGraph&! query_graph,
        Int begin,
        Int end
    ) {
        UInt64 started! = self.timing_start();
        Bool use_source = self.component_requires_source(schedule, source_modules, query_graph, begin, end);
        self.add_timing_freshness(self.timing_elapsed(started));
        started = self.timing_start();
        if (!self.prepare_source_component(schedule, source_modules, begin, end, use_source)) {
            return false;
        }
        self.add_timing_prepare(self.timing_elapsed(started));
        started = self.timing_start();
        self.collect_component_declaration_names(schedule, source_modules, begin, end);
        self.bind_core_declarations_if_ready();
        self.add_timing_declarations(self.timing_elapsed(started));
        started = self.timing_start();
        self.collect_component_aliases(schedule, source_modules, begin, end);
        self.record_core_functions_if_ready();
        self.collect_component_extend_members(schedule, source_modules, begin, end);
        self.load_component_interface_extension_groups(schedule, source_modules, begin, end);
        self.load_component_interface_aliases(schedule, source_modules, begin, end, false);
        self.bind_std_prelude_aliases();
        self.validate_component_wildcard_import_conflicts(
            schedule,
            source_modules,
            begin,
            end
        );
        self.add_timing_facts(self.timing_elapsed(started));
        started = self.timing_start();
        if (!self.lower_component_bodies(
            schedule,
            source_modules,
            query_graph,
            begin,
            end
        )) {
            return false;
        }
        self.add_timing_bodies(self.timing_elapsed(started));
        if (self.owner.use_source_artifacts) {
            started = self.timing_start();
            self.store_component_interfaces(schedule, source_modules, begin, end);
            self.add_timing_store(self.timing_elapsed(started));
        }
        return true;
    }

    UInt64 timing_start(Self&! self) {
        if (!self.owner.timing_enabled) { return UInt64(0); }
        return system_time.monotonic_time_ns();
    }

    UInt64 timing_elapsed(Self&! self, UInt64 started) {
        if (!self.owner.timing_enabled) { return UInt64(0); }
        UInt64 finished = system_time.monotonic_time_ns();
        if (finished < started) { return UInt64(0); }
        return finished - started;
    }

    Void add_timing_prepare(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_prepare(elapsed);
    }

    Void add_timing_freshness(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_freshness(elapsed);
    }

    Void add_timing_bindings(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_bindings(elapsed);
    }

    Void add_timing_skeletons(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_skeletons(elapsed);
    }

    Void add_timing_declarations(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_declarations(elapsed);
    }

    Void add_timing_facts(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_facts(elapsed);
    }

    Void add_timing_bodies(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_bodies(elapsed);
    }

    Void add_timing_store(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_store(elapsed);
    }

    Void add_timing_finalize(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_finalize(elapsed);
    }

    map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> source_module_index(
        Self&! self,
        module_graph.ModuleGraph& graph
    ) {
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> result! =
            map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>();
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity)) {
                result.set(identity, module_id);
            }
            index = index + 1;
        }
        return result;
    }

    Bool component_requires_source(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        module_graph.ModuleGraph&! query_graph,
        Int begin,
        Int end
    ) {
        if (!self.owner.use_source_artifacts) {
            self.force_component_source_models(schedule, begin, end);
            return true;
        }
        if (self.component_contains_required_source_package(
            schedule,
            source_modules,
            begin,
            end
        )) {
            self.force_component_source_models(schedule, begin, end);
            return true;
        }
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(node_id);
            cache_identity.StableSourceId identity = node.identity;
            Bool source_dirty = node.source_dirty;
            Bool dependency_candidate = node.dependency_candidate;
            guard self.module_for_source_node(node_id, source_modules) is .some(module_id) else {
                self.force_component_source_models(schedule, begin, end);
                return true;
            }
            db.ModuleModelInput input = db.module_model(
                self.ctx.query$.ref(),
                identity,
                source_dirty,
                dependency_candidate,
                { [ref self, ref! query_graph, module_id] dependency_candidate =>
                    return self.module_model_can_restore(query_graph, module_id, dependency_candidate);
                }
            );
            if (input == .source) {
                self.force_component_source_models(schedule, begin, end);
                return true;
            }
            index = index + 1;
        }
        index = begin;
        while (index < end) {
            self.ctx.store.source_dependencies.clear_dependency_candidate(schedule.node_at(index));
            index = index + 1;
        }
        return false;
    }

    Bool component_contains_required_source_package(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        guard self.owner.required_source_package is .some(required) else { return false; }
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            if (self.module_for_source_node(node_id, source_modules) is .some(module_id)) {
                store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
                if (module.package_id == required) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool module_model_can_restore(
        Self&! self,
        module_graph.ModuleGraph&! query_graph,
        qid.ModuleId module_id,
        Bool dependency_candidate
    ) {
        if (self.ctx.store.resolve.module_ref(module_id).comptime_items.len() > 0) { return false; }
        // 文档和位置变化不改变语义接口，必须独立校验，不能由 dependency_candidate 门控。
        if (!self.module_observations_valid(query_graph, module_id, !dependency_candidate)) { return false; }
        return self.ensure_fresh_module_interface(module_id);
    }

    Void force_component_source_models(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(
                schedule.node_at(index)
            );
            db.force_source_module_model(self.ctx.query$.ref(), node.identity);
            index = index + 1;
        }
    }

    Bool module_observations_valid(Self&! self, module_graph.ModuleGraph&! query_graph,
        qid.ModuleId module_id, Bool nonsemantic_only
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (self.ctx.store.artifacts.load_observations(source_id) == null
            && !self.load_module_observations(module_id)) {
            return false;
        }
        if (!self.ctx.query.prepare_observed_reflection(self.ctx.store$.mut_ref(), source_id)) { return false; }
        if (!self.prepare_observed_facts(query_graph, source_id, nonsemantic_only)) { return false; }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity)
            else { return false; }
        qkey.Fingerprint128 reflection_inputs = source_fingerprint.reflection_inputs(
            self.ctx.store.artifacts$.ref(), source_id);
        if (!db.object_reflection_inputs_match(self.ctx.query$.ref(), identity, reflection_inputs)) { return false; }
        guard self.ctx.store.artifacts.load_observations(source_id)
            is .some(observations) else {
            return false;
        }
        return self.ctx.query.validate_declaration_observations(
            self.ctx.store$.ref(),
            observations,
            nonsemantic_only,
            identity,
            true
        );
    }

    #doc 语义观察复用编译层的事实准备；未选定模型的同一 SCC 回退源码，不重入正在选择的模块。
    Bool prepare_observed_facts(Self&! self, module_graph.ModuleGraph&! graph,
        source.SourceId source_id, Bool dependencies_unchanged
    ) {
        Int count = self.ctx.store.artifacts.load_observations(source_id)$.some().entries.len();
        Int index! = 0;
        while (index < count) {
            _ item = self.ctx.store.artifacts.load_observations(source_id)$.some().entries.get(index);
            index = index + 1;
            if (item.aspect != .declaration_type && item.aspect != .metadata) { continue; }
            if (item.aspect == .declaration_type
                && (item.name.low == UInt64(Int(db.DeclarationTypeProperty.regions))
                    || item.name.low == UInt64(Int(db.DeclarationTypeProperty.constraints)))) {
                continue;
            }
            guard self.ctx.store.incremental.current_def_for_stable(item.subject) is .some(definition)
                else { return false; }
            _ module = self.ctx.store.defs.get(definition).module_id$.some();
            if (self.ctx.store.resolve.module_ref(module).source_id == source_id) {
                if (!dependencies_unchanged) { return false; }
                continue;
            }
            _ state = self.module_state(module);
            if (state != .resolved && state != .interface_loaded) { return false; }
            guard self.owner.prepare_observed_fact is .some(prepare) else { return false; }
            qid.DefId target = if item.aspect == .declaration_type
                && self.ctx.store.defs.get(definition).kind == .generic_param_def {
                self.ctx.store.defs.get(definition).owner_def$.some()
            } else { definition };
            if (!prepare(self.ctx$.mut_ref(), self.owner$.mut_ref(), graph$.mut_ref(), target, item.aspect)) {
                return false;
            }
        }
        return true;
    }

    Bool load_module_observations(Self&! self, qid.ModuleId module_id) {
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id)
            is .some(identity) else {
            return false;
        }
        UInt8[]^ path = artifact_path.stable_source_ji_path(
            self.owner.artifact_cache_dir.bytes(),
            identity
        );
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        return source_ji.load_declaration_observations_from_ji(
            self.ctx.store$.mut_ref(),
            source_id,
            path[..],
            self.owner.compiler_version_hash,
            identity.fingerprint
        );
    }

    Bool prepare_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool use_source
    ) {
        if (use_source) {
            self.mark_component_source_dirty(schedule, begin, end);
        }
        UInt64 started = self.timing_start();
        Int index! = begin;
        while (index < end) {
            guard self.module_for_source_node(schedule.node_at(index), source_modules)
                is .some(module_id) else {
                return false;
            }
            self.refresh_import_aliases(module_id);
            // 同一 resolver 可先求值配置再构建 root 图；已完成的模块不能重新登记声明。
            if (self.module_state(module_id) == .resolved) {
                index = index + 1;
                continue;
            }
            if (use_source) {
                self.ctx.store.resolve.set_module_interface_only(module_id, false);
                db.begin_source_observations(
                    self.ctx.query$.ref(),
                    self.ctx.store.resolve.module_ref(module_id).source_id
                );
                module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
                if (!builder.ensure_file_source_ast(self.ctx.store.resolve.module_ref(module_id).source_id)) {
                    return false;
                }
                module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
                if (state != .declarations_ready && state != .declarations_collected) {
                    self.set_module_state(module_id, .collecting_declarations);
                }
            } else {
                // ModuleModelQuery 已完成 L1/L2/L3 选择和 interface freshness
                // 验证；这里只 materialize 已选中的 interface facts。
                self.ctx.store.artifacts.record_interface_lookup(.hit);
                self.ctx.store.resolve.set_module_interface_only(module_id, true);
                db.retain_declaration_observations(self.ctx.query$.ref(), self.ctx.store.artifacts$.ref(),
                    self.ctx.store.resolve.module_ref(module_id).source_id);
                self.set_module_state(module_id, .interface_loaded);
            }
            index = index + 1;
        }
        self.add_timing_bindings(self.timing_elapsed(started));
        if (!use_source) {
            UInt64 started = self.timing_start();
            self.load_component_interface_skeletons(
                schedule,
                source_modules,
                begin,
                end
            );
            self.add_timing_skeletons(self.timing_elapsed(started));
        }
        return true;
    }

    Void load_component_interface_skeletons(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 1;
        while (progress > 0) {
            progress = self.load_component_interface_skeleton_round(
                schedule,
                source_modules,
                begin,
                end
            );
        }
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            self.load_module_interface_skeletons(module_id);
            index = index + 1;
        }
    }

    Int load_component_interface_skeleton_round(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
            artifact.ModuleInterface& module_interface =
                self.ctx.store.artifacts.load_interface(module.source_id)$.some();
            interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
                self.ctx$.mut_ref(),
                self.owner.module_states$.mut_ref(),
                self.owner.declaration_defs$.mut_ref()
            );
            progress = progress
                + loader.load_module_interface_skeleton_round(module_id, module_interface);
            index = index + 1;
        }
        return progress;
    }

    Void load_module_interface_skeletons(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.ctx.store.artifacts.load_interface(module.source_id)$.some();
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
    }

    Void mark_component_source_dirty(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        Bool changed! = false;
        while (index < end) {
            source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(schedule.node_at(index));
            if (node.source_dirty || node.dependency_candidate) { changed = true; break; }
            index = index + 1;
        }
        // comptime 任务要求从源码重新求值，不等于源码或被观察的依赖发生变化。
        if (!changed) { return; }
        index = begin;
        while (index < end) {
            self.ctx.store.source_dependencies.mark_source_dirty(schedule.node_at(index));
            index = index + 1;
        }
    }

    qid.ModuleId? module_for_source_node(
        Self&! self,
        source_graph.SourceNodeId node_id,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules
    ) {
        cache_identity.StableSourceId identity =
            self.ctx.store.source_dependencies.node(node_id).identity;
        guard source_modules.get(identity) is .some(module_id) else { return null; }
        return module_id$.get();
    }

    Void collect_component_declaration_names(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
                self.set_module_state(module_id, .declarations_ready);
            }
            index = index + 1;
        }
    }

    Void collect_component_aliases(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        self.collect_component_alias_rounds(schedule, source_modules, begin, end);

        Int final_progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                final_progress = final_progress + self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }

        // 带泛型实参的 alias 在最终 pass 才落地，需要再传播到同一 SCC 的 flatten import。
        if (final_progress > 0) {
            self.collect_component_alias_rounds(schedule, source_modules, begin, end);
        }
    }

    Void collect_component_alias_rounds(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int round! = 0;
        Int limit = end - begin + 1;
        while (round < limit) {
            Int progress = self.collect_component_alias_round(
                schedule,
                source_modules,
                begin,
                end
            );
            if (progress == 0) { break; }
            round = round + 1;
        }
    }

    Int collect_component_alias_round(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                progress = progress + self.collect_module_aliases_deferred(module_id);
            }
            index = index + 1;
        }
        return progress;
    }

    Void collect_component_extend_members(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                if (!self.owner.extension_skeletons.has(module_id)) {
                    self.collect_module_extend_members(module_id);
                    self.owner.extension_skeletons.add(module_id);
                }
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_extension_groups(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_extension_groups(module_id);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_aliases(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool require_targets
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_aliases(module_id, require_targets);
            }
            index = index + 1;
        }
    }

    Bool lower_component_bodies(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        module_graph.ModuleGraph&! query_graph,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (!self.ensure_module_model(query_graph, module_id)) { return false; }
            index = index + 1;
        }
        return true;
    }

    Void store_component_interfaces(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            qid.ModuleId module_id = self.module_for_source_node(node_id, source_modules)$.some();
            if (self.module_state(module_id) != .interface_loaded) {
                incremental_fingerprint.fingerprint_module(self.ctx$.mut_ref(), module_id);
                if (interface_builder.store_module_interface(self.ctx$.mut_ref(), module_id)) {
                    self.publish_module_interface_change(node_id, module_id);
                }
            }
            index = index + 1;
        }
    }

    Void publish_module_interface_change(
        Self&! self,
        source_graph.SourceNodeId node_id,
        qid.ModuleId module_id
    ) {
        // 按需求值或 provider 要求重新读取源码，不等于输入失效；其中间接口可能还没有 const 值。
        // 只传播源变化或依赖失效触发的重建，不能用干净模块的未完成接口替代上次已完成的接口。
        source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(node_id);
        if (!node.source_dirty && !node.dependency_candidate) { return; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.ctx.store.artifacts.load_interface(module.source_id)$.some();
        db.publish_module_interface_change(
            self.ctx.query$.ref(),
            self.ctx.store.source_dependencies$.mut_ref(),
            node_id,
            module_interface.interface_hash,
            module_interface.public_interface_hash
        );
    }

    Bool lower_module_graph_without_source_schedule(
        Self&! self,
        module_graph.ModuleGraph& graph,
        module_graph.ModuleGraph&! query_graph
    ) {
        self.collect_module_graph_declarations(graph);
        self.validate_wildcard_import_conflicts(graph);
        Int index! = graph.module_count();
        while (index > 0) {
            index = index - 1;
            qid.ModuleId module_id = graph.module_at(index);
            self.load_module_graph_interface_aliases(graph, false);
            if (!self.ensure_module_model(query_graph, module_id)) { return false; }
        }
        return true;
    }

    Void validate_component_wildcard_import_conflicts(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            if (self.module_for_source_node(schedule.node_at(index), source_modules)
                is .some(module_id)
            ) {
                self.validate_module_wildcard_import_conflicts(module_id);
            }
            index = index + 1;
        }
    }

    Void validate_wildcard_import_conflicts(
        Self&! self,
        module_graph.ModuleGraph& graph
    ) {
        Int index! = 0;
        while (index < graph.module_count()) {
            self.validate_module_wildcard_import_conflicts(graph.module_at(index));
            index = index + 1;
        }
    }

    Void validate_module_wildcard_import_conflicts(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        Int current_index! = 0;
        while (current_index < module.imports.len()) {
            store.ImportRecord current = module.imports.get(current_index);
            if (current.flatten && current.target_module != null) {
                Int previous_index! = 0;
                while (previous_index < current_index) {
                    store.ImportRecord previous = module.imports.get(previous_index);
                    if (previous.flatten && previous.target_module != null) {
                        if (self.validate_wildcard_import_pair(module_id, previous, current)) {
                            break;
                        }
                    }
                    previous_index = previous_index + 1;
                }
            }
            current_index = current_index + 1;
        }
    }

    Bool validate_wildcard_import_pair(
        Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord previous,
        store.ImportRecord current
    ) {
        qid.NamespaceId previous_namespace = self.ctx.store.resolve.module_ref(
            previous.target_module$.some()
        ).namespace_id;
        qid.NamespaceId current_namespace = self.ctx.store.resolve.module_ref(
            current.target_module$.some()
        ).namespace_id;
        return self.validate_wildcard_surface_against(
            module_id,
            previous_namespace,
            current_namespace,
            previous.span,
            current.span,
            0
        );
    }

    Bool validate_wildcard_surface_against(
        Self&! self,
        qid.ModuleId module_id,
        qid.NamespaceId surface_namespace,
        qid.NamespaceId other_namespace,
        token.Span previous_span,
        token.Span current_span,
        Int depth
    ) {
        if (surface_namespace == other_namespace) { return false; }
        if (depth > self.ctx.store.resolve.wildcard_imports.len()) { return false; }
        table.MultiTableCursor cursor! =
            self.ctx.store.resolve.first_namespace_binding(surface_namespace);
        while (cursor.valid()) {
            namespace.BindingEntry candidate =
                self.ctx.store.resolve.namespace_binding_at(cursor);
            if (candidate.visibility == .public_visibility) {
                if (self.public_wildcard_binding(
                    other_namespace,
                    candidate.symbol,
                    candidate.domain,
                    0
                ) is .some(other_binding)) {
                    // 同一名字空间中同名函数属于一个重载组，重复路径不能把组内成员判为冲突。
                    if (candidate.def_id != other_binding.def_id
                        && candidate.namespace_id != other_binding.namespace_id
                    ) {
                        self.add_wildcard_import_conflict(
                            module_id,
                            previous_span,
                            current_span,
                            candidate.symbol
                        );
                        return true;
                    }
                }
            }
            cursor = self.ctx.store.resolve.next_namespace_binding(cursor);
        }
        Int edge_index! = 0;
        while (edge_index < self.ctx.store.resolve.wildcard_imports.len()) {
            store.WildcardImportRecord edge =
                self.ctx.store.resolve.wildcard_imports.get(edge_index);
            if (edge.namespace_id.to_index() == surface_namespace.to_index()
                && edge.visibility == .public_visibility
                && self.validate_wildcard_surface_against(
                    module_id,
                    edge.target_namespace_id,
                    other_namespace,
                    previous_span,
                    current_span,
                    depth + 1
                )
            ) {
                return true;
            }
            edge_index = edge_index + 1;
        }
        return false;
    }

    namespace.BindingEntry? public_wildcard_binding(
        Self&! self,
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        Int depth
    ) {
        if (depth > self.ctx.store.resolve.wildcard_imports.len()) { return null; }
        if (self.ctx.store.resolve.namespaces.first_public_binding(namespace_id, symbol, domain)
            is .some(binding)
        ) {
            return binding;
        }
        Int index! = 0;
        while (index < self.ctx.store.resolve.wildcard_imports.len()) {
            store.WildcardImportRecord edge = self.ctx.store.resolve.wildcard_imports.get(index);
            if (edge.namespace_id.to_index() == namespace_id.to_index()
                && edge.visibility == .public_visibility
            ) {
                if (self.public_wildcard_binding(
                    edge.target_namespace_id,
                    symbol,
                    domain,
                    depth + 1
                ) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Void add_wildcard_import_conflict(
        Self&! self,
        qid.ModuleId module_id,
        token.Span previous_span,
        token.Span current_span,
        qid.SymbolId symbol
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        diagnostics.add_duplicate_def(
            self.ctx.store.diagnostics$.mut_ref(),
            module.source_id,
            current_span,
            previous_span,
            self.ctx.store.symbols.text(symbol)
        );
        self.ctx.store.model.mark_error();
    }

    // Semantic Model 固化后即可发布 declaration fingerprint。它不读取
    // TypeCheckStore，先于 type check 执行可让稳定语义查询读取已发布值。
    public Void fingerprint_module_graph_model(Self&! self, module_graph.ModuleGraph& graph) {
        incremental_fingerprint.fingerprint_module_graph(self.ctx$.mut_ref(), graph);
    }

    public Void finalize_module_graph_model(Self&! self, module_graph.ModuleGraph& graph) {
        // codegen 模式也要构造纯语义 interface，backend 成功后再把本轮
        // 源码快照对应的 `.ji` 发布给下一次编译。
        self.store_module_graph_interfaces(graph);
    }

    Void store_module_graph_interfaces(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) != .interface_loaded) {
                interface_builder.store_module_interface(self.ctx$.mut_ref(), module_id);
            }
            index = index + 1;
        }
    }

    public Bool ensure_module_model(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
        if (state == .resolved) { return true; }
        if (state == .interface_loaded) {
            return self.ensure_interface_module_model(graph, module_id);
        }
        if (state != .declarations_collected) { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (!self.lower_module_bodies_to_model(graph, module_id)) { return false; }
        return self.owner.asts.remove(source_id);
    }

    public Bool ensure_root_entry_signature(
        Self&! self,
        module_graph.ModuleGraph&! graph
    ) {
        qid.ModuleId root_module = graph.root_module;
        store.ModuleRecord& root = self.ctx.store.resolve.module_ref(root_module);
        qid.SymbolId main_symbol = self.ctx.store.symbols.intern("main");
        guard self.ctx.store.resolve.first_binding(
            root.namespace_id,
            main_symbol,
            .value_name
        ) is .some(binding) else {
            return true;
        }
        db.begin_source_observations(self.ctx.query$.ref(), root.source_id);
        return self.ensure_declaration_signature(graph, binding.def_id);
    }

    public Bool ensure_root_entry_model(
        Self&! self,
        module_graph.ModuleGraph&! graph
    ) {
        qid.ModuleId root_module = graph.root_module;
        store.ModuleRecord& root = self.ctx.store.resolve.module_ref(root_module);
        qid.SymbolId main_symbol = self.ctx.store.symbols.intern("main");
        guard self.ctx.store.resolve.first_binding(
            root.namespace_id,
            main_symbol,
            .value_name
        ) is .some(binding) else {
            // Library/check roots do not have a single entry declaration. Their
            // source declarations are the demand roots: resolving each root
            // declaration can discover only the imports it actually references
            // before the final reachable-source seal.
            db.begin_source_observations(self.ctx.query$.ref(), root.source_id);
            Int index! = 0;
            while (index < self.ctx.store.defs.len()) {
                qid.DefId def_id = qid.DefId.from_index(index);
                def.DefRecord record = self.ctx.store.defs.get(def_id);
                if (record.module_id is .some(module_id)) {
                    if (module_id.index == root_module.index
                        && self.owner.declaration_items.get(def_id) != null
                        && !self.ensure_declaration_model(graph, def_id)
                    ) {
                        return false;
                    }
                }
                index = index + 1;
            }
            return true;
        }
        db.begin_source_observations(self.ctx.query$.ref(), root.source_id);
        return self.ensure_declaration_model(graph, binding.def_id);
    }

    public Bool ensure_declaration_model(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.DefId def_id
    ) {
        sem.DeclarationSemaState progress = self.ctx.store.model.declaration_sema_state(def_id);
        if (progress == .body_ready) { return true; }
        if (progress == .resolving_body) { return true; }
        if (progress == .failed) { return false; }
        if (!self.ensure_declaration_signature(graph, def_id)) { return false; }
        if (self.ctx.store.model.declaration_sema_state(def_id) == .body_ready) {
            return true;
        }

        guard self.declaration_module_id(def_id) is .some(module_id) else { return false; }
        module_graph_builder.ModuleResolvePassState module_progress = self.module_state(module_id);
        // lookup 可能已把 interface declaration 推进到 signature_ready；
        // interface-only module 没有源码 AST，model ensure 必须恢复剩余 facts。
        if (module_progress == .interface_loaded) {
            return self.ensure_interface_declaration_facts(module_id, def_id);
        }
        if (!self.module_allows_declaration_ensure(module_progress)) { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        if (self.owner.asts.get(module.source_id) == null) { return false; }
        guard self.owner.declaration_items.get(def_id) is .some(declaration_item) else {
            return false;
        }
        ast.AstId declaration_id = declaration_item$.get();
        ast.AstId item_id! = declaration_id;
        if (self.owner.declaration_containers.get(def_id) is .some(container)) {
            item_id = container$.get();
        }
        Bool target_member = self.container_supports_member_ensure(module.source_id, item_id)
            && declaration_id.to_index() != item_id.to_index();

        Bool lowered = self.resolve_and_lower_declaration(
            module.source_id,
            module_id,
            module.namespace_id,
            item_id,
            def_id,
            target_member,
            false,
            graph
        );
        if (!lowered) {
            self.ctx.store.model.set_declaration_sema_state(def_id, .failed);
            return false;
        }
        self.finish_declaration_sema(def_id);
        if (!self.ensure_init_field_models(graph, def_id)) {
            self.ctx.store.model.set_declaration_sema_state(def_id, .failed);
            return false;
        }
        if (self.owner.use_source_artifacts) {
            incremental_fingerprint.fingerprint_def_model(self.ctx$.mut_ref(), def_id);
        }
        return true;
    }

    #doc
        显式 init 依赖字段默认值；只补所属类型的字段 model，不推进其他成员 body。
    #end
    Bool ensure_init_field_models(Self&! self, module_graph.ModuleGraph&! graph, qid.DefId def_id) {
        def.DefRecord record = self.ctx.store.defs.get(def_id);
        if (record.kind != .init_def) { return true; }
        guard record.owner_def is .some(owner) else { return true; }
        Int index! = 0;
        while (index < self.ctx.store.model.def_member_count(owner)) {
            qid.DefId member = self.ctx.store.model.def_member_at(owner, index);
            index = index + 1;
            if (self.ctx.store.defs.get(member).kind != .field_def) { continue; }
            if (!self.ensure_declaration_model(graph, member)) { return false; }
        }
        return true;
    }

    #doc 模块标签只降低独立顶层项，复用声明的按需引用解析，不强制降低模块中的函数体。
    public Bool ensure_module_metadata(Self&! self, module_graph.ModuleGraph&! graph, qid.ModuleId module_id) {
        _ record = self.ctx.store.resolve.module_ref(module_id);
        qid.DefId definition = record.def_id;
        source.SourceId source_id = record.source_id;
        qid.NamespaceId namespace_id = record.namespace_id;
        if (self.ctx.query.metadata.prepared(definition)) { return true; }
        guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
        guard unit.root is .some(root) else { return false; }
        list.ArrayList<ast.AstId> items! = list.ArrayList<ast.AstId>();
        self.collect_module_metadata_items(source_id, root, items$.mut_ref());
        Int index! = 0;
        while (index < items.len()) {
            if (!self.resolve_and_lower_declaration(source_id, module_id, namespace_id,
                items.get(index), definition, false, true, graph)) { return false; }
            index = index + 1;
        }
        self.ctx.query.metadata.prepare(definition);
        return true;
    }

    Void collect_module_metadata_items(self, source.SourceId source_id, ast.AstId item,
        list.ArrayList<ast.AstId>&! items
    ) {
        _ unit = self.owner.asts.get(source_id)$.some();
        _ node = unit.get(item);
        if (node.data is .meta_attribute(meta)) {
            if (meta.module_target) { items.add(item); }
            return;
        }
        guard ast.root_data(node.data) is .some(root) else { return; }
        Int index! = 0;
        while (index < root.items.length) {
            _ child = unit.child_at(root.items, index);
            self.collect_module_metadata_items(source_id, child, items);
            index = index + 1;
        }
    }

    public Bool ensure_declaration_signature(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.DefId def_id
    ) {
        sem.DeclarationSemaState progress = self.ctx.store.model.declaration_sema_state(def_id);
        if (progress == .signature_ready || progress == .body_ready) { return true; }
        if (progress == .resolving_signature) {
            def.DefRecord record = self.ctx.store.defs.get(def_id);
            if (record.kind == .alias_def && record.domain == .alias_name) {
                self.add_alias_cycle_diagnostic(def_id);
                self.ctx.store.model.set_declaration_sema_state(def_id, .failed);
                return false;
            }
            return true;
        }
        if (progress == .resolving_body) { return true; }
        if (progress == .failed) { return false; }

        guard self.declaration_module_id(def_id) is .some(module_id) else { return false; }
        Bool alias_skeleton = self.ctx.store.defs.get(def_id).kind == .alias_def
            && self.ctx.store.defs.get(def_id).domain == .alias_name;
        module_graph_builder.ModuleResolvePassState module_progress! = self.module_state(module_id);
        if (module_progress == .interface_loaded) {
            return self.ensure_interface_declaration_facts(module_id, def_id);
        }
        if (!self.prepare_module_comptime(graph, module_id)) { return false; }
        if (module_progress == .declarations_ready && !alias_skeleton) {
            if (!self.ensure_module_extend_members(graph, module_id)) { return false; }
            module_progress = self.module_state(module_id);
        }
        if (!self.module_allows_declaration_ensure(module_progress)) { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        if (self.owner.asts.get(module.source_id) == null) { return false; }
        guard self.owner.declaration_items.get(def_id) is .some(declaration_item) else {
            return false;
        }
        ast.AstId declaration_id = declaration_item$.get();
        ast.AstId item_id! = declaration_id;
        if (self.owner.declaration_containers.get(def_id) is .some(container)) {
            item_id = container$.get();
        }
        Bool target_member = self.container_supports_member_ensure(module.source_id, item_id)
            && declaration_id.to_index() != item_id.to_index();

        self.ctx.store.model.set_declaration_sema_state(def_id, .resolving_signature);
        Bool lowered = self.resolve_and_lower_declaration(
            module.source_id,
            module_id,
            module.namespace_id,
            item_id,
            def_id,
            target_member,
            true,
            graph
        );
        if (!lowered) {
            self.ctx.store.model.set_declaration_sema_state(def_id, .failed);
            return false;
        }
        return true;
    }

    Void add_alias_cycle_diagnostic(Self&! self, qid.DefId def_id) {
        guard self.ctx.store.source_map.def_span(def_id) is .some(loc) else {
            self.ctx.store.model.mark_error();
            return;
        }
        guard loc.source_id is .some(source_id) else {
            self.ctx.store.model.mark_error();
            return;
        }
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            source_id,
            loc.span,
            "cyclic alias definition",
            "cyclic_alias_definition"
        );
        self.ctx.store.model.mark_error();
    }

    // 当前模块的普通名字已发布；递归请求可读取它们，但不能提前发布未选中分支。
    Bool prepare_module_comptime(Self&! self, module_graph.ModuleGraph&! graph, qid.ModuleId module_id) {
        if (self.ctx.store.resolve.module_ref(module_id).comptime_cursor
            == self.ctx.store.resolve.module_ref(module_id).comptime_items.len()) { return true; }
        if (self.ctx.store.resolve.module_ref(module_id).comptime_running) { return true; }
        self.ctx.store.resolve.set_comptime_running(module_id, true);
        Bool ok! = true;
        while (self.ctx.store.resolve.module_ref(module_id).comptime_cursor
            < self.ctx.store.resolve.module_ref(module_id).comptime_items.len()) {
            Int cursor = self.ctx.store.resolve.module_ref(module_id).comptime_cursor;
            ast.AstId item = self.ctx.store.resolve.module_ref(module_id).comptime_items.get(cursor);
            self.ctx.store.resolve.begin_comptime_item(module_id);
            if (!self.prepare_comptime_item(graph, module_id, item)) { ok = false; break; }
            self.ctx.store.resolve.advance_comptime(module_id);
        }
        self.ctx.store.resolve.set_comptime_running(module_id, false);
        return ok;
    }

    Bool prepare_comptime_item(
        Self&! self, module_graph.ModuleGraph&! graph, qid.ModuleId module_id, ast.AstId item
    ) {
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        ast.AstId expression! = item;
        token.Span span! = token.Span();
        def.Visibility? wildcard_visibility! = null;
        {
            guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
            span = unit.get(item).span;
            if (unit.get(item).data is .top_level_decl(top)
                && unit.get(top.body).data is .alias_decl(alias_decl) && alias_decl.flatten) {
                expression = alias_decl.target$.some();
                def.Visibility visibility = if top.modifiers.public_flag {
                    .public_visibility
                } else { .private_visibility };
                wildcard_visibility = visibility;
            }
        }
        qid.DefId owner = self.ctx.store.resolve.module_ref(module_id).def_id;
        guard self.lower_source_condition(graph, module_id, expression, owner) is .some(root) else { return false; }
        RawFn<comptime_value.ComptimeValue?, context.CompilerContext&!, ModuleResolver&!,
            module_graph.ModuleGraph&!, sem.NodeId, qid.TypeId> evaluate = self.owner.evaluate_expression;
        qid.TypeId expected = if wildcard_visibility != null {
            self.ctx.store.types.namespace_type()
        } else { self.ctx.store.types.unit_type() };
        guard evaluate(self.ctx$.mut_ref(), self.owner$.mut_ref(), graph$.mut_ref(), root, expected)
            is .some(value) else { return false; }
        guard wildcard_visibility is .some(visibility) else { return true; }
        if (value.data is .namespace_value(target)) {
            qid.NamespaceId namespace_id = self.ctx.store.defs.get(target).owned_namespace_id$.some();
            if (self.ctx.store.defs.get(target).kind == .module_def) {
                qid.ModuleId target_module = self.ctx.store.defs.get(target).module_id$.some();
                qid.SymbolId target_path = self.ctx.store.resolve.module_ref(target_module).path_symbol;
                Int import_index = self.ctx.store.resolve.module_ref(module_id).imports.len();
                self.ctx.store.resolve.add_import(module_id, store.ImportRecord(
                    kind = .package_import, state = .resolved, span = span, visibility = visibility,
                    flatten = true, expression_import = true, path_symbol = target_path,
                    alias_symbol = null, target_module = target_module, alias_def = null));
                return self.ensure_lookup_import_target(graph, module_id, import_index) != null;
            }
            qid.NamespaceId destination = self.ctx.store.resolve.module_ref(module_id).namespace_id;
            self.ctx.store.resolve.add_wildcard_import(
                destination, namespace_id, visibility, span);
            return true;
        }
        guard value.data is .import_value(origin, path, file_path) else { return false; }
        Int index = self.ctx.store.resolve.module_ref(module_id).imports.len();
        self.ctx.store.resolve.add_import(module_id, store.ImportRecord(
            kind = if file_path { .file_import } else { .package_import },
            state = .unresolved, span = span,
            visibility = visibility, flatten = true, expression_import = true,
            path_symbol = path, alias_symbol = null, target_module = null, alias_def = null));
        return self.ensure_lookup_import_target(graph, module_id, index) != null;
    }

    public sem.NodeId? lower_source_condition(
        Self&! self, module_graph.ModuleGraph&! graph, qid.ModuleId module_id, ast.AstId condition,
        qid.DefId? owner_def = null
    ) {
        if (self.ctx.store.resolve.module_ref(module_id).condition_roots.get(condition.to_index()) is .some(found)) {
            return found$.get();
        }
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        qid.NamespaceId namespace_id! = self.ctx.store.resolve.module_ref(module_id).namespace_id;
        if (owner_def is .some(owner) && self.ctx.store.defs.get(owner).kind == .alias_def) {
            namespace_id = self.ctx.store.defs.get(owner).decl_namespace_id;
        }
        while (true) {
            qid.ModuleId? pending_module! = null;
            Int pending_index! = -1;
            qid.DefId? pending_declaration! = null;
            sem.NodeId? root! = null;
            {
                guard self.owner.asts.get(source_id) is .some(unit) else { return null; }
                resolve_state.AstResolveState state! = resolve_state.AstResolveState(
                    self.ctx$.mut_ref(), unit, self.owner.declaration_defs$.mut_ref(),
                    self.owner.declaration_items$.mut_ref(), self.owner.declaration_containers$.mut_ref(),
                    module_id, namespace_id
                );
                {
                    reference_resolver.ReferenceResolver resolver! =
                        reference_resolver.ReferenceResolver(state$.mut_ref());
                    resolver.resolve_source_expression(condition);
                }
                if (state.has_pending_request()) {
                    pending_module = state.pending_import_module;
                    pending_index = state.pending_import_index;
                    pending_declaration = state.pending_declaration;
                } else if (!state.ctx.store.model.has_errors()) {
                    root = model_lower.lower_source_expression(state$.mut_ref(), condition, owner_def);
                }
            }
            if (pending_module is .some(import_module)) {
                if (!self.ensure_lookup_import(graph, import_module, pending_index)) { return null; }
                continue;
            }
            if (pending_declaration is .some(dependency_def)) {
                if (!self.ensure_declaration_signature(graph, dependency_def)) { return null; }
                continue;
            }
            if (root is .some(node)) {
                self.ctx.store.resolve.set_condition_root(module_id, condition.to_index(), node);
            }
            return root;
        }
        return null;
    }

    #doc
        alias 表达式先求得导入引用，再发现选中模块；未选中路径不加入 import graph。
        求值期间不持有 AST 借用，结果发布复用 NameResolver 的普通 alias 绑定。
    #end
    Bool ensure_alias_expression(Self&! self, module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id, qid.NamespaceId namespace_id, ast.AstId item_id, qid.DefId def_id) {
        if (self.ctx.store.defs.get(def_id).kind != .alias_def
            || self.ctx.store.model.def_alias_target(def_id) != null) { return true; }
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        ast.AliasData declaration!;
        ast.AstId expression!;
        token.Span span!;
        def.Visibility visibility!;
        {
            guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
            ast.AstId declaration_item! = item_id;
            if (self.owner.declaration_items.get(def_id) is .some(found)) { declaration_item = found$.get(); }
            ast.AstNode item = unit.get(declaration_item);
            ast.AstId body! = declaration_item;
            if (item.data is .top_level_decl(top)) { body = top.body; }
            if (item.data is .member_decl(member)) { body = member.body; }
            guard unit.get(body).data is .alias_decl(alias_decl) else { return true; }
            guard alias_decl.target is .some(target) else { return true; }
            if (!name_resolver.alias_expression(unit.get(target).data)) { return true; }
            declaration = alias_decl;
            expression = target;
            span = unit.get(body).span;
            visibility = self.ctx.store.defs.get(def_id).visibility;
        }
        guard self.lower_source_condition(graph, module_id, expression, def_id) is .some(root) else { return false; }
        RawFn<comptime_value.ComptimeValue?, context.CompilerContext&!, ModuleResolver&!,
            module_graph.ModuleGraph&!, sem.NodeId, qid.TypeId> evaluate = self.owner.evaluate_expression;
        qid.TypeId expected = self.ctx.store.types.namespace_type();
        guard evaluate(self.ctx$.mut_ref(), self.owner$.mut_ref(), graph$.mut_ref(), root, expected)
            is .some(value) else { return false; }
        qid.DefId target_def!;
        if (value.data is .namespace_value(target)) {
            target_def = target;
        } else {
            guard value.data is .import_value(origin, path, file_path) else { return false; }
            Int index = self.ctx.store.resolve.module_ref(origin).imports.len();
            store.ImportKind kind! = .package_import;
            if (file_path) { kind = .file_import; }
            self.ctx.store.resolve.add_import(origin, store.ImportRecord(
                kind = kind, state = .unresolved, span = span, visibility = visibility, flatten = false,
                expression_import = true,
                path_symbol = path, alias_symbol = self.ctx.store.defs.get(def_id).name.symbol,
                target_module = null, alias_def = def_id));
            guard self.ensure_lookup_import_target(graph, origin, index) is .some(target_module) else { return false; }
            target_def = self.ctx.store.resolve.module_ref(target_module).def_id;
        }
        {
            guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
            resolve_state.AstResolveState state! = resolve_state.AstResolveState(
                self.ctx$.mut_ref(), unit, self.owner.declaration_defs$.mut_ref(),
                self.owner.declaration_items$.mut_ref(), self.owner.declaration_containers$.mut_ref(),
                module_id, self.ctx.store.defs.get(def_id).decl_namespace_id);
            name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
            resolver.bind_expression_alias(def_id, declaration.name, target_def, visibility, span);
        }
        return !self.ctx.store.model.has_errors();
    }

    Bool resolve_and_lower_declaration(
        Self&! self,
        source.SourceId source_id,
        qid.ModuleId module_id,
        qid.NamespaceId namespace_id,
        ast.AstId item_id,
        qid.DefId def_id,
        Bool target_member,
        Bool signature_only,
        module_graph.ModuleGraph&! graph
    ) {
        if (!self.ensure_alias_expression(graph, module_id, namespace_id, item_id, def_id)) { return false; }
        qid.NamespaceId lookup_namespace! = namespace_id;
        if (self.ctx.store.defs.get(def_id).kind == .alias_def) {
            lookup_namespace = self.ctx.store.defs.get(def_id).decl_namespace_id;
        }
        while (true) {
            qid.ModuleId? pending_module! = null;
            Int pending_index! = -1;
            qid.DefId? pending_declaration! = null;
            Bool lowered! = false;
            {
                guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
                resolve_state.AstResolveState state! = resolve_state.AstResolveState(
                    self.ctx$.mut_ref(),
                    unit,
                    self.owner.declaration_defs$.mut_ref(),
                    self.owner.declaration_items$.mut_ref(),
                    self.owner.declaration_containers$.mut_ref(),
                    module_id,
                    lookup_namespace
                );
                name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
                if (state.ctx.store.defs.get(def_id).kind == .alias_def
                    && state.ctx.store.model.def_alias_target(def_id) == null
                ) {
                    ast.AstId alias_item! = item_id;
                    if (self.owner.declaration_items.get(def_id) is .some(found)) { alias_item = found$.get(); }
                    resolver.resolve_alias_declaration(alias_item);
                }
                if (!state.has_pending_request()) {
                    if (target_member) {
                        resolver.resolve_top_level_member(item_id, def_id, signature_only);
                    } else if (signature_only) {
                        resolver.resolve_top_level_signature(item_id);
                    } else {
                        resolver.resolve_top_level_item(item_id);
                    }
                }
                if (state.has_pending_request()) {
                    pending_module = state.pending_import_module;
                    pending_index = state.pending_import_index;
                    pending_declaration = state.pending_declaration;
                } else if (!state.ctx.store.model.has_errors()) {
                    if (target_member) {
                        lowered = model_lower.lower_top_level_member(
                            state$.mut_ref(),
                            item_id,
                            def_id,
                            signature_only
                        );
                    } else if (signature_only) {
                        lowered = model_lower.lower_top_level_signature(state$.mut_ref(), item_id);
                    } else {
                        lowered = model_lower.lower_top_level_item(state$.mut_ref(), item_id);
                    }
                }
            }
            if (pending_module is .some(import_module)) {
                if (!self.ensure_lookup_import(graph, import_module, pending_index)) {
                    return false;
                }
                continue;
            }
            if (pending_declaration is .some(dependency_def)) {
                if (!self.ensure_declaration_signature(graph, dependency_def)) {
                    return false;
                }
                continue;
            }
            return lowered;
        }
        return false;
    }

    Bool ensure_interface_module_model(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        qid.DefId module_def = self.ctx.store.resolve.module_ref(module_id).def_id;
        if (self.ctx.store.model.declaration_sema_state(module_def) == .body_ready) {
            return true;
        }
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        guard self.ctx.store.artifacts.load_interface(source_id)
            is .some(module_interface) else {
            return false;
        }
        Int index! = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            guard self.ctx.store.incremental.current_def_for_stable(declaration.stable_id)
                is .some(def_id) else {
                self.ctx.store.model.mark_error();
                return false;
            }
            if (!self.ensure_declaration_model(graph, def_id)) { return false; }
            index = index + 1;
        }
        self.finish_declaration_sema(module_def);
        return true;
    }

    Bool ensure_interface_declaration_facts(
        Self&! self,
        qid.ModuleId module_id,
        qid.DefId def_id
    ) {
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        guard self.ctx.store.artifacts.load_interface(source_id)
            is .some(module_interface) else {
            return false;
        }
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        return loader.ensure_declaration_facts(def_id, module_interface);
    }

    Bool ensure_lookup_import(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id,
        Int import_index
    ) {
        return self.ensure_lookup_import_target(graph, module_id, import_index) != null;
    }

    qid.ModuleId? ensure_lookup_import_target(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id,
        Int import_index
    ) {
        qid.ModuleId target_module!;
        {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.discover_module_imports(graph, module_id);
            if (!builder.ensure_import_target(graph, module_id, import_index)) {
                return null;
            }
            guard self.ctx.store.resolve.module_ref(module_id).imports.get(import_index).target_module
                is .some(resolved_target) else { return null; }
            target_module = resolved_target;
        }
        module_graph_builder.ModuleResolvePassState progress = self.module_state(target_module);
        if (progress == .resolved || progress == .interface_loaded) {
            return target_module;
        }
        source.SourceId target_source = self.ctx.store.resolve.module_ref(target_module).source_id;
        db.begin_source_observations(self.ctx.query$.ref(), target_source);
        {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            if (self.owner.asts.get(target_source) == null
                && !builder.ensure_file_source_ast(target_source)
            ) { return null; }
            builder.ensure_declarations(target_source);
        }
        if (self.module_state(target_module) != .declarations_ready
            && self.module_state(target_module) != .declarations_collected
            && self.module_state(target_module) != .resolving
            && self.module_state(target_module) != .resolved
            && self.module_state(target_module) != .interface_loaded
        ) {
            return null;
        }
        if (!self.prepare_module_comptime(graph, target_module)) { return null; }
        return target_module;
    }

    Bool ensure_module_extend_members(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        module_graph_builder.ModuleResolvePassState progress = self.module_state(module_id);
        if (progress == .failed) { return false; }
        if (progress == .resolved || progress == .interface_loaded) { return true; }
        if (self.owner.extension_skeletons.has(module_id)) { return true; }
        if (progress != .declarations_ready
            && progress != .declarations_collected
            && progress != .resolving
        ) { return false; }
        // 这个集合只表示按需 extension skeleton pass 已进入或完成，不代替
        // declarations_collected；最终 alias -> extension 固定点仍保留原状态边界。
        self.owner.extension_skeletons.add(module_id);
        while (true) {
            qid.ModuleId? pending_module! = null;
            Int pending_index! = -1;
            qid.DefId? pending_declaration! = null;
            {
                store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
                guard self.owner.asts.get(module.source_id) is .some(unit) else { return false; }
                resolve_state.AstResolveState state! = resolve_state.AstResolveState(
                    self.ctx$.mut_ref(),
                    unit,
                    self.owner.declaration_defs$.mut_ref(),
                    self.owner.declaration_items$.mut_ref(),
                    self.owner.declaration_containers$.mut_ref(),
                    module_id,
                    module.namespace_id
                );
                name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
                resolver.collect_extend_members();
                if (state.has_pending_import()) {
                    pending_module = state.pending_import_module;
                    pending_index = state.pending_import_index;
                }
                pending_declaration = state.pending_declaration;
            }
            if (pending_module is .some(import_module)) {
                if (!self.ensure_lookup_import(graph, import_module, pending_index)) {
                    self.set_module_state(module_id, .failed);
                    return false;
                }
                continue;
            }
            if (pending_declaration is .some(dependency_def)) {
                if (!self.ensure_declaration_signature(graph, dependency_def)) {
                    self.set_module_state(module_id, .failed);
                    return false;
                }
                continue;
            }
            return !self.ctx.store.model.has_errors();
        }
        return false;
    }

    Bool container_supports_member_ensure(
        Self&! self,
        source.SourceId source_id,
        ast.AstId item_id
    ) {
        guard self.owner.asts.get(source_id) is .some(unit) else { return false; }
        ast.AstNode item = unit.get(item_id);
        if (item.data is .extern_block(_)) { return true; }
        guard item.data is .top_level_decl(top_level) else { return false; }
        ast.AstNode body = unit.get(top_level.body);
        if (body.data is .extend_decl(_)) { return true; }
        return body.data is .nominal_decl(_) || body.data is .trait_decl(_);
    }

    qid.ModuleId? declaration_module_id(Self&! self, qid.DefId def_id) {
        return self.ctx.store.defs.get(def_id).module_id;
    }

    Bool module_allows_declaration_ensure(
        Self&! self,
        module_graph_builder.ModuleResolvePassState state
    ) {
        return state == .declarations_ready
            || state == .declarations_collected
            || state == .resolving;
    }

    qid.DefId? top_level_item_def(
        Self& self,
        ast.AstUnit& unit,
        qid.ModuleId module_id,
        ast.AstId item_id
    ) {
        guard resolve_state.top_level_declaration_name(unit, item_id) is .some(name) else {
            return null;
        }
        guard self.owner.declaration_defs.get(resolve_state.DeclarationDefKey(module_id, name))
            is .some(found) else {
            return null;
        }
        return found$.get();
    }

    Void finish_declaration_sema(Self&! self, qid.DefId def_id) {
        self.ctx.store.model.set_declaration_sema_state(def_id, .signature_ready);
        // 没有源码 body 的 declaration 也已经完成；body_ready 表示无需再推进，
        // 不要求 sem.Def.body 一定非空。
        self.ctx.store.model.set_declaration_sema_state(def_id, .body_ready);
    }

    Bool lower_module_bodies_to_model(
        Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        self.set_module_state(module_id, .resolving);
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(module_id).namespace_id;
        qid.DefId module_def = self.ctx.store.resolve.module_ref(module_id).def_id;
        list.ArrayList<qid.DefId> declarations =
            self.top_level_declaration_defs_for_source(source_id, module_id);
        Int declaration_index! = 0;
        while (declaration_index < declarations.len()) {
            if (!self.ensure_declaration_model(graph, declarations.get(declaration_index))) {
                self.set_module_state(module_id, .failed);
                return false;
            }
            declaration_index = declaration_index + 1;
        }
        ast.AstUnit& unit = self.owner.asts.get(source_id)$.some();
        Bool model_errors!;
        Bool lowered! = false;
        {
            resolve_state.AstResolveState state! = resolve_state.AstResolveState(
                self.ctx$.mut_ref(),
                unit,
                self.owner.declaration_defs$.mut_ref(),
                self.owner.declaration_items$.mut_ref(),
                self.owner.declaration_containers$.mut_ref(),
                module_id,
                namespace_id
            );
            {
                name_resolver.NameResolver resolver! =
                    name_resolver.NameResolver(state$.mut_ref());
                resolver.resolve_references();
            }
            model_errors = state.ctx.store.model.has_errors();
            if (!model_errors) {
                lowered = model_lower.lower_unit(state$.mut_ref());
            }
        }
        if (model_errors) {
            self.set_module_state(module_id, .failed);
            self.ctx.store.model.mark_error();
            return false;
        }
        if (!lowered) {
            self.set_module_state(module_id, .failed);
            return false;
        }
        self.finish_declaration_sema(module_def);
        self.set_module_state(module_id, .resolved);
        return true;
    }

    list.ArrayList<qid.DefId> top_level_declaration_defs_for_source(
        Self& self,
        source.SourceId source_id,
        qid.ModuleId module_id
    ) {
        list.ArrayList<qid.DefId> declarations! = list.ArrayList<qid.DefId>();
        guard self.owner.asts.get(source_id) is .some(unit) else { return declarations; }
        guard unit.root is .some(root_id) else { return declarations; }
        ast.AstNode root = unit.get(root_id);
        guard ast.root_data(root.data) is .some(root_data) else { return declarations; }
        Int index! = 0;
        while (index < root_data.items.length) {
            ast.AstId item_id = unit.child_at(root_data.items, index);
            if (self.top_level_item_def(unit, module_id, item_id) is .some(def_id)) {
                declarations.add(def_id);
            }
            index = index + 1;
        }
        return declarations$.move();
    }

    Void collect_module_graph_declarations(Self&! self, module_graph.ModuleGraph& graph) {
        self.prepare_module_graph_declarations(graph);
        self.collect_module_graph_declaration_names(graph);
        self.bind_core_declarations();
        self.collect_module_graph_aliases(graph);
        self.record_core_functions_if_ready();
        self.collect_module_graph_extend_members(graph);
        self.load_module_graph_interface_extension_groups(graph);
    }

    Void bind_core_declarations(Self&! self) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        self.bind_core_primitive_types(core_module);
        self.bind_core_named_types(core_module);
        self.bind_core_value(core_module, "assert");
        self.bind_standard_domains(core_module);
        self.bind_core_trait(core_module, "Movable");
        self.bind_core_trait(core_module, "Copyable");
        self.bind_core_trait(core_module, "Mutable");
        self.bind_core_trait(core_module, "Sendable");
        self.bind_core_trait(core_module, "Equatable");
        self.bind_core_trait(core_module, "Hasher");
        self.bind_core_trait(core_module, "Hashable");
        self.bind_core_trait(core_module, "Iterator");
        self.bind_core_trait(core_module, "Sequence");
        self.bind_core_trait(core_module, "Contiguous");
        self.bind_core_trait(core_module, "Collection");
        self.bind_core_trait(core_module, "Executor");
        self.bind_core_trait(core_module, "Domain");
        self.bind_core_trait(core_module, "AtomicValue");
        self.bind_core_namespace(core_module, "coroutine");
        // alias 解析可能立即触发普通 comptime；发布 namespace 时同步登记其内建函数身份。
        self.record_reflect_module_if_ready();
        self.record_generate_functions_if_ready();
    }

    Void bind_core_declarations_if_ready(Self&! self) {
        if (self.owner.core_declarations_bound) { return; }
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        module_graph_builder.ModuleResolvePassState state = self.module_state(core_module);
        if (state != .collecting_declarations
            && state != .declarations_ready
            && state != .declarations_collected
            && state != .interface_loaded
        ) {
            return;
        }
        self.bind_core_declarations();
        self.owner.core_declarations_bound = true;
    }

    Void bind_core_primitive_types(Self&! self, qid.ModuleId core_module) {
        self.bind_core_primitive_type(
            core_module,
            "Void",
            self.ctx.store.types.unit_type(),
            self.ctx.store.resolve.core_types.void_type
        );
        self.bind_core_primitive_type(
            core_module, "Bool", self.ctx.store.types.bool_type(), self.ctx.store.resolve.core_types.bool_type
        );
        self.bind_core_primitive_type(
            core_module, "Int", self.ctx.store.types.int_type(), self.ctx.store.resolve.core_types.int_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt", self.ctx.store.types.uint_type(), self.ctx.store.resolve.core_types.uint_type
        );
        self.bind_core_primitive_type(
            core_module, "Int8", self.ctx.store.types.int8_type(), self.ctx.store.resolve.core_types.int8_type
        );
        self.bind_core_primitive_type(
            core_module, "Int16", self.ctx.store.types.int16_type(), self.ctx.store.resolve.core_types.int16_type
        );
        self.bind_core_primitive_type(
            core_module, "Int32", self.ctx.store.types.int32_type(), self.ctx.store.resolve.core_types.int32_type
        );
        self.bind_core_primitive_type(
            core_module, "Int64", self.ctx.store.types.int64_type(), self.ctx.store.resolve.core_types.int64_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt8", self.ctx.store.types.uint8_type(), self.ctx.store.resolve.core_types.uint8_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt16", self.ctx.store.types.uint16_type(), self.ctx.store.resolve.core_types.uint16_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt32", self.ctx.store.types.uint32_type(), self.ctx.store.resolve.core_types.uint32_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt64", self.ctx.store.types.uint64_type(), self.ctx.store.resolve.core_types.uint64_type
        );
        self.bind_core_primitive_type(
            core_module, "Float16", self.ctx.store.types.float16_type(), self.ctx.store.resolve.core_types.float16_type
        );
        self.bind_core_primitive_type(
            core_module, "Float", self.ctx.store.types.float_type(), self.ctx.store.resolve.core_types.float_type
        );
        self.bind_core_primitive_type(
            core_module, "Float32", self.ctx.store.types.float_type(), self.ctx.store.resolve.core_types.float32_type
        );
        self.bind_core_primitive_type(
            core_module, "Float64", self.ctx.store.types.double_type(), self.ctx.store.resolve.core_types.float64_type
        );
        self.bind_core_primitive_type(
            core_module, "Double", self.ctx.store.types.double_type(), self.ctx.store.resolve.core_types.double_type
        );
        self.bind_core_primitive_type(
            core_module, "Char", self.ctx.store.types.char_type(), self.ctx.store.resolve.core_types.char_type
        );
    }

    Void bind_core_primitive_type(Self&! self,
        qid.ModuleId core_module,
        UInt8[]& name,
        qid.TypeId type_id,
        qid.DefId? existing
    ) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        qid.DefId def_id = self.core_primitive_type_def(core_module, symbol, existing);
        self.ctx.store.types.bind_builtin_type_def(def_id, type_id);
        self.ctx.store.resolve.set_core_primitive_type(name, def_id);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_primitive_type_def(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId? existing) {
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        return def_id;
    }

    Void bind_core_named_types(Self&! self, qid.ModuleId core_module) {
        self.core_type_def_or_existing(
            core_module, "Task", self.ctx.store.resolve.core_types.task_type
        );
        self.core_type_def_or_existing(
            core_module, "RawFn", self.ctx.store.resolve.core_types.raw_fn_type
        );
        self.core_type_def_or_existing(
            core_module, "Fn", self.ctx.store.resolve.core_types.fn_type
        );
        self.core_type_def_or_existing(
            core_module, "FnOnce", self.ctx.store.resolve.core_types.fn_once_type
        );
        self.core_type_def_or_existing(core_module, "DomainKind", null);
        qid.DefId executor_job = self.core_type_def_or_existing(core_module, "ExecutorJob", null);
        qid.DefId main_executor =
            self.core_type_def_or_existing(core_module, "MainExecutor", null);
        qid.DefId serial_executor = self.core_type_def_or_existing(core_module, "SerialExecutor", null);
        qid.DefId concurrent_executor =
            self.core_type_def_or_existing(core_module, "ConcurrentExecutor", null);
        self.ctx.store.resolve.set_executor_types(
            executor_job, main_executor, serial_executor, concurrent_executor
        );
        self.core_type_def_or_existing(core_module, "Atomic", null);
        self.core_type_def_or_existing(core_module, "MemoryOrder", null);
        self.core_type_def_or_existing(core_module, "Mutex", null);
    }

    Void bind_core_type_alias(Self&! self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? target_def) {
        guard target_def is .some(def_id) else { return; }
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_type_def_or_existing(Self&! self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? existing) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            self.bind_core_prelude_type(symbol, binding.def_id);
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
        return def_id;
    }

    Void bind_core_module_type(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId def_id) {
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(core_module).namespace_id;
        if (self.ctx.store.resolve.first_binding(namespace_id, symbol, .type_name) != null) {
            return;
        }
        // core 源码不再重复声明 builtin type；没有源码绑定时，把启动期
        // builtin DefId 暴露为 core module 的公开类型名。
        self.ctx.store.resolve.bind_name(
            namespace_id,
            symbol,
            .type_name,
            def_id,
            .public_visibility,
            token.Span()
        );
    }

    Void bind_core_trait(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        guard self.core_trait_binding(core_module, symbol) is .some(binding) else {
            return;
        }
        if (name == "Movable") {
            self.ctx.store.resolve.set_movable_trait(binding.def_id);
        } else if (name == "Copyable") {
            self.ctx.store.resolve.set_copyable_trait(binding.def_id);
        } else if (name == "Mutable") {
            self.ctx.store.resolve.set_mutable_trait(binding.def_id);
        } else if (name == "Sendable") {
            self.ctx.store.resolve.set_sendable_trait(binding.def_id);
        } else if (name == "Equatable") {
            self.ctx.store.resolve.set_equatable_trait(binding.def_id);
        } else if (name == "Hashable") {
            self.ctx.store.resolve.set_hashable_trait(binding.def_id);
        } else if (name == "Iterator") {
            self.ctx.store.resolve.set_iterator_trait(binding.def_id);
        } else if (name == "Sequence") {
            self.ctx.store.resolve.set_sequence_trait(binding.def_id);
        } else if (name == "Contiguous") {
            self.ctx.store.resolve.set_contiguous_trait(binding.def_id);
        } else if (name == "Collection") {
            self.ctx.store.resolve.set_collection_trait(binding.def_id);
        } else if (name == "Executor") {
            self.ctx.store.resolve.set_executor_trait(binding.def_id);
        } else if (name == "Domain") {
            self.ctx.store.resolve.set_domain_trait(binding.def_id);
        }
        self.bind_core_prelude_trait(symbol, binding.def_id);
    }

    namespace.BindingEntry? core_type_binding(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        qid.NamespaceId namespace_id = module.namespace_id;
        Int import_count = module.imports.len();
        if (self.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding)) {
            return self.valid_core_type_binding(binding);
        }
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(core_module).imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_type_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_type_binding_in_module(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        return self.valid_core_type_binding(binding);
    }

    namespace.BindingEntry? valid_core_type_binding(Self&! self, namespace.BindingEntry binding) {
        def.DefRecord record = self.ctx.store.defs.get(binding.def_id);
        if (record.visibility != .public_visibility) { return null; }
        if (record.kind == .builtin_type_def) { return binding; }
        if (record.kind == .struct_def) { return binding; }
        if (record.kind == .enum_def) { return binding; }
        return null;
    }

    namespace.BindingEntry? core_trait_binding(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        qid.NamespaceId namespace_id = module.namespace_id;
        Int import_count = module.imports.len();
        if (self.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding)) {
            return binding;
        }
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(core_module).imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_trait_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_trait_binding_in_module(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        def.DefRecord record = self.ctx.store.defs.get(binding.def_id);
        if (record.kind != .trait_def || record.visibility != .public_visibility) {
            return null;
        }
        return binding;
    }

    Void bind_core_prelude_trait(Self&! self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .type_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_prelude_type(Self&! self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .type_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_value(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        guard self.core_value_binding(core_module, symbol) is .some(binding) else { return; }
        self.bind_core_prelude_value(symbol, binding.def_id);
    }

    Void bind_standard_domains(Self&! self, qid.ModuleId core_module) {
        qid.SymbolId main_symbol = self.ctx.store.symbols.intern("main_domain");
        qid.SymbolId global_symbol = self.ctx.store.symbols.intern("global_domain");
        guard self.core_value_binding(core_module, main_symbol)
            is .some(main_binding) else {
            return;
        }
        guard self.core_value_binding(core_module, global_symbol)
            is .some(global_binding) else {
            return;
        }
        self.bind_core_prelude_value(main_symbol, main_binding.def_id);
        self.bind_core_prelude_value(global_symbol, global_binding.def_id);
        self.ctx.store.resolve.set_standard_domains(
            main_binding.def_id, global_binding.def_id
        );
    }

    Void bind_core_namespace(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else {
            return;
        }
        self.record_core_namespace_functions(name, binding);
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .namespace_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .namespace_name, binding.def_id, token.Span());
    }

    Void record_core_functions_if_ready(Self&! self) {
        self.record_reflect_module_if_ready();
        self.record_generate_functions_if_ready();
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        qid.SymbolId symbol = self.ctx.store.symbols.intern("coroutine");
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else { return; }
        self.record_core_namespace_functions("coroutine", binding);
    }

    #doc 生成输出能力绑定到 core 的真实函数身份，普通同名声明不会获得宿主能力。
    Void record_generate_functions_if_ready(Self&! self) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        qid.NamespaceId core_namespace = self.ctx.store.resolve.module_ref(core_module).namespace_id;
        qid.SymbolId symbol = self.ctx.store.symbols.intern("generate");
        guard self.ctx.store.resolve.lookup_namespace(core_namespace, symbol, .namespace_name, false)
            is .some(binding) else { return; }
        guard self.ctx.store.defs.get(binding.def_id).owned_namespace_id is .some(namespace_id) else { return; }
        self.ctx.store.resolve.core_functions.generate_write = self.core_member_function(namespace_id, "generate_write");
        self.ctx.store.resolve.core_functions.generate_read = self.core_member_function(namespace_id, "generate_read");
        self.ctx.store.resolve.core_functions.generate_cache_read =
            self.core_member_function(namespace_id, "generate_cache_read");
        self.ctx.store.resolve.core_functions.generate_cache_write =
            self.core_member_function(namespace_id, "generate_cache_write");
        self.ctx.store.resolve.core_functions.generate_resource_bytes =
            self.core_member_function(namespace_id, "generate_resource_bytes");
        self.bind_core_namespace(core_module, "generate");
    }

    #doc 从 compiler core 的 namespace 绑定记录标准句柄身份，不接受用户同名类型。
    Void record_reflect_module_if_ready(Self&! self) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        qid.NamespaceId core_namespace = self.ctx.store.resolve.module_ref(core_module).namespace_id;
        qid.SymbolId reflect_symbol = self.ctx.store.symbols.intern("reflect");
        guard self.ctx.store.resolve.lookup_namespace(core_namespace, reflect_symbol, .namespace_name, false)
            is .some(binding) else { return; }
        guard self.ctx.store.defs.get(binding.def_id).owned_namespace_id is .some(namespace_id) else { return; }
        qid.SymbolId module_symbol = self.ctx.store.symbols.intern("Module");
        guard self.ctx.store.resolve.lookup_namespace(namespace_id, module_symbol, .type_name, false)
            is .some(module_binding) else { return; }
        self.ctx.store.resolve.core_types.reflect_module_type = module_binding.def_id;
        self.ctx.store.resolve.core_functions.reflect_location_fingerprint =
            self.core_member_function(namespace_id, "reflect_location_fingerprint");
        self.ctx.store.resolve.core_functions.reflect_module_fingerprint =
            self.core_member_function(namespace_id, "reflect_module_fingerprint");
