// import path 到 SourceKey/SourceId 的解析规则。

alias string = import "../support/string.jiang";
alias store_api = import "../store.jiang";
alias qid = import "../id.jiang";
alias source = import "../source.jiang";
alias store = import "./store.jiang";
import std;

@region(a)
public struct ImportPathResolver: Copyable {
    @life(a)
    store_api.CompilerStore& store;

    public init(self, store_api.CompilerStore& store) {
        self.store = store;
    }

    public source.SourceKey key_for_virtual_import(self, store.ImportRecord& import_record) {
        UInt8[]& text = self.store.symbols.text(import_record.path_symbol);
        return .virtual(text);
    }

    // 只做 SourceStore 里已登记 source 的反查，不负责从磁盘读取。
    // 文件 import 路径必须显式写全，不隐式补扩展名或目录入口。
    public source.SourceId? find_import_source(self, qid.ModuleId module_id, store.ImportRecord& import_record) {
        if (import_record.kind != .file_import) {
            return self.store.sources.find(self.key_for_virtual_import(import_record));
        }
        UInt8[]& import_path = self.store.symbols.text(import_record.path_symbol);
        if (self.find_file_source(module_id, import_path) is .some(source_id)) {
            return source_id;
        }
        return null;
    }

    /// 从已登记的包配置或内建资源定位入口，不加载源码或运行生成器。
    public Path? package_import_path(self, qid.ModuleId module_id, qid.SymbolId path_symbol) {
        qid.PackageId package_id = self.store.resolve.module_ref(module_id).package_id;
        if (self.store.resolve.package_dependency(package_id, path_symbol) is .some(dependency)) {
            guard self.store.resolve.package_for_dir(dependency.path_symbol) is .some(target) else { return null; }
            return Path(self.store.symbols.text(self.store.resolve.package_ref(target).root_path));
        }
        UInt8[]& path = self.store.symbols.text(path_symbol);
        if (string.equal(path, "std")) { return self.store.sources.builtin_path("src/std/std.jiang"); }
        if (string.equal(path, "build")) { return self.store.sources.builtin_path("src/std/build.jiang"); }
        if (string.equal(path, "core")) { return self.store.sources.builtin_path("src/compiler/core.jiang"); }
        return null;
    }

    public Bool valid_import_path(self, store.ImportRecord& import_record) {
        if (import_record.path_symbol.to_index() <= 0) {
            return false;
        }
        UInt8[]& text = self.store.symbols.text(import_record.path_symbol);
        return text.length > 0;
    }

    public source.SourceId? find_file_source(self, qid.ModuleId module_id, UInt8[]& import_path) {
        Path primary = self.primary_file_import_path(module_id, import_path);
        if (self.store.sources.find(.file(primary.bytes())) is .some(source_id)) {
            return source_id;
        }
        return null;
    }

    // 计算 import 字面量对应的主路径。
    // 相对路径以当前 module 的 source 文件目录为基准；virtual source 则以原文本为基准。
    public Path primary_file_import_path(self, qid.ModuleId module_id, UInt8[]& import_path) {
        if (std.path.is_absolute(import_path)) {
            return std.path.normalize(import_path);
        }

        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        source.SourceInfo& source_record = self.store.sources.entry(module.source_id);
        if (!source_record.key.is_file()) {
            return std.path.normalize(import_path);
        }
        UInt8[]& dirname = std.path.dirname(source_record.name());
        Path joined = std.path.join(dirname, import_path);
        return std.path.normalize(joined.bytes());
    }
}
