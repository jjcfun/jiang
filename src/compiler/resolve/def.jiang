// Definition records and the global DefId table.

import qid = "../id.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct Name: Copyable {
    public qid.SymbolId symbol;
    public token.Span span;
}

public enum NameDomain {
    type_name,
    value_name,
    member_name,
    label_name,
    namespace_name,
    // 仅用于 declaration name collection 尚未解析 target 的 alias skeleton。
    alias_name,
}

public enum Visibility {
    private_visibility,
    public_visibility,
}

public enum DefKind {
    package_def,
    module_def,
    import_alias_def,
    alias_def,
    extension_def,
    struct_def,
    enum_def,
    trait_def,
    trait_companion_type_def,
    function_def,
    init_def,
    deinit_def,
    global_def,
    field_def,
    enum_case_def,
    associated_type_def,
    generic_param_def,
    parameter_def,
    local_def,
    builtin_type_def,
    builtin_value_def,
    error_def,
}

public enum TraitCompanionKind {
    any,
    vtable,
    receiver,
}

public struct TraitCompanionInfo: Copyable {
    public qid.DefId trait_def;
    public TraitCompanionKind kind;
}

public struct DefRecord: Copyable {
    public qid.DefId id;
    public DefKind kind;
    public NameDomain domain!;
    public Visibility visibility;
    public Name name;
    public qid.DefId? owner_def;
    public qid.ModuleId? module_id;
    public qid.NamespaceId decl_namespace_id!;
    public qid.NamespaceId? owned_namespace_id!;
    public qid.DefId? associated_trait_member!;
    public TraitCompanionInfo? trait_companion!;
}

public struct DefStore: Movable {
    public table.ArrayTable<qid.DefId, DefRecord> records!;

    public init(self) {
        self.records = table.ArrayTable<qid.DefId, DefRecord>();
    }

    public qid.DefId create(Self&! self,
        DefKind kind,
        NameDomain domain,
        Visibility visibility,
        Name name,
        qid.DefId? owner_def,
        qid.ModuleId? module_id,
        qid.NamespaceId decl_namespace_id,
        qid.NamespaceId? owned_namespace_id
    ) {
        qid.DefId def_id = self.records.next_id();
        self.records.append(DefRecord (
            id: def_id,
            kind: kind,
            domain: domain,
            visibility: visibility,
            name: name,
            owner_def: owner_def,
            module_id: module_id,
            decl_namespace_id: decl_namespace_id,
            owned_namespace_id: owned_namespace_id,
            associated_trait_member: null,
            trait_companion: null
        ));
        return def_id;
    }

    public Int len(self) {
        return self.records.len();
    }

    public Bool has(self, qid.DefId id) {
        return self.records.has(id);
    }

    public DefRecord get(self, qid.DefId id) {
        return self.records.get(id);
    }

    public DefRecord& ref_at(self, qid.DefId id) {
        return self.records.ref_at(id);
    }

    public Void set_owned_namespace(
        Self&! self,
        qid.DefId id,
        qid.NamespaceId? namespace_id
    ) {
        DefRecord&! record = self.records.mut_ref_at(id);
        record.owned_namespace_id = namespace_id;
    }

    public Void set_domain(Self&! self, qid.DefId id, NameDomain domain) {
        DefRecord&! record = self.records.mut_ref_at(id);
        record.domain = domain;
    }

    public Void set_associated_trait_member(Self&! self, qid.DefId id, qid.DefId? member) {
        DefRecord&! record = self.records.mut_ref_at(id);
        record.associated_trait_member = member;
    }

    public Void set_trait_companion(Self&! self, qid.DefId id, TraitCompanionInfo? companion) {
        DefRecord&! record = self.records.mut_ref_at(id);
        record.trait_companion = companion;
    }
}
