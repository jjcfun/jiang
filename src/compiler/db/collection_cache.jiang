#doc(module)
    语义集合的共同缓存项：拥有有序结果及其惰性指纹，发布后只读，随查询会话一同重置。
    遍历直接读取固定结果；只有首次指纹编码需要写入缓存，不对每次元素访问加锁。
#end

alias qkey = import "../incremental/key.jiang";
alias list = import "../support/list.jiang";
alias map = import "../support/map.jiang";
import std;

@region(v: V)
@where(V: Copyable)
struct CollectionResult<V>: Movable {
    @life(v)
    public list.ArrayList<V> values;
    Mutex<qkey.Fingerprint128?>^ memo;

    public init(self, list.ArrayList<V> values) {
        self.values = values;
        self.memo = new Mutex<qkey.Fingerprint128?>(null);
    }

    @life(return: self.v)
    public V at(self, Int index) { return self.values.get(index); }

    #doc 编码只借用这份固定集合，不递归调用本缓存；未就绪的稳定身份不缓存为完成指纹。
    public qkey.Fingerprint128? fingerprint(self, FnOnce<qkey.Fingerprint128?, list.ArrayList<V>&> encode) {
        return self.memo.with_lock<qkey.Fingerprint128?>({ [ref self, encode] cached =>
            if (cached$.get() is .some(value)) { return value; }
            guard encode(self.values$.ref()) is .some(value) else { return null; }
            cached$.set(value);
            return value;
        });
    }
}

@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable, V: Copyable)
public struct CollectionCache<K, V>: Movable {
    @life(k, v)
    map.WyHashMap<K, CollectionResult<V>> entries!;

    public init(self) { self.entries = map.WyHashMap<K, CollectionResult<V>>(); }
    public Void reset(Self&! self) { self.entries.clear(); }
    public Bool has(self, K key) { return self.entries.has(key); }

    #doc 空集也是完成值；同一会话不覆盖已经发布的集合及其指纹。
    public Void publish(Self&! self, K key, list.ArrayList<V> values) {
        assert(!self.entries.has(key));
        self.entries.set(key, CollectionResult<V>(values));
    }

    #doc 借用已经发布的集合，不复制元素；借用期间不能重置或修改缓存。
    @life(return: (self, self.v))
    public V[]& slice(self, K key) { return self.entries.get(key)$.some().values.slice(); }

    public Int count(self, K key) { return self.entries.get(key)$.some().values.len(); }

    #doc 携带借用的结果限定在本查询会话内；无借用的声明和模块 ID 仍按值返回。
    @life(return: self)
    public V at(self, K key, Int index) { return self.entries.get(key)$.some().at(index); }

    #doc 未发布集合不调用编码器；成功编码一次后所有消费者直接复用同一项中的指纹。
    public qkey.Fingerprint128? fingerprint(self, K key,
        FnOnce<qkey.Fingerprint128?, list.ArrayList<V>&> encode
    ) {
        guard self.entries.get(key) is .some(result) else { return null; }
        return result.fingerprint(encode);
    }
}
