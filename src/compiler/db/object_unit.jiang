// source / monomorph object unit 的 L2 复用决策。
//
// `.jbuild` 仍拥有持久 work product；query 只按完整 input fingerprint 验证
// object 并缓存本轮 reuse/emit 结果。

alias map = import "../support/map.jiang";
alias build_manifest = import "../artifact/build_manifest.jiang";
alias cache_identity = import "../artifact/cache_identity.jiang";
alias object_hash = import "../artifact/object_hash.jiang";
alias artifact_path = import "../artifact/path.jiang";
alias qkey = import "../incremental/key.jiang";
alias source_graph = import "../incremental/source_graph.jiang";
alias core_traits = import "../core/traits.jiang";
alias query_cache = import "./query_cache.jiang";
alias system_fs = import "../system/fs.jiang";
import std;

public struct ObjectUnitKey: Copyable, Hashable, Equatable {
    public cache_identity.StableSourceId source;
    public build_manifest.WorkProductKind kind;
    public qkey.Fingerprint128 input;

    public init(self,
        cache_identity.StableSourceId source,
        build_manifest.WorkProductKind kind,
        qkey.Fingerprint128 input
    ) {
        self.source = source;
        self.kind = kind;
        self.input = input;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.source.hash(hasher);
        hasher.write(Int(self.kind));
        self.input.hash(hasher);
    }

    public Bool equal(ObjectUnitKey& lhs, ObjectUnitKey& rhs) {
        return lhs.source == rhs.source
            && lhs.kind == rhs.kind
            && lhs.input == rhs.input;
    }
}

public enum ObjectUnitResult: Copyable {
    reuse(build_manifest.WorkProduct),
    emit,
}

public struct ObjectUnitQuery: Movable {
    Mutex<query_cache.QueryCache<ObjectUnitKey, ObjectUnitResult>>^ cache;
    Mutex<map.WyHashMap<cache_identity.StableSourceId, qkey.Fingerprint128>>^ reflection_inputs;

    public init(self) {
        self.cache = new Mutex<query_cache.QueryCache<
            ObjectUnitKey,
            ObjectUnitResult
        >>(query_cache.QueryCache<ObjectUnitKey, ObjectUnitResult>());
        self.reflection_inputs = new Mutex<map.WyHashMap<cache_identity.StableSourceId, qkey.Fingerprint128>>(
            map.WyHashMap<cache_identity.StableSourceId, qkey.Fingerprint128>());
    }

    #doc 只有 debug object 恢复阶段要求与上次发射事实一致；普通 check／generate 不受旧 object 约束。
    public Bool reflection_inputs_match(self, cache_identity.StableSourceId source, qkey.Fingerprint128 current) {
        return self.reflection_inputs.with_lock({ [source, current] entries =>
            guard entries.get(source) is .some(expected) else { return true; }
            return expected$.get() == current;
        });
    }

    public Void reset(self) {
        self.cache.with_lock<Void>({ cache => cache.reset(); });
        self.reflection_inputs.with_lock<Void>({ entries => entries.clear(); });
    }

    public ObjectUnitResult evaluate(
        self,
        ObjectUnitKey key,
        build_manifest.BuildManifest?& previous,
        UInt8[]& path
    ) {
        ObjectUnitResult? cached = self.cache.with_lock({ cache =>
            cache.lookup(key)
        });
        if (cached is .some(result)) { return result; }
        ObjectUnitResult result! = .emit();
        if (reusable_product(previous, key, path) is .some(product)) {
            result = .reuse(product);
        }
        self.cache.with_lock<Void>({ cache => cache.publish(key, result); });
        return result;
    }

    // `.ji` 只证明 Semantic Model 可恢复。debug codegen 若没有完整 source /
    // monomorph object coverage，必须在 model lowering 前强制该 source 回源。
    public Void require_debug_source_products(
        self,
        source_graph.SourceDependencyGraph&! graph,
        UInt8[]& context_root,
        qkey.Fingerprint128 target_identity,
        qkey.Fingerprint128 context_fingerprint
    ) {
        build_manifest.BuildManifest? previous = build_manifest.load(
            context_root,
            target_identity,
            context_fingerprint
        );
        self.reflection_inputs.with_lock<Void>({ entries => entries.clear(); });
        if (previous is .some(ref _ state)) {
            Int product_index! = 0;
            while (product_index < state.work_product_count()) {
                build_manifest.WorkProduct product = state.work_product_at(product_index);
                product_index = product_index + 1;
                if (product.kind != .source_unit) { continue; }
                self.reflection_inputs.with_lock<Void>({ [product] entries =>
                    entries.set(cache_identity.StableSourceId(product.source_identity), product.reflection_inputs);
                });
            }
        }
        Int index! = 0;
        while (index < graph.node_count()) {
            source_graph.SourceNodeId node_id = source_graph.SourceNodeId(index);
            source_graph.SourceNode& node = graph.node(node_id);
            if (!node.source_dirty && (node.dependency_candidate
                || !source_products_available(previous$.ref(), node.identity, context_root))) {
                graph.mark_source_dirty(node_id);
            }
            index = index + 1;
        }
        // interface hash 相同只证明声明可复用，不能证明旧 object 的实现依赖仍有效。
        // 在 model/JIL lowering 前恢复所有 implementation importers，重新建立定义闭包。
        graph.propagate_codegen_dirtiness();
    }
}

Bool source_products_available(
    build_manifest.BuildManifest?& previous,
    cache_identity.StableSourceId identity,
    UInt8[]& context_root
) {
    guard previous is .some(ref _ state) else { return false; }
    UInt8[]^ source_path = artifact_path.stable_source_object_path(context_root, identity);
    if (!build_manifest.work_product_is_available(
        state,
        identity.fingerprint,
        .source_unit,
        source_path[..]
    )) {
        return false;
    }
    guard state.find_work_product(identity.fingerprint, .monomorph_unit)
        is .some(_) else {
        return true;
    }
    UInt8[]^ mono_path =
        artifact_path.stable_source_monomorph_object_path(context_root, identity);
    return build_manifest.work_product_is_available(
        state,
        identity.fingerprint,
        .monomorph_unit,
        mono_path[..]
    );
}

build_manifest.WorkProduct? reusable_product(
    build_manifest.BuildManifest?& previous,
    ObjectUnitKey key,
    UInt8[]& path
) {
    guard previous is .some(ref _ state) else { return null; }
    guard state.find_work_product(key.source.fingerprint, key.kind)
        is .some(product) else {
        return null;
    }
    if (product.input_fingerprint != key.input) { return null; }
    guard system_fs.file_metadata(path) is .some(metadata) else { return null; }
    if (metadata.size < 0) { return null; }
    if (product.object_modified_ns == metadata.modified_ns
        && product.object_size == UInt64(metadata.size)) {
        return product;
    }
    guard object_hash.hash_file(path) is .some(actual_hash) else { return null; }
    if (actual_hash != product.object_hash) { return null; }
    return build_manifest.WorkProduct(
        product.source_identity,
        product.kind,
        product.input_fingerprint,
        product.object_hash,
        metadata.modified_ns,
        UInt64(metadata.size)
    );
}
