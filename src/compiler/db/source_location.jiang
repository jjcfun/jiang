#doc(module)
    原始来源范围的共同查询，缓存 UTF-8 起点及其内容指纹；声明、导入和编译期值使用同一结果。
    正文与行索引由 SourceStore 持有；缺少正文时不自行加载，来源 revision 变化后重新查询。
#end

alias source = import "../source.jiang";
alias source_store = import "../source/store.jiang";
alias source_map = import "../diagnostic/source_map.jiang";
alias diagnostic = import "../diagnostic.jiang";
alias token = import "../syntax/token.jiang";
alias qkey = import "../incremental/key.jiang";
alias cache_identity = import "../artifact/cache_identity.jiang";
alias object_key = import "../artifact/object_key.jiang";
alias list = import "../support/list.jiang";
alias query_cache = import "./query_cache.jiang";
import std;

struct LocationKey: Copyable, Hashable, Equatable {
    public source.SourceId source_id;
    public Int revision;
    public Int start;
    public Int length;

    public Void hash<H: Hasher>(self, H&! hasher) {
        self.source_id.hash(hasher);
        hasher.write(self.revision); hasher.write(self.start); hasher.write(self.length);
    }

    public Bool equal(Self& left, Self& right) {
        return left.source_id == right.source_id && left.revision == right.revision
            && left.start == right.start && left.length == right.length;
    }
}

public struct SourceLocation: Copyable {
    public diagnostic.SourcePosition position;
    public qkey.Fingerprint128 fingerprint;
}

public struct SourceLocationQuery: Movable {
    Mutex<query_cache.QueryCache<LocationKey, SourceLocation>>^ entries;

    public init(self) {
        self.entries = new Mutex<query_cache.QueryCache<LocationKey, SourceLocation>>(
            query_cache.QueryCache<LocationKey, SourceLocation>()
        );
    }

    public Void reset(self) { self.entries.with_lock<Void>({ cache => cache.reset(); }); }

    #doc revision 只参与会话 key；结果指纹仅覆盖来源名称、范围及行列，不因其他正文变化而改变。
    public SourceLocation? evaluate(self, source_store.SourceStore& sources, source.SourceId source_id,
        token.Span span
    ) {
        if (!sources.has_source(source_id)) { return null; }
        _ key = LocationKey(source_id: source_id, revision: sources.revision(source_id),
            start: span.start, length: span.length);
        return self.entries.with_lock<SourceLocation?>({ [ref sources, source_id, span, key] cache =>
            if (cache.peek(key) is .some(result)) { return result; }
            _ position = source_map.position_at_snapshot(sources.get(source_id), span.start, .utf8);
            _ result = SourceLocation(position: position,
                fingerprint: position_fingerprint(sources.entry(source_id).name(), UInt64(span.start),
                    UInt64(span.length), UInt64(position.line + 1), UInt64(position.character + 1)));
            cache.publish(key, result);
            return result;
        });
    }
}

#doc 来源查询与可持久化 Location 值共用编码；行列从 1 开始，长度和偏移按 UTF-8 字节计。
public qkey.Fingerprint128 position_fingerprint(UInt8[]& name, UInt64 offset, UInt64 length,
    UInt64 line, UInt64 column
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>(3);
    parts.add(cache_identity.text_fingerprint("source-location:", name));
    parts.add(qkey.Fingerprint128(offset, length));
    parts.add(qkey.Fingerprint128(line, column));
    return object_key.combine_fingerprints(UInt64(131), parts$.ref());
}
