#doc(module)
    声明类型的共同查询；结果 TypeId 与惰性内容指纹保存在同一缓存项，编译和反射共用。
#end

alias qid = import "../id.jiang";
alias qkey = import "../incremental/key.jiang";
alias query_cache = import "./query_cache.jiang";
import std;

public enum TypeCheckDefRequest {
    compute,
    cycle,
}

#doc 缓存已有类型句柄及其惰性指纹，不复制 TypeStore 中的类型事实。
struct TypeCheckDefResult: Copyable {
    public qid.TypeId type_id;
    public qkey.Fingerprint128? fingerprint = null;
}

public struct TypeCheckDefQuery: Movable {
    Mutex<query_cache.QueryCache<qid.DefId, TypeCheckDefResult>>^ defs;

    public init(self) {
        self.defs = new Mutex<query_cache.QueryCache<qid.DefId, TypeCheckDefResult>>(
            query_cache.QueryCache<qid.DefId, TypeCheckDefResult>()
        );
    }

    public Void reset(self) {
        self.defs.with_lock<Void>({ cache => cache.reset(); });
    }

    public qid.TypeId evaluate(
        self,
        qid.DefId def_id,
        FnOnce<qid.TypeId, TypeCheckDefRequest> evaluate
    ) {
        query_cache.QueryCacheState<TypeCheckDefResult> state = self.defs.with_lock({ cache =>
            cache.state(def_id)
        });
        if (state is .ready(result)) { return result.type_id; }
        if (state is .evaluating) { return evaluate(.cycle); }
        qid.TypeId type_id = evaluate(.compute);
        self.defs.with_lock<Void>({ cache =>
            cache.complete(def_id, TypeCheckDefResult(type_id = type_id));
        });
        return type_id;
    }

    #doc 只为已完成的同一类型结果计算一次指纹；未就绪不触发 Sema，也不建立独立事实缓存。
    public qkey.Fingerprint128? fingerprint(self, qid.DefId def_id,
        FnOnce<qkey.Fingerprint128, qid.TypeId> encode
    ) {
        guard self.defs.with_lock<TypeCheckDefResult?>({ cache => cache.peek(def_id) })
            is .some(result) else { return null; }
        if (result.fingerprint is .some(value)) { return value; }
        qkey.Fingerprint128 value = encode(result.type_id);
        self.defs.with_lock<Void>({ cache =>
            cache.publish(def_id, TypeCheckDefResult(type_id = result.type_id, fingerprint = value));
        });
        return value;
    }
}
