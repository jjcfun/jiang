#doc(module)
    const definition 的同步求值状态；声明与具体实例复用同一状态机，值由消费者发布。
#end

alias query_cache = import "./query_cache.jiang";
import std;

public enum ConstDefinitionRequest {
    compute,
    cycle,
}

@region(k: K)
@where(K: Hashable & Equatable & Copyable)
public struct ConstDefinitionQuery<K>: Movable {
    @life(k)
    Mutex<query_cache.QueryCache<K, Bool>>^ definitions;

    public init(self) {
        self.definitions = new Mutex<query_cache.QueryCache<K, Bool>>(
            query_cache.QueryCache<K, Bool>()
        );
    }

    public Void reset(self) {
        self.definitions.with_lock<Void>({ cache => cache.reset(); });
    }

    #doc
        回调返回 null 表示依赖未就绪，可重试；false 表示已失败；true 表示值已发布。
        成功和失败保留到本轮 query reset，回调在锁外执行。
    #end
    public Bool evaluate(
        self,
        K key,
        FnOnce<Bool?, ConstDefinitionRequest> evaluate
    ) {
        query_cache.QueryCacheState<Bool> state = self.definitions.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(value)) { return value; }
        if (state is .evaluating) {
            if (evaluate(.cycle) is .some(value)) { return value; }
            return false;
        }
        Bool? complete = evaluate(.compute);
        self.definitions.with_lock<Void>({ cache =>
            if (complete is .some(value)) {
                cache.complete(key, value);
            } else {
                cache.remove(key);
            }
        });
        if (complete is .some(value)) { return value; }
        return false;
    }
}
