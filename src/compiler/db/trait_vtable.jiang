// Concrete trait vtable 的 session typed query。
//
// key 包含 JIL Store identity，GlobalId 只在所属 Program 内有效；query 不负责生成业务数据。

import core_traits = "../core/traits.jiang";
import jil = "../jil/model.jiang";
import query_cache = "./query_cache.jiang";

public struct TraitVTableQueryKey: Copyable, Hashable, Equatable {
    Int store_identity;
    public jil.TraitVTableKey vtable;

    public init(self, Int store_identity, jil.TraitVTableKey vtable) {
        self.store_identity = store_identity;
        self.vtable = vtable;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        self.vtable.hash(hasher);
    }

    public Bool equal(TraitVTableQueryKey& lhs, TraitVTableQueryKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && jil.TraitVTableKey.equal(lhs.vtable$.ref(), rhs.vtable$.ref());
    }
}

public struct TraitVTableQuery: Movable {
    Mutex<query_cache.QueryCache<TraitVTableQueryKey, jil.GlobalId>>^ globals;

    public init(self) {
        self.globals = new Mutex<query_cache.QueryCache<TraitVTableQueryKey, jil.GlobalId>>(
            query_cache.QueryCache<TraitVTableQueryKey, jil.GlobalId>()
        );
    }

    public Void reset(self) {
        self.globals.with_lock<Void>({ cache => cache.reset(); });
    }

    public jil.GlobalId? evaluate(
        self,
        TraitVTableQueryKey key,
        FnOnce<jil.GlobalId> compute
    ) {
        query_cache.QueryCacheState<jil.GlobalId> state = self.globals.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(global_id)) { return global_id; }
        if (state is .evaluating) { return null; }
        jil.GlobalId global_id = compute();
        self.globals.with_lock<Void>({ cache =>
            cache.complete(key, global_id);
        });
        return global_id;
    }
}
