// 同步查询缓存。key 不存在表示尚未求值，evaluating 表示当前调用链正在求值，
// ready 表示结果已经发布。

import map = "../support/map.jiang";

@region(v: V)
@where(V: Copyable)
public enum QueryCacheState<V>: Copyable {
    missing,
    evaluating,

    @life(v)
    ready(V),
}

// 通用 per-query cache 原语：同步求值状态 + memo + epoch reset。
// entries 只保存完成值；evaluating 记录 key 当前是否正在求值。
@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable, V: Copyable)
public struct QueryCache<K, V>: Movable {
    @life(k, v)
    map.WyHashMap<K, V> entries!;

    @life(k)
    map.WyHashMap<K, Bool> evaluating!;

    public init(self) {
        self.entries = map.WyHashMap<K, V>();
        self.evaluating = map.WyHashMap<K, Bool>();
    }

    public Void reset(Self&! self) {
        self.entries.clear();
        self.evaluating.clear();
    }

    @life(return: self.v)
    public V? lookup(self, K key) {
        guard self.entries.get(key) is .some(value) else { return null; }
        return value$.get();
    }

    @life(return: self.v)
    public V? peek(self, K key) {
        return self.lookup(key);
    }

    @life(return: self.v)
    public QueryCacheState<V> state(Self&! self, K key) {
        if (self.entries.get(key) is .some(value)) {
            QueryCacheState<V> state = .ready(value$.get());
            return state;
        }
        if (self.evaluating.get(key) is .some(active)) {
            if (active$.get()) {
                QueryCacheState<V> state = .evaluating();
                return state;
            }
        }
        self.evaluating.set(key, true);
        QueryCacheState<V> state = .missing();
        return state;
    }

    public Bool is_evaluating(self, K key) {
        guard self.evaluating.get(key) is .some(active) else { return false; }
        return active$.get();
    }

    public Void complete(Self&! self, K key, V value) {
        assert(self.is_evaluating(key));
        self.evaluating.set(key, false);
        self.entries.set(key, value);
    }

    // L2 恢复或不需要递归检测的直接发布路径。
    public Void publish(Self&! self, K key, V value) {
        self.evaluating.set(key, false);
        self.entries.set(key, value);
    }

    public Void remove(Self&! self, K key) {
        self.entries.remove(key);
        self.evaluating.remove(key);
    }
}
