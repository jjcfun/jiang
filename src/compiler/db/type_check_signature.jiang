#doc(module)
    完整声明签名检查的同步查询；共享完成状态与惰性指纹，具体类型和契约仍由既有 Store 保存。
#end

alias qid = import "../id.jiang";
alias qkey = import "../incremental/key.jiang";
alias query_cache = import "./query_cache.jiang";
alias table = import "../support/table.jiang";
import std;

alias SignatureState = query_cache.QueryCacheState<qkey.Fingerprint128?>;

public struct TypeCheckSignatureQuery: Movable {
    Mutex<table.SideTable<qid.DefId, SignatureState>>^ entries;

    public init(self) {
        self.entries = new Mutex<table.SideTable<qid.DefId, SignatureState>>(
            table.SideTable<qid.DefId, SignatureState>()
        );
    }

    public Void reset(self) { self.entries.with_lock<Void>({ cache => cache.clear(); }); }

    #doc DefId 直接索引完成状态；仅首次请求推进检查，递归请求不提前发布结果。
    public Bool begin(self, qid.DefId definition) {
        return self.entries.with_lock<Bool>({ cache =>
            if (cache.has(definition)) { return false; }
            cache.set(definition, .evaluating());
            return true;
        });
    }

    public Void complete(self, qid.DefId definition) {
        self.entries.with_lock<Void>({ cache =>
            assert(cache.get(definition) is .evaluating);
            cache.set(definition, .ready(null));
        });
    }

    SignatureState state(self, qid.DefId definition) {
        return self.entries.with_lock<SignatureState>({ cache =>
            if (!cache.has(definition)) { return .missing(); }
            return cache.get(definition);
        });
    }

    public Bool ready(self, qid.DefId definition) { return self.state(definition) is .ready; }
    public Bool checking(self, qid.DefId definition) { return self.state(definition) is .evaluating; }

    #doc 未完成签名不计算指纹；首次读取编码原有事实，后续消费者命中同一条完成记录。
    public qkey.Fingerprint128? fingerprint(self, qid.DefId definition, FnOnce<qkey.Fingerprint128> encode) {
        guard self.state(definition) is .ready(cached) else { return null; }
        if (cached is .some(value)) { return value; }
        qkey.Fingerprint128 value = encode();
        self.entries.with_lock<Void>({ cache => cache.set(definition, .ready(value)); });
        return value;
    }
}
