// syntax 阶段稳定入口，串联 lexer、parser 与 lang provider。
//
// This file is the boundary that wires lexer and parser together. Callers
// that need a parsed source unit should use this instead of constructing the
// lexer and parser separately.

#doc(module)
    ### Overview

    串联 Jiang lexer、parser 与 custom language provider，产出 compiler-private syntax unit。
#end

alias list = import "./support/list.jiang";
alias lexer = import "./syntax/lexer.jiang";
alias parser = import "./syntax/parser.jiang";
alias ast = import "./syntax/ast.jiang";
public alias builder = import "./syntax/builder.jiang";
alias context = import "./context.jiang";
alias diagnostic = import "./diagnostic.jiang";
alias lang_block = import "./lang/block.jiang";
alias lang_registry = import "./lang/registry.jiang";
alias source = import "./source.jiang";
alias string = import "./support/string.jiang";
import std;

#doc 一次 source parse 的 syntax unit、成功状态和本轮诊断范围。
public struct SyntaxResult: Movable {
    public ast.AstUnit unit!;
    public Bool ok;
    public diagnostic.DiagnosticScope diagnostics;

    public init(self, ast.AstUnit unit, Bool ok, diagnostic.DiagnosticScope diagnostics) {
        self.unit = unit;
        self.ok = ok;
        self.diagnostics = diagnostics;
    }

    #doc 判断本次 parse 是否产生 error diagnostic。
    public Bool has_errors(self) {
        return !self.ok;
    }

    #doc 移出本次 parse 生成的 syntax unit。
    public ast.AstUnit take_unit(Self&! self) {
        return self.unit.take();
    }
}

#doc 使用空 custom-language registry 解析一份 Jiang source。
public SyntaxResult parse_source(context.CompilerContext&! ctx, UInt8[]& text, source.SourceId source_id) {
    diagnostic.DiagnosticScope scope! = ctx.store.diagnostics.scope();
    lang_registry.Registry registry! = lang_registry.Registry();
    lang_block.LangBlockStore blocks! = lang_block.LangBlockStore();
    lexer.LexResult lexed!;
    {
        lexer.Lexer lex! = lexer.Lexer(
            ctx.store$.mut_ref(), text, source_id, registry$.mut_ref(), blocks$.mut_ref()
        );
        lexed = lex.tokenize();
    }

    parser.ParseResult parsed! = parser.parse_tokens(
        ctx.store$.mut_ref(),
        lexed.tokens$.ref(),
        blocks$.mut_ref(),
        text,
        source_id
    );
    scope.finish(ctx.store.diagnostics$.ref());
    return SyntaxResult(parsed.take_unit(), !scope.has_errors(), scope);
}

#doc 使用调用方提供的 custom-language registry 解析一份 Jiang source。
public SyntaxResult parse_source_with_lang(
    context.CompilerContext&! ctx,
    UInt8[]& text,
    source.SourceId source_id,
    lang_registry.Registry&! registry
) {
    UInt8[]& extension! = "jiang";
    if (ctx.store.sources.entry(source_id).key is .file(path)) { extension = source_extension(path); }
    Bool lang_source = !string.equal(extension, "jiang");
    diagnostic.DiagnosticScope scope! = ctx.store.diagnostics.scope();
    lang_block.LangBlockStore blocks! = lang_block.LangBlockStore();
    lexer.LexResult lexed!;
    {
        lexer.Lexer lex! = lexer.Lexer(
            ctx.store$.mut_ref(), text, source_id, registry, blocks$.mut_ref()
        );
        lexed = if (lang_source) { lex.tokenize_lang_source(extension) } else { lex.tokenize() };
    }

    parser.ParseResult parsed! = parser.parse_tokens(
        ctx.store$.mut_ref(),
        lexed.tokens$.ref(),
        blocks$.mut_ref(),
        text,
        source_id,
        lang_source
    );
    scope.finish(ctx.store.diagnostics$.ref());
    return SyntaxResult(parsed.take_unit(), !scope.has_errors(), scope);
}

#doc 仅使用文件 basename 的最后一个扩展名；无扩展名不会猜测为 Jiang 源码。
UInt8[]& source_extension(UInt8[]& path) {
    Int index! = path.length - 1;
    while (index > 0) {
        if (path[index] == UInt8(47)) { return ""; }
        if (path[index] == UInt8(46)) {
            if (path[index - 1] == UInt8(47)) { return ""; }
            return path[index + 1..path.length];
        }
        index = index - 1;
    }
    return "";
}

#doc 将原生声明后缀追加到同一 AST；token 使用完整 overlay 的字节位置，不重解析原始 Lang 源码。
public Bool append_native_declarations(
    context.CompilerContext&! ctx, ast.AstUnit&! unit, UInt8[]& text, Int start
) {
    diagnostic.DiagnosticScope scope! = ctx.store.diagnostics.scope();
    std.jiang.syntax.Source source = std.jiang.syntax.Source(
        std.jiang.syntax.SourceId(unit.source_id.to_index()), text);
    lexer.Tokenizer tokenizer! = lexer.Tokenizer(unit.source_id, .lexer, source,
        std.jiang.syntax.Span(start, text.length - start));
    list.ArrayList<std.jiang.Token<std.jiang.TokenKind>> tokens! =
        list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>();
    while (true) {
        std.jiang.Token<std.jiang.TokenKind> token = tokenizer.next(ctx.store$.mut_ref());
        tokens.add(token);
        if (token.kind is .eof) { break; }
    }
    parser.append_tokens(ctx.store$.mut_ref(), tokens$.ref(), unit, text);
    scope.finish(ctx.store.diagnostics$.ref());
    return !scope.has_errors();
}
