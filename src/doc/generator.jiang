// 完成 type check 后直接从 Semantic Model 生成 Markdown API 文档。
//
// 输出只包含稳定 anchor、Jiang 签名和原始 Markdown，不建立持久 API/Markdown AST。

import context = "../context.jiang";
import artifact_documentation = "../artifact/documentation.jiang";
import artifact_path = "../artifact/path.jiang";
import source_ji = "../artifact/source_ji.jiang";
import diagnostic = "../diagnostic.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import driver_options = "../driver/options.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import resolve_store = "../resolve/store.jiang";
import sem = "../sema/model.jiang";
import source = "../source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_io = "../system/io.jiang";
import markdown = "./markdown.jiang";
import signature = "./signature.jiang";
import std;

public Path? generate(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir
) {
    hydrate_cached_documentation(ctx, graph, artifact_cache_dir);
    std.StringBuilder output! = std.StringBuilder();
    append_package_page(ctx, output$.mut_ref(), graph);
    Path output_dir = documentation_output_dir(ctx$.ref(), graph, options);
    if (!system_fs.create_dirs(output_dir.bytes())) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "failed to create documentation output directory",
            "doc_output_directory_failed"
        );
        return null;
    }
    Path index_path = std.path.join(output_dir.bytes(), "index.md");
    if (!system_fs.write_all(index_path.bytes(), output.slice())) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "failed to write documentation index",
            "doc_output_write_failed"
        );
        return null;
    }
    return index_path;
}

Void hydrate_cached_documentation(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    UInt8[]& artifact_cache_dir
) {
    Int index! = 0;
    while (index < graph.module_count()) {
        qid.ModuleId module_id = graph.module_at(index);
        if (module_in_root_package(ctx$.ref(), graph, module_id)) {
            hydrate_module_documentation(ctx, module_id, artifact_cache_dir);
        }
        index = index + 1;
    }
}

Void hydrate_module_documentation(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    UInt8[]& artifact_cache_dir
) {
    if (!ctx.store.resolve.module_ref(module_id).interface_only) { return; }
    guard source_ji.source_identity_for_module(ctx$.ref(), module_id) is .some(identity) else { return; }
    UInt8[]^ path = artifact_path.stable_source_ji_path(artifact_cache_dir, identity);
    guard artifact_documentation.read_from_ji(
        ctx.store.symbols$.mut_ref(),
        ctx.store.artifacts$.mut_ref(),
        path[..]
    ) is .some(docs) else { return; }
    if (docs.module_markdown is .some(markdown_symbol)) {
        ctx.store.model.set_module_doc(module_id, markdown_symbol);
    }
    hydrate_declaration_docs(ctx, module_id, docs$.ref());
    hydrate_extension_docs(ctx, module_id, docs$.ref());
}

Void hydrate_declaration_docs(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    artifact_documentation.Documentation& docs
) {
    Int index! = 0;
    while (index < docs.declarations.len()) {
        artifact_documentation.DeclarationDoc entry = docs.declarations.get(index);
        if (def_for_stable_id(ctx$.ref(), module_id, entry.stable_id) is .some(def_id)) {
            ctx.store.model.set_declaration_doc(def_id, entry.markdown);
        }
        index = index + 1;
    }
}

qid.DefId? def_for_stable_id(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    qkey.StableSymbolId stable_id
) {
    guard ctx.store.incremental.current_def_for_stable(stable_id) is .some(def_id) else {
        return null;
    }
    guard ctx.store.defs.get(def_id).module_id is .some(owner_module) else { return null; }
    if (owner_module != module_id) { return null; }
    return def_id;
}

Void hydrate_extension_docs(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    artifact_documentation.Documentation& docs
) {
    Int group_index! = 0;
    Int ordinal! = 0;
    Int doc_index! = 0;
    while (group_index < ctx.store.model.extension_group_len()) {
        if (ctx.store.model.extension_group_module(group_index) == module_id) {
            if (doc_index < docs.extensions.len()) {
                artifact_documentation.ExtensionDoc entry = docs.extensions.get(doc_index);
                if (entry.ordinal == ordinal) {
                    ctx.store.model.set_extension_doc(group_index, entry.markdown);
                    doc_index = doc_index + 1;
                }
            }
            ordinal = ordinal + 1;
        }
        group_index = group_index + 1;
    }
}

public Void print_generated_path(UInt8[]& index_path) {
    UInt8[]^ absolute = cache_identity.absolute_path(index_path);
    system_fs.File out = system_io.stdout();
    out.write_all(absolute[..]);
    out.write_all("\n");
}

Path documentation_output_dir(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options
) {
    if (options.output_path.length > 0) { return std.path.normalize(options.output_path); }
    UInt8[]& package_name = ctx.store.symbols.text(
        ctx.store.resolve.package_ref(graph.package_id).name
    );
    Path base = std.path.join("build/doc", package_name);
    return std.path.normalize(base.bytes());
}

Void append_package_page(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    module_graph.ModuleGraph& graph
) {
    UInt8[]& package_name = ctx.store.symbols.text(
        ctx.store.resolve.package_ref(graph.package_id).name
    );
    list.ArrayList<qid.ModuleId> modules = public_modules(ctx$.ref(), graph);
    output.append_valid_utf8("# Package `");
    output.append_valid_utf8(package_name);
    output.append_valid_utf8("`\n\n");
    append_module_navigation(ctx$.ref(), output, modules$.ref());
    append_dependency_navigation(ctx$.ref(), output, graph);
    Int index! = 0;
    while (index < modules.len()) {
        append_module(ctx, output, modules.get(index));
        index = index + 1;
    }
}

list.ArrayList<qid.ModuleId> public_modules(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph
) {
    list.ArrayList<qid.ModuleId> result! = list.ArrayList<qid.ModuleId>();
    result.add(graph.root_module);
    Int index! = 0;
    while (index < result.len()) {
        add_public_import_modules(ctx, graph, result.get(index), result$.mut_ref());
        index = index + 1;
    }
    return result;
}

Void add_public_import_modules(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    qid.ModuleId module_id,
    list.ArrayList<qid.ModuleId>&! result
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    Int index! = 0;
    while (index < module.imports.len()) {
        resolve_store.ImportRecord entry = module.imports.get(index);
        if (entry.visibility == .public_visibility && entry.target_module is .some(target)) {
            if (module_in_root_package(ctx, graph, target) && !contains_module(result, target)) {
                result.add(target);
            }
        }
        index = index + 1;
    }
}

Bool contains_module(list.ArrayList<qid.ModuleId>& modules, qid.ModuleId target) {
    Int index! = 0;
    while (index < modules.len()) {
        if (modules.get(index) == target) { return true; }
        index = index + 1;
    }
    return false;
}

Void append_module_navigation(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<qid.ModuleId>& modules
) {
    output.append_valid_utf8("## Modules\n\n");
    Int index! = 0;
    while (index < modules.len()) {
        qid.ModuleId module_id = modules.get(index);
        qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
        output.append_valid_utf8("- [`");
        append_module_name(ctx, output, module_id);
        output.append_valid_utf8("`](index.md#");
        append_anchor(ctx, output, module_def);
        output.append_valid_utf8(")\n");
        index = index + 1;
    }
    output.append_valid_utf8("\n");
}

Void append_dependency_navigation(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    module_graph.ModuleGraph& graph
) {
    resolve_store.PackageRecord& package_record = ctx.store.resolve.package_ref(graph.package_id);
    if (package_record.dependencies.empty()) { return; }
    output.append_valid_utf8("## Dependencies\n\n");
    Int index! = 0;
    while (index < package_record.dependencies.len()) {
        resolve_store.PackageDependencyRecord dependency = package_record.dependencies.get(index);
        if (ctx.store.resolve.package_for_dir(dependency.path_symbol) is .some(package_id)) {
            UInt8[]& name = ctx.store.symbols.text(ctx.store.resolve.package_ref(package_id).name);
            output.append_valid_utf8("- [`");
            output.append_valid_utf8(name);
            output.append_valid_utf8("`](../");
            output.append_valid_utf8(name);
            output.append_valid_utf8("/index.md)\n");
        }
        index = index + 1;
    }
    output.append_valid_utf8("\n");
}

Bool module_in_root_package(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    qid.ModuleId module_id
) {
    return ctx.store.resolve.module_ref(module_id).package_id == graph.package_id;
}

Void append_module(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    append_anchor_tag(ctx$.ref(), output, module_def);
    output.append_valid_utf8("## Module `");
    append_module_name(ctx$.ref(), output, module_id);
    output.append_valid_utf8("`\n\n");
    append_module_source(ctx, output, module_id);
    if (ctx.store.model.module_doc(module_id) is .some(doc_symbol)) {
        append_markdown(ctx, output, module_def, ctx.store.symbols.text(doc_symbol));
    }
    append_owner_members(ctx, output, module_def, 3);
    append_extensions(ctx, output, module_id);
}

Void append_module_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    UInt8[]& path = ctx.store.symbols.text(ctx.store.resolve.module_ref(module_id).path_symbol);
    qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
    UInt8[]& package_dir = ctx.store.symbols.text(ctx.store.resolve.package_ref(package_id).dir_path);
    if (path_is_in_directory(path, package_dir)) {
        output.append_valid_utf8(path[package_dir.length + 1..path.length]);
        return;
    }
    output.append_valid_utf8(path);
}

Bool path_is_in_directory(UInt8[]& path, UInt8[]& directory) {
    if (path.length <= directory.length || path[directory.length] != UInt8(47)) { return false; }
    Int index! = 0;
    while (index < directory.length) {
        if (path[index] != directory[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Void append_module_source(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    source.SourceId source_id = ctx.store.resolve.module_ref(module_id).source_id;
    output.append_valid_utf8("Source: `");
    output.append_valid_utf8(ctx.store.sources.entry(source_id).name());
    output.append_valid_utf8(":1:1`\n\n");
}

Void append_member_navigation(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<qid.DefId>& members
) {
    if (members.empty()) { return; }
    output.append_valid_utf8("### API\n\n");
    Int index! = 0;
    while (index < members.len()) {
        qid.DefId member_def = members.get(index);
        output.append_valid_utf8("- [`");
        append_def_name(ctx, output, member_def);
        output.append_valid_utf8("`](index.md#");
        append_anchor(ctx, output, member_def);
        output.append_valid_utf8(")\n");
        index = index + 1;
    }
    output.append_valid_utf8("\n");
}

Bool documented_public_def(context.CompilerContext& ctx, qid.DefId def_id) {
    if (!ctx.store.defs.has(def_id) || !ctx.store.model.has_def(def_id)) { return false; }
    def.DefRecord record = ctx.store.defs.get(def_id);
    if (record.visibility != .public_visibility) { return false; }
    if (record.kind == .import_alias_def || record.kind == .generic_param_def) { return false; }
    if (record.kind == .parameter_def) { return false; }
    if (record.kind == .local_def || record.kind == .extension_def) { return false; }
    return true;
}

Bool public_owned_member(context.CompilerContext& ctx, qid.DefId def_id) {
    if (!documented_public_def(ctx, def_id)) { return false; }
    return ctx.store.model.extension_group_for_member(def_id) == null;
}

Void append_owner_members(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId owner_def,
    Int level
) {
    sem.Def& owner = ctx.store.model.def_ref(owner_def);
    list.ArrayList<qid.DefId> members = sorted_public_members(ctx$.ref(), owner);
    append_member_navigation(ctx$.ref(), output, members$.ref());
    Int index! = 0;
    while (index < members.len()) {
        append_declaration(ctx, output, members.get(index), level);
        index = index + 1;
    }
}

list.ArrayList<qid.DefId> sorted_public_members(
    context.CompilerContext& ctx,
    sem.Def& owner
) {
    list.ArrayList<qid.DefId> result! = list.ArrayList<qid.DefId>();
    Int index! = 0;
    while (index < owner.members.len()) {
        qid.DefId member_def = owner.members.get(index);
        if (public_owned_member(ctx, member_def)) { insert_sorted_def(ctx, result$.mut_ref(), member_def); }
        index = index + 1;
    }
    return result;
}

Void insert_sorted_def(
    context.CompilerContext& ctx,
    list.ArrayList<qid.DefId>&! values,
    qid.DefId def_id
) {
    values.add(def_id);
    Int index! = values.len() - 1;
    while (index > 0 && def_order_less(ctx, def_id, values.get(index - 1))) {
        values.set(index, values.get(index - 1));
        index = index - 1;
    }
    values.set(index, def_id);
}

Bool def_order_less(
    context.CompilerContext& ctx,
    qid.DefId lhs,
    qid.DefId rhs
) {
    guard ctx.store.incremental.stable_id_for_def(lhs) is .some(left) else {
        return lhs.to_index() < rhs.to_index();
    }
    guard ctx.store.incremental.stable_id_for_def(rhs) is .some(right) else { return false; }
    if (left.low != right.low) { return left.low < right.low; }
    return left.high < right.high;
}

Void append_declaration(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId def_id,
    Int level
) {
    append_anchor_tag(ctx$.ref(), output, def_id);
    append_heading_prefix(output, level);
    output.append_valid_utf8(" `");
    append_def_name(ctx$.ref(), output, def_id);
    output.append_valid_utf8("`\n\n```jiang\n");
    signature.append_declaration(ctx$.ref(), output, def_id);
    output.append_valid_utf8("\n```\n\n");
    append_def_source(ctx, output, def_id);
    if (ctx.store.model.declaration_doc(def_id) is .some(doc_symbol)) {
        append_markdown(ctx, output, def_id, ctx.store.symbols.text(doc_symbol));
    }
    append_owner_members(ctx, output, def_id, level + 1);
}

Void append_heading_prefix(std.StringBuilder&! output, Int level) {
    Int count! = level;
    if (count > 6) { count = 6; }
    Int index! = 0;
    while (index < count) {
        output.append_valid_utf8("#");
        index = index + 1;
    }
}

Void append_def_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(def_id).name.symbol));
}

Void append_def_source(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    guard ctx.store.source_map.def_span(def_id) is .some(location) else { return; }
    guard location.source_id is .some(source_id) else { return; }
    output.append_valid_utf8("Source: `");
    output.append_valid_utf8(ctx.store.sources.entry(source_id).name());
    output.append_valid_utf8("`\n\n");
}

Void append_markdown(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId owner_def,
    UInt8[]& text
) {
    markdown.Document parsed = markdown.parse(text);
    analyze_links(ctx, owner_def, text, parsed$.ref());
    output.append_valid_utf8(text);
    output.append_valid_utf8("\n\n");
}

Void analyze_links(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& text,
    markdown.Document& parsed
) {
    Int index! = 0;
    while (index < parsed.events.len()) {
        markdown.Event event = parsed.events.get(index);
        if (event is .link(_ span, _ label, destination)) {
            analyze_link(ctx, owner_def, destination.slice(text));
        }
        if (event is .fenced_code_block(_ span, _ info, _ body, closed) && !closed) {
            add_doc_warning(ctx, owner_def, "Markdown code fence is not closed", "doc_unclosed_code_fence");
        }
        index = index + 1;
    }
}

Void analyze_link(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& destination
) {
    if (destination.length == 0) {
        add_doc_warning(ctx, owner_def, "Markdown link destination is empty", "doc_empty_link_destination");
        return;
    }
    Int fragment_start = local_api_fragment_start(destination);
    if (fragment_start < 0 || api_anchor_exists(ctx$.ref(), destination[fragment_start..destination.length])) {
        return;
    }
    add_doc_warning(ctx, owner_def, "Markdown API link cannot be resolved", "doc_unresolved_api_link");
}

Int local_api_fragment_start(UInt8[]& destination) {
    if (text_starts_with(destination, "#api-")) { return 1; }
    if (text_starts_with(destination, "index.md#api-")) { return 9; }
    return -1;
}

Bool api_anchor_exists(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.defs.len()) {
        qid.DefId def_id = qid.DefId.from_index(index);
        if (documented_public_def(ctx, def_id) && def_anchor_matches(ctx, def_id, expected)) {
            return true;
        }
        index = index + 1;
    }
    index = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (extension_anchor_matches(ctx, index, expected)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool def_anchor_matches(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    UInt8[]& expected
) {
    std.StringBuilder builder! = std.StringBuilder();
    append_anchor(ctx, builder$.mut_ref(), def_id);
    return string.equal(builder.slice(), expected);
}

Bool extension_anchor_matches(
    context.CompilerContext& ctx,
    Int group_index,
    UInt8[]& expected
) {
    std.StringBuilder builder! = std.StringBuilder();
    append_extension_anchor(ctx, builder$.mut_ref(), group_index);
    return string.equal(builder.slice(), expected);
}

Bool text_starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (prefix.length > text.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Void add_doc_warning(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (ctx.store.source_map.def_span(owner_def) is .some(location)) {
        if (location.source_id is .some(source_id)) {
            range = diagnostic.SourceRange(source_id, location.span);
        }
    }
    diagnostic_helper.add_warning(ctx.store.diagnostics$.mut_ref(), range, message, code);
}

Void append_extensions(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    Int index! = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (public_extension_in_module(ctx$.ref(), index, module_id)) {
            append_extension(ctx, output, index);
        }
        index = index + 1;
    }
}

Bool public_extension_in_module(
    context.CompilerContext& ctx,
    Int group_index,
    qid.ModuleId module_id
) {
    return ctx.store.model.extension_group_module(group_index) == module_id
        && ctx.store.model.extension_group_is_public(group_index);
}

Void append_extension(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    qid.DefId binding_owner = ctx.store.model.extension_group_binding_owner(group_index);
    append_extension_anchor_tag(ctx$.ref(), output, group_index);
    output.append_valid_utf8("### Extension `");
    append_def_name(ctx$.ref(), output, ctx.store.model.extension_group_target_owner(group_index));
    output.append_valid_utf8("`\n\n```jiang\n");
    signature.append_extension(ctx$.ref(), output, group_index);
    output.append_valid_utf8("\n```\n\n");
    if (ctx.store.model.extension_doc(group_index) is .some(doc_symbol)) {
        append_markdown(ctx, output, binding_owner, ctx.store.symbols.text(doc_symbol));
    }
    list.ArrayList<qid.DefId> members! = list.ArrayList<qid.DefId>();
    Int member_index! = 0;
    while (member_index < ctx.store.model.extension_member_count(group_index)) {
        qid.DefId member_def = ctx.store.model.extension_member_at(group_index, member_index);
        if (documented_public_def(ctx$.ref(), member_def)) {
            insert_sorted_def(ctx$.ref(), members$.mut_ref(), member_def);
        }
        member_index = member_index + 1;
    }
    member_index = 0;
    while (member_index < members.len()) {
        append_declaration(ctx, output, members.get(member_index), 4);
        member_index = member_index + 1;
    }
}

Void append_extension_anchor_tag(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    output.append_valid_utf8("<a id=\"");
    append_extension_anchor(ctx, output, group_index);
    output.append_valid_utf8("\"></a>\n");
}

Void append_extension_anchor(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    output.append_valid_utf8("api-extension-");
    qid.ModuleId module_id = ctx.store.model.extension_group_module(group_index);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    guard ctx.store.incremental.stable_id_for_def(module_def) is .some(stable_id) else {
        output.append(module_id.to_index());
        output.append_valid_utf8("-");
        output.append(extension_ordinal_in_module(ctx, group_index));
        return;
    }
    append_stable_id(output, stable_id);
    output.append_valid_utf8("-");
    output.append(extension_ordinal_in_module(ctx, group_index));
}

Int extension_ordinal_in_module(context.CompilerContext& ctx, Int group_index) {
    qid.ModuleId module_id = ctx.store.model.extension_group_module(group_index);
    Int index! = 0;
    Int ordinal! = 0;
    while (index < group_index) {
        if (ctx.store.model.extension_group_module(index) == module_id) {
            ordinal = ordinal + 1;
        }
        index = index + 1;
    }
    return ordinal;
}

Void append_anchor_tag(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8("<a id=\"");
    append_anchor(ctx, output, def_id);
    output.append_valid_utf8("\"></a>\n");
}

Void append_anchor(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8("api-");
    guard ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id) else {
        output.append(def_id.to_index());
        return;
    }
    append_stable_id(output, stable_id);
}

Void append_stable_id(std.StringBuilder&! output, qkey.StableSymbolId stable_id) {
    output.append(stable_id.high, 16);
    output.append_valid_utf8("-");
    output.append(stable_id.low, 16);
}
