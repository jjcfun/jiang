// API 文档 Markdown 的轻量结构解析器。
//
// parser 只生成引用原始文本 byte span 的扁平 event，供 heading、code fence
// 和 link 分析使用；它不渲染 HTML，也不进入普通 compile path。

import list = "../support/list.jiang";

public struct TextSpan: Copyable {
    public Int start;
    public Int length;

    public init(self, Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end(self) {
        return self.start + self.length;
    }

    @life(return: text)
    public UInt8[]& slice(self, UInt8[]& text) {
        return text[self.start..self.end()];
    }
}

public enum Event: Copyable {
    heading(Int level, TextSpan span, TextSpan content),
    paragraph(TextSpan span),
    emphasis(TextSpan span, TextSpan content),
    strong(TextSpan span, TextSpan content),
    inline_code(TextSpan span, TextSpan content),
    fenced_code_block(TextSpan span, TextSpan info, TextSpan body, Bool closed),
    ordered_list_item(Int ordinal, TextSpan span, TextSpan content),
    unordered_list_item(TextSpan span, TextSpan content),
    block_quote(TextSpan span, TextSpan content),
    link(TextSpan span, TextSpan label, TextSpan destination),
    horizontal_rule(TextSpan span),
}

public struct Document: Movable {
    public list.ArrayList<Event> events!;

    public init(self) {
        self.events = list.ArrayList<Event>();
    }
}

struct Line: Copyable {
    Int start;
    Int end;
    Int next;
}

struct FenceMarker: Copyable {
    UInt8 marker;
    Int count;
    TextSpan info;
}

public Document parse(UInt8[]& text) {
    Parser parser! = Parser(text);
    parser.parse_blocks();
    return parser.document;
}

@region(a)
struct Parser: Movable {
    @life(a)
    UInt8[]& text;
    Int offset!;
    Document document!;

    init(self, UInt8[]& text) {
        self.text = text;
        self.offset = 0;
        self.document = Document();
    }

    Void parse_blocks(Self&! self) {
        while (self.offset < self.text.length) {
            Line line = line_at(self.text, self.offset);
            if (line_blank(self.text, line)) {
                self.offset = line.next;
                continue;
            }
            if (self.parse_fence(line)) { continue; }
            if (self.parse_heading(line)) { continue; }
            if (self.parse_horizontal_rule(line)) { continue; }
            if (self.parse_list_item(line)) { continue; }
            if (self.parse_block_quote(line)) { continue; }
            self.parse_paragraph(line);
        }
    }

    Bool parse_fence(Self&! self, Line opening) {
        guard fence_marker(self.text, opening) is .some(marker) else { return false; }
        Int body_start = opening.next;
        Int body_end! = self.text.length;
        Int block_end! = self.text.length;
        Bool closed! = false;
        Int cursor! = opening.next;
        while (cursor < self.text.length) {
            Line line = line_at(self.text, cursor);
            if (closing_fence(self.text, line, marker)) {
                body_end = line.start;
                block_end = line.end;
                closed = true;
                self.offset = line.next;
                break;
            }
            cursor = line.next;
        }
        if (!closed) { self.offset = self.text.length; }
        self.document.events.add(.fenced_code_block(
            TextSpan(opening.start, block_end - opening.start),
            marker.info,
            TextSpan(body_start, body_end - body_start),
            closed
        ));
        return true;
    }

    Bool parse_heading(Self&! self, Line line) {
        guard heading_event(self.text, line) is .some(event) else { return false; }
        self.document.events.add(event);
        guard event is .heading(_ level, _ span, content) else { return false; }
        self.scan_inline(content);
        self.offset = line.next;
        return true;
    }

    Bool parse_horizontal_rule(Self&! self, Line line) {
        guard horizontal_rule_span(self.text, line) is .some(span) else { return false; }
        self.document.events.add(.horizontal_rule(span));
        self.offset = line.next;
        return true;
    }

    Bool parse_list_item(Self&! self, Line line) {
        guard list_item_event(self.text, line) is .some(event) else { return false; }
        self.document.events.add(event);
        TextSpan content! = TextSpan();
        if (event is .ordered_list_item(_ ordinal, _ span, value)) { content = value; }
        if (event is .unordered_list_item(_ span, value)) { content = value; }
        self.scan_inline(content);
        self.offset = line.next;
        return true;
    }

    Bool parse_block_quote(Self&! self, Line line) {
        guard block_quote_event(self.text, line) is .some(event) else { return false; }
        self.document.events.add(event);
        guard event is .block_quote(_ span, content) else { return false; }
        self.scan_inline(content);
        self.offset = line.next;
        return true;
    }

    Void parse_paragraph(Self&! self, Line first) {
        Int start = trim_hspace_start(self.text, first.start, first.end);
        Int end! = trim_hspace_end(self.text, start, first.end);
        Int cursor! = first.next;
        while (cursor < self.text.length) {
            Line line = line_at(self.text, cursor);
            if (line_blank(self.text, line) || line_starts_block(self.text, line)) { break; }
            end = trim_hspace_end(self.text, line.start, line.end);
            cursor = line.next;
        }
        TextSpan span = TextSpan(start, end - start);
        self.document.events.add(.paragraph(span));
        self.scan_inline(span);
        self.offset = cursor;
    }

    Void scan_inline(Self&! self, TextSpan span) {
        Int cursor! = span.start;
        while (cursor < span.end()) {
            UInt8 byte = self.text[cursor];
            if (byte == '\\' && cursor + 1 < span.end()) {
                cursor = cursor + 2;
                continue;
            }
            if (byte == '`') {
                cursor = self.scan_inline_code(cursor, span.end());
                continue;
            }
            if (byte == '[') {
                cursor = self.scan_link(cursor, span.end());
                continue;
            }
            if (byte == '*' || byte == '_') {
                cursor = self.scan_emphasis(cursor, span.end(), byte);
                continue;
            }
            cursor = cursor + 1;
        }
    }

    Int scan_inline_code(Self&! self, Int start, Int end) {
        Int width = run_length(self.text, start, end, '`');
        Int closing = find_delimiter_run(self.text, start + width, end, '`', width);
        if (closing < 0) { return start + width; }
        TextSpan content = TextSpan(start + width, closing - start - width);
        self.document.events.add(.inline_code(
            TextSpan(start, closing + width - start),
            content
        ));
        return closing + width;
    }

    Int scan_link(Self&! self, Int start, Int end) {
        Int label_end = find_unescaped_byte(self.text, start + 1, end, ']');
        if (label_end < 0 || label_end + 1 >= end || self.text[label_end + 1] != '(') {
            return start + 1;
        }
        Int destination_end = find_unescaped_byte(self.text, label_end + 2, end, ')');
        if (destination_end < 0) { return label_end + 2; }
        TextSpan label = TextSpan(start + 1, label_end - start - 1);
        Int destination_start = trim_hspace_start(self.text, label_end + 2, destination_end);
        Int trimmed_end = trim_hspace_end(self.text, destination_start, destination_end);
        TextSpan destination = TextSpan(destination_start, trimmed_end - destination_start);
        self.document.events.add(.link(
            TextSpan(start, destination_end + 1 - start),
            label,
            destination
        ));
        self.scan_inline(label);
        return destination_end + 1;
    }

    Int scan_emphasis(Self&! self, Int start, Int end, UInt8 marker) {
        Int width! = 1;
        if (start + 1 < end && self.text[start + 1] == marker) { width = 2; }
        if (start + width >= end || horizontal_space(self.text[start + width])) {
            return start + width;
        }
        Int closing = find_delimiter_run(self.text, start + width, end, marker, width);
        if (closing < 0 || horizontal_space(self.text[closing - 1])) { return start + width; }
        TextSpan content = TextSpan(start + width, closing - start - width);
        TextSpan full = TextSpan(start, closing + width - start);
        if (width == 2) { self.document.events.add(.strong(full, content)); }
        else { self.document.events.add(.emphasis(full, content)); }
        self.scan_inline(content);
        return closing + width;
    }
}

Line line_at(UInt8[]& text, Int start) {
    Int end! = start;
    while (end < text.length && text[end] != UInt8(10) && text[end] != UInt8(13)) {
        end = end + 1;
    }
    Int next! = end;
    if (next < text.length && text[next] == UInt8(13)) { next = next + 1; }
    if (next < text.length && text[next] == UInt8(10)) { next = next + 1; }
    return Line(start: start, end: end, next: next);
}

Bool line_blank(UInt8[]& text, Line line) {
    return trim_hspace_start(text, line.start, line.end) == line.end;
}

Int indentation_end(UInt8[]& text, Line line) {
    Int cursor! = line.start;
    Int count! = 0;
    while (cursor < line.end && count < 4 && text[cursor] == ' ') {
        cursor = cursor + 1;
        count = count + 1;
    }
    if (count > 3) { return line.start; }
    return cursor;
}

FenceMarker? fence_marker(UInt8[]& text, Line line) {
    Int cursor = indentation_end(text, line);
    if (cursor == line.start && cursor < line.end && text[cursor] == ' ') { return null; }
    if (cursor >= line.end || (text[cursor] != '`' && text[cursor] != '~')) { return null; }
    UInt8 marker = text[cursor];
    Int count = run_length(text, cursor, line.end, marker);
    if (count < 3) { return null; }
    Int info_start = trim_hspace_start(text, cursor + count, line.end);
    Int info_end = trim_hspace_end(text, info_start, line.end);
    if (marker == '`' && contains_byte(text, info_start, info_end, '`')) { return null; }
    return FenceMarker(
        marker: marker,
        count: count,
        info: TextSpan(info_start, info_end - info_start)
    );
}

Bool closing_fence(UInt8[]& text, Line line, FenceMarker opening) {
    Int cursor = indentation_end(text, line);
    if (cursor >= line.end || text[cursor] != opening.marker) { return false; }
    Int count = run_length(text, cursor, line.end, opening.marker);
    if (count < opening.count) { return false; }
    return trim_hspace_start(text, cursor + count, line.end) == line.end;
}

Event? heading_event(UInt8[]& text, Line line) {
    Int cursor = indentation_end(text, line);
    if (cursor >= line.end || text[cursor] != '#') { return null; }
    Int level = run_length(text, cursor, line.end, '#');
    if (level < 1 || level > 6) { return null; }
    Int marker_end = cursor + level;
    if (marker_end < line.end && !horizontal_space(text[marker_end])) { return null; }
    Int content_start = trim_hspace_start(text, marker_end, line.end);
    Int content_end = heading_content_end(text, content_start, line.end);
    return Event.heading(
        level,
        TextSpan(cursor, line.end - cursor),
        TextSpan(content_start, content_end - content_start)
    );
}

Int heading_content_end(UInt8[]& text, Int start, Int end) {
    Int trimmed = trim_hspace_end(text, start, end);
    Int hashes! = trimmed;
    while (hashes > start && text[hashes - 1] == '#') { hashes = hashes - 1; }
    if (hashes == trimmed || hashes == start || !horizontal_space(text[hashes - 1])) {
        return trimmed;
    }
    return trim_hspace_end(text, start, hashes);
}

TextSpan? horizontal_rule_span(UInt8[]& text, Line line) {
    Int cursor = indentation_end(text, line);
    if (cursor >= line.end) { return null; }
    UInt8 marker = text[cursor];
    if (marker != '*' && marker != '-' && marker != '_') { return null; }
    Int count! = 0;
    Int scan! = cursor;
    while (scan < line.end) {
        if (text[scan] == marker) { count = count + 1; }
        else if (!horizontal_space(text[scan])) { return null; }
        scan = scan + 1;
    }
    if (count < 3) { return null; }
    return TextSpan(cursor, line.end - cursor);
}

Event? list_item_event(UInt8[]& text, Line line) {
    Int cursor = indentation_end(text, line);
    if (cursor >= line.end) { return null; }
    UInt8 marker = text[cursor];
    if (marker == '-' || marker == '+' || marker == '*') {
        if (cursor + 1 < line.end && !horizontal_space(text[cursor + 1])) { return null; }
        Int content_start = trim_hspace_start(text, cursor + 1, line.end);
        return Event.unordered_list_item(
            TextSpan(cursor, line.end - cursor),
            TextSpan(content_start, line.end - content_start)
        );
    }
    if (marker < '0' || marker > '9') { return null; }
    Int digits_end! = cursor;
    Int ordinal! = 0;
    while (digits_end < line.end && text[digits_end] >= '0' && text[digits_end] <= '9') {
        if (digits_end - cursor >= 9) { return null; }
        ordinal = ordinal * 10 + Int(text[digits_end] - '0');
        digits_end = digits_end + 1;
    }
    if (digits_end >= line.end || (text[digits_end] != '.' && text[digits_end] != ')')) {
        return null;
    }
    if (digits_end + 1 < line.end && !horizontal_space(text[digits_end + 1])) { return null; }
    Int content_start = trim_hspace_start(text, digits_end + 1, line.end);
    return Event.ordered_list_item(
        ordinal,
        TextSpan(cursor, line.end - cursor),
        TextSpan(content_start, line.end - content_start)
    );
}

Event? block_quote_event(UInt8[]& text, Line line) {
    Int cursor = indentation_end(text, line);
    if (cursor >= line.end || text[cursor] != '>') { return null; }
    Int content_start! = cursor + 1;
    if (content_start < line.end && horizontal_space(text[content_start])) {
        content_start = content_start + 1;
    }
    return Event.block_quote(
        TextSpan(cursor, line.end - cursor),
        TextSpan(content_start, line.end - content_start)
    );
}

Bool line_starts_block(UInt8[]& text, Line line) {
    if (fence_marker(text, line) != null) { return true; }
    if (heading_event(text, line) != null) { return true; }
    if (horizontal_rule_span(text, line) != null) { return true; }
    if (list_item_event(text, line) != null) { return true; }
    return block_quote_event(text, line) != null;
}

Int trim_hspace_start(UInt8[]& text, Int start, Int end) {
    Int cursor! = start;
    while (cursor < end && horizontal_space(text[cursor])) { cursor = cursor + 1; }
    return cursor;
}

Int trim_hspace_end(UInt8[]& text, Int start, Int end) {
    Int cursor! = end;
    while (cursor > start && horizontal_space(text[cursor - 1])) { cursor = cursor - 1; }
    return cursor;
}

Bool horizontal_space(UInt8 byte) {
    return byte == UInt8(32) || byte == UInt8(9);
}

Int run_length(UInt8[]& text, Int start, Int end, UInt8 marker) {
    Int cursor! = start;
    while (cursor < end && text[cursor] == marker) { cursor = cursor + 1; }
    return cursor - start;
}

Int find_delimiter_run(
    UInt8[]& text,
    Int start,
    Int end,
    UInt8 marker,
    Int width
) {
    Int cursor! = start;
    while (cursor < end) {
        if (text[cursor] == '\\' && cursor + 1 < end) {
            cursor = cursor + 2;
            continue;
        }
        if (text[cursor] == marker && run_length(text, cursor, end, marker) == width) {
            return cursor;
        }
        cursor = cursor + 1;
    }
    return -1;
}

Int find_unescaped_byte(UInt8[]& text, Int start, Int end, UInt8 expected) {
    Int cursor! = start;
    while (cursor < end) {
        if (text[cursor] == '\\' && cursor + 1 < end) {
            cursor = cursor + 2;
            continue;
        }
        if (text[cursor] == expected) { return cursor; }
        cursor = cursor + 1;
    }
    return -1;
}

Bool contains_byte(UInt8[]& text, Int start, Int end, UInt8 expected) {
    Int cursor! = start;
    while (cursor < end) {
        if (text[cursor] == expected) { return true; }
        cursor = cursor + 1;
    }
    return false;
}
