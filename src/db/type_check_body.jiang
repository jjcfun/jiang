// 单个 Semantic Model definition body 的 session typed query。

import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct TypeCheckBodyQuery: Movable {
    Mutex<query_cache.QueryCache<Int, Bool>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<Int, Bool>>(
            query_cache.QueryCache<Int, Bool>()
        );
    }

    public () reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public () evaluate(
        self,
        qid.DefId def_id,
        Fn<Void> compute
    ) {
        query_cache.QueryCacheState<Bool> state = self.bodies.with_lock({ cache =>
            cache.state(def_id.to_index())
        });
        if (state is .ready(_) || state is .evaluating) { return; }
        compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(def_id.to_index(), true);
        });
    }
}
