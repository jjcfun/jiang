// JIL borrow check / drop elaboration 的 session typed query。

import enforcement = "../enforcement.jiang";
import jil = "../jil/model.jiang";
import query_cache = "./query_cache.jiang";
import std;

struct JilStoreIdentityState: Movable {
    Int next!;

    init(self) {
        self.next = 0;
    }

    () reset(Self&! self) {
        self.next = 0;
    }

    Int allocate(Self&! self) {
        Int identity = self.next;
        self.next = identity + 1;
        return identity;
    }
}

// JIL Store identity 只为本轮 analysis query key 提供唯一命名。
public struct JilStoreIdentityAllocator: Movable {
    Mutex<JilStoreIdentityState>^ state;

    public init(self) {
        self.state = new Mutex<JilStoreIdentityState>(
            JilStoreIdentityState()
        );
    }

    public () reset(self) {
        self.state.with_lock<Void>({ state => state.reset(); });
    }

    public Int allocate(self) {
        return self.state.with_lock({ state => state.allocate() });
    }
}

public struct BorrowCheckQuery: Movable {
    Mutex<query_cache.QueryCache<Int, Bool>>^ results;

    public init(self) {
        self.results = new Mutex<query_cache.QueryCache<Int, Bool>>(
            query_cache.QueryCache<Int, Bool>()
        );
    }

    public () reset(self) {
        self.results.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool evaluate(self, Int key, Fn<Bool> compute) {
        query_cache.QueryCacheState state = self.results.with_lock({ cache =>
            cache.state(key)
        });
        if (state == .ready) {
            return self.results.with_lock({ cache =>
                cache.lookup(key)$.some()
            });
        }
        if (state == .evaluating) { return false; }
        Bool accepted = compute();
        self.results.with_lock<Void>({ cache =>
            cache.complete(key, accepted);
        });
        return accepted;
    }

    public () invalidate(self, Int key) {
        self.results.with_lock<Void>({ cache => cache.remove(key); });
    }

}

// Drop elaboration 的 memo 只记录该 store 已完成。owner 仍沿 pipeline
// 单向移动，不进入 QueryCache。
public struct DropElaborationQuery: Movable {
    Mutex<query_cache.QueryCache<Int, Bool>>^ completed;

    public init(self) {
        self.completed = new Mutex<query_cache.QueryCache<Int, Bool>>(
            query_cache.QueryCache<Int, Bool>()
        );
    }

    public () reset(self) {
        self.completed.with_lock<Void>({ cache => cache.reset(); });
    }

    public jil.Store^ evaluate(
        self,
        Int key,
        jil.Store^ input,
        Fn<jil.Store^, jil.Store^> compute
    ) {
        query_cache.QueryCacheState state = self.completed.with_lock({ cache =>
            cache.state(key)
        });
        if (state == .ready || state == .evaluating) { return input; }
        jil.Store^ output = compute(input);
        self.completed.with_lock<Void>({ cache =>
            cache.complete(key, true);
        });
        return output;
    }

}

public Int borrow_key(Int store_identity, enforcement.Mode mode) {
    Int mode_identity! = 0;
    if (enforcement.is_bootstrap_audit(mode)) { mode_identity = 1; }
    return store_identity * 2 + mode_identity;
}
