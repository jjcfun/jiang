// module Semantic Model 的增量输入选择。
//
// query 只缓存本轮应从 source 构造还是从 `.ji` interface 恢复；实际 facts
// 仍由 CompilerStore 持有。SCC 若有任一成员回源，调用方用 force_source 将
// 整个 component 固化为 source。

import cache_identity = "../artifact/cache_identity.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum ModuleModelInput {
    source,
    interface,
}

public struct ModuleModelQuery: Movable {
    Mutex<query_cache.QueryCache<
        cache_identity.StableSourceId,
        ModuleModelInput
    >>^ cache;

    public init(self) {
        self.cache = new Mutex<query_cache.QueryCache<
            cache_identity.StableSourceId,
            ModuleModelInput
        >>(query_cache.QueryCache<
            cache_identity.StableSourceId,
            ModuleModelInput
        >());
    }

    public Void reset(self) {
        self.cache.with_lock<Void>({ cache => cache.reset(); });
    }

    public ModuleModelInput evaluate(
        self,
        cache_identity.StableSourceId key,
        Bool source_dirty,
        Bool dependency_candidate,
        FnOnce<Bool, Bool> restore
    ) {
        ModuleModelInput? cached = self.cache.with_lock({ cache =>
            cache.lookup(key)
        });
        if (cached is .some(input)) { return input; }
        ModuleModelInput input! = .source;
        if (!source_dirty && restore(dependency_candidate)) {
            input = .interface;
        }
        self.cache.with_lock<Void>({ cache => cache.publish(key, input); });
        return input;
    }

    public Void force_source(
        self,
        cache_identity.StableSourceId key
    ) {
        self.cache.with_lock<Void>({ cache =>
            cache.publish(key, .source);
        });
    }
}
