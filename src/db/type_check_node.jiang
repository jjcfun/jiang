// Semantic Model node type 的 session typed query。

import qid = "../id.jiang";
import sem = "../sema/model.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum TypeCheckNodeRequest {
    compute,
    cycle,
}

public struct TypeCheckNodeQuery: Movable {
    Mutex<query_cache.QueryCache<sem.NodeId, qid.TypeId>>^ nodes;

    public init(self) {
        self.nodes = new Mutex<query_cache.QueryCache<sem.NodeId, qid.TypeId>>(
            query_cache.QueryCache<sem.NodeId, qid.TypeId>()
        );
    }

    public Void reset(self) {
        self.nodes.with_lock<Void>({ cache => cache.reset(); });
    }

    public qid.TypeId evaluate(
        self,
        sem.NodeId node_id,
        Fn<qid.TypeId, TypeCheckNodeRequest> evaluate
    ) {
        query_cache.QueryCacheState<qid.TypeId> state = self.nodes.with_lock({ cache =>
            cache.state(node_id)
        });
        if (state is .ready(type_id)) { return type_id; }
        if (state is .evaluating) { return evaluate(.cycle); }
        qid.TypeId type_id = evaluate(.compute);
        self.nodes.with_lock<Void>({ cache =>
            cache.complete(node_id, type_id);
        });
        return type_id;
    }

}
