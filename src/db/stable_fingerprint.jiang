// 稳定 declaration fingerprint 的独立 typed caches。
//
// cache 只保存 IncrementalSymbolStore 中 fingerprint 的 L1 副本，不拥有声明
// 或 Semantic Model。evaluate 在 miss 时读取 L2 或执行 L3，且不跨 Mutex 持锁。

import qkey = "../incremental/key.jiang";
import query_dependency = "./query_dependency.jiang";
import query_cache = "./query_cache.jiang";
import std;

struct StableFingerprintState: Movable {
    query_cache.QueryCache<query_dependency.StableQueryKey, qkey.Fingerprint128> cache!;
    Int l2_restores!;

    init(self) {
        self.cache = query_cache.QueryCache<
            query_dependency.StableQueryKey,
            qkey.Fingerprint128
        >();
        self.l2_restores = 0;
    }

    Void reset(Self&! self) {
        self.cache.reset();
        self.l2_restores = 0;
    }

    Void restore(
        Self&! self,
        query_dependency.StableQueryKey key,
        qkey.Fingerprint128 value
    ) {
        if (self.cache.peek(key) != null) { return; }
        if (self.cache.is_evaluating(key)) { return; }
        self.cache.publish(key, value);
        self.l2_restores = self.l2_restores + 1;
    }
}

// 一个 declaration fingerprint typed query 对应一个 cache。signature 与 body
// 在 QueryEngine 中各持有一个本类型实例，不共享 memo 或恢复统计。
public struct StableFingerprintQuery: Movable {
    Mutex<StableFingerprintState>^ state;

    public init(self) {
        self.state = new Mutex<StableFingerprintState>(
            StableFingerprintState()
        );
    }

    public Void reset(self) {
        self.state.with_lock<Void>({ cache =>
            cache.reset();
        });
    }

    public qkey.Fingerprint128 evaluate(
        self,
        query_dependency.StableQueryKey key,
        Fn<qkey.Fingerprint128> evaluate
    ) {
        query_cache.QueryCacheState<qkey.Fingerprint128> cache_state =
            self.state.with_lock({ state =>
                state.cache.state(key)
            });
        if (cache_state is .ready(value)) { return value; }
        assert(cache_state is .missing);
        qkey.Fingerprint128 value = evaluate();
        self.state.with_lock<Void>({ state =>
            state.cache.complete(key, value);
        });
        return value;
    }

    public Void restore(
        self,
        query_dependency.StableQueryKey key,
        qkey.Fingerprint128 value
    ) {
        self.state.with_lock<Void>({ state =>
            state.restore(key, value);
        });
    }

    public Int l2_restores(self) {
        return self.state.with_lock({ state => state.l2_restores });
    }
}
