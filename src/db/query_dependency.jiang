// Database 稳定 query 的依赖图与失效传播。
//
// forward 保存 query -> dependency observation，reverse 提供反向传播索引；
// 本轮 changed roots、候选集合和 fingerprint 裁决也由本图统一管理。

import qkey = "../incremental/key.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import set = "../support/set.jiang";

public enum IncrementalQueryKind {
    source_import_summary,
    module_interface,
    def_signature,
    def_body,
    type_of_def,
    type_of_node,
    trait_conformance,
    generic_instance_plan,
    layout_of_type,
    jil_body,
    backend_artifact,
}

public struct StableQueryKey: Copyable, Hashable, Equatable {
    public IncrementalQueryKind kind;
    public UInt64 primary_low;
    public UInt64 primary_high;
    public UInt64 secondary_low;
    public UInt64 secondary_high;

    public init(self,
        IncrementalQueryKind kind,
        UInt64 primary_low,
        UInt64 primary_high,
        UInt64 secondary_low,
        UInt64 secondary_high
    ) {
        self.kind = kind;
        self.primary_low = primary_low;
        self.primary_high = primary_high;
        self.secondary_low = secondary_low;
        self.secondary_high = secondary_high;
    }

    public StableQueryKey stable_symbol_parts(
        IncrementalQueryKind kind,
        UInt64 stable_id_low,
        UInt64 stable_id_high
    ) {
        return StableQueryKey(
            kind,
            stable_id_low,
            stable_id_high,
            0,
            0
        );
    }

    public StableQueryKey fingerprint_parts(
        IncrementalQueryKind kind,
        UInt64 fingerprint_low,
        UInt64 fingerprint_high
    ) {
        return StableQueryKey(kind, fingerprint_low, fingerprint_high, 0, 0);
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.kind));
        hasher.write(self.primary_low);
        hasher.write(self.primary_high);
        hasher.write(self.secondary_low);
        hasher.write(self.secondary_high);
    }

    public Bool equal(StableQueryKey& lhs, StableQueryKey& rhs) {
        if (Int(lhs.kind) != Int(rhs.kind)) { return false; }
        if (lhs.primary_low != rhs.primary_low) { return false; }
        if (lhs.primary_high != rhs.primary_high) { return false; }
        if (lhs.secondary_low != rhs.secondary_low) { return false; }
        return lhs.secondary_high == rhs.secondary_high;
    }

}

struct QueryDependencies: Movable {
    list.ArrayList<ObservedQueryDependency> values!;

    init(self) {
        self.values = list.ArrayList<ObservedQueryDependency>();
    }

    Int len(self) {
        return self.values.len();
    }

    ObservedQueryDependency get(self, Int index) {
        return self.values.get(index);
    }

    Bool observe(Self&! self, ObservedQueryDependency dependency) {
        Int index! = 0;
        while (index < self.values.len()) {
            if (same_query_key(self.values.get(index).key, dependency.key)) {
                self.values.set(index, dependency);
                return false;
            }
            index = index + 1;
        }
        self.values.add(dependency);
        return true;
    }

    Bool contains(self, ObservedQueryDependency dependency) {
        Int index! = 0;
        while (index < self.values.len()) {
            ObservedQueryDependency current = self.values.get(index);
            if (same_query_key(current.key, dependency.key)
                && current.fingerprint == dependency.fingerprint
            ) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool remove(Self&! self, StableQueryKey dependency) {
        Int index! = 0;
        while (index < self.values.len()) {
            if (same_query_key(self.values.get(index).key, dependency)) {
                Int last = self.values.len() - 1;
                if (index != last) {
                    self.values.set(index, self.values.get(last));
                }
                self.values.pop();
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () clear(Self&! self) {
        self.values.clear();
    }
}

struct QueryDependents: Movable {
    list.ArrayList<StableQueryKey> values!;

    init(self) {
        self.values = list.ArrayList<StableQueryKey>();
    }

    Int len(self) {
        return self.values.len();
    }

    StableQueryKey get(self, Int index) {
        return self.values.get(index);
    }

    () add(Self&! self, StableQueryKey query) {
        Int index! = 0;
        while (index < self.values.len()) {
            if (same_query_key(self.values.get(index), query)) { return; }
            index = index + 1;
        }
        self.values.add(query);
    }

    Bool remove(Self&! self, StableQueryKey query) {
        Int index! = 0;
        while (index < self.values.len()) {
            if (same_query_key(self.values.get(index), query)) {
                Int last = self.values.len() - 1;
                if (index != last) {
                    self.values.set(index, self.values.get(last));
                }
                self.values.pop();
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () clear(Self&! self) {
        self.values.clear();
    }
}

public struct InvalidationStats: Copyable {
    public Int changed_roots;
    public Int candidates;

    public init(self, Int changed_roots, Int candidates) {
        self.changed_roots = changed_roots;
        self.candidates = candidates;
    }
}

// forward 是 query -> observed dependency 的唯一事实表；fingerprint 只存一份。
// reverse 是 dependency -> query 的派生索引；changed_roots 和 candidates
// 是 epoch-local 失效状态，reset 时不清除稳定依赖边。
public struct QueryDependencyGraph: Movable {
    map.WyHashMap<StableQueryKey, QueryDependencies> forward!;
    map.WyHashMap<StableQueryKey, QueryDependents> reverse!;
    map.WyHashMap<StableQueryKey, Bool> changed_roots!;
    map.WyHashMap<StableQueryKey, Bool> candidates!;
    Int l2_observation_restores!;

    public init(self) {
        self.forward = map.WyHashMap<StableQueryKey, QueryDependencies>();
        self.reverse = map.WyHashMap<StableQueryKey, QueryDependents>();
        self.changed_roots = map.WyHashMap<StableQueryKey, Bool>();
        self.candidates = map.WyHashMap<StableQueryKey, Bool>();
        self.l2_observation_restores = 0;
    }

    public () add_dependency(
        Self&! self,
        StableQueryKey query,
        StableQueryKey dependency,
        qkey.Fingerprint128 fingerprint
    ) {
        self.observe_dependency(query, dependency, fingerprint);
    }

    // 查询在实际读取依赖时更新 observation。同一 query -> dependency 只保留
    // 一条边；重新求值只替换 forward 中的 fingerprint。
    public () observe_dependency(
        Self&! self,
        StableQueryKey query,
        StableQueryKey dependency,
        qkey.Fingerprint128 fingerprint
    ) {
        Bool inserted = self.observe_forward(
            query,
            ObservedQueryDependency(dependency, fingerprint)
        );
        if (!inserted) { return; }
        QueryDependents&! dependents = self.reverse_mut(dependency);
        dependents.add(query);
    }

    // 一次 query 重算完成后替换它的全部依赖观察值。旧 reverse 索引与
    // forward 事实只允许通过这个入口一起撤销。
    public () replace_dependencies(
        Self&! self,
        StableQueryKey query,
        ObservedQueryDependency[]& dependencies
    ) {
        self.remove_outgoing(query);

        Int index! = 0;
        while (index < dependencies.length) {
            ObservedQueryDependency dependency = dependencies[index];
            self.observe_dependency(query, dependency.key, dependency.fingerprint);
            index = index + 1;
        }
    }

    // 候选 query 的当前依赖集合与上次观察完全相同时，不需要重算。
    public Bool dependencies_match(
        self,
        StableQueryKey query,
        ObservedQueryDependency[]& dependencies
    ) {
        guard self.forward_ref(query) is .some(current) else {
            return dependencies.length == 0;
        }
        if (current.len() != dependencies.length) { return false; }
        Int index! = 0;
        while (index < dependencies.length) {
            if (!current.contains(dependencies[index])) { return false; }
            index = index + 1;
        }
        return true;
    }

    public Int dependency_count(self, StableQueryKey query) {
        if (self.forward_ref(query) is .some(dependencies)) {
            return dependencies.len();
        }
        return 0;
    }

    public Int dependent_count(self, StableQueryKey dependency) {
        if (self.reverse_ref(dependency) is .some(dependents)) {
            return dependents.len();
        }
        return 0;
    }

    // Artifact 边界只复制稳定 key + fingerprint observation，不暴露图的
    // 内部 owner，也不携带任何 session-local 句柄。
    public list.ArrayList<ObservedQueryDependency> observations(
        self,
        StableQueryKey query
    ) {
        list.ArrayList<ObservedQueryDependency> result! =
            list.ArrayList<ObservedQueryDependency>();
        guard self.forward_ref(query) is .some(dependencies) else {
            return result$.move();
        }
        Int index! = 0;
        while (index < dependencies.len()) {
            result.add(dependencies.get(index));
            index = index + 1;
        }
        return result$.move();
    }

    public () reset_invalidation(Self&! self) {
        self.changed_roots.clear();
        self.candidates.clear();
    }

    public () reset_epoch(Self&! self) {
        self.reset_invalidation();
        self.l2_observation_restores = 0;
    }

    public () restore_observations(
        Self&! self,
        StableQueryKey query,
        ObservedQueryDependency[]& observations
    ) {
        self.replace_dependencies(query, observations);
        self.l2_observation_restores =
            self.l2_observation_restores + observations.length;
    }

    public Int observation_l2_restores(self) {
        return self.l2_observation_restores;
    }

    public () add_changed_root(Self&! self, StableQueryKey root) {
        if (!self.changed_roots.insert(root, true)) { return; }
        list.ArrayList<StableQueryKey> pending! =
            list.ArrayList<StableQueryKey>();
        pending.add(root);
        while (!pending.empty()) {
            StableQueryKey current = pending.pop();
            if (self.candidates.has(current)) { continue; }
            self.candidates.insert(current, true);
            self.append_direct_dependents(current, pending$.ref());
        }
    }

    public InvalidationStats invalidation_stats(self) {
        return InvalidationStats(
            self.changed_roots.len(),
            self.candidates.len()
        );
    }

    public Bool candidate_requires_recompute(
        self,
        StableQueryKey candidate,
        ObservedQueryDependency[]& current_dependencies
    ) {
        if (!self.candidates.has(candidate)) { return false; }
        if (self.changed_roots.has(candidate)) { return true; }
        return !self.dependencies_match(candidate, current_dependencies);
    }

    public list.ArrayList<StableQueryKey> invalidated_by(self, StableQueryKey changed) {
        list.ArrayList<StableQueryKey> result! = list.ArrayList<StableQueryKey>();
        list.ArrayList<StableQueryKey> pending! = list.ArrayList<StableQueryKey>();
        set.HashSet<StableQueryKey> seen! = set.HashSet<StableQueryKey>();

        pending.add(changed);
        while (!pending.empty()) {
            StableQueryKey current = pending.pop();
            if (seen.has(current)) { continue; }
            seen.add(current);
            result.add(current);
            self.append_direct_dependents(current, pending$.ref());
        }
        return result$.move();
    }

    public list.ArrayList<StableQueryKey> invalidated_by_deleted_stable(
        Self&! self,
        qkey.StableSymbolId stable_id
    ) {
        list.ArrayList<StableQueryKey> result! = list.ArrayList<StableQueryKey>();
        set.HashSet<StableQueryKey> seen! = set.HashSet<StableQueryKey>();

        self.append_invalidated_root(.def_signature, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.def_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.type_of_def, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.trait_conformance, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.generic_instance_plan, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.jil_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.backend_artifact, stable_id, result$.ref(), seen$.ref());
        self.remove_stable_edges(.def_signature, stable_id);
        self.remove_stable_edges(.def_body, stable_id);
        self.remove_stable_edges(.type_of_def, stable_id);
        self.remove_stable_edges(.trait_conformance, stable_id);
        self.remove_stable_edges(.generic_instance_plan, stable_id);
        self.remove_stable_edges(.jil_body, stable_id);
        self.remove_stable_edges(.backend_artifact, stable_id);
        return result$.move();
    }

    () append_invalidated_root(self,
        IncrementalQueryKind kind,
        qkey.StableSymbolId stable_id,
        list.ArrayList<StableQueryKey>& result,
        set.HashSet<StableQueryKey>& seen
    ) {
        StableQueryKey root = StableQueryKey.stable_symbol_parts(kind, stable_id.low, stable_id.high);
        list.ArrayList<StableQueryKey> invalidated = self.invalidated_by(root);
        Int index! = 0;
        while (index < invalidated.len()) {
            StableQueryKey key = invalidated.get(index);
            if (!seen.has(key)) {
                seen.add(key);
                result.add(key);
            }
            index = index + 1;
        }
    }

    () append_direct_dependents(self,
        StableQueryKey changed,
        list.ArrayList<StableQueryKey>& pending
    ) {
        guard self.reverse_ref(changed) is .some(dependents) else { return; }
        Int index! = 0;
        while (index < dependents.len()) {
            pending.add(dependents.get(index));
            index = index + 1;
        }
    }

    Bool observe_forward(
        Self&! self,
        StableQueryKey query,
        ObservedQueryDependency dependency
    ) {
        QueryDependencies&! dependencies = self.forward_mut(query);
        return dependencies.observe(dependency);
    }

    StableQueryKey dependency_key_at(self, StableQueryKey query, Int index) {
        guard self.forward_ref(query) is .some(dependencies) else {
            assert(false);
            return query;
        }
        return dependencies.get(index).key;
    }

    () clear_forward(Self&! self, StableQueryKey query) {
        QueryDependencies&! dependencies = self.forward_mut(query);
        dependencies.clear();
    }

    () remove_reverse(
        Self&! self,
        StableQueryKey dependency,
        StableQueryKey query
    ) {
        QueryDependents&! dependents = self.reverse_mut(dependency);
        dependents.remove(query);
    }

    () remove_outgoing(Self&! self, StableQueryKey query) {
        Int old_count = self.dependency_count(query);
        Int index! = 0;
        while (index < old_count) {
            StableQueryKey dependency = self.dependency_key_at(query, index);
            self.remove_reverse(dependency, query);
            index = index + 1;
        }
        self.clear_forward(query);
    }

    () remove_stable_edges(
        Self&! self,
        IncrementalQueryKind kind,
        qkey.StableSymbolId stable_id
    ) {
        StableQueryKey key = StableQueryKey.stable_symbol_parts(
            kind,
            stable_id.low,
            stable_id.high
        );
        self.remove_outgoing(key);
        list.ArrayList<StableQueryKey> dependents = self.take_dependents(key);
        Int index! = 0;
        while (index < dependents.len()) {
            self.remove_forward_dependency(dependents.get(index), key);
            index = index + 1;
        }
    }

    list.ArrayList<StableQueryKey> take_dependents(
        Self&! self,
        StableQueryKey dependency
    ) {
        QueryDependents&! dependents = self.reverse_mut(dependency);
        list.ArrayList<StableQueryKey> result! =
            list.ArrayList<StableQueryKey>(dependents.len());
        Int index! = 0;
        while (index < dependents.len()) {
            result.add(dependents.get(index));
            index = index + 1;
        }
        dependents.clear();
        return result$.move();
    }

    () remove_forward_dependency(
        Self&! self,
        StableQueryKey query,
        StableQueryKey dependency
    ) {
        QueryDependencies&! dependencies = self.forward_mut(query);
        dependencies.remove(dependency);
    }

    @life(return: self)
    QueryDependencies&? forward_ref(self, StableQueryKey key) {
        return self.forward.get(key);
    }

    @life(return: self)
    QueryDependencies&! forward_mut(Self&! self, StableQueryKey key) {
        return self.forward.get_or_insert(key, QueryDependencies());
    }

    @life(return: self)
    QueryDependents&? reverse_ref(self, StableQueryKey key) {
        return self.reverse.get(key);
    }

    @life(return: self)
    QueryDependents&! reverse_mut(Self&! self, StableQueryKey key) {
        return self.reverse.get_or_insert(key, QueryDependents());
    }
}

public struct ObservedQueryDependency: Copyable {
    public StableQueryKey key;
    public qkey.Fingerprint128 fingerprint;

    public init(
        self,
        StableQueryKey key,
        qkey.Fingerprint128 fingerprint
    ) {
        self.key = key;
        self.fingerprint = fingerprint;
    }
}

Bool same_query_key(StableQueryKey lhs, StableQueryKey rhs) {
    IncrementalQueryKind lhs_kind = lhs.kind;
    IncrementalQueryKind rhs_kind = rhs.kind;
    Int lhs_kind_value = Int(lhs_kind);
    Int rhs_kind_value = Int(rhs_kind);
    if (lhs_kind_value != rhs_kind_value) { return false; }
    if (lhs.primary_low != rhs.primary_low) { return false; }
    if (lhs.primary_high != rhs.primary_high) { return false; }
    if (lhs.secondary_low != rhs.secondary_low) { return false; }
    return lhs.secondary_high == rhs.secondary_high;
}

public IncrementalQueryKind? incremental_query_kind_from_int(Int value) {
    IncrementalQueryKind kind! = .source_import_summary;
    if (value == Int(kind)) { return kind; }
    kind = .module_interface;
    if (value == Int(kind)) { return kind; }
    kind = .def_signature;
    if (value == Int(kind)) { return kind; }
    kind = .def_body;
    if (value == Int(kind)) { return kind; }
    kind = .type_of_def;
    if (value == Int(kind)) { return kind; }
    kind = .type_of_node;
    if (value == Int(kind)) { return kind; }
    kind = .trait_conformance;
    if (value == Int(kind)) { return kind; }
    kind = .generic_instance_plan;
    if (value == Int(kind)) { return kind; }
    kind = .layout_of_type;
    if (value == Int(kind)) { return kind; }
    kind = .jil_body;
    if (value == Int(kind)) { return kind; }
    kind = .backend_artifact;
    if (value == Int(kind)) { return kind; }
    return null;
}
