// 本轮 source 分析产生的外部 declaration observations。
//
// recorder 只保存尚未发布的求值输出。前端成功后一次性复制到
// SourceArtifactCache；失败路径不调用 publish，因此不会覆盖上次成功事实。

import artifact = "../artifact/source.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source_identity = "../incremental/source_identity.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";

struct DeclarationObservationState: Movable {
    map.WyHashMap<source.SourceId, Int> source_indices!;
    list.ArrayList<source.SourceId> sources!;
    list.ArrayList<artifact.DeclarationObservationSet> observations!;

    init(self) {
        self.source_indices = map.WyHashMap<source.SourceId, Int>();
        self.sources = list.ArrayList<source.SourceId>();
        self.observations = list.ArrayList<artifact.DeclarationObservationSet>();
    }

    Void reset(Self&! self) {
        self.source_indices.clear();
        self.sources.clear();
        self.observations.clear();
    }

    Void begin_source(Self&! self, source.SourceId source_id) {
        if (self.source_indices.has(source_id)) { return; }
        Int index = self.sources.len();
        self.source_indices.insert(source_id, index);
        self.sources.add(source_id);
        self.observations.add(artifact.DeclarationObservationSet());
    }

    Void record(
        Self&! self,
        source.SourceId source_id,
        artifact.DeclarationObservation observation
    ) {
        self.begin_source(source_id);
        guard self.source_indices.get(source_id) is .some(index_ref) else {
            assert(false);
            return;
        }
        Int index = index_ref$.get();
        self.observations.ref_at(index).add(observation);
    }

    Void publish(
        self,
        artifact.SourceArtifactCache& cache
    ) {
        Int index! = 0;
        while (index < self.sources.len()) {
            artifact.DeclarationObservationSet published! =
                artifact.DeclarationObservationSet();
            artifact.DeclarationObservationSet& pending =
                self.observations.ref_at(index);
            Int observation_index! = 0;
            while (observation_index < pending.entries.len()) {
                published.add(pending.entries.get(observation_index));
                observation_index = observation_index + 1;
            }
            cache.store_observations(self.sources.get(index), published$.move());
            index = index + 1;
        }
    }
}

public struct DeclarationObservationRecorder: Movable {
    Mutex<DeclarationObservationState>^ state;

    public init(self) {
        self.state = new Mutex<DeclarationObservationState>(
            DeclarationObservationState()
        );
    }

    public Void reset(self) {
        self.state.with_lock<Void>({ state => state.reset(); });
    }

    public Void begin_source(self, source.SourceId source_id) {
        self.state.with_lock<Void>({ [source_id] state =>
            state.begin_source(source_id);
        });
    }

    public Void record(
        self,
        source.SourceId source_id,
        artifact.DeclarationObservation observation
    ) {
        self.state.with_lock<Void>({ [source_id, observation] state =>
            state.record(source_id, observation);
        });
    }

    public Void publish(
        self,
        artifact.SourceArtifactCache& cache
    ) {
        self.state.with_lock<Void>({ [ref cache] state =>
            state.publish(cache);
        });
    }
}

// use_owner 已是 type checker 确认的读取主体，target_def 是被读取事实。
// 只有跨 source 且两端都有稳定身份时才记录；session-local/builtin 读取跳过。
public Void record_def_read(
    DeclarationObservationRecorder& recorder,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.DefId target_def,
    artifact.ObservationAspect aspect
) {
    guard store.defs.get(use_owner).module_id is .some(use_module) else { return; }
    guard store.defs.get(target_def).module_id is .some(target_module) else { return; }
    if (use_module == target_module) { return; }
    guard store.incremental.stable_id_for_def(target_def) is .some(stable_id) else {
        return;
    }
    guard source_identity.for_module(store, target_module) is .some(dependency_source) else {
        return;
    }
    qkey.Fingerprint128 observed = observation_fingerprint(store, stable_id, aspect);
    recorder.record(
        store.resolve.module(use_module).source_id,
        artifact.DeclarationObservation(
            dependency_source,
            stable_id,
            aspect,
            qkey.Fingerprint128(),
            observed
        )
    );
}

qkey.Fingerprint128 observation_fingerprint(
    store_api.CompilerStore& store,
    qkey.StableSymbolId stable_id,
    artifact.ObservationAspect aspect
) {
    if (aspect == .body) {
        return store.incremental.body_fingerprint(stable_id);
    }
    return store.incremental.signature_fingerprint(stable_id);
}
