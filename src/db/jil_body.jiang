// generic source JIL lowering 与 instance demand 闭合的 session typed query。

import core_traits = "../core/traits.jiang";
import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct SourceJilKey: Copyable, Hashable, Equatable {
    Int store_identity;
    Int def_index;

    public init(self, Int store_identity, qid.DefId def_id) {
        self.store_identity = store_identity;
        self.def_index = def_id.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        hasher.write(self.def_index);
    }

    public Bool equal(SourceJilKey& lhs, SourceJilKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && lhs.def_index == rhs.def_index;
    }
}

public struct SourceJilQuery: Movable {
    Mutex<query_cache.QueryCache<SourceJilKey, Bool>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<SourceJilKey, Bool>>(
            query_cache.QueryCache<SourceJilKey, Bool>()
        );
    }

    public Void reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool evaluate(
        self,
        SourceJilKey key,
        FnOnce<Void> compute
    ) {
        query_cache.QueryCacheState<Bool> state = self.bodies.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(_)) { return true; }
        if (state is .evaluating) { return false; }
        compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(key, true);
        });
        return true;
    }

    public Bool is_active(self, SourceJilKey key) {
        return self.bodies.with_lock({ cache =>
            cache$.ref().is_evaluating(key)
        });
    }
}

public struct JilInstanceKey: Copyable, Hashable, Equatable {
    Int store_identity;
    Int def_index;
    Int instance_identity;

    public init(
        self,
        Int store_identity,
        qid.DefId def_id,
        Int instance_identity
    ) {
        self.store_identity = store_identity;
        self.def_index = def_id.to_index();
        self.instance_identity = instance_identity;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        hasher.write(self.def_index);
        hasher.write(self.instance_identity);
    }

    public Bool equal(JilInstanceKey& lhs, JilInstanceKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && lhs.def_index == rhs.def_index
            && lhs.instance_identity == rhs.instance_identity;
    }
}

public struct JilInstanceQuery: Movable {
    Mutex<query_cache.QueryCache<JilInstanceKey, Bool>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<JilInstanceKey, Bool>>(
            query_cache.QueryCache<JilInstanceKey, Bool>()
        );
    }

    public Void reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool evaluate(
        self,
        JilInstanceKey key,
        FnOnce<Void> compute
    ) {
        query_cache.QueryCacheState<Bool> state = self.bodies.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(_)) { return true; }
        if (state is .evaluating) { return false; }
        compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(key, true);
        });
        return true;
    }

    public Bool is_active(self, JilInstanceKey key) {
        return self.bodies.with_lock({ cache =>
            cache$.ref().is_evaluating(key)
        });
    }
}
