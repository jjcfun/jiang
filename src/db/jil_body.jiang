// JIL body lowering 的 session typed query。

import core_traits = "../core/traits.jiang";
import qid = "../id.jiang";
import jil = "../jil/model.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct JilBodyKey: Copyable, Hashable, Equatable {
    Int store_identity;
    Int def_index;
    Int instance_index;

    public init(
        self,
        Int store_identity,
        qid.DefId def_id,
        Int instance_index
    ) {
        self.store_identity = store_identity;
        self.def_index = def_id.to_index();
        self.instance_index = instance_index;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        hasher.write(self.def_index);
        hasher.write(self.instance_index);
    }

    public Bool equal(JilBodyKey& lhs, JilBodyKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && lhs.def_index == rhs.def_index
            && lhs.instance_index == rhs.instance_index;
    }
}

public struct JilBodyQuery: Movable {
    Mutex<query_cache.QueryCache<JilBodyKey, jil.FunctionId>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<JilBodyKey, jil.FunctionId>>(
            query_cache.QueryCache<JilBodyKey, jil.FunctionId>()
        );
    }

    public Void reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public jil.FunctionId? evaluate(
        self,
        JilBodyKey key,
        Fn<jil.FunctionId> compute
    ) {
        query_cache.QueryCacheState<jil.FunctionId> state = self.bodies.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(function_id)) { return function_id; }
        if (state is .evaluating) { return null; }
        jil.FunctionId function_id = compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(key, function_id);
        });
        return function_id;
    }

    public Bool is_active(self, JilBodyKey key) {
        return self.bodies.with_lock({ cache =>
            cache$.ref().is_evaluating(key)
        });
    }

}
