// template / concrete instance JIL body lowering 的 session typed query。

import core_traits = "../core/traits.jiang";
import qid = "../id.jiang";
import jil = "../jil/model.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct TemplateJilKey: Copyable, Hashable, Equatable {
    Int store_identity;
    Int def_index;

    public init(self, Int store_identity, qid.DefId def_id) {
        self.store_identity = store_identity;
        self.def_index = def_id.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        hasher.write(self.def_index);
    }

    public Bool equal(TemplateJilKey& lhs, TemplateJilKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && lhs.def_index == rhs.def_index;
    }
}

public struct TemplateJilQuery: Movable {
    Mutex<query_cache.QueryCache<TemplateJilKey, jil.TemplateId>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<TemplateJilKey, jil.TemplateId>>(
            query_cache.QueryCache<TemplateJilKey, jil.TemplateId>()
        );
    }

    public Void reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public jil.TemplateId? evaluate(
        self,
        TemplateJilKey key,
        FnOnce<jil.TemplateId> compute
    ) {
        query_cache.QueryCacheState<jil.TemplateId> state = self.bodies.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(template_id)) { return template_id; }
        if (state is .evaluating) { return null; }
        jil.TemplateId template_id = compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(key, template_id);
        });
        return template_id;
    }

    public Bool is_active(self, TemplateJilKey key) {
        return self.bodies.with_lock({ cache =>
            cache$.ref().is_evaluating(key)
        });
    }
}

public struct InstanceJilKey: Copyable, Hashable, Equatable {
    Int store_identity;
    Int def_index;
    Int instance_identity;

    public init(
        self,
        Int store_identity,
        qid.DefId def_id,
        Int instance_identity
    ) {
        self.store_identity = store_identity;
        self.def_index = def_id.to_index();
        self.instance_identity = instance_identity;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.store_identity);
        hasher.write(self.def_index);
        hasher.write(self.instance_identity);
    }

    public Bool equal(InstanceJilKey& lhs, InstanceJilKey& rhs) {
        return lhs.store_identity == rhs.store_identity
            && lhs.def_index == rhs.def_index
            && lhs.instance_identity == rhs.instance_identity;
    }
}

public struct InstanceJilQuery: Movable {
    Mutex<query_cache.QueryCache<InstanceJilKey, jil.FunctionId>>^ bodies;

    public init(self) {
        self.bodies = new Mutex<query_cache.QueryCache<InstanceJilKey, jil.FunctionId>>(
            query_cache.QueryCache<InstanceJilKey, jil.FunctionId>()
        );
    }

    public Void reset(self) {
        self.bodies.with_lock<Void>({ cache => cache.reset(); });
    }

    public jil.FunctionId? evaluate(
        self,
        InstanceJilKey key,
        FnOnce<jil.FunctionId> compute
    ) {
        query_cache.QueryCacheState<jil.FunctionId> state = self.bodies.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(function_id)) { return function_id; }
        if (state is .evaluating) { return null; }
        jil.FunctionId function_id = compute();
        self.bodies.with_lock<Void>({ cache =>
            cache.complete(key, function_id);
        });
        return function_id;
    }

    public Bool is_active(self, InstanceJilKey key) {
        return self.bodies.with_lock({ cache =>
            cache$.ref().is_evaluating(key)
        });
    }
}
