// trait parent dependency 的 session typed query。

import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum TraitDependencyRequest {
    compute,
    cycle,
}

public struct TraitDependencyQuery: Movable {
    Mutex<query_cache.QueryCache<qid.DefId, Bool>>^ traits;

    public init(self) {
        self.traits = new Mutex<query_cache.QueryCache<qid.DefId, Bool>>(
            query_cache.QueryCache<qid.DefId, Bool>()
        );
    }

    public () reset(self) {
        self.traits.with_lock<Void>({ cache => cache.reset(); });
    }

    public () evaluate(
        self,
        qid.DefId trait_def,
        Fn<Void, TraitDependencyRequest> evaluate
    ) {
        query_cache.QueryCacheState state = self.traits.with_lock({ cache =>
            cache.state(trait_def)
        });
        if (state == .ready) { return; }
        if (state == .evaluating) {
            evaluate(.cycle);
            return;
        }
        evaluate(.compute);
        self.traits.with_lock<Void>({ cache =>
            cache.complete(trait_def, true);
        });
    }

}
