// QueryEngine：求值层的运行时形态（Database 概念的运行时）。
//
// 每个查询一格 typed cache；递归状态由对应 typed query 自己管理。

import qid = "../id.jiang";
import layout = "../layout.jiang";
import jil = "../jil/model.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import source_artifact = "../artifact/source.jiang";
import qkey = "../incremental/key.jiang";
import source_identity = "../incremental/source_identity.jiang";
import source_graph = "../incremental/source_graph.jiang";
import layout_query = "./layout_query.jiang";
import query_cache = "./query_cache.jiang";
import module_interface_query = "./module_interface.jiang";
import module_model_query = "./module_model.jiang";
import object_unit_query = "./object_unit.jiang";
import build_target_query = "./build_target.jiang";
import build_manifest = "../artifact/build_manifest.jiang";
import import_summary_query = "./source_import_summary.jiang";
import stable_fingerprint = "./stable_fingerprint.jiang";
import body_queries = "./type_check_body.jiang";
import node_queries = "./type_check_node.jiang";
import def_queries = "./type_check_def.jiang";
import trait_queries = "./trait_dependency.jiang";
import lifetime_shape_queries = "./type_lifetime_shape.jiang";
import trait_satisfaction_queries = "./trait_satisfaction.jiang";
import const_definition_queries = "./const_definition.jiang";
import jil_body_queries = "./jil_body.jiang";
import trait_vtable_queries = "./trait_vtable.jiang";
import jil_analysis_queries = "./jil_analysis.jiang";
import observation = "./declaration_observation.jiang";
import def = "../resolve/def.jiang";
import namespace = "../resolve/namespace.jiang";
import sem = "../sema/model.jiang";
import lifetime_shape_model = "../sema/lifetime_shape.jiang";
import list = "../support/list.jiang";
import std;

// 求值层运行时：per-query typed caches。
// layout_of_type 的 cache 是 QueryCache<Int, LayoutId>：TypeId 目前没有
// Hashable，key 用稠密索引（to_index），值仍为强类型 LayoutId。
public struct QueryEngine: Movable {
    public layout_query.LayoutQuery layout!;
    module_interface_query.ModuleInterfaceQuery module_interface!;
    module_model_query.ModuleModelQuery module_model!;
    object_unit_query.ObjectUnitQuery object_unit!;
    build_target_query.BuildTargetQuery build_target!;
    import_summary_query.SourceImportSummaryQuery source_import_summary!;
    stable_fingerprint.StableFingerprintQuery def_signatures!;
    stable_fingerprint.StableFingerprintQuery def_bodies!;
    body_queries.TypeCheckBodyQuery type_check_body!;
    node_queries.TypeCheckNodeQuery type_check_node!;
    def_queries.TypeCheckDefQuery type_check_def!;
    trait_queries.TraitDependencyQuery trait_dependency!;
    lifetime_shape_queries.TypeLifetimeShapeQuery lifetime_shape!;
    trait_satisfaction_queries.TraitSatisfactionQuery trait_satisfaction!;
    const_definition_queries.ConstDefinitionQuery const_definition!;
    public jil_body_queries.TemplateJilQuery template_jil!;
    public jil_body_queries.InstanceJilQuery instance_jil!;
    public trait_vtable_queries.TraitVTableQuery trait_vtable!;
    jil_analysis_queries.JilStoreIdentityAllocator jil_store_identities!;
    observation.DeclarationObservationRecorder declaration_observations!;

    public init(self) {
        self.layout = layout_query.LayoutQuery();
        self.module_interface = module_interface_query.ModuleInterfaceQuery();
        self.module_model = module_model_query.ModuleModelQuery();
        self.object_unit = object_unit_query.ObjectUnitQuery();
        self.build_target = build_target_query.BuildTargetQuery();
        self.source_import_summary = import_summary_query.SourceImportSummaryQuery();
        self.def_signatures = stable_fingerprint.StableFingerprintQuery();
        self.def_bodies = stable_fingerprint.StableFingerprintQuery();
        self.type_check_body = body_queries.TypeCheckBodyQuery();
        self.type_check_node = node_queries.TypeCheckNodeQuery();
        self.type_check_def = def_queries.TypeCheckDefQuery();
        self.trait_dependency = trait_queries.TraitDependencyQuery();
        self.lifetime_shape = lifetime_shape_queries.TypeLifetimeShapeQuery();
        self.trait_satisfaction = trait_satisfaction_queries.TraitSatisfactionQuery();
        self.const_definition = const_definition_queries.ConstDefinitionQuery();
        self.template_jil = jil_body_queries.TemplateJilQuery();
        self.instance_jil = jil_body_queries.InstanceJilQuery();
        self.trait_vtable = trait_vtable_queries.TraitVTableQuery();
        self.jil_store_identities =
            jil_analysis_queries.JilStoreIdentityAllocator();
        self.declaration_observations =
            observation.DeclarationObservationRecorder();
    }

    // epoch 边界：清空 per-query caches。
    public Void reset(Self&! self) {
        self.layout.reset();
        self.module_interface.reset();
        self.module_model.reset();
        self.object_unit.reset();
        self.build_target.reset();
        self.source_import_summary.reset();
        self.def_signatures.reset();
        self.def_bodies.reset();
        self.reset_type_check_queries();
        self.template_jil.reset();
        self.instance_jil.reset();
        self.trait_vtable.reset();
        self.jil_store_identities.reset();
        self.declaration_observations.reset();
    }

    public Int def_signature_l2_restores(self) {
        return self.def_signatures.l2_restores();
    }

    public Int def_body_l2_restores(self) {
        return self.def_bodies.l2_restores();
    }

    public Int allocate_jil_store_identity(self) {
        return self.jil_store_identities.allocate();
    }

    // TypeCheckStore reset 会使所有 session DefId 结果失效；对应 cache 必须
    // 在同一 owner generation 边界清空。
    public Void reset_type_check_queries(Self&! self) {
        self.type_check_body.reset();
        self.type_check_node.reset();
        self.type_check_def.reset();
        self.trait_dependency.reset();
        self.lifetime_shape$.mut_ref().reset();
        self.trait_satisfaction.reset();
        self.const_definition.reset();
    }

    public qkey.Fingerprint128 def_signature(
        self,
        qkey.StableSymbolId stable_id,
        FnOnce<qkey.Fingerprint128> evaluate
    ) {
        return self.def_signatures.evaluate(stable_id, evaluate);
    }

    public qkey.Fingerprint128 def_body(
        self,
        qkey.StableSymbolId stable_id,
        FnOnce<qkey.Fingerprint128> evaluate
    ) {
        return self.def_bodies.evaluate(stable_id, evaluate);
    }

    // `.ji` 已经持有 declaration 的稳定 fingerprint。
    public Void restore_def_fingerprints(
        self,
        qkey.StableSymbolId stable_id,
        qkey.Fingerprint128 signature,
        qkey.Fingerprint128 body
    ) {
        self.def_signatures.restore(stable_id, signature);
        self.def_bodies.restore(stable_id, body);
    }

    public Void invalidate_def_fingerprints(self, qkey.StableSymbolId stable_id) {
        self.def_signatures.invalidate(stable_id);
        self.def_bodies.invalidate(stable_id);
    }

    public Bool validate_declaration_observations(
        self,
        store_api.CompilerStore& store,
        source_artifact.DeclarationObservationSet& observations
    ) {
        if (observations.entries.len() == 0) { return false; }
        Int index! = 0;
        while (index < observations.entries.len()) {
            if (!self.validate_declaration_observation(
                store,
                observations.entries.get(index)
            )) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool validate_declaration_observation(
        self,
        store_api.CompilerStore& store,
        source_artifact.DeclarationObservation item
    ) {
        guard store.incremental.current_def_for_stable(item.subject)
            is .some(current_def) else {
            return false;
        }
        guard store.defs.get(current_def).module_id is .some(module_id) else { return false; }
        guard source_identity.for_module(store, module_id) is .some(identity) else { return false; }
        if (identity != item.dependency_source) { return false; }
        if (item.aspect == .signature) {
            return self.def_signature(item.subject, { [ref store, item] =>
                store.incremental.signature_fingerprint(item.subject)
            }) == item.observed;
        }
        if (item.aspect == .body) {
            return self.def_body(item.subject, { [ref store, item] =>
                store.incremental.body_fingerprint(item.subject)
            }) == item.observed;
        }
        if (item.aspect == .namespace_name) {
            return observation.validate_namespace_name(store, item, current_def);
        }
        if (item.aspect == .namespace) {
            return observation.validate_namespace(store, item, current_def);
        }
        return false;
    }

}

public Void type_check_body(
    QueryEngine& query,
    qid.DefId def_id,
    FnOnce<Void> compute
) {
    query.type_check_body.evaluate(def_id, compute);
}

public qid.TypeId type_check_node(
    QueryEngine& query,
    sem.NodeId node_id,
    FnOnce<qid.TypeId, node_queries.TypeCheckNodeRequest> evaluate
) {
    return query.type_check_node.evaluate(node_id, evaluate);
}

public qid.TypeId type_check_def(
    QueryEngine& query,
    qid.DefId def_id,
    FnOnce<qid.TypeId, def_queries.TypeCheckDefRequest> evaluate
) {
    return query.type_check_def.evaluate(def_id, evaluate);
}

public jil.TemplateId? template_jil(
    QueryEngine& query,
    jil_body_queries.TemplateJilKey key,
    FnOnce<jil.TemplateId> compute
) {
    return query.template_jil.evaluate(key, compute);
}

public Bool template_jil_is_active(
    QueryEngine& query,
    jil_body_queries.TemplateJilKey key
) {
    return query.template_jil.is_active(key);
}

public jil.FunctionId? instance_jil(
    QueryEngine& query,
    jil_body_queries.InstanceJilKey key,
    FnOnce<jil.FunctionId> compute
) {
    return query.instance_jil.evaluate(key, compute);
}

public Bool instance_jil_is_active(
    QueryEngine& query,
    jil_body_queries.InstanceJilKey key
) {
    return query.instance_jil.is_active(key);
}

public Void trait_dependency(
    QueryEngine& query,
    qid.DefId trait_def,
    FnOnce<Void, trait_queries.TraitDependencyRequest> evaluate
) {
    query.trait_dependency.evaluate(trait_def, evaluate);
}

public query_cache.QueryCacheState<lifetime_shape_model.LifetimeShapeId> lifetime_shape_state(
    QueryEngine&! query,
    qid.TypeId type_id
) {
    return query.lifetime_shape$.mut_ref().state(type_id);
}

public Void complete_lifetime_shape(
    QueryEngine&! query,
    qid.TypeId type_id,
    lifetime_shape_model.LifetimeShapeId shape
) {
    query.lifetime_shape$.mut_ref().complete(type_id, shape);
}

public lifetime_shape_model.LifetimeShapeId empty_lifetime_shape(QueryEngine& query) {
    return query.lifetime_shape.shapes.empty_shape();
}

public lifetime_shape_model.LifetimeShapeId slot_lifetime_shape(QueryEngine& query) {
    return query.lifetime_shape.shapes.slot_shape();
}

public lifetime_shape_model.LifetimeShape get_lifetime_shape(
    QueryEngine& query,
    lifetime_shape_model.LifetimeShapeId shape
) {
    return query.lifetime_shape.shapes.get(shape);
}

public lifetime_shape_model.LifetimeShapeClass classify_lifetime_shape(
    QueryEngine& query,
    lifetime_shape_model.LifetimeShapeId shape
) {
    return query.lifetime_shape.shapes.classify(shape);
}

public lifetime_shape_model.LifetimeShapeId product_lifetime_shape(
    QueryEngine&! query,
    list.ArrayList<lifetime_shape_model.LifetimeShapeId>& items
) {
    return query.lifetime_shape.shapes.product(items);
}

public lifetime_shape_model.LifetimeShapeId repeated_lifetime_shape(
    QueryEngine&! query,
    lifetime_shape_model.LifetimeShapeId element
) {
    return query.lifetime_shape.shapes.repeated(element);
}

public lifetime_shape_model.LifetimeShapeId alternative_lifetime_shape(
    QueryEngine&! query,
    list.ArrayList<lifetime_shape_model.LifetimeShapeId>& variants
) {
    return query.lifetime_shape.shapes.alternative(variants);
}

public lifetime_shape_model.LifetimeShapeId reference_lifetime_shape(
    QueryEngine&! query,
    lifetime_shape_model.LifetimeShapeId value
) {
    return query.lifetime_shape.shapes.reference(value);
}

public lifetime_shape_model.LifetimeShapeId symbolic_lifetime_shape(
    QueryEngine&! query,
    qid.DefId parameter
) {
    return query.lifetime_shape.shapes.symbolic(parameter);
}

public lifetime_shape_model.LifetimeShapeId recursive_lifetime_shape(
    QueryEngine&! query,
    qid.DefId nominal
) {
    return query.lifetime_shape.shapes.recursive(nominal);
}

public Bool type_satisfies_trait(
    QueryEngine& query,
    qid.TypeId subject,
    qid.DefId trait_def,
    qid.DefId use_owner,
    FnOnce<Bool> compute
) {
    return query.trait_satisfaction.evaluate(
        subject,
        trait_def,
        use_owner,
        compute
    );
}

public Bool const_definition(
    QueryEngine& query,
    qid.DefId def_id,
    FnOnce<Bool, const_definition_queries.ConstDefinitionRequest> evaluate
) {
    return query.const_definition.evaluate(def_id, evaluate);
}

// source import summary 的 L1 只缓存 SourceId owner 句柄；
// L2 读取和 L3 发布都由调用方保持 SourceArtifactCache 的唯一事实所有权。
public source.SourceId? source_import_summary(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    FnOnce<source.SourceId?> load
) {
    return query.source_import_summary.evaluate(identity, load);
}

public Void publish_source_import_summary(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    source.SourceId source_id
) {
    query.source_import_summary.publish(identity, source_id);
}

public module_model_query.ModuleModelInput module_model(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    Bool source_dirty,
    Bool dependency_candidate,
    FnOnce<Bool, Bool> restore
) {
    return query.module_model.evaluate(
        identity,
        source_dirty,
        dependency_candidate,
        restore
    );
}

public Void force_source_module_model(
    QueryEngine& query,
    cache_identity.StableSourceId identity
) {
    query.module_model.force_source(identity);
}

public Int publish_module_interface_change(
    QueryEngine& query,
    source_graph.SourceDependencyGraph&! graph,
    source_graph.SourceNodeId source_id,
    qkey.Fingerprint128 package_interface,
    qkey.Fingerprint128 public_interface
) {
    return graph.publish_interface_change(
        source_id,
        package_interface,
        public_interface
    );
}

public object_unit_query.ObjectUnitResult object_unit(
    QueryEngine& query,
    object_unit_query.ObjectUnitKey key,
    build_manifest.BuildManifest?& previous,
    UInt8[]& path
) {
    return query.object_unit.evaluate(key, previous, path);
}

public Bool build_target_is_no_op(
    QueryEngine& query,
    build_target_query.BuildTargetKey key,
    UInt8[]& context_root,
    UInt8[]& source_base,
    UInt8[]& output_path
) {
    return query.build_target.is_no_op(
        key,
        context_root,
        source_base,
        output_path
    );
}

// 稳定 interface 查询只缓存 owner store 的 SourceId 句柄，不复制 ModuleInterface。
// load 在 L1 miss 时执行 L2 读取或保守重算，并且不跨 cache lock 调用。
public source.SourceId? module_interface(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    FnOnce<source.SourceId?> load
) {
    return query.module_interface.evaluate(identity, load);
}

// L3 构造并写入 SourceArtifactCache 后，由 owner 的发布路径登记 L1 句柄。
public Void publish_module_interface(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    source.SourceId source_id
) {
    query.module_interface.publish(identity, source_id);
}

public Void begin_source_observations(
    QueryEngine& query,
    source.SourceId source_id
) {
    query.declaration_observations.begin_source(source_id);
}

public Void record_declaration_observation(
    QueryEngine& query,
    source.SourceId source_id,
    source_artifact.DeclarationObservation observation
) {
    query.declaration_observations.record(source_id, observation);
}

public Void observe_def_signature(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.DefId target_def
) {
    observation.record_def_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        target_def,
        .signature
    );
}

public Void observe_def_body(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.DefId target_def
) {
    observation.record_def_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        target_def,
        .body
    );
}

public Void observe_namespace_name(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.NamespaceId namespace_id,
    qid.SymbolId symbol,
    def.NameDomain domain,
    namespace.BindingEntry? binding
) {
    observation.record_namespace_name_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        namespace_id,
        symbol,
        domain,
        binding
    );
}

public Void observe_public_namespace(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.NamespaceId namespace_id
) {
    observation.record_public_namespace_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        namespace_id
    );
}

public Void observe_public_extension_surface(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.ModuleId target_module
) {
    observation.record_public_extension_surface_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        target_module
    );
}

public Bool begin_public_extension_search(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner
) {
    guard store.defs.get(use_owner).module_id is .some(use_module) else { return false; }
    if (store.resolve.module_ref(use_module).interface_only) { return false; }
    return query.declaration_observations.begin_extension_search(
        store.resolve.module_ref(use_module).source_id
    );
}

public Void publish_declaration_observations(
    QueryEngine& query,
    source_artifact.SourceArtifactCache&! cache
) {
    query.declaration_observations.publish(cache);
}

public Void require_debug_source_products(
    QueryEngine& query,
    source_graph.SourceDependencyGraph&! graph,
    UInt8[]& context_root,
    qkey.Fingerprint128 target_identity,
    qkey.Fingerprint128 context_fingerprint
) {
    query.object_unit.require_debug_source_products(
        graph,
        context_root,
        target_identity,
        context_fingerprint
    );
}

// 第一个查询入口：layout_of_type。
//
// L1 命中直接返回；miss 走既有 compute 实现并写入本查询 cache。
// 查询入口只借用本查询 state 和只读 CompilerStore，不接收整个 CompilerContext。
public layout.LayoutId layout_of_type(
    QueryEngine&! query,
    store_api.CompilerStore& store,
    qid.TypeId type_id
) {
    return query.layout.evaluate(store, type_id);
}

public Bool layout_has_errors(QueryEngine& query) {
    return query.layout.has_errors();
}

public layout.TargetLayout target_layout(QueryEngine& query) {
    return query.layout.target();
}

public layout.TypeLayout type_layout(QueryEngine& query, layout.LayoutId id) {
    return query.layout.layout(id);
}

public layout.LayoutId? cached_layout_id(QueryEngine& query, qid.TypeId type_id) {
    return query.layout.layout_id_for_type(type_id);
}

public qid.TypeId? trait_vtable_field_type(
    QueryEngine& query,
    qid.DefId trait_def,
    Int offset
) {
    return query.layout.trait_vtable_field_type(trait_def, offset);
}

public layout.DropCategoryKind drop_category_of_type(
    QueryEngine&! query,
    store_api.CompilerStore& store,
    qid.TypeId type_id
) {
    return query.layout.drop_category_of_type(store, type_id);
}

public Void prepare_trait_vtable_field_types(
    QueryEngine&! query,
    store_api.CompilerStore& store,
    qid.TypeId type_id
) {
    query.layout.prepare_trait_vtable_field_types(store, type_id);
}
