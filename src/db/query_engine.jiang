// QueryEngine：求值层的运行时形态（Database 概念的运行时）。
//
// 每个查询一格 typed cache；递归状态由对应 typed query 自己管理。

import qid = "../id.jiang";
import layout = "../layout.jiang";
import jil = "../jil/model.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import source_artifact = "../artifact/source.jiang";
import qkey = "../incremental/key.jiang";
import source_identity = "../incremental/source_identity.jiang";
import layout_query = "./layout_query.jiang";
import module_interface_query = "./module_interface.jiang";
import import_summary_query = "./source_import_summary.jiang";
import stable_fingerprint = "./stable_fingerprint.jiang";
import body_queries = "./type_check_body.jiang";
import node_queries = "./type_check_node.jiang";
import def_queries = "./type_check_def.jiang";
import trait_queries = "./trait_dependency.jiang";
import lifetime_shape_queries = "./type_lifetime_shape.jiang";
import trait_satisfaction_queries = "./trait_satisfaction.jiang";
import const_definition_queries = "./const_definition.jiang";
import jil_body_queries = "./jil_body.jiang";
import jil_analysis_queries = "./jil_analysis.jiang";
import observation = "./declaration_observation.jiang";
import def = "../resolve/def.jiang";
import namespace = "../resolve/namespace.jiang";
import sem = "../sema/model.jiang";
import lifetime_shape_model = "../sema/lifetime_shape.jiang";
import std;

// 求值层运行时：per-query typed caches。
// layout_of_type 的 cache 是 QueryCache<Int, LayoutId>：TypeId 目前没有
// Hashable，key 用稠密索引（to_index），值仍为强类型 LayoutId。
public struct QueryEngine: Movable {
    layout_query.LayoutQuery layout;
    module_interface_query.ModuleInterfaceQuery module_interface;
    import_summary_query.SourceImportSummaryQuery source_import_summary;
    stable_fingerprint.StableFingerprintQuery def_signatures;
    stable_fingerprint.StableFingerprintQuery def_bodies;
    body_queries.TypeCheckBodyQuery type_check_body;
    node_queries.TypeCheckNodeQuery type_check_node;
    def_queries.TypeCheckDefQuery type_check_def;
    trait_queries.TraitDependencyQuery trait_dependency;
    lifetime_shape_queries.TypeLifetimeShapeQuery lifetime_shape;
    trait_satisfaction_queries.TraitSatisfactionQuery trait_satisfaction;
    const_definition_queries.ConstDefinitionQuery const_definition;
    jil_body_queries.JilBodyQuery jil_body;
    jil_analysis_queries.JilStoreIdentityAllocator jil_store_identities;
    observation.DeclarationObservationRecorder declaration_observations;

    public init(self) {
        self.layout = layout_query.LayoutQuery();
        self.module_interface = module_interface_query.ModuleInterfaceQuery();
        self.source_import_summary = import_summary_query.SourceImportSummaryQuery();
        self.def_signatures = stable_fingerprint.StableFingerprintQuery();
        self.def_bodies = stable_fingerprint.StableFingerprintQuery();
        self.type_check_body = body_queries.TypeCheckBodyQuery();
        self.type_check_node = node_queries.TypeCheckNodeQuery();
        self.type_check_def = def_queries.TypeCheckDefQuery();
        self.trait_dependency = trait_queries.TraitDependencyQuery();
        self.lifetime_shape = lifetime_shape_queries.TypeLifetimeShapeQuery();
        self.trait_satisfaction = trait_satisfaction_queries.TraitSatisfactionQuery();
        self.const_definition = const_definition_queries.ConstDefinitionQuery();
        self.jil_body = jil_body_queries.JilBodyQuery();
        self.jil_store_identities =
            jil_analysis_queries.JilStoreIdentityAllocator();
        self.declaration_observations =
            observation.DeclarationObservationRecorder();
    }

    // epoch 边界：清空 per-query caches。
    public Void reset(self) {
        self.layout.reset();
        self.module_interface.reset();
        self.source_import_summary.reset();
        self.def_signatures.reset();
        self.def_bodies.reset();
        self.reset_type_check_queries();
        self.jil_body.reset();
        self.jil_store_identities.reset();
        self.declaration_observations.reset();
    }

    public Int def_signature_l2_restores(self) {
        return self.def_signatures.l2_restores();
    }

    public Int def_body_l2_restores(self) {
        return self.def_bodies.l2_restores();
    }

    public Int allocate_jil_store_identity(self) {
        return self.jil_store_identities.allocate();
    }

    // TypeCheckStore reset 会使所有 session DefId 结果失效；对应 cache 必须
    // 在同一 owner generation 边界清空。
    public Void reset_type_check_queries(self) {
        self.type_check_body.reset();
        self.type_check_node.reset();
        self.type_check_def.reset();
        self.trait_dependency.reset();
        self.lifetime_shape.reset();
        self.trait_satisfaction.reset();
        self.const_definition.reset();
    }

    public qkey.Fingerprint128 def_signature(
        self,
        qkey.StableSymbolId stable_id,
        Fn<qkey.Fingerprint128> evaluate
    ) {
        return self.def_signatures.evaluate(stable_id, evaluate);
    }

    public qkey.Fingerprint128 def_body(
        self,
        qkey.StableSymbolId stable_id,
        Fn<qkey.Fingerprint128> evaluate
    ) {
        return self.def_bodies.evaluate(stable_id, evaluate);
    }

    // `.ji` 已经持有 declaration 的稳定 fingerprint。
    public Void restore_def_fingerprints(
        self,
        qkey.StableSymbolId stable_id,
        qkey.Fingerprint128 signature,
        qkey.Fingerprint128 body
    ) {
        self.def_signatures.restore(stable_id, signature);
        self.def_bodies.restore(stable_id, body);
    }

    public Void invalidate_def_fingerprints(self, qkey.StableSymbolId stable_id) {
        self.def_signatures.invalidate(stable_id);
        self.def_bodies.invalidate(stable_id);
    }

    public Bool validate_declaration_observations(
        self,
        store_api.CompilerStore& store,
        source_artifact.DeclarationObservationSet& observations
    ) {
        if (observations.entries.len() == 0) { return false; }
        Int index! = 0;
        while (index < observations.entries.len()) {
            if (!self.validate_declaration_observation(
                store,
                observations.entries.get(index)
            )) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool validate_declaration_observation(
        self,
        store_api.CompilerStore& store,
        source_artifact.DeclarationObservation item
    ) {
        guard store.incremental.current_def_for_stable(item.subject)
            is .some(current_def) else {
            return false;
        }
        guard store.defs.get(current_def).module_id is .some(module_id) else { return false; }
        guard source_identity.for_module(store, module_id) is .some(identity) else { return false; }
        if (identity != item.dependency_source) { return false; }
        if (item.aspect == .signature) {
            return self.def_signature(item.subject, { [ref store, item] =>
                store.incremental.signature_fingerprint(item.subject)
            }) == item.observed;
        }
        if (item.aspect == .body) {
            return self.def_body(item.subject, { [ref store, item] =>
                store.incremental.body_fingerprint(item.subject)
            }) == item.observed;
        }
        if (item.aspect == .namespace_name) {
            return observation.validate_namespace_name(store, item, current_def);
        }
        return false;
    }

}

public Void type_check_body(
    QueryEngine& query,
    qid.DefId def_id,
    Fn<Void> compute
) {
    query.type_check_body.evaluate(def_id, compute);
}

public qid.TypeId type_check_node(
    QueryEngine& query,
    sem.NodeId node_id,
    Fn<qid.TypeId, node_queries.TypeCheckNodeRequest> evaluate
) {
    return query.type_check_node.evaluate(node_id, evaluate);
}

public qid.TypeId type_check_def(
    QueryEngine& query,
    qid.DefId def_id,
    Fn<qid.TypeId, def_queries.TypeCheckDefRequest> evaluate
) {
    return query.type_check_def.evaluate(def_id, evaluate);
}

public jil.FunctionId? jil_body(
    QueryEngine& query,
    jil_body_queries.JilBodyKey key,
    Fn<jil.FunctionId> compute
) {
    return query.jil_body.evaluate(key, compute);
}

public Bool jil_body_is_active(
    QueryEngine& query,
    jil_body_queries.JilBodyKey key
) {
    return query.jil_body.is_active(key);
}

public Void trait_dependency(
    QueryEngine& query,
    qid.DefId trait_def,
    Fn<Void, trait_queries.TraitDependencyRequest> evaluate
) {
    query.trait_dependency.evaluate(trait_def, evaluate);
}

public lifetime_shape_model.LifetimeShapeId lifetime_shape(
    QueryEngine& query,
    qid.TypeId type_id,
    Fn<
        lifetime_shape_model.LifetimeShapeId,
        lifetime_shape_queries.TypeLifetimeShapeRequest
    > evaluate
) {
    return query.lifetime_shape.evaluate(type_id, evaluate);
}

public Bool type_satisfies_trait(
    QueryEngine& query,
    qid.TypeId subject,
    qid.DefId trait_def,
    qid.DefId use_owner,
    Fn<Bool> compute
) {
    return query.trait_satisfaction.evaluate(
        subject,
        trait_def,
        use_owner,
        compute
    );
}

public Bool const_definition(
    QueryEngine& query,
    qid.DefId def_id,
    Fn<Bool, const_definition_queries.ConstDefinitionRequest> evaluate
) {
    return query.const_definition.evaluate(def_id, evaluate);
}

// source import summary 的 L1 只缓存 SourceId owner 句柄；
// L2 读取和 L3 发布都由调用方保持 SourceArtifactCache 的唯一事实所有权。
public source.SourceId? source_import_summary(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    Fn<source.SourceId?> load
) {
    return query.source_import_summary.evaluate(identity, load);
}

public Void publish_source_import_summary(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    source.SourceId source_id
) {
    query.source_import_summary.publish(identity, source_id);
}

// 稳定 interface 查询只缓存 owner store 的 SourceId 句柄，不复制 ModuleInterface。
// load 在 L1 miss 时执行 L2 读取或保守重算，并且不跨 cache lock 调用。
public source.SourceId? module_interface(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    Fn<source.SourceId?> load
) {
    return query.module_interface.evaluate(identity, load);
}

// L3 构造并写入 SourceArtifactCache 后，由 owner 的发布路径登记 L1 句柄。
public Void publish_module_interface(
    QueryEngine& query,
    cache_identity.StableSourceId identity,
    source.SourceId source_id
) {
    query.module_interface.publish(identity, source_id);
}

public Void begin_source_observations(
    QueryEngine& query,
    source.SourceId source_id
) {
    query.declaration_observations.begin_source(source_id);
}

public Void record_declaration_observation(
    QueryEngine& query,
    source.SourceId source_id,
    source_artifact.DeclarationObservation observation
) {
    query.declaration_observations.record(source_id, observation);
}

public Void observe_def_signature(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.DefId target_def
) {
    observation.record_def_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        target_def,
        .signature
    );
}

public Void observe_def_body(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.DefId target_def
) {
    observation.record_def_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        target_def,
        .body
    );
}

public Void observe_namespace_name(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.DefId use_owner,
    qid.NamespaceId namespace_id,
    qid.SymbolId symbol,
    def.NameDomain domain,
    namespace.BindingEntry? binding
) {
    observation.record_namespace_name_read(
        query.declaration_observations$.ref(),
        store,
        use_owner,
        namespace_id,
        symbol,
        domain,
        binding
    );
}

public Void publish_declaration_observations(
    QueryEngine& query,
    source_artifact.SourceArtifactCache& cache
) {
    query.declaration_observations.publish(cache);
}

// 第一个查询入口：layout_of_type。
//
// L1 命中直接返回；miss 走既有 compute 实现并写入本查询 cache。
// 查询入口只借用本查询 state 和只读 CompilerStore，不接收整个 CompilerContext。
public layout.LayoutId layout_of_type(
    QueryEngine& query,
    store_api.CompilerStore& store,
    qid.TypeId type_id
) {
    return query.layout.evaluate(store, type_id);
}
