// stable source import summary 的 typed query。

import source = "../source.jiang";
import query_dependency = "./query_dependency.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct SourceImportSummaryQuery: Movable {
    Mutex<query_cache.QueryCache<
        query_dependency.StableQueryKey,
        source.SourceId
    >>^ cache;

    public init(self) {
        self.cache = new Mutex<query_cache.QueryCache<
            query_dependency.StableQueryKey,
            source.SourceId
        >>(query_cache.QueryCache<
            query_dependency.StableQueryKey,
            source.SourceId
        >());
    }

    public Void reset(self) {
        self.cache.with_lock<Void>({ cache => cache.reset(); });
    }

    public source.SourceId? evaluate(
        self,
        query_dependency.StableQueryKey key,
        Fn<source.SourceId?> load
    ) {
        source.SourceId? cached = self.cache.with_lock({ cache =>
            cache.lookup(key)
        });
        if (cached is .some(source_id)) { return source_id; }
        guard load() is .some(source_id) else { return null; }
        self.publish(key, source_id);
        return source_id;
    }

    public Void publish(
        self,
        query_dependency.StableQueryKey key,
        source.SourceId source_id
    ) {
        self.cache.with_lock<Void>({ cache =>
            cache.publish(key, source_id);
        });
    }

}
