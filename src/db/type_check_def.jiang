// declaration type 的 session typed query。

import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum TypeCheckDefRequest {
    compute,
    cycle,
}

public struct TypeCheckDefQuery: Movable {
    Mutex<query_cache.QueryCache<qid.DefId, qid.TypeId>>^ defs;

    public init(self) {
        self.defs = new Mutex<query_cache.QueryCache<qid.DefId, qid.TypeId>>(
            query_cache.QueryCache<qid.DefId, qid.TypeId>()
        );
    }

    public () reset(self) {
        self.defs.with_lock<Void>({ cache => cache.reset(); });
    }

    public qid.TypeId evaluate(
        self,
        qid.DefId def_id,
        Fn<qid.TypeId, TypeCheckDefRequest> evaluate
    ) {
        query_cache.QueryCacheState state = self.defs.with_lock({ cache =>
            cache.state(def_id)
        });
        if (state == .ready) {
            return self.defs.with_lock({ cache =>
                cache.lookup(def_id)$.some()
            });
        }
        if (state == .evaluating) { return evaluate(.cycle); }
        qid.TypeId type_id = evaluate(.compute);
        self.defs.with_lock<Void>({ cache =>
            cache.complete(def_id, type_id);
        });
        return type_id;
    }

}
