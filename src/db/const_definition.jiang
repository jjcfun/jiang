// const definition 的同步求值状态；实际值仍由 ComptimeStore 唯一拥有。

import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum ConstDefinitionRequest {
    compute,
    cycle,
}

public struct ConstDefinitionQuery: Movable {
    Mutex<query_cache.QueryCache<qid.DefId, Bool>>^ definitions;

    public init(self) {
        self.definitions = new Mutex<query_cache.QueryCache<qid.DefId, Bool>>(
            query_cache.QueryCache<qid.DefId, Bool>()
        );
    }

    public Void reset(self) {
        self.definitions.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool evaluate(
        self,
        qid.DefId def_id,
        FnOnce<Bool, ConstDefinitionRequest> evaluate
    ) {
        query_cache.QueryCacheState<Bool> state = self.definitions.with_lock({ cache =>
            cache.state(def_id)
        });
        if (state is .ready(_)) { return true; }
        if (state is .evaluating) { return evaluate(.cycle); }
        Bool complete = evaluate(.compute);
        self.definitions.with_lock<Void>({ cache =>
            if (complete) {
                cache.complete(def_id, true);
            } else {
                cache.remove(def_id);
            }
        });
        return complete;
    }
}
