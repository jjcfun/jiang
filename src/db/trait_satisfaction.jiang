// 类型对 trait 的同步判定查询。

import core_traits = "../core/traits.jiang";
import qid = "../id.jiang";
import query_cache = "./query_cache.jiang";
import std;

struct TraitSatisfactionKey: Copyable, Hashable, Equatable {
    Int subject;
    Int trait_def;
    Int use_owner;

    public init(
        self,
        qid.TypeId subject,
        qid.DefId trait_def,
        qid.DefId use_owner
    ) {
        self.subject = subject.to_index();
        self.trait_def = trait_def.to_index();
        self.use_owner = use_owner.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.subject);
        hasher.write(self.trait_def);
        hasher.write(self.use_owner);
    }

    public Bool equal(TraitSatisfactionKey& lhs, TraitSatisfactionKey& rhs) {
        return lhs.subject == rhs.subject
            && lhs.trait_def == rhs.trait_def
            && lhs.use_owner == rhs.use_owner;
    }
}

public struct TraitSatisfactionQuery: Movable {
    Mutex<query_cache.QueryCache<TraitSatisfactionKey, Bool>>^ results;

    public init(self) {
        self.results = new Mutex<query_cache.QueryCache<TraitSatisfactionKey, Bool>>(
            query_cache.QueryCache<TraitSatisfactionKey, Bool>()
        );
    }

    public Void reset(self) {
        self.results.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool evaluate(
        self,
        qid.TypeId subject,
        qid.DefId trait_def,
        qid.DefId use_owner,
        Fn<Bool> compute
    ) {
        TraitSatisfactionKey key = TraitSatisfactionKey(subject, trait_def, use_owner);
        query_cache.QueryCacheState<Bool> state = self.results.with_lock({ cache =>
            cache.state(key)
        });
        if (state is .ready(satisfied)) { return satisfied; }
        if (state is .evaluating) { return false; }
        Bool satisfied = compute();
        self.results.with_lock<Void>({ cache => cache.complete(key, satisfied); });
        return satisfied;
    }
}
