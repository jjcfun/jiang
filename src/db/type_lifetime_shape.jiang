// 类型 lifetime shape 的同步 typed query。
//
// cache 与 LifetimeShapeStore 由同一个 typed query 拥有。LifetimeShapeId 只在
// 当前 compilation epoch 内有效；同步求值通过 QueryEngine&! 串行修改二者。

import qid = "../id.jiang";
import lifetime_shape = "../sema/lifetime_shape.jiang";
import query_cache = "./query_cache.jiang";
import table = "../support/table.jiang";

public struct TypeLifetimeShapeQuery: Movable {
    // TypeId 连续分配，lifetime shape 是编译期高频事实，不能为每次读取计算通用 hash。
    // 缺席表示 missing；已发布位置只保存 evaluating 或 ready。
    table.SideTable<
        qid.TypeId,
        query_cache.QueryCacheState<lifetime_shape.LifetimeShapeId>
    > states!;
    public lifetime_shape.LifetimeShapeStore shapes!;

    public init(self) {
        self.states = table.SideTable<
            qid.TypeId,
            query_cache.QueryCacheState<lifetime_shape.LifetimeShapeId>
        >();
        self.shapes = lifetime_shape.LifetimeShapeStore();
    }

    public Void reset(Self&! self) {
        self.states.clear();
        self.shapes = lifetime_shape.LifetimeShapeStore();
    }

    public query_cache.QueryCacheState<lifetime_shape.LifetimeShapeId> state(
        Self&! self,
        qid.TypeId type_id
    ) {
        if (self.states.has(type_id)) { return self.states.get(type_id); }
        self.states.set(type_id, .evaluating());
        return .missing();
    }

    public Void complete(
        Self&! self,
        qid.TypeId type_id,
        lifetime_shape.LifetimeShapeId shape
    ) {
        assert(self.states.has(type_id));
        assert(self.states.get(type_id) is .evaluating);
        self.states.set(type_id, .ready(shape));
    }
}
