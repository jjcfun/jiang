// 类型 lifetime shape 的同步 typed query。
//
// QueryCache 只保存 TypeId 对应的 LifetimeShapeId 和递归求值状态；真正的
// LifetimeShape 仍由当前 compilation epoch 的 TypeCheckStore 拥有。

import qid = "../id.jiang";
import lifetime_shape = "../sema/lifetime_shape.jiang";
import query_cache = "./query_cache.jiang";
import std;

public enum TypeLifetimeShapeRequest {
    compute,
    cycle,
}

public struct TypeLifetimeShapeQuery: Movable {
    Mutex<query_cache.QueryCache<Int, lifetime_shape.LifetimeShapeId>>^ shapes;

    public init(self) {
        self.shapes = new Mutex<query_cache.QueryCache<
            Int,
            lifetime_shape.LifetimeShapeId
        >>(query_cache.QueryCache<Int, lifetime_shape.LifetimeShapeId>());
    }

    public Void reset(self) {
        self.shapes.with_lock<Void>({ cache => cache.reset(); });
    }

    public lifetime_shape.LifetimeShapeId evaluate(
        self,
        qid.TypeId type_id,
        Fn<lifetime_shape.LifetimeShapeId, TypeLifetimeShapeRequest> evaluate
    ) {
        Int key = type_id.to_index();
        query_cache.QueryCacheState<lifetime_shape.LifetimeShapeId> state =
            self.shapes.with_lock({ cache => cache.state(key) });
        if (state is .ready(shape)) { return shape; }
        if (state is .evaluating) { return evaluate(.cycle); }
        lifetime_shape.LifetimeShapeId shape = evaluate(.compute);
        self.shapes.with_lock<Void>({ cache => cache.complete(key, shape); });
        return shape;
    }
}
