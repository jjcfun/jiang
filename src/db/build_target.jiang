// build target 的成功 no-op 查询。
//
// 只缓存 true。miss 不能缓存：调用方等待 target lock 时，另一进程可能发布
// 新 `.jbuild`，锁内第二次求值必须重新检查持久状态。

import build_state = "../artifact/build_state.jiang";
import qkey = "../incremental/key.jiang";
import core_traits = "../core/traits.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct BuildTargetKey: Copyable, Hashable, Equatable {
    public qkey.Fingerprint128 target;
    public qkey.Fingerprint128 context;
    public qkey.Fingerprint128 invocation;

    public init(self,
        qkey.Fingerprint128 target,
        qkey.Fingerprint128 context,
        qkey.Fingerprint128 invocation
    ) {
        self.target = target;
        self.context = context;
        self.invocation = invocation;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.target.hash(hasher);
        self.context.hash(hasher);
        self.invocation.hash(hasher);
    }

    public Bool equal(BuildTargetKey& lhs, BuildTargetKey& rhs) {
        return lhs.target == rhs.target
            && lhs.context == rhs.context
            && lhs.invocation == rhs.invocation;
    }
}

public struct BuildTargetQuery: Movable {
    Mutex<query_cache.QueryCache<BuildTargetKey, Bool>>^ cache;

    public init(self) {
        self.cache = new Mutex<query_cache.QueryCache<
            BuildTargetKey,
            Bool
        >>(query_cache.QueryCache<BuildTargetKey, Bool>());
    }

    public Void reset(self) {
        self.cache.with_lock<Void>({ cache => cache.reset(); });
    }

    public Bool is_no_op(
        self,
        BuildTargetKey key,
        UInt8[]& context_root,
        UInt8[]& source_base,
        UInt8[]& output_path
    ) {
        Bool? cached = self.cache.with_lock({ cache => cache.lookup(key) });
        if (cached is .some(value)) { return value; }
        if (!build_state.is_no_op(
            context_root,
            key.target,
            key.context,
            key.invocation,
            source_base,
            output_path
        )) {
            return false;
        }
        self.cache.with_lock<Void>({ cache => cache.publish(key, true); });
        return true;
    }
}
