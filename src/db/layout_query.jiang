// TypeId -> LayoutId 的 typed query。

import qid = "../id.jiang";
import layout = "../layout.jiang";
import compute = "../layout/compute.jiang";
import diagnostic = "../diagnostic.jiang";
import store_api = "../store.jiang";
import query_cache = "./query_cache.jiang";
public struct LayoutQuery: Movable {
    query_cache.QueryCache<Int, layout.LayoutId> cache!;
    layout.LayoutStore layouts!;

    public init(self) {
        self.cache = query_cache.QueryCache<Int, layout.LayoutId>();
        self.layouts = layout.LayoutStore();
    }

    public Void reset(Self&! self) {
        self.cache.reset();
        self.layouts.reset();
    }

    public layout.LayoutId evaluate(
        Self&! self,
        store_api.CompilerStore& store,
        qid.TypeId type_id
    ) {
        query_cache.QueryCacheState<layout.LayoutId> state = self.cache.state(type_id.to_index());
        if (state is .ready(value)) { return value; }
        assert(state is .missing);
        layout.LayoutId id = compute.layout_of_type(store, self.layouts$.mut_ref(), type_id);
        self.cache.complete(type_id.to_index(), id);
        return id;
    }

    public Bool has_errors(self) {
        return self.layouts.has_errors();
    }

    public diagnostic.DiagnosticStore take_diagnostics(Self&! self) {
        return self.layouts.diagnostics.take();
    }

    public layout.TargetLayout target(self) {
        return self.layouts.target;
    }

    public Void set_target(Self&! self, layout.TargetLayout target) {
        self.cache.reset();
        self.layouts.set_target(target);
    }

    public layout.TypeLayout layout(self, layout.LayoutId id) {
        return self.layouts.layout(id);
    }

    public Int? field_index_for_def(
        Self&! self,
        store_api.CompilerStore& store,
        qid.TypeId owner_type,
        qid.DefId field_def
    ) {
        layout.LayoutId id = self.evaluate(store, owner_type);
        layout.TypeLayout owner_layout = self.layout(id);
        Int index! = 0;
        while (index < owner_layout.fields.length) {
            if (owner_layout.fields[index].field_def is .some(candidate)) {
                if (candidate.to_index() == field_def.to_index()) { return index; }
            }
            index = index + 1;
        }
        return null;
    }

    public layout.LayoutStore& store(self) {
        return self.layouts$.ref();
    }

    public layout.LayoutId? layout_id_for_type(self, qid.TypeId type_id) {
        return self.layouts.layout_id_for_type(type_id);
    }

    public qid.TypeId? trait_vtable_field_type(self, qid.DefId trait_def, Int offset) {
        return self.layouts.trait_vtable_field_type(trait_def, offset);
    }

    public layout.DropCategoryKind drop_category_of_type(
        Self&! self,
        store_api.CompilerStore& store,
        qid.TypeId type_id
    ) {
        return compute.drop_category_of_type(store, self.layouts$.mut_ref(), type_id);
    }

    public Void prepare_trait_vtable_field_types(
        Self&! self,
        store_api.CompilerStore& store,
        qid.TypeId type_id
    ) {
        compute.prepare_trait_vtable_field_types(store, self.layouts$.mut_ref(), type_id);
    }

}
