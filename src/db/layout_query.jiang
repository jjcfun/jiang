// TypeId -> LayoutId 的 typed query。

import qid = "../id.jiang";
import layout = "../layout.jiang";
import compute = "../layout/compute.jiang";
import store_api = "../store.jiang";
import query_cache = "./query_cache.jiang";
import std;

public struct LayoutQuery: Movable {
    Mutex<query_cache.QueryCache<Int, layout.LayoutId>>^ cache;

    public init(self) {
        self.cache = new Mutex<query_cache.QueryCache<Int, layout.LayoutId>>(
            query_cache.QueryCache<Int, layout.LayoutId>()
        );
    }

    public () reset(self) {
        self.cache.with_lock<Void>({ cache => cache.reset(); });
    }

    public layout.LayoutId evaluate(
        self,
        store_api.CompilerStore& store,
        qid.TypeId type_id
    ) {
        query_cache.QueryCacheState<layout.LayoutId> state = self.cache.with_lock({ cache =>
            cache.state(type_id.to_index())
        });
        if (state is .ready(value)) { return value; }
        assert(state is .missing);
        layout.LayoutId id = compute.layout_of_type(store, type_id);
        self.cache.with_lock<Void>({ cache =>
            cache.complete(type_id.to_index(), id);
        });
        return id;
    }

}
