// Shared compiler context for one compilation session.

import diagnostic = "./diagnostic/diagnostic.jiang";
import query = "./query/api.jiang";

public struct CompilerContext: Movable {
    public query.QuerySystem^ query;
    public diagnostic.DiagnosticBag diagnostics;

    public init() {
        self.query = new query.QuerySystem();
        self.diagnostics = diagnostic.DiagnosticBag();
    }

    public () begin_compilation() {
        self.diagnostics.clear();
        self.query.begin_compilation();
    }

}
