// CLI command dispatch for jiangc.

import context = "../context.jiang";
import diagnostic = "../diagnostic.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import diagnostic_source_map = "../diagnostic/source_map.jiang";
import backend = "../backend.jiang";
import pipeline = "../pipeline.jiang";
import driver_args = "./args.jiang";
import driver_options = "./options.jiang";
import process = "../system/process.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_io = "../system/io.jiang";
import token = "../syntax/token.jiang";
import std;

public Int run(process.ProgramArguments args) {
    UInt8[]& compiler_path = executable_path(args);
    UInt8[]& compiler_version = driver_options.compiler_version_for_executable(compiler_path);
    if (is_help_command(args)) {
        print_help();
        return 0;
    }
    if (is_version_command(args)) {
        print_version(compiler_version);
        return 0;
    }
    driver_args.ArgParseResult parsed = driver_args.parse(args, compiler_version);
    if (!parsed.ok) {
        return 1;
    }
    UInt8[]^ compiler_build = driver_options.compiler_build_for_executable(
        compiler_path,
        compiler_version
    );
    parsed.options.compiler_build = compiler_build[..];
    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.BuildContextResult context_result! =
        driver_options.build_context(parsed.options$.ref(), ctx$.mut_ref());
    if (!context_result.ok) {
        context.CompilerContext error_ctx! = context.CompilerContext();
        add_driver_error(error_ctx$.ref(), context_result.message.bytes(), context_result.code);
        print_diagnostics(error_ctx$.ref());
        return 1;
    }
    pipeline.compile(ctx$.ref(), parsed.options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

@life()
UInt8[]& executable_path(process.ProgramArguments args) {
    if (args.length == 0) {
        return "";
    }
    return argument_text(args, 0);
}

Bool is_help_command(process.ProgramArguments args) {
    if (args.length != 2) { return false; }
    return string.equal(argument_text(args, 1), "--help");
}

Bool is_version_command(process.ProgramArguments args) {
    if (args.length != 2) { return false; }
    return string.equal(argument_text(args, 1), "--version");
}

@life()
UInt8[]& argument_text(process.ProgramArguments args, Int index) {
    return args.argument(index)[..];
}

() print_help() {
    print_usage_line();
    print_line("commands:");
    print_line("  --check file");
    print_line("  --emit-llvm [-o out] file");
    print_line("  --emit-obj [-o out] file");
    print_line("  [-o out] file");
}

() print_usage_line() {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("usage: jiangc [--mode debug|release] [--target triple] ");
    builder.append("[--artifact-cache-dir path] ");
    builder.append("[--link-libc|--no-link-libc] [--linker path] ");
    builder.append("[--jil-stats] [--artifact-stats] ");
    builder.append("[--link-arg arg] [command] file");
    std.String text = builder.into_string();
    print_line(text.bytes());
}

() print_version(UInt8[]& compiler_version) {
    std.StringBuilder version_builder = std.StringBuilder();
    version_builder.append("jiang ");
    version_builder.append(compiler_version);
    print_line(version_builder.slice());

    std.StringBuilder target_builder = std.StringBuilder();
    target_builder.append("target: ");
    target_builder.append(backend.default_target_triple_text());
    print_line(target_builder.slice());

    std.StringBuilder llvm_builder = std.StringBuilder();
    std.String llvm_version = backend.llvm_version_text();
    llvm_builder.append("LLVM: ");
    llvm_builder.append(llvm_version.bytes());
    print_line(llvm_builder.slice());
}

public Int compile_path(UInt8[]& input_path) {
    driver_options.CompileOptions options = driver_options.CompileOptions(.executable, input_path, "");
    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.BuildContextResult context_result! =
        driver_options.build_context(options$.ref(), ctx$.mut_ref());
    if (!context_result.ok) {
        context.CompilerContext error_ctx! = context.CompilerContext();
        add_driver_error(error_ctx$.ref(), context_result.message.bytes(), context_result.code);
        print_diagnostics(error_ctx$.ref());
        return 1;
    }
    pipeline.compile(ctx$.ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

() add_driver_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    diagnostic_helper.add_package_error(ctx, message, code);
}

() print_diagnostics(context.CompilerContext& ctx) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        print_diagnostic(ctx, ctx.store.diagnostics.get(index));
        index = index + 1;
    }
}

() print_diagnostic(context.CompilerContext& ctx, diagnostic.Diagnostic& diag) {
    if (diag.range.source_id is .some(source_id)) {
        UInt8[]& source_name = ctx.store.sources.get(source_id).key.value;
        if (source_name.length > 0) {
            UInt8[]^ location = diagnostic_location(source_name, diag.range.span);
            print_error_line(location[..]);
        }
    }
    if (diag.code.text.length > 0) {
        print_error_line(diag.code.text);
    }
    UInt8[]& message = diag.message.bytes();
    if (message.length > 0) {
        print_error_line(message);
    }
    Int related_index! = 0;
    while (related_index < diag.related.len()) {
        diagnostic.DiagnosticRelatedInformation& related = diag.related.ref_at(related_index);
        print_related_diagnostic(ctx, related);
        related_index = related_index + 1;
    }
}

() print_related_diagnostic(context.CompilerContext& ctx, diagnostic.DiagnosticRelatedInformation& related) {
    if (related.range.source_id is .some(source_id)) {
        UInt8[]& source_name = ctx.store.sources.get(source_id).key.value;
        if (source_name.length > 0) {
            UInt8[]^ location = diagnostic_location(source_name, related.range.span);
            print_error_line(location[..]);
        }
    }
    UInt8[]& message = related.message.bytes();
    if (message.length > 0) {
        std.StringBuilder builder = std.StringBuilder();
        builder.append("note: ");
        builder.append(message);
        print_error_line(builder.slice());
    }
}

UInt8[]^ diagnostic_location(UInt8[]& source_name, token.Span span) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(source_name);
    builder.append(":");
    guard system_fs.read_all(source_name) is .some(text) else {
        builder.append(Int(span.start));
        return builder.into_slice();
    }
    diagnostic.SourcePosition position = diagnostic_source_map.position_at(
        text,
        span.start,
        .utf8
    );
    builder.append(position.line + 1);
    builder.append(":");
    builder.append(position.character + 1);
    return builder.into_slice();
}

() print_line(UInt8[]& text) {
    system_fs.File out = system_io.stdout();
    out.write_all(text);
    out.write_all(newline_bytes());
}

() print_error_line(UInt8[]& text) {
    system_fs.File err = system_io.stderr();
    err.write_all(text);
    err.write_all(newline_bytes());
}

@life()
UInt8[]& newline_bytes() {
    return "\n";
}
