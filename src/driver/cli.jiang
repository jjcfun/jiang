// CLI command dispatch for jiangc.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import diagnostic_source_map = "../diagnostic/source_map.jiang";
import backend = "../backend/api.jiang";
import pipeline = "../pipeline.jiang";
import driver_args = "./args.jiang";
import driver_options = "./options.jiang";
import driver_target = "./target.jiang";
import process = "../system/process.jiang";
import system_target = "../system/target.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_io = "../system/io.jiang";
import token = "../syntax/token.jiang";

public Int run(process.ProgramArguments args) {
    if (is_help_command(args)) {
        print_help();
        return 0;
    }
    if (is_version_command(args)) {
        print_version();
        return 0;
    }
    driver_args.ArgParseResult parsed = driver_args.parse(args);
    if (!parsed.ok) {
        return 1;
    }
    driver_target.TargetParseResult target_result = driver_target.parse(parsed.options.target_triple);
    if (!target_result.ok) {
        context.CompilerContext! error_ctx = context.CompilerContext();
        add_driver_error(error_ctx$.ref(), target_result.message, target_result.code);
        print_diagnostics(error_ctx$.ref());
        return 1;
    }
    system_target.TargetInfo target_info = system_target.with_link_libc_request(
        target_result.info$.ref(),
        parsed.options.link_libc
    );
    context.CompilerContext! ctx = context.CompilerContext(target_info$.move());
    pipeline.compile(ctx$.ref(), parsed.options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

Bool is_help_command(process.ProgramArguments args) {
    if (args.length != 2) { return false; }
    return string.equal(argument_text(args, 1), "--help");
}

Bool is_version_command(process.ProgramArguments args) {
    if (args.length != 2) { return false; }
    return string.equal(argument_text(args, 1), "--version");
}

UInt8[]& argument_text(process.ProgramArguments args, Int index) {
    return args.argument(index)[..];
}

() print_help() {
    print_line("usage: jiangc [--mode debug|release] [--target triple] [--link-libc|--no-link-libc] [--linker path] [--link-arg arg] [command] file");
    print_line("commands:");
    print_line("  --check file");
    print_line("  --emit-llvm [-o out] file");
    print_line("  --emit-obj [-o out] file");
    print_line("  [-o out] file");
}

() print_version() {
    print_line(string.append("jiang ", driver_options.default_compiler_version()));
    print_line(string.append("target: ", backend.default_target_triple_text()));
    print_line(string.append("LLVM: ", backend.llvm_version_text()));
}

public Int compile_path(UInt8[]& input_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(.executable, input_path, "");
    pipeline.compile(ctx$.ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

() add_driver_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

() print_diagnostics(context.CompilerContext& ctx) {
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        print_diagnostic(ctx, ctx.store.diagnostics.get(index));
        index = index + 1;
    }
}

() print_diagnostic(context.CompilerContext& ctx, diagnostic.Diagnostic& diag) {
    if (diag.range.source_id is some source_id) {
        UInt8[]& source_name = ctx.store.sources.get(source_id).key.value;
    if (source_name.length > 0) {
        print_error_line(diagnostic_location(source_name, diag.range.span));
    }
    }
    if (diag.code.text.length > 0) {
        print_error_line(diag.code.text);
    }
    if (diag.message.length > 0) {
        print_error_line(diag.message);
    }
}

UInt8[]& diagnostic_location(UInt8[]& source_name, token.Span span) {
    guard system_fs.read_all(source_name) is some text else {
        return string.append(string.append(source_name, ":"), string.int_text(span.start));
    }
    diagnostic.SourcePosition position = diagnostic_source_map.position_at(
        text,
        span.start,
        .utf8
    );
    UInt8[]&! location = string.append(source_name, ":");
    location = string.append(location, string.int_text(position.line + 1));
    location = string.append(location, ":");
    return string.append(location, string.int_text(position.character + 1));
}

() print_line(UInt8[]& text) {
    system_fs.File out = system_io.stdout();
    out.write_all(text);
    out.write_all(newline_bytes());
}

() print_error_line(UInt8[]& text) {
    system_fs.File err = system_io.stderr();
    err.write_all(text);
    err.write_all(newline_bytes());
}

UInt8[]& newline_bytes() {
    // TODO: 当前源码仍需由 jiangc 0.2 bootstrap 编译，不能直接使用 0.3
    // 的 `const` 语法。等 stage0 升级到支持 `const` 的固定版本后，改成
    // 模块级 `const UInt8 newline = 10;`。
    UInt8![*] newline = UInt8!$.alloc_array(1);
    newline[0] = UInt8(10);
    UInt8[*] bytes = newline$.as(UInt8[*]);
    return bytes[0..1];
}
