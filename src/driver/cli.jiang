// CLI command dispatch for jiangc.

import context = "../context.jiang";
import pipeline = "../pipeline.jiang";
import args = "./args.jiang";
import fs = "../support/fs.jiang";

extern {
    Int32 puts(UInt8[*] text);
}

public Int run(Int argc, UInt8[*][*] argv) {
    args.ArgParseResult parsed = args.parse(argc, argv);
    if (!parsed.ok) {
        return 1;
    }
    context.CompilerContext! ctx = context.CompilerContext();
    pipeline.compile_with_options(ctx$.ref(), parsed.options);
    if (ctx.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

public Int compile_path(UInt8[] input_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    pipeline.compile_package_path(ctx$.ref(), input_path);
    if (ctx.diagnostics.has_errors()) {
        print_diagnostics(ctx$.ref());
        return 1;
    }
    return 0;
}

() print_diagnostics(context.CompilerContext& ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        UInt8[] code = ctx.diagnostics.get(index).code.text;
        if (code.length > 0) {
            print_line(code);
        }
        if (ctx.diagnostics.get(index).message.length > 0) {
            print_line(ctx.diagnostics.get(index).message);
        }
        index = index + 1;
    }
}

() print_line(UInt8[] text) {
    UInt8![*] c_text = fs.c_string(text);
    puts(c_text$.as(UInt8[*]));
}
