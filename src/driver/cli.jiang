// CLI command dispatch for jiangc.

import session = "../session.jiang";
import args = "./args.jiang";

public Int run() {
    args.ArgParseResult parsed = args.parse_empty();
    if (!parsed.ok) {
        return 1;
    }
    return 0;
}

public Int compile_path(UInt8[] input_path) {
    session.CompilerSession compiler = session.CompilerSession();
    compiler.compile_package_path(input_path);
    if (compiler.has_errors()) {
        return 1;
    }
    return 0;
}
