// CLI command dispatch for jiangc.

import context = "../context.jiang";
import pipeline = "../pipeline.jiang";
import args = "./args.jiang";

public Int run(Int argc, UInt8[*][*] argv) {
    args.ArgParseResult parsed = args.parse(argc, argv);
    if (!parsed.ok) {
        return 1;
    }
    context.CompilerContext! ctx = context.CompilerContext();
    pipeline.compile_with_options(ctx$.ref(), parsed.options);
    if (ctx.diagnostics.has_errors()) {
        return 1;
    }
    return 0;
}

public Int compile_path(UInt8[] input_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    pipeline.compile_package_path(ctx$.ref(), input_path);
    if (ctx.diagnostics.has_errors()) {
        return 1;
    }
    return 0;
}
