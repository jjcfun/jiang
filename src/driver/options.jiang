// User-facing compiler options after argument parsing.

import context = "../context.jiang";
import list = "../support/list.jiang";
import package_manifest = "../source/package_manifest.jiang";
import env = "../system/env.jiang";
import path = "../support/path.jiang";
import system_target = "../system/target.jiang";
import target = "./target.jiang";

public enum EmitKind {
    check_only,
    llvm_ir,
    object_file,
    dynamic_library,
    executable,
}

public enum CompileMode {
    debug,
    release,
}

public UInt8[]& default_linker_path() {
    // 和 Rust 默认模型一致：编译器只调用 linker driver 名称，
    // 具体 clang/SDK/系统 linker 解析交给 PATH 或平台工具链 shim。
    return "cc";
}

public UInt8[]& compiler_version_fallback() {
    return "dev";
}

public UInt8[]& compiler_version_for_executable(UInt8[]& executable_path) {
    if (resolved_executable_path(executable_path) is .some(resolved)) {
        UInt8[]& bin_dir = path.dirname(resolved);
        if (package_version_in_dir(bin_dir) is .some(version)) {
            return version;
        }

        UInt8[]& package_dir = path.dirname(bin_dir);
        if (package_version_in_dir(package_dir) is .some(version)) {
            return version;
        }
    }

    if (package_version_in_dir(".") is .some(version)) {
        return version;
    }
    return compiler_version_fallback();
}

UInt8[]&? resolved_executable_path(UInt8[]& executable_path) {
    if (executable_path.length == 0) {
        return null;
    }
    if (env.find_executable(executable_path) is .some(resolved)) {
        return resolved;
    }
    return executable_path;
}

UInt8[]&? package_version_in_dir(UInt8[]& dir) {
    if (dir.length == 0) {
        return null;
    }
    package_manifest.PackageManifest manifest = package_manifest.read(dir);
    if (!manifest.ok || manifest.version.length == 0) {
        return null;
    }
    return manifest.version;
}

public Int backend_codegen_opt_level(CompileMode mode) {
    if (mode == .release) {
        return 2;
    }
    return 0;
}

public UInt8[]& backend_pass_pipeline(CompileMode mode) {
    if (mode == .release) {
        return "default<O2>";
    }
    return "";
}

public UInt8[]& backend_profile(CompileMode mode) {
    if (mode == .release) {
        return "mode=release;codegen=2;passes=default<O2>";
    }
    return "mode=debug;codegen=0;passes=";
}

public struct CompileOptions: Movable {
    public EmitKind! emit;
    public UInt8[]&! input_path;
    public UInt8[]&! output_path;
    public UInt8[]&! artifact_cache_dir;
    public UInt8[]&! target_triple;
    public UInt8[]&! compiler_version;
    public UInt8[]&! linker_path;
    public list.ArrayList<UInt8[]&> link_args;
    public Bool! link_libc;
    public CompileMode! mode;

    public init(self) {
        self.emit = .check_only;
        self.input_path = "";
        self.output_path = "";
        self.artifact_cache_dir = "build/cache";
        self.target_triple = "default-target";
        self.compiler_version = compiler_version_fallback();
        self.linker_path = default_linker_path();
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = .debug;
    }

    public init(self, EmitKind emit, UInt8[]& input_path, UInt8[]& output_path) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = "build/cache";
        self.target_triple = "default-target";
        self.compiler_version = compiler_version_fallback();
        self.linker_path = default_linker_path();
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = .debug;
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = "default-target";
        self.compiler_version = compiler_version_fallback();
        self.linker_path = default_linker_path();
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = .debug;
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = default_linker_path();
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = .debug;
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version,
        CompileMode mode
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = default_linker_path();
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = mode;
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version,
        UInt8[]& linker_path,
        CompileMode mode
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = linker_path;
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.mode = mode;
    }

    public () add_link_arg(self, UInt8[]& arg) {
        self.link_args.add(arg);
    }
}

public struct BuildContextResult: Movable {
    public Bool ok;
    public UInt8[]&! message;
    public UInt8[]&! code;

    public init(self) {
        self.ok = true;
        self.message = "";
        self.code = "";
    }

    public init(self, UInt8[]& message, UInt8[]& code) {
        self.ok = false;
        self.message = message;
        self.code = code;
    }
}

public BuildContextResult build_context(CompileOptions& options, context.CompilerContext!& ctx) {
    target.TargetParseResult! target_result = target.parse(options.target_triple);
    if (!target_result.ok) {
        return BuildContextResult(target_result.message, target_result.code);
    }
    system_target.TargetInfo target_info = system_target.with_link_libc_request(
        target_result.info$.ref(),
        options.link_libc
    );
    ctx.target = target_info$.move();
    return BuildContextResult();
}
