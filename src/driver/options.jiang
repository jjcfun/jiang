// User-facing compiler options after argument parsing.

public enum EmitKind {
    check_only,
    llvm_ir,
    object_file,
    executable,
}

public enum CompileMode {
    debug,
    release,
}

public UInt8[] default_linker_path() {
    // 和 Rust 默认模型一致：编译器只调用 linker driver 名称，
    // 具体 clang/SDK/系统 linker 解析交给 PATH 或平台工具链 shim。
    return "cc";
}

public UInt8[] default_compiler_version() {
    return "jiang-dev";
}

public struct CompileOptions {
    public EmitKind emit;
    public UInt8[] input_path;
    public UInt8[] output_path;
    public UInt8[] artifact_cache_dir;
    public UInt8[] target_triple;
    public UInt8[] compiler_version;
    public UInt8[] linker_path;
    public CompileMode mode;

    public init() {
        self.emit = .check_only;
        self.input_path = "";
        self.output_path = "";
        self.artifact_cache_dir = "build/cache";
        self.target_triple = "default-target";
        self.compiler_version = default_compiler_version();
        self.linker_path = default_linker_path();
        self.mode = .debug;
    }

    public init(EmitKind emit, UInt8[] input_path, UInt8[] output_path) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = "build/cache";
        self.target_triple = "default-target";
        self.compiler_version = default_compiler_version();
        self.linker_path = default_linker_path();
        self.mode = .debug;
    }

    public init(
        EmitKind emit,
        UInt8[] input_path,
        UInt8[] output_path,
        UInt8[] artifact_cache_dir
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = "default-target";
        self.compiler_version = default_compiler_version();
        self.linker_path = default_linker_path();
        self.mode = .debug;
    }

    public init(
        EmitKind emit,
        UInt8[] input_path,
        UInt8[] output_path,
        UInt8[] artifact_cache_dir,
        UInt8[] target_triple,
        UInt8[] compiler_version
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = default_linker_path();
        self.mode = .debug;
    }

    public init(
        EmitKind emit,
        UInt8[] input_path,
        UInt8[] output_path,
        UInt8[] artifact_cache_dir,
        UInt8[] target_triple,
        UInt8[] compiler_version,
        CompileMode mode
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = default_linker_path();
        self.mode = mode;
    }

    public init(
        EmitKind emit,
        UInt8[] input_path,
        UInt8[] output_path,
        UInt8[] artifact_cache_dir,
        UInt8[] target_triple,
        UInt8[] compiler_version,
        UInt8[] linker_path,
        CompileMode mode
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.linker_path = linker_path;
        self.mode = mode;
    }
}
