// User-facing compiler options after argument parsing.

import context = "../context.jiang";
import enforcement = "../enforcement.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import package_manifest = "../source/package_manifest.jiang";
import env = "../system/env.jiang";
import cpu = "../system/cpu.jiang";
import system_target = "../system/target.jiang";
import target = "./target.jiang";
import system_fs = "../system/fs.jiang";
import std;

public enum EmitKind {
    clean_artifact_cache,
    check_only,
    llvm_ir,
    object_file,
    dynamic_library,
    executable,
}

public enum CompileMode {
    debug,
    release,
}

@life()
public UInt8[]& default_linker_path() {
    // 和 Rust 默认模型一致：编译器只调用 linker driver 名称，
    // 具体 clang/SDK/系统 linker 解析交给 PATH 或平台工具链 shim。
    return "cc";
}

@life()
public UInt8[]& compiler_version_fallback() {
    return "dev";
}

public UInt8[]& compiler_version_for_executable(UInt8[]& executable_path) {
    if (resolved_executable_path(executable_path) is .some(resolved)) {
        UInt8[]& resolved_text = resolved[..];
        UInt8[]& bin_dir = std.path.dirname(resolved_text);
        if (package_version_in_dir(bin_dir) is .some(version)) {
            return version;
        }

        UInt8[]& package_dir = std.path.dirname(bin_dir);
        if (package_version_in_dir(package_dir) is .some(version)) {
            return version;
        }
    }

    if (package_version_in_dir(".") is .some(version)) {
        return version;
    }
    return compiler_version_fallback();
}

public UInt8[]^ compiler_build_for_executable(
    UInt8[]& executable_path,
    UInt8[]& compiler_version
) {
    guard resolved_executable_path(executable_path) is .some(resolved) else {
        return copy_slice(compiler_version);
    }
    std.StringBuilder path! = std.StringBuilder();
    path.append(resolved[..]);
    path.append(".build-id");
    guard system_fs.read_all(path.slice()) is .some(build_id) else {
        return copy_slice(compiler_version);
    }
    if (build_id.length == 0) {
        return copy_slice(compiler_version);
    }
    return copy_slice(build_id);
}

UInt8[]^? resolved_executable_path(UInt8[]& executable_path) {
    if (executable_path.length == 0) {
        return null;
    }
    if (env.find_executable(executable_path) is .some(resolved)) {
        return resolved;
    }
    return copy_slice(executable_path);
}

UInt8[]&? package_version_in_dir(UInt8[]& dir) {
    if (dir.length == 0) {
        return null;
    }
    package_manifest.PackageManifest manifest = package_manifest.read(dir);
    if (!manifest.ok || manifest.version.length == 0) {
        return null;
    }
    return manifest.version;
}

public Int backend_codegen_opt_level(CompileMode mode) {
    if (mode == .release) {
        return 2;
    }
    return 0;
}

@life()
public UInt8[]& backend_pass_pipeline(CompileMode mode) {
    if (mode == .release) {
        return "default<O2>";
    }
    return "";
}

@life()
public UInt8[]& backend_profile(CompileMode mode) {
    if (mode == .release) {
        return "mode=release;codegen=2;passes=default<O2>";
    }
    return "mode=debug;codegen=0;passes=";
}

@region(a)
public struct CompileOptions: Movable {
    public EmitKind emit!;

    @life(a)
    public UInt8[]& input_path!;

    @life(a)
    public UInt8[]& output_path!;

    @life(a)
    public UInt8[]& artifact_cache_dir!;

    @life(a)
    public UInt8[]& target_triple!;

    @life(a)
    public UInt8[]& compiler_version!;

    @life(a)
    public UInt8[]& compiler_build!;

    @life(a)
    public UInt8[]& linker_path!;

    @life(a)
    public list.ArrayList<UInt8[]&> link_args!;
    public Bool link_libc!;
    public Bool jil_stats!;
    public Bool verify_jil!;
    public Bool artifact_stats! = false;
    public UInt32 jobs!;
    public CompileMode mode!;
    public enforcement.Mode enforcement_mode!;

    public UInt32 worker_count(self) {
        if (self.jobs > UInt32(0)) { return self.jobs; }
        return cpu.available_count();
    }

    public init(self) {
        self = CompileOptions(
            .check_only,
            "",
            "",
            "build/cache",
            "default-target",
            compiler_version_fallback(),
            default_linker_path(),
            .debug,
            UInt32(0)
        );
    }

    public init(self, EmitKind emit, UInt8[]& input_path, UInt8[]& output_path) {
        self = CompileOptions(
            emit,
            input_path,
            output_path,
            "build/cache",
            "default-target",
            compiler_version_fallback(),
            default_linker_path(),
            .debug,
            UInt32(0)
        );
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir
    ) {
        self = CompileOptions(
            emit,
            input_path,
            output_path,
            artifact_cache_dir,
            "default-target",
            compiler_version_fallback(),
            default_linker_path(),
            .debug,
            UInt32(0)
        );
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version
    ) {
        self = CompileOptions(
            emit,
            input_path,
            output_path,
            artifact_cache_dir,
            target_triple,
            compiler_version,
            default_linker_path(),
            .debug,
            UInt32(0)
        );
    }

    public init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version,
        CompileMode mode
    ) {
        self = CompileOptions(
            emit,
            input_path,
            output_path,
            artifact_cache_dir,
            target_triple,
            compiler_version,
            default_linker_path(),
            mode,
            UInt32(0)
        );
    }

    init(self,
        EmitKind emit,
        UInt8[]& input_path,
        UInt8[]& output_path,
        UInt8[]& artifact_cache_dir,
        UInt8[]& target_triple,
        UInt8[]& compiler_version,
        UInt8[]& linker_path,
        CompileMode mode,
        UInt32 jobs
    ) {
        self.emit = emit;
        self.input_path = input_path;
        self.output_path = output_path;
        self.artifact_cache_dir = artifact_cache_dir;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.compiler_build = compiler_version;
        self.linker_path = linker_path;
        self.link_args = list.ArrayList<UInt8[]&>();
        self.link_libc = true;
        self.jil_stats = false;
        self.verify_jil = false;
        self.artifact_stats = false;
        self.jobs = jobs;
        self.mode = mode;
        self.enforcement_mode = .strict;
    }

    public Void add_link_arg(Self&! self, UInt8[]& arg) {
        self.link_args.add(arg);
    }
}

@region(a)
public struct BuildContextResult: Movable {
    public Bool ok;
    public String message;
    @life(a)
    public UInt8[]& code!;

    public init(self) {
        self.ok = true;
        self.message = "";
        self.code = "";
    }

    public init(self, UInt8[]& message, UInt8[]& code) {
        self.ok = false;
        self.message = String(message);
        self.code = code;
    }

    public init(self, String message, UInt8[]& code) {
        self.ok = false;
        self.message = message;
        self.code = code;
    }
}

@life(return: options)
public BuildContextResult build_context(CompileOptions& options, context.CompilerContext&! ctx) {
    if (!valid_enforcement_request(options)) {
        return BuildContextResult(
            "bootstrap audit only supports debug compiler or compiler-test output",
            "bootstrap_audit_scope_invalid"
        );
    }
    target.TargetParseResult target_result! = target.parse(options.target_triple);
    if (!target_result.ok) {
        return BuildContextResult(target_result.message.bytes(), target_result.code);
    }
    system_target.TargetInfo target_info! = system_target.with_link_libc_request(
        target_result.info$.ref(),
        options.link_libc
    );
    ctx.target = target_info;
    return BuildContextResult();
}

Bool valid_enforcement_request(CompileOptions& options) {
    if (!enforcement.is_bootstrap_audit(options.enforcement_mode)) { return true; }
    if (options.mode != .debug) { return false; }
    Bool compiler = audit_input_matches(options.input_path, "src/jiangc.jiang");
    Bool compiler_test = audit_input_matches(options.input_path, "test/compiler/database.jiang");
    Bool syntax_test = audit_input_matches(options.input_path, "test/compiler/syntax.jiang");
    Bool resolve_test = audit_input_matches(options.input_path, "test/compiler/resolve.jiang");
    if (!compiler && !compiler_test && !syntax_test && !resolve_test) { return false; }
    return options.emit == .executable || options.emit == .llvm_ir;
}

Bool audit_input_matches(UInt8[]& input_path, UInt8[]& relative_path) {
    if (string.equal(input_path, relative_path)) { return true; }
    if (input_path.length <= relative_path.length) { return false; }
    Int offset = input_path.length - relative_path.length;
    if (input_path[offset - 1] != UInt8(47)) { return false; }
    return string.equal(input_path[offset..], relative_path);
}

UInt8[]^ copy_slice(UInt8[]& text) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(text);
    return builder.into_slice();
}
