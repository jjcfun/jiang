// Target triple parsing used by the CLI driver.
//
// Target taxonomy and TargetInfo live in system/target.jiang so compiler
// internals do not depend on driver-specific parsing.

import target = "../system/target.jiang";
import env = "../system/env.jiang";
import string = "../support/string.jiang";
import std;

public UInt8[]& default_macos_deployment_target() {
    return "11.0.0";
}

public struct TargetParseResult: Movable {
    public Bool ok;
    public target.TargetInfo info;
    public String message;
    public UInt8[]& code!;

    public init(self, target.TargetInfo info) {
        self.ok = true;
        self.info = info$.move();
        self.message = "";
        self.code = "";
    }

    public init(self, UInt8[]& message, UInt8[]& code) {
        self.ok = false;
        self.info = target.TargetInfo();
        self.message = String(message);
        self.code = code;
    }

    public init(self, String message, UInt8[]& code) {
        self.ok = false;
        self.info = target.TargetInfo();
        self.message = message$.move();
        self.code = code;
    }
}

public TargetParseResult parse(UInt8[]& target_triple) {
    if (is_default_triple(target_triple)) {
        return parse_default_target();
    }
    if (string.equal(target_triple, "arm64-apple-macosx")) {
        return TargetParseResult(macos_arm64(target_triple));
    }
    if (string.equal(target_triple, "aarch64-apple-darwin")) {
        return TargetParseResult(macos_arm64(target_triple));
    }
    if (string.equal(target_triple, "x86_64-unknown-linux-gnu")) {
        return TargetParseResult(target.TargetInfo (
            requested_triple: String(target_triple),
            llvm_triple: String(target_triple),
            arch: .x86_64,
            os: .linux,
            abi: .gnu,
            object_format: .elf,
            provider: .linux_hosted,
            is_default: false
        ));
    }
    if (string.equal(target_triple, "aarch64-unknown-linux-gnu")) {
        return TargetParseResult(target.TargetInfo (
            requested_triple: String(target_triple),
            llvm_triple: String(target_triple),
            arch: .arm64,
            os: .linux,
            abi: .gnu,
            object_format: .elf,
            provider: .linux_hosted,
            is_default: false
        ));
    }
    if (string.equal(target_triple, "x86_64-pc-windows-msvc")) {
        return TargetParseResult(target.TargetInfo (
            requested_triple: String(target_triple),
            llvm_triple: String(target_triple),
            arch: .x86_64,
            os: .windows,
            abi: .msvc,
            object_format: .coff,
            provider: .windows_hosted,
            is_default: false
        ));
    }
    if (string.equal(target_triple, "aarch64-pc-windows-msvc")) {
        return TargetParseResult(target.TargetInfo (
            requested_triple: String(target_triple),
            llvm_triple: String(target_triple),
            arch: .arm64,
            os: .windows,
            abi: .msvc,
            object_format: .coff,
            provider: .windows_hosted,
            is_default: false
        ));
    }
    if (string.equal(target_triple, "wasm32-unknown-unknown")) {
        return TargetParseResult(target.TargetInfo (
            requested_triple: String(target_triple),
            llvm_triple: String(target_triple),
            arch: .wasm32,
            os: .wasm,
            abi: .none,
            object_format: .wasm,
            provider: .wasm,
            link_libc: false,
            is_default: false
        ));
    }
    if (string.equal(target_triple, "wasm32-wasi")) {
        return TargetParseResult(wasm32_wasi(target_triple));
    }
    if (string.equal(target_triple, "wasm32-wasip1")) {
        return TargetParseResult(wasm32_wasi(target_triple));
    }
    String message = build_text("unsupported target triple: ", target_triple);
    return TargetParseResult(message.bytes(), "unsupported_target_triple");
}

TargetParseResult parse_default_target() {
    guard env.get("JIANG_HOST_TARGET") is .some(host_target) else {
        return TargetParseResult(target.TargetInfo());
    }
    UInt8[]& host_target_text = host_target[..];
    if (is_default_triple(host_target_text)) {
        return TargetParseResult(target.TargetInfo());
    }
    return parse(host_target_text);
}

target.TargetInfo wasm32_wasi(UInt8[]& target_triple) {
    return target.TargetInfo (
        requested_triple: String(target_triple),
        llvm_triple: String("wasm32-wasip1"),
        arch: .wasm32,
        os: .wasm,
        abi: .wasi,
        object_format: .wasm,
        provider: .wasi,
        link_libc: true,
        is_default: false
    );
}

target.TargetInfo macos_arm64(UInt8[]& target_triple) {
    return target.TargetInfo (
        requested_triple: String(target_triple),
        llvm_triple: build_text("arm64-apple-macosx", default_macos_deployment_target()),
        arch: .arm64,
        os: .macos,
        abi: .darwin,
        object_format: .macho,
        provider: .macos_hosted,
        sysroot_strategy: .macos_sdkroot,
        is_default: false
    );
}

public Bool is_default_triple(UInt8[]& target_triple) {
    return target_triple.length == 0 || string.equal(target_triple, "default-target");
}

String build_text(UInt8[]& first, UInt8[]& second) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(first);
    builder.append(second);
    return builder$.move().into_string();
}
