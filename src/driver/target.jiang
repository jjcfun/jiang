// Target triple classification used by the driver/pipeline boundary.
//
// 这里只描述当前编译流程真正用到的 target 属性。macOS 显式 target 会规范化到
// 带 deployment target 的 LLVM triple，避免 Mach-O object 缺少平台版本信息。
// 完整 sysroot/linker/runtime 规则后续继续扩展。

import options = "./options.jiang";
import string = "../support/string.jiang";

public UInt8[]& default_macos_deployment_target() {
    return "11.0.0";
}

public enum TargetArch {
    host,
    arm64,
    x86_64,
}

public enum TargetOs {
    host,
    macos,
    linux,
}

public enum TargetAbi {
    host,
    darwin,
    gnu,
}

public enum ObjectFormat {
    host,
    macho,
    elf,
}

public enum ProviderKind {
    host,
    macos_hosted,
    linux_hosted,
}

public struct TargetInfo: Movable {
    public UInt8[]&! requested_triple;
    public UInt8[]&! llvm_triple;
    public TargetArch! arch;
    public TargetOs! os;
    public TargetAbi! abi;
    public ObjectFormat! object_format;
    public ProviderKind! provider;
    public Bool! is_default;

    public init() {
        self.requested_triple = "default-target";
        self.llvm_triple = "default-target";
        self.arch = .host;
        self.os = .host;
        self.abi = .host;
        self.object_format = .host;
        self.provider = .host;
        self.is_default = true;
    }

    public init(
        UInt8[]& requested_triple,
        UInt8[]& llvm_triple,
        TargetArch arch,
        TargetOs os,
        TargetAbi abi,
        ObjectFormat object_format,
        ProviderKind provider,
        Bool is_default
    ) {
        self.requested_triple = requested_triple;
        self.llvm_triple = llvm_triple;
        self.arch = arch;
        self.os = os;
        self.abi = abi;
        self.object_format = object_format;
        self.provider = provider;
        self.is_default = is_default;
    }
}

public struct TargetParseResult: Movable {
    public Bool ok;
    public TargetInfo info;
    public UInt8[]&! message;
    public UInt8[]&! code;

    public init(TargetInfo info) {
        self.ok = true;
        self.info = info$.move();
        self.message = "";
        self.code = "";
    }

    public init(UInt8[]& message, UInt8[]& code) {
        self.ok = false;
        self.info = TargetInfo();
        self.message = message;
        self.code = code;
    }
}

public TargetParseResult parse(UInt8[]& target_triple) {
    if (is_default_triple(target_triple)) {
        return TargetParseResult(TargetInfo());
    }
    if (string.equal(target_triple, "arm64-apple-macosx")) {
        return TargetParseResult(macos_arm64(target_triple));
    }
    if (string.equal(target_triple, "aarch64-apple-darwin")) {
        return TargetParseResult(macos_arm64(target_triple));
    }
    if (string.equal(target_triple, "x86_64-unknown-linux-gnu")) {
        return TargetParseResult(TargetInfo(
            target_triple,
            target_triple,
            .x86_64,
            .linux,
            .gnu,
            .elf,
            .linux_hosted,
            false
        ));
    }
    if (string.equal(target_triple, "aarch64-unknown-linux-gnu")) {
        return TargetParseResult(TargetInfo(
            target_triple,
            target_triple,
            .arm64,
            .linux,
            .gnu,
            .elf,
            .linux_hosted,
            false
        ));
    }
    return TargetParseResult(
        string.append("unsupported target triple: ", target_triple),
        "unsupported_target_triple"
    );
}

public Bool supports_output(TargetInfo& target, options.EmitKind emit) {
    if (emit != .executable) {
        return true;
    }
    return target.is_default || target.os == .macos;
}

public UInt8[]& unsupported_output_message(TargetInfo& target, options.EmitKind emit) {
    if (emit == .executable) {
        return string.append("executable output is not supported for target yet: ", target.requested_triple);
    }
    return string.append("output is not supported for target: ", target.requested_triple);
}

public UInt8[]& unsupported_output_code(options.EmitKind emit) {
    if (emit == .executable) {
        return "target_executable_unsupported";
    }
    return "target_output_unsupported";
}

public UInt8[]& cache_key(TargetInfo& target, Bool link_libc) {
    UInt8[]&! key = string.append("triple=", target.llvm_triple);
    key = string.append(key, ";provider=");
    key = string.append(key, provider_name(target.provider));
    key = string.append(key, ";object=");
    key = string.append(key, object_format_name(target.object_format));
    if (link_libc) {
        return string.append(key, ";link_libc=true");
    }
    return string.append(key, ";link_libc=false");
}

public Bool is_default_triple(UInt8[]& target_triple) {
    return target_triple.length == 0 || string.equal(target_triple, "default-target");
}

TargetInfo macos_arm64(UInt8[]& target_triple) {
    return TargetInfo(
        target_triple,
        string.append("arm64-apple-macosx", default_macos_deployment_target()),
        .arm64,
        .macos,
        .darwin,
        .macho,
        .macos_hosted,
        false
    );
}

UInt8[]& provider_name(ProviderKind provider) {
    if (provider == .host) { return "host"; }
    if (provider == .macos_hosted) { return "macos-hosted"; }
    if (provider == .linux_hosted) { return "linux-hosted"; }
    return "unknown";
}

UInt8[]& object_format_name(ObjectFormat format) {
    if (format == .host) { return "host"; }
    if (format == .macho) { return "macho"; }
    if (format == .elf) { return "elf"; }
    return "unknown";
}
