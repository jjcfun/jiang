// Raw command-line argument parsing helpers.

import options = "./options.jiang";

public struct ArgParseResult {
    public options.CompileOptions options;
    public Bool ok;

    public init(options.CompileOptions options, Bool ok) {
        self.options = options;
        self.ok = ok;
    }
}

public ArgParseResult parse_empty() {
    return ArgParseResult(options.CompileOptions(), true);
}

public ArgParseResult parse(Int argc, UInt8[*][*] argv) {
    return parse_global_options(argc, argv, 1, options.CompileMode.debug, options.default_linker_path());
}

ArgParseResult parse_global_options(
    Int argc,
    UInt8[*][*] argv,
    Int start,
    options.CompileMode mode,
    UInt8[] linker_path
) {
    if (start + 1 < argc && c_string_equal(argv[start], "--mode")) {
        guard compile_mode_arg(argv[start + 1]) is some parsed_mode else {
            return ArgParseResult(options.CompileOptions(), false);
        }
        return parse_global_options(argc, argv, start + 2, parsed_mode, linker_path);
    }
    if (start + 1 < argc && c_string_equal(argv[start], "--linker")) {
        return parse_global_options(argc, argv, start + 2, mode, c_string_slice(argv[start + 1]));
    }
    return parse_command(argc, argv, start, mode, linker_path);
}

ArgParseResult parse_command(
    Int argc,
    UInt8[*][*] argv,
    Int start,
    options.CompileMode mode,
    UInt8[] linker_path
) {
    Int remaining = argc - start;
    if (remaining == 1) {
        return input_options_with_config(argv[start], .executable, "", mode, linker_path);
    }
    if (remaining == 2) {
        if (c_string_equal(argv[start], "--check")) {
            return input_options_with_config(argv[start + 1], .check_only, "", mode, linker_path);
        }
        if (c_string_equal(argv[start], "--emit-obj")) {
            return input_options_with_config(argv[start + 1], .object_file, "/tmp/jiang-stage2-output.o", mode, linker_path);
        }
        if (c_string_equal(argv[start], "--emit-llvm")) {
            return input_options_with_config(argv[start + 1], .llvm_ir, "", mode, linker_path);
        }
    }
    if (remaining == 3) {
        if (c_string_equal(argv[start], "-o")) {
            return input_options_with_config(argv[start + 2], .executable, c_string_slice(argv[start + 1]), mode, linker_path);
        }
    }
    if (remaining == 4) {
        if (c_string_equal(argv[start], "--emit-obj") && c_string_equal(argv[start + 1], "-o")) {
            return input_options_with_config(argv[start + 3], .object_file, c_string_slice(argv[start + 2]), mode, linker_path);
        }
        if (c_string_equal(argv[start], "--emit-llvm") && c_string_equal(argv[start + 1], "-o")) {
            return input_options_with_config(argv[start + 3], .llvm_ir, c_string_slice(argv[start + 2]), mode, linker_path);
        }
    }
    return ArgParseResult(options.CompileOptions(), false);
}

ArgParseResult input_options(UInt8[*] input_path, options.EmitKind emit, UInt8[] output_path) {
    return ArgParseResult(options.CompileOptions(emit, c_string_slice(input_path), output_path), true);
}

ArgParseResult input_options_with_config(
    UInt8[*] input_path,
    options.EmitKind emit,
    UInt8[] output_path,
    options.CompileMode mode,
    UInt8[] linker_path
) {
    return ArgParseResult(options.CompileOptions(
        emit,
        c_string_slice(input_path),
        output_path,
        "build/cache",
        "default-target",
        "jiang-dev",
        linker_path,
        mode
    ), true);
}

options.CompileMode? compile_mode_arg(UInt8[*] value) {
    if (c_string_equal(value, "debug")) {
        return options.CompileMode.debug;
    }
    if (c_string_equal(value, "release")) {
        return options.CompileMode.release;
    }
    return null;
}

Bool c_string_equal(UInt8[*] left, UInt8[] right) {
    Int! index = 0;
    while (index < right.length) {
        if (left[index] == 0) {
            return false;
        }
        if (left[index] != right[index]) {
            return false;
        }
        index = index + 1;
    }
    return left[index] == 0;
}

UInt8[] c_string_slice(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return text[0..length];
}
