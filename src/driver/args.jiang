// Raw command-line argument parsing helpers.

import options = "./options.jiang";

public struct ArgParseResult: Movable {
    public options.CompileOptions options;
    public Bool ok;

    public init(options.CompileOptions options, Bool ok) {
        self.options = options$.move();
        self.ok = ok;
    }
}

public ArgParseResult parse_empty() {
    return ArgParseResult(options.CompileOptions(), true);
}

public ArgParseResult parse(Int argc, UInt8[*][*] argv) {
    options.CompileOptions! parsed_options = options.CompileOptions();
    Int! start = 1;
    while (start < argc) {
        if (start + 1 < argc && c_string_equal(argv[start], "--mode")) {
            guard compile_mode_arg(argv[start + 1]) is some parsed_mode else {
                return ArgParseResult(options.CompileOptions(), false);
            }
            parsed_options.mode = parsed_mode;
            start = start + 2;
        } else if (start + 1 < argc && c_string_equal(argv[start], "--linker")) {
            parsed_options.linker_path = c_string_slice(argv[start + 1]);
            start = start + 2;
        } else if (start + 1 < argc && c_string_equal(argv[start], "--link-arg")) {
            parsed_options.add_link_arg(c_string_slice(argv[start + 1]));
            start = start + 2;
        } else {
            return parse_command(argc, argv, start, parsed_options$.move());
        }
    }
    return parse_command(argc, argv, start, parsed_options$.move());
}

ArgParseResult parse_command(
    Int argc,
    UInt8[*][*] argv,
    Int start,
    options.CompileOptions parsed_options
) {
    Int remaining = argc - start;
    if (remaining == 1) {
        return input_options_with_config(parsed_options$.move(), argv[start], .executable, "");
    }
    if (remaining == 2) {
        if (c_string_equal(argv[start], "--check")) {
            return input_options_with_config(parsed_options$.move(), argv[start + 1], .check_only, "");
        }
        if (c_string_equal(argv[start], "--emit-obj")) {
            return input_options_with_config(
                parsed_options$.move(),
                argv[start + 1],
                .object_file,
                "/tmp/jiang-stage2-output.o"
            );
        }
        if (c_string_equal(argv[start], "--emit-llvm")) {
            return input_options_with_config(parsed_options$.move(), argv[start + 1], .llvm_ir, "");
        }
    }
    if (remaining == 3) {
        if (c_string_equal(argv[start], "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argv[start + 2],
                .executable,
                c_string_slice(argv[start + 1])
            );
        }
    }
    if (remaining == 4) {
        if (c_string_equal(argv[start], "--emit-obj") && c_string_equal(argv[start + 1], "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argv[start + 3],
                .object_file,
                c_string_slice(argv[start + 2])
            );
        }
        if (c_string_equal(argv[start], "--emit-llvm") && c_string_equal(argv[start + 1], "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argv[start + 3],
                .llvm_ir,
                c_string_slice(argv[start + 2])
            );
        }
    }
    return ArgParseResult(options.CompileOptions(), false);
}

ArgParseResult input_options(UInt8[*] input_path, options.EmitKind emit, UInt8[] output_path) {
    return ArgParseResult(options.CompileOptions(emit, c_string_slice(input_path), output_path), true);
}

ArgParseResult input_options_with_config(
    options.CompileOptions parsed_options,
    UInt8[*] input_path,
    options.EmitKind emit,
    UInt8[] output_path
) {
    options.CompileOptions! result = parsed_options$.move();
    result.emit = emit;
    result.input_path = c_string_slice(input_path);
    result.output_path = output_path;
    return ArgParseResult(result$.move(), true);
}

options.CompileMode? compile_mode_arg(UInt8[*] value) {
    if (c_string_equal(value, "debug")) {
        return options.CompileMode.debug;
    }
    if (c_string_equal(value, "release")) {
        return options.CompileMode.release;
    }
    return null;
}

Bool c_string_equal(UInt8[*] left, UInt8[] right) {
    Int! index = 0;
    while (index < right.length) {
        if (left[index] == 0) {
            return false;
        }
        if (left[index] != right[index]) {
            return false;
        }
        index = index + 1;
    }
    return left[index] == 0;
}

UInt8[] c_string_slice(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return text[0..length];
}
