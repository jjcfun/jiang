// Raw command-line argument parsing helpers.

import options = "./options.jiang";
import process = "../system/process.jiang";
import string = "../support/string.jiang";

public struct ArgParseResult: Movable {
    public options.CompileOptions options;
    public Bool ok;

    public init(options.CompileOptions options, Bool ok) {
        self.options = options$.move();
        self.ok = ok;
    }
}

public ArgParseResult parse_empty() {
    return ArgParseResult(options.CompileOptions(), true);
}

public ArgParseResult parse(process.ProgramArguments argv, UInt8[]& compiler_version) {
    options.CompileOptions! parsed_options = options.CompileOptions();
    parsed_options.compiler_version = compiler_version;
    Int! start = 1;
    while (start < argv.length) {
        if (start + 1 < argv.length && string.equal(argument_text(argv, start), "--mode")) {
            guard compile_mode_arg(argument_text(argv, start + 1)) is .some(parsed_mode) else {
                return ArgParseResult(error_options(compiler_version), false);
            }
            parsed_options.mode = parsed_mode;
            start = start + 2;
        } else if (string.equal(argument_text(argv, start), "--link-libc")) {
            parsed_options.link_libc = true;
            start = start + 1;
        } else if (string.equal(argument_text(argv, start), "--no-link-libc")) {
            parsed_options.link_libc = false;
            start = start + 1;
        } else if (start + 1 < argv.length && string.equal(argument_text(argv, start), "--target")) {
            parsed_options.target_triple = argument_text(argv, start + 1);
            start = start + 2;
        } else if (start + 1 < argv.length && string.equal(argument_text(argv, start), "--linker")) {
            parsed_options.linker_path = argument_text(argv, start + 1);
            start = start + 2;
        } else if (start + 1 < argv.length && string.equal(argument_text(argv, start), "--link-arg")) {
            parsed_options.add_link_arg(argument_text(argv, start + 1));
            start = start + 2;
        } else {
            return parse_command(argv, start, parsed_options$.move());
        }
    }
    return parse_command(argv, start, parsed_options$.move());
}

ArgParseResult parse_command(
    process.ProgramArguments argv,
    Int start,
    options.CompileOptions parsed_options
) {
    Int remaining = argv.length - start;
    if (remaining == 1) {
        return input_options_with_config(parsed_options$.move(), argument_text(argv, start), .executable, "");
    }
    if (remaining == 2) {
        if (string.equal(argument_text(argv, start), "--check")) {
            return input_options_with_config(parsed_options$.move(), argument_text(argv, start + 1), .check_only, "");
        }
        if (string.equal(argument_text(argv, start), "--emit-obj")) {
            return input_options_with_config(
                parsed_options$.move(),
                argument_text(argv, start + 1),
                .object_file,
                "/tmp/jiang-stage2-output.o"
            );
        }
        if (string.equal(argument_text(argv, start), "--emit-llvm")) {
            return input_options_with_config(parsed_options$.move(), argument_text(argv, start + 1), .llvm_ir, "");
        }
    }
    if (remaining == 3) {
        if (string.equal(argument_text(argv, start), "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argument_text(argv, start + 2),
                .executable,
                argument_text(argv, start + 1)
            );
        }
    }
    if (remaining == 4) {
        if (string.equal(argument_text(argv, start), "--emit-obj") && string.equal(argument_text(argv, start + 1), "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argument_text(argv, start + 3),
                .object_file,
                argument_text(argv, start + 2)
            );
        }
        if (string.equal(argument_text(argv, start), "--emit-llvm") && string.equal(argument_text(argv, start + 1), "-o")) {
            return input_options_with_config(
                parsed_options$.move(),
                argument_text(argv, start + 3),
                .llvm_ir,
                argument_text(argv, start + 2)
            );
        }
    }
    return ArgParseResult(error_options(parsed_options.compiler_version), false);
}

ArgParseResult input_options(UInt8[]& input_path, options.EmitKind emit, UInt8[]& output_path) {
    return ArgParseResult(options.CompileOptions(emit, input_path, output_path), true);
}

ArgParseResult input_options_with_config(
    options.CompileOptions parsed_options,
    UInt8[]& input_path,
    options.EmitKind emit,
    UInt8[]& output_path
) {
    options.CompileOptions! result = parsed_options$.move();
    result.emit = emit;
    result.input_path = input_path;
    result.output_path = output_path;
    return ArgParseResult(result$.move(), true);
}

options.CompileMode? compile_mode_arg(UInt8[]& value) {
    if (string.equal(value, "debug")) {
        return options.CompileMode.debug;
    }
    if (string.equal(value, "release")) {
        return options.CompileMode.release;
    }
    return null;
}

UInt8[]& argument_text(process.ProgramArguments argv, Int index) {
    return argv.argument(index)[..];
}

options.CompileOptions error_options(UInt8[]& compiler_version) {
    options.CompileOptions! result = options.CompileOptions();
    result.compiler_version = compiler_version;
    return result$.move();
}
