// Raw command-line argument parsing helpers.

import options = "./options.jiang";

public struct ArgParseResult: Copy {
    public options.CompileOptions options;
    public Bool ok;

    public init(options.CompileOptions options, Bool ok) {
        self.options = options;
        self.ok = ok;
    }
}

public ArgParseResult parse_empty() {
    return ArgParseResult(options.CompileOptions(), true);
}

public ArgParseResult parse(Int argc, UInt8[*][*] argv) {
    if (argc == 2) {
        return input_options(argv[1], .executable, "");
    }
    if (argc == 3) {
        if (c_string_equal(argv[1], "--check")) {
            return input_options(argv[2], .check_only, "");
        }
        if (c_string_equal(argv[1], "--emit-obj")) {
            return input_options(argv[2], .object_file, "/tmp/jiang-stage2-output.o");
        }
        if (c_string_equal(argv[1], "--emit-llvm")) {
            return input_options(argv[2], .llvm_ir, "/tmp/jiang-stage2-output.ll");
        }
    }
    if (argc == 4) {
        if (c_string_equal(argv[1], "-o")) {
            return input_options(argv[3], .executable, c_string_slice(argv[2]));
        }
    }
    if (argc == 5) {
        if (c_string_equal(argv[1], "--emit-obj") && c_string_equal(argv[2], "-o")) {
            return input_options(argv[4], .object_file, c_string_slice(argv[3]));
        }
        if (c_string_equal(argv[1], "--emit-llvm") && c_string_equal(argv[2], "-o")) {
            return input_options(argv[4], .llvm_ir, c_string_slice(argv[3]));
        }
    }
    return ArgParseResult(options.CompileOptions(), false);
}

ArgParseResult input_options(UInt8[*] input_path, options.EmitKind emit, UInt8[] output_path) {
    return ArgParseResult(options.CompileOptions(emit, c_string_slice(input_path), output_path), true);
}

Bool c_string_equal(UInt8[*] left, UInt8[] right) {
    Int! index = 0;
    while (index < right.length) {
        if (left[index] == 0) {
            return false;
        }
        if (left[index] != right[index]) {
            return false;
        }
        index = index + 1;
    }
    return left[index] == 0;
}

UInt8[] c_string_slice(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return text[0..length];
}
