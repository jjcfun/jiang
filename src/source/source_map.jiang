// Source location side table for semantic IDs.
//
// Semantic Model/Type/JIL 不直接携带 source_id/span。需要诊断或 IDE 定位时，通过
// SourceMap 从 NodeId/DefId 反查源码位置。这里保存的是源码位置事实，不参与
// semantic hash，也不用于判断 Semantic Model 是否 stale。

import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import source = "../source.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct SourceLoc: Copyable {
    public source.SourceId? source_id;
    public token.Span span;

    public init(self, source.SourceId source_id, token.Span span) {
        self.source_id = source_id;
        self.span = span;
    }

    public init(self, token.Span span) {
        self.source_id = null;
        self.span = span;
    }
}

struct ModelSpanEntry: Copyable {
    sem.NodeId node_id;
    token.Span span;
}

struct DefSpanEntry: Copyable {
    qid.DefId def_id;
    token.Span span;
}

struct ModelSpanIndex: Movable {
    list.ArrayList<ModelSpanEntry> entries;

    init(self) {
        self.entries = list.ArrayList<ModelSpanEntry>();
    }
}

struct DefSpanIndex: Movable {
    list.ArrayList<DefSpanEntry> entries;

    init(self) {
        self.entries = list.ArrayList<DefSpanEntry>();
    }
}

public struct SourceMap: Movable {
    public table.HashTable<sem.NodeId, SourceLoc> model_spans!;
    public table.SideTable<qid.DefId, SourceLoc> def_spans!;
    table.SideTable<source.SourceId, ModelSpanIndex> models_by_source!;
    table.SideTable<source.SourceId, DefSpanIndex> defs_by_source!;

    public init(self) {
        self.model_spans = table.HashTable<sem.NodeId, SourceLoc>();
        self.def_spans = table.SideTable<qid.DefId, SourceLoc>();
        self.models_by_source = table.SideTable<source.SourceId, ModelSpanIndex>();
        self.defs_by_source = table.SideTable<source.SourceId, DefSpanIndex>();
    }

    public Void reset_model_spans(Self&! self) {
        self.model_spans = table.HashTable<sem.NodeId, SourceLoc>();
        self.models_by_source = table.SideTable<source.SourceId, ModelSpanIndex>();
    }

    public Void set_model_span(
        Self&! self,
        sem.NodeId model_id,
        source.SourceId source_id,
        token.Span span
    ) {
        self.model_spans.set(model_id, SourceLoc(source_id, span));
        if (!self.models_by_source.has(source_id)) {
            self.models_by_source.set(source_id, ModelSpanIndex());
        }
        self.models_by_source.ref_at(source_id).entries.add(ModelSpanEntry (
            node_id: model_id,
            span: span
        ));
    }

    public Void set_sourceless_model_span(Self&! self, sem.NodeId model_id, token.Span span) {
        self.model_spans.set(model_id, SourceLoc(span));
    }

    public SourceLoc? model_span(self, sem.NodeId model_id) {
        return table.hash_table_get_value<sem.NodeId, SourceLoc>(self.model_spans$.ref(), model_id);
    }

    public sem.NodeId? model_at(self, source.SourceId source_id, Int byte_offset) {
        if (!self.models_by_source.has(source_id)) { return null; }
        list.ArrayList<ModelSpanEntry>& entries = self.models_by_source.ref_at(source_id).entries$.ref();
        sem.NodeId? best! = null;
        Int best_length! = 0;
        Int index! = 0;
        while (index < entries.len()) {
            ModelSpanEntry entry = entries.get(index);
            if (span_contains(entry.span, byte_offset) && (best == null || entry.span.length <= best_length)) {
                best = entry.node_id;
                best_length = entry.span.length;
            }
            index = index + 1;
        }
        return best;
    }

    public Void set_def_span(
        Self&! self,
        qid.DefId def_id,
        source.SourceId source_id,
        token.Span span
    ) {
        self.def_spans.set(def_id, SourceLoc(source_id, span));
        if (!self.defs_by_source.has(source_id)) {
            self.defs_by_source.set(source_id, DefSpanIndex());
        }
        self.defs_by_source.ref_at(source_id).entries.add(DefSpanEntry (
            def_id: def_id,
            span: span
        ));
    }

    public Void set_sourceless_def_span(Self&! self, qid.DefId def_id, token.Span span) {
        self.def_spans.set(def_id, SourceLoc(span));
    }

    public SourceLoc? def_span(self, qid.DefId def_id) {
        if (!self.def_spans.has(def_id)) {
            return null;
        }
        return self.def_spans.get(def_id);
    }

    public qid.DefId? def_at(self, source.SourceId source_id, Int byte_offset) {
        if (!self.defs_by_source.has(source_id)) { return null; }
        list.ArrayList<DefSpanEntry>& entries = self.defs_by_source.ref_at(source_id).entries$.ref();
        qid.DefId? best! = null;
        Int best_length! = 0;
        Int index! = 0;
        while (index < entries.len()) {
            DefSpanEntry entry = entries.get(index);
            if (span_contains(entry.span, byte_offset) && (best == null || entry.span.length <= best_length)) {
                best = entry.def_id;
                best_length = entry.span.length;
            }
            index = index + 1;
        }
        return best;
    }
}

Bool span_contains(token.Span span, Int byte_offset) {
    return span.length > 0 && byte_offset >= span.start && byte_offset < span.end();
}
