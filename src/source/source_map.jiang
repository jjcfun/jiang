// Source location side table for semantic IDs.
//
// HIR/Type/MIR 不直接携带 source_id/span。需要诊断或 IDE 定位时，通过
// SourceMap 从 HirId/DefId 反查源码位置。这里保存的是源码位置事实，不参与
// semantic hash，也不用于判断 HIR 是否 stale。

import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import source = "./source.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct SourceLoc {
    public source.SourceId? source_id;
    public token.Span span;

    public init(self, source.SourceId source_id, token.Span span) {
        self.source_id = source_id;
        self.span = span;
    }

    public init(self, token.Span span) {
        self.source_id = null;
        self.span = span;
    }
}

public struct SourceMap: Movable {
    public table.HashTable<hir.HirId, SourceLoc>! hir_spans;
    public table.SideTable<qid.DefId, SourceLoc>! def_spans;

    public init(self) {
        self.hir_spans = table.HashTable<hir.HirId, SourceLoc>();
        self.def_spans = table.SideTable<qid.DefId, SourceLoc>();
    }

    public () reset_hir_spans(self) {
        self.hir_spans = table.HashTable<hir.HirId, SourceLoc>();
    }

    public () set_hir_span(self, hir.HirId hir_id, source.SourceId source_id, token.Span span) {
        self.hir_spans.set(hir_id, SourceLoc(source_id, span));
    }

    public SourceLoc? hir_span(self, hir.HirId hir_id) {
        return table.hash_table_get_value<hir.HirId, SourceLoc>(self.hir_spans$.ref(), hir_id);
    }

    public () set_def_span(self, qid.DefId def_id, source.SourceId source_id, token.Span span) {
        self.def_spans.set(def_id, SourceLoc(source_id, span));
    }

    public () set_sourceless_def_span(self, qid.DefId def_id, token.Span span) {
        self.def_spans.set(def_id, SourceLoc(span));
    }

    public SourceLoc? def_span(self, qid.DefId def_id) {
        if (!self.def_spans.has(def_id)) {
            return null;
        }
        return self.def_spans.get(def_id);
    }
}
