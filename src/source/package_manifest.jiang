// package.ini 解析。
//
// 第一版只识别 [package] 的 name/root，以及 [dependencies] 中的本地依赖。
// 未识别字段会被忽略，方便文档里已有的 version/type 继续存在。

import list = "../support/list.jiang";
import fs = "../support/fs.jiang";
import ident = "../support/ident.jiang";
import path = "../support/path.jiang";
import string = "../support/string.jiang";

public struct PackageDependency {
    public UInt8[] name;
    public UInt8[] path;
}

public struct PackageManifest: Movable {
    public UInt8[]! name;
    public UInt8[]! root;
    public list.ArrayList<PackageDependency> dependencies;
    public Bool! ok;
    public UInt8[]! error;

    public init(UInt8[] package_dir) {
        self.name = basename(package_dir);
        self.root = "";
        self.dependencies = list.ArrayList<PackageDependency>();
        self.ok = true;
        self.error = "";
    }

    public UInt8[] dependency_path(UInt8[] name) {
        Int! index = 0;
        while (index < self.dependencies.len()) {
            PackageDependency dependency = self.dependencies.get(index);
            if (string.equal(dependency.name, name)) {
                return dependency.path;
            }
            index = index + 1;
        }
        return "";
    }
}

public PackageManifest parse(UInt8[] package_dir, UInt8[] text) {
    PackageManifest! manifest = PackageManifest(package_dir);

    UInt8[]! section = "";
    Int! line_start = 0;
    while (line_start <= text.length) {
        Int! line_end = line_start;
        while (line_end < text.length && text[line_end] != UInt8(10)) {
            line_end = line_end + 1;
        }

        UInt8[] line = trim(strip_comment(text[line_start..line_end]));
        if (line.length > 0) {
            parse_line(manifest$.ref(), section, line);
            if (!manifest.ok) {
                return manifest$.move();
            }
            if (is_section_header(line)) {
                section = line[1..line.length - 1];
            }
        }
        line_start = line_end + 1;
    }

    if (!ident.is_ident_name(manifest.name)) {
        manifest.ok = false;
        manifest.error = "package name must follow identifier rules";
        return manifest$.move();
    }
    if (manifest.root.length == 0) {
        manifest.root = string.append(manifest.name, ".jiang");
    }
    return manifest$.move();
}

public UInt8[] manifest_path(UInt8[] package_dir) {
    return join(package_dir, "package.ini");
}

public PackageManifest read(UInt8[] package_dir) {
    UInt8[] package_ini = manifest_path(package_dir);
    guard fs.read_all(package_ini) is some text else {
        PackageManifest! manifest = PackageManifest(package_dir);
        manifest.ok = false;
        manifest.error = "failed to read package.ini";
        return manifest$.move();
    }
    return parse(package_dir, text);
}

public Bool exists(UInt8[] package_dir) {
    return fs.read_all(manifest_path(package_dir)) != null;
}

public UInt8[] find_enclosing_dir(UInt8[] source_path) {
    UInt8[]! dir = path.dirname(source_path);
    while (dir.length > 0) {
        if (exists(dir)) {
            return dir;
        }
        UInt8[] parent = path.dirname(dir);
        if (string.equal(parent, dir)) {
            return "";
        }
        dir = parent;
    }
    return "";
}

public UInt8[] root_file_path(UInt8[] package_dir, PackageManifest& manifest) {
    return path.normalize(path.join(package_dir, manifest.root));
}

() parse_line(PackageManifest& manifest, UInt8[] section, UInt8[] line) {
    if (is_section_header(line)) {
        return;
    }

    Int eq_index = find_equal(line);
    if (eq_index < 0) {
        return;
    }

    UInt8[] key = trim(line[0..eq_index]);
    UInt8[] value = trim(unquote(trim(line[eq_index + 1..line.length])));
    if (string.equal(section, "package")) {
        parse_package_entry(manifest, key, value);
        return;
    }
    if (string.equal(section, "dependencies")) {
        parse_dependency_entry(manifest, key, value);
    }
}

() parse_package_entry(PackageManifest& manifest, UInt8[] key, UInt8[] value) {
    if (string.equal(key, "name")) {
        if (!ident.is_ident_name(value)) {
            manifest.ok = false;
            manifest.error = "package name must follow identifier rules";
            return;
        }
        manifest.name = value;
        return;
    }
    if (string.equal(key, "root")) {
        if (!path_text_valid(value)) {
            manifest.ok = false;
            manifest.error = "package root path is invalid";
            return;
        }
        manifest.root = value;
    }
}

() parse_dependency_entry(PackageManifest& manifest, UInt8[] key, UInt8[] value) {
    if (!ident.is_ident_name(key)) {
        manifest.ok = false;
        manifest.error = "dependency name must follow identifier rules";
        return;
    }
    if (!path_text_valid(value)) {
        manifest.ok = false;
        manifest.error = "dependency path is invalid";
        return;
    }
    manifest.dependencies.add(PackageDependency {name: key, path: value});
}

Bool is_section_header(UInt8[] line) {
    return line.length >= 2 && line[0] == UInt8(91) && line[line.length - 1] == UInt8(93);
}

Int find_equal(UInt8[] line) {
    Int! index = 0;
    while (index < line.length) {
        if (line[index] == UInt8(61)) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

UInt8[] trim(UInt8[] text) {
    Int! start = 0;
    Int! end = text.length;
    while (start < end && is_space(text[start])) {
        start = start + 1;
    }
    while (end > start && is_space(text[end - 1])) {
        end = end - 1;
    }
    return text[start..end];
}

UInt8[] strip_comment(UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        if (text[index] == UInt8(35) || text[index] == UInt8(59)) {
            return text[0..index];
        }
        index = index + 1;
    }
    return text;
}

UInt8[] unquote(UInt8[] text) {
    if (text.length >= 2 && text[0] == UInt8(34) && text[text.length - 1] == UInt8(34)) {
        return text[1..text.length - 1];
    }
    return text;
}

Bool path_text_valid(UInt8[] path) {
    if (path.length == 0) {
        return false;
    }
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == UInt8(92)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool is_space(UInt8 value) {
    return value == UInt8(32) || value == UInt8(9) || value == UInt8(13);
}

UInt8[] basename(UInt8[] path) {
    Int! end = path.length;
    while (end > 1 && path[end - 1] == UInt8(47)) {
        end = end - 1;
    }

    Int! start = 0;
    Int! index = 0;
    while (index < end) {
        if (path[index] == UInt8(47)) {
            start = index + 1;
        }
        index = index + 1;
    }
    return path[start..end];
}

UInt8[] join(UInt8[] base, UInt8[] child) {
    if (base.length == 0) {
        return child;
    }
    if (base[base.length - 1] == UInt8(47)) {
        return string.append(base, child);
    }
    return string.append(string.append(base, "/"), child);
}
