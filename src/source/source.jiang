// Source identity.

import hash = "../support/hash.jiang";
import traits = "../support/traits.jiang";

public struct SourceId: traits.Indexable, Hashable, Equatable {
    // 0-based source table id. Absence should be represented with SourceId?.
    public Int index;

    public init(self) {
        self.index = 0;
    }

    public init(self, Int index) {
        assert(index >= 0);
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public SourceId from_index(Int index) {
        return SourceId(index);
    }

    public UInt64 hash(self) {
        return UInt64(self.index + 1);
    }

    public Bool equal(SourceId& lhs, SourceId& rhs) {
        return lhs.index == rhs.index;
    }
}

public enum SourceKind {
    file,
    virtual,
}

public struct SourceKey: Hashable, Equatable {
    public SourceKind kind;
    public UInt8[]& value;
    public UInt64 cached_hash;

    public init(self, SourceKind kind, UInt8[]& value) {
        self.kind = kind;
        self.value = value;
        self.cached_hash = SourceKey.hash_value(kind, value);
    }

    public UInt64 hash(self) {
        return self.cached_hash;
    }

    public UInt64 hash_value(SourceKind kind, UInt8[]& value) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(Int(kind));
        hasher.write_bytes(value);
        return hasher.finish();
    }

    public Bool equal(SourceKey& lhs, SourceKey& rhs) {
        if (lhs.cached_hash != rhs.cached_hash) {
            return false;
        }
        SourceKind lhs_kind = lhs.kind;
        SourceKind rhs_kind = rhs.kind;
        Int lhs_kind_value = Int(lhs_kind);
        Int rhs_kind_value = Int(rhs_kind);
        if (lhs_kind_value != rhs_kind_value) {
            return false;
        }
        if (lhs.value.length != rhs.value.length) {
            return false;
        }

        Int! index = 0;
        while (index < lhs.value.length) {
            UInt8! lhs_byte = lhs.value[index];
            UInt8! rhs_byte = rhs.value[index];
            if (lhs_byte != rhs_byte) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public struct SourceRecord {
    public SourceId id;
    public SourceKey key;
    public UInt64! content_hash;
    public Int! revision;

    public UInt8[]& name(self) {
        return self.key.value;
    }
}

public UInt64 content_hash(UInt8[]& text) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write_bytes(text);
    return hasher.finish();
}
