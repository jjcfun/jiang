// 单次编译会话的 source identity store。
//
// 工作目录内的绝对路径与相对路径统一成同一个 key，避免同一文件形成两个
// module、package 或稳定定义身份；工作目录外的绝对路径保持绝对形式。

import table = "../support/table.jiang";
import arena = "../support/arena.jiang";
import source = "../source.jiang";
import env = "../system/env.jiang";
import std;

public struct SourceStore: Movable {
    table.ArrayTable<source.SourceId, source.SourceRecord> records;
    table.HashTable<source.SourceKey, source.SourceId> by_key;
    arena.Arena text_arena;

    public init(self) {
        self.records = table.ArrayTable<source.SourceId, source.SourceRecord>();
        self.by_key = table.HashTable<source.SourceKey, source.SourceId>();
        self.text_arena = arena.Arena();
    }

    public Int len(self) {
        return self.records.len();
    }

    public Bool empty(self) {
        return self.records.empty();
    }

    public source.SourceId add_anonymous(self, UInt64 content_hash) {
        source.SourceId id = self.records.next_id();
        self.records.append(source.SourceRecord (
            id: id,
            key: source.SourceKey(.virtual, ""),
            content_hash: content_hash,
            content_hash_known: true,
            revision: 0,
        ));
        return id;
    }

    public source.SourceId intern_path(self, UInt8[]& path, UInt64 content_hash) {
        Path canonical = canonical_file_path(path);
        return self.intern_key(.file, canonical.text(), content_hash);
    }

    // 构图阶段可先按路径建立 source shell，以便推导稳定 artifact path。
    // 在读取 `.ji` header 或源码后必须通过 intern_path 填入真实 hash。
    public source.SourceId reserve_path(self, UInt8[]& path) {
        Path canonical = canonical_file_path(path);
        source.SourceKey lookup = source.SourceKey(.file, canonical.text());
        if (table.hash_table_get_value<source.SourceKey, source.SourceId>(
            self.by_key$.ref(),
            lookup
        ) is .some(existing)) {
            return existing;
        }
        source.SourceId id = self.records.next_id();
        source.SourceKey owned_key = source.SourceKey(.file, self.copy_text(canonical.text()));
        self.records.append(source.SourceRecord (
            id: id,
            key: owned_key,
            content_hash: UInt64(0),
            content_hash_known: false,
            revision: 0,
        ));
        self.by_key.set(owned_key, id);
        return id;
    }

    public source.SourceId intern_virtual(self, UInt8[]& name, UInt64 content_hash) {
        return self.intern_key(.virtual, name, content_hash);
    }

    source.SourceId intern_key(self, source.SourceKind kind, UInt8[]& value, UInt64 content_hash) {
        source.SourceKey key = source.SourceKey(kind, value);
        if (table.hash_table_get_value<source.SourceKey, source.SourceId>(self.by_key$.ref(), key) is .some(id)) {
            source.SourceRecord entry = self.records.get(id);
            if (!entry.content_hash_known) {
                self.records.set(id, source.SourceRecord (
                    id: entry.id,
                    key: entry.key,
                    content_hash: content_hash,
                    content_hash_known: true,
                    revision: entry.revision,
                ));
                return id;
            }
            if (entry.content_hash != content_hash) {
                self.records.set(id, source.SourceRecord (
                    id: entry.id,
                    key: entry.key,
                    content_hash: content_hash,
                    content_hash_known: true,
                    revision: entry.revision + 1,
                ));
            }
            return id;
        }

        source.SourceId id = self.records.next_id();
        source.SourceKey owned_key = source.SourceKey(kind, self.copy_text(value));
        self.records.append(source.SourceRecord (
            id: id,
            key: owned_key,
            content_hash: content_hash,
            content_hash_known: true,
            revision: 0,
        ));
        self.by_key.set(owned_key, id);
        return id;
    }

    public Bool has(self, source.SourceId id) {
        return self.records.has(id);
    }

    public source.SourceRecord get(self, source.SourceId id) {
        return self.records.get(id);
    }

    public source.SourceRecord& ref_at(self, source.SourceId id) {
        return self.records.ref_at(id);
    }

    public source.SourceId? find(self, source.SourceKey key) {
        if (key.kind == .file) {
            Path canonical = canonical_file_path(key.value);
            source.SourceKey canonical_key = source.SourceKey(.file, canonical.text());
            return table.hash_table_get_value<source.SourceKey, source.SourceId>(
                self.by_key$.ref(),
                canonical_key
            );
        }
        return table.hash_table_get_value<source.SourceKey, source.SourceId>(self.by_key$.ref(), key);
    }

    UInt8[]& copy_text(self, UInt8[]& text) {
        unsafe {
            UInt8*! bytes = self.text_arena.alloc_array<UInt8>(text.length + 1);
            Int index! = 0;
            while (index < text.length) {
                bytes[index] = text[index];
                index = index + 1;
            }
            bytes[text.length] = 0;
            UInt8* frozen = unsafe {
                bytes$.as(UInt8*)
            };
            return frozen[0..text.length];
        }
    }
}

Path canonical_file_path(UInt8[]& path) {
    Path normalized = std.path.normalize(path);
    if (!normalized.is_absolute()) { return normalized; }
    guard env.get("PWD") is .some(cwd) else { return normalized; }
    Path normalized_cwd = std.path.normalize(cwd[..]);
    if (!path_is_inside(normalized.text(), normalized_cwd.text())) {
        return normalized;
    }
    return Path(normalized.text()[normalized_cwd.text().length + 1..normalized.text().length]);
}

Bool path_is_inside(UInt8[]& path, UInt8[]& directory) {
    if (directory.length == 0 || path.length <= directory.length) { return false; }
    if (path[directory.length] != UInt8(47)) { return false; }
    Int index! = 0;
    while (index < directory.length) {
        if (path[index] != directory[index]) { return false; }
        index = index + 1;
    }
    return true;
}
