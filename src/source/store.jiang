// Source identity store for one compilation session.

import table = "../support/table.jiang";
import source = "./source.jiang";

public struct SourceStore: Movable {
    table.ArrayTable<source.SourceId, source.SourceRecord> records;
    table.HashTable<source.SourceKey, source.SourceId> by_key;

    public init(self) {
        self.records = table.ArrayTable<source.SourceId, source.SourceRecord>();
        self.by_key = table.HashTable<source.SourceKey, source.SourceId>();
    }

    public Int len(self) {
        return self.records.len();
    }

    public Bool empty(self) {
        return self.records.empty();
    }

    public source.SourceId add_anonymous(self, UInt64 content_hash) {
        source.SourceId id = self.records.next_id();
        self.records.append(source.SourceRecord (
            id: id,
            key: source.SourceKey(.virtual, ""),
            content_hash: content_hash,
            revision: 0,
        ));
        return id;
    }

    public source.SourceId intern_path(self, UInt8[]& path, UInt64 content_hash) {
        return self.intern_key(source.SourceKey(.file, path), content_hash);
    }

    public source.SourceId intern_virtual(self, UInt8[]& name, UInt64 content_hash) {
        return self.intern_key(source.SourceKey(.virtual, name), content_hash);
    }

    source.SourceId intern_key(self, source.SourceKey key, UInt64 content_hash) {
        if (table.hash_table_get_value<source.SourceKey, source.SourceId>(self.by_key$.ref(), key) is .some(id)) {
            source.SourceRecord entry = self.records.get(id);
            if (entry.content_hash != content_hash) {
                self.records.set(id, source.SourceRecord (
                    id: entry.id,
                    key: entry.key,
                    content_hash: content_hash,
                    revision: entry.revision + 1,
                ));
            }
            return id;
        }

        source.SourceId id = self.records.next_id();
        self.records.append(source.SourceRecord (
            id: id,
            key: key,
            content_hash: content_hash,
            revision: 0,
        ));
        self.by_key.set(key, id);
        return id;
    }

    public Bool has(self, source.SourceId id) {
        return self.records.has(id);
    }

    public source.SourceRecord get(self, source.SourceId id) {
        return self.records.get(id);
    }

    public source.SourceRecord& ref_at(self, source.SourceId id) {
        return self.records.ref_at(id);
    }

    public source.SourceId? find(self, source.SourceKey key) {
        return table.hash_table_get_value<source.SourceKey, source.SourceId>(self.by_key$.ref(), key);
    }
}
