// 长驻编译会话的 source identity 与文本入口。
//
// 工作目录内的绝对路径与相对路径统一成同一个 key，避免同一文件形成两个
// module、package 或稳定定义身份；内存 overlay 优先于同路径磁盘文本。

import table = "../support/table.jiang";
import map = "../support/map.jiang";
import arena = "../support/arena.jiang";
import source = "../source.jiang";
import env = "../system/env.jiang";
import fs = "../system/fs.jiang";
import std;

struct SourceOverlay: Movable {
    std.Vector<UInt8> bytes!;
    Bool active!;

    init(self, UInt8[]& text) {
        self.bytes = copy_bytes(text);
        self.active = true;
    }
}

std.Vector<UInt8> copy_bytes(UInt8[]& bytes) {
    std.Vector<UInt8> result! = std.Vector<UInt8>(bytes.length);
    Int index! = 0;
    while (index < bytes.length) {
        result.append(bytes[index]);
        index = index + 1;
    }
    return result;
}

public struct SourceStore: Movable {
    table.ArrayTable<source.SourceId, source.SourceRecord> records!;
    map.WyHashMap<source.SourceKey, source.SourceId> by_key!;
    table.SideTable<source.SourceId, SourceOverlay> overlays!;
    arena.Arena text_arena!;

    public init(self) {
        self.records = table.ArrayTable<source.SourceId, source.SourceRecord>();
        self.by_key = map.WyHashMap<source.SourceKey, source.SourceId>();
        self.overlays = table.SideTable<source.SourceId, SourceOverlay>();
        self.text_arena = arena.Arena();
    }

    public Int len(self) {
        return self.records.len();
    }

    public Bool empty(self) {
        return self.records.empty();
    }

    public source.SourceId add_anonymous(Self&! self, UInt64 content_hash) {
        source.SourceId id = self.records.next_id();
        self.records.append(source.SourceRecord (
            id: id,
            key: source.SourceKey(.virtual, ""),
            content_hash: content_hash,
            content_hash_known: true,
            revision: 0,
        ));
        return id;
    }

    public source.SourceId intern_path(Self&! self, UInt8[]& path, UInt64 content_hash) {
        Path canonical = canonical_file_path(path);
        return self.intern_key(.file, canonical.text(), content_hash);
    }

    // 构图阶段可先按路径建立 source shell，以便推导稳定 artifact path。
    // 在读取 `.ji` header 或源码后必须通过 intern_path 填入真实 hash。
    public source.SourceId reserve_path(Self&! self, UInt8[]& path) {
        Path canonical = canonical_file_path(path);
        source.SourceKey lookup = source.SourceKey(.file, canonical.text());
        if (lookup_source_id(self.by_key$.ref(), lookup) is .some(existing)) { return existing; }
        source.SourceId id = self.records.next_id();
        UInt8[]& owned_text = copy_text(self.text_arena$.mut_ref(), canonical.text());
        source.SourceKey owned_key = source.SourceKey(.file, owned_text);
        self.records.append(source.SourceRecord (
            id: id,
            key: owned_key,
            content_hash: UInt64(0),
            content_hash_known: false,
            revision: 0,
        ));
        self.by_key.set(owned_key, id);
        return id;
    }

    public source.SourceId intern_virtual(Self&! self, UInt8[]& name, UInt64 content_hash) {
        return self.intern_key(.virtual, name, content_hash);
    }

    public source.SourceId set_overlay(Self&! self, UInt8[]& path, UInt8[]& text) {
        source.SourceId id = self.intern_path(path, source.content_hash(text));
        if (self.overlays.has(id)) {
            SourceOverlay&! overlay = self.overlays.mut_ref_at(id);
            overlay.bytes = copy_bytes(text);
            overlay.active = true;
            return id;
        }
        self.overlays.set(id, SourceOverlay(text));
        return id;
    }

    public Bool clear_overlay(Self&! self, UInt8[]& path) {
        guard self.find(source.SourceKey(.file, path)) is .some(id) else { return false; }
        if (!self.overlays.has(id)) { return false; }
        SourceOverlay&! overlay = self.overlays.mut_ref_at(id);
        if (!overlay.active) { return false; }
        overlay.active = false;
        return true;
    }

    public Bool has_overlay(self, source.SourceId id) {
        if (!self.overlays.has(id)) { return false; }
        return self.overlays.ref_at(id).active;
    }

    public Bool has_overlay_path(self, UInt8[]& path) {
        guard self.find(source.SourceKey(.file, path)) is .some(id) else { return false; }
        return self.has_overlay(id);
    }

    @life(return: self)
    public UInt8[]&? read_path(self, UInt8[]& path) {
        if (self.find(source.SourceKey(.file, path)) is .some(id) && self.has_overlay(id)) {
            SourceOverlay& overlay = self.overlays.ref_at(id);
            return overlay.bytes.slice();
        }
        return fs.read_all(path);
    }

    source.SourceId intern_key(Self&! self, source.SourceKind kind, UInt8[]& value, UInt64 content_hash) {
        source.SourceKey key = source.SourceKey(kind, value);
        if (lookup_source_id(self.by_key$.ref(), key) is .some(id)) {
            source.SourceRecord&! entry = self.records.mut_ref_at(id);
            if (!entry.content_hash_known) {
                entry.content_hash = content_hash;
                entry.content_hash_known = true;
                return id;
            }
            if (entry.content_hash != content_hash) {
                entry.content_hash = content_hash;
                entry.revision = entry.revision + 1;
            }
            return id;
        }

        source.SourceId id = self.records.next_id();
        UInt8[]& owned_text = copy_text(self.text_arena$.mut_ref(), value);
        source.SourceKey owned_key = source.SourceKey(kind, owned_text);
        self.records.append(source.SourceRecord (
            id: id,
            key: owned_key,
            content_hash: content_hash,
            content_hash_known: true,
            revision: 0,
        ));
        self.by_key.set(owned_key, id);
        return id;
    }

    public Bool has(self, source.SourceId id) {
        return self.records.has(id);
    }

    public source.SourceRecord get(self, source.SourceId id) {
        return self.records.get(id);
    }

    public source.SourceRecord& ref_at(self, source.SourceId id) {
        return self.records.ref_at(id);
    }

    public source.SourceId? find(self, source.SourceKey key) {
        if (key.kind == .file) {
            Path canonical = canonical_file_path(key.value);
            source.SourceKey canonical_key = source.SourceKey(.file, canonical.text());
            guard self.by_key.get(canonical_key) is .some(id) else { return null; }
            return id$.get();
        }
        guard self.by_key.get(key) is .some(id) else { return null; }
        return id$.get();
    }

}

source.SourceId? lookup_source_id(
    map.WyHashMap<source.SourceKey, source.SourceId>& by_key,
    source.SourceKey key
) {
    guard by_key.get(key) is .some(id) else { return null; }
    return id$.get();
}

@life(return: text_arena)
UInt8[]& copy_text(arena.Arena&! text_arena, UInt8[]& text) {
    unsafe {
        UInt8*! bytes = text_arena.alloc_array<UInt8>(text.length + 1);
        Int index! = 0;
        while (index < text.length) {
            bytes[index] = text[index];
            index = index + 1;
        }
        bytes[text.length] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..text.length];
    }
}

Path canonical_file_path(UInt8[]& path) {
    Path normalized = std.path.normalize(path);
    if (!normalized.is_absolute()) { return normalized; }
    guard env.get("PWD") is .some(cwd) else { return normalized; }
    Path normalized_cwd = std.path.normalize(cwd[..]);
    if (!path_is_inside(normalized.text(), normalized_cwd.text())) {
        return normalized;
    }
    return Path(normalized.text()[normalized_cwd.text().length + 1..normalized.text().length]);
}

Bool path_is_inside(UInt8[]& path, UInt8[]& directory) {
    if (directory.length == 0 || path.length <= directory.length) { return false; }
    if (path[directory.length] != UInt8(47)) { return false; }
    Int index! = 0;
    while (index < directory.length) {
        if (path[index] != directory[index]) { return false; }
        index = index + 1;
    }
    return true;
}
