// Source file identity, path, URI, and text buffer types.

public struct SourceFileId {
    // 0 表示无效 source file；有效 id 从 1 开始。
    public Int index;

    public init() {
        self.index = 0;
    }

    public init(Int index) {
        self.index = index;
    }

    public Bool valid() {
        return self.index > 0;
    }
}

public enum SourceKind {
    file,
    virtual_file,
    repl_input,
    generated,
}

public struct SourceFile {
    public SourceFileId id;
    public SourceKind kind;

    // path 面向本地文件和 CLI；uri 面向 LSP。二者都保留，避免互相转换丢信息。
    public UInt8[] path;
    public UInt8[] uri;
    public UInt8[] text;

    public init() {
        self.id = SourceFileId();
        self.kind = .file;
        self.path = "";
        self.uri = "";
        self.text = "";
    }

    public init(SourceFileId id, SourceKind kind, UInt8[] path, UInt8[] uri, UInt8[] text) {
        self.id = id;
        self.kind = kind;
        self.path = path;
        self.uri = uri;
        self.text = text;
    }
}
