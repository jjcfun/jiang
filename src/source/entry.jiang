// source/package 编译入口加载。
//
// PackageHandle 长期保存规范化 root path 与稳定 SourceId；每轮 compilation
// 再从 SourceStore 读取当前磁盘或 overlay 文本，不持有语义阶段结果。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import package_manifest = "./package_manifest.jiang";
import source = "../source.jiang";
import string = "../support/string.jiang";
import std;

@region(a)
public struct Entry: Movable {
    public source.SourceId source_id;
    @life(a)
    public UInt8[]& text!;
    public Bool ok!;

    public init(self, source.SourceId source_id, UInt8[]& text, Bool ok) {
        self.source_id = source_id;
        self.text = text;
        self.ok = ok;
    }
}

public struct PackageHandle: Movable {
    public source.SourceId root_source_id;
    public Path root_path;
    public Bool ok!;

    public init(self, source.SourceId root_source_id, Path root_path, Bool ok) {
        self.root_source_id = root_source_id;
        self.root_path = root_path;
        self.ok = ok;
    }
}

public PackageHandle load_package(context.CompilerContext& ctx, UInt8[]& input_path) {
    guard root_file_path(ctx, input_path) is .some(root_path) else {
        return PackageHandle(source.SourceId(), Path(""), false);
    }
    source.SourceId source_id = ctx.store.sources.reserve_path(root_path.text());
    return PackageHandle(source_id, root_path, true);
}

@life(return: ctx)
public Entry read_root(context.CompilerContext& ctx, PackageHandle& package) {
    if (!package.ok) { return Entry(source.SourceId(), "", false); }
    UInt8[]& root_text = package.root_path.text();
    guard ctx.store.sources.read_path(root_text) is .some(text) else {
        std.String message = string.concat("failed to read source file: ", root_text);
        diagnostic_helper.add_package_error(ctx, message.bytes(), "source_file_not_found");
        return Entry(source.SourceId(), "", false);
    }
    source.SourceId source_id = ctx.store.sources.intern_path(root_text, source.content_hash(text));
    return Entry(source_id, text, true);
}

Path? root_file_path(context.CompilerContext& ctx, UInt8[]& input_path) {
    Path normalized = std.path.normalize(input_path);
    if (!package_manifest.exists(normalized.text())) {
        return normalized;
    }
    package_manifest.PackageManifest manifest = package_manifest.read(normalized.text());
    if (!manifest.ok) {
        diagnostic_helper.add_package_error(ctx, manifest.error, "package_manifest_invalid");
        return null;
    }
    return package_manifest.root_file_path(normalized.text(), manifest$.ref());
}

UInt8[]^ empty_text() {
    std.StringBuilder builder = std.StringBuilder();
    return builder.into_slice();
}
