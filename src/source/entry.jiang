// source/package 编译入口加载。
//
// 这里负责把用户输入路径归一化为 root source，读取源码并建立 SourceId。

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import path = "../support/path.jiang";
import string = "../support/string.jiang";
import fs = "../system/fs.jiang";
import package_manifest = "./package_manifest.jiang";
import source = "./source.jiang";

public struct Entry: Movable {
    public source.SourceId source_id;
    public UInt8[]&! root_path;
    public UInt8[]&! text;
    public Bool! ok;

    public init(source.SourceId source_id, UInt8[]& root_path, UInt8[]& text, Bool ok) {
        self.source_id = source_id;
        self.root_path = root_path;
        self.text = text;
        self.ok = ok;
    }
}

public Entry load_root(context.CompilerContext& ctx, UInt8[]& input_path) {
    guard root_file_path(ctx, input_path) is .some(root_path) else {
        return Entry(source.SourceId(), "", "", false);
    }
    guard fs.read_all(root_path) is .some(text) else {
        add_package_error(ctx, string.append("failed to read source file: ", root_path), "source_file_not_found");
        return Entry(source.SourceId(), root_path, "", false);
    }
    source.SourceId source_id = ctx.store.sources.intern_path(root_path, source.content_hash(text));
    return Entry(source_id, root_path, text, true);
}

UInt8[]&? root_file_path(context.CompilerContext& ctx, UInt8[]& input_path) {
    UInt8[]& normalized = path.normalize(input_path);
    if (!package_manifest.exists(normalized)) {
        return normalized;
    }
    package_manifest.PackageManifest manifest = package_manifest.read(normalized);
    if (!manifest.ok) {
        add_package_error(ctx, manifest.error, "package_manifest_invalid");
        return null;
    }
    return package_manifest.root_file_path(normalized, manifest$.ref());
}

() add_package_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
