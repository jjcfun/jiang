// source/package 编译入口加载。
//
// PackageHandle 长期保存规范化 root path 与稳定 SourceId；每轮 compilation
// 再从 SourceStore 读取当前磁盘或 overlay 文本，不持有语义阶段结果。

import context = "../context.jiang";
import diagnostic = "../diagnostic.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import package_manifest = "./package_manifest.jiang";
import source = "../source.jiang";
import store_api = "../store.jiang";
import string = "../support/string.jiang";
import std;

public struct Entry: Movable {
    public source.SourceId source_id;
    public UInt8[]^ text!;
    public Bool ok!;

    public init(self, source.SourceId source_id, UInt8[]^ text, Bool ok) {
        self.source_id = source_id;
        self.text = text;
        self.ok = ok;
    }

}

public struct PackageHandle: Movable {
    public Path root_path;
    public Bool ok!;

    public init(self, Path root_path, Bool ok) {
        self.root_path = root_path;
        self.ok = ok;
    }
}

public PackageHandle load_package(context.CompilerContext&! ctx, UInt8[]& input_path) {
    guard root_file_path(ctx.store.diagnostics$.mut_ref(), input_path) is .some(root_path) else {
        return PackageHandle(Path(""), false);
    }
    return PackageHandle(root_path, true);
}

public Entry read_root(context.CompilerContext&! ctx, PackageHandle& package) {
    if (!package.ok) { return Entry(source.SourceId(), empty_text(), false); }
    UInt8[]& root_text = package.root_path.bytes();
    guard ctx.store.sources.load_path_text(root_text) is .some(loaded) else {
        std.String message = string.concat("failed to read source file: ", root_text);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            message.bytes(),
            "source_file_not_found"
        );
        return Entry(source.SourceId(), empty_text(), false);
    }
    UInt8[]^ text! = loaded;
    store_api.CompilerStore&! store = ctx.store$.mut_ref();
    source.SourceId source_id = store.intern_source_path(
        root_text,
        text[..]
    );
    return Entry(source_id, text$.move(), true);
}

Path? root_file_path(diagnostic.DiagnosticStore&! diagnostics, UInt8[]& input_path) {
    Path normalized = std.path.normalize(input_path);
    if (!package_manifest.exists(normalized.bytes())) {
        return normalized;
    }
    package_manifest.PackageManifest manifest = package_manifest.read(normalized.bytes());
    if (!manifest.ok) {
        diagnostic_helper.add_package_error(
            diagnostics,
            manifest.error,
            "package_manifest_invalid"
        );
        return null;
    }
    return package_manifest.root_file_path(normalized.bytes(), manifest$.ref());
}

UInt8[]^ empty_text() {
    std.StringBuilder builder = std.StringBuilder();
    return builder.into_slice();
}
