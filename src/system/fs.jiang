// Internal filesystem provider boundary.
//
// 这里暴露编译器需要的文件系统语义，不暴露 fopen/fread/fwrite 等 libc 形状。
// 和 Zig 的分层类似，这里静态选择一个 provider module；provider 形状由
// `read_all` / `write_all` / `exists` 等同名函数集合定义，而不是运行时 wrapper。

import provider = "./os/macos/fs.jiang";

public struct File: Movable {
    Int32! fd;
    Bool! owns;

    public init(Int32 fd, Bool owns) {
        self.fd = fd;
        self.owns = owns;
    }

    public Bool is_open() {
        return self.fd >= 0;
    }

    deinit() {
        self.close();
    }

    public UInt8[]&? read_all() {
        if (!self.is_open()) {
            return null;
        }
        return provider.read_file_all(self.fd);
    }

    public Bool write_all(UInt8[]& bytes) {
        if (!self.is_open()) {
            return false;
        }
        return provider.write_file_all(self.fd, bytes);
    }

    public () close() {
        if (self.owns && self.is_open()) {
            provider.close_file(self.fd);
        }
        self.fd = Int32(-1);
        self.owns = false;
    }
}

public File? open(UInt8[]& path) {
    guard provider.open_read(path) is some fd else { return null; }
    return File(fd, true);
}

public File? create(UInt8[]& path) {
    guard provider.open_write(path) is some fd else { return null; }
    return File(fd, true);
}

public UInt8[]&? read_all(UInt8[]& path) {
    guard open(path) is some opened else { return null; }
    File! file = opened$.move();
    UInt8[]&? text = file.read_all();
    file.close();
    return text;
}

public Bool write_all(UInt8[]& path, UInt8[]& bytes) {
    guard create(path) is some created else { return false; }
    File! file = created$.move();
    Bool ok = file.write_all(bytes);
    file.close();
    return ok;
}

public Bool exists(UInt8[]& path) {
    return provider.exists(path);
}

public Bool file_exists(UInt8[]& path) {
    return provider.file_exists(path);
}

public Bool dir_exists(UInt8[]& path) {
    return provider.dir_exists(path);
}

public Bool create_dir(UInt8[]& path) {
    return provider.create_dir(path);
}

public Bool create_dirs(UInt8[]& path) {
    return provider.create_dirs(path);
}

public Bool copy_file(UInt8[]& from_path, UInt8[]& to_path) {
    guard read_all(from_path) is some bytes else {
        return false;
    }
    return write_all(to_path, bytes);
}
