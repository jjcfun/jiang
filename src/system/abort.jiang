// Internal abort/panic boundary.
//
// 这里表达“终止当前进程”的语义；具体 hosted/no-libc 实现由 provider 决定。
// panic 先通过 system.io 输出诊断文本，再进入 provider 的 abort 路径。

import io = "./io.jiang";
import provider = "./os/provider.jiang";

public () exit(Int code) {
    provider.exit_process(code);
}

public () abort() {
    provider.abort_process();
}

public () trap() {
    provider.trap();
}

public () panic(UInt8[]& message) {
    io.stderr().write_all(message);
    UInt8![*] newline = UInt8!$.alloc_many(1);
    newline[0] = UInt8(10);
    io.stderr().write_all(newline[0..1]);
    newline$.free();
    provider.abort_process();
}
