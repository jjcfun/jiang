// Internal environment provider boundary.
//
// 上层只表达按名称读取环境变量的语义；底层 provider 可以来自 hosted libc
// environment，也可以来自 no-libc startup/runtime 初始化的环境块。

import provider = "./os/provider.jiang";
import fs = "./fs.jiang";
import std;

@life()
public UInt8[:0]&? get(UInt8[]& name) {
    return provider.environment_value(name);
}

public UInt8[]^? find_executable(UInt8[]& name) {
    if (has_path_separator(name)) {
        if (fs.file_exists(name)) {
            return copy_slice(name);
        }
        return null;
    }
    guard get("PATH") is .some(path) else { return null; }
    return find_in_path(name, path[..]);
}

Bool has_path_separator(UInt8[]& name) {
    Int index! = 0;
    while (index < name.length) {
        if (name[index] == UInt8(47)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

UInt8[]^? find_in_path(UInt8[]& name, UInt8[]& path) {
    Int start! = 0;
    while (start <= path.length) {
        Int end = path_segment_end(path, start);
        if (end > start) {
            UInt8[]^ candidate = path_join(path[start..end], name);
            if (fs.file_exists(candidate[..])) {
                return candidate;
            }
        }
        start = end + 1;
    }
    return null;
}

Int path_segment_end(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && path[index] != UInt8(58)) {
        index = index + 1;
    }
    return index;
}

UInt8[]^ path_join(UInt8[]& dir, UInt8[]& name) {
    if (dir.length == 0) {
        return copy_slice(name);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(dir);
    if (dir[dir.length - 1] == UInt8(47)) {
        builder.append(name);
    } else {
        builder.append("/");
        builder.append(name);
    }
    return builder.into_slice();
}

UInt8[]^ copy_slice(UInt8[]& text) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(text);
    return builder.into_slice();
}
