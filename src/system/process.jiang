// Internal process execution API.
//
// 上层只表达 argv 形式的进程执行语义；底层 provider 可以基于 POSIX/libc、
// raw syscall 或 target runtime 实现相同形状的能力。

import list = "../support/list.jiang";
import provider = "./os/macos/process.jiang";

public enum StreamBehavior {
    inherit,
    pipe,
    discard,
}

public struct RunOptions {
    public StreamBehavior stdout;
    public StreamBehavior stderr;

    public init() {
        self.stdout = .inherit;
        self.stderr = .inherit;
    }
}

// 进程启动参数由宿主启动代码或 libc/main ABI 持有，Jiang 侧只借用。
// 外层 argv 的长度来自 argc；内层每个参数是以 0 结尾的 UInt8 字符串。
public struct ProgramArguments {
    public Int length;
    UInt8[*:0][*] raw;

    public init(Int length, UInt8[*:0][*] raw) {
        self.length = length;
        self.raw = raw;
    }

    public UInt8[:0]& argument(Int index) {
        if (index < 0 || index >= self.length) {
            return "";
        }
        UInt8[*:0] value = self.raw[index];
        return value[0..c_string_length(value)]$.as(UInt8[:0]&);
    }
}

public ProgramArguments arguments() {
    return ProgramArguments(provider.argument_count(), provider.argument_values());
}

public struct ProcessResult {
    public Bool started;
    public Int exit_code;
    public UInt8[]&! stdout;
    public UInt8[]&! stderr;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = "";
        self.stderr = "";
    }

    public init(Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }

    public Bool ok() {
        return self.started && self.exit_code == 0;
    }
}

// `args` 是调用期借用视图；provider 必须在返回前复制或消费参数，不能保存这些 slice。
public ProcessResult run(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    RunOptions options = RunOptions();
    return run(executable, args, options$.ref());
}

public ProcessResult run(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, RunOptions& options) {
    provider.SpawnOptions! provider_options = provider.SpawnOptions();
    provider_options.capture_stdout = options.stdout == .pipe;
    provider_options.capture_stderr = options.stderr == .pipe;
    provider_options.discard_stderr = options.stderr == .discard;
    provider.SpawnResult result = provider.spawn_wait(executable, args, provider_options$.ref());
    return ProcessResult(result.started, result.exit_code, result.stdout, result.stderr);
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
