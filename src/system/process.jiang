// src/system 私有层 的进程执行 API。
//
// 上层只表达 argv 形式的进程执行语义；底层 provider 可以基于 POSIX/libc、
// raw syscall 或 target runtime 实现相同形状的能力。

import list = "../support/list.jiang";
import provider = "./os/provider.jiang";
import startup = "./startup.jiang";

public alias ProgramArguments = startup.ProgramArguments;

// std wrapper 在调用期构造的 argv view；只保存 borrowed slice handle。
@region(a)
public struct ArgumentList: Movable {
    @life(a)
    list.ArrayList<UInt8[]&> values!;

    public init(self, Int capacity = 0) {
        self.values = list.ArrayList<UInt8[]&>(capacity);
    }

    @life(self.a: value)
    public Void append(Self&! self, UInt8[]& value) {
        self.values.add(value);
    }
}

public enum StreamBehavior {
    inherit,
    pipe,
    discard,
}

public struct RunOptions: Copyable {
    public StreamBehavior stdout!;
    public StreamBehavior stderr!;

    public init(self) {
        self.stdout = .inherit;
        self.stderr = .inherit;
    }
}

public ProgramArguments arguments() {
    return startup.arguments();
}

@region(a)
public struct ProcessResult: Copyable {
    public Bool started;
    public Int exit_code;
    @life(a)
    public UInt8[]& stdout!;

    @life(a)
    public UInt8[]& stderr!;

    public init(self, Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = "";
        self.stderr = "";
    }

    public init(self, Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }

    public Bool ok(self) {
        return self.started && self.exit_code == 0;
    }
}

// `args` 是调用期借用视图；provider 必须在返回前复制或消费参数，不能保存这些 slice。
@life()
public ProcessResult run(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    RunOptions options = RunOptions();
    return run(executable, args, options$.ref());
}

@life()
public ProcessResult run(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, RunOptions& options) {
    provider.SpawnOptions provider_options! = provider.SpawnOptions();
    provider_options.capture_stdout = options.stdout == .pipe;
    provider_options.capture_stderr = options.stderr == .pipe;
    provider_options.discard_stderr = options.stderr == .discard;
    provider.SpawnResult result = provider.spawn_wait(executable, args, provider_options$.ref());
    return ProcessResult(result.started, result.exit_code, result.stdout, result.stderr);
}

@life()
public ProcessResult run(UInt8[]& executable, ArgumentList& args, RunOptions& options) {
    return run(executable, args.values$.ref(), options);
}
