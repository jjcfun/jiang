// Hosted dynamic library loader.

import provider = "./os/provider.jiang";

public struct Library: Movable {
    // Opaque platform dynamic library handle.
    public RawPointer<UInt8>! handle;

    // Whether this wrapper is responsible for closing the handle.
    public Bool! owns;

    public init(RawPointer<UInt8> handle) {
        self.handle = handle;
        self.owns = true;
    }

    public Bool loaded() {
        return self.handle != null;
    }

    public RawPointer<UInt8> symbol(UInt8[]& name) {
        if (!self.loaded()) {
            return null;
        }
        return provider.dynamic_library_symbol(self.handle, name);
    }

    public () close() {
        if (self.owns && self.loaded()) {
            provider.dynamic_library_close(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    deinit() {
        self.close();
    }
}

public Library? open(UInt8[]& path) {
    RawPointer<UInt8> handle = provider.dynamic_library_open(path);
    if (handle == null) {
        return null;
    }
    return Library(handle);
}

public Bool close_handle(RawPointer<UInt8> handle) {
    if (handle == null) {
        return false;
    }
    return provider.dynamic_library_close(handle);
}
