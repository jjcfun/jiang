// Target provider selection.
//
// system/* 只依赖这个统一 provider 入口；具体 OS provider 由 comptime 根据
// build.target 选择。resolver 不再对 ./os/provider.jiang 做路径重写。

import build;
import list = "../../support/list.jiang";

comptime {
    if (build.target.os == .macos) {
        import target = "./macos.jiang";
    } else if (build.target.os == .wasm && build.target.abi == .wasi) {
        import target = "./wasi.jiang";
    } else if (build.target.os == .linux && build.target.link_libc) {
        import target = "./linux.jiang";
    } else if (build.target.os == .linux && !build.target.link_libc) {
        import target = "./linux/no_libc.jiang";
    } else {
        import target = "./unsupported.jiang";
    }
}

public alias SpawnResult = target.SpawnResult;
public alias SpawnOptions = target.SpawnOptions;
public alias write_file_all = target.write_file_all;

public struct FileMetadata: Copyable {
    public UInt64 modified_ns;
    public Int size;

    public init(self, UInt64 modified_ns, Int size) {
        self.modified_ns = modified_ns;
        self.size = size;
    }
}

public Int32? open_read(UInt8[]& path) {
    return target.open_read(path);
}

public Int32? open_write(UInt8[]& path) {
    return target.open_write(path);
}

public Bool exists(UInt8[]& path) {
    return target.exists(path);
}

public Bool file_exists(UInt8[]& path) {
    return target.file_exists(path);
}

public Bool dir_exists(UInt8[]& path) {
    return target.dir_exists(path);
}

public Bool create_dir(UInt8[]& path) {
    return target.create_dir(path);
}

public Bool create_dirs(UInt8[]& path) {
    return target.create_dirs(path);
}

public Bool atomic_replace(UInt8[]& temporary_path, UInt8[]& final_path) {
    return target.atomic_replace(temporary_path, final_path);
}

public Bool remove_file(UInt8[]& path) {
    return target.remove_file(path);
}

public Bool remove_tree(UInt8[]& path) {
    return target.remove_tree(path);
}

public Int32? acquire_file_lock(UInt8[]& path) {
    return target.acquire_file_lock(path);
}

public Void release_file_lock(Int32 fd) {
    target.release_file_lock(fd);
}

public Int process_id() {
    return target.process_id();
}

public UInt64 monotonic_time_ns() {
    return target.monotonic_time_ns();
}

@life()
public UInt8[]&? read_file_all(Int32 fd) {
    return target.read_file_all(fd);
}

@life()
public UInt8[]&? read_file_at(Int32 fd, Int offset, Int length) {
    return target.read_file_at(fd, offset, length);
}

public Int? file_size(Int32 fd) {
    return target.file_size(fd);
}

public FileMetadata? file_metadata(Int32 fd) {
    guard target.file_size(fd) is .some(size) else { return null; }
    guard target.file_modified_ns(fd) is .some(modified_ns) else { return null; }
    return FileMetadata(modified_ns, size);
}

public Bool close_file(Int32 fd) {
    return target.close_file(fd);
}

public Void memory_copy(UInt8* dest, UInt8* source, Int count) {
    target.memory_copy(dest, source, count);
}

public Void memory_set(UInt8* dest, Int value, Int count) {
    target.memory_set(dest, value, count);
}

public Void exit_process(Int code) {
    target.exit_process(code);
}

public Void abort_process() {
    target.abort_process();
}

public Void trap() {
    target.trap();
}

@life()
public UInt8[:0]&? environment_value(UInt8[]& name) {
    return target.environment_value(name);
}

public Void* dynamic_library_open(UInt8[]& path) {
    return target.dynamic_library_open(path);
}

public Void* dynamic_library_symbol(Void* handle, UInt8[]& name) {
    return target.dynamic_library_symbol(handle, name);
}

public Bool dynamic_library_close(Void* handle) {
    return target.dynamic_library_close(handle);
}

@life()
public UInt8[:0]&? dynamic_library_error() {
    return target.dynamic_library_error();
}

@life()
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    return target.spawn_wait(executable, args);
}

@life()
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    return target.spawn_wait(executable, args, options);
}
