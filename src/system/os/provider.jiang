// Frozen bootstrap fallback provider.
//
// 旧 bootstrap compiler 不知道 target provider mapping，因此需要一个真实
// 文件保证源码可编译。支持 mapping 的 compiler 会在 resolver 阶段把
// `./os/provider.jiang` 重定向到当前 target provider；正常 0.3+ 编译不应该
// 依赖这个文件。保留它只为了旧 bootstrap/fallback，不在这里继续增加平台逻辑。

import macos = "./macos.jiang";
import list = "../../support/list.jiang";

public alias SpawnResult = macos.SpawnResult;
public alias SpawnOptions = macos.SpawnOptions;

public Int32? open_read(UInt8[]& path) {
    return macos.open_read(path);
}

public Int32? open_write(UInt8[]& path) {
    return macos.open_write(path);
}

public Bool exists(UInt8[]& path) {
    return macos.exists(path);
}

public Bool file_exists(UInt8[]& path) {
    return macos.file_exists(path);
}

public Bool dir_exists(UInt8[]& path) {
    return macos.dir_exists(path);
}

public Bool create_dir(UInt8[]& path) {
    return macos.create_dir(path);
}

public Bool create_dirs(UInt8[]& path) {
    return macos.create_dirs(path);
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return macos.write_file_all(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    return macos.read_file_all(fd);
}

public Bool close_file(Int32 fd) {
    return macos.close_file(fd);
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    macos.memory_copy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    macos.memory_set(dest, value, count);
}

public () exit_process(Int code) {
    macos.exit_process(code);
}

public () abort_process() {
    macos.abort_process();
}

public () trap() {
    macos.trap();
}

public UInt8[:0]&? environment_value(UInt8[]& name) {
    return macos.environment_value(name);
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    return macos.spawn_wait(executable, args);
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    return macos.spawn_wait(executable, args, options);
}
