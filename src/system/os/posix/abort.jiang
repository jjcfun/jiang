// Shared POSIX hosted abort/exit provider implementation.
//
// exit/abort 是 hosted compatibility 路径；no-libc startup/syscall 路径不能
// 通过这个模块间接依赖 libc。

import c = "./c.jiang";

public () exit_process(Int code) {
    c.exit(Int32(code));
}

public () abort_process() {
    c.abort();
}

public () trap() {
    c.abort();
}
