// POSIX hosted ABI declarations shared by Unix-like compatibility providers.
//
// 这里仍然是 hosted compatibility 边界，不是 Jiang system API。平台 provider
// 可以复用这些声明实现共同语义；no-libc provider 不能依赖这个模块。

extern {
    public Int32 open(UInt8[*:0] path, Int32 flags);
    public Int32 creat(UInt8[*:0] path, Int32 mode);
    public Int read(Int32 fd, UInt8[*] data, Int count);
    public Int write(Int32 fd, UInt8[*] data, Int count);
    public () memcpy(UInt8[*] dest, UInt8[*] source, Int count);
    public () memset(UInt8[*] dest, Int value, Int count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 access(UInt8[*:0] path, Int32 mode);
    public Int32 mkdir(UInt8[*:0] path, Int32 mode);
    public CDir* opendir(UInt8[*:0] path);
    public Int32 closedir(CDir* dir);
    public () exit(Int32 code);
    public () abort();
}

public struct CDir {}
