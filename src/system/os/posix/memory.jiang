// Shared POSIX hosted memory provider implementation.
//
// 这里的 memcpy/memset 来自 hosted C/POSIX ABI。no-libc provider 后续应改用
// compiler intrinsic、inline asm 或 target runtime object。

import c = "./c.jiang";

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    c.memcpy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    c.memset(dest, value, count);
}
