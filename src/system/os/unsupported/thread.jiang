// src/system 私有层 为尚无 runtime provider 的 target 提供线程能力占位接口。

public struct Mutex: Copyable {
    UInt8* handle;
    public init(self, UInt8* handle) { self.handle = handle; }
}

public struct Queue: Copyable {
    Void* handle;
    public init(self, Void* handle) { self.handle = handle; }
}

public struct Group: Copyable {
    Void* handle;
    public init(self, Void* handle) { self.handle = handle; }
}

public struct AtomicStackArray: Copyable {
    UInt8* handle;
    public init(self, UInt8* handle) { self.handle = handle; }
}

public Bool supported() { return false; }
public Bool initialize_main_thread() { return true; }
public Bool is_main_thread() { return false; }
public UInt8* allocate_storage(Int size) { return null; }
public UInt8* reallocate_storage(UInt8* pointer, Int size) { return null; }
public Void deallocate_storage(UInt8* pointer) {}
public Mutex create_mutex() { return Mutex(null); }
public Bool mutex_valid(Mutex mutex) { return false; }
public Void* mutex_handle(Mutex mutex) { return null; }
public Mutex mutex_from_handle(Void* handle) { return Mutex(null); }
public Void destroy_mutex(Mutex mutex) {}
public Void lock(Mutex mutex) {}
public Void unlock(Mutex mutex) {}
public AtomicStackArray create_atomic_stack_array(Int count) { return AtomicStackArray(null); }
public Bool atomic_stack_array_valid(AtomicStackArray stacks) { return false; }
public Void* atomic_stack_array_handle(AtomicStackArray stacks) { return null; }
public AtomicStackArray atomic_stack_array_from_handle(Void* handle) { return AtomicStackArray(null); }
public Void destroy_atomic_stack_array(AtomicStackArray stacks) {}
public Void atomic_stack_push(AtomicStackArray stacks, Int index, UInt8* node) {}
public UInt8* atomic_stack_pop(AtomicStackArray stacks, Int index) { return null; }
public Queue concurrent_queue() { return Queue(null); }
public Queue serial_queue() { return Queue(null); }
public Queue main_queue() { return Queue(null); }
public Void destroy_queue(Queue queue, Bool concurrent) {}
public Void* queue_handle(Queue queue) { return null; }
public Void set_queue_identity(Queue queue, Void* identity) {}
public Bool has_queue_identity(Void* identity) { return false; }
public Void* enter_thread_identity(Void* identity) { return null; }
public Void leave_thread_identity(Void* previous) {}
public Bool has_thread_identity(Void* identity) { return false; }
public Group create_group() { return Group(null); }
public Void destroy_group(Group group) {}
public Void* group_handle(Group group) { return group.handle; }
public Group group_from_handle(Void* handle) { return Group(handle); }
public Bool enqueue(Group group, Queue queue, Void* context, Void* callback) { return false; }
public Bool enqueue_task(
    Group group,
    Queue queue,
    UInt8* storage,
    Void* context,
    Void* callback
) { return false; }
public Bool enter_group(Group group) { return false; }
public Void leave_group(Group group) {}
public Void wait_group(Group group) {}
public Bool pump_main_queue_once() { return false; }
public Void wait_word(Int*! pointer, Int expected) {}
public Void wake_word(Int*! pointer) {}
public Void shutdown() {}
