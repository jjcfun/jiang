// macOS hosted target provider.
//
// 这个模块承载 macOS target 的 provider-facing API。外层 system 仍按能力
// 拆分；OS provider 内部按 target 收敛，低层 hosted ABI 保留在 macos/libc.jiang。

import c = "./macos/libc.jiang";
import c_string = "../../support/c_string.jiang";
import list = "../../support/list.jiang";
import posix = "./posix.jiang";

public alias SpawnResult = posix.SpawnResult;
public alias SpawnOptions = posix.SpawnOptions;

public Int32? open_read(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.open(c_path$.as(UInt8[*:0]), 0);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Int32? open_write(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.creat(c_path$.as(UInt8[*:0]), 438);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Bool exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    return c.access(c_path$.as(UInt8[*:0]), 0) == 0;
}

public Bool file_exists(UInt8[]& path) {
    guard open_read(path) is .some(fd) else { return false; }
    close_file(fd);
    return true;
}

public Bool dir_exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    c.CDir* handle = c.opendir(c_path$.as(UInt8[*:0]));
    if (handle == null) {
        return false;
    }
    c.closedir(handle);
    return true;
}

public Bool create_dir(UInt8[]& path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8![*] c_path = c_string.from_slice(path);
    if (c.mkdir(c_path$.as(UInt8[*:0]), 493) == 0) {
        return true;
    }
    return dir_exists(path);
}

public Bool create_dirs(UInt8[]& path) {
    if (path.length == 0) {
        return true;
    }

    Int! index = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return write_fd(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    Int64 size = c.lseek(fd, 0, 2);
    if (size < 0) {
        return null;
    }
    if (c.lseek(fd, 0, 0) < 0) {
        return null;
    }

    Int length = Int(size);
    UInt8![*] bytes = UInt8!$.alloc_many(length + 1);
    Int! read_count = 0;
    if (length > 0) {
        read_count = c.read(fd, bytes$.as(UInt8[*]), length);
    }
    if (read_count != length) {
        return null;
    }
    bytes[length] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..length];
}

public Bool close_file(Int32 fd) {
    return c.close(fd) == 0;
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    c.memcpy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    c.memset(dest, value, count);
}

public () exit_process(Int code) {
    c.exit(Int32(code));
}

public () abort_process() {
    c.abort();
}

public () trap() {
    c.abort();
}

public UInt8[:0]&? environment_value(UInt8[]& name) {
    UInt8![*] c_name = c_string.from_slice(name);
    UInt8[*:0] value = c.getenv(c_name$.as(UInt8[*:0]));
    c_name$.free();
    if (value == null) {
        return null;
    }
    return value[0..c_string_length(value)]$.as(UInt8[:0]&);
}

public RawPointer<UInt8> dynamic_library_open(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    RawPointer<UInt8> handle = c.dlopen(c_path$.as(UInt8[*:0]), Int32(1));
    c_path$.free();
    return handle;
}

public RawPointer<UInt8> dynamic_library_symbol(RawPointer<UInt8> handle, UInt8[]& name) {
    UInt8![*] c_name = c_string.from_slice(name);
    RawPointer<UInt8> symbol = c.dlsym(handle, c_name$.as(UInt8[*:0]));
    c_name$.free();
    return symbol;
}

public Bool dynamic_library_close(RawPointer<UInt8> handle) {
    return c.dlclose(handle) == 0;
}

public UInt8[:0]&? dynamic_library_error() {
    UInt8[*:0] message = c.dlerror();
    if (message == null) {
        return null;
    }
    return message[0..c_string_length(message)]$.as(UInt8[:0]&);
}

// `args` 只借用到本次调用结束。macOS provider 会把每个 slice 复制成 C argv，
// 因此不会把调用方的 ArrayList 或其中的元素引用保存到 posix_spawnp 返回之后。
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    return posix.spawn_wait(executable, args);
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    return posix.spawn_wait(executable, args, options);
}

Bool write_fd(Int32 fd, UInt8[]& bytes) {
    if (bytes.length == 0) {
        return true;
    }
    Int written = c.write(fd, bytes[0]$.addr()$.as(UInt8[*]), bytes.length);
    return written == bytes.length;
}

Int first_segment_start(UInt8[]& path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
