// macOS system provider.
//
// 当前实现仍通过 libSystem/C ABI 完成文件系统和 fd 写入；这是 macOS provider 的
// 实现细节。system/fs.jiang 与 system/io.jiang 只依赖这里暴露的语义化函数集合。

import c = "../c.jiang";
import c_string = "../../support/c_string.jiang";
import list = "../../support/list.jiang";

public struct SpawnResult {
    public Bool started;
    public Int exit_code;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }
}

public Int32? open_read(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.open(c_path$.as(UInt8[*:0]), 0);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Int32? open_write(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.creat(c_path$.as(UInt8[*:0]), 438);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Bool exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    return c.access(c_path$.as(UInt8[*:0]), 0) == 0;
}

public Bool file_exists(UInt8[]& path) {
    guard open_read(path) is some fd else { return false; }
    close_file(fd);
    return true;
}

public Bool dir_exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    c.CDir* handle = c.opendir(c_path$.as(UInt8[*:0]));
    if (handle == null) {
        return false;
    }
    c.closedir(handle);
    return true;
}

public Bool create_dir(UInt8[]& path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8![*] c_path = c_string.from_slice(path);
    if (c.mkdir(c_path$.as(UInt8[*:0]), 493) == 0) {
        return true;
    }
    return dir_exists(path);
}

// 递归创建目录，语义上是幂等操作；已经存在的目录视为成功。
public Bool create_dirs(UInt8[]& path) {
    if (path.length == 0) {
        return true;
    }

    Int! index = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

public Int argument_count() {
    Int* argc = c._NSGetArgc();
    if (argc == null) {
        return 0;
    }
    return argc[0];
}

public UInt8[*:0][*] argument_values() {
    UInt8[*:0][*]* argv = c._NSGetArgv();
    if (argv == null) {
        return null;
    }
    return argv[0];
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return write_fd(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    Int64 size = c.lseek(fd, 0, 2);
    if (size < 0) {
        return null;
    }
    if (c.lseek(fd, 0, 0) < 0) {
        return null;
    }

    Int length = Int(size);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int! read_count = 0;
    if (length > 0) {
        read_count = c.read(fd, bytes$.as(UInt8[*]), length);
    }
    if (read_count != length) {
        return null;
    }
    bytes[length] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..length];
}

public Bool close_file(Int32 fd) {
    return c.close(fd) == 0;
}

// `args` 只借用到本次调用结束。macOS provider 会把每个 slice 复制成 C argv，
// 因此不会把调用方的 ArrayList 或其中的元素引用保存到 posix_spawnp 返回之后。
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = argv_array(executable, args);
    UInt8[*:0]![*] envp = inherited_environment();
    Int argv_count = args.len() + 1;

    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = c.posix_spawnp(
        pid$.as(Int32[*]),
        argv[0],
        0,
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        free_argv(argv, argv_count);
        pid$.free();
        return SpawnResult(false, Int(spawn_result));
    }

    Int32![*] status = Int32!$.alloc_array(1);
    if (c.waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        free_argv(argv, argv_count);
        pid$.free();
        status$.free();
        return SpawnResult(false, -1);
    }
    Int exit_code = exit_code_from_status(status[0]);
    free_argv(argv, argv_count);
    pid$.free();
    status$.free();
    return SpawnResult(true, exit_code);
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    c.memcpy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    c.memset(dest, value, count);
}

Bool write_fd(Int32 fd, UInt8[]& bytes) {
    if (bytes.length == 0) {
        return true;
    }
    Int written = c.write(fd, bytes[0]$.addr()$.as(UInt8[*]), bytes.length);
    return written == bytes.length;
}

UInt8[*:0]![*] argv_array(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = c.calloc(args.len() + 2, UInt8*$.size());
    UInt8![*] executable_arg = c_string.from_slice(executable);
    argv[0] = executable_arg$.as(UInt8[*:0]);
    Int! index = 0;
    while (index < args.len()) {
        UInt8![*] arg = c_string.from_slice(args.get(index));
        argv[index + 1] = arg$.as(UInt8[*:0]);
        index = index + 1;
    }
    return argv;
}

() free_argv(UInt8[*:0]![*] argv, Int count) {
    Int! index = 0;
    while (index < count) {
        argv[index]$.free();
        index = index + 1;
    }
    argv$.free();
}

UInt8[*:0]![*] inherited_environment() {
    // posix_spawnp 需要显式 envp。传 environ 才能继承 PATH/SDKROOT 等变量，
    // 让 linker driver 名称（例如 cc）按调用进程的环境解析。
    return c.environ;
}

Int exit_code_from_status(Int32 status) {
    return Int((status >> 8) & 255);
}

Int first_segment_start(UInt8[]& path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

UInt8[*] c_string_view(UInt8[]& text) {
    return c_string.view(text);
}
