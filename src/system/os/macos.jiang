// macOS hosted target provider.
//
// 这个模块承载 macOS target 的 provider-facing API。外层 system 仍按能力
// 拆分；OS provider 内部按 target 收敛，低层 hosted ABI 保留在 macos/libc.jiang。

import c = "./macos/libc.jiang";
import c_string = "../../support/c_string.jiang";
import list = "../../support/list.jiang";

public struct SpawnResult {
    public Bool started;
    public Int exit_code;
    public UInt8[]&! stdout;
    public UInt8[]&! stderr;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = "";
        self.stderr = "";
    }

    public init(Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions {
    public Bool capture_stdout;
    public Bool capture_stderr;
    public Bool discard_stderr;

    public init() {
        self.capture_stdout = false;
        self.capture_stderr = false;
        self.discard_stderr = false;
    }
}

public Int32? open_read(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.open(c_path$.as(UInt8[*:0]), 0);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Int32? open_write(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = c.creat(c_path$.as(UInt8[*:0]), 438);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Bool exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    return c.access(c_path$.as(UInt8[*:0]), 0) == 0;
}

public Bool file_exists(UInt8[]& path) {
    guard open_read(path) is .some(fd) else { return false; }
    close_file(fd);
    return true;
}

public Bool dir_exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    c.CDir* handle = c.opendir(c_path$.as(UInt8[*:0]));
    if (handle == null) {
        return false;
    }
    c.closedir(handle);
    return true;
}

public Bool create_dir(UInt8[]& path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8![*] c_path = c_string.from_slice(path);
    if (c.mkdir(c_path$.as(UInt8[*:0]), 493) == 0) {
        return true;
    }
    return dir_exists(path);
}

public Bool create_dirs(UInt8[]& path) {
    if (path.length == 0) {
        return true;
    }

    Int! index = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return write_fd(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    Int64 size = c.lseek(fd, 0, 2);
    if (size < 0) {
        return null;
    }
    if (c.lseek(fd, 0, 0) < 0) {
        return null;
    }

    Int length = Int(size);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int! read_count = 0;
    if (length > 0) {
        read_count = c.read(fd, bytes$.as(UInt8[*]), length);
    }
    if (read_count != length) {
        return null;
    }
    bytes[length] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..length];
}

public Bool close_file(Int32 fd) {
    return c.close(fd) == 0;
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    c.memcpy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    c.memset(dest, value, count);
}

public () exit_process(Int code) {
    c.exit(Int32(code));
}

public () abort_process() {
    c.abort();
}

public () trap() {
    c.abort();
}

public UInt8[:0]&? environment_value(UInt8[]& name) {
    UInt8![*] c_name = c_string.from_slice(name);
    UInt8[*:0] value = c.getenv(c_name$.as(UInt8[*:0]));
    c_name$.free();
    if (value == null) {
        return null;
    }
    return value[0..c_string_length(value)]$.as(UInt8[:0]&);
}

// `args` 只借用到本次调用结束。macOS provider 会把每个 slice 复制成 C argv，
// 因此不会把调用方的 ArrayList 或其中的元素引用保存到 posix_spawnp 返回之后。
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    SpawnOptions options = SpawnOptions();
    return spawn_wait(executable, args, options$.ref());
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    if (!options.capture_stdout && !options.capture_stderr && !options.discard_stderr) {
        return spawn_wait_inherit(executable, args);
    }
    if (options.capture_stderr) {
        return SpawnResult(false, -1);
    }
    if (options.capture_stdout) {
        return spawn_wait_stdout_pipe(executable, args, options.discard_stderr);
    }
    return SpawnResult(false, -1);
}

SpawnResult spawn_wait_inherit(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = argv_array(executable, args);
    UInt8[*:0]![*] envp = inherited_environment();
    Int argv_count = args.len() + 1;
    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = c.posix_spawnp(
        pid$.as(Int32[*]),
        argv[0],
        0,
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        free_argv(argv, argv_count);
        pid$.free();
        return SpawnResult(false, Int(spawn_result));
    }

    Int32![*] status = Int32!$.alloc_array(1);
    if (c.waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        free_argv(argv, argv_count);
        pid$.free();
        status$.free();
        return SpawnResult(false, -1);
    }
    Int exit_code = exit_code_from_status(status[0]);
    free_argv(argv, argv_count);
    pid$.free();
    status$.free();
    return SpawnResult(true, exit_code);
}

SpawnResult spawn_wait_stdout_pipe(
    UInt8[]& executable,
    list.ArrayList<UInt8[]&>& args,
    Bool discard_stderr
) {
    UInt8[*:0]![*] argv = argv_array(executable, args);
    UInt8[*:0]![*] envp = inherited_environment();
    Int argv_count = args.len() + 1;
    PipeCapture! stdout_capture = PipeCapture();
    if (!stdout_capture.open(discard_stderr)) {
        free_argv(argv, argv_count);
        return SpawnResult(false, -1);
    }
    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = c.posix_spawnp(
        pid$.as(Int32[*]),
        argv[0],
        stdout_capture.file_actions()$.as(Int),
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        stdout_capture.close_parent();
        free_argv(argv, argv_count);
        pid$.free();
        return SpawnResult(false, Int(spawn_result));
    }
    stdout_capture.close_child_end();
    UInt8[]& stdout = stdout_capture.read_all();
    Int32![*] status = Int32!$.alloc_array(1);
    if (c.waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        stdout_capture.close_parent();
        free_argv(argv, argv_count);
        pid$.free();
        status$.free();
        return SpawnResult(false, -1);
    }
    Int exit_code = exit_code_from_status(status[0]);
    stdout_capture.close_parent();
    free_argv(argv, argv_count);
    pid$.free();
    status$.free();
    return SpawnResult(true, exit_code, stdout, "");
}

struct PipeCapture: Movable {
    Int32! read_fd;
    Int32! write_fd;
    Int32! discard_fd;
    UInt8*![*]! actions;

    init() {
        self.read_fd = Int32(-1);
        self.write_fd = Int32(-1);
        self.discard_fd = Int32(-1);
        self.actions = null;
    }

    Bool open(Bool discard_stderr) {
        Int32![*] fds = Int32!$.alloc_array(2);
        if (c.pipe(fds$.as(Int32[*])) != 0) {
            fds$.free();
            return false;
        }
        self.read_fd = fds[0];
        self.write_fd = fds[1];
        fds$.free();
        UInt8*![*]! raw = UInt8*$.alloc_array(1);
        raw[0] = null;
        if (c.posix_spawn_file_actions_init(raw) != 0) {
            raw$.free();
            self.close_parent();
            return false;
        }
        if (c.posix_spawn_file_actions_adddup2(raw, self.write_fd, Int32(1)) != 0) {
            c.posix_spawn_file_actions_destroy(raw);
            raw$.free();
            self.close_parent();
            return false;
        }
        c.posix_spawn_file_actions_addclose(raw, self.read_fd);
        if (discard_stderr && !self.add_stderr_discard(raw)) {
            c.posix_spawn_file_actions_destroy(raw);
            raw$.free();
            self.close_parent();
            return false;
        }
        self.actions = raw;
        return true;
    }

    Bool add_stderr_discard(UInt8*![*] raw) {
        UInt8![*] dev_null = c_string.from_slice("/dev/null");
        Int32 fd = c.open(dev_null$.as(UInt8[*:0]), 1);
        dev_null$.free();
        if (fd < 0) {
            return false;
        }
        self.discard_fd = fd;
        if (c.posix_spawn_file_actions_adddup2(raw, self.discard_fd, Int32(2)) != 0) {
            return false;
        }
        c.posix_spawn_file_actions_addclose(raw, self.discard_fd);
        return true;
    }

    UInt8*![*] file_actions() {
        return self.actions;
    }

    () close_child_end() {
        if (self.write_fd >= 0) {
            c.close(self.write_fd);
            self.write_fd = Int32(-1);
        }
        if (self.discard_fd >= 0) {
            c.close(self.discard_fd);
            self.discard_fd = Int32(-1);
        }
        self.destroy_actions();
    }

    () close_parent() {
        if (self.read_fd >= 0) {
            c.close(self.read_fd);
            self.read_fd = Int32(-1);
        }
        if (self.write_fd >= 0) {
            c.close(self.write_fd);
            self.write_fd = Int32(-1);
        }
        if (self.discard_fd >= 0) {
            c.close(self.discard_fd);
            self.discard_fd = Int32(-1);
        }
        self.destroy_actions();
    }

    UInt8[]& read_all() {
        if (self.read_fd < 0) {
            return "";
        }
        Int! capacity = 4096;
        Int! length = 0;
        UInt8![*]! buffer = UInt8!$.alloc_array(capacity + 1);
        while (true) {
            if (length + 1024 + 1 > capacity) {
                capacity = capacity * 2;
                UInt8![*] next = UInt8!$.alloc_array(capacity + 1);
                copy_bytes(next, buffer, length);
                buffer$.free();
                buffer = next;
            }
            Int count = c.read(self.read_fd, buffer[length..(length + 1024)]$.ptr(), 1024);
            if (count <= 0) {
                buffer[length] = 0;
                return buffer[0..length];
            }
            length = length + count;
        }
        return "";
    }

    () destroy_actions() {
        if (self.actions != null) {
            c.posix_spawn_file_actions_destroy(self.actions);
            self.actions$.free();
            self.actions = null;
        }
    }
}

Bool write_fd(Int32 fd, UInt8[]& bytes) {
    if (bytes.length == 0) {
        return true;
    }
    Int written = c.write(fd, bytes[0]$.addr()$.as(UInt8[*]), bytes.length);
    return written == bytes.length;
}

Int first_segment_start(UInt8[]& path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

() copy_bytes(UInt8![*] dest, UInt8![*] source, Int length) {
    Int! index = 0;
    while (index < length) {
        dest[index] = source[index];
        index = index + 1;
    }
}

UInt8[*:0]![*] argv_array(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = c.calloc(args.len() + 2, UInt8*$.size());
    UInt8![*] executable_arg = c_string.from_slice(executable);
    argv[0] = executable_arg$.as(UInt8[*:0]);
    Int! index = 0;
    while (index < args.len()) {
        UInt8![*] arg = c_string.from_slice(args.get(index));
        argv[index + 1] = arg$.as(UInt8[*:0]);
        index = index + 1;
    }
    return argv;
}

() free_argv(UInt8[*:0]![*] argv, Int count) {
    Int! index = 0;
    while (index < count) {
        argv[index]$.free();
        index = index + 1;
    }
    argv$.free();
}

UInt8[*:0]![*] inherited_environment() {
    // posix_spawnp 需要显式 envp。传 environ 才能继承 PATH/SDKROOT 等变量，
    // 让 linker driver 名称（例如 cc）按调用进程的环境解析。
    return c.environ;
}

Int exit_code_from_status(Int32 status) {
    return Int((status >> 8) & 255);
}
