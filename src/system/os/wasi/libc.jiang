// WASI libc ABI declarations used by the wasi provider.
//
// 这里依赖 wasi-libc 暴露的 C ABI。system/os/wasi.jiang 提供语义化边界，
// 上层不直接依赖这些函数。

extern {
    public UInt16 __wasi_args_sizes_get(UInt32[*] argc, UInt32[*] argv_buf_size);
    public UInt16 __wasi_args_get(UInt8[*:0][*] argv, UInt8[*] argv_buf);
    public Int32 open(UInt8[*:0] path, Int32 flags, Int32 mode);
    public Int32 creat(UInt8[*:0] path, Int32 mode);
    public Int32 read(Int32 fd, UInt8[*] data, Int32 count);
    public Int32 write(Int32 fd, UInt8[*] data, Int32 count);
    public UInt8[*] memcpy(UInt8[*] dest, UInt8[*] source, Int32 count);
    public UInt8[*] memset(UInt8[*] dest, Int32 value, Int32 count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 access(UInt8[*:0] path, Int32 mode);
    public Int32 mkdir(UInt8[*:0] path, Int32 mode);
    public UInt8[*:0] getenv(UInt8[*:0] name);
    public () exit(Int32 code);
    public () abort();
}
