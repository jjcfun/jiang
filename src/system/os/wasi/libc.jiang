// WASI libc ABI declarations used by the wasi provider.
//
// 这里依赖 wasi-libc 暴露的 C ABI。system/os/wasi.jiang 提供语义化边界，
// 上层不直接依赖这些函数。

extern {
    public UInt16 __wasi_args_sizes_get(UInt32* argc, UInt32* argv_buf_size);
    public UInt16 __wasi_args_get(UInt8** argv, UInt8* argv_buf);
    public UInt16 __wasi_clock_time_get(UInt32 clock_id, UInt64 precision, UInt64* value);
    public Int32 open(UInt8* path, Int32 flags, Int32 mode);
    public Int32 creat(UInt8* path, Int32 mode);
    public Int32 read(Int32 fd, UInt8* data, Int32 count);
    public Int32 write(Int32 fd, UInt8* data, Int32 count);
    public UInt8* memcpy(UInt8* dest, UInt8* source, Int32 count);
    public UInt8* memset(UInt8* dest, Int32 value, Int32 count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 access(UInt8* path, Int32 mode);
    public Int32 mkdir(UInt8* path, Int32 mode);
    public Int32 rename(UInt8* old_path, UInt8* new_path);
    public Int32 unlink(UInt8* path);
    public UInt8* getenv(UInt8* name);
    public Void exit(Int32 code);
    public Void abort();
}
