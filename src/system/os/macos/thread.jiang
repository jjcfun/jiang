// libdispatch-backed execution provider for hosted macOS.

import c = "./libc.jiang";

public struct Mutex {
    UInt8* handle;

    public init(self, UInt8* handle) {
        self.handle = handle;
    }
}

public struct Queue {
    UInt8* handle;

    public init(self, UInt8* handle) {
        self.handle = handle;
    }
}

public struct Group {
    UInt8* handle;

    public init(self, UInt8* handle) {
        self.handle = handle;
    }
}

public Bool supported() {
    return true;
}

public UInt8* allocate_storage(Int size) {
    return unsafe { c.malloc_zone_malloc(c.malloc_default_zone(), size) };
}

public UInt8* reallocate_storage(UInt8* pointer, Int size) {
    return unsafe { c.malloc_zone_realloc(c.malloc_default_zone(), pointer, size) };
}

public () deallocate_storage(UInt8* pointer) {
    unsafe { c.malloc_zone_free(c.malloc_default_zone(), pointer); }
}

public Mutex create_mutex() {
    UInt8* storage = allocate_storage(UInt32$.size());
    if (storage == null) { return Mutex(null); }
    UInt32!* state = unsafe { storage$.as(UInt32!*) };
    unsafe { state$.set(UInt32(0)); }
    return Mutex(storage);
}

public Bool mutex_valid(Mutex mutex) {
    return mutex.handle != null;
}

public () destroy_mutex(Mutex mutex) {
    deallocate_storage(mutex.handle);
}

public () lock(Mutex mutex) {
    unsafe { c.os_unfair_lock_lock(mutex.handle); }
}

public () unlock(Mutex mutex) {
    unsafe { c.os_unfair_lock_unlock(mutex.handle); }
}

public Queue concurrent_queue() {
    return Queue(unsafe { c.dispatch_get_global_queue(0, 0) });
}

public Queue serial_queue() {
    return Queue(unsafe { c.dispatch_queue_create("jiang.serial-domain", null) });
}

public UInt8* queue_handle(Queue queue) {
    return queue.handle;
}

public Group create_group() {
    return Group(unsafe { c.dispatch_group_create() });
}

public Bool enqueue(Group group, Queue queue, UInt8* context, UInt8* callback) {
    if (group.handle == null || queue.handle == null) { return false; }
    unsafe { c.dispatch_group_async_f(group.handle, queue.handle, context, callback); }
    return true;
}

public () wait_group(Group group) {
    if (group.handle == null) { return; }
    unsafe { c.dispatch_group_wait(group.handle, UInt64(18446744073709551615)); }
}
