// macOS hosted process provider.

import c = "./c.jiang";
import c_string = "../../../support/c_string.jiang";
import list = "../../../support/list.jiang";

public struct SpawnResult {
    public Bool started;
    public Int exit_code;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }
}

public Int argument_count() {
    Int* argc = c._NSGetArgc();
    if (argc == null) {
        return 0;
    }
    return argc[0];
}

public UInt8[*:0][*] argument_values() {
    UInt8[*:0][*]* argv = c._NSGetArgv();
    if (argv == null) {
        return null;
    }
    return argv[0];
}

// `args` 只借用到本次调用结束。macOS provider 会把每个 slice 复制成 C argv，
// 因此不会把调用方的 ArrayList 或其中的元素引用保存到 posix_spawnp 返回之后。
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = argv_array(executable, args);
    UInt8[*:0]![*] envp = inherited_environment();
    Int argv_count = args.len() + 1;

    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = c.posix_spawnp(
        pid$.as(Int32[*]),
        argv[0],
        0,
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        free_argv(argv, argv_count);
        pid$.free();
        return SpawnResult(false, Int(spawn_result));
    }

    Int32![*] status = Int32!$.alloc_array(1);
    if (c.waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        free_argv(argv, argv_count);
        pid$.free();
        status$.free();
        return SpawnResult(false, -1);
    }
    Int exit_code = exit_code_from_status(status[0]);
    free_argv(argv, argv_count);
    pid$.free();
    status$.free();
    return SpawnResult(true, exit_code);
}

UInt8[*:0]![*] argv_array(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = c.calloc(args.len() + 2, UInt8*$.size());
    UInt8![*] executable_arg = c_string.from_slice(executable);
    argv[0] = executable_arg$.as(UInt8[*:0]);
    Int! index = 0;
    while (index < args.len()) {
        UInt8![*] arg = c_string.from_slice(args.get(index));
        argv[index + 1] = arg$.as(UInt8[*:0]);
        index = index + 1;
    }
    return argv;
}

() free_argv(UInt8[*:0]![*] argv, Int count) {
    Int! index = 0;
    while (index < count) {
        argv[index]$.free();
        index = index + 1;
    }
    argv$.free();
}

UInt8[*:0]![*] inherited_environment() {
    // posix_spawnp 需要显式 envp。传 environ 才能继承 PATH/SDKROOT 等变量，
    // 让 linker driver 名称（例如 cc）按调用进程的环境解析。
    return c.environ;
}

Int exit_code_from_status(Int32 status) {
    return Int((status >> 8) & 255);
}
