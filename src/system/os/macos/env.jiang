// macOS hosted environment provider.

import c = "./c.jiang";
import c_string = "../../../support/c_string.jiang";

public UInt8[:0]&? environment_value(UInt8[]& name) {
    UInt8![*] c_name = c_string.from_slice(name);
    UInt8[*:0] value = c.getenv(c_name$.as(UInt8[*:0]));
    c_name$.free();
    if (value == null) {
        return null;
    }
    return value[0..c_string_length(value)]$.as(UInt8[:0]&);
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
