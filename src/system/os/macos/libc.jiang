// C/libSystem ABI declarations used by the current macOS hosted provider.
//
// 这里是 compatibility 边界，不是 Jiang system API。上层必须通过
// system/os/macos.jiang 或 system/* 使用语义化能力，不能直接依赖这些 C 函数形状。

extern {
    public Int32 open(UInt8* path, Int32 flags);
    public Int32 creat(UInt8* path, Int32 mode);
    public Int read(Int32 fd, UInt8* data, Int count);
    public Int write(Int32 fd, UInt8* data, Int count);
    public () memcpy(UInt8* dest, UInt8* source, Int count);
    public () memset(UInt8* dest, Int value, Int count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 fstat(Int32 fd, UInt8* status);
    public Int32 access(UInt8* path, Int32 mode);
    public Int32 mkdir(UInt8* path, Int32 mode);
    public Int32 rename(UInt8* old_path, UInt8* new_path);
    public Int32 unlink(UInt8* path);
    public Int32 rmdir(UInt8* path);
    public Int32 flock(Int32 fd, Int32 operation);
    public Int32 getpid();
    public Int sysconf(Int32 name);
    public Int32 clock_gettime(Int32 clock_id, Int64* value);
    public CDir* opendir(UInt8* path);
    public UInt8* readdir(CDir* dir);
    public Int32 closedir(CDir* dir);
    public Void* dlopen(UInt8* path, Int32 mode);
    public Void* dlsym(Void* handle, UInt8* symbol);
    public UInt8* dlerror();
    public Int32 dlclose(Void* handle);
    public Int32 pipe(Int32* fds);
    public Int32 dup2(Int32 oldfd, Int32 newfd);
    public Int32 fcntl(Int32 fd, Int32 command, Int32 value);
    public Int32* __error();

    public UInt8**! calloc(Int count, Int size);
    public Void* malloc_default_zone();
    public UInt8* malloc_zone_malloc(Void* zone, Int size);
    public UInt8* malloc_zone_realloc(Void* zone, UInt8* pointer, Int size);
    public () malloc_zone_free(Void* zone, UInt8* pointer);
    public UInt8**! environ;
    public Int32 posix_spawn_file_actions_init(UInt64* actions);
    public Int32 posix_spawn_file_actions_adddup2(UInt64* actions, Int32 fd, Int32 newfd);
    public Int32 posix_spawn_file_actions_addclose(UInt64* actions, Int32 fd);
    public Int32 posix_spawn_file_actions_destroy(UInt64* actions);
    public Int32 posix_spawnp(
        Int32* pid,
        UInt8* path,
        UInt64* file_actions,
        Void* attr,
        UInt8**! argv,
        UInt8**! envp
    );
    public Int32 waitpid(Int32 pid, Int32* status, Int32 options);
    public () os_unfair_lock_lock(UInt8* lock);
    public () os_unfair_lock_unlock(UInt8* lock);
    public () OSAtomicEnqueue(UInt8* head, Void* node, Int offset);
    public Void* OSAtomicDequeue(UInt8* head, Int offset);
    public Int32 __ulock_wait(UInt32 operation, Void* address, UInt64 value, UInt32 timeout);
    public Int32 __ulock_wake(UInt32 operation, Void* address, UInt64 wake_value);
    public Void* dispatch_get_global_queue(Int identifier, UInt64 flags);
    public Void* dispatch_queue_create(UInt8* label, Void* attributes);
    public () dispatch_async_f(Void* queue, Void* context, Void* callback);
    public () dispatch_queue_set_specific(
        Void* queue,
        Void* key,
        Void* context,
        Void* destructor
    );
    public Void* dispatch_get_specific(Void* key);
    public Void* dispatch_group_create();
    public () dispatch_release(Void* object);
    public () dispatch_group_async_f(
        Void* group,
        Void* queue,
        Void* context,
        Void* callback
    );
    public () dispatch_group_enter(Void* group);
    public () dispatch_group_leave(Void* group);
    public Int dispatch_group_wait(Void* group, UInt64 timeout);
    public UInt64 dispatch_time(UInt64 when, Int64 delta);
    public Void* pthread_self();
    public Int32 pthread_equal(Void* left, Void* right);
    public UInt8* getenv(UInt8* name);
    public () exit(Int32 code);
    public () abort();
}

public struct CDir: Copyable {}
