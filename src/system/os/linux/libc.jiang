// Linux compatibility provider 使用的 hosted libc ABI 声明。
//
// 这里是 hosted provider 的 ABI 边界，不是 Jiang system API。上层必须通过
// src/system/os/linux.jiang 或 src/system/* 使用语义化能力，不能直接依赖这些 C 函数形状。

extern {
    public Int32 open(UInt8* path, Int32 flags);
    public Int32 creat(UInt8* path, Int32 mode);
    public Int read(Int32 fd, UInt8* data, Int count);
    public Int write(Int32 fd, UInt8* data, Int count);
    public Void memcpy(UInt8* dest, UInt8* source, Int count);
    public Void memset(UInt8* dest, Int value, Int count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 fstat(Int32 fd, UInt8* status);
    public Int32 access(UInt8* path, Int32 mode);
    public Int32 mkdir(UInt8* path, Int32 mode);
    public Int32 rename(UInt8* old_path, UInt8* new_path);
    public Int32 unlink(UInt8* path);
    public Int32 rmdir(UInt8* path);
    public Int32 flock(Int32 fd, Int32 operation);
    public Int32 getpid();
    public Int sysconf(Int32 name);
    public Int32 clock_gettime(Int32 clock_id, Int64* value);
    public Int32 getentropy(UInt8* buffer, UInt size);
    public CDir* opendir(UInt8* path);
    public UInt8* readdir(CDir* dir);
    public Int32 closedir(CDir* dir);
    public Void* dlopen(UInt8* path, Int32 mode);
    public Void* dlsym(Void* handle, UInt8* symbol);
    public UInt8* dlerror();
    public Int32 dlclose(Void* handle);
    public Int32 pipe(Int32* fds);
    public Int32 dup2(Int32 oldfd, Int32 newfd);
    public Int32 fcntl(Int32 fd, Int32 command, Int32 value);
    public Int32*! __errno_location();

    public UInt8**! calloc(Int count, Int size);
    public UInt8* realloc(UInt8* pointer, Int size);
    public UInt8**! environ;
    // 共享 POSIX provider 传入经 Linux ABI probe 验证的 80-byte、8-byte aligned opaque storage。
    public Int32 posix_spawn_file_actions_init(UInt64* actions);
    public Int32 posix_spawn_file_actions_adddup2(UInt64* actions, Int32 fd, Int32 newfd);
    public Int32 posix_spawn_file_actions_addclose(UInt64* actions, Int32 fd);
    public Int32 posix_spawn_file_actions_destroy(UInt64* actions);
    public Int32 posix_spawnp(
        Int32* pid,
        UInt8* path,
        UInt64* file_actions,
        Void* attr,
        UInt8**! argv,
        UInt8**! envp
    );
    public Int32 waitpid(Int32 pid, Int32* status, Int32 options);
    public Int32 pthread_create(UInt* thread, Void* attributes, Void* start, Void* context);
    public Int32 pthread_detach(UInt thread);
    public Int32 pthread_join(UInt thread, Void** result);
    public UInt pthread_self();
    public Int32 pthread_equal(UInt left, UInt right);
    public Int32 pthread_mutex_init(UInt8* mutex, Void* attributes);
    public Int32 pthread_mutex_destroy(UInt8* mutex);
    public Int32 pthread_mutex_lock(UInt8* mutex);
    public Int32 pthread_mutex_unlock(UInt8* mutex);
    public Int32 pthread_cond_init(UInt8* condition, Void* attributes);
    public Int32 pthread_cond_destroy(UInt8* condition);
    public Int32 pthread_cond_wait(UInt8* condition, UInt8* mutex);
    public Int32 pthread_cond_signal(UInt8* condition);
    public Int32 pthread_cond_broadcast(UInt8* condition);
    public Int32 pthread_key_create(UInt32* key, Void* destructor);
    public Int32 pthread_key_delete(UInt32 key);
    public Int32 pthread_setspecific(UInt32 key, Void* value);
    public Void* pthread_getspecific(UInt32 key);
    public Int32 sched_yield();
    public Int syscall(Int number, Int arg0, Int arg1, Int arg2, Int arg3, Int arg4, Int arg5);
    public UInt8* getenv(UInt8* name);
    public Void exit(Int32 code);
    public Void abort();
}

public struct CDir: Copyable {}
