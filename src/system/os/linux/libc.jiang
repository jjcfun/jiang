// Linux hosted libc ABI declarations used by the Linux compatibility provider.
//
// 这里是 hosted provider 的 ABI 边界，不是 Jiang system API。上层必须通过
// system/os/linux.jiang 或 system/* 使用语义化能力，不能直接依赖这些 C 函数形状。

extern {
    public Int32 open(UInt8* path, Int32 flags);
    public Int32 creat(UInt8* path, Int32 mode);
    public Int read(Int32 fd, UInt8* data, Int count);
    public Int write(Int32 fd, UInt8* data, Int count);
    public () memcpy(UInt8* dest, UInt8* source, Int count);
    public () memset(UInt8* dest, Int value, Int count);
    public Int32 close(Int32 fd);
    public Int64 lseek(Int32 fd, Int64 offset, Int32 whence);
    public Int32 access(UInt8* path, Int32 mode);
    public Int32 mkdir(UInt8* path, Int32 mode);
    public CDir* opendir(UInt8* path);
    public Int32 closedir(CDir* dir);
    public Void* dlopen(UInt8* path, Int32 mode);
    public Void* dlsym(Void* handle, UInt8* symbol);
    public UInt8* dlerror();
    public Int32 dlclose(Void* handle);
    public Int32 pipe(Int32* fds);
    public Int32 dup2(Int32 oldfd, Int32 newfd);

    public UInt8**! calloc(Int count, Int size);
    public UInt8**! environ;
    // 仅用于让共享 POSIX 模块通过 type check。当前 Linux hosted provider
    // 不会调用这组 file actions；glibc 的真实结构体布局需要后续单独建模。
    public Int32 posix_spawn_file_actions_init(UInt8** actions);
    public Int32 posix_spawn_file_actions_adddup2(UInt8** actions, Int32 fd, Int32 newfd);
    public Int32 posix_spawn_file_actions_addclose(UInt8** actions, Int32 fd);
    public Int32 posix_spawn_file_actions_destroy(UInt8** actions);
    public Int32 posix_spawnp(
        Int32* pid,
        UInt8* path,
        Int file_actions,
        Int attr,
        UInt8**! argv,
        UInt8**! envp
    );
    public Int32 waitpid(Int32 pid, Int32* status, Int32 options);
    public UInt8* getenv(UInt8* name);
    public () exit(Int32 code);
    public () abort();
}

public struct CDir: Copyable {}
