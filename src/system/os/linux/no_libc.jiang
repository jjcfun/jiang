// Linux no-libc target provider.
//
// 这个 provider 不能 import libc ABI。第一阶段只接入最小 syscall 能力，
// 支撑静态可执行文件的退出和基础 fd 写入；文件系统、进程和动态库能力
// 后续继续补齐。

import build;
import startup = "../../startup.jiang";
import list = "../../../support/list.jiang";

comptime {
    if (build.target.arch == .x86_64) {
        import arch = "./x86_64.jiang";
    } else {
        import arch = "./aarch64.jiang";
    }
}

extern Int __jiang_main();

comptime {
    if (build.target.arch == .x86_64) {
        @link_symbol("_start")
        @naked
        () linux_start() {
            #asm {
                code "movq %rsp, %rdi; callq __jiang_linux_start_from_stack";
                clobber "rdi";
                memory;
                volatile;
                noreturn;
            }
        }
    } else {
        @link_symbol("_start")
        @naked
        () linux_start() {
            #asm {
                code "mov x0, sp; bl __jiang_linux_start_from_stack";
                clobber "x0";
                memory;
                volatile;
                noreturn;
            }
        }
    }
}

@link_symbol("__jiang_linux_start_from_stack")
() linux_start_from_stack(Int stack_pointer) {
    do [unsafe] {
        Int[*] stack = stack_pointer$.as(Int[*]);
        Int argc = stack[0];
        UInt8[*:0][*] argv = stack[1]$.ptr()$.as(UInt8[*:0][*]);
        startup.startup_state = startup.StartupState(startup.ProgramArguments(argc, argv));
    }
    Int exit_code = __jiang_main();
    arch.exit(exit_code);
}

public struct SpawnResult {
    public Bool started;
    public Int exit_code;
    public UInt8[]& stdout = "";
    public UInt8[]& stderr = "";

    public init(self, Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }

    public init(self, Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions {
    public Bool capture_stdout = false;
    public Bool capture_stderr = false;
    public Bool discard_stderr = false;
}

