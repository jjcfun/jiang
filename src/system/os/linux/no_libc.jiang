public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    Int written = arch.write(Int(fd), bytes);
    return written == bytes.length;
}

public UInt8[]&? read_file_all(Int32 fd) {
    return null;
}

public Bool close_file(Int32 fd) {
    return false;
}

@link_symbol("memcpy")
public UInt8[*] memcpy(UInt8[*] dest, UInt8[*] source, Int count) {
    memory_copy(dest, source, count);
    return dest;
}

@link_symbol("memset")
public UInt8[*] memset(UInt8[*] dest, Int value, Int count) {
    memory_set(dest, value, count);
    return dest;
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    UInt8![*] mutable_dest = do [unsafe] {
        dest$.as(UInt8![*])
    };
    Int! index = 0;
    while (index < count) {
        mutable_dest[index] = source[index];
        index = index + 1;
    }
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    UInt8![*] mutable_dest = do [unsafe] {
        dest$.as(UInt8![*])
    };
    UInt8 byte = UInt8(value);
    Int! index = 0;
    while (index < count) {
        mutable_dest[index] = byte;
        index = index + 1;
    }
}

public () exit_process(Int code) {
    arch.exit(code);
}

public () abort_process() {
    trap();
}

public () trap() {
    arch.trap();
}

