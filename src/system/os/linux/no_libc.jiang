// Linux no-libc target provider.
//
// 这个 provider 不能 import libc ABI。第一阶段只接入最小 syscall 能力，
// 支撑静态可执行文件的退出和基础 fd 写入；文件系统、进程和动态库能力
// 后续继续补齐。

import build;
import startup = "../../startup.jiang";
import list = "../../../support/list.jiang";

comptime {
    if (build.target.arch == .x86_64) {
        import arch = "./x86_64.jiang";
    } else {
        import arch = "./aarch64.jiang";
    }
}

extern Int __jiang_main();

comptime {
    if (build.target.arch == .x86_64) {
        @link_symbol("_start")
        @naked
        Void linux_start() {
            #asm {
                code "movq %rsp, %rdi; callq __jiang_linux_start_from_stack";
                clobber "rdi";
                memory;
                volatile;
                noreturn;
            }
        }
    } else {
        @link_symbol("_start")
        @naked
        Void linux_start() {
            #asm {
                code "mov x0, sp; bl __jiang_linux_start_from_stack";
                clobber "x0";
                memory;
                volatile;
                noreturn;
            }
        }
    }
}

@link_symbol("__jiang_linux_start_from_stack")
Void linux_start_from_stack(Int stack_pointer) {
    unsafe {
        Int* stack = stack_pointer$.as(Int*);
        Int argc = stack[0];
        UInt8** argv = stack[1]$.ptr()$.as(UInt8**);
        startup.startup_state = startup.StartupState(startup.ProgramArguments(argc, argv));
    }
    Int exit_code = __jiang_main();
    arch.exit(exit_code);
}

@region(a)
public struct SpawnResult: Copyable {
    public Bool started;
    public Int exit_code;

    @life(a)
    public UInt8[]& stdout = "";

    @life(a)
    public UInt8[]& stderr = "";

    public init(self, Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }

    public init(self, Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions: Copyable {
    public Bool capture_stdout! = false;
    public Bool capture_stderr! = false;
    public Bool discard_stderr! = false;
}

public Int32? open_read(UInt8[]& path) {
    return null;
}

public Int32? open_write(UInt8[]& path) {
    return null;
}

public Bool exists(UInt8[]& path) {
    return false;
}

public Bool file_exists(UInt8[]& path) {
    return false;
}

public Bool dir_exists(UInt8[]& path) {
    return false;
}

public Bool create_dir(UInt8[]& path) {
    return false;
}

public Bool create_dirs(UInt8[]& path) {
    return false;
}

// no-libc hosted compiler 尚未提供 renameat/unlinkat；缓存发布会明确退化为
// unsupported，而不是用非原子 copy 覆盖目标文件。
public Bool atomic_replace(UInt8[]& temporary_path, UInt8[]& final_path) {
    return false;
}

public Bool remove_file(UInt8[]& path) {
    return false;
}

public Bool remove_tree(UInt8[]& path) {
    return false;
}

public Int32? acquire_file_lock(UInt8[]& path) {
    return null;
}

public Void release_file_lock(Int32 fd) {}

public Int process_id() {
    return 0;
}

// no-libc provider 尚未暴露 clock syscall，统计能力明确退化。
public UInt64 monotonic_time_ns() {
    return UInt64(0);
}

public UInt64? monotonic_time_ns_checked() {
    return null;
}

public UInt64? wall_time_ns_checked() {
    return null;
}

public Bool fill_entropy(UInt8[]&! bytes) {
    return bytes.length == 0;
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    Int written = arch.write(Int(fd), bytes);
    return written == bytes.length;
}

@life()
public UInt8[]&? read_file_all(Int32 fd) {
    return null;
}

@life()
public UInt8[]&? read_file_at(Int32 fd, Int offset, Int length) {
    return null;
}

public Int? file_size(Int32 fd) {
    return null;
}

public UInt64? file_modified_ns(Int32 fd) {
    return null;
}

public Bool close_file(Int32 fd) {
    return false;
}

@link_symbol("memcpy")
public UInt8* memcpy(UInt8* dest, UInt8* source, Int count) {
    memory_copy(dest, source, count);
    return dest;
}

@link_symbol("memset")
public UInt8* memset(UInt8* dest, Int value, Int count) {
    memory_set(dest, value, count);
    return dest;
}

public Void memory_copy(UInt8* dest, UInt8* source, Int count) {
    UInt8*! mutable_dest = unsafe {
        dest$.as(UInt8*!)
    };
    Int index! = 0;
    while (index < count) {
        unsafe {
            mutable_dest[index] = source[index];
        }
        index = index + 1;
    }
}

public Void memory_set(UInt8* dest, Int value, Int count) {
    UInt8*! mutable_dest = unsafe {
        dest$.as(UInt8*!)
    };
    UInt8 byte = UInt8(value);
    Int index! = 0;
    while (index < count) {
        unsafe {
            mutable_dest[index] = byte;
        }
        index = index + 1;
    }
}

public Void exit_process(Int code) {
    arch.exit(code);
}

public Void abort_process() {
    trap();
}

public Void trap() {
    arch.trap();
}

