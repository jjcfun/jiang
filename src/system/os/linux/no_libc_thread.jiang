// Linux no-libc thread capability baseline.
//
// Queue and pthread-backed capabilities are unavailable until the no-libc runtime owns
// clone/thread startup. Blocking Task words still use the kernel futex ABI directly.

import build;

comptime {
    if (build.target.arch == .x86_64) {
        import arch = "./x86_64.jiang";
    } else {
        import arch = "./aarch64.jiang";
    }
}

const Int futex_wait_private = 128;
const Int futex_wake_private = 129;
const Int errno_interrupted = -4;
const Int errno_try_again = -11;

public struct Mutex: Copyable {
    UInt8* handle;
    public init(self, UInt8* handle) { self.handle = handle; }
}

public struct Queue: Copyable {
    Void* handle;
    public init(self, Void* handle) { self.handle = handle; }
}

public struct Group: Copyable {
    Void* handle;
    public init(self, Void* handle) { self.handle = handle; }
}

public struct AtomicStackArray: Copyable {
    UInt8* handle;
    public init(self, UInt8* handle) { self.handle = handle; }
}

public Bool supported() { return false; }
public UInt8* allocate_storage(Int size) { return null; }
public UInt8* reallocate_storage(UInt8* pointer, Int size) { return null; }
public () deallocate_storage(UInt8* pointer) {}
public Mutex create_mutex() { return Mutex(null); }
public Bool mutex_valid(Mutex mutex) { return false; }
public Void* mutex_handle(Mutex mutex) { return null; }
public Mutex mutex_from_handle(Void* handle) { return Mutex(null); }
public () destroy_mutex(Mutex mutex) {}
public () lock(Mutex mutex) {}
public () unlock(Mutex mutex) {}
public AtomicStackArray create_atomic_stack_array(Int count) { return AtomicStackArray(null); }
public Bool atomic_stack_array_valid(AtomicStackArray stacks) { return false; }
public Void* atomic_stack_array_handle(AtomicStackArray stacks) { return null; }
public AtomicStackArray atomic_stack_array_from_handle(Void* handle) { return AtomicStackArray(null); }
public () destroy_atomic_stack_array(AtomicStackArray stacks) {}
public () atomic_stack_push(AtomicStackArray stacks, Int index, UInt8* node) {}
public UInt8* atomic_stack_pop(AtomicStackArray stacks, Int index) { return null; }
public Queue concurrent_queue() { return Queue(null); }
public Queue serial_queue() { return Queue(null); }
public () destroy_queue(Queue queue, Bool concurrent) {}
public Void* queue_handle(Queue queue) { return null; }
public () set_queue_identity(Queue queue, Void* identity) {}
public Bool has_queue_identity(Void* identity) { return false; }
public Group create_group() { return Group(null); }
public () destroy_group(Group group) {}
public Bool enqueue(Group group, Queue queue, Void* context, Void* callback) { return false; }
public () wait_group(Group group) {}

public () wait_word(Int*! pointer, Int expected) {
    while (true) {
        Int result = futex(pointer, futex_wait_private, expected);
        if (result == errno_try_again) { return; }
        if (result != 0 && result != errno_interrupted) { return; }
    }
}

public () wake_word(Int*! pointer) {
    futex(pointer, futex_wake_private, 2147483647);
}

Int futex(Int*! pointer, Int operation, Int value) {
    return unsafe {
        arch.syscall6(
            futex_syscall_number(),
            pointer$.as(Int),
            operation,
            value,
            0,
            0,
            0
        )
    };
}

Int futex_syscall_number() {
    if (build.target.arch == .x86_64) { return 202; }
    return 98;
}

public () shutdown() {}
