// Linux hosted process provider.

import c = "./c.jiang";
import c_string = "../../../support/c_string.jiang";
import list = "../../../support/list.jiang";

public struct SpawnResult {
    public Bool started;
    public Int exit_code;
    public UInt8[]&! stdout;
    public UInt8[]&! stderr;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = "";
        self.stderr = "";
    }

    public init(Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions {
    public Bool capture_stdout;
    public Bool capture_stderr;
    public Bool discard_stderr;

    public init() {
        self.capture_stdout = false;
        self.capture_stderr = false;
        self.discard_stderr = false;
    }
}

public Int argument_count() {
    return c.__jiang_process_argc;
}

public UInt8[*:0][*] argument_values() {
    return c.__jiang_process_argv;
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    SpawnOptions options = SpawnOptions();
    return spawn_wait(executable, args, options$.ref());
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    if (!options.capture_stdout && !options.capture_stderr && !options.discard_stderr) {
        return spawn_wait_inherit(executable, args);
    }
    if (options.capture_stderr) {
        return SpawnResult(false, -1);
    }
    if (options.capture_stdout) {
        // Linux hosted capture 需要正确建模 glibc 的 posix_spawn_file_actions_t。
        // 它不是 macOS 的 void* 形状，先保持 unsupported，避免错误 ABI。
        return SpawnResult(false, -1);
    }
    return SpawnResult(false, -1);
}

SpawnResult spawn_wait_inherit(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = argv_array(executable, args);
    UInt8[*:0]![*] envp = inherited_environment();
    Int argv_count = args.len() + 1;
    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = c.posix_spawnp(
        pid$.as(Int32[*]),
        argv[0],
        0,
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        free_argv(argv, argv_count);
        pid$.free();
        return SpawnResult(false, Int(spawn_result));
    }

    Int32![*] status = Int32!$.alloc_array(1);
    if (c.waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        free_argv(argv, argv_count);
        pid$.free();
        status$.free();
        return SpawnResult(false, -1);
    }
    Int exit_code = exit_code_from_status(status[0]);
    free_argv(argv, argv_count);
    pid$.free();
    status$.free();
    return SpawnResult(true, exit_code);
}

UInt8[*:0]![*] argv_array(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    UInt8[*:0]![*] argv = c.calloc(args.len() + 2, UInt8*$.size());
    UInt8![*] executable_arg = c_string.from_slice(executable);
    argv[0] = executable_arg$.as(UInt8[*:0]);
    Int! index = 0;
    while (index < args.len()) {
        UInt8![*] arg = c_string.from_slice(args.get(index));
        argv[index + 1] = arg$.as(UInt8[*:0]);
        index = index + 1;
    }
    return argv;
}

() free_argv(UInt8[*:0]![*] argv, Int count) {
    Int! index = 0;
    while (index < count) {
        argv[index]$.free();
        index = index + 1;
    }
    argv$.free();
}

UInt8[*:0]![*] inherited_environment() {
    return c.environ;
}

Int exit_code_from_status(Int32 status) {
    return Int((status >> 8) & 255);
}
