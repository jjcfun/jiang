// Linux x86_64 syscall ABI.
//
// x86_64 syscall 使用 rax 传 syscall number，rdi/rsi/rdx/r10/r8/r9 传参数，
// 通过 syscall 指令进入 kernel。rcx/r11 会被 syscall 指令破坏，memory clobber
// 表示内核可能读写用户态内存。

const Int syscall_read = 0;
const Int syscall_write = 1;
const Int syscall_close = 3;
const Int syscall_mmap = 9;
const Int syscall_munmap = 11;
const Int syscall_exit = 60;
const Int syscall_openat = 257;

public Int syscall0(Int number) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall1(Int number, Int arg0) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall2(Int number, Int arg0, Int arg1) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        in "rsi" arg1;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall3(Int number, Int arg0, Int arg1, Int arg2) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        in "rsi" arg1;
        in "rdx" arg2;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall4(Int number, Int arg0, Int arg1, Int arg2, Int arg3) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        in "rsi" arg1;
        in "rdx" arg2;
        in "r10" arg3;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall5(Int number, Int arg0, Int arg1, Int arg2, Int arg3, Int arg4) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        in "rsi" arg1;
        in "rdx" arg2;
        in "r10" arg3;
        in "r8" arg4;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int syscall6(Int number, Int arg0, Int arg1, Int arg2, Int arg3, Int arg4, Int arg5) {
    return #asm {
        result Int;
        code "syscall";
        in "rax" number;
        in "rdi" arg0;
        in "rsi" arg1;
        in "rdx" arg2;
        in "r10" arg3;
        in "r8" arg4;
        in "r9" arg5;
        out "rax";
        clobber "rcx";
        clobber "r11";
        memory;
        volatile;
    };
}

public Int write(Int fd, UInt8[]& bytes) {
    return do [unsafe] {
        syscall3(
            syscall_write,
            fd,
            bytes$.ptr()$.as(Int),
            bytes.length
        )
    };
}

public Int read(Int fd, UInt8[]& bytes) {
    return do [unsafe] {
        syscall3(
            syscall_read,
            fd,
            bytes$.ptr()$.as(Int),
            bytes.length
        )
    };
}

public Int close(Int fd) {
    return syscall1(syscall_close, fd);
}

public Int openat(Int dirfd, UInt8[*:0] path, Int flags, Int mode) {
    Int path_address = do [unsafe] {
        path$.as(Int)
    };
    return syscall4(
        syscall_openat,
        dirfd,
        path_address,
        flags,
        mode
    );
}

public Int mmap(Int address, Int length, Int prot, Int flags, Int fd, Int offset) {
    return syscall6(
        syscall_mmap,
        address,
        length,
        prot,
        flags,
        fd,
        offset
    );
}

public Int munmap(Int address, Int length) {
    return syscall2(syscall_munmap, address, length);
}

public () exit(Int code) {
    syscall1(syscall_exit, code);
    trap();
}

public () trap() {
    while (true) {
        #asm {
            code "ud2";
            volatile;
            noreturn;
        }
    }
}
