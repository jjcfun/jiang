// Linux aarch64 syscall ABI.
//
// aarch64 syscall 使用 x8 传 syscall number，x0..x5 传参数，通过 svc #0
// 进入 kernel，返回值放在 x0。memory clobber 表示内核可能读写用户态内存。

const Int syscall_read = 63;
const Int syscall_write = 64;
const Int syscall_close = 57;
const Int syscall_mmap = 222;
const Int syscall_munmap = 215;
const Int syscall_exit = 93;
const Int syscall_openat = 56;

public Int syscall0(Int number) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall1(Int number, Int arg0) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall2(Int number, Int arg0, Int arg1) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        in "x1" arg1;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall3(Int number, Int arg0, Int arg1, Int arg2) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        in "x1" arg1;
        in "x2" arg2;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall4(Int number, Int arg0, Int arg1, Int arg2, Int arg3) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        in "x1" arg1;
        in "x2" arg2;
        in "x3" arg3;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall5(Int number, Int arg0, Int arg1, Int arg2, Int arg3, Int arg4) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        in "x1" arg1;
        in "x2" arg2;
        in "x3" arg3;
        in "x4" arg4;
        out "x0";
        memory;
        volatile;
    };
}

public Int syscall6(Int number, Int arg0, Int arg1, Int arg2, Int arg3, Int arg4, Int arg5) {
    return #asm {
        result Int;
        code "svc #0";
        in "x8" number;
        in "x0" arg0;
        in "x1" arg1;
        in "x2" arg2;
        in "x3" arg3;
        in "x4" arg4;
        in "x5" arg5;
        out "x0";
        memory;
        volatile;
    };
}

public Int write(Int fd, UInt8[]& bytes) {
    return syscall3(
        syscall_write,
        fd,
        bytes$.ptr()$.as(Int),
        bytes.length
    );
}

public Int read(Int fd, UInt8[]& bytes) {
    return syscall3(
        syscall_read,
        fd,
        bytes$.ptr()$.as(Int),
        bytes.length
    );
}

public Int close(Int fd) {
    return syscall1(syscall_close, fd);
}

public Int openat(Int dirfd, UInt8[*:0] path, Int flags, Int mode) {
    return syscall4(
        syscall_openat,
        dirfd,
        path$.as(Int),
        flags,
        mode
    );
}

public Int mmap(Int address, Int length, Int prot, Int flags, Int fd, Int offset) {
    return syscall6(
        syscall_mmap,
        address,
        length,
        prot,
        flags,
        fd,
        offset
    );
}

public Int munmap(Int address, Int length) {
    return syscall2(syscall_munmap, address, length);
}

public () exit(Int code) {
    syscall1(syscall_exit, code);
    trap();
}

public () trap() {
    while (true) {
        #asm {
            code "brk #0";
            volatile;
            noreturn;
        }
    }
}
