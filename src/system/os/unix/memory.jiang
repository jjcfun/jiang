// Generic Unix-like hosted memory provider extension point.

import posix_memory = "../posix/memory.jiang";

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    posix_memory.memory_copy(dest, source, count);
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    posix_memory.memory_set(dest, value, count);
}
