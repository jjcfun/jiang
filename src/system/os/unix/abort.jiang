// Generic Unix-like hosted abort/exit provider extension point.
//
// 0.3 先用 POSIX hosted 共享层固定 provider 形状；具体 Unix-like target
// 后续可以在这个目录下补常量、ABI 和行为差异。

import posix_abort = "../posix/abort.jiang";

public () exit_process(Int code) {
    posix_abort.exit_process(code);
}

public () abort_process() {
    posix_abort.abort_process();
}

public () trap() {
    posix_abort.trap();
}
