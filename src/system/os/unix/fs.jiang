// Generic Unix-like hosted filesystem provider extension point.
//
// 0.3 只固定扩展点形状。具体 BSD/Unix-like target 如果 ABI 或常量不同，
// 应在 unix provider 内部覆盖差异，而不是让上层 system API 分平台。

import posix_fs = "../posix/fs.jiang";

public Int32? open_read(UInt8[]& path) {
    return posix_fs.open_read(path);
}

public Int32? open_write(UInt8[]& path) {
    return posix_fs.open_write(path);
}

public Bool exists(UInt8[]& path) {
    return posix_fs.exists(path);
}

public Bool file_exists(UInt8[]& path) {
    return posix_fs.file_exists(path);
}

public Bool dir_exists(UInt8[]& path) {
    return posix_fs.dir_exists(path);
}

public Bool create_dir(UInt8[]& path) {
    return posix_fs.create_dir(path);
}

public Bool create_dirs(UInt8[]& path) {
    return posix_fs.create_dirs(path);
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return posix_fs.write_file_all(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    return posix_fs.read_file_all(fd);
}

public Bool close_file(Int32 fd) {
    return posix_fs.close_file(fd);
}
