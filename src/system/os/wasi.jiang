// WASI target provider.
//
// 第一阶段基于 wasi-libc 提供最小文件写入、内存和退出能力。WASI
// preview1 没有通用子进程和动态库能力，这里显式返回 unsupported。

import libc = "./wasi/libc.jiang";
import c_string = "../../support/c_string.jiang";
import list = "../../support/list.jiang";

public struct SpawnResult {
    public Bool started;
    public Int exit_code;
    public UInt8[]& stdout = "";
    public UInt8[]& stderr = "";

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }

    public init(Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions {
    public Bool capture_stdout = false;
    public Bool capture_stderr = false;
    public Bool discard_stderr = false;
}

public Int32? open_read(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = libc.open(c_path$.as(UInt8[*:0]), 0, 0);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Int32? open_write(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    Int32 fd = libc.creat(c_path$.as(UInt8[*:0]), 438);
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Bool exists(UInt8[]& path) {
    UInt8![*] c_path = c_string.from_slice(path);
    return libc.access(c_path$.as(UInt8[*:0]), 0) == 0;
}

public Bool file_exists(UInt8[]& path) {
    guard open_read(path) is .some(fd) else { return false; }
    close_file(fd);
    return true;
}

public Bool dir_exists(UInt8[]& path) {
    // WASI 目录权限依赖 preopen。先用 access 表达“当前沙箱可见”。
    return exists(path);
}

public Bool create_dir(UInt8[]& path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8![*] c_path = c_string.from_slice(path);
    if (libc.mkdir(c_path$.as(UInt8[*:0]), 493) == 0) {
        return true;
    }
    return dir_exists(path);
}

public Bool create_dirs(UInt8[]& path) {
    if (path.length == 0) {
        return true;
    }

    Int! index = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    return write_fd(fd, bytes);
}

public UInt8[]&? read_file_all(Int32 fd) {
    Int! capacity = 4096;
    Int! length = 0;
    UInt8![*]! buffer = UInt8!$.alloc_many(capacity + 1);
    while (true) {
        if (length + 1024 + 1 > capacity) {
            capacity = capacity * 2;
            UInt8![*] next = UInt8!$.alloc_many(capacity + 1);
            copy_bytes(next, buffer, length);
            buffer$.free();
            buffer = next;
        }
        Int32 count = libc.read(fd, buffer[length..(length + 1024)]$.ptr(), 1024);
        if (count < 0) {
            buffer$.free();
            return null;
        }
        if (count == 0) {
            buffer[length] = 0;
            return buffer[0..length];
        }
        length = length + Int(count);
    }
    return null;
}

public Bool close_file(Int32 fd) {
    return libc.close(fd) == 0;
}

public () memory_copy(UInt8[*] dest, UInt8[*] source, Int count) {
    libc.memcpy(dest, source, Int32(count));
}

public () memory_set(UInt8[*] dest, Int value, Int count) {
    libc.memset(dest, Int32(value), Int32(count));
}

public () exit_process(Int code) {
    libc.exit(Int32(code));
}

public () abort_process() {
    libc.abort();
}

public () trap() {
    libc.abort();
}

public UInt8[:0]&? environment_value(UInt8[]& name) {
    UInt8![*] c_name = c_string.from_slice(name);
    UInt8[*:0] value = libc.getenv(c_name$.as(UInt8[*:0]));
    c_name$.free();
    if (value == null) {
        return null;
    }
    return value[0..c_string_length(value)]$.as(UInt8[:0]&);
}

public RawPointer<UInt8> dynamic_library_open(UInt8[]& path) {
    return null;
}

public RawPointer<UInt8> dynamic_library_symbol(RawPointer<UInt8> handle, UInt8[]& name) {
    return null;
}

public Bool dynamic_library_close(RawPointer<UInt8> handle) {
    return false;
}

public UInt8[:0]&? dynamic_library_error() {
    return null;
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    return SpawnResult(false, -1);
}

public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    return SpawnResult(false, -1);
}

Bool write_fd(Int32 fd, UInt8[]& bytes) {
    if (bytes.length == 0) {
        return true;
    }
    Int32 written = libc.write(fd, bytes[0]$.addr()$.as(UInt8[*]), Int32(bytes.length));
    return Int(written) == bytes.length;
}

Int first_segment_start(UInt8[]& path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[]& path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

() copy_bytes(UInt8![*] dest, UInt8![*] source, Int length) {
    Int! index = 0;
    while (index < length) {
        dest[index] = source[index];
        index = index + 1;
    }
}
