// WASI target provider.
//
// 第一阶段基于 wasi-libc 提供最小文件写入、内存和退出能力。WASI
// preview1 没有通用子进程和动态库能力，这里显式返回 unsupported。

import libc = "./wasi/libc.jiang";
import c_string = "../../support/c_string.jiang";
import list = "../../support/list.jiang";

const Int32 O_RDONLY = 67108864;

@region(a)
public struct SpawnResult: Copyable {
    public Bool started;
    public Int exit_code;

    @life(a)
    public UInt8[]& stdout = "";

    @life(a)
    public UInt8[]& stderr = "";

    public init(self, Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }

    public init(self, Bool started, Int exit_code, UInt8[]& stdout, UInt8[]& stderr) {
        self.started = started;
        self.exit_code = exit_code;
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

public struct SpawnOptions: Copyable {
    public Bool capture_stdout! = false;
    public Bool capture_stderr! = false;
    public Bool discard_stderr! = false;
}

public Int32? open_read(UInt8[]& path) {
    UInt8*! c_path = c_string.from_slice(path);
    Int32 fd = unsafe {
        libc.open(c_path$.as(UInt8*), O_RDONLY, 0)
    };
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Int32? open_write(UInt8[]& path) {
    UInt8*! c_path = c_string.from_slice(path);
    Int32 fd = unsafe {
        libc.creat(c_path$.as(UInt8*), 438)
    };
    if (fd < 0) {
        return null;
    }
    return fd;
}

public Bool exists(UInt8[]& path) {
    UInt8*! c_path = c_string.from_slice(path);
    return unsafe {
        libc.access(c_path$.as(UInt8*), 0) == 0
    };
}

public Bool file_exists(UInt8[]& path) {
    guard open_read(path) is .some(fd) else { return false; }
    close_file(fd);
    return true;
}

public Bool dir_exists(UInt8[]& path) {
    // WASI 目录权限依赖 preopen。先用 access 表达“当前沙箱可见”。
    return exists(path);
}

public Bool create_dir(UInt8[]& path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8*! c_path = c_string.from_slice(path);
    Bool created = unsafe {
        libc.mkdir(c_path$.as(UInt8*), 493) == 0
    };
    if (created) {
        return true;
    }
    return dir_exists(path);
}

public Bool create_dirs(UInt8[]& path) {
    if (path.length == 0) {
        return true;
    }

    Int index! = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

public Bool atomic_replace(UInt8[]& temporary_path, UInt8[]& final_path) {
    UInt8*! temporary = c_string.from_slice(temporary_path);
    UInt8*! final = c_string.from_slice(final_path);
    return unsafe {
        libc.rename(temporary$.as(UInt8*), final$.as(UInt8*)) == 0
    };
}

public Bool remove_file(UInt8[]& path) {
    UInt8*! c_path = c_string.from_slice(path);
    return unsafe {
        libc.unlink(c_path$.as(UInt8*)) == 0
    };
}

public Bool remove_tree(UInt8[]& path) {
    if (!exists(path)) { return true; }
    return remove_file(path);
}

public Int32? acquire_file_lock(UInt8[]& path) {
    return null;
}

public Void release_file_lock(Int32 fd) {}

public Int process_id() {
    return 0;
}

// WASI monotonic clock id 为 1；失败时返回 0，让统计层明确退化。
public UInt64 monotonic_time_ns() {
    UInt64 value! = UInt64(0);
    if (unsafe { libc.__wasi_clock_time_get(UInt32(1), UInt64(1), value$.ptr()) } != 0) {
        return UInt64(0);
    }
    return value;
}

@inline
public Bool write_file_all(Int32 fd, UInt8[]& bytes) {
    if (bytes.length == 0) {
        return true;
    }
    Bool written = unsafe {
        write_file_all_raw(fd, bytes$.ptr(), Int32(bytes.length))
    };
    return written;
}

public Int? file_size(Int32 fd) {
    Int64 size = unsafe { libc.lseek(fd, 0, 2) };
    if (size < 0) { return null; }
    if (unsafe { libc.lseek(fd, 0, 0) } < 0) { return null; }
    return Int(size);
}

public UInt64? file_modified_ns(Int32 fd) {
    return null;
}

Bool write_file_all_raw(Int32 fd, UInt8* data, Int32 length) {
    unsafe {
        Int32 written = libc.write(fd, data, length);
        return written == length;
    }
}

@life()
public UInt8[]&? read_file_all(Int32 fd) {
    unsafe {
        Int capacity! = 4096;
        Int length! = 0;
        UInt8*! buffer! = UInt8$.alloc(capacity + 1);
        while (true) {
            if (length + 1024 + 1 > capacity) {
                capacity = capacity * 2;
                UInt8*! next = UInt8$.alloc(capacity + 1);
                copy_bytes(next, buffer, length);
                buffer$.dealloc();
                buffer = next;
            }
            Int32 count = libc.read(fd, buffer[length..(length + 1024)]$.ptr(), 1024);
            if (count < 0) {
                buffer$.dealloc();
                return null;
            }
            if (count == 0) {
                buffer[length] = 0;
                return buffer[0..length];
            }
            length = length + Int(count);
        }
        return null;
    }
}

@life()
public UInt8[]&? read_file_at(Int32 fd, Int offset, Int length) {
    unsafe {
        if (libc.lseek(fd, Int64(offset), 0) < 0) { return null; }
        UInt8*! bytes = UInt8$.alloc(length + 1);
        Int read_count! = 0;
        while (read_count < length) {
            Int32 count = libc.read(
                fd,
                bytes[read_count..length]$.ptr(),
                Int32(length - read_count)
            );
            if (count <= 0) {
                bytes$.dealloc();
                return null;
            }
            read_count = read_count + Int(count);
        }
        bytes[length] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..length];
    }
}

public Bool close_file(Int32 fd) {
    return unsafe {
        libc.close(fd) == 0
    };
}

public Void memory_copy(UInt8* dest, UInt8* source, Int count) {
    unsafe {
        libc.memcpy(dest, source, Int32(count));
    }
}

public Void memory_set(UInt8* dest, Int value, Int count) {
    unsafe {
        libc.memset(dest, Int32(value), Int32(count));
    }
}

public Void exit_process(Int code) {
    unsafe {
        libc.exit(Int32(code));
    }
}

public Void abort_process() {
    unsafe {
        libc.abort();
    }
}

public Void trap() {
    unsafe {
        libc.abort();
    }
}

@life()
public UInt8[:0]&? environment_value(UInt8[]& name) {
    unsafe {
        UInt8*! c_name = c_string.from_slice(name);
        UInt8* value = libc.getenv(c_name$.as(UInt8*));
        c_name$.dealloc();
        if (value == null) {
            return null;
        }
        return value[0..c_string_length(value)]$.as(UInt8[:0]&);
    }
}

public Void* dynamic_library_open(UInt8[]& path) {
    return null;
}

public Void* dynamic_library_symbol(Void* handle, UInt8[]& name) {
    return null;
}

public Bool dynamic_library_close(Void* handle) {
    return false;
}

@life()
public UInt8[:0]&? dynamic_library_error() {
    return null;
}

@life()
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args) {
    return SpawnResult(false, -1);
}

@life()
public SpawnResult spawn_wait(UInt8[]& executable, list.ArrayList<UInt8[]&>& args, SpawnOptions& options) {
    return SpawnResult(false, -1);
}

Int first_segment_start(UInt8[]& path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int c_string_length(UInt8* text) {
    Int length! = 0;
    unsafe {
        while (text[length] != 0) {
            length = length + 1;
        }
    }
    return length;
}

Void copy_bytes(UInt8*! dest, UInt8*! source, Int length) {
    unsafe {
        Int index! = 0;
        while (index < length) {
            dest[index] = source[index];
            index = index + 1;
        }
    }
}
