// src/system 私有层 provider 与公开 std facade 共用的可移植文件系统错误。

public enum FileError: Copyable {
    not_found,
    permission_denied,
    already_exists,
    not_a_directory,
    is_a_directory,
    invalid_argument,
    too_many_open_files,
    no_space,
    read_only,
    closed,
    unsupported,
    io,
}

// 当前 macOS、Linux 和 wasi-libc provider 共用这些稳定 POSIX errno 分类。
public FileError from_posix_errno(Int code) {
    return switch code {
        2 => .not_found,
        13 => .permission_denied,
        17 => .already_exists,
        20 => .not_a_directory,
        21 => .is_a_directory,
        22 => .invalid_argument,
        23 => .too_many_open_files,
        24 => .too_many_open_files,
        28 => .no_space,
        30 => .read_only,
        else => .io,
    };
}
