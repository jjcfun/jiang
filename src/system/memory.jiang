// Internal memory operation API.
//
// 这里表达平台无关的字节搬运语义。no-libc provider 以后可以改成 compiler
// intrinsic、DSL-backed inline asm 或 target runtime object。

import provider = "./os/provider.jiang";

public () copy(UInt8* dest, UInt8* source, Int count) {
    provider.memory_copy(dest, source, count);
}

public () set(UInt8* dest, Int value, Int count) {
    provider.memory_set(dest, value, count);
}

public struct Allocator: Copyable {
    public UInt8[]& alloc_symbol;
    public UInt8[]& free_symbol;

    public init(self, UInt8[]& alloc_symbol, UInt8[]& free_symbol) {
        self.alloc_symbol = alloc_symbol;
        self.free_symbol = free_symbol;
    }
}

public Allocator allocator(Bool link_libc) {
    if (link_libc) {
        return Allocator("malloc", "free");
    }
    // `__jiang_*` 是 Jiang runtime ABI 保留符号。普通 Jiang 函数会生成
    // backend mangled name，不会和这里冲突；no-libc runtime 或 extern 声明
    // 如果使用同名符号，表示显式提供这组运行时入口。
    return Allocator("__jiang_malloc", "__jiang_free");
}
