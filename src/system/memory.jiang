// Internal memory operation API.
//
// 这里表达平台无关的字节搬运语义。`./os/provider.jiang` 是 resolver 识别的
// virtual import；no-libc provider 以后可以改成 compiler intrinsic、DSL-backed
// inline asm 或 target runtime object。

import provider = "./os/provider.jiang";

public () copy(UInt8[*] dest, UInt8[*] source, Int count) {
    provider.memory_copy(dest, source, count);
}

public () set(UInt8[*] dest, Int value, Int count) {
    provider.memory_set(dest, value, count);
}

public struct AllocSymbols {
    public UInt8[]& alloc_symbol;
    public UInt8[]& free_symbol;

    public init(UInt8[]& alloc_symbol, UInt8[]& free_symbol) {
        self.alloc_symbol = alloc_symbol;
        self.free_symbol = free_symbol;
    }
}

public AllocSymbols alloc_symbols(Bool link_libc) {
    if (link_libc) {
        return AllocSymbols("malloc", "free");
    }
    return AllocSymbols("__jiang_malloc", "__jiang_free");
}
