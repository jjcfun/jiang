// Internal memory operation API.
//
// 这里表达平台无关的字节搬运语义。当前 macOS hosted provider 使用 libSystem
// memcpy/memset；未来 no-libc provider 可以改成 compiler intrinsic、inline asm
// 或 target runtime object。

import provider = "./os/macos/memory.jiang";

public () copy(UInt8[*] dest, UInt8[*] source, Int count) {
    provider.memory_copy(dest, source, count);
}

public () set(UInt8[*] dest, Int value, Int count) {
    provider.memory_set(dest, value, count);
}

public struct RuntimeAllocator {
    public UInt8[]& alloc_symbol;
    public UInt8[]& free_symbol;

    public init(UInt8[]& alloc_symbol, UInt8[]& free_symbol) {
        self.alloc_symbol = alloc_symbol;
        self.free_symbol = free_symbol;
    }
}

public RuntimeAllocator runtime_allocator(Bool link_libc) {
    if (link_libc) {
        return RuntimeAllocator("malloc", "free");
    }
    return RuntimeAllocator("__jiang_alloc", "__jiang_free");
}
