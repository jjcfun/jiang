// Shared target model.
//
// 这里放 target taxonomy 和由 target 推导出的通用事实。driver 只负责把
// triple 解析成 TargetInfo；pipeline/backend/resolver 只消费这个结构。

import std;

public enum TargetArch {
    host,
    arm64,
    x86_64,
    wasm32,
}

public enum TargetOs {
    host,
    macos,
    linux,
    windows,
    wasm,
}

public enum TargetAbi {
    host,
    darwin,
    gnu,
    msvc,
    wasi,
    none,
}

public enum ObjectFormat {
    host,
    macho,
    elf,
    coff,
    wasm,
}

public enum ProviderKind {
    host,
    macos_hosted,
    linux_hosted,
    linux_no_libc,
    windows_hosted,
    // Wasm 不区分 hosted/no-libc provider；是否链接 libc 由 target_has_libc
    // 统一判断。这样不会把“Wasm 默认无 libc”误建模成一种特殊开关。
    wasm,
    wasi,
}

public enum LinkerDriverKind {
    host,
    cc,
}

public enum SysrootStrategy {
    none,
    macos_sdkroot,
}

public enum ExecutableSupport {
    supported,
    requires_toolchain,
    requires_runtime,
    unsupported_runtime,
    unsupported,
}

public struct TargetInfo: Movable {
    public String requested_triple = "default-target";
    public String llvm_triple = "default-target";
    public TargetArch arch = .host;
    public TargetOs os = .host;
    public TargetAbi abi = .host;
    public ObjectFormat object_format = .host;
    public ProviderKind provider = .host;
    public Bool link_libc = true;
    // 这些字段描述 target 的默认链接策略。CLI 的 --linker 仍然可以覆盖实际
    // 执行的 linker 路径，但默认策略必须跟 target 放在一起，避免 backend/linker
    // 继续用 os 字段散落推断。
    public LinkerDriverKind linker_driver = .cc;
    public SysrootStrategy sysroot_strategy = .none;
    public Bool is_default = true;
}

public TargetInfo copy(TargetInfo& target) {
    return TargetInfo (
        requested_triple: String(target.requested_triple.bytes()),
        llvm_triple: String(target.llvm_triple.bytes()),
        arch: target.arch,
        os: target.os,
        abi: target.abi,
        object_format: target.object_format,
        provider: target.provider,
        link_libc: target.link_libc,
        linker_driver: target.linker_driver,
        sysroot_strategy: target.sysroot_strategy,
        is_default: target.is_default
    );
}

public TargetInfo with_link_libc_request(TargetInfo& target, Bool requested_link_libc) {
    ProviderKind provider! = target.provider;
    Bool link_libc = target_has_libc(target) && requested_link_libc;
    if (target.provider == .linux_hosted && !link_libc) {
        provider = .linux_no_libc;
    }
    return TargetInfo (
        requested_triple: String(target.requested_triple.bytes()),
        llvm_triple: String(target.llvm_triple.bytes()),
        arch: target.arch,
        os: target.os,
        abi: target.abi,
        object_format: target.object_format,
        provider: provider,
        link_libc: link_libc,
        linker_driver: target.linker_driver,
        sysroot_strategy: target.sysroot_strategy,
        is_default: target.is_default
    );
}

public String cache_key(TargetInfo& target) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("triple=");
    builder.append(target.llvm_triple.bytes());
    builder.append(";provider=");
    builder.append(provider_name(target.provider));
    builder.append(";object=");
    builder.append(object_format_name(target.object_format));
    if (target.link_libc) {
        builder.append(";link_libc=true");
    } else {
        builder.append(";link_libc=false");
    }
    return builder.into_string();
}

public Bool target_has_libc(TargetInfo& target) {
    if (target.provider == .wasi) {
        return true;
    }
    if (target.provider == .wasm) {
        return false;
    }
    if (target.provider == .linux_no_libc) {
        return false;
    }
    return true;
}

public Bool target_needs_macos_sdkroot(TargetInfo& target) {
    return target.sysroot_strategy == .macos_sdkroot;
}

public Bool is_linux_no_libc(TargetInfo& target) {
    return target.provider == .linux_no_libc && !target.link_libc;
}

public ExecutableSupport executable_support(TargetInfo& target) {
    if (target.is_default || target.os == .macos) {
        return .supported;
    }
    if (target.provider == .linux_hosted) {
        return .requires_toolchain;
    }
    if (is_linux_no_libc(target)) {
        if (target.arch == .x86_64) {
            return .supported;
        }
        return .requires_runtime;
    }
    if (target.provider == .wasi) {
        return .supported;
    }
    if (target.os == .wasm || target.os == .windows) {
        return .unsupported_runtime;
    }
    return .unsupported;
}

public Bool target_supports_executable(TargetInfo& target) {
    return executable_support(target) == .supported;
}

public UInt8[]& linux_no_libc_runtime_object_path(TargetInfo& target) {
    return "";
}

public UInt8[]& default_linker_driver_name(TargetInfo& target) {
    if (target.linker_driver == .cc) { return "cc"; }
    return "cc";
}

UInt8[]& provider_name(ProviderKind provider) {
    if (provider == .host) { return "host"; }
    if (provider == .macos_hosted) { return "macos-hosted"; }
    if (provider == .linux_hosted) { return "linux-hosted"; }
    if (provider == .linux_no_libc) { return "linux-no-libc"; }
    if (provider == .windows_hosted) { return "windows-hosted"; }
    if (provider == .wasm) { return "wasm"; }
    if (provider == .wasi) { return "wasi"; }
    return "unknown";
}

UInt8[]& object_format_name(ObjectFormat format) {
    if (format == .host) { return "host"; }
    if (format == .macho) { return "macho"; }
    if (format == .elf) { return "elf"; }
    if (format == .coff) { return "coff"; }
    if (format == .wasm) { return "wasm"; }
    return "unknown";
}
