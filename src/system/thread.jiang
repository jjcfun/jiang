// Internal thread and synchronization API.
//
// Runtime code depends on this semantic boundary instead of importing pthread
// or libdispatch declarations directly.

import build;

comptime {
    if (build.target.os == .macos) {
        import target = "./os/macos/thread.jiang";
    } else if (build.target.os == .linux && build.target.link_libc) {
        import target = "./os/linux/thread.jiang";
    } else if (build.target.os == .linux) {
        import target = "./os/linux/no_libc_thread.jiang";
    } else {
        import target = "./os/unsupported/thread.jiang";
    }
}

public alias Mutex = target.Mutex;
public alias Queue = target.Queue;
public alias Group = target.Group;
public alias AtomicStackArray = target.AtomicStackArray;

public Bool supported() {
    return target.supported();
}

public UInt8* allocate_storage(Int size) {
    return target.allocate_storage(size);
}

public UInt8* reallocate_storage(UInt8* pointer, Int size) {
    return target.reallocate_storage(pointer, size);
}

public () deallocate_storage(UInt8* pointer) {
    target.deallocate_storage(pointer);
}

public Mutex create_mutex() {
    return target.create_mutex();
}

public Bool mutex_valid(Mutex mutex) {
    return target.mutex_valid(mutex);
}

public Void* mutex_handle(Mutex mutex) {
    return target.mutex_handle(mutex);
}

public Mutex mutex_from_handle(Void* handle) {
    return target.mutex_from_handle(handle);
}

public () destroy(Mutex mutex) {
    target.destroy_mutex(mutex);
}

public () lock(Mutex mutex) {
    target.lock(mutex);
}

public () unlock(Mutex mutex) {
    target.unlock(mutex);
}

public AtomicStackArray create_atomic_stack_array(Int count) {
    return target.create_atomic_stack_array(count);
}

public Bool atomic_stack_array_valid(AtomicStackArray stacks) {
    return target.atomic_stack_array_valid(stacks);
}

public Void* atomic_stack_array_handle(AtomicStackArray stacks) {
    return target.atomic_stack_array_handle(stacks);
}

public AtomicStackArray atomic_stack_array_from_handle(Void* handle) {
    return target.atomic_stack_array_from_handle(handle);
}

public () destroy_atomic_stack_array(AtomicStackArray stacks) {
    target.destroy_atomic_stack_array(stacks);
}

public () atomic_stack_push(AtomicStackArray stacks, Int index, UInt8* node) {
    target.atomic_stack_push(stacks, index, node);
}

public UInt8* atomic_stack_pop(AtomicStackArray stacks, Int index) {
    return target.atomic_stack_pop(stacks, index);
}

public Queue concurrent_queue() {
    return target.concurrent_queue();
}

public Queue serial_queue() {
    return target.serial_queue();
}

public () destroy_queue(Queue queue, Bool concurrent) {
    target.destroy_queue(queue, concurrent);
}

public Void* queue_handle(Queue queue) {
    return target.queue_handle(queue);
}

public () set_queue_identity(Queue queue, Void* identity) {
    target.set_queue_identity(queue, identity);
}

public Bool has_queue_identity(Void* identity) {
    return target.has_queue_identity(identity);
}

public Group create_group() {
    return target.create_group();
}

public () destroy_group(Group group) {
    target.destroy_group(group);
}

public Bool enqueue(Group group, Queue queue, Void* context, Void* callback) {
    return target.enqueue(group, queue, context, callback);
}

public () wait_group(Group group) {
    target.wait_group(group);
}

// Backend-generated blocking Task joins use these stable semantic symbols.
// Platform providers must absorb interrupts and spurious wakes before returning.
@link_symbol("__jiang_system_thread_wait_word")
public () wait_word(Int*! pointer, Int expected) {
    target.wait_word(pointer, expected);
}

@link_symbol("__jiang_system_thread_wake_word")
public () wake_word(Int*! pointer) {
    target.wake_word(pointer);
}

public () shutdown() {
    target.shutdown();
}
