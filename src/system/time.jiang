// src/system 私有层 的时钟 provider；单调时钟只表示进程内时间间隔。

import provider = "./os/provider.jiang";

public UInt64 monotonic_time_ns() {
    return provider.monotonic_time_ns();
}

public UInt64? monotonic_time_ns_checked() {
    return provider.monotonic_time_ns_checked();
}

public UInt64? wall_time_ns_checked() {
    return provider.wall_time_ns_checked();
}
