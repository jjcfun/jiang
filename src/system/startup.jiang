// Internal startup/runtime state and symbol contract.
//
// 这里不是 public std API。它固定 backend、hosted wrapper、未来 no-libc
// startup object 之间共享的符号名和启动状态：平台入口可以不同，但最终都应
// 初始化 Jiang runtime state，并调用同一个语言入口 `__jiang_main`。

import build;
import wasi_libc = "./os/wasi/libc.jiang";

// 只保存启动瞬间由平台入口交给语言运行时的初始事实。运行过程中会变化的
// process 状态不应该放进这里。
public struct StartupState {
    public ProgramArguments arguments;

    public init() {
        self.arguments = ProgramArguments();
    }

    public init(ProgramArguments arguments) {
        self.arguments = arguments;
    }
}

@link_symbol("__jiang_startup_state")
public StartupState! startup_state = StartupState();

// 进程启动参数由宿主启动代码或 no-libc startup ABI 持有，Jiang 侧只借用。
// 外层 argv 的长度来自 argc；内层每个参数是以 0 结尾的 UInt8 字符串。
public struct ProgramArguments {
    public Int length;
    UInt8[*:0][*] raw;

    public init() {
        self.length = 0;
        self.raw = null;
    }

    public init(Int length, UInt8[*:0][*] raw) {
        self.length = length;
        self.raw = raw;
    }

    public UInt8[:0]& argument(self, Int index) {
        if (index < 0 || index >= self.length) {
            return "";
        }
        UInt8[*:0] value = self.raw[index];
        return value[0..c_string_length(value)]$.as(UInt8[:0]&);
    }
}

public ProgramArguments arguments() {
    return startup_state.arguments;
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

comptime {
    if (build.target.link_libc) {
        extern Int __jiang_main();

        if (build.target.abi == .wasi) {
            @link_symbol("__main_void")
            Int32 wasi_entry() {
                init_wasi_startup_state();
                return Int32(__jiang_main());
            }
        } else {
            @link_symbol("main")
            Int32 hosted_entry(Int32 argc, UInt8[*:0][*] argv) {
                startup_state = StartupState(ProgramArguments(Int(argc), argv));
                return Int32(__jiang_main());
            }
        }
    }
}

comptime {
    if (build.target.abi == .wasi) {
        () init_wasi_startup_state() {
            UInt32! argc = 0;
            UInt32! argv_buf_size = 0;
            UInt16 sizes_error = wasi_libc.__wasi_args_sizes_get(
                argc$.addr()$.as(UInt32[*]),
                argv_buf_size$.addr()$.as(UInt32[*])
            );
            if (sizes_error != UInt16(0)) {
                startup_state = StartupState();
                return;
            }

            UInt8[*:0]![*] argv = UInt8[*:0]$.alloc_many(Int(argc) + 1);
            UInt8![*] argv_buf = UInt8!$.alloc_many(Int(argv_buf_size) + 1);
            UInt16 args_error = wasi_libc.__wasi_args_get(argv$.as(UInt8[*:0][*]), argv_buf$.as(UInt8[*]));
            if (args_error != UInt16(0)) {
                startup_state = StartupState();
                return;
            }
            argv[Int(argc)] = null;
            argv_buf[Int(argv_buf_size)] = 0;
            startup_state = StartupState(ProgramArguments(Int(argc), argv$.as(UInt8[*:0][*])));
        }
    } else {
        () init_wasi_startup_state() {}
    }
}
