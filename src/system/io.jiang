// Internal I/O provider boundary.
//
// 上层只表达 byte write 语义，不暴露 puts/fwrite 等 libc 形状。这里静态选择
// provider module，避免把 provider 做成运行时 struct wrapper。

import fs = "./fs.jiang";
import provider = "./os/macos.jiang";

public fs.File stdout() {
    return fs.File(provider.stdout_fd(), false);
}

public fs.File stderr() {
    return fs.File(provider.stderr_fd(), false);
}
