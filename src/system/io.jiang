// src/system 私有层 的 I/O provider 边界。
//
// 上层只表达 byte write 语义，不暴露 puts/fwrite 等 libc 形状。stdout/stderr
// 复用 system.fs.File，具体 fd 写入由 fs 的 target provider 处理。

import fs = "./fs.jiang";

const Int32 stdout_fd = 1;
const Int32 stderr_fd = 2;

public fs.File stdout() {
    return fs.file_from_handle(stdout_fd, false);
}

public fs.File stderr() {
    return fs.file_from_handle(stderr_fd, false);
}
