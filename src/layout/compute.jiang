// Concrete type layout 计算入口。
//
// compute 层依赖 CompilerStore；`layout.jiang` 只定义数据结构，避免 query
// 和 layout model 之间形成 import cycle。

import layout = "../layout.jiang";
import def = "../resolve/def.jiang";
import diagnostic = "../diagnostic.jiang";
import sem = "../sema/model.jiang";
import generic_bindings = "../sema/generic/bindings.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import callable_abi = "../jil/callable_abi.jiang";
import trait_abi = "../jil/trait_abi.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import types = "../sema/type.jiang";
import token = "../syntax/token.jiang";
import std;

public layout.LayoutId layout_of_type(
    store_api.CompilerStore& store,
    layout.LayoutStore&! layouts,
    qid.TypeId type_id
) {
    LayoutComputer computer! = LayoutComputer(store, layouts);
    return computer.layout_of_type(type_id);
}

public layout.DropCategoryKind drop_category_of_type(
    store_api.CompilerStore& store,
    layout.LayoutStore&! layouts,
    qid.TypeId type_id
) {
    LayoutComputer computer! = LayoutComputer(store, layouts);
    return computer.drop_category_of_type(type_id);
}

public Void prepare_trait_vtable_field_types(
    store_api.CompilerStore& store,
    layout.LayoutStore&! layouts,
    qid.TypeId type_id
) {
    LayoutComputer computer! = LayoutComputer(store, layouts);
    computer.prepare_trait_vtable_field_types(type_id);
}

@region(a, b)
struct LayoutComputer: Movable {
    @life(a)
    store_api.CompilerStore& store;
    @life(b)
    layout.LayoutStore&! layouts;
    // value: 1 = visiting, 2 = done。by-value 递归类型的用户诊断属于
    // type_check；layout 这里只保留内部 guard，避免前序阶段漏检时无限递归。
    map.WyHashMap<qid.TypeId, Int> states!;
    map.WyHashMap<qid.TypeId, Int> drop_states!;

    public init(self, store_api.CompilerStore& store, layout.LayoutStore&! layouts) {
        self.store = store;
        self.layouts = layouts;
        self.states = map.WyHashMap<qid.TypeId, Int>();
        self.drop_states = map.WyHashMap<qid.TypeId, Int>();
    }

    public layout.LayoutId layout_of_type(Self&! self, qid.TypeId type_id) {
        if (self.layouts.layout_id_for_type(type_id) is .some(existing)) {
            return existing;
        }

        if (layout_state_is(self.states$.ref(), type_id, 1)) {
            return self.add_reentrant_layout(self.key_for_type(type_id));
        }

        self.states.set(type_id, 1);
        layout.LayoutKey key = self.key_for_type(type_id);
        types.TypeInfo info = self.store.types.get(type_id);
        layout.LayoutId id = self.compute_layout(info, key);
        self.states.set(type_id, 2);
        self.layouts.set_type_layout(type_id, id);
        return id;
    }

    public layout.DropCategoryKind drop_category_of_type(Self&! self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (self.layouts.drop_category_for_type(type_id) is .some(existing)) {
            return existing;
        }

        if (layout_state_is(self.drop_states$.ref(), type_id, 1)) {
            return .recursive_drop;
        }

        self.drop_states.set(type_id, 1);
        layout.DropCategoryKind category = self.compute_drop_category(info);
        self.layouts.set_type_drop_category(type_id, category);
        self.drop_states.set(type_id, 2);
        return category;
    }

    public Void prepare_trait_vtable_field_types(Self&! self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        guard info.data is .trait_companion(companion) else { return; }
        if (companion.kind != .vtable) { return; }
        if (self.layouts.trait_vtable_field_type(companion.trait_def, 0) != null) {
            return;
        }
        self.layouts.set_trait_vtable_field_type(
            companion.trait_def,
            0,
            trait_abi.receiver_info_pointer_type(self.store)
        );
        self.prepare_trait_vtable_method_types(companion.trait_def);
    }

    Void prepare_trait_vtable_method_types(Self&! self, qid.DefId trait_def) {
        Int slot! = 1;
        Int index! = 0;
        while (index < self.store.model.def_member_count(trait_def)) {
            qid.DefId member_def = self.store.model.def_member_at(trait_def, index);
            if (self.store.defs.get(member_def).kind == .function_def) {
                qid.TypeId slot_type = trait_abi.method_slot_type(
                    self.store, trait_def, member_def
                );
                self.layouts.set_trait_vtable_field_type(
                    trait_def,
                    slot,
                    slot_type
                );
                slot = slot + 1;
            }
            index = index + 1;
        }
    }

    layout.DropCategoryKind compute_drop_category(Self&! self, types.TypeInfo info) {
        if (info.data is .invalid) { return .no_drop; }
        if (info.data is .never) { return .no_drop; }
        if (info.data is .unit) { return .no_drop; }
        if (info.data is .bool_type) { return .no_drop; }
        if (info.data is .char_type) { return .no_drop; }
        if (info.data is .int_type(_)) { return .no_drop; }
        if (info.data is .float_type(_)) { return .no_drop; }
        if (info.data is .function_type(function_type)) {
            if (function_type.kind == .closure) { return .custom_drop; }
            return .no_drop;
        }
        if (info.data is .trait_companion(_)) { return .no_drop; }
        if (info.data is .handle_type(handle_type)) {
            return self.drop_category_for_handle(handle_type);
        }
        if (info.data is .optional(optional_type)) {
            return self.aggregate_drop_category_for_type(optional_type.element);
        }
        if (info.data is .error_union(error_union_type)) {
            return self.drop_category_for_error_union(error_union_type);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.drop_category_for_sequence(tuple_type.items);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.drop_category_for_sequence(environment.capture_types);
        }
        if (info.data is .task_state_type(state)) {
            return self.drop_category_for_sequence(state.field_types);
        }
        if (info.data is .array_type(array_type)) {
            return self.drop_category_for_array(array_type);
        }
        if (info.data is .named(named)) {
            return self.drop_category_for_nominal(named);
        }
        return .no_drop;
    }

    layout.DropCategoryKind drop_category_for_error_union(Self&! self, types.ErrorUnionType error_union_type) {
        return self.merge_drop_category(
            self.aggregate_drop_category_for_type(error_union_type.value),
            self.aggregate_drop_category_for_type(error_union_type.error)
        );
    }

    layout.LayoutId compute_layout(Self&! self, types.TypeInfo info, layout.LayoutKey key) {
        if (info.data is .invalid) {
            return self.add_builtin(key, .invalid, 0, 1);
        }
        if (info.data is .never) {
            return self.add_builtin(key, .never, 0, 1);
        }
        if (info.data is .unit) {
            return self.add_builtin(key, .unit, 0, 1);
        }
        if (info.data is .bool_type) {
            return self.add_builtin(key, .bool_type, 1, 1);
        }
        if (info.data is .char_type) {
            return self.add_builtin(key, .char_type, 4, 4);
        }
        if (info.data is .int_type(int_type)) {
            Int size = self.integer_size(int_type);
            return self.add_builtin(key, .int_type, size, self.scalar_align(size, self.layouts.target.int_align));
        }
        if (info.data is .float_type(float_type)) {
            Int size = self.bits_to_bytes(float_type.bits);
            Int align = self.scalar_align(size, self.layouts.target.float_align);
            return self.add_builtin(key, .float_type, size, align);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.layout_tuple(key, tuple_type);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.layout_type_slice(key, environment.capture_types);
        }
        if (info.data is .task_state_type(state)) {
            return self.layout_type_slice(key, state.field_types);
        }
        if (info.data is .array_type(array_type)) {
            return self.layout_array(key, array_type);
        }
        if (info.data is .optional(optional_type)) {
            return self.layout_optional(key, optional_type);
        }
        if (info.data is .error_union(error_union_type)) {
            return self.layout_error_union(key, error_union_type);
        }
        if (info.data is .handle_type(handle_type)) {
            return self.layout_handle(key, handle_type);
        }
        if (info.data is .function_type(function_type)) {
            return self.layout_function(key, info.id, function_type);
        }
        if (info.data is .task_type(task_type)) {
            return self.layout_task(key, task_type);
        }
        if (info.data is .trait_companion(companion)) {
            return self.layout_trait_companion(key, companion);
        }
        if (info.data is .named(named)) {
            return self.layout_nominal(key, named);
        }
        return self.add_invalid_type(key, info);
    }

    layout.DropCategoryKind drop_category_for_handle(Self&! self, types.HandleType handle_type) {
        if (self.handle_is_trait_object(handle_type)) {
            if (handle_type.kind == .owner_pointer) {
                return .recursive_drop;
            }
            return .no_drop;
        }
        if (handle_type.kind == .owner_pointer) {
            return .recursive_drop;
        }
        return .no_drop;
    }

    layout.DropCategoryKind drop_category_for_array(Self&! self, types.ArrayType array_type) {
        if (array_type.count == 0) {
            return .no_drop;
        }
        return self.aggregate_drop_category_for_type(array_type.element);
    }

    layout.DropCategoryKind drop_category_for_sequence(Self&! self, qid.TypeId[]& type_ids) {
        layout.DropCategoryKind category! = .trivial_drop;
        Int index! = 0;
        while (index < type_ids.length) {
            category = self.merge_drop_category(category, self.drop_category_of_type(type_ids[index]));
            index = index + 1;
        }
        return category;
    }

    layout.DropCategoryKind aggregate_drop_category_for_type(Self&! self, qid.TypeId type_id) {
        return self.merge_drop_category(.trivial_drop, self.drop_category_of_type(type_id));
    }

    layout.DropCategoryKind drop_category_for_nominal(Self&! self, types.NamedType named) {
        def.DefKind kind = self.store.defs.get(named.def_id).kind;
        if (kind == .enum_def) {
            return .no_drop;
        }
        if (self.nominal_has_custom_deinit(named.def_id)) {
            return .custom_drop;
        }
        if (kind == .struct_def || kind == .union_def) {
            return self.drop_category_for_nominal_members(named, kind);
        }
        return .no_drop;
    }

    Bool nominal_has_custom_deinit(self, qid.DefId def_id) {
        guard self.store.model.def(def_id) is .some(model_def) else {
            return false;
        }
        return model_def.custom_deinit_def != null;
    }

    layout.DropCategoryKind drop_category_for_nominal_members(
        Self&! self,
        types.NamedType named,
        def.DefKind kind
    ) {
        layout.DropCategoryKind category! = .trivial_drop;
        Int index! = 0;
        while (index < self.store.model.def_member_count(named.def_id)) {
            qid.DefId member_def = self.store.model.def_member_at(named.def_id, index);
            if (self.member_participates_in_drop(kind, member_def)) {
                qid.TypeId member_type = self.concrete_member_type(named, member_def);
                category = self.merge_drop_category(category, self.drop_category_of_type(member_type));
            }
            index = index + 1;
        }
        return category;
    }

    Bool member_participates_in_drop(self, def.DefKind owner_kind, qid.DefId member_def) {
        def.DefKind member_kind = self.store.defs.get(member_def).kind;
        if (owner_kind == .union_def) {
            return member_kind == .union_variant_def;
        }
        return member_kind == .field_def;
    }

    layout.DropCategoryKind merge_drop_category(self,
        layout.DropCategoryKind lhs,
        layout.DropCategoryKind rhs
    ) {
        if (lhs == .custom_drop || rhs == .custom_drop) {
            return .custom_drop;
        }
        if (lhs == .recursive_drop || rhs == .recursive_drop) {
            return .recursive_drop;
        }
        if (lhs == .trivial_drop || rhs == .trivial_drop) {
            return .trivial_drop;
        }
        return .no_drop;
    }

    layout.LayoutId add_builtin(
        Self&! self,
        layout.LayoutKey key,
        layout.BuiltinLayoutKind kind,
        Int size,
        Int align
    ) {
        layout.TypeLayoutKind layout_kind! = .scalar;
        if (kind == .invalid) {
            layout_kind = .invalid;
        }
        if (kind == .never || kind == .unit) {
            layout_kind = .zero_sized;
        }
        return self.layouts.add_layout(
            key,
            layout_kind,
            size,
            align,
            self.align_to(size, align),
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId add_function_pointer(Self&! self, layout.LayoutKey key) {
        return self.layouts.add_layout(
            key,
            .function_pointer,
            self.layouts.target.pointer_size,
            self.layouts.target.pointer_align,
            self.layouts.target.pointer_size,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId layout_function(
        Self&! self,
        layout.LayoutKey key,
        qid.TypeId type_id,
        types.FunctionType function_type
    ) {
        if (function_type.kind == .raw) {
            return self.add_function_pointer(key);
        }
        list.ArrayList<qid.TypeId> fields = self.closure_field_types(type_id);
        return self.layout_type_sequence(key, fields$.ref());
    }

    list.ArrayList<qid.TypeId> closure_field_types(Self&! self, qid.TypeId type_id) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(2);
        fields.add(callable_abi.closure_environment_type(self.store.types$.ref()));
        fields.add(callable_abi.closure_vtable_pointer_type(
            self.store.types$.ref(), type_id
        ));
        return fields;
    }

    layout.LayoutId add_invalid(Self&! self, layout.LayoutKey key) {
        self.layouts.mark_error();
        self.add_layout_error("failed to compute layout key", "layout_compute_failed");
        return self.layouts.add_layout(
            key,
            .invalid,
            0,
            1,
            0,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId add_invalid_type(Self&! self, layout.LayoutKey key, types.TypeInfo info) {
        self.layouts.mark_error();
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("failed to compute layout for type kind: ");
        builder.append(self.type_kind_name(info));
        std.String message = builder.into_string();
        self.add_layout_error(message.bytes(), "layout_compute_failed");
        return self.layouts.add_layout(
            key,
            .invalid,
            0,
            1,
            1,
            self.layouts.empty_fields()
        );
    }

    UInt8[]& type_kind_name(self, types.TypeInfo info) {
        if (info.data is .invalid) { return "invalid"; }
        if (info.data is .never) { return "never"; }
        if (info.data is .unit) { return "unit"; }
        if (info.data is .bool_type) { return "bool"; }
        if (info.data is .char_type) { return "char"; }
        if (info.data is .int_type(_)) { return "int"; }
        if (info.data is .float_type(_)) { return "float"; }
        if (info.data is .named(_)) { return "named"; }
        if (info.data is .optional(_)) { return "optional"; }
        if (info.data is .error_union(_)) { return "error_union"; }
        if (info.data is .handle_type(_)) { return "handle"; }
        if (info.data is .slice_value_type(_)) { return "slice_value"; }
        if (info.data is .array_type(_)) { return "array"; }
        if (info.data is .tuple_type(_)) { return "tuple"; }
        if (info.data is .closure_environment_type(_)) { return "closure_environment"; }
        if (info.data is .task_state_type(_)) { return "task_state"; }
        if (info.data is .function_type(_)) { return "function"; }
        return "unknown";
    }

    UInt8[]& def_kind_name(self, def.DefKind kind) {
        if (kind == .package_def) { return "package"; }
        if (kind == .module_def) { return "module"; }
        if (kind == .import_alias_def) { return "import_alias"; }
        if (kind == .alias_def) { return "alias"; }
        if (kind == .struct_def) { return "struct"; }
        if (kind == .enum_def) { return "enum"; }
        if (kind == .union_def) { return "union"; }
        if (kind == .trait_def) { return "trait"; }
        if (kind == .function_def) { return "function"; }
        if (kind == .init_def) { return "init"; }
        if (kind == .deinit_def) { return "deinit"; }
        if (kind == .global_def) { return "global"; }
        if (kind == .field_def) { return "field"; }
        if (kind == .enum_case_def) { return "enum_case"; }
        if (kind == .union_variant_def) { return "union_variant"; }
        if (kind == .associated_type_def) { return "associated_type"; }
        if (kind == .generic_param_def) { return "generic_param"; }
        if (kind == .parameter_def) { return "parameter"; }
        if (kind == .local_def) { return "local"; }
        if (kind == .builtin_type_def) { return "builtin_type"; }
        if (kind == .builtin_value_def) { return "builtin_value"; }
        return "error";
    }

    layout.LayoutId add_reentrant_layout(Self&! self, layout.LayoutKey key) {
        self.layouts.mark_error();
        self.add_layout_error("layout computation re-entered the same type", "layout_reentrant_type");
        return self.layouts.add_layout(
            key,
            .invalid,
            0,
            1,
            0,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId layout_tuple(Self&! self, layout.LayoutKey key, types.TupleType tuple_type) {
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(tuple_type.items.length);
        Int offset! = 0;
        Int max_align! = 1;
        Int index! = 0;
        while (index < tuple_type.items.length) {
            qid.TypeId field_type = tuple_type.items[index];
            layout.LayoutId field_layout_id = self.layout_of_type(field_type);
            layout.TypeLayout field_layout = self.layouts.layout(field_layout_id);
            offset = self.align_to(offset, field_layout.align);
            fields.add(layout.FieldLayout(null, field_type, offset));
            offset = offset + field_layout.size;
            max_align = self.max_int(max_align, field_layout.align);
            index = index + 1;
        }

        Int size = self.align_to(offset, max_align);
        return self.add_aggregate_layout(
            key,
            size,
            max_align,
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_task(Self&! self, layout.LayoutKey key, types.TaskType task_type) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(1);
        fields.add(task_type.state_type);
        return self.layout_type_sequence(key, fields$.ref());
    }

    layout.LayoutId layout_array(Self&! self, layout.LayoutKey key, types.ArrayType array_type) {
        layout.LayoutId element_layout_id = self.layout_of_type(array_type.element);
        layout.TypeLayout element_layout = self.layouts.layout(element_layout_id);
        Int storage_count = types.array_storage_count(array_type);
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(storage_count);
        Int index! = 0;
        while (index < storage_count) {
            fields.add(layout.FieldLayout(null, array_type.element, element_layout.stride * index));
            index = index + 1;
        }
        Int size = element_layout.stride * storage_count;
        return self.add_aggregate_layout(
            key,
            size,
            element_layout.align,
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_trait_companion(
        Self&! self,
        layout.LayoutKey key,
        types.TraitCompanionType companion
    ) {
        if (companion.kind == .receiver) {
            return self.add_pointer_layout(key);
        }
        if (companion.kind == .vtable) {
            return self.add_pointer_layout(key);
        }
        self.layouts.mark_error();
        self.add_layout_error(
            "trait object type is unsized and must be used behind '&' or '^'",
            "trait_object_value_type"
        );
        return self.layouts.add_layout(
            key,
            .invalid,
            0,
            self.layouts.target.pointer_align,
            0,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId add_pointer_layout(Self&! self, layout.LayoutKey key) {
        return self.layouts.add_layout(
            key,
            .scalar,
            self.layouts.target.pointer_size,
            self.layouts.target.pointer_align,
            self.layouts.target.pointer_size,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId layout_trait_any(Self&! self, layout.LayoutKey key, qid.DefId trait_def) {
        list.ArrayList<qid.TypeId> fields = self.trait_any_field_types(trait_def);
        return self.layout_type_sequence(key, fields$.ref());
    }

    layout.LayoutId layout_trait_vtable(Self&! self, layout.LayoutKey key, qid.DefId trait_def) {
        list.ArrayList<qid.TypeId> fields = self.trait_vtable_field_types(trait_def);
        return self.layout_type_sequence(key, fields$.ref());
    }

    layout.LayoutId layout_type_sequence(
        Self&! self,
        layout.LayoutKey key,
        list.ArrayList<qid.TypeId>& field_types
    ) {
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(field_types.len());
        Int offset! = 0;
        Int max_align! = 1;
        Int index! = 0;
        while (index < field_types.len()) {
            qid.TypeId field_type = field_types.get(index);
            layout.LayoutId field_layout_id = self.layout_of_type(field_type);
            layout.TypeLayout field_layout = self.layouts.layout(field_layout_id);
            offset = self.align_to(offset, field_layout.align);
            fields.add(layout.FieldLayout(null, field_type, offset));
            offset = offset + field_layout.size;
            max_align = self.max_int(max_align, field_layout.align);
            index = index + 1;
        }

        Int size = self.align_to(offset, max_align);
        return self.add_aggregate_layout(
            key,
            size,
            max_align,
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_type_slice(Self&! self, layout.LayoutKey key, qid.TypeId[]& field_types) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(field_types.length);
        Int index! = 0;
        while (index < field_types.length) {
            fields.add(field_types[index]);
            index = index + 1;
        }
        return self.layout_type_sequence(key, fields$.ref());
    }

    layout.LayoutId add_aggregate_layout(Self&! self,
        layout.LayoutKey key,
        Int size,
        Int align,
        layout.FieldLayout[]& fields
    ) {
        if (size == 0) {
            return self.layouts.add_layout(
                key,
                .zero_sized,
                0,
                align,
                0,
                fields
            );
        }
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            align,
            self.align_to(size, align),
            fields
        );
    }

    list.ArrayList<qid.TypeId> trait_any_field_types(Self&! self, qid.DefId trait_def) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(2);
        qid.TypeId vtable_type = trait_abi.vtable_type(self.store, trait_def);
        fields.add(trait_abi.receiver_type(self.store, trait_def));
        fields.add(vtable_type);
        return fields;
    }

    list.ArrayList<qid.TypeId> trait_vtable_field_types(Self&! self, qid.DefId trait_def) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>();
        self.add_trait_vtable_field_types(trait_def, fields$.mut_ref());
        return fields;
    }

    Void add_trait_vtable_field_types(
        Self&! self,
        qid.DefId trait_def,
        list.ArrayList<qid.TypeId>&! fields
    ) {
        Int index! = 0;
        while (index < self.store.model.def_member_count(trait_def)) {
            qid.DefId member_def = self.store.model.def_member_at(trait_def, index);
            if (self.store.defs.get(member_def).kind == .function_def) {
                fields.add(trait_abi.method_slot_type(self.store, trait_def, member_def));
            }
            index = index + 1;
        }
    }

    layout.LayoutId layout_optional(Self&! self, layout.LayoutKey key, types.OptionalType optional_type) {
        // 第一版 optional 不做 niche 优化，显式表示为 `{ tag, payload }`。
        // 后续 niche 只应该改变 layout query 结果，不能改变 semantic TypeId。
        qid.TypeId tag_type = self.store.types.bool_type();
        layout.LayoutId payload_layout_id = self.layout_of_type(optional_type.element);
        layout.TypeLayout payload_layout = self.layouts.layout(payload_layout_id);
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(2);
        fields.add(layout.FieldLayout(null, tag_type, 0));

        Int payload_offset = self.align_to(1, payload_layout.align);
        fields.add(layout.FieldLayout(null, optional_type.element, payload_offset));

        Int max_align = self.max_int(1, payload_layout.align);
        Int size = self.align_to(payload_offset + payload_layout.size, max_align);
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            max_align,
            self.align_to(size, max_align),
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_error_union(
        Self&! self,
        layout.LayoutKey key,
        types.ErrorUnionType error_union_type
    ) {
        // 第一版 error union 不做 niche/overlap 优化，显式表示为
        // `{ is_error, value_payload, error_payload }`。
        qid.TypeId tag_type = self.store.types.bool_type();
        layout.LayoutId value_layout_id = self.layout_of_type(error_union_type.value);
        Int value_size! = 0;
        Int value_align! = 1;
        {
            layout.TypeLayout value_layout = self.layouts.layout(value_layout_id);
            value_size = value_layout.size;
            value_align = value_layout.align;
        }
        layout.LayoutId error_layout_id = self.layout_of_type(error_union_type.error);
        layout.TypeLayout error_layout = self.layouts.layout(error_layout_id);
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(3);
        fields.add(layout.FieldLayout(null, tag_type, 0));

        Int value_offset = self.align_to(1, value_align);
        fields.add(layout.FieldLayout(null, error_union_type.value, value_offset));

        Int error_offset = self.align_to(value_offset + value_size, error_layout.align);
        fields.add(layout.FieldLayout(null, error_union_type.error, error_offset));

        Int max_align = self.max_int(self.max_int(1, value_align), error_layout.align);
        Int size = self.align_to(error_offset + error_layout.size, max_align);
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            max_align,
            self.align_to(size, max_align),
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_handle(Self&! self, layout.LayoutKey key, types.HandleType handle_type) {
        if (self.handle_is_trait_object(handle_type)) {
            return self.layout_trait_object_handle(key, handle_type);
        }
        if (handle_type.kind == .slice) {
            return self.layout_slice(key, handle_type);
        }
        if (self.handle_is_owned_slice_value(handle_type)) {
            return self.layout_owned_slice_value(key, handle_type);
        }
        return self.add_pointer_sized_scalar(key);
    }

    layout.LayoutId layout_trait_object_handle(
        Self&! self,
        layout.LayoutKey key,
        types.HandleType handle_type
    ) {
        guard self.trait_object_trait_def(handle_type) is .some(trait_def) else {
            return self.add_pointer_sized_scalar(key);
        }
        qid.TypeId receiver_type = self.store.types.trait_companion_type(trait_def, .receiver, token.Span());
        qid.TypeId vtable_type = self.store.types.trait_companion_type(trait_def, .vtable, token.Span());
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(2);
        fields.add(layout.FieldLayout(null, receiver_type, 0));
        fields.add(layout.FieldLayout(null, vtable_type, self.layouts.target.pointer_size));

        Int size = self.layouts.target.pointer_size * 2;
        Int align = self.layouts.target.pointer_align;
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            align,
            self.align_to(size, align),
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId add_pointer_sized_scalar(Self&! self, layout.LayoutKey key) {
        return self.layouts.add_layout(
            key,
            .scalar,
            self.layouts.target.pointer_size,
            self.layouts.target.pointer_align,
            self.layouts.target.pointer_size,
            self.layouts.empty_fields()
        );
    }

    layout.LayoutId layout_slice(Self&! self, layout.LayoutKey key, types.HandleType slice_type) {
        qid.TypeId pointer_type = self.store.types.raw_pointer_type(slice_type.element, token.Span());
        qid.TypeId length_type = self.store.types.uint_type();
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(2);
        fields.add(layout.FieldLayout(null, pointer_type, 0));
        fields.add(layout.FieldLayout(null, length_type, self.layouts.target.pointer_size));

        Int size = self.layouts.target.pointer_size * 2;
        Int align = self.layouts.target.pointer_align;
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            align,
            self.align_to(size, align),
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_owned_slice_value(
        Self&! self,
        layout.LayoutKey key,
        types.HandleType handle_type
    ) {
        types.TypeInfo element_info = self.store.types.get(handle_type.element);
        guard element_info.data is .slice_value_type(array_type) else {
            return self.add_pointer_sized_scalar(key);
        }
        qid.TypeId pointer_type = self.store.types.raw_pointer_type(array_type.element, token.Span());
        qid.TypeId length_type = self.store.types.uint_type();
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(2);
        fields.add(layout.FieldLayout(null, pointer_type, 0));
        fields.add(layout.FieldLayout(null, length_type, self.layouts.target.pointer_size));

        Int size = self.layouts.target.pointer_size * 2;
        Int align = self.layouts.target.pointer_align;
        return self.layouts.add_layout(
            key,
            .aggregate,
            size,
            align,
            self.align_to(size, align),
            self.layouts.field_array(fields$.ref())
        );
    }

    layout.LayoutId layout_nominal(Self&! self, layout.LayoutKey key, types.NamedType named) {
        def.DefKind kind = self.store.defs.get(named.def_id).kind;
        if (kind == .struct_def) {
            return self.layout_nominal_fields(key, named);
        }
        if (kind == .enum_def) {
            return self.add_enum_scalar(key, named);
        }
        if (kind == .union_def) {
            return self.layout_union(key, named);
        }
        std.String message = self.non_nominal_named_type_message(named.def_id, kind);
        self.add_layout_error(
            message.bytes(),
            "layout_non_nominal_named_type"
        );
        return self.add_invalid(key);
    }

    std.String non_nominal_named_type_message(self, qid.DefId def_id, def.DefKind kind) {
        qid.SymbolId symbol = self.store.defs.get(def_id).name.symbol;
        std.StringBuilder builder! = std.StringBuilder();
        builder.append("named layout target is not nominal: ");
        builder.append(self.def_kind_name(kind));
        builder.append(" ");
        builder.append(self.store.symbols.text(symbol));
        return builder.into_string();
    }

    layout.LayoutId layout_nominal_fields(Self&! self, layout.LayoutKey key, types.NamedType named) {
        if (!self.store.model.has_def(named.def_id)) {
            self.add_layout_error("nominal layout target has no Semantic Model definition", "layout_missing_model_def");
            return self.add_invalid(key);
        }
        Int member_count = self.store.model.def_member_count(named.def_id);
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(member_count);
        Int offset! = 0;
        Int max_align! = 1;
        Bool packed = self.store.model.def_layout_packed(named.def_id);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.store.model.def_member_at(named.def_id, index);
            if (self.store.defs.get(member_def).kind == .field_def) {
                qid.TypeId field_type = self.concrete_member_type(named, member_def);
                layout.LayoutId field_layout_id = self.layout_of_type(field_type);
                layout.TypeLayout field_layout = self.layouts.layout(field_layout_id);
                Int field_align! = field_layout.align;
                if (packed) {
                    field_align = 1;
                }
                offset = self.align_to(offset, field_align);
                fields.add(layout.FieldLayout(member_def, field_type, offset));
                offset = offset + field_layout.size;
                max_align = self.max_int(max_align, field_align);
            }
            index = index + 1;
        }

        Int aggregate_align = self.aggregate_align(
            max_align,
            self.store.model.def_layout_options(named.def_id)
        );
        Int size = self.align_to(offset, aggregate_align);
        return self.add_aggregate_layout(
            key,
            size,
            aggregate_align,
            self.layouts.field_array(fields$.ref())
        );
    }

    Int aggregate_align(self, Int natural_align, sem.LayoutOptions options) {
        if (options.align == 0) {
            return natural_align;
        }
        if (options.packed) {
            return options.align;
        }
        return self.max_int(natural_align, options.align);
    }

    layout.LayoutId add_enum_scalar(Self&! self, layout.LayoutKey key, types.NamedType named) {
        qid.TypeId underlying_type = self.enum_underlying_type(named.def_id);
        layout.LayoutId underlying_layout_id = self.layout_of_type(underlying_type);
        layout.TypeLayout underlying = self.layouts.layout(underlying_layout_id);
        return self.layouts.add_layout(
            key,
            .scalar,
            underlying.size,
            underlying.align,
            underlying.stride,
            self.layouts.empty_fields()
        );
    }

    qid.TypeId enum_underlying_type(Self&! self, qid.DefId enum_def) {
        if (self.store.typeck.enum_underlying_type(enum_def) is .some(type_id)) {
            return type_id;
        }
        return self.store.types.int32_type();
    }

    layout.LayoutId layout_union(Self&! self, layout.LayoutKey key, types.NamedType named) {
        if (!self.store.model.has_def(named.def_id)) {
            self.add_layout_error("union layout target has no Semantic Model definition", "layout_missing_model_def");
            return self.add_invalid(key);
        }
        Int member_count = self.store.model.def_member_count(named.def_id);
        list.ArrayList<layout.FieldLayout> fields! = list.ArrayList<layout.FieldLayout>(member_count + 1);

        // Jiang union 是 tagged union。当前阶段还没有显式 tag enum layout，
        // 先用 target int 表示 tag，并把所有 payload 放到同一 payload offset。
        qid.TypeId tag_type = self.store.types.int_type();
        Int tag_size = self.layouts.target.pointer_size;
        Int tag_align = self.scalar_align(tag_size, self.layouts.target.int_align);
        fields.add(layout.FieldLayout(null, tag_type, 0));

        Int max_payload_size! = 0;
        Int max_payload_align! = 1;
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.store.model.def_member_at(named.def_id, index);
            if (self.store.defs.get(member_def).kind == .union_variant_def) {
                qid.TypeId payload_type = self.concrete_member_type(named, member_def);
                layout.LayoutId payload_layout_id = self.layout_of_type(payload_type);
                layout.TypeLayout payload_layout = self.layouts.layout(payload_layout_id);
                max_payload_size = self.max_int(max_payload_size, payload_layout.size);
                max_payload_align = self.max_int(max_payload_align, payload_layout.align);
            }
            index = index + 1;
        }

        Int payload_offset = self.align_to(tag_size, max_payload_align);
        self.add_union_payload_fields(fields$.mut_ref(), named, payload_offset);

        Int max_align = self.max_int(tag_align, max_payload_align);
        Int size = self.align_to(payload_offset + max_payload_size, max_align);
        return self.layouts.add_layout_with_payload_storage(
            key,
            .aggregate,
            size,
            max_align,
            self.align_to(size, max_align),
            payload_offset,
            self.layouts.field_array(fields$.ref())
        );
    }

    Void add_union_payload_fields(Self&! self,
        list.ArrayList<layout.FieldLayout>&! fields,
        types.NamedType named,
        Int payload_offset
    ) {
        Int index! = 0;
        while (index < self.store.model.def_member_count(named.def_id)) {
            qid.DefId member_def = self.store.model.def_member_at(named.def_id, index);
            if (self.store.defs.get(member_def).kind != .union_variant_def) {
                index = index + 1;
                continue;
            }
            fields.add(layout.FieldLayout(
                    member_def,
                    self.concrete_member_type(named, member_def),
                    payload_offset
                )
            );
            index = index + 1;
        }
    }

    qid.TypeId concrete_member_type(
        Self&! self,
        types.NamedType named,
        qid.DefId field_def
    ) {
        guard self.store.defs.get(field_def).owner_def is .some(owner_def) else {
            return self.invalid_concrete_member_type();
        }
        if (owner_def != named.def_id) {
            return self.invalid_concrete_member_type();
        }
        guard self.store.typeck.def_type(field_def) is .some(template_type) else {
            return self.invalid_concrete_member_type();
        }
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
            self.store.defs$.ref(),
            self.store.model$.ref(),
            self.store.types$.ref(),
            named.def_id,
            named.args,
            caller$.ref()
        );
        return generic_bindings.substitute_type(
            self.store.types$.ref(), template_type, bindings$.ref()
        );
    }

    qid.TypeId invalid_concrete_member_type(Self&! self) {
        self.layouts.mark_error();
        self.add_layout_error("failed to substitute concrete member type", "layout_concrete_member_type_failed");
        return self.store.types.invalid_type();
    }

    Void add_layout_error(Self&! self, UInt8[]& message, UInt8[]& code) {
        self.layouts.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .layout,
                diagnostic.DiagnosticCode(code),
                diagnostic.SourceRange(),
                message
            )
        );
    }

    layout.LayoutKey key_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .invalid) {
            return self.builtin_key(.invalid, 0, false);
        }
        if (info.data is .never) {
            return self.builtin_key(.never, 0, false);
        }
        if (info.data is .unit) {
            return self.builtin_key(.unit, 0, false);
        }
        if (info.data is .bool_type) {
            return self.builtin_key(.bool_type, 1, false);
        }
        if (info.data is .char_type) {
            return self.builtin_key(.char_type, 32, false);
        }
        if (info.data is .int_type(int_type)) {
            return self.builtin_key(.int_type, int_type.bits, int_type.signed);
        }
        if (info.data is .float_type(float_type)) {
            return self.builtin_key(.float_type, float_type.bits, false);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return layout.LayoutKey(.tuple_type(layout.SequenceLayoutKey(self.key_array_for_types(tuple_type.items))));
        }
        if (info.data is .closure_environment_type(environment)) {
            return layout.LayoutKey(.tuple_type(layout.SequenceLayoutKey(
                self.key_array_for_types(environment.capture_types)
            )));
        }
        if (info.data is .task_state_type(state)) {
            return layout.LayoutKey(.tuple_type(layout.SequenceLayoutKey(
                self.key_array_for_types(state.field_types)
            )));
        }
        if (info.data is .array_type(array_type)) {
            qid.TypeId element = array_type.element;
            Int count = array_type.count;
            Bool has_sentinel = types.sentinel_has(array_type.sentinel);
            UInt64 sentinel_value = types.sentinel_value(array_type.sentinel);
            return layout.LayoutKey(.array_type(layout.ArrayLayoutKey(
                self.one_type_key(element),
                count,
                has_sentinel,
                sentinel_value
            )));
        }
        if (info.data is .optional(optional_type)) {
            return layout.LayoutKey(.optional_type(layout.SequenceLayoutKey(self.one_type_key(optional_type.element))));
        }
        if (info.data is .error_union(error_union_type)) {
            return layout.LayoutKey(.error_union_type(layout.SequenceLayoutKey(
                self.two_type_keys(error_union_type.value, error_union_type.error)
            )));
        }
        if (info.data is .handle_type(handle_type)) {
            // handle 的布局通常只由 handle kind 决定。`T[]^` 是 owning
            // unsized array，需要和普通 `T^` 区分成 fat pointer layout。
            return layout.LayoutKey(.handle_type(layout.HandleLayoutKey(
                self.handle_layout_kind(handle_type),
                self.one_type_key(handle_type.element)
            )));
        }
        if (info.data is .function_type(function_type)) {
            return layout.LayoutKey(.function_type(layout.FunctionLayoutKey(Int(function_type.kind))));
        }
        if (info.data is .task_type(task_type)) {
            list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(1);
            fields.add(task_type.state_type);
            return layout.LayoutKey(.tuple_type(layout.SequenceLayoutKey(self.key_array_for_types(fields.slice()))));
        }
        if (info.data is .trait_companion(companion)) {
            return layout.LayoutKey(.trait_companion_type(layout.TraitCompanionLayoutKey(
                companion.trait_def,
                Int(companion.kind)
            )));
        }
        if (info.data is .named(named)) {
            qid.DefId def_id = named.def_id;
            return layout.LayoutKey(.nominal_type(layout.NominalLayoutKey(
                def_id,
                self.key_array_for_named_type(type_id),
                self.key_array_for_named_const_args(type_id)
            )));
        }
        return self.builtin_key(.invalid, 0, false);
    }

    layout.HandleLayoutKind handle_layout_kind(self, types.HandleType handle_type) {
        if (handle_type.kind == .reference) { return .reference; }
        if (handle_type.kind == .owner_pointer) {
            if (self.handle_is_owned_slice_value(handle_type)) {
                return .owned_slice_value;
            }
            return .owner_pointer;
        }
        if (handle_type.kind == .raw_pointer) { return .raw_pointer; }
        return .slice;
    }

    Bool handle_is_owned_slice_value(self, types.HandleType handle_type) {
        if (handle_type.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.store.types.get(handle_type.element);
        return element_info.data is .slice_value_type(_);
    }

    Bool handle_is_trait_object(self, types.HandleType handle_type) {
        if (handle_type.kind != .reference && handle_type.kind != .owner_pointer) {
            return false;
        }
        return self.trait_object_trait_def(handle_type) != null;
    }

    qid.DefId? trait_object_trait_def(self, types.HandleType handle_type) {
        types.TypeInfo element_info = self.store.types.get(handle_type.element);
        guard element_info.data is .trait_companion(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        return companion.trait_def;
    }

    layout.LayoutKey builtin_key(self, layout.BuiltinLayoutKind kind, Int bits, Bool signed) {
        return layout.LayoutKey(.builtin(layout.BuiltinLayoutKey(kind, bits, signed)));
    }

    @life(return: (self, self))
    layout.LayoutKey[]& one_type_key(self, qid.TypeId type_id) {
        list.ArrayList<layout.LayoutKey> keys! = list.ArrayList<layout.LayoutKey>(1);
        keys.add(self.key_for_type(type_id));
        return self.layouts.key_array(keys$.ref());
    }

    @life(return: (self, self))
    layout.LayoutKey[]& two_type_keys(self, qid.TypeId first, qid.TypeId second) {
        list.ArrayList<layout.LayoutKey> keys! = list.ArrayList<layout.LayoutKey>(2);
        keys.add(self.key_for_type(first));
        keys.add(self.key_for_type(second));
        return self.layouts.key_array(keys$.ref());
    }

    @life(return: (self, self))
    layout.LayoutKey[]& key_array_for_types(self, qid.TypeId[]& type_ids) {
        list.ArrayList<layout.LayoutKey> keys! = list.ArrayList<layout.LayoutKey>(type_ids.length);
        Int index! = 0;
        while (index < type_ids.length) {
            keys.add(self.key_for_type(type_ids[index]));
            index = index + 1;
        }
        return self.layouts.key_array(keys$.ref());
    }

    @life(return: (self, self))
    layout.LayoutKey[]& key_array_for_named_type(self, qid.TypeId type_id) {
        Int count = self.store.types.named_type_arg_count(type_id);
        list.ArrayList<layout.LayoutKey> keys! = list.ArrayList<layout.LayoutKey>(count);
        Int index! = 0;
        while (index < count) {
            qid.TypeId arg = self.store.types.named_type_arg_at(type_id, index);
            keys.add(self.key_for_type(arg));
            index = index + 1;
        }
        return self.layouts.key_array(keys$.ref());
    }

    @life(return: self)
    Int[]& key_array_for_named_const_args(self, qid.TypeId type_id) {
        Int count = self.store.types.named_const_arg_count(type_id);
        list.ArrayList<Int> keys! = list.ArrayList<Int>(count);
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeValue value = self.store.types.named_const_arg_at(type_id, index);
            keys.add(self.const_arg_layout_key(value));
            index = index + 1;
        }
        return self.layouts.int_array(keys$.ref());
    }

    Int[]& key_array_for_const_args(self, comptime_value.ComptimeValue[]& values) {
        list.ArrayList<Int> keys! = list.ArrayList<Int>(values.length);
        Int index! = 0;
        while (index < values.length) {
            keys.add(self.const_arg_layout_key(values[index]));
            index = index + 1;
        }
        return self.layouts.int_array(keys$.ref());
    }

    Int const_arg_layout_key(self, comptime_value.ComptimeValue value) {
        if (value.data is .int_value(int_value)) { return int_value; }
        if (value.data is .uint_value(uint_value)) { return Int(uint_value); }
        if (value.data is .char_value(char_value)) { return Int(char_value); }
        if (value.data is .bool_value(bool_value)) {
            if (bool_value) { return 1; }
            return 0;
        }
        if (value.data is .enum_case_value(case_def)) { return case_def.to_index(); }
        if (value.data is .const_param_value(param_def)) { return param_def.to_index(); }
        return 0;
    }

    Int integer_size(self, types.IntType int_type) {
        if (int_type.bits <= 0) {
            return self.layouts.target.pointer_size;
        }
        return self.bits_to_bytes(int_type.bits);
    }

    Int bits_to_bytes(self, Int bits) {
        if (bits <= 0) {
            return 0;
        }
        return (bits + 7) / 8;
    }

    Int scalar_align(self, Int size, Int max_align) {
        if (size <= 1) {
            return 1;
        }
        if (size < max_align) {
            return size;
        }
        return max_align;
    }

    Int align_to(self, Int value, Int align) {
        if (align <= 1) {
            return value;
        }
        Int remainder = value % align;
        if (remainder == 0) {
            return value;
        }
        return value + (align - remainder);
    }

    Int max_int(self, Int lhs, Int rhs) {
        if (lhs > rhs) {
            return lhs;
        }
        return rhs;
    }
}

Bool layout_state_is(
    map.WyHashMap<qid.TypeId, Int>& states,
    qid.TypeId type_id,
    Int expected
) {
    guard states.get(type_id) is .some(state) else { return false; }
    return state$.get() == expected;
}
