// Concrete type layout 数据模型。
//
// layout 运行在 type check/monomorph 之后，负责把 concrete semantic type
// 映射到目标平台上的 size、align、stride 和 field offset。这里先只定义
// 长期稳定的数据边界；具体 layout 计算会在后续接入。

import qid = "../store/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";

public struct LayoutId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public LayoutId from_index(Int index) {
        return LayoutId(index);
    }
}

public enum BuiltinLayoutKind {
    invalid,
    never,
    unit,
    bool_type,
    char_type,
    int_type,
    float_type,
}

public struct BuiltinLayoutKey: Copyable {
    public BuiltinLayoutKind kind;
    public Int bits;
    public Bool signed;

    public init(self, BuiltinLayoutKind kind, Int bits, Bool signed) {
        self.kind = kind;
        self.bits = bits;
        self.signed = signed;
    }
}

public struct SequenceLayoutKey: Copyable {
    public LayoutKey[]& items;

    public init(self, LayoutKey[]& items) {
        self.items = items;
    }
}

public struct ArrayLayoutKey: Copyable {
    public LayoutKey[]& element;
    public Int count;
    public Bool has_sentinel;
    public UInt64 sentinel_value;

    public init(self, LayoutKey[]& element, Int count, Bool has_sentinel, UInt64 sentinel_value) {
        self.element = element;
        self.count = count;
        self.has_sentinel = has_sentinel;
        self.sentinel_value = sentinel_value;
    }
}

public struct FunctionLayoutKey: Copyable {
    public Int kind;

    public init(self, Int kind) {
        self.kind = kind;
    }
}

public enum HandleLayoutKind {
    reference,
    owner_pointer,
    owned_slice_value,
    raw_pointer,
    slice,
}

public struct HandleLayoutKey: Copyable {
    public HandleLayoutKind kind;
    public LayoutKey[]& element;

    public init(self, HandleLayoutKind kind, LayoutKey[]& element) {
        self.kind = kind;
        self.element = element;
    }
}

public struct NominalLayoutKey: Copyable {
    public qid.DefId def_id;
    public LayoutKey[]& type_args;
    public Int[]& const_arg_hashes;

    public init(self, qid.DefId def_id, LayoutKey[]& type_args, Int[]& const_arg_hashes) {
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_arg_hashes = const_arg_hashes;
    }
}

public struct TraitCompanionLayoutKey: Copyable {
    public qid.DefId trait_def;
    public Int kind;

    public init(self, qid.DefId trait_def, Int kind) {
        self.trait_def = trait_def;
        self.kind = kind;
    }
}

public union LayoutKeyData: Copyable {
    BuiltinLayoutKey builtin;
    SequenceLayoutKey tuple_type;
    ArrayLayoutKey array_type;
    SequenceLayoutKey optional_type;
    SequenceLayoutKey error_union_type;
    HandleLayoutKey handle_type;
    FunctionLayoutKey function_type;
    NominalLayoutKey nominal_type;
    TraitCompanionLayoutKey trait_companion_type;
}

public struct LayoutKey: Copyable {
    public LayoutKeyData data;

    public init(self, LayoutKeyData data) {
        self.data = data;
    }
}

public enum TypeLayoutKind {
    invalid,
    zero_sized,
    scalar,
    aggregate,
    function_pointer,
}

public enum DropCategoryKind {
    no_drop,
    trivial_drop,
    custom_drop,
    recursive_drop,
}

public struct FieldLayout: Copyable {
    public qid.DefId? field_def;
    public qid.TypeId field_type;
    public Int offset;

    public init(self, qid.DefId? field_def, qid.TypeId field_type, Int offset) {
        self.field_def = field_def;
        self.field_type = field_type;
        self.offset = offset;
    }
}

public struct TypeLayout: Copyable {
    public LayoutId id;
    public LayoutKey key;
    public TypeLayoutKind kind;
    public Int size;
    public Int align;
    public Int stride;
    public Int payload_storage_offset;
    public FieldLayout[]& fields;

    public init(self,
        LayoutId id,
        LayoutKey key,
        TypeLayoutKind kind,
        Int size,
        Int align,
        Int stride,
        Int payload_storage_offset,
        FieldLayout[]& fields
    ) {
        self.id = id;
        self.key = key;
        self.kind = kind;
        self.size = size;
        self.align = align;
        self.stride = stride;
        self.payload_storage_offset = payload_storage_offset;
        self.fields = fields;
    }
}

public struct TargetLayout: Copyable {
    public Int pointer_size!;
    public Int pointer_align!;
    public Int int_align!;
    public Int float_align!;
    public Int aggregate_align!;

    public init(self) {
        self.pointer_size = 8;
        self.pointer_align = 8;
        self.int_align = 8;
        self.float_align = 8;
        self.aggregate_align = 8;
    }
}

public struct LayoutStore: Movable {
    public Bool ok!;
    public TargetLayout target!;
    public arena.Arena storage!;
    public table.HashTable<Int, LayoutId> type_layouts!;
    public table.ArrayTable<LayoutId, TypeLayout> layouts!;
    public table.HashTable<Int, DropCategoryKind> type_drop_categories!;

    public init(self) {
        self.ok = true;
        self.target = TargetLayout();
        self.storage = arena.Arena();
        self.type_layouts = table.HashTable<Int, LayoutId>();
        self.layouts = table.ArrayTable<LayoutId, TypeLayout>();
        self.type_drop_categories = table.HashTable<Int, DropCategoryKind>();
    }

    public () reset(self) {
        self.ok = true;
        self.storage.reset();
        self.type_layouts = table.HashTable<Int, LayoutId>();
        self.layouts = table.ArrayTable<LayoutId, TypeLayout>();
        self.type_drop_categories = table.HashTable<Int, DropCategoryKind>();
    }

    public () set_target(self, TargetLayout target) {
        self.target = target;
        self.reset();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public LayoutId? layout_id_for_type(self, qid.TypeId type_id) {
        return table.hash_table_get_value<Int, LayoutId>(self.type_layouts$.ref(), type_id.to_index());
    }

    public () set_type_layout(self, qid.TypeId type_id, LayoutId layout_id) {
        self.type_layouts.set(type_id.to_index(), layout_id);
    }

    public TypeLayout layout(self, LayoutId id) {
        return self.layouts.get(id);
    }

    public TypeLayout& layout_ref(self, LayoutId id) {
        return self.layouts.ref_at(id);
    }

    public DropCategoryKind? drop_category_for_type(self, qid.TypeId type_id) {
        return table.hash_table_get_value<Int, DropCategoryKind>(
            self.type_drop_categories$.ref(),
            type_id.to_index()
        );
    }

    public () set_type_drop_category(self, qid.TypeId type_id, DropCategoryKind category) {
        self.type_drop_categories.set(type_id.to_index(), category);
    }

    public LayoutId add_layout(self,
        LayoutKey key,
        TypeLayoutKind kind,
        Int size,
        Int align,
        Int stride,
        FieldLayout[]& fields
    ) {
        LayoutId id = self.layouts.next_id();
        self.layouts.append(TypeLayout(id, key, kind, size, align, stride, -1, fields));
        return id;
    }

    public LayoutId add_layout_with_payload_storage(self,
        LayoutKey key,
        TypeLayoutKind kind,
        Int size,
        Int align,
        Int stride,
        Int payload_storage_offset,
        FieldLayout[]& fields
    ) {
        LayoutId id = self.layouts.next_id();
        self.layouts.append(TypeLayout(id, key, kind, size, align, stride, payload_storage_offset, fields));
        return id;
    }

    public LayoutKey[]& key_array(self, list.ArrayList<LayoutKey>& keys) {
        unsafe {
            Int count = keys.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            LayoutKey*! values = self.storage.alloc_array<LayoutKey>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = keys.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public Int[]& int_array(self, list.ArrayList<Int>& items) {
        unsafe {
            Int count = items.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Int*! values = self.storage.alloc_array<Int>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = items.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public FieldLayout[]& field_array(self, list.ArrayList<FieldLayout>& fields) {
        unsafe {
            Int count = fields.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            FieldLayout*! values = self.storage.alloc_array<FieldLayout>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = fields.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public FieldLayout[]& empty_fields(self) {
        unsafe {
            FieldLayout*! values = self.storage.alloc_array<FieldLayout>(1);
            return values[0..0];
        }
    }
}
