// Concrete type layout 数据模型。
//
// layout 运行在 type check/monomorph 之后，负责把 concrete semantic type
// 映射到目标平台上的 size、align、stride 和 field offset。这里先只定义
// 长期稳定的数据边界；具体 layout 计算会在后续接入。

import qid = "../query/id.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";

public struct LayoutId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static LayoutId from_index(Int index) {
        return LayoutId(index);
    }
}

public enum BuiltinLayoutKind {
    invalid,
    never,
    unit,
    bool_type,
    char_type,
    int_type,
    float_type,
}

public struct BuiltinLayoutKey {
    public BuiltinLayoutKind kind;
    public Int bits;
    public Bool signed;

    public init(BuiltinLayoutKind kind, Int bits, Bool signed) {
        self.kind = kind;
        self.bits = bits;
        self.signed = signed;
    }
}

public struct SequenceLayoutKey {
    public LayoutKey[] items;

    public init(LayoutKey[] items) {
        self.items = items;
    }
}

public struct ArrayLayoutKey {
    public LayoutKey[] element;
    public Int count;

    public init(LayoutKey[] element, Int count) {
        self.element = element;
        self.count = count;
    }
}

public struct FunctionLayoutKey {
    public LayoutKey[] params;
    public LayoutKey[] result;

    public init(LayoutKey[] params, LayoutKey[] result) {
        self.params = params;
        self.result = result;
    }
}

public enum HandleLayoutKind {
    reference,
    owner_pointer,
    many_pointer,
    raw_pointer,
    slice,
}

public struct HandleLayoutKey {
    public HandleLayoutKind kind;
    public LayoutKey[] element;

    public init(HandleLayoutKind kind, LayoutKey[] element) {
        self.kind = kind;
        self.element = element;
    }
}

public struct NominalLayoutKey {
    public qid.DefId def_id;
    public LayoutKey[] type_args;

    public init(qid.DefId def_id, LayoutKey[] type_args) {
        self.def_id = def_id;
        self.type_args = type_args;
    }
}

public union LayoutKeyData {
    BuiltinLayoutKey builtin;
    SequenceLayoutKey tuple_type;
    ArrayLayoutKey array_type;
    SequenceLayoutKey optional_type;
    SequenceLayoutKey error_union_type;
    HandleLayoutKey handle_type;
    FunctionLayoutKey function_type;
    NominalLayoutKey nominal_type;
}

public struct LayoutKey: Hashable, Equatable {
    public LayoutKeyData data;

    public init(LayoutKeyData data) {
        self.data = data;
    }

    public UInt64 hash() {
        hash.WyHasher! hasher = hash.WyHasher();
        write_layout_key(hasher$.ref(), self);
        return hasher.finish();
    }

    public static Bool equal(LayoutKey& lhs, LayoutKey& rhs) {
        return layout_key_equal(lhs, rhs);
    }
}

public enum TypeLayoutKind {
    invalid,
    zero_sized,
    scalar,
    aggregate,
    function_pointer,
}

public enum DropCategoryKind {
    no_drop,
    trivial_drop,
    custom_drop,
    recursive_drop,
}

public struct FieldLayout {
    public qid.DefId? field_def;
    public qid.TypeId field_type;
    public Int offset;

    public init(qid.DefId? field_def, qid.TypeId field_type, Int offset) {
        self.field_def = field_def;
        self.field_type = field_type;
        self.offset = offset;
    }
}

public struct TypeLayout {
    public LayoutId id;
    public LayoutKey key;
    public TypeLayoutKind kind;
    public Int size;
    public Int align;
    public Int stride;
    public FieldLayout[] fields;

    public init(
        LayoutId id,
        LayoutKey key,
        TypeLayoutKind kind,
        Int size,
        Int align,
        Int stride,
        FieldLayout[] fields
    ) {
        self.id = id;
        self.key = key;
        self.kind = kind;
        self.size = size;
        self.align = align;
        self.stride = stride;
        self.fields = fields;
    }
}

public struct TargetLayout {
    public Int! pointer_size;
    public Int! pointer_align;
    public Int! int_align;
    public Int! float_align;
    public Int! aggregate_align;

    public init() {
        self.pointer_size = 8;
        self.pointer_align = 8;
        self.int_align = 8;
        self.float_align = 8;
        self.aggregate_align = 8;
    }
}

public struct LayoutStore {
    public Bool! ok;
    public TargetLayout! target;
    public arena.Arena! storage;
    public table.HashTable<LayoutKey, LayoutId>! keys;
    public table.ArrayTable<LayoutId, TypeLayout>! layouts;
    public table.HashTable<LayoutKey, DropCategoryKind>! drop_categories;

    public init() {
        self.ok = true;
        self.target = TargetLayout();
        self.storage = arena.Arena();
        self.keys = table.HashTable<LayoutKey, LayoutId>();
        self.layouts = table.ArrayTable<LayoutId, TypeLayout>();
        self.drop_categories = table.HashTable<LayoutKey, DropCategoryKind>();
    }

    public () reset() {
        self.ok = true;
        self.storage.reset();
        self.keys = table.HashTable<LayoutKey, LayoutId>();
        self.layouts = table.ArrayTable<LayoutId, TypeLayout>();
        self.drop_categories = table.HashTable<LayoutKey, DropCategoryKind>();
    }

    public () set_target(TargetLayout target) {
        self.target = target;
        self.reset();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public LayoutId? layout_id(LayoutKey key) {
        return self.keys.get(key);
    }

    public TypeLayout layout(LayoutId id) {
        return self.layouts.get(id);
    }

    public TypeLayout& layout_ref(LayoutId id) {
        return self.layouts.ref_at(id);
    }

    public DropCategoryKind? drop_category(LayoutKey key) {
        return self.drop_categories.get(key);
    }

    public () set_drop_category(LayoutKey key, DropCategoryKind category) {
        self.drop_categories.set(key, category);
    }

    public LayoutId add_layout(
        LayoutKey key,
        TypeLayoutKind kind,
        Int size,
        Int align,
        Int stride,
        FieldLayout[] fields
    ) {
        if (self.keys.get(key) is some existing) {
            return existing;
        }

        LayoutId id = self.layouts.next_id();
        self.keys.set(key, id);
        self.layouts.append(TypeLayout(id, key, kind, size, align, stride, fields));
        return id;
    }

    public LayoutKey[] key_array(list.ArrayList<LayoutKey>& keys) {
        Int count = keys.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        LayoutKey![*] values = self.storage.alloc_array<LayoutKey>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = keys.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public FieldLayout[] field_array(list.ArrayList<FieldLayout>& fields) {
        Int count = fields.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        FieldLayout![*] values = self.storage.alloc_array<FieldLayout>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = fields.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public FieldLayout[] empty_fields() {
        FieldLayout![*] values = self.storage.alloc_array<FieldLayout>(1);
        return values[0..0];
    }
}

() write_layout_key(hash.WyHasher& hasher, LayoutKey key) {
    if (key.data is .builtin(builtin)) {
        hasher.write_int(1);
        write_builtin_key(hasher, builtin);
        return;
    }
    if (key.data is .tuple_type(tuple_type)) {
        hasher.write_int(2);
        write_layout_key_array(hasher, tuple_type.items);
        return;
    }
    if (key.data is .array_type(array_type)) {
        hasher.write_int(8);
        write_layout_key_array(hasher, array_type.element);
        hasher.write_int(array_type.count);
        return;
    }
    if (key.data is .optional_type(optional_type)) {
        hasher.write_int(3);
        write_layout_key_array(hasher, optional_type.items);
        return;
    }
    if (key.data is .error_union_type(error_union_type)) {
        hasher.write_int(4);
        write_layout_key_array(hasher, error_union_type.items);
        return;
    }
    if (key.data is .handle_type(handle_type)) {
        hasher.write_int(5);
        hasher.write_int(handle_kind_index(handle_type.kind));
        write_layout_key_array(hasher, handle_type.element);
        return;
    }
    if (key.data is .function_type(function_type)) {
        hasher.write_int(6);
        write_layout_key_array(hasher, function_type.params);
        write_layout_key_array(hasher, function_type.result);
        return;
    }
    if (key.data is .nominal_type(nominal_type)) {
        hasher.write_int(7);
        hasher.write_int(nominal_type.def_id.to_index());
        write_layout_key_array(hasher, nominal_type.type_args);
    }
}

() write_builtin_key(hash.WyHasher& hasher, BuiltinLayoutKey key) {
    hasher.write_int(builtin_kind_index(key.kind));
    hasher.write_int(key.bits);
    hasher.write_bool(key.signed);
}

() write_layout_key_array(hash.WyHasher& hasher, LayoutKey[] keys) {
    hasher.write_int(keys.length);
    Int! index = 0;
    while (index < keys.length) {
        write_layout_key(hasher, keys[index]);
        index = index + 1;
    }
}

Bool layout_key_equal(LayoutKey& lhs, LayoutKey& rhs) {
    if (lhs.data is .builtin(left)) {
        if (rhs.data is .builtin(right)) {
            return builtin_key_equal(left, right);
        }
        return false;
    }
    if (lhs.data is .tuple_type(left)) {
        if (rhs.data is .tuple_type(right)) {
            return layout_key_array_equal(left.items, right.items);
        }
        return false;
    }
    if (lhs.data is .array_type(left)) {
        if (rhs.data is .array_type(right)) {
            return left.count == right.count && layout_key_array_equal(left.element, right.element);
        }
        return false;
    }
    if (lhs.data is .optional_type(left)) {
        if (rhs.data is .optional_type(right)) {
            return layout_key_array_equal(left.items, right.items);
        }
        return false;
    }
    if (lhs.data is .error_union_type(left)) {
        if (rhs.data is .error_union_type(right)) {
            return layout_key_array_equal(left.items, right.items);
        }
        return false;
    }
    if (lhs.data is .handle_type(left)) {
        if (rhs.data is .handle_type(right)) {
            return left.kind == right.kind && layout_key_array_equal(left.element, right.element);
        }
        return false;
    }
    if (lhs.data is .function_type(left)) {
        if (rhs.data is .function_type(right)) {
            return layout_key_array_equal(left.params, right.params)
                && layout_key_array_equal(left.result, right.result);
        }
        return false;
    }
    if (lhs.data is .nominal_type(left)) {
        if (rhs.data is .nominal_type(right)) {
            return left.def_id == right.def_id
                && layout_key_array_equal(left.type_args, right.type_args);
        }
        return false;
    }
    return false;
}

Bool builtin_key_equal(BuiltinLayoutKey lhs, BuiltinLayoutKey rhs) {
    return lhs.kind == rhs.kind && lhs.bits == rhs.bits && lhs.signed == rhs.signed;
}

Bool layout_key_array_equal(LayoutKey[] lhs, LayoutKey[] rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (!layout_key_equal(lhs[index]$.ref(), rhs[index]$.ref())) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int builtin_kind_index(BuiltinLayoutKind kind) {
    if (kind == .invalid) { return 0; }
    if (kind == .never) { return 1; }
    if (kind == .unit) { return 2; }
    if (kind == .bool_type) { return 3; }
    if (kind == .char_type) { return 4; }
    if (kind == .int_type) { return 5; }
    return 6;
}

Int handle_kind_index(HandleLayoutKind kind) {
    if (kind == .reference) { return 1; }
    if (kind == .owner_pointer) { return 2; }
    if (kind == .many_pointer) { return 3; }
    if (kind == .raw_pointer) { return 4; }
    return 5;
}
