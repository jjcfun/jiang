// 增量 query dependency 的最小图结构。
//
// 这里不做 QueryCache，也不保存查询结果。它只定义稳定 query key 和
// query -> dependency / dependency -> query 两张边表，供后续 invalidation 接入。

import qkey = "../query/key.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public enum IncrementalQueryKind {
    source_import_summary,
    module_interface,
    def_signature,
    def_body,
    type_of_def,
    type_of_node,
    trait_conformance,
    generic_instance_plan,
    layout_of_type,
    mir_body,
    backend_artifact,
}

public struct IncrementalQueryKey: Hashable, Equatable {
    public IncrementalQueryKind kind;
    public qkey.Fingerprint128 primary;
    public qkey.Fingerprint128 secondary;

    public init(
        IncrementalQueryKind kind,
        qkey.Fingerprint128 primary,
        qkey.Fingerprint128 secondary
    ) {
        self.kind = kind;
        self.primary = primary;
        self.secondary = secondary;
    }

    public static IncrementalQueryKey stable_symbol(
        IncrementalQueryKind kind,
        qkey.StableSymbolId stable_id
    ) {
        return IncrementalQueryKey(
            kind,
            qkey.Fingerprint128(stable_id.low, stable_id.high),
            qkey.Fingerprint128()
        );
    }

    public static IncrementalQueryKey fingerprint(
        IncrementalQueryKind kind,
        qkey.Fingerprint128 fingerprint
    ) {
        return IncrementalQueryKey(kind, fingerprint, qkey.Fingerprint128());
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.kind.value);
        write_fingerprint(hasher$.ref(), self.primary);
        write_fingerprint(hasher$.ref(), self.secondary);
        return hasher.finish();
    }

    public static Bool equal(IncrementalQueryKey& lhs, IncrementalQueryKey& rhs) {
        if (lhs.kind.value != rhs.kind.value) { return false; }
        if (lhs.primary != rhs.primary) { return false; }
        return lhs.secondary == rhs.secondary;
    }
}

public struct QueryDependencyGraph: Movable {
    table.HashTable<IncrementalQueryKey, list.ArrayList<IncrementalQueryKey>> dependencies;
    table.HashTable<IncrementalQueryKey, list.ArrayList<IncrementalQueryKey>> reverse_dependencies;

    public init() {
        self.dependencies = table.HashTable<IncrementalQueryKey, list.ArrayList<IncrementalQueryKey>>();
        self.reverse_dependencies = table.HashTable<IncrementalQueryKey, list.ArrayList<IncrementalQueryKey>>();
    }

    public () add_dependency(IncrementalQueryKey query, IncrementalQueryKey dependency) {
        self.add_edge(self.dependencies$.ref(), query, dependency);
        self.add_edge(self.reverse_dependencies$.ref(), dependency, query);
    }

    public Int dependency_count(IncrementalQueryKey query) {
        guard self.dependencies.get(query) is some dependencies else { return 0; }
        return dependencies.len();
    }

    public Int dependent_count(IncrementalQueryKey dependency) {
        guard self.reverse_dependencies.get(dependency) is some dependents else { return 0; }
        return dependents.len();
    }

    public list.ArrayList<IncrementalQueryKey> invalidated_by(IncrementalQueryKey changed) {
        list.ArrayList<IncrementalQueryKey>! result = list.ArrayList<IncrementalQueryKey>();
        list.ArrayList<IncrementalQueryKey>! pending = list.ArrayList<IncrementalQueryKey>();
        table.HashTable<IncrementalQueryKey, Bool>! seen = table.HashTable<IncrementalQueryKey, Bool>();

        pending.add(changed);
        while (!pending.empty()) {
            IncrementalQueryKey current = pending.pop();
            if (seen.has(current)) {
                continue;
            }
            seen.set(current, true);
            result.add(current);
            self.append_direct_dependents(current, pending$.ref());
        }
        return result$.move();
    }

    public list.ArrayList<IncrementalQueryKey> invalidated_by_deleted_stable(
        qkey.StableSymbolId stable_id
    ) {
        list.ArrayList<IncrementalQueryKey>! result = list.ArrayList<IncrementalQueryKey>();
        table.HashTable<IncrementalQueryKey, Bool>! seen = table.HashTable<IncrementalQueryKey, Bool>();

        self.append_invalidated_root(.source_import_summary, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.module_interface, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.def_signature, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.def_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.type_of_def, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.generic_instance_plan, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.mir_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.backend_artifact, stable_id, result$.ref(), seen$.ref());
        return result$.move();
    }

    () append_invalidated_root(
        IncrementalQueryKind kind,
        qkey.StableSymbolId stable_id,
        list.ArrayList<IncrementalQueryKey>& result,
        table.HashTable<IncrementalQueryKey, Bool>& seen
    ) {
        IncrementalQueryKey root = IncrementalQueryKey.stable_symbol(kind, stable_id);
        list.ArrayList<IncrementalQueryKey> invalidated = self.invalidated_by(root);
        Int! index = 0;
        while (index < invalidated.len()) {
            IncrementalQueryKey key = invalidated.get(index);
            if (!seen.has(key)) {
                seen.set(key, true);
                result.add(key);
            }
            index = index + 1;
        }
    }

    () append_direct_dependents(
        IncrementalQueryKey changed,
        list.ArrayList<IncrementalQueryKey>& pending
    ) {
        guard self.reverse_dependencies.get(changed) is some dependents else { return; }
        Int! index = 0;
        while (index < dependents.len()) {
            pending.add(dependents.get(index));
            index = index + 1;
        }
    }

    () add_edge(
        table.HashTable<IncrementalQueryKey, list.ArrayList<IncrementalQueryKey>>& edges,
        IncrementalQueryKey from,
        IncrementalQueryKey to
    ) {
        if (edges.get_ref(from) is some existing) {
            existing.add(to);
            return;
        }
        list.ArrayList<IncrementalQueryKey>! values = list.ArrayList<IncrementalQueryKey>();
        values.add(to);
        edges.set(from, values$.move());
    }
}

public struct QueryStack: Movable {
    list.ArrayList<IncrementalQueryKey> active;

    public init() {
        self.active = list.ArrayList<IncrementalQueryKey>();
    }

    public Bool enter(IncrementalQueryKey key) {
        if (self.contains(key)) {
            return false;
        }
        self.active.add(key);
        return true;
    }

    public () leave(IncrementalQueryKey key) {
        assert(self.active.len() > 0);
        IncrementalQueryKey current = self.active.pop();
        assert(current == key);
    }

    public Bool contains(IncrementalQueryKey key) {
        Int! index = 0;
        while (index < self.active.len()) {
            if (self.active.get(index) == key) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
}

() write_fingerprint(hash.WyHasher& hasher, qkey.Fingerprint128 fingerprint) {
    hasher.write_uint64(fingerprint.low);
    hasher.write_uint64(fingerprint.high);
}
