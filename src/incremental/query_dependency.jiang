// 增量 query dependency 的最小图结构。
//
// 这里不做 QueryCache，也不保存查询结果。它只定义稳定 query key 和
// query -> dependency / dependency -> query 两张边表，供后续 invalidation 接入。

import qkey = "../incremental/key.jiang";
import list = "../support/list.jiang";

public enum IncrementalQueryKind {
    source_import_summary,
    module_interface,
    def_signature,
    def_body,
    type_of_def,
    type_of_node,
    trait_conformance,
    generic_instance_plan,
    layout_of_type,
    mir_body,
    backend_artifact,
}

public struct IncrementalQueryKey {
    public IncrementalQueryKind kind;
    public UInt64 primary_low;
    public UInt64 primary_high;
    public UInt64 secondary_low;
    public UInt64 secondary_high;

    public init(self,
        IncrementalQueryKind kind,
        UInt64 primary_low,
        UInt64 primary_high,
        UInt64 secondary_low,
        UInt64 secondary_high
    ) {
        self.kind = kind;
        self.primary_low = primary_low;
        self.primary_high = primary_high;
        self.secondary_low = secondary_low;
        self.secondary_high = secondary_high;
    }

    public static IncrementalQueryKey stable_symbol_parts(
        IncrementalQueryKind kind,
        UInt64 stable_id_low,
        UInt64 stable_id_high
    ) {
        return IncrementalQueryKey(
            kind,
            stable_id_low,
            stable_id_high,
            0,
            0
        );
    }

    public static IncrementalQueryKey fingerprint_parts(
        IncrementalQueryKind kind,
        UInt64 fingerprint_low,
        UInt64 fingerprint_high
    ) {
        return IncrementalQueryKey(kind, fingerprint_low, fingerprint_high, 0, 0);
    }

}

public struct QueryDependencyGraph: Movable {
    list.ArrayList<QueryDependencyEdge> edges;

    public init(self) {
        self.edges = list.ArrayList<QueryDependencyEdge>();
    }

    public () add_dependency(self, IncrementalQueryKey query, IncrementalQueryKey dependency) {
        self.edges.add(QueryDependencyEdge(query, dependency));
    }

    public Int dependency_count(self, IncrementalQueryKey query) {
        Int! count = 0;
        Int! index = 0;
        while (index < self.edges.len()) {
            QueryDependencyEdge edge = self.edges.get(index);
            if (same_query_key(edge.query, query)) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    public Int dependent_count(self, IncrementalQueryKey dependency) {
        Int! count = 0;
        Int! index = 0;
        while (index < self.edges.len()) {
            QueryDependencyEdge edge = self.edges.get(index);
            if (same_query_key(edge.dependency, dependency)) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    public list.ArrayList<IncrementalQueryKey> invalidated_by(self, IncrementalQueryKey changed) {
        list.ArrayList<IncrementalQueryKey>! result = list.ArrayList<IncrementalQueryKey>();
        list.ArrayList<IncrementalQueryKey>! pending = list.ArrayList<IncrementalQueryKey>();
        list.ArrayList<IncrementalQueryKey>! seen = list.ArrayList<IncrementalQueryKey>();

        pending.add(changed);
        while (!pending.empty()) {
            IncrementalQueryKey current = pending.pop();
            if (self.seen_has(seen$.ref(), current)) {
                continue;
            }
            seen.add(current);
            result.add(current);
            self.append_direct_dependents(current, pending$.ref());
        }
        return result$.move();
    }

    public list.ArrayList<IncrementalQueryKey> invalidated_by_deleted_stable(self,
        qkey.StableSymbolId stable_id
    ) {
        list.ArrayList<IncrementalQueryKey>! result = list.ArrayList<IncrementalQueryKey>();
        list.ArrayList<IncrementalQueryKey>! seen = list.ArrayList<IncrementalQueryKey>();

        self.append_invalidated_root(.source_import_summary, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.module_interface, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.def_signature, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.def_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.type_of_def, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.generic_instance_plan, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.mir_body, stable_id, result$.ref(), seen$.ref());
        self.append_invalidated_root(.backend_artifact, stable_id, result$.ref(), seen$.ref());
        return result$.move();
    }

    () append_invalidated_root(self,
        IncrementalQueryKind kind,
        qkey.StableSymbolId stable_id,
        list.ArrayList<IncrementalQueryKey>& result,
        list.ArrayList<IncrementalQueryKey>& seen
    ) {
        IncrementalQueryKey root = IncrementalQueryKey.stable_symbol_parts(kind, stable_id.low, stable_id.high);
        list.ArrayList<IncrementalQueryKey> invalidated = self.invalidated_by(root);
        Int! index = 0;
        while (index < invalidated.len()) {
            IncrementalQueryKey key = invalidated.get(index);
            if (!self.seen_has(seen, key)) {
                seen.add(key);
                result.add(key);
            }
            index = index + 1;
        }
    }

    () append_direct_dependents(self,
        IncrementalQueryKey changed,
        list.ArrayList<IncrementalQueryKey>& pending
    ) {
        Int! index = 0;
        while (index < self.edges.len()) {
            QueryDependencyEdge edge = self.edges.get(index);
            if (same_query_key(edge.dependency, changed)) {
                pending.add(edge.query);
            }
            index = index + 1;
        }
    }

    Bool seen_has(self, list.ArrayList<IncrementalQueryKey>& seen, IncrementalQueryKey key) {
        Int! index = 0;
        while (index < seen.len()) {
            if (same_query_key(seen.get(index), key)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
}

public struct QueryDependencyEdge {
    public IncrementalQueryKey query;
    public IncrementalQueryKey dependency;

    public init(self, IncrementalQueryKey query, IncrementalQueryKey dependency) {
        self.query = query;
        self.dependency = dependency;
    }
}

public struct QueryStack: Movable {
    list.ArrayList<IncrementalQueryKey> active;

    public init(self) {
        self.active = list.ArrayList<IncrementalQueryKey>();
    }

    public Bool enter(self, IncrementalQueryKey key) {
        if (self.contains(key)) {
            return false;
        }
        self.active.add(key);
        return true;
    }

    public () leave(self, IncrementalQueryKey key) {
        assert(self.active.len() > 0);
        IncrementalQueryKey current = self.active.pop();
        assert(same_query_key(current, key));
    }

    public Bool contains(self, IncrementalQueryKey key) {
        Int! index = 0;
        while (index < self.active.len()) {
            if (same_query_key(self.active.get(index), key)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
}

Bool same_query_key(IncrementalQueryKey lhs, IncrementalQueryKey rhs) {
    IncrementalQueryKind lhs_kind = lhs.kind;
    IncrementalQueryKind rhs_kind = rhs.kind;
    Int lhs_kind_value = Int(lhs_kind);
    Int rhs_kind_value = Int(rhs_kind);
    if (lhs_kind_value != rhs_kind_value) { return false; }
    if (lhs.primary_low != rhs.primary_low) { return false; }
    if (lhs.primary_high != rhs.primary_high) { return false; }
    if (lhs.secondary_low != rhs.secondary_low) { return false; }
    return lhs.secondary_high == rhs.secondary_high;
}
