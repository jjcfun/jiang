// 跨编译稳定 key 和 artifact 指纹。

import hash = "../support/hash.jiang";
import blake3 = "../support/blake3.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import qid = "../id.jiang";
import rdef = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";

public struct StableSymbolId: Copyable, Hashable, Equatable {
    public UInt64 low;
    public UInt64 high;

    public init(self) {
        self.low = 0;
        self.high = 0;
    }

    public init(self, UInt64 low, UInt64 high) {
        self.low = low;
        self.high = high;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(UInt64(self.low));
        hasher.write(UInt64(self.high));
    }

    public Bool equal(StableSymbolId& lhs, StableSymbolId& rhs) {
        return lhs.low == rhs.low && lhs.high == rhs.high;
    }
}

public struct Fingerprint128: Copyable, Hashable, Equatable {
    public UInt64 low;
    public UInt64 high;

    public init(self) {
        self.low = 0;
        self.high = 0;
    }

    public init(self, UInt64 low, UInt64 high) {
        self.low = low;
        self.high = high;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(UInt64(self.low));
        hasher.write(UInt64(self.high));
    }

    public Bool equal(Fingerprint128& lhs, Fingerprint128& rhs) {
        return lhs.low == rhs.low && lhs.high == rhs.high;
    }
}

public enum StableSymbolKind {
    package_symbol,
    module_symbol,
    type_symbol,
    trait_symbol,
    function_symbol,
    global_symbol,
    field_symbol,
    enum_case_symbol,
    union_variant_symbol,
    associated_type_symbol,
    local_symbol,
}

public struct StableSymbolKey: Copyable, Hashable, Equatable {
    public StableSymbolKind kind;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public StableSymbolId? owner;
    public qid.SymbolId name;
    public rdef.NameDomain domain;
    // 基础路径仍不唯一时使用稳定区分值；普通 symbol 保持 null。
    public Fingerprint128? disambiguator = null;

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.kind));
        hasher.write(Int(self.domain));
        hasher.write(Int(self.package_name.to_index()));
        hasher.write(Int(self.module_path.to_index()));
        hasher.write(Int(self.name.to_index()));
        write_session_fingerprint(hasher, self.disambiguator);
        if (self.owner is .some(owner_id)) {
            hasher.write(true);
            hasher.write(UInt64(owner_id.low));
            hasher.write(UInt64(owner_id.high));
            return;
        }
        hasher.write(false);
    }

    public Bool equal(StableSymbolKey& lhs, StableSymbolKey& rhs) {
        StableSymbolKind lhs_kind = lhs.kind;
        StableSymbolKind rhs_kind = rhs.kind;
        Int lhs_kind_value = Int(lhs_kind);
        Int rhs_kind_value = Int(rhs_kind);
        if (lhs_kind_value != rhs_kind_value) {
            return false;
        }
        rdef.NameDomain lhs_domain = lhs.domain;
        rdef.NameDomain rhs_domain = rhs.domain;
        Int lhs_domain_value = Int(lhs_domain);
        Int rhs_domain_value = Int(rhs_domain);
        if (lhs_domain_value != rhs_domain_value) {
            return false;
        }
        if (lhs.package_name != rhs.package_name) {
            return false;
        }
        if (lhs.module_path != rhs.module_path) {
            return false;
        }
        if (lhs.name != rhs.name) {
            return false;
        }
        if (!optional_fingerprint_equal(lhs.disambiguator, rhs.disambiguator)) {
            return false;
        }
        return stable_owner_equal(lhs.owner, rhs.owner);
    }
}

// StableSymbolId 是跨 session 复用的语义身份。它必须由 stable key 的确定性
// 字节流生成，不能依赖 SymbolId index 或临时 HashTable hasher。
public StableSymbolId stable_symbol_id_for_key(interner.SymbolStore& symbols, StableSymbolKey key) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    write_stable_symbol_key_bytes(bytes$.ref(), symbols, key);
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes.slice());
    return StableSymbolId(digest.a, digest.b);
}

// stable symbol id 的输入必须是确定性字节流，不能复用 HashTable 的临时
// hasher。这里写文本而不是 SymbolId index，保证跨进程/跨 session 稳定。
() write_stable_symbol_key_bytes(
    list.ArrayList<UInt8>& bytes,
    interner.SymbolStore& symbols,
    StableSymbolKey key
) {
    write_stable_int(bytes, Int(key.kind));
    write_stable_int(bytes, Int(key.domain));
    write_stable_symbol_text(bytes, symbols, key.package_name);
    write_stable_symbol_text(bytes, symbols, key.module_path);
    write_stable_symbol_text(bytes, symbols, key.name);
    write_stable_owner_bytes(bytes, key.owner);
    write_stable_fingerprint_bytes(bytes, key.disambiguator);
}

() write_stable_symbol_text(
    list.ArrayList<UInt8>& bytes,
    interner.SymbolStore& symbols,
    qid.SymbolId symbol
) {
    UInt8[]& text = symbols.text(symbol);
    write_stable_int(bytes, text.length);
    write_stable_bytes(bytes, text);
}

() write_stable_owner_bytes(list.ArrayList<UInt8>& bytes, StableSymbolId? owner) {
    if (owner is .some(owner_id)) {
        write_stable_bool(bytes, true);
        write_stable_uint64(bytes, owner_id.low);
        write_stable_uint64(bytes, owner_id.high);
        return;
    }
    write_stable_bool(bytes, false);
}

() write_stable_fingerprint_bytes(list.ArrayList<UInt8>& bytes, Fingerprint128? fingerprint) {
    if (fingerprint is .some(value)) {
        write_stable_bool(bytes, true);
        write_stable_uint64(bytes, value.low);
        write_stable_uint64(bytes, value.high);
        return;
    }
    write_stable_bool(bytes, false);
}

() write_stable_bool(list.ArrayList<UInt8>& bytes, Bool value) {
    if (value) {
        bytes.add(1);
        return;
    }
    bytes.add(0);
}

() write_stable_int(list.ArrayList<UInt8>& bytes, Int value) {
    write_stable_uint64(bytes, UInt64(value));
}

() write_stable_uint64(list.ArrayList<UInt8>& bytes, UInt64 value) {
    UInt64 current! = value;
    Int index! = 0;
    while (index < 8) {
        bytes.add(UInt8(current & 255));
        current = current >> 8;
        index = index + 1;
    }
}

() write_stable_bytes(list.ArrayList<UInt8>& bytes, UInt8[]& value) {
    Int index! = 0;
    while (index < value.length) {
        bytes.add(value[index]);
        index = index + 1;
    }
}

public () write_stable_symbol_key(
    hash.WyHasher&! hasher,
    interner.SymbolStore& symbols,
    StableSymbolKey key
) {
    hasher.write(Int(key.kind));
    hasher.write(Int(key.domain));
    write_symbol_text(hasher, symbols, key.package_name);
    write_symbol_text(hasher, symbols, key.module_path);
    write_symbol_text(hasher, symbols, key.name);
    write_stable_owner(hasher, key.owner);
    write_session_fingerprint(hasher, key.disambiguator);
}

() write_session_symbol_key(hash.WyHasher&! hasher, StableSymbolKey& key) {
    hasher.write(Int(key.kind));
    hasher.write(Int(key.domain));
    hasher.write(Int(key.package_name.to_index()));
    hasher.write(Int(key.module_path.to_index()));
    hasher.write(Int(key.name.to_index()));
    write_stable_owner(hasher, key.owner);
    write_session_fingerprint(hasher, key.disambiguator);
}

() write_symbol_text(hash.WyHasher&! hasher, interner.SymbolStore& symbols, qid.SymbolId symbol) {
    UInt8[]& text = symbols.text(symbol);
    hasher.write(Int(text.length));
    hasher.write(text);
}

() write_stable_owner(hash.WyHasher&! hasher, StableSymbolId? owner) {
    if (owner is .some(owner_id)) {
        hasher.write(true);
        hasher.write(UInt64(owner_id.low));
        hasher.write(UInt64(owner_id.high));
        return;
    }
    hasher.write(false);
}

() write_session_fingerprint<H: core_traits.Hasher>(H&! hasher, Fingerprint128? fingerprint) {
    if (fingerprint is .some(value)) {
        hasher.write(true);
        hasher.write(UInt64(value.low));
        hasher.write(UInt64(value.high));
        return;
    }
    hasher.write(false);
}

Bool optional_fingerprint_equal(Fingerprint128? lhs, Fingerprint128? rhs) {
    if (lhs is .some(left)) {
        guard rhs is .some(right) else { return false; }
        return left == right;
    }
    return rhs == null;
}

Bool stable_owner_equal(StableSymbolId? lhs, StableSymbolId? rhs) {
    if (lhs is .some(lhs_id)) {
        if (rhs is .some(rhs_id)) {
            return lhs_id == rhs_id;
        }
        return false;
    }
    return rhs == null;
}
