// Persistent symbol identity and name-to-definition index for incremental builds.

import list = "../support/list.jiang";
import table = "../support/table.jiang";
import qid = "../query/id.jiang";
import qkey = "../query/key.jiang";
import source = "../source/source.jiang";
import token = "../syntax/token.jiang";

public struct StableSymbolRecord {
    public qkey.StableSymbolId stable_id;
    public qkey.StableSymbolKey key;
    public qid.DefId?! current_def;
    public qkey.Fingerprint128! signature_fingerprint;
    public qkey.Fingerprint128! body_fingerprint;
    public qkey.Fingerprint128! type_check_fingerprint;
    public qkey.Fingerprint128! mir_fingerprint;
    public source.SourceId?! source_id;
    public qid.ModuleId?! module_id;
    public token.Span! last_seen_span;
    public Int! generation;

    public init(
        qkey.StableSymbolId stable_id,
        qkey.StableSymbolKey key,
        qid.DefId current_def,
        source.SourceId? source_id,
        qid.ModuleId? module_id,
        token.Span span,
        Int generation
    ) {
        self.stable_id = stable_id;
        self.key = key;
        self.current_def = current_def;
        self.signature_fingerprint = qkey.Fingerprint128();
        self.body_fingerprint = qkey.Fingerprint128();
        self.type_check_fingerprint = qkey.Fingerprint128();
        self.mir_fingerprint = qkey.Fingerprint128();
        self.source_id = source_id;
        self.module_id = module_id;
        self.last_seen_span = span;
        self.generation = generation;
    }
}

public struct IncrementalSymbolIndex {
    public list.ArrayList<StableSymbolRecord>! records;
    public table.HashTable<qkey.StableSymbolId, Int>! stable_to_record;
    public table.HashTable<qid.DefId, Int>! def_to_record;
    public table.MultiTable<source.SourceId, Int>! source_records;
    public table.MultiTable<qid.ModuleId, Int>! module_records;
    public Int! generation;

    public init() {
        self.records = list.ArrayList<StableSymbolRecord>();
        self.stable_to_record = table.HashTable<qkey.StableSymbolId, Int>();
        self.def_to_record = table.HashTable<qid.DefId, Int>();
        self.source_records = table.MultiTable<source.SourceId, Int>();
        self.module_records = table.MultiTable<qid.ModuleId, Int>();
        self.generation = 0;
    }

    public Int len() {
        return self.records.len();
    }

    public () begin_generation() {
        self.generation = self.generation + 1;
    }

    // record_symbol 是 resolve/HIR lowering 写 stable identity 的入口。同一个
    // stable key 再次出现时复用旧 symbol_record，只更新当前 session 的 DefId 和位置事实。
    public qkey.StableSymbolId record_symbol(
        qkey.StableSymbolKey key,
        qid.DefId current_def,
        source.SourceId? source_id,
        qid.ModuleId? module_id,
        token.Span span
    ) {
        qkey.StableSymbolId stable_id = qkey.stable_symbol_id_for_key(key);
        if (self.stable_to_record.get(stable_id) is some record_index) {
            self.refresh_record(record_index, current_def, source_id, module_id, span);
            return stable_id;
        }

        Int! record_index = self.records.len();
        self.records.add(StableSymbolRecord(stable_id, key, current_def, source_id, module_id, span, self.generation));
        self.stable_to_record.set(stable_id, record_index);
        self.def_to_record.set(current_def, record_index);
        self.add_source_module_indexes(record_index, source_id, module_id);
        return stable_id;
    }

    public qkey.StableSymbolId? stable_id_for_def(qid.DefId def_id) {
        if (self.def_to_record.get(def_id) is some record_index) {
            return self.records.get(record_index).stable_id;
        }
        return null;
    }

    public () set_signature_fingerprint(qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint) {
        if (self.record_ref_for_stable(stable_id) is some symbol_record) {
            symbol_record.signature_fingerprint = fingerprint;
        }
    }

    public () set_body_fingerprint(qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint) {
        if (self.record_ref_for_stable(stable_id) is some symbol_record) {
            symbol_record.body_fingerprint = fingerprint;
        }
    }

    public () set_type_check_fingerprint(qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint) {
        if (self.record_ref_for_stable(stable_id) is some symbol_record) {
            symbol_record.type_check_fingerprint = fingerprint;
        }
    }

    public () set_mir_fingerprint(qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint) {
        if (self.record_ref_for_stable(stable_id) is some symbol_record) {
            symbol_record.mir_fingerprint = fingerprint;
        }
    }

    public Bool has_stable(qkey.StableSymbolId stable_id) {
        return self.stable_to_record.has(stable_id);
    }

    public Bool has_def(qid.DefId def_id) {
        return self.def_to_record.has(def_id);
    }

    public qid.DefId? current_def_for_stable(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.get(record_index).current_def;
        }
        return null;
    }

    public qkey.Fingerprint128 signature_fingerprint(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.get(record_index).signature_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public qkey.Fingerprint128 body_fingerprint(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.get(record_index).body_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public qkey.Fingerprint128 type_check_fingerprint(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.get(record_index).type_check_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public qkey.Fingerprint128 mir_fingerprint(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.get(record_index).mir_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public list.ArrayList<qkey.StableSymbolId> stale_symbols_for_source(source.SourceId source_id) {
        list.ArrayList<qkey.StableSymbolId> stale = list.ArrayList<qkey.StableSymbolId>();
        table.MultiTableCursor! cursor = self.source_records.first(source_id);
        while (cursor.valid()) {
            StableSymbolRecord symbol_record = self.records.get(self.source_records.get(cursor));
            if (symbol_record.generation != self.generation) {
                stale.add(symbol_record.stable_id);
            }
            cursor = self.source_records.next(cursor);
        }
        return stale;
    }

    public Int stale_symbol_count_for_source(source.SourceId source_id) {
        Int! count = 0;
        table.MultiTableCursor! cursor = self.source_records.first(source_id);
        while (cursor.valid()) {
            StableSymbolRecord symbol_record = self.records.get(self.source_records.get(cursor));
            if (symbol_record.generation != self.generation) {
                count = count + 1;
            }
            cursor = self.source_records.next(cursor);
        }
        return count;
    }

    StableSymbolRecord&? record_ref_for_stable(qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is some record_index) {
            return self.records.ref_at(record_index);
        }
        return null;
    }

    () refresh_record(
        Int record_index,
        qid.DefId current_def,
        source.SourceId? source_id,
        qid.ModuleId? module_id,
        token.Span span
    ) {
        StableSymbolRecord& symbol_record = self.records.ref_at(record_index);
        if (symbol_record.current_def is some previous_def) {
            if (previous_def != current_def) {
                self.def_to_record.remove(previous_def);
            }
        }

        symbol_record.current_def = current_def;
        symbol_record.source_id = source_id;
        symbol_record.module_id = module_id;
        symbol_record.last_seen_span = span;
        symbol_record.generation = self.generation;
        self.def_to_record.set(current_def, record_index);
    }

    () add_source_module_indexes(Int record_index, source.SourceId? source_id, qid.ModuleId? module_id) {
        if (source_id is some id) {
            self.source_records.add(id, record_index);
        }
        if (module_id is some id) {
            self.module_records.add(id, record_index);
        }
    }
}
