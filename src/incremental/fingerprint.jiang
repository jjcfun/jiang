// Semantic Model fingerprint 计算。
//
// fingerprint 只描述语义结构，不写入 span/source offset。源码位置变化应该更新
// SourceMap，但不应该让 signature/body cache 失效。

import context = "../context.jiang";
import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import resolve_store = "../resolve/store.jiang";
import namespace = "../resolve/namespace.jiang";
import layout = "../layout.jiang";
import jil = "../jil.jiang";
import module_graph = "../resolve/module_graph.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import blake3 = "../support/blake3.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public Void fingerprint_module_graph(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    Int index! = 0;
    while (index < graph.module_count()) {
        fingerprint_module(ctx, graph.module_at(index));
        index = index + 1;
    }
}

public Void fingerprint_module(context.CompilerContext&! ctx, qid.ModuleId module_id) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    fingerprint_def_tree(ctx, module_def);
}

Int jil_atomic_ordering_tag(jil.AtomicOrdering ordering) {
    if (ordering == .relaxed) { return 0; }
    if (ordering == .acquire) { return 1; }
    if (ordering == .release) { return 2; }
    if (ordering == .acquire_release) { return 3; }
    return 4;
}

public Void fingerprint_type_check_results(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    // TypeCheckStore 是本次 compilation 的 side table，不写入 stable symbol index。
    // 这里暂时保留入口，后续 object key 需要时再接入独立 cache 层。
}

Void fingerprint_def_tree(context.CompilerContext&! ctx, qid.DefId def_id) {
    if (!ctx.store.model.has_def(def_id)) { return; }
    if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
        if (!ctx.store.incremental.fingerprints_loaded(stable_id)) {
            // Graph discovery may restore an old `.ji` value before deciding to
            // rebuild this source. A source-backed declaration must replace it.
            ctx.query.invalidate_def_fingerprints(stable_id);
            DefFingerprints fingerprints = compute_def_fingerprints(ctx, def_id, stable_id);
            ctx.store.incremental.set_signature_fingerprint(
                stable_id,
                fingerprints.signature
            );
            ctx.store.incremental.set_body_fingerprint(stable_id, fingerprints.body);
        }
    }

    Int member_count = ctx.store.model.def_member_count(def_id);
    Int index! = 0;
    while (index < member_count) {
        qid.DefId member_def = ctx.store.model.def_member_at(def_id, index);
        fingerprint_def_tree(ctx, member_def);
        index = index + 1;
    }
}

struct DefFingerprints: Copyable {
    qkey.Fingerprint128 signature;
    qkey.Fingerprint128 body;
}

DefFingerprints compute_def_fingerprints(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    qkey.StableSymbolId stable_id
) {
    sem.Def& model_def = ctx.store.model.def_ref(def_id);
    qkey.Fingerprint128 signature = ctx.query.def_signature(
        stable_id,
        { [ref ctx, ref model_def] => model_signature_fingerprint(ctx, model_def) }
    );
    qkey.Fingerprint128 body = ctx.query.def_body(
        stable_id,
        { [ref ctx, ref model_def] => model_body_fingerprint(ctx, model_def) }
    );
    return DefFingerprints (signature: signature, body: body);
}

public qkey.Fingerprint128 model_signature_fingerprint(context.CompilerContext& ctx, sem.Def& model_def) {
    FingerprintWriter writer! = FingerprintWriter();
    def.DefRecord def_record = ctx.store.defs.get(model_def.def_id);
    writer.write_int(1);
    writer.write_def_record(ctx, def_record);
    writer.write_model_decl(ctx, model_def.decl);
    writer.write_optional_type_ref_node(ctx, model_def.enum_underlying_type_ref);
    writer.write_bool(model_def.layout_options.packed);
    writer.write_int(model_def.layout_options.align);
    writer.write_int(model_def.members.len());
    writer.write_int(model_def.trait_refs.len());
    Int trait_index! = 0;
    while (trait_index < model_def.trait_refs.len()) {
        writer.write_type_ref_node(ctx, model_def.trait_refs.get(trait_index));
        trait_index = trait_index + 1;
    }
    writer.write_int(model_def.negative_trait_refs.len());
    trait_index = 0;
    while (trait_index < model_def.negative_trait_refs.len()) {
        writer.write_type_ref_node(ctx, model_def.negative_trait_refs.get(trait_index));
        trait_index = trait_index + 1;
    }
    writer.write_where_predicates(ctx, model_def.where_predicates$.ref());
    writer.write_int(model_def.life_annotation_count);
    writer.write_bool(model_def.has_explicit_empty_lifetime_contract);
    writer.write_lifetime_constraints(ctx, model_def.lifetime_constraints$.ref());
    writer.write_life_clauses(ctx, model_def.life_clauses$.ref());
    writer.write_int(model_def.region_annotation_count);
    writer.write_region_schema(
        ctx,
        model_def.region_params$.ref(),
        model_def.region_constraints$.ref()
    );
    if (model_def.custom_deinit_def is .some(deinit_def)) {
        writer.write_bool(true);
        writer.write_def_ref(ctx, deinit_def);
    } else {
        writer.write_bool(false);
    }
    return writer.finish();
}

// Callable declaration identity 只编码参与重载区分的 Semantic Model 签名，不依赖
// type-check TypeId。返回类型和参数名不参与 Jiang 的重载选择，因此不写入。
// init/deinit 传 false，避免把 ABI 隐藏 self 写入 stable key。
public qkey.Fingerprint128 callable_signature_fingerprint(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    sem.FunctionSignature signature,
    Bool include_receiver
) {
    FingerprintWriter writer! = FingerprintWriter();
    writer.write_int(7);
    if (include_receiver) {
        writer.write_bool(signature.has_receiver);
        writer.write_int(Int(signature.receiver_mode));
    }
    sem.Def& callable = ctx.store.model.def_ref(def_id);
    writer.write_int(callable.generic_params.len());
    Int index! = 0;
    while (index < callable.generic_params.len()) {
        writer.write_def_ref(ctx, callable.generic_params.get(index));
        index = index + 1;
    }
    writer.write_int(signature.params.length);
    index = 0;
    while (index < signature.params.length) {
        writer.write_type_ref_node(ctx, signature.params[index]);
        index = index + 1;
    }
    writer.write_model_effect_set(ctx, signature.effects);
    return writer.finish();
}

public qkey.Fingerprint128 model_body_fingerprint(context.CompilerContext& ctx, sem.Def& model_def) {
    FingerprintWriter writer! = FingerprintWriter();
    writer.write_int(3);
    if (model_def.body is .some(ref _ body)) {
        writer.write_bool(true);
        writer.write_model_id(ctx, body.root);
        writer.write_int(body.locals.len());
        Int index! = 0;
        while (index < body.locals.len()) {
            sem.Local local = body.locals.get_index(index);
            writer.write_local(ctx, local);
            index = index + 1;
        }
        writer.write_int(model_def.nodes.len());
        index = 0;
        while (index < model_def.nodes.len()) {
            writer.write_node(ctx, model_def.nodes.get(index));
            index = index + 1;
        }
    } else {
        writer.write_bool(false);
    }
    return writer.finish();
}

public qkey.Fingerprint128 type_check_fingerprint(context.CompilerContext& ctx, sem.Def& model_def) {
    FingerprintWriter writer! = FingerprintWriter();
    writer.write_int(3);
    if (ctx.store.typeck.def_type(model_def.def_id) is .some(type_id)) {
        writer.write_bool(true);
        writer.write_type_id(ctx, type_id);
    } else {
        writer.write_bool(false);
    }
    writer.write_optional_type_id(ctx, ctx.store.typeck.enum_underlying_type(model_def.def_id));
    if (ctx.store.typeck.enum_case_value(model_def.def_id) is .some(case_value)) {
        writer.write_bool(true);
        writer.write_int(case_value);
    } else {
        writer.write_bool(false);
    }

    Int index! = 0;
    while (index < model_def.nodes.len()) {
        writer.write_node_type_check_result(ctx, model_def.nodes.get(index).id);
        index = index + 1;
    }
    return writer.finish();
}

public qkey.Fingerprint128 type_layout_fingerprint(context.CompilerContext& ctx, layout.TypeLayout type_layout) {
    FingerprintWriter writer! = FingerprintWriter();
    writer.write_int(4);
    writer.write_layout_key(ctx, type_layout.key);
    writer.write_int(Int(type_layout.kind));
    writer.write_int(type_layout.size);
    writer.write_int(type_layout.align);
    writer.write_int(type_layout.stride);
    writer.write_field_layouts(ctx, type_layout.fields);
    return writer.finish();
}

public Void fingerprint_jil_store(context.CompilerContext& ctx, jil.Store& store) {
    // JIL 是本次 compilation 的 concrete codegen input，不写入 stable symbol index。
    // object cache 后续用独立 key 记录 JIL/layout/body 等 codegen 输入。
}

public qkey.Fingerprint128 jil_function_fingerprint(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Function function
) {
    FingerprintWriter writer! = FingerprintWriter(store.program$.ref());
    writer.write_int(6);
    if (jil.function_generated_origin(function.origin) is .some(generated)) {
        writer.write_int(2);
        writer.write_int(Int(generated.kind));
        if (generated.identity_type is .some(type_id)) {
            writer.write_int(1);
            writer.write_type_id(ctx, type_id);
        } else {
            writer.write_int(2);
            writer.write_def_ref(ctx, generated.provenance_def);
        }
    } else {
        writer.write_int(1);
        writer.write_def_ref(ctx, jil.function_provenance_def(function.origin));
    }
    writer.write_generic_arg_array(ctx, function.args);
    writer.write_optional_signature_id(function.signature_id);
    writer.write_type_effect_set(ctx, function.effects);
    writer.write_bool(function.is_coroutine);
    writer.write_optional_type_id(ctx, function.coroutine_capture_env_type);
    writer.write_int(Int(function.confinement));
    writer.write_optional_def_id(ctx, function.confinement_domain);
    writer.write_optional_coroutine_frame(ctx, function.coroutine_frame);
    writer.write_jil_body(ctx, function.body);
    return writer.finish();
}

@region(a, b, c, d)
struct FingerprintWriter: Movable {
    list.ArrayList<UInt8> bytes!;
    @life(a, b, c, d)
    jil.Program&? program!;

    public init(self) {
        self.bytes = list.ArrayList<UInt8>();
        self.program = null;
    }

    public init(self, jil.Program& program) {
        self.bytes = list.ArrayList<UInt8>();
        self.program = program;
    }

    qkey.Fingerprint128 finish(self) {
        blake3.Blake3Hash digest = blake3.blake3_hash(self.bytes.slice());
        return qkey.Fingerprint128(digest.a, digest.b);
    }

    Void write_bool(Self&! self, Bool value) {
        if (value) {
            self.write_byte(1);
        } else {
            self.write_byte(0);
        }
    }

    Void write_int(Self&! self, Int value) {
        self.write_uint64(UInt64(value));
    }

    Void write_uint64(Self&! self, UInt64 value) {
        UInt64 current! = value;
        Int index! = 0;
        while (index < 8) {
            self.write_byte(UInt8(current & 255));
            current = current >> 8;
            index = index + 1;
        }
    }

    Void write_byte(Self&! self, UInt8 value) {
        self.bytes.add(value);
    }

    Void write_symbol(Self&! self, context.CompilerContext& ctx, qid.SymbolId symbol) {
        UInt8[]& text = ctx.store.symbols.text(symbol);
        self.write_int(text.length);
        self.write_bytes(text);
    }

    Void write_bytes(Self&! self, UInt8[]& bytes) {
        Int index! = 0;
        while (index < bytes.length) {
            self.write_byte(bytes[index]);
            index = index + 1;
        }
    }

    Void write_optional_symbol_id(Self&! self, context.CompilerContext& ctx, qid.SymbolId? symbol) {
        if (symbol is .some(value)) {
            self.write_bool(true);
            self.write_symbol(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_optional_def_id(Self&! self, context.CompilerContext& ctx, qid.DefId? def_id) {
        if (def_id is .some(value)) {
            self.write_bool(true);
            self.write_def_ref(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_def_record(Self&! self, context.CompilerContext& ctx, def.DefRecord def_record) {
        self.write_int(Int(def_record.kind));
        self.write_int(Int(def_record.domain));
        self.write_int(Int(def_record.visibility));
        self.write_symbol(ctx, def_record.name.symbol);
        if (def_record.owner_def is .some(owner_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, owner_def);
        } else {
            self.write_bool(false);
        }
    }

    Void write_type_id(Self&! self, context.CompilerContext& ctx, qid.TypeId type_id) {
        self.write_type_info(ctx, ctx.store.types.get(type_id));
    }

    Void write_type_info(Self&! self, context.CompilerContext& ctx, types.TypeInfo info) {
        self.write_bool(info.is_mutable);
        self.write_type_data(ctx, info.data);
    }

    Void write_type_data(Self&! self, context.CompilerContext& ctx, types.TypeData data) {
        if (self.write_builtin_type_data(data)) { return; }
        if (data is .named(named)) {
            self.write_int(7);
            self.write_def_ref(ctx, named.def_id);
            self.write_type_id_array(ctx, named.type_args);
            self.write_comptime_value_array(ctx, named.const_args);
            return;
        }
        if (data is .optional(optional)) {
            self.write_int(8);
            self.write_type_id(ctx, optional.element);
            return;
        }
        if (data is .error_union(error_union)) {
            self.write_int(9);
            self.write_type_id(ctx, error_union.value);
            self.write_type_id(ctx, error_union.error);
            return;
        }
        self.write_compound_type_data(ctx, data);
    }

    Bool write_builtin_type_data(Self&! self, types.TypeData data) {
        if (data is .invalid) { self.write_int(1); return true; }
        if (data is .never) { self.write_int(2); return true; }
        if (data is .unit) { self.write_int(3); return true; }
        if (data is .bool_type) { self.write_int(4); return true; }
        if (data is .char_type) { self.write_int(5); return true; }
        if (data is .int_type(int_type)) {
            self.write_int(6);
            self.write_int(int_type.bits);
            self.write_bool(int_type.signed);
            return true;
        }
        if (data is .float_type(float_type)) {
            self.write_int(10);
            self.write_int(float_type.bits);
            return true;
        }
        return false;
    }

    Void write_compound_type_data(Self&! self, context.CompilerContext& ctx, types.TypeData data) {
        if (data is .handle_type(handle_type)) {
            self.write_int(11);
            self.write_int(Int(handle_type.kind));
            self.write_bool(types.sentinel_has(handle_type.sentinel));
            self.write_uint64(types.sentinel_value(handle_type.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(handle_type.sentinel));
            self.write_type_id(ctx, handle_type.element);
            return;
        }
        if (data is .slice_value_type(slice_value)) {
            self.write_int(15);
            self.write_type_id(ctx, slice_value.element);
            self.write_bool(types.sentinel_has(slice_value.sentinel));
            self.write_uint64(types.sentinel_value(slice_value.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(slice_value.sentinel));
            return;
        }
        if (data is .tuple_type(tuple_type)) {
            self.write_int(12);
            self.write_type_id_array(ctx, tuple_type.items);
            return;
        }
        if (data is .closure_environment_type(environment)) {
            self.write_int(16);
            self.write_def_ref(ctx, environment.lambda_def);
            self.write_generic_arg_array(ctx, environment.args);
            self.write_type_id_array(ctx, environment.capture_types);
            return;
        }
        if (data is .task_state_type(state)) {
            self.write_int(17);
            self.write_type_id(ctx, state.result);
            return;
        }
        if (data is .array_type(array_type)) {
            self.write_int(14);
            self.write_type_id(ctx, array_type.element);
            self.write_int(array_type.count);
            self.write_bool(types.sentinel_has(array_type.sentinel));
            self.write_uint64(types.sentinel_value(array_type.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(array_type.sentinel));
            return;
        }
        if (data is .function_type(function_type)) {
            self.write_int(13);
            self.write_type_id_array(ctx, function_type.params);
            self.write_type_id(ctx, function_type.result);
            self.write_lifetime_contract(ctx, function_type.lifetime_contract);
            self.write_type_effect_set(ctx, function_type.effects);
            return;
        }
        self.write_int(0);
    }

    Void write_type_id_array(Self&! self, context.CompilerContext& ctx, qid.TypeId[]& items) {
        self.write_int(items.length);
        Int index! = 0;
        while (index < items.length) {
            self.write_type_id(ctx, items[index]);
            index = index + 1;
        }
    }

    Void write_generic_arg_array(Self&! self, context.CompilerContext& ctx, types.GenericArg[]& args) {
        self.write_int(args.length);
        Int index! = 0;
        while (index < args.length) {
            types.GenericArg arg = args[index];
            if (arg is .type_arg(type_arg)) {
                self.write_int(1);
                self.write_type_id(ctx, type_arg.value);
            }
            if (arg is .const_arg(const_arg)) {
                self.write_int(2);
                self.write_comptime_value(ctx, const_arg.value);
                self.write_optional_def_id(ctx, const_arg.binding_def);
            }
            index = index + 1;
        }
    }

    Void write_lifetime_contract(
        Self&! self,
        context.CompilerContext& ctx,
        types.LifetimeContract contract
    ) {
        Int count = ctx.store.types.lifetime_contract_flow_count(contract);
        self.write_int(count);
        Int index! = 0;
        while (index < count) {
            types.LifetimeFlow flow = ctx.store.types.lifetime_contract_flow_at(contract, index);
            self.write_lifetime_path(ctx, flow.source);
            self.write_lifetime_path(ctx, flow.target);
            index = index + 1;
        }
    }

    Void write_lifetime_path(
        Self&! self,
        context.CompilerContext& ctx,
        types.LifetimePath path
    ) {
        self.write_int(Int(path.root_kind));
        self.write_int(path.root_index);
        self.write_int(path.position_index);
        if (path.projection_path is .some(projection)) {
            self.write_bool(true);
            self.write_type_lifetime_projection(ctx, projection);
            return;
        }
        self.write_bool(false);
    }

    Void write_type_lifetime_projection(
        Self&! self,
        context.CompilerContext& ctx,
        types.LifetimeProjectionPathId path_id
    ) {
        types.LifetimeProjectionPathNode node = ctx.store.types.lifetime_projection_path(path_id);
        if (node.parent is .some(parent)) {
            self.write_bool(true);
            self.write_type_lifetime_projection(ctx, parent);
        } else {
            self.write_bool(false);
        }
        self.write_int(Int(node.kind));
        self.write_optional_def_id(ctx, node.field_def);
        self.write_int(node.tuple_index);
    }

    Void write_layout_key(Self&! self, context.CompilerContext& ctx, layout.LayoutKey key) {
        if (key.data is .builtin(builtin)) {
            self.write_int(1);
            self.write_int(Int(builtin.kind));
            self.write_int(builtin.bits);
            self.write_bool(builtin.signed);
            return;
        }
        if (key.data is .tuple_type(tuple_type)) {
            self.write_int(2);
            self.write_layout_key_array(ctx, tuple_type.items);
            return;
        }
        if (key.data is .array_type(array_type)) {
            self.write_int(8);
            self.write_layout_key_array(ctx, array_type.element);
            self.write_int(array_type.count);
            self.write_bool(array_type.has_sentinel);
            self.write_uint64(array_type.sentinel_value);
            return;
        }
        if (key.data is .optional_type(optional_type)) {
            self.write_int(3);
            self.write_layout_key_array(ctx, optional_type.items);
            return;
        }
        self.write_non_builtin_layout_key(ctx, key.data);
    }

    Void write_non_builtin_layout_key(Self&! self, context.CompilerContext& ctx, layout.LayoutKeyData data) {
        if (data is .error_union_type(error_union_type)) {
            self.write_int(4);
            self.write_layout_key_array(ctx, error_union_type.items);
            return;
        }
        if (data is .handle_type(handle_type)) {
            self.write_int(5);
            self.write_int(Int(handle_type.kind));
            self.write_layout_key_array(ctx, handle_type.element);
            return;
        }
        if (data is .function_type(function_type)) {
            self.write_int(6);
            self.write_int(function_type.kind);
            return;
        }
        if (data is .nominal_type(nominal_type)) {
            self.write_int(7);
            self.write_def_ref(ctx, nominal_type.def_id);
            self.write_layout_key_array(ctx, nominal_type.type_args);
            return;
        }
        if (data is .trait_companion_type(companion)) {
            self.write_int(9);
            self.write_def_ref(ctx, companion.trait_def);
            self.write_int(companion.kind);
            return;
        }
        self.write_int(0);
    }

    Void write_layout_key_array(Self&! self, context.CompilerContext& ctx, layout.LayoutKey[]& items) {
        self.write_int(items.length);
        Int index! = 0;
        while (index < items.length) {
            self.write_layout_key(ctx, items[index]);
            index = index + 1;
        }
    }

    Void write_field_layouts(Self&! self, context.CompilerContext& ctx, layout.FieldLayout[]& fields) {
        self.write_int(fields.length);
        Int index! = 0;
        while (index < fields.length) {
            self.write_field_layout(ctx, fields[index]);
            index = index + 1;
        }
    }

    Void write_field_layout(Self&! self, context.CompilerContext& ctx, layout.FieldLayout field) {
        if (field.field_def is .some(field_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, field_def);
        } else {
            self.write_bool(false);
        }
        self.write_type_id(ctx, field.field_type);
        self.write_int(field.offset);
    }

    Void write_jil_body(Self&! self, context.CompilerContext& ctx, jil.Body body) {
        self.write_int(body.locals.length);
        Int index! = 0;
        while (index < body.locals.length) {
            self.write_jil_local(ctx, body.locals[index]);
            index = index + 1;
        }
        self.write_int(body.blocks.length);
        index = 0;
        while (index < body.blocks.length) {
            self.write_jil_block(ctx, body.blocks[index]);
            index = index + 1;
        }
        self.write_int(body.entry.to_index());
        self.write_int(body.return_local.to_index());
    }

    Void write_optional_coroutine_frame(
        Self&! self,
        context.CompilerContext& ctx,
        jil.CoroutineFrameLayout? layout
    ) {
        if (layout is .some(value)) {
            self.write_bool(true);
            self.write_coroutine_frame(ctx, value$.ref());
            return;
        }
        self.write_bool(false);
    }

    Void write_coroutine_frame(Self&! self, context.CompilerContext& ctx, jil.CoroutineFrameLayout& layout) {
        self.write_type_id(ctx, layout.frame_type_id);
        self.write_task_abi(ctx, layout.task_abi);
        self.write_int(layout.state_field_index);
        self.write_int(layout.return_field_index);
        self.write_int(layout.continuation_result_field_index);
        self.write_int(layout.continuation_context_field_index);
        self.write_int(layout.continuation_function_field_index);
        self.write_int(layout.continuation_executor_field_index);
        self.write_int(layout.current_executor_field_index);
        self.write_int(layout.cancellation_enabled_field_index);
        self.write_int(layout.cancellation_context_field_index);
        self.write_int(layout.external_continuation_field_index);
        self.write_type_effect_set(ctx, layout.effects);
        self.write_bool(layout.may_defer);
        self.write_int(layout.fields.length);
        Int index! = 0;
        while (index < layout.fields.length) {
            self.write_coroutine_frame_field(ctx, layout.fields[index]);
            index = index + 1;
        }
        self.write_coroutine_local_mappings(layout.local_mappings);
        self.write_coroutine_suspend_points(layout.suspend_points);
        self.write_task_regions(ctx, layout.task_regions);
        self.write_coroutine_state_dispatch(layout.state_dispatch);
        self.write_int(layout.cancellation_entry.to_index());
    }

    Void write_task_regions(
        Self&! self,
        context.CompilerContext& ctx,
        jil.TaskRegion[]& regions
    ) {
        self.write_int(regions.length);
        Int index! = 0;
        while (index < regions.length) {
            jil.TaskRegion region = regions[index];
            self.write_int(region.task_local.to_index());
            self.write_int(region.origin_block.to_index());
            self.write_int(region.origin_statement_index);
            self.write_optional_block_id(region.release_block);
            self.write_int(region.release_statement_index);
            self.write_int(region.consume_count);
            self.write_int(region.release_count);
            self.write_int(Int(region.storage.allocation));
            self.write_int(Int(region.storage.frame));
            self.write_int(Int(region.storage.sync));
            self.write_int(Int(region.storage.reclaim));
            self.write_optional_jil_function_ref(ctx, region.child_resume);
            index = index + 1;
        }
    }

    Void write_task_abi(Self&! self, context.CompilerContext& ctx, jil.TaskAbiLayout abi) {
        self.write_type_id(ctx, abi.task_type_id);
        self.write_type_id(ctx, abi.task_state_type_id);
        self.write_type_id(ctx, abi.task_state_pointer_type_id);
        self.write_type_id(ctx, abi.result_type_id);
        self.write_type_id(ctx, abi.frame_pointer_type_id);
        self.write_type_id(ctx, abi.resume_return_type_id);
        self.write_type_id(ctx, abi.resume_function_type_id);
        self.write_type_id(ctx, abi.waiter_layout.type_id);
        self.write_type_id(ctx, abi.waiter_layout.pointer_type_id);
        self.write_int(abi.waiter_layout.context_field_index);
        self.write_int(abi.waiter_layout.resume_field_index);
        self.write_int(abi.waiter_layout.executor_field_index);
        self.write_int(abi.waiter_layout.task_field_index);
        self.write_suspend_continuation_layout(ctx, abi.suspend_layout);
        self.write_type_id(ctx, abi.blocking_ack_pointer_type_id);
        self.write_type_id(ctx, abi.bool_type_id);
        self.write_aggregate_field(ctx, abi.state_field);
        self.write_aggregate_field(ctx, abi.frame_field);
        self.write_aggregate_field(ctx, abi.resume_function_field);
        self.write_aggregate_field(ctx, abi.execution_executor_field);
        self.write_aggregate_field(ctx, abi.result_field);
        self.write_aggregate_field(ctx, abi.cancellation_requested_field);
        self.write_aggregate_field(ctx, abi.cancel_target_word_field);
        self.write_aggregate_field(ctx, abi.lifetime_state_field);
        self.write_aggregate_field(ctx, abi.cleanup_function_field);
    }

    Void write_suspend_continuation_layout(
        Self&! self,
        context.CompilerContext& ctx,
        jil.SuspendContinuationLayout layout
    ) {
        self.write_type_id(ctx, layout.type_id);
        self.write_type_id(ctx, layout.pointer_type_id);
        self.write_int(layout.result_field_index);
        self.write_int(layout.context_field_index);
        self.write_int(layout.resume_field_index);
        self.write_int(layout.executor_field_index);
        self.write_int(layout.phase_field_index);
        self.write_int(layout.cancel_request_pointer_field_index);
        self.write_int(layout.cancel_word_pointer_field_index);
        self.write_int(layout.handler_context_field_index);
        self.write_int(layout.handler_function_field_index);
        self.write_int(layout.handler_drop_field_index);
        self.write_int(layout.fallback_cancel_request_field_index);
        self.write_int(layout.fallback_cancel_word_field_index);
        self.write_int(layout.task_field_index);
    }

    Void write_aggregate_field(Self&! self, context.CompilerContext& ctx, jil.AggregateField field) {
        self.write_type_id(ctx, field.type_id);
        self.write_int(field.index);
    }

    Void write_coroutine_frame_field(Self&! self, context.CompilerContext& ctx, jil.CoroutineFrameField field) {
        self.write_int(Int(field.kind));
        self.write_type_id(ctx, field.type_id);
        self.write_optional_jil_local_id(field.local_id);
        self.write_bool(field.live_across_suspend);
        self.write_bool(field.needs_drop);
    }

    Void write_coroutine_local_mappings(Self&! self, jil.CoroutineLocalFrameField[]& mappings) {
        self.write_int(mappings.length);
        Int index! = 0;
        while (index < mappings.length) {
            self.write_int(mappings[index].local_id.to_index());
            self.write_int(mappings[index].field_index);
            index = index + 1;
        }
    }

    Void write_coroutine_suspend_points(Self&! self, jil.CoroutineSuspendPoint[]& points) {
        self.write_int(points.length);
        Int index! = 0;
        while (index < points.length) {
            self.write_int(points[index].state_id);
            self.write_int(points[index].block_id.to_index());
            self.write_int(points[index].resume_target.to_index());
            index = index + 1;
        }
    }

    Void write_coroutine_state_dispatch(Self&! self, jil.CoroutineStateDispatch dispatch) {
        self.write_int(dispatch.entry_state_id);
        self.write_int(dispatch.completed_state_id);
        self.write_int(dispatch.resume_cases.length);
        Int index! = 0;
        while (index < dispatch.resume_cases.length) {
            self.write_int(dispatch.resume_cases[index].state_id);
            self.write_int(dispatch.resume_cases[index].target.to_index());
            index = index + 1;
        }
    }

    Void write_optional_jil_local_id(Self&! self, jil.LocalId? local_id) {
        if (local_id is .some(value)) {
            self.write_bool(true);
            self.write_int(value.to_index());
            return;
        }
        self.write_bool(false);
    }

    Void write_jil_local(Self&! self, context.CompilerContext& ctx, jil.LocalDecl local) {
        self.write_int(local.id.to_index());
        self.write_int(Int(local.kind));
        self.write_type_id(ctx, local.type_id);
        if (local.name is .some(name)) {
            self.write_bool(true);
            self.write_symbol(ctx, name);
        } else {
            self.write_bool(false);
        }
        self.write_optional_selected_def(ctx, local.def_id);
        self.write_bool(local.mutable_local);
        self.write_bool(local.address_taken);
        self.write_optional_jil_local_id(local.coroutine_capture_task);
        if (local.coroutine_capture_kind is .some(kind)) {
            self.write_int(Int(kind) + 1);
        } else {
            self.write_int(0);
        }
    }

    Void write_jil_block(Self&! self, context.CompilerContext& ctx, jil.Block block) {
        self.write_int(block.id.to_index());
        self.write_int(block.statements.length);
        Int index! = 0;
        while (index < block.statements.length) {
            self.write_jil_statement(ctx, block.statements[index]);
            index = index + 1;
        }
        self.write_jil_terminator(ctx, block.terminator);
    }

    Void write_jil_statement(Self&! self, context.CompilerContext& ctx, jil.Statement statement) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            self.write_int(1);
            self.write_jil_place(ctx, assign_stmt.destination);
            self.write_jil_rvalue(ctx, assign_stmt.value);
            return;
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            self.write_int(7);
            self.write_jil_place(ctx, atomic_store.destination);
            self.write_jil_operand(ctx, atomic_store.value);
            self.write_int(jil_atomic_ordering_tag(atomic_store.ordering));
            self.write_int(Int(atomic_store.mode));
            return;
        }
        if (statement.kind is .executor_leave_stmt(executor_leave)) {
            self.write_int(12);
            self.write_int(executor_leave.executor.to_index());
            self.write_int(executor_leave.previous_context.to_index());
            return;
        }
        if (statement.kind is .task_suspend_stmt(suspend)) {
            self.write_int(11);
            self.write_jil_place(ctx, suspend.task);
            self.write_int(Int(suspend.mode));
            return;
        }
        if (statement.kind is .task_complete_stmt(complete)) {
            self.write_int(17);
            self.write_jil_place(ctx, complete.task);
            self.write_int(Int(complete.mode));
            self.write_bool(complete.owner_lifecycle);
            return;
        }
        if (statement.kind is .storage_live_stmt(storage_live)) {
            self.write_int(2);
            self.write_int(storage_live.local_id.to_index());
            return;
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            self.write_int(3);
            self.write_int(storage_dead.local_id.to_index());
            return;
        }
        if (statement.kind is .set_discriminant_stmt(set_discriminant)) {
            self.write_int(4);
            self.write_jil_place(ctx, set_discriminant.destination);
            self.write_int(set_discriminant.discriminant);
            return;
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            self.write_int(5);
            self.write_jil_place(ctx, forget_stmt.place);
            return;
        }
        if (statement.kind is .exclusive_stmt(exclusive_stmt)) {
            self.write_int(6);
            self.write_jil_place(ctx, exclusive_stmt.place);
            return;
        }
        if (statement.kind is .task_wait_stmt(wait)) {
            self.write_int(10);
            self.write_jil_place(ctx, wait.state);
            self.write_bool(wait.wake);
            self.write_jil_operand(ctx, wait.expected);
            return;
        }
        if (statement.kind is .task_region_start_stmt(start)) {
            self.write_int(18);
            self.write_jil_place(ctx, start.task);
            self.write_int(Int(start.storage.allocation));
            self.write_int(Int(start.storage.frame));
            self.write_int(Int(start.storage.sync));
            self.write_int(Int(start.storage.reclaim));
            self.write_optional_jil_function_ref(ctx, start.child_resume);
            return;
        }
        if (statement.kind is .capture_bind_stmt(bind)) {
            self.write_int(20);
            self.write_jil_place(ctx, bind.destination);
            self.write_jil_place(ctx, bind.environment);
            return;
        }
        if (statement.kind is .task_owner_release_stmt(release)) {
            self.write_int(19);
            self.write_jil_place(ctx, release.pointer);
        }
    }

    Void write_jil_terminator(Self&! self, context.CompilerContext& ctx, jil.Terminator terminator) {
        if (terminator.kind is .goto_term(goto_term)) {
            self.write_int(1);
            self.write_int(goto_term.target.to_index());
            self.write_optional_jil_place(ctx, goto_term.initialized_place);
            return;
        }
        if (terminator.kind is .branch_term(branch_term)) {
            self.write_int(2);
            self.write_jil_operand(ctx, branch_term.condition);
            self.write_int(branch_term.then_target.to_index());
            self.write_int(branch_term.else_target.to_index());
            return;
        }
        if (terminator.kind is .switch_term(switch_term)) {
            self.write_switch_terminator(ctx, switch_term);
            return;
        }
        self.write_effect_terminator(ctx, terminator.kind);
    }

    Void write_effect_terminator(Self&! self, context.CompilerContext& ctx, jil.TerminatorKind kind) {
        if (kind is .call_term(call_term)) {
            self.write_call_terminator(ctx, call_term);
            return;
        }
        if (kind is .drop_term(drop_term)) {
            self.write_int(5);
            self.write_jil_place(ctx, drop_term.place);
            self.write_int(drop_term.target.to_index());
            self.write_optional_block_id(drop_term.cleanup);
            return;
        }
        if (kind is .assert_term(assert_term)) {
            self.write_assert_terminator(ctx, assert_term);
            return;
        }
        if (kind is .suspend_pending_term(suspend_pending)) {
            self.write_int(10);
            self.write_int(suspend_pending.target.to_index());
            self.write_int(Int(suspend_pending.suspend_wake));
            self.write_optional_jil_local_id(suspend_pending.task_local);
            return;
        }
        self.write_leaf_terminator(ctx, kind);
    }

    Void write_switch_terminator(Self&! self, context.CompilerContext& ctx, jil.SwitchTerminator switch_term) {
        self.write_int(3);
        self.write_jil_operand(ctx, switch_term.discriminator);
        self.write_int(switch_term.cases.length);
        Int index! = 0;
        while (index < switch_term.cases.length) {
            self.write_jil_const(ctx, switch_term.cases[index].value);
            self.write_int(switch_term.cases[index].target.to_index());
            index = index + 1;
        }
        self.write_int(switch_term.default_target.to_index());
    }

    Void write_call_terminator(Self&! self, context.CompilerContext& ctx, jil.CallTerminator call_term) {
        self.write_int(4);
        self.write_jil_call_callee(ctx, call_term.callee);
        self.write_int(call_term.args.length);
        Int index! = 0;
        while (index < call_term.args.length) {
            self.write_jil_operand(ctx, call_term.args[index]);
            index = index + 1;
        }
        self.write_type_effect_set(ctx, call_term.current_effects);
        self.write_bool(call_term.is_suspend_point);
        self.write_int(Int(call_term.suspend_wake));
        self.write_optional_jil_function_ref(ctx, call_term.suspend_child);
        self.write_bool(call_term.task_handoff);
        if (call_term.async_start is .some(async_start)) {
            self.write_bool(true);
            self.write_int(Int(async_start));
        } else {
            self.write_bool(false);
        }
        self.write_bool(call_term.deferred_async_direct);
        if (call_term.deferred_async_task is .some(task)) {
            self.write_bool(true);
            self.write_int(task.task_local.to_index());
            self.write_int(Int(task.storage.allocation));
            self.write_int(Int(task.storage.frame));
            self.write_int(Int(task.storage.sync));
            self.write_int(Int(task.storage.reclaim));
            self.write_optional_type_id(ctx, task.environment_type);
            self.write_int(task.captures.length);
            index = 0;
            while (index < task.captures.length) {
                self.write_jil_operand(ctx, task.captures[index]);
                index = index + 1;
            }
        } else {
            self.write_bool(false);
        }
        self.write_jil_place(ctx, call_term.destination);
        self.write_int(call_term.target.to_index());
        self.write_optional_jil_place(ctx, call_term.initialized_place);
        self.write_bool(call_term.deferred_initialization);
        self.write_jil_places(ctx, call_term.exclusive_places);
        self.write_optional_block_id(call_term.cleanup);
    }

    Void write_jil_places(Self&! self, context.CompilerContext& ctx, jil.Place[]& places) {
        self.write_int(places.length);
        Int index! = 0;
        while (index < places.length) {
            self.write_jil_place(ctx, places[index]);
            index = index + 1;
        }
    }

    Void write_jil_call_callee(Self&! self, context.CompilerContext& ctx, jil.CallCallee callee) {
        if (callee is .direct_function(function_value)) {
            self.write_int(1);
            self.write_jil_function_ref(ctx, function_value);
            return;
        }
        if (callee is .indirect_operand(operand)) {
            self.write_int(2);
            self.write_jil_operand(ctx, operand);
            return;
        }
        if (callee is .domain_enqueue(enqueue)) {
            self.write_int(3);
            self.write_def_ref(ctx, enqueue.domain_def);
            self.write_int(enqueue.domain_kind);
            self.write_optional_jil_operand(ctx, enqueue.task);
            self.write_jil_operand(ctx, enqueue.resume);
            self.write_bool(enqueue.handoff);
            return;
        }
        if (callee is .dynamic_domain_enqueue(enqueue)) {
            self.write_int(4);
            self.write_jil_operand(ctx, enqueue.executor);
            self.write_optional_jil_operand(ctx, enqueue.task);
            self.write_jil_operand(ctx, enqueue.resume);
            self.write_bool(enqueue.handoff);
            self.write_int(Int(enqueue.mode));
            return;
        }
        self.write_int(0);
    }

    Void write_assert_terminator(Self&! self, context.CompilerContext& ctx, jil.AssertTerminator assert_term) {
        self.write_int(6);
        self.write_jil_operand(ctx, assert_term.condition);
        self.write_bool(assert_term.expected);
        if (assert_term.source_id is .some(source_id)) {
            self.write_bool(true);
            self.write_int(source_id.to_index());
        } else {
            self.write_bool(false);
        }
        self.write_int(assert_term.source_offset);
        if (assert_term.message is .some(message)) {
            self.write_bool(true);
            self.write_jil_operand(ctx, message);
        } else {
            self.write_bool(false);
        }
        self.write_int(assert_term.target.to_index());
        self.write_optional_block_id(assert_term.cleanup);
    }

    Void write_leaf_terminator(Self&! self, context.CompilerContext& ctx, jil.TerminatorKind kind) {
        if (kind is .return_term(return_term)) {
            self.write_int(7);
            self.write_bool(return_term.implicit_unit);
            return;
        }
        if (kind is .cancel_term(_)) {
            self.write_int(10);
            return;
        }
        if (kind is .throw_term(throw_term)) {
            self.write_int(8);
            self.write_jil_operand(ctx, throw_term.error_value);
            return;
        }
        if (kind is .unreachable_term(unreachable_term)) {
            self.write_int(9);
            self.write_bool(unreachable_term.generated_by_check);
            return;
        }
        self.write_int(0);
    }

    Void write_optional_jil_place(Self&! self, context.CompilerContext& ctx, jil.Place? place) {
        if (place is .some(value)) {
            self.write_bool(true);
            self.write_jil_place(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_jil_place(Self&! self, context.CompilerContext& ctx, jil.Place place) {
        if (place.base is .global(global_ref)) {
            self.write_int(1);
            self.write_jil_global_ref(ctx, global_ref);
            self.write_type_id(ctx, global_ref.type_id);
        } else {
            self.write_int(0);
            self.write_int(place.local_id.to_index());
        }
        self.write_int(place.projection.length);
        Int index! = 0;
        while (index < place.projection.length) {
            self.write_jil_place_elem(ctx, place.projection[index]);
            index = index + 1;
        }
    }

    Void write_jil_place_elem(Self&! self, context.CompilerContext& ctx, jil.PlaceElem elem) {
        if (elem is .deref_projection(deref)) {
            self.write_int(1);
            self.write_bool(deref.raw_pointer);
            return;
        }
        if (elem is .field_projection(field)) {
            self.write_int(2);
            self.write_def_ref(ctx, field.field_def);
            self.write_type_id(ctx, field.field_type);
            return;
        }
        if (elem is .frame_field_projection(field)) {
            self.write_int(6);
            self.write_int(field.field_index);
            self.write_type_id(ctx, field.field_type);
            return;
        }
        if (elem is .index_projection(index_projection)) {
            self.write_int(3);
            self.write_int(index_projection.index_local.to_index());
            return;
        }
        self.write_index_place_elem(elem);
    }

    Void write_index_place_elem(Self&! self, jil.PlaceElem elem) {
        if (elem is .constant_index_projection(index_projection)) {
            self.write_int(4);
            self.write_int(index_projection.offset);
            return;
        }
        if (elem is .subslice_projection(subslice)) {
            self.write_int(5);
            self.write_int(subslice.from);
            self.write_int(subslice.to);
            return;
        }
        self.write_int(0);
    }

    Void write_jil_operand(Self&! self, context.CompilerContext& ctx, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.write_int(1);
            self.write_jil_place(ctx, copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.write_int(2);
            self.write_jil_place(ctx, move_operand.place);
            return;
        }
        if (operand is .out_operand(out_operand)) {
            self.write_int(5);
            self.write_jil_place(ctx, out_operand.place);
            return;
        }
        if (operand is .function_operand(function_value)) {
            self.write_int(3);
            self.write_jil_function_ref(ctx, function_value);
            return;
        }
        if (operand is .global_operand(global_value)) {
            self.write_int(4);
            self.write_jil_global_ref(ctx, global_value);
            self.write_type_id(ctx, global_value.type_id);
            return;
        }
        if (operand is .global_address_operand(global_value)) {
            self.write_int(6);
            self.write_jil_global_ref(ctx, global_value);
            self.write_type_id(ctx, global_value.type_id);
            return;
        }
        if (operand is .trait_vtable_operand(vtable)) {
            self.write_int(8);
            self.write_def_ref(ctx, vtable.key.trait_def);
            self.write_type_id(ctx, vtable.key.subject_type);
            self.write_type_id(ctx, vtable.type_id);
            return;
        }
        if (operand is .const_operand(value)) {
            self.write_int(7);
            self.write_jil_const(ctx, value);
        }
    }

    Void write_jil_global_ref(Self&! self, context.CompilerContext& ctx, jil.GlobalRef value) {
        guard self.program is .some(program) else {
            assert(false, "JIL fingerprint requires Program");
            return;
        }
        jil.Global& global = program.globals.ref_at(value.id.to_index());
        if (global.origin is .source(def_id)) {
            self.write_int(1);
            self.write_def_ref(ctx, def_id);
            return;
        }
        guard global.origin is .generated(generated) else { self.write_int(0); return; }
        self.write_int(2);
        self.write_int(Int(generated.kind));
        self.write_def_ref(ctx, generated.provenance_def);
        if (generated.identity_type is .some(type_id)) {
            self.write_bool(true);
            self.write_type_id(ctx, type_id);
        } else {
            self.write_bool(false);
        }
    }

    Void write_jil_function_ref(Self&! self, context.CompilerContext& ctx, jil.FunctionRef value) {
        if (jil.function_target_generated(value.target) is .some(generated)) {
            guard self.program is .some(program) else {
                assert(false, "JIL fingerprint requires Program");
                return;
            }
            jil.Function function = program.function(generated.id);
            guard jil.function_generated_origin(function.origin) is .some(origin) else {
                assert(false, "generated FunctionRef requires generated Function");
                return;
            }
            self.write_int(2);
            self.write_int(Int(origin.kind));
            if (origin.identity_type is .some(type_id)) {
                self.write_int(1);
                self.write_type_id(ctx, type_id);
            } else {
                self.write_int(2);
                self.write_def_ref(ctx, origin.provenance_def);
            }
        } else {
            self.write_int(1);
            self.write_def_ref(ctx, jil.function_target_provenance_def(value.target));
        }
        self.write_generic_arg_array(ctx, value.args);
        self.write_bool(value.coroutine_start);
        self.write_bool(value.coroutine_sync);
        self.write_bool(value.coroutine_resume);
        self.write_bool(value.coroutine_completion);
        self.write_type_id(ctx, value.type_id);
    }

    Void write_optional_jil_function_ref(
        Self&! self,
        context.CompilerContext& ctx,
        jil.FunctionRef? value
    ) {
        if (value is .some(function_ref)) {
            self.write_bool(true);
            self.write_jil_function_ref(ctx, function_ref);
            return;
        }
        self.write_bool(false);
    }

    Void write_jil_const(Self&! self, context.CompilerContext& ctx, jil.Const value) {
        self.write_type_id(ctx, value.type_id);
        if (value.value is .bool_value(bool_value)) {
            self.write_int(1);
            self.write_bool(bool_value.value);
            return;
        }
        if (value.value is .int_value(int_value)) {
            self.write_int(2);
            self.write_uint64(int_value.bits);
            self.write_bool(int_value.signed_value);
            return;
        }
        if (value.value is .float_value(_)) {
            self.write_int(3);
            self.write_uint64(0);
            return;
        }
        self.write_non_numeric_jil_const(ctx, value.value);
    }

    Void write_non_numeric_jil_const(Self&! self, context.CompilerContext& ctx, jil.ConstValue value) {
        if (value is .string_value(string_value)) {
            self.write_int(4);
            self.write_symbol(ctx, string_value.symbol_id);
            return;
        }
        if (value is .null_value(null_value)) {
            self.write_int(5);
            self.write_bool(null_value.typed_null);
            return;
        }
        if (value is .unit_value(unit_value)) {
            self.write_int(6);
            self.write_bool(unit_value.unit_value);
            return;
        }
        self.write_int(0);
    }

    Void write_jil_rvalue(Self&! self, context.CompilerContext& ctx, jil.Rvalue value) {
        if (value is .use_value(use_value)) {
            self.write_int(1);
            self.write_jil_operand(ctx, use_value.value);
            return;
        }
        if (value is .unary_value(unary_value)) {
            self.write_int(2);
            self.write_int(Int(unary_value.op));
            self.write_jil_operand(ctx, unary_value.value);
            return;
        }
        if (value is .binary_value(binary_value)) {
            self.write_binary_rvalue(ctx, binary_value);
            return;
        }
        self.write_non_arithmetic_rvalue(ctx, value);
    }

    Void write_binary_rvalue(Self&! self, context.CompilerContext& ctx, jil.BinaryRvalue value) {
        self.write_int(3);
        self.write_int(Int(value.op));
        self.write_jil_operand(ctx, value.lhs);
        self.write_jil_operand(ctx, value.rhs);
    }

    Void write_non_arithmetic_rvalue(Self&! self, context.CompilerContext& ctx, jil.Rvalue value) {
        if (value is .cast_value(cast_value)) {
            self.write_int(4);
            self.write_int(Int(cast_value.kind));
            self.write_jil_operand(ctx, cast_value.value);
            self.write_type_id(ctx, cast_value.target_type);
            return;
        }
        if (value is .inline_asm_value(inline_asm)) {
            self.write_inline_asm_rvalue(ctx, inline_asm);
            return;
        }
        if (value is .borrow_value(borrow_value)) {
            self.write_int(5);
            self.write_jil_place(ctx, borrow_value.place);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.write_int(6);
            self.write_bool(address_of_value.mutable_pointer);
            self.write_jil_place(ctx, address_of_value.place);
            return;
        }
        if (value is .coroutine_address_value(coroutine_address)) {
            self.write_int(20);
            self.write_jil_place(ctx, coroutine_address.place);
            self.write_bool(coroutine_address.frame_root);
            return;
        }
        if (value is .domain_executor_value(domain_executor)) {
            self.write_int(23);
            self.write_def_ref(ctx, domain_executor.domain_def);
            self.write_int(domain_executor.domain_kind);
            return;
        }
        if (value is .current_executor_value(_)) {
            self.write_int(25);
            return;
        }
        if (value is .scheduled_continuation_resume_value(_)) {
            self.write_int(27);
            return;
        }
        if (value is .executor_enter_value(executor_enter)) {
            self.write_int(26);
            self.write_int(executor_enter.executor.to_index());
            self.write_int(executor_enter.context.to_index());
            return;
        }
        if (value is .current_task_value(current_task)) {
            self.write_int(24);
            self.write_bool(current_task.observed);
            self.write_bool(current_task.cancellation_context);
            return;
        }
        if (value is .atomic_load_value(atomic_load)) {
            self.write_int(21);
            self.write_jil_place(ctx, atomic_load.place);
            self.write_int(jil_atomic_ordering_tag(atomic_load.ordering));
            self.write_int(Int(atomic_load.mode));
            return;
        }
        if (value is .atomic_exchange_value(exchange)) {
            self.write_int(29);
            self.write_jil_place(ctx, exchange.place);
            self.write_jil_operand(ctx, exchange.desired);
            self.write_int(jil_atomic_ordering_tag(exchange.ordering));
            self.write_int(Int(exchange.mode));
            return;
        }
        if (value is .atomic_compare_exchange_value(compare_exchange)) {
            self.write_int(22);
            self.write_jil_place(ctx, compare_exchange.place);
            self.write_jil_operand(ctx, compare_exchange.expected);
            self.write_jil_operand(ctx, compare_exchange.desired);
            self.write_int(jil_atomic_ordering_tag(compare_exchange.success_ordering));
            self.write_int(jil_atomic_ordering_tag(compare_exchange.failure_ordering));
            self.write_int(Int(compare_exchange.mode));
            return;
        }
        if (value is .alloc_box_value(alloc_box_value)) {
            self.write_int(15);
            self.write_type_id(ctx, alloc_box_value.value_type);
            return;
        }
        if (value is .coroutine_frame_alloc_value(frame_alloc)) {
            self.write_int(28);
            self.write_type_id(ctx, frame_alloc.value_type);
            self.write_jil_operand(ctx, frame_alloc.executor);
            return;
        }
        if (value is .alloc_array_value(alloc_array_value)) {
            self.write_int(16);
            self.write_type_id(ctx, alloc_array_value.element_type);
            self.write_jil_operand(ctx, alloc_array_value.count);
            return;
        }
        if (value is .free_value(free_value)) {
            self.write_int(17);
            self.write_jil_operand(ctx, free_value.pointer);
            return;
        }
        if (value is .coroutine_frame_free_value(frame_free)) {
            self.write_int(29);
            self.write_jil_operand(ctx, frame_free.pointer);
            self.write_jil_operand(ctx, frame_free.executor);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.write_slice_rvalue(ctx, slice_value);
            return;
        }
        self.write_projection_rvalue(ctx, value);
    }

    Void write_inline_asm_rvalue(Self&! self, context.CompilerContext& ctx, jil.InlineAsmRvalue value) {
        self.write_int(19);
        self.write_type_id(ctx, value.result_type);
        self.write_symbol(ctx, value.code_symbol);
        self.write_int(value.operands.length);
        Int index! = 0;
        while (index < value.operands.length) {
            self.write_inline_asm_jil_operand(ctx, value.operands[index]);
            index = index + 1;
        }
        self.write_int(value.clobbers.length);
        index = 0;
        while (index < value.clobbers.length) {
            self.write_symbol(ctx, value.clobbers[index]);
            index = index + 1;
        }
        self.write_bool(value.volatile);
        self.write_bool(value.memory);
        self.write_bool(value.noreturn);
    }

    Void write_inline_asm_jil_operand(Self&! self, context.CompilerContext& ctx, jil.InlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.write_int(1);
            self.write_symbol(ctx, input.constraint_symbol);
            self.write_jil_operand(ctx, input.value);
            return;
        }
        if (operand is .output(output)) {
            self.write_int(2);
            self.write_symbol(ctx, output.constraint_symbol);
            self.write_type_id(ctx, output.type_id);
            return;
        }
        self.write_int(0);
    }

    Void write_slice_rvalue(Self&! self, context.CompilerContext& ctx, jil.SliceRvalue value) {
        self.write_int(18);
        self.write_jil_place(ctx, value.base);
        self.write_optional_jil_operand(ctx, value.start);
        self.write_optional_jil_operand(ctx, value.end);
    }

    Void write_optional_jil_operand(Self&! self, context.CompilerContext& ctx, jil.Operand? operand) {
        if (operand is .some(value)) {
            self.write_bool(true);
            self.write_jil_operand(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_projection_rvalue(Self&! self, context.CompilerContext& ctx, jil.Rvalue value) {
        if (value is .len_value(len_value)) {
            self.write_int(7);
            self.write_jil_place(ctx, len_value.place);
            return;
        }
        if (value is .discriminant_value(discriminant_value)) {
            self.write_int(8);
            self.write_jil_place(ctx, discriminant_value.place);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.write_aggregate_rvalue(ctx, aggregate_value);
            return;
        }
        if (value is .closure_value(closure_value)) {
            self.write_closure_rvalue(ctx, closure_value);
            return;
        }
        self.write_special_rvalue(ctx, value);
    }

    Void write_aggregate_rvalue(Self&! self, context.CompilerContext& ctx, jil.AggregateRvalue value) {
        self.write_int(9);
        self.write_int(Int(value.kind));
        self.write_optional_selected_def(ctx, value.def_id);
        self.write_type_id(ctx, value.type_id);
        self.write_int(value.fields.length);
        Int index! = 0;
        while (index < value.fields.length) {
            self.write_jil_operand(ctx, value.fields[index]);
            index = index + 1;
        }
    }

    Void write_closure_rvalue(Self&! self, context.CompilerContext& ctx, jil.ClosureRvalue value) {
        self.write_int(19);
        self.write_def_ref(ctx, value.lambda_def);
        self.write_generic_arg_array(ctx, value.args);
        self.write_type_id(ctx, value.closure_type);
        self.write_type_id(ctx, value.environment_type);
        self.write_type_id(ctx, value.vtable_type);
        self.write_int(Int(value.storage));
        self.write_int(Int(value.environment_storage));
        self.write_optional_jil_place(ctx, value.stack_environment);
        self.write_int(value.captures.length);
        Int index! = 0;
        while (index < value.captures.length) {
            self.write_jil_operand(ctx, value.captures[index]);
            index = index + 1;
        }
    }

    Void write_special_rvalue(Self&! self, context.CompilerContext& ctx, jil.Rvalue value) {
        if (value is .optional_value(optional_value)) {
            self.write_int(10);
            self.write_int(Int(optional_value.op));
            self.write_jil_operand(ctx, optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.write_int(11);
            self.write_int(Int(error_union_value.op));
            self.write_jil_operand(ctx, error_union_value.value);
            return;
        }
        self.write_int(0);
    }

    Void write_optional_block_id(Self&! self, jil.BlockId? block_id) {
        if (block_id is .some(id)) {
            self.write_bool(true);
            self.write_int(id.to_index());
            return;
        }
        self.write_bool(false);
    }

    Void write_def_ref(Self&! self, context.CompilerContext& ctx, qid.DefId def_id) {
        if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
            self.write_bool(true);
            self.write_uint64(stable_id.low);
            self.write_uint64(stable_id.high);
            return;
        }

        // builtin 和尚未接入 stable key 的内部 def 暂时用 DefRecord 结构兜底；
        // 后续磁盘 cache 前必须给这些跨 session 可见 def 补稳定 key。
        self.write_bool(false);
        self.write_def_record(ctx, ctx.store.defs.get(def_id));
    }

    Void write_node_type_check_result(Self&! self, context.CompilerContext& ctx, sem.NodeId node_id) {
        self.write_model_id(ctx, node_id);
        if (ctx.store.typeck.node_type(node_id) is .some(type_id)) {
            self.write_bool(true);
            self.write_type_id(ctx, type_id);
        } else {
            self.write_bool(false);
        }
        self.write_optional_selected_def(ctx, ctx.store.typeck.member_selection(node_id));
        self.write_optional_selected_def(ctx, ctx.store.typeck.pattern_selection(node_id));
        self.write_generic_instance(ctx, ctx.store.typeck.generic_instance(node_id));
    }

    Void write_optional_selected_def(Self&! self, context.CompilerContext& ctx, qid.DefId? selected_def) {
        if (selected_def is .some(def_id)) {
            self.write_bool(true);
            self.write_def_ref(ctx, def_id);
            return;
        }
        self.write_bool(false);
    }

    Void write_generic_instance(Self&! self, context.CompilerContext& ctx, typeck_store.GenericInstance? instance) {
        if (instance is .some(value)) {
            self.write_bool(true);
            self.write_def_ref(ctx, value.def_id);
            self.write_type_id_array(ctx, value.type_args);
            // Const generic arguments affect the selected instantiation just
            // like type arguments, so they must participate in semantic
            // fingerprints as soon as the side table can carry them.
            self.write_comptime_value_array(ctx, value.const_args);
            return;
        }
        self.write_bool(false);
    }

    Void write_comptime_value_array(Self&! self, context.CompilerContext& ctx, comptime_value.ComptimeValue[]& items) {
        self.write_int(items.length);
        Int index! = 0;
        while (index < items.length) {
            self.write_comptime_value(ctx, items[index]);
            index = index + 1;
        }
    }

    Void write_comptime_value(Self&! self, context.CompilerContext& ctx, comptime_value.ComptimeValue value) {
        self.write_type_id(ctx, value.type_id);
        if (value.data is .invalid) { self.write_int(1); return; }
        if (value.data is .unit_value) { self.write_int(2); return; }
        if (value.data is .bool_value(bool_value)) {
            self.write_int(3);
            self.write_bool(bool_value);
            return;
        }
        if (value.data is .int_value(int_value)) {
            self.write_int(4);
            self.write_int(int_value);
            return;
        }
        if (value.data is .uint_value(uint_value)) {
            self.write_int(5);
            self.write_uint64(uint_value);
            return;
        }
        if (value.data is .char_value(char_value)) {
            self.write_int(6);
            self.write_uint64(char_value);
            return;
        }
        if (value.data is .float_bits(float_bits)) {
            self.write_int(7);
            self.write_uint64(float_bits);
            return;
        }
        self.write_aggregate_comptime_value(ctx, value.data);
    }

    Void write_aggregate_comptime_value(
        Self&! self,
        context.CompilerContext& ctx,
        comptime_value.ComptimeValueData data
    ) {
        if (data is .string_value(string_value)) {
            self.write_int(8);
            self.write_symbol(ctx, string_value);
            return;
        }
        if (data is .symbol_value(symbol_value)) {
            self.write_int(9);
            self.write_symbol(ctx, symbol_value);
            return;
        }
        if (data is .const_param_value(const_param)) {
            self.write_int(10);
            self.write_def_ref(ctx, const_param);
            return;
        }
        if (data is .enum_case_value(case_def)) {
            self.write_int(11);
            self.write_def_ref(ctx, case_def);
            return;
        }
        if (data is .struct_value(aggregate)) {
            self.write_int(12);
            Int count = ctx.store.comptime_store.field_count(aggregate);
            self.write_int(count);
            Int index! = 0;
            while (index < count) {
                comptime_value.ComptimeAggregateField field =
                    ctx.store.comptime_store.field_at(aggregate, index);
                self.write_def_ref(ctx, field.field_def);
                self.write_comptime_value(ctx, field.value);
                index = index + 1;
            }
            return;
        }
        if (data is .tuple_value(aggregate)) {
            self.write_int(13);
            self.write_comptime_aggregate(ctx, aggregate);
            return;
        }
        if (data is .array_value(aggregate)) {
            self.write_int(14);
            self.write_comptime_aggregate(ctx, aggregate);
            return;
        }
        self.write_int(0);
    }

    Void write_comptime_aggregate(
        Self&! self,
        context.CompilerContext& ctx,
        comptime_value.ComptimeAggregateId aggregate
    ) {
        Int count = ctx.store.comptime_store.item_count(aggregate);
        self.write_int(count);
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeValue item = ctx.store.comptime_store.item_at(aggregate, index);
            self.write_comptime_value(ctx, item);
            index = index + 1;
        }
    }

    Void write_model_id(Self&! self, context.CompilerContext& ctx, sem.NodeId id) {
        self.write_def_ref(ctx, id.owner_def);
        self.write_int(id.local_index);
    }

    Void write_model_decl(Self&! self, context.CompilerContext& ctx, sem.Decl decl) {
        self.write_int(Int(decl.kind));
        self.write_bool(decl.mutable_binding);
        self.write_bool(decl.is_const);
        self.write_bool(decl.naked);
        self.write_optional_symbol_id(ctx, decl.link_symbol);
        self.write_optional_type_ref_node(ctx, decl.type_ref);
        self.write_optional_model_id(ctx, decl.enum_case_value);
        if (decl.function_signature is .some(signature)) {
            self.write_bool(true);
            self.write_bool(signature.has_receiver);
            self.write_int(Int(signature.receiver_mode));
            self.write_int(signature.params.length);
            Int index! = 0;
            while (index < signature.params.length) {
                self.write_symbol(ctx, signature.param_symbols[index]);
                self.write_type_ref_node(ctx, signature.params[index]);
                index = index + 1;
            }
            self.write_int(signature.exclusive_symbols.length);
            index = 0;
            while (index < signature.exclusive_symbols.length) {
                self.write_symbol(ctx, signature.exclusive_symbols[index]);
                index = index + 1;
            }
            self.write_type_ref_node(ctx, signature.result);
            self.write_model_effect_set(ctx, signature.effects);
            self.write_int(signature.param_defaults.length);
            index = 0;
            while (index < signature.param_defaults.length) {
                sem.ParamDefault param_default = signature.param_defaults[index];
                self.write_int(param_default.param_index);
                self.write_node_data(ctx, ctx.store.model.node(param_default.value).data);
                index = index + 1;
            }
        } else {
            self.write_bool(false);
        }
    }

    Void write_optional_type_ref_node(Self&! self, context.CompilerContext& ctx, sem.NodeId? node_id) {
        if (node_id is .some(value)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_optional_type_id(Self&! self, context.CompilerContext& ctx, qid.TypeId? type_id) {
        if (type_id is .some(value)) {
            self.write_bool(true);
            self.write_type_id(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    Void write_where_predicates(
        Self&! self,
        context.CompilerContext& ctx,
        list.ArrayList<sem.WherePredicate>& predicates
    ) {
        self.write_int(predicates.len());
        Int index! = 0;
        while (index < predicates.len()) {
            self.write_where_predicate(ctx, predicates.get(index));
            index = index + 1;
        }
    }

    Void write_where_predicate(Self&! self, context.CompilerContext& ctx, sem.WherePredicate predicate) {
        if (predicate is .const_type(constraint)) {
            self.write_int(6);
            self.write_def_ref(ctx, constraint.param_def);
            self.write_type_ref_node(ctx, constraint.type_ref);
            return;
        }
        if (predicate is .type_bound(bound)) {
            self.write_int(1);
            self.write_type_ref_node(ctx, bound.subject);
            self.write_type_ref_node(ctx, bound.bound);
            return;
        }
        if (predicate is .negative_type_bound(bound)) {
            self.write_int(4);
            self.write_type_ref_node(ctx, bound.subject);
            self.write_type_ref_node(ctx, bound.bound);
            return;
        }
        if (predicate is .equal(equal)) {
            self.write_int(2);
            self.write_type_ref_node(ctx, equal.subject);
            self.write_type_ref_node(ctx, equal.value);
            return;
        }
        if (predicate is .not_equal(equal)) {
            self.write_int(5);
            self.write_type_ref_node(ctx, equal.subject);
            self.write_type_ref_node(ctx, equal.value);
            return;
        }
        if (predicate is .projection_equal(projection)) {
            self.write_int(3);
            self.write_type_ref_node(ctx, projection.subject);
            self.write_type_ref_node(ctx, projection.trait_ref);
            self.write_symbol(ctx, projection.assoc_symbol);
            self.write_type_ref_node(ctx, projection.value);
        }
    }

    Void write_lifetime_constraints(Self&! self,
        context.CompilerContext& ctx,
        list.ArrayList<sem.LifetimeConstraint>& constraints
    ) {
        self.write_int(constraints.len());
        Int index! = 0;
        while (index < constraints.len()) {
            sem.LifetimeConstraint constraint = constraints.get(index);
            self.write_lifetime_name(ctx, constraint.longer);
            self.write_lifetime_name(ctx, constraint.shorter);
            self.write_int(Int(constraint.relation));
            index = index + 1;
        }
    }

    Void write_life_clauses(
        Self&! self,
        context.CompilerContext& ctx,
        list.ArrayList<sem.LifeClause>& clauses
    ) {
        self.write_int(clauses.len());
        Int index! = 0;
        while (index < clauses.len()) {
            sem.LifeClause clause = clauses.get(index);
            if (clause.target is .some(target)) {
                self.write_bool(true);
                self.write_lifetime_name(ctx, target);
            } else {
                self.write_bool(false);
            }
            self.write_lifetime_name(ctx, clause.source);
            if (clause.source_expression is .some(expression)) {
                self.write_bool(true);
                self.write_lifetime_expression(ctx, expression);
            } else {
                self.write_bool(false);
            }
            index = index + 1;
        }
    }

    Void write_lifetime_expression(
        Self&! self,
        context.CompilerContext& ctx,
        sem.LifetimeExpressionId expression_id
    ) {
        sem.LifetimeExpression expression =
            ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .name(name)) {
            self.write_int(1);
            self.write_lifetime_name(ctx, name);
            return;
        }
        if (expression.data is .product(product)) {
            self.write_int(2);
            self.write_lifetime_expression(ctx, product.left);
            self.write_lifetime_expression(ctx, product.right);
            return;
        }
        guard expression.data is .meet(meet) else {
            self.write_int(0);
            return;
        }
        self.write_int(3);
        self.write_lifetime_expression(ctx, meet.left);
        self.write_lifetime_expression(ctx, meet.right);
    }

    Void write_region_schema(
        Self&! self,
        context.CompilerContext& ctx,
        list.ArrayList<sem.RegionParam>& params,
        list.ArrayList<sem.RegionConstraint>& constraints
    ) {
        self.write_int(params.len());
        Int index! = 0;
        while (index < params.len()) {
            sem.RegionParam param = params.get(index);
            self.write_symbol(ctx, param.name);
            if (param.shape_source is .some(source)) {
                self.write_bool(true);
                self.write_symbol(ctx, source);
            } else {
                self.write_bool(false);
            }
            if (param.default_source is .some(source)) {
                self.write_bool(true);
                self.write_symbol(ctx, source);
            } else {
                self.write_bool(false);
            }
            index = index + 1;
        }
        self.write_int(constraints.len());
        index = 0;
        while (index < constraints.len()) {
            sem.RegionConstraint constraint = constraints.get(index);
            self.write_symbol(ctx, constraint.target);
            self.write_symbol(ctx, constraint.source);
            index = index + 1;
        }
    }

    Void write_lifetime_name(Self&! self, context.CompilerContext& ctx, sem.LifetimeName name) {
        self.write_int(Int(name.kind));
        if (name.symbol is .some(symbol)) {
            self.write_bool(true);
            self.write_symbol(ctx, symbol);
        } else {
            self.write_bool(false);
        }
        if (name.projection_path is .some(path_id)) {
            self.write_bool(true);
            self.write_lifetime_path(ctx, path_id);
        } else {
            self.write_bool(false);
        }
    }

    Void write_lifetime_path(Self&! self, context.CompilerContext& ctx, sem.LifetimePathId path_id) {
        sem.LifetimePathNode node = ctx.store.model.lifetime_path_node(path_id);
        if (node.parent is .some(parent)) {
            self.write_bool(true);
            self.write_lifetime_path(ctx, parent);
        } else {
            self.write_bool(false);
        }
        self.write_int(Int(node.projection.kind));
        if (node.projection.symbol is .some(symbol)) {
            self.write_bool(true);
            self.write_symbol(ctx, symbol);
        } else {
            self.write_bool(false);
        }
        if (node.projection.field_def is .some(field_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, field_def);
        } else {
            self.write_bool(false);
        }
        self.write_int(node.projection.tuple_index);
    }

    Void write_local(Self&! self, context.CompilerContext& ctx, sem.Local local) {
        self.write_int(Int(local.kind));
        self.write_symbol(ctx, local.symbol);
        self.write_def_ref(ctx, local.def_id);
        self.write_bool(local.mutable_binding);
        self.write_bool(local.borrow_binding);
        if (local.type_ref is .some(type_ref)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, type_ref);
            return;
        }
        self.write_bool(false);
    }

    Void write_node(Self&! self, context.CompilerContext& ctx, sem.Node node) {
        self.write_int(node.id.local_index);
        self.write_node_data(ctx, node.data);
    }

    Void write_node_data(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (self.write_expr_node(ctx, data)) { return; }
        if (self.write_stmt_node(ctx, data)) { return; }
        if (self.write_pattern_node(ctx, data)) { return; }
        if (self.write_type_ref_node_data(ctx, data)) { return; }
        self.write_leaf_node(data);
    }

    Bool write_expr_node(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .block(block)) {
            self.write_int(11);
            self.write_model_effect_set(ctx, block.effects);
            self.write_model_id_array(ctx, block.statements);
            self.write_optional_model_id(ctx, block.result);
            return true;
        }
        if (data is .name_ref(name_ref)) {
            self.write_int(12);
            self.write_name_ref(ctx, name_ref);
            return true;
        }
        if (data is .member_access(access)) {
            self.write_int(13);
            self.write_model_id(ctx, access.base);
            self.write_symbol(ctx, access.member_symbol);
            return true;
        }
        if (data is .index_access(access)) {
            self.write_int(14);
            self.write_model_id(ctx, access.base);
            self.write_model_id(ctx, access.index);
            return true;
        }
        if (data is .slice_access(access)) {
            self.write_int(44);
            self.write_model_id(ctx, access.base);
            self.write_optional_model_id(ctx, access.start);
            self.write_optional_model_id(ctx, access.end);
            return true;
        }
        if (data is .struct_literal(literal)) {
            self.write_int(46);
            self.write_model_id(ctx, literal.type_ref);
            self.write_int(literal.fields.length);
            Int index! = 0;
            while (index < literal.fields.length) {
                self.write_symbol(ctx, literal.fields[index].field_symbol);
                self.write_model_id(ctx, literal.fields[index].value);
                index = index + 1;
            }
            return true;
        }
        if (data is .tuple_literal(literal)) {
            self.write_int(47);
            self.write_int(literal.items.length);
            Int index! = 0;
            while (index < literal.items.length) {
                self.write_model_id(ctx, literal.items[index]);
                index = index + 1;
            }
            return true;
        }
        if (data is .array_literal(literal)) {
            self.write_int(48);
            self.write_int(literal.items.length);
            Int index! = 0;
            while (index < literal.items.length) {
                self.write_model_id(ctx, literal.items[index]);
                index = index + 1;
            }
            return true;
        }
        if (data is .range_expr(range_expr)) {
            self.write_int(49);
            self.write_model_id(ctx, range_expr.start);
            self.write_model_id(ctx, range_expr.end);
            return true;
        }
        if (data is .inline_asm(inline_asm)) {
            self.write_inline_asm(ctx, inline_asm);
            return true;
        }
        if (data is .catch_expr(catch_expr)) {
            self.write_int(45);
            self.write_model_id(ctx, catch_expr.value);
            self.write_optional_model_id(ctx, catch_expr.pattern);
            self.write_model_id(ctx, catch_expr.body);
            return true;
        }
        if (data is .call(call)) {
            self.write_call(ctx, call);
            return true;
        }
        if (data is .implicit_call(call)) {
            self.write_implicit_call(ctx, call);
            return true;
        }
        if (sem.literal_node_data(data) is .some(literal)) {
            self.write_int(16);
            self.write_literal(ctx, literal);
            return true;
        }
        return false;
    }

    Bool write_stmt_node(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .let_stmt(let_stmt)) {
            self.write_int(17);
            self.write_int(let_stmt.local_id.to_index());
            self.write_optional_model_id(ctx, let_stmt.initializer);
            return true;
        }
        if (data is .destructure_stmt(destructure)) {
            self.write_int(48);
            self.write_model_id(ctx, destructure.pattern);
            self.write_model_id(ctx, destructure.initializer);
            return true;
        }
        if (data is .guard_stmt(guard_stmt)) {
            self.write_int(18);
            self.write_model_id(ctx, guard_stmt.condition);
            self.write_model_id(ctx, guard_stmt.else_body);
            return true;
        }
        if (data is .assign_stmt(assign_stmt)) {
            self.write_int(19);
            self.write_int(Int(assign_stmt.op));
            self.write_model_id(ctx, assign_stmt.target);
            self.write_model_id(ctx, assign_stmt.value);
            return true;
        }
        if (data is .return_stmt(return_stmt)) {
            self.write_int(20);
            self.write_optional_model_id(ctx, return_stmt.value);
            return true;
        }
        if (data is .throw_stmt(throw_stmt)) {
            self.write_int(48);
            self.write_model_id(ctx, throw_stmt.value);
            return true;
        }
        if (data is .unary(unary)) {
            self.write_int(23);
            self.write_int(Int(unary.op));
            self.write_model_id(ctx, unary.value);
            return true;
        }
        return self.write_control_expr(ctx, data);
    }

    Bool write_control_expr(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .binary(binary)) {
            self.write_int(24);
            self.write_int(Int(binary.op));
            self.write_model_id(ctx, binary.left);
            self.write_model_id(ctx, binary.right);
            return true;
        }
        if (data is .if_expr(if_expr)) {
            self.write_int(25);
            self.write_model_id(ctx, if_expr.condition);
            self.write_model_id(ctx, if_expr.then_body);
            self.write_optional_model_id(ctx, if_expr.else_body);
            return true;
        }
        if (data is .loop_expr(loop_expr)) {
            self.write_loop(ctx, loop_expr);
            return true;
        }
        if (data is .switch_expr(switch_expr)) {
            self.write_switch(ctx, switch_expr);
            return true;
        }
        if (data is .is_pattern(is_pattern)) {
            self.write_int(28);
            self.write_model_id(ctx, is_pattern.value);
            self.write_model_id(ctx, is_pattern.pattern);
            return true;
        }
        if (data is .defer_stmt(defer_stmt)) {
            self.write_int(34);
            self.write_model_id(ctx, defer_stmt.body);
            return true;
        }
        return false;
    }

    Bool write_pattern_node(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .binding_pattern(pattern)) {
            self.write_int(29);
            self.write_int(pattern.local_id.to_index());
            return true;
        }
        if (data is .literal_pattern(pattern)) {
            self.write_int(30);
            self.write_literal(ctx, pattern.literal);
            return true;
        }
        if (data is .optional_pattern(pattern)) {
            self.write_int(31);
            self.write_optional_model_id(ctx, pattern.nested);
            return true;
        }
        if (data is .tuple_pattern(pattern)) {
            self.write_int(51);
            self.write_model_id_array(ctx, pattern.items);
            return true;
        }
        if (data is .variant_pattern(pattern)) {
            self.write_variant_pattern(ctx, pattern);
            return true;
        }
        if (data is .wildcard_pattern) {
            self.write_int(33);
            return true;
        }
        return false;
    }

    Void write_inline_asm(Self&! self, context.CompilerContext& ctx, sem.InlineAsm inline_asm) {
        self.write_int(50);
        self.write_model_id(ctx, inline_asm.result_type);
        self.write_symbol(ctx, inline_asm.code_symbol);
        self.write_int(inline_asm.operands.length);
        Int index! = 0;
        while (index < inline_asm.operands.length) {
            self.write_inline_asm_operand(ctx, inline_asm.operands[index]);
            index = index + 1;
        }
        self.write_int(inline_asm.clobbers.length);
        index = 0;
        while (index < inline_asm.clobbers.length) {
            self.write_symbol(ctx, inline_asm.clobbers[index]);
            index = index + 1;
        }
        self.write_bool(inline_asm.volatile);
        self.write_bool(inline_asm.memory);
        self.write_bool(inline_asm.noreturn);
    }

    Void write_inline_asm_operand(Self&! self, context.CompilerContext& ctx, sem.InlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.write_int(1);
            self.write_symbol(ctx, input.name);
            self.write_symbol(ctx, input.constraint_symbol);
            self.write_model_id(ctx, input.value);
            return;
        }
        if (operand is .output(output)) {
            self.write_int(2);
            self.write_symbol(ctx, output.name);
            self.write_symbol(ctx, output.constraint_symbol);
            self.write_optional_model_id(ctx, output.type_ref);
            return;
        }
        self.write_int(0);
    }

    Bool write_type_ref_node_data(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .named_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .layered_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .array_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .errorable_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .function_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .tuple_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .infer_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .unit_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .invalid_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        return false;
    }

    Void write_leaf_node(Self&! self, sem.NodeData data) {
        if (data is .break_stmt) { self.write_int(21); return; }
        if (data is .continue_stmt) { self.write_int(22); return; }
        self.write_int(0);
    }

    Void write_name_ref(Self&! self, context.CompilerContext& ctx, sem.NameRef name_ref) {
        if (name_ref is .local(local_id)) {
            self.write_int(1);
            self.write_int(local_id.to_index());
            return;
        }
        if (name_ref is .def_ref(def_id)) {
            self.write_int(2);
            self.write_resolved_def_identity(ctx, def_id);
        }
    }

    Void write_resolved_def_identity(Self&! self, context.CompilerContext& ctx, qid.DefId def_id) {
        def.DefRecord def_record = ctx.store.defs.get(def_id);
        if (!self.def_kind_can_overload(def_record.kind)) {
            self.write_int(1);
            self.write_def_ref(ctx, def_id);
            return;
        }

        // resolve 阶段只在 NameRef 中暂存 overload 集合的一项；source lowering
        // 与 `.ji` loading 的声明顺序可能不同。body fingerprint 必须记录排序后的
        // 稳定候选集合，不能把这个临时代表当成最终调用目标。
        self.write_int(2);
        list.ArrayList<qkey.Fingerprint128> candidates! =
            self.overload_candidate_identities(ctx, def_record);
        self.write_int(candidates.len());
        Int index! = 0;
        while (index < candidates.len()) {
            qkey.Fingerprint128 candidate = candidates.get(index);
            self.write_uint64(candidate.low);
            self.write_uint64(candidate.high);
            index = index + 1;
        }
    }

    Bool def_kind_can_overload(self, def.DefKind kind) {
        return kind == .function_def || kind == .init_def || kind == .deinit_def;
    }

    list.ArrayList<qkey.Fingerprint128> overload_candidate_identities(
        self,
        context.CompilerContext& ctx,
        def.DefRecord initial
    ) {
        list.ArrayList<qkey.Fingerprint128> candidates! =
            list.ArrayList<qkey.Fingerprint128>();
        table.MultiTableCursor cursor! = ctx.store.resolve.first_binding_cursor(
            initial.decl_namespace_id,
            initial.name.symbol,
            initial.domain
        );
        while (cursor.valid()) {
            namespace.BindingEntry binding = ctx.store.resolve.binding_at(cursor);
            candidates.add(self.resolved_def_fingerprint(ctx, binding.def_id));
            cursor = ctx.store.resolve.next_binding_cursor(cursor);
        }
        if (candidates.len() == 0) {
            candidates.add(self.resolved_def_fingerprint(ctx, initial.id));
        }
        self.sort_fingerprints(candidates$.mut_ref());
        return candidates;
    }

    qkey.Fingerprint128 resolved_def_fingerprint(
        self,
        context.CompilerContext& ctx,
        qid.DefId def_id
    ) {
        FingerprintWriter writer! = FingerprintWriter();
        if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
            writer.write_int(1);
            writer.write_uint64(stable_id.low);
            writer.write_uint64(stable_id.high);
            return writer.finish();
        }
        writer.write_int(2);
        writer.write_def_record(ctx, ctx.store.defs.get(def_id));
        return writer.finish();
    }

    Void sort_fingerprints(
        self,
        list.ArrayList<qkey.Fingerprint128>&! fingerprints
    ) {
        Int index! = 1;
        while (index < fingerprints.len()) {
            Int current! = index;
            while (current > 0
                && self.fingerprint_less(fingerprints.get(current), fingerprints.get(current - 1))
            ) {
                qkey.Fingerprint128 previous = fingerprints.get(current - 1);
                fingerprints.set(current - 1, fingerprints.get(current));
                fingerprints.set(current, previous);
                current = current - 1;
            }
            index = index + 1;
        }
    }

    Bool fingerprint_less(
        self,
        qkey.Fingerprint128 lhs,
        qkey.Fingerprint128 rhs
    ) {
        if (lhs.low != rhs.low) { return lhs.low < rhs.low; }
        return lhs.high < rhs.high;
    }

    Void write_call(Self&! self, context.CompilerContext& ctx, sem.Call call) {
        self.write_int(14);
        self.write_model_id(ctx, call.callee);
        self.write_model_id_array(ctx, call.type_args);
        self.write_call_arg_array(ctx, call.args);
        if (call.target is .some(target)) {
            self.write_bool(true);
            self.write_resolved_def_identity(ctx, target.def_id);
            return;
        }
        self.write_bool(false);
    }

    Void write_call_arg_array(Self&! self, context.CompilerContext& ctx, sem.CallArg[]& args) {
        self.write_int(args.length);
        Int index! = 0;
        while (index < args.length) {
            sem.CallArg arg = args[index];
            self.write_optional_symbol_id(ctx, arg.label);
            self.write_model_id(ctx, arg.value);
            self.write_bool(arg.trailing);
            index = index + 1;
        }
    }

    Void write_implicit_call(Self&! self, context.CompilerContext& ctx, sem.ImplicitCall call) {
        self.write_int(15);
        self.write_model_id(ctx, call.base);
        self.write_int(Int(call.op));
        self.write_model_id_array(ctx, call.args);
        self.write_bool(call.optional_chain);
    }

    Void write_loop(Self&! self, context.CompilerContext& ctx, sem.Loop loop_expr) {
        self.write_int(26);
        self.write_optional_model_id(ctx, loop_expr.condition);
        self.write_optional_model_id(ctx, loop_expr.pattern);
        self.write_optional_model_id(ctx, loop_expr.iterable);
        self.write_model_id(ctx, loop_expr.body);
    }

    Void write_switch(Self&! self, context.CompilerContext& ctx, sem.Switch switch_expr) {
        self.write_int(27);
        self.write_model_id(ctx, switch_expr.value);
        self.write_int(switch_expr.cases.length);
        Int index! = 0;
        while (index < switch_expr.cases.length) {
            self.write_switch_case(ctx, switch_expr.cases[index]);
            index = index + 1;
        }
    }

    Void write_switch_case(Self&! self, context.CompilerContext& ctx, sem.SwitchCase switch_case) {
        self.write_model_id_array(ctx, switch_case.patterns);
        self.write_model_id(ctx, switch_case.body);
    }

    Void write_variant_pattern(Self&! self, context.CompilerContext& ctx, sem.VariantPattern pattern) {
        self.write_int(32);
        if (pattern.variant_def is .some(variant_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, variant_def);
        } else {
            self.write_bool(false);
        }
        if (pattern.member_symbol is .some(member_symbol)) {
            self.write_bool(true);
            self.write_symbol(ctx, member_symbol);
        } else {
            self.write_bool(false);
        }
        self.write_model_id_array(ctx, pattern.payload);
    }

    Void write_literal(Self&! self, context.CompilerContext& ctx, sem.Literal literal) {
        if (literal.value is .int_value(value)) {
            self.write_int(1);
            self.write_uint64(value.bits);
            self.write_bool(value.signed_value);
            return;
        }
        if (literal.value is .float_value(value)) {
            self.write_int(2);
            // 当前 Semantic Model lowering 尚未保留浮点字面量文本，所有 float literal
            // 都是占位值。这里先写固定槽位，避免把不存在的精度信息伪装成指纹。
            self.write_uint64(0);
            return;
        }
        if (literal.value is .bool_value(value)) {
            self.write_int(3);
            self.write_bool(value);
            return;
        }
        self.write_non_numeric_literal(ctx, literal.value);
    }

    Void write_non_numeric_literal(Self&! self, context.CompilerContext& ctx, sem.LiteralValue value) {
        if (value is .string_value(symbol)) {
            self.write_int(4);
            self.write_symbol(ctx, symbol);
            return;
        }
        if (value is .char_value(char_value)) {
            self.write_int(5);
            self.write_uint64(UInt64(char_value));
            return;
        }
        if (value is .null_value) { self.write_int(6); return; }
        if (value is .unit_value) { self.write_int(7); return; }
        self.write_int(0);
    }

    Void write_optional_signature_id(Self&! self, qid.SignatureId? signature_id) {
        if (signature_id is .some(id)) {
            self.write_bool(true);
            self.write_int(id.index);
            return;
        }
        self.write_bool(false);
    }

    Void write_optional_model_id(Self&! self, context.CompilerContext& ctx, sem.NodeId? id) {
        if (id is .some(node_id)) {
            self.write_bool(true);
            self.write_model_id(ctx, node_id);
            return;
        }
        self.write_bool(false);
    }

    Void write_model_id_array(Self&! self, context.CompilerContext& ctx, sem.NodeId[]& items) {
        self.write_int(items.length);
        Int index! = 0;
        while (index < items.length) {
            self.write_model_id(ctx, items[index]);
            index = index + 1;
        }
    }

    Void write_type_ref_node(Self&! self, context.CompilerContext& ctx, sem.NodeId node_id) {
        self.write_type_ref_data(ctx, ctx.store.model.node(node_id).data);
    }

    Void write_type_ref_data(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .named_type_ref(type_ref)) {
            self.write_named_type_ref(ctx, type_ref);
            return;
        }
        if (data is .layered_type_ref(type_ref)) {
            self.write_layered_type_ref(ctx, type_ref);
            return;
        }
        if (data is .array_type_ref(type_ref)) {
            self.write_array_type_ref(ctx, type_ref);
            return;
        }
        if (data is .errorable_type_ref(type_ref)) {
            self.write_errorable_type_ref(ctx, type_ref);
            return;
        }
        if (data is .function_type_ref(type_ref)) {
            self.write_function_type_ref(ctx, type_ref);
            return;
        }
        self.write_leaf_type_ref(ctx, data);
    }

    Void write_leaf_type_ref(Self&! self, context.CompilerContext& ctx, sem.NodeData data) {
        if (data is .tuple_type_ref(type_ref)) {
            self.write_int(7);
            self.write_int(type_ref.items.length);
            if (type_ref.contract_names is .some(names)) {
                self.write_int(names.length);
                Int index! = 0;
                while (index < names.length) {
                    self.write_symbol(ctx, names[index]);
                    index = index + 1;
                }
                return;
            }
            self.write_int(0);
            return;
        }
        if (data is .infer_type_ref) { self.write_int(8); return; }
        if (data is .unit_type_ref) { self.write_int(9); return; }
        if (data is .invalid_type_ref) { self.write_int(10); return; }
        self.write_int(0);
    }

    Void write_named_type_ref(Self&! self, context.CompilerContext& ctx, sem.NamedTypeRef type_ref) {
        self.write_int(1);
        self.write_def_ref(ctx, type_ref.def_id);
        self.write_type_ref_array(ctx, type_ref.args);
        if (type_ref.contract_names is .some(names)) {
            self.write_int(names.length);
            Int index! = 0;
            while (index < names.length) {
                self.write_symbol(ctx, names[index]);
                index = index + 1;
            }
            return;
        }
        self.write_int(0);
    }

    Void write_layered_type_ref(Self&! self, context.CompilerContext& ctx, sem.LayeredTypeRef type_ref) {
        self.write_int(2);
        self.write_int(Int(type_ref.kind));
        self.write_int(Int(type_ref.sentinel_kind));
        self.write_uint64(type_ref.sentinel_value);
        self.write_type_ref_node(ctx, type_ref.element);
    }

    Void write_array_type_ref(Self&! self, context.CompilerContext& ctx, sem.ArrayTypeRef type_ref) {
        self.write_int(3);
        self.write_type_ref_node(ctx, type_ref.element);
        self.write_int(Int(type_ref.count_kind));
        self.write_uint64(type_ref.count_value);
        self.write_int(Int(type_ref.sentinel_kind));
        self.write_uint64(type_ref.sentinel_value);
    }

    Void write_errorable_type_ref(Self&! self, context.CompilerContext& ctx, sem.ErrorableTypeRef type_ref) {
        self.write_int(4);
        self.write_type_ref_node(ctx, type_ref.value_type);
        if (type_ref.error_type is .some(error_type)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, error_type);
        } else {
            self.write_bool(false);
        }
    }

    Void write_function_type_ref(Self&! self, context.CompilerContext& ctx, sem.FunctionTypeRef type_ref) {
        self.write_int(5);
        self.write_type_ref_array(ctx, type_ref.params);
        self.write_type_ref_node(ctx, type_ref.result);
        self.write_model_effect_set(ctx, type_ref.effects);
    }

    Void write_model_effect_set(Self&! self, context.CompilerContext& ctx, sem.EffectSet effects) {
        self.write_bool(effects.has_unsafe);
        self.write_bool(effects.has_async);
        self.write_optional_model_id(ctx, effects.domain);
        self.write_optional_model_id(ctx, effects.context);
    }

    Void write_type_effect_set(Self&! self, context.CompilerContext& ctx, types.EffectSet effects) {
        self.write_bool(effects.has_unsafe);
        self.write_bool(effects.has_async);
        if (effects.domain is .some(domain)) {
            self.write_bool(true);
            self.write_def_ref(ctx, domain.binding);
            self.write_type_id(ctx, domain.domain_type);
            return;
        }
        self.write_bool(false);
    }

    Void write_type_ref_array(Self&! self, context.CompilerContext& ctx, sem.NodeId[]& items) {
        self.write_int(items.length);
        Int index! = 0;
        while (index < items.length) {
            self.write_type_ref_node(ctx, items[index]);
            index = index + 1;
        }
    }
}
