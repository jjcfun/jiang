// HIR fingerprint 计算。
//
// fingerprint 只描述语义结构，不写入 span/source offset。源码位置变化应该更新
// SourceMap，但不应该让 signature/body cache 失效。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import layout = "../layout/layout.jiang";
import mir = "../mir/mir.jiang";
import module_graph = "../resolve/module_graph.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import blake3 = "../support/blake3.jiang";
import list = "../support/list.jiang";

public () fingerprint_module_graph(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    Int! index = 0;
    while (index < graph.module_count()) {
        qid.ModuleId module_id = graph.module_at(index);
        qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
        fingerprint_def_tree(ctx, module_def);
        index = index + 1;
    }
}

public () fingerprint_type_check_results(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    // TypeCheckStore 是本次 compilation 的 side table，不写入 stable symbol index。
    // 这里暂时保留入口，后续 object key 需要时再接入独立 cache 层。
}

() fingerprint_def_tree(context.CompilerContext& ctx, qid.DefId def_id) {
    guard ctx.store.hirs.def(def_id) != null else { return; }
    hir.HirDef& hir_def = ctx.store.hirs.def_ref(def_id);
    if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
        ctx.store.incremental.set_signature_fingerprint(stable_id, hir_signature_fingerprint(ctx, hir_def));
        ctx.store.incremental.set_body_fingerprint(stable_id, hir_body_fingerprint(ctx, hir_def));
    }

    Int! index = 0;
    while (index < hir_def.members.len()) {
        fingerprint_def_tree(ctx, hir_def.members.get(index));
        index = index + 1;
    }
}

public qkey.Fingerprint128 hir_signature_fingerprint(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    FingerprintWriter writer = FingerprintWriter();
    def.DefRecord def_record = ctx.store.defs.get(hir_def.def_id);
    writer.write_int(1);
    writer.write_def_record(ctx, def_record);
    writer.write_hir_decl(ctx, hir_def.decl);
    writer.write_optional_type_ref_node(ctx, hir_def.enum_underlying_type_ref);
    writer.write_bool(hir_def.layout_options.packed);
    writer.write_int(hir_def.layout_options.align);
    writer.write_int(hir_def.members.len());
    writer.write_int(hir_def.trait_refs.len());
    Int! trait_index = 0;
    while (trait_index < hir_def.trait_refs.len()) {
        writer.write_type_ref_node(ctx, hir_def.trait_refs.get(trait_index));
        trait_index = trait_index + 1;
    }
    writer.write_where_predicates(ctx, hir_def.where_predicates$.ref());
    writer.write_lifetime_constraints(ctx, hir_def.lifetime_constraints$.ref());
    if (hir_def.custom_deinit_def is .some(deinit_def)) {
        writer.write_bool(true);
        writer.write_def_ref(ctx, deinit_def);
    } else {
        writer.write_bool(false);
    }
    return writer.finish();
}

public qkey.Fingerprint128 hir_body_fingerprint(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    FingerprintWriter writer = FingerprintWriter();
    writer.write_int(2);
    if (hir_def.body is .some(ref _ body)) {
        writer.write_bool(true);
        writer.write_hir_id(ctx, body.root);
        writer.write_int(body.locals.len());
        Int! index = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            writer.write_local(ctx, local);
            index = index + 1;
        }
        writer.write_int(hir_def.nodes.len());
        index = 0;
        while (index < hir_def.nodes.len()) {
            writer.write_node(ctx, hir_def.nodes.get(index));
            index = index + 1;
        }
    } else {
        writer.write_bool(false);
    }
    return writer.finish();
}

public qkey.Fingerprint128 type_check_fingerprint(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    FingerprintWriter writer = FingerprintWriter();
    writer.write_int(3);
    if (ctx.store.typeck.def_type(hir_def.def_id) is .some(type_id)) {
        writer.write_bool(true);
        writer.write_type_id(ctx, type_id);
    } else {
        writer.write_bool(false);
    }
    writer.write_optional_type_id(ctx, ctx.store.typeck.enum_underlying_type(hir_def.def_id));
    if (ctx.store.typeck.enum_case_value(hir_def.def_id) is .some(case_value)) {
        writer.write_bool(true);
        writer.write_int(case_value);
    } else {
        writer.write_bool(false);
    }

    Int! index = 0;
    while (index < hir_def.nodes.len()) {
        writer.write_node_type_check_result(ctx, hir_def.nodes.get(index).id);
        index = index + 1;
    }
    return writer.finish();
}

public qkey.Fingerprint128 type_layout_fingerprint(context.CompilerContext& ctx, layout.TypeLayout type_layout) {
    FingerprintWriter writer = FingerprintWriter();
    writer.write_int(4);
    writer.write_layout_key(ctx, type_layout.key);
    writer.write_int(Int(type_layout.kind));
    writer.write_int(type_layout.size);
    writer.write_int(type_layout.align);
    writer.write_int(type_layout.stride);
    writer.write_field_layouts(ctx, type_layout.fields);
    return writer.finish();
}

public () fingerprint_mir_store(context.CompilerContext& ctx, mir.MirStore& store) {
    // MIR 是本次 compilation 的 concrete codegen input，不写入 stable symbol index。
    // object cache 后续用独立 key 记录 MIR/layout/body 等 codegen 输入。
}

public qkey.Fingerprint128 mir_function_fingerprint(context.CompilerContext& ctx, mir.MirFunction function) {
    FingerprintWriter writer = FingerprintWriter();
    writer.write_int(6);
    writer.write_def_ref(ctx, function.def_id);
    writer.write_type_id_array(ctx, function.type_args);
    writer.write_comptime_value_array(ctx, function.const_args);
    writer.write_optional_signature_id(function.signature_id);
    writer.write_type_effect_set(ctx, function.effects);
    writer.write_bool(function.is_coroutine);
    writer.write_optional_coroutine_frame(ctx, function.coroutine_frame);
    writer.write_mir_body(ctx, function.body);
    return writer.finish();
}

struct FingerprintWriter: Movable {
    list.ArrayList<UInt8>! bytes;

    public init(self) {
        self.bytes = list.ArrayList<UInt8>();
    }

    qkey.Fingerprint128 finish(self) {
        blake3.Blake3Hash digest = blake3.blake3_hash(self.bytes.slice());
        return qkey.Fingerprint128(digest.a, digest.b);
    }

    () write_bool(self, Bool value) {
        if (value) {
            self.write_byte(1);
        } else {
            self.write_byte(0);
        }
    }

    () write_int(self, Int value) {
        self.write_uint64(UInt64(value));
    }

    () write_uint64(self, UInt64 value) {
        UInt64! current = value;
        Int! index = 0;
        while (index < 8) {
            self.write_byte(UInt8(current & 255));
            current = current >> 8;
            index = index + 1;
        }
    }

    () write_byte(self, UInt8 value) {
        self.bytes.add(value);
    }

    () write_symbol(self, context.CompilerContext& ctx, qid.SymbolId symbol) {
        UInt8[]& text = ctx.store.symbols.text(symbol);
        self.write_int(text.length);
        self.write_bytes(text);
    }

    () write_bytes(self, UInt8[]& bytes) {
        Int! index = 0;
        while (index < bytes.length) {
            self.write_byte(bytes[index]);
            index = index + 1;
        }
    }

    () write_optional_symbol_id(self, context.CompilerContext& ctx, qid.SymbolId? symbol) {
        if (symbol is .some(value)) {
            self.write_bool(true);
            self.write_symbol(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_optional_def_id(self, context.CompilerContext& ctx, qid.DefId? def_id) {
        if (def_id is .some(value)) {
            self.write_bool(true);
            self.write_def_ref(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_def_record(self, context.CompilerContext& ctx, def.DefRecord def_record) {
        self.write_int(Int(def_record.kind));
        self.write_int(Int(def_record.domain));
        self.write_int(Int(def_record.visibility));
        self.write_symbol(ctx, def_record.name.symbol);
        if (def_record.owner_def is .some(owner_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, owner_def);
        } else {
            self.write_bool(false);
        }
    }

    () write_type_id(self, context.CompilerContext& ctx, qid.TypeId type_id) {
        self.write_type_info(ctx, ctx.store.types.get(type_id));
    }

    () write_type_info(self, context.CompilerContext& ctx, types.TypeInfo info) {
        self.write_bool(info.is_mutable);
        self.write_type_data(ctx, info.data);
    }

    () write_type_data(self, context.CompilerContext& ctx, types.TypeData data) {
        if (self.write_builtin_type_data(data)) { return; }
        if (data is .named(named)) {
            self.write_int(7);
            self.write_def_ref(ctx, named.def_id);
            self.write_type_id_array(ctx, named.type_args);
            self.write_comptime_value_array(ctx, named.const_args);
            return;
        }
        if (data is .optional(optional)) {
            self.write_int(8);
            self.write_type_id(ctx, optional.element);
            return;
        }
        if (data is .error_union(error_union)) {
            self.write_int(9);
            self.write_type_id(ctx, error_union.value);
            self.write_type_id(ctx, error_union.error);
            return;
        }
        self.write_compound_type_data(ctx, data);
    }

    Bool write_builtin_type_data(self, types.TypeData data) {
        if (data is .invalid) { self.write_int(1); return true; }
        if (data is .never) { self.write_int(2); return true; }
        if (data is .unit) { self.write_int(3); return true; }
        if (data is .bool_type) { self.write_int(4); return true; }
        if (data is .char_type) { self.write_int(5); return true; }
        if (data is .int_type(int_type)) {
            self.write_int(6);
            self.write_int(int_type.bits);
            self.write_bool(int_type.signed);
            return true;
        }
        if (data is .float_type(float_type)) {
            self.write_int(10);
            self.write_int(float_type.bits);
            return true;
        }
        return false;
    }

    () write_compound_type_data(self, context.CompilerContext& ctx, types.TypeData data) {
        if (data is .handle_type(handle_type)) {
            self.write_int(11);
            self.write_int(Int(handle_type.kind));
            self.write_bool(types.sentinel_has(handle_type.sentinel));
            self.write_uint64(types.sentinel_value(handle_type.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(handle_type.sentinel));
            self.write_type_id(ctx, handle_type.element);
            return;
        }
        if (data is .slice_value_type(slice_value)) {
            self.write_int(15);
            self.write_type_id(ctx, slice_value.element);
            self.write_bool(types.sentinel_has(slice_value.sentinel));
            self.write_uint64(types.sentinel_value(slice_value.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(slice_value.sentinel));
            return;
        }
        if (data is .tuple_type(tuple_type)) {
            self.write_int(12);
            self.write_type_id_array(ctx, tuple_type.items);
            return;
        }
        if (data is .array_type(array_type)) {
            self.write_int(14);
            self.write_type_id(ctx, array_type.element);
            self.write_int(array_type.count);
            self.write_bool(types.sentinel_has(array_type.sentinel));
            self.write_uint64(types.sentinel_value(array_type.sentinel));
            self.write_optional_def_id(ctx, types.sentinel_param(array_type.sentinel));
            return;
        }
        if (data is .function_type(function_type)) {
            self.write_int(13);
            self.write_type_id_array(ctx, function_type.params);
            self.write_type_id(ctx, function_type.result);
            self.write_type_effect_set(ctx, function_type.effects);
            return;
        }
        self.write_int(0);
    }

    () write_type_id_array(self, context.CompilerContext& ctx, qid.TypeId[]& items) {
        self.write_int(items.length);
        Int! index = 0;
        while (index < items.length) {
            self.write_type_id(ctx, items[index]);
            index = index + 1;
        }
    }

    () write_layout_key(self, context.CompilerContext& ctx, layout.LayoutKey key) {
        if (key.data is .builtin(builtin)) {
            self.write_int(1);
            self.write_int(Int(builtin.kind));
            self.write_int(builtin.bits);
            self.write_bool(builtin.signed);
            return;
        }
        if (key.data is .tuple_type(tuple_type)) {
            self.write_int(2);
            self.write_layout_key_array(ctx, tuple_type.items);
            return;
        }
        if (key.data is .array_type(array_type)) {
            self.write_int(8);
            self.write_layout_key_array(ctx, array_type.element);
            self.write_int(array_type.count);
            self.write_bool(array_type.has_sentinel);
            self.write_uint64(array_type.sentinel_value);
            return;
        }
        if (key.data is .optional_type(optional_type)) {
            self.write_int(3);
            self.write_layout_key_array(ctx, optional_type.items);
            return;
        }
        self.write_non_builtin_layout_key(ctx, key.data);
    }

    () write_non_builtin_layout_key(self, context.CompilerContext& ctx, layout.LayoutKeyData data) {
        if (data is .error_union_type(error_union_type)) {
            self.write_int(4);
            self.write_layout_key_array(ctx, error_union_type.items);
            return;
        }
        if (data is .handle_type(handle_type)) {
            self.write_int(5);
            self.write_int(Int(handle_type.kind));
            self.write_layout_key_array(ctx, handle_type.element);
            return;
        }
        if (data is .function_type(function_type)) {
            self.write_int(6);
            self.write_int(function_type.kind);
            return;
        }
        if (data is .nominal_type(nominal_type)) {
            self.write_int(7);
            self.write_def_ref(ctx, nominal_type.def_id);
            self.write_layout_key_array(ctx, nominal_type.type_args);
            return;
        }
        if (data is .trait_companion_type(companion)) {
            self.write_int(9);
            self.write_def_ref(ctx, companion.trait_def);
            self.write_int(companion.kind);
            return;
        }
        self.write_int(0);
    }

    () write_layout_key_array(self, context.CompilerContext& ctx, layout.LayoutKey[]& items) {
        self.write_int(items.length);
        Int! index = 0;
        while (index < items.length) {
            self.write_layout_key(ctx, items[index]);
            index = index + 1;
        }
    }

    () write_field_layouts(self, context.CompilerContext& ctx, layout.FieldLayout[]& fields) {
        self.write_int(fields.length);
        Int! index = 0;
        while (index < fields.length) {
            self.write_field_layout(ctx, fields[index]);
            index = index + 1;
        }
    }

    () write_field_layout(self, context.CompilerContext& ctx, layout.FieldLayout field) {
        if (field.field_def is .some(field_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, field_def);
        } else {
            self.write_bool(false);
        }
        self.write_type_id(ctx, field.field_type);
        self.write_int(field.offset);
    }

    () write_mir_body(self, context.CompilerContext& ctx, mir.MirBody body) {
        self.write_int(body.locals.length);
        Int! index = 0;
        while (index < body.locals.length) {
            self.write_mir_local(ctx, body.locals[index]);
            index = index + 1;
        }
        self.write_int(body.blocks.length);
        index = 0;
        while (index < body.blocks.length) {
            self.write_mir_block(ctx, body.blocks[index]);
            index = index + 1;
        }
        self.write_int(body.entry.to_index());
        self.write_int(body.return_local.to_index());
    }

    () write_optional_coroutine_frame(
        self,
        context.CompilerContext& ctx,
        mir.MirCoroutineFrameLayout? layout
    ) {
        if (layout is .some(value)) {
            self.write_bool(true);
            self.write_coroutine_frame(ctx, value$.ref());
            return;
        }
        self.write_bool(false);
    }

    () write_coroutine_frame(self, context.CompilerContext& ctx, mir.MirCoroutineFrameLayout& layout) {
        self.write_type_id(ctx, layout.frame_type_id);
        self.write_future_abi(ctx, layout.future_abi);
        self.write_int(layout.state_field_index);
        self.write_int(layout.return_field_index);
        self.write_int(layout.continuation_result_field_index);
        self.write_int(layout.continuation_context_field_index);
        self.write_int(layout.continuation_function_field_index);
        self.write_type_effect_set(ctx, layout.effects);
        self.write_int(layout.fields.length);
        Int! index = 0;
        while (index < layout.fields.length) {
            self.write_coroutine_frame_field(ctx, layout.fields[index]);
            index = index + 1;
        }
        self.write_coroutine_local_mappings(layout.local_mappings);
        self.write_coroutine_suspend_points(layout.suspend_points);
        self.write_coroutine_state_dispatch(layout.state_dispatch);
        self.write_int(layout.future_consumptions.length);
        Int! future_index = 0;
        while (future_index < layout.future_consumptions.length) {
            mir.MirFutureConsumption consumption = layout.future_consumptions[future_index];
            self.write_int(consumption.future_local.to_index());
            self.write_int(consumption.start_block.to_index());
            self.write_bool(consumption.consume_block != null);
            if (consumption.consume_block is .some(consume_block)) {
                self.write_int(consume_block.to_index());
            }
            self.write_int(Int(consumption.storage));
            future_index = future_index + 1;
        }
    }

    () write_future_abi(self, context.CompilerContext& ctx, mir.MirFutureAbiLayout abi) {
        self.write_type_id(ctx, abi.future_type_id);
        self.write_type_id(ctx, abi.task_state_type_id);
        self.write_type_id(ctx, abi.task_state_pointer_type_id);
        self.write_type_id(ctx, abi.result_type_id);
        self.write_type_id(ctx, abi.frame_pointer_type_id);
        self.write_type_id(ctx, abi.resume_return_type_id);
        self.write_type_id(ctx, abi.resume_function_type_id);
        self.write_type_id(ctx, abi.waiter_resume_function_type_id);
        self.write_type_id(ctx, abi.bool_type_id);
        self.write_int(abi.handle_pointer_field_index);
        self.write_synthetic_field(ctx, abi.state_field);
        self.write_synthetic_field(ctx, abi.frame_field);
        self.write_synthetic_field(ctx, abi.resume_function_field);
        self.write_synthetic_field(ctx, abi.result_field);
        self.write_synthetic_field(ctx, abi.result_drop_field);
        self.write_synthetic_field(ctx, abi.waiter_registered_field);
        self.write_synthetic_field(ctx, abi.waiter_context_field);
        self.write_synthetic_field(ctx, abi.waiter_resume_field);
        self.write_synthetic_field(ctx, abi.waiter_domain_id_field);
        self.write_synthetic_field(ctx, abi.waiter_domain_kind_field);
        self.write_synthetic_field(ctx, abi.allocation_pointer_field);
        self.write_synthetic_field(ctx, abi.ownership_state_field);
    }

    () write_synthetic_field(self, context.CompilerContext& ctx, mir.MirSyntheticField field) {
        self.write_symbol(ctx, ctx.store.defs.get(field.def_id).name.symbol);
        self.write_type_id(ctx, field.type_id);
        self.write_int(field.index);
    }

    () write_coroutine_frame_field(self, context.CompilerContext& ctx, mir.MirCoroutineFrameField field) {
        self.write_int(Int(field.kind));
        self.write_type_id(ctx, field.type_id);
        self.write_optional_mir_local_id(field.local_id);
        self.write_bool(field.live_across_suspend);
        self.write_bool(field.needs_drop);
    }

    () write_coroutine_local_mappings(self, mir.MirCoroutineLocalFrameField[]& mappings) {
        self.write_int(mappings.length);
        Int! index = 0;
        while (index < mappings.length) {
            self.write_int(mappings[index].local_id.to_index());
            self.write_int(mappings[index].field_index);
            index = index + 1;
        }
    }

    () write_coroutine_suspend_points(self, mir.MirCoroutineSuspendPoint[]& points) {
        self.write_int(points.length);
        Int! index = 0;
        while (index < points.length) {
            self.write_int(points[index].state_id);
            self.write_int(points[index].block_id.to_index());
            self.write_int(points[index].resume_target.to_index());
            index = index + 1;
        }
    }

    () write_coroutine_state_dispatch(self, mir.MirCoroutineStateDispatch dispatch) {
        self.write_int(dispatch.entry_state_id);
        self.write_int(dispatch.completed_state_id);
        self.write_int(dispatch.resume_cases.length);
        Int! index = 0;
        while (index < dispatch.resume_cases.length) {
            self.write_int(dispatch.resume_cases[index].state_id);
            self.write_int(dispatch.resume_cases[index].target.to_index());
            index = index + 1;
        }
    }

    () write_optional_mir_local_id(self, mir.MirLocalId? local_id) {
        if (local_id is .some(value)) {
            self.write_bool(true);
            self.write_int(value.to_index());
            return;
        }
        self.write_bool(false);
    }

    () write_mir_local(self, context.CompilerContext& ctx, mir.MirLocalDecl local) {
        self.write_int(local.id.to_index());
        self.write_int(Int(local.kind));
        self.write_type_id(ctx, local.type_id);
        if (local.name is .some(name)) {
            self.write_bool(true);
            self.write_symbol(ctx, name);
        } else {
            self.write_bool(false);
        }
        self.write_optional_selected_def(ctx, local.def_id);
        self.write_bool(local.mutable_local);
        self.write_bool(local.address_taken);
    }

    () write_mir_block(self, context.CompilerContext& ctx, mir.MirBlock block) {
        self.write_int(block.id.to_index());
        self.write_int(block.statements.length);
        Int! index = 0;
        while (index < block.statements.length) {
            self.write_mir_statement(ctx, block.statements[index]);
            index = index + 1;
        }
        self.write_mir_terminator(ctx, block.terminator);
    }

    () write_mir_statement(self, context.CompilerContext& ctx, mir.MirStatement statement) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            self.write_int(1);
            self.write_mir_place(ctx, assign_stmt.destination);
            self.write_mir_rvalue(ctx, assign_stmt.value);
            return;
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            self.write_int(7);
            self.write_mir_place(ctx, atomic_store.destination);
            self.write_mir_operand(ctx, atomic_store.value);
            return;
        }
        if (statement.kind is .storage_live_stmt(storage_live)) {
            self.write_int(2);
            self.write_int(storage_live.local_id.to_index());
            return;
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            self.write_int(3);
            self.write_int(storage_dead.local_id.to_index());
            return;
        }
        if (statement.kind is .set_discriminant_stmt(set_discriminant)) {
            self.write_int(4);
            self.write_mir_place(ctx, set_discriminant.destination);
            self.write_int(set_discriminant.discriminant);
            return;
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            self.write_int(5);
            self.write_mir_place(ctx, forget_stmt.place);
            return;
        }
        if (statement.kind is .unique_stmt(unique_stmt)) {
            self.write_int(6);
            self.write_mir_place(ctx, unique_stmt.place);
        }
    }

    () write_mir_terminator(self, context.CompilerContext& ctx, mir.MirTerminator terminator) {
        if (terminator.kind is .goto_term(goto_term)) {
            self.write_int(1);
            self.write_int(goto_term.target.to_index());
            return;
        }
        if (terminator.kind is .branch_term(branch_term)) {
            self.write_int(2);
            self.write_mir_operand(ctx, branch_term.condition);
            self.write_int(branch_term.then_target.to_index());
            self.write_int(branch_term.else_target.to_index());
            return;
        }
        if (terminator.kind is .switch_term(switch_term)) {
            self.write_switch_terminator(ctx, switch_term);
            return;
        }
        self.write_effect_terminator(ctx, terminator.kind);
    }

    () write_effect_terminator(self, context.CompilerContext& ctx, mir.MirTerminatorKind kind) {
        if (kind is .call_term(call_term)) {
            self.write_call_terminator(ctx, call_term);
            return;
        }
        if (kind is .drop_term(drop_term)) {
            self.write_int(5);
            self.write_mir_place(ctx, drop_term.place);
            self.write_int(drop_term.target.to_index());
            self.write_optional_block_id(drop_term.cleanup);
            return;
        }
        if (kind is .assert_term(assert_term)) {
            self.write_assert_terminator(ctx, assert_term);
            return;
        }
        if (kind is .suspend_pending_term(suspend_pending)) {
            self.write_int(10);
            if (suspend_pending.future is .some(place)) {
                self.write_bool(true);
                self.write_mir_place(ctx, place);
            } else {
                self.write_bool(false);
            }
            self.write_int(suspend_pending.target.to_index());
            return;
        }
        self.write_leaf_terminator(ctx, kind);
    }

    () write_switch_terminator(self, context.CompilerContext& ctx, mir.MirSwitchTerminator switch_term) {
        self.write_int(3);
        self.write_mir_operand(ctx, switch_term.discriminator);
        self.write_int(switch_term.cases.length);
        Int! index = 0;
        while (index < switch_term.cases.length) {
            self.write_mir_const(ctx, switch_term.cases[index].value);
            self.write_int(switch_term.cases[index].target.to_index());
            index = index + 1;
        }
        self.write_int(switch_term.default_target.to_index());
    }

    () write_call_terminator(self, context.CompilerContext& ctx, mir.MirCallTerminator call_term) {
        self.write_int(4);
        self.write_mir_call_callee(ctx, call_term.callee);
        self.write_int(call_term.args.length);
        Int! index = 0;
        while (index < call_term.args.length) {
            self.write_mir_operand(ctx, call_term.args[index]);
            index = index + 1;
        }
        self.write_type_effect_set(ctx, call_term.current_effects);
        self.write_bool(call_term.is_suspend_point);
        self.write_mir_place(ctx, call_term.destination);
        self.write_int(call_term.target.to_index());
        self.write_optional_mir_place(ctx, call_term.initialized_place);
        self.write_mir_places(ctx, call_term.unique_places);
        self.write_optional_block_id(call_term.cleanup);
    }

    () write_mir_places(self, context.CompilerContext& ctx, mir.MirPlace[]& places) {
        self.write_int(places.length);
        Int! index = 0;
        while (index < places.length) {
            self.write_mir_place(ctx, places[index]);
            index = index + 1;
        }
    }

    () write_mir_call_callee(self, context.CompilerContext& ctx, mir.MirCallCallee callee) {
        if (callee is .direct_function(function_value)) {
            self.write_int(1);
            self.write_mir_function_ref(ctx, function_value);
            return;
        }
        if (callee is .indirect_operand(operand)) {
            self.write_int(2);
            self.write_mir_operand(ctx, operand);
            return;
        }
        if (callee is .domain_enqueue(enqueue)) {
            self.write_int(3);
            self.write_def_ref(ctx, enqueue.domain_def);
            self.write_int(enqueue.domain_kind);
            self.write_mir_operand(ctx, enqueue.resume);
            return;
        }
        self.write_int(0);
    }

    () write_assert_terminator(self, context.CompilerContext& ctx, mir.MirAssertTerminator assert_term) {
        self.write_int(6);
        self.write_mir_operand(ctx, assert_term.condition);
        self.write_bool(assert_term.expected);
        if (assert_term.message is .some(message)) {
            self.write_bool(true);
            self.write_symbol(ctx, message);
        } else {
            self.write_bool(false);
        }
        self.write_int(assert_term.target.to_index());
        self.write_optional_block_id(assert_term.cleanup);
    }

    () write_leaf_terminator(self, context.CompilerContext& ctx, mir.MirTerminatorKind kind) {
        if (kind is .return_term(return_term)) {
            self.write_int(7);
            self.write_bool(return_term.implicit_unit);
            return;
        }
        if (kind is .throw_term(throw_term)) {
            self.write_int(8);
            self.write_mir_operand(ctx, throw_term.error_value);
            return;
        }
        if (kind is .unreachable_term(unreachable_term)) {
            self.write_int(9);
            self.write_bool(unreachable_term.generated_by_check);
            return;
        }
        self.write_int(0);
    }

    () write_optional_mir_place(self, context.CompilerContext& ctx, mir.MirPlace? place) {
        if (place is .some(value)) {
            self.write_bool(true);
            self.write_mir_place(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_mir_place(self, context.CompilerContext& ctx, mir.MirPlace place) {
        if (place.base is .global(global_ref)) {
            self.write_int(1);
            self.write_int(global_ref.global_def.to_index());
            self.write_int(global_ref.type_id.to_index());
        } else {
            self.write_int(0);
            self.write_int(place.local_id.to_index());
        }
        self.write_int(place.projection.length);
        Int! index = 0;
        while (index < place.projection.length) {
            self.write_mir_place_elem(ctx, place.projection[index]);
            index = index + 1;
        }
    }

    () write_mir_place_elem(self, context.CompilerContext& ctx, mir.MirPlaceElem elem) {
        if (elem is .deref_projection(deref)) {
            self.write_int(1);
            self.write_bool(deref.raw_pointer);
            return;
        }
        if (elem is .field_projection(field)) {
            self.write_int(2);
            self.write_def_ref(ctx, field.field_def);
            self.write_type_id(ctx, field.field_type);
            return;
        }
        if (elem is .frame_field_projection(field)) {
            self.write_int(6);
            self.write_int(field.field_index);
            self.write_type_id(ctx, field.field_type);
            return;
        }
        if (elem is .index_projection(index_projection)) {
            self.write_int(3);
            self.write_int(index_projection.index_local.to_index());
            return;
        }
        self.write_index_place_elem(elem);
    }

    () write_index_place_elem(self, mir.MirPlaceElem elem) {
        if (elem is .constant_index_projection(index_projection)) {
            self.write_int(4);
            self.write_int(index_projection.offset);
            return;
        }
        if (elem is .subslice_projection(subslice)) {
            self.write_int(5);
            self.write_int(subslice.from);
            self.write_int(subslice.to);
            return;
        }
        self.write_int(0);
    }

    () write_mir_operand(self, context.CompilerContext& ctx, mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.write_int(1);
            self.write_mir_place(ctx, copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.write_int(2);
            self.write_mir_place(ctx, move_operand.place);
            return;
        }
        if (operand is .out_operand(out_operand)) {
            self.write_int(5);
            self.write_mir_place(ctx, out_operand.place);
            return;
        }
        if (operand is .function_operand(function_value)) {
            self.write_int(3);
            self.write_mir_function_ref(ctx, function_value);
            return;
        }
        if (operand is .global_operand(global_value)) {
            self.write_int(4);
            self.write_def_ref(ctx, global_value.global_def);
            self.write_type_id(ctx, global_value.type_id);
            return;
        }
        if (operand is .global_address_operand(global_value)) {
            self.write_int(6);
            self.write_def_ref(ctx, global_value.global_def);
            self.write_type_id(ctx, global_value.type_id);
            return;
        }
        if (operand is .const_operand(value)) {
            self.write_int(7);
            self.write_mir_const(ctx, value);
        }
    }

    () write_mir_function_ref(self, context.CompilerContext& ctx, mir.MirFunctionRef value) {
        self.write_def_ref(ctx, value.function_def);
        self.write_type_id_array(ctx, value.type_args);
        self.write_bool(value.coroutine_resume);
        self.write_bool(value.coroutine_completion);
        self.write_type_id(ctx, value.type_id);
    }

    () write_mir_const(self, context.CompilerContext& ctx, mir.MirConst value) {
        self.write_type_id(ctx, value.type_id);
        if (value.value is .bool_value(bool_value)) {
            self.write_int(1);
            self.write_bool(bool_value.value);
            return;
        }
        if (value.value is .int_value(int_value)) {
            self.write_int(2);
            self.write_uint64(int_value.bits);
            self.write_bool(int_value.signed_value);
            return;
        }
        if (value.value is .float_value(_)) {
            self.write_int(3);
            self.write_uint64(0);
            return;
        }
        self.write_non_numeric_mir_const(ctx, value.value);
    }

    () write_non_numeric_mir_const(self, context.CompilerContext& ctx, mir.MirConstValue value) {
        if (value is .string_value(string_value)) {
            self.write_int(4);
            self.write_symbol(ctx, string_value.symbol_id);
            return;
        }
        if (value is .null_value(null_value)) {
            self.write_int(5);
            self.write_bool(null_value.typed_null);
            return;
        }
        if (value is .unit_value(unit_value)) {
            self.write_int(6);
            self.write_bool(unit_value.unit_value);
            return;
        }
        self.write_int(0);
    }

    () write_mir_rvalue(self, context.CompilerContext& ctx, mir.MirRvalue value) {
        if (value is .use_value(use_value)) {
            self.write_int(1);
            self.write_mir_operand(ctx, use_value.value);
            return;
        }
        if (value is .unary_value(unary_value)) {
            self.write_int(2);
            self.write_int(Int(unary_value.op));
            self.write_mir_operand(ctx, unary_value.value);
            return;
        }
        if (value is .binary_value(binary_value)) {
            self.write_binary_rvalue(ctx, binary_value);
            return;
        }
        self.write_non_arithmetic_rvalue(ctx, value);
    }

    () write_binary_rvalue(self, context.CompilerContext& ctx, mir.MirBinaryRvalue value) {
        self.write_int(3);
        self.write_int(Int(value.op));
        self.write_mir_operand(ctx, value.lhs);
        self.write_mir_operand(ctx, value.rhs);
    }

    () write_non_arithmetic_rvalue(self, context.CompilerContext& ctx, mir.MirRvalue value) {
        if (value is .cast_value(cast_value)) {
            self.write_int(4);
            self.write_int(Int(cast_value.kind));
            self.write_mir_operand(ctx, cast_value.value);
            self.write_type_id(ctx, cast_value.target_type);
            return;
        }
        if (value is .inline_asm_value(inline_asm)) {
            self.write_inline_asm_rvalue(ctx, inline_asm);
            return;
        }
        if (value is .borrow_value(borrow_value)) {
            self.write_int(5);
            self.write_mir_place(ctx, borrow_value.place);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.write_int(6);
            self.write_bool(address_of_value.mutable_pointer);
            self.write_mir_place(ctx, address_of_value.place);
            return;
        }
        if (value is .coroutine_address_value(coroutine_address)) {
            self.write_int(20);
            self.write_mir_place(ctx, coroutine_address.place);
            self.write_bool(coroutine_address.frame_root);
            return;
        }
        if (value is .atomic_load_value(atomic_load)) {
            self.write_int(21);
            self.write_mir_place(ctx, atomic_load.place);
            return;
        }
        if (value is .atomic_compare_exchange_value(compare_exchange)) {
            self.write_int(22);
            self.write_mir_place(ctx, compare_exchange.place);
            self.write_mir_operand(ctx, compare_exchange.expected);
            self.write_mir_operand(ctx, compare_exchange.desired);
            return;
        }
        if (value is .alloc_box_value(alloc_box_value)) {
            self.write_int(15);
            self.write_type_id(ctx, alloc_box_value.value_type);
            return;
        }
        if (value is .alloc_array_value(alloc_array_value)) {
            self.write_int(16);
            self.write_type_id(ctx, alloc_array_value.element_type);
            self.write_mir_operand(ctx, alloc_array_value.count);
            return;
        }
        if (value is .free_value(free_value)) {
            self.write_int(17);
            self.write_mir_operand(ctx, free_value.pointer);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.write_slice_rvalue(ctx, slice_value);
            return;
        }
        self.write_projection_rvalue(ctx, value);
    }

    () write_inline_asm_rvalue(self, context.CompilerContext& ctx, mir.MirInlineAsmRvalue value) {
        self.write_int(19);
        self.write_type_id(ctx, value.result_type);
        self.write_symbol(ctx, value.code_symbol);
        self.write_int(value.operands.length);
        Int! index = 0;
        while (index < value.operands.length) {
            self.write_inline_asm_mir_operand(ctx, value.operands[index]);
            index = index + 1;
        }
        self.write_int(value.clobbers.length);
        index = 0;
        while (index < value.clobbers.length) {
            self.write_symbol(ctx, value.clobbers[index]);
            index = index + 1;
        }
        self.write_bool(value.volatile);
        self.write_bool(value.memory);
        self.write_bool(value.noreturn);
    }

    () write_inline_asm_mir_operand(self, context.CompilerContext& ctx, mir.MirInlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.write_int(1);
            self.write_symbol(ctx, input.constraint_symbol);
            self.write_mir_operand(ctx, input.value);
            return;
        }
        if (operand is .output(output)) {
            self.write_int(2);
            self.write_symbol(ctx, output.constraint_symbol);
            self.write_type_id(ctx, output.type_id);
            return;
        }
        self.write_int(0);
    }

    () write_slice_rvalue(self, context.CompilerContext& ctx, mir.MirSliceRvalue value) {
        self.write_int(18);
        self.write_mir_place(ctx, value.base);
        self.write_optional_mir_operand(ctx, value.start);
        self.write_optional_mir_operand(ctx, value.end);
    }

    () write_optional_mir_operand(self, context.CompilerContext& ctx, mir.MirOperand? operand) {
        if (operand is .some(value)) {
            self.write_bool(true);
            self.write_mir_operand(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_projection_rvalue(self, context.CompilerContext& ctx, mir.MirRvalue value) {
        if (value is .len_value(len_value)) {
            self.write_int(7);
            self.write_mir_place(ctx, len_value.place);
            return;
        }
        if (value is .discriminant_value(discriminant_value)) {
            self.write_int(8);
            self.write_mir_place(ctx, discriminant_value.place);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.write_aggregate_rvalue(ctx, aggregate_value);
            return;
        }
        self.write_special_rvalue(ctx, value);
    }

    () write_aggregate_rvalue(self, context.CompilerContext& ctx, mir.MirAggregateRvalue value) {
        self.write_int(9);
        self.write_int(Int(value.kind));
        self.write_optional_selected_def(ctx, value.def_id);
        self.write_type_id(ctx, value.type_id);
        self.write_int(value.fields.length);
        Int! index = 0;
        while (index < value.fields.length) {
            self.write_mir_operand(ctx, value.fields[index]);
            index = index + 1;
        }
    }

    () write_special_rvalue(self, context.CompilerContext& ctx, mir.MirRvalue value) {
        if (value is .optional_value(optional_value)) {
            self.write_int(10);
            self.write_int(Int(optional_value.op));
            self.write_mir_operand(ctx, optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.write_int(11);
            self.write_int(Int(error_union_value.op));
            self.write_mir_operand(ctx, error_union_value.value);
            return;
        }
        self.write_int(0);
    }

    () write_optional_block_id(self, mir.MirBlockId? block_id) {
        if (block_id is .some(id)) {
            self.write_bool(true);
            self.write_int(id.to_index());
            return;
        }
        self.write_bool(false);
    }

    () write_def_ref(self, context.CompilerContext& ctx, qid.DefId def_id) {
        if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
            self.write_bool(true);
            self.write_uint64(stable_id.low);
            self.write_uint64(stable_id.high);
            return;
        }

        // builtin 和尚未接入 stable key 的内部 def 暂时用 DefRecord 结构兜底；
        // 后续磁盘 cache 前必须给这些跨 session 可见 def 补稳定 key。
        self.write_bool(false);
        self.write_def_record(ctx, ctx.store.defs.get(def_id));
    }

    () write_node_type_check_result(self, context.CompilerContext& ctx, hir.HirId node_id) {
        self.write_hir_id(ctx, node_id);
        if (ctx.store.typeck.node_type(node_id) is .some(type_id)) {
            self.write_bool(true);
            self.write_type_id(ctx, type_id);
        } else {
            self.write_bool(false);
        }
        self.write_optional_selected_def(ctx, ctx.store.typeck.member_selection(node_id));
        self.write_optional_selected_def(ctx, ctx.store.typeck.pattern_selection(node_id));
        self.write_generic_instance(ctx, ctx.store.typeck.generic_instance(node_id));
    }

    () write_optional_selected_def(self, context.CompilerContext& ctx, qid.DefId? selected_def) {
        if (selected_def is .some(def_id)) {
            self.write_bool(true);
            self.write_def_ref(ctx, def_id);
            return;
        }
        self.write_bool(false);
    }

    () write_generic_instance(self, context.CompilerContext& ctx, typeck_store.GenericInstance? instance) {
        if (instance is .some(value)) {
            self.write_bool(true);
            self.write_def_ref(ctx, value.def_id);
            self.write_type_id_array(ctx, value.type_args);
            // Const generic arguments affect the selected instantiation just
            // like type arguments, so they must participate in semantic
            // fingerprints as soon as the side table can carry them.
            self.write_comptime_value_array(ctx, value.const_args);
            return;
        }
        self.write_bool(false);
    }

    () write_comptime_value_array(self, context.CompilerContext& ctx, comptime_value.ComptimeValue[]& items) {
        self.write_int(items.length);
        Int! index = 0;
        while (index < items.length) {
            self.write_comptime_value(ctx, items[index]);
            index = index + 1;
        }
    }

    () write_comptime_value(self, context.CompilerContext& ctx, comptime_value.ComptimeValue value) {
        self.write_type_id(ctx, value.type_id);
        if (value.data is .invalid) { self.write_int(1); return; }
        if (value.data is .unit_value) { self.write_int(2); return; }
        if (value.data is .bool_value(bool_value)) {
            self.write_int(3);
            self.write_bool(bool_value);
            return;
        }
        if (value.data is .int_value(int_value)) {
            self.write_int(4);
            self.write_int(int_value);
            return;
        }
        if (value.data is .uint_value(uint_value)) {
            self.write_int(5);
            self.write_uint64(uint_value);
            return;
        }
        if (value.data is .char_value(char_value)) {
            self.write_int(6);
            self.write_uint64(char_value);
            return;
        }
        if (value.data is .float_bits(float_bits)) {
            self.write_int(7);
            self.write_uint64(float_bits);
            return;
        }
        self.write_aggregate_comptime_value(ctx, value.data);
    }

    () write_aggregate_comptime_value(self, context.CompilerContext& ctx, comptime_value.ComptimeValueData data) {
        if (data is .string_value(string_value)) {
            self.write_int(8);
            self.write_int(string_value.length);
            self.write_bytes(string_value);
            return;
        }
        if (data is .symbol_value(symbol_value)) {
            self.write_int(9);
            self.write_symbol(ctx, symbol_value);
            return;
        }
        if (data is .const_param_value(const_param)) {
            self.write_int(10);
            self.write_def_ref(ctx, const_param);
            return;
        }
        if (data is .enum_case_value(case_def)) {
            self.write_int(11);
            self.write_def_ref(ctx, case_def);
            return;
        }
        if (data is .struct_value(fields)) {
            self.write_int(12);
            self.write_int(fields.length);
            Int! index = 0;
            while (index < fields.length) {
                self.write_def_ref(ctx, fields[index].field_def);
                self.write_comptime_value(ctx, fields[index].value);
                index = index + 1;
            }
            return;
        }
        if (data is .tuple_value(items)) {
            self.write_int(13);
            self.write_comptime_value_array(ctx, items);
            return;
        }
        if (data is .array_value(items)) {
            self.write_int(14);
            self.write_comptime_value_array(ctx, items);
            return;
        }
        self.write_int(0);
    }

    () write_hir_id(self, context.CompilerContext& ctx, hir.HirId id) {
        self.write_def_ref(ctx, id.owner_def);
        self.write_int(id.local_index);
    }

    () write_hir_decl(self, context.CompilerContext& ctx, hir.HirDecl decl) {
        self.write_int(Int(decl.kind));
        self.write_bool(decl.is_const);
        self.write_bool(decl.naked);
        self.write_optional_symbol_id(ctx, decl.link_symbol);
        self.write_optional_type_ref_node(ctx, decl.type_ref);
        self.write_optional_hir_id(ctx, decl.enum_case_value);
        if (decl.function_signature is .some(signature)) {
            self.write_bool(true);
            self.write_int(signature.params.length);
            Int! index = 0;
            while (index < signature.params.length) {
                self.write_symbol(ctx, signature.param_symbols[index]);
                self.write_type_ref_node(ctx, signature.params[index]);
                index = index + 1;
            }
            self.write_int(signature.unique_symbols.length);
            index = 0;
            while (index < signature.unique_symbols.length) {
                self.write_symbol(ctx, signature.unique_symbols[index]);
                index = index + 1;
            }
            self.write_type_ref_node(ctx, signature.result);
        } else {
            self.write_bool(false);
        }
    }

    () write_optional_type_ref_node(self, context.CompilerContext& ctx, hir.HirId? node_id) {
        if (node_id is .some(value)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_optional_type_id(self, context.CompilerContext& ctx, qid.TypeId? type_id) {
        if (type_id is .some(value)) {
            self.write_bool(true);
            self.write_type_id(ctx, value);
            return;
        }
        self.write_bool(false);
    }

    () write_where_predicates(self, context.CompilerContext& ctx, list.ArrayList<hir.HirWherePredicate>& predicates) {
        self.write_int(predicates.len());
        Int! index = 0;
        while (index < predicates.len()) {
            self.write_where_predicate(ctx, predicates.get(index));
            index = index + 1;
        }
    }

    () write_where_predicate(self, context.CompilerContext& ctx, hir.HirWherePredicate predicate) {
        if (predicate is .type_bound(bound)) {
            self.write_int(1);
            self.write_type_ref_node(ctx, bound.subject);
            self.write_type_ref_node(ctx, bound.bound);
            return;
        }
        if (predicate is .negative_type_bound(bound)) {
            self.write_int(4);
            self.write_type_ref_node(ctx, bound.subject);
            self.write_type_ref_node(ctx, bound.bound);
            return;
        }
        if (predicate is .equal(equal)) {
            self.write_int(2);
            self.write_type_ref_node(ctx, equal.subject);
            self.write_type_ref_node(ctx, equal.value);
            return;
        }
        if (predicate is .not_equal(equal)) {
            self.write_int(5);
            self.write_type_ref_node(ctx, equal.subject);
            self.write_type_ref_node(ctx, equal.value);
            return;
        }
        if (predicate is .projection_equal(projection)) {
            self.write_int(3);
            self.write_type_ref_node(ctx, projection.subject);
            self.write_type_ref_node(ctx, projection.trait_ref);
            self.write_symbol(ctx, projection.assoc_symbol);
            self.write_type_ref_node(ctx, projection.value);
        }
    }

    () write_lifetime_constraints(self,
        context.CompilerContext& ctx,
        list.ArrayList<hir.HirLifetimeConstraint>& constraints
    ) {
        self.write_int(constraints.len());
        Int! index = 0;
        while (index < constraints.len()) {
            hir.HirLifetimeConstraint constraint = constraints.get(index);
            self.write_lifetime_name(ctx, constraint.longer);
            self.write_lifetime_name(ctx, constraint.shorter);
            index = index + 1;
        }
    }

    () write_lifetime_name(self, context.CompilerContext& ctx, hir.HirLifetimeName name) {
        self.write_int(Int(name.kind));
        if (name.symbol is .some(symbol)) {
            self.write_bool(true);
            self.write_symbol(ctx, symbol);
            return;
        }
        self.write_bool(false);
    }

    () write_local(self, context.CompilerContext& ctx, hir.HirLocal local) {
        self.write_int(Int(local.kind));
        self.write_symbol(ctx, local.symbol);
        self.write_def_ref(ctx, local.def_id);
        self.write_bool(local.mutable_binding);
        self.write_bool(local.borrow_binding);
        if (local.type_ref is .some(type_ref)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, type_ref);
            return;
        }
        self.write_bool(false);
    }

    () write_node(self, context.CompilerContext& ctx, hir.HirNode node) {
        self.write_int(node.id.local_index);
        self.write_node_data(ctx, node.data);
    }

    () write_node_data(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (self.write_expr_node(ctx, data)) { return; }
        if (self.write_stmt_node(ctx, data)) { return; }
        if (self.write_pattern_node(ctx, data)) { return; }
        if (self.write_type_ref_node_data(ctx, data)) { return; }
        self.write_leaf_node(data);
    }

    Bool write_expr_node(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .block(block)) {
            self.write_int(11);
            self.write_hir_effect_set(ctx, block.effects);
            self.write_hir_id_array(ctx, block.statements);
            self.write_optional_hir_id(ctx, block.result);
            return true;
        }
        if (data is .name_ref(name_ref)) {
            self.write_int(12);
            self.write_name_ref(ctx, name_ref);
            return true;
        }
        if (data is .member_access(access)) {
            self.write_int(13);
            self.write_hir_id(ctx, access.base);
            self.write_symbol(ctx, access.member_symbol);
            return true;
        }
        if (data is .index_access(access)) {
            self.write_int(14);
            self.write_hir_id(ctx, access.base);
            self.write_hir_id(ctx, access.index);
            return true;
        }
        if (data is .slice_access(access)) {
            self.write_int(44);
            self.write_hir_id(ctx, access.base);
            self.write_optional_hir_id(ctx, access.start);
            self.write_optional_hir_id(ctx, access.end);
            return true;
        }
        if (data is .struct_literal(literal)) {
            self.write_int(46);
            self.write_hir_id(ctx, literal.type_ref);
            self.write_int(literal.fields.length);
            Int! index = 0;
            while (index < literal.fields.length) {
                self.write_symbol(ctx, literal.fields[index].field_symbol);
                self.write_hir_id(ctx, literal.fields[index].value);
                index = index + 1;
            }
            return true;
        }
        if (data is .tuple_literal(literal)) {
            self.write_int(47);
            self.write_int(literal.items.length);
            Int! index = 0;
            while (index < literal.items.length) {
                self.write_hir_id(ctx, literal.items[index]);
                index = index + 1;
            }
            return true;
        }
        if (data is .array_literal(literal)) {
            self.write_int(48);
            self.write_int(literal.items.length);
            Int! index = 0;
            while (index < literal.items.length) {
                self.write_hir_id(ctx, literal.items[index]);
                index = index + 1;
            }
            return true;
        }
        if (data is .range_expr(range_expr)) {
            self.write_int(49);
            self.write_hir_id(ctx, range_expr.start);
            self.write_hir_id(ctx, range_expr.end);
            return true;
        }
        if (data is .inline_asm(inline_asm)) {
            self.write_inline_asm(ctx, inline_asm);
            return true;
        }
        if (data is .catch_expr(catch_expr)) {
            self.write_int(45);
            self.write_hir_id(ctx, catch_expr.value);
            self.write_optional_hir_id(ctx, catch_expr.pattern);
            self.write_hir_id(ctx, catch_expr.body);
            return true;
        }
        if (data is .call(call)) {
            self.write_call(ctx, call);
            return true;
        }
        if (data is .implicit_call(call)) {
            self.write_implicit_call(ctx, call);
            return true;
        }
        if (hir.literal_node_data(data) is .some(literal)) {
            self.write_int(16);
            self.write_literal(ctx, literal);
            return true;
        }
        return false;
    }

    Bool write_stmt_node(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .let_stmt(let_stmt)) {
            self.write_int(17);
            self.write_int(let_stmt.local_id.to_index());
            self.write_optional_hir_id(ctx, let_stmt.initializer);
            return true;
        }
        if (data is .destructure_stmt(destructure)) {
            self.write_int(48);
            self.write_hir_id_array(ctx, destructure.bindings);
            self.write_hir_id(ctx, destructure.initializer);
            return true;
        }
        if (data is .guard_stmt(guard_stmt)) {
            self.write_int(18);
            self.write_hir_id(ctx, guard_stmt.condition);
            self.write_hir_id(ctx, guard_stmt.else_body);
            return true;
        }
        if (data is .assign_stmt(assign_stmt)) {
            self.write_int(19);
            self.write_int(Int(assign_stmt.op));
            self.write_hir_id(ctx, assign_stmt.target);
            self.write_hir_id(ctx, assign_stmt.value);
            return true;
        }
        if (data is .return_stmt(return_stmt)) {
            self.write_int(20);
            self.write_optional_hir_id(ctx, return_stmt.value);
            return true;
        }
        if (data is .throw_stmt(throw_stmt)) {
            self.write_int(48);
            self.write_hir_id(ctx, throw_stmt.value);
            return true;
        }
        if (data is .unary(unary)) {
            self.write_int(23);
            self.write_int(Int(unary.op));
            self.write_hir_id(ctx, unary.value);
            return true;
        }
        return self.write_control_expr(ctx, data);
    }

    Bool write_control_expr(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .binary(binary)) {
            self.write_int(24);
            self.write_int(Int(binary.op));
            self.write_hir_id(ctx, binary.left);
            self.write_hir_id(ctx, binary.right);
            return true;
        }
        if (data is .if_expr(if_expr)) {
            self.write_int(25);
            self.write_hir_id(ctx, if_expr.condition);
            self.write_hir_id(ctx, if_expr.then_body);
            self.write_optional_hir_id(ctx, if_expr.else_body);
            return true;
        }
        if (data is .loop_expr(loop_expr)) {
            self.write_loop(ctx, loop_expr);
            return true;
        }
        if (data is .switch_expr(switch_expr)) {
            self.write_switch(ctx, switch_expr);
            return true;
        }
        if (data is .is_pattern(is_pattern)) {
            self.write_int(28);
            self.write_hir_id(ctx, is_pattern.value);
            self.write_hir_id(ctx, is_pattern.pattern);
            return true;
        }
        if (data is .defer_stmt(defer_stmt)) {
            self.write_int(34);
            self.write_hir_id(ctx, defer_stmt.body);
            return true;
        }
        return false;
    }

    Bool write_pattern_node(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .binding_pattern(pattern)) {
            self.write_int(29);
            self.write_int(pattern.local_id.to_index());
            return true;
        }
        if (data is .literal_pattern(pattern)) {
            self.write_int(30);
            self.write_literal(ctx, pattern.literal);
            return true;
        }
        if (data is .optional_pattern(pattern)) {
            self.write_int(31);
            self.write_optional_hir_id(ctx, pattern.nested);
            return true;
        }
        if (data is .variant_pattern(pattern)) {
            self.write_variant_pattern(ctx, pattern);
            return true;
        }
        if (data is .wildcard_pattern) {
            self.write_int(33);
            return true;
        }
        return false;
    }

    () write_inline_asm(self, context.CompilerContext& ctx, hir.HirInlineAsm inline_asm) {
        self.write_int(50);
        self.write_hir_id(ctx, inline_asm.result_type);
        self.write_symbol(ctx, inline_asm.code_symbol);
        self.write_int(inline_asm.operands.length);
        Int! index = 0;
        while (index < inline_asm.operands.length) {
            self.write_inline_asm_operand(ctx, inline_asm.operands[index]);
            index = index + 1;
        }
        self.write_int(inline_asm.clobbers.length);
        index = 0;
        while (index < inline_asm.clobbers.length) {
            self.write_symbol(ctx, inline_asm.clobbers[index]);
            index = index + 1;
        }
        self.write_bool(inline_asm.volatile);
        self.write_bool(inline_asm.memory);
        self.write_bool(inline_asm.noreturn);
    }

    () write_inline_asm_operand(self, context.CompilerContext& ctx, hir.HirInlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.write_int(1);
            self.write_symbol(ctx, input.name);
            self.write_symbol(ctx, input.constraint_symbol);
            self.write_hir_id(ctx, input.value);
            return;
        }
        if (operand is .output(output)) {
            self.write_int(2);
            self.write_symbol(ctx, output.name);
            self.write_symbol(ctx, output.constraint_symbol);
            self.write_optional_hir_id(ctx, output.type_ref);
            return;
        }
        self.write_int(0);
    }

    Bool write_type_ref_node_data(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .named_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .layered_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .array_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .errorable_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .function_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .tuple_type_ref(_)) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .infer_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .unit_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        if (data is .invalid_type_ref) { self.write_type_ref_data(ctx, data); return true; }
        return false;
    }

    () write_leaf_node(self, hir.HirNodeData data) {
        if (data is .break_stmt) { self.write_int(21); return; }
        if (data is .continue_stmt) { self.write_int(22); return; }
        self.write_int(0);
    }

    () write_name_ref(self, context.CompilerContext& ctx, hir.HirNameRef name_ref) {
        if (name_ref is .local(local_id)) {
            self.write_int(1);
            self.write_int(local_id.to_index());
            return;
        }
        if (name_ref is .def_ref(def_id)) {
            self.write_int(2);
            self.write_def_ref(ctx, def_id);
        }
    }

    () write_call(self, context.CompilerContext& ctx, hir.HirCall call) {
        self.write_int(14);
        self.write_hir_id(ctx, call.callee);
        self.write_hir_id_array(ctx, call.type_args);
        self.write_call_arg_array(ctx, call.args);
        if (call.target is .some(target)) {
            self.write_bool(true);
            self.write_def_ref(ctx, target.def_id);
            self.write_optional_signature_id(target.signature_id);
            return;
        }
        self.write_bool(false);
    }

    () write_call_arg_array(self, context.CompilerContext& ctx, hir.HirCallArg[]& args) {
        self.write_int(args.length);
        Int! index = 0;
        while (index < args.length) {
            hir.HirCallArg arg = args[index];
            self.write_optional_symbol_id(ctx, arg.label);
            self.write_hir_id(ctx, arg.value);
            index = index + 1;
        }
    }

    () write_implicit_call(self, context.CompilerContext& ctx, hir.HirImplicitCall call) {
        self.write_int(15);
        self.write_hir_id(ctx, call.base);
        self.write_int(Int(call.op));
        self.write_hir_id_array(ctx, call.args);
        self.write_bool(call.optional_chain);
    }

    () write_loop(self, context.CompilerContext& ctx, hir.HirLoop loop_expr) {
        self.write_int(26);
        self.write_optional_hir_id(ctx, loop_expr.condition);
        self.write_optional_hir_id(ctx, loop_expr.pattern);
        self.write_optional_hir_id(ctx, loop_expr.iterable);
        self.write_hir_id(ctx, loop_expr.body);
    }

    () write_switch(self, context.CompilerContext& ctx, hir.HirSwitch switch_expr) {
        self.write_int(27);
        self.write_hir_id(ctx, switch_expr.value);
        self.write_int(switch_expr.cases.length);
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            self.write_switch_case(ctx, switch_expr.cases[index]);
            index = index + 1;
        }
    }

    () write_switch_case(self, context.CompilerContext& ctx, hir.HirSwitchCase switch_case) {
        self.write_hir_id_array(ctx, switch_case.patterns);
        self.write_hir_id(ctx, switch_case.body);
    }

    () write_variant_pattern(self, context.CompilerContext& ctx, hir.HirVariantPattern pattern) {
        self.write_int(32);
        if (pattern.variant_def is .some(variant_def)) {
            self.write_bool(true);
            self.write_def_ref(ctx, variant_def);
        } else {
            self.write_bool(false);
        }
        if (pattern.member_symbol is .some(member_symbol)) {
            self.write_bool(true);
            self.write_symbol(ctx, member_symbol);
        } else {
            self.write_bool(false);
        }
        self.write_hir_id_array(ctx, pattern.payload);
    }

    () write_literal(self, context.CompilerContext& ctx, hir.HirLiteral literal) {
        if (literal.value is .int_value(value)) {
            self.write_int(1);
            self.write_uint64(value.bits);
            self.write_bool(value.signed_value);
            return;
        }
        if (literal.value is .float_value(value)) {
            self.write_int(2);
            // 当前 HIR lowering 尚未保留浮点字面量文本，所有 float literal
            // 都是占位值。这里先写固定槽位，避免把不存在的精度信息伪装成指纹。
            self.write_uint64(0);
            return;
        }
        if (literal.value is .bool_value(value)) {
            self.write_int(3);
            self.write_bool(value);
            return;
        }
        self.write_non_numeric_literal(ctx, literal.value);
    }

    () write_non_numeric_literal(self, context.CompilerContext& ctx, hir.HirLiteralValue value) {
        if (value is .string_value(symbol)) {
            self.write_int(4);
            self.write_symbol(ctx, symbol);
            return;
        }
        if (value is .char_value(char_value)) {
            self.write_int(5);
            self.write_uint64(UInt64(char_value));
            return;
        }
        if (value is .null_value) { self.write_int(6); return; }
        if (value is .unit_value) { self.write_int(7); return; }
        self.write_int(0);
    }

    () write_optional_signature_id(self, qid.SignatureId? signature_id) {
        if (signature_id is .some(id)) {
            self.write_bool(true);
            self.write_int(id.index);
            return;
        }
        self.write_bool(false);
    }

    () write_optional_hir_id(self, context.CompilerContext& ctx, hir.HirId? id) {
        if (id is .some(node_id)) {
            self.write_bool(true);
            self.write_hir_id(ctx, node_id);
            return;
        }
        self.write_bool(false);
    }

    () write_hir_id_array(self, context.CompilerContext& ctx, hir.HirId[]& items) {
        self.write_int(items.length);
        Int! index = 0;
        while (index < items.length) {
            self.write_hir_id(ctx, items[index]);
            index = index + 1;
        }
    }

    () write_type_ref_node(self, context.CompilerContext& ctx, hir.HirId node_id) {
        self.write_type_ref_data(ctx, ctx.store.hirs.node(node_id).data);
    }

    () write_type_ref_data(self, context.CompilerContext& ctx, hir.HirNodeData data) {
        if (data is .named_type_ref(type_ref)) {
            self.write_named_type_ref(ctx, type_ref);
            return;
        }
        if (data is .layered_type_ref(type_ref)) {
            self.write_layered_type_ref(ctx, type_ref);
            return;
        }
        if (data is .array_type_ref(type_ref)) {
            self.write_array_type_ref(ctx, type_ref);
            return;
        }
        if (data is .errorable_type_ref(type_ref)) {
            self.write_errorable_type_ref(ctx, type_ref);
            return;
        }
        if (data is .function_type_ref(type_ref)) {
            self.write_function_type_ref(ctx, type_ref);
            return;
        }
        self.write_leaf_type_ref(data);
    }

    () write_leaf_type_ref(self, hir.HirNodeData data) {
        if (data is .tuple_type_ref(type_ref)) {
            self.write_int(7);
            self.write_int(type_ref.items.length);
            return;
        }
        if (data is .infer_type_ref) { self.write_int(8); return; }
        if (data is .unit_type_ref) { self.write_int(9); return; }
        if (data is .invalid_type_ref) { self.write_int(10); return; }
        self.write_int(0);
    }

    () write_named_type_ref(self, context.CompilerContext& ctx, hir.HirNamedTypeRef type_ref) {
        self.write_int(1);
        self.write_def_ref(ctx, type_ref.def_id);
        self.write_type_ref_array(ctx, type_ref.args);
    }

    () write_layered_type_ref(self, context.CompilerContext& ctx, hir.HirLayeredTypeRef type_ref) {
        self.write_int(2);
        self.write_int(Int(type_ref.kind));
        self.write_int(Int(type_ref.sentinel_kind));
        self.write_uint64(type_ref.sentinel_value);
        self.write_type_ref_node(ctx, type_ref.element);
    }

    () write_array_type_ref(self, context.CompilerContext& ctx, hir.HirArrayTypeRef type_ref) {
        self.write_int(3);
        self.write_type_ref_node(ctx, type_ref.element);
        self.write_int(Int(type_ref.count_kind));
        self.write_uint64(type_ref.count_value);
        self.write_int(Int(type_ref.sentinel_kind));
        self.write_uint64(type_ref.sentinel_value);
    }

    () write_errorable_type_ref(self, context.CompilerContext& ctx, hir.HirErrorableTypeRef type_ref) {
        self.write_int(4);
        self.write_type_ref_node(ctx, type_ref.value_type);
        if (type_ref.error_type is .some(error_type)) {
            self.write_bool(true);
            self.write_type_ref_node(ctx, error_type);
        } else {
            self.write_bool(false);
        }
    }

    () write_function_type_ref(self, context.CompilerContext& ctx, hir.HirFunctionTypeRef type_ref) {
        self.write_int(5);
        self.write_type_ref_array(ctx, type_ref.params);
        self.write_type_ref_node(ctx, type_ref.result);
        self.write_hir_effect_set(ctx, type_ref.effects);
    }

    () write_hir_effect_set(self, context.CompilerContext& ctx, hir.HirEffectSet effects) {
        self.write_bool(effects.has_unsafe);
        self.write_bool(effects.has_async);
        self.write_optional_hir_id(ctx, effects.domain);
        self.write_optional_hir_id(ctx, effects.context);
    }

    () write_type_effect_set(self, context.CompilerContext& ctx, types.EffectSet effects) {
        self.write_bool(effects.has_unsafe);
        self.write_bool(effects.has_async);
        self.write_optional_def_id(ctx, effects.domain_const);
    }

    () write_type_ref_array(self, context.CompilerContext& ctx, hir.HirId[]& items) {
        self.write_int(items.length);
        Int! index = 0;
        while (index < items.length) {
            self.write_type_ref_node(ctx, items[index]);
            index = index + 1;
        }
    }
}
