// 增量编译的 stable symbol 身份表，维护 stable id 与当前 session DefId 的映射。

import list = "../support/list.jiang";
import map = "../support/map.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import interner = "../resolve/interner.jiang";

public struct StableSymbolRecord: Copyable {
    public qkey.StableSymbolId stable_id;
    public qkey.StableSymbolKey key;
    public qid.DefId? current_def!;
    public qkey.Fingerprint128 signature_fingerprint!;
    public qkey.Fingerprint128 body_fingerprint!;
    public Bool fingerprints_loaded!;
    public Int generation!;

    public init(self,
        qkey.StableSymbolId stable_id,
        qkey.StableSymbolKey key,
        qid.DefId current_def,
        Int generation
    ) {
        self.stable_id = stable_id;
        self.key = key;
        self.current_def = current_def;
        self.signature_fingerprint = qkey.Fingerprint128();
        self.body_fingerprint = qkey.Fingerprint128();
        self.fingerprints_loaded = false;
        self.generation = generation;
    }
}

public struct IncrementalSymbolStore: Movable {
    public list.ArrayList<StableSymbolRecord> records!;
    public map.WyHashMap<qkey.StableSymbolId, Int> stable_to_record!;
    public map.WyHashMap<qid.DefId, Int> def_to_record!;
    public Int generation!;

    public init(self) {
        self.records = list.ArrayList<StableSymbolRecord>();
        self.stable_to_record = map.WyHashMap<qkey.StableSymbolId, Int>();
        self.def_to_record = map.WyHashMap<qid.DefId, Int>();
        self.generation = 0;
    }

    public Int len(self) {
        list.ArrayList<StableSymbolRecord>& records = self.records$.ref();
        return records.len();
    }

    public Void begin_generation(Self&! self) {
        self.generation = self.generation + 1;
        // DefId 属于单次编译。stable identity 和 fingerprint 可以跨代保留，
        // 但新一代 resolve 重新建立映射前，任何旧 DefId 都必须不可见。
        self.def_to_record.clear();
        Int index! = 0;
        while (index < self.records.len()) {
            self.records.mut_ref_at(index).current_def = null;
            index = index + 1;
        }
    }

    // record_symbol 是 resolve/Semantic Model lowering 写 stable identity 的入口。同一个
    // stable key 再次出现时复用旧 symbol_record，只更新当前 session 的 DefId。
    public qkey.StableSymbolId record_symbol(Self&! self,
        interner.SymbolStore& symbols,
        qkey.StableSymbolKey key,
        qid.DefId current_def
    ) {
        qkey.StableSymbolId stable_id = qkey.stable_symbol_id_for_key(symbols, key);
        if (self.stable_to_record.get(stable_id) is .some(record_index_ref)) {
            Int record_index = record_index_ref$.get();
            self.refresh_record(record_index, current_def);
            self.records.mut_ref_at(record_index).fingerprints_loaded = false;
            return stable_id;
        }

        Int record_index = self.records.len();
        self.records.add(StableSymbolRecord(stable_id, key, current_def, self.generation));
        self.stable_to_record.set(stable_id, record_index);
        self.def_to_record.set(current_def, record_index);
        return stable_id;
    }

    // interface artifact 已经持有上轮写入的 stable id。加载 `.ji` 时必须
    // 直接恢复 artifact stable id -> 当前 DefId 的映射；重新计算 key 只用于
    // 校验，不应该决定本次 session 是否能找到这个定义。
    public Void record_loaded_symbol(Self&! self,
        qkey.StableSymbolId stable_id,
        qkey.StableSymbolKey key,
        qid.DefId current_def
    ) {
        if (self.stable_to_record.get(stable_id) is .some(record_index_ref)) {
            Int record_index = record_index_ref$.get();
            self.refresh_record(record_index, current_def);
            self.records.mut_ref_at(record_index).fingerprints_loaded = true;
            return;
        }

        Int record_index = self.records.len();
        self.records.add(StableSymbolRecord(stable_id, key, current_def, self.generation));
        self.records.mut_ref_at(record_index).fingerprints_loaded = true;
        self.stable_to_record.set(stable_id, record_index);
        self.def_to_record.set(current_def, record_index);
    }

    public qkey.StableSymbolId? stable_id_for_def(self, qid.DefId def_id) {
        if (self.def_to_record.get(def_id) is .some(record_index)) {
            return self.records.get(record_index$.get()).stable_id;
        }
        return null;
    }

    public qkey.Fingerprint128? disambiguator_for_def(self, qid.DefId def_id) {
        guard self.def_to_record.get(def_id) is .some(record_index) else {
            return null;
        }
        return self.records.get(record_index$.get()).key.disambiguator;
    }

    public Void set_signature_fingerprint(
        Self&! self, qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint
    ) {
        if (self.record_ref_for_stable(stable_id) is .some(symbol_record)) {
            symbol_record.signature_fingerprint = fingerprint;
        }
    }

    public Void set_body_fingerprint(
        Self&! self, qkey.StableSymbolId stable_id, qkey.Fingerprint128 fingerprint
    ) {
        if (self.record_ref_for_stable(stable_id) is .some(symbol_record)) {
            symbol_record.body_fingerprint = fingerprint;
        }
    }

    public Void set_loaded_fingerprints(
        Self&! self,
        qkey.StableSymbolId stable_id,
        qkey.Fingerprint128 signature,
        qkey.Fingerprint128 body
    ) {
        if (self.record_ref_for_stable(stable_id) is .some(symbol_record)) {
            symbol_record.signature_fingerprint = signature;
            symbol_record.body_fingerprint = body;
            symbol_record.fingerprints_loaded = true;
        }
    }

    public Bool fingerprints_loaded(self, qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is .some(record_index)) {
            return self.records.get(record_index$.get()).fingerprints_loaded;
        }
        return false;
    }

    public Bool has_stable(self, qkey.StableSymbolId stable_id) {
        return self.stable_to_record.has(stable_id);
    }

    public Bool has_def(self, qid.DefId def_id) {
        return self.def_to_record.has(def_id);
    }

    public qid.DefId? current_def_for_stable(self, qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is .some(record_index)) {
            StableSymbolRecord record = self.records.get(record_index$.get());
            if (record.generation == self.generation) {
                return record.current_def;
            }
        }
        return null;
    }

    public qkey.Fingerprint128 signature_fingerprint(self, qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is .some(record_index)) {
            return self.records.get(record_index$.get()).signature_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public qkey.Fingerprint128 body_fingerprint(self, qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is .some(record_index)) {
            return self.records.get(record_index$.get()).body_fingerprint;
        }
        return qkey.Fingerprint128();
    }

    public list.ArrayList<qkey.StableSymbolId> stale_symbols(self) {
        list.ArrayList<qkey.StableSymbolId> stale! = list.ArrayList<qkey.StableSymbolId>();
        list.ArrayList<StableSymbolRecord>& records = self.records$.ref();
        Int index! = 0;
        while (index < records.len()) {
            StableSymbolRecord symbol_record = records.get(index);
            if (symbol_record.generation != self.generation) {
                stale.add(symbol_record.stable_id);
            }
            index = index + 1;
        }
        return stale;
    }

    public Int stale_symbol_count(self) {
        Int count! = 0;
        list.ArrayList<StableSymbolRecord>& records = self.records$.ref();
        Int index! = 0;
        while (index < records.len()) {
            StableSymbolRecord symbol_record = records.get(index);
            if (symbol_record.generation != self.generation) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    @life(return: self)
    StableSymbolRecord&!? record_ref_for_stable(Self&! self, qkey.StableSymbolId stable_id) {
        if (self.stable_to_record.get(stable_id) is .some(record_index)) {
            return self.records.mut_ref_at(record_index$.get());
        }
        return null;
    }

    Void refresh_record(Self&! self,
        Int record_index,
        qid.DefId current_def
    ) {
        StableSymbolRecord&! symbol_record = self.records.mut_ref_at(record_index);
        if (symbol_record.current_def is .some(previous_def)) {
            if (previous_def != current_def) {
                self.def_to_record.remove(previous_def);
            }
        }

        symbol_record.current_def = current_def;
        symbol_record.generation = self.generation;
        self.def_to_record.set(current_def, record_index);
    }
}
