// 当前 session module 到跨编译 source identity 的唯一映射。

import cache_identity = "../artifact/cache_identity.jiang";
import qid = "../id.jiang";
import resolve_store = "../resolve/store.jiang";
import store_api = "../store.jiang";

public cache_identity.StableSourceId? for_module(
    store_api.CompilerStore& store,
    qid.ModuleId module_id
) {
    resolve_store.ModuleRecord& module = store.resolve.module_ref(module_id);
    resolve_store.PackageRecord& package_record = store.resolve.package_ref(module.package_id);
    guard store.incremental.stable_id_for_def(package_record.def_id)
        is .some(package_identity) else {
        return null;
    }
    return cache_identity.stable_source_identity(
        package_identity,
        store.symbols.text(package_record.dir_path),
        store.symbols.text(module.path_symbol)
    );
}
