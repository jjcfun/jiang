// 长驻编译服务的外层 session。
//
// CompilerSession 持有可复用 CompilerContext，并负责 target 配置与每轮 compilation
// 的入口边界；persistent incremental state 保留在 context.store 中。

import compiler_context = "./context.jiang";
import diagnostic = "./diagnostic.jiang";
import diagnostic_helper = "./diagnostic/helper.jiang";
import driver_options = "./driver/options.jiang";
import pipeline = "./pipeline.jiang";
import service = "./service.jiang";
import source = "./source.jiang";
import source_entry = "./source/entry.jiang";

public struct CompilerSession: Movable {
    compiler_context.CompilerContext ctx!;

    public init(self) {
        self.ctx = compiler_context.CompilerContext();
    }

    public source.SourceId set_source(Self&! self, UInt8[]& path, UInt8[]& text) {
        return self.ctx.store.sources.set_overlay(path, text);
    }

    public Bool clear_source(Self&! self, UInt8[]& path) {
        return self.ctx.store.sources.clear_overlay(path);
    }

    public Void compile(Self&! self, driver_options.CompileOptions& options) {
        if (!self.configure(options)) { return; }
        pipeline.compile(self.ctx$.mut_ref(), options);
    }

    public source_entry.PackageHandle load_package(Self&! self, UInt8[]& input_path) {
        self.ctx.store.diagnostics.clear();
        return source_entry.load_package(self.ctx$.mut_ref(), input_path);
    }

    public Void compile_loaded(
        Self&! self,
        source_entry.PackageHandle& package,
        driver_options.CompileOptions& options
    ) {
        if (!self.configure(options)) { return; }
        pipeline.compile_loaded_package(self.ctx$.mut_ref(), package, options);
    }

    public Int generation(self) {
        return self.ctx.store.incremental.generation;
    }

    public diagnostic.DiagnosticStore& diagnostics(self) {
        return self.ctx.store.diagnostics$.ref();
    }

    public service.CompilerQueries queries(self) {
        return service.CompilerQueries(self.ctx.store$.ref());
    }

    Bool configure(Self&! self, driver_options.CompileOptions& options) {
        driver_options.BuildContextResult result! =
            driver_options.build_context(options, self.ctx$.mut_ref());
        if (result.ok) { return true; }
        self.ctx$.mut_ref().begin_compilation();
        diagnostic_helper.add_package_error(
            self.ctx.store.diagnostics$.mut_ref(),
            result.message.bytes(),
            result.code
        );
        return false;
    }
}
