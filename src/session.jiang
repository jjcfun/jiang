// 长驻编译服务的外层 session。
//
// CompilerSession 只负责持有可复用 CompilerContext；每轮编译开始时通过
// begin_compilation 清理单次 compilation 状态，persistent incremental state
// 保留在 context.store 中。

import compiler_context = "./context.jiang";

public struct CompilerSession: Movable {
    public compiler_context.CompilerContext! ctx;

    public init() {
        self.ctx = compiler_context.CompilerContext();
    }

    public () begin_compilation(self) {
        self.ctx.begin_compilation();
    }
    public compiler_context.CompilerContext& context_ref(self) {
        return self.ctx$.ref();
    }
}
