// Per-invocation compiler session state and configuration.

import context = "./context.jiang";
import pipeline = "./pipeline.jiang";

public struct CompilerSession {
    public context.CompilerContext^ ctx;

    public init() {
        self.ctx = new context.CompilerContext();
    }

    public () compile_source(UInt8[] text) {
        pipeline.compile_source(self.ctx$.ref(), text);
    }

    public () compile_file(UInt8[] file_path) {
        pipeline.compile_file(self.ctx$.ref(), file_path);
    }

    public () compile_path(UInt8[] input_path) {
        pipeline.compile_path(self.ctx$.ref(), input_path);
    }

    public Bool has_errors() {
        return self.ctx.diagnostics.has_errors();
    }
}
