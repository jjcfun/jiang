// Compiler builtin initialization.
//
// 这里创建 compiler core 必须存在的 Def/HIR/namespace/type 映射。普通声明的
// 类型结果只写入 TypeCheckResults；这里的 type 映射只服务 Bool/Int 这类
// 启动期内建类型名。

import qid = "../query/id.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import def = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import store = "../resolve/store.jiang";
import source_map = "../source/source_map.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";
import sema_type = "../sema/type.jiang";

public () init_builtins(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    sema_type.TypeTable& types
) {
    qid.DefId bool_def = add_type(symbols, defs, resolve, sources, types, "Bool", types.bool_type());
    add_type(symbols, defs, resolve, sources, types, "Int", types.int_type());
    add_type(symbols, defs, resolve, sources, types, "UInt", types.uint_type());
    add_type(symbols, defs, resolve, sources, types, "Int8", types.int8_type());
    add_type(symbols, defs, resolve, sources, types, "Int16", types.int16_type());
    add_type(symbols, defs, resolve, sources, types, "Int32", types.int32_type());
    add_type(symbols, defs, resolve, sources, types, "Int64", types.int64_type());
    add_type(symbols, defs, resolve, sources, types, "UInt8", types.uint8_type());
    add_type(symbols, defs, resolve, sources, types, "UInt16", types.uint16_type());
    add_type(symbols, defs, resolve, sources, types, "UInt32", types.uint32_type());
    qid.DefId uint64_def = add_type(symbols, defs, resolve, sources, types, "UInt64", types.uint64_type());
    add_type(symbols, defs, resolve, sources, types, "Float", types.float_type());
    add_type(symbols, defs, resolve, sources, types, "Float32", types.float_type());
    add_type(symbols, defs, resolve, sources, types, "Float64", types.double_type());
    add_type(symbols, defs, resolve, sources, types, "Double", types.double_type());
    add_type(symbols, defs, resolve, sources, types, "Char", types.char_type());
    add_type(symbols, defs, resolve, sources, types, "CString", types.c_string_type());
    qid.DefId movable_def = add_trait(symbols, defs, resolve, hirs, sources, "Movable");
    qid.DefId equatable_def = add_trait(symbols, defs, resolve, hirs, sources, "Equatable");
    qid.DefId hashable_def = add_trait(symbols, defs, resolve, hirs, sources, "Hashable");
    resolve.set_core_traits(movable_def, equatable_def, hashable_def);
    add_trait_parent(hirs, hashable_def, equatable_def);
    add_trait_method(symbols, defs, resolve, hirs, sources, hashable_def, "hash", uint64_def);
    export_core_prelude_trait(symbols, resolve, "Movable", movable_def);
    export_core_prelude_trait(symbols, resolve, "Hashable", hashable_def);
    export_core_prelude_trait(symbols, resolve, "Equatable", equatable_def);
    add_value_with_param(symbols, defs, resolve, hirs, sources, "assert", bool_def);
    add_value(symbols, defs, resolve, hirs, sources, "print", true);
    add_value(symbols, defs, resolve, hirs, sources, "panic", false);
}

qid.DefId add_type(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    source_map.SourceMap& sources,
    sema_type.TypeTable& types,
    UInt8[] name,
    qid.TypeId type_id
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    sources.set_sourceless_def_span(def_id, token.Span());
    types.bind_builtin_type_def(def_id, type_id);
    return def_id;
}

qid.DefId add_trait(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    UInt8[] name
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        null,
        null,
        span
    );
    qid.DefId def_id = defs.create(
        .trait_def,
        .type_name,
        .public_visibility,
        def.Name {symbol: symbol, span: span},
        null,
        null,
        resolve.builtin_namespace,
        namespace_id
    );
    resolve.bind_builtin_name(symbol, .type_name, def_id, span);
    hirs.declare_def(def_id, .type_decl);
    sources.set_sourceless_def_span(def_id, span);
    return def_id;
}

// core builtin trait 是编译器基础能力；prelude 只导出同一个 DefId。
// 将来 no-std 关闭 prelude 时，builtin_namespace 仍然保留这些核心约束。
() export_core_prelude_trait(
    interner.SymbolTable& symbols,
    store.ResolveStore& resolve,
    UInt8[] name,
    qid.DefId trait_def
) {
    resolve.bind_prelude_name(
        symbols.intern(name),
        .type_name,
        trait_def,
        token.Span()
    );
}

() add_trait_parent(
    hir_store.HirStore& hirs,
    qid.DefId trait_def,
    qid.DefId parent_def
) {
    hirs.add_trait_ref(trait_def, builtin_named_type_ref(hirs, trait_def, parent_def));
}

// builtin trait requirement 必须走和普通 trait method 一样的 Def/HIR/namespace
// 形状。这里是通用注册入口；Hashable/Equatable 只是调用方提供的数据，
// 不能在 type check 里为某个 trait 写专用分支。
qid.DefId add_trait_method(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    qid.DefId trait_def,
    UInt8[] name,
    qid.DefId result_type_def
) {
    guard defs.get(trait_def).owned_namespace_id is some namespace_id else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .function_def,
        .value_name,
        .public_visibility,
        def.Name {symbol: symbol, span: span},
        trait_def,
        null,
        namespace_id,
        null
    );
    resolve.bind_name(namespace_id, symbol, .value_name, def_id, span);
    hirs.declare_def(def_id, .function_decl);
    hirs.add_member(trait_def, def_id);
    hirs.set_function_signature(def_id, builtin_function_signature(hirs, def_id, result_type_def));
    sources.set_sourceless_def_span(def_id, span);
    return def_id;
}

hir.HirFunctionSignature builtin_function_signature(
    hir_store.HirStore& hirs,
    qid.DefId method_def,
    qid.DefId result_type_def
) {
    return hir.HirFunctionSignature {
        has_receiver: false,
        params: empty_hir_ids(hirs),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: builtin_named_type_ref(hirs, method_def, result_type_def)
    };
}

hir.HirParamDefault[] empty_param_defaults(hir_store.HirStore& hirs) {
    hir.HirParamDefault![*] stored = hirs.storage.alloc_array<hir.HirParamDefault>(1);
    return stored[0..0];
}

hir.HirId builtin_named_type_ref(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId type_def
) {
    list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(0);
    return hirs.add_node(owner_def, .named_type_ref(hir.HirNamedTypeRef {
        def_id: type_def,
        args: freeze_hir_ids(hirs, args$.move())
    }));
}

hir.HirId[] empty_hir_ids(hir_store.HirStore& hirs) {
    list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(0);
    return freeze_hir_ids(hirs, values$.move());
}

hir.HirId[] freeze_hir_ids(hir_store.HirStore& hirs, list.ArrayList<hir.HirId> values) {
    Int count = values.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }
    hir.HirId![*] stored = hirs.storage.alloc_array<hir.HirId>(capacity);
    Int! index = 0;
    while (index < count) {
        stored[index] = values.get(index);
        index = index + 1;
    }
    return stored[0..count];
}

qid.SymbolId[] empty_symbol_ids(hir_store.HirStore& hirs) {
    Int capacity = 1;
    qid.SymbolId![*] stored = hirs.storage.alloc_array<qid.SymbolId>(capacity);
    return stored[0..0];
}

() add_value(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    UInt8[] name,
    Bool has_param
) {
    qid.DefId def_id = create_builtin_def(symbols, defs, resolve, name, .builtin_value_def, .value_name);
    hirs.declare_def(def_id, .function_decl);
    hirs.set_function_signature(def_id, builtin_value_signature(hirs, def_id, has_param));
    sources.set_sourceless_def_span(def_id, token.Span());
}

() add_value_with_param(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    UInt8[] name,
    qid.DefId param_type_def
) {
    qid.DefId def_id = create_builtin_def(symbols, defs, resolve, name, .builtin_value_def, .value_name);
    hirs.declare_def(def_id, .function_decl);
    hirs.set_function_signature(def_id, builtin_value_signature_with_param(hirs, def_id, param_type_def));
    sources.set_sourceless_def_span(def_id, token.Span());
}

hir.HirFunctionSignature builtin_value_signature(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    Bool has_param
) {
    if (has_param) {
        return hir.HirFunctionSignature {
            has_receiver: false,
            params: invalid_param_type_refs(hirs, owner_def),
            param_symbols: empty_symbol_ids(hirs),
            param_defaults: empty_param_defaults(hirs),
            result: invalid_type_ref(hirs, owner_def)
        };
    }
    return hir.HirFunctionSignature {
        has_receiver: false,
        params: empty_hir_ids(hirs),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: invalid_type_ref(hirs, owner_def)
    };
}

hir.HirFunctionSignature builtin_value_signature_with_param(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId param_type_def
) {
    list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(1);
    params.add(builtin_named_type_ref(hirs, owner_def, param_type_def));
    return hir.HirFunctionSignature {
        has_receiver: false,
        params: freeze_hir_ids(hirs, params$.move()),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: invalid_type_ref(hirs, owner_def)
    };
}

hir.HirId[] invalid_param_type_refs(hir_store.HirStore& hirs, qid.DefId owner_def) {
    list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(1);
    params.add(invalid_type_ref(hirs, owner_def));
    return freeze_hir_ids(hirs, params$.move());
}

hir.HirId invalid_type_ref(hir_store.HirStore& hirs, qid.DefId owner_def) {
    return hirs.add_node(owner_def, .invalid_type_ref());
}

qid.DefId create_type_def(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    UInt8[] name
) {
    return create_builtin_def(symbols, defs, resolve, name, .builtin_type_def, .type_name);
}

qid.DefId create_builtin_def(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    UInt8[] name,
    def.DefKind kind,
    def.NameDomain domain
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        kind,
        domain,
        .public_visibility,
        def.Name {symbol: symbol, span: span},
        null,
        null,
        resolve.builtin_namespace,
        null
    );
    resolve.bind_builtin_name(symbol, domain, def_id, span);
    return def_id;
}
