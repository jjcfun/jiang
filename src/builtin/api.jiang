// Compiler builtin initialization.
//
// 这里创建 compiler core 必须存在的 Def/HIR/namespace/type 映射。普通声明的
// 类型结果只写入 TypeCheckStore；这里的 type 映射只服务 Bool/Int 这类
// 启动期内建类型名。

import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import incremental_store = "../incremental/symbol_store.jiang";
import def = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import store = "../resolve/store.jiang";
import source_map = "../source/source_map.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";
import sema_type = "../sema/type.jiang";

struct BuiltinStableScope {
    qid.SymbolId! package_name;
    qid.SymbolId! module_path;

    init() {
        self.package_name = qid.SymbolId.from_index(0);
        self.module_path = qid.SymbolId.from_index(0);
    }

    () load(interner.SymbolStore& symbols) {
        self.package_name = symbols.intern("__builtin");
        self.module_path = self.package_name;
    }
}

() record_builtin_stable_symbol(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId def_id,
    qkey.StableSymbolKind kind,
    qid.DefId? owner_def
) {
    def.DefRecord def_record = defs.get(def_id);
    incremental.record_symbol(
        symbols,
        qkey.StableSymbolKey (
            kind: kind,
            package_name: stable.package_name,
            module_path: stable.module_path,
            owner: builtin_owner_stable_id(incremental, owner_def),
            name: def_record.name.symbol,
            domain: def_record.domain
        ),
        def_id
    );
}

qkey.StableSymbolId? builtin_owner_stable_id(
    incremental_store.IncrementalSymbolStore& incremental,
    qid.DefId? owner_def
) {
    guard owner_def is some owner else { return null; }
    return incremental.stable_id_for_def(owner);
}

public () init_builtins(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    sema_type.TypeStore& types,
    incremental_store.IncrementalSymbolStore& incremental
) {
    BuiltinStableScope! stable = BuiltinStableScope();
    stable.load(symbols);
    qid.DefId bool_def =
        add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Bool", types.bool_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Int", types.int_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "UInt", types.uint_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Int8", types.int8_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Int16", types.int16_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Int32", types.int32_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Int64", types.int64_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "UInt8", types.uint8_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "UInt16", types.uint16_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "UInt32", types.uint32_type());
    qid.DefId uint64_def = add_primitive_type(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        types,
        incremental,
        stable,
        "UInt64",
        types.uint64_type()
    );
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Float", types.float_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Float32", types.float_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Float64", types.double_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Double", types.double_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "Char", types.char_type());
    add_primitive_type(symbols, defs, resolve, hirs, sources, types, incremental, stable, "CString", types.c_string_type());
    qid.DefId option_def = add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "Option");
    qid.DefId result_def = add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "Result");
    qid.DefId ref_def = add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "Reference");
    qid.DefId box_def = add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "Box");
    qid.DefId raw_pointer_def =
        add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "RawPointer");
    qid.DefId many_pointer_def =
        add_unbound_type(symbols, defs, resolve, hirs, sources, incremental, stable, "ManyPointer");
    resolve.set_core_types(option_def, result_def, ref_def, box_def, raw_pointer_def, many_pointer_def);
    add_builtin_generic_param(symbols, defs, hirs, sources, option_def, "T");
    add_builtin_generic_param(symbols, defs, hirs, sources, result_def, "T");
    qid.DefId result_error_param = add_builtin_generic_param(symbols, defs, hirs, sources, result_def, "E");
    qid.DefId ref_param = add_builtin_generic_param(symbols, defs, hirs, sources, ref_def, "T");
    qid.DefId box_param = add_builtin_generic_param(symbols, defs, hirs, sources, box_def, "T");
    qid.DefId raw_pointer_param = add_builtin_generic_param(symbols, defs, hirs, sources, raw_pointer_def, "T");
    qid.DefId many_pointer_param = add_builtin_generic_param(symbols, defs, hirs, sources, many_pointer_def, "T");
    add_restricted_handle_type_constraints(
        hirs,
        ref_def,
        ref_param,
        box_def,
        ref_def,
        raw_pointer_def,
        many_pointer_def
    );
    add_restricted_handle_type_constraints(
        hirs,
        box_def,
        box_param,
        box_def,
        ref_def,
        raw_pointer_def,
        many_pointer_def
    );
    add_pointer_type_constraints(hirs, raw_pointer_def, raw_pointer_param, box_def, ref_def);
    add_pointer_type_constraints(hirs, many_pointer_def, many_pointer_param, box_def, ref_def);
    qid.DefId movable_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Movable");
    qid.DefId mutable_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Mutable");
    qid.DefId equatable_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Equatable");
    qid.DefId hashable_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Hashable");
    qid.DefId iterator_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Iterator");
    qid.DefId sequence_def = add_trait(symbols, defs, resolve, hirs, sources, incremental, stable, "Sequence");
    resolve.set_core_traits(movable_def, mutable_def, equatable_def, hashable_def, iterator_def, sequence_def);
    add_result_type_constraints(hirs, result_def, result_error_param, option_def, mutable_def);
    add_trait_parent(hirs, hashable_def, equatable_def);
    qid.DefId iterator_element_def =
        add_associated_type(symbols, defs, resolve, hirs, sources, incremental, stable, iterator_def, "Element");
    add_iterator_next_requirement(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        iterator_def,
        iterator_element_def
    );
    add_associated_type(symbols, defs, resolve, hirs, sources, incremental, stable, sequence_def, "Element");
    qid.DefId sequence_iter_def =
        add_associated_type(symbols, defs, resolve, hirs, sources, incremental, stable, sequence_def, "Iter");
    add_trait_parent_to_associated_type(hirs, sequence_iter_def, iterator_def);
    add_sequence_make_iterator_requirement(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        sequence_def,
        sequence_iter_def
    );
    add_equatable_equal_requirement(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        equatable_def,
        bool_def
    );
    add_trait_method(symbols, defs, resolve, hirs, sources, incremental, stable, hashable_def, "hash", uint64_def);
    export_core_prelude_trait(symbols, resolve, "Movable", movable_def);
    export_core_prelude_trait(symbols, resolve, "Mutable", mutable_def);
    export_core_prelude_trait(symbols, resolve, "Hashable", hashable_def);
    export_core_prelude_trait(symbols, resolve, "Equatable", equatable_def);
    export_core_prelude_trait(symbols, resolve, "Iterator", iterator_def);
    export_core_prelude_trait(symbols, resolve, "Sequence", sequence_def);
    add_value_with_param(symbols, defs, resolve, hirs, sources, "assert", bool_def);
    add_value(symbols, defs, resolve, hirs, sources, "print", true);
    add_value(symbols, defs, resolve, hirs, sources, "panic", false);
}

qid.DefId add_primitive_type(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    sema_type.TypeStore& types,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    UInt8[]& name,
    qid.TypeId type_id
) {
    qid.DefId def_id = add_type(symbols, defs, resolve, sources, types, incremental, stable, name, type_id);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        def_id,
        null,
        token.Span()
    );
    defs.ref_at(def_id).owned_namespace_id = namespace_id;
    hirs.declare_def(def_id, .type_decl);
    return def_id;
}

qid.DefId add_type(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    source_map.SourceMap& sources,
    sema_type.TypeStore& types,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    UInt8[]& name,
    qid.TypeId type_id
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    sources.set_sourceless_def_span(def_id, token.Span());
    types.bind_builtin_type_def(def_id, type_id);
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .type_symbol, null);
    return def_id;
}

qid.DefId add_unbound_type(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    UInt8[]& name
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        def_id,
        null,
        token.Span()
    );
    defs.ref_at(def_id).owned_namespace_id = namespace_id;
    hirs.declare_def(def_id, .type_decl);
    sources.set_sourceless_def_span(def_id, token.Span());
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .type_symbol, null);
    return def_id;
}

qid.DefId add_builtin_generic_param(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    qid.DefId owner_def,
    UInt8[]& name
) {
    guard defs.get(owner_def).owned_namespace_id is some namespace_id else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .generic_param_def,
        .type_name,
        .private_visibility,
        def.Name (symbol: symbol, span: span),
        owner_def,
        null,
        namespace_id,
        null
    );
    hirs.declare_def(def_id, .generic_param_decl);
    hirs.add_generic_param(owner_def, def_id);
    sources.set_sourceless_def_span(def_id, span);
    return def_id;
}

() add_result_type_constraints(
    hir_store.HirStore& hirs,
    qid.DefId result_def,
    qid.DefId error_param,
    qid.DefId option_def,
    qid.DefId mutable_def
) {
    hir.HirId subject = builtin_named_type_ref(hirs, result_def, error_param);
    add_negative_type_bound(hirs, result_def, subject, mutable_def);
    add_type_not_equal_pattern(hirs, result_def, subject, option_def);
}

() add_negative_type_bound(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    hir.HirId subject,
    qid.DefId trait_def
) {
    hirs.add_where_predicate(owner_def, .negative_type_bound(hir.HirWhereTypeBound(
        subject: subject,
        bound: builtin_named_type_ref(hirs, owner_def, trait_def)
    )));
}

() add_restricted_handle_type_constraints(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId param_def,
    qid.DefId box_def,
    qid.DefId ref_def,
    qid.DefId raw_pointer_def,
    qid.DefId many_pointer_def
) {
    hir.HirId subject = builtin_named_type_ref(hirs, owner_def, param_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, box_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, ref_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, raw_pointer_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, many_pointer_def);
}

() add_pointer_type_constraints(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId param_def,
    qid.DefId box_def,
    qid.DefId ref_def
) {
    hir.HirId subject = builtin_named_type_ref(hirs, owner_def, param_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, box_def);
    add_type_not_equal_pattern(hirs, owner_def, subject, ref_def);
}

() add_type_not_equal_pattern(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    hir.HirId subject,
    qid.DefId pattern_def
) {
    hirs.add_where_predicate(owner_def, .type_not_equal(hir.HirWhereTypeEqual(
        subject: subject,
        value: builtin_single_arg_pattern_ref(hirs, owner_def, pattern_def)
    )));
}

qid.DefId add_trait(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    UInt8[]& name
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        null,
        null,
        span
    );
    qid.DefId def_id = defs.create(
        .trait_def,
        .type_name,
        .public_visibility,
        def.Name (symbol: symbol, span: span),
        null,
        null,
        resolve.builtin_namespace,
        namespace_id
    );
    resolve.bind_builtin_name(symbol, .type_name, def_id, span);
    hirs.declare_def(def_id, .type_decl);
    sources.set_sourceless_def_span(def_id, span);
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .trait_symbol, null);
    return def_id;
}

// core builtin trait 是编译器基础能力；prelude 只导出同一个 DefId。
// 将来 no-std 关闭 prelude 时，builtin_namespace 仍然保留这些核心约束。
() export_core_prelude_trait(
    interner.SymbolStore& symbols,
    store.ResolveStore& resolve,
    UInt8[]& name,
    qid.DefId trait_def
) {
    resolve.bind_prelude_name(
        symbols.intern(name),
        .type_name,
        trait_def,
        token.Span()
    );
}

() add_trait_parent(
    hir_store.HirStore& hirs,
    qid.DefId trait_def,
    qid.DefId parent_def
) {
    hirs.add_trait_ref(trait_def, builtin_named_type_ref(hirs, trait_def, parent_def));
}

// builtin trait requirement 必须走和普通 trait method 一样的 Def/HIR/namespace
// 形状。这里是通用注册入口；Hashable/Equatable 只是调用方提供的数据，
// 不能在 type check 里为某个 trait 写专用分支。
qid.DefId add_trait_method(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId trait_def,
    UInt8[]& name,
    qid.DefId result_type_def
) {
    guard defs.get(trait_def).owned_namespace_id is some namespace_id else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .function_def,
        .value_name,
        .public_visibility,
        def.Name (symbol: symbol, span: span),
        trait_def,
        null,
        namespace_id,
        null
    );
    resolve.bind_name(namespace_id, symbol, .value_name, def_id, span);
    hirs.declare_def(def_id, .function_decl);
    hirs.add_member(trait_def, def_id);
    hirs.declare_signature(def_id, builtin_function_signature(hirs, def_id, result_type_def));
    sources.set_sourceless_def_span(def_id, span);
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .function_symbol, trait_def);
    return def_id;
}

qid.DefId add_associated_type(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId trait_def,
    UInt8[]& name
) {
    guard defs.get(trait_def).owned_namespace_id is some namespace_id else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .associated_type_def,
        .type_name,
        .public_visibility,
        def.Name (symbol: symbol, span: span),
        trait_def,
        null,
        namespace_id,
        null
    );
    resolve.bind_name(namespace_id, symbol, .type_name, def_id, span);
    hirs.declare_def(def_id, .associated_type_decl);
    hirs.add_member(trait_def, def_id);
    sources.set_sourceless_def_span(def_id, span);
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .associated_type_symbol, trait_def);
    return def_id;
}

() add_trait_parent_to_associated_type(
    hir_store.HirStore& hirs,
    qid.DefId assoc_def,
    qid.DefId trait_def
) {
    hirs.add_trait_ref(assoc_def, builtin_named_type_ref(hirs, assoc_def, trait_def));
}

qid.DefId add_iterator_next_requirement(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId trait_def,
    qid.DefId element_def
) {
    qid.DefId method_def = add_trait_method(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        trait_def,
        "next",
        element_def
    );
    hirs.declare_signature(method_def, associated_result_signature(
        hirs,
        method_def,
        optional_type_ref(hirs, method_def, builtin_named_type_ref(hirs, method_def, element_def))
    ));
    return method_def;
}

qid.DefId add_sequence_make_iterator_requirement(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId trait_def,
    qid.DefId iter_def
) {
    qid.DefId method_def = add_trait_method(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        trait_def,
        "make_iterator",
        iter_def
    );
    hirs.declare_signature(method_def, associated_result_signature(
        hirs,
        method_def,
        builtin_named_type_ref(hirs, method_def, iter_def)
    ));
    return method_def;
}

qid.DefId add_equatable_equal_requirement(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    incremental_store.IncrementalSymbolStore& incremental,
    BuiltinStableScope stable,
    qid.DefId trait_def,
    qid.DefId bool_def
) {
    qid.DefId method_def = add_trait_method(
        symbols,
        defs,
        resolve,
        hirs,
        sources,
        incremental,
        stable,
        trait_def,
        "equal",
        bool_def
    );
    hirs.declare_signature(method_def, equatable_equal_signature(hirs, trait_def, method_def, bool_def));
    return method_def;
}

hir.HirFunctionSignature builtin_function_signature(
    hir_store.HirStore& hirs,
    qid.DefId method_def,
    qid.DefId result_type_def
) {
    return hir.HirFunctionSignature (
        has_receiver: false,
        params: empty_hir_ids(hirs),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: builtin_named_type_ref(hirs, method_def, result_type_def)
    );
}

hir.HirFunctionSignature equatable_equal_signature(
    hir_store.HirStore& hirs,
    qid.DefId trait_def,
    qid.DefId method_def,
    qid.DefId bool_def
) {
    list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(2);
    params.add(builtin_self_ref(hirs, trait_def, method_def));
    params.add(builtin_self_ref(hirs, trait_def, method_def));
    return hir.HirFunctionSignature (
        has_receiver: false,
        params: freeze_hir_ids(hirs, params$.move()),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: builtin_named_type_ref(hirs, method_def, bool_def)
    );
}

hir.HirFunctionSignature associated_result_signature(
    hir_store.HirStore& hirs,
    qid.DefId method_def,
    hir.HirId result_type_ref
) {
    return hir.HirFunctionSignature (
        has_receiver: false,
        params: empty_hir_ids(hirs),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: result_type_ref
    );
}

hir.HirId builtin_self_ref(hir_store.HirStore& hirs, qid.DefId trait_def, qid.DefId method_def) {
    return hirs.add_node(method_def, .layered_type_ref(hir.HirLayeredTypeRef (
        kind: .reference,
        element: builtin_named_type_ref(hirs, method_def, trait_def)
    )));
}

hir.HirParamDefault[]& empty_param_defaults(hir_store.HirStore& hirs) {
    hir.HirParamDefault![*] stored = hirs.storage.alloc_array<hir.HirParamDefault>(1);
    return stored[0..0];
}

hir.HirId builtin_named_type_ref(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId type_def
) {
    list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(0);
    return hirs.add_node(owner_def, .named_type_ref(hir.HirNamedTypeRef (
        def_id: type_def,
        args: freeze_hir_ids(hirs, args$.move())
    )));
}

hir.HirId builtin_single_arg_pattern_ref(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId type_def
) {
    list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(1);
    args.add(hirs.add_node(owner_def, .infer_type_ref()));
    return hirs.add_node(owner_def, .named_type_ref(hir.HirNamedTypeRef (
        def_id: type_def,
        args: freeze_hir_ids(hirs, args$.move())
    )));
}

hir.HirId optional_type_ref(hir_store.HirStore& hirs, qid.DefId owner_def, hir.HirId element) {
    return hirs.add_node(owner_def, .layered_type_ref(hir.HirLayeredTypeRef (
        kind: .optional_type,
        element: element
    )));
}

hir.HirId many_pointer_type_ref(hir_store.HirStore& hirs, qid.DefId owner_def, hir.HirId element) {
    return hirs.add_node(owner_def, .layered_type_ref(hir.HirLayeredTypeRef (
        kind: .many_pointer,
        element: element
    )));
}

hir.HirId[]& empty_hir_ids(hir_store.HirStore& hirs) {
    list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(0);
    return freeze_hir_ids(hirs, values$.move());
}

hir.HirId[]& freeze_hir_ids(hir_store.HirStore& hirs, list.ArrayList<hir.HirId> values) {
    Int count = values.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }
    hir.HirId![*] stored = hirs.storage.alloc_array<hir.HirId>(capacity);
    Int! index = 0;
    while (index < count) {
        stored[index] = values.get(index);
        index = index + 1;
    }
    return stored[0..count];
}

qid.SymbolId[]& empty_symbol_ids(hir_store.HirStore& hirs) {
    Int capacity = 1;
    qid.SymbolId![*] stored = hirs.storage.alloc_array<qid.SymbolId>(capacity);
    return stored[0..0];
}

() add_value(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    UInt8[]& name,
    Bool has_param
) {
    qid.DefId def_id = create_builtin_def(symbols, defs, resolve, name, .builtin_value_def, .value_name);
    hirs.declare_def(def_id, .function_decl);
    hirs.declare_signature(def_id, builtin_value_signature(hirs, def_id, has_param));
    sources.set_sourceless_def_span(def_id, token.Span());
}

() add_value_with_param(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    hir_store.HirStore& hirs,
    source_map.SourceMap& sources,
    UInt8[]& name,
    qid.DefId param_type_def
) {
    qid.DefId def_id = create_builtin_def(symbols, defs, resolve, name, .builtin_value_def, .value_name);
    hirs.declare_def(def_id, .function_decl);
    hirs.declare_signature(def_id, builtin_value_signature_with_param(hirs, def_id, param_type_def));
    sources.set_sourceless_def_span(def_id, token.Span());
}

hir.HirFunctionSignature builtin_value_signature(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    Bool has_param
) {
    if (has_param) {
        return hir.HirFunctionSignature (
            has_receiver: false,
            params: invalid_param_type_refs(hirs, owner_def),
            param_symbols: empty_symbol_ids(hirs),
            param_defaults: empty_param_defaults(hirs),
            result: invalid_type_ref(hirs, owner_def)
        );
    }
    return hir.HirFunctionSignature (
        has_receiver: false,
        params: empty_hir_ids(hirs),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: invalid_type_ref(hirs, owner_def)
    );
}

hir.HirFunctionSignature builtin_value_signature_with_param(
    hir_store.HirStore& hirs,
    qid.DefId owner_def,
    qid.DefId param_type_def
) {
    list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(1);
    params.add(builtin_named_type_ref(hirs, owner_def, param_type_def));
    return hir.HirFunctionSignature (
        has_receiver: false,
        params: freeze_hir_ids(hirs, params$.move()),
        param_symbols: empty_symbol_ids(hirs),
        param_defaults: empty_param_defaults(hirs),
        result: invalid_type_ref(hirs, owner_def)
    );
}

hir.HirId[]& invalid_param_type_refs(hir_store.HirStore& hirs, qid.DefId owner_def) {
    list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(1);
    params.add(invalid_type_ref(hirs, owner_def));
    return freeze_hir_ids(hirs, params$.move());
}

hir.HirId invalid_type_ref(hir_store.HirStore& hirs, qid.DefId owner_def) {
    return hirs.add_node(owner_def, .invalid_type_ref());
}

qid.DefId create_type_def(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    UInt8[]& name
) {
    return create_builtin_def(symbols, defs, resolve, name, .builtin_type_def, .type_name);
}

qid.DefId create_builtin_def(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    store.ResolveStore& resolve,
    UInt8[]& name,
    def.DefKind kind,
    def.NameDomain domain
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        kind,
        domain,
        .public_visibility,
        def.Name (symbol: symbol, span: span),
        null,
        null,
        resolve.builtin_namespace,
        null
    );
    resolve.bind_builtin_name(symbol, domain, def_id, span);
    return def_id;
}
