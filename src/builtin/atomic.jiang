// 编译器 builtin 原子值。
//
// 公开方法按 memory order 分派到 compiler builtin。builtin 必须直接降低为目标原子指令，
// 不能通过 system 或 OS 函数调用实现。AtomicValue 只包含后端保证 lock-free 的标量类型。

import * = "../core/atomic_value.jiang";
import * = "../core/traits.jiang";

public enum MemoryOrder {
    relaxed,
    acquire,
    release,
    acquire_release,
    sequential,
}

@where(T: AtomicValue, T: Copyable)
public struct Atomic<T>: Movable {
    T storage;

    public init(self, T value) {
        self.storage = value;
    }

    @inline
    public T get(self) {
        return atomic_load(self.storage$.ref(), MemoryOrder.sequential);
    }

    @inline
    public T get_with_order(self, MemoryOrder order) {
        if (order == .relaxed) {
            return atomic_load(self.storage$.ref(), MemoryOrder.relaxed);
        }
        if (order == .acquire) {
            return atomic_load(self.storage$.ref(), MemoryOrder.acquire);
        }
        if (order == .sequential) {
            return atomic_load(self.storage$.ref(), MemoryOrder.sequential);
        }
        assert(false);
        return atomic_load(self.storage$.ref(), MemoryOrder.sequential);
    }

    @inline
    public () set(self, T value) {
        atomic_store(self.storage$.ref(), value, MemoryOrder.sequential);
    }

    @inline
    public () set_with_order(self, T value, MemoryOrder order) {
        if (order == .relaxed) {
            atomic_store(self.storage$.ref(), value, MemoryOrder.relaxed);
            return;
        }
        if (order == .release) {
            atomic_store(self.storage$.ref(), value, MemoryOrder.release);
            return;
        }
        if (order == .sequential) {
            atomic_store(self.storage$.ref(), value, MemoryOrder.sequential);
            return;
        }
        assert(false);
    }

    @inline
    public T get_and_set(self, T value) {
        return atomic_exchange(self.storage$.ref(), value, MemoryOrder.sequential);
    }

    @inline
    public T get_and_set_with_order(self, T value, MemoryOrder order) {
        return atomic_exchange_with_order(self.storage$.ref(), value, order);
    }

    @inline
    public Bool compare_exchange(
        self,
        T expected,
        T desired
    ) {
        return atomic_compare_exchange(
            self.storage$.ref(),
            expected,
            desired,
            MemoryOrder.sequential,
            MemoryOrder.sequential
        );
    }

    @inline
    public Bool compare_exchange_with_order(
        self,
        T expected,
        T desired,
        MemoryOrder success,
        MemoryOrder failure
    ) {
        if (failure == .relaxed) {
            return compare_exchange_relaxed_failure(self.storage$.ref(), expected, desired, success);
        }
        if (failure == .acquire) {
            return compare_exchange_acquire_failure(self.storage$.ref(), expected, desired, success);
        }
        if (failure == .sequential) {
            return compare_exchange_sequential_failure(self.storage$.ref(), expected, desired, success);
        }
        assert(false);
        return false;
    }
}

@where(T: AtomicValue, T: Copyable)
@life()
T atomic_exchange_with_order<T>(T& storage, T value, MemoryOrder order) {
    if (order == .relaxed) {
        return atomic_exchange(storage, value, MemoryOrder.relaxed);
    }
    if (order == .acquire) {
        return atomic_exchange(storage, value, MemoryOrder.acquire);
    }
    if (order == .release) {
        return atomic_exchange(storage, value, MemoryOrder.release);
    }
    if (order == .acquire_release) {
        return atomic_exchange(storage, value, MemoryOrder.acquire_release);
    }
    if (order == .sequential) {
        return atomic_exchange(storage, value, MemoryOrder.sequential);
    }
    assert(false);
    return atomic_exchange(storage, value, MemoryOrder.sequential);
}

@where(T: AtomicValue, T: Copyable)
Bool compare_exchange_relaxed_failure<T>(
    T& storage,
    T expected,
    T desired,
    MemoryOrder success
) {
    if (success == .relaxed) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.relaxed, MemoryOrder.relaxed
        );
    }
    if (success == .acquire) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.acquire, MemoryOrder.relaxed
        );
    }
    if (success == .release) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.release, MemoryOrder.relaxed
        );
    }
    if (success == .acquire_release) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.acquire_release, MemoryOrder.relaxed
        );
    }
    if (success == .sequential) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.sequential, MemoryOrder.relaxed
        );
    }
    assert(false);
    return false;
}

@where(T: AtomicValue, T: Copyable)
Bool compare_exchange_acquire_failure<T>(
    T& storage,
    T expected,
    T desired,
    MemoryOrder success
) {
    if (success == .acquire) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.acquire, MemoryOrder.acquire
        );
    }
    if (success == .acquire_release) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.acquire_release, MemoryOrder.acquire
        );
    }
    if (success == .sequential) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.sequential, MemoryOrder.acquire
        );
    }
    assert(false);
    return false;
}

@where(T: AtomicValue, T: Copyable)
Bool compare_exchange_sequential_failure<T>(
    T& storage,
    T expected,
    T desired,
    MemoryOrder success
) {
    if (success == .sequential) {
        return atomic_compare_exchange(
            storage, expected, desired, MemoryOrder.sequential, MemoryOrder.sequential
        );
    }
    assert(false);
    return false;
}

extern [builtin] T atomic_load<T>(T& storage, MemoryOrder order);

extern [builtin] () atomic_store<T>(T& storage, T value, MemoryOrder order);

@life()
extern [builtin] T atomic_exchange<T>(T& storage, T value, MemoryOrder order);

extern [builtin] Bool atomic_compare_exchange<T>(
    T& storage,
    T expected,
    T desired,
    MemoryOrder success,
    MemoryOrder failure
);
