// 编译器 builtin 原子值。
//
// 公开方法按 memory order 分派到 compiler builtin。builtin 必须直接降低为目标原子指令，
// 不能通过 system 或 OS 函数调用实现。AtomicValue 只包含后端保证 lock-free 的标量类型。

import * = "../core/atomic_value.jiang";

public enum AtomicLoadOrder {
    relaxed,
    acquire,
    sequential,
}

public enum AtomicStoreOrder {
    relaxed,
    release,
    sequential,
}

public enum AtomicUpdateOrder {
    relaxed,
    acquire,
    release,
    acquire_release,
    sequential,
}

@where(T: AtomicValue, T: !Movable)
public struct Atomic<T>: Movable {
    T storage;

    public init(self, T value) {
        self.storage = value;
    }

    @inline
    public T get(self) {
        return self.get_sequential();
    }

    @inline
    public T get_with_order(self, AtomicLoadOrder order) {
        if (order == .relaxed) {
            return self.get_relaxed();
        }
        if (order == .acquire) {
            return self.get_acquire();
        }
        return self.get_sequential();
    }

    @inline
    public T get_relaxed(self) {
        return atomic_load(self.storage$.ref(), AtomicLoadOrder.relaxed);
    }

    @inline
    public T get_acquire(self) {
        return atomic_load(self.storage$.ref(), AtomicLoadOrder.acquire);
    }

    @inline
    public T get_sequential(self) {
        return atomic_load(self.storage$.ref(), AtomicLoadOrder.sequential);
    }

    @inline
    public () set(self, T value) {
        self.set_sequential(value);
    }

    @inline
    public () set_with_order(self, T value, AtomicStoreOrder order) {
        if (order == .relaxed) {
            self.set_relaxed(value);
            return;
        }
        if (order == .release) {
            self.set_release(value);
            return;
        }
        self.set_sequential(value);
    }

    @inline
    public () set_relaxed(self, T value) {
        atomic_store(self.storage$.ref(), value, AtomicStoreOrder.relaxed);
    }

    @inline
    public () set_release(self, T value) {
        atomic_store(self.storage$.ref(), value, AtomicStoreOrder.release);
    }

    @inline
    public () set_sequential(self, T value) {
        atomic_store(self.storage$.ref(), value, AtomicStoreOrder.sequential);
    }

    @inline
    public Bool compare_exchange(
        self,
        T expected,
        T desired,
        AtomicUpdateOrder success,
        AtomicLoadOrder failure
    ) {
        if (failure == .relaxed) {
            return compare_exchange_relaxed_failure(self.storage$.ref(), expected, desired, success);
        }
        if (failure == .acquire) {
            return compare_exchange_acquire_failure(self.storage$.ref(), expected, desired, success);
        }
        return compare_exchange_seq_cst_failure(self.storage$.ref(), expected, desired, success);
    }

    @inline
    public Bool compare_exchange_acquire_release(self, T expected, T desired) {
        return atomic_compare_exchange(
            self.storage$.ref(),
            expected,
            desired,
            AtomicUpdateOrder.acquire_release,
            AtomicLoadOrder.acquire
        );
    }

    @inline
    public Bool compare_exchange_sequential(self, T expected, T desired) {
        return atomic_compare_exchange(
            self.storage$.ref(),
            expected,
            desired,
            AtomicUpdateOrder.sequential,
            AtomicLoadOrder.sequential
        );
    }
}

@where(T: AtomicValue, T: !Movable)
Bool compare_exchange_relaxed_failure<T>(
    T& storage,
    T expected,
    T desired,
    AtomicUpdateOrder success
) {
    if (success == .relaxed) {
        return atomic_compare_exchange(
            storage, expected, desired, AtomicUpdateOrder.relaxed, AtomicLoadOrder.relaxed
        );
    }
    if (success == .acquire) {
        return atomic_compare_exchange(
            storage, expected, desired, AtomicUpdateOrder.acquire, AtomicLoadOrder.relaxed
        );
    }
    if (success == .release) {
        return atomic_compare_exchange(
            storage, expected, desired, AtomicUpdateOrder.release, AtomicLoadOrder.relaxed
        );
    }
    if (success == .acquire_release) {
        return atomic_compare_exchange(
            storage,
            expected,
            desired,
            AtomicUpdateOrder.acquire_release,
            AtomicLoadOrder.relaxed
        );
    }
    return atomic_compare_exchange(
        storage, expected, desired, AtomicUpdateOrder.sequential, AtomicLoadOrder.relaxed
    );
}

@where(T: AtomicValue, T: !Movable)
Bool compare_exchange_acquire_failure<T>(
    T& storage,
    T expected,
    T desired,
    AtomicUpdateOrder success
) {
    if (success == .acquire) {
        return atomic_compare_exchange(
            storage, expected, desired, AtomicUpdateOrder.acquire, AtomicLoadOrder.acquire
        );
    }
    if (success == .acquire_release) {
        return atomic_compare_exchange(
            storage,
            expected,
            desired,
            AtomicUpdateOrder.acquire_release,
            AtomicLoadOrder.acquire
        );
    }
    if (success == .sequential) {
        return atomic_compare_exchange(
            storage, expected, desired, AtomicUpdateOrder.sequential, AtomicLoadOrder.acquire
        );
    }
    return invalid_compare_exchange_order();
}

@where(T: AtomicValue, T: !Movable)
Bool compare_exchange_seq_cst_failure<T>(
    T& storage,
    T expected,
    T desired,
    AtomicUpdateOrder success
) {
    if (success == .sequential) {
        return atomic_compare_exchange(
            storage,
            expected,
            desired,
            AtomicUpdateOrder.sequential,
            AtomicLoadOrder.sequential
        );
    }
    return invalid_compare_exchange_order();
}

Bool invalid_compare_exchange_order() {
    assert(false);
    return false;
}

extern [builtin] T atomic_load<T>(T& storage, AtomicLoadOrder order);

extern [builtin] () atomic_store<T>(T& storage, T value, AtomicStoreOrder order);

extern [builtin] Bool atomic_compare_exchange<T>(
    T& storage,
    T expected,
    T desired,
    AtomicUpdateOrder success,
    AtomicLoadOrder failure
);
