// 语言级互斥锁。
//
// Mutex 只保存 system provider 的 opaque handle。具体阻塞原语由 system 选择，
// 用户代码不接触 pthread、os_unfair_lock 或其他平台类型。

import thread = "../system/thread.jiang";

public struct Mutex: !Movable {
    Void* handle;

    public init(self) {
        thread.Mutex mutex = thread.create_mutex();
        assert(thread.mutex_valid(mutex));
        self.handle = thread.mutex_handle(mutex);
    }

    public deinit(self) {
        thread.destroy(thread.mutex_from_handle(self.handle));
    }

    @inline
    @life(self > return)
    public MutexGuard lock(self) {
        thread.lock(thread.mutex_from_handle(self.handle));
        return MutexGuard(handle: self.handle, mutex: self$.ref());
    }
}

public struct MutexGuard: Movable {
    // Cached because guard destruction must not dereference a possibly rewritten borrow place.
    Void* handle;

    // Lifetime-only anchor: the Mutex must outlive the guard that owns its unlock operation.
    @life(mutex > self)
    Mutex& mutex;

    public deinit(self) {
        thread.unlock(thread.mutex_from_handle(self.handle));
    }
}
