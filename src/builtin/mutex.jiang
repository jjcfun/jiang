// 语言级互斥容器。
//
// Mutex<T> 将值与 system provider 的 opaque lock 绑定。用户只能在 with_lock
// 回调的同步作用域中取得值的可变引用，不接触 pthread、os_unfair_lock 等平台类型。

import thread = "../system/thread.jiang";

@region(a)
public struct Mutex<T>: !Movable {
    Void* handle;

    @life(a)
    T value;

    public init(self, T value) {
        thread.Mutex mutex = thread.create_mutex();
        assert(thread.mutex_valid(mutex));
        self.handle = thread.mutex_handle(mutex);
        self.value = value;
    }

    public deinit(self) {
        thread.destroy(thread.mutex_from_handle(self.handle));
    }

    @inline
    public R with_lock<R>(self, Fn<R, T&!> action) {
        thread.lock(thread.mutex_from_handle(self.handle));
        MutexLock lock = MutexLock(self.handle);
        T&! value = unsafe {
            self.value$.ptr()$.as(T&!)
        };
        return action(value);
    }
}

struct MutexLock: !Movable {
    Void* handle;

    init(self, Void* handle) {
        self.handle = handle;
    }

    public deinit(self) {
        thread.unlock(thread.mutex_from_handle(self.handle));
    }
}
