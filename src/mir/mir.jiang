    return .error_union_value(value);
}

public MirRvalue optional_rvalue(MirOptionalRvalue value) {
    return .optional_value(value);
}

public MirRvalue aggregate_rvalue(MirAggregateRvalue value) {
    return .aggregate_value(value);
}

public struct MirUseRvalue {
    public MirOperand value;
}

public enum MirUnaryOp {
    neg,
    bit_not,
    logic_not,
}

public struct MirUnaryRvalue {
    public MirUnaryOp op;
    public MirOperand value;
}

public enum MirBinaryOp {
    add,
    sub,
    mul,
    div,
    rem,
    bit_and,
    bit_or,
    bit_xor,
    shl,
    shr,
    eq,
    ne,
    lt,
    le,
    gt,
    ge,
}

public struct MirBinaryRvalue {
    public MirBinaryOp op;
    public MirOperand lhs;
    public MirOperand rhs;
}

public enum MirCastKind {
    int_to_int,
    int_to_float,
    float_to_int,
    float_to_float,
    ptr_to_ptr,
    ptr_to_int,
    int_to_ptr,
    bitcast,
}

public struct MirCastRvalue {
    public MirCastKind kind;
    public MirOperand value;
    public qid.TypeId target_type;
}

public struct MirBorrowRvalue {
    public MirPlace place;
}

public struct MirAddressOfRvalue {
    public Bool mutable_pointer;
    public MirPlace place;
}

public struct MirAllocValueRvalue {
    public qid.TypeId value_type;
    public MirOperand value;
}

public struct MirAllocArrayRvalue {
    public qid.TypeId element_type;
    public MirOperand count;
}

public struct MirFreeRvalue {
    public MirOperand pointer;
}

public struct MirSliceRvalue {
    public MirPlace base;
    public MirOperand? start;
    public MirOperand? end;
}

public struct MirLenRvalue {
    public MirPlace place;
}

public struct MirDiscriminantRvalue {
    public MirPlace place;
}

public enum MirAggregateKind {
    tuple,
    array,
    struct_value,
    record_value,
    enum_case,
    union_variant,
}

public struct MirAggregateRvalue {
    public MirAggregateKind kind;
    public qid.DefId? def_id;
    public qid.TypeId type_id;
    public MirOperand? tag;
    public Int payload_field_index;
    public MirOperand[] fields;
}

public enum MirOptionalOp {
    make_some,
    make_none,
    unwrap_some,
    is_some,
}

public struct MirOptionalRvalue {
