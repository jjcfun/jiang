}

public struct MirTaskConsumeStatement: Copyable {
    public MirPlace task;
    // 与 Task storage place 分离的编译期 identity。嵌套 Task 字段使用 synthetic local，
    // 避免同一聚合中的多个 Task 被 region/frame planner 合并。
    public MirLocalId? task_local = null;
    // 只有源程序中的 await/cancel_and_await 参与“结果只能消费一次”诊断。
    // 编译器生成的结构化清理 join 不应被当成第二次用户消费。
    public Bool user_visible;
    // 同一个 await site 因协程恢复 CFG 被再次分析时不构成第二次源码消费。
    public Int site;
    public Bool repeatable;
}

