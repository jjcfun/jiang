public struct MirGotoTerminator: Copyable {
    public MirBlockId target;
}

public struct MirBranchTerminator: Copyable {
    public MirOperand condition;
    public MirBlockId then_target;
    public MirBlockId else_target;
}

public struct MirSwitchTerminator: Copyable {
    public MirOperand discriminator;
    public MirSwitchCase[]& cases;
    public MirBlockId default_target;
}

public struct MirSwitchCase: Copyable {
    public MirConst value;
    public MirBlockId target;
}

public struct MirCallTerminator: Copyable {
    public MirCallCallee callee;
    public MirOperand[]& args;
    public types.EffectSet current_effects;
    public Bool is_suspend_point;
    public MirSuspendWakeKind suspend_wake = .none;
    // direct_child 的源码实例。callee 可能是递归 start shim，因此不能从
    // 实际调用符号反推这条固定点边。
    public MirFunctionRef? suspend_child = null;
    // handoff 只保存 continuation state；当前 resume 返回时不能再次发布 Task suspend。
    public Bool task_handoff = false;
    public MirAsyncStartKind? async_start = null;

    // 返回值写入 destination，然后跳到 target。
    public MirPlace destination;
    public MirBlockId target;

    // init call 会通过 hidden out operand 初始化调用方传入的 storage；
    // 它不是普通返回值，但 borrow check 需要知道这个 place 已初始化。
    public MirPlace? initialized_place;

    // 间接 callable 的 LifetimeContract 已解析为 MIR 实参数路径。
    // null 只允许用于返回类型不携带 borrow 的内部/合成调用；borrow check 会校验该不变量。
    public types.LifetimeFlow[]&? return_lifetime_flows = null;

    // async ABI 调用的实际 args/destination 是 frame pointer 与 unit 临时值。
    // 这两个字段保留源码 callable 的逻辑实参和结果 place，仅供 borrow check 应用 LifetimeContract。
    public MirOperand[]&? lifetime_args = null;
    public MirPlace? lifetime_destination = null;

    // exclusive 参数签名约束会在 call lowering 时解析成调用点 place；
    // borrow check 在这些 place 上验证没有未来仍会使用的派生 borrow。
    public MirPlace[]& exclusive_places;

    // 可抛错、可 panic 或有析构路径的 call 可以跳到 cleanup block。
    public MirBlockId? cleanup;
}

public enum MirAsyncStartKind {
    observed_task,
    detached,
}

public union MirCallCallee: Copyable {
    public MirFunctionRef direct_function;
    public MirOperand indirect_operand;
    public MirDomainEnqueueCallee domain_enqueue;
    public MirDynamicDomainEnqueueCallee dynamic_domain_enqueue;
}

