// MIR 是 HIR 之后、backend 之前的中层 IR。完整阶段设计见 doc/compiler/mir.md。
//
// 这里采用接近 Rust MIR 的 CFG 形态：
// - 一个 body 由 locals 和 basic blocks 组成。
// - 每个 basic block 包含若干 statement，并以一个 terminator 结束。
// - statement 只做局部赋值、存储生命周期和 discriminant 写入。
// - terminator 负责控制流跳转、调用、return、throw、drop 等会改变 CFG 的动作。
//
// MIR 不是 SSA。表达式结果写入 MirPlace，分支合流也通过同一个 local/place
// 承接结果。后续如果需要 SSA 优化，可以从 MIR 再构建专门的优化 IR。

import qid = "../store/id.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import memory = "../support/memory.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";
import token = "../syntax/token.jiang";

public struct MirStore: Movable {
    public Bool! ok;
    public arena.Arena! storage;
    public list.ArrayList<MirFunction> functions;
    public list.ArrayList<MirGlobal> globals;

    // 非泛型函数仍可直接用 DefId 查找。
    public table.HashTable<qid.DefId, MirFunctionId> function_for_def;
    public table.HashTable<qid.DefId, MirGlobalId> global_for_def;

    // 泛型函数 concrete MIR 需要同时区分 DefId 和 type args。
    // 不能写进 function_for_def，否则 id<Int> 和 id<Bool> 会互相覆盖。
    public table.HashTable<MirFunctionKey, MirFunctionId> function_for_instance;

    public init(self, Bool ok) {
        self.ok = ok;
        self.storage = arena.Arena();
        self.functions = list.ArrayList<MirFunction>();
        self.globals = list.ArrayList<MirGlobal>();
        self.function_for_def = table.HashTable<qid.DefId, MirFunctionId>();
        self.global_for_def = table.HashTable<qid.DefId, MirGlobalId>();
        self.function_for_instance = table.HashTable<MirFunctionKey, MirFunctionId>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public MirFunctionId add_function(self, MirFunction function) {
        MirFunctionId id = function.id;
        self.functions.add(function);
        if (function.type_args.length == 0 && function.const_args.length == 0) {
            if (!function.is_runtime_entry) {
                self.function_for_def.set(function.def_id, id);
            }
        } else {
            self.function_for_instance.set(
                MirFunctionKey(function.def_id, function.type_args, function.const_args),
                id
            );
        }
        return id;
    }

    public MirFunction function(self, MirFunctionId id) {
        return self.functions.get(id.to_index());
    }

    public MirGlobalId add_global(self, MirGlobal global) {
        MirGlobalId id = global.id;
        self.globals.add(global);
        self.global_for_def.set(global.def_id, id);
        return id;
    }

    public MirFunctionId? function_id_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, MirFunctionId>(self.function_for_def$.ref(), def_id);
    }

    public MirGlobalId? global_id_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, MirGlobalId>(self.global_for_def$.ref(), def_id);
    }

    public MirFunctionId? function_id_for_instance(self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return table.hash_table_get_value<MirFunctionKey, MirFunctionId>(
            self.function_for_instance$.ref(),
            MirFunctionKey(def_id, type_args, const_args)
        );
    }

    public qid.TypeId[]& empty_type_args(self) {
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(1);
        return values[0..0];
    }

    public qid.TypeId[]& type_arg_array(self, qid.TypeId[]& type_args) {
        Int count = type_args.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = type_args[index];
            index = index + 1;
        }
        return values[0..count];
    }

    public comptime_value.ComptimeValue[]& empty_const_args(self) {
        comptime_value.ComptimeValue![*] values =
            self.storage.alloc_array<comptime_value.ComptimeValue>(1);
        return values[0..0];
    }

    public comptime_value.ComptimeValue[]& const_arg_array(self,
        comptime_value.ComptimeValue[]& const_args
    ) {
        Int count = const_args.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        comptime_value.ComptimeValue![*] values =
            self.storage.alloc_array<comptime_value.ComptimeValue>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = const_args[index];
            index = index + 1;
        }
        return values[0..count];
    }

    public MirLocalDecl[]& empty_locals(self) {
        MirLocalDecl![*] values = self.storage.alloc_array<MirLocalDecl>(1);
        return values[0..0];
    }

    public MirLocalDecl![*] alloc_local_array(self, Int count) {
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        return self.storage.alloc_array<MirLocalDecl>(capacity);
    }

    public MirStatement[]& empty_statements(self) {
        MirStatement![*] values = self.storage.alloc_array<MirStatement>(1);
        return values[0..0];
    }

    public MirBlock[]& empty_blocks(self) {
        MirBlock![*] values = self.storage.alloc_array<MirBlock>(1);
        return values[0..0];
    }

    public MirStatement[]& statement_array(self, list.ArrayList<MirStatement>& statements) {
        return self.statement_slice(statements.slice());
    }

    public MirStatement[]& statement_slice(self, MirStatement[]& statements) {
        Int count = statements.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirStatement![*] values = self.storage.alloc_array<MirStatement>(capacity);
        Int! index = 0;
        while (index < count) {
            memory.copy_bytes(
                values[index]$.ptr()$.as(UInt8[*]),
                statements[index]$.ptr()$.as(UInt8[*]),
                MirStatement$.size()
            );
            index = index + 1;
        }
        return values[0..count];
    }

    public MirBlock[]& block_array(self, list.ArrayList<MirBlock>& blocks) {
        Int count = blocks.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirBlock![*] values = self.storage.alloc_array<MirBlock>(capacity);
        MirBlock[]& source = blocks.slice();
        Int! index = 0;
        while (index < count) {
            // MirBlock 内含 MirTerminator 大 union。这里是在把临时 block 列表
            // 固化进 MIR arena，按字节复制可以避开大 union/大 struct 按值赋值路径。
            memory.copy_bytes(
                values[index]$.ptr()$.as(UInt8[*]),
                source[index]$.ptr()$.as(UInt8[*]),
                MirBlock$.size()
            );
            index = index + 1;
        }
        return values[0..count];
    }

    public MirOperand[]& operand_array(self, list.ArrayList<MirOperand>& operands) {
        return self.operand_slice(operands.slice());
    }

    public MirOperand[]& operand_slice(self, MirOperand[]& operands) {
        Int count = operands.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirOperand![*] values = self.storage.alloc_array<MirOperand>(capacity);
        Int! index = 0;
        while (index < count) {
            // MirOperand 是 backend 前最频繁复制的大 union。这里是在把临时
            // ArrayList/slice 固化进 MIR arena，直接按元素字节复制可以避免
            // 自举阶段反复经过 union 按值赋值路径。
            memory.copy_bytes(
                values[index]$.ptr()$.as(UInt8[*]),
                operands[index]$.ptr()$.as(UInt8[*]),
                MirOperand$.size()
            );
            index = index + 1;
        }
        return values[0..count];
    }

    public MirPlace[]& place_array(self, list.ArrayList<MirPlace>& places) {
        Int count = places.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirPlace![*] values = self.storage.alloc_array<MirPlace>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = places.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirPlace[]& empty_places(self) {
        list.ArrayList<MirPlace>! places = list.ArrayList<MirPlace>();
        return self.place_array(places$.ref());
    }

    public MirPlace[]& single_place_array(self, MirPlace place) {
        list.ArrayList<MirPlace>! places = list.ArrayList<MirPlace>(1);
        places.add(place);
        return self.place_array(places$.ref());
    }

    public MirInlineAsmOperand[]& inline_asm_operand_array(self, list.ArrayList<MirInlineAsmOperand>& operands) {
        Int count = operands.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirInlineAsmOperand![*] values = self.storage.alloc_array<MirInlineAsmOperand>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = operands.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirInlineAsmOperand[]& inline_asm_operand_slice(self, MirInlineAsmOperand[]& operands) {
        list.ArrayList<MirInlineAsmOperand>! values = list.ArrayList<MirInlineAsmOperand>(operands.length);
        Int! index = 0;
        while (index < operands.length) {
            values.add(operands[index]);
            index = index + 1;
        }
        return self.inline_asm_operand_array(values$.ref());
    }

    public qid.SymbolId[]& symbol_id_array(self, list.ArrayList<qid.SymbolId>& symbols) {
        Int count = symbols.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.SymbolId![*] values = self.storage.alloc_array<qid.SymbolId>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = symbols.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public qid.SymbolId[]& symbol_id_slice(self, qid.SymbolId[]& symbols) {
        list.ArrayList<qid.SymbolId>! values = list.ArrayList<qid.SymbolId>(symbols.length);
        Int! index = 0;
        while (index < symbols.length) {
            values.add(symbols[index]);
            index = index + 1;
        }
        return self.symbol_id_array(values$.ref());
    }

    public MirStaticField[]& static_field_array(self, list.ArrayList<MirStaticField>& fields) {
        Int count = fields.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirStaticField![*] values = self.storage.alloc_array<MirStaticField>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = fields.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirSwitchCase[]& switch_case_array(self, list.ArrayList<MirSwitchCase>& cases) {
        return self.switch_case_slice(cases.slice());
    }

    public MirSwitchCase[]& switch_case_slice(self, MirSwitchCase[]& cases) {
        Int count = cases.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirSwitchCase![*] values = self.storage.alloc_array<MirSwitchCase>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = cases[index];
            index = index + 1;
        }
        return values[0..count];
    }

    public MirPlaceElem[]& empty_projection(self) {
        MirPlaceElem![*] values = self.storage.alloc_array<MirPlaceElem>(1);
        return values[0..0];
    }

    public MirPlaceElem[]& projection_array(self, list.ArrayList<MirPlaceElem>& elems) {
        return self.projection_slice(elems.slice());
    }

    public MirPlaceElem[]& projection_slice(self, MirPlaceElem[]& elems) {
        Int count = elems.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirPlaceElem![*] values = self.storage.alloc_array<MirPlaceElem>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = elems[index];
            index = index + 1;
        }
        return values[0..count];
    }

}

public struct MirFunctionKey: Hashable, Equatable {
    // MIR 层自己的 instance key，避免 mir.jiang 依赖 sema/monomorph。
    // 形状和 monomorph.InstanceKey 保持一致，backend 后续也会从这里派生符号。
    public qid.DefId def_id;
    public qid.TypeId[]& type_args;
    public comptime_value.ComptimeValue[]& const_args;

    public init(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        comptime_value.ComptimeValue![*] empty =
            comptime_value.ComptimeValue!$.alloc_many(1);
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = empty[0..0];
    }

    public init(self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = const_args;
    }

    public UInt64 hash(self) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.def_id.to_index());
        hasher.write_int(self.type_args.length);
        Int! index = 0;
        while (index < self.type_args.length) {
            hasher.write_int(self.type_args[index].to_index());
            index = index + 1;
        }
        hasher.write_int(self.const_args.length);
        index = 0;
        while (index < self.const_args.length) {
            write_comptime_value_hash(hasher$.ref(), self.const_args[index]);
            index = index + 1;
        }
        return hasher.finish();
    }

    public Bool equal(MirFunctionKey& lhs, MirFunctionKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return comptime_value_slices_equal(lhs.const_args, rhs.const_args);
    }
}

() write_comptime_value_hash(hash.WyHasher& hasher, comptime_value.ComptimeValue value) {
    hasher.write_int(value.type_id.to_index());
    if (value.data is .invalid) { hasher.write_int(1); return; }
    if (value.data is .unit_value) { hasher.write_int(2); return; }
    if (value.data is .bool_value(bool_value)) {
        hasher.write_int(3);
        hasher.write_bool(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        hasher.write_int(4);
        hasher.write_int(int_value);
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        hasher.write_int(5);
        hasher.write_uint64(uint_value);
        return;
    }
    if (value.data is .char_value(char_value)) {
        hasher.write_int(6);
        hasher.write_uint64(char_value);
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        hasher.write_int(7);
        hasher.write_int(symbol_value.to_index());
        return;
    }
    if (value.data is .const_param_value(const_param)) {
        hasher.write_int(8);
        hasher.write_int(const_param.to_index());
        return;
    }
    if (value.data is .enum_case_value(enum_case)) {
        hasher.write_int(9);
        hasher.write_int(enum_case.to_index());
        return;
    }
    hasher.write_int(99);
}

Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    return false;
}

public struct MirFunctionId: traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MirFunctionId from_index(Int index) {
        return MirFunctionId(index);
    }
}

public struct MirGlobalId: traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MirGlobalId from_index(Int index) {
        return MirGlobalId(index);
    }
}

public struct MirBodyId: traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MirBodyId from_index(Int index) {
        return MirBodyId(index);
    }
}

public struct MirBlockId: traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MirBlockId from_index(Int index) {
        return MirBlockId(index);
    }
}

public struct MirLocalId: traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MirLocalId from_index(Int index) {
        return MirLocalId(index);
    }
}

public struct MirModule {
    public qid.ModuleId module_id;
    public MirFunction[]& functions;
    public MirGlobal[]& globals;
}

public struct MirFunction {
    public MirFunctionId id;
    public qid.DefId def_id;

    // 空数组表示普通非泛型函数；非空表示这个 MirFunction 是泛型函数的
    // concrete instance。
    public qid.TypeId[]& type_args;
    public comptime_value.ComptimeValue[]& const_args;
    public qid.SignatureId? signature_id;
    public Bool is_language_entry;
    public Bool is_runtime_entry;
    public Bool is_external;
    public Bool inline_always;
    public Bool naked;
    public token.Span span;
    public MirBody body;
}

public struct MirGlobal {
    public MirGlobalId id;
    public qid.DefId def_id;
    public qid.TypeId type_id;
    public token.Span span;
    public Bool read_only;
    public Bool is_external;

    // null 表示外部 global 或无需静态 initializer。
    public MirStaticValue? initializer;
}

public struct MirStaticField {
    public qid.TypeId type_id;
    public MirStaticValue value;
}

public union MirStaticValue {
    public MirConst scalar;
    public MirStaticField[]& aggregate;
    public MirFunctionRef function;
    public MirGlobalRef global_address;
}

public MirStaticValue scalar_static_value(MirConst value) {
    return .scalar(value);
}

public MirStaticValue aggregate_static_value(MirStaticField[]& fields) {
    return .aggregate(fields);
}

public MirStaticValue function_static_value(MirFunctionRef value) {
    return .function(value);
}

public MirStaticValue global_address_static_value(MirGlobalRef value) {
    return .global_address(value);
}

public struct MirBody {
    public MirBodyId id;
    public token.Span span;
    public MirLocalDecl[]& locals;
    public MirBlock[]& blocks;
    public MirBlockId entry;
    public MirLocalId return_local;
}

public enum MirLocalKind {
    return_place,
    param,
    user_local,
    compiler_temp,
}

public struct MirLocalDecl {
    public MirLocalId id;
    public MirLocalKind kind;
    public qid.TypeId type_id;
    public token.Span span;

    // 有源码名字的 param/local 指向 name interner；临时值和返回位置为 null。
    public qid.SymbolId? name;

    // 有对应声明或绑定的 local 指向 DefId；编译器临时值为 null。
    public qid.DefId? def_id;

    // true 表示这个 local 可以被重新赋值或通过可变 place 写入。
    public Bool mutable_local;

    // true 表示这个 local 可能被取地址、借用或捕获，后续优化不能随意替换为纯值。
    public Bool address_taken;
}

public struct MirBlock {
    public MirBlockId id;
    public token.Span span;
    public MirStatement[]& statements;
    public MirTerminator terminator;
}

public struct MirStatement {
    public token.Span span;
    public MirStatementKind kind;
}

public union MirStatementKind {
    MirAssignStatement assign_stmt;
    MirStorageLiveStatement storage_live_stmt;
    MirStorageDeadStatement storage_dead_stmt;
    MirSetDiscriminantStatement set_discriminant_stmt;
    MirForgetStatement forget_stmt;
}

public MirStatementKind assign_statement_kind(MirAssignStatement statement) {
    return .assign_stmt(statement);
}

public MirStatementKind storage_live_statement_kind(MirStorageLiveStatement statement) {
    return .storage_live_stmt(statement);
}

public MirStatementKind storage_dead_statement_kind(MirStorageDeadStatement statement) {
    return .storage_dead_stmt(statement);
}

public MirStatementKind set_discriminant_statement_kind(MirSetDiscriminantStatement statement) {
    return .set_discriminant_stmt(statement);
}

public MirStatementKind forget_statement_kind(MirForgetStatement statement) {
    return .forget_stmt(statement);
}

public struct MirAssignStatement {
