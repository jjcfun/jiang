        handoff: handoff
    ));
}

public struct MirDropTerminator: Copyable {
    public MirPlace place;
    public MirBlockId target;

    // drop/deinit 出错或 panic 时进入 cleanup；无异常语义时为 null。
    public MirBlockId? cleanup;
}

public struct MirAssertTerminator: Copyable {
    public MirOperand condition;
    public Bool expected;
    public qid.SymbolId? message;
    public MirBlockId target;
    public MirBlockId? cleanup;
}

public struct MirSuspendPendingTerminator: Copyable {
    public MirBlockId target;
    public MirSuspendWakeKind suspend_wake;
    public MirLocalId? task_local = null;
}

public struct MirReturnTerminator: Copyable {
    // 返回值固定从 body.return_local 读取。
    public Bool implicit_unit;
}

// Coroutine-only terminal used while building the cancellation cleanup path.
// Frame rewriting replaces it with completion notification before codegen.
public struct MirCancelTerminator: Copyable {
}

public struct MirThrowTerminator: Copyable {
    public MirOperand error_value;
}

public struct MirUnreachableTerminator: Copyable {
    public Bool generated_by_check;
}

// CFG dataflow 不直接 pattern match terminator。统一通过这两个 helper 读取
// successor，避免 borrow check、drop elaboration 和后端各自复制控制流规则。
public Int terminator_successor_count(MirTerminator terminator) {
    if (terminator.kind is .goto_term(_)) { return 1; }
    if (terminator.kind is .branch_term(_)) { return 2; }
    if (terminator.kind is .switch_term(switch_term)) { return switch_term.cases.length + 1; }
    if (terminator.kind is .call_term(call_term)) {
        if (call_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (drop_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (assert_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .suspend_pending_term(_)) { return 1; }
    return 0;
}

public MirBlockId terminator_successor_at(MirTerminator terminator, Int index) {
    assert(index >= 0 && index < terminator_successor_count(terminator));
    if (terminator.kind is .goto_term(goto_term)) { return goto_term.target; }
    if (terminator.kind is .branch_term(branch_term)) {
        if (index == 0) { return branch_term.then_target; }
        return branch_term.else_target;
    }
    if (terminator.kind is .switch_term(switch_term)) {
        if (index < switch_term.cases.length) {
            return switch_term.cases[index].target;
        }
        return switch_term.default_target;
    }
    if (terminator.kind is .call_term(call_term)) {
        if (index == 0) { return call_term.target; }
        return call_term.cleanup$.some();
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (index == 0) { return drop_term.target; }
        return drop_term.cleanup$.some();
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (index == 0) { return assert_term.target; }
        return assert_term.cleanup$.some();
    }
    if (terminator.kind is .suspend_pending_term(suspend_pending)) { return suspend_pending.target; }
    return MirBlockId(0);
}

public struct MirPlace: Copyable {
    public MirPlaceBase base;
    public MirLocalId local_id;
    public MirPlaceElem[]& projection;
}

public union MirPlaceBase: Copyable {
    MirLocalId local;
    MirGlobalRef global;
}

public MirPlaceBase local_place_base(MirLocalId local_id) {
    return .local(local_id);
}

public MirPlaceBase global_place_base(MirGlobalRef global_ref) {
    return .global(global_ref);
}

@life(projection > return)
public MirPlace local_place(MirLocalId local_id, MirPlaceElem[]& projection) {
    return MirPlace(
        base: local_place_base(local_id),
        local_id: local_id,
        projection: projection
    );
}

@life(projection > return)
public MirPlace global_place(MirGlobalRef global_ref, MirPlaceElem[]& projection) {
    return MirPlace(
        base: global_place_base(global_ref),
        local_id: MirLocalId.from_index(0),
        projection: projection
    );
}

public MirLocalId? place_local_id(MirPlace place) {
    if (place.base is .local(local_id)) {
        return local_id;
    }
    return null;
}

public union MirPlaceElem: Copyable {
    MirDerefProjection deref_projection;
    MirFieldProjection field_projection;
    MirFrameFieldProjection frame_field_projection;
    MirIndexProjection index_projection;
    MirConstantIndexProjection constant_index_projection;
    MirSubsliceProjection subslice_projection;
}

public MirPlaceElem deref_projection_elem(MirDerefProjection projection) {
    return .deref_projection(projection);
}

public MirPlaceElem field_projection_elem(MirFieldProjection projection) {
    return .field_projection(projection);
}

public MirPlaceElem frame_field_projection_elem(MirFrameFieldProjection projection) {
    return .frame_field_projection(projection);
}

public MirPlaceElem index_projection_elem(MirIndexProjection projection) {
    return .index_projection(projection);
}

public MirPlaceElem constant_index_projection_elem(MirConstantIndexProjection projection) {
    return .constant_index_projection(projection);
}

public MirPlaceElem subslice_projection_elem(MirSubsliceProjection projection) {
    return .subslice_projection(projection);
}

