public MirCallCallee domain_task_enqueue_callee(
    qid.DefId domain_def,
    Int domain_kind,
    MirOperand task,
    MirOperand resume,
    Bool handoff
) {
    return .domain_enqueue(MirDomainEnqueueCallee(
        domain_def: domain_def,
        domain_kind: domain_kind,
        task: task,
        resume: resume,
        handoff: handoff
    ));
}

