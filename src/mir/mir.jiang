}

public MirRvalue alloc_rvalue(MirAllocValueRvalue value) {
    return .alloc_value(value);
}

public MirRvalue alloc_array_rvalue(MirAllocArrayRvalue value) {
    return .alloc_array_value(value);
}

public MirRvalue free_rvalue(MirFreeRvalue value) {
