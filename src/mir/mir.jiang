    public qid.DefId domain_def;
    public Int domain_kind;
    public MirOperand? task;
    public MirOperand resume;
    public Bool handoff;
}

public struct MirDynamicDomainEnqueueCallee: Copyable {
    public MirOperand executor;
    public MirOperand? task;
    public MirOperand resume;
    public Bool handoff;
    public MirTaskScheduleMode mode = .concurrent;
}

public enum MirTaskScheduleMode {
    concurrent,
    local,
}

public MirCallCallee direct_function_callee(MirFunctionRef value) {
    return .direct_function(value);
}

