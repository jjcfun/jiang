public MirCallCallee dynamic_domain_enqueue_callee(MirOperand executor, MirOperand resume) {
    return .dynamic_domain_enqueue(MirDynamicDomainEnqueueCallee (
        executor: executor,
        task: null,
        resume: resume,
        handoff: false
    ));
}

