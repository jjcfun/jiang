public struct MirCoroutineFrameLayout: Copyable {
    public qid.TypeId frame_type_id;
    public MirTaskAbiLayout task_abi;
    public MirCoroutineFrameField[]& fields;
    public MirCoroutineLocalFrameField[]& local_mappings;
    public MirCoroutineSuspendPoint[]& suspend_points;
    public MirTaskRegion[]& task_regions;
    public MirCoroutineStateDispatch state_dispatch;
    public MirBlockId cancellation_entry;
    public Int state_field_index;
    public Int return_field_index;
    public Int continuation_result_field_index;
    public Int continuation_context_field_index;
    public Int continuation_function_field_index;
    public Int continuation_executor_field_index;
    public Int current_executor_field_index;
    public Int cancellation_enabled_field_index;
    public Int cancellation_context_field_index;
    public Int external_continuation_field_index;
    public Int domain_kind;
    public types.EffectSet effects;
    // false 表示该协程及其传递 child 不会等待未来事件，可以整体同步执行。
    public Bool may_defer = true;
}

// preserving 表示：如果当前 Job 进入函数时已经由单一串行 executor
// 独占，那么函数及其全部可达 suspend 边不会把该 Job 暴露给其他线程。
// 这只是函数体摘要，不代表每个调用上下文本身都 fully-confined。
public enum MirCoroutineConfinement {
    preserving,
    escaping,
}

public enum MirTaskAllocationStorage {
    local,
    heap,
}

public enum MirTaskFrameStorage {
    local,
    heap,
    external,
}

public enum MirTaskSyncMode {
    local_serial,
    concurrent,
}

// 描述 suspend 后谁可能让当前 Job 再次运行。它与 Task completion 的
// local_serial/concurrent 正交：完成通知可以是本地的，但被调用协程仍可能
// 经由外部线程或其他 executor 唤醒同一个 Job。
public enum MirSuspendWakeKind {
    none,
    direct_child,
    task_child,
    cross_executor,
    external,
    dynamic,
    arbitrary,
}

public enum MirTaskReclaimPolicy {
    parent,
    self_owned,
}

public struct MirTaskStoragePlan: Copyable {
