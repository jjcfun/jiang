    return .indirect_operand(value);
}

@life(resume > return)
public MirCallCallee domain_enqueue_callee(qid.DefId domain_def, Int domain_kind, MirOperand resume) {
    return .domain_enqueue(MirDomainEnqueueCallee(
        domain_def: domain_def,
        domain_kind: domain_kind,
        task: null,
        resume: resume,
        handoff: false
    ));
}

