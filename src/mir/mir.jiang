// MIR 是 HIR 之后、backend 之前的中层 IR。完整阶段设计见 doc/compiler/mir.md。
//
// 这里采用接近 Rust MIR 的 CFG 形态：
// - 一个 body 由 locals 和 basic blocks 组成。
// - 每个 basic block 包含若干 statement，并以一个 terminator 结束。
// - statement 只做局部赋值、存储生命周期和 discriminant 写入。
// - terminator 负责控制流跳转、调用、return、throw、drop 等会改变 CFG 的动作。
//
// MIR 不是 SSA。表达式结果写入 MirPlace，分支合流也通过同一个 local/place
// 承接结果。后续如果需要 SSA 优化，可以从 MIR 再构建专门的优化 IR。

import qid = "../query/id.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";
import token = "../syntax/token.jiang";

public struct MirStore: Movable {
    public Bool! ok;
    public arena.Arena! storage;
    public list.ArrayList<MirFunction> functions;

    // 非泛型函数仍可直接用 DefId 查找。
    public table.HashTable<qid.DefId, MirFunctionId> function_for_def;

    // 泛型函数 concrete MIR 需要同时区分 DefId 和 type args。
    // 不能写进 function_for_def，否则 id<Int> 和 id<Bool> 会互相覆盖。
    public table.HashTable<MirFunctionKey, MirFunctionId> function_for_instance;

    public init(Bool ok) {
        self.ok = ok;
        self.storage = arena.Arena();
        self.functions = list.ArrayList<MirFunction>();
        self.function_for_def = table.HashTable<qid.DefId, MirFunctionId>();
        self.function_for_instance = table.HashTable<MirFunctionKey, MirFunctionId>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public MirFunctionId add_function(MirFunction function) {
        MirFunctionId id = function.id;
        self.functions.add(function);
        if (function.type_args.length == 0) {
            if (!function.is_runtime_entry) {
                self.function_for_def.set(function.def_id, id);
            }
        } else {
            self.function_for_instance.set(MirFunctionKey(function.def_id, function.type_args), id);
        }
        return id;
    }

    public MirFunction function(MirFunctionId id) {
        return self.functions.get(id.to_index());
    }

    public MirFunctionId? function_id_for_def(qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, MirFunctionId>(self.function_for_def$.ref(), def_id);
    }

    public MirFunctionId? function_id_for_instance(qid.DefId def_id, qid.TypeId[] type_args) {
        return table.hash_table_get_value<MirFunctionKey, MirFunctionId>(
            self.function_for_instance$.ref(),
            MirFunctionKey(def_id, type_args)
        );
    }

    public qid.TypeId[] empty_type_args() {
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(1);
        return values[0..0];
    }

    public qid.TypeId[] type_arg_array(qid.TypeId[] type_args) {
        Int count = type_args.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = type_args[index];
            index = index + 1;
        }
        return values[0..count];
    }

    public MirLocalDecl[] empty_locals() {
        MirLocalDecl![*] values = self.storage.alloc_array<MirLocalDecl>(1);
        return values[0..0];
    }

    public MirLocalDecl![*] alloc_local_array(Int count) {
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        return self.storage.alloc_array<MirLocalDecl>(capacity);
    }

    public MirStatement[] empty_statements() {
        MirStatement![*] values = self.storage.alloc_array<MirStatement>(1);
        return values[0..0];
    }

    public MirBlock[] empty_blocks() {
        MirBlock![*] values = self.storage.alloc_array<MirBlock>(1);
        return values[0..0];
    }

    public MirStatement[] statement_array(list.ArrayList<MirStatement>& statements) {
        Int count = statements.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirStatement![*] values = self.storage.alloc_array<MirStatement>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = statements.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirBlock[] block_array(list.ArrayList<MirBlock>& blocks) {
        Int count = blocks.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirBlock![*] values = self.storage.alloc_array<MirBlock>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = blocks.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirOperand[] operand_array(list.ArrayList<MirOperand>& operands) {
        return self.operand_slice(operands.slice());
    }

    public MirOperand[] operand_slice(MirOperand[] operands) {
        Int count = operands.length;
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirOperand![*] values = self.storage.alloc_array<MirOperand>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = operands[index];
            index = index + 1;
        }
        return values[0..count];
    }

    public MirSwitchCase[] switch_case_array(list.ArrayList<MirSwitchCase>& cases) {
        Int count = cases.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirSwitchCase![*] values = self.storage.alloc_array<MirSwitchCase>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = cases.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    public MirPlaceElem[] empty_projection() {
        MirPlaceElem![*] values = self.storage.alloc_array<MirPlaceElem>(1);
        return values[0..0];
    }

    public MirPlaceElem[] projection_array(list.ArrayList<MirPlaceElem>& elems) {
        Int count = elems.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        MirPlaceElem![*] values = self.storage.alloc_array<MirPlaceElem>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = elems.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

}

public struct MirFunctionKey: Hashable, Equatable {
    // MIR 层自己的 instance key，避免 mir.jiang 依赖 sema/monomorph。
    // 形状和 monomorph.InstanceKey 保持一致，backend 后续也会从这里派生符号。
    public qid.DefId def_id;
    public qid.TypeId[] type_args;

    public init(qid.DefId def_id, qid.TypeId[] type_args) {
        self.def_id = def_id;
        self.type_args = type_args;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.def_id.to_index());
        hasher.write_int(self.type_args.length);
        Int! index = 0;
        while (index < self.type_args.length) {
            hasher.write_int(self.type_args[index].to_index());
            index = index + 1;
        }
        return hasher.finish();
    }

    public static Bool equal(MirFunctionKey& lhs, MirFunctionKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public struct MirFunctionId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static MirFunctionId from_index(Int index) {
        return MirFunctionId(index);
    }
}

public struct MirGlobalId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static MirGlobalId from_index(Int index) {
        return MirGlobalId(index);
    }
}

public struct MirBodyId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static MirBodyId from_index(Int index) {
        return MirBodyId(index);
    }
}

public struct MirBlockId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static MirBlockId from_index(Int index) {
        return MirBlockId(index);
    }
}

public struct MirLocalId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static MirLocalId from_index(Int index) {
        return MirLocalId(index);
    }
}

public struct MirModule {
    public qid.ModuleId module_id;
    public MirFunction[] functions;
    public MirGlobal[] globals;
}

public struct MirFunction {
    public MirFunctionId id;
    public qid.DefId def_id;

    // 空数组表示普通非泛型函数；非空表示这个 MirFunction 是泛型函数的
    // concrete instance。
    public qid.TypeId[] type_args;
    public qid.SignatureId? signature_id;
    public Bool is_runtime_entry;
    public Bool is_external;
    public token.Span span;
    public MirBody body;
}

public struct MirGlobal {
    public MirGlobalId id;
    public qid.DefId def_id;
    public qid.TypeId type_id;
    public token.Span span;

    // null 表示外部 global 或无 MIR initializer。
    public MirBody? initializer;
}

public struct MirBody {
    public MirBodyId id;
    public token.Span span;
    public MirLocalDecl[] locals;
    public MirBlock[] blocks;
    public MirBlockId entry;
    public MirLocalId return_local;
}

public enum MirLocalKind {
    return_place,
    param,
    user_local,
    compiler_temp,
}

public struct MirLocalDecl {
    public MirLocalId id;
    public MirLocalKind kind;
    public qid.TypeId type_id;
    public token.Span span;

    // 有源码名字的 param/local 指向 name interner；临时值和返回位置为 null。
    public qid.SymbolId? name;

    // 有对应声明或绑定的 local 指向 DefId；编译器临时值为 null。
    public qid.DefId? def_id;

    // true 表示这个 local 可以被重新赋值或通过可变 place 写入。
    public Bool mutable_local;

    // true 表示这个 local 可能被取地址、借用或捕获，后续优化不能随意替换为纯值。
    public Bool address_taken;
}

public struct MirBlock {
    public MirBlockId id;
    public token.Span span;
    public MirStatement[] statements;
    public MirTerminator terminator;
}

public struct MirStatement {
    public token.Span span;
    public MirStatementKind kind;
}

public union MirStatementKind {
    MirAssignStatement assign_stmt;
    MirStorageLiveStatement storage_live_stmt;
    MirStorageDeadStatement storage_dead_stmt;
    MirSetDiscriminantStatement set_discriminant_stmt;
}

public MirStatementKind assign_statement_kind(MirAssignStatement statement) {
    return .assign_stmt(statement);
}

public MirStatementKind storage_live_statement_kind(MirStorageLiveStatement statement) {
    return .storage_live_stmt(statement);
}

public MirStatementKind storage_dead_statement_kind(MirStorageDeadStatement statement) {
    return .storage_dead_stmt(statement);
}

public struct MirAssignStatement {
    public MirPlace destination;
    public MirRvalue value;
}

public struct MirStorageLiveStatement {
    public MirLocalId local_id;
}

public struct MirStorageDeadStatement {
    public MirLocalId local_id;
}

public struct MirSetDiscriminantStatement {
    public MirPlace destination;
    public Int discriminant;
}

public struct MirTerminator {
    public token.Span span;
    public MirTerminatorKind kind;
}

public union MirTerminatorKind {
    MirGotoTerminator goto_term;
    MirBranchTerminator branch_term;
    MirSwitchTerminator switch_term;
    MirCallTerminator call_term;
    MirDropTerminator drop_term;
    MirAssertTerminator assert_term;
    MirReturnTerminator return_term;
    MirThrowTerminator throw_term;
    MirUnreachableTerminator unreachable_term;
}

public MirTerminatorKind goto_terminator_kind(MirGotoTerminator terminator) {
    return .goto_term(terminator);
}

public MirTerminatorKind branch_terminator_kind(MirBranchTerminator terminator) {
    return .branch_term(terminator);
}

public MirTerminatorKind call_terminator_kind(MirCallTerminator terminator) {
    return .call_term(terminator);
}

public MirTerminatorKind switch_terminator_kind(MirSwitchTerminator terminator) {
    return .switch_term(terminator);
}

public MirTerminatorKind drop_terminator_kind(MirDropTerminator terminator) {
    return .drop_term(terminator);
}

public MirTerminatorKind assert_terminator_kind(MirAssertTerminator terminator) {
    return .assert_term(terminator);
}

public MirTerminatorKind return_terminator_kind(MirReturnTerminator terminator) {
    return .return_term(terminator);
}

public MirTerminatorKind unreachable_terminator_kind(MirUnreachableTerminator terminator) {
    return .unreachable_term(terminator);
}

public struct MirGotoTerminator {
    public MirBlockId target;
}

public struct MirBranchTerminator {
    public MirOperand condition;
    public MirBlockId then_target;
    public MirBlockId else_target;
}

public struct MirSwitchTerminator {
    public MirOperand discriminator;
    public MirSwitchCase[] cases;
    public MirBlockId default_target;
}

public struct MirSwitchCase {
    public MirConst value;
    public MirBlockId target;
}

public struct MirCallTerminator {
    public MirCallCallee callee;
    public MirOperand[] args;

    // 返回值写入 destination，然后跳到 target。
    public MirPlace destination;
    public MirBlockId target;

    // 可抛错、可 panic 或有析构路径的 call 可以跳到 cleanup block。
    public MirBlockId? cleanup;
}

public union MirCallCallee {
    public MirFunctionRef direct_function;
    public MirOperand indirect_operand;
}

public MirCallCallee direct_function_callee(MirFunctionRef value) {
    return .direct_function(value);
}

public MirCallCallee indirect_operand_callee(MirOperand value) {
    return .indirect_operand(value);
}

public struct MirDropTerminator {
    public MirPlace place;
    public MirBlockId target;

    // drop/deinit 出错或 panic 时进入 cleanup；无异常语义时为 null。
    public MirBlockId? cleanup;
}

public struct MirAssertTerminator {
    public MirOperand condition;
    public Bool expected;
    public qid.SymbolId? message;
    public MirBlockId target;
    public MirBlockId? cleanup;
}

public struct MirReturnTerminator {
    // 返回值固定从 body.return_local 读取。
    public Bool implicit_unit;
}

public struct MirThrowTerminator {
    public MirOperand error_value;
}

public struct MirUnreachableTerminator {
    public Bool generated_by_check;
}

// CFG dataflow 不直接 pattern match terminator。统一通过这两个 helper 读取
// successor，避免 borrow check、drop elaboration 和后端各自复制控制流规则。
public Int terminator_successor_count(MirTerminator terminator) {
    if (terminator.kind is .goto_term(_)) { return 1; }
    if (terminator.kind is .branch_term(_)) { return 2; }
    if (terminator.kind is .switch_term(switch_term)) { return switch_term.cases.length + 1; }
    if (terminator.kind is .call_term(call_term)) {
        if (call_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (drop_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (assert_term.cleanup != null) { return 2; }
        return 1;
    }
    return 0;
}

public MirBlockId terminator_successor_at(MirTerminator terminator, Int index) {
    assert(index >= 0 && index < terminator_successor_count(terminator));
    if (terminator.kind is .goto_term(goto_term)) { return goto_term.target; }
    if (terminator.kind is .branch_term(branch_term)) {
        if (index == 0) { return branch_term.then_target; }
        return branch_term.else_target;
    }
    if (terminator.kind is .switch_term(switch_term)) {
        if (index < switch_term.cases.length) {
            return switch_term.cases[index].target;
        }
        return switch_term.default_target;
    }
    if (terminator.kind is .call_term(call_term)) {
        if (index == 0) { return call_term.target; }
        return call_term.cleanup$.some();
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (index == 0) { return drop_term.target; }
        return drop_term.cleanup$.some();
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (index == 0) { return assert_term.target; }
        return assert_term.cleanup$.some();
    }
    return MirBlockId(0);
}

public struct MirPlace {
    public MirLocalId local_id;
    public MirPlaceElem[] projection;
}

public union MirPlaceElem {
    MirDerefProjection deref_projection;
    MirFieldProjection field_projection;
    MirIndexProjection index_projection;
    MirConstantIndexProjection constant_index_projection;
    MirSubsliceProjection subslice_projection;
}

public MirPlaceElem deref_projection_elem(MirDerefProjection projection) {
    return .deref_projection(projection);
}

public MirPlaceElem field_projection_elem(MirFieldProjection projection) {
    return .field_projection(projection);
}

public MirPlaceElem index_projection_elem(MirIndexProjection projection) {
    return .index_projection(projection);
}

public MirPlaceElem constant_index_projection_elem(MirConstantIndexProjection projection) {
    return .constant_index_projection(projection);
}

public MirPlaceElem subslice_projection_elem(MirSubsliceProjection projection) {
    return .subslice_projection(projection);
}

public struct MirDerefProjection {
    public Bool raw_pointer;
}

public struct MirFieldProjection {
    public qid.DefId field_def;
    public qid.TypeId field_type;
    public Int field_index;
}

public struct MirIndexProjection {
    // 为了避免 place/operand 递归过深，index 先要求是 local。
    public MirLocalId index_local;
}

public struct MirConstantIndexProjection {
    public Int offset;
}

public struct MirSubsliceProjection {
    public Int from;
    public Int to;
}

public union MirOperand {
    MirCopyOperand copy_operand;
    MirMoveOperand move_operand;
    MirFunctionRef function_operand;
    MirGlobalRef global_operand;
    MirConst const_operand;
}

public MirOperand copy_operand_value(MirCopyOperand operand) {
    return .copy_operand(operand);
}

public MirOperand move_operand_value(MirMoveOperand operand) {
    return .move_operand(operand);
}

public MirOperand function_operand_value(MirFunctionRef operand) {
    return .function_operand(operand);
}

public MirOperand global_operand_value(MirGlobalRef operand) {
    return .global_operand(operand);
}

public MirOperand const_operand_value(MirConst constant) {
    return .const_operand(constant);
}

public struct MirCopyOperand {
    public MirPlace place;
}

public struct MirMoveOperand {
    public MirPlace place;
}

public struct MirConst {
    public qid.TypeId type_id;
    public token.Span span;
    public MirConstValue value;
}

public struct MirFunctionRef {
    public qid.DefId function_def;
    public qid.TypeId[] type_args;
    public qid.TypeId type_id;
    public token.Span span;
}

public struct MirGlobalRef {
    public qid.DefId global_def;
    public qid.TypeId type_id;
    public token.Span span;
}

public union MirConstValue {
    public MirBoolConst bool_value;
    public MirIntConst int_value;
    public MirFloatConst float_value;
    public MirStringConst string_value;
    public MirNullConst null_value;
    public MirUnitConst unit_value;
}

public struct MirBoolConst {
    public Bool value;
}

public struct MirIntConst {
    public UInt64 bits;
    public Bool signed_value;
}

public struct MirFloatConst {
    public Float64 value;
}

public struct MirStringConst {
    public qid.SymbolId symbol_id;
    public Bool nul_terminated;
}

public struct MirNullConst {
    public Bool typed_null;
}

public struct MirUnitConst {
    public Bool unit_value;
}

public MirBoolConst? bool_const_value(MirConstValue value) {
    if (value is .bool_value(bool_value)) { return bool_value; }
    return null;
}

public MirIntConst? int_const_value(MirConstValue value) {
    if (value is .int_value(int_value)) { return int_value; }
    return null;
}

public MirFloatConst? float_const_value(MirConstValue value) {
    if (value is .float_value(float_value)) { return float_value; }
    return null;
}

public MirStringConst? string_const_value(MirConstValue value) {
    if (value is .string_value(string_value)) { return string_value; }
    return null;
}

public MirConstValue bool_const_kind(MirBoolConst value) {
    return .bool_value(value);
}

public MirConstValue int_const_kind(MirIntConst value) {
    return .int_value(value);
}

public MirConstValue float_const_kind(MirFloatConst value) {
    return .float_value(value);
}

public MirConstValue string_const_kind(MirStringConst value) {
