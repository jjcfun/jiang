public Bool is_unit_const_value(MirConstValue value) {
    return value is .unit_value(_);
}

public Bool is_null_const_value(MirConstValue value) {
    return value is .null_value(_);
}

public union MirRvalue {
    MirUseRvalue use_value;
    MirUnaryRvalue unary_value;
    MirBinaryRvalue binary_value;
    MirCastRvalue cast_value;
    MirBorrowRvalue borrow_value;
    MirAddressOfRvalue address_of_value;
    MirAllocValueRvalue alloc_value;
    MirAllocArrayRvalue alloc_array_value;
    MirFreeRvalue free_value;
    MirSliceRvalue slice_value;
    MirLenRvalue len_value;
    MirDiscriminantRvalue discriminant_value;
    MirAggregateRvalue aggregate_value;
    MirOptionalRvalue optional_value;
    MirErrorUnionRvalue error_union_value;
}

public MirRvalue use_rvalue(MirUseRvalue value) {
    return .use_value(value);
}

public MirRvalue unary_rvalue(MirUnaryRvalue value) {
