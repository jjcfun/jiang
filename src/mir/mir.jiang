    // 完成字同时发布 readiness 与结果是否存在，释放路径无需第二个原子标记。
    public MirPlace state;
    public MirPlace result;
    public MirFunctionRef result_drop;
    public Bool result_consumed;
    public MirTaskStoragePlan storage;
}

