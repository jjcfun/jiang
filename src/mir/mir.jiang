public struct MirTaskAbiLayout: Copyable {
    public qid.TypeId task_type_id;
    public qid.TypeId task_state_type_id;
    public qid.TypeId task_state_pointer_type_id;
    public qid.TypeId result_type_id;
    public qid.TypeId frame_pointer_type_id;
    public qid.TypeId resume_return_type_id;
    public qid.TypeId resume_function_type_id;
    public MirTaskWaiterLayout waiter_layout;
    public MirSuspendContinuationLayout suspend_layout;
    public qid.TypeId blocking_ack_pointer_type_id;
    public qid.TypeId bool_type_id;
    // 0 running，1 completed-with-result，3 completed-without-result；其余值为 waiter 指针，
    // 低位 0 表示 async waiter record，低位 1 表示 blocking ack word。
    public MirSyntheticField state_field;
    public MirSyntheticField frame_field;
    public MirSyntheticField resume_function_field;
    public MirSyntheticField execution_executor_field;
    public MirSyntheticField result_field;
    public MirSyntheticField cancellation_requested_field;
    // Pointer-sized atomic word: 0 inactive, 1 handler, 2 claimed, 3 passive suspend, otherwise TaskState*.
    public MirSyntheticField cancel_target_word_field;
    // 0 stack, 1 heap-running+owner, 2 heap-completed+owner,
    // 3 heap-running-ownerless, 4 heap-consumed+owner, 5 cleanup claimed.
    public MirSyntheticField lifetime_state_field;
    public MirSyntheticField cleanup_function_field;
    public MirSyntheticField schedule_state_field;
    public MirSyntheticField schedule_executor_field;
    public MirSyntheticField schedule_context_field;
    public MirSyntheticField schedule_resume_field;
    public MirSyntheticField schedule_active_executor_field;
}

