// Facade for HIR to MIR lowering.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import source_map = "../source/source_map.jiang";
import store = "../resolve/store.jiang";
import monomorph = "../sema/monomorph.jiang";
import sema_result = "../sema/result.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    hir_store.HirStore& hir_store,
    sema_result.TypeCheckResults& typeck,
    monomorph.MonomorphInstances& instances,
    module_graph.ModuleGraph& graph
) {
    mir.MirStore^ output = new mir.MirStore(hir_store.ok && typeck.ok);
    if (hir_store.has_errors() || typeck.has_errors()) {
        return output$.move();
    }

    MirLowerer! lowerer = MirLowerer(ctx, hir_store, typeck, instances, graph, output$.ref());
    lowerer.lower_package();
    return output$.move();
}

struct MirLowerer: Movable {
    context.CompilerContext& ctx;
    hir_store.HirStore& hirs;
    sema_result.TypeCheckResults& typeck;
    monomorph.MonomorphInstances& instances;
    module_graph.ModuleGraph& graph;
    mir.MirStore& output;

    public init(
        context.CompilerContext& ctx,
        hir_store.HirStore& hirs,
        sema_result.TypeCheckResults& typeck,
        monomorph.MonomorphInstances& instances,
        module_graph.ModuleGraph& graph,
        mir.MirStore& output
    ) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.output = output;
    }

    public () lower_package() {
        // MIR 调度从 module graph + HIR ownership tree 派生：graph 给出本次
        // 编译的 root/import closure，module HirDef.members 给出当前
        // module 的顶层声明集合。泛型模板本身不生成 MIR；后面按
        // MonomorphInstances 为每个 concrete type args 生成独立函数体。
        Int! module_index = 0;
        while (module_index < self.graph.modules.len()) {
            store.ModuleRecord module = self.ctx.query.resolve.modules.get(self.graph.modules.get(module_index));
            self.lower_def_tree(module.def_id);
            module_index = module_index + 1;
        }
        self.lower_instances();
        self.ensure_custom_deinit_instances();
        self.lower_runtime_entry();
    }

    () lower_def_tree(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else {
            return;
        }
        if (self.is_lowerable_function_decl(hir_def.decl.kind)) {
            if (hir_def.body != null && self.generic_param_count(hir_def) == 0) {
                self.lower_function(hir_def);
            } else if (self.is_external_function_decl(hir_def)) {
                self.lower_external_function(hir_def);
            }
        }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.lower_def_tree(hir_def.members.get(index));
            index = index + 1;
        }
    }

    () lower_function(hir.HirDef& hir_def) {
        monomorph.SubstitutionMap! empty = monomorph.SubstitutionMap();
        self.lower_function_with_substitution(hir_def, empty$.ref(), self.output.empty_type_args());
    }

    Bool is_lowerable_function_decl(hir.HirDeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    Bool is_external_function_decl(hir.HirDef& hir_def) {
        if (hir_def.body != null || self.generic_param_count(hir_def) != 0) {
            return false;
        }
        guard self.ctx.query.defs.get(hir_def.def_id).owner_def is some owner_def else {
            return false;
        }
        def.DefKind owner_kind = self.ctx.query.defs.get(owner_def).kind;
        if (owner_kind == .module_def) { return true; }
        return owner_kind == .package_def;
    }

    // 第二阶段 lower concrete generic instances。它们不会出现在 HIR ownership
    // tree 里，只存在于 MonomorphInstances 中。
    () lower_instances() {
        Int! index = 0;
        while (index < self.instances.len()) {
            self.lower_instance(self.instances.get(index));
            index = index + 1;
        }
    }

    () lower_instance(monomorph.InstanceKey instance) {
        if (monomorph.instance_kind(self.ctx.query$.ref(), instance) != .function_body) {
            return;
        }
        if (!self.type_args_are_concrete(instance.type_args)) {
            return;
        }
        if (self.output.function_id_for_instance(instance.def_id, instance.type_args) != null) {
            return;
        }
        guard self.hirs.def(instance.def_id) is some hir_def else {
            return;
        }
        if (hir_def.body == null) {
            return;
        }
        // instance.type_args 先绑定到泛型参数 DefId，body lowering 后续所有
        // 类型读取都通过 substitutions 转成 concrete TypeId。
        monomorph.SubstitutionMap substitutions = monomorph.build_substitution(
            self.ctx.query$.ref(),
            hir_def,
            instance
        );
        self.lower_function_with_substitution(hir_def, substitutions$.ref(), instance.type_args);
    }

    () lower_function_with_substitution(
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        qid.TypeId[] type_args
    ) {
        Int function_index = self.output.functions.len();
        // HIR 不再直接携带 span；诊断位置后续通过 SourceMap 查询。
        token.Span span = self.def_span(hir_def.def_id);
        BodyLowerer! body_lowerer = BodyLowerer(
            self$.ref(),
            mir.MirBodyId.from_index(function_index),
            hir_def,
            substitutions,
            span
        );
        mir.MirBody mir_body = body_lowerer.lower();
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: hir_def.def_id,
            type_args: self.output.type_arg_array(type_args),
            signature_id: null,
            is_runtime_entry: false,
            is_external: false,
            span: span,
            body: mir_body
        });
    }

    () lower_external_function(hir.HirDef& hir_def) {
        if (self.output.function_id_for_def(hir_def.def_id) != null) {
            return;
        }
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(hir_def.def_id);
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: hir_def.def_id,
            type_args: self.output.empty_type_args(),
            signature_id: null,
            is_runtime_entry: false,
            is_external: true,
            span: span,
            body: self.external_function_body(mir.MirBodyId.from_index(function_index), hir_def, span)
        });
    }

    () ensure_external_function(qid.DefId function_def) {
        if (self.output.function_id_for_def(function_def) != null) {
            return;
        }
        if (self.hirs.def(function_def) is some hir_def) {
            if (hir_def.body != null) { return; }
        }
        self.lower_external_function_def(function_def);
    }

    () ensure_function_instance(qid.DefId function_def, qid.TypeId[] type_args) {
        if (type_args.length == 0) {
            return;
        }
        if (!self.type_args_are_concrete(type_args)) {
            return;
        }
        if (self.output.function_id_for_instance(function_def, type_args) != null) {
            return;
        }
        self.lower_instance(monomorph.InstanceKey(function_def, type_args));
    }

    Bool type_args_are_concrete(qid.TypeId[] type_args) {
        Int! index = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(type_args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_concrete(qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.query.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.ctx.query.defs.get(named.def_id).kind == .generic_param_def) {
                return false;
            }
            return self.type_args_are_concrete(named.args);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(handle.element);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(optional.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(tuple_type.items);
        }
        return true;
    }

    () ensure_custom_deinit_instances() {
        // drop elaboration 会把 concrete nominal local/field 改写成 deinit 调用。
        // 这些调用目标必须在 MIR 阶段就补齐，backend 只能消费完整 MIR。
        Int! function_index = 0;
        while (function_index < self.output.functions.len()) {
            mir.MirFunction function = self.output.functions.get(function_index);
            self.ensure_custom_deinit_instances_for_body(function.body);
            function_index = function_index + 1;
        }
    }

    () ensure_custom_deinit_instances_for_body(mir.MirBody body) {
        Int! local_index = 0;
        while (local_index < body.locals.length) {
            self.ensure_custom_deinit_instance_for_type(body.locals[local_index].type_id);
            local_index = local_index + 1;
        }
    }

    () ensure_custom_deinit_instance_for_type(qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.query.types.get(type_id);
        if (info.data is .named(named)) {
            self.ensure_custom_deinit_instance_for_named(named);
            self.ensure_custom_deinit_instances_for_type_args(named.args);
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.ensure_custom_deinit_instance_for_type(handle.element);
            return;
        }
        if (info.data is .optional(optional)) {
            self.ensure_custom_deinit_instance_for_type(optional.element);
            return;
        }
        if (info.data is .array_type(array_type)) {
            self.ensure_custom_deinit_instance_for_type(array_type.element);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.ensure_custom_deinit_instances_for_type_args(tuple_type.items);
        }
    }

    () ensure_custom_deinit_instances_for_type_args(qid.TypeId[] type_args) {
        Int! index = 0;
        while (index < type_args.length) {
            self.ensure_custom_deinit_instance_for_type(type_args[index]);
            index = index + 1;
        }
    }

    () ensure_custom_deinit_instance_for_named(types.NamedType named) {
        if (named.args.length == 0 || !self.type_args_are_concrete(named.args)) {
            return;
        }
        guard self.hirs.def(named.def_id) is some hir_def else {
            return;
        }
        guard hir_def.custom_deinit_def is some deinit_def else {
            return;
        }
        self.ensure_function_instance(deinit_def, named.args);
    }

    () lower_external_function_def(qid.DefId function_def) {
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(function_def);
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: function_def,
            type_args: self.output.empty_type_args(),
            signature_id: null,
            is_runtime_entry: false,
            is_external: true,
            span: span,
            body: self.external_function_body_for_def(mir.MirBodyId.from_index(function_index), function_def, span)
        });
    }

    () lower_runtime_entry() {
        guard self.language_main_def() is some main_def else { return; }
        if (self.output.function_id_for_def(main_def) == null) { return; }
        self.add_runtime_entry_for_main(main_def);
    }

    qid.DefId? language_main_def() {
        Int! module_index = 0;
        while (module_index < self.graph.modules.len()) {
            store.ModuleRecord module = self.ctx.query.resolve.modules.get(self.graph.modules.get(module_index));
            if (self.main_member_def(module.def_id) is some main_def) { return main_def; }
            module_index = module_index + 1;
        }
        return null;
    }

    qid.DefId? main_member_def(qid.DefId owner_def) {
        guard self.hirs.def(owner_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.def_is_language_main(member_def)) { return member_def; }
            index = index + 1;
        }
        return null;
    }

    Bool def_is_language_main(qid.DefId def_id) {
        if (self.ctx.query.defs.get(def_id).kind != .function_def) { return false; }
        qid.SymbolId symbol_id = self.ctx.query.defs.get(def_id).name.symbol;
        return string.equal(self.ctx.query.symbols.text(symbol_id), "main");
    }

    () add_runtime_entry_for_main(qid.DefId main_def) {
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(main_def);
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: main_def,
            type_args: self.output.empty_type_args(),
            signature_id: null,
            is_runtime_entry: true,
            is_external: false,
            span: span,
            body: self.runtime_entry_body(mir.MirBodyId.from_index(function_index), main_def, span)
        });
    }

    mir.MirBody external_function_body(mir.MirBodyId body_id, hir.HirDef& hir_def, token.Span span) {
        return self.external_function_body_for_def(body_id, hir_def.def_id, span);
    }

    mir.MirBody external_function_body_for_def(mir.MirBodyId body_id, qid.DefId function_def, token.Span span) {
        qid.TypeId! function_type_id = self.ctx.query.types.invalid_type();
        if (self.typeck.def_type(function_def) is some type_id) {
            function_type_id = type_id;
        }
        types.TypeInfo info = self.ctx.query.types.get(function_type_id);
        guard info.data is .function_type(function_type) else {
            return self.empty_external_body(body_id, span);
        }

        Int local_count = function_type.params.length + 1;
        mir.MirLocalDecl![*] locals = self.output.alloc_local_array(local_count);
        locals[0] = self.runtime_local(mir.MirLocalId.from_index(0), .return_place, function_type.result, span);
        Int! index = 0;
        while (index < function_type.params.length) {
            locals[index + 1] = self.runtime_local(
                mir.MirLocalId.from_index(index + 1),
                .param,
                function_type.params[index],
                span
            );
            index = index + 1;
        }
        return mir.MirBody {
            id: body_id,
            span: span,
            locals: locals[0..local_count],
            blocks: self.output.empty_blocks(),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        };
    }

    mir.MirBody empty_external_body(mir.MirBodyId body_id, token.Span span) {
        mir.MirLocalDecl![*] locals = self.output.alloc_local_array(1);
        locals[0] = self.runtime_local(
            mir.MirLocalId.from_index(0),
            .return_place,
            self.ctx.query.types.unit_type(),
            span
        );
        return mir.MirBody {
            id: body_id,
            span: span,
            locals: locals[0..1],
            blocks: self.output.empty_blocks(),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        };
    }

    mir.MirBody runtime_entry_body(mir.MirBodyId body_id, qid.DefId main_def, token.Span span) {
        qid.TypeId int_type = self.ctx.query.types.int_type();
        qid.TypeId main_type = self.typeck.def_type(main_def)$.some();
        qid.TypeId main_result_type = self.function_result_type(main_type);

        mir.MirLocalDecl![*] locals = self.output.alloc_local_array(2);
        locals[0] = self.runtime_local(mir.MirLocalId.from_index(0), .return_place, int_type, span);
        locals[1] = self.runtime_local(mir.MirLocalId.from_index(1), .compiler_temp, main_result_type, span);

        list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>(2);
        blocks.add(self.runtime_call_main_block(main_def, main_type, span));
        blocks.add(self.runtime_return_zero_block(span));
        return mir.MirBody {
            id: body_id,
            span: span,
            locals: locals[0..2],
            blocks: self.output.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        };
    }

    qid.TypeId function_result_type(qid.TypeId callee_type) {
        types.TypeInfo info = self.ctx.query.types.get(callee_type);
        if (info.data is .function_type(function_info)) {
            return function_info.result;
        }
        return self.ctx.query.types.unit_type();
    }

    mir.MirLocalDecl runtime_local(
        mir.MirLocalId id,
        mir.MirLocalKind kind,
        qid.TypeId type_id,
        token.Span span
    ) {
        return mir.MirLocalDecl {
            id: id,
            kind: kind,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        };
    }

    mir.MirBlock runtime_call_main_block(qid.DefId main_def, qid.TypeId main_type, token.Span span) {
        list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>();
        return mir.MirBlock {
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.output.empty_statements(),
            terminator: mir.MirTerminator {
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator {
                    callee: self.runtime_main_callee(main_def, main_type, span),
                    args: self.output.operand_array(args$.ref()),
                    destination: self.runtime_place(mir.MirLocalId.from_index(1)),
                    target: mir.MirBlockId.from_index(1),
                    cleanup: null
                })
            }
        };
    }

    mir.MirOperand runtime_main_callee(qid.DefId main_def, qid.TypeId main_type, token.Span span) {
        return mir.const_operand_value(mir.MirConst {
            type_id: main_type,
            span: span,
            value: mir.function_const_kind(mir.MirFunctionConst {
                function_def: main_def,
                type_args: self.output.empty_type_args()
            })
        });
    }

    mir.MirBlock runtime_return_zero_block(token.Span span) {
        list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>(1);
        statements.add(mir.MirStatement {
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement {
                destination: self.runtime_place(mir.MirLocalId.from_index(0)),
                value: mir.use_rvalue(mir.MirUseRvalue {
                    value: mir.const_operand_value(mir.MirConst {
                        type_id: self.ctx.query.types.int_type(),
                        span: span,
                        value: mir.int_const_kind(mir.MirIntConst {bits: 0, signed_value: true})
                    })
                })
            })
        });
        return mir.MirBlock {
            id: mir.MirBlockId.from_index(1),
            span: span,
            statements: self.output.statement_array(statements$.ref()),
            terminator: mir.MirTerminator {
                span: span,
                kind: mir.return_terminator_kind(mir.MirReturnTerminator {implicit_unit: false})
            }
        };
    }

    mir.MirPlace runtime_place(mir.MirLocalId local_id) {
        return mir.MirPlace {
            local_id: local_id,
            projection: self.output.empty_projection()
        };
    }

    Int generic_param_count(hir.HirDef& hir_def) {
        Int! count = 0;
        if (self.ctx.query.defs.get(hir_def.def_id).owner_def is some owner_def) {
            count = count + self.generic_param_count_for_def(owner_def);
        }
        return count + self.generic_param_count_for_def(hir_def.def_id);
    }

    Int generic_param_count_for_def(qid.DefId def_id) {
        hir.HirDef& hir_def = self.hirs.def_ref(def_id);
        Int! count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    () add_initial_locals(
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        list.ArrayList<mir.MirLocalDecl>& locals
    ) {
        locals.add(mir.MirLocalDecl {
            id: mir.MirLocalId.from_index(0),
            kind: mir.MirLocalKind.return_place,
            type_id: self.return_type(hir_def, substitutions),
            span: self.def_span(hir_def.def_id),
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        });
        guard hir_def.body is some body else {
            return;
        }
        Int! index = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            locals.add(self.lower_local(local, substitutions, index + 1));
            index = index + 1;
        }
    }

    mir.MirLocalDecl lower_local(
        hir.HirLocal local,
        monomorph.SubstitutionMap& substitutions,
        Int mir_index
    ) {
        qid.TypeId type_id = self.type_for_local(local, substitutions);
        return mir.MirLocalDecl {
            id: mir.MirLocalId.from_index(mir_index),
            kind: self.local_kind(local.kind),
            type_id: type_id,
            span: self.def_span(local.def_id),
            name: local.symbol,
            def_id: local.def_id,
            mutable_local: self.ctx.query.types.get(type_id).is_mutable,
            address_taken: false
        };
    }

    qid.TypeId type_for_local(hir.HirLocal local, monomorph.SubstitutionMap& substitutions) {
        if (self.typeck.def_type(local.def_id) is some type_id) {
            return self.substitute_type(type_id, substitutions);
        }
        return self.ctx.query.types.invalid_type();
    }

    mir.MirLocalKind local_kind(hir.HirLocalKind kind) {
        if (kind == .parameter) { return mir.MirLocalKind.param; }
        return mir.MirLocalKind.user_local;
    }

    qid.TypeId return_type(hir.HirDef& hir_def, monomorph.SubstitutionMap& substitutions) {
        if (self.typeck.def_type(hir_def.def_id) is some function_type_id) {
            qid.TypeId substituted = self.substitute_type(function_type_id, substitutions);
            if (self.ctx.query.types.get(substituted).data is .function_type(function_type)) {
                return function_type.result;
            }
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId substitute_type(qid.TypeId type_id, monomorph.SubstitutionMap& substitutions) {
        if (substitutions.len() == 0) {
            return type_id;
        }
        // TypeCheckResults 保存的是泛型模板视角的 TypeId；具体实例的 MIR
        // local/const/temp 必须在这里替换成 concrete TypeId。
        return monomorph.substitute_type(self.ctx.query$.ref(), type_id, substitutions);
    }

    token.Span def_span(qid.DefId def_id) {
        if (self.ctx.query.source_map.def_span(def_id) is some loc) {
            return loc.span;
        }
        return token.Span();
    }

    token.Span hir_span(hir.HirId hir_id) {
        if (self.ctx.query.source_map.hir_span(hir_id) is some loc) {
            return loc.span;
        }
        return token.Span();
    }
}

struct LoopTargets {
    mir.MirBlockId continue_target;
    mir.MirBlockId break_target;
    Int active_depth;
    Int defer_depth;
}

struct SwitchPayloadEntry {
    hir.HirId pattern_id;
    mir.MirBlockId entry_block;
    mir.MirBlockId body_block;
}

struct IfConditionLowerResult {
    mir.MirOperand condition;
    hir.HirId? pattern_id;
    mir.MirPlace? subject_place;
    qid.TypeId subject_type;
}

// BodyLowerer 负责把单个 HIR function body 转成 MIR CFG。
// block id 先预留再回填，保证 branch/call 提前引用目标 block 时，
// `MirBlockId.index` 仍然等于 `MirBody.blocks[index]`。
struct BodyLowerer: Movable {
    MirLowerer& lowerer;
    mir.MirBodyId body_id;
    hir.HirDef& hir_def;
    monomorph.SubstitutionMap& substitutions;
    token.Span span;
    list.ArrayList<mir.MirLocalDecl>! locals;
    list.ArrayList<mir.MirBlock>! blocks;
    list.ArrayList<mir.MirStatement>! statements;
    list.ArrayList<LoopTargets>! loop_targets;
    list.ArrayList<mir.MirLocalId>! active_locals;
    list.ArrayList<hir.HirId>! active_defers;
    mir.MirBlockId! current_block;
    Bool! terminated;

    public init(
        MirLowerer& lowerer,
        mir.MirBodyId body_id,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        token.Span span
    ) {
        self.lowerer = lowerer;
        self.body_id = body_id;
        self.hir_def = hir_def;
        self.substitutions = substitutions;
        self.span = span;
        self.locals = list.ArrayList<mir.MirLocalDecl>();
        self.blocks = list.ArrayList<mir.MirBlock>();
        self.statements = list.ArrayList<mir.MirStatement>();
        self.loop_targets = list.ArrayList<LoopTargets>();
        self.active_locals = list.ArrayList<mir.MirLocalId>();
        self.active_defers = list.ArrayList<hir.HirId>();
        self.current_block = self.reserve_block(span);
        self.terminated = false;
        self.lowerer.add_initial_locals(hir_def, substitutions, self.locals$.ref());
    }

    mir.MirBody lower() {
        if (self.hir_def.body is some body) {
            self.lower_root(body.root);
        }
        if (!self.terminated) {
            self.finish_block(mir.return_terminator_kind(mir.MirReturnTerminator {implicit_unit: true}), self.span);
        }
        return mir.MirBody {
            id: self.body_id,
            span: self.span,
            locals: self.freeze_locals(),
            blocks: self.lowerer.output.block_array(self.blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: self.return_local()
        };
    }

    () lower_root(hir.HirId root) {
        hir.HirNode node = self.lowerer.hirs.node(root);
        if (node.data is .block(block)) {
            self.lower_root_block(block);
            return;
        }
        self.assign_return_value(root);
        if (!self.terminated) {
            self.finish_return(false, self.lowerer.hir_span(root));
        }
    }

    () lower_root_block(hir.HirBlock block) {
        list.ArrayList<mir.MirLocalId>! scope_locals = list.ArrayList<mir.MirLocalId>();
        Int defer_depth = self.active_defers.len();
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.terminated) { return; }
            if (self.lower_statement_node(block.statements[index]) is some local_id) {
                scope_locals.add(local_id);
            }
            index = index + 1;
        }
        if (self.terminated) { return; }
        if (block.result is some result) {
            self.assign_return_value(result);
            if (!self.terminated) {
                self.run_deferred_from(defer_depth, self.lowerer.hir_span(result));
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
                self.finish_return(false, self.lowerer.hir_span(result));
            }
            return;
        }
        self.run_deferred_from(defer_depth, self.span);
        self.end_scope(scope_locals$.ref(), self.span);
        self.finish_unit_return(self.span);
    }

    mir.MirLocalId? lower_statement_node(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .let_stmt(let_stmt)) {
            return self.lower_let(node_id, let_stmt);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.lower_defer(defer_stmt);
            return null;
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            self.lower_guard(node_id, guard_stmt);
            return null;
        }
        if (node.data is .return_stmt(return_stmt)) {
            self.lower_return(node_id, return_stmt);
            return null;
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            self.lower_throw(node_id, throw_stmt);
            return null;
        }
        if (node.data is .break_stmt) {
            self.lower_break(node_id);
            return null;
        }
        if (node.data is .continue_stmt) {
            self.lower_continue(node_id);
            return null;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.lower_assign(node_id, assign_stmt);
            return null;
        }
        if (self.is_expr_statement(node)) {
            self.lower_expr_statement(node_id);
            return null;
        }
        self.mark_unsupported(node_id);
        return null;
    }

    Bool is_expr_statement(hir.HirNode node) {
        if (node.data is .block(_)) { return true; }
        if (node.data is .name_ref(_)) { return true; }
        if (node.data is .member_access(_)) { return true; }
        if (node.data is .index_access(_)) { return true; }
        if (node.data is .slice_access(_)) { return true; }
        if (node.data is .call(_)) { return true; }
        if (node.data is .implicit_call(_)) { return true; }
        if (node.data is .literal(_)) { return true; }
        if (node.data is .unary(_)) { return true; }
        if (node.data is .binary(_)) { return true; }
        if (node.data is .if_expr(_)) { return true; }
        if (node.data is .loop_expr(_)) { return true; }
        if (node.data is .switch_expr(_)) { return true; }
        if (node.data is .catch_expr(_)) { return true; }
        return false;
    }

    () lower_expr_statement(hir.HirId node_id) {
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
    }

    () lower_defer(hir.HirDefer defer_stmt) {
        self.active_defers.add(defer_stmt.body);
    }

    mir.MirLocalId lower_let(hir.HirId node_id, hir.HirLet let_stmt) {
        mir.MirLocalId local_id = self.mir_local_for_hir(let_stmt.local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(node_id));
        if (let_stmt.initializer is some initializer) {
            self.lower_into_place(initializer, self.place_for_local(local_id));
        }
        return local_id;
    }

    () lower_return(hir.HirId node_id, hir.HirReturn return_stmt) {
        if (return_stmt.value is some value) {
            self.assign_return_value(value);
            if (self.terminated) { return; }
            self.run_deferred_from(0, self.lowerer.hir_span(node_id));
            self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
            self.finish_return(false, self.lowerer.hir_span(node_id));
            return;
        }
        self.run_deferred_from(0, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
        self.finish_unit_return(self.lowerer.hir_span(node_id));
    }

    () finish_unit_return(token.Span span) {
        if (self.return_type_is_error_union()) {
            self.assign_return_unit(span);
            self.finish_return(false, span);
            return;
        }
        self.finish_return(true, span);
    }

    () assign_return_unit(token.Span span) {
        self.push_assign(
            self.place_for_local(self.return_local()),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.make_value,
                value: mir.const_operand_value(mir.MirConst {
                    type_id: self.lowerer.ctx.query.types.unit_type(),
                    span: span,
                    value: mir.unit_const_kind(mir.MirUnitConst {unit_value: true})
                })
            }),
            span
        );
    }

    () assign_return_value(hir.HirId value) {
        mir.MirPlace destination = self.place_for_local(self.return_local());
        if (self.return_type_is_error_union()) {
            self.push_assign(
                destination,
                mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                    op: mir.MirErrorUnionOp.make_value,
                    value: self.lower_to_operand(value)
                }),
                self.lowerer.hir_span(value)
            );
            return;
        }
        self.lower_into_place(value, destination);
    }

    Bool return_type_is_error_union() {
        qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
        types.TypeInfo info = self.lowerer.ctx.query.types.get(return_type);
        return info.data is .error_union(_);
    }

    () lower_throw(hir.HirId node_id, hir.HirThrow throw_stmt) {
        self.push_assign(
            self.place_for_local(self.return_local()),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.make_error,
                value: self.lower_to_operand(throw_stmt.value)
            }),
            self.lowerer.hir_span(node_id)
        );
        if (self.terminated) { return; }
        self.run_deferred_from(0, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
        self.finish_return(false, self.lowerer.hir_span(node_id));
    }

    () lower_assign(hir.HirId node_id, hir.HirAssign assign_stmt) {
        guard self.place_for_expr(assign_stmt.target) is some destination else {
            self.mark_unsupported(assign_stmt.target);
            return;
        }
        if (assign_stmt.op == .assign) {
            self.lower_into_place(assign_stmt.value, destination);
            return;
        }
        guard self.binary_op_for_assign(assign_stmt.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirOperand lhs = self.lower_to_operand(assign_stmt.target);
        mir.MirOperand rhs = self.lower_to_operand(assign_stmt.value);
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue {op: op, lhs: lhs, rhs: rhs}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_into_place(hir.HirId node_id, mir.MirPlace destination) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .block(block)) {
            self.lower_block_into_place(block, destination);
            return;
        }
        if (node.data is .call(call)) {
            self.lower_call(node_id, call, destination);
            return;
        }
        if (node.data is .implicit_call(implicit_call)) {
            self.lower_implicit_call(node_id, implicit_call, destination);
            return;
        }
        if (node.data is .member_access(member_access)) {
            self.lower_member_access(node_id, member_access, destination);
            return;
        }
        if (node.data is .slice_access(slice_access)) {
            self.lower_slice(node_id, slice_access, destination);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.lower_struct_literal(node_id, struct_literal, destination);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.lower_tuple_literal(node_id, tuple_literal, destination);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.lower_array_literal(node_id, array_literal, destination);
            return;
        }
        if (node.data is .if_expr(if_expr)) {
            self.lower_if(node_id, if_expr, destination);
            return;
        }
        if (node.data is .loop_expr(loop_expr)) {
            self.lower_loop(node_id, loop_expr, destination);
            return;
        }
        if (node.data is .switch_expr(switch_expr)) {
            self.lower_switch(node_id, switch_expr, destination);
            return;
        }
        if (node.data is .catch_expr(catch_expr)) {
            self.lower_catch(node_id, catch_expr, destination);
            return;
        }
        if (node.data is .is_pattern(is_pattern)) {
            self.lower_is_pattern_into_place(node_id, is_pattern, destination);
            return;
        }
        if (node.data is .unary(unary)) {
            self.lower_unary(node_id, unary, destination);
            return;
        }
        if (node.data is .binary(binary)) {
            self.lower_binary(node_id, binary, destination);
            return;
        }
        mir.MirOperand value = self.lower_operand(node_id);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue {value: value}), self.lowerer.hir_span(node_id));
    }

    () lower_block_into_place(hir.HirBlock block, mir.MirPlace destination) {
        list.ArrayList<mir.MirLocalId>! scope_locals = list.ArrayList<mir.MirLocalId>();
        Int defer_depth = self.active_defers.len();
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.terminated) { return; }
            if (self.lower_statement_node(block.statements[index]) is some local_id) {
                scope_locals.add(local_id);
            }
            index = index + 1;
        }
        if (self.terminated) { return; }
        if (block.result is some result) {
            self.lower_into_place(result, destination);
            if (!self.terminated) {
                self.run_deferred_from(defer_depth, self.lowerer.hir_span(result));
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
            }
            return;
        }
        self.push_assign(destination, self.unit_rvalue(token.Span()), token.Span());
        self.run_deferred_from(defer_depth, token.Span());
        self.end_scope(scope_locals$.ref(), token.Span());
    }

    () lower_if(hir.HirId node_id, hir.HirIf if_expr, mir.MirPlace destination) {
        list.ArrayList<mir.MirLocalId>! condition_locals = list.ArrayList<mir.MirLocalId>();
        IfConditionLowerResult condition_result = self.lower_if_condition(if_expr.condition);
        mir.MirBlockId then_block = self.reserve_block(self.lowerer.hir_span(if_expr.then_body));
        mir.MirBlockId else_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: condition_result.condition,
            then_target: then_block,
            else_target: else_block
        }), self.lowerer.hir_span(if_expr.condition));

        Int active_depth = self.active_locals.len();
        self.start_block(then_block);
        self.lower_if_condition_bindings(condition_result, condition_locals$.ref());
        self.lower_into_place(if_expr.then_body, destination);
        if (!self.terminated) {
            self.end_scope(condition_locals$.ref(), self.lowerer.hir_span(if_expr.then_body));
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: join_block}), self.lowerer.hir_span(node_id));
        }
        self.restore_active_locals(active_depth);

        self.start_block(else_block);
        if (if_expr.else_body is some else_body) {
            self.lower_into_place(else_body, destination);
        } else {
            self.push_assign(
                destination,
                self.unit_rvalue(self.lowerer.hir_span(node_id)),
                self.lowerer.hir_span(node_id)
            );
        }
        if (!self.terminated) {
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: join_block}), self.lowerer.hir_span(node_id));
        }
        self.restore_active_locals(active_depth);

        self.start_block(join_block);
    }

    () lower_guard(hir.HirId node_id, hir.HirGuard guard_stmt) {
        IfConditionLowerResult condition = self.lower_if_condition(guard_stmt.condition);
        mir.MirBlockId continue_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId else_block = self.reserve_block(self.lowerer.hir_span(guard_stmt.else_body));
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: condition.condition,
            then_target: continue_block,
            else_target: else_block
        }), self.lowerer.hir_span(guard_stmt.condition));

        self.start_block(else_block);
        self.lower_expr_statement(guard_stmt.else_body);
        if (!self.terminated) {
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: continue_block}), self.lowerer.hir_span(node_id));
        }

        self.start_block(continue_block);
        list.ArrayList<mir.MirLocalId>! condition_locals = list.ArrayList<mir.MirLocalId>();
        self.lower_if_condition_bindings(condition, condition_locals$.ref());
    }

    IfConditionLowerResult lower_if_condition(hir.HirId condition_id) {
        hir.HirNode condition_node = self.lowerer.hirs.node(condition_id);
        if (condition_node.data is .is_pattern(is_pattern)) {
            return self.lower_is_pattern_condition(condition_id, is_pattern);
        }
        return IfConditionLowerResult {
            condition: self.lower_to_operand(condition_id),
            pattern_id: null,
            subject_place: null,
            subject_type: self.lowerer.ctx.query.types.invalid_type()
        };
    }

    IfConditionLowerResult lower_is_pattern_condition(hir.HirId node_id, hir.HirIsPattern is_pattern) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(is_pattern.pattern);
        if (pattern_node.data is .optional_pattern(_)) {
            return self.lower_optional_pattern_condition(node_id, is_pattern);
        }
        if (pattern_node.data is .variant_pattern(_)) {
            return self.lower_variant_pattern_condition(node_id, is_pattern);
        }
        if (pattern_node.data is .wildcard_pattern) {
            return IfConditionLowerResult {
                condition: self.bool_operand(true, self.lowerer.hir_span(node_id)),
                pattern_id: null,
                subject_place: null,
                subject_type: self.type_for_node(is_pattern.value)
            };
        }
        self.mark_unsupported(is_pattern.pattern);
        return IfConditionLowerResult {
            condition: self.bool_operand(false, self.lowerer.hir_span(node_id)),
            pattern_id: null,
            subject_place: null,
            subject_type: self.type_for_node(is_pattern.value)
        };
    }

    IfConditionLowerResult lower_optional_pattern_condition(hir.HirId node_id, hir.HirIsPattern is_pattern) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId subject_local = self.add_temp(self.type_for_node(is_pattern.value), span);
        mir.MirPlace subject_place = self.place_for_local(subject_local);
        self.lower_into_place(is_pattern.value, subject_place);
        mir.MirLocalId condition_local = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(condition_local),
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.is_some,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: subject_place})
            }),
            span
        );
        return IfConditionLowerResult {
            condition: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(condition_local)}),
            pattern_id: is_pattern.pattern,
            subject_place: subject_place,
            subject_type: self.type_for_node(is_pattern.value)
        };
    }

    IfConditionLowerResult lower_variant_pattern_condition(hir.HirId node_id, hir.HirIsPattern is_pattern) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId subject_type = self.type_for_node(is_pattern.value);
        mir.MirLocalId subject_local = self.add_temp(subject_type, span);
        mir.MirPlace subject_place = self.place_for_local(subject_local);
        self.lower_into_place(is_pattern.value, subject_place);
        mir.MirLocalId condition_local = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(condition_local),
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: mir.MirBinaryOp.eq,
                lhs: self.variant_pattern_discriminator(is_pattern.value, is_pattern.pattern, subject_type, subject_place),
                rhs: self.variant_pattern_tag(is_pattern.pattern, subject_type)
            }),
            span
        );
        return IfConditionLowerResult {
            condition: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(condition_local)}),
            pattern_id: is_pattern.pattern,
            subject_place: subject_place,
            subject_type: subject_type
        };
    }

    mir.MirOperand variant_pattern_discriminator(
        hir.HirId value_id,
        hir.HirId pattern_id,
        qid.TypeId subject_type,
        mir.MirPlace subject_place
    ) {
        if (!self.switch_needs_explicit_discriminant(subject_type)) {
            return self.lower_to_operand(value_id);
        }
        token.Span span = self.lowerer.hir_span(pattern_id);
        mir.MirLocalId discriminator_local = self.add_temp(self.lowerer.ctx.query.types.int_type(), span);
        self.push_assign(
            self.place_for_local(discriminator_local),
            mir.discriminant_rvalue(mir.MirDiscriminantRvalue {place: subject_place}),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(discriminator_local)});
    }

    mir.MirOperand variant_pattern_tag(hir.HirId pattern_id, qid.TypeId subject_type) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is some variant_def else {
            self.mark_unsupported(pattern_id);
            return self.bool_operand(false, self.lowerer.hir_span(pattern_id));
        }
        qid.TypeId discriminator_type = self.switch_discriminator_type(subject_type);
        return mir.const_operand_value(self.variant_tag_const(pattern_id, variant_def, discriminator_type));
    }

    () lower_is_pattern_into_place(hir.HirId node_id, hir.HirIsPattern is_pattern, mir.MirPlace destination) {
        IfConditionLowerResult condition = self.lower_is_pattern_condition(node_id, is_pattern);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue {value: condition.condition}), self.lowerer.hir_span(node_id));
    }

    () lower_if_condition_bindings(
        IfConditionLowerResult condition,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        guard condition.pattern_id is some pattern_id else { return; }
        guard condition.subject_place is some subject_place else { return; }
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        if (pattern_node.data is .optional_pattern(optional_pattern)) {
            self.lower_optional_pattern_binding(optional_pattern.nested, subject_place, condition_locals);
            return;
        }
        if (pattern_node.data is .variant_pattern(variant_pattern)) {
            if (variant_pattern.payload.length != 0) {
                self.lower_variant_payload_binding(pattern_id, subject_place, condition.subject_type, condition_locals);
            }
            return;
        }
    }

    () lower_optional_pattern_binding(
        hir.HirId pattern_id,
        mir.MirPlace subject_place,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        if (pattern_node.data is .wildcard_pattern) { return; }
        guard pattern_node.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        condition_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(pattern_id));
        self.push_assign(
            self.place_for_local(local_id),
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.unwrap_some,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: subject_place})
            }),
            self.lowerer.hir_span(pattern_id)
        );
    }

    () lower_loop(hir.HirId node_id, hir.HirLoop loop_expr, mir.MirPlace destination) {
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            self.lower_for_loop(node_id, loop_expr, destination);
            return;
        }
        mir.MirBlockId header_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId exit_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: header_block}), self.lowerer.hir_span(node_id));
        self.start_block(header_block);
        if (loop_expr.condition is some condition) {
            mir.MirOperand condition_value = self.lower_to_operand(condition);
            self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
                condition: condition_value,
                then_target: body_block,
                else_target: exit_block
            }), self.lowerer.hir_span(condition));
        } else {
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: body_block}), self.lowerer.hir_span(node_id));
        }

        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(LoopTargets {
            continue_target: header_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        });
        self.start_block(body_block);
        self.lower_expr_statement(loop_expr.body);
        if (!self.terminated) {
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: header_block}), self.lowerer.hir_span(node_id));
        }
        LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);

        self.start_block(exit_block);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_for_loop(hir.HirId node_id, hir.HirLoop loop_expr, mir.MirPlace destination) {
        guard loop_expr.iterable is some iterable else {
            self.mark_unsupported(node_id);
            return;
        }
        guard loop_expr.pattern is some pattern else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        hir.HirNode iterable_node = self.lowerer.hirs.node(iterable);
        if (iterable_node.data is .range_expr(range_expr)) {
            self.lower_range_for_loop(loop_expr, pattern, range_expr, destination, span);
            return;
        }
        mir.MirPlace iterable_place = self.pointer_base_place(iterable);
        mir.MirLocalId index_local = self.add_loop_index_local(span);
        mir.MirLocalId len_local = self.add_loop_len_local(span);
        self.init_for_loop_counters(iterable_place, index_local, len_local, span);
        self.lower_for_loop_cfg(loop_expr, pattern, iterable_place, index_local, len_local, destination, span);
    }

    () lower_range_for_loop(
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        hir.HirRange range_expr,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirLocalId index_local = self.add_loop_index_local(span);
        mir.MirLocalId end_local = self.add_loop_len_local(span);
        self.lower_into_place(range_expr.start, self.place_for_local(index_local));
        self.lower_into_place(range_expr.end, self.place_for_local(end_local));
        if (self.terminated) {
            return;
        }
        self.lower_range_for_loop_cfg(loop_expr, pattern, index_local, end_local, destination, span);
    }

    mir.MirLocalId add_loop_index_local(token.Span span) {
        return self.add_temp(self.lowerer.ctx.query.types.int_type(), span);
    }

    mir.MirLocalId add_loop_len_local(token.Span span) {
        return self.add_temp(self.lowerer.ctx.query.types.int_type(), span);
    }

    () init_for_loop_counters(
        mir.MirPlace iterable_place,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        token.Span span
    ) {
        self.push_assign(self.place_for_local(index_local), self.int_const_rvalue(0, span), span);
        self.push_assign(
            self.place_for_local(len_local),
            mir.len_rvalue(mir.MirLenRvalue {place: iterable_place}),
            span
        );
    }

    () lower_for_loop_cfg(
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirPlace iterable_place,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirBlockId header_block = self.reserve_block(span);
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId increment_block = self.reserve_block(span);
        mir.MirBlockId exit_block = self.reserve_block(span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: header_block}), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, len_local, span);
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            self.project_index(iterable_place, index_local),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    () lower_range_for_loop_cfg(
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirLocalId index_local,
        mir.MirLocalId end_local,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirBlockId header_block = self.reserve_block(span);
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId increment_block = self.reserve_block(span);
        mir.MirBlockId exit_block = self.reserve_block(span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: header_block}), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, end_local, span);
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            self.place_for_local(index_local),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    () lower_for_loop_header(
        mir.MirBlockId header_block,
        mir.MirBlockId body_block,
        mir.MirBlockId exit_block,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        token.Span span
    ) {
        self.start_block(header_block);
        mir.MirLocalId cond_local = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(cond_local),
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: mir.MirBinaryOp.lt,
                lhs: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(index_local)}),
                rhs: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(len_local)})
            }),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(cond_local)}),
            then_target: body_block,
            else_target: exit_block
        }), span);
    }

    () lower_for_loop_body(
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirPlace item_place,
        mir.MirLocalId index_local,
        mir.MirBlockId body_block,
        mir.MirBlockId increment_block,
        mir.MirBlockId exit_block,
        mir.MirPlace destination
    ) {
        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(LoopTargets {
            continue_target: increment_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        });
        self.start_block(body_block);
        list.ArrayList<mir.MirLocalId>! item_locals = list.ArrayList<mir.MirLocalId>();
        self.lower_payload_pattern(pattern, item_place, item_locals$.ref());
        self.lower_expr_statement(loop_expr.body);
        self.finish_for_loop_body(increment_block, loop_expr, item_locals$.ref());
        LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);
    }

    () finish_for_loop_body(
        mir.MirBlockId increment_block,
        hir.HirLoop loop_expr,
        list.ArrayList<mir.MirLocalId>& item_locals
    ) {
        if (self.terminated) { return; }
        token.Span span = self.lowerer.hir_span(loop_expr.body);
        self.end_scope(item_locals, span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: increment_block}), span);
    }

    () lower_for_loop_increment(
        mir.MirBlockId increment_block,
        mir.MirLocalId index_local,
        mir.MirBlockId header_block,
        token.Span span
    ) {
        self.start_block(increment_block);
        self.push_assign(
            self.place_for_local(index_local),
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: mir.MirBinaryOp.add,
                lhs: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(index_local)}),
                rhs: mir.const_operand_value(self.int_const(1, span))
            }),
            span
        );
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: header_block}), span);
    }

    () lower_for_loop_exit(mir.MirBlockId exit_block, mir.MirPlace destination, token.Span span) {
        self.start_block(exit_block);
        self.push_assign(destination, self.unit_rvalue(span), span);
    }

    () lower_switch(hir.HirId node_id, hir.HirSwitch switch_expr, mir.MirPlace destination) {
        qid.TypeId value_type = self.type_for_node(switch_expr.value);
        mir.MirPlace?! subject_place = self.switch_subject_place(switch_expr, value_type);
        mir.MirOperand discriminator = self.lower_switch_discriminator(switch_expr.value, value_type, subject_place);
        qid.TypeId discriminator_type = self.switch_discriminator_type(value_type);
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId default_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId! default_target = default_block;
        list.ArrayList<mir.MirBlockId>! body_blocks = list.ArrayList<mir.MirBlockId>(switch_expr.cases.length);
        list.ArrayList<mir.MirSwitchCase>! cases = list.ArrayList<mir.MirSwitchCase>();
        list.ArrayList<SwitchPayloadEntry>! payload_entries = list.ArrayList<SwitchPayloadEntry>();

        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(switch_expr.cases[case_index].body));
            body_blocks.add(body_block);
            default_target = self.add_switch_patterns(
                switch_expr.cases[case_index],
                body_block,
                default_target,
                discriminator_type,
                cases$.ref(),
                payload_entries$.ref()
            );
            case_index = case_index + 1;
        }

        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator {
            discriminator: discriminator,
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: default_target
        }), self.lowerer.hir_span(node_id));

        Int active_depth = self.active_locals.len();
        self.lower_switch_payload_entries(payload_entries$.ref(), subject_place, value_type);
        self.restore_active_locals(active_depth);
        self.lower_switch_case_bodies(
            switch_expr,
            body_blocks$.ref(),
            destination,
            join_block,
            active_depth,
            subject_place,
            value_type
        );
        self.restore_active_locals(active_depth);
        if (default_target.to_index() == default_block.to_index()) {
            self.start_block(default_block);
            self.finish_block(
                mir.unreachable_terminator_kind(mir.MirUnreachableTerminator {generated_by_check: true}),
                self.lowerer.hir_span(node_id)
            );
        }
        self.start_block(join_block);
    }

    mir.MirPlace? switch_subject_place(hir.HirSwitch switch_expr, qid.TypeId value_type) {
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.pointer_base_place(switch_expr.value);
        }
        if (self.switch_has_payload_patterns(switch_expr)) {
            return self.pointer_base_place(switch_expr.value);
        }
        return null;
    }

    Bool switch_has_payload_patterns(hir.HirSwitch switch_expr) {
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            if (self.switch_case_has_payload_pattern(switch_expr.cases[case_index])) {
                return true;
            }
            case_index = case_index + 1;
        }
        return false;
    }

    Bool switch_case_has_payload_pattern(hir.HirSwitchCase switch_case) {
        Int! pattern_index = 0;
        while (pattern_index < switch_case.patterns.length) {
            if (self.pattern_has_payload(switch_case.patterns[pattern_index])) {
                return true;
            }
            pattern_index = pattern_index + 1;
        }
        return false;
    }

    Bool pattern_has_payload(hir.HirId pattern_id) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        guard pattern.data is .variant_pattern(variant_pattern) else {
            return false;
        }
        return variant_pattern.payload.length != 0;
    }

    mir.MirOperand lower_switch_discriminator(
        hir.HirId value,
        qid.TypeId value_type,
        mir.MirPlace? subject_place
    ) {
        if (!self.switch_needs_explicit_discriminant(value_type)) {
            return self.lower_to_operand(value);
        }
        token.Span span = self.lowerer.hir_span(value);
        guard subject_place is some place else {
            return self.unsupported_operand(value);
        }
        mir.MirLocalId temp = self.add_temp(self.lowerer.ctx.query.types.int_type(), span);
        self.push_assign(
            self.place_for_local(temp),
            mir.discriminant_rvalue(mir.MirDiscriminantRvalue {place: place}),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(temp)});
    }

    qid.TypeId switch_discriminator_type(qid.TypeId value_type) {
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.lowerer.ctx.query.types.int_type();
        }
        return value_type;
    }

    Bool switch_needs_explicit_discriminant(qid.TypeId value_type) {
        guard self.nominal_def_kind(value_type) is some kind else {
            return false;
        }
        return kind == .union_def;
    }

    mir.MirBlockId add_switch_patterns(
        hir.HirSwitchCase switch_case,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<SwitchPayloadEntry>& payload_entries
    ) {
        mir.MirBlockId! updated_default = default_target;
        Int! pattern_index = 0;
        while (pattern_index < switch_case.patterns.length) {
            hir.HirId pattern_id = switch_case.patterns[pattern_index];
            updated_default = self.add_switch_pattern(
                pattern_id,
                body_block,
                updated_default,
                discriminator_type,
                cases,
                payload_entries
            );
            pattern_index = pattern_index + 1;
        }
        return updated_default;
    }

    mir.MirBlockId add_switch_pattern(
        hir.HirId pattern_id,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<SwitchPayloadEntry>& payload_entries
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) {
            return body_block;
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            cases.add(mir.MirSwitchCase {
                value: self.lower_literal_as_const(pattern_id, literal_pattern.literal, discriminator_type),
                target: body_block
            });
            return default_target;
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            self.add_variant_switch_pattern(
                pattern_id,
                variant_pattern,
                body_block,
                discriminator_type,
                cases,
                payload_entries
            );
            return default_target;
        }
        self.mark_unsupported(pattern_id);
        return default_target;
    }

    () add_variant_switch_pattern(
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        mir.MirBlockId body_block,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<SwitchPayloadEntry>& payload_entries
    ) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is some variant_def else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirBlockId! target = body_block;
        if (variant_pattern.payload.length != 0) {
            target = self.reserve_block(self.lowerer.hir_span(pattern_id));
            payload_entries.add(SwitchPayloadEntry {
                pattern_id: pattern_id,
                entry_block: target,
                body_block: body_block
            });
        }
        cases.add(mir.MirSwitchCase {
            value: self.variant_tag_const(pattern_id, variant_def, discriminator_type),
            target: target
        });
    }

    mir.MirConst variant_tag_const(hir.HirId pattern_id, qid.DefId variant_def, qid.TypeId discriminator_type) {
        return mir.MirConst {
            type_id: discriminator_type,
            span: self.lowerer.hir_span(pattern_id),
            value: mir.int_const_kind(mir.MirIntConst {
                bits: UInt64(self.variant_tag_index(variant_def)),
                signed_value: true
            })
        };
    }

    Int variant_tag_index(qid.DefId variant_def) {
        guard self.lowerer.ctx.query.defs.get(variant_def).owner_def is some owner_def else {
            return 0;
        }
        guard self.lowerer.hirs.def(owner_def) is some owner_hir else {
            return 0;
        }
        Int! tag = 0;
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (member_def.to_index() == variant_def.to_index()) {
                return tag;
            }
            if (self.def_is_variant_member(member_def)) {
                tag = tag + 1;
            }
            index = index + 1;
        }
        return 0;
    }

    Bool def_is_variant_member(qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.query.defs.get(def_id).kind;
        if (kind == .enum_case_def) {
            return true;
        }
        return kind == .union_variant_def;
    }

    () lower_switch_payload_entries(
        list.ArrayList<SwitchPayloadEntry>& entries,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type
    ) {
        Int! index = 0;
        while (index < entries.len()) {
            SwitchPayloadEntry entry = entries.get(index);
            self.start_block(entry.entry_block);
            list.ArrayList<mir.MirLocalId>! entry_locals = list.ArrayList<mir.MirLocalId>();
            self.lower_variant_payload_binding(
                entry.pattern_id,
                subject_place,
                subject_type,
                entry_locals$.ref()
            );
            if (!self.terminated) {
                self.finish_block(
                    mir.goto_terminator_kind(mir.MirGotoTerminator {target: entry.body_block}),
                    self.lowerer.hir_span(entry.pattern_id)
                );
            }
            index = index + 1;
        }
    }

    def.DefKind? nominal_def_kind(qid.TypeId type_id) {
        guard self.nominal_type_data(type_id) is some named else {
            return null;
        }
        return self.lowerer.ctx.query.defs.get(named.def_id).kind;
    }

    types.NamedType? nominal_type_data(qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        guard info.data is .named(named) else {
            return null;
        }
        return named;
    }

    () lower_switch_case_bodies(
        hir.HirSwitch switch_expr,
        list.ArrayList<mir.MirBlockId>& body_blocks,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        Int active_depth,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type
    ) {
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            self.start_block(body_blocks.get(case_index));
            list.ArrayList<mir.MirLocalId>! case_locals = list.ArrayList<mir.MirLocalId>();
            self.collect_switch_case_payload_locals(switch_expr.cases[case_index], case_locals$.ref());
            self.lower_into_place(switch_expr.cases[case_index].body, destination);
            if (!self.terminated) {
                self.end_scope(case_locals$.ref(), self.lowerer.hir_span(switch_expr.cases[case_index].body));
                self.finish_block(
                    mir.goto_terminator_kind(mir.MirGotoTerminator {target: join_block}),
                    self.lowerer.hir_span(switch_expr.cases[case_index].body)
                );
            }
            self.restore_active_locals(active_depth);
            case_index = case_index + 1;
        }
    }

    () collect_switch_case_payload_locals(
        hir.HirSwitchCase switch_case,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        Int! pattern_index = 0;
        while (pattern_index < switch_case.patterns.length) {
            self.collect_payload_pattern_locals(switch_case.patterns[pattern_index], case_locals);
            pattern_index = pattern_index + 1;
        }
    }

    () lower_variant_payload_binding(
        hir.HirId pattern_id,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        guard subject_place is some base_place else {
            self.mark_unsupported(pattern_id);
            return;
        }
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        guard pattern.data is .variant_pattern(variant_pattern) else { return; }
        guard self.lowerer.typeck.pattern_selection(pattern_id) is some variant_def else {
            self.mark_unsupported(pattern_id);
            return;
        }
        qid.TypeId payload_type = self.variant_payload_type(variant_def, subject_type);
        mir.MirPlace payload_place = self.project_field(base_place, variant_def, payload_type);
        self.lower_variant_payload_patterns(variant_pattern, payload_place, payload_type, case_locals);
    }

    () lower_variant_payload_patterns(
        hir.HirVariantPattern variant_pattern,
        mir.MirPlace payload_place,
        qid.TypeId payload_type,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        if (variant_pattern.payload.length == 1) {
            self.lower_payload_pattern(variant_pattern.payload[0], payload_place, case_locals);
            return;
        }
        if (!self.payload_type_is_tuple(payload_type)) {
            self.mark_unsupported(variant_pattern.payload[0]);
            return;
        }
        Int! index = 0;
        while (index < variant_pattern.payload.length) {
            self.lower_payload_pattern(
                variant_pattern.payload[index],
                self.project_constant_index(payload_place, index),
                case_locals
            );
            index = index + 1;
        }
    }

    () collect_payload_pattern_locals(hir.HirId pattern_id, list.ArrayList<mir.MirLocalId>& case_locals) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .variant_pattern(variant_pattern)) {
            Int! index = 0;
            while (index < variant_pattern.payload.length) {
                self.collect_payload_pattern_locals(variant_pattern.payload[index], case_locals);
                index = index + 1;
            }
            return;
        }
        if (pattern.data is .binding_pattern(binding)) {
            self.add_case_payload_local(self.mir_local_for_hir(binding.local_id), case_locals);
        }
    }

    () add_case_payload_local(mir.MirLocalId local_id, list.ArrayList<mir.MirLocalId>& case_locals) {
        Int! index = 0;
        while (index < case_locals.len()) {
            if (case_locals.get(index).to_index() == local_id.to_index()) { return; }
            index = index + 1;
        }
        case_locals.add(local_id);
        self.active_locals.add(local_id);
    }

    () lower_payload_pattern(
        hir.HirId pattern_id,
        mir.MirPlace source,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) { return; }
        guard pattern.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        self.add_case_payload_local(local_id, case_locals);
        self.push_storage_live(local_id, self.lowerer.hir_span(pattern_id));
        self.push_assign(
            self.place_for_local(local_id),
            mir.use_rvalue(mir.MirUseRvalue {value: mir.copy_operand_value(mir.MirCopyOperand {place: source})}),
            self.lowerer.hir_span(pattern_id)
        );
    }

    qid.TypeId variant_payload_type(qid.DefId variant_def, qid.TypeId subject_type) {
        guard self.nominal_type_data(subject_type) is some named else {
            return self.lowerer.ctx.query.types.invalid_type();
        }
        guard self.lowerer.ctx.query.defs.get(variant_def).owner_def is some owner_def else {
            return self.lowerer.ctx.query.types.invalid_type();
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            return self.lowerer.ctx.query.types.invalid_type();
        }
        guard self.lowerer.typeck.def_type(variant_def) is some template_type else {
            return self.lowerer.ctx.query.types.invalid_type();
        }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.args);
        return self.lowerer.substitute_type(template_type, substitutions$.ref());
    }

    monomorph.SubstitutionMap nominal_substitution(qid.DefId owner_def, qid.TypeId[] type_args) {
        monomorph.SubstitutionMap! substitutions = monomorph.SubstitutionMap();
        hir.HirDef& owner_hir = self.lowerer.hirs.def_ref(owner_def);
        Int! generic_index = 0;
        Int! member_index = 0;
        while (member_index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(member_index);
            if (self.lowerer.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                if (generic_index < type_args.length) {
                    substitutions.set(member_def, type_args[generic_index]);
                }
                generic_index = generic_index + 1;
            }
            member_index = member_index + 1;
        }
        return substitutions$.move();
    }

    Bool payload_type_is_tuple(qid.TypeId payload_type) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(payload_type);
        return info.data is .tuple_type(_);
    }

    () lower_catch(hir.HirId node_id, hir.HirCatch catch_expr, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId error_union_local = self.add_temp(self.type_for_node(catch_expr.value), span);
        self.lower_into_place(catch_expr.value, self.place_for_local(error_union_local));
        if (self.terminated) { return; }

        mir.MirLocalId is_error_local = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        mir.MirPlace error_union_place = self.place_for_local(error_union_local);
        self.push_assign(
            self.place_for_local(is_error_local),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.is_error,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: error_union_place})
            }),
            span
        );

        mir.MirBlockId success_block = self.reserve_block(span);
        mir.MirBlockId catch_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(is_error_local)}),
            then_target: catch_block,
            else_target: success_block
        }), span);

        Int active_depth = self.active_locals.len();
        self.lower_catch_success_block(success_block, error_union_place, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.lower_catch_error_block(catch_block, catch_expr, error_union_place, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.start_block(join_block);
    }

    () lower_catch_success_block(
        mir.MirBlockId block_id,
        mir.MirPlace error_union_place,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        token.Span span
    ) {
        self.start_block(block_id);
        self.push_assign(
            destination,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.unwrap_value,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: error_union_place})
            }),
            span
        );
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: join_block}), span);
    }

    () lower_catch_error_block(
        mir.MirBlockId block_id,
        hir.HirCatch catch_expr,
        mir.MirPlace error_union_place,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        token.Span span
    ) {
        self.start_block(block_id);
        list.ArrayList<mir.MirLocalId>! catch_locals = list.ArrayList<mir.MirLocalId>();
        self.lower_catch_pattern(catch_expr.pattern, error_union_place, catch_locals$.ref(), span);
        if (!self.terminated) {
            self.lower_into_place(catch_expr.body, destination);
        }
        if (!self.terminated) {
            self.end_scope(catch_locals$.ref(), span);
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator {target: join_block}), span);
        }
    }

    () lower_catch_pattern(
        hir.HirId? pattern,
        mir.MirPlace error_union_place,
        list.ArrayList<mir.MirLocalId>& catch_locals,
        token.Span span
    ) {
        guard pattern is some pattern_id else { return; }
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        guard pattern_node.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        catch_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, span);
        self.push_assign(
            self.place_for_local(local_id),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.unwrap_error,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: error_union_place})
            }),
            span
        );
    }

    () lower_break(hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            mir.goto_terminator_kind(mir.MirGotoTerminator {target: target.break_target}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_continue(hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            mir.goto_terminator_kind(mir.MirGotoTerminator {target: target.continue_target}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_unary(hir.HirId node_id, hir.HirUnary unary, mir.MirPlace destination) {
        if (unary.op == .new_value) {
            self.lower_new_value(node_id, unary, destination);
            return;
        }
        guard self.unary_op(unary.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.unary_rvalue(mir.MirUnaryRvalue {op: op, value: self.lower_to_operand(unary.value)}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_new_value(hir.HirId node_id, hir.HirUnary unary, mir.MirPlace destination) {
        self.push_assign(
            destination,
            mir.alloc_rvalue(mir.MirAllocValueRvalue {
                value_type: self.type_for_node(unary.value),
                value: self.lower_to_operand(unary.value)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_binary(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.lower_logic_binary(node_id, binary, destination);
            return;
        }
        if (binary.op == .equal || binary.op == .not_equal) {
            self.lower_equal_binary(node_id, binary, destination);
            return;
        }
        guard self.binary_op(binary.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: op,
                lhs: self.lower_to_operand(binary.left),
                rhs: self.lower_to_operand(binary.right)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_equal_binary(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId compare_type = self.equality_compare_type(binary);
        if (!self.equality_needs_expansion(compare_type)) {
            self.lower_scalar_equal_binary(node_id, binary, destination);
            return;
        }
        mir.MirPlace lhs = self.lower_equality_operand(binary.left, compare_type, span);
        mir.MirPlace rhs = self.lower_equality_operand(binary.right, compare_type, span);
        self.lower_equal_places(compare_type, lhs, rhs, destination, binary.op == .not_equal, span);
    }

    () lower_scalar_equal_binary(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        guard self.binary_op(binary.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: op,
                lhs: self.lower_to_operand(binary.left),
                rhs: self.lower_to_operand(binary.right)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    qid.TypeId equality_compare_type(hir.HirBinary binary) {
        qid.TypeId left = self.type_for_node(binary.left);
        if (self.type_has_layout_fields(left)) {
            return left;
        }
        qid.TypeId right = self.type_for_node(binary.right);
        if (self.type_has_layout_fields(right)) {
            return right;
        }
        return left;
    }

    Bool equality_needs_expansion(qid.TypeId type_id) {
        return self.type_has_layout_fields(type_id);
    }

    Bool type_has_layout_fields(qid.TypeId type_id) {
        return self.layout_for_type(type_id).fields.length > 0;
    }

    mir.MirPlace lower_equality_operand(hir.HirId node_id, qid.TypeId compare_type, token.Span span) {
        mir.MirLocalId local = self.add_temp(compare_type, span);
        mir.MirPlace place = self.place_for_local(local);
        self.lower_into_place(node_id, place);
        return place;
    }

    () lower_equal_places(
        qid.TypeId type_id,
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirPlace destination,
        Bool invert,
        token.Span span
    ) {
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        if (type_layout.fields.length == 0) {
            self.lower_scalar_equal_places(lhs, rhs, destination, invert, span);
            return;
        }
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        self.push_assign(self.place_for_local(result), self.bool_rvalue(true, span), span);
        Int! index = 0;
        while (index < type_layout.fields.length) {
            layout.FieldLayout field = type_layout.fields[index];
            if (!self.type_has_abi_value(field.field_type)) {
                index = index + 1;
                continue;
            }
            self.lower_equal_field(type_id, field, index, lhs, rhs, result, span);
            index = index + 1;
        }
        self.finish_equal_places(result, destination, invert, span);
    }

    () lower_equal_field(
        qid.TypeId owner_type,
        layout.FieldLayout field,
        Int field_index,
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirLocalId result,
        token.Span span
    ) {
        mir.MirLocalId field_result = self.add_temp(self.lowerer.ctx.query.types.bool_type(), span);
        self.lower_equal_places(
            field.field_type,
            self.project_layout_field(lhs, field, field_index),
            self.project_layout_field(rhs, field, field_index),
            self.place_for_local(field_result),
            false,
            span
        );
        self.push_assign(
            self.place_for_local(result),
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: mir.MirBinaryOp.bit_and,
                lhs: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(result)}),
                rhs: mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(field_result)})
            }),
            span
        );
    }

    () finish_equal_places(mir.MirLocalId result, mir.MirPlace destination, Bool invert, token.Span span) {
        mir.MirOperand result_operand = mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(result)});
        if (invert) {
            self.push_assign(
                destination,
                mir.unary_rvalue(mir.MirUnaryRvalue {op: mir.MirUnaryOp.logic_not, value: result_operand}),
                span
            );
            return;
        }
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue {value: result_operand}), span);
    }

    () lower_scalar_equal_places(
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirPlace destination,
        Bool invert,
        token.Span span
    ) {
        mir.MirBinaryOp! op = mir.MirBinaryOp.eq;
        if (invert) {
            op = mir.MirBinaryOp.ne;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue {
                op: op,
                lhs: mir.copy_operand_value(mir.MirCopyOperand {place: lhs}),
                rhs: mir.copy_operand_value(mir.MirCopyOperand {place: rhs})
            }),
            span
        );
    }

    mir.MirPlace project_layout_field(mir.MirPlace base, layout.FieldLayout field, Int field_index) {
        if (field.field_def is some field_def) {
            return self.project_field_at_index(base, field_def, field.field_type, field_index);
        }
        return self.project_constant_index(base, field_index);
    }

    Bool type_has_abi_value(qid.TypeId type_id) {
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        return type_layout.kind != .invalid && type_layout.kind != .zero_sized;
    }

    layout.TypeLayout layout_for_type(qid.TypeId type_id) {
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, type_id);
        return self.lowerer.ctx.query.layouts.layout(layout_id);
    }

    () lower_logic_binary(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        if (binary.op == .logic_and) {
            self.lower_logic_and(node_id, binary, destination);
            return;
        }
        self.lower_logic_or(node_id, binary, destination);
    }

    () lower_logic_and(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId rhs_block = self.reserve_block(self.lowerer.hir_span(binary.right));
        mir.MirBlockId false_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        mir.MirOperand condition = self.lower_to_operand(binary.left);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: condition,
            then_target: rhs_block,
            else_target: false_block
        }), self.lowerer.hir_span(binary.left));

        self.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.terminated) {
            self.finish_block(self.goto_terminator(join_block), span);
        }

        self.start_block(false_block);
        self.push_assign(destination, self.bool_rvalue(false, span), span);
        self.finish_block(self.goto_terminator(join_block), span);
        self.start_block(join_block);
    }

    () lower_logic_or(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId true_block = self.reserve_block(span);
        mir.MirBlockId rhs_block = self.reserve_block(self.lowerer.hir_span(binary.right));
        mir.MirBlockId join_block = self.reserve_block(span);
        mir.MirOperand condition = self.lower_to_operand(binary.left);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator {
            condition: condition,
            then_target: true_block,
            else_target: rhs_block
        }), self.lowerer.hir_span(binary.left));

        self.start_block(true_block);
        self.push_assign(destination, self.bool_rvalue(true, span), span);
        self.finish_block(self.goto_terminator(join_block), span);

        self.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.terminated) {
            self.finish_block(self.goto_terminator(join_block), span);
        }
        self.start_block(join_block);
    }

    // type check 已经保证 get/set 的 base 是 pointer/reference。MIR 只把
    // 它们降成现有 place deref 读写，不再重新做语义判定。
    () lower_implicit_call(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.op == .alloc_array) {
            self.lower_alloc_array(node_id, call, destination);
            return;
        }
        if (call.op == .size) {
            self.lower_type_info_value(node_id, call, destination, 0);
            return;
        }
        if (call.op == .align) {
            self.lower_type_info_value(node_id, call, destination, 1);
            return;
        }
        if (call.op == .max_align) {
            self.lower_type_info_value(node_id, call, destination, 2);
            return;
        }
        if (call.op == .get) {
            self.lower_pointer_get(node_id, call, destination);
            return;
        }
        if (call.op == .set) {
            self.lower_pointer_set(node_id, call, destination);
            return;
        }
        if (call.op == .move) {
            self.lower_move(node_id, call, destination);
            return;
        }
        if (call.op == .ref) {
            self.lower_borrow_ref(node_id, call, destination, false);
            return;
        }
        if (call.op == .addr) {
            self.lower_borrow_ref(node_id, call, destination, true);
            return;
        }
        if (call.op == .cast) {
            self.lower_cast(node_id, call, destination);
            return;
        }
        if (call.op == .free) {
            self.lower_free(node_id, call, destination);
            return;
        }
        if (call.op == .optional_some) {
            self.lower_optional_some(node_id, call, destination);
            return;
        }
        self.mark_unsupported(node_id);
    }

    () lower_alloc_array(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.alloc_array_rvalue(mir.MirAllocArrayRvalue {
                element_type: self.type_for_node(call.base),
                count: self.lower_to_operand(call.args[0])
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_type_info_value(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination, Int kind) {
        qid.TypeId type_id = self.type_for_node(call.base);
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, type_id);
        layout.TypeLayout type_layout = self.lowerer.ctx.query.layouts.layout(layout_id);
        Int! value = 8;
        if (kind == 0) {
            value = type_layout.size;
        } else if (kind == 1) {
            value = type_layout.align;
        }
        self.push_assign(destination, self.int_rvalue(node_id, value), self.lowerer.hir_span(node_id));
    }

    () lower_pointer_get(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.pointer_deref_place(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue {value: mir.copy_operand_value(mir.MirCopyOperand {place: source})}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_pointer_set(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.pointer_deref_place(call.base) is some target else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_into_place(call.args[0], target);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_move(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.place_for_expr(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue {value: mir.move_operand_value(mir.MirMoveOperand {place: source})}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_borrow_ref(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination, Bool raw_pointer) {
        guard self.place_for_expr(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirRvalue! value = mir.borrow_rvalue(mir.MirBorrowRvalue {place: source});
        if (raw_pointer) {
            value = mir.address_of_rvalue(mir.MirAddressOfRvalue {
                mutable_pointer: true,
                place: source
            });
        }
        self.push_assign(destination, value, self.lowerer.hir_span(node_id));
    }

    () lower_cast(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.base);
        qid.TypeId target_type = self.type_for_node(call.args[0]);
        if (self.cast_is_slice_to_handle(source_type, target_type)) {
            self.lower_slice_data_cast(node_id, call, source_type, target_type, destination);
            return;
        }
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue {
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.base),
                target_type: target_type
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool cast_is_slice_to_handle(qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.query.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.query.types.get(target_type);
        guard source.data is .handle_type(source_handle) else { return false; }
        return source_handle.kind == .slice && target.data is .handle_type(_);
    }

    () lower_slice_data_cast(
        hir.HirId node_id,
        hir.HirImplicitCall call,
        qid.TypeId source_type,
        qid.TypeId target_type,
        mir.MirPlace destination
    ) {
        // slice 的 layout 是 `{ data, length }`。MIR 在这里显式投影 data
        // 字段，backend 后续只需要处理普通 field projection 和 ptr cast。
        mir.MirPlace data_place = self.slice_data_place(node_id, call.base, source_type);
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue {
                kind: mir.MirCastKind.ptr_to_ptr,
                value: mir.copy_operand_value(mir.MirCopyOperand {place: data_place}),
                target_type: target_type
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirPlace slice_data_place(hir.HirId node_id, hir.HirId base, qid.TypeId source_type) {
        if (self.place_for_expr(base) is some place) {
            return self.project_constant_index(place, 0);
        }
        mir.MirLocalId temp = self.add_temp(source_type, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.lower_into_place(base, temp_place);
        return self.project_constant_index(temp_place, 0);
    }

    () lower_free(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.free_rvalue(mir.MirFreeRvalue {pointer: self.free_pointer_operand(node_id, call)}),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand free_pointer_operand(hir.HirId node_id, hir.HirImplicitCall call) {
        if (!call.optional_chain) {
            return self.lower_to_operand(call.base);
        }
        if (self.type_is_handle(self.type_for_node(call.base))) {
            return self.lower_to_operand(call.base);
        }
        mir.MirLocalId temp = self.add_temp(self.optional_element_type(call.base), self.lowerer.hir_span(node_id));
        self.push_assign(
            self.place_for_local(temp),
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.unwrap_some,
                value: self.lower_to_operand(call.base)
            }),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(temp)});
    }

    qid.TypeId optional_element_type(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        return type_id;
    }

    Bool type_is_handle(qid.TypeId type_id) {
        return self.lowerer.ctx.query.types.get(type_id).data is .handle_type(_);
    }

    () lower_optional_some(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        self.push_assign(
            destination,
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.unwrap_some,
                value: self.lower_to_operand(call.base)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirCastKind cast_kind(qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.query.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.query.types.get(target_type);
        if (source.data is .handle_type(_)) {
            if (target.data is .handle_type(_)) {
                return mir.MirCastKind.ptr_to_ptr;
            }
            if (target.data is .int_type(_)) { return mir.MirCastKind.ptr_to_int; }
        }
        if (source.data is .int_type(_)) {
            if (target.data is .handle_type(_)) { return mir.MirCastKind.int_to_ptr; }
            if (target.data is .float_type(_)) { return mir.MirCastKind.int_to_float; }
            if (target.data is .int_type(_)) { return mir.MirCastKind.int_to_int; }
        }
        if (source.data is .float_type(_)) {
            if (target.data is .int_type(_)) { return mir.MirCastKind.float_to_int; }
            if (target.data is .float_type(_)) { return mir.MirCastKind.float_to_float; }
        }
        return mir.MirCastKind.bitcast;
    }

    () lower_slice(hir.HirId node_id, hir.HirSliceAccess slice_access, mir.MirPlace destination) {
        mir.MirPlace base = self.pointer_base_place(slice_access.base);
        self.push_assign(
            destination,
            mir.slice_rvalue(mir.MirSliceRvalue {
                base: base,
                start: self.optional_slice_bound(slice_access.start),
                end: self.optional_slice_bound(slice_access.end)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_struct_literal(hir.HirId node_id, hir.HirStructLiteral literal, mir.MirPlace destination) {
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.ctx.query.types.get(type_id).data is .named(named) else {
            self.mark_unsupported(node_id);
            return;
        }
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.args);
        guard self.append_struct_literal_fields(literal, named.def_id, substitutions$.ref(), fields$.ref()) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: self.struct_literal_aggregate_kind(named.def_id),
                def_id: named.def_id,
                type_id: type_id,
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool append_struct_literal_fields(
        hir.HirStructLiteral literal,
        qid.DefId owner_def,
        monomorph.SubstitutionMap& substitutions,
        list.ArrayList<mir.MirOperand>& fields
    ) {
        guard self.lowerer.hirs.def(owner_def) is some owner_hir else { return false; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.query.defs.get(member_def).kind == .field_def) {
                guard self.struct_literal_field_value(literal, member_def) is some value else { return false; }
                guard self.field_expected_type(member_def, substitutions) is some field_type else { return false; }
                fields.add(self.lower_to_operand_as_type(value, field_type));
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? field_expected_type(qid.DefId field_def, monomorph.SubstitutionMap& substitutions) {
        guard self.lowerer.typeck.def_type(field_def) is some type_id else { return null; }
        return self.lowerer.substitute_type(type_id, substitutions);
    }

    mir.MirOperand lower_to_operand_as_type(hir.HirId node_id, qid.TypeId expected) {
        mir.MirOperand value = self.lower_to_operand(node_id);
        if (self.value_needs_optional_lift(value, expected)) {
            return self.lower_optional_lift_operand(node_id, value, expected);
        }
        return self.lower_error_union_lift_if_needed(node_id, value, expected);
    }

    Bool value_needs_optional_lift(mir.MirOperand value, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.ctx.query.types.get(expected);
        guard expected_info.data is .optional(_) else { return false; }
        qid.TypeId actual = self.mir_operand_type(value);
        if (self.same_type(actual, expected)) {
            return false;
        }
        types.TypeInfo actual_info = self.lowerer.ctx.query.types.get(actual);
        if (actual_info.data is .invalid) { return false; }
        if (actual_info.data is .never) { return false; }
        return true;
    }

    mir.MirOperand lower_optional_lift_operand(hir.HirId node_id, mir.MirOperand value, qid.TypeId expected) {
        mir.MirLocalId temp = self.add_temp(expected, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.make_some,
                value: value
            }),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: temp_place});
    }

    mir.MirOperand lower_error_union_lift_if_needed(
        hir.HirId node_id,
        mir.MirOperand value,
        qid.TypeId expected
    ) {
        if (self.value_needs_error_union_lift(value, expected)) {
            return self.lower_error_union_lift_operand(node_id, value, expected);
        }
        return value;
    }

    Bool value_needs_error_union_lift(mir.MirOperand value, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.ctx.query.types.get(expected);
        guard expected_info.data is .error_union(_) else { return false; }
        qid.TypeId actual = self.mir_operand_type(value);
        if (self.same_type(actual, expected)) {
            return false;
        }
        types.TypeInfo actual_info = self.lowerer.ctx.query.types.get(actual);
        if (actual_info.data is .invalid) { return false; }
        if (actual_info.data is .never) { return false; }
        return true;
    }

    mir.MirOperand lower_error_union_lift_operand(hir.HirId node_id, mir.MirOperand value, qid.TypeId expected) {
        mir.MirLocalId temp = self.add_temp(expected, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.make_value,
                value: value
            }),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: temp_place});
    }

    qid.TypeId mir_operand_type(mir.MirOperand value) {
        if (value is .const_operand(const_value)) {
            return const_value.type_id;
        }
        if (value is .copy_operand(copy_value)) {
            return self.mir_place_type(copy_value.place);
        }
        if (value is .move_operand(move_value)) {
            return self.mir_place_type(move_value.place);
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.lowerer.ctx.query.types.get(lhs);
        types.TypeInfo rhs_info = self.lowerer.ctx.query.types.get(rhs);
        return self.same_type_data(lhs_info.data, rhs_info.data);
    }

    Bool same_type_data(types.TypeData lhs, types.TypeData rhs) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return self.same_named_type(lhs_named, rhs_named);
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            return self.same_type_list(lhs_tuple.items, rhs_tuple.items);
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind && self.same_type(lhs_handle.element, rhs_handle.element);
        }
        if (lhs is .error_union(lhs_error)) {
            guard rhs is .error_union(rhs_error) else { return false; }
            return self.same_type(lhs_error.value, rhs_error.value)
                && self.same_type(lhs_error.error, rhs_error.error);
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type(lhs_optional.element, rhs_optional.element);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return lhs_array.count == rhs_array.count && self.same_type(lhs_array.element, rhs_array.element);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return self.same_type(lhs_function.result, rhs_function.result)
                && self.same_type_list(lhs_function.params, rhs_function.params);
        }
        return false;
    }

    Bool same_named_type(types.NamedType lhs, types.NamedType rhs) {
        if (lhs.def_id.to_index() != rhs.def_id.to_index()) {
            return false;
        }
        return self.same_type_list(lhs.args, rhs.args);
    }

    Bool same_type_list(qid.TypeId[] lhs, qid.TypeId[] rhs) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.length) {
            if (!self.same_type(lhs[index], rhs[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    hir.HirId? struct_literal_field_value(hir.HirStructLiteral literal, qid.DefId field_def) {
        qid.SymbolId field_symbol = self.lowerer.ctx.query.defs.get(field_def).name.symbol;
        Int! index = 0;
        while (index < literal.fields.length) {
            if (qid.SymbolId.equal(literal.fields[index].field_symbol$.ref(), field_symbol$.ref())) {
                return literal.fields[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirAggregateKind struct_literal_aggregate_kind(qid.DefId def_id) {
        if (self.lowerer.ctx.query.defs.get(def_id).kind == .record_def) {
            return mir.MirAggregateKind.record_value;
        }
        return mir.MirAggregateKind.struct_value;
    }

    () lower_tuple_literal(hir.HirId node_id, hir.HirTupleLiteral literal, mir.MirPlace destination) {
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>(literal.items.length);
        qid.TypeId[] item_types = self.tuple_item_types(node_id);
        Int! index = 0;
        while (index < literal.items.length) {
            fields.add(self.lower_tuple_item_operand(literal.items[index], item_types, index));
            index = index + 1;
        }
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: mir.MirAggregateKind.tuple,
                def_id: null,
                type_id: self.type_for_node(node_id),
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    qid.TypeId[] tuple_item_types(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .tuple_type(tuple_type)) {
            return tuple_type.items;
        }
        return self.lowerer.output.empty_type_args();
    }

    mir.MirOperand lower_tuple_item_operand(hir.HirId item, qid.TypeId[] item_types, Int index) {
        if (index < item_types.length) {
            return self.lower_to_operand_as_type(item, item_types[index]);
        }
        return self.lower_to_operand(item);
    }

    () lower_array_literal(hir.HirId node_id, hir.HirArrayLiteral literal, mir.MirPlace destination) {
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>(literal.items.length);
        qid.TypeId element_type = self.array_element_type(node_id);
        Int! index = 0;
        while (index < literal.items.length) {
            fields.add(self.lower_to_operand_as_type(literal.items[index], element_type));
            index = index + 1;
        }
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: mir.MirAggregateKind.array,
                def_id: null,
                type_id: self.type_for_node(node_id),
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    qid.TypeId array_element_type(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    mir.MirOperand? optional_slice_bound(hir.HirId? bound) {
        if (bound is some bound_id) {
            return self.lower_to_operand(bound_id);
        }
        return null;
    }

    // 如果 base 本身不是 place（例如返回 pointer 的 call），先落入临时
    // local，再在这个 local 上追加 deref projection。
    mir.MirPlace? pointer_deref_place(hir.HirId base_id) {
        mir.MirPlace! base_place = self.pointer_base_place(base_id);
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base_place.projection.length + 1);
        Int! index = 0;
        while (index < base_place.projection.length) {
            elems.add(base_place.projection[index]);
            index = index + 1;
        }
        elems.add(.deref_projection(mir.MirDerefProjection {raw_pointer: self.is_raw_pointer_type(base_id)}));
        return self.place_with_projection(base_place.local_id, elems$.ref());
    }

    mir.MirPlace project_deref(mir.MirPlace base, Bool raw_pointer) {
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int! index = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(.deref_projection(mir.MirDerefProjection {raw_pointer: raw_pointer}));
        return self.place_with_projection(base.local_id, elems$.ref());
    }

    mir.MirPlace place_with_projection(mir.MirLocalId local_id, list.ArrayList<mir.MirPlaceElem>& elems) {
        return mir.MirPlace {
            local_id: local_id,
            projection: self.lowerer.output.projection_array(elems)
        };
    }

    mir.MirPlace pointer_base_place(hir.HirId base_id) {
        if (self.place_for_expr(base_id) is some place) {
            return place;
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(base_id), self.lowerer.hir_span(base_id));
        self.lower_into_place(base_id, self.place_for_local(temp));
        return self.place_for_local(temp);
    }

    Bool is_raw_pointer_type(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo type_info = self.lowerer.ctx.query.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    mir.MirOperand lower_to_operand(hir.HirId node_id) {
        if (self.move_operand_for_expr(node_id) is some operand) {
            return operand;
        }
        if (self.can_lower_as_direct_operand(node_id)) {
            return self.lower_operand(node_id);
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
        return mir.copy_operand_value(mir.MirCopyOperand {place: self.place_for_local(temp)});
    }

    mir.MirOperand? move_operand_for_expr(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .implicit_call(call) else {
            return null;
        }
        if (call.op == .move) {
            guard self.place_for_expr(call.base) is some source else {
                self.mark_unsupported(node_id);
                return null;
            }
            return mir.move_operand_value(mir.MirMoveOperand {place: source});
        }
        return null;
    }

    Bool can_lower_as_direct_operand(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(_)) { return true; }
        if (node.data is .name_ref(_)) { return true; }
        if (node.data is .member_access(_)) {
            if (self.place_for_expr(node_id) is some _) {
                return true;
            }
            return false;
        }
        if (node.data is .index_access(_)) { return true; }
        return false;
    }

    mir.MirOperand lower_operand(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return mir.const_operand_value(self.lower_const(node_id, literal));
        }
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                mir.MirPlace place = self.place_for_local(self.mir_local_for_hir(local_id));
                return mir.copy_operand_value(mir.MirCopyOperand {place: place});
            }
            if (name_ref is .def_ref(def_id)) {
                return self.lower_def_operand(node_id, def_id);
            }
        }
        if (node.data is .member_access(_)) {
            if (self.enum_value_operand(node_id) is some value) {
                return value;
            }
            if (self.lowerer.typeck.member_selection(node_id) is some member_def) {
                if (self.lowerer.ctx.query.defs.get(member_def).kind == .enum_case_def) {
                    return self.lower_def_operand(node_id, member_def);
                }
                if (self.def_can_be_function_operand(member_def)) {
                    return self.lower_def_operand(node_id, member_def);
                }
            }
        }
        if (self.place_for_expr(node_id) is some place) {
            return mir.copy_operand_value(mir.MirCopyOperand {place: place});
        }
        return self.unsupported_operand(node_id);
    }

    () lower_member_access(hir.HirId node_id, hir.HirMemberAccess member_access, mir.MirPlace destination) {
        if (self.lowerer.typeck.member_selection(node_id) is some member_def) {
            def.DefKind kind = self.lowerer.ctx.query.defs.get(member_def).kind;
            if (kind == .union_variant_def) {
                self.lower_empty_union_variant_value(node_id, member_def, destination);
                return;
            }
            if (kind == .enum_case_def || self.def_can_be_function_operand(member_def)) {
                self.push_assign(
                    destination,
                    mir.use_rvalue(mir.MirUseRvalue {value: self.lower_def_operand(node_id, member_def)}),
                    self.lowerer.hir_span(node_id)
                );
                return;
            }
        }
        mir.MirOperand value = self.lower_operand(node_id);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue {value: value}), self.lowerer.hir_span(node_id));
    }

    () lower_empty_union_variant_value(hir.HirId node_id, qid.DefId variant_def, mir.MirPlace destination) {
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: mir.MirAggregateKind.union_variant,
                def_id: variant_def,
                type_id: self.type_for_node(node_id),
                tag: self.union_variant_tag_operand(node_id, variant_def),
                payload_field_index: self.union_variant_payload_field_index(node_id, variant_def),
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand lower_def_operand(hir.HirId node_id, qid.DefId def_id) {
        if (self.lowerer.ctx.query.defs.get(def_id).kind == .enum_case_def) {
            return mir.const_operand_value(mir.MirConst {
                type_id: self.type_for_node(node_id),
                span: self.lowerer.hir_span(node_id),
                value: mir.int_const_kind(mir.MirIntConst {
                    bits: UInt64(self.variant_tag_index(def_id)),
                    signed_value: true
                })
            });
        }
        if (!self.def_can_be_function_operand(def_id)) {
            return self.unsupported_operand(node_id);
        }
        self.lowerer.ensure_external_function(def_id);
        qid.TypeId[] type_args = self.function_const_type_args(node_id, def_id);
        return mir.const_operand_value(mir.MirConst {
            type_id: self.type_for_node(node_id),
            span: self.lowerer.hir_span(node_id),
            value: mir.function_const_kind(mir.MirFunctionConst {
                function_def: def_id,
                type_args: type_args
            })
        });
    }

    Bool def_can_be_function_operand(qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.query.defs.get(def_id).kind;
        if (kind == .function_def || kind == .init_def) {
            return true;
        }
        return kind == .deinit_def;
    }

    qid.TypeId[] function_const_type_args(hir.HirId node_id, qid.DefId def_id) {
        if (self.lowerer.typeck.generic_instance(node_id) is some instance) {
            if (instance.def_id == def_id) {
                qid.TypeId[] type_args = self.substituted_type_arg_array(instance.type_args);
                if (self.lowerer.type_args_are_concrete(type_args)) {
                    return type_args;
                }
            }
        }
        if (self.member_receiver_type_args(node_id, def_id) is some receiver_args) {
            return self.lowerer.output.type_arg_array(receiver_args);
        }
        list.ArrayList<qid.TypeId> args = self.current_instance_type_args(def_id);
        if (args.len() > 0) {
            return self.lowerer.output.type_arg_array(args.data[0..args.len()]);
        }
        return self.lowerer.output.empty_type_args();
    }

    qid.TypeId[]? member_receiver_type_args(hir.HirId node_id, qid.DefId def_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .member_access(member_access) else { return null; }
        guard self.lowerer.ctx.query.defs.get(def_id).owner_def is some owner_def else { return null; }
        qid.TypeId base_type = self.type_for_node(member_access.base);
        guard self.named_receiver_type(base_type) is some named else { return null; }
        if (named.def_id != owner_def || named.args.length == 0) {
            return null;
        }
        return named.args;
    }

    types.NamedType? named_receiver_type(qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .named(named)) {
            return named;
        }
        if (info.data is .handle_type(handle)) {
            types.TypeInfo element_info = self.lowerer.ctx.query.types.get(handle.element);
            if (element_info.data is .named(named)) {
                return named;
            }
        }
        return null;
    }

    list.ArrayList<qid.TypeId> current_instance_type_args(qid.DefId def_id) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>();
        if (self.lowerer.ctx.query.defs.get(def_id).owner_def is some owner_def) {
            self.add_current_generic_args(owner_def, args$.ref());
        }
        self.add_current_generic_args(def_id, args$.ref());
        return args$.move();
    }

    () add_current_generic_args(qid.DefId def_id, list.ArrayList<qid.TypeId>& args) {
        guard self.lowerer.hirs.def(def_id) is some hir_def else { return; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.lowerer.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                if (self.substitutions.get(member_def) is some type_id) {
                    args.add(type_id);
                }
            }
            index = index + 1;
        }
    }

    mir.MirOperand? enum_value_operand(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .member_access(member_access) else { return null; }
        if (!self.enum_value_access(member_access)) {
            return null;
        }
        return self.lower_to_operand(member_access.base);
    }

    Bool enum_value_access(hir.HirMemberAccess member_access) {
        if (!self.symbol_text_equal(member_access.member_symbol, "value")) {
            return false;
        }
        qid.TypeId base_type = self.type_for_node(member_access.base);
        guard self.nominal_def_kind(base_type) is some kind else { return false; }
        return kind == .enum_def;
    }

    mir.MirPlace? place_for_expr(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                return self.place_for_local(self.mir_local_for_hir(local_id));
            }
            return null;
        }
        if (node.data is .member_access(member_access)) {
            return self.place_for_member(node_id, member_access);
        }
        if (node.data is .index_access(index_access)) {
            return self.place_for_index(index_access);
        }
        return null;
    }

    mir.MirPlace? place_for_member(hir.HirId node_id, hir.HirMemberAccess member_access) {
        if (self.is_slice_length_access(member_access)) {
            mir.MirPlace base = self.pointer_base_place(member_access.base);
            return self.project_constant_index(base, 1);
        }
        guard self.lowerer.typeck.member_selection(node_id) is some member_def else {
            return null;
        }
        if (self.lowerer.ctx.query.defs.get(member_def).kind != .field_def) {
            return null;
        }
        mir.MirPlace! base = self.pointer_base_place(member_access.base);
        if (self.member_base_needs_deref(member_access.base)) {
            base = self.project_deref(base, self.is_raw_pointer_type(member_access.base));
        }
        return self.project_field(base, member_def, self.type_for_node(node_id));
    }

    Bool member_base_needs_deref(hir.HirId base_id) {
        qid.TypeId base_type = self.type_for_node(base_id);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .raw_pointer;
    }

    // MIR 的 field projection 必须在这里固化成 layout field index。backend 只能
    // 按 index 取地址，不能再根据 DefId/name 重新解释语言层字段关系。
    mir.MirPlace project_field(mir.MirPlace base, qid.DefId field_def, qid.TypeId field_type) {
        qid.TypeId owner_type = self.mir_place_type(base);
        guard self.layout_field_index_for_def(owner_type, field_def) is some field_index else {
            self.lowerer.output.mark_error();
            self.add_field_projection_layout_diagnostic(owner_type, field_def);
            return base;
        }
        return self.project_field_at_index(base, field_def, field_type, field_index);
    }

    mir.MirPlace project_field_at_index(
        mir.MirPlace base,
        qid.DefId field_def,
        qid.TypeId field_type,
        Int field_index
    ) {
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int! index = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(.field_projection(mir.MirFieldProjection {
            field_def: field_def,
            field_type: field_type,
            field_index: field_index
        }));
        return mir.MirPlace {
            local_id: base.local_id,
            projection: self.lowerer.output.projection_array(elems$.ref())
        };
    }

    qid.TypeId mir_place_type(mir.MirPlace place) {
        qid.TypeId! current = self.locals.get(place.local_id.to_index()).type_id;
        Int! index = 0;
        while (index < place.projection.length) {
            mir.MirPlaceElem elem = place.projection[index];
            if (elem is .field_projection(field)) {
                current = field.field_type;
            } else if (elem is .constant_index_projection(constant_index)) {
                current = self.layout_for_type(current).fields[constant_index.offset].field_type;
            } else {
                current = self.pointer_like_element_type(current);
            }
            index = index + 1;
        }
        return current;
    }

    qid.TypeId pointer_like_element_type(qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            return handle.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    Int? layout_field_index_for_def(qid.TypeId owner_type, qid.DefId field_def) {
        layout.TypeLayout owner_layout = self.layout_for_type(owner_type);
        Int! index = 0;
        while (index < owner_layout.fields.length) {
            if (owner_layout.fields[index].field_def is some candidate) {
                if (candidate.to_index() == field_def.to_index()) {
                    return index;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Bool is_slice_length_access(hir.HirMemberAccess member_access) {
        if (!self.symbol_text_equal(member_access.member_symbol, "length")) {
            return false;
        }
        qid.TypeId base_type = self.type_for_node(member_access.base);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .slice;
    }

    Bool symbol_text_equal(qid.SymbolId symbol, UInt8[] text) {
        return string.equal(self.lowerer.ctx.query.symbols.text(symbol), text);
    }

    mir.MirPlace project_constant_index(mir.MirPlace base, Int offset) {
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int! index = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(.constant_index_projection(mir.MirConstantIndexProjection {offset: offset}));
        return mir.MirPlace {
            local_id: base.local_id,
            projection: self.lowerer.output.projection_array(elems$.ref())
        };
    }

    mir.MirPlace? place_for_index(hir.HirIndexAccess index_access) {
        guard self.place_for_expr(index_access.base) is some base else {
            return null;
        }
        mir.MirLocalId index_local = self.index_local_for_expr(index_access.index);
        return self.project_index(base, index_local);
    }

    mir.MirLocalId index_local_for_expr(hir.HirId index_id) {
        if (self.place_for_expr(index_id) is some index_place) {
            if (index_place.projection.length == 0) {
                return index_place.local_id;
            }
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(index_id), self.lowerer.hir_span(index_id));
        self.lower_into_place(index_id, self.place_for_local(temp));
        return temp;
    }

    mir.MirPlace project_index(mir.MirPlace base, mir.MirLocalId index_local) {
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int! index = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(.index_projection(mir.MirIndexProjection {index_local: index_local}));
        return mir.MirPlace {
            local_id: base.local_id,
            projection: self.lowerer.output.projection_array(elems$.ref())
        };
    }

    () finish_return(Bool implicit_unit, token.Span span) {
        self.finish_block(mir.return_terminator_kind(mir.MirReturnTerminator {implicit_unit: implicit_unit}), span);
    }

    mir.MirConst lower_const(hir.HirId node_id, hir.HirLiteral literal) {
        token.Span span = self.lowerer.hir_span(node_id);
        // literal 的目标类型也可能是泛型参数，例如 T id<T>(T value)
        // 内部的返回值；type_for_node 会自动套用当前 instance substitution。
        qid.TypeId type_id = self.type_for_node(node_id);
        return self.lower_literal_as_const(node_id, literal, type_id);
    }

    mir.MirConst lower_literal_as_const(hir.HirId node_id, hir.HirLiteral literal, qid.TypeId type_id) {
        token.Span span = self.lowerer.hir_span(node_id);
        if (literal.value is .int_value(int_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst {bits: int_value.bits, signed_value: int_value.signed_value})
            };
        }
        if (literal.value is .float_value(float_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.float_const_kind(mir.MirFloatConst {value: float_value.value})
            };
        }
        if (literal.value is .bool_value(bool_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.bool_const_kind(mir.MirBoolConst {value: bool_value})
            };
        }
        if (literal.value is .string_value(symbol_id)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.string_const_kind(mir.MirStringConst {symbol_id: symbol_id})
            };
        }
        if (literal.value is .char_value(char_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst {bits: UInt64(char_value), signed_value: false})
            };
        }
        if (literal.value is .null_value) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: mir.null_const_kind(mir.MirNullConst {typed_null: true})
            };
        }
        return mir.MirConst {
            type_id: type_id,
            span: span,
            value: mir.unit_const_kind(mir.MirUnitConst {unit_value: true})
        };
    }

    () lower_call(hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.target is some target) {
            def.DefKind kind = self.lowerer.ctx.query.defs.get(target.def_id).kind;
            if (kind == .builtin_value_def && self.is_builtin_call(target.def_id, "assert")) {
                self.lower_builtin_assert(node_id, call);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, target.def_id, destination);
                return;
            }
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, target.def_id, destination);
                return;
            }
        }
        if (self.lowerer.ctx.query.typeck.member_selection(call.callee) is some member_def) {
            def.DefKind kind = self.lowerer.ctx.query.defs.get(member_def).kind;
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, member_def, destination);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, member_def, destination);
                return;
            }
        }
        if (self.lowerer.typeck.type_constructor_init(node_id) is some constructor_kind) {
            self.lower_type_constructor_init(node_id, call, constructor_kind, destination);
            return;
        }
        list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>(call.args.length);
        mir.MirOperand callee = self.lower_to_operand(call.callee);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator {
            callee: callee,
            args: self.lowerer.output.operand_array(args$.ref()),
            destination: destination,
            target: next_block,
            cleanup: null
        }), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_type_constructor_init(
        hir.HirId node_id,
        hir.HirCall call,
        sema_result.TypeConstructorKind constructor_kind,
        mir.MirPlace destination
    ) {
        if (constructor_kind == .builtin_numeric) {
            self.lower_builtin_numeric_init(node_id, call, destination);
            return;
        }
        self.lower_default_nominal_init(node_id, call, destination);
    }

    () lower_builtin_numeric_init(hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.args[0]);
        qid.TypeId target_type = self.type_for_node(node_id);
        // builtin numeric init 目前没有用户可见函数体；MIR 用 cast_value
        // 表达底层转换，仍由 type check 的 constructor side table 触发。
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue {
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.args[0]),
                target_type: target_type
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_default_nominal_init(hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.ctx.query.types.get(type_id).data is .named(named) else {
            self.mark_unsupported(node_id);
            return;
        }
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: self.struct_literal_aggregate_kind(named.def_id),
                def_id: named.def_id,
                type_id: type_id,
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_call_to_function_def(
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId function_def,
        mir.MirPlace destination
    ) {
        qid.DefId target_def = self.concrete_call_target(call, function_def);
        list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        qid.TypeId! function_type = self.lowerer.ctx.query.types.invalid_type();
        if (self.lowerer.typeck.def_type(target_def) is some type_id) {
            function_type = type_id;
        }
        qid.TypeId[] type_args = self.function_call_type_args(node_id, call, target_def);
        if (type_args.length > 0) {
            self.lowerer.ensure_function_instance(target_def, type_args);
        } else {
            self.lowerer.ensure_external_function(target_def);
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator {
            callee: self.function_const_operand_with_args(
                call.callee,
                target_def,
                function_type,
                type_args
            ),
            args: self.lowerer.output.operand_array(args$.ref()),
            destination: destination,
            target: next_block,
            cleanup: null
        }), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    qid.DefId concrete_call_target(hir.HirCall call, qid.DefId function_def) {
        guard self.trait_owner_for_def(function_def) is some trait_def else {
            return function_def;
        }
        guard self.concrete_static_receiver_def(call.callee) is some receiver_def else {
            return function_def;
        }
        qid.SymbolId member_symbol = self.lowerer.ctx.query.defs.get(function_def).name.symbol;
        if (self.member_def_by_symbol(receiver_def, member_symbol) is some member_def) {
            return member_def;
        }
        return function_def;
    }

    qid.DefId? trait_owner_for_def(qid.DefId function_def) {
        guard self.lowerer.ctx.query.defs.get(function_def).owner_def is some owner_def else {
            return null;
        }
        if (self.lowerer.ctx.query.defs.get(owner_def).kind == .trait_def) {
            return owner_def;
        }
        return null;
    }

    qid.DefId? concrete_static_receiver_def(hir.HirId callee_id) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        qid.TypeId receiver_type = self.type_for_node(member_access.base);
        types.TypeInfo receiver_info = self.lowerer.ctx.query.types.get(receiver_type);
        guard receiver_info.data is .named(named) else { return null; }
        def.DefKind kind = self.lowerer.ctx.query.defs.get(named.def_id).kind;
        if (kind == .generic_param_def || kind == .trait_def) {
            return null;
        }
        return named.def_id;
    }

    qid.DefId? member_def_by_symbol(qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.lowerer.hirs.def(owner_def) is some owner_hir else { return null; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            def.DefRecord member_record = self.lowerer.ctx.query.defs.get(member_def);
            qid.SymbolId member_symbol = member_record.name.symbol;
            if (member_symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirOperand function_const_operand(hir.HirId node_id, qid.DefId function_def, qid.TypeId function_type) {
        qid.TypeId[]! type_args = self.lowerer.output.empty_type_args();
        if (self.lowerer.typeck.generic_instance(node_id) is some instance) {
            if (instance.def_id == function_def) {
                type_args = self.substituted_type_arg_array(instance.type_args);
            }
        }
        return self.function_const_operand_with_args(node_id, function_def, function_type, type_args);
    }

    mir.MirOperand function_const_operand_with_args(
        hir.HirId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        qid.TypeId[] type_args
    ) {
        return mir.const_operand_value(mir.MirConst {
            type_id: function_type,
            span: self.lowerer.hir_span(node_id),
            value: mir.function_const_kind(mir.MirFunctionConst {
                function_def: function_def,
                type_args: type_args
            })
        });
    }

    qid.TypeId[] function_call_type_args(hir.HirId node_id, hir.HirCall call, qid.DefId function_def) {
        if (self.lowerer.typeck.generic_instance(node_id) is some instance) {
            if (instance.def_id == function_def) {
                qid.TypeId[] type_args = self.substituted_type_arg_array(instance.type_args);
                if (self.lowerer.type_args_are_concrete(type_args)) {
                    return type_args;
                }
            }
        }
        if (call.type_args.length > 0) {
            return self.type_args_for_refs(call.type_args);
        }
        if (self.infer_function_type_args(call, function_def) is some inferred_args) {
            return inferred_args;
        }
        if (self.member_receiver_type_args(call.callee, function_def) is some receiver_args) {
            return self.lowerer.output.type_arg_array(receiver_args);
        }
        guard self.lowerer.ctx.query.defs.get(function_def).owner_def is some owner_def else {
            return self.function_const_type_args(call.callee, function_def);
        }
        if (call.args.length == 0) {
            return self.function_const_type_args(call.callee, function_def);
        }
        qid.TypeId first_arg_type = self.type_for_node(call.args[0]);
        types.TypeInfo first_arg_info = self.lowerer.ctx.query.types.get(first_arg_type);
        if (first_arg_info.data is .named(named)) {
            if (named.def_id == owner_def && named.args.length > 0) {
                return self.lowerer.output.type_arg_array(named.args);
            }
        }
        return self.function_const_type_args(call.callee, function_def);
    }

    qid.TypeId[] substituted_type_arg_array(qid.TypeId[] type_args) {
        if (self.substitutions.len() == 0) {
            return self.lowerer.output.type_arg_array(type_args);
        }
        list.ArrayList<qid.TypeId>! substituted = list.ArrayList<qid.TypeId>(type_args.length);
        Int! index = 0;
        while (index < type_args.length) {
            substituted.add(self.lowerer.substitute_type(type_args[index], self.substitutions));
            index = index + 1;
        }
        return self.lowerer.output.type_arg_array(substituted.data[0..substituted.len()]);
    }

    qid.TypeId[] type_args_for_refs(hir.HirId[] type_refs) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(type_refs.length);
        Int! index = 0;
        while (index < type_refs.length) {
            args.add(self.type_for_node(type_refs[index]));
            index = index + 1;
        }
        return self.lowerer.output.type_arg_array(args.data[0..args.len()]);
    }

    qid.TypeId[]? infer_function_type_args(hir.HirCall call, qid.DefId function_def) {
        list.ArrayList<qid.DefId> param_defs = self.generic_param_defs(function_def);
        if (param_defs.len() == 0) {
            return null;
        }
        guard self.lowerer.typeck.def_type(function_def) is some function_type_id else { return null; }
        types.TypeInfo info = self.lowerer.ctx.query.types.get(function_type_id);
        guard info.data is .function_type(function_type) else { return null; }

        list.ArrayList<qid.TypeId>! inferred = list.ArrayList<qid.TypeId>(param_defs.len());
        Int! index = 0;
        while (index < param_defs.len()) {
            inferred.add(self.lowerer.ctx.query.types.invalid_type());
            index = index + 1;
        }
        index = 0;
        while (index < call.args.length && index < function_type.params.length) {
            self.infer_type_arg(function_type.params[index], self.type_for_node(call.args[index]), param_defs$.ref(), inferred$.ref());
            index = index + 1;
        }
        if (!self.inferred_type_args_complete(inferred$.ref())) {
            return null;
        }
        return self.lowerer.output.type_arg_array(inferred.data[0..inferred.len()]);
    }

    list.ArrayList<qid.DefId> generic_param_defs(qid.DefId function_def) {
        list.ArrayList<qid.DefId>! params = list.ArrayList<qid.DefId>();
        if (self.lowerer.ctx.query.defs.get(function_def).owner_def is some owner_def) {
            self.add_generic_param_defs(owner_def, params$.ref());
        }
        self.add_generic_param_defs(function_def, params$.ref());
        if (params.len() == 0) {
            self.add_generic_param_defs_from_signature(function_def, params$.ref());
        }
        return params$.move();
    }

    () add_generic_param_defs(qid.DefId owner_def, list.ArrayList<qid.DefId>& params) {
        guard self.lowerer.hirs.def(owner_def) is some hir_def else { return; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.lowerer.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                params.add(member_def);
            }
            index = index + 1;
        }
    }

    () add_generic_param_defs_from_signature(qid.DefId function_def, list.ArrayList<qid.DefId>& params) {
        guard self.lowerer.typeck.def_type(function_def) is some function_type_id else { return; }
        types.TypeInfo info = self.lowerer.ctx.query.types.get(function_type_id);
        guard info.data is .function_type(function_type) else { return; }
        Int! index = 0;
        while (index < function_type.params.length) {
            self.add_generic_param_defs_from_type(function_type.params[index], params);
            index = index + 1;
        }
        self.add_generic_param_defs_from_type(function_type.result, params);
    }

    () add_generic_param_defs_from_type(qid.TypeId type_id, list.ArrayList<qid.DefId>& params) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .named(named)) {
            self.add_generic_param_defs_from_named(named, params);
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.add_generic_param_defs_from_type(handle.element, params);
        }
    }

    () add_generic_param_defs_from_named(types.NamedType named, list.ArrayList<qid.DefId>& params) {
        if (self.lowerer.ctx.query.defs.get(named.def_id).kind == .generic_param_def) {
            self.add_unique_generic_param_def(named.def_id, params);
            return;
        }
        Int! index = 0;
        while (index < named.args.length) {
            self.add_generic_param_defs_from_type(named.args[index], params);
            index = index + 1;
        }
    }

    () add_unique_generic_param_def(qid.DefId def_id, list.ArrayList<qid.DefId>& params) {
        if (self.generic_param_index(params, def_id) != null) {
            return;
        }
        params.add(def_id);
    }

    () infer_type_arg(
        qid.TypeId template_type,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        types.TypeInfo template_info = self.lowerer.ctx.query.types.get(template_type);
        if (template_info.data is .named(named)) {
            self.infer_named_type_arg(named, actual_type, param_defs, inferred);
            return;
        }
        if (template_info.data is .handle_type(template_handle)) {
            self.infer_handle_type_arg(template_handle, actual_type, param_defs, inferred);
        }
    }

    () infer_named_type_arg(
        types.NamedType template_named,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        if (self.generic_param_index(param_defs, template_named.def_id) is some param_index) {
            inferred.set(param_index, actual_type);
            return;
        }
        types.TypeInfo actual_info = self.lowerer.ctx.query.types.get(actual_type);
        guard actual_info.data is .named(actual_named) else { return; }
        if (template_named.def_id != actual_named.def_id) {
            return;
        }
        Int! index = 0;
        while (index < template_named.args.length && index < actual_named.args.length) {
            self.infer_type_arg(template_named.args[index], actual_named.args[index], param_defs, inferred);
            index = index + 1;
        }
    }

    () infer_handle_type_arg(
        types.HandleType template_handle,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        types.TypeInfo actual_info = self.lowerer.ctx.query.types.get(actual_type);
        guard actual_info.data is .handle_type(actual_handle) else { return; }
        if (template_handle.kind != actual_handle.kind) {
            return;
        }
        self.infer_type_arg(template_handle.element, actual_handle.element, param_defs, inferred);
    }

    Int? generic_param_index(list.ArrayList<qid.DefId>& param_defs, qid.DefId def_id) {
        Int! index = 0;
        while (index < param_defs.len()) {
            if (param_defs.get(index).to_index() == def_id.to_index()) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    Bool inferred_type_args_complete(list.ArrayList<qid.TypeId>& inferred) {
        Int! index = 0;
        while (index < inferred.len()) {
            if (self.lowerer.ctx.query.types.get(inferred.get(index)).data is .invalid) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool is_builtin_call(qid.DefId def_id, UInt8[] name) {
        def.DefRecord def_record = self.lowerer.ctx.query.defs.get(def_id);
        return string.equal(self.lowerer.ctx.query.symbols.text(def_record.name.symbol), name);
    }

    () lower_builtin_assert(hir.HirId node_id, hir.HirCall call) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.assert_terminator_kind(mir.MirAssertTerminator {
            condition: self.lower_to_operand(call.args[0]),
            expected: true,
            message: null,
            target: next_block,
            cleanup: null
        }), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_union_variant_constructor(
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId variant_def,
        mir.MirPlace destination
    ) {
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            fields.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue {
                kind: mir.MirAggregateKind.union_variant,
                def_id: variant_def,
                type_id: self.type_for_node(node_id),
                tag: self.union_variant_tag_operand(node_id, variant_def),
                payload_field_index: self.union_variant_payload_field_index(node_id, variant_def),
                fields: self.lowerer.output.operand_array(fields$.ref())
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand unsupported_operand(hir.HirId node_id) {
        self.mark_unsupported(node_id);
        return mir.const_operand_value(mir.MirConst {
            type_id: self.lowerer.ctx.query.types.invalid_type(),
            span: self.lowerer.hir_span(node_id),
            value: mir.unit_const_kind(mir.MirUnitConst {unit_value: true})
        });
    }

    mir.MirOperand union_variant_tag_operand(hir.HirId node_id, qid.DefId variant_def) {
        return mir.const_operand_value(self.variant_tag_const(
            node_id,
            variant_def,
            self.lowerer.ctx.query.types.int_type()
        ));
    }

    Int union_variant_payload_field_index(hir.HirId node_id, qid.DefId variant_def) {
        qid.TypeId owner_type = self.type_for_node(node_id);
        guard self.layout_field_index_for_def(owner_type, variant_def) is some field_index else {
            self.lowerer.output.mark_error();
            self.add_field_projection_layout_diagnostic(owner_type, variant_def);
            return -1;
        }
        return field_index;
    }

    () mark_unsupported(hir.HirId node_id) {
        self.lowerer.output.mark_error();
        self.add_unsupported_diagnostic(node_id);
    }

    () add_unsupported_diagnostic(hir.HirId node_id) {
        diagnostic.SourceRange! range = diagnostic.SourceRange();
        if (self.lowerer.ctx.query.source_map.hir_span(node_id) is some loc) {
            range = self.source_range(loc);
        }
        self.lowerer.ctx.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .lowering,
                diagnostic.DiagnosticCode("mir_unsupported_hir"),
                range,
                string.append("unsupported HIR node for MIR lowering: ", self.hir_node_kind(node_id))
            )
        );
    }

    () add_field_projection_layout_diagnostic(qid.TypeId owner_type, qid.DefId field_def) {
        diagnostic.SourceRange! range = diagnostic.SourceRange();
        if (self.lowerer.ctx.query.source_map.def_span(field_def) is some loc) {
            range = self.source_range(loc);
        }
        self.lowerer.ctx.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .lowering,
                diagnostic.DiagnosticCode("mir_field_projection_layout_mismatch"),
                range,
                self.field_projection_layout_message(owner_type, field_def)
            )
        );
    }

    UInt8[] field_projection_layout_message(qid.TypeId owner_type, qid.DefId field_def) {
        types.TypeInfo owner_info = self.lowerer.ctx.query.types.get(owner_type);
        guard owner_info.data is .named(named) else {
            return "field projection owner is not a nominal type";
        }
        if (self.lowerer.ctx.query.defs.get(field_def).owner_def is some field_owner) {
            if (field_owner.to_index() != named.def_id.to_index()) {
                return "field projection owner type does not match the field owner";
            }
        }
        return "field projection does not exist in the nominal owner layout";
    }

    UInt8[] hir_node_kind(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .block(_)) { return "block"; }
        if (node.data is .name_ref(_)) { return "name_ref"; }
        if (node.data is .member_access(_)) { return "member_access"; }
        if (node.data is .index_access(_)) { return "index_access"; }
        if (node.data is .slice_access(_)) { return "slice_access"; }
        if (node.data is .struct_literal(_)) { return "struct_literal"; }
        if (node.data is .tuple_literal(_)) { return "tuple_literal"; }
        if (node.data is .array_literal(_)) { return "array_literal"; }
        if (node.data is .range_expr(_)) { return "range_expr"; }
        if (node.data is .call(_)) { return "call"; }
        if (node.data is .implicit_call(_)) { return "implicit_call"; }
        if (node.data is .literal(_)) { return "literal"; }
        if (node.data is .let_stmt(_)) { return "let_stmt"; }
        if (node.data is .defer_stmt(_)) { return "defer_stmt"; }
        if (node.data is .guard_stmt(_)) { return "guard_stmt"; }
        if (node.data is .assign_stmt(_)) { return "assign_stmt"; }
        if (node.data is .return_stmt(_)) { return "return_stmt"; }
        if (node.data is .throw_stmt(_)) { return "throw_stmt"; }
        if (node.data is .break_stmt) { return "break_stmt"; }
        if (node.data is .continue_stmt) { return "continue_stmt"; }
        if (node.data is .unary(_)) { return "unary"; }
        if (node.data is .binary(_)) { return "binary"; }
        if (node.data is .if_expr(_)) { return "if_expr"; }
        if (node.data is .loop_expr(_)) { return "loop_expr"; }
        if (node.data is .switch_expr(_)) { return "switch_expr"; }
        if (node.data is .catch_expr(_)) { return "catch_expr"; }
        if (node.data is .is_pattern(_)) { return "is_pattern"; }
        if (node.data is .binding_pattern(_)) { return "binding_pattern"; }
        if (node.data is .literal_pattern(_)) { return "literal_pattern"; }
        if (node.data is .optional_pattern(_)) { return "optional_pattern"; }
        if (node.data is .variant_pattern(_)) { return "variant_pattern"; }
        if (node.data is .wildcard_pattern) { return "wildcard_pattern"; }
        if (node.data is .named_type_ref(_)) { return "named_type_ref"; }
        if (node.data is .layered_type_ref(_)) { return "layered_type_ref"; }
        if (node.data is .array_type_ref(_)) { return "array_type_ref"; }
        if (node.data is .errorable_type_ref(_)) { return "errorable_type_ref"; }
        if (node.data is .function_type_ref(_)) { return "function_type_ref"; }
        if (node.data is .tuple_type_ref(_)) { return "tuple_type_ref"; }
        if (node.data is .infer_type_ref) { return "infer_type_ref"; }
        if (node.data is .unit_type_ref) { return "unit_type_ref"; }
        if (node.data is .invalid_type_ref) { return "invalid_type_ref"; }
        return "invalid";
    }

    diagnostic.SourceRange source_range(source_map.SourceLoc loc) {
        guard loc.source_id is some source_id else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, loc.span);
    }

    () push_assign(mir.MirPlace destination, mir.MirRvalue value, token.Span span) {
        if (self.terminated) { return; }
        mir.MirRvalue normalized = self.normalize_rvalue(value, span);
        self.statements.add(mir.MirStatement {
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement {
                destination: destination,
                value: normalized
            })
        });
    }

    mir.MirRvalue normalize_rvalue(mir.MirRvalue value, token.Span span) {
        if (value is .aggregate_value(aggregate)) {
            return mir.aggregate_rvalue(self.normalize_aggregate(aggregate, span));
        }
        return value;
    }

    mir.MirAggregateRvalue normalize_aggregate(mir.MirAggregateRvalue aggregate, token.Span span) {
        if (aggregate.kind == .union_variant) {
            return aggregate;
        }
        list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>(aggregate.fields.length);
        Int! index = 0;
        while (index < aggregate.fields.length) {
            qid.TypeId field_type = self.aggregate_field_type(aggregate, index);
            fields.add(self.normalize_aggregate_operand(aggregate.fields[index], field_type, span));
            index = index + 1;
        }
        return mir.MirAggregateRvalue {
            kind: aggregate.kind,
            def_id: aggregate.def_id,
            type_id: aggregate.type_id,
            tag: aggregate.tag,
            payload_field_index: aggregate.payload_field_index,
            fields: self.lowerer.output.operand_array(fields$.ref())
        };
    }

    qid.TypeId aggregate_field_type(mir.MirAggregateRvalue aggregate, Int field_index) {
        if (aggregate.def_id is some def_id) {
            if (self.aggregate_nominal_field_type(aggregate.type_id, def_id, field_index) is some field_type) {
                return field_type;
            }
        }
        return self.sequence_aggregate_field_type(aggregate.type_id, field_index);
    }

    qid.TypeId? aggregate_nominal_field_type(qid.TypeId type_id, qid.DefId def_id, Int field_index) {
        guard self.lowerer.hirs.def(def_id) is some hir_def else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution_for_type(type_id, def_id);
        Int! field_count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.lowerer.ctx.query.defs.get(member_def).kind == .field_def) {
                if (field_count == field_index) {
                    return self.field_expected_type(member_def, substitutions$.ref());
                }
                field_count = field_count + 1;
            }
            index = index + 1;
        }
        return null;
    }

    monomorph.SubstitutionMap nominal_substitution_for_type(qid.TypeId type_id, qid.DefId def_id) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .named(named)) {
            return self.nominal_substitution(named.def_id, named.args);
        }
        return self.nominal_substitution(def_id, self.lowerer.output.empty_type_args());
    }

    qid.TypeId sequence_aggregate_field_type(qid.TypeId type_id, Int field_index) {
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .tuple_type(tuple_type)) {
            if (field_index < tuple_type.items.length) { return tuple_type.items[field_index]; }
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    mir.MirOperand normalize_aggregate_operand(mir.MirOperand value, qid.TypeId expected, token.Span span) {
        if (self.value_needs_optional_lift(value, expected)) {
            return self.lower_optional_lift_operand_with_span(value, expected, span);
        }
        return self.lower_error_union_lift_operand_with_span_if_needed(value, expected, span);
    }

    mir.MirOperand lower_optional_lift_operand_with_span(
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        mir.MirLocalId temp = self.add_temp(expected, span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.optional_rvalue(mir.MirOptionalRvalue {
                op: mir.MirOptionalOp.make_some,
                value: value
            }),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: temp_place});
    }

    mir.MirOperand lower_error_union_lift_operand_with_span_if_needed(
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        if (self.value_needs_error_union_lift(value, expected)) {
            return self.lower_error_union_lift_operand_with_span(value, expected, span);
        }
        return value;
    }

    mir.MirOperand lower_error_union_lift_operand_with_span(
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        mir.MirLocalId temp = self.add_temp(expected, span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue {
                op: mir.MirErrorUnionOp.make_value,
                value: value
            }),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand {place: temp_place});
    }

    () push_storage_live(mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement {
            span: span,
            kind: mir.storage_live_statement_kind(mir.MirStorageLiveStatement {local_id: local_id})
        });
    }

    () push_storage_dead(mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement {
            span: span,
            kind: mir.storage_dead_statement_kind(mir.MirStorageDeadStatement {local_id: local_id})
        });
    }

    // StorageDead 是词法 scope 边界。drop elaboration 会在这些边界前
    // 插入真实 drop；return 点只保留函数级兜底。
    () end_scope(list.ArrayList<mir.MirLocalId>& scope_locals, token.Span span) {
        Int! index = scope_locals.len() - 1;
        while (index >= 0) {
            self.push_storage_dead(scope_locals.get(index), span);
            index = index - 1;
        }
        self.restore_active_locals(self.active_locals.len() - scope_locals.len());
    }

    () push_active_storage_dead_from(Int active_depth, token.Span span) {
        Int! index = self.active_locals.len() - 1;
        while (index >= active_depth) {
            self.push_storage_dead(self.active_locals.get(index), span);
            index = index - 1;
        }
    }

    () restore_active_locals(Int active_depth) {
        self.active_locals.truncate(active_depth);
    }

    // defer 是词法 scope cleanup。提前退出路径会从当前 defer 栈一路
    // 执行到目标 scope 的深度，然后再释放离开的 locals。
    () run_deferred_from(Int defer_depth, token.Span span) {
        Int! index = self.active_defers.len() - 1;
        while (index >= defer_depth) {
            self.lower_expr_statement(self.active_defers.get(index));
            index = index - 1;
        }
        self.restore_active_defers(defer_depth);
    }

    () restore_active_defers(Int defer_depth) {
        self.active_defers.truncate(defer_depth);
    }

    () finish_block(mir.MirTerminatorKind terminator, token.Span span) {
        if (self.terminated) { return; }
        self.blocks.set(self.current_block.to_index(), mir.MirBlock {
            id: self.current_block,
            span: span,
            statements: self.lowerer.output.statement_array(self.statements$.ref()),
            terminator: mir.MirTerminator {
                span: span,
                kind: terminator
            }
        });
        self.terminated = true;
    }

    mir.MirTerminatorKind goto_terminator(mir.MirBlockId target) {
        return mir.goto_terminator_kind(mir.MirGotoTerminator {target: target});
    }

    mir.MirBlockId reserve_block(token.Span span) {
        mir.MirBlockId block_id = mir.MirBlockId.from_index(self.blocks.len());
        self.blocks.add(mir.MirBlock {
            id: block_id,
            span: span,
            statements: self.lowerer.output.empty_statements(),
            terminator: mir.MirTerminator {
                span: span,
                kind: mir.unreachable_terminator_kind(mir.MirUnreachableTerminator {generated_by_check: true})
            }
        });
        return block_id;
    }

    () start_block(mir.MirBlockId block_id) {
        self.current_block = block_id;
        self.terminated = false;
        self.statements.clear();
    }

    mir.MirRvalue unit_rvalue(token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue {
            value: mir.const_operand_value(mir.MirConst {
                type_id: self.lowerer.ctx.query.types.unit_type(),
                span: span,
                value: mir.unit_const_kind(mir.MirUnitConst {unit_value: true})
            })
        });
    }

    mir.MirRvalue int_const_rvalue(Int value, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue {value: mir.const_operand_value(self.int_const(value, span))});
    }

    mir.MirRvalue bool_rvalue(Bool value, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue {value: mir.const_operand_value(mir.MirConst {
            type_id: self.lowerer.ctx.query.types.bool_type(),
            span: span,
            value: mir.bool_const_kind(mir.MirBoolConst {value: value})
        })});
    }

    mir.MirOperand bool_operand(Bool value, token.Span span) {
        return mir.const_operand_value(mir.MirConst {
            type_id: self.lowerer.ctx.query.types.bool_type(),
            span: span,
            value: mir.bool_const_kind(mir.MirBoolConst {value: value})
        });
    }

    mir.MirConst int_const(Int value, token.Span span) {
        return mir.MirConst {
            type_id: self.lowerer.ctx.query.types.int_type(),
            span: span,
            value: mir.int_const_kind(mir.MirIntConst {bits: UInt64(value), signed_value: true})
        };
    }

    mir.MirRvalue int_rvalue(hir.HirId node_id, Int value) {
        return mir.use_rvalue(mir.MirUseRvalue {
            value: mir.const_operand_value(mir.MirConst {
                type_id: self.lowerer.ctx.query.types.int_type(),
                span: self.lowerer.hir_span(node_id),
                value: mir.int_const_kind(mir.MirIntConst {bits: UInt64(value), signed_value: true})
            })
        });
    }

    mir.MirUnaryOp? unary_op(hir.HirUnaryOp op) {
        if (op == .negate) { return mir.MirUnaryOp.neg; }
        if (op == .not) { return mir.MirUnaryOp.logic_not; }
        if (op == .bit_not) { return mir.MirUnaryOp.bit_not; }
        return null;
    }

    mir.MirBinaryOp? binary_op_for_assign(hir.HirAssignOp op) {
        if (op == .add_assign) { return mir.MirBinaryOp.add; }
        if (op == .sub_assign) { return mir.MirBinaryOp.sub; }
        if (op == .mul_assign) { return mir.MirBinaryOp.mul; }
        if (op == .div_assign) { return mir.MirBinaryOp.div; }
        if (op == .mod_assign) { return mir.MirBinaryOp.rem; }
        if (op == .bit_and_assign) { return mir.MirBinaryOp.bit_and; }
        if (op == .bit_or_assign) { return mir.MirBinaryOp.bit_or; }
        if (op == .bit_xor_assign) { return mir.MirBinaryOp.bit_xor; }
        if (op == .shift_left_assign) { return mir.MirBinaryOp.shl; }
        if (op == .shift_right_assign) { return mir.MirBinaryOp.shr; }
        return null;
    }

    mir.MirBinaryOp? binary_op(hir.HirBinaryOp op) {
        if (op == .add) { return mir.MirBinaryOp.add; }
        if (op == .sub) { return mir.MirBinaryOp.sub; }
        if (op == .mul) { return mir.MirBinaryOp.mul; }
        if (op == .div) { return mir.MirBinaryOp.div; }
        if (op == .mod) { return mir.MirBinaryOp.rem; }
        if (op == .bit_and) { return mir.MirBinaryOp.bit_and; }
        if (op == .bit_or) { return mir.MirBinaryOp.bit_or; }
        if (op == .bit_xor) { return mir.MirBinaryOp.bit_xor; }
        if (op == .shift_left) { return mir.MirBinaryOp.shl; }
        if (op == .shift_right) { return mir.MirBinaryOp.shr; }
        if (op == .equal) { return mir.MirBinaryOp.eq; }
        if (op == .not_equal) { return mir.MirBinaryOp.ne; }
        if (op == .less) { return mir.MirBinaryOp.lt; }
        if (op == .less_equal) { return mir.MirBinaryOp.le; }
        if (op == .greater) { return mir.MirBinaryOp.gt; }
        if (op == .greater_equal) { return mir.MirBinaryOp.ge; }
        return null;
    }

    mir.MirLocalId add_temp(qid.TypeId type_id, token.Span span) {
        mir.MirLocalId local_id = mir.MirLocalId.from_index(self.locals.len());
        self.locals.add(mir.MirLocalDecl {
            id: local_id,
            kind: mir.MirLocalKind.compiler_temp,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        });
        return local_id;
    }

    qid.TypeId type_for_node(hir.HirId node_id) {
        if (self.lowerer.typeck.node_type(node_id) is some type_id) {
            return self.lowerer.substitute_type(type_id, self.substitutions);
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    mir.MirLocalId return_local() {
        return mir.MirLocalId.from_index(0);
    }

    mir.MirLocalId mir_local_for_hir(hir.HirLocalId local_id) {
        return mir.MirLocalId.from_index(local_id.to_index() + 1);
    }

    mir.MirPlace place_for_local(mir.MirLocalId local_id) {
        return mir.MirPlace {
            local_id: local_id,
            projection: self.lowerer.output.empty_projection()
        };
    }

    mir.MirLocalDecl[] freeze_locals() {
        Int count = self.locals.len();
        mir.MirLocalDecl![*] values = self.lowerer.output.alloc_local_array(count);
        Int! index = 0;
        while (index < count) {
            values[index] = self.locals.get(index);
            index = index + 1;
        }
        return values[0..count];
    }
}
