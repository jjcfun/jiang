// Facade for HIR to MIR lowering.

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import qid = "../store/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import store = "../resolve/store.jiang";
import drop_semantics = "../sema/drop.jiang";
import monomorph = "../sema/monomorph.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import memory = "../support/memory.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";
import mir_diagnostics = "./diagnostics.jiang";
import drop_elaborate = "./drop_elaborate.jiang";
import std;
import lower_support = "./lower_support.jiang";
import coroutine_frame_layout = "./pass/coroutine/frame_layout.jiang";
import coroutine_frame_rewrite = "./pass/coroutine/frame_rewrite.jiang";
import coroutine_task_abi = "./pass/coroutine/task_abi.jiang";
import coroutine_confinement = "./pass/coroutine/confinement.jiang";
import coroutine_local_variant = "./pass/coroutine/local_variant.jiang";
import coroutine_plan = "./pass/coroutine/plan.jiang";
import coroutine_rtc = "./pass/coroutine/run_to_completion.jiang";

const Int suspend_registering = 0;
const Int suspend_parked = 1;
const Int suspend_resuming = 2;
const Int suspend_resumed = 3;

enum AtomicBuiltinKind {
    load,
    store,
    compare_exchange,
}

struct AtomicBuiltin {
    AtomicBuiltinKind kind;
    mir.MirAtomicOrdering success;
    mir.MirAtomicOrdering failure;

    init(
        self,
        AtomicBuiltinKind kind,
        mir.MirAtomicOrdering success,
        mir.MirAtomicOrdering failure
    ) {
        self.kind = kind;
        self.success = success;
        self.failure = failure;
    }
}

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph
) {
    hir_store.HirStore& hir_store = ctx.store.hirs$.ref();
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    return lower_package(ctx, hir_store, typeck, instances, graph);
}

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    hir_store.HirStore& hir_store,
    typeck_store.TypeCheckStore& typeck,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph
) {
    mir.MirStore^ output = new mir.MirStore(hir_store.ok && typeck.ok);
    if (hir_store.has_errors() || typeck.has_errors()) {
        return output$.move();
    }

    MirLowerer lowerer! = MirLowerer(ctx, hir_store, typeck, instances, graph, output$.ref());
    lowerer.lower_package();
    if (output.has_errors()) {
        diagnostic_helper.add_package_error(ctx, "MIR lowering failed", "mir_lowering_failed");
    }
    return output$.move();
}

struct TraitVTableGlobalKey: Hashable, Equatable {
    qid.DefId trait_def;
    qid.TypeId subject_type;

    public init(self, qid.DefId trait_def, qid.TypeId subject_type) {
        self.trait_def = trait_def;
        self.subject_type = subject_type;
    }

    public UInt64 hash(self) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.trait_def.to_index());
        hasher.write_int(self.subject_type.to_index());
        return hasher.finish();
    }

    public Bool equal(TraitVTableGlobalKey& lhs, TraitVTableGlobalKey& rhs) {
        if (lhs.trait_def != rhs.trait_def) {
            return false;
        }
        return lhs.subject_type == rhs.subject_type;
    }
}

struct LambdaVTableGlobalKey: Hashable, Equatable {
    mir.MirFunctionKey function;
    Bool heap_env;

    public init(self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        Bool heap_env
    ) {
        self.function = mir.MirFunctionKey(function_def, type_args, const_args);
        self.heap_env = heap_env;
    }

    public UInt64 hash(self) {
        return hash.combine(self.function.hash(), hash.hash_bool(self.heap_env));
    }

    public Bool equal(LambdaVTableGlobalKey& lhs, LambdaVTableGlobalKey& rhs) {
        if (lhs.heap_env != rhs.heap_env) { return false; }
        return mir.MirFunctionKey.equal(lhs.function$.ref(), rhs.function$.ref());
    }
}

std.String build_text_int(UInt8[]& prefix, Int value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix);
    builder.append(value);
    return builder$.move().into_string();
}

Bool async_start_is_detached(mir.MirAsyncStartKind? value) {
    if (value is .some(kind)) { return kind == .detached; }
    return false;
}

struct MirLowerer: Movable {
    context.CompilerContext& ctx;
    hir_store.HirStore& hirs;
    typeck_store.TypeCheckStore& typeck;
    monomorph.MonomorphStore& instances;
    module_graph.ModuleGraph& graph;
    mir.MirStore& output;
    table.HashTable<TraitVTableGlobalKey, qid.DefId> trait_vtable_globals;
    table.HashTable<Int, qid.DefId> receiver_type_globals;
    table.HashTable<Int, qid.DefId> receiver_drop_shims;
    table.HashTable<Int, qid.DefId> raw_fn_to_fn_shims;
    table.HashTable<Int, qid.DefId> raw_fn_vtable_globals;
    table.HashTable<LambdaVTableGlobalKey, qid.DefId> lambda_vtable_globals;
    table.HashTable<Int, qid.DefId> lambda_env_drop_shims;
    table.HashTable<mir.MirFunctionKey, qid.DefId> async_callable_start_shims;
    table.HashTable<mir.MirFunctionKey, qid.DefId> async_callable_completion_shims;
    table.HashTable<mir.MirFunctionKey, qid.DefId> serial_completion_shims;
    coroutine_plan.Store coroutine_plans;
    list.ArrayList<Bool> rtc_eligible!;
    table.HashTable<mir.MirFunctionKey, Bool> lowering_functions;
    table.HashTable<Int, qid.DefId> cancel_handler_shims;
    table.HashTable<qid.DefId, qid.DefId> async_block_env_drop_shims;
    table.HashTable<Int, mir.MirTaskStateLayout> task_state_layouts;
    qid.DefId? closure_noop_drop_shim!;

    public init(self,
        context.CompilerContext& ctx,
        hir_store.HirStore& hirs,
        typeck_store.TypeCheckStore& typeck,
        monomorph.MonomorphStore& instances,
        module_graph.ModuleGraph& graph,
        mir.MirStore& output
    ) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.output = output;
        self.trait_vtable_globals = table.HashTable<TraitVTableGlobalKey, qid.DefId>();
        self.receiver_type_globals = table.HashTable<Int, qid.DefId>();
        self.receiver_drop_shims = table.HashTable<Int, qid.DefId>();
        self.raw_fn_to_fn_shims = table.HashTable<Int, qid.DefId>();
        self.raw_fn_vtable_globals = table.HashTable<Int, qid.DefId>();
        self.lambda_vtable_globals = table.HashTable<LambdaVTableGlobalKey, qid.DefId>();
        self.lambda_env_drop_shims = table.HashTable<Int, qid.DefId>();
        self.async_callable_start_shims = table.HashTable<mir.MirFunctionKey, qid.DefId>();
        self.async_callable_completion_shims = table.HashTable<mir.MirFunctionKey, qid.DefId>();
        self.serial_completion_shims = table.HashTable<mir.MirFunctionKey, qid.DefId>();
        self.coroutine_plans = coroutine_plan.Store();
        self.rtc_eligible = list.ArrayList<Bool>();
        self.lowering_functions = table.HashTable<mir.MirFunctionKey, Bool>();
        self.cancel_handler_shims = table.HashTable<Int, qid.DefId>();
        self.async_block_env_drop_shims = table.HashTable<qid.DefId, qid.DefId>();
        self.task_state_layouts = table.HashTable<Int, mir.MirTaskStateLayout>();
        self.closure_noop_drop_shim = null;
    }

    public () lower_package(self) {
        // MIR 调度从 module graph + HIR ownership tree 派生：graph 给出本次
        // 编译的 root/import closure，module HirDef.members 给出当前
        // module 的顶层声明集合。泛型模板本身不生成 MIR；后面按
        // MonomorphStore 为每个 concrete type args 生成独立函数体。
        Int module_index! = 0;
        while (module_index < self.graph.module_count()) {
            store.ModuleRecord& module = self.ctx.store.resolve.module_ref(self.graph.module_at(module_index));
            self.lower_def_tree(module.def_id);
            module_index = module_index + 1;
        }
        self.lower_instances();
        self.ensure_custom_deinit_instances();
        self.lower_runtime_entry();
        list.ArrayList<coroutine_confinement.Summary> confinement! =
            coroutine_confinement.analyze(self.output);
        self.apply_coroutine_confinement(confinement$.ref());
        self.rtc_eligible = coroutine_rtc.analyze(self.output);
        self.prepare_coroutine_plans();
        self.prepare_coroutine_source_layouts();
        self.lower_coroutine_resume_functions();
    }

    () apply_coroutine_confinement(
        self,
        list.ArrayList<coroutine_confinement.Summary>& states
    ) {
        Int index! = 0;
        while (index < self.output.functions.len()) {
            mir.MirFunction&! function = self.output.functions.ref_at(index);
            coroutine_confinement.Summary summary = states.get(index);
            if (summary.kind == .escaping) { function.confinement = .escaping; }
            else { function.confinement = .preserving; }
            function.confinement_domain = summary.binding;
            if (function.coroutine_frame is .some(frame)) {
                mir.MirCoroutineFrameLayout updated! = frame;
                updated.may_defer = summary.may_defer;
                function.coroutine_frame = updated;
            }
            index = index + 1;
        }
    }

    () prepare_coroutine_plans(self) {
        list.ArrayList<mir.MirFunctionId> worklist! =
            list.ArrayList<mir.MirFunctionId>();
        Int function_count = self.output.functions.len();
        Int index! = 0;
        while (index < function_count) {
            mir.MirFunction function = self.output.functions.get(index);
            self.collect_confined_task_roots(function, worklist$.ref());
            self.collect_direct_rtc_children(function, worklist$.ref());
            index = index + 1;
        }
        index = 0;
        while (index < worklist.len()) {
            self.collect_confined_children(
                self.output.function(worklist.get(index)), worklist$.ref()
            );
            index = index + 1;
        }
        self.prepare_rtc_resume_shims(worklist$.ref());
    }

    () collect_direct_rtc_children(
        self,
        mir.MirFunction function,
        list.ArrayList<mir.MirFunctionId>& worklist
    ) {
        Int block_index! = 0;
        while (block_index < function.body.blocks.length) {
            mir.MirTerminator terminator = function.body.blocks[block_index].terminator;
            if (terminator.kind is .call_term(call)) {
                self.create_direct_rtc_resume_shim(call, worklist);
            }
            block_index = block_index + 1;
        }
    }

    () create_direct_rtc_resume_shim(
        self,
        mir.MirCallTerminator call,
        list.ArrayList<mir.MirFunctionId>& worklist
    ) {
        if (call.suspend_wake != .direct_child) { return; }
        guard coroutine_rtc.eligible_child(
            self.output, self.rtc_eligible$.ref(), call
        ) is .some(child) else { return; }
        guard self.confined_source_function_id(child) is .some(function_id) else { return; }
        mir.MirFunction function = self.output.function(function_id);
        if (!self.direct_rtc_binding_is_satisfied(call, function)) { return; }
        if (coroutine_rtc.body_has_cross_executor_child(function.body)) {
            self.demand_confined_variant(child, worklist);
        }
        self.create_rtc_resume_shim(child);
    }

    Bool direct_rtc_binding_is_satisfied(
        self,
        mir.MirCallTerminator call,
        mir.MirFunction child
    ) {
        guard child.confinement_domain is .some(required) else { return true; }
        guard call.current_effects.domain is .some(domain) else { return false; }
        return domain.binding == required;
    }

    () prepare_coroutine_source_layouts(self) {
        Int function_count = self.output.functions.len();
        Int index! = 0;
        while (index < function_count) {
            self.prepare_coroutine_source_layout(index);
            index = index + 1;
        }
    }

    () prepare_coroutine_source_layout(
        self,
        Int function_index
    ) {
        mir.MirFunction source = self.output.functions.get(function_index);
        mir.MirFunction selected = coroutine_local_variant.select_task_roots(
            self.output,
            source,
            self.coroutine_plans$.ref()
        );
        self.output.functions.ref_at(function_index).body = selected.body;
        if (source.coroutine_frame == null) {
            return;
        }
        guard source.coroutine_frame is .some(frame) else { return; }
        Bool has_direct_child = coroutine_rtc.body_has_direct_rtc_child(
            source.body, self.coroutine_plans$.ref()
        );
        if (!has_direct_child) { return; }
        mir.MirBody body! = selected.body;
        body = coroutine_rtc.rewrite_direct_rtc_children(
            self.output, body, self.coroutine_plans$.ref()
        );
        mir.MirTaskStateLayout task_state = self.create_task_state_layout(
            source.def_id,
            frame.task_abi.result_type_id,
            source.span
        );
        if (coroutine_frame_layout.build_frame_layout(
                self.output,
                self.ctx.store.types$.ref(),
                body,
                source.effects,
                self.ctx.store.types.int_type(),
                task_state$.ref(),
                frame.cancellation_entry
            ) is .some(updated)
        ) {
            mir.MirCoroutineFrameLayout layout! = updated;
            layout.domain_kind = frame.domain_kind;
            layout.may_defer = frame.may_defer;
            mir.MirFunction&! function = self.output.functions.ref_at(function_index);
            function.body = body;
            function.coroutine_frame = layout;
        }
    }

    () prepare_rtc_resume_shims(
        self,
        list.ArrayList<mir.MirFunctionId>& confined
    ) {
        Int function_index! = 0;
        while (function_index < confined.len()) {
            mir.MirFunction function = self.output.function(
                confined.get(function_index)
            );
            self.collect_rtc_children(function);
            function_index = function_index + 1;
        }
    }

    () collect_rtc_children(self, mir.MirFunction function) {
        Int block_index! = 0;
        while (block_index < function.body.blocks.length) {
            mir.MirTerminator terminator = function.body.blocks[block_index].terminator;
            if (terminator.kind is .call_term(call)) {
                if (coroutine_rtc.eligible_child(
                        self.output, self.rtc_eligible$.ref(), call
                    ) is .some(child)
                ) {
                    self.create_rtc_resume_shim(child);
                }
            }
            block_index = block_index + 1;
        }
    }

    () create_rtc_resume_shim(self, mir.MirFunctionRef child) {
        mir.MirFunctionKey key = mir.MirFunctionKey(
            child.function_def, child.type_args, child.const_args
        );
        if (self.coroutine_plans.get(key).rtc_resume != null) { return; }
        qid.DefId resume_def = self.create_coroutine_variant_def(
            child.function_def, "__rtc_resume_", child.span
        );
        self.coroutine_plans.set_rtc_resume(key, resume_def);
    }

    () collect_confined_task_roots(
        self,
        mir.MirFunction function,
        list.ArrayList<mir.MirFunctionId>& worklist
    ) {
        guard function.coroutine_frame is .some(frame) else { return; }
        Int index! = 0;
        while (index < frame.task_regions.length) {
            mir.MirTaskRegion region = frame.task_regions[index];
            if (region.storage.sync == .local_serial) {
                self.demand_confined_variant(region.child_resume, worklist);
            }
            index = index + 1;
        }
    }

    () collect_confined_children(
        self,
        mir.MirFunction function,
        list.ArrayList<mir.MirFunctionId>& worklist
    ) {
        self.collect_confined_task_roots(function, worklist);
        Int index! = 0;
        while (index < function.body.blocks.length) {
            mir.MirTerminator terminator = function.body.blocks[index].terminator;
            if (terminator.kind is .call_term(call)) {
                if (!async_start_is_detached(call.async_start)) {
                    self.demand_confined_variant(call.suspend_child, worklist);
                }
            }
            index = index + 1;
        }
    }

    () demand_confined_variant(
        self,
        mir.MirFunctionRef? candidate,
        list.ArrayList<mir.MirFunctionId>& worklist
    ) {
        guard candidate is .some(function_ref) else { return; }
        if (!function_ref.coroutine_resume) { return; }
        mir.MirFunctionKey key = mir.MirFunctionKey(
            function_ref.function_def, function_ref.type_args, function_ref.const_args
        );
        if (self.coroutine_plans.get(key).confined_resume != null) { return; }
        guard self.confined_source_function_id(function_ref) is .some(function_id) else { return; }
        mir.MirFunction function = self.output.function(function_id);
        if (!self.function_has_confined_variant(function)) { return; }
        self.create_confined_coroutine_shims(function);
        worklist.add(function_id);
    }

    mir.MirFunctionId? confined_source_function_id(
        self,
        mir.MirFunctionRef function_ref
    ) {
        if (function_ref.type_args.length == 0 && function_ref.const_args.length == 0) {
            return self.output.function_id_for_def(function_ref.function_def);
        }
        return self.output.function_id_for_instance(
            function_ref.function_def, function_ref.type_args, function_ref.const_args
        );
    }

    Bool function_has_confined_variant(self, mir.MirFunction function) {
        if (!function.is_coroutine || function.is_external) { return false; }
        if (function.confinement == .escaping) { return false; }
        return !self.async_block_function_is_detached(function.def_id);
    }

    () create_confined_coroutine_shims(self, mir.MirFunction function) {
        mir.MirFunctionKey key = mir.MirFunctionKey(
            function.def_id, function.type_args, function.const_args
        );
        qid.DefId resume_def = self.create_coroutine_variant_def(
            function.def_id, "__confined_resume_", function.span
        );
        self.coroutine_plans.set_confined_resume(key, resume_def);
    }

    qid.DefId create_coroutine_variant_def(
        self,
        qid.DefId source_def,
        UInt8[]& prefix,
        token.Span span
    ) {
        def.DefRecord source = self.ctx.store.defs.get(source_def);
        std.String name = build_text_int(prefix, source_def.to_index());
        return self.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.ctx.store.symbols.intern(name.bytes()), span: span),
            source.owner_def,
            source.module_id,
            source.decl_namespace_id,
            null
        );
    }

    () lower_coroutine_resume_functions(self) {
        Int function_count = self.output.functions.len();
        Int index! = 0;
        while (index < function_count) {
            mir.MirFunction function = self.output.functions.get(index);
            self.lower_coroutine_resume_function(function);
            index = index + 1;
        }
    }

    () lower_coroutine_resume_function(self, mir.MirFunction function) {
        if (!function.is_coroutine || function.is_coroutine_resume) {
            return;
        }
        guard function.coroutine_frame is .some(frame) else {
            return;
        }
        self.add_async_callable_abi_functions(function, frame$.ref());
        mir.MirFunctionRef? env_drop = self.async_block_env_drop_function(function.def_id, function.span);
        if (function.is_external) {
            coroutine_frame_rewrite.add_completion_function(self.output, function, frame$.ref(), env_drop);
            return;
        }
        coroutine_frame_rewrite.ResumeFunctionLowering resume =
            coroutine_frame_rewrite.add_resume_function(self.output, function, frame$.ref());
        self.output.mark_drop_elaborated(resume.function.id);
        self.output.mark_borrow_check_exempt(resume.function.id);
        if (self.async_block_function_is_detached(function.def_id)) {
            coroutine_frame_rewrite.add_detached_completion_function(self.output, function, frame$.ref(), env_drop);
            return;
        }
        coroutine_frame_rewrite.CompletionFunctionLowering completion =
            coroutine_frame_rewrite.add_completion_function(
                self.output, function, frame$.ref(), env_drop
            );
        self.add_confined_coroutine_variant(function, frame$.ref(), resume);
        self.add_rtc_coroutine_variant(function, frame$.ref());
        mir.MirFunctionKey key = mir.MirFunctionKey(
            function.def_id, function.type_args, function.const_args
        );
        if (table.hash_table_get_value<mir.MirFunctionKey, qid.DefId>(
                self.serial_completion_shims$.ref(), key
            ) is .some(serial_def)
        ) {
            coroutine_frame_rewrite.add_serial_completion_function(
                self.output, function, frame$.ref(), env_drop, serial_def
            );
        }
    }

    () add_confined_coroutine_variant(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        coroutine_frame_rewrite.ResumeFunctionLowering resume
    ) {
        mir.MirFunctionKey key = mir.MirFunctionKey(
            source.def_id, source.type_args, source.const_args
        );
        guard self.coroutine_plans.get(key).confined_resume is .some(resume_def) else {
            return;
        }
        coroutine_frame_rewrite.ResumeFunctionLowering variant_resume! = resume;
        if (coroutine_rtc.body_uses_rtc(
                self.output,
                source.body,
                layout,
                self.coroutine_plans$.ref()
            )
        ) {
            mir.MirFunction optimized = self.coroutine_source_with_rtc_calls(
                source, layout
            );
            variant_resume = coroutine_frame_rewrite.lower_resume_function(
                self.output,
                optimized,
                layout,
                mir.MirFunctionId.from_index(self.output.functions.len())
            );
        }
        coroutine_local_variant.add(
            self.output,
            variant_resume.function,
            resume_def,
            coroutine_frame_rewrite.resume_current_executor_place(
                self.output, layout, variant_resume.frame_local_id
            ),
            self.coroutine_plans$.ref()
        );
    }

    () add_rtc_coroutine_variant(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout
    ) {
        mir.MirFunctionKey key = mir.MirFunctionKey(
            source.def_id, source.type_args, source.const_args
        );
        guard self.coroutine_plans.get(key).rtc_resume is .some(resume_def) else {
            return;
        }
        mir.MirFunction optimized = self.coroutine_source_with_rtc_calls(
            source, layout
        );
        coroutine_frame_rewrite.ResumeFunctionLowering resume =
            coroutine_frame_rewrite.lower_rtc_resume_function(
                self.output,
                optimized,
                layout,
                mir.MirFunctionId.from_index(self.output.functions.len())
            );
        coroutine_local_variant.add(
            self.output,
            resume.function,
            resume_def,
            coroutine_frame_rewrite.resume_current_executor_place(
                self.output, layout, resume.frame_local_id
            ),
            self.coroutine_plans$.ref()
        );
    }

    @life(self > return, source > return)
    mir.MirFunction coroutine_source_with_rtc_calls(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout
    ) {
        return mir.MirFunction (
            id: source.id,
            def_id: source.def_id,
            type_args: source.type_args,
            const_args: source.const_args,
            signature_id: source.signature_id,
            effects: source.effects,
            is_coroutine: source.is_coroutine,
            coroutine_frame: source.coroutine_frame,
            confinement: source.confinement,
            confinement_domain: source.confinement_domain,
            is_coroutine_resume: source.is_coroutine_resume,
            is_coroutine_completion: source.is_coroutine_completion,
            is_language_entry: source.is_language_entry,
            is_runtime_entry: source.is_runtime_entry,
            is_external: source.is_external,
            inline_always: source.inline_always,
            naked: source.naked,
            span: source.span,
            body: coroutine_rtc.rewrite_body(
                self.output,
                source.body,
                layout,
                self.coroutine_plans$.ref()
            )
        );
    }

    Bool async_block_function_is_detached(self, qid.DefId function_def) {
        guard self.typeck.async_block_function_usage(function_def) is .some(usage) else { return false; }
        return usage == typeck_store.AsyncStartUsage.detached;
    }

    mir.MirFunctionRef? async_block_env_drop_function(self, qid.DefId function_def, token.Span span) {
        guard table.hash_table_get_value<qid.DefId, qid.DefId>(
            self.async_block_env_drop_shims$.ref(),
            function_def
        ) is .some(shim_def) else { return null; }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.ctx.store.types.opaque_pointer_type(span));
        qid.TypeId function_type = self.ctx.store.types.function_type(
            params$.move(),
            self.ctx.store.types.unit_type(),
            span
        );
        return mir.MirFunctionRef (
            function_def: shim_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: function_type,
            span: span
        );
    }

    () add_async_callable_abi_functions(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout
    ) {
        mir.MirFunctionKey key = mir.MirFunctionKey(
            source.def_id, source.type_args, source.const_args
        );
        guard table.hash_table_get_value<mir.MirFunctionKey, qid.DefId>(
            self.async_callable_start_shims$.ref(), key
        ) is .some(start_def) else { return; }
        guard table.hash_table_get_value<mir.MirFunctionKey, qid.DefId>(
            self.async_callable_completion_shims$.ref(), key
        ) is .some(completion_def) else { return; }
        self.add_async_callable_start_function(source, layout, start_def, completion_def);
        self.add_async_callable_completion_function(source, layout, completion_def);
    }

    () add_async_callable_start_function(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        qid.DefId start_def,
        qid.DefId completion_def
    ) {
        types.FunctionType function_type = self.async_callable_source_type(source);
        mir.MirFunctionId id = mir.MirFunctionId.from_index(self.output.functions.len());
        mir.MirBody body = self.async_callable_start_body(
            source, layout, function_type, completion_def, id
        );
        self.output.add_generated_function(mir.MirFunction (
            id: id,
            def_id: start_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: source.span,
            body: body
        ));
        self.output.mark_borrow_check_exempt(id);
    }

    types.FunctionType async_callable_source_type(self, mir.MirFunction source) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
        Int index! = 0;
        while (index < source.body.locals.length) {
            mir.MirLocalDecl local = source.body.locals[index];
            if (local.kind == .param) {
                params.add(local.type_id);
            }
            index = index + 1;
        }
        qid.TypeId result = source.body.locals[source.body.return_local.to_index()].type_id;
        qid.TypeId type_id = self.ctx.store.types.function_type_with_effects(
            params$.move(), result, source.span, source.effects
        );
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else {
            return types.FunctionType (
                params: self.output.empty_type_args(),
                result: self.ctx.store.types.unit_type(),
                effects: types.EffectSet(),
                kind: .raw
            );
        }
        return function_type;
    }

    mir.MirBody async_callable_start_body(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        types.FunctionType function_type,
        qid.DefId completion_def,
        mir.MirFunctionId function_id
    ) {
        unsafe {
            token.Span span = source.span;
            Int param_count = function_type.params.length;
            mir.MirLocalId continuation_local = mir.MirLocalId.from_index(param_count + 1);
            mir.MirLocalId frame_pointer_local = mir.MirLocalId.from_index(param_count + 2);
            mir.MirLocalId erased_frame_local = mir.MirLocalId.from_index(param_count + 3);
            mir.MirLocalId allocation_executor_local = mir.MirLocalId.from_index(param_count + 4);
            Int local_count = param_count + 5;
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(local_count);
            locals[0] = self.generated_local(
                mir.MirLocalId.from_index(0), .return_place, self.ctx.store.types.unit_type(), span
            );
            Int index! = 0;
            while (index < param_count) {
                locals[index + 1] = self.generated_local(
                    mir.MirLocalId.from_index(index + 1), .param, function_type.params[index], span
                );
                index = index + 1;
            }
            mir.MirExternalContinuationLayout continuation_layout =
                self.external_async_continuation_layout(function_type.result, span);
            locals[continuation_local.to_index()] = self.generated_local(
                continuation_local, .param, continuation_layout.pointer_type_id, span
            );
            locals[frame_pointer_local.to_index()] = self.generated_local(
                frame_pointer_local, .compiler_temp, layout.task_abi.frame_pointer_type_id, span
            );
            locals[erased_frame_local.to_index()] = self.generated_local(
                erased_frame_local, .compiler_temp, self.ctx.store.types.opaque_pointer_type(span), span
            );
            locals[allocation_executor_local.to_index()] = self.generated_local(
                allocation_executor_local,
                .compiler_temp,
                self.ctx.store.types.opaque_pointer_type(span),
                span
            );
            mir.MirPlace frame_pointer = mir.local_place(frame_pointer_local, self.output.empty_projection());
            mir.MirPlace frame = self.generated_deref_place(frame_pointer, true);
            list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>();
            mir.MirPlace continuation = self.generated_deref_place(
                mir.local_place(continuation_local, self.output.empty_projection()), true
            );
            mir.MirRvalue allocation_executor! = mir.use_rvalue(mir.MirUseRvalue (
                value: mir.copy_operand_value(mir.MirCopyOperand (
                    place: self.generated_constant_index_place(
                        continuation, continuation_layout.executor_field_index
                    )
                ))
            ));
            if (layout.effects.domain is .some(domain)) {
                allocation_executor = mir.domain_executor_rvalue(mir.MirDomainExecutorRvalue (
                    domain_def: domain.binding,
                    domain_kind: layout.domain_kind
                ));
            }
            statements.add(self.generated_assign(
                mir.local_place(allocation_executor_local, self.output.empty_projection()),
                allocation_executor,
                span
            ));
            statements.add(self.generated_assign(
                frame_pointer,
                mir.coroutine_frame_alloc_rvalue(mir.MirCoroutineFrameAllocRvalue (
                    value_type: layout.frame_type_id,
                    executor: mir.copy_operand_value(mir.MirCopyOperand (
                        place: mir.local_place(
                            allocation_executor_local, self.output.empty_projection()
                        )
                    ))
                )),
                span
            ));
            self.append_async_callable_frame_initializers(
                source,
                layout,
                function_type,
                frame,
                continuation_local,
                frame_pointer_local,
                erased_frame_local,
                completion_def,
                span,
                statements$.ref()
            );
            list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
            blocks.add(self.async_callable_start_call_block(
                source,
                layout,
                frame_pointer_local,
                erased_frame_local,
                statements$.ref(),
                span
            ));
            blocks.add(self.generated_return_block(1, span));
            return mir.MirBody (
                id: mir.MirBodyId.from_index(function_id.to_index()),
                span: span,
                locals: locals[0..local_count],
                blocks: self.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    () append_async_callable_frame_initializers(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        types.FunctionType function_type,
        mir.MirPlace frame,
        mir.MirLocalId continuation_local,
        mir.MirLocalId frame_pointer_local,
        mir.MirLocalId erased_frame_local,
        qid.DefId completion_def,
        token.Span span,
        list.ArrayList<mir.MirStatement>& statements
    ) {
        Int source_local_index! = 1;
        Int abi_param_index! = 0;
        while (source_local_index < source.body.locals.length) {
            mir.MirLocalDecl source_local = source.body.locals[source_local_index];
            if (source_local.kind == .param) {
                if (self.coroutine_frame_field_index(layout, source_local.id) is .some(field_index)) {
                    statements.add(self.generated_assign_operand(
                        self.generated_constant_index_place(frame, field_index),
                        mir.copy_operand_value(mir.MirCopyOperand (
                            place: mir.local_place(
                                mir.MirLocalId.from_index(abi_param_index + 1),
                                self.output.empty_projection()
                            )
                        )),
                        span
                    ));
                }
                abi_param_index = abi_param_index + 1;
            }
            source_local_index = source_local_index + 1;
        }
        statements.add(coroutine_task_abi.frame_state_initializer(self.output, layout, frame, span));
        mir.MirStatement[]& domain = coroutine_task_abi.frame_domain_initializers(
            self.output, layout, frame, span
        );
        Int index! = 0;
        while (index < domain.length) {
            statements.add(domain[index]);
            index = index + 1;
        }
        statements.add(coroutine_task_abi.cancellation_enabled_initializer(
            self.output, layout, frame, 2, span
        ));
        mir.MirExternalContinuationLayout continuation_layout =
            self.external_async_continuation_layout(function_type.result, span);
        mir.MirPlace continuation = self.generated_deref_place(
            mir.local_place(continuation_local, self.output.empty_projection()), true
        );
        statements.add(self.generated_assign_operand(
            self.generated_constant_index_place(frame, layout.cancellation_context_field_index),
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(
                    continuation, continuation_layout.cancellation_context_field_index
                )
            )),
            span
        ));
        if (layout.effects.domain == null) {
            statements.add(self.generated_assign_operand(
                self.generated_constant_index_place(frame, layout.current_executor_field_index),
                mir.copy_operand_value(mir.MirCopyOperand (
                    place: self.generated_constant_index_place(
                        continuation, continuation_layout.executor_field_index
                    )
                )),
                span
            ));
        }
        self.append_async_callable_continuation_initializers(
            layout,
            function_type,
            frame,
            continuation_local,
            frame_pointer_local,
            erased_frame_local,
            completion_def,
            span,
            statements
        );
    }

    () append_async_callable_continuation_initializers(
        self,
        mir.MirCoroutineFrameLayout& layout,
        types.FunctionType function_type,
        mir.MirPlace frame,
        mir.MirLocalId continuation_local,
        mir.MirLocalId frame_pointer_local,
        mir.MirLocalId erased_frame_local,
        qid.DefId completion_def,
        token.Span span,
        list.ArrayList<mir.MirStatement>& statements
    ) {
        mir.MirExternalContinuationLayout continuation_layout =
            self.external_async_continuation_layout(function_type.result, span);
        mir.MirPlace continuation = self.generated_deref_place(
            mir.local_place(continuation_local, self.output.empty_projection()), true
        );
        statements.add(self.generated_assign_operand(
            self.generated_constant_index_place(frame, layout.continuation_result_field_index),
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(continuation, continuation_layout.result_field_index)
            )),
            span
        ));
        statements.add(self.generated_cast_assign(
            self.generated_constant_index_place(frame, layout.external_continuation_field_index),
            mir.local_place(continuation_local, self.output.empty_projection()),
            layout.fields[layout.external_continuation_field_index].type_id,
            span
        ));
        statements.add(self.generated_cast_assign(
            mir.local_place(erased_frame_local, self.output.empty_projection()),
            mir.local_place(frame_pointer_local, self.output.empty_projection()),
            self.ctx.store.types.opaque_pointer_type(span),
            span
        ));
        statements.add(self.generated_cast_assign(
            self.generated_constant_index_place(frame, layout.continuation_context_field_index),
            mir.local_place(frame_pointer_local, self.output.empty_projection()),
            layout.fields[layout.continuation_context_field_index].type_id,
            span
        ));
        statements.add(coroutine_task_abi.continuation_function_initializer(
            self.output,
            layout,
            frame,
            mir.MirFunctionRef (
                function_def: completion_def,
                type_args: self.output.empty_type_args(),
                const_args: self.output.empty_const_args(),
                coroutine_resume: false,
                coroutine_completion: false,
                type_id: layout.fields[layout.continuation_function_field_index].type_id,
                span: span
            ),
            span
        ));
        statements.add(coroutine_task_abi.continuation_executor_null_initializer(
            self.output, layout, frame, span
        ));
    }

    mir.MirBlock async_callable_start_call_block(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirLocalId frame_pointer_local,
        mir.MirLocalId erased_frame_local,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        mir.MirFunctionRef resume = mir.MirFunctionRef (
            function_def: source.def_id,
            type_args: source.type_args,
            const_args: source.const_args,
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: layout.task_abi.resume_function_type_id,
            span: span
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (
            place: mir.local_place(erased_frame_local, self.output.empty_projection())
        )));
        mir.MirPlace frame = self.generated_deref_place(
            mir.local_place(frame_pointer_local, self.output.empty_projection()), true
        );
        mir.MirOperand task = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.generated_constant_index_place(
                frame, layout.cancellation_context_field_index
            )
        ));
        mir.MirCallCallee callee! = mir.dynamic_task_enqueue_callee(
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(
                    frame, layout.current_executor_field_index
                )
            )),
            task,
            mir.function_operand_value(resume),
            true
        );
        if (layout.effects.domain is .some(domain)) {
            callee = mir.domain_task_enqueue_callee(
                domain.binding,
                layout.domain_kind,
                task,
                mir.function_operand_value(resume),
                true
            );
        }
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.output.statement_array(statements),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: callee,
                    args: self.output.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    task_handoff: true,
                    destination: mir.local_place(mir.MirLocalId.from_index(0), self.output.empty_projection()),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    () add_async_callable_completion_function(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        qid.DefId completion_def
    ) {
        mir.MirFunctionId id = mir.MirFunctionId.from_index(self.output.functions.len());
        self.output.add_generated_function(mir.MirFunction (
            id: id,
            def_id: completion_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: source.span,
            body: self.async_callable_completion_body(source, layout, id)
        ));
        self.output.mark_borrow_check_exempt(id);
    }

    mir.MirBody async_callable_completion_body(
        self,
        mir.MirFunction source,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirFunctionId function_id
    ) {
        unsafe {
            token.Span span = source.span;
            qid.TypeId result_type = source.body.locals[source.body.return_local.to_index()].type_id;
            mir.MirExternalContinuationLayout continuation_layout =
                self.external_async_continuation_layout(result_type, span);
            mir.MirLocalId return_local = mir.MirLocalId.from_index(0);
            mir.MirLocalId context_local = mir.MirLocalId.from_index(1);
            mir.MirLocalId frame_pointer_local = mir.MirLocalId.from_index(2);
            mir.MirLocalId continuation_local = mir.MirLocalId.from_index(3);
            mir.MirLocalId allocation_executor_local = mir.MirLocalId.from_index(4);
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(5);
            locals[0] = self.generated_local(
                return_local, .return_place, self.ctx.store.types.unit_type(), span
            );
            locals[1] = self.generated_local(
                context_local,
                .param,
                layout.fields[layout.continuation_context_field_index].type_id,
                span
            );
            locals[2] = self.generated_local(
                frame_pointer_local, .compiler_temp, layout.task_abi.frame_pointer_type_id, span
            );
            locals[3] = self.generated_local(
                continuation_local, .compiler_temp, continuation_layout.pointer_type_id, span
            );
            locals[4] = self.generated_local(
                allocation_executor_local,
                .compiler_temp,
                self.ctx.store.types.opaque_pointer_type(span),
                span
            );
            mir.MirPlace frame_pointer = mir.local_place(frame_pointer_local, self.output.empty_projection());
            mir.MirPlace frame = self.generated_deref_place(frame_pointer, true);
            list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(4);
            statements.add(self.generated_cast_assign(
                frame_pointer,
                mir.local_place(context_local, self.output.empty_projection()),
                layout.task_abi.frame_pointer_type_id,
                span
            ));
            statements.add(self.generated_cast_assign(
                mir.local_place(continuation_local, self.output.empty_projection()),
                self.generated_constant_index_place(frame, layout.external_continuation_field_index),
                continuation_layout.pointer_type_id,
                span
            ));
            statements.add(self.generated_assign_operand(
                mir.local_place(allocation_executor_local, self.output.empty_projection()),
                mir.copy_operand_value(mir.MirCopyOperand (
                    place: self.generated_constant_index_place(
                        frame, layout.current_executor_field_index
                    )
                )),
                span
            ));
            statements.add(self.generated_assign(
                mir.local_place(return_local, self.output.empty_projection()),
                mir.coroutine_frame_free_rvalue(mir.MirCoroutineFrameFreeRvalue (
                    pointer: mir.copy_operand_value(mir.MirCopyOperand (place: frame_pointer)),
                    executor: mir.copy_operand_value(mir.MirCopyOperand (
                        place: mir.local_place(
                            allocation_executor_local, self.output.empty_projection()
                        )
                    ))
                )),
                span
            ));
            list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
            blocks.add(self.async_callable_completion_call_block(
                continuation_layout, continuation_local, statements$.ref(), span
            ));
            blocks.add(self.generated_return_block(1, span));
            return mir.MirBody (
                id: mir.MirBodyId.from_index(function_id.to_index()),
                span: span,
                locals: locals[0..5],
                blocks: self.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: return_local
            );
        }
    }

    mir.MirBlock async_callable_completion_call_block(
        self,
        mir.MirExternalContinuationLayout layout,
        mir.MirLocalId continuation_local,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        mir.MirPlace continuation = self.generated_deref_place(
            mir.local_place(continuation_local, self.output.empty_projection()), true
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (
            place: self.generated_constant_index_place(
                continuation, layout.target_context_field_index
            )
        )));
        // completion shim 正在当前 Task 的 Job 上运行；恢复调用方是执行权转移，
        // 必须直接 handoff，不能经 scheduled-continuation wrapper 退化成普通 request。
        mir.MirCallCallee callee = mir.dynamic_task_enqueue_callee(
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(
                    continuation, layout.executor_field_index
                )
            )),
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(
                    continuation, layout.cancellation_context_field_index
                )
            )),
            mir.copy_operand_value(mir.MirCopyOperand (
                place: self.generated_constant_index_place(
                    continuation, layout.target_resume_field_index
                )
            )),
            true
        );
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.output.statement_array(statements),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: callee,
                    args: self.output.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: mir.local_place(mir.MirLocalId.from_index(0), self.output.empty_projection()),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirLocalDecl generated_local(
        self,
        mir.MirLocalId id,
        mir.MirLocalKind kind,
        qid.TypeId type_id,
        token.Span span
    ) {
        return mir.MirLocalDecl (
            id: id,
            kind: kind,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    mir.MirStatement generated_assign(
        self,
        mir.MirPlace destination,
        mir.MirRvalue value,
        token.Span span
    ) {
        return mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: destination,
                value: value
            ))
        );
    }

    mir.MirStatement generated_assign_operand(
        self,
        mir.MirPlace destination,
        mir.MirOperand value,
        token.Span span
    ) {
        return self.generated_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (value: value)),
            span
        );
    }

    mir.MirStatement generated_cast_assign(
        self,
        mir.MirPlace destination,
        mir.MirPlace source,
        qid.TypeId target_type,
        token.Span span
    ) {
        return self.generated_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: source)),
                target_type: target_type
            )),
            span
        );
    }

    mir.MirPlace generated_deref_place(self, mir.MirPlace base, Bool raw_pointer) {
        list.ArrayList<mir.MirPlaceElem> projection! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            projection.add(base.projection[index]);
            index = index + 1;
        }
        projection.add(mir.deref_projection_elem(mir.MirDerefProjection (raw_pointer: raw_pointer)));
        return mir.local_place(base.local_id, self.output.projection_array(projection$.ref()));
    }

    mir.MirPlace generated_constant_index_place(self, mir.MirPlace base, Int field_index) {
        list.ArrayList<mir.MirPlaceElem> projection! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            projection.add(base.projection[index]);
            index = index + 1;
        }
        projection.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: field_index)));
        return mir.local_place(base.local_id, self.output.projection_array(projection$.ref()));
    }

    Int? coroutine_frame_field_index(self, mir.MirCoroutineFrameLayout& layout, mir.MirLocalId local_id) {
        Int index! = 0;
        while (index < layout.local_mappings.length) {
            if (layout.local_mappings[index].local_id == local_id) {
                return layout.local_mappings[index].field_index;
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirBlock generated_return_block(self, Int index, token.Span span) {
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(index),
            span: span,
            statements: self.output.empty_statements(),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: true))
            )
        );
    }

    () lower_def_tree(self, qid.DefId def_id) {
        self.lower_def_tree_with_generics(def_id, 0);
    }

    () lower_def_tree_with_generics(self, qid.DefId def_id, Int inherited_generic_count) {
        guard self.hirs.def(def_id) is .some(hir_def) else {
            return;
        }
        Int generic_count = self.lowering_generic_param_count(hir_def, inherited_generic_count);
        self.lower_async_block_members(hir_def, generic_count);
        if (self.is_lowerable_function_decl(hir_def.decl.kind)) {
            if (self.hirs.has_body(hir_def.def_id)
                && generic_count == 0
                && self.function_signature_is_concrete(hir_def.def_id)
            ) {
                self.lower_function(hir_def);
            } else if (self.is_external_function_decl(hir_def)) {
                self.lower_external_function(hir_def);
            }
        }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            self.lower_def_tree_with_generics(hir_def.members.get(index), generic_count);
            index = index + 1;
        }
    }

    () lower_async_block_members(self, hir.HirDef& hir_def, Int inherited_generic_count) {
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.typeck.is_async_block_function(member_def)) {
                self.lower_def_tree_with_generics(member_def, inherited_generic_count);
            }
            index = index + 1;
        }
    }

    Int lowering_generic_param_count(self, hir.HirDef& hir_def, Int inherited_generic_count) {
        Int tree_count = inherited_generic_count + self.generic_param_count_for_def(hir_def.def_id);
        Int owner_count = self.generic_param_count(hir_def);
        if (owner_count > tree_count) {
            // Extension members can be discovered from their module even though
            // their semantic owner is the extended type. Use the owner chain so
            // methods on `extend <T, N: const Int> T[N]` stay instance-only.
            return owner_count;
        }
        return tree_count;
    }

    () lower_function(self, hir.HirDef& hir_def) {
        if (self.output.function_id_for_def(hir_def.def_id) != null) {
            return;
        }
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        self.lower_function_with_substitution(
            hir_def,
            empty$.ref(),
            self.output.empty_type_args(),
            self.output.empty_const_args()
        );
    }

    Bool is_lowerable_function_decl(self, hir.HirDeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    Bool function_signature_is_concrete(self, qid.DefId function_def) {
        guard self.typeck.def_type(function_def) is .some(type_id) else {
            return false;
        }
        return self.type_is_concrete(type_id);
    }

    Bool is_external_function_decl(self, hir.HirDef& hir_def) {
        if (self.hirs.has_body(hir_def.def_id) || self.generic_param_count(hir_def) != 0) {
            return false;
        }
        guard self.ctx.store.defs.get(hir_def.def_id).owner_def is .some(owner_def) else {
            return false;
        }
        def.DefKind owner_kind = self.ctx.store.defs.get(owner_def).kind;
        if (owner_kind == .module_def) { return true; }
        return owner_kind == .package_def;
    }

    // 第二阶段 lower concrete generic instances。它们不会出现在 HIR ownership
    // tree 里，只存在于 MonomorphStore 中。
    () lower_instances(self) {
        Int index! = 0;
        while (index < self.instances.len()) {
            self.lower_instance(self.instances.get(index));
            index = index + 1;
        }
    }

    () lower_instance(self, monomorph.InstanceKey instance) {
        if (monomorph.instance_kind(self.ctx.store$.ref(), instance) != .function_body) {
            return;
        }
        // Some source-level generic bindings canonicalize to a non-generic MIR
        // symbol, for example builtin type extensions whose semantic owner has
        // been rebound through core. Once backend args are empty, DefId is the
        // only MIR identity and the direct non-generic path owns the body.
        if (instance.type_args.length == 0 && instance.const_args.length == 0) {
            if (self.output.function_id_for_def(instance.def_id) != null) {
                return;
            }
        }
        if (!self.type_args_are_concrete(instance.type_args)) {
            return;
        }
        if (self.output.function_id_for_instance(instance.def_id, instance.type_args, instance.const_args) != null) {
            return;
        }
        guard self.hirs.def(instance.def_id) is .some(hir_def) else {
            return;
        }
        if (!self.hirs.has_body(hir_def.def_id)) {
            return;
        }
        // instance.type_args 先绑定到泛型参数 DefId，body lowering 后续所有
        // 类型读取都通过 substitutions 转成 concrete TypeId。
        monomorph.SubstitutionMap substitutions = monomorph.build_substitution(
            self.ctx.store$.ref(),
            hir_def,
            instance
        );
        self.lower_function_with_substitution(
            hir_def,
            substitutions$.ref(),
            instance.type_args,
            instance.const_args
        );
    }

    () lower_function_with_substitution(self,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        mir.MirFunctionKey lowering_key = mir.MirFunctionKey(
            hir_def.def_id, type_args, const_args
        );
        self.lowering_functions.set(lowering_key, true);
        Int provisional_function_index = self.output.functions.len();
        // HIR 不再直接携带 span；诊断位置后续通过 SourceMap 查询。
        token.Span span = self.def_span(hir_def.def_id);
        BodyLowerer body_lowerer! = BodyLowerer(
            self,
            mir.MirBodyId.from_index(provisional_function_index),
            hir_def,
            substitutions,
            type_args,
            const_args,
            span
        );
        mir.MirBlockId cancellation_entry = body_lowerer.cancellation_entry;
        mir.MirBody mir_body! = body_lowerer.lower();
        Int function_index = self.output.functions.len();
        mir_body = self.body_with_id(mir_body, mir.MirBodyId.from_index(function_index));
        types.EffectSet effects = self.function_effects_for_def(hir_def.def_id, substitutions);
        mir.MirFunction function! = mir.MirFunction (
            id: mir.MirFunctionId.from_index(function_index),
            def_id: hir_def.def_id,
            type_args: self.output.type_arg_array(type_args),
            const_args: self.output.const_arg_array(const_args),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: null,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: self.def_is_language_entry(hir_def.def_id),
            is_runtime_entry: false,
            is_external: false,
            inline_always: hir_def.decl.inline_mode == .always,
            naked: hir_def.decl.naked,
            span: span,
            body: mir_body
        );
        if (effects.has_async) {
            mir.MirFunction borrow_check_source! = function;
            function = drop_elaborate.elaborate_function(self.ctx, self.output, function);
            function.coroutine_frame = self.coroutine_frame_layout_for_body(
                hir_def.def_id, function.body, effects, cancellation_entry
            );
            borrow_check_source.coroutine_frame = function.coroutine_frame;
            self.output.set_borrow_check_override(borrow_check_source$.move());
            self.output.mark_drop_elaborated(function.id);
        }
        self.output.add_function(function);
        self.lowering_functions.remove(lowering_key);
    }

    Bool function_is_lowering(
        self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return self.lowering_functions.has(mir.MirFunctionKey(
            function_def, type_args, const_args
        ));
    }

    @life(body > return)
    mir.MirBody body_with_id(self, mir.MirBody body, mir.MirBodyId body_id) {
        return mir.MirBody (
            id: body_id,
            span: body.span,
            locals: body.locals,
            blocks: body.blocks,
            entry: body.entry,
            return_local: body.return_local
        );
    }

    () lower_external_function(self, hir.HirDef& hir_def) {
        if (self.output.function_id_for_def(hir_def.def_id) != null) {
            return;
        }
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(hir_def.def_id);
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        types.EffectSet effects = self.function_effects_for_def(hir_def.def_id, empty$.ref());
        mir.MirBody mir_body = self.external_function_body(mir.MirBodyId.from_index(function_index), hir_def, span);
        mir.MirCoroutineFrameLayout? coroutine_frame = self.external_coroutine_frame_layout(
            mir.MirBodyId.from_index(function_index), hir_def.def_id, effects, span
        );
        self.output.add_function(mir.MirFunction (
            id: mir.MirFunctionId.from_index(function_index),
            def_id: hir_def.def_id,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: coroutine_frame,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: true,
            inline_always: false,
            naked: false,
            span: span,
            body: mir_body
        ));
    }

    mir.MirCoroutineFrameLayout? external_coroutine_frame_layout(
        self,
        mir.MirBodyId body_id,
        qid.DefId function_def,
        types.EffectSet effects,
        token.Span span
    ) {
        if (!effects.has_async) { return null; }
        mir.MirBody source_body = self.external_source_function_body(body_id, function_def, span);
        return self.coroutine_frame_layout_for_body(
            function_def, source_body, effects, source_body.entry
        );
    }

    () ensure_external_function(self, qid.DefId function_def) {
        if (self.output.function_id_for_def(function_def) != null) {
            return;
        }
        if (self.def_is_trait_member(function_def)) {
            return;
        }
        if (self.hirs.def(function_def) is .some(hir_def)) {
            if (self.hirs.has_body(hir_def.def_id)) { return; }
            self.lower_external_function(hir_def);
            return;
        }
        self.lower_external_function_def(function_def);
    }

    Bool def_is_trait_member(self, qid.DefId def_id) {
        guard self.ctx.store.defs.get(def_id).owner_def is .some(owner_def) else {
            return false;
        }
        return self.ctx.store.defs.get(owner_def).kind == .trait_def;
    }

    () ensure_function_instance(self, qid.DefId function_def, qid.TypeId[]& type_args) {
        self.ensure_function_instance_with_const_args(function_def, type_args, self.output.empty_const_args());
    }

    () ensure_function_instance_with_const_args(self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.length == 0 && const_args.length == 0) {
            return;
        }
        if (!self.type_args_are_concrete(type_args)) {
            return;
        }
        if (self.output.function_id_for_instance(function_def, type_args, const_args) != null) {
            return;
        }
        if (self.instances.instance_for_codegen_args(function_def, type_args, const_args) is .some(instance)) {
            self.lower_instance(instance);
            return;
        }
        self.lower_instance(monomorph.InstanceKey(function_def, type_args, const_args));
    }

    Bool type_args_are_concrete(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(type_args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_concrete(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.ctx.store.defs.get(named.def_id).kind == .generic_param_def) {
                return false;
            }
            return self.type_args_are_concrete(named.type_args);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(handle.element);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(optional.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(tuple_type.items);
        }
        return true;
    }

    () ensure_custom_deinit_instances(self) {
        // drop elaboration 会把 concrete nominal local/field 改写成 deinit 调用。
        // 这些调用目标必须在 MIR 阶段就补齐，backend 只能消费完整 MIR。
        Int function_index! = 0;
        while (function_index < self.output.functions.len()) {
            mir.MirFunction& function = self.output.functions.ref_at(function_index);
            self.ensure_custom_deinit_instances_for_body(function.body);
            function_index = function_index + 1;
        }
    }

    () ensure_custom_deinit_instances_for_body(self, mir.MirBody body) {
        Int local_index! = 0;
        while (local_index < body.locals.length) {
            self.ensure_custom_deinit_instance_for_type(body.locals[local_index].type_id);
            local_index = local_index + 1;
        }
    }

    () ensure_custom_deinit_instance_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            self.ensure_custom_deinit_instance_for_named(named);
            self.ensure_custom_deinit_instances_for_type_args(named.type_args);
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.ensure_custom_deinit_instance_for_type(handle.element);
            return;
        }
        if (info.data is .optional(optional)) {
            self.ensure_custom_deinit_instance_for_type(optional.element);
            return;
        }
        if (info.data is .array_type(array_type)) {
            self.ensure_custom_deinit_instance_for_type(array_type.element);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.ensure_custom_deinit_instances_for_type_args(tuple_type.items);
        }
    }

    () ensure_custom_deinit_instances_for_type_args(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            self.ensure_custom_deinit_instance_for_type(type_args[index]);
            index = index + 1;
        }
    }

    () ensure_custom_deinit_instance_for_named(self, types.NamedType named) {
        if (named.type_args.length == 0 || !self.type_args_are_concrete(named.type_args)) {
            return;
        }
        guard self.hirs.def(named.def_id) is .some(hir_def) else {
            return;
        }
        guard hir_def.custom_deinit_def is .some(deinit_def) else {
            return;
        }
        self.ensure_function_instance(deinit_def, named.type_args);
    }

    () lower_external_function_def(self, qid.DefId function_def) {
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(function_def);
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        types.EffectSet effects = self.function_effects_for_def(function_def, empty$.ref());
        mir.MirBody body = self.external_function_body_for_def(
            mir.MirBodyId.from_index(function_index), function_def, span
        );
        self.output.add_function(mir.MirFunction (
            id: mir.MirFunctionId.from_index(function_index),
            def_id: function_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: self.external_coroutine_frame_layout(
                mir.MirBodyId.from_index(function_index), function_def, effects, span
            ),
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: true,
            inline_always: false,
            naked: false,
            span: span,
            body: body
        ));
    }

    () lower_runtime_entry(self) {
        guard self.language_main_def() is .some(main_def) else { return; }
        guard self.hirs.def(main_def) is .some(main_hir_def) else { return; }
        self.lower_function(main_hir_def);
        self.add_runtime_entry_for_main(main_def);
    }

    qid.DefId? language_main_def(self) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(self.graph.root_module);
        return self.main_member_def(module.def_id);
    }

    qid.DefId? main_member_def(self, qid.DefId owner_def) {
        guard self.hirs.def(owner_def) is .some(hir_def) else { return null; }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.def_is_language_main(member_def)) { return member_def; }
            index = index + 1;
        }
        return null;
    }

    Bool def_is_language_main(self, qid.DefId def_id) {
        if (self.ctx.store.defs.get(def_id).kind != .function_def) { return false; }
        qid.SymbolId symbol_id = self.ctx.store.defs.get(def_id).name.symbol;
        return string.equal(self.ctx.store.symbols.text(symbol_id), "main");
    }

    Bool def_is_language_entry(self, qid.DefId def_id) {
        guard self.language_main_def() is .some(main_def) else { return false; }
        return main_def.to_index() == def_id.to_index();
    }

    () add_runtime_entry_for_main(self, qid.DefId main_def) {
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(main_def);
        self.output.add_function(mir.MirFunction (
            id: mir.MirFunctionId.from_index(function_index),
            def_id: main_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: true,
            is_external: false,
            inline_always: false,
            naked: false,
            span: span,
            body: self.runtime_entry_body(mir.MirBodyId.from_index(function_index), main_def, span)
        ));
    }

    mir.MirBody external_function_body(self, mir.MirBodyId body_id, hir.HirDef& hir_def, token.Span span) {
        return self.external_function_body_for_def(body_id, hir_def.def_id, span);
    }

    mir.MirBody external_function_body_for_def(self, mir.MirBodyId body_id, qid.DefId function_def, token.Span span) {
        qid.TypeId function_type_id! = self.ctx.store.types.invalid_type();
        if (self.typeck.def_type(function_def) is .some(type_id)) {
            function_type_id = type_id;
        }
        types.TypeInfo info = self.ctx.store.types.get(function_type_id);
        guard info.data is .function_type(function_type) else {
            return self.empty_external_body(body_id, span);
        }

        if (function_type.effects.has_async) {
            return self.external_async_function_body(body_id, function_type, span);
        }

        return self.external_source_body_for_type(body_id, function_type, span);
    }

    mir.MirBody external_source_function_body(
        self,
        mir.MirBodyId body_id,
        qid.DefId function_def,
        token.Span span
    ) {
        guard self.typeck.def_type(function_def) is .some(function_type_id) else {
            return self.empty_external_body(body_id, span);
        }
        types.TypeInfo info = self.ctx.store.types.get(function_type_id);
        guard info.data is .function_type(function_type) else {
            return self.empty_external_body(body_id, span);
        }
        return self.external_source_body_for_type(body_id, function_type, span);
    }

    mir.MirBody external_source_body_for_type(
        self,
        mir.MirBodyId body_id,
        types.FunctionType function_type,
        token.Span span
    ) {
        unsafe {
            Int local_count = function_type.params.length + 1;
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(local_count);
            locals[0] = self.runtime_local(mir.MirLocalId.from_index(0), .return_place, function_type.result, span);
            Int index! = 0;
            while (index < function_type.params.length) {
                locals[index + 1] = self.runtime_local(
                    mir.MirLocalId.from_index(index + 1),
                    .param,
                    function_type.params[index],
                    span
                );
                index = index + 1;
            }
            return mir.MirBody (
                id: body_id,
                span: span,
                locals: locals[0..local_count],
                blocks: self.output.empty_blocks(),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    mir.MirBody external_async_function_body(
        self,
        mir.MirBodyId body_id,
        types.FunctionType function_type,
        token.Span span
    ) {
        unsafe {
            Int source_param_count = function_type.params.length;
            Int local_count = source_param_count + 2;
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(local_count);
            locals[0] = self.runtime_local(
                mir.MirLocalId.from_index(0),
                .return_place,
                self.ctx.store.types.unit_type(),
                span
            );
            Int index! = 0;
            while (index < source_param_count) {
                locals[index + 1] = self.runtime_local(
                    mir.MirLocalId.from_index(index + 1),
                    .param,
                    function_type.params[index],
                    span
                );
                index = index + 1;
            }
            locals[source_param_count + 1] = self.runtime_local(
                mir.MirLocalId.from_index(source_param_count + 1),
                .param,
                self.external_async_continuation_layout(function_type.result, span).pointer_type_id,
                span
            );
            return mir.MirBody (
                id: body_id,
                span: span,
                locals: locals[0..local_count],
                blocks: self.output.empty_blocks(),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    qid.TypeId coroutine_context_pointer_type(self, token.Span span) {
        return self.ctx.store.types.opaque_pointer_type(span);
    }

    qid.TypeId coroutine_continuation_type(self, qid.TypeId context_type, token.Span span) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(context_type);
        return self.ctx.store.types.function_type(params$.move(), self.ctx.store.types.unit_type(), span);
    }

    mir.MirExternalContinuationLayout external_async_continuation_layout(
        self,
        qid.TypeId result_type,
        token.Span span
    ) {
        qid.TypeId context_type = self.coroutine_context_pointer_type(span);
        qid.TypeId resume_type = self.coroutine_continuation_type(context_type, span);
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(7);
        fields.add(self.ctx.store.types.raw_pointer_type(result_type, span));
        fields.add(context_type);
        fields.add(resume_type);
        fields.add(context_type);
        fields.add(context_type);
        fields.add(context_type);
        fields.add(resume_type);
        qid.TypeId type_id = self.ctx.store.types.tuple_type(fields$.move(), span);
        return mir.MirExternalContinuationLayout (
            type_id: type_id,
            pointer_type_id: self.ctx.store.types.raw_pointer_type(type_id, span),
            result_field_index: 0,
            context_field_index: 1,
            resume_field_index: 2,
            executor_field_index: 3,
            target_context_field_index: 4,
            target_resume_field_index: 5,
            cancellation_context_field_index: 6
        );
    }

    mir.MirTaskWaiterLayout task_waiter_layout(self, token.Span span) {
        qid.TypeId pointer_type = self.coroutine_context_pointer_type(span);
        qid.TypeId resume_type = self.coroutine_continuation_type(pointer_type, span);
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(4);
        fields.add(pointer_type);
        fields.add(resume_type);
        fields.add(pointer_type);
        fields.add(pointer_type);
        qid.TypeId type_id = self.ctx.store.types.tuple_type(fields$.move(), span);
        return mir.MirTaskWaiterLayout (
            type_id: type_id,
            pointer_type_id: self.ctx.store.types.raw_pointer_type(type_id, span),
            context_field_index: 0,
            resume_field_index: 1,
            executor_field_index: 2,
            task_field_index: 3
        );
    }

    mir.MirSuspendContinuationLayout suspend_continuation_layout(
        self,
        qid.TypeId result_type,
        token.Span span
    ) {
        return coroutine_frame_layout.build_suspend_continuation_layout(
            self.ctx.store.types$.ref(), result_type, span
        );
    }

    qid.TypeId external_async_abi_function_type(self, qid.TypeId source_type, token.Span span) {
        types.TypeInfo info = self.ctx.store.types.get(source_type);
        guard info.data is .function_type(function_type) else {
            return source_type;
        }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length + 1);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(function_type.params[index]);
            index = index + 1;
        }
        params.add(self.external_async_continuation_layout(function_type.result, span).pointer_type_id);
        return self.ctx.store.types.function_type(params$.move(), self.ctx.store.types.unit_type(), span);
    }

    mir.MirBody empty_external_body(self, mir.MirBodyId body_id, token.Span span) {
        unsafe {
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(1);
            locals[0] = self.runtime_local(
                mir.MirLocalId.from_index(0),
                .return_place,
                self.ctx.store.types.unit_type(),
                span
            );
            return mir.MirBody (
                id: body_id,
                span: span,
                locals: locals[0..1],
                blocks: self.output.empty_blocks(),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    mir.MirBody runtime_entry_body(self, mir.MirBodyId body_id, qid.DefId main_def, token.Span span) {
        unsafe {
            if (self.output.function_id_for_def(main_def) == null) {
                return self.empty_external_body(body_id, span);
            }
            qid.TypeId int_type = self.ctx.store.types.int_type();
            qid.TypeId main_type = self.typeck.def_type(main_def)$.some();
            qid.TypeId main_result_type = self.function_result_type(main_type);
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(2);
            locals[0] = self.runtime_local(mir.MirLocalId.from_index(0), .return_place, int_type, span);
            locals[1] = self.runtime_local(mir.MirLocalId.from_index(1), .compiler_temp, main_result_type, span);

            list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
            blocks.add(self.runtime_call_main_block(main_def, main_type, span));
            blocks.add(self.runtime_return_block(main_result_type, span));
            return mir.MirBody (
                id: body_id,
                span: span,
                locals: locals[0..2],
                blocks: self.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    mir.MirBody async_runtime_entry_body(
        self,
        mir.MirBodyId body_id,
        mir.MirFunction main_function,
        mir.MirCoroutineFrameLayout& layout,
        token.Span span
    ) {
        unsafe {
            mir.MirLocalDecl*! locals = self.output.alloc_local_array(4);
            locals[0] = self.runtime_local(
                mir.MirLocalId.from_index(0), .return_place, self.ctx.store.types.int_type(), span
            );
            locals[1] = self.runtime_local(
                mir.MirLocalId.from_index(1), .compiler_temp, layout.task_abi.task_type_id, span
            );
            locals[2] = self.runtime_local(
                mir.MirLocalId.from_index(2), .compiler_temp, layout.frame_type_id, span
            );
            locals[3] = self.runtime_local(
                mir.MirLocalId.from_index(3), .compiler_temp, self.ctx.store.types.unit_type(), span
            );
            mir.MirPlace task_place = self.runtime_place(mir.MirLocalId.from_index(1));
            mir.MirPlace frame_place = self.runtime_place(mir.MirLocalId.from_index(2));
            mir.MirFunctionRef resume_function = self.runtime_coroutine_function_ref(
                main_function, layout, true, span
            );
            mir.MirFunctionRef completion_function = self.runtime_coroutine_function_ref(
                main_function, layout, false, span
            );
            mir.MirStatement[]& initializers = coroutine_task_abi.initializers(
                self.output,
                layout,
                task_place,
                frame_place,
                resume_function,
                completion_function,
                span
            );
            list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
            blocks.add(self.async_runtime_resume_block(layout, task_place, initializers, span));
            blocks.add(self.async_runtime_return_block(layout, task_place, span));
            return mir.MirBody (
                id: body_id,
                span: span,
                locals: locals[0..4],
                blocks: self.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
        }
    }

    mir.MirFunctionRef runtime_coroutine_function_ref(
        self,
        mir.MirFunction function,
        mir.MirCoroutineFrameLayout& layout,
        Bool resume,
        token.Span span
    ) {
        qid.TypeId type_id! = layout.fields[layout.continuation_function_field_index].type_id;
        if (resume) { type_id = layout.task_abi.resume_function_type_id; }
        return mir.MirFunctionRef (
            function_def: function.def_id,
            type_args: self.output.type_arg_array(function.type_args),
            const_args: self.output.const_arg_array(function.const_args),
            coroutine_resume: resume,
            coroutine_completion: !resume,
            type_id: type_id,
            span: span
        );
    }

    @life(initializers > return)
    mir.MirBlock async_runtime_resume_block(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace task_place,
        mir.MirStatement[]& initializers,
        token.Span span
    ) {
        mir.MirPlace frame_pointer = coroutine_task_abi.task_field_place(
            self.output, task_place, layout.task_abi.frame_field
        );
        mir.MirPlace resume_function = coroutine_task_abi.task_field_place(
            self.output, task_place, layout.task_abi.resume_function_field
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (place: frame_pointer)));
        mir.MirCallCallee callee = mir.indirect_operand_callee(
            mir.copy_operand_value(mir.MirCopyOperand (place: resume_function))
        );
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: initializers,
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: callee,
                    args: self.output.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    async_start: mir.MirAsyncStartKind.observed_task,
                    destination: self.runtime_place(mir.MirLocalId.from_index(3)),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirBlock async_runtime_return_block(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace task_place,
        token.Span span
    ) {
        mir.MirPlace result_place = coroutine_task_abi.task_field_place(
            self.output, task_place, layout.task_abi.result_field
        );
        mir.MirOperand exit_code = self.runtime_async_exit_operand(result_place, layout.task_abi.result_type_id, span);
        list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(1);
        statements.add(mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: self.runtime_place(mir.MirLocalId.from_index(0)),
                value: mir.use_rvalue(mir.MirUseRvalue (value: exit_code))
            ))
        ));
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(1),
            span: span,
            statements: self.output.statement_array(statements$.ref()),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: false))
            )
        );
    }

    mir.MirOperand runtime_async_exit_operand(
        self,
        mir.MirPlace result_place,
        qid.TypeId result_type,
        token.Span span
    ) {
        if (result_type.to_index() == self.ctx.store.types.unit_type().to_index()) {
            return mir.const_operand_value(mir.MirConst (
                type_id: self.ctx.store.types.int_type(),
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: 0, signed_value: true))
            ));
        }
        return mir.copy_operand_value(mir.MirCopyOperand (place: result_place));
    }

    types.FunctionType function_type_or_empty(self, qid.TypeId callee_type) {
        types.TypeInfo info = self.ctx.store.types.get(callee_type);
        if (info.data is .function_type(function_info)) {
            return function_info;
        }
        return types.FunctionType (
            params: self.output.empty_type_args(),
            result: self.ctx.store.types.unit_type(),
            effects: types.EffectSet(),
            kind: .raw
        );
    }

    qid.TypeId function_result_type(self, qid.TypeId callee_type) {
        types.TypeInfo info = self.ctx.store.types.get(callee_type);
        if (info.data is .function_type(function_info)) {
            return function_info.result;
        }
        return self.ctx.store.types.unit_type();
    }

    mir.MirLocalDecl runtime_local(self,
        mir.MirLocalId id,
        mir.MirLocalKind kind,
        qid.TypeId type_id,
        token.Span span
    ) {
        return mir.MirLocalDecl (
            id: id,
            kind: kind,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    mir.MirBlock runtime_call_main_block(self,
        qid.DefId main_def,
        qid.TypeId main_type,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(0);
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.output.empty_statements(),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: self.runtime_main_callee(main_def, main_type, span),
                    args: self.output.operand_slice(args.slice()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: self.runtime_place(mir.MirLocalId.from_index(1)),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirCallCallee runtime_main_callee(self, qid.DefId main_def, qid.TypeId main_type, token.Span span) {
        return mir.direct_function_callee(mir.MirFunctionRef (
            function_def: main_def,
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: main_type,
            span: span
        ));
    }

    mir.MirBlock runtime_return_block(self, qid.TypeId main_result_type, token.Span span) {
        list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(1);
        statements.add(mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: self.runtime_place(mir.MirLocalId.from_index(0)),
                value: mir.use_rvalue(mir.MirUseRvalue (
                    value: self.runtime_return_operand(main_result_type, span)
                ))
            ))
        ));
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(1),
            span: span,
            statements: self.output.statement_array(statements$.ref()),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: false))
            )
        );
    }

    mir.MirOperand runtime_return_operand(self, qid.TypeId main_result_type, token.Span span) {
        if (main_result_type.to_index() != self.ctx.store.types.unit_type().to_index()) {
            return mir.copy_operand_value(mir.MirCopyOperand (
                place: self.runtime_place(mir.MirLocalId.from_index(1))
            ));
        }
        return mir.const_operand_value(mir.MirConst (
            type_id: self.ctx.store.types.int_type(),
            span: span,
            value: mir.int_const_kind(mir.MirIntConst (bits: 0, signed_value: true))
        ));
    }

    mir.MirPlace runtime_place(self, mir.MirLocalId local_id) {
        return mir.local_place(local_id, self.output.empty_projection());
    }

    Int generic_param_count(self, hir.HirDef& hir_def) {
        Int count! = self.generic_param_count_for_def(hir_def.def_id);
        qid.DefId? owner! = self.ctx.store.defs.get(hir_def.def_id).owner_def;
        while (owner is .some(owner_def)) {
            if (!self.ctx.store.defs.has(owner_def)) {
                return count;
            }
            count = count + self.generic_param_count_for_def(owner_def);
            owner = self.ctx.store.defs.get(owner_def).owner_def;
        }
        return count;
    }

    Int generic_param_count_for_def(self, qid.DefId def_id) {
        guard self.hirs.def(def_id) is .some(hir_def) else { return 0; }
        return hir_def.generic_params.len();
    }

    Int add_initial_locals(self,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        list.ArrayList<mir.MirLocalDecl>& locals
    ) {
        locals.add(mir.MirLocalDecl (
            id: mir.MirLocalId.from_index(0),
            kind: mir.MirLocalKind.return_place,
            type_id: self.return_type(hir_def, substitutions),
            span: self.def_span(hir_def.def_id),
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        ));
        guard hir_def.body is .some(ref _ body) else {
            return 0;
        }
        Int hir_local_offset! = 0;
        if (self.should_synthesize_closure_env_local(hir_def, body)) {
            locals.add(self.synthetic_closure_env_local(hir_def));
            hir_local_offset = hir_local_offset + 1;
        }
        if (self.should_synthesize_receiver_local(hir_def, body)) {
            locals.add(self.synthetic_receiver_local(hir_def, substitutions, hir_local_offset + 1));
            hir_local_offset = hir_local_offset + 1;
        }
        Int index! = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            locals.add(self.lower_local(hir_def, local, substitutions, index + 1 + hir_local_offset));
            index = index + 1;
        }
        return hir_local_offset;
    }

    Bool should_synthesize_receiver_local(self, hir.HirDef& hir_def, hir.HirBody& body) {
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        if (!signature.has_receiver) {
            return false;
        }
        if (body.locals.len() == 0) {
            return true;
        }
        hir.HirLocal first = body.locals.get_index(0);
        return !string.equal(self.ctx.store.symbols.text(first.symbol), "self");
    }

    Bool should_synthesize_closure_env_local(self, hir.HirDef& hir_def, hir.HirBody& body) {
        if (!hir_def.decl.is_lambda_function) { return false; }
        guard self.typeck.def_type(hir_def.def_id) is .some(type_id) else { return false; }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        Int parameter_count! = 0;
        Int index! = 0;
        while (index < body.locals.len()) {
            if (body.locals.get_index(index).kind == .parameter) {
                parameter_count = parameter_count + 1;
            }
            index = index + 1;
        }
        return function_type.params.length == parameter_count + 1;
    }

    mir.MirLocalDecl synthetic_closure_env_local(self, hir.HirDef& hir_def) {
        token.Span span = self.def_span(hir_def.def_id);
        return mir.MirLocalDecl (
            id: mir.MirLocalId.from_index(1),
            kind: mir.MirLocalKind.param,
            type_id: self.ctx.store.types.opaque_pointer_type(span),
            span: span,
            name: self.ctx.store.symbols.intern("__env"),
            def_id: null,
            mutable_local: false,
            address_taken: false
        );
    }

    mir.MirLocalDecl synthetic_receiver_local(self,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        Int mir_index
    ) {
        token.Span span = self.def_span(hir_def.def_id);
        qid.TypeId type_id = self.receiver_type(hir_def, substitutions, span);
        return mir.MirLocalDecl (
            id: mir.MirLocalId.from_index(mir_index),
            kind: mir.MirLocalKind.param,
            type_id: type_id,
            span: span,
            name: self.ctx.store.symbols.intern("self"),
            def_id: null,
            mutable_local: false,
            address_taken: false
        );
    }

    qid.TypeId receiver_type(self,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        token.Span span
    ) {
        if (self.typeck.def_type(hir_def.def_id) is .some(function_type_id)) {
            qid.TypeId substituted = self.substitute_type(function_type_id, substitutions);
            types.TypeInfo info = self.ctx.store.types.get(substituted);
            if (info.data is .function_type(function_type)) {
                if (function_type.params.length > 0) {
                    return function_type.params[0];
                }
            }
        }
        guard self.ctx.store.defs.get(hir_def.def_id).owner_def is .some(owner_def) else {
            return self.ctx.store.types.invalid_type();
        }
        if (self.ctx.store.types.builtin_type_for_def(owner_def) is .some(type_id)) {
            return self.ctx.store.types.reference_type(type_id, span);
        }
        return self.ctx.store.types.reference_type(self.ctx.store.types.named_type(owner_def, span), span);
    }

    mir.MirLocalDecl lower_local(self,
        hir.HirDef& hir_def,
        hir.HirLocal local,
        monomorph.SubstitutionMap& substitutions,
        Int mir_index
    ) {
        qid.TypeId type_id = self.type_for_local(hir_def, local, substitutions);
        return mir.MirLocalDecl (
            id: mir.MirLocalId.from_index(mir_index),
            kind: self.local_kind(hir_def, local),
            type_id: type_id,
            span: self.def_span(local.def_id),
            name: local.symbol,
            def_id: local.def_id,
            mutable_local: local.mutable_binding,
            address_taken: false
        );
    }

    qid.TypeId type_for_local(self,
        hir.HirDef& hir_def,
        hir.HirLocal local,
        monomorph.SubstitutionMap& substitutions
    ) {
        if (self.local_is_self_receiver(hir_def, local)) {
            return self.receiver_type(hir_def, substitutions, self.def_span(local.def_id));
        }
        if (self.typeck.def_type(local.def_id) is .some(type_id)) {
            return self.substitute_type(type_id, substitutions);
        }
        if (local.type_ref is .some(type_ref)) {
            if (self.typeck.node_type(type_ref) is .some(type_id)) {
                return self.substitute_type(type_id, substitutions);
            }
        }
        return self.ctx.store.types.invalid_type();
    }

    Bool local_is_self_receiver(self, hir.HirDef& hir_def, hir.HirLocal local) {
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        if (!signature.has_receiver) {
            return false;
        }
        return string.equal(self.ctx.store.symbols.text(local.symbol), "self");
    }

    mir.MirLocalKind local_kind(self, hir.HirDef& hir_def, hir.HirLocal local) {
        if (self.local_is_self_receiver(hir_def, local)) {
            return mir.MirLocalKind.param;
        }
        if (local.kind == .parameter) { return mir.MirLocalKind.param; }
        if (self.ctx.store.defs.get(local.def_id).kind == .parameter_def) {
            return mir.MirLocalKind.param;
        }
        return mir.MirLocalKind.user_local;
    }

    qid.TypeId return_type(self, hir.HirDef& hir_def, monomorph.SubstitutionMap& substitutions) {
        if (self.typeck.def_type(hir_def.def_id) is .some(function_type_id)) {
            qid.TypeId substituted = self.substitute_type(function_type_id, substitutions);
            if (self.ctx.store.types.get(substituted).data is .function_type(function_type)) {
                return function_type.result;
            }
        }
        return self.ctx.store.types.unit_type();
    }

    types.EffectSet function_effects_for_def(self,
        qid.DefId function_def,
        monomorph.SubstitutionMap& substitutions
    ) {
        guard self.typeck.def_type(function_def) is .some(function_type_id) else {
            return types.EffectSet();
        }
        qid.TypeId substituted = self.substitute_type(function_type_id, substitutions);
        types.TypeInfo info = self.ctx.store.types.get(substituted);
        guard info.data is .function_type(function_type) else {
            return types.EffectSet();
        }
        return function_type.effects;
    }

    mir.MirCoroutineFrameLayout? coroutine_frame_layout_for_body(
        self,
        qid.DefId function_def,
        mir.MirBody body,
        types.EffectSet effects,
        mir.MirBlockId cancellation_entry
    ) {
        if (!effects.has_async) { return null; }
        mir.MirTaskStateLayout task_state! = self.create_task_state_layout(
            function_def,
            body.locals[body.return_local.to_index()].type_id,
            body.span
        );
        guard coroutine_frame_layout.build_frame_layout(
            self.output,
            self.ctx.store.types$.ref(),
            body,
            effects,
            self.ctx.store.types.int_type(),
            task_state$.ref(),
            cancellation_entry
        ) is .some(layout) else {
            return null;
        }
        mir.MirCoroutineFrameLayout result! = layout;
        if (effects.domain is .some(domain)) {
            result.domain_kind = self.domain_kind_for_type(domain.domain_type);
        }
        return result;
    }

    mir.MirTaskStateLayout create_task_state_layout(
        self,
        qid.DefId function_def,
        qid.TypeId result_type,
        token.Span span
    ) {
        if (table.hash_table_get_value<Int, mir.MirTaskStateLayout>(
                self.task_state_layouts$.ref(), result_type.to_index()
            ) is .some(layout)
        ) {
            return layout;
        }
        qid.DefId state_def = self.create_task_state_def(function_def, result_type, span);
        qid.TypeId state_type = self.ctx.store.types.named_type(state_def, span);
        self.ctx.store.types.bind_task_state_type(result_type, state_type);
        qid.TypeId int_type = self.ctx.store.types.int_type();
        qid.TypeId opaque_pointer = self.ctx.store.types.opaque_pointer_type(span);
        qid.TypeId resume_function = self.task_resume_function_type(span);
        mir.MirTaskStateLayout result = mir.MirTaskStateLayout (
            type_id: state_type,
            schedule_state: self.add_task_state_field(
                state_def, "schedule_state", int_type, span
            ),
            schedule_executor: self.add_task_state_field(
                state_def, "schedule_executor", opaque_pointer, span
            ),
            schedule_context: self.add_task_state_field(
                state_def, "schedule_context", opaque_pointer, span
            ),
            schedule_resume: self.add_task_state_field(
                state_def, "schedule_resume", resume_function, span
            ),
            schedule_active_executor: self.add_task_state_field(
                state_def, "schedule_active_executor", opaque_pointer, span
            ),
            state: self.add_task_state_field(state_def, "state", int_type, span),
            frame: self.add_task_state_field(state_def, "frame", opaque_pointer, span),
            resume_function: self.add_task_state_field(
                state_def, "resume_function", resume_function, span
            ),
            execution_executor: self.add_task_state_field(
                state_def, "execution_executor", opaque_pointer, span
            ),
            cancellation_requested: self.add_task_state_field(
                state_def, "cancellation_requested", int_type, span
            ),
            cancel_target_word: self.add_task_state_field(
                state_def, "cancel_target_word", int_type, span
            ),
            external_ref_count: self.add_task_state_field(
                state_def, "external_ref_count", int_type, span
            ),
            result: self.add_task_state_field(state_def, "result", result_type, span)
        );
        self.task_state_layouts.set(result_type.to_index(), result);
        return result;
    }

    qid.DefId create_task_state_def(
        self,
        qid.DefId function_def,
        qid.TypeId result_type,
        token.Span span
    ) {
        def.DefRecord function_record = self.ctx.store.defs.get(function_def);
        std.String name = build_text_int("__task_state_", result_type.to_index());
        qid.DefId state_def = self.ctx.store.defs.create(
            .struct_def,
            .type_name,
            .private_visibility,
            def.Name(symbol: self.ctx.store.symbols.intern(name.bytes()), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
        self.ctx.store.source_map.set_sourceless_def_span(state_def, span);
        self.hirs.declare_def(state_def, .type_decl);
        self.ctx.store.types.bind_named_type_def(state_def, self.ctx.store.types.named_type(state_def, span));
        return state_def;
    }

    mir.MirSyntheticField add_task_state_field(
        self,
        qid.DefId state_def,
        UInt8[]& name,
        qid.TypeId type_id,
        token.Span span
    ) {
        hir.HirDef& state_hir = self.hirs.def_ref(state_def);
        Int field_index = state_hir.members.len();
        def.DefRecord state_record = self.ctx.store.defs.get(state_def);
        qid.DefId field_def = self.ctx.store.defs.create(
            .field_def,
            .member_name,
            .private_visibility,
            def.Name(symbol: self.ctx.store.symbols.intern(name), span: span),
            state_def,
            state_record.module_id,
            state_record.decl_namespace_id,
            null
        );
        self.ctx.store.source_map.set_sourceless_def_span(field_def, span);
        self.hirs.declare_def(field_def, .field_decl);
        self.hirs.add_member(state_def, field_def);
        self.typeck.set_def_type(field_def, type_id);
        return mir.MirSyntheticField(def_id: field_def, type_id: type_id, index: field_index);
    }

    qid.TypeId task_resume_function_type(self, token.Span span) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.ctx.store.types.opaque_pointer_type(span));
        return self.ctx.store.types.function_type(params$.move(), self.ctx.store.types.unit_type(), span);
    }

    Int domain_kind_for_def(self, qid.DefId domain_def) {
        guard self.ctx.store.resolve.core_traits.domain_trait is .some(domain_trait) else { return -1; }
        qid.SymbolId kind_symbol = self.ctx.store.symbols.intern("kind");
        guard self.hirs.def(domain_trait) is .some(domain_hir) else { return -1; }
        Int index! = 0;
        while (index < domain_hir.members.len()) {
            qid.DefId kind_assoc = domain_hir.members.get(index);
            index = index + 1;
            if (self.ctx.store.defs.get(kind_assoc).name.symbol.to_index() != kind_symbol.to_index()) { continue; }
            return self.domain_kind_for_member(domain_def, kind_assoc);
        }
        return -1;
    }

    Int domain_kind_for_type(self, qid.TypeId domain_type) {
        types.TypeInfo info = self.ctx.store.types.get(domain_type);
        guard info.data is .named(named) else { return -1; }
        return self.domain_kind_for_def(named.def_id);
    }

    Int domain_kind_for_member(self, qid.DefId domain_def, qid.DefId kind_assoc) {
        guard self.hirs.def(domain_def) is .some(domain_hir) else { return -1; }
        Int index! = 0;
        while (index < domain_hir.members.len()) {
            qid.DefId member_def = domain_hir.members.get(index);
            index = index + 1;
            def.DefRecord record = self.ctx.store.defs.get(member_def);
            guard record.associated_trait_member is .some(trait_member) else { continue; }
            if (trait_member != kind_assoc) { continue; }
            guard self.ctx.store.comptime_store.const_value(member_def) is .some(value) else { return -1; }
            guard value.data is .enum_case_value(case_def) else { return -1; }
            if (self.typeck.enum_case_value(case_def) is .some(kind)) { return kind; }
            return -1;
        }
        return -1;
    }

    types.EffectSet effect_set_for_hir(self, hir.HirEffectSet effects) {
        return types.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: self.effect_domain(effects)
        );
    }

    types.DomainEffect? effect_domain(self, hir.HirEffectSet effects) {
        guard effects.domain is .some(domain) else { return null; }
        hir.HirNode node = self.hirs.node(domain);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(raw_binding_def) else { return null; }
        qid.DefId binding_def = self.resolve_alias_target(raw_binding_def);
        guard self.typeck.def_type(binding_def) is .some(binding_type) else { return null; }
        return types.DomainEffect(binding: binding_def, domain_type: binding_type);
    }

    qid.DefId resolve_alias_target(self, qid.DefId def_id) {
        qid.DefId current! = def_id;
        Int depth! = 0;
        while (depth < 64) {
            if (self.ctx.store.defs.get(current).kind != .alias_def) { return current; }
            guard self.hirs.def(current) is .some(hir_def) else { return current; }
            guard hir_def.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    types.EffectSet merge_effects(self, types.EffectSet base, types.EffectSet added) {
        types.DomainEffect? domain! = base.domain;
        if (added.domain is .some(_)) {
            domain = added.domain;
        }
        return types.EffectSet(
            has_unsafe: base.has_unsafe || added.has_unsafe,
            has_async: base.has_async || added.has_async,
            domain: domain
        );
    }

    qid.TypeId substitute_type(self, qid.TypeId type_id, monomorph.SubstitutionMap& substitutions) {
        if (substitutions.len() == 0) {
            return type_id;
        }
        // TypeCheckStore 保存的是泛型模板视角的 TypeId；具体实例的 MIR
        // local/const/temp 必须在这里替换成 concrete TypeId。
        return monomorph.substitute_type(self.ctx.store$.ref(), type_id, substitutions);
    }

    token.Span def_span(self, qid.DefId def_id) {
        if (self.ctx.store.source_map.def_span(def_id) is .some(loc)) {
            return loc.span;
        }
        return token.Span();
    }

    token.Span hir_span(self, hir.HirId hir_id) {
        if (self.ctx.store.source_map.hir_span(hir_id) is .some(loc)) {
            return loc.span;
        }
        return token.Span();
    }
}

// BodyLowerer 负责把单个 HIR function body 转成 MIR CFG。
// block id 先预留再回填，保证 branch/call 提前引用目标 block 时，
// `MirBlockId.index` 仍然等于 `MirBody.blocks[index]`。
struct BodyLowerer: Movable {
    MirLowerer& lowerer;
    mir.MirBodyId body_id;
    hir.HirDef& hir_def;
    monomorph.SubstitutionMap& substitutions;
    qid.TypeId[]& function_type_args;
    comptime_value.ComptimeValue[]& function_const_args;
    token.Span span;
    list.ArrayList<mir.MirLocalDecl> locals!;
    list.ArrayList<mir.MirBlock> blocks!;
    list.ArrayList<mir.MirStatement> statements!;
    list.ArrayList<lower_support.LoopTargets> loop_targets!;
    list.ArrayList<mir.MirLocalId> active_locals!;
    list.ArrayList<hir.HirId> active_defers!;
    typeck_store.LambdaCaptureInfo[]&? lambda_capture_infos;
    types.EffectSet current_effects!;
    mir.MirLocalId? active_coroutine_capture_task!;
    table.HashTable<Int, mir.MirTaskStoragePlan> task_storage_plans;
    table.HashTable<Int, Bool> cancellation_task_defs;
    table.HashTable<Int, hir.HirId> known_lambda_initializers;
    Int hir_local_offset!;
    mir.MirBlockId current_block!;
    mir.MirBlockId cancellation_entry!;
    Bool terminated!;

    public init(self,
        MirLowerer& lowerer,
        mir.MirBodyId body_id,
        hir.HirDef& hir_def,
        monomorph.SubstitutionMap& substitutions,
        qid.TypeId[]& function_type_args,
        comptime_value.ComptimeValue[]& function_const_args,
        token.Span span
    ) {
        self.lowerer = lowerer;
        self.body_id = body_id;
        self.hir_def = hir_def;
        self.substitutions = substitutions;
        self.function_type_args = function_type_args;
        self.function_const_args = function_const_args;
        self.span = span;
        self.locals = list.ArrayList<mir.MirLocalDecl>();
        self.blocks = list.ArrayList<mir.MirBlock>();
        self.statements = list.ArrayList<mir.MirStatement>();
        self.loop_targets = list.ArrayList<lower_support.LoopTargets>();
        self.active_locals = list.ArrayList<mir.MirLocalId>();
        self.active_defers = list.ArrayList<hir.HirId>();
        self.lambda_capture_infos = lowerer.typeck.lambda_capture_infos(hir_def.def_id);
        self.current_effects = lowerer.function_effects_for_def(hir_def.def_id, substitutions);
        self.active_coroutine_capture_task = null;
        self.task_storage_plans = table.HashTable<Int, mir.MirTaskStoragePlan>();
        self.cancellation_task_defs = table.HashTable<Int, Bool>();
        self.collect_cancellation_task_defs();
        self.known_lambda_initializers = table.HashTable<Int, hir.HirId>();
        self.current_block = self.reserve_block(span);
        self.cancellation_entry = self.current_block;
        if (self.current_effects.has_async) {
            self.cancellation_entry = self.reserve_block(span);
        }
        self.terminated = false;
        self.hir_local_offset = self.lowerer.add_initial_locals(hir_def, substitutions, self.locals$.ref());
    }

    mir.MirBody lower(self) {
        self.initialize_task_local_handles();
        if (self.hir_def.body is .some(ref _ body)) {
            self.lower_root(body.root);
        }
        if (!self.terminated) {
            self.finish_block(mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: true)), self.span);
        }
        self.lower_cancellation_entry();
        return mir.MirBody (
            id: self.body_id,
            span: self.span,
            locals: self.freeze_locals(),
            blocks: self.lowerer.output.block_array(self.blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: self.return_local()
        );
    }

    () lower_cancellation_entry(self) {
        if (!self.current_effects.has_async) { return; }
        self.start_block(self.cancellation_entry);
        list.ArrayList<mir.MirLocalId> cleanup_locals! = list.ArrayList<mir.MirLocalId>();
        Int index! = 0;
        while (index < self.locals.len()) {
            mir.MirLocalDecl local = self.locals.get(index);
            index = index + 1;
            if (local.id.to_index() == self.return_local().to_index()) { continue; }
            if (local.kind == mir.MirLocalKind.compiler_temp) { continue; }
            cleanup_locals.add(local.id);
        }
        self.cleanup_local_range(cleanup_locals$.ref(), 0, self.span);
        self.finish_block(
            mir.cancel_terminator_kind(mir.MirCancelTerminator()), self.span
        );
    }

    () initialize_task_local_handles(self) {
        if (!self.current_effects.has_async) { return; }
        Int index! = 0;
        while (index < self.locals.len()) {
            mir.MirLocalDecl local = self.locals.get(index);
            index = index + 1;
            if (local.kind != mir.MirLocalKind.user_local) { continue; }
            if (!(self.lowerer.ctx.store.types.get(local.type_id).data is .task_type(_))) { continue; }
            mir.MirPlace task_place = self.place_for_local(local.id);
            mir.MirPlace pointer = coroutine_task_abi.task_handle_pointer_place(
                self.lowerer.output, task_place
            );
            self.push_assign(
                pointer,
                mir.use_rvalue(mir.MirUseRvalue (
                    value: self.null_operand(self.mir_place_type(pointer), local.span)
                )),
                local.span
            );
        }
    }

    hir.HirLocal hir_local(self, hir.HirLocalId local_id) {
        guard self.hir_def.body is .some(ref _ body) else {
            return hir.HirLocal(
                local_id,
                .local_variable,
                self.lowerer.ctx.store.symbols.intern("<invalid>"),
                qid.DefId.from_index(0),
                false,
                false,
                null
            );
        }
        return body.local(local_id);
    }

    () lower_root(self, hir.HirId root) {
        hir.HirNode node = self.lowerer.hirs.node(root);
        if (node.data is .block(block)) {
            self.lower_root_block(block);
            return;
        }
        self.assign_return_value(root);
        if (!self.terminated) {
            self.push_active_storage_dead_from(0, self.lowerer.hir_span(root));
            self.finish_return(false, self.lowerer.hir_span(root));
        }
    }

    () lower_root_block(self, hir.HirBlock block) {
        types.EffectSet saved_effects = self.enter_block_effects(block.effects);
        list.ArrayList<mir.MirLocalId> scope_locals! = list.ArrayList<mir.MirLocalId>();
        Int defer_depth = self.active_defers.len();
        Int index! = 0;
        while (index < block.statements.length) {
            if (self.terminated) {
                self.current_effects = saved_effects;
                return;
            }
            self.lower_statement_node(block.statements[index], scope_locals$.ref());
            index = index + 1;
        }
        if (self.terminated) {
            self.current_effects = saved_effects;
            return;
        }
        if (block.result is .some(result)) {
            self.assign_return_value(result);
            if (!self.terminated) {
                self.run_deferred_from(defer_depth, self.lowerer.hir_span(result));
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
                self.push_active_storage_dead_from(0, self.lowerer.hir_span(result));
                self.finish_return(false, self.lowerer.hir_span(result));
            }
            self.current_effects = saved_effects;
            return;
        }
        self.run_deferred_from(defer_depth, self.span);
        self.end_scope(scope_locals$.ref(), self.span);
        self.push_active_storage_dead_from(0, self.span);
        self.finish_unit_return(self.span);
        self.current_effects = saved_effects;
    }

    types.EffectSet enter_block_effects(self, hir.HirEffectSet effects) {
        types.EffectSet saved = self.current_effects;
        types.EffectSet block_effects = self.lowerer.effect_set_for_hir(effects);
        self.current_effects = self.lowerer.merge_effects(self.current_effects, block_effects);
        return saved;
    }

    () lower_statement_node(self, hir.HirId node_id, list.ArrayList<mir.MirLocalId>& scope_locals) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .let_stmt(let_stmt)) {
            scope_locals.add(self.lower_let(node_id, let_stmt));
            return;
        }
        if (node.data is .destructure_stmt(destructure)) {
            self.lower_destructure(node_id, destructure, scope_locals);
            return;
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.lower_defer(defer_stmt);
            return;
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            self.lower_guard(node_id, guard_stmt);
            return;
        }
        if (node.data is .return_stmt(return_stmt)) {
            self.lower_return(node_id, return_stmt);
            return;
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            self.lower_throw(node_id, throw_stmt);
            return;
        }
        if (node.data is .break_stmt) {
            self.lower_break(node_id);
            return;
        }
        if (node.data is .continue_stmt) {
            self.lower_continue(node_id);
            return;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.lower_assign(node_id, assign_stmt);
            return;
        }
        if (self.is_expr_statement(node)) {
            self.lower_expr_statement(node_id);
            return;
        }
        self.mark_unsupported(node_id);
    }

    Bool is_expr_statement(self, hir.HirNode node) {
        if (node.data is .block(_)) { return true; }
        if (node.data is .name_ref(_)) { return true; }
        if (node.data is .member_access(_)) { return true; }
        if (node.data is .index_access(_)) { return true; }
        if (node.data is .slice_access(_)) { return true; }
        if (node.data is .call(_)) { return true; }
        if (node.data is .implicit_call(_)) { return true; }
        if (node.data is .literal(_)) { return true; }
        if (node.data is .unary(_)) { return true; }
        if (node.data is .binary(_)) { return true; }
        if (node.data is .inline_asm(_)) { return true; }
        if (node.data is .if_expr(_)) { return true; }
        if (node.data is .loop_expr(_)) { return true; }
        if (node.data is .switch_expr(_)) { return true; }
        if (node.data is .catch_expr(_)) { return true; }
        if (node.data is .await_expr(_)) { return true; }
        if (node.data is .await_task_expr(_)) { return true; }
        if (node.data is .cancel_task_expr(_)) { return true; }
        if (node.data is .task_cancellation_expr(_)) { return true; }
        if (node.data is .propagate_error_expr(_)) { return true; }
        return false;
    }

    () lower_expr_statement(self, hir.HirId node_id) {
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
        if (!self.terminated) {
            self.push_storage_dead(temp, self.lowerer.hir_span(node_id));
        }
    }

    () lower_defer(self, hir.HirDefer defer_stmt) {
        self.active_defers.add(defer_stmt.body);
    }

    mir.MirLocalId lower_let(self, hir.HirId node_id, hir.HirLet let_stmt) {
        mir.MirLocalId local_id = self.mir_local_for_hir(let_stmt.local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(node_id));
        if (let_stmt.initializer is .some(initializer)) {
            hir.HirLocal local = self.hir_local(let_stmt.local_id);
            if (local.borrow_binding) {
                self.lower_borrow_binding_initializer(initializer, self.place_for_local(local_id));
                return local_id;
            }
            self.lower_into_place(initializer, self.place_for_local(local_id));
            hir.HirNode value = self.lowerer.hirs.node(initializer);
            if (!local.mutable_binding && value.data is .lambda_expr(_)) {
                self.known_lambda_initializers.set(
                    let_stmt.local_id.to_index(), initializer
                );
            }
        }
        return local_id;
    }

    () lower_destructure(self,
        hir.HirId node_id,
        hir.HirDestructure destructure,
        list.ArrayList<mir.MirLocalId>& scope_locals
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId source_local = self.add_temp(self.type_for_node(destructure.initializer), span);
        mir.MirPlace source_place = self.place_for_local(source_local);
        scope_locals.add(source_local);
        self.active_locals.add(source_local);
        self.push_storage_live(source_local, span);
        self.lower_into_place(destructure.initializer, source_place);
        Int index! = 0;
        while (index < destructure.bindings.length) {
            mir.MirPlace item_place = self.project_constant_index(source_place, index);
            self.lower_destructure_binding(destructure.bindings[index], item_place, scope_locals);
            index = index + 1;
        }
    }

    () lower_destructure_binding(self,
        hir.HirId pattern_id,
        mir.MirPlace source,
        list.ArrayList<mir.MirLocalId>& scope_locals
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) { return; }
        guard pattern.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        scope_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(pattern_id));
        hir.HirLocal local = self.hir_local(binding.local_id);
        if (local.borrow_binding) {
            self.push_assign(
                self.place_for_local(local_id),
                mir.borrow_rvalue(mir.MirBorrowRvalue (place: source)),
                self.lowerer.hir_span(pattern_id)
            );
            return;
        }
        self.push_assign(
            self.place_for_local(local_id),
            mir.use_rvalue(mir.MirUseRvalue (value: mir.copy_operand_value(mir.MirCopyOperand (place: source)))),
            self.lowerer.hir_span(pattern_id)
        );
    }

    () lower_borrow_binding_initializer(self, hir.HirId initializer, mir.MirPlace destination) {
        guard self.place_for_expr(initializer) is .some(source) else {
            self.mark_unsupported(initializer);
            return;
        }
        self.push_assign(
            destination,
            mir.borrow_rvalue(mir.MirBorrowRvalue (place: source)),
            self.lowerer.hir_span(initializer)
        );
    }

    () lower_return(self, hir.HirId node_id, hir.HirReturn return_stmt) {
        if (return_stmt.value is .some(value)) {
            self.assign_return_value(value);
            if (self.terminated) { return; }
            self.run_deferred_from(0, self.lowerer.hir_span(node_id));
            self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
            self.finish_return(false, self.lowerer.hir_span(node_id));
            return;
        }
        self.run_deferred_from(0, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
        self.finish_unit_return(self.lowerer.hir_span(node_id));
    }

    () finish_unit_return(self, token.Span span) {
        if (self.return_type_is_error_union()) {
            self.assign_return_unit(span);
            self.finish_return(false, span);
            return;
        }
        self.finish_return(true, span);
    }

    () assign_return_unit(self, token.Span span) {
        self.push_assign(
            self.place_for_local(self.return_local()),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.make_value,
                value: mir.const_operand_value(mir.MirConst (
                    type_id: self.lowerer.ctx.store.types.unit_type(),
                    span: span,
                    value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
                ))
            )),
            span
        );
    }

    () assign_return_value(self, hir.HirId value) {
        mir.MirPlace destination = self.place_for_local(self.return_local());
        if (self.return_type_is_error_union()) {
            qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
            self.push_assign(
                destination,
                mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                    op: mir.MirErrorUnionOp.make_value,
                    value: self.lower_to_operand_as_type(value, self.error_union_value_type(return_type))
                )),
                self.lowerer.hir_span(value)
            );
            return;
        }
        self.lower_into_place(value, destination);
    }

    Bool return_type_is_error_union(self) {
        qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
        types.TypeInfo info = self.lowerer.ctx.store.types.get(return_type);
        return info.data is .error_union(_);
    }

    () lower_throw(self, hir.HirId node_id, hir.HirThrow throw_stmt) {
        qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
        self.push_assign(
            self.place_for_local(self.return_local()),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.make_error,
                value: self.lower_to_operand_as_type(throw_stmt.value, self.error_union_error_type(return_type))
            )),
            self.lowerer.hir_span(node_id)
        );
        if (self.terminated) { return; }
        self.run_deferred_from(0, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
        self.finish_return(false, self.lowerer.hir_span(node_id));
    }

    qid.TypeId error_union_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .error_union(error_union)) {
            return error_union.value;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    qid.TypeId error_union_error_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .error_union(error_union)) {
            return error_union.error;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    () lower_assign(self, hir.HirId node_id, hir.HirAssign assign_stmt) {
        if (self.lower_subscript_assignment(assign_stmt)) {
            return;
        }
        if (self.lower_init_self_assignment(assign_stmt)) {
            return;
        }
        guard self.place_for_expr(assign_stmt.target) is .some(destination) else {
            self.mark_unsupported(assign_stmt.target);
            return;
        }
        if (assign_stmt.op == .assign) {
            self.lower_into_place(assign_stmt.value, destination);
            return;
        }
        guard lower_support.binary_op_for_assign(assign_stmt.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirOperand lhs = self.lower_to_operand(assign_stmt.target);
        mir.MirOperand rhs = self.lower_to_operand(assign_stmt.value);
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue (op: op, lhs: lhs, rhs: rhs)),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool lower_init_self_assignment(self, hir.HirAssign assign_stmt) {
        if (assign_stmt.op != .assign) {
            return false;
        }
        if (!self.init_self_assignment_target(assign_stmt.target)) {
            return false;
        }
        guard self.place_for_expr(assign_stmt.target) is .some(self_place) else {
            return false;
        }
        mir.MirPlace destination = self.project_deref(self_place, false);
        self.lower_into_place(assign_stmt.value, destination);
        return true;
    }

    Bool init_self_assignment_target(self, hir.HirId target_id) {
        if (self.hir_def.decl.kind != .init_decl) {
            return false;
        }
        hir.HirNode target = self.lowerer.hirs.node(target_id);
        guard target.data is .name_ref(name_ref) else { return false; }
        guard name_ref is .local(local_id) else { return false; }
        hir.HirLocal local = self.hir_local(local_id);
        return string.equal(self.lowerer.ctx.store.symbols.text(local.symbol), "self");
    }

    () lower_into_place(self, hir.HirId node_id, mir.MirPlace destination) {
        if (self.node_result_needs_string_literal_constructor(node_id)) {
            self.lower_string_literal_constructor(node_id, destination);
            return;
        }
        if (self.node_result_needs_array_to_slice(node_id, destination)) {
            self.lower_array_to_slice_into_place(node_id, destination);
            return;
        }
        if (self.node_result_needs_lift(node_id, destination)) {
            self.lower_lifted_result_into_place(node_id, destination);
            return;
        }
        self.lower_direct_into_place(node_id, destination);
    }

    Bool node_result_needs_string_literal_constructor(self, hir.HirId node_id) {
        guard self.lowerer.typeck.expr_lowering(node_id) is .some(lowering) else { return false; }
        return lowering == .string_literal_constructor;
    }

    () lower_string_literal_constructor(self, hir.HirId node_id, mir.MirPlace destination) {
        guard self.lowerer.typeck.call_target(node_id) is .some(init_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .literal(literal) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId[]& type_args = self.lowerer.output.empty_type_args();
        comptime_value.ComptimeValue[]& const_args = self.lowerer.output.empty_const_args();
        qid.TypeId function_type = self.function_type_for_ref(init_def, type_args, const_args);
        types.FunctionType signature = self.function_type_or_empty(function_type);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(2);
        args.add(self.borrow_destination_operand(destination, span));
        args.add(mir.const_operand_value(self.lower_literal_as_const(node_id, literal, signature.params[1])));
        self.lower_init_call_with_args(node_id, init_def, function_type, args$.ref(), destination, span);
    }

    () lower_init_call_with_args(self,
        hir.HirId node_id,
        qid.DefId init_def,
        qid.TypeId function_type,
        list.ArrayList<mir.MirOperand>& args,
        mir.MirPlace destination,
        token.Span span
    ) {
        self.lowerer.ensure_external_function(init_def);
        mir.MirLocalId unit_local = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId next_block = self.reserve_block(span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: self.direct_function_callee(
                init_def,
                function_type,
                self.lowerer.output.empty_type_args(),
                self.lowerer.output.empty_const_args(),
                span
            ),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: self.place_for_local(unit_local),
            target: next_block,
            initialized_place: destination,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
    }

    // HIR 允许按 expected type 把 `T` 隐式提升成 `T?`/`T!E`。这种语义必须在
    // MIR 中显式化，否则 backend 会把 `T` 的 aggregate 字段写进目标 wrapper。
    Bool node_result_needs_lift(self, hir.HirId node_id, mir.MirPlace destination) {
        qid.TypeId actual = self.type_for_node(node_id);
        qid.TypeId expected = self.mir_place_type(destination);
        return self.type_needs_optional_lift(actual, expected) || self.type_needs_error_union_lift(actual, expected);
    }

    Bool node_result_needs_array_to_slice(self, hir.HirId node_id, mir.MirPlace destination) {
        qid.TypeId actual = self.source_type_for_expected_conversion(node_id);
        qid.TypeId expected = self.mir_place_type(destination);
        return self.type_needs_array_to_slice(actual, expected);
    }

    qid.TypeId source_type_for_expected_conversion(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .array_literal(array_literal)) {
            return self.array_literal_source_type(node_id, array_literal);
        }
        // `place_for_expr` 可能为复杂 place 生成临时值；探测期望转换类型时，
        // 只对确定无副作用的表达式调用它。
        if (self.place_lookup_has_no_lowering_side_effect(node_id)) {
            guard self.place_for_expr(node_id) is .some(place) else {
                return self.type_for_node(node_id);
            }
            return self.mir_place_type(place);
        }
        return self.type_for_node(node_id);
    }

    qid.TypeId array_literal_source_type(self, hir.HirId node_id, hir.HirArrayLiteral literal) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .array_type(_)) {
            return type_id;
        }
        guard info.data is .handle_type(handle) else { return type_id; }
        if (handle.kind != .slice) { return type_id; }
        return self.lowerer.ctx.store.types.array_type_with_sentinel(
            handle.element,
            literal.items.length,
            handle.sentinel,
            self.lowerer.hir_span(node_id)
        );
    }

    Bool place_lookup_has_no_lowering_side_effect(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            return name_ref is .local;
        }
        if (node.data is .member_access(member_access)) {
            return self.place_lookup_has_no_lowering_side_effect(member_access.base);
        }
        if (node.data is .index_access(index_access)) {
            return self.place_lookup_has_no_lowering_side_effect(index_access.base)
                && self.index_lookup_has_no_lowering_side_effect(index_access.index);
        }
        return false;
    }

    Bool index_lookup_has_no_lowering_side_effect(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .name_ref(name_ref) else {
            return false;
        }
        return name_ref is .local;
    }

    Bool type_needs_array_to_slice(self, qid.TypeId actual, qid.TypeId expected) {
        types.TypeInfo actual_info = self.lowerer.ctx.store.types.get(actual);
        types.TypeInfo expected_info = self.lowerer.ctx.store.types.get(expected);
        guard actual_info.data is .array_type(actual_array) else { return false; }
        guard expected_info.data is .handle_type(expected_handle) else { return false; }
        if (expected_handle.kind != .slice) { return false; }
        return self.type_same(actual_array.element, expected_handle.element);
    }

    Bool type_same(self, qid.TypeId left, qid.TypeId right) {
        return left.to_index() == right.to_index();
    }

    () lower_array_to_slice_into_place(self, hir.HirId node_id, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId actual = self.source_type_for_expected_conversion(node_id);
        if (self.array_to_slice_base_place(node_id) is .some(base)) {
            self.assign_array_slice(destination, base, actual, span);
            return;
        }
        mir.MirLocalId temp = self.add_temp(actual, span);
        self.push_storage_live(temp, span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.lower_direct_into_place(node_id, temp_place);
        self.assign_array_slice(destination, temp_place, actual, span);
        self.push_storage_dead(temp, span);
    }

    mir.MirPlace? array_to_slice_base_place(self, hir.HirId node_id) {
        if (!self.place_lookup_has_no_lowering_side_effect(node_id)) {
            return null;
        }
        return self.place_for_expr(node_id);
    }

    () assign_array_slice(
        self,
        mir.MirPlace destination,
        mir.MirPlace base,
        qid.TypeId array_type,
        token.Span span
    ) {
        self.push_assign(
            destination,
            mir.slice_rvalue(mir.MirSliceRvalue (
                base: base,
                start: null,
                end: self.array_to_slice_end(array_type, span)
            )),
            span
        );
    }

    mir.MirOperand? array_to_slice_end(self, qid.TypeId array_type, token.Span span) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.array_slice_end_type(array_type));
        guard info.data is .array_type(array) else { return null; }
        return mir.const_operand_value(self.int_const(array.count, span));
    }

    qid.TypeId array_slice_end_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return type_id; }
        if (handle.kind != .reference) { return type_id; }
        return handle.element;
    }

    () lower_lifted_result_into_place(self, hir.HirId node_id, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.lower_direct_into_place(node_id, temp_place);
        mir.MirOperand value = self.operand_for_place(temp_place);
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.normalize_aggregate_operand(value, self.mir_place_type(destination), span)
            )),
            span
        );
    }

    () lower_direct_into_place(self, hir.HirId node_id, mir.MirPlace destination) {
        if (self.comptime_value_for_expr(node_id) is .some(const_value)) {
            if (self.lower_comptime_value_into_place(node_id, const_value, destination)) {
                return;
            }
        }
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .block(block)) {
            if (self.lower_async_block_task(node_id, destination)) {
                return;
            }
            self.lower_block_into_place(block, destination);
            return;
        }
        if (node.data is .call(call)) {
            self.lower_call(node_id, call, destination);
            return;
        }
        if (node.data is .implicit_call(implicit_call)) {
            self.lower_implicit_call(node_id, implicit_call, destination);
            return;
        }
        if (node.data is .member_access(member_access)) {
            self.lower_member_access(node_id, member_access, destination);
            return;
        }
        if (node.data is .index_access(index_access)) {
            if (self.lower_subscript_get(node_id, index_access, destination)) {
                return;
            }
        }
        if (node.data is .slice_access(slice_access)) {
            self.lower_slice(node_id, slice_access, destination);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.lower_struct_literal(node_id, struct_literal, destination);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.lower_tuple_literal(node_id, tuple_literal, destination);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.lower_array_literal(node_id, array_literal, destination);
            return;
        }
        if (node.data is .if_expr(if_expr)) {
            self.lower_if(node_id, if_expr, destination);
            return;
        }
        if (node.data is .loop_expr(loop_expr)) {
            self.lower_loop(node_id, loop_expr, destination);
            return;
        }
        if (node.data is .switch_expr(switch_expr)) {
            self.lower_switch(node_id, switch_expr, destination);
            return;
        }
        if (node.data is .catch_expr(catch_expr)) {
            self.lower_catch(node_id, catch_expr, destination);
            return;
        }
        if (node.data is .await_expr(value)) {
            self.lower_into_place(value, destination);
            return;
        }
        if (node.data is .await_task_expr(value)) {
            self.lower_await_task_expr(value, destination);
            return;
        }
        if (node.data is .cancel_task_expr(value)) {
            self.lower_cancel_task_expr(value, destination);
            return;
        }
        if (node.data is .task_cancellation_expr(value)) {
            self.lower_task_cancellation_expr(value, destination);
            return;
        }
        if (node.data is .propagate_error_expr(value)) {
            self.lower_propagate_error_expr(node_id, value, destination);
            return;
        }
        if (node.data is .sync_block(async_block)) {
            self.lower_sync_block(node_id, async_block, destination);
            return;
        }
        if (node.data is .is_pattern(is_pattern)) {
            self.lower_is_pattern_into_place(node_id, is_pattern, destination);
            return;
        }
        if (node.data is .unary(unary)) {
            self.lower_unary(node_id, unary, destination);
            return;
        }
        if (node.data is .binary(binary)) {
            self.lower_binary(node_id, binary, destination);
            return;
        }
        if (node.data is .inline_asm(inline_asm)) {
            self.lower_inline_asm(node_id, inline_asm, destination);
            return;
        }
        if (node.data is .lambda_expr(lambda)) {
            if (self.type_is_closure(self.type_for_node(node_id))) {
                self.lower_lambda_closure(node_id, lambda, destination);
                return;
            }
        }
        mir.MirOperand value = self.lower_operand(node_id);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue (value: value)), self.lowerer.hir_span(node_id));
    }

    () lower_inline_asm(self, hir.HirId node_id, hir.HirInlineAsm inline_asm, mir.MirPlace destination) {
        list.ArrayList<mir.MirInlineAsmOperand> operands! = list.ArrayList<mir.MirInlineAsmOperand>(
            inline_asm.operands.length
        );
        Int index! = 0;
        while (index < inline_asm.operands.length) {
            operands.add(self.lower_inline_asm_operand(node_id, inline_asm, inline_asm.operands[index]));
            index = index + 1;
        }
        mir.MirRvalue value = mir.inline_asm_rvalue(mir.MirInlineAsmRvalue (
            result_type: self.type_for_node(node_id),
            code_symbol: inline_asm.code_symbol,
            operands: self.lowerer.output.inline_asm_operand_array(operands$.ref()),
            clobbers: self.lowerer.output.symbol_id_slice(inline_asm.clobbers),
            volatile: inline_asm.volatile,
            memory: inline_asm.memory,
            noreturn: inline_asm.noreturn
        ));
        self.push_assign(destination, value, self.lowerer.hir_span(node_id));
        if (inline_asm.noreturn) {
            self.finish_block(
                mir.unreachable_terminator_kind(mir.MirUnreachableTerminator (generated_by_check: false)),
                self.lowerer.hir_span(node_id)
            );
        }
    }

    mir.MirInlineAsmOperand lower_inline_asm_operand(self,
        hir.HirId node_id,
        hir.HirInlineAsm inline_asm,
        hir.HirInlineAsmOperand operand
    ) {
        if (operand is .input(input)) {
            return .input(mir.MirInlineAsmInput (
                constraint_symbol: input.constraint_symbol,
                value: self.lower_to_operand(input.value)
            ));
        }
        if (operand is .output(output)) {
            return .output(mir.MirInlineAsmOutput (
                constraint_symbol: output.constraint_symbol,
                type_id: self.inline_asm_output_type(node_id, inline_asm, output)
            ));
        }
        return .output(mir.MirInlineAsmOutput (
            constraint_symbol: qid.SymbolId(0),
            type_id: self.lowerer.ctx.store.types.invalid_type()
        ));
    }

    qid.TypeId inline_asm_output_type(self,
        hir.HirId node_id,
        hir.HirInlineAsm inline_asm,
        hir.HirInlineAsmOutput output
    ) {
        if (output.type_ref is .some(type_ref)) {
            return self.type_for_node(type_ref);
        }
        qid.TypeId result_type = self.type_for_node(inline_asm.result_type);
        if (!(self.lowerer.ctx.store.types.get(result_type).data is .invalid)) {
            return result_type;
        }
        return self.type_for_node(node_id);
    }

    Bool lower_async_block_task(self, hir.HirId node_id, mir.MirPlace destination) {
        qid.DefId function_def = node_id.owner_def;
        if (function_def.to_index() == self.hir_def.def_id.to_index()) { return false; }
        if (!self.lowerer.typeck.is_async_block_function(function_def)) { return false; }
        guard self.lowerer.typeck.lambda_capture_infos(function_def) is .some(captures) else {
            self.mark_unsupported(node_id);
            return true;
        }
        guard self.lowerer.output.function_id_for_def(function_def) is .some(function_id) else {
            self.mark_unsupported(node_id);
            return true;
        }
        mir.MirFunction function = self.lowerer.output.function(function_id);
        guard function.coroutine_frame is .some(layout) else {
            self.mark_unsupported(node_id);
            return true;
        }
        guard mir.place_local_id(destination) is .some(task_local) else {
            self.mark_unsupported(node_id);
            return true;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        if (self.async_start_is_detached(node_id)) {
            self.lower_detached_async_block(
                node_id, function_def, captures, function$.ref(), layout$.ref(), span
            );
            return true;
        }
        mir.MirTaskStoragePlan storage = self.task_local_storage(
            task_local, .local, self.task_sync_mode(layout$.ref())
        );
        mir.MirFunctionRef resume_function = self.coroutine_generated_function_ref(
            function_def,
            self.lowerer.output.empty_type_args(),
            self.lowerer.output.empty_const_args(),
            layout$.ref(),
            true,
            span
        );
        self.push_task_region_start(destination, storage, resume_function, span);
        mir.MirLocalId frame_local = self.add_coroutine_capture_temp(
            layout.frame_type_id, span, task_local, .task_frame
        );
        mir.MirPlace frame_place = self.place_for_local(frame_local);
        self.initialize_structured_task_state(destination, layout$.ref(), task_local, storage, span);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.async_block_env_operand(node_id, function_def, captures, task_local, span));
        mir.MirOperand[]& frozen_args = self.lowerer.output.operand_array(args$.ref());
        self.lower_async_operands_into_frame(
            frozen_args, function$.ref(), layout$.ref(), frame_place, span
        );
        mir.MirFunctionRef completion_function = self.task_completion_function_ref(
            function_def,
            self.lowerer.output.empty_type_args(),
            self.lowerer.output.empty_const_args(),
            layout$.ref(),
            storage.sync,
            span
        );
        mir.MirStatement[]& initializers = coroutine_task_abi.initialized_task_initializers(
            self.lowerer.output,
            layout$.ref(),
            destination,
            frame_place,
            resume_function,
            completion_function,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.statements.add(initializers[index]);
            index = index + 1;
        }
        self.push_structured_task_frame_domain(
            layout$.ref(), frame_place, storage, span
        );
        self.push_task_execution_domain_initializers(
            layout$.ref(), destination, frame_place, span
        );
        self.lower_task_resume_call(
            destination, resume_function, self.async_start_kind(node_id), span
        );
        return true;
    }

    Bool async_start_is_detached(self, hir.HirId node_id) {
        guard self.lowerer.typeck.async_start_usage(node_id) is .some(usage) else { return false; }
        return usage == typeck_store.AsyncStartUsage.detached;
    }

    () lower_detached_async_block(
        self,
        hir.HirId node_id,
        qid.DefId function_def,
        typeck_store.LambdaCaptureInfo[]& captures,
        mir.MirFunction& function,
        mir.MirCoroutineFrameLayout& layout,
        token.Span span
    ) {
        mir.MirLocalId allocation_executor = self.add_temp(
            self.lowerer.ctx.store.types.opaque_pointer_type(span), span
        );
        mir.MirRvalue allocation_executor_value! = mir.use_rvalue(mir.MirUseRvalue (
            value: self.null_operand(
                self.lowerer.ctx.store.types.opaque_pointer_type(span), span
            )
        ));
        if (layout.effects.domain is .some(domain)) {
            allocation_executor_value = mir.domain_executor_rvalue(mir.MirDomainExecutorRvalue (
                domain_def: domain.binding,
                domain_kind: layout.domain_kind
            ));
        } else if (self.current_effects.has_async) {
            allocation_executor_value = mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue());
        }
        self.push_assign(
            self.place_for_local(allocation_executor), allocation_executor_value, span
        );
        mir.MirLocalId frame_pointer = self.add_temp(layout.task_abi.frame_pointer_type_id, span);
        mir.MirPlace frame_pointer_place = self.place_for_local(frame_pointer);
        self.push_assign(
            frame_pointer_place,
            mir.coroutine_frame_alloc_rvalue(mir.MirCoroutineFrameAllocRvalue (
                value_type: layout.frame_type_id,
                executor: self.operand_for_place(self.place_for_local(allocation_executor))
            )),
            span
        );
        mir.MirPlace frame_place = self.project_deref(frame_pointer_place, true);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.async_block_env_operand(node_id, function_def, captures, null, span));
        mir.MirOperand[]& frozen_args = self.lowerer.output.operand_array(args$.ref());
        self.lower_async_operands_into_frame(frozen_args, function, layout, frame_place, span);
        self.statements.add(coroutine_task_abi.frame_state_initializer(
            self.lowerer.output,
            layout,
            frame_place,
            span
        ));
        mir.MirStatement[]& domain_initializers = coroutine_task_abi.frame_domain_initializers(
            self.lowerer.output, layout, frame_place, span
        );
        Int domain_index! = 0;
        while (domain_index < domain_initializers.length) {
            self.statements.add(domain_initializers[domain_index]);
            domain_index = domain_index + 1;
        }
        self.push_inherited_frame_domain(layout, frame_place, span);
        mir.MirPlace result_place = self.project_constant_index(frame_place, layout.return_field_index);
        self.push_assign(
            self.project_constant_index(frame_place, layout.continuation_result_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: result_place,
                frame_root: false
            )),
            span
        );
        mir.MirOperand erased_frame = self.cast_operand_to_type(
            self.operand_for_place(frame_pointer_place),
            self.mir_place_type(self.project_constant_index(frame_place, layout.continuation_context_field_index)),
            span
        );
        self.push_assign(
            self.project_constant_index(frame_place, layout.continuation_context_field_index),
            mir.use_rvalue(mir.MirUseRvalue (value: erased_frame)),
            span
        );
        mir.MirFunctionRef completion_function = self.coroutine_generated_function_ref(
            function_def,
            self.lowerer.output.empty_type_args(),
            self.lowerer.output.empty_const_args(),
            layout,
            false,
            span
        );
        self.statements.add(coroutine_task_abi.continuation_function_initializer(
            self.lowerer.output,
            layout,
            frame_place,
            completion_function,
            span
        ));
        self.statements.add(coroutine_task_abi.continuation_executor_null_initializer(
            self.lowerer.output, layout, frame_place, span
        ));
        self.lower_detached_resume_call(function_def, layout, frame_pointer_place, span);
    }

    () lower_detached_resume_call(
        self,
        qid.DefId function_def,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_pointer_place,
        token.Span span
    ) {
        mir.MirFunctionRef resume_function = self.coroutine_generated_function_ref(
            function_def,
            self.lowerer.output.empty_type_args(),
            self.lowerer.output.empty_const_args(),
            layout,
            true,
            span
        );
        mir.MirOperand resume_operand = mir.function_operand_value(resume_function);
        mir.MirCallCallee callee! = mir.direct_function_callee(resume_function);
        if (layout.effects.domain is .some(domain)) {
            if (!types.effect_domain_equal(self.current_effects.domain, layout.effects.domain)) {
                callee = mir.domain_enqueue_callee(domain.binding, layout.domain_kind, resume_operand);
            }
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.cast_operand_to_type(
            self.operand_for_place(frame_pointer_place),
            self.lowerer.ctx.store.types.opaque_pointer_type(span),
            span
        ));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId target = self.reserve_block(span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            async_start: mir.MirAsyncStartKind.detached,
            destination: self.place_for_local(result),
            target: target,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(target);
    }

    mir.MirOperand cast_operand_to_type(self, mir.MirOperand value, qid.TypeId target_type, token.Span span) {
        mir.MirLocalId local = self.add_temp(target_type, span);
        self.push_assign(
            self.place_for_local(local),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: value,
                target_type: target_type
            )),
            span
        );
        return self.operand_for_place(self.place_for_local(local));
    }

    mir.MirOperand async_block_env_operand(
        self,
        hir.HirId node_id,
        qid.DefId function_def,
        typeck_store.LambdaCaptureInfo[]& captures,
        mir.MirLocalId? capture_task,
        token.Span span
    ) {
        unsafe {
            if (captures.length == 0) {
                return self.null_operand(self.closure_env_type(span), span);
            }
            hir.HirLambdaParam*! params = self.lowerer.hirs.storage.alloc_array<hir.HirLambdaParam>(1);
            hir.HirLambdaCapture*! explicit_captures =
                self.lowerer.hirs.storage.alloc_array<hir.HirLambdaCapture>(1);
            hir.HirLambda lambda = hir.HirLambda (
                param_count: 0,
                params: params[0..0],
                captures: explicit_captures[0..0],
                function_def: function_def,
                body: node_id
            );
            mir.MirOperand env = self.heap_lambda_env_operand(node_id, lambda, capture_task, span);
            qid.TypeId env_type = self.lambda_env_type_for_infos(function_def, captures, span);
            qid.DefId drop_shim = self.ensure_lambda_env_drop_shim(node_id, env_type, true);
            self.lowerer.async_block_env_drop_shims.set(function_def, drop_shim);
            return env;
        }
    }

    () lower_block_into_place(self, hir.HirBlock block, mir.MirPlace destination) {
        types.EffectSet saved_effects = self.enter_block_effects(block.effects);
        list.ArrayList<mir.MirLocalId> scope_locals! = list.ArrayList<mir.MirLocalId>();
        Int defer_depth = self.active_defers.len();
        Int index! = 0;
        while (index < block.statements.length) {
            if (self.terminated) {
                self.current_effects = saved_effects;
                return;
            }
            self.lower_statement_node(block.statements[index], scope_locals$.ref());
            index = index + 1;
        }
        if (self.terminated) {
            self.current_effects = saved_effects;
            return;
        }
        if (block.result is .some(result)) {
            self.lower_into_place(result, destination);
            if (!self.terminated) {
                self.run_deferred_from(defer_depth, self.lowerer.hir_span(result));
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
            }
            self.current_effects = saved_effects;
            return;
        }
        self.push_assign(destination, self.unit_rvalue(token.Span()), token.Span());
        self.run_deferred_from(defer_depth, token.Span());
        self.end_scope(scope_locals$.ref(), token.Span());
        self.current_effects = saved_effects;
    }

    () lower_if(self, hir.HirId node_id, hir.HirIf if_expr, mir.MirPlace destination) {
        list.ArrayList<mir.MirLocalId> condition_locals! = list.ArrayList<mir.MirLocalId>();
        lower_support.IfConditionLowerResult condition_result = self.lower_if_condition(if_expr.condition);
        mir.MirBlockId then_block = self.reserve_block(self.lowerer.hir_span(if_expr.then_body));
        mir.MirBlockId else_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: condition_result.condition,
            then_target: then_block,
            else_target: else_block
        )), self.lowerer.hir_span(if_expr.condition));

        Int active_depth = self.active_locals.len();
        self.start_block(then_block);
        self.lower_if_condition_bindings(condition_result$.ref(), condition_locals$.ref());
        self.lower_into_place(if_expr.then_body, destination);
        if (!self.terminated) {
            self.end_scope(condition_locals$.ref(), self.lowerer.hir_span(if_expr.then_body));
            self.finish_block(
                mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)),
                self.lowerer.hir_span(node_id)
            );
        }
        self.restore_active_locals(active_depth);

        self.start_block(else_block);
        if (if_expr.else_body is .some(else_body)) {
            self.lower_into_place(else_body, destination);
        } else {
            self.push_assign(
                destination,
                self.unit_rvalue(self.lowerer.hir_span(node_id)),
                self.lowerer.hir_span(node_id)
            );
        }
        if (!self.terminated) {
            self.finish_block(
                mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)),
                self.lowerer.hir_span(node_id)
            );
        }
        self.restore_active_locals(active_depth);

        self.start_block(join_block);
    }

    () lower_guard(self, hir.HirId node_id, hir.HirGuard guard_stmt) {
        lower_support.IfConditionLowerResult condition = self.lower_if_condition(guard_stmt.condition);
        mir.MirBlockId continue_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId else_block = self.reserve_block(self.lowerer.hir_span(guard_stmt.else_body));
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: condition.condition,
            then_target: continue_block,
            else_target: else_block
        )), self.lowerer.hir_span(guard_stmt.condition));

        self.start_block(else_block);
        self.lower_expr_statement(guard_stmt.else_body);
        if (!self.terminated) {
            self.finish_block(
                mir.goto_terminator_kind(mir.MirGotoTerminator (target: continue_block)),
                self.lowerer.hir_span(node_id)
            );
        }

        self.start_block(continue_block);
        list.ArrayList<mir.MirLocalId> condition_locals! = list.ArrayList<mir.MirLocalId>();
        self.lower_if_condition_bindings(condition$.ref(), condition_locals$.ref());
    }

    lower_support.IfConditionLowerResult lower_if_condition(self, hir.HirId condition_id) {
        hir.HirNode condition_node = self.lowerer.hirs.node(condition_id);
        if (condition_node.data is .is_pattern(is_pattern)) {
            return self.lower_is_pattern_condition(condition_id, is_pattern);
        }
        if (condition_node.data is .binary(binary)) {
            if (binary.op == .logic_and) {
                return self.lower_logic_and_condition(condition_id, binary);
            }
        }
        return self.empty_if_condition_result(self.lower_to_operand(condition_id));
    }

    lower_support.IfConditionLowerResult empty_if_condition_result(self, mir.MirOperand condition) {
        return lower_support.IfConditionLowerResult (
            condition: condition,
            bindings: list.ArrayList<lower_support.PatternConditionBinding>(),
            active_locals: list.ArrayList<mir.MirLocalId>()
        );
    }

    lower_support.IfConditionLowerResult pattern_if_condition_result(self,
        mir.MirOperand condition,
        hir.HirId pattern_id,
        mir.MirPlace subject_place,
        qid.TypeId subject_type
    ) {
        list.ArrayList<lower_support.PatternConditionBinding> bindings! =
            list.ArrayList<lower_support.PatternConditionBinding>(1);
        bindings.add(lower_support.PatternConditionBinding (
            pattern_id: pattern_id,
            subject_place: subject_place,
            subject_type: subject_type
        ));
        return lower_support.IfConditionLowerResult (
            condition: condition,
            bindings: bindings$.move(),
            active_locals: list.ArrayList<mir.MirLocalId>()
        );
    }

    lower_support.IfConditionLowerResult lower_is_pattern_condition(self, hir.HirId node_id, hir.HirIsPattern is_pattern) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(is_pattern.pattern);
        if (pattern_node.data is .optional_pattern(_)) {
            return self.lower_optional_pattern_condition(node_id, is_pattern);
        }
        if (pattern_node.data is .variant_pattern(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, self.type_for_node(is_pattern.value))) {
                return self.lower_optional_variant_pattern_condition(node_id, is_pattern, variant_pattern);
            }
            return self.lower_variant_pattern_condition(node_id, is_pattern);
        }
        if (pattern_node.data is .wildcard_pattern) {
            return self.empty_if_condition_result(self.bool_operand(true, self.lowerer.hir_span(node_id)));
        }
        self.mark_unsupported(is_pattern.pattern);
        return self.empty_if_condition_result(self.bool_operand(false, self.lowerer.hir_span(node_id)));
    }

    lower_support.IfConditionLowerResult lower_optional_pattern_condition(self,
        hir.HirId node_id,
        hir.HirIsPattern is_pattern
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirPlace subject_place = self.optional_pattern_subject_place(is_pattern, span);
        qid.TypeId subject_type = self.pattern_subject_type(self.type_for_node(is_pattern.value));
        mir.MirLocalId condition_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(condition_local),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.is_some,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: subject_place))
            )),
            span
        );
        return self.pattern_if_condition_result(
            mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(condition_local))),
            is_pattern.pattern,
            subject_place,
            subject_type
        );
    }

    lower_support.IfConditionLowerResult lower_optional_variant_pattern_condition(self,
        hir.HirId node_id,
        hir.HirIsPattern is_pattern,
        hir.HirVariantPattern variant_pattern
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirPlace subject_place = self.optional_variant_pattern_subject_place(is_pattern, variant_pattern, span);
        qid.TypeId subject_type = self.pattern_subject_type(self.type_for_node(is_pattern.value));
        mir.MirLocalId condition_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(condition_local),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.is_some,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: subject_place))
            )),
            span
        );
        if (self.optional_variant_pattern_is_none(variant_pattern)) {
            self.push_assign(
                self.place_for_local(condition_local),
                mir.unary_rvalue(mir.MirUnaryRvalue (
                    op: mir.MirUnaryOp.logic_not,
                    value: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(condition_local)))
                )),
                span
            );
        }
        return self.pattern_if_condition_result(
            mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(condition_local))),
            is_pattern.pattern,
            subject_place,
            subject_type
        );
    }

    mir.MirPlace optional_pattern_subject_place(self, hir.HirIsPattern is_pattern, token.Span span) {
        qid.TypeId value_type = self.type_for_node(is_pattern.value);
        if (self.optional_pattern_has_borrow_binding(is_pattern.pattern)) {
            if (self.place_for_expr(is_pattern.value) is .some(place)) {
                return self.pattern_subject_place_for_value(place, value_type);
            }
        }
        mir.MirLocalId subject_local = self.add_temp(value_type, span);
        mir.MirPlace subject_place! = self.place_for_local(subject_local);
        self.lower_into_place(is_pattern.value, subject_place);
        return self.pattern_subject_place_for_value(subject_place, value_type);
    }

    Bool optional_pattern_has_borrow_binding(self, hir.HirId pattern_id) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        guard pattern_node.data is .optional_pattern(optional_pattern) else { return false; }
        guard optional_pattern.nested is .some(nested) else { return false; }
        hir.HirNode nested_node = self.lowerer.hirs.node(nested);
        guard nested_node.data is .binding_pattern(binding) else { return false; }
        hir.HirLocal local = self.hir_local(binding.local_id);
        return local.borrow_binding;
    }

    mir.MirPlace optional_variant_pattern_subject_place(self,
        hir.HirIsPattern is_pattern,
        hir.HirVariantPattern variant_pattern,
        token.Span span
    ) {
        qid.TypeId value_type = self.type_for_node(is_pattern.value);
        if (self.optional_variant_pattern_has_borrow_binding(variant_pattern)) {
            if (self.place_for_expr(is_pattern.value) is .some(place)) {
                return self.pattern_subject_place_for_value(place, value_type);
            }
        }
        mir.MirLocalId subject_local = self.add_temp(value_type, span);
        mir.MirPlace subject_place! = self.place_for_local(subject_local);
        self.lower_into_place(is_pattern.value, subject_place);
        return self.pattern_subject_place_for_value(subject_place, value_type);
    }

    Bool optional_variant_pattern_has_borrow_binding(self, hir.HirVariantPattern variant_pattern) {
        if (variant_pattern.payload.length != 1) { return false; }
        hir.HirNode nested_node = self.lowerer.hirs.node(variant_pattern.payload[0]);
        guard nested_node.data is .binding_pattern(binding) else { return false; }
        hir.HirLocal local = self.hir_local(binding.local_id);
        return local.borrow_binding;
    }

    lower_support.IfConditionLowerResult lower_variant_pattern_condition(self,
        hir.HirId node_id,
        hir.HirIsPattern is_pattern
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId value_type = self.type_for_node(is_pattern.value);
        qid.TypeId subject_type = self.pattern_subject_type(value_type);
        mir.MirPlace subject_place = self.variant_pattern_subject_place(is_pattern, span);
        mir.MirLocalId condition_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(condition_local),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.eq,
                lhs: self.variant_pattern_discriminator(
                    is_pattern.value,
                    is_pattern.pattern,
                    subject_type,
                    subject_place
                ),
                rhs: self.variant_pattern_tag(is_pattern.pattern, subject_type)
            )),
            span
        );
        return self.pattern_if_condition_result(
            mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(condition_local))),
            is_pattern.pattern,
            subject_place,
            subject_type
        );
    }

    mir.MirPlace variant_pattern_subject_place(self, hir.HirIsPattern is_pattern, token.Span span) {
        qid.TypeId value_type = self.type_for_node(is_pattern.value);
        if (self.variant_pattern_has_borrow_binding(is_pattern.pattern)) {
            if (self.place_for_expr(is_pattern.value) is .some(place)) {
                return self.pattern_subject_place_for_value(place, value_type);
            }
        }
        mir.MirLocalId subject_local = self.add_temp(value_type, span);
        mir.MirPlace subject_place = self.place_for_local(subject_local);
        self.lower_into_place(is_pattern.value, subject_place);
        return self.pattern_subject_place_for_value(subject_place, value_type);
    }

    Bool variant_pattern_has_borrow_binding(self, hir.HirId pattern_id) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        guard pattern_node.data is .variant_pattern(variant_pattern) else { return false; }
        Int index! = 0;
        while (index < variant_pattern.payload.length) {
            if (self.pattern_has_borrow_binding(variant_pattern.payload[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool pattern_has_borrow_binding(self, hir.HirId pattern_id) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        guard pattern_node.data is .binding_pattern(binding) else { return false; }
        hir.HirLocal local = self.hir_local(binding.local_id);
        return local.borrow_binding;
    }

    lower_support.IfConditionLowerResult lower_logic_and_condition(self, hir.HirId node_id, hir.HirBinary binary) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId result_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        mir.MirPlace result_place = self.place_for_local(result_local);
        lower_support.IfConditionLowerResult left = self.lower_if_condition(binary.left);
        mir.MirBlockId rhs_block = self.reserve_block(self.lowerer.hir_span(binary.right));
        mir.MirBlockId false_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: left.condition,
            then_target: rhs_block,
            else_target: false_block
        )), self.lowerer.hir_span(binary.left));

        Int active_depth = self.active_locals.len();
        self.start_block(rhs_block);
        list.ArrayList<mir.MirLocalId> materialized! = list.ArrayList<mir.MirLocalId>();
        self.lower_if_condition_bindings(left$.ref(), materialized$.ref());
        lower_support.IfConditionLowerResult right = self.lower_if_condition(binary.right);
        self.push_assign(result_place, mir.use_rvalue(mir.MirUseRvalue (value: right.condition)), span);
        if (!self.terminated) {
            self.finish_block(self.goto_terminator(join_block), span);
        }
        self.append_condition_active_locals(materialized$.ref(), right.active_locals$.ref());
        self.restore_active_locals(active_depth);

        self.start_block(false_block);
        self.push_assign(result_place, self.bool_rvalue(false, span), span);
        self.finish_block(self.goto_terminator(join_block), span);
        self.start_block(join_block);

        return lower_support.IfConditionLowerResult (
            condition: mir.copy_operand_value(mir.MirCopyOperand (place: result_place)),
            bindings: right.bindings.take(),
            active_locals: materialized$.move()
        );
    }

    () append_condition_active_locals(self,
        list.ArrayList<mir.MirLocalId>& target,
        list.ArrayList<mir.MirLocalId>& source
    ) {
        Int index! = 0;
        while (index < source.len()) {
            target.add(source.get(index));
            index = index + 1;
        }
    }

    qid.TypeId pattern_subject_type(self, qid.TypeId value_type) {
        // MIR subject 类型需要和 type check 一致：pattern 检查引用指向的值，
        // 而不是引用 handle 本身。
        qid.TypeId read_type = self.read_value_type(value_type);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(read_type);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.read_value_type(handle.element);
            }
        }
        return read_type;
    }

    mir.MirPlace pattern_subject_place_for_value(self, mir.MirPlace value_place, qid.TypeId value_type) {
        // 源表达式是引用时，discriminant/payload 要从被引用的 place 读取。
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.read_value_type(value_type));
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.project_deref(value_place, false);
            }
        }
        return self.copy_place_projection(value_place);
    }

    qid.TypeId read_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (!info.is_mutable) {
            return type_id;
        }
        return self.lowerer.ctx.store.types.create(info.data, info.span);
    }

    mir.MirOperand variant_pattern_discriminator(self,
        hir.HirId value_id,
        hir.HirId pattern_id,
        qid.TypeId subject_type,
        mir.MirPlace subject_place
    ) {
        if (!self.switch_needs_explicit_discriminant(subject_type)) {
            return self.lower_to_operand(value_id);
        }
        token.Span span = self.lowerer.hir_span(pattern_id);
        mir.MirLocalId discriminator_local = self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
        self.push_assign(
            self.place_for_local(discriminator_local),
            mir.discriminant_rvalue(mir.MirDiscriminantRvalue (place: subject_place)),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(discriminator_local)));
    }

    mir.MirOperand variant_pattern_tag(self, hir.HirId pattern_id, qid.TypeId subject_type) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return self.bool_operand(false, self.lowerer.hir_span(pattern_id));
        }
        qid.TypeId discriminator_type = self.switch_discriminator_type(subject_type);
        return mir.const_operand_value(self.variant_tag_const(pattern_id, variant_def, discriminator_type));
    }

    () lower_is_pattern_into_place(self, hir.HirId node_id, hir.HirIsPattern is_pattern, mir.MirPlace destination) {
        lower_support.IfConditionLowerResult condition = self.lower_is_pattern_condition(node_id, is_pattern);
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (value: condition.condition)),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_if_condition_bindings(self,
        lower_support.IfConditionLowerResult& condition,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        Int active_index! = 0;
        while (active_index < condition.active_locals.len()) {
            mir.MirLocalId local_id = condition.active_locals.get(active_index);
            self.active_locals.add(local_id);
            condition_locals.add(local_id);
            active_index = active_index + 1;
        }

        Int binding_index! = 0;
        while (binding_index < condition.bindings.len()) {
            self.lower_condition_binding(condition.bindings.ref_at(binding_index), condition_locals);
            binding_index = binding_index + 1;
        }
    }

    () lower_condition_binding(self,
        lower_support.PatternConditionBinding& binding,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(binding.pattern_id);
        if (pattern_node.data is .optional_pattern(optional_pattern)) {
            if (optional_pattern.nested is .some(nested)) {
                self.lower_optional_pattern_binding(nested, binding.subject_place, condition_locals);
            }
            return;
        }
        if (pattern_node.data is .variant_pattern(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, binding.subject_type)) {
                self.lower_optional_variant_condition_binding(variant_pattern, binding.subject_place, condition_locals);
                return;
            }
            if (variant_pattern.payload.length != 0) {
                self.lower_variant_payload_binding(
                    binding.pattern_id,
                    binding.subject_place,
                    binding.subject_type,
                    condition_locals
                );
            }
            return;
        }
    }

    () lower_optional_variant_condition_binding(self,
        hir.HirVariantPattern variant_pattern,
        mir.MirPlace subject_place,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        if (self.optional_variant_pattern_is_none(variant_pattern)) { return; }
        if (variant_pattern.payload.length != 1) { return; }
        self.lower_optional_pattern_binding(
            variant_pattern.payload[0],
            subject_place,
            condition_locals
        );
    }

    Bool variant_pattern_is_optional(self, hir.HirVariantPattern variant_pattern, qid.TypeId value_type) {
        qid.TypeId subject_type = self.pattern_subject_type(value_type);
        types.TypeInfo subject_info = self.lowerer.ctx.store.types.get(subject_type);
        if (!(subject_info.data is .optional(_))) { return false; }
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        UInt8[]& name = self.lowerer.ctx.store.symbols.text(symbol);
        return self.string_equal(name, "some") || self.string_equal(name, "none");
    }

    Bool optional_variant_pattern_is_none(self, hir.HirVariantPattern variant_pattern) {
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        return self.string_equal(self.lowerer.ctx.store.symbols.text(symbol), "none");
    }

    Bool string_equal(self, UInt8[]& lhs, UInt8[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    () lower_optional_pattern_binding(self,
        hir.HirId pattern_id,
        mir.MirPlace subject_place,
        list.ArrayList<mir.MirLocalId>& condition_locals
    ) {
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        if (pattern_node.data is .wildcard_pattern) { return; }
        guard pattern_node.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        condition_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(pattern_id));
        hir.HirLocal local = self.hir_local(binding.local_id);
        if (local.borrow_binding) {
            mir.MirPlace payload_place = self.project_constant_index(subject_place, 1);
            self.push_assign(
                self.place_for_local(local_id),
                mir.borrow_rvalue(mir.MirBorrowRvalue (place: payload_place)),
                self.lowerer.hir_span(pattern_id)
            );
            return;
        }
        self.push_assign(
            self.place_for_local(local_id),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.unwrap_some,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: subject_place))
            )),
            self.lowerer.hir_span(pattern_id)
        );
    }

    () lower_loop(self, hir.HirId node_id, hir.HirLoop loop_expr, mir.MirPlace destination) {
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            self.lower_for_loop(node_id, loop_expr, destination);
            return;
        }
        mir.MirBlockId header_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId exit_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(
            mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)),
            self.lowerer.hir_span(node_id)
        );
        self.start_block(header_block);
        lower_support.IfConditionLowerResult condition_result! = self.empty_if_condition_result(
            self.bool_operand(true, self.lowerer.hir_span(node_id))
        );
        if (loop_expr.condition is .some(condition)) {
            condition_result = self.lower_if_condition(condition);
            self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
                condition: condition_result.condition,
                then_target: body_block,
                else_target: exit_block
            )), self.lowerer.hir_span(condition));
        } else {
            self.finish_block(
                mir.goto_terminator_kind(mir.MirGotoTerminator (target: body_block)),
                self.lowerer.hir_span(node_id)
            );
        }

        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(lower_support.LoopTargets (
            continue_target: header_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.start_block(body_block);
        list.ArrayList<mir.MirLocalId> condition_locals! = list.ArrayList<mir.MirLocalId>();
        self.lower_if_condition_bindings(condition_result$.ref(), condition_locals$.ref());
        self.lower_expr_statement(loop_expr.body);
        if (!self.terminated) {
            self.end_scope(condition_locals$.ref(), self.lowerer.hir_span(loop_expr.body));
            self.finish_block(
                mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)),
                self.lowerer.hir_span(node_id)
            );
        }
        lower_support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);

        self.start_block(exit_block);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_for_loop(self, hir.HirId node_id, hir.HirLoop loop_expr, mir.MirPlace destination) {
        guard loop_expr.iterable is .some(iterable) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard loop_expr.pattern is .some(pattern) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        hir.HirNode iterable_node = self.lowerer.hirs.node(iterable);
        if (iterable_node.data is .range_expr(range_expr)) {
            self.lower_range_for_loop(loop_expr, pattern, range_expr, destination, span);
            return;
        }
        if (self.lowerer.typeck.for_loop_contiguous_plan(node_id) is .some(plan)) {
            self.lower_contiguous_for_loop(loop_expr, pattern, iterable, plan, destination, span);
            return;
        }
        if (self.lowerer.typeck.for_loop_sequence_plan(node_id) is .some(plan)) {
            self.lower_sequence_for_loop(loop_expr, pattern, iterable, plan, destination, span);
            return;
        }
        self.mark_unsupported(node_id);
    }

    () lower_contiguous_for_loop(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        hir.HirId iterable,
        typeck_store.ForLoopContiguousPlan plan,
        mir.MirPlace destination,
        token.Span span
    ) {
        if (self.lower_contiguous_trait_for_loop(loop_expr, pattern, iterable, plan, destination, span)) {
            return;
        }
        mir.MirPlace iterable_place = self.pointer_base_place(iterable);
        mir.MirLocalId index_local = self.add_loop_index_local(span);
        mir.MirLocalId len_local = self.add_loop_len_local(span);
        self.init_for_loop_counters(iterable_place, index_local, len_local, span);
        self.lower_for_loop_cfg(loop_expr, pattern, iterable_place, index_local, len_local, destination, span);
    }

    Bool lower_contiguous_trait_for_loop(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        hir.HirId iterable,
        typeck_store.ForLoopContiguousPlan plan,
        mir.MirPlace destination,
        token.Span span
    ) {
        guard plan.pointer_def is .some(pointer_def) else { return false; }
        guard plan.length_def is .some(length_def) else { return false; }
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        qid.TypeId pointer_type = self.lowerer.ctx.store.types.raw_pointer_type(element_type, span);
        mir.MirLocalId pointer_local = self.add_temp(pointer_type, span);
        mir.MirLocalId len_local = self.add_loop_len_local(span);
        mir.MirPlace receiver_place = self.contiguous_receiver_place(iterable, span);
        qid.TypeId receiver_type = self.mir_place_type(receiver_place);
        self.lower_contiguous_method_call(
            receiver_place,
            receiver_type,
            pointer_def,
            self.place_for_local(pointer_local),
            span
        );
        self.lower_contiguous_method_call(
            receiver_place,
            receiver_type,
            length_def,
            self.place_for_local(len_local),
            span
        );
        if (self.terminated) { return true; }
        mir.MirLocalId index_local = self.add_loop_index_local(span);
        self.push_assign(self.place_for_local(index_local), self.int_const_rvalue(0, span), span);
        self.lower_for_loop_cfg(
            loop_expr,
            pattern,
            self.place_for_local(pointer_local),
            index_local,
            len_local,
            destination,
            span
        );
        return true;
    }

    mir.MirPlace contiguous_receiver_place(self, hir.HirId iterable, token.Span span) {
        if (self.place_for_expr(iterable) is .some(place)) {
            return place;
        }
        qid.TypeId receiver_type = self.type_for_node(iterable);
        mir.MirLocalId receiver_local = self.add_temp(receiver_type, span);
        mir.MirPlace receiver_place = self.place_for_local(receiver_local);
        self.lower_into_place(iterable, receiver_place);
        return receiver_place;
    }

    () lower_contiguous_method_call(self,
        mir.MirPlace receiver_place,
        qid.TypeId receiver_type,
        qid.DefId method_def,
        mir.MirPlace destination,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(method_def) == .mutable_ref_receiver;
        args.add(self.receiver_operand_for_place(receiver_place, receiver_type, mutable_reference, span));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(receiver_type, method_def);
        self.lower_direct_function_call_with_type_args(method_def, type_args, args$.ref(), destination, span);
    }

    mir.MirOperand receiver_operand_for_place(
        self,
        mir.MirPlace receiver_place,
        qid.TypeId receiver_type,
        Bool mutable_reference,
        token.Span span
    ) {
        if (self.type_is_reference(receiver_type)) {
            return mir.copy_operand_value(mir.MirCopyOperand (place: receiver_place));
        }
        return self.borrow_receiver_place(receiver_place, receiver_type, mutable_reference, span);
    }

    () lower_range_for_loop(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        hir.HirRange range_expr,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirLocalId index_local = self.add_loop_index_local(span);
        mir.MirLocalId end_local = self.add_loop_len_local(span);
        self.lower_into_place(range_expr.start, self.place_for_local(index_local));
        self.lower_into_place(range_expr.end, self.place_for_local(end_local));
        if (self.terminated) {
            return;
        }
        self.lower_range_for_loop_cfg(loop_expr, pattern, index_local, end_local, destination, span);
    }

    () lower_sequence_for_loop(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        hir.HirId iterable,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirPlace destination,
        token.Span span
    ) {
        qid.TypeId iterator_type = self.lowerer.substitute_type(plan.iterator_type, self.substitutions);
        mir.MirLocalId iterator_local = self.add_temp(iterator_type, span);
        self.lower_sequence_make_iterator(iterable, plan, iterator_local, span);
        if (self.terminated) { return; }
        self.lower_sequence_for_loop_cfg(loop_expr, pattern, plan, iterator_local, destination, span);
    }

    () lower_sequence_make_iterator(self,
        hir.HirId iterable,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirLocalId iterator_local,
        token.Span span
    ) {
        qid.TypeId receiver_type = self.type_for_node(iterable);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(plan.make_iterator_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(iterable, mutable_reference));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(receiver_type, plan.make_iterator_def);
        self.lower_direct_function_call_with_type_args(
            plan.make_iterator_def,
            type_args,
            args$.ref(),
            self.place_for_local(iterator_local),
            span
        );
    }

    () lower_sequence_for_loop_cfg(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirLocalId iterator_local,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirBlockId header_block = self.reserve_block(span);
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId increment_block = self.reserve_block(span);
        mir.MirBlockId exit_block = self.reserve_block(span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)), span);
        mir.MirLocalId next_local = self.lower_sequence_for_loop_header(
            header_block,
            body_block,
            exit_block,
            plan,
            iterator_local,
            span
        );
        self.lower_sequence_for_loop_body(
            loop_expr,
            pattern,
            plan,
            next_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.start_block(increment_block);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)), span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    mir.MirLocalId lower_sequence_for_loop_header(self,
        mir.MirBlockId header_block,
        mir.MirBlockId body_block,
        mir.MirBlockId exit_block,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirLocalId iterator_local,
        token.Span span
    ) {
        self.start_block(header_block);
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        qid.TypeId next_type = self.lowerer.ctx.store.types.optional_type(element_type, span);
        mir.MirLocalId next_local = self.add_temp(next_type, span);
        self.lower_sequence_next_call(plan, iterator_local, next_local, span);
        mir.MirLocalId cond_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(cond_local),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.is_some,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(next_local)))
            )),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(cond_local))),
            then_target: body_block,
            else_target: exit_block
        )), span);
        return next_local;
    }

    () lower_sequence_next_call(self,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirLocalId iterator_local,
        mir.MirLocalId next_local,
        token.Span span
    ) {
        qid.TypeId iterator_type = self.lowerer.substitute_type(plan.iterator_type, self.substitutions);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(plan.next_def) == .mutable_ref_receiver;
        args.add(self.borrow_receiver_place(
            self.place_for_local(iterator_local),
            iterator_type,
            mutable_reference,
            span
        ));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(iterator_type, plan.next_def);
        self.lower_direct_function_call_with_type_args(
            plan.next_def,
            type_args,
            args$.ref(),
            self.place_for_local(next_local),
            span
        );
    }

    () lower_sequence_for_loop_body(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        typeck_store.ForLoopSequencePlan plan,
        mir.MirLocalId next_local,
        mir.MirBlockId body_block,
        mir.MirBlockId increment_block,
        mir.MirBlockId exit_block,
        mir.MirPlace destination
    ) {
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        mir.MirLocalId item_local = self.add_temp(element_type, self.lowerer.hir_span(loop_expr.body));
        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(lower_support.LoopTargets (
            continue_target: increment_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.start_block(body_block);
        self.push_assign(
            self.place_for_local(item_local),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.unwrap_some,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(next_local)))
            )),
            self.lowerer.hir_span(loop_expr.body)
        );
        list.ArrayList<mir.MirLocalId> item_locals! = list.ArrayList<mir.MirLocalId>();
        self.lower_payload_pattern(pattern, self.place_for_local(item_local), item_locals$.ref());
        self.lower_expr_statement(loop_expr.body);
        self.finish_for_loop_body(increment_block, loop_expr, item_locals$.ref());
        lower_support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);
    }

    mir.MirLocalId add_loop_index_local(self, token.Span span) {
        return self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
    }

    mir.MirLocalId add_loop_len_local(self, token.Span span) {
        return self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
    }

    () init_for_loop_counters(self,
        mir.MirPlace iterable_place,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        token.Span span
    ) {
        self.push_assign(self.place_for_local(index_local), self.int_const_rvalue(0, span), span);
        self.push_assign(
            self.place_for_local(len_local),
            mir.len_rvalue(mir.MirLenRvalue (place: iterable_place)),
            span
        );
    }

    () lower_for_loop_cfg(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirPlace iterable_place,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirBlockId header_block = self.reserve_block(span);
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId increment_block = self.reserve_block(span);
        mir.MirBlockId exit_block = self.reserve_block(span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, len_local, span);
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            self.project_index(iterable_place, index_local),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    () lower_range_for_loop_cfg(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirLocalId index_local,
        mir.MirLocalId end_local,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirBlockId header_block = self.reserve_block(span);
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId increment_block = self.reserve_block(span);
        mir.MirBlockId exit_block = self.reserve_block(span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, end_local, span);
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            self.place_for_local(index_local),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    () lower_for_loop_header(self,
        mir.MirBlockId header_block,
        mir.MirBlockId body_block,
        mir.MirBlockId exit_block,
        mir.MirLocalId index_local,
        mir.MirLocalId len_local,
        token.Span span
    ) {
        self.start_block(header_block);
        mir.MirLocalId cond_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(cond_local),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.lt,
                lhs: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(index_local))),
                rhs: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(len_local)))
            )),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(cond_local))),
            then_target: body_block,
            else_target: exit_block
        )), span);
    }

    () lower_for_loop_body(self,
        hir.HirLoop loop_expr,
        hir.HirId pattern,
        mir.MirPlace item_place,
        mir.MirLocalId index_local,
        mir.MirBlockId body_block,
        mir.MirBlockId increment_block,
        mir.MirBlockId exit_block,
        mir.MirPlace destination
    ) {
        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(lower_support.LoopTargets (
            continue_target: increment_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.start_block(body_block);
        list.ArrayList<mir.MirLocalId> item_locals! = list.ArrayList<mir.MirLocalId>();
        self.lower_payload_pattern(pattern, item_place, item_locals$.ref());
        self.lower_expr_statement(loop_expr.body);
        self.finish_for_loop_body(increment_block, loop_expr, item_locals$.ref());
        lower_support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);
    }

    () finish_for_loop_body(self,
        mir.MirBlockId increment_block,
        hir.HirLoop loop_expr,
        list.ArrayList<mir.MirLocalId>& item_locals
    ) {
        if (self.terminated) { return; }
        token.Span span = self.lowerer.hir_span(loop_expr.body);
        self.end_scope(item_locals, span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: increment_block)), span);
    }

    () lower_for_loop_increment(self,
        mir.MirBlockId increment_block,
        mir.MirLocalId index_local,
        mir.MirBlockId header_block,
        token.Span span
    ) {
        self.start_block(increment_block);
        self.push_assign(
            self.place_for_local(index_local),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.add,
                lhs: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(index_local))),
                rhs: mir.const_operand_value(self.int_const(1, span))
            )),
            span
        );
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: header_block)), span);
    }

    () lower_for_loop_exit(self, mir.MirBlockId exit_block, mir.MirPlace destination, token.Span span) {
        self.start_block(exit_block);
        self.push_assign(destination, self.unit_rvalue(span), span);
    }

    () lower_switch(self, hir.HirId node_id, hir.HirSwitch switch_expr, mir.MirPlace destination) {
        qid.TypeId value_type = self.type_for_node(switch_expr.value);
        mir.MirPlace? subject_place! = self.switch_subject_place(switch_expr, value_type);
        mir.MirOperand discriminator = self.lower_switch_discriminator(switch_expr.value, value_type, subject_place);
        qid.TypeId discriminator_type = self.switch_discriminator_type(value_type);
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId default_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId default_target! = default_block;
        list.ArrayList<mir.MirBlockId> body_blocks! = list.ArrayList<mir.MirBlockId>(switch_expr.cases.length);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>();
        list.ArrayList<lower_support.SwitchPayloadEntry> payload_entries! =
            list.ArrayList<lower_support.SwitchPayloadEntry>();

        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(switch_expr.cases[case_index].body));
            body_blocks.add(body_block);
            default_target = self.add_switch_patterns(
                switch_expr.cases[case_index],
                body_block,
                default_target,
                discriminator_type,
                cases$.ref(),
                payload_entries$.ref()
            );
            case_index = case_index + 1;
        }

        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: discriminator,
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: default_target
        )), self.lowerer.hir_span(node_id));

        Int active_depth = self.active_locals.len();
        self.lower_switch_payload_entries(payload_entries$.ref(), subject_place, value_type);
        self.restore_active_locals(active_depth);
        self.lower_switch_case_bodies(
            switch_expr,
            body_blocks$.ref(),
            destination,
            join_block,
            active_depth,
            subject_place,
            value_type
        );
        self.restore_active_locals(active_depth);
        if (default_target.to_index() == default_block.to_index()) {
            self.start_block(default_block);
            self.finish_block(
                mir.unreachable_terminator_kind(mir.MirUnreachableTerminator (generated_by_check: true)),
                self.lowerer.hir_span(node_id)
            );
        }
        self.start_block(join_block);
    }

    mir.MirPlace? switch_subject_place(self, hir.HirSwitch switch_expr, qid.TypeId value_type) {
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.pointer_base_place(switch_expr.value);
        }
        if (self.switch_has_payload_patterns(switch_expr)) {
            return self.pointer_base_place(switch_expr.value);
        }
        return null;
    }

    Bool switch_has_payload_patterns(self, hir.HirSwitch switch_expr) {
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            if (self.switch_case_has_payload_pattern(switch_expr.cases[case_index])) {
                return true;
            }
            case_index = case_index + 1;
        }
        return false;
    }

    Bool switch_case_has_payload_pattern(self, hir.HirSwitchCase switch_case) {
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            if (self.pattern_has_payload(switch_case.patterns[pattern_index])) {
                return true;
            }
            pattern_index = pattern_index + 1;
        }
        return false;
    }

    Bool pattern_has_payload(self, hir.HirId pattern_id) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        guard pattern.data is .variant_pattern(variant_pattern) else {
            return false;
        }
        return variant_pattern.payload.length != 0;
    }

    mir.MirOperand lower_switch_discriminator(self,
        hir.HirId value,
        qid.TypeId value_type,
        mir.MirPlace? subject_place
    ) {
        if (!self.switch_needs_explicit_discriminant(value_type)) {
            return self.lower_to_operand(value);
        }
        token.Span span = self.lowerer.hir_span(value);
        guard subject_place is .some(place) else {
            return self.unsupported_operand(value);
        }
        mir.MirLocalId temp = self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
        self.push_assign(
            self.place_for_local(temp),
            mir.discriminant_rvalue(mir.MirDiscriminantRvalue (place: place)),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(temp)));
    }

    qid.TypeId switch_discriminator_type(self, qid.TypeId value_type) {
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.lowerer.ctx.store.types.int_type();
        }
        return value_type;
    }

    Bool switch_needs_explicit_discriminant(self, qid.TypeId value_type) {
        guard self.nominal_def_kind(value_type) is .some(kind) else {
            return false;
        }
        return kind == .union_def;
    }

    mir.MirBlockId add_switch_patterns(self,
        hir.HirSwitchCase switch_case,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<lower_support.SwitchPayloadEntry>& payload_entries
    ) {
        mir.MirBlockId updated_default! = default_target;
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            hir.HirId pattern_id = switch_case.patterns[pattern_index];
            updated_default = self.add_switch_pattern(
                pattern_id,
                body_block,
                updated_default,
                discriminator_type,
                cases,
                payload_entries
            );
            pattern_index = pattern_index + 1;
        }
        return updated_default;
    }

    mir.MirBlockId add_switch_pattern(self,
        hir.HirId pattern_id,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<lower_support.SwitchPayloadEntry>& payload_entries
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) {
            return body_block;
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            cases.add(mir.MirSwitchCase (
                value: self.lower_literal_as_const(pattern_id, literal_pattern.literal, discriminator_type),
                target: body_block
            ));
            return default_target;
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            self.add_variant_switch_pattern(
                pattern_id,
                variant_pattern,
                body_block,
                discriminator_type,
                cases,
                payload_entries
            );
            return default_target;
        }
        self.mark_unsupported(pattern_id);
        return default_target;
    }

    () add_variant_switch_pattern(self,
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        mir.MirBlockId body_block,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases,
        list.ArrayList<lower_support.SwitchPayloadEntry>& payload_entries
    ) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirBlockId target! = body_block;
        if (variant_pattern.payload.length != 0) {
            target = self.reserve_block(self.lowerer.hir_span(pattern_id));
            payload_entries.add(lower_support.SwitchPayloadEntry (
                pattern_id: pattern_id,
                entry_block: target,
                body_block: body_block
            ));
        }
        cases.add(mir.MirSwitchCase (
            value: self.variant_tag_const(pattern_id, variant_def, discriminator_type),
            target: target
        ));
    }

    mir.MirConst variant_tag_const(self, hir.HirId pattern_id, qid.DefId variant_def, qid.TypeId discriminator_type) {
        return mir.MirConst (
            type_id: discriminator_type,
            span: self.lowerer.hir_span(pattern_id),
            value: mir.int_const_kind(mir.MirIntConst (
                bits: UInt64(self.variant_tag_value(variant_def)),
                signed_value: true
            ))
        );
    }

    Int variant_tag_value(self, qid.DefId variant_def) {
        if (self.lowerer.ctx.store.defs.get(variant_def).kind == .enum_case_def) {
            return self.enum_case_value_or_error(variant_def);
        }
        return self.variant_tag_index(variant_def);
    }

    Int enum_case_value_or_error(self, qid.DefId case_def) {
        if (self.lowerer.typeck.enum_case_value(case_def) is .some(value)) {
            return value;
        }
        self.lowerer.output.mark_error();
        return 0;
    }

    Int variant_tag_index(self, qid.DefId variant_def) {
        guard self.lowerer.ctx.store.defs.get(variant_def).owner_def is .some(owner_def) else {
            return 0;
        }
        guard self.lowerer.hirs.def(owner_def) is .some(owner_hir) else {
            return 0;
        }
        Int tag! = 0;
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (member_def.to_index() == variant_def.to_index()) {
                return tag;
            }
            if (self.def_is_variant_member(member_def)) {
                tag = tag + 1;
            }
            index = index + 1;
        }
        return 0;
    }

    Bool def_is_variant_member(self, qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.store.defs.get(def_id).kind;
        if (kind == .enum_case_def) {
            return true;
        }
        return kind == .union_variant_def;
    }

    () lower_switch_payload_entries(self,
        list.ArrayList<lower_support.SwitchPayloadEntry>& entries,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type
    ) {
        Int index! = 0;
        while (index < entries.len()) {
            lower_support.SwitchPayloadEntry entry = entries.get(index);
            self.start_block(entry.entry_block);
            list.ArrayList<mir.MirLocalId> entry_locals! = list.ArrayList<mir.MirLocalId>();
            self.lower_variant_payload_binding(
                entry.pattern_id,
                subject_place,
                subject_type,
                entry_locals$.ref()
            );
            if (!self.terminated) {
                self.finish_block(
                    mir.goto_terminator_kind(mir.MirGotoTerminator (target: entry.body_block)),
                    self.lowerer.hir_span(entry.pattern_id)
                );
            }
            index = index + 1;
        }
    }

    def.DefKind? nominal_def_kind(self, qid.TypeId type_id) {
        guard self.nominal_type_data(type_id) is .some(named) else {
            return null;
        }
        return self.lowerer.ctx.store.defs.get(named.def_id).kind;
    }

    types.NamedType? nominal_type_data(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .named(named) else {
            return null;
        }
        return named;
    }

    () lower_switch_case_bodies(self,
        hir.HirSwitch switch_expr,
        list.ArrayList<mir.MirBlockId>& body_blocks,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        Int active_depth,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type
    ) {
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            self.start_block(body_blocks.get(case_index));
            list.ArrayList<mir.MirLocalId> case_locals! = list.ArrayList<mir.MirLocalId>();
            self.collect_switch_case_payload_locals(switch_expr.cases[case_index], case_locals$.ref());
            self.lower_into_place(switch_expr.cases[case_index].body, destination);
            if (!self.terminated) {
                self.end_scope(case_locals$.ref(), self.lowerer.hir_span(switch_expr.cases[case_index].body));
                self.finish_block(
                    mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)),
                    self.lowerer.hir_span(switch_expr.cases[case_index].body)
                );
            }
            self.restore_active_locals(active_depth);
            case_index = case_index + 1;
        }
    }

    () collect_switch_case_payload_locals(self,
        hir.HirSwitchCase switch_case,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            self.collect_payload_pattern_locals(switch_case.patterns[pattern_index], case_locals);
            pattern_index = pattern_index + 1;
        }
    }

    () lower_variant_payload_binding(self,
        hir.HirId pattern_id,
        mir.MirPlace? subject_place,
        qid.TypeId subject_type,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        guard subject_place is .some(base_place) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        guard pattern.data is .variant_pattern(variant_pattern) else { return; }
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        qid.TypeId payload_type = self.variant_payload_type(variant_def, subject_type);
        mir.MirPlace payload_place = self.project_field(base_place, variant_def, payload_type);
        self.lower_variant_payload_patterns(variant_pattern, payload_place, payload_type, case_locals);
    }

    () lower_variant_payload_patterns(self,
        hir.HirVariantPattern variant_pattern,
        mir.MirPlace payload_place,
        qid.TypeId payload_type,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        if (variant_pattern.payload.length == 1) {
            self.lower_payload_pattern(variant_pattern.payload[0], payload_place, case_locals);
            return;
        }
        if (!self.payload_type_is_tuple(payload_type)) {
            self.mark_unsupported(variant_pattern.payload[0]);
            return;
        }
        Int index! = 0;
        while (index < variant_pattern.payload.length) {
            self.lower_payload_pattern(
                variant_pattern.payload[index],
                self.project_constant_index(payload_place, index),
                case_locals
            );
            index = index + 1;
        }
    }

    () collect_payload_pattern_locals(self, hir.HirId pattern_id, list.ArrayList<mir.MirLocalId>& case_locals) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .variant_pattern(variant_pattern)) {
            Int index! = 0;
            while (index < variant_pattern.payload.length) {
                self.collect_payload_pattern_locals(variant_pattern.payload[index], case_locals);
                index = index + 1;
            }
            return;
        }
        if (pattern.data is .binding_pattern(binding)) {
            self.add_case_payload_local(self.mir_local_for_hir(binding.local_id), case_locals);
        }
    }

    () add_case_payload_local(self, mir.MirLocalId local_id, list.ArrayList<mir.MirLocalId>& case_locals) {
        Int index! = 0;
        while (index < case_locals.len()) {
            if (case_locals.get(index).to_index() == local_id.to_index()) { return; }
            index = index + 1;
        }
        case_locals.add(local_id);
        self.active_locals.add(local_id);
    }

    () lower_payload_pattern(self,
        hir.HirId pattern_id,
        mir.MirPlace source,
        list.ArrayList<mir.MirLocalId>& case_locals
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) { return; }
        guard pattern.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        self.add_case_payload_local(local_id, case_locals);
        self.push_storage_live(local_id, self.lowerer.hir_span(pattern_id));
        hir.HirLocal local = self.hir_local(binding.local_id);
        if (local.borrow_binding) {
            self.push_assign(
                self.place_for_local(local_id),
                mir.borrow_rvalue(mir.MirBorrowRvalue (place: source)),
                self.lowerer.hir_span(pattern_id)
            );
            return;
        }
        self.push_assign(
            self.place_for_local(local_id),
            mir.use_rvalue(mir.MirUseRvalue (value: mir.copy_operand_value(mir.MirCopyOperand (place: source)))),
            self.lowerer.hir_span(pattern_id)
        );
    }

    qid.TypeId variant_payload_type(self, qid.DefId variant_def, qid.TypeId subject_type) {
        guard self.nominal_type_data(subject_type) is .some(named) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        guard self.lowerer.ctx.store.defs.get(variant_def).owner_def is .some(owner_def) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        guard self.lowerer.typeck.def_type(variant_def) is .some(template_type) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        return self.lowerer.substitute_type(template_type, substitutions$.ref());
    }

    monomorph.SubstitutionMap nominal_substitution(self, qid.DefId owner_def, qid.TypeId[]& type_args) {
        monomorph.SubstitutionMap substitutions! = monomorph.SubstitutionMap();
        hir.HirDef& owner_hir = self.lowerer.hirs.def_ref(owner_def);
        Int type_index! = 0;
        Int member_index! = 0;
        while (member_index < owner_hir.generic_params.len()) {
            qid.DefId member_def = owner_hir.generic_params.get(member_index);
            def.DefRecord member = self.lowerer.ctx.store.defs.get(member_def);
            // const generic 参数不占用 type_args 槽位；混合参数顺序里
            // 后续类型参数必须继续绑定到下一个类型实参。
            if (member.domain == .type_name && type_index < type_args.length) {
                substitutions.set_type(member_def, type_args[type_index]);
                type_index = type_index + 1;
            }
            member_index = member_index + 1;
        }
        return substitutions$.move();
    }

    Bool payload_type_is_tuple(self, qid.TypeId payload_type) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(payload_type);
        return info.data is .tuple_type(_);
    }

    () lower_catch(self, hir.HirId node_id, hir.HirCatch catch_expr, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId error_union_local = self.add_temp(self.type_for_node(catch_expr.value), span);
        self.lower_into_place(catch_expr.value, self.place_for_local(error_union_local));
        if (self.terminated) { return; }

        mir.MirLocalId is_error_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        mir.MirPlace error_union_place = self.place_for_local(error_union_local);
        self.push_assign(
            self.place_for_local(is_error_local),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.is_error,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: error_union_place))
            )),
            span
        );

        mir.MirBlockId success_block = self.reserve_block(span);
        mir.MirBlockId catch_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(is_error_local))),
            then_target: catch_block,
            else_target: success_block
        )), span);

        Int active_depth = self.active_locals.len();
        self.lower_catch_success_block(success_block, error_union_place, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.lower_catch_error_block(catch_block, catch_expr, error_union_place, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.start_block(join_block);
    }

    () lower_propagate_error_expr(
        self,
        hir.HirId node_id,
        hir.HirId value,
        mir.MirPlace destination
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId result_local = self.add_temp(self.type_for_node(value), span);
        mir.MirPlace result_place = self.place_for_local(result_local);
        self.lower_into_place(value, result_place);
        if (self.terminated) { return; }
        mir.MirLocalId is_error_local = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(is_error_local),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.is_error,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: result_place))
            )),
            span
        );
        mir.MirBlockId error_block = self.reserve_block(span);
        mir.MirBlockId success_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: mir.copy_operand_value(mir.MirCopyOperand (
                place: self.place_for_local(is_error_local)
            )),
            then_target: error_block,
            else_target: success_block
        )), span);
        self.lower_propagate_error_block(error_block, result_place, span);
        self.start_block(success_block);
        self.push_assign(
            destination,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.unwrap_value,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: result_place))
            )),
            span
        );
    }

    () lower_propagate_error_block(
        self,
        mir.MirBlockId block_id,
        mir.MirPlace result_place,
        token.Span span
    ) {
        self.start_block(block_id);
        qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
        mir.MirLocalId error_local = self.add_temp(self.error_union_error_type(return_type), span);
        self.push_assign(
            self.place_for_local(error_local),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.unwrap_error,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: result_place))
            )),
            span
        );
        self.push_assign(
            self.place_for_local(self.return_local()),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.make_error,
                value: self.operand_for_place(self.place_for_local(error_local))
            )),
            span
        );
        self.run_deferred_from(0, span);
        self.push_active_storage_dead_from(0, span);
        self.finish_return(false, span);
    }

    () lower_catch_success_block(self,
        mir.MirBlockId block_id,
        mir.MirPlace error_union_place,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        token.Span span
    ) {
        self.start_block(block_id);
        self.push_assign(
            destination,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.unwrap_value,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: error_union_place))
            )),
            span
        );
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)), span);
    }

    () lower_catch_error_block(self,
        mir.MirBlockId block_id,
        hir.HirCatch catch_expr,
        mir.MirPlace error_union_place,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        token.Span span
    ) {
        self.start_block(block_id);
        list.ArrayList<mir.MirLocalId> catch_locals! = list.ArrayList<mir.MirLocalId>();
        self.lower_catch_pattern(catch_expr.pattern, error_union_place, catch_locals$.ref(), span);
        if (!self.terminated) {
            self.lower_into_place(catch_expr.body, destination);
        }
        if (!self.terminated) {
            self.end_scope(catch_locals$.ref(), span);
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)), span);
        }
    }

    () lower_catch_pattern(self,
        hir.HirId? pattern,
        mir.MirPlace error_union_place,
        list.ArrayList<mir.MirLocalId>& catch_locals,
        token.Span span
    ) {
        guard pattern is .some(pattern_id) else { return; }
        hir.HirNode pattern_node = self.lowerer.hirs.node(pattern_id);
        guard pattern_node.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        mir.MirLocalId local_id = self.mir_local_for_hir(binding.local_id);
        catch_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, span);
        self.push_assign(
            self.place_for_local(local_id),
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.unwrap_error,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: error_union_place))
            )),
            span
        );
    }

    () lower_break(self, hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        lower_support.LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            mir.goto_terminator_kind(mir.MirGotoTerminator (target: target.break_target)),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_continue(self, hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        lower_support.LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.hir_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            mir.goto_terminator_kind(mir.MirGotoTerminator (target: target.continue_target)),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_unary(self, hir.HirId node_id, hir.HirUnary unary, mir.MirPlace destination) {
        if (unary.op == .new_value) {
            self.lower_new_value(node_id, unary, destination);
            return;
        }
        guard lower_support.unary_op(unary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.unary_rvalue(mir.MirUnaryRvalue (op: op, value: self.lower_to_operand(unary.value))),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_new_value(self, hir.HirId node_id, hir.HirUnary unary, mir.MirPlace destination) {
        if (self.place_is_owned_slice_value(destination)) {
            self.lower_owned_slice_value_new(node_id, unary.value, destination);
            return;
        }
        hir.HirNode value = self.lowerer.hirs.node(unary.value);
        if (value.data is .lambda_expr(lambda)) {
            if (self.place_is_owned_closure(destination)) {
                self.lower_new_lambda_closure(node_id, unary.value, lambda, destination);
                return;
            }
        }
        token.Span span = self.lowerer.hir_span(node_id);
        self.push_assign(
            destination,
            mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: self.type_for_node(unary.value))),
            span
        );
        // `new T(expr)` 的 initializer 必须直接写进 heap pointee。不能先把
        // 拥有资源的 aggregate 构造成 rvalue 再复制到 heap，否则会破坏所有权。
        self.lower_into_place(unary.value, self.project_deref(destination, false));
    }

    Bool place_is_owned_closure(self, mir.MirPlace place) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .owner_pointer) { return false; }
        return self.type_is_closure(handle.element);
    }

    () lower_new_lambda_closure(
        self,
        hir.HirId node_id,
        hir.HirId lambda_id,
        hir.HirLambda lambda,
        mir.MirPlace destination
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId closure_type = self.type_for_node(lambda_id);
        self.push_assign(
            destination,
            mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: closure_type)),
            span
        );
        mir.MirOperand env = self.heap_lambda_env_operand(lambda_id, lambda, null, span);
        mir.MirOperand vtable = self.lambda_vtable_operand(lambda_id, lambda, true, span);
        self.push_closure_assign(
            lambda_id,
            self.project_deref(destination, false),
            closure_type,
            env,
            vtable
        );
    }

    () lower_owned_slice_value_new(self, hir.HirId node_id, hir.HirId value_id, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId element_type = self.owned_slice_value_element_type(self.mir_place_type(destination));
        Int count = self.owned_slice_value_initializer_count(value_id);
        self.push_assign(
            destination,
            mir.alloc_array_rvalue(mir.MirAllocArrayRvalue (
                element_type: element_type,
                count: self.int_operand(count, span)
            )),
            span
        );

        hir.HirNode value = self.lowerer.hirs.node(value_id);
        if (value.data is .array_literal(array_literal)) {
            self.lower_owned_slice_value_literal(array_literal, destination, element_type, span);
            self.lower_owned_slice_value_sentinel(destination, count, element_type, span);
            return;
        }
        if (value.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                self.lower_owned_unsized_string_literal(symbol_id, destination, element_type, span);
                self.lower_owned_slice_value_sentinel(destination, count, element_type, span);
                return;
            }
        }
        self.mark_unsupported(value_id);
    }

    () lower_owned_slice_value_literal(self,
        hir.HirArrayLiteral literal,
        mir.MirPlace destination,
        qid.TypeId element_type,
        token.Span span
    ) {
        Int index! = 0;
        while (index < literal.items.length) {
            mir.MirPlace element_place = self.project_runtime_index(destination, index, span);
            self.lower_into_place_as_type(literal.items[index], element_place, element_type);
            index = index + 1;
        }
    }

    () lower_owned_slice_value_sentinel(self,
        mir.MirPlace destination,
        Int count,
        qid.TypeId element_type,
        token.Span span
    ) {
        qid.TypeId destination_type = self.mir_place_type(destination);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(destination_type);
        guard info.data is .handle_type(handle) else { return; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(slice_type) else { return; }
        guard slice_type.sentinel is .some(sentinel) else { return; }
        mir.MirPlace sentinel_place = self.project_runtime_index(destination, count, span);
        self.lower_comptime_value_into_place_at_span(sentinel.value, sentinel_place, span);
    }

    () lower_owned_unsized_string_literal(self,
        qid.SymbolId symbol_id,
        mir.MirPlace destination,
        qid.TypeId element_type,
        token.Span span
    ) {
        UInt8[]& text = self.lowerer.ctx.store.symbols.text(symbol_id);
        Int index! = 0;
        while (index < text.length) {
            self.push_assign(
                self.project_runtime_index(destination, index, span),
                self.uint8_rvalue(Int(text[index]), span),
                span
            );
            index = index + 1;
        }
    }

    Int owned_slice_value_initializer_count(self, hir.HirId value_id) {
        hir.HirNode value = self.lowerer.hirs.node(value_id);
        if (value.data is .array_literal(array_literal)) {
            return array_literal.items.length;
        }
        if (value.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                return self.lowerer.ctx.store.symbols.text(symbol_id).length;
            }
        }
        return 0;
    }

    mir.MirPlace project_runtime_index(self, mir.MirPlace base, Int offset, token.Span span) {
        mir.MirLocalId index_local = self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
        self.push_assign(self.place_for_local(index_local), self.int_const_rvalue(offset, span), span);
        return self.project_index(base, index_local);
    }

    qid.TypeId owned_slice_value_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(array_type) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        return array_type.element;
    }

    Bool place_is_owned_slice_value(self, mir.MirPlace place) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        return self.handle_is_owned_slice_value(handle);
    }

    () lower_binary(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        if (self.string_concat_const(node_id) is .some(symbol_id)) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (
                    value: mir.const_operand_value(mir.MirConst (
                        type_id: self.type_for_node(node_id),
                        span: self.lowerer.hir_span(node_id),
                        value: mir.string_const_kind(mir.MirStringConst (
                            symbol_id: symbol_id,
                            nul_terminated: false
                        ))
                    ))
                )),
                self.lowerer.hir_span(node_id)
            );
            return;
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.lower_logic_binary(node_id, binary, destination);
            return;
        }
        if (binary.op == .equal || binary.op == .not_equal) {
            self.lower_equal_binary(node_id, binary, destination);
            return;
        }
        guard lower_support.binary_op(binary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: op,
                lhs: self.lower_to_operand(binary.left),
                rhs: self.lower_to_operand(binary.right)
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    qid.SymbolId? string_concat_const(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                return symbol_id;
            }
            return null;
        }
        guard node.data is .binary(binary) else {
            return null;
        }
        if (binary.op != .add) {
            return null;
        }
        guard self.string_concat_const(binary.left) is .some(left_symbol) else {
            return null;
        }
        guard self.string_concat_const(binary.right) is .some(right_symbol) else {
            return null;
        }
        UInt8[]& left = self.lowerer.ctx.store.symbols.text(left_symbol);
        UInt8[]& right = self.lowerer.ctx.store.symbols.text(right_symbol);
        std.String text = string.concat(left, right);
        return self.lowerer.ctx.store.symbols.intern(text.bytes());
    }

    () lower_equal_binary(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId compare_type = self.receiver_expr_type(binary.left);
        if (self.lower_null_handle_equal_binary(binary, compare_type, destination, span)) {
            return;
        }
        if (self.lower_trait_equal_binary(node_id, binary, compare_type, destination, span)) {
            return;
        }
        if (self.lower_reference_equal_binary(node_id, binary, compare_type, destination, span)) {
            return;
        }
        if (!self.has_aggregate_equality_plan(node_id) && !self.type_has_aggregate_equality(compare_type)) {
            self.lower_scalar_equal_binary(node_id, binary, destination);
            return;
        }
        mir.MirPlace lhs = self.lower_equality_operand(binary.left, compare_type, span);
        mir.MirPlace rhs = self.lower_equality_operand(binary.right, compare_type, span);
        self.lower_equal_places(compare_type, lhs, rhs, destination, binary.op == .not_equal, span);
    }

    Bool lower_null_handle_equal_binary(self,
        hir.HirBinary binary,
        qid.TypeId compare_type,
        mir.MirPlace destination,
        token.Span span
    ) {
        if (self.is_null_literal(binary.right)) {
            return self.lower_null_handle_compare(binary.left, compare_type, destination, binary.op == .not_equal, span);
        }
        if (self.is_null_literal(binary.left)) {
            qid.TypeId right_type = self.receiver_expr_type(binary.right);
            return self.lower_null_handle_compare(binary.right, right_type, destination, binary.op == .not_equal, span);
        }
        return false;
    }

    Bool lower_null_handle_compare(self,
        hir.HirId value_id,
        qid.TypeId handle_type,
        mir.MirPlace destination,
        Bool not_equal,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(handle_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (!self.handle_can_compare_null(handle)) {
            return false;
        }
        mir.MirPlace handle_place = self.null_compare_handle_place(value_id, handle_type, span);
        mir.MirPlace compare_place = self.null_compare_payload_place(handle_place, handle_type);
        qid.TypeId compare_type = self.mir_place_type(compare_place);
        mir.MirBinaryOp op! = mir.MirBinaryOp.eq;
        if (not_equal) {
            op = mir.MirBinaryOp.ne;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: op,
                lhs: mir.copy_operand_value(mir.MirCopyOperand (place: compare_place)),
                rhs: self.null_operand(compare_type, span)
            )),
            span
        );
        return true;
    }

    Bool handle_can_compare_null(self, types.HandleType handle) {
        return handle.kind == .raw_pointer;
    }

    mir.MirPlace null_compare_handle_place(self, hir.HirId value_id, qid.TypeId handle_type, token.Span span) {
        if (self.place_for_expr(value_id) is .some(place)) {
            return place;
        }
        mir.MirLocalId local = self.add_temp(handle_type, span);
        mir.MirPlace place = self.place_for_local(local);
        self.lower_into_place(value_id, place);
        return place;
    }

    @life(handle_place > return)
    mir.MirPlace null_compare_payload_place(self, mir.MirPlace handle_place, qid.TypeId handle_type) {
        if (self.layout_for_type(handle_type).fields.length > 0) {
            return self.project_constant_index(handle_place, 0);
        }
        return handle_place;
    }

    mir.MirOperand null_operand(self, qid.TypeId type_id, token.Span span) {
        return mir.const_operand_value(mir.MirConst (
            type_id: type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        ));
    }

    Bool is_null_literal(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .literal(literal) else { return false; }
        return literal.value is .null_value;
    }

    () lower_scalar_equal_binary(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        guard lower_support.binary_op(binary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: op,
                lhs: self.lower_to_operand(binary.left),
                rhs: self.lower_to_operand(binary.right)
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool lower_trait_equal_binary(self,
        hir.HirId node_id,
        hir.HirBinary binary,
        qid.TypeId compare_type,
        mir.MirPlace destination,
        token.Span span
    ) {
        guard self.lowerer.typeck.member_selection(node_id) is .some(trait_member) else {
            return false;
        }
        guard self.concrete_member_for_type(trait_member, compare_type) is .some(target) else {
            return false;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(target) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(binary.left, mutable_reference));
        args.add(self.lower_receiver_operand(binary.right, mutable_reference));
        if (binary.op == .equal) {
            self.lower_direct_function_call(node_id, target, args$.ref(), destination);
            return true;
        }
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.lower_direct_function_call(node_id, target, args$.ref(), self.place_for_local(result));
        self.finish_equal_places(result, destination, true, span);
        return true;
    }

    Bool lower_reference_equal_binary(self,
        hir.HirId node_id,
        hir.HirBinary binary,
        qid.TypeId compare_type,
        mir.MirPlace destination,
        token.Span span
    ) {
        guard self.reference_element_type(compare_type) is .some(element_type) else {
            return false;
        }
        guard self.lowerer.ctx.store.resolve.core_traits.equatable_trait is .some(equatable_def) else {
            return false;
        }
        guard self.trait_member_by_name(equatable_def, "equal") is .some(equal_def) else {
            return false;
        }
        guard self.concrete_member_for_type(equal_def, element_type) is .some(target) else {
            return false;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(target) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(binary.left, mutable_reference));
        args.add(self.lower_receiver_operand(binary.right, mutable_reference));
        if (binary.op == .equal) {
            self.lower_direct_function_call(node_id, target, args$.ref(), destination);
            return true;
        }
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.lower_direct_function_call(node_id, target, args$.ref(), self.place_for_local(result));
        self.finish_equal_places(result, destination, true, span);
        return true;
    }

    qid.TypeId? reference_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .reference) { return null; }
        return handle.element;
    }

    qid.DefId? trait_member_by_name(self, qid.DefId trait_def, UInt8[]& name) {
        guard self.lowerer.hirs.def(trait_def) is .some(trait_hir) else { return null; }
        Int index! = 0;
        while (index < trait_hir.members.len()) {
            qid.DefId member_def = trait_hir.members.get(index);
            if (self.symbol_text_equal(self.lowerer.ctx.store.defs.get(member_def).name.symbol, name)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? concrete_member_for_type(self, qid.DefId trait_member_def, qid.TypeId type_id) {
        qid.SymbolId member_symbol = self.lowerer.ctx.store.defs.get(trait_member_def).name.symbol;
        guard self.nominal_type_data(self.member_lookup_value_type(type_id)) is .some(named) else {
            return null;
        }
        qid.DefId? member_def = self.function_member_def_by_symbol(named.def_id, member_symbol);
        guard member_def is .some(concrete_def) else {
            return null;
        }
        if (self.lowerer.def_is_trait_member(concrete_def)) {
            return null;
        }
        return concrete_def;
    }

    qid.TypeId member_lookup_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (self.handle_is_trait_object(handle)) {
                return handle.element;
            }
            if (handle.kind == .reference) {
                return handle.element;
            }
        }
        return type_id;
    }

    Bool has_aggregate_equality_plan(self, hir.HirId node_id) {
        guard self.lowerer.typeck.expr_lowering(node_id) is .some(lowering) else {
            return false;
        }
        return lowering == .aggregate_equality;
    }

    Bool type_has_aggregate_equality(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .tuple_type(_)) { return true; }
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .optional(_)) { return true; }
        if (info.data is .error_union(_)) { return true; }
        if (info.data is .handle_type(handle)) { return handle.kind == .slice; }
        if (info.data is .named(named)) { return self.named_type_has_aggregate_equality(named.def_id); }
        return false;
    }

    Bool named_type_has_aggregate_equality(self, qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return kind == .union_def;
    }

    mir.MirPlace lower_equality_operand(self, hir.HirId node_id, qid.TypeId compare_type, token.Span span) {
        mir.MirLocalId local = self.add_temp(compare_type, span);
        mir.MirPlace place = self.place_for_local(local);
        self.lower_into_place(node_id, place);
        return place;
    }

    () lower_equal_places(self,
        qid.TypeId type_id,
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirPlace destination,
        Bool invert,
        token.Span span
    ) {
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        if (type_layout.fields.length == 0) {
            self.lower_scalar_equal_places(lhs, rhs, destination, invert, span);
            return;
        }
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(self.place_for_local(result), self.bool_rvalue(true, span), span);
        Int index! = 0;
        while (index < type_layout.fields.length) {
            layout.FieldLayout field = type_layout.fields[index];
            if (!self.type_has_abi_value(field.field_type)) {
                index = index + 1;
                continue;
            }
            self.lower_equal_field(type_id, field, index, lhs, rhs, result, span);
            index = index + 1;
        }
        self.finish_equal_places(result, destination, invert, span);
    }

    () lower_equal_field(self,
        qid.TypeId owner_type,
        layout.FieldLayout field,
        Int field_index,
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirLocalId result,
        token.Span span
    ) {
        mir.MirLocalId field_result = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.lower_equal_places(
            field.field_type,
            self.project_layout_field(lhs, field, field_index),
            self.project_layout_field(rhs, field, field_index),
            self.place_for_local(field_result),
            false,
            span
        );
        self.push_assign(
            self.place_for_local(result),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.bit_and,
                lhs: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(result))),
                rhs: mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(field_result)))
            )),
            span
        );
    }

    () finish_equal_places(self, mir.MirLocalId result, mir.MirPlace destination, Bool invert, token.Span span) {
        mir.MirOperand result_operand = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.place_for_local(result)
        ));
        if (invert) {
            self.push_assign(
                destination,
                mir.unary_rvalue(mir.MirUnaryRvalue (op: mir.MirUnaryOp.logic_not, value: result_operand)),
                span
            );
            return;
        }
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue (value: result_operand)), span);
    }

    () lower_scalar_equal_places(self,
        mir.MirPlace lhs,
        mir.MirPlace rhs,
        mir.MirPlace destination,
        Bool invert,
        token.Span span
    ) {
        mir.MirBinaryOp op! = mir.MirBinaryOp.eq;
        if (invert) {
            op = mir.MirBinaryOp.ne;
        }
        self.push_assign(
            destination,
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: op,
                lhs: mir.copy_operand_value(mir.MirCopyOperand (place: lhs)),
                rhs: mir.copy_operand_value(mir.MirCopyOperand (place: rhs))
            )),
            span
        );
    }

    mir.MirPlace project_layout_field(self, mir.MirPlace base, layout.FieldLayout field, Int field_index) {
        if (field.field_def is .some(field_def)) {
            return self.project_field_at_index(base, field_def, field.field_type, field_index);
        }
        return self.project_constant_index(base, field_index);
    }

    Bool type_has_abi_value(self, qid.TypeId type_id) {
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        return type_layout.kind != .invalid && type_layout.kind != .zero_sized;
    }

    layout.TypeLayout layout_for_type(self, qid.TypeId type_id) {
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, type_id);
        return self.lowerer.ctx.store.layouts.layout(layout_id);
    }

    () lower_logic_binary(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        if (binary.op == .logic_and) {
            self.lower_logic_and(node_id, binary, destination);
            return;
        }
        self.lower_logic_or(node_id, binary, destination);
    }

    () lower_logic_and(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId rhs_block = self.reserve_block(self.lowerer.hir_span(binary.right));
        mir.MirBlockId false_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        mir.MirOperand condition = self.lower_to_operand(binary.left);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: condition,
            then_target: rhs_block,
            else_target: false_block
        )), self.lowerer.hir_span(binary.left));

        self.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.terminated) {
            self.finish_block(self.goto_terminator(join_block), span);
        }

        self.start_block(false_block);
        self.push_assign(destination, self.bool_rvalue(false, span), span);
        self.finish_block(self.goto_terminator(join_block), span);
        self.start_block(join_block);
    }

    () lower_logic_or(self, hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId true_block = self.reserve_block(span);
        mir.MirBlockId rhs_block = self.reserve_block(self.lowerer.hir_span(binary.right));
        mir.MirBlockId join_block = self.reserve_block(span);
        mir.MirOperand condition = self.lower_to_operand(binary.left);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: condition,
            then_target: true_block,
            else_target: rhs_block
        )), self.lowerer.hir_span(binary.left));

        self.start_block(true_block);
        self.push_assign(destination, self.bool_rvalue(true, span), span);
        self.finish_block(self.goto_terminator(join_block), span);

        self.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.terminated) {
            self.finish_block(self.goto_terminator(join_block), span);
        }
        self.start_block(join_block);
    }

    // type check 已经保证 get/set 的 base 是 pointer/reference。MIR 只把
    // 它们降成现有 place deref 读写，不再重新做语义判定。
    () lower_implicit_call(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.lowerer.typeck.intrinsic_operation(node_id) is .some(operation) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_intrinsic_operation(node_id, call, operation, destination);
    }

    () lower_intrinsic_operation(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        typeck_store.IntrinsicOperationKind operation,
        mir.MirPlace destination
    ) {
        switch operation {
            .alloc => self.lower_alloc(node_id, call, destination),
            .type_size => self.lower_type_info_value(node_id, call, destination, .size),
            .type_align => self.lower_type_info_value(node_id, call, destination, .align),
            .type_max_align => self.lower_type_info_value(node_id, call, destination, .max_align),
            .pointer_get => self.lower_pointer_get(node_id, call, destination),
            .pointer_set => self.lower_pointer_set(node_id, call, destination),
            .move => self.lower_move(node_id, call, destination),
            .borrow_ref => self.lower_borrow_ref(node_id, call, destination, false),
            .mutable_borrow_ref => self.lower_borrow_ref(node_id, call, destination, false),
            .address_of => self.lower_borrow_ref(node_id, call, destination, true),
            .mutable_address_of => self.lower_slice_ptr(node_id, call, destination),
            .cast => self.lower_cast(node_id, call, destination),
            .slice_ptr => self.lower_slice_ptr(node_id, call, destination),
            .dealloc => self.lower_dealloc(node_id, call, destination),
            .destroy => self.lower_destroy(node_id, call, destination),
            .drop => self.lower_drop(node_id, call, destination),
            .forget => self.lower_forget(node_id, call, destination),
            .optional_some => self.lower_optional_some(node_id, call, destination),
            .trait_ref => self.lower_trait_ref(node_id, call, destination),
            .trait_mut_ref => self.lower_trait_mut_ref(node_id, call, destination),
            .trait_new => self.lower_trait_new(node_id, call, destination),
            .trait_vtable => self.lower_trait_vtable(node_id, call, destination),
            .trait_receiver => self.lower_trait_receiver(node_id, call, destination),
        }
    }

    () lower_async_call_task(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        guard self.async_call_frame_layout(node_id, call) is .some(layout) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.async_call_target_def(call) is .some(target_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.base, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.base, target_def);
        guard self.async_call_target_function(target_def, type_args, const_args) is .some(function) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (function.is_external) {
            self.lower_external_async_task(
                node_id, call, target_def, type_args, const_args, layout$.ref(), destination, span
            );
            return;
        }
        guard mir.place_local_id(destination) is .some(task_local) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirTaskStoragePlan storage = self.task_local_storage(
            task_local, .local, self.task_sync_mode(layout$.ref())
        );
        guard self.async_call_resume_function_ref(
                node_id, call, layout$.ref()
            ) is .some(resume_function)
        else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_task_region_start(destination, storage, resume_function, span);
        mir.MirLocalId frame_local = self.add_coroutine_capture_temp(
            layout.frame_type_id, span, task_local, .task_frame
        );
        mir.MirPlace frame_place = self.place_for_local(frame_local);
        self.initialize_structured_task_state(destination, layout$.ref(), task_local, storage, span);
        self.lower_async_call_args_into_frame(call, layout$.ref(), frame_place);
        guard self.async_call_completion_function_ref(
                node_id, call, layout$.ref(), storage.sync
            ) is .some(completion_function)
        else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirStatement[]& initializers = coroutine_task_abi.initialized_task_initializers(
            self.lowerer.output,
            layout$.ref(),
            destination,
            frame_place,
            resume_function,
            completion_function,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.statements.add(initializers[index]);
            index = index + 1;
        }
        self.push_structured_task_frame_domain(
            layout$.ref(), frame_place, storage, span
        );
        self.push_task_execution_domain_initializers(
            layout$.ref(), destination, frame_place, span
        );
        self.lower_task_resume_call(
            destination, resume_function, self.async_start_kind(node_id), span
        );
    }

    () lower_external_async_task(
        self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace task_place,
        token.Span span
    ) {
        guard mir.place_local_id(task_place) is .some(task_local) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirTaskStoragePlan storage = self.task_local_storage(
            task_local, .external, .concurrent
        );
        self.push_task_region_start(task_place, storage, null, span);
        self.initialize_structured_task_state(task_place, layout, task_local, storage, span);
        mir.MirPlace frame_pointer = coroutine_task_abi.task_field_place(
            self.lowerer.output, task_place, layout.task_abi.frame_field
        );
        self.push_assign(
            frame_pointer,
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.null_operand(self.mir_place_type(frame_pointer), span)
            )),
            span
        );
        mir.MirStatement[]& state_initializers = coroutine_task_abi.external_task_state_initializers(
            self.lowerer.output, layout, task_place, span
        );
        Int state_index! = 0;
        while (state_index < state_initializers.length) {
            self.statements.add(state_initializers[state_index]);
            state_index = state_index + 1;
        }
        mir.MirExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(
                layout.task_abi.result_type_id, span
            );
        mir.MirLocalId continuation_local = self.add_coroutine_capture_temp(
            continuation_layout.type_id,
            span,
            task_local,
            .task_external_continuation
        );
        mir.MirPlace continuation_place = self.place_for_local(continuation_local);
        self.initialize_external_task_continuation(
            node_id,
            call,
            layout,
            task_place,
            continuation_layout,
            continuation_place,
            span
        );
        mir.MirLocalId continuation_pointer = self.add_temp(
            continuation_layout.pointer_type_id,
            span
        );
        self.push_assign(
            self.place_for_local(continuation_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length + 1);
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        mir.MirOperand[]& abi_args = self.lowerer.output.operand_array(args$.ref());
        self.lower_external_async_start_call(
            target_def,
            type_args,
            const_args,
            abi_args,
            self.async_start_kind(node_id),
            span
        );
    }

    () initialize_external_task_continuation(
        self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace task_place,
        mir.MirExternalContinuationLayout continuation_layout,
        mir.MirPlace continuation_place,
        token.Span span
    ) {
        mir.MirRvalue context = mir.use_rvalue(mir.MirUseRvalue (
            value: self.operand_for_place(self.project_constant_index(
                task_place, layout.task_abi.handle_pointer_field_index
            ))
        ));
        mir.MirOperand resume = mir.function_operand_value(
            self.async_call_completion_function_ref(
                node_id, call, layout, .concurrent
            )$.some()
        );
        self.initialize_external_async_continuation(
            continuation_layout,
            continuation_place,
            coroutine_task_abi.task_field_place(
                self.lowerer.output, task_place, layout.task_abi.result_field
            ),
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.operand_for_place(coroutine_task_abi.task_field_place(
                    self.lowerer.output,
                    task_place,
                    layout.task_abi.execution_executor_field
                ))
            )),
            context,
            resume,
            span
        );
    }

    () initialize_external_async_continuation(
        self,
        mir.MirExternalContinuationLayout layout,
        mir.MirPlace continuation_place,
        mir.MirPlace result_place,
        mir.MirRvalue executor,
        mir.MirRvalue context,
        mir.MirOperand resume,
        token.Span span
    ) {
        self.push_assign(
            self.project_constant_index(continuation_place, layout.result_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: result_place,
                frame_root: false
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(continuation_place, layout.context_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(continuation_place, layout.resume_field_index),
            mir.scheduled_continuation_resume_rvalue(mir.MirScheduledContinuationResumeRvalue()),
            span
        );
        self.push_assign(
            self.project_constant_index(continuation_place, layout.executor_field_index),
            executor,
            span
        );
        self.push_assign(
            self.project_constant_index(continuation_place, layout.target_context_field_index),
            context,
            span
        );
        self.push_assign(
            self.project_constant_index(continuation_place, layout.target_resume_field_index),
            mir.use_rvalue(mir.MirUseRvalue (value: resume)),
            span
        );
        mir.MirPlace cancellation_context = self.project_constant_index(
            continuation_place, layout.cancellation_context_field_index
        );
        mir.MirRvalue cancellation_value! = mir.use_rvalue(mir.MirUseRvalue (
            value: self.null_operand(self.mir_place_type(cancellation_context), span)
        ));
        if (self.current_effects.has_async) {
            cancellation_value = mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            ));
        }
        self.push_assign(cancellation_context, cancellation_value, span);
    }

    () lower_external_async_start_call(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirOperand[]& args,
        mir.MirAsyncStartKind? async_start,
        token.Span span
    ) {
        qid.TypeId source_type = self.function_type_for_ref(target_def, type_args, const_args);
        mir.MirLocalId unit_result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId next_block = self.reserve_block(span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.direct_function_callee(mir.MirFunctionRef (
                function_def: target_def,
                type_args: self.lowerer.output.type_arg_array(type_args),
                const_args: self.lowerer.output.const_arg_array(const_args),
                coroutine_resume: false,
                coroutine_completion: false,
                type_id: self.lowerer.external_async_abi_function_type(source_type, span),
                span: span
            )),
            args: args,
            current_effects: self.current_effects,
            is_suspend_point: false,
            async_start: async_start,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
    }

    mir.MirFunctionRef? async_call_completion_function_ref(
        self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirTaskSyncMode sync
    ) {
        guard self.async_call_target_def(call) is .some(target_def) else { return null; }
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.base, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.base, target_def);
        return self.task_completion_function_ref(
            target_def,
            type_args,
            const_args,
            layout,
            sync,
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirFunctionRef? async_call_resume_function_ref(
        self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        mir.MirCoroutineFrameLayout& layout
    ) {
        guard self.async_call_target_def(call) is .some(target_def) else {
            return null;
        }
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.base, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.base, target_def);
        return mir.MirFunctionRef (
            function_def: target_def,
            type_args: self.lowerer.output.type_arg_array(type_args),
            const_args: self.lowerer.output.const_arg_array(const_args),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: layout.task_abi.resume_function_type_id,
            span: self.lowerer.hir_span(node_id)
        );
    }

    () lower_await_task_expr(self, hir.HirId value, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(value);
        mir.MirPlace task_place;
        if (self.place_for_expr(value) is .some(place)) {
            task_place = place;
        } else {
            mir.MirLocalId task_local = self.add_temp(self.type_for_node(value), span);
            task_place = self.place_for_local(task_local);
            self.lower_into_place(value, task_place);
        }
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_consume_statement_kind(mir.MirTaskConsumeStatement (
                task: task_place
            ))
        ));
        self.lower_await_task_ready(task_place, span);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue (
            value: mir.move_operand_value(mir.MirMoveOperand (
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, task_state.result
                )
            ))
        )), span);
        self.release_consumed_task(task_place, true, span);
    }

    () lower_cancel_task_expr(self, hir.HirId value, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(value);
        mir.MirPlace task_place;
        if (self.place_for_expr(value) is .some(place)) {
            task_place = place;
        } else {
            mir.MirLocalId task_local = self.add_temp(self.type_for_node(value), span);
            task_place = self.place_for_local(task_local);
            self.lower_into_place(value, task_place);
        }
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_consume_statement_kind(mir.MirTaskConsumeStatement (
                task: task_place
            ))
        ));
        self.request_task_cancellation(task_place, task_state, span);
        self.lower_await_task_ready(task_place, span);
        self.push_assign(destination, self.unit_rvalue(span), span);
        self.release_consumed_task(task_place, false, span);
    }

    () lower_task_cancellation_expr(self, hir.HirId value, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(value);
        guard self.place_for_expr(value) is .some(task_place) else {
            self.mark_unsupported(value);
            return;
        }
        mir.MirPlace task_pointer = coroutine_task_abi.task_handle_pointer_place(
            self.lowerer.output, task_place
        );
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_retain_statement_kind(mir.MirTaskRetainStatement (
                pointer: self.operand_for_place(task_pointer)
            ))
        ));
        mir.MirPlace handle = self.project_constant_index(destination, 0);
        self.push_assign(
            handle,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: self.operand_for_place(task_pointer),
                target_type: self.mir_place_type(handle)
            )),
            span
        );
    }

    () lower_sync_block(
        self,
        hir.HirId node_id,
        hir.HirId async_block,
        mir.MirPlace destination
    ) {
        if (!self.current_effects.has_async) {
            self.lower_await_task_expr(async_block, destination);
            return;
        }
        qid.DefId function_def = async_block.owner_def;
        guard self.lowerer.typeck.lambda_capture_infos(function_def) is .some(captures) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.lowerer.output.function_id_for_def(function_def) is .some(function_id) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirFunction function = self.lowerer.output.function(function_id);
        guard function.coroutine_frame is .some(layout) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.async_block_env_operand(async_block, function_def, captures, null, span));
        self.lower_async_direct_continuation_call(
            function_def,
            self.lowerer.output.empty_type_args(),
            self.lowerer.output.empty_const_args(),
            self.lowerer.output.operand_array(args$.ref()),
            destination,
            function$.ref(),
            layout$.ref(),
            span
        );
    }

    () release_consumed_task(
        self,
        mir.MirPlace task_place,
        Bool result_consumed,
        token.Span span
    ) {
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        mir.MirPlace task_pointer = self.project_constant_index(task_place, 0);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_release_statement_kind(mir.MirTaskReleaseStatement (
                task_pointer: task_pointer,
                frame: coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, task_state.frame
                ),
                state: coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, task_state.state
                ),
                result: coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, task_state.result
                ),
                result_drop: self.task_result_drop_function(task_state, span),
                result_consumed: result_consumed,
                storage: self.task_storage_plan(task_place)
            ))
        ));
        self.push_assign(
            task_pointer,
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.null_operand(self.mir_place_type(task_pointer), span)
            )),
            span
        );
    }

    mir.MirTaskStoragePlan parent_owned_task_storage(
        self,
        mir.MirTaskFrameStorage frame,
        mir.MirTaskSyncMode sync
    ) {
        return mir.MirTaskStoragePlan (
            control: .local,
            frame: frame,
            sync: sync,
            reclaim: .parent
        );
    }

    mir.MirTaskStoragePlan task_local_storage(
        self,
        mir.MirLocalId task_local,
        mir.MirTaskFrameStorage frame,
        mir.MirTaskSyncMode sync
    ) {
        if (!self.task_local_exports_cancellation(task_local)) {
            return self.parent_owned_task_storage(frame, sync);
        }
        return mir.MirTaskStoragePlan (
            control: .heap,
            frame: frame,
            sync: .concurrent,
            reclaim: .parent
        );
    }

    Bool task_local_exports_cancellation(self, mir.MirLocalId task_local) {
        mir.MirLocalDecl local = self.locals.get(task_local.to_index());
        guard local.def_id is .some(def_id) else { return false; }
        guard table.hash_table_get_value<Int, Bool>(
            self.cancellation_task_defs$.ref(), def_id.to_index()
        ) is .some(value) else { return false; }
        return value;
    }

    () collect_cancellation_task_defs(self) {
        Int index! = 0;
        while (index < self.hir_def.nodes.len()) {
            hir.HirNode node = self.hir_def.nodes.get(index);
            if (node.data is .task_cancellation_expr(base)) {
                self.collect_cancellation_task_def(base);
            }
            index = index + 1;
        }
    }

    () collect_cancellation_task_def(self, hir.HirId base) {
        hir.HirNode node = self.lowerer.hirs.node(base);
        guard node.data is .name_ref(name_ref) else { return; }
        guard name_ref is .def_ref(def_id) else { return; }
        self.cancellation_task_defs.set(def_id.to_index(), true);
    }

    mir.MirTaskSyncMode task_sync_mode(self, mir.MirCoroutineFrameLayout& child) {
        if (!self.current_effects.has_async) {
            return .concurrent;
        }
        guard self.current_effects.domain is .some(current_domain) else {
            return .concurrent;
        }
        if (child.effects.domain is .some(_)) {
            if (child.domain_kind != 0) { return .concurrent; }
            if (!types.effect_domain_equal(self.current_effects.domain, child.effects.domain)) {
                return .concurrent;
            }
            return .local_serial;
        }
        if (self.lowerer.domain_kind_for_type(current_domain.domain_type) != 0) {
            return .concurrent;
        }
        return .local_serial;
    }

    () push_task_region_start(
        self,
        mir.MirPlace task_place,
        mir.MirTaskStoragePlan storage,
        mir.MirFunctionRef? child_resume,
        token.Span span
    ) {
        self.set_task_storage_plan(task_place, storage);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_region_start_statement_kind(mir.MirTaskRegionStartStatement (
                task: task_place,
                storage: storage,
                child_resume: child_resume
            ))
        ));
    }

    () set_task_storage_plan(
        self,
        mir.MirPlace task_place,
        mir.MirTaskStoragePlan storage
    ) {
        guard mir.place_local_id(task_place) is .some(task_local) else { return; }
        self.task_storage_plans.set(task_local.to_index(), storage);
    }

    mir.MirTaskStoragePlan task_storage_plan(self, mir.MirPlace task_place) {
        if (mir.place_local_id(task_place) is .some(task_local)) {
            if (table.hash_table_get_value<Int, mir.MirTaskStoragePlan>(
                    self.task_storage_plans$.ref(), task_local.to_index()
                ) is .some(storage)
            ) {
                return storage;
            }
        }
        return mir.MirTaskStoragePlan (
            control: .heap,
            frame: .local,
            sync: .concurrent,
            reclaim: .parent
        );
    }

    mir.MirPlace initialize_local_task_state(
        self,
        mir.MirPlace task_place,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirLocalId task_local,
        token.Span span
    ) {
        mir.MirLocalId state_local = self.add_coroutine_capture_temp(
            layout.task_abi.task_state_type_id, span, task_local, .task_control
        );
        mir.MirPlace state_place = self.place_for_local(state_local);
        mir.MirPlace handle = self.project_constant_index(
            task_place, layout.task_abi.handle_pointer_field_index
        );
        self.push_assign(
            handle,
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: state_place,
                frame_root: false
            )),
            span
        );
        return state_place;
    }

    () initialize_structured_task_state(
        self,
        mir.MirPlace task_place,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirLocalId task_local,
        mir.MirTaskStoragePlan storage,
        token.Span span
    ) {
        if (storage.control == .local) {
            self.initialize_local_task_state(task_place, layout, task_local, span);
            return;
        }
        self.statements.add(coroutine_task_abi.task_state_initializer(
            self.lowerer.output, layout, task_place, span
        ));
    }

    () lower_task_resume_call(
        self,
        mir.MirPlace task_place,
        mir.MirFunctionRef? known_resume,
        mir.MirAsyncStartKind? async_start,
        token.Span span
    ) {
        qid.TypeId task_type = self.mir_place_type(task_place);
        guard self.lowerer.ctx.store.types.get(task_type).data is .task_type(task_info) else {
            return;
        }
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_result(task_info.result);
        mir.MirLocalId resume_return = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirPlace frame_pointer_place = coroutine_task_abi.task_field_place(
            self.lowerer.output, task_place, task_state.frame
        );
        mir.MirPlace resume_function_place = coroutine_task_abi.task_field_place(
            self.lowerer.output, task_place, task_state.resume_function
        );
        mir.MirPlace executor_place = coroutine_task_abi.task_field_place(
            self.lowerer.output, task_place, task_state.execution_executor
        );
        mir.MirPlace task_pointer_place = self.project_constant_index(
            task_place, 0
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(0);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (place: frame_pointer_place)));
        mir.MirBlockId next_block = self.reserve_block(span);
        mir.MirOperand resume_operand = self.operand_for_place(resume_function_place);
        mir.MirCallCallee callee! = mir.dynamic_task_enqueue_callee(
            self.operand_for_place(executor_place),
            self.operand_for_place(task_pointer_place),
            resume_operand,
            false
        );
        mir.MirTaskStoragePlan storage = self.task_storage_plan(task_place);
        if (storage.sync == .local_serial && known_resume is .some(resume_function)) {
            self.initialize_running_local_task(task_place, task_state, executor_place, span);
            callee = mir.direct_function_callee(resume_function);
        }
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            suspend_child: known_resume,
            async_start: async_start,
            destination: self.place_for_local(resume_return),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
    }

    () initialize_running_local_task(
        self,
        mir.MirPlace task_place,
        mir.MirTaskStateLayout task_state,
        mir.MirPlace executor_place,
        token.Span span
    ) {
        self.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.output, task_place, task_state.schedule_state
            ),
            mir.use_rvalue(mir.MirUseRvalue (
                value: mir.const_operand_value(self.int_const(2, span))
            )),
            span
        );
        self.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.output, task_place, task_state.schedule_active_executor
            ),
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.operand_for_place(executor_place)
            )),
            span
        );
    }

    mir.MirAsyncStartKind? async_start_kind(self, hir.HirId node_id) {
        guard self.lowerer.typeck.async_start_usage(node_id) is .some(usage) else { return null; }
        if (usage == typeck_store.AsyncStartUsage.detached) {
            return mir.MirAsyncStartKind.detached;
        }
        return mir.MirAsyncStartKind.observed_task;
    }

    Int domain_kind_for_def(self, qid.DefId domain_def) {
        return self.lowerer.domain_kind_for_def(domain_def);
    }

    mir.MirTaskStateLayout task_state_layout_for_task(self, mir.MirPlace task_place) {
        qid.TypeId task_type = self.mir_place_type(task_place);
        guard self.lowerer.ctx.store.types.get(task_type).data is .task_type(task) else {
            return self.task_state_layout_for_result(self.lowerer.ctx.store.types.invalid_type());
        }
        return self.task_state_layout_for_result(task.result);
    }

    mir.MirTaskStateLayout task_state_layout_for_result(self, qid.TypeId result_type) {
        return self.lowerer.create_task_state_layout(
            self.hir_def.def_id, result_type, token.Span()
        );
    }

    mir.MirFunctionRef task_result_drop_function(
        self,
        mir.MirTaskStateLayout task_state,
        token.Span span
    ) {
        qid.TypeId result_type = task_state.result.type_id;
        qid.DefId drop_def = self.ensure_lambda_env_drop_shim_at_span(
            result_type, false, span
        );
        return mir.MirFunctionRef (
            function_def: drop_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.closure_drop_env_type(span),
            span: span
        );
    }

    () lower_await_task_ready(self, mir.MirPlace task_place, token.Span span) {
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        mir.MirTaskStoragePlan storage = self.task_storage_plan(task_place);
        mir.MirBlockId check_block = self.reserve_block(span);
        mir.MirBlockId ready_block = self.reserve_block(span);
        mir.MirBlockId pending_block = self.reserve_block(span);
        self.finish_block(self.goto_terminator(check_block), span);
        self.start_block(check_block);
        mir.MirPlace state_place = coroutine_task_abi.task_field_place(
            self.lowerer.output, task_place, task_state.state
        );
        mir.MirLocalId state_local = self.add_temp(self.mir_place_type(state_place), span);
        mir.MirRvalue state_value! = mir.use_rvalue(mir.MirUseRvalue (
            value: self.operand_for_place(state_place)
        ));
        if (storage.sync == .concurrent) {
            state_value = mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: state_place,
                mode: .coroutine_atomic
            ));
        }
        self.push_assign(
            self.place_for_local(state_local),
            state_value,
            span
        );
        mir.MirOperand state_operand = self.operand_for_place(self.place_for_local(state_local));
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(2);
        cases.add(mir.MirSwitchCase (value: self.int_const(1, span), target: ready_block));
        cases.add(mir.MirSwitchCase (value: self.int_const(3, span), target: ready_block));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: state_operand,
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: pending_block
        )), span);
        self.start_block(pending_block);
        if (self.current_effects.has_async) {
            if (storage.sync == .local_serial) {
                self.lower_serial_task_waiter_registration(
                    task_place, state_place, ready_block, check_block, span
                );
                return;
            }
            self.lower_atomic_task_waiter_registration(task_place, ready_block, check_block, span);
            return;
        }
        self.lower_blocking_task_waiter_registration(
            task_place, state_place, ready_block, check_block, span
        );
    }

    () lower_atomic_task_waiter_registration(
        self,
        mir.MirPlace task_place,
        mir.MirBlockId ready_block,
        mir.MirBlockId check_block,
        token.Span span
    ) {
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        guard mir.place_local_id(task_place) is .some(task_local) else { return; }
        mir.MirLocalId waiter_word = self.initialize_task_waiter(
            task_place, task_local, span
        );
        mir.MirLocalId registered = self.add_temp(
            self.lowerer.ctx.store.types.bool_type(), span
        );
        self.push_assign(
            self.place_for_local(registered),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, task_state.state
                ),
                expected: mir.const_operand_value(self.int_const(0, span)),
                desired: self.operand_for_place(self.place_for_local(waiter_word)),
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId suspend_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(registered)),
            then_target: suspend_block,
            else_target: check_block
        )), span);
        self.start_block(suspend_block);
        self.finish_block(mir.suspend_pending_terminator_kind(mir.MirSuspendPendingTerminator (
            target: check_block,
            suspend_wake: .task_child,
            task_local: task_local
        )), span);
        self.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    () lower_serial_task_waiter_registration(
        self,
        mir.MirPlace task_place,
        mir.MirPlace state_place,
        mir.MirBlockId ready_block,
        mir.MirBlockId check_block,
        token.Span span
    ) {
        guard mir.place_local_id(task_place) is .some(task_local) else { return; }
        mir.MirLocalId waiter_word = self.initialize_task_waiter(
            task_place, task_local, span
        );
        self.push_assign(
            state_place,
            mir.use_rvalue(mir.MirUseRvalue (
                value: self.operand_for_place(self.place_for_local(waiter_word))
            )),
            span
        );
        self.finish_block(mir.suspend_pending_terminator_kind(mir.MirSuspendPendingTerminator (
            target: check_block,
            suspend_wake: .task_child,
            task_local: task_local
        )), span);
        self.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    mir.MirLocalId initialize_task_waiter(
        self,
        mir.MirPlace task_place,
        mir.MirLocalId task_local,
        token.Span span
    ) {
        mir.MirTaskWaiterLayout waiter_layout = self.lowerer.task_waiter_layout(span);
        mir.MirLocalId waiter_local = self.add_coroutine_capture_temp(
            waiter_layout.type_id, span, task_local, .task_waiter
        );
        mir.MirPlace waiter = self.place_for_local(waiter_local);
        self.register_current_task_cancel_child(task_place, span);
        self.push_assign(
            self.project_constant_index(waiter, waiter_layout.context_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(waiter, waiter_layout.resume_field_index),
            mir.use_rvalue(mir.MirUseRvalue (
                value: mir.function_operand_value(mir.MirFunctionRef (
                    function_def: self.hir_def.def_id,
                    type_args: self.lowerer.output.type_arg_array(self.function_type_args),
                    const_args: self.lowerer.output.const_arg_array(self.function_const_args),
                    coroutine_resume: true,
                    coroutine_completion: false,
                    type_id: self.mir_place_type(
                        self.project_constant_index(waiter, waiter_layout.resume_field_index)
                    ),
                    span: span
                ))
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(waiter, waiter_layout.executor_field_index),
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            span
        );
        self.push_assign(
            self.project_constant_index(waiter, waiter_layout.task_field_index),
            mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        mir.MirLocalId waiter_pointer = self.add_temp(waiter_layout.pointer_type_id, span);
        self.push_assign(
            self.place_for_local(waiter_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: waiter,
                frame_root: false
            )),
            span
        );
        mir.MirLocalId waiter_word = self.add_temp(self.lowerer.ctx.store.types.int_type(), span);
        self.push_assign(
            self.place_for_local(waiter_word),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(waiter_pointer)),
                target_type: self.lowerer.ctx.store.types.int_type()
            )),
            span
        );
        return waiter_word;
    }

    () lower_blocking_task_waiter_registration(
        self,
        mir.MirPlace task_place,
        mir.MirPlace state_place,
        mir.MirBlockId ready_block,
        mir.MirBlockId check_block,
        token.Span span
    ) {
        qid.TypeId int_type = self.lowerer.ctx.store.types.int_type();
        mir.MirLocalId acknowledged = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(acknowledged),
            mir.use_rvalue(mir.MirUseRvalue (
                value: mir.const_operand_value(self.int_const(0, span))
            )),
            span
        );
        qid.TypeId ack_pointer_type = self.lowerer.ctx.store.types.raw_pointer_type(int_type, span);
        mir.MirLocalId ack_pointer = self.add_temp(ack_pointer_type, span);
        self.push_assign(
            self.place_for_local(ack_pointer),
            mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: true,
                place: self.place_for_local(acknowledged)
            )),
            span
        );
        mir.MirLocalId ack_word = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(ack_word),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(ack_pointer)),
                target_type: int_type
            )),
            span
        );
        mir.MirLocalId tagged_word = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(tagged_word),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.bit_or,
                lhs: self.operand_for_place(self.place_for_local(ack_word)),
                rhs: mir.const_operand_value(self.int_const(1, span))
            )),
            span
        );
        mir.MirLocalId registered = self.add_temp(
            self.lowerer.ctx.store.types.bool_type(), span
        );
        self.push_assign(
            self.place_for_local(registered),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: state_place,
                expected: mir.const_operand_value(self.int_const(0, span)),
                desired: self.operand_for_place(self.place_for_local(tagged_word)),
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId wait_block = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(registered)),
            then_target: wait_block,
            else_target: check_block
        )), span);
        self.start_block(wait_block);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_wait_statement_kind(mir.MirTaskWaitStatement (
                state: state_place,
                wake: false,
                expected: self.operand_for_place(self.place_for_local(tagged_word))
            ))
        ));
        mir.MirBlockId ack_check = self.reserve_block(span);
        self.finish_block(self.goto_terminator(ack_check), span);
        self.start_block(ack_check);
        mir.MirLocalId ack_state = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(ack_state),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: self.place_for_local(acknowledged),
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<mir.MirSwitchCase> ack_cases! = list.ArrayList<mir.MirSwitchCase>(1);
        ack_cases.add(mir.MirSwitchCase (
            value: self.int_const(1, span),
            target: check_block
        ));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(ack_state)),
            cases: self.lowerer.output.switch_case_array(ack_cases$.ref()),
            default_target: ack_check
        )), span);
        self.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    () request_task_cancellation(
        self,
        mir.MirPlace task_place,
        mir.MirTaskStateLayout task_state,
        token.Span span
    ) {
        mir.MirPlace state_pointer = coroutine_task_abi.task_handle_pointer_place(
            self.lowerer.output, task_place
        );
        self.request_task_cancellation_pointer(state_pointer, task_state, span);
    }

    () request_task_cancellation_pointer(
        self,
        mir.MirPlace state_pointer,
        mir.MirTaskStateLayout task_state,
        token.Span span
    ) {
        mir.MirLocalId pointer_local = self.add_temp(self.mir_place_type(state_pointer), span);
        self.push_assign(
            self.place_for_local(pointer_local),
            mir.use_rvalue(mir.MirUseRvalue (value: self.operand_for_place(state_pointer))),
            span
        );
        mir.MirPlace state = self.project_deref(self.place_for_local(pointer_local), true);
        mir.MirPlace request = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, state, task_state.cancellation_requested
        );
        self.push_atomic_store(
            request, mir.const_operand_value(self.int_const(1, span)), span
        );
        mir.MirPlace target = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, state, task_state.cancel_target_word
        );
        mir.MirLocalId observed = self.add_temp(self.mir_place_type(target), span);
        self.push_assign(
            self.place_for_local(observed),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: target,
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId enqueue = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(1);
        cases.add(mir.MirSwitchCase (value: self.int_const(3, span), target: complete));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: enqueue
        )), span);
        self.start_block(enqueue);
        self.enqueue_task_cancellation(
            state, self.place_for_local(pointer_local), task_state, span
        );
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () enqueue_task_cancellation(
        self,
        mir.MirPlace state,
        mir.MirPlace task_pointer,
        mir.MirTaskStateLayout task_state,
        token.Span span
    ) {
        mir.MirPlace executor = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, state, task_state.execution_executor
        );
        mir.MirPlace frame = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, state, task_state.frame
        );
        mir.MirPlace resume = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, state, task_state.resume_function
        );
        mir.MirLocalId observed_executor = self.add_temp(self.mir_place_type(executor), span);
        self.push_assign(
            self.place_for_local(observed_executor),
            mir.use_rvalue(mir.MirUseRvalue (value: self.operand_for_place(executor))),
            span
        );
        mir.MirBlockId enqueue = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(observed_executor), enqueue, complete, span
        );
        self.start_block(enqueue);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.operand_for_place(frame));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.dynamic_task_enqueue_callee(
                self.operand_for_place(self.place_for_local(observed_executor)),
                self.operand_for_place(task_pointer),
                self.operand_for_place(resume),
                false
            ),
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(complete);
    }

    () register_current_task_cancel_child(
        self,
        mir.MirPlace child_task,
        token.Span span
    ) {
        mir.MirBlockId register = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        mir.MirTaskStateLayout parent_state = self.current_task_state_layout();
        mir.MirPlace parent_pointer = self.current_task_cancellation_state_pointer(
            parent_state, span
        );
        self.branch_on_non_null_pointer(parent_pointer, register, complete, span);
        self.start_block(register);
        mir.MirPlace parent_value = self.project_deref(parent_pointer, true);
        mir.MirPlace target_word = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, parent_value, parent_state.cancel_target_word
        );
        mir.MirPlace child_word = self.task_cancel_target_word(child_task, target_word, span);
        self.push_atomic_store(
            target_word,
            self.operand_for_place(child_word),
            span
        );
        mir.MirPlace parent_request = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, parent_value, parent_state.cancellation_requested
        );
        mir.MirLocalId request = self.add_temp(self.mir_place_type(parent_request), span);
        self.push_assign(
            self.place_for_local(request),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: parent_request,
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId propagate = self.reserve_block(span);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(1);
        cases.add(mir.MirSwitchCase (value: self.int_const(1, span), target: propagate));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(request)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.start_block(propagate);
        self.request_task_cancellation(
            child_task, self.task_state_layout_for_task(child_task), span
        );
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () clear_current_task_cancel_child(
        self,
        mir.MirPlace child_task,
        token.Span span
    ) {
        if (!self.current_effects.has_async) { return; }
        mir.MirBlockId prepare = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        mir.MirTaskStateLayout state = self.current_task_state_layout();
        mir.MirPlace pointer = self.current_task_cancellation_state_pointer(state, span);
        self.branch_on_non_null_pointer(pointer, prepare, complete, span);
        self.start_block(prepare);
        mir.MirPlace parent = self.project_deref(pointer, true);
        mir.MirPlace target_word = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, parent, state.cancel_target_word
        );
        mir.MirPlace child_word = self.task_cancel_target_word(child_task, target_word, span);
        mir.MirLocalId cleared = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(cleared),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: target_word,
                expected: self.operand_for_place(child_word),
                desired: mir.const_operand_value(self.int_const(0, span)),
                mode: .coroutine_atomic
            )),
            span
        );
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    mir.MirPlace task_cancel_target_word(
        self,
        mir.MirPlace task,
        mir.MirPlace target_word,
        token.Span span
    ) {
        mir.MirLocalId encoded = self.add_temp(self.mir_place_type(target_word), span);
        self.push_assign(
            self.place_for_local(encoded),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: self.operand_for_place(coroutine_task_abi.task_handle_pointer_place(
                    self.lowerer.output, task
                )),
                target_type: self.mir_place_type(target_word)
            )),
            span
        );
        return self.place_for_local(encoded);
    }

    mir.MirTaskStateLayout current_task_state_layout(self) {
        qid.TypeId result = self.mir_place_type(self.place_for_local(self.return_local()));
        return self.task_state_layout_for_result(result);
    }

    mir.MirPlace current_task_cancellation_state_pointer(
        self,
        mir.MirTaskStateLayout state,
        token.Span span
    ) {
        qid.TypeId pointer_type = self.lowerer.ctx.store.types.raw_pointer_type(state.type_id, span);
        mir.MirLocalId pointer = self.add_temp(pointer_type, span);
        self.push_assign(
            self.place_for_local(pointer),
            mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        return self.place_for_local(pointer);
    }

    () branch_on_non_null_pointer(
        self,
        mir.MirPlace pointer,
        mir.MirBlockId present,
        mir.MirBlockId absent,
        token.Span span
    ) {
        mir.MirLocalId is_present = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(is_present),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.ne,
                lhs: self.operand_for_place(pointer),
                rhs: self.null_operand(self.mir_place_type(pointer), span)
            )),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(is_present)),
            then_target: present,
            else_target: absent
        )), span);
    }

    () push_atomic_store(self, mir.MirPlace destination, mir.MirOperand value, token.Span span) {
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.atomic_store_statement_kind(mir.MirAtomicStoreStatement (
                destination: destination,
                value: value,
                mode: .coroutine_atomic
            ))
        ));
    }

    () lower_async_call_args_into_frame(
        self,
        hir.HirImplicitCall call,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_place
    ) {
        Int index! = 0;
        while (index < call.args.length) {
            mir.MirLocalId param_local = mir.MirLocalId.from_index(index + 1);
            if (self.async_call_frame_field_place(layout, frame_place, param_local) is .some(param_place)) {
                self.lower_into_place_as_type(call.args[index], param_place, self.mir_place_type(param_place));
            }
            index = index + 1;
        }
    }

    mir.MirPlace? async_call_frame_field_place(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_place,
        mir.MirLocalId local_id
    ) {
        Int index! = 0;
        while (index < layout.local_mappings.length) {
            mir.MirCoroutineLocalFrameField mapping = layout.local_mappings[index];
            if (mapping.local_id.to_index() == local_id.to_index()) {
                return self.project_frame_field(frame_place, layout, mapping.field_index);
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirPlace project_frame_field(
        self,
        mir.MirPlace frame_place,
        mir.MirCoroutineFrameLayout& layout,
        Int field_index
    ) {
        list.ArrayList<mir.MirPlaceElem> projection! =
            list.ArrayList<mir.MirPlaceElem>(frame_place.projection.length + 1);
        Int index! = 0;
        while (index < frame_place.projection.length) {
            projection.add(frame_place.projection[index]);
            index = index + 1;
        }
        projection.add(mir.frame_field_projection_elem(mir.MirFrameFieldProjection (
            field_index: field_index,
            field_type: layout.fields[field_index].type_id
        )));
        return mir.local_place(frame_place.local_id, self.lowerer.output.projection_array(projection$.ref()));
    }

    mir.MirCoroutineFrameLayout? async_call_frame_layout(self, hir.HirId node_id, hir.HirImplicitCall call) {
        guard self.async_call_target_def(call) is .some(target_def) else {
            return null;
        }
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.base, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.base, target_def);
        self.ensure_async_call_target(target_def, type_args, const_args);
        guard self.async_call_target_function(target_def, type_args, const_args) is .some(function) else {
            return null;
        }
        return function.coroutine_frame;
    }

    qid.DefId? async_call_target_def(self, hir.HirImplicitCall call) {
        if (self.lowerer.typeck.member_selection(call.base) is .some(selected_def)) {
            return selected_def;
        }
        hir.HirNode base = self.lowerer.hirs.node(call.base);
        if (base.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            return def_id;
        }
        return null;
    }

    () ensure_async_call_target(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (self.lowerer.function_is_lowering(target_def, type_args, const_args)) { return; }
        if (type_args.length > 0 || const_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(target_def, type_args, const_args);
            return;
        }
        guard self.lowerer.hirs.def(target_def) is .some(hir_def) else {
            self.lowerer.ensure_external_function(target_def);
            return;
        }
        if (self.lowerer.hirs.has_body(target_def)) {
            self.lowerer.lower_function(hir_def);
            return;
        }
        self.lowerer.ensure_external_function(target_def);
    }

    mir.MirFunction? async_call_target_function(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.length > 0 || const_args.length > 0) {
            guard self.lowerer.output.function_id_for_instance(target_def, type_args, const_args) is .some(id) else {
                return null;
            }
            return self.lowerer.output.function(id);
        }
        guard self.lowerer.output.function_id_for_def(target_def) is .some(id) else {
            return null;
        }
        return self.lowerer.output.function(id);
    }

    () lower_alloc(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length > 1) {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        self.push_assign(
            destination,
            mir.alloc_array_rvalue(mir.MirAllocArrayRvalue (
                element_type: self.type_for_node(call.base),
                count: self.alloc_count_operand(call, span)
            )),
            span
        );
    }

    mir.MirOperand alloc_count_operand(self, hir.HirImplicitCall call, token.Span span) {
        if (call.args.length == 1) {
            return self.lower_to_operand(call.args[0]);
        }
        // `T$.alloc()` is the single-element shorthand for `T$.alloc(1)`.
        return self.int_operand(1, span);
    }

    () lower_type_info_value(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        mir.MirPlace destination,
        lower_support.TypeInfoValueKind kind
    ) {
        qid.TypeId type_id = self.type_for_node(call.base);
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, type_id);
        layout.TypeLayout type_layout = self.lowerer.ctx.store.layouts.layout(layout_id);
        Int value! = self.lowerer.ctx.store.layouts.target.aggregate_align;
        if (kind == .size) {
            value = type_layout.size;
        } else if (kind == .align) {
            value = type_layout.align;
        }
        self.push_assign(destination, self.int_rvalue(node_id, value), self.lowerer.hir_span(node_id));
    }

    () lower_pointer_get(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.pointer_deref_place(call.base) is .some(source) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (value: mir.copy_operand_value(mir.MirCopyOperand (place: source)))),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_pointer_set(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.pointer_deref_place(call.base) is .some(target) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_into_place(call.args[0], target);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_move(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.place_for_expr(call.base) is .some(source) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (source.projection.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (value: mir.move_operand_value(mir.MirMoveOperand (place: source)))),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_borrow_ref(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination, Bool raw_pointer) {
        guard self.place_for_expr(call.base) is .some(base_source) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirPlace source! = base_source;
        if (!raw_pointer) {
            if (self.reference_to_owner_borrow_source(source, destination) is .some(owner_source)) {
                source = owner_source;
            }
        }
        if (raw_pointer && self.address_of_should_deref_reference(source, destination)) {
            source = self.project_deref(source, false);
        }
        if (!raw_pointer && self.borrow_ref_should_copy_trait_object_handle(source, destination)) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (value: mir.copy_operand_value(mir.MirCopyOperand (place: source)))),
                self.lowerer.hir_span(node_id)
            );
            return;
        }
        if (!raw_pointer && self.borrow_ref_should_slice_owned_value(source, destination)) {
            self.push_assign(
                destination,
                mir.slice_rvalue(mir.MirSliceRvalue (base: source, start: null, end: null)),
                self.lowerer.hir_span(node_id)
            );
            return;
        }
        Bool borrow_pointee! = false;
        if (!raw_pointer && self.borrow_ref_should_deref_owner(source, destination)) {
            borrow_pointee = true;
        }
        mir.MirRvalue value! = mir.borrow_rvalue(mir.MirBorrowRvalue (place: source));
        if (borrow_pointee) {
            mir.MirPlace borrow_source = self.project_deref(source, false);
            value = mir.borrow_rvalue(mir.MirBorrowRvalue (place: borrow_source));
        }
        if (raw_pointer) {
            value = mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: true,
                place: source
            ));
        }
        self.push_assign(destination, value, self.lowerer.hir_span(node_id));
    }

    Bool address_of_should_deref_reference(self, mir.MirPlace source, mir.MirPlace destination) {
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(self.mir_place_type(source));
        types.TypeInfo destination_info = self.lowerer.ctx.store.types.get(self.mir_place_type(destination));
        guard source_info.data is .handle_type(source_handle) else { return false; }
        guard destination_info.data is .handle_type(destination_handle) else { return false; }
        if (source_handle.kind != .reference || destination_handle.kind != .raw_pointer) {
            return false;
        }
        return self.lowerer.ctx.store.types.same_type(source_handle.element, destination_handle.element);
    }

    mir.MirPlace? reference_to_owner_borrow_source(self, mir.MirPlace source, mir.MirPlace destination) {
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(self.mir_place_type(source));
        types.TypeInfo destination_info = self.lowerer.ctx.store.types.get(self.mir_place_type(destination));
        guard source_info.data is .handle_type(source_handle) else { return null; }
        guard destination_info.data is .handle_type(destination_handle) else { return null; }
        if (source_handle.kind != .reference || destination_handle.kind != .reference) { return null; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(source_handle.element);
        guard element_info.data is .handle_type(owner_handle) else { return null; }
        if (owner_handle.kind != .owner_pointer) { return null; }
        if (!self.lowerer.ctx.store.types.same_type(owner_handle.element, destination_handle.element)) { return null; }
        return self.project_deref(source, false);
    }

    Bool borrow_ref_should_slice_owned_value(self, mir.MirPlace source, mir.MirPlace destination) {
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(self.mir_place_type(source));
        types.TypeInfo destination_info = self.lowerer.ctx.store.types.get(self.mir_place_type(destination));
        guard source_info.data is .handle_type(source_handle) else { return false; }
        guard destination_info.data is .handle_type(destination_handle) else { return false; }
        if (source_handle.kind != .owner_pointer || destination_handle.kind != .slice) {
            return false;
        }
        return self.slice_borrow_matches_owner_pointee(source_handle.element, destination_handle);
    }

    // Owned slice values store `{ data, length }`, so borrowing them as `T[]&`
    // is the same MIR operation as taking an open slice view over that value.
    Bool slice_borrow_matches_owner_pointee(self, qid.TypeId pointee, types.HandleType destination_handle) {
        types.TypeInfo pointee_info = self.lowerer.ctx.store.types.get(pointee);
        guard pointee_info.data is .slice_value_type(slice_value) else { return false; }
        if (!types.sentinel_equal(slice_value.sentinel, destination_handle.sentinel)) { return false; }
        return self.lowerer.ctx.store.types.same_type(slice_value.element, destination_handle.element);
    }

    Bool borrow_ref_should_deref_owner(self, mir.MirPlace source, mir.MirPlace destination) {
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(self.mir_place_type(source));
        types.TypeInfo destination_info = self.lowerer.ctx.store.types.get(self.mir_place_type(destination));
        guard source_info.data is .handle_type(source_handle) else { return false; }
        guard destination_info.data is .handle_type(destination_handle) else { return false; }
        if (source_handle.kind != .owner_pointer || destination_handle.kind != .reference) {
            return false;
        }
        return self.lowerer.ctx.store.types.same_type(source_handle.element, destination_handle.element);
    }

    Bool borrow_ref_should_copy_trait_object_handle(self, mir.MirPlace source, mir.MirPlace destination) {
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(self.mir_place_type(source));
        types.TypeInfo destination_info = self.lowerer.ctx.store.types.get(self.mir_place_type(destination));
        guard source_info.data is .handle_type(source_handle) else { return false; }
        guard destination_info.data is .handle_type(destination_handle) else { return false; }
        if (source_handle.kind != .owner_pointer || destination_handle.kind != .reference) {
            return false;
        }
        if (!self.handle_is_trait_object(source_handle) || !self.handle_is_trait_object(destination_handle)) {
            return false;
        }
        return self.lowerer.ctx.store.types.same_type(source_handle.element, destination_handle.element);
    }

    () lower_cast(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.base);
        qid.TypeId target_type = self.type_for_node(node_id);
        if (self.cast_is_slice_to_slice(source_type, target_type)) {
            self.lower_slice_layout_cast(node_id, call, destination);
            return;
        }
        if (self.cast_is_slice_to_owned_slice_value(source_type, target_type)) {
            self.lower_slice_layout_cast(node_id, call, destination);
            return;
        }
        if (self.cast_is_slice_to_pointer_handle(source_type, target_type)) {
            self.lower_slice_data_cast(node_id, call, source_type, target_type, destination);
            return;
        }
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.base),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool cast_is_slice_to_slice(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.store.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.store.types.get(target_type);
        guard source.data is .handle_type(source_handle) else { return false; }
        guard target.data is .handle_type(target_handle) else { return false; }
        return source_handle.kind == .slice && target_handle.kind == .slice;
    }

    Bool cast_is_slice_to_owned_slice_value(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.store.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.store.types.get(target_type);
        guard source.data is .handle_type(source_handle) else { return false; }
        guard target.data is .handle_type(target_handle) else { return false; }
        if (source_handle.kind != .slice) { return false; }
        return self.handle_is_owned_slice_value(target_handle);
    }

    Bool cast_is_slice_to_pointer_handle(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.store.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.store.types.get(target_type);
        guard source.data is .handle_type(source_handle) else { return false; }
        guard target.data is .handle_type(target_handle) else { return false; }
        return source_handle.kind == .slice && target_handle.kind != .slice;
    }

    () lower_slice_layout_cast(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        // Sentinel slice 和 plain slice 的 layout 都是 `{ data, length }`。
        // 显式 cast 只改变类型语义，不能把整个 slice 聚合误当成 data 指针。
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (value: self.lower_to_operand(call.base))),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_slice_data_cast(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        qid.TypeId source_type,
        qid.TypeId target_type,
        mir.MirPlace destination
    ) {
        // slice 的 layout 是 `{ data, length }`。MIR 在这里显式投影 data
        // 字段，backend 后续只需要处理普通 field projection 和 ptr cast。
        mir.MirPlace data_place = self.slice_data_place(node_id, call.base, source_type);
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: data_place)),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirPlace slice_data_place(self, hir.HirId node_id, hir.HirId base, qid.TypeId source_type) {
        if (self.place_for_expr(base) is .some(place)) {
            return self.project_constant_index(place, 0);
        }
        mir.MirLocalId temp = self.add_temp(source_type, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.lower_into_place(base, temp_place);
        return self.project_constant_index(temp_place, 0);
    }

    () lower_slice_ptr(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        qid.TypeId source_type = self.type_for_node(call.base);
        qid.TypeId target_type = self.type_for_node(node_id);
        // `array[..]$.ptr()` only needs the array data address; constructing
        // the intermediate slice would compute and store a length that ptr()
        // immediately discards.
        if (self.full_array_slice_base_place(call.base) is .some(array_place)) {
            self.lower_array_place_ptr(node_id, array_place, target_type, destination);
            return;
        }
        if (self.ptr_receiver_is_existing_pointer(source_type)) {
            self.lower_existing_pointer_ptr(node_id, call.base, source_type, target_type, destination);
            return;
        }
        if (self.type_is_array_value(source_type)) {
            guard self.place_for_expr(call.base) is .some(array_place) else {
                self.mark_unsupported(node_id);
                return;
            }
            self.lower_array_place_ptr(node_id, array_place, target_type, destination);
            return;
        }
        if (!self.ptr_receiver_is_slice(source_type)) {
            self.lower_place_ptr(node_id, call.base, target_type, destination);
            return;
        }
        mir.MirPlace data_place = self.slice_data_place(node_id, call.base, source_type);
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: data_place)),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    Bool ptr_receiver_is_existing_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .raw_pointer;
    }

    Bool ptr_receiver_is_slice(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .slice;
    }

    () lower_existing_pointer_ptr(self,
        hir.HirId node_id,
        hir.HirId base_id,
        qid.TypeId source_type,
        qid.TypeId target_type,
        mir.MirPlace destination
    ) {
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: self.copy_handle_operand(base_id, source_type),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand copy_handle_operand(self, hir.HirId base_id, qid.TypeId source_type) {
        if (self.place_for_expr(base_id) is .some(place)) {
            return mir.copy_operand_value(mir.MirCopyOperand (place: place));
        }
        mir.MirLocalId temp = self.add_temp(source_type, self.lowerer.hir_span(base_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.lower_into_place(base_id, temp_place);
        return mir.copy_operand_value(mir.MirCopyOperand (place: temp_place));
    }

    () lower_place_ptr(self,
        hir.HirId node_id,
        hir.HirId base_id,
        qid.TypeId target_type,
        mir.MirPlace destination
    ) {
        guard self.place_for_expr(base_id) is .some(place) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_array_place_ptr(node_id, place, target_type, destination);
    }

    mir.MirPlace? full_array_slice_base_place(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .slice_access(slice_access) else { return null; }
        if (slice_access.start != null || slice_access.end != null) { return null; }
        qid.TypeId base_type = self.type_for_node(slice_access.base);
        if (!self.type_is_array_value(base_type) && !self.type_is_reference_to_array(base_type)) {
            return null;
        }
        return self.slice_base_place(slice_access.base);
    }

    Bool type_is_array_value(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        return info.data is .array_type(_);
    }

    () lower_array_place_ptr(self,
        hir.HirId node_id,
        mir.MirPlace array_place,
        qid.TypeId target_type,
        mir.MirPlace destination
    ) {
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: self.array_address_temp(node_id, array_place))),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirPlace array_address_temp(self, hir.HirId node_id, mir.MirPlace array_place) {
        qid.TypeId pointer_type = self.lowerer.ctx.store.types.raw_pointer_type(
            self.mir_place_type(array_place),
            self.lowerer.hir_span(node_id)
        );
        mir.MirLocalId temp = self.add_temp(pointer_type, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: false,
                place: array_place
            )),
            self.lowerer.hir_span(node_id)
        );
        return temp_place;
    }

    () lower_dealloc(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            mir.free_rvalue(mir.MirFreeRvalue (pointer: self.dealloc_pointer_operand(node_id, call))),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_destroy(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.pointer_deref_place(call.base) is .some(place) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId continuation = self.reserve_block(span);
        self.finish_block(
            mir.drop_terminator_kind(mir.MirDropTerminator (
                place: place,
                target: continuation,
                cleanup: null
            )),
            span
        );
        self.start_block(continuation);
        self.push_assign(destination, self.unit_rvalue(span), span);
    }

    () lower_drop(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.place_for_expr(call.base) is .some(place) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (place.projection.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirBlockId continuation = self.reserve_block(span);
        self.finish_block(
            mir.drop_terminator_kind(mir.MirDropTerminator (
                place: place,
                target: continuation,
                cleanup: null
            )),
            span
        );
        self.start_block(continuation);
        self.push_assign(destination, self.unit_rvalue(span), span);
    }

    () lower_forget(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_forget_statement(node_id, call);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () push_forget_statement(self, hir.HirId node_id, hir.HirImplicitCall call) {
        guard self.place_for_expr(call.base) is .some(place) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_forget_place(node_id, place);
    }

    () push_forget_place(self, hir.HirId node_id, mir.MirPlace place) {
        if (place.projection.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.statements.add(mir.MirStatement (
            span: self.lowerer.hir_span(node_id),
            kind: mir.forget_statement_kind(mir.MirForgetStatement (place: place))
        ));
    }

    mir.MirOperand dealloc_pointer_operand(self, hir.HirId node_id, hir.HirImplicitCall call) {
        if (!call.optional_chain) {
            return self.lower_to_operand(call.base);
        }
        if (self.type_is_handle(self.type_for_node(call.base))) {
            return self.lower_to_operand(call.base);
        }
        mir.MirLocalId temp = self.add_temp(self.optional_element_type(call.base), self.lowerer.hir_span(node_id));
        self.push_assign(
            self.place_for_local(temp),
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.unwrap_some,
                value: self.lower_to_operand(call.base)
            )),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(temp)));
    }

    qid.TypeId optional_element_type(self, hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        return type_id;
    }

    Bool type_is_handle(self, qid.TypeId type_id) {
        return self.lowerer.ctx.store.types.get(type_id).data is .handle_type(_);
    }

    () lower_optional_some(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        self.push_assign(
            destination,
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.unwrap_some,
                value: self.lower_to_operand(call.base)
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_trait_receiver(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_trait_receiver_value(call.args[0], destination, self.lowerer.hir_span(node_id));
    }

    () lower_trait_vtable(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.trait_companion_for_type(self.type_for_node(node_id)) is .some(companion) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_vtable_subject_type(call) is .some(subject_type) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.ensure_trait_vtable_global(node_id, companion.trait_def, subject_type) is .some(global_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        self.push_assign(
            destination,
            mir.use_rvalue(mir.MirUseRvalue (
                value: mir.global_address_operand_value(mir.MirGlobalRef (
                    global_def: global_def,
                    type_id: self.type_for_node(node_id),
                    is_external: false,
                    span: span
                ))
            )),
            span
        );
    }

    () lower_trait_ref(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_object_companion_for_type(self.type_for_node(node_id)) is .some(companion) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId subject_type = self.trait_ref_subject_type(self.type_for_node(call.args[0]));
        guard self.ensure_trait_vtable_global(node_id, companion.trait_def, subject_type) is .some(global_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_trait_object_assign(node_id, destination, companion.trait_def, global_def, call.args[0], span);
    }

    () lower_trait_mut_ref(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_object_companion_for_type(self.type_for_node(node_id)) is .some(companion) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId subject_type = self.trait_ref_subject_type(self.type_for_node(call.args[0]));
        guard self.ensure_trait_vtable_global(node_id, companion.trait_def, subject_type) is .some(global_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirPlace reference = self.mutable_trait_reference_place(call.args[0], span);
        self.push_trait_object_assign_from_reference(
            node_id,
            destination,
            companion.trait_def,
            global_def,
            reference,
            span
        );
    }

    mir.MirPlace mutable_trait_reference_place(self, hir.HirId value_id, token.Span span) {
        qid.TypeId value_type = self.type_for_node(value_id);
        if (self.type_is_reference(value_type)) {
            mir.MirLocalId copied = self.add_temp(value_type, span);
            mir.MirPlace copied_place = self.place_for_local(copied);
            self.push_assign(
                copied_place,
                mir.use_rvalue(mir.MirUseRvalue(value: self.lower_to_operand(value_id))),
                span
            );
            return copied_place;
        }
        mir.MirPlace source = self.receiver_source_place(value_id, span);
        qid.TypeId reference_type = self.lowerer.ctx.store.types.reference_type(value_type, span);
        qid.TypeId mutable_reference = self.lowerer.ctx.store.types.mutable_type(reference_type, span);
        mir.MirLocalId borrowed = self.add_temp(mutable_reference, span);
        mir.MirPlace borrowed_place = self.place_for_local(borrowed);
        self.push_assign(borrowed_place, mir.borrow_rvalue(mir.MirBorrowRvalue(place: source)), span);
        return borrowed_place;
    }

    () lower_trait_new(self, hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_object_companion_for_type(self.type_for_node(node_id)) is .some(companion) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId subject_type = self.type_for_node(call.args[0]);
        guard self.ensure_trait_vtable_global(node_id, companion.trait_def, subject_type) is .some(global_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirLocalId owned_local = self.add_temp(
            self.lowerer.ctx.store.types.owner_pointer_type(subject_type, span),
            span
        );
        mir.MirPlace owned_place = self.place_for_local(owned_local);
        self.push_assign(
            owned_place,
            mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: subject_type)),
            span
        );
        self.lower_into_place(call.args[0], self.project_deref(owned_place, false));
        self.push_trait_object_owned_assign(node_id, destination, companion.trait_def, global_def, owned_place, span);
    }

    () push_trait_object_assign(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.DefId trait_def,
        qid.DefId global_def,
        hir.HirId value_id,
        token.Span span
    ) {
        qid.TypeId receiver_type = self.lowerer.ctx.store.types.trait_companion_type(
            trait_def,
            .receiver,
            span
        );
        qid.TypeId vtable_type = self.lowerer.ctx.store.types.trait_companion_type(
            trait_def,
            .vtable,
            span
        );
        mir.MirLocalId receiver_local = self.add_temp(receiver_type, span);
        self.lower_trait_receiver_value(value_id, self.place_for_local(receiver_local), span);
        self.push_trait_object_aggregate(node_id, destination, global_def, receiver_local, vtable_type, span);
    }

    () push_trait_object_assign_from_reference(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.DefId trait_def,
        qid.DefId global_def,
        mir.MirPlace reference,
        token.Span span
    ) {
        qid.TypeId receiver_type = self.lowerer.ctx.store.types.trait_companion_type(
            trait_def,
            .receiver,
            span
        );
        qid.TypeId vtable_type = self.lowerer.ctx.store.types.trait_companion_type(
            trait_def,
            .vtable,
            span
        );
        mir.MirLocalId receiver_local = self.add_temp(receiver_type, span);
        self.push_assign(
            self.place_for_local(receiver_local),
            mir.use_rvalue(mir.MirUseRvalue(
                value: mir.copy_operand_value(mir.MirCopyOperand(place: reference))
            )),
            span
        );
        self.push_trait_object_aggregate(node_id, destination, global_def, receiver_local, vtable_type, span);
    }

    () push_trait_object_owned_assign(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.DefId trait_def,
        qid.DefId global_def,
        mir.MirPlace owned_place,
        token.Span span
    ) {
        qid.TypeId receiver_type = self.lowerer.ctx.store.types.trait_companion_type(trait_def, .receiver, span);
        qid.TypeId vtable_type = self.lowerer.ctx.store.types.trait_companion_type(trait_def, .vtable, span);
        mir.MirLocalId receiver_local = self.add_temp(receiver_type, span);
        self.push_assign(
            self.place_for_local(receiver_local),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: mir.copy_operand_value(mir.MirCopyOperand (place: owned_place)),
                target_type: receiver_type
            )),
            span
        );
        self.push_trait_object_aggregate(node_id, destination, global_def, receiver_local, vtable_type, span);
    }

    () push_trait_object_aggregate(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.DefId global_def,
        mir.MirLocalId receiver_local,
        qid.TypeId vtable_type,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>(2);
        fields.add(mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(receiver_local))));
        fields.add(mir.global_address_operand_value(mir.MirGlobalRef (
            global_def: global_def,
            type_id: vtable_type,
            is_external: false,
            span: span
        )));
        self.push_assign(
            destination,
            self.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: mir.MirAggregateKind.tuple,
                def_id: null,
                type_id: self.type_for_node(node_id),
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            ), span),
            span
        );
    }

    qid.TypeId trait_ref_subject_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return type_id; }
        if (handle.kind == .reference) { return handle.element; }
        return type_id;
    }

    qid.DefId? ensure_trait_vtable_global(self,
        hir.HirId node_id,
        qid.DefId trait_def,
        qid.TypeId subject_type
    ) {
        TraitVTableGlobalKey key = TraitVTableGlobalKey(trait_def, subject_type);
        if (table.hash_table_get_value<TraitVTableGlobalKey, qid.DefId>(
            self.lowerer.trait_vtable_globals$.ref(),
            key
        ) is .some(existing)) {
            return existing;
        }
        guard self.trait_vtable_static_value(node_id, trait_def, subject_type) is .some(initializer) else {
            return null;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId vtable_type = self.lowerer.ctx.store.types.trait_companion_type(trait_def, .vtable, span);
        qid.DefId global_def = self.create_trait_vtable_global_def(trait_def, subject_type, span);
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: global_def,
            type_id: vtable_type,
            span: span,
            read_only: true,
            is_external: false,
            initializer: initializer
        ));
        self.lowerer.trait_vtable_globals.set(key, global_def);
        return global_def;
    }

    qid.DefId create_trait_vtable_global_def(self,
        qid.DefId trait_def,
        qid.TypeId subject_type,
        token.Span span
    ) {
        def.DefRecord trait_record = self.lowerer.ctx.store.defs.get(trait_def);
        std.String name = self.trait_vtable_global_name(trait_def, subject_type);
        return self.lowerer.ctx.store.defs.create(
            .global_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            trait_def,
            trait_record.module_id,
            trait_record.decl_namespace_id,
            null
        );
    }

    std.String trait_vtable_global_name(self, qid.DefId trait_def, qid.TypeId subject_type) {
        std.StringBuilder builder = std.StringBuilder();
        builder.append("__vtable_");
        builder.append(trait_def.to_index());
        builder.append("_");
        builder.append(subject_type.to_index());
        return builder$.move().into_string();
    }

    () lower_trait_receiver_value(self, hir.HirId value_id, mir.MirPlace destination, token.Span span) {
        if (self.type_is_reference(self.type_for_node(value_id))) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (value: self.lower_to_operand(value_id))),
                span
            );
            return;
        }
        mir.MirPlace source = self.receiver_source_place(value_id, span);
        self.push_assign(
            destination,
            mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: true,
                place: source
            )),
            span
        );
    }

    () push_trait_vtable_assign(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.DefId trait_def,
        qid.TypeId subject_type
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        list.ArrayList<mir.MirOperand> fields = self.trait_vtable_operands(node_id, trait_def, subject_type);
        self.push_assign(
            destination,
            self.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: mir.MirAggregateKind.tuple,
                def_id: null,
                type_id: self.mir_place_type(destination),
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            ), span),
            span
        );
    }

    list.ArrayList<mir.MirOperand> trait_vtable_operands(self,
        hir.HirId node_id,
        qid.DefId trait_def,
        qid.TypeId subject_type
    ) {
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>();
        guard self.lowerer.hirs.def(trait_def) is .some(hir_def) else { return fields$.move(); }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId trait_member = hir_def.members.get(index);
            if (self.lowerer.ctx.store.defs.get(trait_member).kind == .function_def) {
                fields.add(self.trait_vtable_function_operand(node_id, subject_type, trait_member));
            }
            index = index + 1;
        }
        return fields$.move();
    }

    mir.MirStaticValue? trait_vtable_static_value(self,
        hir.HirId node_id,
        qid.DefId trait_def,
        qid.TypeId subject_type
    ) {
        list.ArrayList<mir.MirStaticField> fields! = list.ArrayList<mir.MirStaticField>();
        fields.add(self.receiver_type_info_static_field(node_id, subject_type));
        guard self.lowerer.hirs.def(trait_def) is .some(hir_def) else { return null; }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId trait_member = hir_def.members.get(index);
            if (self.lowerer.ctx.store.defs.get(trait_member).kind == .function_def) {
                guard self.trait_vtable_function_ref(node_id, subject_type, trait_member) is .some(function_ref) else {
                    return null;
                }
                fields.add(mir.MirStaticField (
                    type_id: function_ref.type_id,
                    value: mir.function_static_value(function_ref)
                ));
            }
            index = index + 1;
        }
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(fields$.ref()));
    }

    mir.MirStaticField receiver_type_info_static_field(self, hir.HirId node_id, qid.TypeId subject_type) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId pointer_type = self.receiver_type_info_pointer_type(span);
        return mir.MirStaticField (
            type_id: pointer_type,
            value: mir.global_address_static_value(mir.MirGlobalRef (
                global_def: self.ensure_receiver_type_global(node_id, subject_type),
                type_id: pointer_type,
                is_external: false,
                span: span
            ))
        );
    }

    qid.TypeId receiver_drop_function_type(self, token.Span span) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.lowerer.ctx.store.types.opaque_pointer_type(span));
        return self.lowerer.ctx.store.types.function_type(
            params$.move(),
            self.lowerer.ctx.store.types.unit_type(),
            span
        );
    }

    qid.TypeId receiver_type_info_type(self, token.Span span) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(3);
        fields.add(self.receiver_drop_function_type(span));
        fields.add(self.lowerer.ctx.store.types.int_type());
        fields.add(self.lowerer.ctx.store.types.int_type());
        return self.lowerer.ctx.store.types.tuple_type(fields$.move(), span);
    }

    qid.TypeId receiver_type_info_pointer_type(self, token.Span span) {
        return self.lowerer.ctx.store.types.raw_pointer_type(self.receiver_type_info_type(span), span);
    }

    qid.DefId ensure_receiver_type_global(self, hir.HirId node_id, qid.TypeId subject_type) {
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.receiver_type_globals$.ref(),
            subject_type.to_index()
        ) is .some(existing)) {
            return existing;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.DefId global_def = self.create_receiver_type_global_def(subject_type, span);
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: global_def,
            type_id: self.receiver_type_info_type(span),
            span: span,
            read_only: true,
            is_external: false,
            initializer: self.receiver_type_info_static_value(node_id, subject_type)
        ));
        self.lowerer.receiver_type_globals.set(subject_type.to_index(), global_def);
        return global_def;
    }

    mir.MirStaticValue receiver_type_info_static_value(self, hir.HirId node_id, qid.TypeId subject_type) {
        token.Span span = self.lowerer.hir_span(node_id);
        list.ArrayList<mir.MirStaticField> fields! = list.ArrayList<mir.MirStaticField>(3);
        qid.TypeId drop_type = self.receiver_drop_function_type(span);
        fields.add(mir.MirStaticField (
            type_id: drop_type,
            value: mir.function_static_value(mir.MirFunctionRef (
                function_def: self.ensure_receiver_drop_shim(node_id, subject_type),
                type_args: self.lowerer.output.empty_type_args(),
                const_args: self.lowerer.output.empty_const_args(),
                coroutine_resume: false,
            coroutine_completion: false,
                type_id: drop_type,
                span: span
            ))
        ));
        fields.add(mir.MirStaticField (
            type_id: self.lowerer.ctx.store.types.int_type(),
            value: mir.scalar_static_value(mir.MirConst (
                type_id: self.lowerer.ctx.store.types.int_type(),
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(0), signed_value: true))
            ))
        ));
        fields.add(mir.MirStaticField (
            type_id: self.lowerer.ctx.store.types.int_type(),
            value: mir.scalar_static_value(mir.MirConst (
                type_id: self.lowerer.ctx.store.types.int_type(),
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(0), signed_value: true))
            ))
        ));
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(fields$.ref()));
    }

    mir.MirFunctionRef ensure_cancel_handler_shim(
        self,
        hir.HirId handler_id,
        hir.HirLambda handler,
        mir.MirFunctionRef drop,
        token.Span span
    ) {
        qid.DefId shim_def;
        Int key = handler.function_def.to_index();
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.cancel_handler_shims$.ref(), key
        ) is .some(existing)) {
            shim_def = existing;
        } else {
            shim_def = self.create_cancel_handler_shim_def(handler.function_def, span);
            self.lowerer.cancel_handler_shims.set(key, shim_def);
            self.add_cancel_handler_shim_function(
                shim_def,
                self.cancel_handler_function(handler_id, handler, span),
                drop,
                span
            );
        }
        return mir.MirFunctionRef (
            function_def: shim_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.lowerer.task_resume_function_type(span),
            span: span
        );
    }

    mir.MirFunctionRef cancel_handler_function(
        self,
        hir.HirId handler_id,
        hir.HirLambda handler,
        token.Span span
    ) {
        return mir.MirFunctionRef (
            function_def: handler.function_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.closure_code_type(self.type_for_node(handler_id)),
            span: span
        );
    }

    qid.DefId create_cancel_handler_shim_def(self, qid.DefId handler_def, token.Span span) {
        def.DefRecord handler_record = self.lowerer.ctx.store.defs.get(handler_def);
        std.String name = build_text_int("__cancel_handler_", handler_def.to_index());
        return self.lowerer.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            handler_record.owner_def,
            handler_record.module_id,
            handler_record.decl_namespace_id,
            null
        );
    }

    () add_cancel_handler_shim_function(
        self,
        qid.DefId shim_def,
        mir.MirFunctionRef handler,
        mir.MirFunctionRef drop,
        token.Span span
    ) {
        Int function_index = self.lowerer.output.functions.len();
        qid.TypeId unit_type = self.lowerer.ctx.store.types.unit_type();
        list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(4);
        locals.add(self.receiver_drop_local(0, .return_place, unit_type, span));
        locals.add(self.receiver_drop_local(1, .param, self.closure_env_type(span), span));
        locals.add(self.receiver_drop_local(2, .compiler_temp, unit_type, span));
        locals.add(self.receiver_drop_local(3, .compiler_temp, unit_type, span));
        list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(3);
        blocks.add(self.cancel_handler_call_block(handler, 2, 0, 1, span));
        blocks.add(self.cancel_handler_call_block(drop, 3, 1, 2, span));
        blocks.add(mir.MirBlock (
            id: mir.MirBlockId.from_index(2),
            span: span,
            statements: self.lowerer.output.empty_statements(),
            terminator: self.receiver_drop_return_terminator(span)
        ));
        mir.MirBody body = mir.MirBody (
            id: mir.MirBodyId.from_index(function_index),
            span: span,
            locals: self.freeze_generated_locals(locals$.ref()),
            blocks: self.lowerer.output.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        );
        self.add_cancel_handler_shim_mir(shim_def, function_index, body, span);
    }

    mir.MirBlock cancel_handler_call_block(
        self,
        mir.MirFunctionRef function,
        Int result_local,
        Int block_index,
        Int target_index,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (
            place: self.receiver_drop_param_place()
        )));
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(block_index),
            span: span,
            statements: self.lowerer.output.empty_statements(),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: mir.direct_function_callee(function),
                    args: self.lowerer.output.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: mir.local_place(
                        mir.MirLocalId.from_index(result_local),
                        self.lowerer.output.empty_projection()
                    ),
                    target: mir.MirBlockId.from_index(target_index),
                    initialized_place: null,
                    exclusive_places: self.lowerer.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    () add_cancel_handler_shim_mir(
        self,
        qid.DefId shim_def,
        Int function_index,
        mir.MirBody body,
        token.Span span
    ) {
        self.lowerer.output.add_function(mir.MirFunction (
            id: mir.MirFunctionId.from_index(function_index),
            def_id: shim_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: body
        ));
    }

    mir.MirLocalDecl[]& freeze_generated_locals(
        self,
        list.ArrayList<mir.MirLocalDecl>& locals
    ) {
        unsafe {
            mir.MirLocalDecl*! stored = self.lowerer.output.alloc_local_array(locals.len());
            Int index! = 0;
            while (index < locals.len()) {
                stored[index] = locals.get(index);
                index = index + 1;
            }
            return stored[0..locals.len()];
        }
    }

    qid.DefId ensure_receiver_drop_shim(self, hir.HirId node_id, qid.TypeId subject_type) {
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.receiver_drop_shims$.ref(),
            subject_type.to_index()
        ) is .some(existing)) {
            return existing;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.DefId shim_def = self.create_receiver_drop_shim_def(subject_type, span);
        self.lowerer.receiver_drop_shims.set(subject_type.to_index(), shim_def);
        self.add_receiver_drop_shim_function(shim_def, subject_type, span);
        self.lowerer.ensure_custom_deinit_instance_for_type(subject_type);
        return shim_def;
    }

    qid.DefId create_receiver_drop_shim_def(self, qid.TypeId subject_type, token.Span span) {
        def.DefRecord function_record = self.lowerer.ctx.store.defs.get(self.hir_def.def_id);
        std.String name = build_text_int("__receiver_drop_in_place_", subject_type.to_index());
        return self.lowerer.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
    }

    () add_receiver_drop_shim_function(self, qid.DefId shim_def, qid.TypeId subject_type, token.Span span) {
        unsafe {
            Int function_index = self.lowerer.output.functions.len();
            qid.TypeId receiver_type = self.lowerer.ctx.store.types.raw_pointer_type(
                self.lowerer.ctx.store.types.uint8_type(),
                span
            );
            qid.TypeId subject_pointer = self.lowerer.ctx.store.types.raw_pointer_type(subject_type, span);
            list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(3);
            locals.add(self.receiver_drop_local(0, .return_place, self.lowerer.ctx.store.types.unit_type(), span));
            locals.add(self.receiver_drop_local(1, .param, receiver_type, span));
            locals.add(self.receiver_drop_local(2, .compiler_temp, subject_pointer, span));

            drop_semantics.DropQuery query = drop_semantics.DropQuery(self.lowerer.ctx);
            Bool needs_runtime_drop = query.type_needs_runtime_drop(subject_type);
            Bool needs_free = self.receiver_type_needs_free(subject_type);
            mir.MirPlace pointer_place = mir.local_place(
                mir.MirLocalId.from_index(2),
                self.lowerer.output.empty_projection()
            );
            list.ArrayList<mir.MirPlaceElem> deref_projection! = list.ArrayList<mir.MirPlaceElem>(1);
            deref_projection.add(mir.deref_projection_elem(mir.MirDerefProjection(raw_pointer: true)));
            mir.MirPlace pointee = mir.local_place(
                mir.MirLocalId.from_index(2),
                self.lowerer.output.projection_array(deref_projection$.ref())
            );
            list.ArrayList<mir.MirStatement> entry_statements! = list.ArrayList<mir.MirStatement>(1);
            if (needs_runtime_drop) {
                entry_statements.add(self.receiver_drop_pointer_assign(pointer_place, subject_pointer, span));
            }
            list.ArrayList<mir.MirStatement> return_statements! = list.ArrayList<mir.MirStatement>(1);
            if (needs_free) {
                return_statements.add(self.receiver_drop_free_statement(span));
            }
            list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
            if (needs_runtime_drop) {
                blocks.add(self.receiver_drop_block(pointee, entry_statements$.ref(), span));
            } else {
                blocks.add(self.receiver_drop_return_block(return_statements$.ref(), span));
            }
            blocks.add(mir.MirBlock(
                id: mir.MirBlockId.from_index(1),
                span: span,
                statements: self.lowerer.output.statement_array(return_statements$.ref()),
                terminator: mir.MirTerminator(
                    span: span,
                    kind: mir.return_terminator_kind(mir.MirReturnTerminator(implicit_unit: true))
                )
            ));
            mir.MirLocalDecl*! stored_locals = self.lowerer.output.alloc_local_array(locals.len());
            Int local_index! = 0;
            while (local_index < locals.len()) {
                stored_locals[local_index] = locals[local_index];
                local_index = local_index + 1;
            }
            mir.MirBody body = mir.MirBody(
                id: mir.MirBodyId.from_index(function_index),
                span: span,
                locals: stored_locals[0..locals.len()],
                blocks: self.lowerer.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
            self.lowerer.output.add_function(mir.MirFunction(
                id: mir.MirFunctionId.from_index(function_index),
                def_id: shim_def,
                type_args: self.lowerer.output.empty_type_args(),
                const_args: self.lowerer.output.empty_const_args(),
                signature_id: null,
                effects: types.EffectSet(),
                is_coroutine: false,
                coroutine_frame: null,
                is_coroutine_resume: false,
            is_coroutine_completion: false,
                is_language_entry: false,
                is_runtime_entry: false,
                is_external: false,
                inline_always: false,
                naked: false,
                span: span,
                body: body
            ));
        }
    }

    Bool receiver_type_needs_free(self, qid.TypeId subject_type) {
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, subject_type);
        layout.TypeLayout type_layout = self.lowerer.ctx.store.layouts.layout(layout_id);
        return type_layout.kind != .invalid && type_layout.kind != .zero_sized;
    }

    mir.MirBlock receiver_drop_block(self,
        mir.MirPlace pointee,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.lowerer.output.statement_array(statements),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.drop_terminator_kind(mir.MirDropTerminator (
                    place: pointee,
                    target: mir.MirBlockId.from_index(1),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirBlock receiver_drop_return_block(self,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.lowerer.output.statement_array(statements),
            terminator: self.receiver_drop_return_terminator(span)
        );
    }

    mir.MirTerminator receiver_drop_return_terminator(self, token.Span span) {
        return mir.MirTerminator (
            span: span,
            kind: mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: true))
        );
    }

    mir.MirStatement receiver_drop_pointer_assign(self,
        mir.MirPlace pointer_place,
        qid.TypeId subject_pointer,
        token.Span span
    ) {
        mir.MirOperand receiver_operand = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.receiver_drop_param_place()
        ));
        mir.MirRvalue cast_value = mir.cast_rvalue(mir.MirCastRvalue (
            kind: mir.MirCastKind.ptr_to_ptr,
            value: receiver_operand,
            target_type: subject_pointer
        ));
        return mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: pointer_place,
                value: cast_value
            ))
        );
    }

    mir.MirStatement receiver_drop_free_statement(self, token.Span span) {
        mir.MirPlace return_place = mir.local_place(
            mir.MirLocalId.from_index(0),
            self.lowerer.output.empty_projection()
        );
        mir.MirOperand pointer = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.receiver_drop_param_place()
        ));
        mir.MirRvalue free_value = mir.free_rvalue(mir.MirFreeRvalue (pointer: pointer));
        return mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: return_place,
                value: free_value
            ))
        );
    }

    mir.MirPlace receiver_drop_param_place(self) {
        return mir.local_place(mir.MirLocalId.from_index(1), self.lowerer.output.empty_projection());
    }

    mir.MirLocalDecl receiver_drop_local(self, Int index, mir.MirLocalKind kind, qid.TypeId type_id, token.Span span) {
        return mir.MirLocalDecl(
            id: mir.MirLocalId.from_index(index),
            kind: kind,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    qid.DefId ensure_closure_noop_drop_shim(self, token.Span span) {
        if (self.lowerer.closure_noop_drop_shim is .some(existing)) {
            return existing;
        }
        qid.DefId shim_def = self.create_closure_drop_shim_def("__closure_drop_noop", span);
        self.lowerer.closure_noop_drop_shim = shim_def;
        self.add_closure_noop_drop_shim_function(shim_def, span);
        return shim_def;
    }

    () add_closure_noop_drop_shim_function(self, qid.DefId shim_def, token.Span span) {
        Int function_index = self.lowerer.output.functions.len();
        list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(2);
        locals.add(self.receiver_drop_local(0, .return_place, self.lowerer.ctx.store.types.unit_type(), span));
        locals.add(self.receiver_drop_local(1, .param, self.closure_env_type(span), span));
        list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(1);
        blocks.add(self.env_drop_return_block(self.lowerer.output.empty_statements(), span, 0));
        self.add_closure_drop_shim_function(shim_def, function_index, locals$.ref(), blocks$.ref(), span);
    }

    qid.DefId ensure_lambda_env_drop_shim(self, hir.HirId node_id, qid.TypeId env_type, Bool heap_env) {
        return self.ensure_lambda_env_drop_shim_at_span(
            env_type, heap_env, self.lowerer.hir_span(node_id)
        );
    }

    qid.DefId ensure_lambda_env_drop_shim_at_span(
        self,
        qid.TypeId env_type,
        Bool heap_env,
        token.Span span
    ) {
        Int key! = env_type.to_index() * 2;
        if (heap_env) {
            key = key + 1;
        }
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.lambda_env_drop_shims$.ref(),
            key
        ) is .some(existing)) {
            return existing;
        }
        std.String name! = build_text_int("__closure_drop_env_stack_", env_type.to_index());
        if (heap_env) {
            name = build_text_int("__closure_drop_env_heap_", env_type.to_index());
        }
        qid.DefId shim_def = self.create_closure_drop_shim_def(name.bytes(), span);
        self.lowerer.lambda_env_drop_shims.set(key, shim_def);
        self.add_lambda_env_drop_shim_function(shim_def, env_type, heap_env, span);
        return shim_def;
    }

    qid.DefId create_closure_drop_shim_def(self, UInt8[]& name, token.Span span) {
        def.DefRecord function_record = self.lowerer.ctx.store.defs.get(self.hir_def.def_id);
        return self.lowerer.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
    }

    () add_lambda_env_drop_shim_function(self, qid.DefId shim_def, qid.TypeId env_type, Bool heap_env, token.Span span) {
        Int function_index = self.lowerer.output.functions.len();
        qid.TypeId env_pointer_type = self.raw_pointer_type(env_type, span);
        list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(3);
        locals.add(self.receiver_drop_local(0, .return_place, self.lowerer.ctx.store.types.unit_type(), span));
        locals.add(self.receiver_drop_local(1, .param, self.closure_env_type(span), span));
        locals.add(self.receiver_drop_local(2, .compiler_temp, env_pointer_type, span));

        Bool needs_runtime_drop = self.closure_env_type_needs_runtime_drop(env_type);
        list.ArrayList<mir.MirStatement> entry_statements! = list.ArrayList<mir.MirStatement>(1);
        if (needs_runtime_drop) {
            entry_statements.add(self.env_drop_pointer_assign(env_pointer_type, span));
        }
        list.ArrayList<mir.MirStatement> return_statements! = list.ArrayList<mir.MirStatement>(1);
        if (heap_env) {
            return_statements.add(self.env_drop_free_statement(span));
        }

        list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
        if (needs_runtime_drop) {
            mir.MirPlace pointer_place = mir.local_place(
                mir.MirLocalId.from_index(2),
                self.lowerer.output.empty_projection()
            );
            blocks.add(self.env_drop_block(
                self.project_deref(pointer_place, true),
                entry_statements$.ref(),
                span
            ));
            blocks.add(self.env_drop_return_block(self.lowerer.output.statement_array(return_statements$.ref()), span, 1));
        } else {
            blocks.add(self.env_drop_return_block(self.lowerer.output.statement_array(return_statements$.ref()), span, 0));
        }
        self.add_closure_drop_shim_function(shim_def, function_index, locals$.ref(), blocks$.ref(), span);
    }

    Bool closure_env_type_needs_runtime_drop(self, qid.TypeId env_type) {
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.lowerer.ctx);
        return query.type_needs_runtime_drop(env_type);
    }

    () add_closure_drop_shim_function(self,
        qid.DefId shim_def,
        Int function_index,
        list.ArrayList<mir.MirLocalDecl>& locals,
        list.ArrayList<mir.MirBlock>& blocks,
        token.Span span
    ) {
        unsafe {
            mir.MirLocalDecl*! stored_locals = self.lowerer.output.alloc_local_array(locals.len());
            Int local_index! = 0;
            while (local_index < locals.len()) {
                stored_locals[local_index] = locals.get(local_index);
                local_index = local_index + 1;
            }
            mir.MirBody body = mir.MirBody(
                id: mir.MirBodyId.from_index(function_index),
                span: span,
                locals: stored_locals[0..locals.len()],
                blocks: self.lowerer.output.block_array(blocks),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            );
            self.lowerer.output.add_function(mir.MirFunction(
                id: mir.MirFunctionId.from_index(function_index),
                def_id: shim_def,
                type_args: self.lowerer.output.empty_type_args(),
                const_args: self.lowerer.output.empty_const_args(),
                signature_id: null,
                effects: types.EffectSet(),
                is_coroutine: false,
                coroutine_frame: null,
                is_coroutine_resume: false,
            is_coroutine_completion: false,
                is_language_entry: false,
                is_runtime_entry: false,
                is_external: false,
                inline_always: false,
                naked: false,
                span: span,
                body: body
            ));
        }
    }

    mir.MirStatement env_drop_pointer_assign(self, qid.TypeId env_pointer_type, token.Span span) {
        mir.MirOperand env_operand = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.receiver_drop_param_place()
        ));
        return mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: mir.local_place(mir.MirLocalId.from_index(2), self.lowerer.output.empty_projection()),
                value: mir.cast_rvalue(mir.MirCastRvalue (
                    kind: mir.MirCastKind.ptr_to_ptr,
                    value: env_operand,
                    target_type: env_pointer_type
                ))
            ))
        );
    }

    mir.MirStatement env_drop_free_statement(self, token.Span span) {
        mir.MirOperand pointer = mir.copy_operand_value(mir.MirCopyOperand (
            place: self.receiver_drop_param_place()
        ));
        return mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: mir.local_place(mir.MirLocalId.from_index(0), self.lowerer.output.empty_projection()),
                value: mir.free_rvalue(mir.MirFreeRvalue (pointer: pointer))
            ))
        );
    }

    mir.MirBlock env_drop_block(self,
        mir.MirPlace pointee,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.lowerer.output.statement_array(statements),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.drop_terminator_kind(mir.MirDropTerminator (
                    place: pointee,
                    target: mir.MirBlockId.from_index(1),
                    cleanup: null
                ))
            )
        );
    }

    @life(statements > return)
    mir.MirBlock env_drop_return_block(self,
        mir.MirStatement[]& statements,
        token.Span span,
        Int block_index
    ) {
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(block_index),
            span: span,
            statements: statements,
            terminator: self.receiver_drop_return_terminator(span)
        );
    }

    qid.DefId create_receiver_type_global_def(self, qid.TypeId subject_type, token.Span span) {
        def.DefRecord function_record = self.lowerer.ctx.store.defs.get(self.hir_def.def_id);
        std.String name = build_text_int("__receiver_type_", subject_type.to_index());
        return self.lowerer.ctx.store.defs.create(
            .global_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
    }

    mir.MirOperand trait_vtable_function_operand(self,
        hir.HirId node_id,
        qid.TypeId subject_type,
        qid.DefId trait_member
    ) {
        guard self.trait_vtable_function_ref(node_id, subject_type, trait_member) is .some(function_ref) else {
            return self.unsupported_operand(node_id);
        }
        return mir.function_operand_value(function_ref);
    }

    mir.MirFunctionRef? trait_vtable_function_ref(self,
        hir.HirId node_id,
        qid.TypeId subject_type,
        qid.DefId trait_member
    ) {
        guard self.impl_member_for_trait_type(subject_type, trait_member) is .some(impl_def) else {
            return null;
        }
        qid.TypeId[]& type_args = self.impl_function_type_args(subject_type, impl_def);
        comptime_value.ComptimeValue[]& const_args = self.impl_function_const_args(subject_type, impl_def);
        qid.TypeId function_type = self.function_type_for_ref(impl_def, type_args, const_args);
        if (type_args.length > 0 || const_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(impl_def, type_args, const_args);
        } else {
            self.lowerer.ensure_external_function(impl_def);
        }
        return self.function_ref(node_id, impl_def, function_type, type_args, const_args);
    }

    qid.DefId? impl_member_for_trait_type(self, qid.TypeId subject_type, qid.DefId trait_member) {
        guard self.namespace_provider_def_for_type(subject_type) is .some(impl_def) else { return null; }
        return self.member_impl_for_trait_member(impl_def, trait_member, .value_name);
    }

    qid.DefId? member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member, def.NameDomain domain) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_member) is .some(impl_member)) {
            return impl_member;
        }
        guard self.lowerer.ctx.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.lowerer.ctx.store.defs.get(trait_member).name.symbol;
        guard self.lowerer.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, domain)
            is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? qualified_member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member) {
        guard self.lowerer.hirs.def(impl_def) is .some(hir_def) else { return null; }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            def.DefRecord member_record = self.lowerer.ctx.store.defs.get(member_def);
            if (member_record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) { return member_def; }
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId[]& impl_function_type_args(self, qid.TypeId subject_type, qid.DefId impl_def) {
        guard self.lowerer.ctx.store.defs.get(impl_def).owner_def is .some(owner_def) else {
            return self.lowerer.output.empty_type_args();
        }
        guard self.receiver_type_args_for_owner(subject_type, owner_def) is .some(args) else {
            return self.lowerer.output.empty_type_args();
        }
        return args;
    }

    comptime_value.ComptimeValue[]& impl_function_const_args(self, qid.TypeId subject_type, qid.DefId impl_def) {
        guard self.lowerer.ctx.store.defs.get(impl_def).owner_def is .some(owner_def) else {
            return self.lowerer.output.empty_const_args();
        }
        guard self.receiver_const_args_for_owner(subject_type, owner_def) is .some(args) else {
            return self.lowerer.output.empty_const_args();
        }
        return args;
    }

    qid.TypeId? trait_vtable_subject_type(self, hir.HirImplicitCall call) {
        if (call.args.length != 1) { return null; }
        return self.type_for_node(call.args[0]);
    }

    qid.DefId? trait_member_for_symbol(self, qid.DefId trait_def, qid.SymbolId symbol) {
        guard self.lowerer.ctx.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.lowerer.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.lowerer.ctx.store.defs.get(binding.def_id).kind != .function_def) { return null; }
        return binding.def_id;
    }

    qid.DefId trait_member_identity(self, qid.DefId member_def) {
        def.DefRecord record = self.lowerer.ctx.store.defs.get(member_def);
        if (record.associated_trait_member is .some(trait_member)) {
            return trait_member;
        }
        return member_def;
    }

    Int? trait_vtable_slot_index(self, qid.DefId trait_def, qid.DefId member_def) {
        qid.DefId target = self.trait_member_identity(member_def);
        guard self.lowerer.hirs.def(trait_def) is .some(hir_def) else { return null; }
        Int slot! = 0;
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId candidate = hir_def.members.get(index);
            if (self.lowerer.ctx.store.defs.get(candidate).kind == .function_def) {
                if (candidate == target) { return slot; }
                slot = slot + 1;
            }
            index = index + 1;
        }
        return null;
    }

    types.TraitCompanionType? trait_companion_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .trait_companion(companion)) {
            return companion;
        }
        return null;
    }

    types.TraitCompanionType? trait_object_companion_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .trait_companion(companion)) {
            return companion;
        }
        guard info.data is .handle_type(handle) else { return null; }
        types.TypeInfo element = self.lowerer.ctx.store.types.get(handle.element);
        guard element.data is .trait_companion(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        return companion;
    }

    mir.MirCastKind cast_kind(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.store.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.store.types.get(target_type);
        if (source.data is .handle_type(_)) {
            if (target.data is .handle_type(_)) {
                return mir.MirCastKind.ptr_to_ptr;
            }
            if (target.data is .function_type(_)) {
                return mir.MirCastKind.ptr_to_ptr;
            }
            if (target.data is .int_type(_)) { return mir.MirCastKind.ptr_to_int; }
        }
        if (source.data is .function_type(_)) {
            if (target.data is .handle_type(_)) {
                return mir.MirCastKind.ptr_to_ptr;
            }
            if (target.data is .int_type(_)) { return mir.MirCastKind.ptr_to_int; }
        }
        if (source.data is .int_type(_)) {
            if (target.data is .handle_type(_)) { return mir.MirCastKind.int_to_ptr; }
            if (target.data is .function_type(_)) { return mir.MirCastKind.int_to_ptr; }
            if (target.data is .float_type(_)) { return mir.MirCastKind.int_to_float; }
            if (target.data is .int_type(_)) { return mir.MirCastKind.int_to_int; }
        }
        if (source.data is .float_type(_)) {
            if (target.data is .int_type(_)) { return mir.MirCastKind.float_to_int; }
            if (target.data is .float_type(_)) { return mir.MirCastKind.float_to_float; }
        }
        return mir.MirCastKind.bitcast;
    }

    () lower_slice(self, hir.HirId node_id, hir.HirSliceAccess slice_access, mir.MirPlace destination) {
        mir.MirPlace base = self.slice_base_place(slice_access.base);
        token.Span span = self.lowerer.hir_span(node_id);
        self.push_assign(
            destination,
            mir.slice_rvalue(mir.MirSliceRvalue (
                base: base,
                start: self.optional_slice_bound(slice_access.start),
                end: self.slice_end_bound(slice_access, span)
            )),
            span
        );
    }

    mir.MirOperand? slice_end_bound(self, hir.HirSliceAccess slice_access, token.Span span) {
        if (slice_access.end is .some(end)) {
            return self.optional_slice_bound(end);
        }
        qid.TypeId base_type = self.type_for_node(slice_access.base);
        return self.array_to_slice_end(base_type, span);
    }

    mir.MirPlace slice_base_place(self, hir.HirId base_id) {
        mir.MirPlace base = self.pointer_base_place(base_id);
        qid.TypeId base_type = self.type_for_node(base_id);
        if (self.type_is_reference_to_array(base_type)) {
            return self.project_deref(base, false);
        }
        return base;
    }

    Bool type_is_reference_to_array(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference) { return false; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        return element_info.data is .array_type(_);
    }

    () lower_struct_literal(self, hir.HirId node_id, hir.HirStructLiteral literal, mir.MirPlace destination) {
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.ctx.store.types.get(type_id).data is .named(named) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (self.lower_nominal_literal_as_field_assignments(node_id, literal, destination, named)) {
            return;
        }
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>();
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        guard self.append_struct_literal_fields(literal, named.def_id, substitutions$.ref(), fields$.ref()) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            self.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: self.struct_literal_aggregate_kind(named.def_id),
                def_id: named.def_id,
                type_id: type_id,
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_array(fields$.ref())
            ), self.lowerer.hir_span(node_id)),
            self.lowerer.hir_span(node_id)
        );
    }

    // struct literal 在 MIR 中直接降成字段 assignment。这样 borrow check
    // 看到的是 `dest.field = value`，不需要重新解释 aggregate 的字段语义。
    Bool lower_nominal_literal_as_field_assignments(self,
        hir.HirId node_id,
        hir.HirStructLiteral literal,
        mir.MirPlace destination,
        types.NamedType named
    ) {
        def.DefKind kind = self.lowerer.ctx.store.defs.get(named.def_id).kind;
        if (kind != .struct_def) {
            return false;
        }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        guard self.lowerer.hirs.def(named.def_id) is .some(owner_hir) else {
            self.mark_unsupported(node_id);
            return true;
        }
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.lower_nominal_literal_field(literal, destination, member_def, substitutions$.ref()) else {
                    self.mark_unsupported(node_id);
                    return true;
                }
            }
            index = index + 1;
        }
        return true;
    }

    Bool lower_nominal_literal_field(self,
        hir.HirStructLiteral literal,
        mir.MirPlace destination,
        qid.DefId field_def,
        monomorph.SubstitutionMap& substitutions
    ) {
        guard self.struct_literal_field_value(literal, field_def) is .some(value) else { return false; }
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        mir.MirPlace field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(value, field_place, field_type);
        return true;
    }

    () lower_into_place_as_type(self, hir.HirId node_id, mir.MirPlace destination, qid.TypeId expected) {
        qid.TypeId actual = self.type_for_node(node_id);
        if (self.type_needs_optional_lift(actual, expected) || self.type_needs_error_union_lift(actual, expected)) {
            mir.MirOperand value = self.lower_to_operand_as_type(node_id, expected);
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (value: value)),
                self.lowerer.hir_span(node_id)
            );
            return;
        }
        self.lower_into_place(node_id, destination);
    }

    Bool append_struct_literal_fields(self,
        hir.HirStructLiteral literal,
        qid.DefId owner_def,
        monomorph.SubstitutionMap& substitutions,
        list.ArrayList<mir.MirOperand>& fields
    ) {
        guard self.lowerer.hirs.def(owner_def) is .some(owner_hir) else { return false; }
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.struct_literal_field_value(literal, member_def) is .some(value) else { return false; }
                guard self.field_expected_type(member_def, substitutions) is .some(field_type) else { return false; }
                fields.add(self.lower_to_operand_as_type(value, field_type));
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? field_expected_type(self, qid.DefId field_def, monomorph.SubstitutionMap& substitutions) {
        guard self.lowerer.typeck.def_type(field_def) is .some(type_id) else { return null; }
        return self.lowerer.substitute_type(type_id, substitutions);
    }

    mir.MirOperand lower_to_operand_as_type(self, hir.HirId node_id, qid.TypeId expected) {
        mir.MirOperand value = self.lower_to_operand(node_id);
        if (self.value_needs_optional_lift(value, expected)) {
            return self.lower_optional_lift_operand(node_id, value, expected);
        }
        return self.lower_error_union_lift_if_needed(node_id, value, expected);
    }

    Bool value_needs_optional_lift(self, mir.MirOperand value, qid.TypeId expected) {
        return self.type_needs_optional_lift(self.mir_operand_type(value), expected);
    }

    Bool type_needs_optional_lift(self, qid.TypeId actual, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.ctx.store.types.get(expected);
        guard expected_info.data is .optional(_) else { return false; }
        return self.type_can_be_lifted(actual, expected);
    }

    mir.MirOperand lower_optional_lift_operand(self, hir.HirId node_id, mir.MirOperand value, qid.TypeId expected) {
        mir.MirLocalId temp = self.add_temp(expected, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.make_some,
                value: value
            )),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: temp_place));
    }

    mir.MirOperand lower_error_union_lift_if_needed(self,
        hir.HirId node_id,
        mir.MirOperand value,
        qid.TypeId expected
    ) {
        if (self.value_needs_error_union_lift(value, expected)) {
            return self.lower_error_union_lift_operand(node_id, value, expected);
        }
        return value;
    }

    Bool value_needs_error_union_lift(self, mir.MirOperand value, qid.TypeId expected) {
        return self.type_needs_error_union_lift(self.mir_operand_type(value), expected);
    }

    Bool type_needs_error_union_lift(self, qid.TypeId actual, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.ctx.store.types.get(expected);
        guard expected_info.data is .error_union(_) else { return false; }
        return self.type_can_be_lifted(actual, expected);
    }

    Bool type_can_be_lifted(self, qid.TypeId actual, qid.TypeId expected) {
        if (self.lowerer.ctx.store.types.same_type_ignoring_mutability(actual, expected)) {
            return false;
        }
        types.TypeInfo actual_info = self.lowerer.ctx.store.types.get(actual);
        if (actual_info.data is .invalid) { return false; }
        if (actual_info.data is .never) { return false; }
        return true;
    }

    mir.MirOperand lower_error_union_lift_operand(self, hir.HirId node_id, mir.MirOperand value, qid.TypeId expected) {
        mir.MirLocalId temp = self.add_temp(expected, self.lowerer.hir_span(node_id));
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.make_value,
                value: value
            )),
            self.lowerer.hir_span(node_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: temp_place));
    }

    qid.TypeId mir_operand_type(self, mir.MirOperand value) {
        if (value is .const_operand(const_value)) {
            return const_value.type_id;
        }
        if (value is .copy_operand(copy_value)) {
            return self.mir_place_type(copy_value.place);
        }
        if (value is .move_operand(move_value)) {
            return self.mir_place_type(move_value.place);
        }
        if (value is .global_operand(global_value)) {
            return global_value.type_id;
        }
        if (value is .global_address_operand(global_value)) {
            return global_value.type_id;
        }
        if (value is .function_operand(function_value)) {
            return function_value.type_id;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    hir.HirId? struct_literal_field_value(self, hir.HirStructLiteral literal, qid.DefId field_def) {
        qid.SymbolId field_symbol = self.lowerer.ctx.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < literal.fields.length) {
            if (literal.fields[index].field_symbol == field_symbol) {
                return literal.fields[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirAggregateKind struct_literal_aggregate_kind(self, qid.DefId def_id) {
        return mir.MirAggregateKind.struct_value;
    }

    () lower_tuple_literal(self, hir.HirId node_id, hir.HirTupleLiteral literal, mir.MirPlace destination) {
        qid.TypeId[]& item_types = self.tuple_item_types(node_id);
        Int index! = 0;
        while (index < literal.items.length) {
            qid.TypeId item_type = self.tuple_item_type(item_types, index);
            mir.MirPlace item_place = self.project_constant_index(destination, index);
            self.lower_into_place_as_type(literal.items[index], item_place, item_type);
            index = index + 1;
        }
    }

    qid.TypeId[]& tuple_item_types(self, hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .tuple_type(tuple_type)) {
            return tuple_type.items;
        }
        return self.lowerer.output.empty_type_args();
    }

    qid.TypeId tuple_item_type(self, qid.TypeId[]& item_types, Int index) {
        if (index < item_types.length) {
            return item_types[index];
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    () lower_array_literal(self, hir.HirId node_id, hir.HirArrayLiteral literal, mir.MirPlace destination) {
        qid.TypeId element_type = self.array_element_type(node_id, destination);
        Int index! = 0;
        while (index < literal.items.length) {
            mir.MirPlace element_place = self.project_constant_index(destination, index);
            self.lower_into_place_as_type(literal.items[index], element_place, element_type);
            index = index + 1;
        }
        self.lower_array_sentinel_storage(destination, element_type, self.lowerer.hir_span(node_id));
    }

    () lower_array_sentinel_storage(self, mir.MirPlace destination, qid.TypeId element_type, token.Span span) {
        qid.TypeId destination_type = self.mir_place_type(destination);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(destination_type);
        guard info.data is .array_type(array_type) else { return; }
        guard array_type.sentinel is .some(sentinel) else { return; }
        mir.MirPlace sentinel_place = self.project_constant_index(destination, array_type.count);
        self.lower_comptime_value_into_place_at_span(sentinel.value, sentinel_place, span);
    }

    qid.TypeId array_element_type(self, hir.HirId node_id, mir.MirPlace destination) {
        qid.TypeId destination_type = self.mir_place_type(destination);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(destination_type);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .array_literal(literal) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        qid.TypeId source_type = self.array_literal_source_type(node_id, literal);
        types.TypeInfo source_info = self.lowerer.ctx.store.types.get(source_type);
        if (source_info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    mir.MirOperand? optional_slice_bound(self, hir.HirId? bound) {
        if (bound is .some(bound_id)) {
            return self.lower_to_operand(bound_id);
        }
        return null;
    }

    // 如果 base 本身不是 place（例如返回 pointer 的 call），先落入临时
    // local，再在这个 local 上追加 deref projection。
    mir.MirPlace? pointer_deref_place(self, hir.HirId base_id) {
        mir.MirPlace base_place! = self.pointer_base_place(base_id);
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base_place.projection.length + 1);
        Int index! = 0;
        while (index < base_place.projection.length) {
            elems.add(base_place.projection[index]);
            index = index + 1;
        }
        elems.add(mir.deref_projection_elem(mir.MirDerefProjection (
            raw_pointer: self.place_is_raw_pointer(base_place)
        )));
        return self.place_with_projection(base_place, elems$.ref());
    }

    mir.MirPlace project_deref(self, mir.MirPlace base, Bool raw_pointer) {
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(mir.deref_projection_elem(mir.MirDerefProjection (raw_pointer: raw_pointer)));
        return self.place_with_projection(base, elems$.ref());
    }

    mir.MirPlace copy_place_projection(self, mir.MirPlace base) {
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base.projection.length);
        Int index! = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        return self.place_with_projection(base, elems$.ref());
    }

    mir.MirPlace place_with_projection(self, mir.MirPlace base, list.ArrayList<mir.MirPlaceElem>& elems) {
        if (base.base is .global(global_ref)) {
            return mir.global_place(global_ref, self.lowerer.output.projection_array(elems));
        }
        return mir.local_place(base.local_id, self.lowerer.output.projection_array(elems));
    }

    mir.MirPlace pointer_base_place(self, hir.HirId base_id) {
        if (self.place_for_expr(base_id) is .some(place)) {
            return place;
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(base_id), self.lowerer.hir_span(base_id));
        self.lower_into_place(base_id, self.place_for_local(temp));
        return self.place_for_local(temp);
    }

    Bool is_raw_pointer_type(self, hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo type_info = self.lowerer.ctx.store.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    Bool place_is_raw_pointer(self, mir.MirPlace place) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    mir.MirOperand lower_to_operand(self, hir.HirId node_id) {
        if (self.move_operand_for_expr(node_id) is .some(operand)) {
            return operand;
        }
        if (self.comptime_operand_for_expr(node_id) is .some(operand)) {
            return operand;
        }
        if (self.can_lower_as_direct_operand(node_id)) {
            return self.lower_operand(node_id);
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
        return self.operand_for_place(self.place_for_local(temp));
    }

    mir.MirOperand? comptime_operand_for_expr(self, hir.HirId node_id) {
        guard self.comptime_value_for_expr(node_id) is .some(const_value) else {
            return null;
        }
        qid.TypeId expected_type = self.type_for_node(node_id);
        token.Span span = self.lowerer.hir_span(node_id);
        if (self.mir_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            return mir.const_operand_value(scalar_const);
        }
        mir.MirLocalId temp = self.add_temp(expected_type, span);
        guard self.lower_comptime_value_into_place_at_span(const_value, self.place_for_local(temp), span) else {
            return null;
        }
        return self.operand_for_place(self.place_for_local(temp));
    }

    mir.MirOperand? move_operand_for_expr(self, hir.HirId node_id) {
        guard self.lowerer.typeck.intrinsic_operation(node_id) is .some(operation) else {
            return null;
        }
        if (operation != typeck_store.IntrinsicOperationKind.move) { return null; }
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .implicit_call(call) else { return null; }
        guard self.place_for_expr(call.base) is .some(source) else {
            self.mark_unsupported(node_id);
            return null;
        }
        if (source.projection.length != 0) {
            self.mark_unsupported(node_id);
            return null;
        }
        return mir.move_operand_value(mir.MirMoveOperand (place: source));
    }

    Bool can_lower_as_direct_operand(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(_)) { return true; }
        if (node.data is .lambda_expr(_)) { return !self.type_is_closure(self.type_for_node(node_id)); }
        if (node.data is .name_ref(_)) { return true; }
        if (node.data is .member_access(_)) {
            if (self.lowerer.typeck.expr_lowering(node_id) is .some(lowering_kind)) {
                if (lowering_kind == .trait_object_method_value) {
                    return true;
                }
            }
            if (self.place_for_expr(node_id) is .some(_)) {
                return true;
            }
            return false;
        }
        if (node.data is .index_access(_)) {
            if (self.place_for_expr(node_id) is .some(_)) {
                return true;
            }
            return false;
        }
        return false;
    }

    mir.MirOperand lower_operand(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return mir.const_operand_value(self.lower_const(node_id, literal));
        }
        if (node.data is .lambda_expr(lambda)) {
            return self.lambda_function_operand(node_id, lambda);
        }
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                if (self.lambda_capture_place_for_local(local_id) is .some(capture_place)) {
                    return self.operand_for_place(capture_place);
                }
                mir.MirPlace place = self.place_for_local(self.mir_local_for_hir(local_id));
                return self.operand_for_place(place);
            }
            if (name_ref is .def_ref(def_id)) {
                if (self.place_for_local_def(def_id) is .some(place)) {
                    return self.operand_for_place(place);
                }
                if (self.lambda_capture_place_for_def(def_id) is .some(capture_place)) {
                    return self.operand_for_place(capture_place);
                }
                if (self.selected_name_ref_def_operand(node_id) is .some(operand)) {
                    return operand;
                }
                return self.lower_def_operand(node_id, def_id);
            }
        }
        if (node.data is .member_access(_)) {
            if (self.lowerer.typeck.expr_lowering(node_id) is .some(lowering_kind)) {
                if (lowering_kind == .trait_object_method_value) {
                    return self.trait_object_method_value_operand(node_id);
                }
            }
            if (self.lowerer.typeck.member_selection(node_id) is .some(member_def)) {
                if (self.lowerer.ctx.store.defs.get(member_def).kind == .enum_case_def) {
                    return self.lower_def_operand(node_id, member_def);
                }
                if (self.def_can_be_function_operand(member_def)) {
                    return self.lower_def_operand(node_id, member_def);
                }
            }
        }
        if (self.place_for_expr(node_id) is .some(place)) {
            return self.operand_for_place(place);
        }
        return self.unsupported_operand(node_id);
    }

    mir.MirOperand lambda_function_operand(self, hir.HirId node_id, hir.HirLambda lambda) {
        qid.TypeId function_type = self.type_for_node(node_id);
        if (self.type_is_closure(function_type)) {
            return self.unsupported_operand(node_id);
        }
        self.ensure_lambda_function_instance(lambda.function_def);
        qid.TypeId[]& type_args = self.lowerer.output.type_arg_array(self.function_type_args);
        comptime_value.ComptimeValue[]& const_args =
            self.lowerer.output.const_arg_array(self.function_const_args);
        return mir.function_operand_value(
            self.function_ref(node_id, lambda.function_def, function_type, type_args, const_args)
        );
    }

    () lower_lambda_closure(self, hir.HirId node_id, hir.HirLambda lambda, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirOperand env = self.lambda_env_operand(node_id, lambda, span);
        mir.MirOperand vtable = self.lambda_vtable_operand(node_id, lambda, false, span);
        self.push_closure_assign(
            node_id,
            destination,
            self.type_for_node(node_id),
            env,
            vtable
        );
    }

    mir.MirOperand lambda_env_operand(self, hir.HirId node_id, hir.HirLambda lambda, token.Span span) {
        guard self.lowerer.typeck.lambda_capture_infos(lambda.function_def) is .some(captures) else {
            return self.null_operand(self.closure_env_type(span), span);
        }
        if (captures.length == 0) {
            return self.null_operand(self.closure_env_type(span), span);
        }
        qid.TypeId env_type = self.lambda_env_type_for_infos(lambda.function_def, captures, span);
        qid.TypeId env_pointer_type = self.raw_pointer_type(env_type, span);
        mir.MirLocalId env_local = self.add_temp(env_type, span);
        mir.MirPlace env_place = self.place_for_local(env_local);
        self.push_storage_live(env_local, span);
        self.fill_lambda_env(node_id, lambda, captures, env_place);
        return self.erased_lambda_env_address_operand(env_place, env_pointer_type, span);
    }

    mir.MirOperand heap_lambda_env_operand(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        mir.MirLocalId? capture_task,
        token.Span span
    ) {
        guard self.lowerer.typeck.lambda_capture_infos(lambda.function_def) is .some(captures) else {
            return self.null_operand(self.closure_env_type(span), span);
        }
        if (captures.length == 0) {
            return self.null_operand(self.closure_env_type(span), span);
        }
        mir.MirLocalId? saved_capture_task! = self.active_coroutine_capture_task;
        self.active_coroutine_capture_task = capture_task;
        qid.TypeId env_type = self.lambda_env_type_for_infos(lambda.function_def, captures, span);
        qid.TypeId env_pointer_type = self.raw_pointer_type(env_type, span);
        mir.MirLocalId env_pointer = self.add_optional_coroutine_capture_temp(
            env_pointer_type, span, capture_task
        );
        mir.MirPlace env_pointer_place = self.place_for_local(env_pointer);
        self.push_assign(
            env_pointer_place,
            mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: env_type)),
            span
        );
        mir.MirPlace env_place = self.project_deref(env_pointer_place, true);
        self.fill_lambda_env(node_id, lambda, captures, env_place);
        mir.MirOperand env = self.erased_lambda_env_pointer_operand(
            env_pointer_place, env_pointer_type, capture_task, span
        );
        self.active_coroutine_capture_task = saved_capture_task;
        return env;
    }

    mir.MirOperand lambda_vtable_operand(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        Bool heap_env,
        token.Span span
    ) {
        qid.TypeId closure_type = self.type_for_node(node_id);
        qid.DefId global_def = self.ensure_lambda_vtable_global(node_id, lambda, closure_type, heap_env);
        return mir.global_address_operand_value(mir.MirGlobalRef (
            global_def: global_def,
            type_id: self.closure_vtable_pointer_type(closure_type, span),
            is_external: false,
            span: span
        ));
    }

    qid.DefId ensure_lambda_vtable_global(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        qid.TypeId closure_type,
        Bool heap_env
    ) {
        LambdaVTableGlobalKey key = LambdaVTableGlobalKey(
            lambda.function_def,
            self.function_type_args,
            self.function_const_args,
            heap_env
        );
        if (table.hash_table_get_value<LambdaVTableGlobalKey, qid.DefId>(
            self.lowerer.lambda_vtable_globals$.ref(),
            key
        ) is .some(existing)) {
            return existing;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        std.String name! = build_text_int("__closure_vtable_stack_", lambda.function_def.to_index());
        if (heap_env) {
            name = build_text_int("__closure_vtable_heap_", lambda.function_def.to_index());
        }
        qid.DefId global_def = self.create_closure_vtable_global_def(name.bytes(), span);
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: global_def,
            type_id: self.closure_vtable_type(closure_type, span),
            span: span,
            read_only: true,
            is_external: false,
            initializer: self.lambda_vtable_static_value(node_id, lambda, closure_type, heap_env)
        ));
        self.lowerer.lambda_vtable_globals.set(key, global_def);
        return global_def;
    }

    mir.MirStaticValue lambda_vtable_static_value(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        qid.TypeId closure_type,
        Bool heap_env
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        self.ensure_lambda_function_instance(lambda.function_def);
        list.ArrayList<mir.MirStaticField> fields! = list.ArrayList<mir.MirStaticField>(2);
        qid.TypeId code_type = self.closure_code_type(closure_type);
        qid.DefId code_def! = lambda.function_def;
        if (self.function_type_is_async(closure_type)) {
            code_def = self.ensure_async_callable_start_shim(
                lambda.function_def,
                self.function_type_args,
                self.function_const_args,
                span
            );
        }
        qid.TypeId[]& code_type_args! = self.lowerer.output.empty_type_args();
        comptime_value.ComptimeValue[]& code_const_args! = self.lowerer.output.empty_const_args();
        if (code_def == lambda.function_def) {
            code_type_args = self.lowerer.output.type_arg_array(self.function_type_args);
            code_const_args = self.lowerer.output.const_arg_array(self.function_const_args);
        }
        fields.add(mir.MirStaticField (
            type_id: code_type,
            value: mir.function_static_value(mir.MirFunctionRef (
                function_def: code_def,
                type_args: code_type_args,
                const_args: code_const_args,
                coroutine_resume: false,
            coroutine_completion: false,
                type_id: code_type,
                span: span
            ))
        ));
        fields.add(mir.MirStaticField (
            type_id: self.closure_drop_env_type(span),
            value: self.lambda_drop_env_static_value(node_id, lambda, heap_env, span)
        ));
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(fields$.ref()));
    }

    () ensure_lambda_function_instance(self, qid.DefId lambda_def) {
        self.lowerer.ensure_function_instance_with_const_args(
            lambda_def,
            self.function_type_args,
            self.function_const_args
        );
    }

    qid.DefId ensure_async_callable_start_shim(
        self,
        qid.DefId source_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        token.Span span
    ) {
        mir.MirFunctionKey key = mir.MirFunctionKey(source_def, type_args, const_args);
        if (table.hash_table_get_value<mir.MirFunctionKey, qid.DefId>(
            self.lowerer.async_callable_start_shims$.ref(), key
        ) is .some(existing)) {
            return existing;
        }
        qid.DefId start_def = self.create_async_callable_abi_def(source_def, "__async_fn_start_", span);
        qid.DefId completion_def = self.create_async_callable_abi_def(
            source_def, "__async_fn_complete_", span
        );
        self.lowerer.async_callable_start_shims.set(key, start_def);
        self.lowerer.async_callable_completion_shims.set(key, completion_def);
        return start_def;
    }

    qid.DefId ensure_serial_completion_shim(
        self,
        qid.DefId source_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        token.Span span
    ) {
        mir.MirFunctionKey key = mir.MirFunctionKey(source_def, type_args, const_args);
        if (table.hash_table_get_value<mir.MirFunctionKey, qid.DefId>(
            self.lowerer.serial_completion_shims$.ref(), key
        ) is .some(existing)) {
            return existing;
        }
        qid.DefId shim_def = self.create_async_callable_abi_def(
            source_def, "__serial_task_complete_", span
        );
        self.lowerer.serial_completion_shims.set(key, shim_def);
        return shim_def;
    }

    qid.DefId create_async_callable_abi_def(
        self,
        qid.DefId source_def,
        UInt8[]& prefix,
        token.Span span
    ) {
        def.DefRecord source_record = self.lowerer.ctx.store.defs.get(source_def);
        std.String name = build_text_int(prefix, source_def.to_index());
        return self.lowerer.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            source_record.owner_def,
            source_record.module_id,
            source_record.decl_namespace_id,
            null
        );
    }

    mir.MirStaticValue lambda_drop_env_static_value(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        Bool heap_env,
        token.Span span
    ) {
        guard self.lowerer.typeck.lambda_capture_infos(lambda.function_def) is .some(captures) else {
            return self.closure_noop_drop_static_value(span);
        }
        if (captures.length == 0) {
            return self.closure_noop_drop_static_value(span);
        }
        qid.TypeId env_type = self.lambda_env_type_for_infos(lambda.function_def, captures, span);
        return mir.function_static_value(mir.MirFunctionRef (
            function_def: self.ensure_lambda_env_drop_shim(node_id, env_type, heap_env),
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.closure_drop_env_type(span),
            span: span
        ));
    }

    mir.MirStaticValue closure_noop_drop_static_value(self, token.Span span) {
        return mir.function_static_value(mir.MirFunctionRef (
            function_def: self.ensure_closure_noop_drop_shim(span),
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.closure_drop_env_type(span),
            span: span
        ));
    }

    qid.DefId create_closure_vtable_global_def(self, UInt8[]& name, token.Span span) {
        def.DefRecord function_record = self.lowerer.ctx.store.defs.get(self.hir_def.def_id);
        return self.lowerer.ctx.store.defs.create(
            .global_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
    }

    qid.TypeId lambda_env_type_for_infos(
        self,
        qid.DefId lambda_def,
        typeck_store.LambdaCaptureInfo[]& captures,
        token.Span span
    ) {
        qid.DefId env_def = self.create_lambda_env_struct_def(lambda_def, captures, span);
        return self.lowerer.ctx.store.types.named_type(env_def, span);
    }

    qid.DefId create_lambda_env_struct_def(
        self,
        qid.DefId lambda_def,
        typeck_store.LambdaCaptureInfo[]& captures,
        token.Span span
    ) {
        def.DefRecord lambda_record = self.lowerer.ctx.store.defs.get(lambda_def);
        // env struct 只作为 MIR/layout carrier；capture 语义仍来自 LambdaCaptureInfo。
        qid.DefId env_def = self.lowerer.ctx.store.defs.create(
            .struct_def,
            .type_name,
            .private_visibility,
            def.Name(symbol: self.lambda_env_struct_symbol(lambda_def), span: span),
            lambda_record.owner_def,
            lambda_record.module_id,
            lambda_record.decl_namespace_id,
            null
        );
        self.lowerer.ctx.store.source_map.set_sourceless_def_span(env_def, span);
        self.lowerer.hirs.declare_def(env_def, .type_decl);
        self.lowerer.ctx.store.types.bind_named_type_def(
            env_def,
            self.lowerer.ctx.store.types.named_type(env_def, span)
        );
        self.add_lambda_env_fields(env_def, captures, span);
        return env_def;
    }

    qid.SymbolId lambda_env_struct_symbol(self, qid.DefId lambda_def) {
        std.String name = build_text_int("__closure_env_", lambda_def.to_index());
        return self.lowerer.ctx.store.symbols.intern(name.bytes());
    }

    () add_lambda_env_fields(
        self,
        qid.DefId env_def,
        typeck_store.LambdaCaptureInfo[]& captures,
        token.Span span
    ) {
        Int index! = 0;
        while (index < captures.length) {
            self.add_lambda_env_field(env_def, captures[index], index, span);
            index = index + 1;
        }
    }

    () add_lambda_env_field(
        self,
        qid.DefId env_def,
        typeck_store.LambdaCaptureInfo info,
        Int index,
        token.Span span
    ) {
        def.DefRecord env_record = self.lowerer.ctx.store.defs.get(env_def);
        qid.DefId field_def = self.lowerer.ctx.store.defs.create(
            .field_def,
            .member_name,
            .private_visibility,
            def.Name(symbol: self.lambda_env_field_symbol(info, index), span: span),
            env_def,
            env_record.module_id,
            env_record.decl_namespace_id,
            null
        );
        self.lowerer.ctx.store.source_map.set_sourceless_def_span(field_def, span);
        self.lowerer.hirs.declare_def(field_def, .field_decl);
        self.lowerer.hirs.add_member(env_def, field_def);
        self.lowerer.typeck.set_def_type(field_def, self.lambda_env_capture_type(info));
    }

    qid.SymbolId lambda_env_field_symbol(self, typeck_store.LambdaCaptureInfo info, Int index) {
        if (self.lambda_env_capture_symbol(info) is .some(symbol)) {
            return symbol;
        }
        std.String name = build_text_int("_", index);
        return self.lowerer.ctx.store.symbols.intern(name.bytes());
    }

    qid.SymbolId? lambda_env_capture_symbol(self, typeck_store.LambdaCaptureInfo info) {
        if (info.kind == .explicit_capture) {
            return self.lowerer.ctx.store.defs.get(info.local_def).name.symbol;
        }
        if (info.source_def is .some(source_def)) {
            return self.lowerer.ctx.store.defs.get(source_def).name.symbol;
        }
        return null;
    }

    qid.TypeId lambda_env_capture_type(self, typeck_store.LambdaCaptureInfo info) {
        qid.TypeId type_id! = info.type_id;
        if (info.kind == .explicit_capture) {
            if (self.lowerer.typeck.def_type(info.local_def) is .some(local_type)) {
                type_id = local_type;
            }
        }
        return self.lowerer.substitute_type(type_id, self.substitutions);
    }

    qid.TypeId raw_pointer_type(self, qid.TypeId element_type, token.Span span) {
        return self.lowerer.ctx.store.types.raw_pointer_type(element_type, span);
    }

    () fill_lambda_env(self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        typeck_store.LambdaCaptureInfo[]& captures,
        mir.MirPlace env_value
    ) {
        Int index! = 0;
        while (index < captures.length) {
            typeck_store.LambdaCaptureInfo info = captures[index];
            mir.MirPlace field_place = self.project_constant_index(env_value, info.field_index);
            self.fill_lambda_capture(node_id, lambda, info, field_place);
            index = index + 1;
        }
    }

    () fill_lambda_capture(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        typeck_store.LambdaCaptureInfo info,
        mir.MirPlace field_place
    ) {
        if (info.kind == .explicit_capture) {
            hir.HirLambdaCapture capture = lambda.captures[info.field_index];
            hir.HirLocal local = self.lambda_capture_local(lambda.function_def, capture.local_id);
            if (local.borrow_binding) {
                self.lower_borrow_binding_initializer(capture.value, field_place);
                return;
            }
            self.lower_into_place(capture.value, field_place);
            return;
        }
        self.push_assign(
            field_place,
            mir.use_rvalue(mir.MirUseRvalue (value: self.lambda_capture_operand(node_id, lambda, info))),
            self.lowerer.hir_span(node_id)
        );
    }

    hir.HirLocal lambda_capture_local(self, qid.DefId lambda_def, hir.HirLocalId local_id) {
        hir.HirDef& lambda_hir = self.lowerer.hirs.def(lambda_def)$.some();
        guard lambda_hir.body is .some(ref _ body) else {
            return hir.HirLocal(local_id, .local_variable, qid.SymbolId(0), qid.DefId.from_index(0), false, false, null);
        }
        return body.local(local_id);
    }

    mir.MirOperand lambda_capture_operand(
        self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        typeck_store.LambdaCaptureInfo info
    ) {
        if (info.kind == .explicit_capture) {
            return self.lower_to_operand(lambda.captures[info.field_index].value);
        }
        if (info.source_def is .some(source_def)) {
            if (self.place_for_local_def(source_def) is .some(place)) {
                if (info.deref_on_use) {
                    return self.borrow_operand_from_place(place, self.lowerer.hir_span(node_id));
                }
                return self.operand_for_place(place);
            }
        }
        return self.unsupported_operand(node_id);
    }

    mir.MirOperand borrow_operand_from_place(self, mir.MirPlace place, token.Span span) {
        qid.TypeId reference_type = self.lowerer.ctx.store.types.reference_type(self.mir_place_type(place), span);
        mir.MirLocalId reference_local = self.add_temp(reference_type, span);
        mir.MirPlace reference_place = self.place_for_local(reference_local);
        self.push_assign(reference_place, mir.borrow_rvalue(mir.MirBorrowRvalue (place: place)), span);
        return self.operand_for_place(reference_place);
    }

    mir.MirOperand erased_lambda_env_address_operand(
        self,
        mir.MirPlace env_place,
        qid.TypeId env_pointer_type,
        token.Span span
    ) {
        qid.TypeId erased_type = self.closure_env_type(span);
        mir.MirLocalId erased_local = self.add_temp(erased_type, span);
        mir.MirPlace erased_place = self.place_for_local(erased_local);
        self.push_assign(
            erased_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(env_pointer_type, erased_type),
                value: self.lambda_env_address_operand(env_place, env_pointer_type, span),
                target_type: erased_type
            )),
            span
        );
        return self.operand_for_place(erased_place);
    }

    mir.MirOperand erased_lambda_env_pointer_operand(
        self,
        mir.MirPlace env_pointer_place,
        qid.TypeId env_pointer_type,
        mir.MirLocalId? capture_task,
        token.Span span
    ) {
        qid.TypeId erased_type = self.closure_env_type(span);
        mir.MirLocalId erased_local = self.add_optional_coroutine_capture_temp(
            erased_type, span, capture_task
        );
        mir.MirPlace erased_place = self.place_for_local(erased_local);
        self.push_assign(
            erased_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(env_pointer_type, erased_type),
                value: self.operand_for_place(env_pointer_place),
                target_type: erased_type
            )),
            span
        );
        return self.operand_for_place(erased_place);
    }

    mir.MirOperand lambda_env_address_operand(self,
        mir.MirPlace env_place,
        qid.TypeId env_pointer_type,
        token.Span span
    ) {
        mir.MirLocalId pointer_local = self.add_temp(env_pointer_type, span);
        mir.MirPlace pointer_place = self.place_for_local(pointer_local);
        self.push_assign(
            pointer_place,
            mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: true,
                place: env_place
            )),
            span
        );
        return self.operand_for_place(pointer_place);
    }

    () push_closure_assign(self,
        hir.HirId node_id,
        mir.MirPlace destination,
        qid.TypeId closure_type,
        mir.MirOperand env,
        mir.MirOperand vtable
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>(2);
        fields.add(env);
        fields.add(vtable);
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: mir.MirAggregateKind.struct_value,
                def_id: null,
                type_id: closure_type,
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.output.operand_slice(fields.slice())
            )),
            span
        );
    }

    qid.TypeId closure_env_type(self, token.Span span) {
        return self.lowerer.ctx.store.types.opaque_pointer_type(span);
    }

    qid.TypeId closure_drop_env_type(self, token.Span span) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.closure_env_type(span));
        return self.lowerer.ctx.store.types.function_type(
            params$.move(),
            self.lowerer.ctx.store.types.unit_type(),
            span
        );
    }

    qid.TypeId closure_vtable_type(self, qid.TypeId closure_type, token.Span span) {
        list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(2);
        fields.add(self.closure_code_type(closure_type));
        fields.add(self.closure_drop_env_type(span));
        return self.lowerer.ctx.store.types.tuple_type(fields$.move(), span);
    }

    qid.TypeId closure_vtable_pointer_type(self, qid.TypeId closure_type, token.Span span) {
        return self.raw_pointer_type(self.closure_vtable_type(closure_type, span), span);
    }

    qid.TypeId lambda_env_type_for_body(self, token.Span span) {
        guard self.lambda_capture_infos is .some(captures) else {
            return self.lowerer.ctx.store.types.unit_type();
        }
        return self.lambda_env_type_for_infos(self.hir_def.def_id, captures, span);
    }

    mir.MirPlace? lambda_capture_place_for_local(self, hir.HirLocalId local_id) {
        hir.HirLocal local = self.hir_local(local_id);
        return self.lambda_capture_place_for_local_def(local.def_id, true);
    }

    mir.MirPlace? lambda_capture_place_for_def(self, qid.DefId def_id) {
        return self.lambda_capture_place_for_local_def(def_id, false);
    }

    mir.MirPlace? lambda_capture_place_for_local_def(self, qid.DefId def_id, Bool explicit_only) {
        guard self.lambda_capture_infos is .some(captures) else { return null; }
        Int index! = 0;
        while (index < captures.length) {
            typeck_store.LambdaCaptureInfo info = captures[index];
            if (explicit_only && info.kind != .explicit_capture) {
                index = index + 1;
                continue;
            }
            if (self.lambda_capture_matches_def(info, def_id)) {
                mir.MirPlace field_place = self.lambda_capture_field_place(info, token.Span());
                if (self.lambda_capture_def_needs_deref(info, explicit_only)) {
                    return self.project_deref(field_place, false);
                }
                return field_place;
            }
            index = index + 1;
        }
        return null;
    }

    Bool lambda_capture_def_needs_deref(self, typeck_store.LambdaCaptureInfo info, Bool explicit_only) {
        if (explicit_only) { return false; }
        if (info.kind != .implicit_capture) { return false; }
        return info.deref_on_use;
    }

    Bool lambda_capture_matches_def(self, typeck_store.LambdaCaptureInfo info, qid.DefId def_id) {
        if (qid.DefId.equal(info.local_def$.ref(), def_id$.ref())) { return true; }
        if (info.kind != .implicit_capture) { return false; }
        if (info.source_def is .some(source_def)) {
            return qid.DefId.equal(source_def$.ref(), def_id$.ref());
        }
        return false;
    }

    mir.MirPlace lambda_capture_field_place(self, typeck_store.LambdaCaptureInfo info, token.Span span) {
        qid.TypeId env_type = self.lambda_env_type_for_body(span);
        qid.TypeId env_pointer_type = self.raw_pointer_type(env_type, span);
        mir.MirLocalId typed_env = self.add_temp(env_pointer_type, span);
        mir.MirPlace typed_env_place = self.place_for_local(typed_env);
        self.push_assign(
            typed_env_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(self.closure_env_type(span), env_pointer_type),
                value: self.operand_for_place(self.place_for_local(mir.MirLocalId.from_index(1))),
                target_type: env_pointer_type
            )),
            span
        );
        mir.MirPlace env_value = self.project_deref(typed_env_place, true);
        return self.project_constant_index(env_value, info.field_index);
    }

    Bool type_is_closure(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.kind == .closure;
    }

    Bool function_type_is_async(self, qid.TypeId type_id) {
        types.TypeInfo info! = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .owner_pointer || handle.kind == .reference) {
                info = self.lowerer.ctx.store.types.get(handle.element);
            }
        }
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.effects.has_async;
    }

    Bool type_is_closure_callable(self, qid.TypeId type_id) {
        if (self.type_is_closure(type_id)) { return true; }
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .owner_pointer && handle.kind != .reference) {
            return false;
        }
        return self.type_is_closure(handle.element);
    }

    mir.MirOperand? selected_name_ref_def_operand(self, hir.HirId node_id) {
        guard self.lowerer.typeck.member_selection(node_id) is .some(selected_def) else {
            return null;
        }
        if (!self.def_can_be_function_operand(selected_def)) {
            return null;
        }
        // `RawFn<...>` expected typing can refine an overloaded name_ref to a
        // different function def than the one resolve used as its initial
        // representative. MIR must lower that refined choice.
        return self.lower_def_operand(node_id, selected_def);
    }

    mir.MirOperand operand_for_place(self, mir.MirPlace place) {
        if (self.place_moves_by_default(place)) {
            return mir.move_operand_value(mir.MirMoveOperand (place: place));
        }
        return mir.copy_operand_value(mir.MirCopyOperand (place: place));
    }

    Bool place_moves_by_default(self, mir.MirPlace place) {
        if (place.projection.length != 0) {
            return false;
        }
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.lowerer.ctx);
        return query.type_needs_runtime_drop(self.mir_place_type(place));
    }

    () lower_member_access(self, hir.HirId node_id, hir.HirMemberAccess member_access, mir.MirPlace destination) {
        if (self.lowerer.typeck.expr_lowering(node_id) is .some(lowering_kind)) {
            if (lowering_kind == .trait_object_method_value) {
                self.push_assign(
                    destination,
                    mir.use_rvalue(mir.MirUseRvalue (value: self.trait_object_method_value_operand(node_id))),
                    self.lowerer.hir_span(node_id)
                );
                return;
            }
        }
        if (self.lowerer.typeck.member_selection(node_id) is .some(member_def)) {
            def.DefKind kind = self.lowerer.ctx.store.defs.get(member_def).kind;
            if (kind == .union_variant_def) {
                self.lower_empty_union_variant_value(node_id, member_def, destination);
                return;
            }
            if (kind == .enum_case_def || self.def_can_be_function_operand(member_def)) {
                self.push_assign(
                    destination,
                    mir.use_rvalue(mir.MirUseRvalue (value: self.lower_def_operand(node_id, member_def))),
                    self.lowerer.hir_span(node_id)
                );
                return;
            }
        }
        mir.MirOperand value = self.lower_operand(node_id);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue (value: value)), self.lowerer.hir_span(node_id));
    }

    () lower_empty_union_variant_value(self, hir.HirId node_id, qid.DefId variant_def, mir.MirPlace destination) {
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>();
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: mir.MirAggregateKind.union_variant,
                def_id: variant_def,
                type_id: self.type_for_node(node_id),
                tag: self.union_variant_tag_operand(node_id, variant_def),
                payload_field_index: self.union_variant_payload_field_index(node_id, variant_def),
                fields: self.lowerer.output.operand_array(fields$.ref())
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand lower_def_operand(self, hir.HirId node_id, qid.DefId def_id) {
        if (self.lowerer.ctx.store.defs.get(def_id).kind == .enum_case_def) {
            return mir.const_operand_value(mir.MirConst (
                type_id: self.type_for_node(node_id),
                span: self.lowerer.hir_span(node_id),
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: UInt64(self.enum_case_value_or_error(def_id)),
                    signed_value: true
                ))
            ));
        }
        if (self.const_global_operand(node_id, def_id) is .some(operand)) {
            return operand;
        }
        if (self.is_const_global_def(def_id)) {
            return self.unsupported_operand(node_id);
        }
        if (!self.def_can_be_function_operand(def_id)) {
            self.ensure_runtime_global_storage(node_id, def_id, self.type_for_node(node_id));
            Bool is_external! = false;
            if (self.lowerer.hirs.def(def_id) is .some(hir_def)) {
                is_external = hir_def.decl.is_external;
            }
            return mir.global_operand_value(mir.MirGlobalRef (
                global_def: def_id,
                type_id: self.type_for_node(node_id),
                is_external: is_external,
                span: self.lowerer.hir_span(node_id)
            ));
        }
        self.lowerer.ensure_external_function(def_id);
        qid.TypeId[]& type_args = self.function_ref_type_args(node_id, def_id);
        comptime_value.ComptimeValue[]& const_args = self.function_ref_const_args(node_id, def_id);
        qid.TypeId value_type = self.type_for_node(node_id);
        if (self.function_type_is_async(value_type) && self.internal_async_function_value(def_id)) {
            qid.DefId start_def = self.ensure_async_callable_start_shim(
                def_id, type_args, const_args, self.lowerer.hir_span(node_id)
            );
            return mir.function_operand_value(self.function_ref(
                node_id,
                start_def,
                value_type,
                self.lowerer.output.empty_type_args(),
                self.lowerer.output.empty_const_args()
            ));
        }
        return mir.function_operand_value(
            self.function_ref(node_id, def_id, value_type, type_args, const_args)
        );
    }

    Bool internal_async_function_value(self, qid.DefId function_def) {
        guard self.lowerer.hirs.def(function_def) is .some(hir_def) else { return false; }
        return self.lowerer.hirs.has_body(hir_def.def_id);
    }

    mir.MirOperand? const_global_operand(self, hir.HirId node_id, qid.DefId def_id) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else {
            return null;
        }
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return null;
        }
        qid.TypeId expected_type = self.type_for_node(node_id);
        // const initializer 的真实语义由 HIR comptime interpreter 记录到
        // ComptimeStore。MIR 这里只把已解释出的标量值转成运行期可用常量，
        // 避免旧 lower_const_expr 被迫支持完整 comptime HIR。
        if (self.lowerer.ctx.store.comptime_store.const_value(def_id) is .some(const_value)) {
            if (self.mir_const_from_comptime_value(node_id, const_value, expected_type) is .some(value)) {
                return mir.const_operand_value(value);
            }
            if (self.ensure_comptime_const_global(node_id, def_id, const_value, expected_type)) {
                return mir.global_operand_value(mir.MirGlobalRef (
                    global_def: def_id,
                    type_id: expected_type,
                    is_external: false,
                    span: self.lowerer.hir_span(node_id)
                ));
            }
        }
        guard hir_def.body is .some(ref _ body) else {
            return null;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        visiting.add(def_id);
        if (self.lower_const_expr(body.root, self.type_for_node(node_id), visiting$.ref()) is .some(value)) {
            return mir.const_operand_value(value);
        }
        self.mark_unsupported(body.root);
        return null;
    }

    Bool is_const_global_def(self, qid.DefId def_id) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else { return false; }
        return hir_def.decl.kind == .global_decl && hir_def.decl.is_const;
    }

    Bool ensure_runtime_global_storage(self, hir.HirId node_id, qid.DefId def_id, qid.TypeId type_id) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else { return false; }
        if (hir_def.decl.kind != .global_decl || hir_def.decl.is_const) {
            return false;
        }
        if (self.lowerer.output.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirStaticValue? initializer! = null;
        if (hir_def.body is .some(ref _ body)) {
            initializer = self.static_value_from_hir(body.root, type_id, span);
        }
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: def_id,
            type_id: type_id,
            span: span,
            read_only: false,
            is_external: hir_def.decl.is_external,
            initializer: initializer
        ));
        return true;
    }

    mir.MirConst? lower_comptime_const_value(self, hir.HirId node_id, qid.DefId def_id, qid.TypeId expected_type) {
        guard self.lowerer.ctx.store.comptime_store.const_value(def_id) is .some(const_value) else {
            return null;
        }
        return self.mir_const_from_comptime_value(node_id, const_value, expected_type);
    }

    Bool ensure_comptime_const_global(self,
        hir.HirId node_id,
        qid.DefId def_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        if (!self.comptime_value_needs_global_storage(const_value)) {
            return false;
        }
        if (self.lowerer.output.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        guard self.static_value_from_comptime(const_value, expected_type, span) is .some(initializer) else {
            return false;
        }
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: def_id,
            type_id: expected_type,
            span: span,
            read_only: true,
            is_external: false,
            initializer: initializer
        ));
        return true;
    }

    mir.MirStaticValue? static_value_from_hir(self, hir.HirId node_id, qid.TypeId expected_type, token.Span span) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return self.static_literal_value(node_id, literal, expected_type, span);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.static_array_literal_value(array_literal, expected_type, span);
        }
        return null;
    }

    mir.MirStaticValue? static_literal_value(self,
        hir.HirId node_id,
        hir.HirLiteral literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        return mir.scalar_static_value(self.lower_literal_as_const(node_id, literal, expected_type));
    }

    mir.MirStaticValue? static_array_literal_value(self,
        hir.HirArrayLiteral array_literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        list.ArrayList<mir.MirStaticField> fields! = list.ArrayList<mir.MirStaticField>(array_literal.items.length);
        Int index! = 0;
        while (index < array_literal.items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.static_value_from_hir(array_literal.items[index], item_type, span) is .some(value) else {
                return null;
            }
            fields.add(mir.MirStaticField(type_id: item_type, value: value));
            index = index + 1;
        }
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(fields$.ref()));
    }

    Bool comptime_value_needs_global_storage(self, comptime_value.ComptimeValue const_value) {
        if (const_value.data is .struct_value(_)) { return true; }
        if (const_value.data is .tuple_value(_)) { return true; }
        return const_value.data is .array_value(_);
    }

    mir.MirStaticValue? static_value_from_comptime(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.mir_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar)) {
            return mir.scalar_static_value(scalar);
        }
        if (const_value.data is .struct_value(fields)) {
            return self.static_struct_value(fields, expected_type, span);
        }
        if (const_value.data is .tuple_value(items)) {
            return self.static_sequence_value(items, expected_type, span);
        }
        if (const_value.data is .array_value(items)) {
            return self.static_sequence_value(items, expected_type, span);
        }
        return null;
    }

    mir.MirStaticValue? static_struct_value(self,
        comptime_value.ComptimeAggregateField[]& fields,
        qid.TypeId expected_type,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(expected_type);
        guard info.data is .named(named) else { return null; }
        guard self.lowerer.hirs.def(named.def_id) is .some(owner_hir) else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        list.ArrayList<mir.MirStaticField> static_fields! = list.ArrayList<mir.MirStaticField>();
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(fields, member_def) is .some(field_value) else { return null; }
                guard self.field_expected_type(member_def, substitutions$.ref()) is .some(field_type) else { return null; }
                guard self.static_value_from_comptime(field_value, field_type, span) is .some(static_value) else {
                    return null;
                }
                static_fields.add(mir.MirStaticField(type_id: field_type, value: static_value));
            }
            index = index + 1;
        }
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(static_fields$.ref()));
    }

    mir.MirStaticValue? static_sequence_value(self,
        comptime_value.ComptimeValue[]& items,
        qid.TypeId expected_type,
        token.Span span
    ) {
        list.ArrayList<mir.MirStaticField> static_fields! = list.ArrayList<mir.MirStaticField>(items.length);
        Int index! = 0;
        while (index < items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.static_value_from_comptime(items[index], item_type, span) is .some(static_value) else {
                return null;
            }
            static_fields.add(mir.MirStaticField(type_id: item_type, value: static_value));
            index = index + 1;
        }
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(static_fields$.ref()));
    }

    mir.MirConst? mir_const_from_comptime_value(self,
        hir.HirId node_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        if (const_value.data is .unit_value) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
            );
        }
        if (const_value.data is .bool_value(bool_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.bool_const_kind(mir.MirBoolConst (value: bool_value))
            );
        }
        if (const_value.data is .int_value(int_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: unsafe { int_value$.as(UInt64) },
                    signed_value: true
                ))
            );
        }
        if (const_value.data is .uint_value(uint_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: uint_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .char_value(char_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: char_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .float_bits(float_bits)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.float_const_kind(mir.MirFloatConst (value: self.float64_from_bits(float_bits)))
            );
        }
        if (const_value.data is .symbol_value(symbol_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.string_const_kind(mir.MirStringConst (
                    symbol_id: symbol_value,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .enum_case_value(case_def)) {
            return self.enum_case_int_const(case_def, expected_type, span);
        }
        return null;
    }

    comptime_value.ComptimeValue? comptime_value_for_expr(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.substitutions.const_binding(def_id) is .some(const_value)) {
                return const_value;
            }
            return self.lowerer.ctx.store.comptime_store.const_value(def_id);
        }
        if (node.data is .member_access(member_access)) {
            guard self.lowerer.typeck.member_selection(node_id) is .some(member_def) else { return null; }
            if (self.lowerer.ctx.store.defs.get(member_def).kind != .field_def) {
                return null;
            }
            guard self.comptime_value_for_expr(member_access.base) is .some(base_value) else { return null; }
            return self.comptime_field_value(node_id, base_value, member_def);
        }
        return null;
    }

    comptime_value.ComptimeValue? comptime_field_value(self,
        hir.HirId node_id,
        comptime_value.ComptimeValue base_value,
        qid.DefId field_def
    ) {
        guard base_value.data is .struct_value(fields) else { return null; }
        Int index! = 0;
        while (index < fields.length) {
            if (fields[index].field_def.to_index() == field_def.to_index()) {
                comptime_value.ComptimeValue field_value = fields[index].value;
                return comptime_value.ComptimeValue(type_id: self.type_for_node(node_id), data: field_value.data);
            }
            index = index + 1;
        }
        return null;
    }

    Bool lower_comptime_value_into_place(self,
        hir.HirId node_id,
        comptime_value.ComptimeValue const_value,
        mir.MirPlace destination
    ) {
        qid.TypeId expected_type = self.mir_place_type(destination);
        token.Span span = self.lowerer.hir_span(node_id);
        if (self.mir_const_from_comptime_value(node_id, const_value, expected_type) is .some(scalar_const)) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (value: mir.const_operand_value(scalar_const))),
                span
            );
            return true;
        }
        if (const_value.data is .struct_value(fields)) {
            guard self.comptime_struct_aggregate(fields, expected_type, span) is .some(aggregate) else {
                return false;
            }
            self.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .tuple_value(items)) {
            guard self.comptime_sequence_aggregate(
                mir.MirAggregateKind.tuple,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        if (const_value.data is .array_value(items)) {
            guard self.comptime_sequence_aggregate(
                mir.MirAggregateKind.array,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        return false;
    }

    mir.MirAggregateRvalue? comptime_struct_aggregate(self,
        comptime_value.ComptimeAggregateField[]& fields,
        qid.TypeId expected_type,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(expected_type);
        guard info.data is .named(named) else { return null; }
        guard self.lowerer.hirs.def(named.def_id) is .some(owner_hir) else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        list.ArrayList<mir.MirOperand> operands! = list.ArrayList<mir.MirOperand>();
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(fields, member_def) is .some(field_value) else { return null; }
                guard self.field_expected_type(member_def, substitutions$.ref()) is .some(field_type) else { return null; }
                guard self.comptime_value_operand(field_value, field_type, span) is .some(operand) else { return null; }
                operands.add(operand);
            }
            index = index + 1;
        }
        return mir.MirAggregateRvalue (
            kind: mir.MirAggregateKind.struct_value,
            def_id: named.def_id,
            type_id: expected_type,
            tag: null,
            payload_field_index: -1,
            fields: self.lowerer.output.operand_array(operands$.ref())
        );
    }

    comptime_value.ComptimeValue? comptime_struct_field(self,
        comptime_value.ComptimeAggregateField[]& fields,
        qid.DefId field_def
    ) {
        Int index! = 0;
        while (index < fields.length) {
            if (fields[index].field_def.to_index() == field_def.to_index()) {
                return fields[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirAggregateRvalue? comptime_sequence_aggregate(self,
        mir.MirAggregateKind kind,
        qid.DefId? def_id,
        qid.TypeId expected_type,
        comptime_value.ComptimeValue[]& items,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> operands! = list.ArrayList<mir.MirOperand>(items.length);
        Int index! = 0;
        while (index < items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.comptime_value_operand(items[index], item_type, span) is .some(operand) else { return null; }
            operands.add(operand);
            index = index + 1;
        }
        return mir.MirAggregateRvalue (
            kind: kind,
            def_id: def_id,
            type_id: expected_type,
            tag: null,
            payload_field_index: -1,
            fields: self.lowerer.output.operand_array(operands$.ref())
        );
    }

    mir.MirOperand? comptime_value_operand(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.mir_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            return mir.const_operand_value(scalar_const);
        }
        mir.MirLocalId temp = self.add_temp(expected_type, span);
        guard self.lower_comptime_value_into_place_at_span(const_value, self.place_for_local(temp), span) else {
            return null;
        }
        return mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(temp)));
    }

    Bool lower_comptime_value_into_place_at_span(self,
        comptime_value.ComptimeValue const_value,
        mir.MirPlace destination,
        token.Span span
    ) {
        qid.TypeId expected_type = self.mir_place_type(destination);
        if (self.mir_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (value: mir.const_operand_value(scalar_const))),
                span
            );
            return true;
        }
        if (const_value.data is .struct_value(fields)) {
            guard self.comptime_struct_aggregate(fields, expected_type, span) is .some(aggregate) else {
                return false;
            }
            self.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .tuple_value(items)) {
            guard self.comptime_sequence_aggregate(
                mir.MirAggregateKind.tuple,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        if (const_value.data is .array_value(items)) {
            guard self.comptime_sequence_aggregate(
                mir.MirAggregateKind.array,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        return false;
    }

    mir.MirConst? mir_const_from_comptime_value_for_span(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (const_value.data is .unit_value) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
            );
        }
        if (const_value.data is .bool_value(bool_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.bool_const_kind(mir.MirBoolConst (value: bool_value))
            );
        }
        if (const_value.data is .int_value(int_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: unsafe { int_value$.as(UInt64) },
                    signed_value: true
                ))
            );
        }
        if (const_value.data is .uint_value(uint_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: uint_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .char_value(char_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (
                    bits: char_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .float_bits(float_bits)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.float_const_kind(mir.MirFloatConst (value: self.float64_from_bits(float_bits)))
            );
        }
        if (const_value.data is .symbol_value(symbol_value)) {
            return mir.MirConst (
                type_id: expected_type,
                span: span,
                value: mir.string_const_kind(mir.MirStringConst (
                    symbol_id: symbol_value,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .enum_case_value(case_def)) {
            return self.enum_case_int_const(case_def, expected_type, span);
        }
        return null;
    }

    Bool def_can_be_function_operand(self, qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.store.defs.get(def_id).kind;
        if (kind == .function_def || kind == .init_def) {
            return true;
        }
        return kind == .deinit_def;
    }

    qid.TypeId[]& function_ref_type_args(self, hir.HirId node_id, qid.DefId def_id) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == def_id) {
                return self.concrete_instance_type_args(instance.type_args);
            }
        }
        return self.lowerer.output.empty_type_args();
    }

    mir.MirPlace? place_for_expr(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                if (self.lambda_capture_place_for_local(local_id) is .some(capture_place)) {
                    return capture_place;
                }
                return self.place_for_local(self.mir_local_for_hir(local_id));
            }
            if (name_ref is .def_ref(def_id)) {
                if (self.place_for_local_def(def_id) is .some(place)) {
                    return place;
                }
                if (self.lambda_capture_place_for_def(def_id) is .some(capture_place)) {
                    return capture_place;
                }
                guard self.place_for_global_def(node_id, def_id) is .some(global_place) else {
                    return null;
                }
                return global_place;
            }
            return null;
        }
        if (node.data is .member_access(member_access)) {
            guard self.place_for_member(node_id, member_access) is .some(member_place) else {
                return null;
            }
            return member_place;
        }
        if (node.data is .index_access(index_access)) {
            if (self.lowerer.typeck.member_selection(node_id) != null) {
                return null;
            }
            guard self.place_for_index(index_access) is .some(index_place) else {
                return null;
            }
            return index_place;
        }
        return null;
    }

    mir.MirPlace? place_for_local_def(self, qid.DefId def_id) {
        guard self.hir_def.body is .some(ref _ body) else { return null; }
        Int index! = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            if (qid.DefId.equal(local.def_id$.ref(), def_id$.ref())) {
                return self.place_for_local(self.mir_local_for_hir(local.id));
            }
            index = index + 1;
        }
        return null;
    }

    mir.MirPlace? place_for_global_def(self, hir.HirId node_id, qid.DefId def_id) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else {
            return null;
        }
        if (hir_def.decl.kind != .global_decl || hir_def.decl.is_const) {
            return null;
        }
        qid.TypeId type_id = self.type_for_node(node_id);
        if (!self.ensure_runtime_global_storage(node_id, def_id, type_id)) {
            return null;
        }
        return mir.global_place(
            mir.MirGlobalRef(
                global_def: def_id,
                type_id: type_id,
                is_external: hir_def.decl.is_external,
                span: self.lowerer.hir_span(node_id)
            ),
            self.lowerer.output.empty_projection()
        );
    }

    mir.MirPlace? place_for_member(self, hir.HirId node_id, hir.HirMemberAccess member_access) {
        if (self.is_slice_length_access(member_access)) {
            mir.MirPlace base = self.pointer_base_place(member_access.base);
            return self.project_constant_index(base, 1);
        }
        if (self.trait_companion_member_place(member_access) is .some(place)) {
            return place;
        }
        guard self.lowerer.typeck.member_selection(node_id) is .some(member_def) else {
            return null;
        }
        if (self.lowerer.ctx.store.defs.get(member_def).kind != .field_def) {
            return null;
        }
        mir.MirPlace base! = self.pointer_base_place(member_access.base);
        if (self.member_base_needs_deref(base)) {
            base = self.project_deref(base, self.place_is_raw_pointer(base));
        }
        return self.project_field(base, member_def, self.type_for_node(node_id));
    }

    mir.MirPlace? trait_companion_member_place(self, hir.HirMemberAccess member_access) {
        qid.TypeId base_type = self.member_lookup_value_type(self.receiver_expr_type(member_access.base));
        guard self.trait_companion_for_type(base_type) is .some(companion) else { return null; }
        mir.MirPlace any_place = self.member_lookup_base_place(member_access.base);
        if (companion.kind == .any) {
            if (self.symbol_text_equal(member_access.member_symbol, "receiver")) {
                return self.project_constant_index(any_place, 0);
            }
            return null;
        }
        if (companion.kind != .vtable) { return null; }
        guard self.trait_member_for_symbol(companion.trait_def, member_access.member_symbol) is .some(method_def) else {
            return null;
        }
        guard self.trait_vtable_slot_index(companion.trait_def, method_def) is .some(slot_index) else {
            return null;
        }
        return self.project_constant_index(any_place, slot_index + 1);
    }

    mir.MirPlace member_lookup_base_place(self, hir.HirId base_id) {
        mir.MirPlace base! = self.pointer_base_place(base_id);
        if (self.member_base_needs_deref(base)) {
            base = self.project_deref(base, self.place_is_raw_pointer(base));
        }
        return base;
    }

    Bool member_base_needs_deref(self, mir.MirPlace base) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(base));
        guard info.data is .handle_type(handle) else { return false; }
        if (self.handle_is_trait_object(handle)) { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .raw_pointer;
    }

    Bool handle_is_trait_object(self, types.HandleType handle) {
        if (handle.kind != .reference && handle.kind != .owner_pointer) {
            return false;
        }
        types.TypeInfo element = self.lowerer.ctx.store.types.get(handle.element);
        guard element.data is .trait_companion(companion) else { return false; }
        return companion.kind == .any;
    }

    // MIR 的 field projection 必须在这里固化成 layout field index。backend 只能
    // 按 index 取地址，不能再根据 DefId/name 重新解释语言层字段关系。
    @life(self > return, base > return)
    mir.MirPlace project_field(self, mir.MirPlace base, qid.DefId field_def, qid.TypeId field_type) {
        qid.TypeId owner_type = self.mir_place_type(base);
        guard self.layout_field_index_for_def(owner_type, field_def) is .some(field_index) else {
            self.lowerer.output.mark_error();
            self.add_field_projection_layout_diagnostic(owner_type, field_def);
            return base;
        }
        return self.project_field_at_index(base, field_def, field_type, field_index);
    }

    mir.MirPlace project_field_at_index(self,
        mir.MirPlace base,
        qid.DefId field_def,
        qid.TypeId field_type,
        Int field_index
    ) {
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(mir.field_projection_elem(mir.MirFieldProjection (
            field_def: field_def,
            field_type: field_type,
            field_index: field_index
        )));
        return self.place_with_projection(base, elems$.ref());
    }

    qid.TypeId mir_place_type(self, mir.MirPlace place) {
        qid.TypeId current! = self.mir_place_base_type(place);
        Int index! = 0;
        while (index < place.projection.length) {
            mir.MirPlaceElem elem = place.projection[index];
            if (elem is .field_projection(field)) {
                current = field.field_type;
            } else if (elem is .constant_index_projection(constant_index)) {
                current = self.constant_index_projection_type(current, constant_index.offset);
            } else {
                current = self.pointer_like_element_type(current);
            }
            index = index + 1;
        }
        return current;
    }

    qid.TypeId constant_index_projection_type(self, qid.TypeId type_id, Int offset) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .tuple_type(tuple_type)) {
            assert(offset >= 0 && offset < tuple_type.items.length);
            return tuple_type.items[offset];
        }
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        assert(offset >= 0 && offset < type_layout.fields.length);
        return type_layout.fields[offset].field_type;
    }

    qid.TypeId mir_place_base_type(self, mir.MirPlace place) {
        if (place.base is .global(global_ref)) {
            return global_ref.type_id;
        }
        return self.locals.get(place.local_id.to_index()).type_id;
    }

    qid.TypeId pointer_like_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (self.handle_is_owned_slice_value(handle)) {
                return self.owned_slice_value_handle_element_type(handle);
            }
            return handle.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    qid.TypeId owned_slice_value_handle_element_type(self, types.HandleType handle) {
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(array_type) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        return array_type.element;
    }

    Int? layout_field_index_for_def(self, qid.TypeId owner_type, qid.DefId field_def) {
        layout.TypeLayout owner_layout = self.layout_for_type(owner_type);
        Int index! = 0;
        while (index < owner_layout.fields.length) {
            if (owner_layout.fields[index].field_def is .some(candidate)) {
                if (candidate.to_index() == field_def.to_index()) {
                    return index;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Bool is_slice_length_access(self, hir.HirMemberAccess member_access) {
        if (!self.symbol_text_equal(member_access.member_symbol, "length")) {
            return false;
        }
        qid.TypeId base_type = self.type_for_node(member_access.base);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .slice) { return true; }
        return self.handle_is_owned_slice_value(handle);
    }

    Bool handle_is_owned_slice_value(self, types.HandleType handle) {
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    Bool symbol_text_equal(self, qid.SymbolId symbol, UInt8[]& text) {
        return string.equal(self.lowerer.ctx.store.symbols.text(symbol), text);
    }

    mir.MirPlace project_constant_index(self, mir.MirPlace base, Int offset) {
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: offset)));
        return self.place_with_projection(base, elems$.ref());
    }

    mir.MirPlace? place_for_index(self, hir.HirIndexAccess index_access) {
        guard self.place_for_expr(index_access.base) is .some(base) else {
            return null;
        }
        mir.MirLocalId index_local = self.index_local_for_expr(index_access.index);
        return self.project_index(base, index_local);
    }

    mir.MirLocalId index_local_for_expr(self, hir.HirId index_id) {
        if (self.place_for_expr(index_id) is .some(index_place)) {
            if (index_place.projection.length == 0) {
                return index_place.local_id;
            }
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(index_id), self.lowerer.hir_span(index_id));
        self.lower_into_place(index_id, self.place_for_local(temp));
        return temp;
    }

    mir.MirPlace project_index(self, mir.MirPlace base, mir.MirLocalId index_local) {
        list.ArrayList<mir.MirPlaceElem> elems! = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(mir.index_projection_elem(mir.MirIndexProjection (index_local: index_local)));
        return self.place_with_projection(base, elems$.ref());
    }

    () finish_return(self, Bool implicit_unit, token.Span span) {
        self.finish_block(mir.return_terminator_kind(mir.MirReturnTerminator (implicit_unit: implicit_unit)), span);
    }

    mir.MirConst lower_const(self, hir.HirId node_id, hir.HirLiteral literal) {
        token.Span span = self.lowerer.hir_span(node_id);
        // literal 的目标类型也可能是泛型参数，例如 T id<T>(T value)
        // 内部的返回值；type_for_node 会自动套用当前 instance substitution。
        qid.TypeId type_id = self.type_for_node(node_id);
        return self.lower_literal_as_const(node_id, literal, type_id);
    }

    mir.MirConst lower_literal_as_const(self, hir.HirId node_id, hir.HirLiteral literal, qid.TypeId type_id) {
        token.Span span = self.lowerer.hir_span(node_id);
        if (literal.value is .int_value(int_value)) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: int_value.bits, signed_value: int_value.signed_value))
            );
        }
        if (literal.value is .float_value(float_value)) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.float_const_kind(mir.MirFloatConst (value: float_value.value))
            );
        }
        if (literal.value is .bool_value(bool_value)) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.bool_const_kind(mir.MirBoolConst (value: bool_value))
            );
        }
        if (literal.value is .string_value(symbol_id)) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.string_const_kind(mir.MirStringConst (
                    symbol_id: symbol_id,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(type_id)
                ))
            );
        }
        if (literal.value is .char_value(char_value)) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(char_value), signed_value: false))
            );
        }
        if (literal.value is .null_value) {
            return mir.MirConst (
                type_id: type_id,
                span: span,
                value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
            );
        }
        return mir.MirConst (
            type_id: type_id,
            span: span,
            value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
        );
    }

    mir.MirConst? lower_const_expr(self,
        hir.HirId node_id,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return self.lower_literal_as_const(node_id, literal, expected_type);
        }
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.lowerer.ctx.store.defs.get(def_id).kind == .enum_case_def) {
                return self.enum_case_int_const(def_id, expected_type, self.lowerer.hir_span(node_id));
            }
            return self.lower_const_def_ref(node_id, def_id, visiting);
        }
        if (node.data is .member_access(_)) {
            if (self.enum_case_def_for_value(node_id) is .some(case_def)) {
                return self.enum_case_int_const(case_def, expected_type, self.lowerer.hir_span(node_id));
            }
            return null;
        }
        if (node.data is .unary(unary)) {
            return self.lower_const_unary(node_id, unary, expected_type, visiting);
        }
        if (node.data is .binary(binary)) {
            return self.lower_const_binary(node_id, binary, expected_type, visiting);
        }
        return null;
    }

    mir.MirConst? lower_const_def_ref(self,
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else { return null; }
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return null;
        }
        if (self.const_visiting_contains(visiting, def_id)) {
            return null;
        }
        guard hir_def.body is .some(ref _ body) else { return null; }
        visiting.add(def_id);
        mir.MirConst? result = self.lower_const_expr(body.root, self.type_for_node(node_id), visiting);
        visiting.pop();
        return result;
    }

    Bool const_visiting_contains(self, list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    mir.MirConst? lower_const_unary(self,
        hir.HirId node_id,
        hir.HirUnary unary,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        qid.TypeId value_type = self.type_for_node(unary.value);
        guard self.lower_const_expr(unary.value, value_type, visiting) is .some(value) else {
            return null;
        }
        if (unary.op == .not) {
            guard value.value is .bool_value(bool_value) else { return null; }
            return self.bool_const_for_node(node_id, !bool_value.value);
        }
        guard value.value is .int_value(int_value) else { return null; }
        if (unary.op == .negate) {
            return self.int_const_for_node(node_id, expected_type, UInt64(0) - int_value.bits, int_value.signed_value);
        }
        if (unary.op == .bit_not) {
            return self.int_const_for_node(node_id, expected_type, ~int_value.bits, int_value.signed_value);
        }
        return null;
    }

    mir.MirConst? lower_const_binary(self,
        hir.HirId node_id,
        hir.HirBinary binary,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        qid.TypeId left_type = self.type_for_node(binary.left);
        qid.TypeId right_type = self.type_for_node(binary.right);
        guard self.lower_const_expr(binary.left, left_type, visiting) is .some(left) else { return null; }
        guard self.lower_const_expr(binary.right, right_type, visiting) is .some(right) else { return null; }
        if (left.value is .bool_value(left_bool)) {
            guard right.value is .bool_value(right_bool) else { return null; }
            return self.lower_const_bool_binary(node_id, binary.op, left_bool.value, right_bool.value);
        }
        guard left.value is .int_value(left_int) else { return null; }
        guard right.value is .int_value(right_int) else { return null; }
        return self.lower_const_int_binary(node_id, binary.op, expected_type, left_int, right_int);
    }

    mir.MirConst? lower_const_bool_binary(self, hir.HirId node_id, hir.HirBinaryOp op, Bool left, Bool right) {
        if (op == .logic_and) { return self.bool_const_for_node(node_id, left && right); }
        if (op == .logic_or) { return self.bool_const_for_node(node_id, left || right); }
        if (op == .equal) { return self.bool_const_for_node(node_id, left == right); }
        if (op == .not_equal) { return self.bool_const_for_node(node_id, left != right); }
        return null;
    }

    mir.MirConst? lower_const_int_binary(self,
        hir.HirId node_id,
        hir.HirBinaryOp op,
        qid.TypeId expected_type,
        mir.MirIntConst left,
        mir.MirIntConst right
    ) {
        if (op == .equal) { return self.bool_const_for_node(node_id, left.bits == right.bits); }
        if (op == .not_equal) { return self.bool_const_for_node(node_id, left.bits != right.bits); }
        if (op == .less) { return self.bool_const_for_node(node_id, left.bits < right.bits); }
        if (op == .less_equal) { return self.bool_const_for_node(node_id, left.bits <= right.bits); }
        if (op == .greater) { return self.bool_const_for_node(node_id, left.bits > right.bits); }
        if (op == .greater_equal) { return self.bool_const_for_node(node_id, left.bits >= right.bits); }
        if (op == .add) { return self.int_const_for_node(node_id, expected_type, left.bits + right.bits, left.signed_value); }
        if (op == .sub) { return self.int_const_for_node(node_id, expected_type, left.bits - right.bits, left.signed_value); }
        if (op == .mul) { return self.int_const_for_node(node_id, expected_type, left.bits * right.bits, left.signed_value); }
        if (op == .div) {
            if (right.bits == UInt64(0)) { return null; }
            return self.int_const_for_node(node_id, expected_type, left.bits / right.bits, left.signed_value);
        }
        if (op == .mod) {
            if (right.bits == UInt64(0)) { return null; }
            return self.int_const_for_node(node_id, expected_type, left.bits % right.bits, left.signed_value);
        }
        if (op == .bit_and) { return self.int_const_for_node(node_id, expected_type, left.bits & right.bits, left.signed_value); }
        if (op == .bit_or) { return self.int_const_for_node(node_id, expected_type, left.bits | right.bits, left.signed_value); }
        if (op == .bit_xor) { return self.int_const_for_node(node_id, expected_type, left.bits ^ right.bits, left.signed_value); }
        if (op == .shift_left) { return self.int_const_for_node(node_id, expected_type, left.bits << right.bits, left.signed_value); }
        if (op == .shift_right) { return self.int_const_for_node(node_id, expected_type, left.bits >> right.bits, left.signed_value); }
        return null;
    }

    mir.MirConst bool_const_for_node(self, hir.HirId node_id, Bool value) {
        return mir.MirConst (
            type_id: self.type_for_node(node_id),
            span: self.lowerer.hir_span(node_id),
            value: mir.bool_const_kind(mir.MirBoolConst (value: value))
        );
    }

    mir.MirConst int_const_for_node(self, hir.HirId node_id, qid.TypeId type_id, UInt64 bits, Bool signed_value) {
        return mir.MirConst (
            type_id: type_id,
            span: self.lowerer.hir_span(node_id),
            value: mir.int_const_kind(mir.MirIntConst (bits: bits, signed_value: signed_value))
        );
    }

    () lower_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (self.is_enum_init_call(node_id, call) || self.is_enum_type_constructor_call(node_id, call)) {
            self.lower_enum_init_call(node_id, call, destination);
            return;
        }
        if (self.lowerer.typeck.expr_lowering(node_id) is .some(lowering_kind)) {
            self.lower_special_call(node_id, call, lowering_kind, destination);
            return;
        }
        if (self.call_can_lower_builtin_primitive_hash(call)) {
            self.lower_core_hash_call(node_id, call, destination);
            return;
        }
        if (self.call_can_lower_core_contiguous(call)) {
            self.lower_core_contiguous_call(node_id, call, destination);
            return;
        }
        if (self.lowerer.ctx.store.typeck.member_selection(call.callee) is .some(member_def)) {
            def.DefKind kind = self.lowerer.ctx.store.defs.get(member_def).kind;
            if (kind == .init_def) {
                self.lower_init_constructor_call(node_id, call, member_def, destination);
                return;
            }
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, member_def, destination);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, member_def, destination);
                return;
            }
        }
        if (call.target is .some(target)) {
            def.DefKind kind = self.lowerer.ctx.store.defs.get(target.def_id).kind;
            if (self.is_assert_call(target.def_id, kind)) {
                self.lower_builtin_assert(node_id, call);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, target.def_id, destination);
                return;
            }
            if (kind == .init_def) {
                self.lower_init_constructor_call(node_id, call, target.def_id, destination);
                return;
            }
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, target.def_id, destination);
                return;
            }
        }
        if (self.call_callee_def(call.callee) is .some(callee_def)) {
            def.DefKind callee_kind = self.lowerer.ctx.store.defs.get(callee_def).kind;
            if (self.is_assert_call(callee_def, callee_kind)) {
                self.lower_builtin_assert(node_id, call);
                return;
            }
        }
        if (self.type_is_closure_callable(self.type_for_node(call.callee))) {
            self.lower_closure_call(node_id, call, destination);
            return;
        }
        if (self.function_type_is_async(self.type_for_node(call.callee))) {
            self.lower_async_raw_fn_call(node_id, call, destination);
            return;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length);
        mir.MirCallCallee callee = mir.indirect_operand_callee(self.lower_to_operand(call.callee));
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(self.type_for_node(call.callee)),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_async_raw_fn_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId source_type = self.type_for_node(call.callee);
        qid.TypeId abi_type = self.lowerer.external_async_abi_function_type(source_type, span);
        mir.MirLocalId abi_callee = self.add_temp(abi_type, span);
        self.push_assign(
            self.place_for_local(abi_callee),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_ptr,
                value: self.lower_to_operand(call.callee),
                target_type: abi_type
            )),
            span
        );
        mir.MirExternalContinuationLayout layout = self.lowerer.external_async_continuation_layout(
            self.mir_place_type(destination), span
        );
        mir.MirLocalId continuation = self.add_temp(layout.type_id, span);
        mir.MirPlace continuation_place = self.place_for_local(continuation);
        self.initialize_current_async_continuation(layout, continuation_place, destination, span);
        mir.MirLocalId continuation_pointer = self.add_temp(layout.pointer_type_id, span);
        self.push_assign(
            self.place_for_local(continuation_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length + 1);
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        self.finish_async_indirect_start(
            self.operand_for_place(self.place_for_local(abi_callee)), args$.ref(), span
        );
    }

    () lower_closure_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (self.function_type_is_async(self.type_for_node(call.callee))) {
            self.lower_async_closure_call(node_id, call, destination);
            return;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length + 1);
        mir.MirCallCallee callee = mir.indirect_operand_callee(self.closure_call_operand(call.callee));
        args.add(self.closure_env_operand(call.callee));
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(self.type_for_node(call.callee)),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_async_closure_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        hir.HirId callee_id = call.callee;
        hir.HirCallArg[]& call_args = call.args;
        if (self.known_async_lambda(callee_id) is .some(lambda)) {
            token.Span direct_span = self.lowerer.hir_span(node_id);
            list.ArrayList<mir.MirOperand> direct_args! =
                list.ArrayList<mir.MirOperand>(call_args.length + 1);
            direct_args.add(self.closure_env_operand(callee_id));
            Int direct_index! = 0;
            while (direct_index < call_args.length) {
                direct_args.add(self.lower_to_operand(call_args[direct_index].value));
                direct_index = direct_index + 1;
            }
            self.lower_async_direct_call(
                node_id,
                lambda.function_def,
                self.function_type_args,
                self.function_const_args,
                self.lowerer.output.operand_array(direct_args$.ref()),
                destination,
                direct_span
            );
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirExternalContinuationLayout layout = self.lowerer.external_async_continuation_layout(
            self.mir_place_type(destination), span
        );
        mir.MirLocalId continuation = self.add_temp(layout.type_id, span);
        mir.MirPlace continuation_place = self.place_for_local(continuation);
        self.initialize_current_async_continuation(layout, continuation_place, destination, span);
        mir.MirLocalId continuation_pointer = self.add_temp(layout.pointer_type_id, span);
        self.push_assign(
            self.place_for_local(continuation_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length + 2);
        args.add(self.closure_env_operand(call.callee));
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        self.finish_async_indirect_start(self.closure_call_operand(call.callee), args$.ref(), span);
    }

    hir.HirLambda? known_async_lambda(self, hir.HirId callee_id) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        guard callee.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .local(local_id) else { return null; }
        guard table.hash_table_get_value<Int, hir.HirId>(
            self.known_lambda_initializers$.ref(), local_id.to_index()
        ) is .some(initializer) else { return null; }
        hir.HirNode node = self.lowerer.hirs.node(initializer);
        guard node.data is .lambda_expr(lambda) else { return null; }
        if (!self.function_type_is_async(self.type_for_node(callee_id))) { return null; }
        return lambda;
    }

    () initialize_current_async_continuation(
        self,
        mir.MirExternalContinuationLayout layout,
        mir.MirPlace continuation_place,
        mir.MirPlace destination,
        token.Span span
    ) {
        mir.MirRvalue context = mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: self.place_for_local(self.return_local()),
            frame_root: true
        ));
        qid.TypeId context_type = self.lowerer.coroutine_context_pointer_type(span);
        mir.MirOperand resume = mir.function_operand_value(mir.MirFunctionRef (
            function_def: self.hir_def.def_id,
            type_args: self.lowerer.output.type_arg_array(self.function_type_args),
            const_args: self.lowerer.output.const_arg_array(self.function_const_args),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: self.lowerer.coroutine_continuation_type(context_type, span),
            span: span
        ));
        self.initialize_external_async_continuation(
            layout,
            continuation_place,
            destination,
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            context,
            resume,
            span
        );
    }

    () finish_async_indirect_start(
        self,
        mir.MirOperand callee,
        list.ArrayList<mir.MirOperand>& args,
        token.Span span
    ) {
        self.finish_async_start(
            mir.indirect_operand_callee(callee), args, .dynamic, null, span
        );
    }

    () finish_async_direct_start(
        self,
        mir.MirFunctionRef callee,
        mir.MirFunctionRef child_resume,
        list.ArrayList<mir.MirOperand>& args,
        token.Span span
    ) {
        self.finish_async_start(
            mir.direct_function_callee(callee),
            args,
            .direct_child,
            child_resume,
            span
        );
    }

    () finish_async_start(
        self,
        mir.MirCallCallee callee,
        list.ArrayList<mir.MirOperand>& args,
        mir.MirSuspendWakeKind suspend_wake,
        mir.MirFunctionRef? suspend_child,
        token.Span span
    ) {
        mir.MirLocalId unit_result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId next_block = self.reserve_block(span);
        self.compare_exchange_passive_cancel_target(0, 3, span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: suspend_wake,
            suspend_child: suspend_child,
            task_handoff: true,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
        self.compare_exchange_passive_cancel_target(3, 0, span);
    }

    mir.MirOperand closure_call_operand(self, hir.HirId callee_id) {
        mir.MirPlace closure_place = self.closure_callee_place(callee_id);
        mir.MirPlace vtable_ptr = self.project_constant_index(closure_place, 1);
        mir.MirPlace vtable = self.project_deref(vtable_ptr, true);
        mir.MirPlace call_place = self.project_constant_index(vtable, 0);
        return mir.copy_operand_value(mir.MirCopyOperand (place: call_place));
    }

    mir.MirOperand closure_env_operand(self, hir.HirId callee_id) {
        mir.MirPlace closure_place = self.closure_callee_place(callee_id);
        mir.MirPlace env_place = self.project_constant_index(closure_place, 0);
        return mir.copy_operand_value(mir.MirCopyOperand (place: env_place));
    }

    mir.MirPlace closure_callee_place(self, hir.HirId callee_id) {
        mir.MirPlace place! = self.pointer_base_place(callee_id);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(place));
        guard info.data is .handle_type(handle) else {
            return place;
        }
        if (handle.kind == .owner_pointer || handle.kind == .reference) {
            if (self.type_is_closure(handle.element)) {
                return self.project_deref(place, false);
            }
        }
        return place;
    }

    mir.MirPlace[]& exclusive_places_for_call(self, hir.HirId node_id, hir.HirCall call, qid.DefId target_def) {
        list.ArrayList<mir.MirPlace> places! = list.ArrayList<mir.MirPlace>();
        guard self.lowerer.hirs.def(target_def) is .some(hir_def) else {
            return self.lowerer.output.place_array(places$.ref());
        }
        guard hir_def.decl.function_signature is .some(signature) else {
            return self.lowerer.output.place_array(places$.ref());
        }
        if (signature.receiver_mode == .move_receiver) {
            self.append_exclusive_self_place(call.callee, places$.ref());
        }
        Int index! = 0;
        while (index < signature.exclusive_symbols.length) {
            self.append_exclusive_symbol_place(node_id, call, signature, signature.exclusive_symbols[index], places$.ref());
            index = index + 1;
        }
        return self.lowerer.output.place_array(places$.ref());
    }

    () append_exclusive_self_place(self, hir.HirId callee_id, list.ArrayList<mir.MirPlace>& places) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else {
            return;
        }
        if (self.place_for_expr(member_access.base) is .some(place)) {
            places.add(place);
        }
    }

    () append_exclusive_symbol_place(self,
        hir.HirId node_id,
        hir.HirCall call,
        hir.HirFunctionSignature signature,
        qid.SymbolId symbol,
        list.ArrayList<mir.MirPlace>& places
    ) {
        if (self.symbol_text_equal(symbol, "self")) {
            self.append_exclusive_self_place(call.callee, places);
            return;
        }
        guard self.param_index_for_symbol(signature, symbol) is .some(param_index) else {
            return;
        }
        guard self.exclusive_arg_expr(node_id, call, param_index) is .some(arg_id) else {
            return;
        }
        if (self.exclusive_place_for_expr(arg_id) is .some(place)) {
            places.add(place);
        }
    }

    Int? param_index_for_symbol(self, hir.HirFunctionSignature signature, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    hir.HirId? exclusive_arg_expr(self, hir.HirId node_id, hir.HirCall call, Int param_index) {
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(ordered)) {
            if (param_index >= 0 && param_index < ordered.values.length) {
                return ordered.values[param_index];
            }
            return null;
        }
        if (param_index >= 0 && param_index < call.args.length) {
            return call.args[param_index].value;
        }
        return null;
    }

    mir.MirPlace? exclusive_place_for_expr(self, hir.HirId node_id) {
        if (self.place_for_expr(node_id) is .some(place)) {
            return place;
        }
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .implicit_call(call) else { return null; }
        guard self.lowerer.typeck.intrinsic_operation(node_id) is .some(operation) else { return null; }
        if (operation == .borrow_ref
            || operation == .mutable_borrow_ref
            || operation == .address_of
            || operation == .mutable_address_of) {
            return self.place_for_expr(call.base);
        }
        return null;
    }

    () lower_planned_trait_object_method_call(self,
        hir.HirId node_id,
        hir.HirCall call,
        mir.MirPlace destination
    ) {
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.lowerer.ctx.store.typeck.member_selection(call.callee) is .some(trait_member) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.lowerer.ctx.store.defs.get(trait_member).owner_def is .some(trait_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (!self.function_has_receiver_abi(trait_member)) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_vtable_slot_index(trait_def, trait_member) is .some(slot_index) else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirPlace any_place = self.member_lookup_base_place(member_access.base);
        mir.MirPlace receiver_place = self.project_constant_index(any_place, 0);
        mir.MirPlace vtable_place = self.project_constant_index(any_place, 1);
        mir.MirPlace slot_place = self.project_constant_index(vtable_place, slot_index + 1);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(call.args.length + 1);
        args.add(mir.copy_operand_value(mir.MirCopyOperand (place: receiver_place)));
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.indirect_operand_callee(mir.copy_operand_value(mir.MirCopyOperand (place: slot_place))),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(self.type_for_node(node_id)),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    mir.MirOperand trait_object_method_value_operand(self, hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .member_access(member_access) else {
            return self.unsupported_operand(node_id);
        }
        guard self.lowerer.ctx.store.typeck.member_selection(node_id) is .some(trait_member) else {
            return self.unsupported_operand(node_id);
        }
        guard self.lowerer.ctx.store.defs.get(trait_member).owner_def is .some(trait_def) else {
            return self.unsupported_operand(node_id);
        }
        guard self.trait_vtable_slot_index(trait_def, trait_member) is .some(slot_index) else {
            return self.unsupported_operand(node_id);
        }
        mir.MirPlace any_place = self.member_lookup_base_place(member_access.base);
        mir.MirPlace vtable_place = self.project_constant_index(any_place, 1);
        mir.MirPlace slot_place = self.project_constant_index(vtable_place, slot_index + 1);
        return mir.copy_operand_value(mir.MirCopyOperand (place: slot_place));
    }

    () lower_init_constructor_call(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId init_def,
        mir.MirPlace destination
    ) {
        qid.DefId target_def = self.direct_call_target(node_id, init_def);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>();
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.callee, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.callee, target_def);
        qid.TypeId function_type = self.function_type_for_ref(target_def, type_args, const_args);
        args.add(self.borrow_destination_operand(destination, self.lowerer.hir_span(node_id)));
        self.add_constructor_call_operands(node_id, call, args$.ref(), function_type);
        if (type_args.length > 0 || const_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(target_def, type_args, const_args);
        } else {
            self.lowerer.ensure_external_function(target_def);
        }

        mir.MirLocalId unit_local = self.add_temp(
            self.lowerer.ctx.store.types.unit_type(),
            self.lowerer.hir_span(node_id)
        );
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: self.function_callee_with_args(
                call.callee,
                target_def,
                function_type,
                type_args,
                const_args
            ),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: self.place_for_local(unit_local),
            target: next_block,
            initialized_place: destination,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    mir.MirOperand borrow_destination_operand(self, mir.MirPlace destination, token.Span span) {
        return mir.out_operand_value(mir.MirOutOperand (place: destination));
    }

    () add_constructor_call_operands(self,
        hir.HirId node_id,
        hir.HirCall call,
        list.ArrayList<mir.MirOperand>& args,
        qid.TypeId function_type
    ) {
        types.FunctionType signature = self.function_type_or_empty(function_type);
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(ordered)) {
            self.add_ordered_call_operands(args, ordered.values, signature, 1);
            return;
        }
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_call_arg_operand(call.args[index].value, signature, index + 1));
            index = index + 1;
        }
    }

    Bool is_enum_init_call(self, hir.HirId node_id, hir.HirCall call) {
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return false; }
        if (!self.symbol_text_equal(member_access.member_symbol, "init?")) { return false; }
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        guard self.nominal_def_kind(enum_type) is .some(kind) else { return false; }
        return kind == .enum_def;
    }

    Bool is_enum_type_constructor_call(self, hir.HirId node_id, hir.HirCall call) {
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        if (!self.is_type_ref_data(callee.data)) { return false; }
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        guard self.nominal_def_kind(enum_type) is .some(kind) else { return false; }
        return kind == .enum_def;
    }

    Bool is_type_ref_data(self, hir.HirNodeData data) {
        if (data is .named_type_ref(_)) { return true; }
        if (data is .layered_type_ref(_)) { return true; }
        if (data is .array_type_ref(_)) { return true; }
        if (data is .errorable_type_ref(_)) { return true; }
        if (data is .function_type_ref(_)) { return true; }
        if (data is .tuple_type_ref(_)) { return true; }
        if (data is .unit_type_ref()) { return true; }
        if (data is .infer_type_ref()) { return true; }
        return data is .invalid_type_ref;
    }

    () lower_enum_init_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        qid.TypeId value_type = self.type_for_node(call.args[0].value);
        mir.MirLocalId value_local = self.add_temp(value_type, span);
        mir.MirPlace value_place = self.place_for_local(value_local);
        self.lower_into_place(call.args[0].value, value_place);

        mir.MirBlockId default_block = self.reserve_block(span);
        mir.MirBlockId join_block = self.reserve_block(span);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>();
        self.add_enum_init_cases(enum_type, value_type, span, cases$.ref());
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: mir.copy_operand_value(mir.MirCopyOperand (place: value_place)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: default_block
        )), span);

        self.lower_enum_init_case_blocks(enum_type, destination, join_block, cases$.ref(), span);
        self.start_block(default_block);
        self.push_assign(destination, self.optional_none_rvalue(span), span);
        self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)), span);
        self.start_block(join_block);
    }

    () add_enum_init_cases(self,
        qid.TypeId enum_type,
        qid.TypeId value_type,
        token.Span span,
        list.ArrayList<mir.MirSwitchCase>& cases
    ) {
        guard self.nominal_type_data(enum_type) is .some(named) else { return; }
        guard self.lowerer.hirs.def(named.def_id) is .some(enum_hir) else { return; }
        Int index! = 0;
        while (index < enum_hir.members.len()) {
            qid.DefId case_def = enum_hir.members.get(index);
            index = index + 1;
            if (self.lowerer.ctx.store.defs.get(case_def).kind != .enum_case_def) { continue; }
            cases.add(mir.MirSwitchCase (
                value: self.enum_case_int_const(case_def, value_type, span),
                target: self.reserve_block(span)
            ));
        }
    }

    () lower_enum_init_case_blocks(self,
        qid.TypeId enum_type,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        list.ArrayList<mir.MirSwitchCase>& cases,
        token.Span span
    ) {
        Int index! = 0;
        while (index < cases.len()) {
            mir.MirSwitchCase switch_case = cases.get(index);
            self.start_block(switch_case.target);
            self.push_assign(
                destination,
                self.optional_some_enum_rvalue(enum_type, switch_case.value, span),
                span
            );
            self.finish_block(mir.goto_terminator_kind(mir.MirGotoTerminator (target: join_block)), span);
            index = index + 1;
        }
    }

    mir.MirRvalue optional_some_enum_rvalue(self,
        qid.TypeId enum_type,
        mir.MirConst switch_value,
        token.Span span
    ) {
        return mir.optional_rvalue(mir.MirOptionalRvalue (
            op: mir.MirOptionalOp.make_some,
            value: mir.const_operand_value(mir.MirConst (
                type_id: enum_type,
                span: span,
                value: switch_value.value
            ))
        ));
    }

    mir.MirRvalue optional_none_rvalue(self, token.Span span) {
        return mir.optional_rvalue(mir.MirOptionalRvalue (
            op: mir.MirOptionalOp.make_none,
            value: self.unit_operand(span)
        ));
    }

    mir.MirOperand unit_operand(self, token.Span span) {
        return mir.const_operand_value(mir.MirConst (
            type_id: self.lowerer.ctx.store.types.unit_type(),
            span: span,
            value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
        ));
    }

    mir.MirConst enum_case_int_const(self, qid.DefId case_def, qid.TypeId value_type, token.Span span) {
        return mir.MirConst (
            type_id: value_type,
            span: span,
            value: mir.int_const_kind(mir.MirIntConst (
                bits: UInt64(self.enum_case_value_or_error(case_def)),
                signed_value: true
            ))
        );
    }

    qid.TypeId optional_payload_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    () lower_special_call(self,
        hir.HirId node_id,
        hir.HirCall call,
        typeck_store.ExprLoweringKind lowering_kind,
        mir.MirPlace destination
    ) {
        if (lowering_kind == .builtin_numeric) {
            self.lower_builtin_numeric_init(node_id, call, destination);
            return;
        }
        if (lowering_kind == .enum_discriminant) {
            self.lower_enum_discriminant_init(node_id, call, destination);
            return;
        }
        if (lowering_kind == .raw_fn_to_fn) {
            self.lower_raw_fn_to_fn(node_id, call, destination);
            return;
        }
        if (lowering_kind == .builtin_primitive_hash) {
            self.lower_core_hash_call(node_id, call, destination);
            return;
        }
        if (lowering_kind == .trait_object_method_call) {
            self.lower_planned_trait_object_method_call(node_id, call, destination);
            return;
        }
        self.lower_default_nominal_init(node_id, call, destination);
    }

    () lower_raw_fn_to_fn(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId raw_type = self.type_for_node(call.args[0].value);
        token.Span span = self.lowerer.hir_span(node_id);
        self.push_closure_assign(
            node_id,
            destination,
            self.type_for_node(node_id),
            self.erased_raw_fn_env_operand(call.args[0].value, raw_type, span),
            self.raw_fn_vtable_operand(node_id, raw_type, self.type_for_node(node_id), span)
        );
    }

    mir.MirOperand raw_fn_vtable_operand(
        self,
        hir.HirId node_id,
        qid.TypeId raw_type,
        qid.TypeId closure_type,
        token.Span span
    ) {
        qid.DefId global_def = self.ensure_raw_fn_vtable_global(node_id, raw_type, closure_type);
        return mir.global_address_operand_value(mir.MirGlobalRef (
            global_def: global_def,
            type_id: self.closure_vtable_pointer_type(closure_type, span),
            is_external: false,
            span: span
        ));
    }

    qid.DefId ensure_raw_fn_vtable_global(self, hir.HirId node_id, qid.TypeId raw_type, qid.TypeId closure_type) {
        Int key = raw_type.to_index();
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.raw_fn_vtable_globals$.ref(),
            key
        ) is .some(existing)) {
            return existing;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.DefId global_def = self.create_closure_vtable_global_def(
            build_text_int("__raw_fn_vtable_", raw_type.to_index()).bytes(),
            span
        );
        mir.MirGlobalId id = mir.MirGlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(mir.MirGlobal (
            id: id,
            def_id: global_def,
            type_id: self.closure_vtable_type(closure_type, span),
            span: span,
            read_only: true,
            is_external: false,
            initializer: self.raw_fn_vtable_static_value(node_id, raw_type, closure_type)
        ));
        self.lowerer.raw_fn_vtable_globals.set(key, global_def);
        return global_def;
    }

    mir.MirStaticValue raw_fn_vtable_static_value(
        self,
        hir.HirId node_id,
        qid.TypeId raw_type,
        qid.TypeId closure_type
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId code_type = self.closure_code_type(closure_type);
        list.ArrayList<mir.MirStaticField> fields! = list.ArrayList<mir.MirStaticField>(2);
        fields.add(mir.MirStaticField (
            type_id: code_type,
            value: mir.function_static_value(mir.MirFunctionRef (
                function_def: self.ensure_raw_fn_to_fn_shim(node_id, raw_type),
                type_args: self.lowerer.output.empty_type_args(),
                const_args: self.lowerer.output.empty_const_args(),
                coroutine_resume: false,
            coroutine_completion: false,
                type_id: code_type,
                span: span
            ))
        ));
        fields.add(mir.MirStaticField (
            type_id: self.closure_drop_env_type(span),
            value: self.closure_noop_drop_static_value(span)
        ));
        return mir.aggregate_static_value(self.lowerer.output.static_field_array(fields$.ref()));
    }

    mir.MirOperand erased_raw_fn_env_operand(self, hir.HirId raw_fn_id, qid.TypeId raw_type, token.Span span) {
        qid.TypeId erased_type = self.closure_env_type(span);
        mir.MirLocalId erased_local = self.add_temp(erased_type, span);
        mir.MirPlace erased_place = self.place_for_local(erased_local);
        self.push_assign(
            erased_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(raw_type, erased_type),
                value: self.lower_to_operand(raw_fn_id),
                target_type: erased_type
            )),
            span
        );
        return self.operand_for_place(erased_place);
    }

    qid.DefId ensure_raw_fn_to_fn_shim(self, hir.HirId node_id, qid.TypeId raw_type) {
        Int key = raw_type.to_index();
        if (table.hash_table_get_value<Int, qid.DefId>(
            self.lowerer.raw_fn_to_fn_shims$.ref(),
            key
        ) is .some(existing)) {
            return existing;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.DefId shim_def = self.create_raw_fn_to_fn_shim_def(raw_type, span);
        self.lowerer.raw_fn_to_fn_shims.set(key, shim_def);
        self.add_raw_fn_to_fn_shim_function(shim_def, raw_type, span);
        return shim_def;
    }

    qid.DefId create_raw_fn_to_fn_shim_def(self, qid.TypeId raw_type, token.Span span) {
        def.DefRecord function_record = self.lowerer.ctx.store.defs.get(self.hir_def.def_id);
        std.String name = build_text_int("__raw_fn_to_fn_", raw_type.to_index());
        return self.lowerer.ctx.store.defs.create(
            .function_def,
            .value_name,
            .private_visibility,
            def.Name(symbol: self.lowerer.ctx.store.symbols.intern(name.bytes()), span: span),
            function_record.owner_def,
            function_record.module_id,
            function_record.decl_namespace_id,
            null
        );
    }

    () add_raw_fn_to_fn_shim_function(self, qid.DefId shim_def, qid.TypeId raw_type, token.Span span) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(raw_type);
        guard info.data is .function_type(function_type) else { return; }
        if (function_type.effects.has_async) {
            self.add_async_raw_fn_to_fn_shim_function(shim_def, raw_type, function_type, span);
            return;
        }
        Int function_index = self.lowerer.output.functions.len();
        mir.MirLocalId raw_local = mir.MirLocalId.from_index(function_type.params.length + 2);
        list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(function_type.params.length + 3);
        locals.add(self.raw_fn_to_fn_local(0, .return_place, function_type.result, span, null));
        locals.add(self.raw_fn_to_fn_local(
            1,
            .param,
            self.closure_env_type(span),
            span,
            self.lowerer.ctx.store.symbols.intern("__env")
        ));
        Int param_index! = 0;
        while (param_index < function_type.params.length) {
            locals.add(self.raw_fn_to_fn_local(
                param_index + 2,
                .param,
                function_type.params[param_index],
                span,
                null
            ));
            param_index = param_index + 1;
        }
        locals.add(self.raw_fn_to_fn_local(raw_local.to_index(), .compiler_temp, raw_type, span, null));

        list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(1);
        statements.add(self.raw_fn_to_fn_cast_statement(raw_local, raw_type, span));
        list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
        blocks.add(self.raw_fn_to_fn_call_block(raw_local, function_type, statements$.ref(), span));
        blocks.add(self.raw_fn_to_fn_return_block(function_type.result, span));
        mir.MirBody body = mir.MirBody(
            id: mir.MirBodyId.from_index(function_index),
            span: span,
            locals: self.raw_fn_to_fn_locals(locals$.ref()),
            blocks: self.lowerer.output.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        );
        self.lowerer.output.add_function(mir.MirFunction(
            id: mir.MirFunctionId.from_index(function_index),
            def_id: shim_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: false,
            naked: false,
            span: span,
            body: body
        ));
    }

    () add_async_raw_fn_to_fn_shim_function(
        self,
        qid.DefId shim_def,
        qid.TypeId raw_type,
        types.FunctionType function_type,
        token.Span span
    ) {
        Int function_index = self.lowerer.output.functions.len();
        Int param_count = function_type.params.length;
        mir.MirLocalId continuation_local = mir.MirLocalId.from_index(param_count + 2);
        mir.MirLocalId raw_local = mir.MirLocalId.from_index(param_count + 3);
        qid.TypeId abi_type = self.lowerer.external_async_abi_function_type(raw_type, span);
        list.ArrayList<mir.MirLocalDecl> locals! = list.ArrayList<mir.MirLocalDecl>(param_count + 4);
        locals.add(self.raw_fn_to_fn_local(
            0, .return_place, self.lowerer.ctx.store.types.unit_type(), span, null
        ));
        locals.add(self.raw_fn_to_fn_local(
            1,
            .param,
            self.closure_env_type(span),
            span,
            self.lowerer.ctx.store.symbols.intern("__env")
        ));
        Int param_index! = 0;
        while (param_index < param_count) {
            locals.add(self.raw_fn_to_fn_local(
                param_index + 2, .param, function_type.params[param_index], span, null
            ));
            param_index = param_index + 1;
        }
        mir.MirExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(function_type.result, span);
        locals.add(self.raw_fn_to_fn_local(
            continuation_local.to_index(), .param, continuation_layout.pointer_type_id, span, null
        ));
        locals.add(self.raw_fn_to_fn_local(
            raw_local.to_index(), .compiler_temp, abi_type, span, null
        ));
        list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(1);
        statements.add(self.raw_fn_to_fn_cast_statement(raw_local, abi_type, span));
        list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(2);
        blocks.add(self.async_raw_fn_to_fn_call_block(
            raw_local, continuation_local, function_type, statements$.ref(), span
        ));
        blocks.add(self.raw_fn_to_fn_return_block(self.lowerer.ctx.store.types.unit_type(), span));
        mir.MirFunctionId function_id = mir.MirFunctionId.from_index(function_index);
        self.lowerer.output.add_generated_function(mir.MirFunction (
            id: function_id,
            def_id: shim_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: mir.MirBody (
                id: mir.MirBodyId.from_index(function_index),
                span: span,
                locals: self.raw_fn_to_fn_locals(locals$.ref()),
                blocks: self.lowerer.output.block_array(blocks$.ref()),
                entry: mir.MirBlockId.from_index(0),
                return_local: mir.MirLocalId.from_index(0)
            )
        ));
        self.lowerer.output.mark_borrow_check_exempt(function_id);
    }

    mir.MirBlock async_raw_fn_to_fn_call_block(
        self,
        mir.MirLocalId raw_local,
        mir.MirLocalId continuation_local,
        types.FunctionType function_type,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(
            function_type.params.length + 1
        );
        Int index! = 0;
        while (index < function_type.params.length) {
            args.add(mir.copy_operand_value(mir.MirCopyOperand (
                place: self.place_for_local(mir.MirLocalId.from_index(index + 2))
            )));
            index = index + 1;
        }
        args.add(mir.copy_operand_value(mir.MirCopyOperand (
            place: self.place_for_local(continuation_local)
        )));
        return mir.MirBlock (
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.lowerer.output.statement_array(statements),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator (
                    callee: mir.indirect_operand_callee(mir.copy_operand_value(mir.MirCopyOperand (
                        place: self.place_for_local(raw_local)
                    ))),
                    args: self.lowerer.output.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: self.place_for_local(mir.MirLocalId.from_index(0)),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.lowerer.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirLocalDecl raw_fn_to_fn_local(
        self,
        Int index,
        mir.MirLocalKind kind,
        qid.TypeId type_id,
        token.Span span,
        qid.SymbolId? name
    ) {
        return mir.MirLocalDecl(
            id: mir.MirLocalId.from_index(index),
            kind: kind,
            type_id: type_id,
            span: span,
            name: name,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    mir.MirLocalDecl[]& raw_fn_to_fn_locals(self, list.ArrayList<mir.MirLocalDecl>& locals) {
        unsafe {
            mir.MirLocalDecl*! stored = self.lowerer.output.alloc_local_array(locals.len());
            Int index! = 0;
            while (index < locals.len()) {
                stored[index] = locals.get(index);
                index = index + 1;
            }
            return stored[0..locals.len()];
        }
    }

    mir.MirStatement raw_fn_to_fn_cast_statement(
        self,
        mir.MirLocalId raw_local,
        qid.TypeId raw_type,
        token.Span span
    ) {
        return mir.MirStatement(
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement(
                destination: self.place_for_local(raw_local),
                value: mir.cast_rvalue(mir.MirCastRvalue(
                    kind: mir.MirCastKind.ptr_to_ptr,
                    value: mir.copy_operand_value(mir.MirCopyOperand(place: self.place_for_local(mir.MirLocalId(1)))),
                    target_type: raw_type
                ))
            ))
        );
    }

    mir.MirBlock raw_fn_to_fn_call_block(
        self,
        mir.MirLocalId raw_local,
        types.FunctionType function_type,
        list.ArrayList<mir.MirStatement>& statements,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            args.add(mir.copy_operand_value(mir.MirCopyOperand(
                place: self.place_for_local(mir.MirLocalId.from_index(index + 2))
            )));
            index = index + 1;
        }
        return mir.MirBlock(
            id: mir.MirBlockId.from_index(0),
            span: span,
            statements: self.lowerer.output.statement_array(statements),
            terminator: mir.MirTerminator(
                span: span,
                kind: mir.call_terminator_kind(mir.MirCallTerminator(
                    callee: mir.indirect_operand_callee(mir.copy_operand_value(mir.MirCopyOperand(
                        place: self.place_for_local(raw_local)
                    ))),
                    args: self.lowerer.output.operand_slice(args.slice()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: self.place_for_local(mir.MirLocalId(0)),
                    target: mir.MirBlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.lowerer.output.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    mir.MirBlock raw_fn_to_fn_return_block(self, qid.TypeId result_type, token.Span span) {
        list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>();
        return mir.MirBlock(
            id: mir.MirBlockId.from_index(1),
            span: span,
            statements: self.lowerer.output.statement_array(statements$.ref()),
            terminator: mir.MirTerminator(
                span: span,
                kind: mir.return_terminator_kind(mir.MirReturnTerminator(
                    implicit_unit: result_type == self.lowerer.ctx.store.types.unit_type()
                ))
            )
        );
    }

    qid.TypeId closure_code_type(self, qid.TypeId raw_type) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(raw_type);
        guard info.data is .function_type(function_type) else { return self.lowerer.ctx.store.types.invalid_type(); }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length + 1);
        params.add(self.closure_env_type(token.Span()));
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(function_type.params[index]);
            index = index + 1;
        }
        qid.TypeId source_type = self.lowerer.ctx.store.types.function_type_with_effects(
            params$.move(),
            function_type.result,
            token.Span(),
            function_type.effects
        );
        if (function_type.effects.has_async) {
            return self.lowerer.external_async_abi_function_type(source_type, token.Span());
        }
        return source_type;
    }

    Bool lower_core_hash_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        guard self.hash_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        qid.TypeId receiver_type = self.type_for_node(receiver);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(receiver_type);
        if (info.data is .float_type(float_type)) {
            return self.lower_float_hash(node_id, receiver, float_type, destination);
        }
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.int_to_int,
                value: self.lower_to_operand(receiver),
                target_type: self.mir_place_type(destination)
            )),
            self.lowerer.hir_span(node_id)
        );
        return true;
    }

    Bool lower_float_hash(self,
        hir.HirId node_id,
        hir.HirId receiver,
        types.FloatType float_type,
        mir.MirPlace destination
    ) {
        qid.TypeId bits_type = self.float_hash_bits_type(float_type);
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirLocalId bits_local = self.add_temp(bits_type, span);
        mir.MirPlace bits_place = self.place_for_local(bits_local);
        self.push_assign(
            bits_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.bitcast,
                value: self.lower_to_operand(receiver),
                target_type: bits_type
            )),
            span
        );
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.int_to_int,
                value: self.operand_for_place(bits_place),
                target_type: self.mir_place_type(destination)
            )),
            span
        );
        return true;
    }

    qid.TypeId float_hash_bits_type(self, types.FloatType float_type) {
        if (float_type.bits == 32) {
            return self.lowerer.ctx.store.types.uint32_type();
        }
        return self.lowerer.ctx.store.types.uint64_type();
    }

    Bool call_can_lower_builtin_primitive_hash(self, hir.HirCall call) {
        guard self.lowerer.ctx.store.typeck.member_selection(call.callee) is .some(member_def) else {
            return false;
        }
        if (!self.is_core_hash_method(member_def)) {
            return false;
        }
        guard self.hash_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        return self.type_has_builtin_primitive_hash(self.type_for_node(receiver));
    }

    Bool call_can_lower_core_contiguous(self, hir.HirCall call) {
        guard self.lowerer.ctx.store.typeck.member_selection(call.callee) is .some(member_def) else {
            return false;
        }
        if (!self.is_core_contiguous_method(member_def)) {
            return false;
        }
        guard self.contiguous_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        return self.receiver_has_builtin_contiguous_storage(receiver);
    }

    Bool lower_core_contiguous_call(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        guard self.contiguous_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        guard self.lowerer.ctx.store.typeck.member_selection(call.callee) is .some(member_def) else {
            return false;
        }
        qid.SymbolId symbol = self.lowerer.ctx.store.defs.get(member_def).name.symbol;
        if (self.symbol_text_equal(symbol, "ptr")) {
            return self.lower_core_contiguous_pointer(node_id, receiver, destination);
        }
        if (self.symbol_text_equal(symbol, "length")) {
            return self.lower_core_contiguous_length(node_id, receiver, destination);
        }
        return false;
    }

    Bool lower_core_contiguous_pointer(self, hir.HirId node_id, hir.HirId receiver, mir.MirPlace destination) {
        qid.TypeId value_type = self.contiguous_receiver_value_type(receiver);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(value_type);
        if (info.data is .array_type(_)) {
            self.lower_array_place_ptr(
                node_id,
                self.contiguous_receiver_storage_place(receiver),
                self.mir_place_type(destination),
                destination
            );
            return true;
        }
        if (self.contiguous_data_place(receiver, value_type) is .some(data_place)) {
            self.push_assign(
                destination,
                mir.cast_rvalue(mir.MirCastRvalue (
                    kind: mir.MirCastKind.ptr_to_ptr,
                    value: mir.copy_operand_value(mir.MirCopyOperand (place: data_place)),
                    target_type: self.mir_place_type(destination)
                )),
                self.lowerer.hir_span(node_id)
            );
            return true;
        }
        return false;
    }

    Bool lower_core_contiguous_length(self, hir.HirId node_id, hir.HirId receiver, mir.MirPlace destination) {
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId value_type = self.contiguous_receiver_value_type(receiver);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(value_type);
        if (info.data is .array_type(array_type)) {
            self.push_assign(destination, self.int_const_rvalue(array_type.count, span), span);
            return true;
        }
        if (self.contiguous_length_place(receiver, value_type) is .some(length_place)) {
            self.push_assign(
                destination,
                mir.use_rvalue(mir.MirUseRvalue (
                    value: mir.copy_operand_value(mir.MirCopyOperand (place: length_place))
                )),
                span
            );
            return true;
        }
        return false;
    }

    Bool is_core_contiguous_method(self, qid.DefId function_def) {
        guard self.lowerer.ctx.store.resolve.core_traits.contiguous_trait is .some(contiguous_def) else {
            return false;
        }
        guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def.to_index() != contiguous_def.to_index()) {
            return false;
        }
        qid.SymbolId symbol = self.lowerer.ctx.store.defs.get(function_def).name.symbol;
        return self.symbol_text_equal(symbol, "ptr") || self.symbol_text_equal(symbol, "length");
    }

    hir.HirId? contiguous_receiver_node(self, hir.HirId callee_id) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        if (callee.data is .member_access(member_access)) {
            return member_access.base;
        }
        return null;
    }

    Bool receiver_has_builtin_contiguous_storage(self, hir.HirId receiver) {
        return self.type_has_builtin_contiguous_storage(self.contiguous_receiver_value_type(receiver));
    }

    Bool type_has_builtin_contiguous_storage(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .slice_value_type(_)) { return true; }
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .slice) { return true; }
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    qid.TypeId contiguous_receiver_value_type(self, hir.HirId receiver) {
        return self.member_lookup_value_type(self.receiver_expr_type(receiver));
    }

    mir.MirPlace contiguous_receiver_storage_place(self, hir.HirId receiver) {
        mir.MirPlace place! = self.pointer_base_place(receiver);
        if (self.contiguous_place_needs_deref(place)) {
            place = self.project_deref(place, self.place_is_raw_pointer(place));
        }
        return place;
    }

    Bool contiguous_place_needs_deref(self, mir.MirPlace place) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(self.mir_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .raw_pointer;
    }

    mir.MirPlace? contiguous_data_place(self, hir.HirId receiver, qid.TypeId value_type) {
        if (!self.type_has_contiguous_slice_layout(value_type)) {
            return null;
        }
        return self.project_constant_index(self.contiguous_receiver_storage_place(receiver), 0);
    }

    mir.MirPlace? contiguous_length_place(self, hir.HirId receiver, qid.TypeId value_type) {
        if (!self.type_has_contiguous_slice_layout(value_type)) {
            return null;
        }
        return self.project_constant_index(self.contiguous_receiver_storage_place(receiver), 1);
    }

    Bool type_has_contiguous_slice_layout(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .slice_value_type(_)) { return true; }
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .slice) { return true; }
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.lowerer.ctx.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    Bool is_core_hash_method(self, qid.DefId function_def) {
        guard self.lowerer.ctx.store.resolve.core_traits.hashable_trait is .some(hashable_def) else {
            return false;
        }
        guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def.to_index() != hashable_def.to_index()) {
            return false;
        }
        qid.SymbolId symbol = self.lowerer.ctx.store.defs.get(function_def).name.symbol;
        return string.equal(self.lowerer.ctx.store.symbols.text(symbol), "hash");
    }

    hir.HirId? hash_receiver_node(self, hir.HirId callee_id) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        if (callee.data is .member_access(member_access)) {
            return member_access.base;
        }
        return null;
    }

    Bool type_has_builtin_primitive_hash(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .bool_type) { return true; }
        if (info.data is .char_type) { return true; }
        if (info.data is .int_type(_)) { return true; }
        return info.data is .float_type(_);
    }

    () lower_builtin_numeric_init(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.args[0].value);
        qid.TypeId target_type = self.type_for_node(node_id);
        // builtin numeric init 目前没有用户可见函数体；MIR 用 cast_value
        // 表达底层转换，仍由 type check 的 constructor side table 触发。
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.args[0].value),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_enum_discriminant_init(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId target_type = self.type_for_node(node_id);
        qid.TypeId source_type = self.type_for_node(call.args[0].value);
        qid.TypeId underlying_type = self.enum_underlying_type(source_type);
        self.push_assign(
            destination,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.int_to_int,
                value: self.enum_discriminant_operand(call.args[0].value, source_type, underlying_type),
                target_type: target_type
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand enum_discriminant_operand(self,
        hir.HirId value_id,
        qid.TypeId enum_type,
        qid.TypeId underlying_type
    ) {
        if (self.enum_case_def_for_value(value_id) is .some(case_def)) {
            mir.MirConst value = self.enum_case_int_const(case_def, underlying_type, self.lowerer.hir_span(value_id));
            return mir.const_operand_value(value);
        }
        mir.MirPlace place = self.enum_value_place(value_id, enum_type);
        mir.MirLocalId temp = self.add_temp(underlying_type, self.lowerer.hir_span(value_id));
        self.push_assign(
            self.place_for_local(temp),
            mir.discriminant_rvalue(mir.MirDiscriminantRvalue (place: place)),
            self.lowerer.hir_span(value_id)
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: self.place_for_local(temp)));
    }

    mir.MirPlace enum_value_place(self, hir.HirId value_id, qid.TypeId enum_type) {
        if (self.place_for_expr(value_id) is .some(place)) {
            return place;
        }
        mir.MirLocalId temp = self.add_temp(enum_type, self.lowerer.hir_span(value_id));
        mir.MirPlace place = self.place_for_local(temp);
        self.lower_into_place(value_id, place);
        return place;
    }

    qid.TypeId enum_underlying_type(self, qid.TypeId enum_type) {
        guard self.nominal_type_data(enum_type) is .some(named) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        if (self.lowerer.ctx.store.typeck.enum_underlying_type(named.def_id) is .some(type_id)) {
            return type_id;
        }
        return self.lowerer.ctx.store.types.int32_type();
    }

    qid.DefId? enum_case_def_for_value(self, hir.HirId value_id) {
        hir.HirNode node = self.lowerer.hirs.node(value_id);
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .def_ref(def_id)) {
                if (self.lowerer.ctx.store.defs.get(def_id).kind == .enum_case_def) {
                    return def_id;
                }
            }
        }
        if (node.data is .member_access(_)) {
            if (self.lowerer.typeck.member_selection(value_id) is .some(member_def)) {
                if (self.lowerer.ctx.store.defs.get(member_def).kind == .enum_case_def) {
                    return member_def;
                }
            }
        }
        return null;
    }

    () lower_default_nominal_init(self, hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.ctx.store.types.get(type_id).data is .named(named) else {
            self.mark_unsupported(node_id);
            return;
        }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        guard self.lowerer.hirs.def(named.def_id) is .some(owner_hir) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(ordered)) {
            self.lower_default_nominal_ordered_fields(node_id, owner_hir, destination, substitutions$.ref(), ordered.values);
            return;
        }
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.lower_default_nominal_field(call, destination, member_def, substitutions$.ref()) else {
                    self.mark_unsupported(node_id);
                    return;
                }
            }
            index = index + 1;
        }
    }

    () lower_default_nominal_ordered_fields(self,
        hir.HirId node_id,
        hir.HirDef& owner_hir,
        mir.MirPlace destination,
        monomorph.SubstitutionMap& substitutions,
        hir.HirId[]& values
    ) {
        Int field_index! = 0;
        Int member_index! = 0;
        while (member_index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(member_index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                if (!self.lower_default_nominal_ordered_field(destination, member_def, substitutions, values, field_index)) {
                    self.mark_unsupported(node_id);
                    return;
                }
                field_index = field_index + 1;
            }
            member_index = member_index + 1;
        }
    }

    Bool lower_default_nominal_ordered_field(self,
        mir.MirPlace destination,
        qid.DefId field_def,
        monomorph.SubstitutionMap& substitutions,
        hir.HirId[]& values,
        Int field_index
    ) {
        if (field_index >= values.length) { return false; }
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        mir.MirPlace field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(values[field_index], field_place, field_type);
        return true;
    }

    Bool lower_default_nominal_field(self,
        hir.HirCall call,
        mir.MirPlace destination,
        qid.DefId field_def,
        monomorph.SubstitutionMap& substitutions
    ) {
        guard self.default_constructor_field_value(call, field_def) is .some(value) else { return false; }
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        mir.MirPlace field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(value, field_place, field_type);
        return true;
    }

    hir.HirId? default_constructor_field_value(self, hir.HirCall call, qid.DefId field_def) {
        qid.SymbolId symbol = self.lowerer.ctx.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < call.args.length) {
            if (call.args[index].label is .some(label)) {
                if (label == symbol) {
                    return call.args[index].value;
                }
            }
            index = index + 1;
        }
        guard self.lowerer.hirs.def(field_def) is .some(field_hir) else { return null; }
        if (field_hir.decl.field_default is .some(default_value)) {
            return default_value;
        }
        return null;
    }

    () lower_call_to_function_def(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId function_def,
        mir.MirPlace destination
    ) {
        qid.DefId target_def! = self.direct_call_target(node_id, function_def);
        target_def = self.static_dispatch_target_for_call(call, target_def);
        def.DefKind target_kind = self.lowerer.ctx.store.defs.get(target_def).kind;
        if (self.is_assert_call(target_def, target_kind)) {
            self.lower_builtin_assert(node_id, call);
            return;
        }
        if (self.is_coroutine_suspend_def(target_def)) {
            self.lower_coroutine_suspend(node_id, call, destination);
            return;
        }
        if (self.is_continuation_resume_def(target_def)) {
            self.lower_continuation_resume(node_id, call, destination);
            return;
        }
        if (self.is_continuation_on_cancel_def(target_def)) {
            self.lower_continuation_on_cancel(node_id, call, destination);
            return;
        }
        if (self.atomic_builtin(call, target_def) is .some(builtin)) {
            self.lower_atomic_builtin_call(node_id, call, builtin, destination);
            return;
        }
        qid.TypeId[]& type_args = self.function_call_type_args(node_id, call.callee, target_def);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, call.callee, target_def);
        qid.TypeId function_type = self.function_type_for_ref(target_def, type_args, const_args);
        list.ArrayList<mir.MirOperand> args! = self.lower_call_operands(node_id, call, target_def, function_type);
        if (type_args.length > 0 || const_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(target_def, type_args, const_args);
        } else {
            self.lowerer.ensure_external_function(target_def);
        }
        if (self.function_type_is_async(function_type)) {
            self.lower_async_direct_call(
                node_id,
                target_def,
                type_args,
                const_args,
                self.lowerer.output.operand_array(args$.ref()),
                destination,
                self.lowerer.hir_span(node_id)
            );
            return;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: self.function_callee_with_args(
                call.callee,
                target_def,
                function_type,
                type_args,
                const_args
            ),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.exclusive_places_for_call(node_id, call, target_def),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_atomic_builtin_call(
        self,
        hir.HirId node_id,
        hir.HirCall call,
        AtomicBuiltin builtin,
        mir.MirPlace destination
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirPlace storage = self.atomic_builtin_storage(call.args[0].value, span);
        if (builtin.kind == .load) {
            self.push_assign(
                destination,
                mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                    place: storage,
                    ordering: builtin.success
                )),
                span
            );
            return;
        }
        mir.MirOperand value = self.lower_to_operand(call.args[1].value);
        if (builtin.kind == .store) {
            self.statements.add(mir.MirStatement (
                span: span,
                kind: mir.atomic_store_statement_kind(mir.MirAtomicStoreStatement (
                    destination: storage,
                    value: value,
                    ordering: builtin.success
                ))
            ));
            self.push_assign(destination, self.unit_rvalue(span), span);
            return;
        }
        self.push_assign(
            destination,
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: storage,
                expected: value,
                desired: self.lower_to_operand(call.args[2].value),
                success_ordering: builtin.success,
                failure_ordering: builtin.failure
            )),
            span
        );
    }

    mir.MirPlace atomic_builtin_storage(self, hir.HirId value_id, token.Span span) {
        qid.TypeId reference_type = self.type_for_node(value_id);
        mir.MirLocalId reference = self.add_temp(reference_type, span);
        mir.MirPlace reference_place = self.place_for_local(reference);
        self.push_assign(
            reference_place,
            mir.use_rvalue(mir.MirUseRvalue (value: self.lower_to_operand(value_id))),
            span
        );
        return self.project_deref(reference_place, true);
    }

    Bool is_coroutine_suspend_def(self, qid.DefId target_def) {
        guard self.lowerer.ctx.store.resolve.core_functions.coroutine_suspend
            is .some(suspend_def) else { return false; }
        return target_def == suspend_def;
    }

    Bool is_continuation_resume_def(self, qid.DefId target_def) {
        guard self.lowerer.ctx.store.resolve.core_functions.continuation_resume
            is .some(resume_def) else { return false; }
        return target_def == resume_def;
    }

    Bool is_continuation_on_cancel_def(self, qid.DefId target_def) {
        guard self.lowerer.ctx.store.resolve.core_functions.continuation_on_cancel
            is .some(on_cancel_def) else { return false; }
        return target_def == on_cancel_def;
    }

    () lower_coroutine_suspend(
        self,
        hir.HirId node_id,
        hir.HirCall call,
        mir.MirPlace destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        hir.HirId registration_id = call.args[0].value;
        qid.TypeId registration_type = self.type_for_node(registration_id);
        types.TypeInfo registration_info = self.lowerer.ctx.store.types.get(registration_type);
        guard registration_info.data is .function_type(registration_fn) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard registration_fn.params.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_coroutine_suspend_registration(
            node_id,
            registration_id,
            registration_type,
            registration_fn.params[0],
            destination
        );
    }

    () lower_coroutine_suspend_registration(
        self,
        hir.HirId node_id,
        hir.HirId registration_id,
        qid.TypeId registration_type,
        qid.TypeId continuation_type,
        mir.MirPlace destination
    ) {
        token.Span span = self.lowerer.hir_span(node_id);
        mir.MirSuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            self.mir_place_type(destination), span
        );
        mir.MirLocalId record_local = self.add_temp(layout.type_id, span);
        mir.MirPlace record = self.place_for_local(record_local);
        self.initialize_suspend_continuation(layout, record, destination, span);
        self.check_cancellation_before_suspend_registration(record, layout, span);
        mir.MirLocalId continuation_local = self.add_temp(continuation_type, span);
        mir.MirPlace continuation = self.place_for_local(continuation_local);
        self.initialize_suspend_handle(layout, record, continuation, span);
        if (self.call_suspend_registration_lambda(
                registration_id, continuation, record, layout, span
            )
        ) {
            return;
        }
        mir.MirLocalId registration_local = self.add_temp(registration_type, span);
        mir.MirPlace registration = self.place_for_local(registration_local);
        self.lower_into_place(registration_id, registration);
        self.call_suspend_registration(registration, continuation, record, layout, span);
    }

    () check_cancellation_before_suspend_registration(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace request = self.project_deref(
            self.project_constant_index(record, layout.cancel_request_pointer_field_index),
            true
        );
        mir.MirLocalId requested = self.add_temp(self.mir_place_type(request), span);
        self.push_assign(
            self.place_for_local(requested),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: request,
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId cancelled = self.reserve_block(span);
        mir.MirBlockId registration = self.reserve_block(span);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(1);
        cases.add(mir.MirSwitchCase (
            value: self.int_const(1, span),
            target: cancelled
        ));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(requested)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: registration
        )), span);
        self.start_block(cancelled);
        self.clear_suspend_registration_target(record, layout, span);
        mir.MirBlockId parked = self.reserve_block(span);
        self.call_suspend_resume(record, layout, parked, span);
        self.start_block(parked);
        self.finish_block(mir.suspend_pending_terminator_kind(mir.MirSuspendPendingTerminator (
            target: parked,
            suspend_wake: .external
        )), span);
        self.start_block(registration);
    }

    () clear_suspend_registration_target(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace word = self.project_deref(
            self.project_constant_index(record, layout.cancel_word_pointer_field_index),
            true
        );
        mir.MirLocalId cleared = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(cleared),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: word,
                expected: mir.const_operand_value(self.int_const(3, span)),
                desired: mir.const_operand_value(self.int_const(0, span)),
                mode: .coroutine_atomic
            )),
            span
        );
    }

    () initialize_suspend_continuation(
        self,
        mir.MirSuspendContinuationLayout layout,
        mir.MirPlace record,
        mir.MirPlace destination,
        token.Span span
    ) {
        self.push_assign(
            self.project_constant_index(record, layout.result_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: destination,
                frame_root: false
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.context_field_index),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.resume_field_index),
            mir.use_rvalue(mir.MirUseRvalue (
                value: mir.function_operand_value(mir.MirFunctionRef (
                    function_def: self.hir_def.def_id,
                    type_args: self.lowerer.output.type_arg_array(self.function_type_args),
                    const_args: self.lowerer.output.const_arg_array(self.function_const_args),
                    coroutine_resume: true,
                    coroutine_completion: false,
                    type_id: self.lowerer.coroutine_continuation_type(
                        self.lowerer.coroutine_context_pointer_type(span), span
                    ),
                    span: span
                ))
            )),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.executor_field_index),
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.task_field_index),
            mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        self.push_atomic_store(
            self.project_constant_index(record, layout.phase_field_index),
            self.int_operand(suspend_registering, span),
            span
        );
        self.initialize_suspend_cancel_target(layout, record, span);
    }

    () initialize_suspend_cancel_target(
        self,
        mir.MirSuspendContinuationLayout layout,
        mir.MirPlace record,
        token.Span span
    ) {
        mir.MirTaskStateLayout state = self.current_task_state_layout();
        mir.MirPlace pointer = self.current_task_cancellation_state_pointer(state, span);
        mir.MirBlockId inherited = self.reserve_block(span);
        mir.MirBlockId fallback = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.branch_on_non_null_pointer(pointer, inherited, fallback, span);
        self.start_block(inherited);
        mir.MirPlace task = self.project_deref(pointer, true);
        mir.MirPlace word = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, task, state.cancel_target_word
        );
        mir.MirPlace request = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, task, state.cancellation_requested
        );
        self.store_suspend_field_address(record, layout.cancel_request_pointer_field_index, request, span);
        self.store_suspend_field_address(record, layout.cancel_word_pointer_field_index, word, span);
        self.push_atomic_store(word, mir.const_operand_value(self.int_const(3, span)), span);
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(fallback);
        mir.MirPlace fallback_request = self.project_constant_index(
            record, layout.fallback_cancel_request_field_index
        );
        mir.MirPlace fallback_word = self.project_constant_index(
            record, layout.fallback_cancel_word_field_index
        );
        self.push_atomic_store(
            fallback_request, mir.const_operand_value(self.int_const(0, span)), span
        );
        self.push_atomic_store(
            fallback_word, mir.const_operand_value(self.int_const(3, span)), span
        );
        self.store_suspend_field_address(
            record, layout.cancel_request_pointer_field_index, fallback_request, span
        );
        self.store_suspend_field_address(
            record, layout.cancel_word_pointer_field_index, fallback_word, span
        );
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () store_suspend_field_address(
        self,
        mir.MirPlace record,
        Int field_index,
        mir.MirPlace value,
        token.Span span
    ) {
        self.push_assign(
            self.project_constant_index(record, field_index),
            mir.address_of_rvalue(mir.MirAddressOfRvalue (
                mutable_pointer: true,
                place: value
            )),
            span
        );
    }

    mir.MirOperand suspend_cancel_target_word(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirLocalId pointer = self.add_temp(layout.pointer_type_id, span);
        self.push_assign(
            self.place_for_local(pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: record,
                frame_root: false
            )),
            span
        );
        qid.TypeId int_type = self.lowerer.ctx.store.types.int_type();
        mir.MirLocalId address = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(address),
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(pointer)),
                target_type: int_type
            )),
            span
        );
        mir.MirLocalId tagged = self.add_temp(int_type, span);
        self.push_assign(
            self.place_for_local(tagged),
            mir.binary_rvalue(mir.MirBinaryRvalue (
                op: mir.MirBinaryOp.bit_or,
                lhs: self.operand_for_place(self.place_for_local(address)),
                rhs: self.int_operand(1, span)
            )),
            span
        );
        return self.operand_for_place(self.place_for_local(tagged));
    }

    () initialize_suspend_handle(
        self,
        mir.MirSuspendContinuationLayout layout,
        mir.MirPlace record,
        mir.MirPlace continuation,
        token.Span span
    ) {
        mir.MirLocalId pointer = self.add_temp(layout.pointer_type_id, span);
        mir.MirPlace pointer_place = self.place_for_local(pointer);
        self.push_assign(
            pointer_place,
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: record,
                frame_root: false
            )),
            span
        );
        mir.MirPlace state = self.project_constant_index(continuation, 0);
        self.push_assign(
            state,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.ptr_to_int,
                value: self.operand_for_place(pointer_place),
                target_type: self.mir_place_type(state)
            )),
            span
        );
    }

    () call_suspend_registration(
        self,
        mir.MirPlace registration,
        mir.MirPlace continuation,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace vtable = self.project_deref(
            self.project_constant_index(registration, 1), true
        );
        mir.MirPlace function = self.project_constant_index(vtable, 0);
        mir.MirCallCallee callee = mir.indirect_operand_callee(self.operand_for_place(function));
        mir.MirOperand environment = self.operand_for_place(self.project_constant_index(registration, 0));
        self.finish_suspend_registration_call(
            callee, environment, continuation, record, layout, span
        );
    }

    Bool call_suspend_registration_lambda(
        self,
        hir.HirId registration_id,
        mir.MirPlace continuation,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        hir.HirNode node = self.lowerer.hirs.node(registration_id);
        guard node.data is .lambda_expr(lambda) else { return false; }
        qid.TypeId closure_type = self.type_for_node(registration_id);
        mir.MirOperand environment = self.lambda_env_operand(registration_id, lambda, span);
        self.ensure_lambda_function_instance(lambda.function_def);
        mir.MirFunctionRef function = mir.MirFunctionRef (
            function_def: lambda.function_def,
            type_args: self.lowerer.output.type_arg_array(self.function_type_args),
            const_args: self.lowerer.output.const_arg_array(self.function_const_args),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.closure_code_type(closure_type),
            span: span
        );
        self.finish_suspend_registration_call(
            mir.direct_function_callee(function),
            environment,
            continuation,
            record,
            layout,
            span
        );
        return true;
    }

    () finish_suspend_registration_call(
        self,
        mir.MirCallCallee callee,
        mir.MirOperand environment,
        mir.MirPlace continuation,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(2);
        args.add(environment);
        args.add(self.operand_for_place(continuation));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId next = self.reserve_block(span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: next,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next);
        self.finish_suspend_registration(record, layout, span);
    }

    () finish_suspend_registration(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace phase = self.project_constant_index(record, layout.phase_field_index);
        mir.MirLocalId parked = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(parked),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: phase,
                expected: self.int_operand(suspend_registering, span),
                desired: self.int_operand(suspend_parked, span),
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId suspend = self.reserve_block(span);
        mir.MirBlockId await_publish = self.reserve_block(span);
        mir.MirBlockId check_cancel = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(parked)),
            then_target: suspend,
            else_target: await_publish
        )), span);
        self.start_block(suspend);
        self.finish_block(mir.suspend_pending_terminator_kind(mir.MirSuspendPendingTerminator (
            target: complete,
            suspend_wake: .external
        )), span);
        self.start_block(await_publish);
        mir.MirLocalId observed = self.add_temp(self.mir_place_type(phase), span);
        self.push_assign(
            self.place_for_local(observed),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: phase,
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(2);
        cases.add(mir.MirSwitchCase (
            value: self.int_const(suspend_resumed, span),
            target: check_cancel
        ));
        cases.add(mir.MirSwitchCase (value: self.int_const(suspend_parked, span), target: suspend));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: await_publish
        )), span);
        self.start_block(check_cancel);
        self.check_cancellation_before_suspend_registration(record, layout, span);
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () lower_continuation_resume(
        self,
        hir.HirId node_id,
        hir.HirCall call,
        mir.MirPlace destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.call_member_receiver(call) is .some(receiver_id) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        hir.HirId value_id = call.args[0].value;
        mir.MirSuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            self.type_for_node(value_id), span
        );
        mir.MirPlace record = self.suspend_record_for_receiver(receiver_id, layout, span);
        self.push_assign(destination, self.unit_rvalue(span), span);
        self.resume_suspend_record(value_id, record, layout, span);
    }

    () lower_continuation_on_cancel(
        self,
        hir.HirId node_id,
        hir.HirCall call,
        mir.MirPlace destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.call_member_receiver(call) is .some(receiver_id) else {
            self.mark_unsupported(node_id);
            return;
        }
        hir.HirId handler_id = call.args[0].value;
        hir.HirNode handler_node = self.lowerer.hirs.node(handler_id);
        guard handler_node.data is .lambda_expr(handler) else {
            self.mark_unsupported(handler_id);
            return;
        }
        token.Span span = self.lowerer.hir_span(node_id);
        qid.TypeId result_type = self.continuation_result_type(receiver_id);
        mir.MirSuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            result_type, span
        );
        mir.MirPlace record = self.suspend_record_for_receiver(receiver_id, layout, span);
        self.register_suspend_cancel_handler(handler_id, handler, record, layout, span);
        self.push_assign(destination, self.unit_rvalue(span), span);
    }

    qid.TypeId continuation_result_type(self, hir.HirId receiver_id) {
        qid.TypeId type_id! = self.type_for_node(receiver_id);
        types.TypeInfo info! = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            type_id = handle.element;
            info = self.lowerer.ctx.store.types.get(type_id);
        }
        guard info.data is .named(named) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        guard named.type_args.length == 1 else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        return self.lowerer.substitute_type(named.type_args[0], self.substitutions);
    }

    () register_suspend_cancel_handler(
        self,
        hir.HirId handler_id,
        hir.HirLambda handler,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirOperand context = self.heap_lambda_env_operand(handler_id, handler, null, span);
        mir.MirFunctionRef drop = self.cancel_handler_drop_function(handler_id, handler, span);
        mir.MirFunctionRef invoke = self.ensure_cancel_handler_shim(
            handler_id, handler, drop, span
        );
        self.push_assign(
            self.project_constant_index(record, layout.handler_context_field_index),
            mir.use_rvalue(mir.MirUseRvalue (value: context)),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.handler_drop_field_index),
            mir.use_rvalue(mir.MirUseRvalue (value: mir.function_operand_value(drop))),
            span
        );
        self.push_assign(
            self.project_constant_index(record, layout.handler_function_field_index),
            mir.use_rvalue(mir.MirUseRvalue (value: mir.function_operand_value(invoke))),
            span
        );
        self.push_atomic_store(
            self.project_deref(
                self.project_constant_index(record, layout.cancel_word_pointer_field_index),
                true
            ),
            self.suspend_cancel_target_word(record, layout, span),
            span
        );
        self.invoke_suspend_cancel_handler_if_requested(record, layout, span);
    }

    () invoke_suspend_cancel_handler_if_requested(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace request = self.project_deref(
            self.project_constant_index(record, layout.cancel_request_pointer_field_index),
            true
        );
        mir.MirLocalId requested = self.add_temp(self.mir_place_type(request), span);
        self.push_assign(
            self.place_for_local(requested),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: request,
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId invoke = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(1);
        cases.add(mir.MirSwitchCase (value: self.int_const(1, span), target: invoke));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(requested)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.start_block(invoke);
        self.invoke_suspend_cancel_handler(record, layout, span);
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () invoke_suspend_cancel_handler(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace word = self.project_deref(
            self.project_constant_index(record, layout.cancel_word_pointer_field_index),
            true
        );
        mir.MirLocalId claimed = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(claimed),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: word,
                expected: self.suspend_cancel_target_word(record, layout, span),
                desired: mir.const_operand_value(self.int_const(2, span)),
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId invoke = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: invoke,
            else_target: complete
        )), span);
        self.start_block(invoke);
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(record, layout.handler_context_field_index)
        ));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.indirect_operand_callee(self.operand_for_place(
                self.project_constant_index(record, layout.handler_function_field_index)
            )),
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(complete);
    }

    mir.MirFunctionRef cancel_handler_drop_function(
        self,
        hir.HirId handler_id,
        hir.HirLambda handler,
        token.Span span
    ) {
        qid.DefId drop_def! = self.ensure_closure_noop_drop_shim(span);
        if (self.lowerer.typeck.lambda_capture_infos(handler.function_def) is .some(captures)) {
            if (captures.length > 0) {
                qid.TypeId env_type = self.lambda_env_type_for_infos(handler.function_def, captures, span);
                drop_def = self.ensure_lambda_env_drop_shim(handler_id, env_type, true);
            }
        }
        return mir.MirFunctionRef (
            function_def: drop_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: self.lowerer.task_resume_function_type(span),
            span: span
        );
    }

    hir.HirId? call_member_receiver(self, hir.HirCall call) {
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        return member_access.base;
    }

    mir.MirPlace suspend_record_for_receiver(
        self,
        hir.HirId receiver_id,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace receiver! = self.receiver_source_place(receiver_id, span);
        if (self.type_is_reference(self.mir_place_type(receiver))) {
            receiver = self.project_deref(receiver, false);
        }
        mir.MirPlace state = self.project_constant_index(receiver, 0);
        mir.MirLocalId pointer = self.add_temp(layout.pointer_type_id, span);
        mir.MirPlace pointer_place = self.place_for_local(pointer);
        self.push_assign(
            pointer_place,
            mir.cast_rvalue(mir.MirCastRvalue (
                kind: mir.MirCastKind.int_to_ptr,
                value: self.operand_for_place(state),
                target_type: layout.pointer_type_id
            )),
            span
        );
        return self.project_deref(pointer_place, true);
    }

    () resume_suspend_record(
        self,
        hir.HirId value_id,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace phase = self.project_constant_index(record, layout.phase_field_index);
        mir.MirLocalId observed = self.add_temp(self.mir_place_type(phase), span);
        mir.MirLocalId claimed = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        mir.MirLocalId schedule = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        mir.MirBlockId inspect = self.reserve_block(span);
        mir.MirBlockId claim_registering = self.reserve_block(span);
        mir.MirBlockId claim_parked = self.reserve_block(span);
        mir.MirBlockId publish = self.reserve_block(span);
        mir.MirBlockId enqueue = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.finish_block(self.goto_terminator(inspect), span);
        self.start_block(inspect);
        self.push_assign(
            self.place_for_local(observed),
            mir.atomic_load_rvalue(mir.MirAtomicLoadRvalue (
                place: phase,
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<mir.MirSwitchCase> cases! = list.ArrayList<mir.MirSwitchCase>(2);
        cases.add(mir.MirSwitchCase (
            value: self.int_const(suspend_registering, span),
            target: claim_registering
        ));
        cases.add(mir.MirSwitchCase (
            value: self.int_const(suspend_parked, span),
            target: claim_parked
        ));
        self.finish_block(mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.start_block(claim_registering);
        self.push_assign(self.place_for_local(schedule), self.bool_rvalue(false, span), span);
        self.push_assign(
            self.place_for_local(claimed),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: phase,
                expected: self.int_operand(suspend_registering, span),
                desired: self.int_operand(suspend_resuming, span),
                mode: .coroutine_atomic
            )),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: publish,
            else_target: inspect
        )), span);
        self.start_block(claim_parked);
        self.push_assign(self.place_for_local(schedule), self.bool_rvalue(true, span), span);
        self.push_assign(
            self.place_for_local(claimed),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: phase,
                expected: self.int_operand(suspend_parked, span),
                desired: self.int_operand(suspend_resuming, span),
                mode: .coroutine_atomic
            )),
            span
        );
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: publish,
            else_target: inspect
        )), span);
        self.start_block(publish);
        self.clear_suspend_cancel_handler(record, layout, span);
        mir.MirPlace result_pointer = self.project_constant_index(record, layout.result_field_index);
        self.lower_into_place(value_id, self.project_deref(result_pointer, true));
        self.push_atomic_store(phase, self.int_operand(suspend_resumed, span), span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(schedule)),
            then_target: enqueue,
            else_target: complete
        )), span);
        self.start_block(enqueue);
        self.call_suspend_resume(record, layout, complete, span);
        self.start_block(complete);
    }

    () clear_suspend_cancel_handler(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        token.Span span
    ) {
        mir.MirPlace word = self.project_deref(
            self.project_constant_index(record, layout.cancel_word_pointer_field_index), true
        );
        mir.MirLocalId claimed = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(claimed),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: word,
                expected: self.suspend_cancel_target_word(record, layout, span),
                desired: mir.const_operand_value(self.int_const(0, span)),
                mode: .coroutine_atomic
            )),
            span
        );
        mir.MirBlockId drop = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.finish_block(mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: drop,
            else_target: complete
        )), span);
        self.start_block(drop);
        self.call_suspend_handler_drop(record, layout, complete, span);
        self.start_block(complete);
        self.clear_suspend_registration_target(record, layout, span);
    }

    () call_suspend_handler_drop(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        mir.MirBlockId complete,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(record, layout.handler_context_field_index)
        ));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.indirect_operand_callee(self.operand_for_place(
                self.project_constant_index(record, layout.handler_drop_field_index)
            )),
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
    }

    () call_suspend_resume(
        self,
        mir.MirPlace record,
        mir.MirSuspendContinuationLayout layout,
        mir.MirBlockId complete,
        token.Span span
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(record, layout.context_field_index)
        ));
        mir.MirLocalId result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.dynamic_task_enqueue_callee(
                self.operand_for_place(self.project_constant_index(record, layout.executor_field_index)),
                self.operand_for_place(self.project_constant_index(record, layout.task_field_index)),
                self.operand_for_place(self.project_constant_index(record, layout.resume_field_index)),
                false
            ),
            args: self.lowerer.output.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
    }

    () lower_async_direct_call(
        self,
        hir.HirId node_id,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirOperand[]& args,
        mir.MirPlace destination,
        token.Span span
    ) {
        if (self.lowerer.function_is_lowering(target_def, type_args, const_args)) {
            self.lower_recursive_async_direct_call(
                target_def, type_args, const_args, args, destination, span
            );
            return;
        }
        self.ensure_async_call_target(target_def, type_args, const_args);
        guard self.async_call_target_function(target_def, type_args, const_args) is .some(function) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (function.is_external && self.current_effects.has_async) {
            self.lower_external_async_continuation_call(
                node_id,
                target_def,
                type_args,
                const_args,
                args,
                destination,
                span
            );
            return;
        }
        guard function.coroutine_frame is .some(layout) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (self.current_effects.has_async) {
            self.lower_async_direct_continuation_call(
                target_def,
                type_args,
                const_args,
                args,
                destination,
                function$.ref(),
                layout$.ref(),
                span
            );
            return;
        }
        mir.MirLocalId frame_local = self.add_temp(layout.frame_type_id, span);
        mir.MirPlace frame_place = self.place_for_local(frame_local);
        self.lower_async_operands_into_frame(
            args, function$.ref(), layout$.ref(), frame_place, span
        );
        mir.MirLocalId task_local = self.add_temp(layout.task_abi.task_type_id, span);
        mir.MirPlace task_place = self.place_for_local(task_local);
        mir.MirTaskStoragePlan storage = self.parent_owned_task_storage(
            .local, .concurrent
        );
        self.set_task_storage_plan(task_place, storage);
        self.initialize_local_task_state(task_place, layout$.ref(), task_local, span);
        mir.MirFunctionRef resume_function = self.coroutine_generated_function_ref(
            target_def, type_args, const_args, layout$.ref(), true, span
        );
        mir.MirFunctionRef completion_function = self.coroutine_generated_function_ref(
            target_def, type_args, const_args, layout$.ref(), false, span
        );
        mir.MirStatement[]& initializers = coroutine_task_abi.initialized_task_initializers(
            self.lowerer.output,
            layout$.ref(),
            task_place,
            frame_place,
            resume_function,
            completion_function,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.statements.add(initializers[index]);
            index = index + 1;
        }
        self.lower_task_resume_call(task_place, resume_function, null, span);
        self.lower_await_task_ready(task_place, span);
        self.push_assign(destination, mir.use_rvalue(mir.MirUseRvalue (
            value: self.operand_for_place(
                coroutine_task_abi.task_field_place(
                    self.lowerer.output, task_place, layout.task_abi.result_field
                )
            )
        )), span);
        self.release_consumed_task(task_place, true, span);
    }

    () lower_recursive_async_direct_call(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirOperand[]& args,
        mir.MirPlace destination,
        token.Span span
    ) {
        qid.DefId start_def = self.ensure_async_callable_start_shim(
            target_def, type_args, const_args, span
        );
        mir.MirExternalContinuationLayout layout =
            self.lowerer.external_async_continuation_layout(
                self.mir_place_type(destination), span
            );
        mir.MirLocalId continuation = self.add_temp(layout.type_id, span);
        mir.MirPlace continuation_place = self.place_for_local(continuation);
        self.initialize_current_async_continuation(
            layout, continuation_place, destination, span
        );
        mir.MirLocalId continuation_pointer = self.add_temp(
            layout.pointer_type_id, span
        );
        self.push_assign(
            self.place_for_local(continuation_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> start_args! = list.ArrayList<mir.MirOperand>(args.length + 1);
        Int arg_index! = 0;
        while (arg_index < args.length) {
            start_args.add(args[arg_index]);
            arg_index = arg_index + 1;
        }
        start_args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        qid.TypeId source_type = self.function_type_for_ref(
            target_def, type_args, const_args
        );
        mir.MirFunctionRef child_resume = mir.MirFunctionRef (
            function_def: target_def,
            type_args: self.lowerer.output.type_arg_array(type_args),
            const_args: self.lowerer.output.const_arg_array(const_args),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: self.lowerer.coroutine_continuation_type(
                self.lowerer.coroutine_context_pointer_type(span), span
            ),
            span: span
        );
        self.finish_async_direct_start(
            mir.MirFunctionRef (
                function_def: start_def,
                type_args: self.lowerer.output.empty_type_args(),
                const_args: self.lowerer.output.empty_const_args(),
                coroutine_resume: false,
                coroutine_completion: false,
                type_id: self.lowerer.external_async_abi_function_type(source_type, span),
                span: span
            ),
            child_resume,
            start_args$.ref(),
            span
        );
    }

    () lower_external_async_continuation_call(
        self,
        hir.HirId node_id,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirOperand[]& source_args,
        mir.MirPlace destination,
        token.Span span
    ) {
        qid.TypeId context_type = self.lowerer.coroutine_context_pointer_type(span);
        qid.TypeId continuation_type = self.lowerer.coroutine_continuation_type(context_type, span);
        mir.MirExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(
                self.mir_place_type(destination), span
            );
        mir.MirLocalId continuation_record = self.add_temp(continuation_layout.type_id, span);
        mir.MirPlace continuation_place = self.place_for_local(continuation_record);
        mir.MirRvalue context =
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            ));
        mir.MirOperand resume = mir.function_operand_value(mir.MirFunctionRef (
            function_def: self.hir_def.def_id,
            type_args: self.lowerer.output.type_arg_array(self.function_type_args),
            const_args: self.lowerer.output.const_arg_array(self.function_const_args),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: continuation_type,
            span: span
        ));
        self.initialize_external_async_continuation(
            continuation_layout,
            continuation_place,
            destination,
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            context,
            resume,
            span
        );
        mir.MirLocalId continuation_pointer = self.add_temp(
            continuation_layout.pointer_type_id,
            span
        );
        self.push_assign(
            self.place_for_local(continuation_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> abi_args! = list.ArrayList<mir.MirOperand>(source_args.length + 1);
        Int index! = 0;
        while (index < source_args.length) {
            abi_args.add(source_args[index]);
            index = index + 1;
        }
        abi_args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        mir.MirLocalId unit_result = self.add_temp(self.lowerer.ctx.store.types.unit_type(), span);
        mir.MirBlockId next_block = self.reserve_block(span);
        self.compare_exchange_passive_cancel_target(0, 3, span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.direct_function_callee(mir.MirFunctionRef (
                function_def: target_def,
                type_args: self.lowerer.output.type_arg_array(type_args),
                const_args: self.lowerer.output.const_arg_array(const_args),
                coroutine_resume: false,
                coroutine_completion: false,
                type_id: self.lowerer.external_async_abi_function_type(
                    self.function_type_for_ref(target_def, type_args, const_args), span
                ),
                span: span
            )),
            args: self.lowerer.output.operand_array(abi_args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: .external,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
        self.compare_exchange_passive_cancel_target(3, 0, span);
    }

    () lower_async_direct_continuation_call(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirOperand[]& args,
        mir.MirPlace destination,
        mir.MirFunction& function,
        mir.MirCoroutineFrameLayout& layout,
        token.Span span
    ) {
        // 普通 async 调用属于当前 Task：callee frame 保存在父 frame 中，完成后直接恢复父协程。
        mir.MirLocalId frame_local = self.add_temp(layout.frame_type_id, span);
        mir.MirPlace frame_place = self.place_for_local(frame_local);
        self.lower_async_operands_into_frame(args, function, layout, frame_place, span);
        mir.MirFunctionRef parent_resume = mir.MirFunctionRef (
            function_def: self.hir_def.def_id,
            type_args: self.lowerer.output.type_arg_array(self.function_type_args),
            const_args: self.lowerer.output.const_arg_array(self.function_const_args),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: layout.fields[layout.continuation_function_field_index].type_id,
            span: span
        );
        mir.MirStatement[]& initializers = coroutine_task_abi.direct_continuation_initializers(
            self.lowerer.output,
            layout,
            frame_place,
            destination,
            self.place_for_local(self.return_local()),
            parent_resume,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.statements.add(initializers[index]);
            index = index + 1;
        }
        self.push_inherited_frame_domain(layout, frame_place, span);
        mir.MirLocalId frame_pointer = self.add_temp(layout.task_abi.frame_pointer_type_id, span);
        self.push_assign(
            self.place_for_local(frame_pointer),
            mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
                place: frame_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<mir.MirOperand> resume_args! = list.ArrayList<mir.MirOperand>(1);
        resume_args.add(self.operand_for_place(self.place_for_local(frame_pointer)));
        mir.MirLocalId resume_result = self.add_temp(layout.task_abi.resume_return_type_id, span);
        mir.MirBlockId next_block = self.reserve_block(span);
        mir.MirFunctionRef resume_function = self.coroutine_generated_function_ref(
            target_def, type_args, const_args, layout, true, span
        );
        mir.MirCallCallee callee! = mir.direct_function_callee(resume_function);
        mir.MirSuspendWakeKind suspend_wake! = .direct_child;
        if (layout.effects.domain is .some(domain)) {
            if (!types.effect_domain_equal(self.current_effects.domain, layout.effects.domain)) {
                callee = mir.domain_task_enqueue_callee(
                    domain.binding,
                    layout.domain_kind,
                    self.operand_for_place(self.project_constant_index(
                        frame_place, layout.cancellation_context_field_index
                    )),
                    mir.function_operand_value(resume_function),
                    true
                );
                suspend_wake = .cross_executor;
            }
        }
        self.compare_exchange_passive_cancel_target(0, 3, span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: callee,
            args: self.lowerer.output.operand_array(resume_args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: suspend_wake,
            suspend_child: resume_function,
            task_handoff: true,
            destination: self.place_for_local(resume_result),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
        self.compare_exchange_passive_cancel_target(3, 0, span);
    }

    () compare_exchange_passive_cancel_target(
        self,
        Int expected,
        Int desired,
        token.Span span
    ) {
        mir.MirTaskStateLayout state = self.current_task_state_layout();
        mir.MirPlace pointer = self.current_task_cancellation_state_pointer(state, span);
        mir.MirBlockId exchange = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.branch_on_non_null_pointer(pointer, exchange, complete, span);
        self.start_block(exchange);
        mir.MirPlace task = self.project_deref(pointer, true);
        mir.MirPlace target = coroutine_task_abi.task_state_field_place(
            self.lowerer.output, task, state.cancel_target_word
        );
        mir.MirLocalId claimed = self.add_temp(self.lowerer.ctx.store.types.bool_type(), span);
        self.push_assign(
            self.place_for_local(claimed),
            mir.atomic_compare_exchange_rvalue(mir.MirAtomicCompareExchangeRvalue (
                place: target,
                expected: mir.const_operand_value(self.int_const(expected, span)),
                desired: mir.const_operand_value(self.int_const(desired, span)),
                mode: .coroutine_atomic
            )),
            span
        );
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () lower_async_operands_into_frame(
        self,
        mir.MirOperand[]& args,
        mir.MirFunction& function,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_place,
        token.Span span
    ) {
        Int arg_index! = 0;
        Int local_index! = 1;
        while (local_index < function.body.locals.length && arg_index < args.length) {
            mir.MirLocalDecl local = function.body.locals[local_index];
            if (local.kind != .param) {
                local_index = local_index + 1;
                continue;
            }
            mir.MirLocalId param_local = local.id;
            if (self.async_call_frame_field_place(layout, frame_place, param_local) is .some(param_place)) {
                self.push_assign(
                    param_place,
                    mir.use_rvalue(mir.MirUseRvalue (value: args[arg_index])),
                    span
                );
            }
            arg_index = arg_index + 1;
            local_index = local_index + 1;
        }
    }

    () push_inherited_frame_domain(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_place,
        token.Span span
    ) {
        if (layout.effects.domain != null || !self.current_effects.has_async) { return; }
        self.push_assign(
            self.project_constant_index(frame_place, layout.current_executor_field_index),
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            span
        );
    }

    () push_structured_task_frame_domain(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace frame_place,
        mir.MirTaskStoragePlan storage,
        token.Span span
    ) {
        if (storage.sync != .local_serial) {
            self.push_inherited_frame_domain(layout, frame_place, span);
            return;
        }
        self.push_assign(
            self.project_constant_index(frame_place, layout.current_executor_field_index),
            mir.current_executor_rvalue(mir.MirCurrentExecutorRvalue()),
            span
        );
    }

    () push_task_execution_domain_initializers(
        self,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirPlace task,
        mir.MirPlace frame,
        token.Span span
    ) {
        mir.MirStatement[]& initializers = coroutine_task_abi.execution_domain_initializers(
            self.lowerer.output, layout, task, frame, span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.statements.add(initializers[index]);
            index = index + 1;
        }
    }

    mir.MirFunctionRef coroutine_generated_function_ref(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirCoroutineFrameLayout& layout,
        Bool resume,
        token.Span span
    ) {
        qid.TypeId function_type! = layout.fields[layout.continuation_function_field_index].type_id;
        if (resume) { function_type = layout.task_abi.resume_function_type_id; }
        return mir.MirFunctionRef (
            function_def: target_def,
            type_args: self.lowerer.output.type_arg_array(type_args),
            const_args: self.lowerer.output.const_arg_array(const_args),
            coroutine_resume: resume,
            coroutine_completion: !resume,
            type_id: function_type,
            span: span
        );
    }

    mir.MirFunctionRef task_completion_function_ref(
        self,
        qid.DefId target_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        mir.MirCoroutineFrameLayout& layout,
        mir.MirTaskSyncMode sync,
        token.Span span
    ) {
        if (sync == .concurrent) {
            return self.coroutine_generated_function_ref(
                target_def, type_args, const_args, layout, false, span
            );
        }
        qid.DefId shim_def = self.ensure_serial_completion_shim(
            target_def, type_args, const_args, span
        );
        return mir.MirFunctionRef (
            function_def: shim_def,
            type_args: self.lowerer.output.empty_type_args(),
            const_args: self.lowerer.output.empty_const_args(),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: layout.fields[layout.continuation_function_field_index].type_id,
            span: span
        );
    }

    qid.DefId direct_call_target(self, hir.HirId node_id, qid.DefId resolved_def) {
        // HIR 的 call.target/member_selection 是 resolve 阶段得到的原始目标。
        // type check 只在重载、trait 静态分派、构造器等场景把它细化为最终目标。
        if (self.lowerer.typeck.call_target(node_id) is .some(target_def)) {
            return target_def;
        }
        return resolved_def;
    }

    qid.DefId static_dispatch_target_for_call(self, hir.HirCall call, qid.DefId target_def) {
        if (!self.lowerer.def_is_trait_member(target_def)) {
            return target_def;
        }
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else {
            return target_def;
        }
        if (self.extension_member_for_trait_member(target_def, member_access.base) is .some(concrete_def)) {
            return concrete_def;
        }
        if (self.concrete_member_for_trait_member(target_def, member_access.base) is .some(concrete_def)) {
            return concrete_def;
        }
        return target_def;
    }

    qid.DefId? extension_member_for_trait_member(self, qid.DefId trait_member_def, hir.HirId receiver_id) {
        qid.TypeId receiver_type = self.member_lookup_value_type(self.receiver_expr_type(receiver_id));
        guard self.namespace_provider_def_for_type(receiver_type) is .some(provider_def) else { return null; }
        guard self.lowerer.ctx.store.defs.get(trait_member_def).owner_def is .some(trait_def) else {
            return null;
        }
        Int index! = 0;
        while (index < self.lowerer.hirs.extension_group_len()) {
            hir.HirExtensionGroup& group = self.lowerer.hirs.extension_group_ref(index);
            if (group.target_owner_def == provider_def && self.extension_group_matches_trait(group, trait_def)) {
                if (self.extension_group_member_impl(group, trait_member_def, .value_name) is .some(member_def)) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Bool extension_group_matches_trait(self, hir.HirExtensionGroup& group, qid.DefId trait_def) {
        guard group.trait_ref is .some(trait_ref) else { return false; }
        hir.HirNode node = self.lowerer.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id == trait_def;
    }

    qid.DefId? extension_group_member_impl(self,
        hir.HirExtensionGroup& group,
        qid.DefId trait_member_def,
        def.NameDomain domain
    ) {
        Int index! = 0;
        while (index < group.members.len()) {
            qid.DefId member_def = group.members.get(index);
            if (self.extension_member_matches_trait_member(member_def, trait_member_def, domain)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool extension_member_matches_trait_member(self, qid.DefId member_def, qid.DefId trait_member_def, def.NameDomain domain) {
        def.DefRecord member = self.lowerer.ctx.store.defs.get(member_def);
        if (member.domain != domain) { return false; }
        if (member.associated_trait_member is .some(implemented_member)) {
            return implemented_member == trait_member_def;
        }
        return member.name.symbol == self.lowerer.ctx.store.defs.get(trait_member_def).name.symbol;
    }

    qid.DefId? concrete_member_for_trait_member(self, qid.DefId trait_member_def, hir.HirId receiver_id) {
        qid.SymbolId member_symbol = self.lowerer.ctx.store.defs.get(trait_member_def).name.symbol;
        qid.TypeId receiver_type = self.member_lookup_value_type(self.receiver_expr_type(receiver_id));
        guard self.nominal_type_data(receiver_type) is .some(named) else {
            return null;
        }
        qid.DefId? member_def = self.function_member_def_by_symbol(named.def_id, member_symbol);
        guard member_def is .some(concrete_def) else {
            return null;
        }
        if (self.lowerer.def_is_trait_member(concrete_def)) {
            return null;
        }
        return concrete_def;
    }

    Bool lower_subscript_get(self, hir.HirId node_id, hir.HirIndexAccess index_access, mir.MirPlace destination) {
        guard self.lowerer.typeck.member_selection(node_id) is .some(function_def) else {
            return false;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(function_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(index_access.base, mutable_reference));
        args.add(self.lower_to_operand(index_access.index));
        self.lower_direct_function_call(node_id, function_def, args$.ref(), destination);
        return true;
    }

    Bool lower_subscript_assignment(self, hir.HirAssign assign_stmt) {
        if (assign_stmt.op != .assign) {
            return false;
        }
        hir.HirNode target = self.lowerer.hirs.node(assign_stmt.target);
        guard target.data is .index_access(index_access) else {
            return false;
        }
        guard self.subscript_set_def(assign_stmt.target) is .some(function_def) else {
            return false;
        }
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>(3);
        Bool mutable_reference = self.function_self_receiver_mode(function_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(index_access.base, mutable_reference));
        args.add(self.lower_to_operand(index_access.index));
        args.add(self.lower_to_operand(assign_stmt.value));
        mir.MirLocalId unit_temp = self.add_temp(
            self.lowerer.ctx.store.types.unit_type(),
            self.lowerer.hir_span(assign_stmt.target)
        );
        self.lower_direct_function_call(assign_stmt.target, function_def, args$.ref(), self.place_for_local(unit_temp));
        return true;
    }

    qid.DefId? subscript_set_def(self, hir.HirId index_id) {
        guard self.lowerer.typeck.member_selection(index_id) is .some(get_def) else {
            return null;
        }
        guard self.lowerer.ctx.store.defs.get(get_def).owner_def is .some(owner_def) else {
            return null;
        }
        qid.SymbolId symbol = self.lowerer.ctx.store.symbols.intern("subscript_set");
        return self.member_def_by_symbol(owner_def, symbol);
    }

    qid.DefId? member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.lowerer.hirs.def(owner_def) is .some(owner_hir) else {
            return null;
        }
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? function_member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.lowerer.hirs.def(owner_def) is .some(owner_hir) else {
            return null;
        }
        Int index! = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            def.DefRecord record = self.lowerer.ctx.store.defs.get(member_def);
            if (record.kind == .function_def && record.name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    () lower_direct_function_call(self,
        hir.HirId node_id,
        qid.DefId function_def,
        list.ArrayList<mir.MirOperand>& args,
        mir.MirPlace destination
    ) {
        def.DefKind function_kind = self.lowerer.ctx.store.defs.get(function_def).kind;
        if (self.is_assert_call(function_def, function_kind)) {
            self.lower_assert_operands(node_id, args);
            return;
        }
        qid.TypeId[]& type_args = self.selected_member_type_args(node_id);
        comptime_value.ComptimeValue[]& const_args = self.function_call_const_args(node_id, node_id, function_def);
        qid.TypeId function_type = self.function_type_for_ref(function_def, type_args, const_args);
        if (type_args.length > 0 || const_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(function_def, type_args, const_args);
        } else {
            self.lowerer.ensure_external_function(function_def);
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: self.function_callee_with_args(node_id, function_def, function_type, type_args, const_args),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_direct_function_call_with_type_args(self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        list.ArrayList<mir.MirOperand>& args,
        mir.MirPlace destination,
        token.Span span
    ) {
        comptime_value.ComptimeValue[]& const_args = self.lowerer.output.empty_const_args();
        qid.TypeId function_type = self.function_type_for_ref(function_def, type_args, const_args);
        if (type_args.length > 0) {
            self.lowerer.ensure_function_instance_with_const_args(function_def, type_args, const_args);
        } else {
            self.lowerer.ensure_external_function(function_def);
        }
        mir.MirBlockId next_block = self.reserve_block(span);
        self.finish_block(mir.call_terminator_kind(mir.MirCallTerminator (
            callee: self.direct_function_callee(function_def, function_type, type_args, const_args, span),
            args: self.lowerer.output.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.output.empty_places(),
            cleanup: null
        )), span);
        self.start_block(next_block);
    }

    mir.MirCallCallee direct_function_callee(self,
        qid.DefId function_def,
        qid.TypeId function_type,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        token.Span span
    ) {
        return mir.direct_function_callee(mir.MirFunctionRef (
            function_def: function_def,
            type_args: self.lowerer.output.type_arg_array(type_args),
            const_args: self.lowerer.output.const_arg_array(const_args),
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: function_type,
            span: span
        ));
    }

    qid.TypeId[]& method_type_args_for_receiver(self, qid.TypeId receiver_type, qid.DefId function_def) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(receiver_type);
        guard info.data is .named(named) else {
            return self.lowerer.output.empty_type_args();
        }
        if (named.type_args.length == 0) {
            return self.lowerer.output.empty_type_args();
        }
        guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return self.lowerer.output.empty_type_args();
        }
        if (named.def_id != owner_def) {
            return self.lowerer.output.empty_type_args();
        }
        return self.concrete_instance_type_args(named.type_args);
    }

    qid.TypeId[]& selected_member_type_args(self, hir.HirId node_id) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            return self.concrete_instance_type_args(instance.type_args);
        }
        return self.lowerer.output.empty_type_args();
    }

    list.ArrayList<mir.MirOperand> lower_call_operands(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId target_def,
        qid.TypeId function_type
    ) {
        list.ArrayList<mir.MirOperand> args! = list.ArrayList<mir.MirOperand>();
        types.FunctionType signature = self.function_type_or_empty(function_type);
        self.add_receiver_call_operand(call, target_def, args$.ref());
        Int param_offset = args.len();
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(ordered)) {
            self.add_ordered_call_operands(args$.ref(), ordered.values, signature, param_offset);
            return args$.move();
        }
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_call_arg_operand(call.args[index].value, signature, index + param_offset));
            index = index + 1;
        }
        return args$.move();
    }

    () add_receiver_call_operand(self,
        hir.HirCall call,
        qid.DefId target_def,
        list.ArrayList<mir.MirOperand>& args
    ) {
        if (!self.function_has_receiver_abi(target_def)) {
            return;
        }
        hir.HirNode callee = self.lowerer.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else {
            return;
        }
        if (self.function_self_receiver_mode(target_def) == .move_receiver) {
            args.add(self.lower_move_receiver_operand(member_access.base));
            return;
        }
        Bool mutable_reference = self.function_self_receiver_mode(target_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(member_access.base, mutable_reference));
    }

    hir.HirSelfReceiverMode function_self_receiver_mode(self, qid.DefId function_def) {
        guard self.lowerer.hirs.def(function_def) is .some(hir_def) else {
            return .ref_receiver;
        }
        guard hir_def.decl.function_signature is .some(signature) else {
            return .ref_receiver;
        }
        return signature.receiver_mode;
    }

    mir.MirOperand lower_move_receiver_operand(self, hir.HirId receiver) {
        token.Span span = self.lowerer.hir_span(receiver);
        mir.MirPlace source = self.receiver_source_place(receiver, span);
        if (source.projection.length != 0) {
            self.mark_unsupported(receiver);
            return self.lower_to_operand(receiver);
        }
        return mir.move_operand_value(mir.MirMoveOperand (place: source));
    }

    mir.MirOperand lower_receiver_operand(self, hir.HirId receiver, Bool mutable_reference) {
        token.Span span = self.lowerer.hir_span(receiver);
        if (self.reference_receiver_place(receiver) is .some(reference_place)) {
            return mir.copy_operand_value(mir.MirCopyOperand (place: reference_place));
        }
        qid.TypeId receiver_type = self.type_for_node(receiver);
        if (self.type_is_reference(receiver_type)) {
            return self.lower_to_operand(receiver);
        }
        if (self.receiver_pointee_place(receiver) is .some(pointee)) {
            return self.borrow_receiver_place(pointee, self.mir_place_type(pointee), mutable_reference, span);
        }
        mir.MirPlace source = self.receiver_source_place(receiver, span);
        return self.borrow_receiver_place(source, receiver_type, mutable_reference, span);
    }

    mir.MirOperand borrow_receiver_place(
        self,
        mir.MirPlace source,
        qid.TypeId value_type,
        Bool mutable_reference,
        token.Span span
    ) {
        qid.TypeId reference_type! = self.lowerer.ctx.store.types.reference_type(value_type, span);
        if (mutable_reference) {
            reference_type = self.lowerer.ctx.store.types.mutable_type(reference_type, span);
        }
        mir.MirLocalId reference_local = self.add_temp(reference_type, span);
        mir.MirPlace reference_place = self.place_for_local(reference_local);
        self.push_assign(
            reference_place,
            mir.borrow_rvalue(mir.MirBorrowRvalue (place: source)),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: reference_place));
    }

    mir.MirPlace? receiver_pointee_place(self, hir.HirId receiver) {
        qid.TypeId receiver_type = self.type_for_node(receiver);
        types.TypeInfo info = self.lowerer.ctx.store.types.get(receiver_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (!self.handle_receiver_needs_deref(handle.kind)) {
            return null;
        }
        return self.pointer_deref_place(receiver);
    }

    Bool handle_receiver_needs_deref(self, types.HandleTypeKind kind) {
        if (kind == .owner_pointer) { return true; }
        return kind == .raw_pointer;
    }

    mir.MirPlace? reference_receiver_place(self, hir.HirId receiver) {
        guard self.place_for_expr(receiver) is .some(place) else {
            return null;
        }
        if (self.type_is_reference(self.mir_place_type(place))) {
            return place;
        }
        return null;
    }

    Bool type_is_reference(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .reference;
    }

    mir.MirPlace receiver_source_place(self, hir.HirId receiver, token.Span span) {
        if (self.place_for_expr(receiver) is .some(place)) {
            return place;
        }
        mir.MirLocalId local = self.add_temp(self.type_for_node(receiver), span);
        mir.MirPlace place = self.place_for_local(local);
        self.lower_into_place(receiver, place);
        return place;
    }

    Bool function_has_receiver_abi(self, qid.DefId function_def) {
        // MIR function ABI 由 signature 决定。body lower 会在 HIR 没有显式
        // `self` local 时合成 receiver local，所以 call 侧不能再用 body.locals
        // 反推，否则会漏传 receiver 并导致所有后续参数错位。
        guard self.lowerer.hirs.def(function_def) is .some(hir_def) else {
            return false;
        }
        guard hir_def.decl.function_signature is .some(signature) else {
            return false;
        }
        return signature.has_receiver;
    }

    () add_ordered_call_operands(self,
        list.ArrayList<mir.MirOperand>& args,
        hir.HirId[]& values,
        types.FunctionType signature,
        Int param_offset
    ) {
        Int index! = 0;
        while (index < values.length) {
            args.add(self.lower_call_arg_operand(values[index], signature, index + param_offset));
            index = index + 1;
        }
    }

    mir.MirOperand lower_call_arg_operand(self, hir.HirId value, types.FunctionType signature, Int param_index) {
        if (param_index < 0 || param_index >= signature.params.length) {
            return self.lower_to_operand(value);
        }
        token.Span span = self.lowerer.hir_span(value);
        mir.MirLocalId local = self.add_temp(signature.params[param_index], span);
        mir.MirPlace place = self.place_for_local(local);
        self.lower_into_place(value, place);
        return self.operand_for_place(place);
    }

    types.FunctionType function_type_or_empty(self, qid.TypeId function_type) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(function_type);
        if (info.data is .function_type(signature)) {
            return signature;
        }
        return types.FunctionType (
            params: self.lowerer.output.empty_type_args(),
            result: self.lowerer.ctx.store.types.unit_type(),
            effects: types.EffectSet(),
            kind: .raw
        );
    }

    mir.MirOperand function_operand(self, hir.HirId node_id, qid.DefId function_def, qid.TypeId function_type) {
        qid.TypeId[]& type_args! = self.lowerer.output.empty_type_args();
        comptime_value.ComptimeValue[]& const_args! = self.lowerer.output.empty_const_args();
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                type_args = self.substituted_type_arg_array(instance.type_args);
                const_args = self.lowerer.output.const_arg_array(instance.const_args);
            }
        }
        qid.TypeId concrete_function_type = self.function_type_for_ref(function_def, type_args, const_args);
        return mir.function_operand_value(
            self.function_ref(node_id, function_def, concrete_function_type, type_args, const_args)
        );
    }

    mir.MirCallCallee function_callee_with_args(self,
        hir.HirId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return mir.direct_function_callee(
            self.function_ref(node_id, function_def, function_type, type_args, const_args)
        );
    }

    @life(type_args > return, const_args > return)
    mir.MirFunctionRef function_ref(self,
        hir.HirId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return mir.MirFunctionRef (
            function_def: function_def,
            type_args: type_args,
            const_args: const_args,
            coroutine_resume: false,
            coroutine_completion: false,
            type_id: function_type,
            span: self.lowerer.hir_span(node_id)
        );
    }

    qid.TypeId[]& function_call_type_args(self, hir.HirId node_id, hir.HirId callee_id, qid.DefId function_def) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                qid.TypeId[]& type_args = self.concrete_instance_type_args(instance.type_args);
                if (instance.type_args.length == 0 || type_args.length > 0) {
                    return type_args;
                }
            }
        }
        if (self.lowerer.typeck.generic_instance(callee_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                qid.TypeId[]& type_args = self.concrete_instance_type_args(instance.type_args);
                if (instance.type_args.length == 0 || type_args.length > 0) {
                    return type_args;
                }
            }
        }
        if (self.receiver_owner_type_args(callee_id, function_def) is .some(receiver_args)) {
            return receiver_args;
        }
        return self.function_ref_type_args(callee_id, function_def);
    }

    comptime_value.ComptimeValue[]& function_call_const_args(self,
        hir.HirId node_id,
        hir.HirId callee_id,
        qid.DefId function_def
    ) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                return self.lowerer.output.const_arg_array(instance.const_args);
            }
        }
        if (self.lowerer.typeck.generic_instance(callee_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                return self.lowerer.output.const_arg_array(instance.const_args);
            }
        }
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        if (callee.data is .member_access(member_access)) {
            guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
                return self.lowerer.output.empty_const_args();
            }
            if (self.lowerer.typeck.generic_instance(member_access.base) is .some(instance)) {
                if (instance.def_id == owner_def) {
                    return self.lowerer.output.const_arg_array(instance.const_args);
                }
            }
        }
        if (self.receiver_owner_const_args(callee_id, function_def) is .some(receiver_args)) {
            return receiver_args;
        }
        return self.lowerer.output.empty_const_args();
    }

    comptime_value.ComptimeValue[]& function_ref_const_args(self, hir.HirId node_id, qid.DefId function_def) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                return self.lowerer.output.const_arg_array(instance.const_args);
            }
        }
        return self.lowerer.output.empty_const_args();
    }

    qid.TypeId[]&? receiver_owner_type_args(self, hir.HirId callee_id, qid.DefId function_def) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else { return null; }
        qid.TypeId receiver_type = self.member_lookup_value_type(self.receiver_expr_type(member_access.base));
        return self.receiver_type_args_for_owner(receiver_type, owner_def);
    }

    qid.TypeId[]&? receiver_type_args_for_owner(self, qid.TypeId receiver_type, qid.DefId owner_def) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(receiver_type);
        if (info.data is .named(named)) {
            if (named.def_id != owner_def || named.type_args.length == 0) { return null; }
            qid.TypeId[]& concrete_args = self.concrete_instance_type_args(named.type_args);
            if (concrete_args.length == 0) { return null; }
            return concrete_args;
        }
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>();
        if (info.data is .array_type(array_type)) {
            if (!self.array_type_matches_owner(owner_def, array_type)) { return null; }
            args.add(array_type.element);
            return self.lowerer.output.type_arg_array(args.slice());
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (!self.slice_type_matches_owner(owner_def, slice_type)) { return null; }
            args.add(slice_type.element);
            return self.lowerer.output.type_arg_array(args.slice());
        }
        return null;
    }

    comptime_value.ComptimeValue[]&? receiver_owner_const_args(self, hir.HirId callee_id, qid.DefId function_def) {
        hir.HirNode callee = self.lowerer.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        guard self.lowerer.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else { return null; }
        qid.TypeId receiver_type = self.member_lookup_value_type(self.receiver_expr_type(member_access.base));
        return self.receiver_const_args_for_owner(receiver_type, owner_def);
    }

    qid.TypeId receiver_expr_type(self, hir.HirId receiver_id) {
        qid.TypeId node_type = self.type_for_node(receiver_id);
        if (node_type.to_index() != self.lowerer.ctx.store.types.invalid_type().to_index()
            && !self.type_contains_generic_param(node_type)) {
            return node_type;
        }
        if (self.place_for_expr(receiver_id) is .some(place)) {
            return self.mir_place_type(place);
        }
        return node_type;
    }

    comptime_value.ComptimeValue[]&? receiver_const_args_for_owner(self, qid.TypeId receiver_type, qid.DefId owner_def) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(receiver_type);
        if (info.data is .named(named)) {
            if (named.def_id != owner_def || named.const_args.length == 0) { return null; }
            return self.lowerer.output.const_arg_array(named.const_args);
        }
        list.ArrayList<comptime_value.ComptimeValue> args! = list.ArrayList<comptime_value.ComptimeValue>();
        if (info.data is .array_type(array_type)) {
            if (!self.array_type_matches_owner(owner_def, array_type)) { return null; }
            args.add(self.array_count_comptime_value(array_type));
            if (self.is_sentinel_array_owner(owner_def)) {
                guard array_type.sentinel is .some(sentinel) else { return null; }
                args.add(self.sentinel_comptime_value(sentinel));
            }
            return self.lowerer.output.const_arg_array(args.slice());
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (!self.is_sentinel_slice_owner(owner_def)) { return null; }
            guard slice_type.sentinel is .some(sentinel) else { return null; }
            args.add(self.sentinel_comptime_value(sentinel));
            return self.lowerer.output.const_arg_array(args.slice());
        }
        return null;
    }

    qid.DefId? namespace_provider_def_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.type_owner_def is .some(owner_def)) { return owner_def; }
        if (info.data is .named(named)) { return named.def_id; }
        if (info.data is .array_type(array_type)) {
            if (array_type.sentinel != null) { return self.lowerer.ctx.store.resolve.core_types.sentinel_array_type; }
            return self.lowerer.ctx.store.resolve.core_types.array_type;
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (slice_type.sentinel != null) { return self.lowerer.ctx.store.resolve.core_types.sentinel_slice_type; }
            return self.lowerer.ctx.store.resolve.core_types.slice_type;
        }
        return null;
    }

    Bool array_type_matches_owner(self, qid.DefId owner_def, types.ArrayType array_type) {
        if (array_type.sentinel != null) {
            return self.is_sentinel_array_owner(owner_def);
        }
        return self.is_array_owner(owner_def);
    }

    Bool slice_type_matches_owner(self, qid.DefId owner_def, types.SliceValueType slice_type) {
        if (slice_type.sentinel != null) {
            return self.is_sentinel_slice_owner(owner_def);
        }
        return self.is_slice_owner(owner_def);
    }

    Bool is_array_owner(self, qid.DefId owner_def) {
        guard self.lowerer.ctx.store.resolve.core_types.array_type is .some(array_def) else { return false; }
        return owner_def == array_def;
    }

    Bool is_sentinel_array_owner(self, qid.DefId owner_def) {
        guard self.lowerer.ctx.store.resolve.core_types.sentinel_array_type is .some(array_def) else { return false; }
        return owner_def == array_def;
    }

    Bool is_slice_owner(self, qid.DefId owner_def) {
        guard self.lowerer.ctx.store.resolve.core_types.slice_type is .some(slice_def) else { return false; }
        return owner_def == slice_def;
    }

    Bool is_sentinel_slice_owner(self, qid.DefId owner_def) {
        guard self.lowerer.ctx.store.resolve.core_types.sentinel_slice_type is .some(slice_def) else { return false; }
        return owner_def == slice_def;
    }

    comptime_value.ComptimeValue array_count_comptime_value(self, types.ArrayType array_type) {
        qid.TypeId int_type = self.lowerer.ctx.store.types.int_type();
        if (array_type.count_param is .some(param_def)) {
            return comptime_value.ComptimeValue(type_id: int_type, data: .const_param_value(param_def));
        }
        return comptime_value.ComptimeValue(type_id: int_type, data: .int_value(array_type.count));
    }

    comptime_value.ComptimeValue sentinel_comptime_value(self, types.Sentinel sentinel) {
        return sentinel.value;
    }

    qid.TypeId function_type_for_ref(self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        guard self.lowerer.typeck.def_type(function_def) is .some(raw_type) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        if (type_args.length == 0 && const_args.length == 0) {
            return self.lowerer.substitute_type(raw_type, self.substitutions);
        }
        guard self.lowerer.hirs.def(function_def) is .some(hir_def) else {
            return self.lowerer.ctx.store.types.invalid_type();
        }
        // MIR function ref 必须保存 concrete 函数签名。不能用 call 表达式的
        // 结果类型，也不能只按 type args 替换；const args 会影响数组等 ABI 布局。
        monomorph.InstanceKey instance! = monomorph.InstanceKey(function_def, type_args, const_args);
        if (self.lowerer.instances.instance_for_codegen_args(function_def, type_args, const_args)
            is .some(stored_instance)
        ) {
            instance = stored_instance;
        }
        monomorph.SubstitutionMap substitutions = monomorph.build_substitution(
            self.lowerer.ctx.store$.ref(), hir_def, instance
        );
        return self.lowerer.substitute_type(raw_type, substitutions$.ref());
    }

    qid.TypeId[]& concrete_instance_type_args(self, qid.TypeId[]& type_args) {
        qid.TypeId[]& concrete_args = self.substituted_type_arg_array(type_args);
        if (self.lowerer.type_args_are_concrete(concrete_args) && !self.type_args_contain_generic_params(concrete_args)) {
            return concrete_args;
        }
        return self.lowerer.output.empty_type_args();
    }

    Bool type_args_contain_generic_params(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            if (self.type_contains_generic_param(type_args[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool type_contains_generic_param(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.lowerer.ctx.store.defs.get(named.def_id).kind == .generic_param_def) {
                return true;
            }
            Int index! = 0;
            while (index < named.type_args.length) {
                if (self.type_contains_generic_param(named.type_args[index])) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        if (info.data is .optional(optional)) {
            return self.type_contains_generic_param(optional.element);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_contains_generic_param(handle.element);
        }
        if (info.data is .slice_value_type(slice_type)) {
            return self.type_contains_generic_param(slice_type.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_contains_generic_param(array_type.element);
        }
        return false;
    }

    qid.TypeId[]& substituted_type_arg_array(self, qid.TypeId[]& type_args) {
        if (self.substitutions.len() == 0) {
            return self.lowerer.output.type_arg_array(type_args);
        }
        list.ArrayList<qid.TypeId> substituted! = list.ArrayList<qid.TypeId>(type_args.length);
        Int index! = 0;
        while (index < type_args.length) {
            substituted.add(self.lowerer.substitute_type(type_args[index], self.substitutions));
            index = index + 1;
        }
        return self.lowerer.output.type_arg_array(substituted.slice());
    }

    Bool is_builtin_call(self, qid.DefId def_id, UInt8[]& name) {
        def.DefRecord def_record = self.lowerer.ctx.store.defs.get(def_id);
        return string.equal(self.lowerer.ctx.store.symbols.text(def_record.name.symbol), name);
    }

    AtomicBuiltin? atomic_builtin(self, hir.HirCall call, qid.DefId def_id) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else { return null; }
        if (hir_def.decl.extern_kind != .builtin) { return null; }
        UInt8[]& name = self.lowerer.ctx.store.symbols.text(
            self.lowerer.ctx.store.defs.get(def_id).name.symbol
        );
        if (string.equal(name, "atomic_load") && call.args.length == 2) {
            guard self.atomic_ordering(call.args[1].value) is .some(ordering) else { return null; }
            return AtomicBuiltin(.load, ordering, .relaxed);
        }
        if (string.equal(name, "atomic_store") && call.args.length == 3) {
            guard self.atomic_ordering(call.args[2].value) is .some(ordering) else { return null; }
            return AtomicBuiltin(.store, ordering, .relaxed);
        }
        if (string.equal(name, "atomic_compare_exchange") && call.args.length == 5) {
            guard self.atomic_ordering(call.args[3].value) is .some(success) else { return null; }
            guard self.atomic_ordering(call.args[4].value) is .some(failure) else { return null; }
            return AtomicBuiltin(.compare_exchange, success, failure);
        }
        return null;
    }

    mir.MirAtomicOrdering? atomic_ordering(self, hir.HirId value_id) {
        guard self.enum_case_def_for_value(value_id) is .some(case_def) else { return null; }
        UInt8[]& name = self.lowerer.ctx.store.symbols.text(
            self.lowerer.ctx.store.defs.get(case_def).name.symbol
        );
        if (string.equal(name, "relaxed")) { return mir.MirAtomicOrdering.relaxed; }
        if (string.equal(name, "acquire")) { return mir.MirAtomicOrdering.acquire; }
        if (string.equal(name, "release")) { return mir.MirAtomicOrdering.release; }
        if (string.equal(name, "acquire_release")) { return mir.MirAtomicOrdering.acquire_release; }
        if (string.equal(name, "sequential")) {
            return mir.MirAtomicOrdering.sequentially_consistent;
        }
        return null;
    }

    qid.DefId? call_callee_def(self, hir.HirId callee) {
        if (self.lowerer.ctx.store.typeck.member_selection(callee) is .some(member_def)) {
            return member_def;
        }
        hir.HirNode node = self.lowerer.hirs.node(callee);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    Bool is_assert_call(self, qid.DefId def_id, def.DefKind kind) {
        if (kind != .function_def || !self.is_builtin_call(def_id, "assert")) {
            return false;
        }
        return !self.lowerer.hirs.has_body(def_id);
    }

    () lower_builtin_assert(self, hir.HirId node_id, hir.HirCall call) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_assert_operand(node_id, self.lower_to_operand(call.args[0].value));
    }

    () lower_assert_operands(self, hir.HirId node_id, list.ArrayList<mir.MirOperand>& args) {
        if (args.len() != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_assert_operand(node_id, args.get(0));
    }

    () lower_assert_operand(self, hir.HirId node_id, mir.MirOperand condition) {
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(mir.assert_terminator_kind(mir.MirAssertTerminator (
            condition: condition,
            expected: true,
            message: null,
            target: next_block,
            cleanup: null
        )), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    () lower_union_variant_constructor(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId variant_def,
        mir.MirPlace destination
    ) {
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>(call.args.length);
        Int index! = 0;
        while (index < call.args.length) {
            fields.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        self.push_assign(
            destination,
            mir.aggregate_rvalue(mir.MirAggregateRvalue (
                kind: mir.MirAggregateKind.union_variant,
                def_id: variant_def,
                type_id: self.type_for_node(node_id),
                tag: self.union_variant_tag_operand(node_id, variant_def),
                payload_field_index: self.union_variant_payload_field_index(node_id, variant_def),
                fields: self.lowerer.output.operand_array(fields$.ref())
            )),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand unsupported_operand(self, hir.HirId node_id) {
        self.mark_unsupported(node_id);
        return mir.const_operand_value(mir.MirConst (
            type_id: self.lowerer.ctx.store.types.invalid_type(),
            span: self.lowerer.hir_span(node_id),
            value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
        ));
    }

    mir.MirOperand union_variant_tag_operand(self, hir.HirId node_id, qid.DefId variant_def) {
        return mir.const_operand_value(self.variant_tag_const(
            node_id,
            variant_def,
            self.lowerer.ctx.store.types.int_type()
        ));
    }

    Int union_variant_payload_field_index(self, hir.HirId node_id, qid.DefId variant_def) {
        qid.TypeId owner_type = self.type_for_node(node_id);
        guard self.layout_field_index_for_def(owner_type, variant_def) is .some(field_index) else {
            self.lowerer.output.mark_error();
            self.add_field_projection_layout_diagnostic(owner_type, variant_def);
            return -1;
        }
        return field_index;
    }

    () mark_unsupported(self, hir.HirId node_id) {
        self.lowerer.output.mark_error();
        self.add_unsupported_diagnostic(node_id);
    }

    () add_unsupported_diagnostic(self, hir.HirId node_id) {
        mir_diagnostics.add_unsupported_hir(
            self.lowerer.ctx,
            node_id,
            self.lowerer.hirs.node(node_id)
        );
    }

    () add_field_projection_layout_diagnostic(self, qid.TypeId owner_type, qid.DefId field_def) {
        mir_diagnostics.add_field_projection_layout_mismatch(self.lowerer.ctx, owner_type, field_def);
    }

    () push_assign(self, mir.MirPlace destination, mir.MirRvalue value, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.assign_statement_kind(mir.MirAssignStatement (
                destination: destination,
                value: value
            ))
        ));
    }

    () push_exclusive(self, mir.MirPlace place, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.exclusive_statement_kind(mir.MirExclusiveStatement (place: place))
        ));
    }

    mir.MirRvalue aggregate_rvalue(self, mir.MirAggregateRvalue aggregate, token.Span span) {
        return mir.aggregate_rvalue(self.normalize_aggregate(aggregate, span));
    }

    @life(self > return, aggregate > return)
    mir.MirAggregateRvalue normalize_aggregate(self, mir.MirAggregateRvalue aggregate, token.Span span) {
        if (aggregate.kind == .union_variant) {
            return aggregate;
        }
        list.ArrayList<mir.MirOperand> fields! = list.ArrayList<mir.MirOperand>(aggregate.fields.length);
        Int index! = 0;
        while (index < aggregate.fields.length) {
            qid.TypeId field_type = self.aggregate_field_type(aggregate, index);
            fields.add(self.normalize_aggregate_operand(aggregate.fields[index], field_type, span));
            index = index + 1;
        }
        return mir.MirAggregateRvalue (
            kind: aggregate.kind,
            def_id: aggregate.def_id,
            type_id: aggregate.type_id,
            tag: aggregate.tag,
            payload_field_index: aggregate.payload_field_index,
            fields: self.lowerer.output.operand_array(fields$.ref())
        );
    }

    qid.TypeId aggregate_field_type(self, mir.MirAggregateRvalue aggregate, Int field_index) {
        if (aggregate.def_id is .some(def_id)) {
            if (self.aggregate_nominal_field_type(aggregate.type_id, def_id, field_index) is .some(field_type)) {
                return field_type;
            }
        }
        return self.sequence_aggregate_field_type(aggregate.type_id, field_index);
    }

    qid.TypeId? aggregate_nominal_field_type(self, qid.TypeId type_id, qid.DefId def_id, Int field_index) {
        guard self.lowerer.hirs.def(def_id) is .some(hir_def) else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution_for_type(type_id, def_id);
        Int field_count! = 0;
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                if (field_count == field_index) {
                    return self.field_expected_type(member_def, substitutions$.ref());
                }
                field_count = field_count + 1;
            }
            index = index + 1;
        }
        return null;
    }

    monomorph.SubstitutionMap nominal_substitution_for_type(self, qid.TypeId type_id, qid.DefId def_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            return self.nominal_substitution(named.def_id, named.type_args);
        }
        return self.nominal_substitution(def_id, self.lowerer.output.empty_type_args());
    }

    qid.TypeId sequence_aggregate_field_type(self, qid.TypeId type_id, Int field_index) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .tuple_type(tuple_type)) {
            if (field_index < tuple_type.items.length) { return tuple_type.items[field_index]; }
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    mir.MirOperand normalize_aggregate_operand(self, mir.MirOperand value, qid.TypeId expected, token.Span span) {
        if (self.value_needs_optional_lift(value, expected)) {
            return self.lower_optional_lift_operand_with_span(value, expected, span);
        }
        return self.lower_error_union_lift_operand_with_span_if_needed(value, expected, span);
    }

    mir.MirOperand lower_optional_lift_operand_with_span(self,
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        mir.MirLocalId temp = self.add_temp(expected, span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.optional_rvalue(mir.MirOptionalRvalue (
                op: mir.MirOptionalOp.make_some,
                value: value
            )),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: temp_place));
    }

    mir.MirOperand lower_error_union_lift_operand_with_span_if_needed(self,
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        if (self.value_needs_error_union_lift(value, expected)) {
            return self.lower_error_union_lift_operand_with_span(value, expected, span);
        }
        return value;
    }

    mir.MirOperand lower_error_union_lift_operand_with_span(self,
        mir.MirOperand value,
        qid.TypeId expected,
        token.Span span
    ) {
        mir.MirLocalId temp = self.add_temp(expected, span);
        mir.MirPlace temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            mir.error_union_rvalue(mir.MirErrorUnionRvalue (
                op: mir.MirErrorUnionOp.make_value,
                value: value
            )),
            span
        );
        return mir.copy_operand_value(mir.MirCopyOperand (place: temp_place));
    }

    () push_storage_live(self, mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.storage_live_statement_kind(mir.MirStorageLiveStatement (local_id: local_id))
        ));
    }

    () push_storage_dead(self, mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.storage_dead_statement_kind(mir.MirStorageDeadStatement (local_id: local_id))
        ));
    }

    Bool local_is_scoped_task(self, mir.MirLocalId local_id) {
        mir.MirLocalDecl local = self.locals.get(local_id.to_index());
        if (local.kind != mir.MirLocalKind.user_local) { return false; }
        return self.lowerer.ctx.store.types.get(local.type_id).data is .task_type(_);
    }

    () request_scoped_task_cancellation_if_present(
        self,
        mir.MirLocalId local_id,
        token.Span span
    ) {
        mir.MirPlace task_place = self.place_for_local(local_id);
        mir.MirTaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        mir.MirPlace task_pointer = coroutine_task_abi.task_handle_pointer_place(
            self.lowerer.output, task_place
        );
        mir.MirBlockId cancel = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.branch_on_non_null_pointer(task_pointer, cancel, complete, span);
        self.start_block(cancel);
        self.request_task_cancellation(task_place, task_state, span);
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () join_scoped_task_if_present(
        self,
        mir.MirLocalId local_id,
        token.Span span
    ) {
        mir.MirPlace task_place = self.place_for_local(local_id);
        mir.MirPlace task_pointer = coroutine_task_abi.task_handle_pointer_place(
            self.lowerer.output, task_place
        );
        mir.MirBlockId join = self.reserve_block(span);
        mir.MirBlockId complete = self.reserve_block(span);
        self.branch_on_non_null_pointer(task_pointer, join, complete, span);
        self.start_block(join);
        self.statements.add(mir.MirStatement (
            span: span,
            kind: mir.task_consume_statement_kind(mir.MirTaskConsumeStatement (
                task: task_place
            ))
        ));
        self.lower_await_task_ready(task_place, span);
        self.release_consumed_task(task_place, false, span);
        self.finish_block(self.goto_terminator(complete), span);
        self.start_block(complete);
    }

    () cleanup_local_range(
        self,
        list.ArrayList<mir.MirLocalId>& locals,
        Int start,
        token.Span span
    ) {
        Int index! = start;
        while (index < locals.len()) {
            mir.MirLocalId local_id = locals.get(index);
            if (self.local_is_scoped_task(local_id)) {
                self.request_scoped_task_cancellation_if_present(local_id, span);
            }
            index = index + 1;
        }
        index = locals.len() - 1;
        while (index >= start) {
            mir.MirLocalId local_id = locals.get(index);
            if (self.local_is_scoped_task(local_id)) {
                self.join_scoped_task_if_present(local_id, span);
            }
            index = index - 1;
        }
        index = locals.len() - 1;
        while (index >= start) {
            self.push_storage_dead(locals.get(index), span);
            index = index - 1;
        }
    }

    // StorageDead 是词法 scope 边界。drop elaboration 会在这些边界前
    // 插入真实 drop；return 点只保留函数级兜底。
    () end_scope(self, list.ArrayList<mir.MirLocalId>& scope_locals, token.Span span) {
        self.cleanup_local_range(scope_locals, 0, span);
        self.restore_active_locals(self.active_locals.len() - scope_locals.len());
    }

    () push_active_storage_dead_from(self, Int active_depth, token.Span span) {
        self.cleanup_local_range(self.active_locals$.ref(), active_depth, span);
    }

    () restore_active_locals(self, Int active_depth) {
        self.active_locals.truncate(active_depth);
    }

    // defer 是词法 scope cleanup。提前退出路径会从当前 defer 栈一路
    // 执行到目标 scope 的深度，然后再释放离开的 locals。
    () run_deferred_from(self, Int defer_depth, token.Span span) {
        Int index! = self.active_defers.len() - 1;
        while (index >= defer_depth) {
            self.lower_expr_statement(self.active_defers.get(index));
            index = index - 1;
        }
        self.restore_active_defers(defer_depth);
    }

    () restore_active_defers(self, Int defer_depth) {
        self.active_defers.truncate(defer_depth);
    }

    () finish_block(self, mir.MirTerminatorKind terminator, token.Span span) {
        if (self.terminated) { return; }
        self.blocks.set(self.current_block.to_index(), mir.MirBlock (
            id: self.current_block,
            span: span,
            statements: self.lowerer.output.statement_array(self.statements$.ref()),
            terminator: mir.MirTerminator (
                span: span,
                kind: terminator
            )
        ));
        self.terminated = true;
    }

    mir.MirTerminatorKind goto_terminator(self, mir.MirBlockId target) {
        return mir.goto_terminator_kind(mir.MirGotoTerminator (target: target));
    }

    mir.MirBlockId reserve_block(self, token.Span span) {
        mir.MirBlockId block_id = mir.MirBlockId.from_index(self.blocks.len());
        self.blocks.add(mir.MirBlock (
            id: block_id,
            span: span,
            statements: self.lowerer.output.empty_statements(),
            terminator: mir.MirTerminator (
                span: span,
                kind: mir.unreachable_terminator_kind(mir.MirUnreachableTerminator (generated_by_check: true))
            )
        ));
        return block_id;
    }

    () start_block(self, mir.MirBlockId block_id) {
        self.current_block = block_id;
        self.terminated = false;
        self.statements.clear();
    }

    mir.MirRvalue unit_rvalue(self, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue (
            value: mir.const_operand_value(mir.MirConst (
                type_id: self.lowerer.ctx.store.types.unit_type(),
                span: span,
                value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
            ))
        ));
    }

    mir.MirRvalue int_const_rvalue(self, Int value, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue (value: mir.const_operand_value(self.int_const(value, span))));
    }

    mir.MirOperand int_operand(self, Int value, token.Span span) {
        return mir.const_operand_value(self.int_const(value, span));
    }

    mir.MirRvalue uint8_rvalue(self, Int value, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue (
            value: mir.const_operand_value(mir.MirConst (
                type_id: self.lowerer.ctx.store.types.uint8_type(),
                span: span,
                value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(value), signed_value: false))
            ))
        ));
    }

    mir.MirRvalue bool_rvalue(self, Bool value, token.Span span) {
        return mir.use_rvalue(mir.MirUseRvalue (value: mir.const_operand_value(mir.MirConst (
            type_id: self.lowerer.ctx.store.types.bool_type(),
            span: span,
            value: mir.bool_const_kind(mir.MirBoolConst (value: value))
        ))));
    }

    mir.MirOperand bool_operand(self, Bool value, token.Span span) {
        return mir.const_operand_value(mir.MirConst (
            type_id: self.lowerer.ctx.store.types.bool_type(),
            span: span,
            value: mir.bool_const_kind(mir.MirBoolConst (value: value))
        ));
    }

    mir.MirConst int_const(self, Int value, token.Span span) {
        return mir.MirConst (
            type_id: self.lowerer.ctx.store.types.int_type(),
            span: span,
            value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(value), signed_value: true))
        );
    }

    mir.MirRvalue int_rvalue(self, hir.HirId node_id, Int value) {
        return mir.use_rvalue(mir.MirUseRvalue (
            value: mir.const_operand_value(mir.MirConst (
                type_id: self.lowerer.ctx.store.types.int_type(),
                span: self.lowerer.hir_span(node_id),
                value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(value), signed_value: true))
            ))
        ));
    }

    mir.MirLocalId add_temp(self, qid.TypeId type_id, token.Span span) {
        mir.MirLocalId local_id = mir.MirLocalId.from_index(self.locals.len());
        self.locals.add(mir.MirLocalDecl (
            id: local_id,
            kind: mir.MirLocalKind.compiler_temp,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false,
            coroutine_capture_task: self.active_coroutine_capture_task
        ));
        return local_id;
    }

    mir.MirLocalId add_optional_coroutine_capture_temp(
        self,
        qid.TypeId type_id,
        token.Span span,
        mir.MirLocalId? capture_task
    ) {
        guard capture_task is .some(task_local) else { return self.add_temp(type_id, span); }
        return self.add_coroutine_capture_temp(type_id, span, task_local, .auxiliary);
    }

    mir.MirLocalId add_coroutine_capture_temp(
        self,
        qid.TypeId type_id,
        token.Span span,
        mir.MirLocalId capture_task,
        mir.MirCoroutineCaptureKind capture_kind
    ) {
        mir.MirLocalId local_id = self.add_temp(type_id, span);
        mir.MirLocalDecl local! = self.locals.get(local_id.to_index());
        local.coroutine_capture_task = capture_task;
        local.coroutine_capture_kind = capture_kind;
        self.locals.set(local_id.to_index(), local$.move());
        return local_id;
    }

    qid.TypeId type_for_node(self, hir.HirId node_id) {
        if (self.lowerer.typeck.node_type(node_id) is .some(type_id)) {
            return self.lowerer.substitute_type(type_id, self.substitutions);
        }
        return self.lowerer.ctx.store.types.invalid_type();
    }

    Bool type_is_nul_terminated_string_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .raw_pointer) {
                return self.type_is_uint8(handle.element);
            }
        }
        return false;
    }

    Bool type_is_uint8(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(type_id);
        guard info.data is .int_type(int_type) else { return false; }
        return int_type.bits == 8 && !int_type.signed;
    }

    Float64 float64_from_bits(self, UInt64 bits) {
        // ComptimeValue/artifact 用 bits 保存浮点 payload，避免跨平台文本
        // 格式化差异；MIR 需要恢复成 Float64 后再交给 LLVM const real。
        unsafe {
            UInt64*! input = UInt64$.alloc(1);
            Float64*! output = Float64$.alloc(1);
            input[0] = bits;
            memory.copy_bytes(output[0]$.addr()$.as(UInt8*), input[0]$.addr()$.as(UInt8*), 8);
            Float64 result = output[0];
            input$.dealloc();
            output$.dealloc();
            return result;
        }
    }

    mir.MirLocalId return_local(self) {
        return mir.MirLocalId.from_index(0);
    }

    mir.MirLocalId mir_local_for_hir(self, hir.HirLocalId local_id) {
        return mir.MirLocalId.from_index(local_id.to_index() + 1 + self.hir_local_offset);
    }

    mir.MirPlace place_for_local(self, mir.MirLocalId local_id) {
        return mir.local_place(local_id, self.lowerer.output.empty_projection());
    }

    mir.MirLocalDecl[]& freeze_locals(self) {
        unsafe {
            Int count = self.locals.len();
            mir.MirLocalDecl*! values = self.lowerer.output.alloc_local_array(count);
            Int index! = 0;
            while (index < count) {
                values[index] = self.locals.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }
}
