// Facade for HIR to MIR lowering.

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    hir.HirStore& hir_store
) {
    mir.MirStore^ output = new mir.MirStore(hir_store.ok);
    if (hir_store.has_errors()) {
        return output;
    }

    MirLowerer! lowerer = MirLowerer(ctx, hir_store, output);
    lowerer.lower_package();
    return output;
}

struct MirLowerer {
    context.CompilerContext& ctx;
    hir.HirStore& hirs;
    mir.MirStore^ output;

    public init(context.CompilerContext& ctx, hir.HirStore& hirs, mir.MirStore^ output) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.output = output;
    }

    public () lower_package() {
        // MIR 调度以 HIR declaration order 为稳定顺序。
        // 函数调用只在 MIR 中记录 callee DefId，不要求 callee 先 lower。
        Int! index = 0;
        while (index < self.hirs.decl_len()) {
            hir.HirDecl decl = self.hirs.decl(self.hirs.decl_def_at(index))$.some();
            if (decl.kind == .function_decl) {
                if (decl.body is some body_id) {
                    self.lower_function(decl, body_id);
                }
            }
            index = index + 1;
        }
    }

    () lower_function(hir.HirDecl decl, hir.HirBodyId body_id) {
        // 当前只是 MIR 骨架：为每个 HIR function 建立 MirFunction/MirBody，
        // 具体 statement/rvalue/terminator lowering 后续再补。
        Int function_index = self.output.functions.len();
        mir.MirBody mir_body = self.empty_body(mir.MirBodyId.from_index(function_index), decl.span);
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: decl.def_id,
            signature_id: null,
            span: decl.span,
            body: mir_body
        });
    }

    mir.MirBody empty_body(mir.MirBodyId body_id, token.Span span) {
        mir.MirBlockId entry = mir.MirBlockId.from_index(0);
        mir.MirBlock block = mir.MirBlock {
            id: entry,
            span: span,
            statements: self.output.empty_statements(),
            terminator: mir.MirTerminator {
                span: span,
                kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
            }
        };
        return mir.MirBody {
            id: body_id,
            span: span,
            locals: self.output.empty_locals(),
            blocks: self.output.single_block(block),
            entry: entry,
            return_local: mir.MirLocalId.from_index(0)
        };
    }
}
