// Facade for HIR to MIR lowering.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import store = "../resolve/store.jiang";
import monomorph = "../sema/monomorph.jiang";
import sema_result = "../sema/result.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    hir_store.HirStore& hir_store,
    sema_result.TypeCheckResults& typeck,
    monomorph.InstancePlan& instances,
    module_graph.ModuleGraph& graph
) {
    mir.MirStore^ output = new mir.MirStore(hir_store.ok && typeck.ok);
    if (hir_store.has_errors() || typeck.has_errors()) {
        return output;
    }
    // collect 阶段只标记递归实例化，真正的 diagnostic 在 lowering 入口
    // 统一发出，避免 monomorph 依赖 CompilerContext/diagnostic 模块。
    if (instances.recursive_expansion) {
        add_recursive_instance_diagnostic(ctx);
        output.mark_error();
        return output;
    }

    MirLowerer! lowerer = MirLowerer(ctx, hir_store, typeck, instances, graph, output);
    lowerer.lower_package();
    return output;
}

() add_recursive_instance_diagnostic(context.CompilerContext& ctx) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .lowering,
            diagnostic.DiagnosticCode("recursive_generic_instantiation"),
            diagnostic.SourceRange(),
            "recursive generic instantiation"
        )
    );
}

struct MirLowerer {
    context.CompilerContext& ctx;
    hir_store.HirStore& hirs;
    sema_result.TypeCheckResults& typeck;
    monomorph.InstancePlan& instances;
    module_graph.ModuleGraph& graph;
    mir.MirStore^ output;

    public init(
        context.CompilerContext& ctx,
        hir_store.HirStore& hirs,
        sema_result.TypeCheckResults& typeck,
        monomorph.InstancePlan& instances,
        module_graph.ModuleGraph& graph,
        mir.MirStore^ output
    ) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.output = output;
    }

    public () lower_package() {
        // MIR 调度从 module graph + HIR ownership tree 派生：graph 给出本次
        // 编译的 root/import closure，module HirDef.members 给出当前
        // module 的顶层声明集合。泛型模板本身不生成 MIR；后面按
        // InstancePlan 为每个 concrete type args 生成独立函数体。
        Int! module_index = 0;
        while (module_index < self.graph.modules.len()) {
            store.ModuleRecord module = self.ctx.query.resolve.modules.get(self.graph.modules.get(module_index));
            self.lower_def_tree(module.def_id);
            module_index = module_index + 1;
        }
        self.lower_instances();
    }

    () lower_def_tree(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else {
            return;
        }
        if (hir_def.decl.kind == .function_decl || hir_def.decl.kind == .deinit_decl) {
            if (hir_def.body != null && self.generic_param_count(hir_def) == 0) {
                self.lower_function(hir_def);
            }
        }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.lower_def_tree(hir_def.members.get(index));
            index = index + 1;
        }
    }

    () lower_function(hir.HirDef hir_def) {
        self.lower_function_with_substitution(hir_def, monomorph.SubstitutionMap(), self.output.empty_type_args());
    }

    // 第二阶段 lower concrete generic instances。它们不会出现在 HIR ownership
    // tree 里，只存在于 InstancePlan 中。
    () lower_instances() {
        Int! index = 0;
        while (index < self.instances.len()) {
            self.lower_instance(self.instances.get(index));
            index = index + 1;
        }
    }

    () lower_instance(monomorph.InstanceKey instance) {
        if (monomorph.instance_kind(self.ctx.query$.ref(), instance) != .function_body) {
            return;
        }
        guard self.hirs.def(instance.def_id) is some hir_def else {
            return;
        }
        if (hir_def.body == null) {
            return;
        }
        // instance.type_args 先绑定到泛型参数 DefId，body lowering 后续所有
        // 类型读取都通过 substitutions 转成 concrete TypeId。
        monomorph.SubstitutionMap substitutions = monomorph.build_substitution(
            self.ctx.query$.ref(),
            hir_def,
            instance
        );
        self.lower_function_with_substitution(hir_def, substitutions, instance.type_args);
    }

    () lower_function_with_substitution(
        hir.HirDef hir_def,
        monomorph.SubstitutionMap substitutions,
        qid.TypeId[] type_args
    ) {
        Int function_index = self.output.functions.len();
        // HIR 不再直接携带 span；诊断位置后续通过 SourceMap 查询。
        token.Span span = self.def_span(hir_def.def_id);
        BodyLowerer! body_lowerer = BodyLowerer(
            self$.ref(),
            mir.MirBodyId.from_index(function_index),
            hir_def,
            substitutions,
            span
        );
        mir.MirBody mir_body = body_lowerer.lower();
        self.output.add_function(mir.MirFunction {
            id: mir.MirFunctionId.from_index(function_index),
            def_id: hir_def.def_id,
            type_args: self.output.type_arg_array(type_args),
            signature_id: null,
            span: span,
            body: mir_body
        });
    }

    Int generic_param_count(hir.HirDef hir_def) {
        Int! count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    () add_initial_locals(
        hir.HirDef hir_def,
        monomorph.SubstitutionMap substitutions,
        list.ArrayList<mir.MirLocalDecl>& locals
    ) {
        locals.add(mir.MirLocalDecl {
            id: mir.MirLocalId.from_index(0),
            kind: .return_place,
            type_id: self.return_type(hir_def, substitutions),
            span: self.def_span(hir_def.def_id),
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        });
        guard hir_def.body is some body else {
            return;
        }
        Int! index = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            locals.add(self.lower_local(local, substitutions, index + 1));
            index = index + 1;
        }
    }

    mir.MirLocalDecl lower_local(hir.HirLocal local, monomorph.SubstitutionMap substitutions, Int mir_index) {
        qid.TypeId type_id = self.type_for_local(local, substitutions);
        return mir.MirLocalDecl {
            id: mir.MirLocalId.from_index(mir_index),
            kind: self.local_kind(local.kind),
            type_id: type_id,
            span: self.def_span(local.def_id),
            name: local.symbol,
            def_id: local.def_id,
            mutable_local: self.ctx.query.types.get(type_id).is_mutable,
            address_taken: false
        };
    }

    qid.TypeId type_for_local(hir.HirLocal local, monomorph.SubstitutionMap substitutions) {
        if (self.typeck.def_type(local.def_id) is some type_id) {
            return self.substitute_type(type_id, substitutions);
        }
        return self.ctx.query.types.invalid_type();
    }

    mir.MirLocalKind local_kind(hir.HirLocalKind kind) {
        if (kind == .parameter) { return .param; }
        return .user_local;
    }

    qid.TypeId return_type(hir.HirDef hir_def, monomorph.SubstitutionMap substitutions) {
        if (self.typeck.def_type(hir_def.def_id) is some function_type_id) {
            qid.TypeId substituted = self.substitute_type(function_type_id, substitutions);
            if (self.ctx.query.types.get(substituted).data is .function_type(function_type)) {
                return function_type.result;
            }
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId substitute_type(qid.TypeId type_id, monomorph.SubstitutionMap substitutions) {
        if (substitutions.len() == 0) {
            return type_id;
        }
        // TypeCheckResults 保存的是泛型模板视角的 TypeId；具体实例的 MIR
        // local/const/temp 必须在这里替换成 concrete TypeId。
        return monomorph.substitute_type(self.ctx.query$.ref(), type_id, substitutions);
    }

    token.Span def_span(qid.DefId def_id) {
        if (self.ctx.query.source_map.def_span(def_id) is some loc) {
            return loc.span;
        }
        return token.Span();
    }

    token.Span hir_span(hir.HirId hir_id) {
        if (self.ctx.query.source_map.hir_span(hir_id) is some loc) {
            return loc.span;
        }
        return token.Span();
    }
}

struct LoopTargets {
    mir.MirBlockId continue_target;
    mir.MirBlockId break_target;
    Int active_depth;
}

// BodyLowerer 负责把单个 HIR function body 转成 MIR CFG。
// block id 先预留再回填，保证 branch/call 提前引用目标 block 时，
// `MirBlockId.index` 仍然等于 `MirBody.blocks[index]`。
struct BodyLowerer {
    MirLowerer& lowerer;
    mir.MirBodyId body_id;
    hir.HirDef hir_def;
    monomorph.SubstitutionMap substitutions;
    token.Span span;
    list.ArrayList<mir.MirLocalDecl>! locals;
    list.ArrayList<mir.MirBlock>! blocks;
    list.ArrayList<mir.MirStatement>! statements;
    list.ArrayList<LoopTargets>! loop_targets;
    list.ArrayList<mir.MirLocalId>! active_locals;
    mir.MirBlockId! current_block;
    Bool! terminated;

    public init(
        MirLowerer& lowerer,
        mir.MirBodyId body_id,
        hir.HirDef hir_def,
        monomorph.SubstitutionMap substitutions,
        token.Span span
    ) {
        self.lowerer = lowerer;
        self.body_id = body_id;
        self.hir_def = hir_def;
        self.substitutions = substitutions;
        self.span = span;
        self.locals = list.ArrayList<mir.MirLocalDecl>();
        self.blocks = list.ArrayList<mir.MirBlock>();
        self.statements = list.ArrayList<mir.MirStatement>();
        self.loop_targets = list.ArrayList<LoopTargets>();
        self.active_locals = list.ArrayList<mir.MirLocalId>();
        self.current_block = self.reserve_block(span);
        self.terminated = false;
        self.lowerer.add_initial_locals(hir_def, substitutions, self.locals$.ref());
    }

    mir.MirBody lower() {
        if (self.hir_def.body is some body) {
            self.lower_root(body.root);
        }
        if (!self.terminated) {
            self.finish_block(.return_term(mir.MirReturnTerminator {implicit_unit: true}), self.span);
        }
        return mir.MirBody {
            id: self.body_id,
            span: self.span,
            locals: self.freeze_locals(),
            blocks: self.lowerer.output.block_array(self.blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: self.return_local()
        };
    }

    () lower_root(hir.HirId root) {
        hir.HirNode node = self.lowerer.hirs.node(root);
        if (node.data is .block(block)) {
            self.lower_root_block(block);
            return;
        }
        self.lower_into_place(root, self.place_for_local(self.return_local()));
        if (!self.terminated) {
            self.finish_return(false, self.lowerer.hir_span(root));
        }
    }

    () lower_root_block(hir.HirBlock block) {
        list.ArrayList<mir.MirLocalId>! scope_locals = list.ArrayList<mir.MirLocalId>();
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.terminated) { return; }
            if (self.lower_statement_node(block.statements[index]) is some local_id) {
                scope_locals.add(local_id);
            }
            index = index + 1;
        }
        if (self.terminated) { return; }
        if (block.result is some result) {
            self.lower_into_place(result, self.place_for_local(self.return_local()));
            if (!self.terminated) {
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
                self.finish_return(false, self.lowerer.hir_span(result));
            }
            return;
        }
        self.end_scope(scope_locals$.ref(), self.span);
        self.finish_return(true, self.span);
    }

    mir.MirLocalId? lower_statement_node(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .let_stmt(let_stmt)) {
            return self.lower_let(node_id, let_stmt);
        }
        if (node.data is .return_stmt(return_stmt)) {
            self.lower_return(node_id, return_stmt);
            return null;
        }
        if (node.data is .break_stmt) {
            self.lower_break(node_id);
            return null;
        }
        if (node.data is .continue_stmt) {
            self.lower_continue(node_id);
            return null;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.lower_assign(node_id, assign_stmt);
            return null;
        }
        if (self.is_expr_statement(node)) {
            self.lower_expr_statement(node_id);
            return null;
        }
        self.mark_unsupported(node_id);
        return null;
    }

    Bool is_expr_statement(hir.HirNode node) {
        if (node.data is .block) { return true; }
        if (node.data is .name_ref) { return true; }
        if (node.data is .member_access) { return true; }
        if (node.data is .call) { return true; }
        if (node.data is .implicit_call) { return true; }
        if (node.data is .literal) { return true; }
        if (node.data is .unary) { return true; }
        if (node.data is .binary) { return true; }
        if (node.data is .if_expr) { return true; }
        if (node.data is .loop_expr) { return true; }
        if (node.data is .switch_expr) { return true; }
        return false;
    }

    () lower_expr_statement(hir.HirId node_id) {
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
    }

    mir.MirLocalId lower_let(hir.HirId node_id, hir.HirLet let_stmt) {
        mir.MirLocalId local_id = self.mir_local_for_hir(let_stmt.local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, self.lowerer.hir_span(node_id));
        if (let_stmt.initializer is some initializer) {
            self.lower_into_place(initializer, self.place_for_local(local_id));
        }
        return local_id;
    }

    () lower_return(hir.HirId node_id, hir.HirReturn return_stmt) {
        if (return_stmt.value is some value) {
            self.lower_into_place(value, self.place_for_local(self.return_local()));
            if (self.terminated) { return; }
            self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
            self.finish_return(false, self.lowerer.hir_span(node_id));
            return;
        }
        self.push_active_storage_dead_from(0, self.lowerer.hir_span(node_id));
        self.finish_return(true, self.lowerer.hir_span(node_id));
    }

    () lower_assign(hir.HirId node_id, hir.HirAssign assign_stmt) {
        guard self.place_for_expr(assign_stmt.target) is some destination else {
            self.mark_unsupported(assign_stmt.target);
            return;
        }
        if (assign_stmt.op == .assign) {
            self.lower_into_place(assign_stmt.value, destination);
            return;
        }
        guard self.binary_op_for_assign(assign_stmt.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirOperand lhs = self.lower_to_operand(assign_stmt.target);
        mir.MirOperand rhs = self.lower_to_operand(assign_stmt.value);
        self.push_assign(
            destination,
            .binary_value(mir.MirBinaryRvalue {op: op, lhs: lhs, rhs: rhs}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_into_place(hir.HirId node_id, mir.MirPlace destination) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .block(block)) {
            self.lower_block_into_place(block, destination);
            return;
        }
        if (node.data is .call(call)) {
            self.lower_call(node_id, call, destination);
            return;
        }
        if (node.data is .implicit_call(implicit_call)) {
            self.lower_implicit_call(node_id, implicit_call, destination);
            return;
        }
        if (node.data is .if_expr(if_expr)) {
            self.lower_if(node_id, if_expr, destination);
            return;
        }
        if (node.data is .loop_expr(loop_expr)) {
            self.lower_loop(node_id, loop_expr, destination);
            return;
        }
        if (node.data is .switch_expr(switch_expr)) {
            self.lower_switch(node_id, switch_expr, destination);
            return;
        }
        if (node.data is .unary(unary)) {
            self.lower_unary(node_id, unary, destination);
            return;
        }
        if (node.data is .binary(binary)) {
            self.lower_binary(node_id, binary, destination);
            return;
        }
        mir.MirOperand value = self.lower_operand(node_id);
        self.push_assign(destination, .use_value(mir.MirUseRvalue {value: value}), self.lowerer.hir_span(node_id));
    }

    () lower_block_into_place(hir.HirBlock block, mir.MirPlace destination) {
        list.ArrayList<mir.MirLocalId>! scope_locals = list.ArrayList<mir.MirLocalId>();
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.terminated) { return; }
            if (self.lower_statement_node(block.statements[index]) is some local_id) {
                scope_locals.add(local_id);
            }
            index = index + 1;
        }
        if (self.terminated) { return; }
        if (block.result is some result) {
            self.lower_into_place(result, destination);
            if (!self.terminated) {
                self.end_scope(scope_locals$.ref(), self.lowerer.hir_span(result));
            }
            return;
        }
        self.push_assign(destination, self.unit_rvalue(token.Span()), token.Span());
        self.end_scope(scope_locals$.ref(), token.Span());
    }

    () lower_if(hir.HirId node_id, hir.HirIf if_expr, mir.MirPlace destination) {
        mir.MirOperand condition = self.lower_to_operand(if_expr.condition);
        mir.MirBlockId then_block = self.reserve_block(self.lowerer.hir_span(if_expr.then_body));
        mir.MirBlockId else_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(.branch_term(mir.MirBranchTerminator {
            condition: condition,
            then_target: then_block,
            else_target: else_block
        }), self.lowerer.hir_span(if_expr.condition));

        Int active_depth = self.active_locals.len();
        self.start_block(then_block);
        self.lower_into_place(if_expr.then_body, destination);
        if (!self.terminated) {
            self.finish_block(.goto_term(mir.MirGotoTerminator {target: join_block}), self.lowerer.hir_span(node_id));
        }
        self.restore_active_locals(active_depth);

        self.start_block(else_block);
        if (if_expr.else_body is some else_body) {
            self.lower_into_place(else_body, destination);
        } else {
            self.push_assign(
                destination,
                self.unit_rvalue(self.lowerer.hir_span(node_id)),
                self.lowerer.hir_span(node_id)
            );
        }
        if (!self.terminated) {
            self.finish_block(.goto_term(mir.MirGotoTerminator {target: join_block}), self.lowerer.hir_span(node_id));
        }
        self.restore_active_locals(active_depth);

        self.start_block(join_block);
    }

    () lower_loop(hir.HirId node_id, hir.HirLoop loop_expr, mir.MirPlace destination) {
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirBlockId header_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(loop_expr.body));
        mir.MirBlockId exit_block = self.reserve_block(self.lowerer.hir_span(node_id));

        self.finish_block(.goto_term(mir.MirGotoTerminator {target: header_block}), self.lowerer.hir_span(node_id));
        self.start_block(header_block);
        if (loop_expr.condition is some condition) {
            mir.MirOperand condition_value = self.lower_to_operand(condition);
            self.finish_block(.branch_term(mir.MirBranchTerminator {
                condition: condition_value,
                then_target: body_block,
                else_target: exit_block
            }), self.lowerer.hir_span(condition));
        } else {
            self.finish_block(.goto_term(mir.MirGotoTerminator {target: body_block}), self.lowerer.hir_span(node_id));
        }

        Int active_depth = self.active_locals.len();
        self.loop_targets.add(LoopTargets {
            continue_target: header_block,
            break_target: exit_block,
            active_depth: active_depth
        });
        self.start_block(body_block);
        self.lower_expr_statement(loop_expr.body);
        if (!self.terminated) {
            self.finish_block(.goto_term(mir.MirGotoTerminator {target: header_block}), self.lowerer.hir_span(node_id));
        }
        LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);

        self.start_block(exit_block);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_switch(hir.HirId node_id, hir.HirSwitch switch_expr, mir.MirPlace destination) {
        mir.MirOperand discriminator = self.lower_to_operand(switch_expr.value);
        qid.TypeId discriminator_type = self.type_for_node(switch_expr.value);
        mir.MirBlockId join_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId default_block = self.reserve_block(self.lowerer.hir_span(node_id));
        mir.MirBlockId! default_target = default_block;
        list.ArrayList<mir.MirBlockId>! body_blocks = list.ArrayList<mir.MirBlockId>(switch_expr.cases.length);
        list.ArrayList<mir.MirSwitchCase>! cases = list.ArrayList<mir.MirSwitchCase>();

        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            mir.MirBlockId body_block = self.reserve_block(self.lowerer.hir_span(switch_expr.cases[case_index].body));
            body_blocks.add(body_block);
            default_target = self.add_switch_patterns(
                switch_expr.cases[case_index],
                body_block,
                default_target,
                discriminator_type,
                cases$.ref()
            );
            case_index = case_index + 1;
        }

        self.finish_block(.switch_term(mir.MirSwitchTerminator {
            discriminator: discriminator,
            cases: self.lowerer.output.switch_case_array(cases$.ref()),
            default_target: default_target
        }), self.lowerer.hir_span(node_id));

        Int active_depth = self.active_locals.len();
        self.lower_switch_case_bodies(switch_expr, body_blocks$.ref(), destination, join_block, active_depth);
        self.restore_active_locals(active_depth);
        if (default_target.to_index() == default_block.to_index()) {
            self.start_block(default_block);
            self.finish_block(
                .unreachable_term(mir.MirUnreachableTerminator {generated_by_check: true}),
                self.lowerer.hir_span(node_id)
            );
        }
        self.start_block(join_block);
    }

    mir.MirBlockId add_switch_patterns(
        hir.HirSwitchCase switch_case,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases
    ) {
        mir.MirBlockId! updated_default = default_target;
        Int! pattern_index = 0;
        while (pattern_index < switch_case.patterns.length) {
            hir.HirId pattern_id = switch_case.patterns[pattern_index];
            updated_default = self.add_switch_pattern(
                pattern_id,
                body_block,
                updated_default,
                discriminator_type,
                cases
            );
            pattern_index = pattern_index + 1;
        }
        return updated_default;
    }

    mir.MirBlockId add_switch_pattern(
        hir.HirId pattern_id,
        mir.MirBlockId body_block,
        mir.MirBlockId default_target,
        qid.TypeId discriminator_type,
        list.ArrayList<mir.MirSwitchCase>& cases
    ) {
        hir.HirNode pattern = self.lowerer.hirs.node(pattern_id);
        if (pattern.data is .wildcard_pattern) {
            return body_block;
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            cases.add(mir.MirSwitchCase {
                value: self.lower_literal_as_const(pattern_id, literal_pattern.literal, discriminator_type),
                target: body_block
            });
            return default_target;
        }
        self.mark_unsupported(pattern_id);
        return default_target;
    }

    () lower_switch_case_bodies(
        hir.HirSwitch switch_expr,
        list.ArrayList<mir.MirBlockId>& body_blocks,
        mir.MirPlace destination,
        mir.MirBlockId join_block,
        Int active_depth
    ) {
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            self.start_block(body_blocks.get(case_index));
            self.lower_into_place(switch_expr.cases[case_index].body, destination);
            if (!self.terminated) {
                self.finish_block(
                    .goto_term(mir.MirGotoTerminator {target: join_block}),
                    self.lowerer.hir_span(switch_expr.cases[case_index].body)
                );
            }
            self.restore_active_locals(active_depth);
            case_index = case_index + 1;
        }
    }

    () lower_break(hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        LoopTargets target = self.loop_targets.last();
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            .goto_term(mir.MirGotoTerminator {target: target.break_target}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_continue(hir.HirId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        LoopTargets target = self.loop_targets.last();
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.hir_span(node_id));
        self.finish_block(
            .goto_term(mir.MirGotoTerminator {target: target.continue_target}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_unary(hir.HirId node_id, hir.HirUnary unary, mir.MirPlace destination) {
        guard self.unary_op(unary.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .unary_value(mir.MirUnaryRvalue {op: op, value: self.lower_to_operand(unary.value)}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_binary(hir.HirId node_id, hir.HirBinary binary, mir.MirPlace destination) {
        guard self.binary_op(binary.op) is some op else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .binary_value(mir.MirBinaryRvalue {
                op: op,
                lhs: self.lower_to_operand(binary.left),
                rhs: self.lower_to_operand(binary.right)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    // type check 已经保证 get/set 的 base 是 pointer/reference。MIR 只把
    // 它们降成现有 place deref 读写，不再重新做语义判定。
    () lower_implicit_call(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.op == .alloc_array) {
            self.lower_alloc_array(node_id, call, destination);
            return;
        }
        if (call.op == .size) {
            self.lower_type_info_value(node_id, call, destination, 0);
            return;
        }
        if (call.op == .align) {
            self.lower_type_info_value(node_id, call, destination, 1);
            return;
        }
        if (call.op == .max_align) {
            self.lower_type_info_value(node_id, call, destination, 2);
            return;
        }
        if (call.op == .get) {
            self.lower_pointer_get(node_id, call, destination);
            return;
        }
        if (call.op == .set) {
            self.lower_pointer_set(node_id, call, destination);
            return;
        }
        if (call.op == .move) {
            self.lower_move(node_id, call, destination);
            return;
        }
        if (call.op == .ref) {
            self.lower_borrow_ref(node_id, call, destination, false);
            return;
        }
        if (call.op == .addr) {
            self.lower_borrow_ref(node_id, call, destination, true);
            return;
        }
        if (call.op == .cast) {
            self.lower_cast(node_id, call, destination);
            return;
        }
        if (call.op == .free) {
            self.lower_free(node_id, call, destination);
            return;
        }
        if (call.op == .optional_some) {
            self.lower_optional_some(node_id, call, destination);
            return;
        }
        self.mark_unsupported(node_id);
    }

    () lower_alloc_array(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .alloc_array_value(mir.MirAllocArrayRvalue {
                element_type: self.type_for_node(call.base),
                count: self.lower_to_operand(call.args[0])
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_type_info_value(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination, Int kind) {
        qid.TypeId type_id = self.type_for_node(call.base);
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.lowerer.ctx, type_id);
        layout.TypeLayout type_layout = self.lowerer.ctx.query.layouts.layout(layout_id);
        Int! value = 8;
        if (kind == 0) {
            value = type_layout.size;
        } else if (kind == 1) {
            value = type_layout.align;
        }
        self.push_assign(destination, self.int_rvalue(node_id, value), self.lowerer.hir_span(node_id));
    }

    () lower_pointer_get(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.pointer_deref_place(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .use_value(mir.MirUseRvalue {value: .copy_operand(mir.MirCopyOperand {place: source})}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_pointer_set(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.pointer_deref_place(call.base) is some target else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_into_place(call.args[0], target);
        self.push_assign(destination, self.unit_rvalue(self.lowerer.hir_span(node_id)), self.lowerer.hir_span(node_id));
    }

    () lower_move(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        guard self.place_for_expr(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .use_value(mir.MirUseRvalue {value: .move_operand(mir.MirMoveOperand {place: source})}),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_borrow_ref(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination, Bool raw_pointer) {
        guard self.place_for_expr(call.base) is some source else {
            self.mark_unsupported(node_id);
            return;
        }
        mir.MirRvalue! value = .borrow_value(mir.MirBorrowRvalue {place: source});
        if (raw_pointer) {
            value = .address_of_value(mir.MirAddressOfRvalue {
                mutable_pointer: true,
                place: source
            });
        }
        self.push_assign(destination, value, self.lowerer.hir_span(node_id));
    }

    () lower_cast(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.base);
        qid.TypeId target_type = self.type_for_node(call.args[0]);
        self.push_assign(
            destination,
            .cast_value(mir.MirCastRvalue {
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.base),
                target_type: target_type
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    () lower_free(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        if (call.args.length != 0) {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            .free_value(mir.MirFreeRvalue {pointer: self.free_pointer_operand(node_id, call)}),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirOperand free_pointer_operand(hir.HirId node_id, hir.HirImplicitCall call) {
        if (!call.optional_chain) {
            return self.lower_to_operand(call.base);
        }
        mir.MirLocalId temp = self.add_temp(self.optional_element_type(call.base), self.lowerer.hir_span(node_id));
        self.push_assign(
            self.place_for_local(temp),
            .optional_value(mir.MirOptionalRvalue {
                op: .unwrap_some,
                value: self.lower_to_operand(call.base)
            }),
            self.lowerer.hir_span(node_id)
        );
        return .copy_operand(mir.MirCopyOperand {place: self.place_for_local(temp)});
    }

    qid.TypeId optional_element_type(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.ctx.query.types.get(type_id);
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        return type_id;
    }

    () lower_optional_some(hir.HirId node_id, hir.HirImplicitCall call, mir.MirPlace destination) {
        self.push_assign(
            destination,
            .optional_value(mir.MirOptionalRvalue {
                op: .unwrap_some,
                value: self.lower_to_operand(call.base)
            }),
            self.lowerer.hir_span(node_id)
        );
    }

    mir.MirCastKind cast_kind(qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source = self.lowerer.ctx.query.types.get(source_type);
        types.TypeInfo target = self.lowerer.ctx.query.types.get(target_type);
        if (source.data is .handle_type) {
            if (target.data is .handle_type) { return .ptr_to_ptr; }
            if (target.data is .int_type) { return .ptr_to_int; }
        }
        if (source.data is .int_type) {
            if (target.data is .handle_type) { return .int_to_ptr; }
            if (target.data is .float_type) { return .int_to_float; }
            if (target.data is .int_type) { return .int_to_int; }
        }
        if (source.data is .float_type) {
            if (target.data is .int_type) { return .float_to_int; }
            if (target.data is .float_type) { return .float_to_float; }
        }
        return .bitcast;
    }

    // 如果 base 本身不是 place（例如返回 pointer 的 call），先落入临时
    // local，再在这个 local 上追加 deref projection。
    mir.MirPlace? pointer_deref_place(hir.HirId base_id) {
        mir.MirPlace! base_place = self.pointer_base_place(base_id);
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base_place.projection.length + 1);
        Int! index = 0;
        while (index < base_place.projection.length) {
            elems.add(base_place.projection[index]);
            index = index + 1;
        }
        elems.add(.deref_projection(mir.MirDerefProjection {raw_pointer: self.is_raw_pointer_type(base_id)}));
        return mir.MirPlace {
            local_id: base_place.local_id,
            projection: self.lowerer.output.projection_array(elems$.ref())
        };
    }

    mir.MirPlace pointer_base_place(hir.HirId base_id) {
        if (self.place_for_expr(base_id) is some place) {
            return place;
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(base_id), self.lowerer.hir_span(base_id));
        self.lower_into_place(base_id, self.place_for_local(temp));
        return self.place_for_local(temp);
    }

    Bool is_raw_pointer_type(hir.HirId node_id) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo type_info = self.lowerer.ctx.query.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    mir.MirOperand lower_to_operand(hir.HirId node_id) {
        if (self.move_operand_for_expr(node_id) is some operand) {
            return operand;
        }
        if (self.can_lower_as_direct_operand(node_id)) {
            return self.lower_operand(node_id);
        }
        mir.MirLocalId temp = self.add_temp(self.type_for_node(node_id), self.lowerer.hir_span(node_id));
        self.lower_into_place(node_id, self.place_for_local(temp));
        return .copy_operand(mir.MirCopyOperand {place: self.place_for_local(temp)});
    }

    mir.MirOperand? move_operand_for_expr(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        guard node.data is .implicit_call(call) else {
            return null;
        }
        if (call.op == .move) {
            guard self.place_for_expr(call.base) is some source else {
                self.mark_unsupported(node_id);
                return null;
            }
            return .move_operand(mir.MirMoveOperand {place: source});
        }
        return null;
    }

    Bool can_lower_as_direct_operand(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal) { return true; }
        if (node.data is .name_ref) { return true; }
        if (node.data is .member_access) {
            if (self.place_for_expr(node_id) is some _) {
                return true;
            }
            return false;
        }
        return false;
    }

    mir.MirOperand lower_operand(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return .const_operand(self.lower_const(node_id, literal));
        }
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                mir.MirPlace place = self.place_for_local(self.mir_local_for_hir(local_id));
                return .copy_operand(mir.MirCopyOperand {place: place});
            }
            if (name_ref is .def_ref(def_id)) {
                return self.lower_def_operand(node_id, def_id);
            }
        }
        if (node.data is .member_access(_)) {
            if (self.lowerer.typeck.member_selection(node_id) is some member_def) {
                if (self.def_can_be_function_operand(member_def)) {
                    return self.lower_def_operand(node_id, member_def);
                }
            }
        }
        if (self.place_for_expr(node_id) is some place) {
            return .copy_operand(mir.MirCopyOperand {place: place});
        }
        return self.unsupported_operand(node_id);
    }

    mir.MirOperand lower_def_operand(hir.HirId node_id, qid.DefId def_id) {
        if (!self.def_can_be_function_operand(def_id)) {
            return self.unsupported_operand(node_id);
        }
        qid.TypeId[] type_args = self.function_const_type_args(node_id, def_id);
        return .const_operand(mir.MirConst {
            type_id: self.type_for_node(node_id),
            span: self.lowerer.hir_span(node_id),
            value: .function_value(mir.MirFunctionConst {
                function_def: def_id,
                type_args: type_args
            })
        });
    }

    Bool def_can_be_function_operand(qid.DefId def_id) {
        def.DefKind kind = self.lowerer.ctx.query.defs.get(def_id).kind;
        if (kind == .function_def) {
            return true;
        }
        return kind == .deinit_def;
    }

    qid.TypeId[] function_const_type_args(hir.HirId node_id, qid.DefId def_id) {
        if (self.lowerer.typeck.generic_instance(node_id) is some instance) {
            if (instance.def_id == def_id) {
                return self.lowerer.output.type_arg_array(instance.type_args);
            }
        }
        return self.lowerer.output.empty_type_args();
    }

    mir.MirPlace? place_for_expr(hir.HirId node_id) {
        hir.HirNode node = self.lowerer.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                return self.place_for_local(self.mir_local_for_hir(local_id));
            }
            return null;
        }
        if (node.data is .member_access(member_access)) {
            return self.place_for_member(node_id, member_access);
        }
        return null;
    }

    mir.MirPlace? place_for_member(hir.HirId node_id, hir.HirMemberAccess member_access) {
        guard self.place_for_expr(member_access.base) is some base else {
            return null;
        }
        guard self.lowerer.typeck.member_selection(node_id) is some member_def else {
            return null;
        }
        if (self.lowerer.ctx.query.defs.get(member_def).kind != .field_def) {
            return null;
        }
        return self.project_field(base, member_def, self.type_for_node(node_id));
    }

    mir.MirPlace project_field(mir.MirPlace base, qid.DefId field_def, qid.TypeId field_type) {
        list.ArrayList<mir.MirPlaceElem>! elems = list.ArrayList<mir.MirPlaceElem>(base.projection.length + 1);
        Int! index = 0;
        while (index < base.projection.length) {
            elems.add(base.projection[index]);
            index = index + 1;
        }
        elems.add(.field_projection(mir.MirFieldProjection {field_def: field_def, field_type: field_type}));
        return mir.MirPlace {
            local_id: base.local_id,
            projection: self.lowerer.output.projection_array(elems$.ref())
        };
    }

    () finish_return(Bool implicit_unit, token.Span span) {
        self.finish_block(.return_term(mir.MirReturnTerminator {implicit_unit: implicit_unit}), span);
    }

    mir.MirConst lower_const(hir.HirId node_id, hir.HirLiteral literal) {
        token.Span span = self.lowerer.hir_span(node_id);
        // literal 的目标类型也可能是泛型参数，例如 T id<T>(T value)
        // 内部的返回值；type_for_node 会自动套用当前 instance substitution。
        qid.TypeId type_id = self.type_for_node(node_id);
        return self.lower_literal_as_const(node_id, literal, type_id);
    }

    mir.MirConst lower_literal_as_const(hir.HirId node_id, hir.HirLiteral literal, qid.TypeId type_id) {
        token.Span span = self.lowerer.hir_span(node_id);
        if (literal.value is .int_value(int_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .int_value(mir.MirIntConst {bits: int_value.bits, signed_value: int_value.signed_value})
            };
        }
        if (literal.value is .float_value(float_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .float_value(mir.MirFloatConst {value: float_value.value})
            };
        }
        if (literal.value is .bool_value(bool_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .bool_value(mir.MirBoolConst {value: bool_value})
            };
        }
        if (literal.value is .string_value(symbol_id)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .string_value(mir.MirStringConst {symbol_id: symbol_id})
            };
        }
        if (literal.value is .char_value(char_value)) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .int_value(mir.MirIntConst {bits: UInt64(char_value), signed_value: false})
            };
        }
        if (literal.value is .null_value) {
            return mir.MirConst {
                type_id: type_id,
                span: span,
                value: .null_value(mir.MirNullConst {typed_null: true})
            };
        }
        return mir.MirConst {
            type_id: type_id,
            span: span,
            value: .unit_value(mir.MirUnitConst {unit_value: true})
        };
    }

    () lower_call(hir.HirId node_id, hir.HirCall call, mir.MirPlace destination) {
        list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>(call.args.length);
        mir.MirOperand callee = self.lower_to_operand(call.callee);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        mir.MirBlockId next_block = self.reserve_block(self.lowerer.hir_span(node_id));
        self.finish_block(.call_term(mir.MirCallTerminator {
            callee: callee,
            args: self.lowerer.output.operand_array(args$.ref()),
            destination: destination,
            target: next_block,
            cleanup: null
        }), self.lowerer.hir_span(node_id));
        self.start_block(next_block);
    }

    mir.MirOperand unsupported_operand(hir.HirId node_id) {
        self.mark_unsupported(node_id);
        return .const_operand(mir.MirConst {
            type_id: self.lowerer.ctx.query.types.invalid_type(),
            span: self.lowerer.hir_span(node_id),
            value: .unit_value(mir.MirUnitConst {unit_value: true})
        });
    }

    () mark_unsupported(hir.HirId node_id) {
        self.lowerer.output.mark_error();
    }

    () push_assign(mir.MirPlace destination, mir.MirRvalue value, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement {
            span: span,
            kind: .assign_stmt(mir.MirAssignStatement {
                destination: destination,
                value: value
            })
        });
    }

    () push_storage_live(mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement {
            span: span,
            kind: .storage_live_stmt(mir.MirStorageLiveStatement {local_id: local_id})
        });
    }

    () push_storage_dead(mir.MirLocalId local_id, token.Span span) {
        if (self.terminated) { return; }
        self.statements.add(mir.MirStatement {
            span: span,
            kind: .storage_dead_stmt(mir.MirStorageDeadStatement {local_id: local_id})
        });
    }

    // StorageDead 是词法 scope 边界。drop elaboration 会在这些边界前
    // 插入真实 drop；return 点只保留函数级兜底。
    () end_scope(list.ArrayList<mir.MirLocalId>& scope_locals, token.Span span) {
        Int! index = scope_locals.len() - 1;
        while (index >= 0) {
            self.push_storage_dead(scope_locals.get(index), span);
            index = index - 1;
        }
        self.restore_active_locals(self.active_locals.len() - scope_locals.len());
    }

    () push_active_storage_dead_from(Int active_depth, token.Span span) {
        Int! index = self.active_locals.len() - 1;
        while (index >= active_depth) {
            self.push_storage_dead(self.active_locals.get(index), span);
            index = index - 1;
        }
    }

    () restore_active_locals(Int active_depth) {
        self.active_locals.truncate(active_depth);
    }

    () finish_block(mir.MirTerminatorKind terminator, token.Span span) {
        if (self.terminated) { return; }
        self.blocks.set(self.current_block.to_index(), mir.MirBlock {
            id: self.current_block,
            span: span,
            statements: self.lowerer.output.statement_array(self.statements$.ref()),
            terminator: mir.MirTerminator {
                span: span,
                kind: terminator
            }
        });
        self.terminated = true;
    }

    mir.MirBlockId reserve_block(token.Span span) {
        mir.MirBlockId block_id = mir.MirBlockId.from_index(self.blocks.len());
        self.blocks.add(mir.MirBlock {
            id: block_id,
            span: span,
            statements: self.lowerer.output.empty_statements(),
            terminator: mir.MirTerminator {
                span: span,
                kind: .unreachable_term(mir.MirUnreachableTerminator {generated_by_check: true})
            }
        });
        return block_id;
    }

    () start_block(mir.MirBlockId block_id) {
        self.current_block = block_id;
        self.terminated = false;
        self.statements.clear();
    }

    mir.MirRvalue unit_rvalue(token.Span span) {
        return .use_value(mir.MirUseRvalue {
            value: .const_operand(mir.MirConst {
                type_id: self.lowerer.ctx.query.types.unit_type(),
                span: span,
                value: .unit_value(mir.MirUnitConst {unit_value: true})
            })
        });
    }

    mir.MirRvalue int_rvalue(hir.HirId node_id, Int value) {
        return .use_value(mir.MirUseRvalue {
            value: .const_operand(mir.MirConst {
                type_id: self.lowerer.ctx.query.types.int_type(),
                span: self.lowerer.hir_span(node_id),
                value: .int_value(mir.MirIntConst {bits: UInt64(value), signed_value: true})
            })
        });
    }

    mir.MirUnaryOp? unary_op(hir.HirUnaryOp op) {
        if (op == .negate) { return .neg; }
        if (op == .not) { return .logic_not; }
        if (op == .bit_not) { return .bit_not; }
        return null;
    }

    mir.MirBinaryOp? binary_op_for_assign(hir.HirAssignOp op) {
        if (op == .add_assign) { return .add; }
        if (op == .sub_assign) { return .sub; }
        if (op == .mul_assign) { return .mul; }
        if (op == .div_assign) { return .div; }
        if (op == .mod_assign) { return .rem; }
        if (op == .bit_and_assign) { return .bit_and; }
        if (op == .bit_or_assign) { return .bit_or; }
        if (op == .bit_xor_assign) { return .bit_xor; }
        if (op == .shift_left_assign) { return .shl; }
        if (op == .shift_right_assign) { return .shr; }
        return null;
    }

    mir.MirBinaryOp? binary_op(hir.HirBinaryOp op) {
        if (op == .add) { return .add; }
        if (op == .sub) { return .sub; }
        if (op == .mul) { return .mul; }
        if (op == .div) { return .div; }
        if (op == .mod) { return .rem; }
        if (op == .bit_and) { return .bit_and; }
        if (op == .bit_or) { return .bit_or; }
        if (op == .bit_xor) { return .bit_xor; }
        if (op == .shift_left) { return .shl; }
        if (op == .shift_right) { return .shr; }
        if (op == .equal) { return .eq; }
        if (op == .not_equal) { return .ne; }
        if (op == .less) { return .lt; }
        if (op == .less_equal) { return .le; }
        if (op == .greater) { return .gt; }
        if (op == .greater_equal) { return .ge; }
        return null;
    }

    mir.MirLocalId add_temp(qid.TypeId type_id, token.Span span) {
        mir.MirLocalId local_id = mir.MirLocalId.from_index(self.locals.len());
        self.locals.add(mir.MirLocalDecl {
            id: local_id,
            kind: .compiler_temp,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        });
        return local_id;
    }

    qid.TypeId type_for_node(hir.HirId node_id) {
        if (self.lowerer.typeck.node_type(node_id) is some type_id) {
            return self.lowerer.substitute_type(type_id, self.substitutions);
        }
        return self.lowerer.ctx.query.types.invalid_type();
    }

    mir.MirLocalId return_local() {
        return mir.MirLocalId.from_index(0);
    }

    mir.MirLocalId mir_local_for_hir(hir.HirLocalId local_id) {
        return mir.MirLocalId.from_index(local_id.to_index() + 1);
    }

    mir.MirPlace place_for_local(mir.MirLocalId local_id) {
        return mir.MirPlace {
            local_id: local_id,
            projection: self.lowerer.output.empty_projection()
        };
    }

    mir.MirLocalDecl[] freeze_locals() {
        Int count = self.locals.len();
        mir.MirLocalDecl![*] values = self.lowerer.output.alloc_local_array(count);
        Int! index = 0;
        while (index < count) {
            values[index] = self.locals.get(index);
            index = index + 1;
        }
        return values[0..count];
    }
}
