// Facade for HIR to MIR lowering.

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import mir = "./mir.jiang";
import source = "../source/source.jiang";

public mir.MirFile^ lower_file(
    context.CompilerContext& ctx,
    source.SourceId root_source_id,
    Int root_revision,
    hir.HirStore& hir_store
) {
    return new mir.MirFile(root_source_id, root_revision, hir_store.ok);
}
