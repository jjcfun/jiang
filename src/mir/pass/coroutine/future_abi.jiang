// MIR helpers for compiler-internal Future storage ABI.

import mir = "../../mir.jiang";
import list = "../../../support/list.jiang";
import token = "../../../syntax/token.jiang";

public mir.MirStatement[]& initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    mir.MirPlace frame_place,
    mir.MirFunctionRef resume_function,
    mir.MirFunctionRef completion_function,
    token.Span span
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>(6);
    statements.add(state_initializer(output, layout, future_place, span));
    statements.add(frame_initializer(output, layout, future_place, frame_place, span));
    statements.add(resume_function_initializer(output, layout, future_place, resume_function, span));
    statements.add(continuation_result_initializer(output, layout, future_place, frame_place, span));
    statements.add(continuation_context_initializer(output, layout, future_place, frame_place, span));
    statements.add(continuation_function_initializer(output, layout, frame_place, completion_function, span));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement continuation_context_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_context_field_index),
        mir.address_of_rvalue(mir.MirAddressOfRvalue (
            mutable_pointer: true,
            place: future_field_place(output, future_place, layout.future_abi.state_field_index)
        )),
        span
    );
}

public mir.MirStatement continuation_function_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    mir.MirFunctionRef completion_function,
    token.Span span
) {
    return assign_statement(
        projected_field_place(output, frame_place, layout.continuation_function_field_index),
        mir.function_operand_value(completion_function),
        span
    );
}

public mir.MirStatement continuation_result_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_result_field_index),
        mir.address_of_rvalue(mir.MirAddressOfRvalue (
            mutable_pointer: true,
            place: future_field_place(output, future_place, layout.future_abi.result_field_index)
        )),
        span
    );
}

public mir.MirStatement state_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    token.Span span
) {
    return assign_statement(
        future_field_place(output, future_place, layout.future_abi.state_field_index),
        mir.const_operand_value(state_const(layout, span, layout.state_dispatch.entry_state_id)),
        span
    );
}

public mir.MirStatement frame_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_rvalue_statement(
        future_field_place(output, future_place, layout.future_abi.frame_field_index),
        mir.address_of_rvalue(mir.MirAddressOfRvalue (
            mutable_pointer: true,
            place: frame_place
        )),
        span
    );
}

public mir.MirStatement resume_function_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace future_place,
    mir.MirFunctionRef resume_function,
    token.Span span
) {
    return assign_statement(
        future_field_place(output, future_place, layout.future_abi.resume_function_field_index),
        mir.function_operand_value(resume_function),
        span
    );
}

public mir.MirPlace future_field_place(
    mir.MirStore& output,
    mir.MirPlace future_place,
    Int field_index
) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(future_place.projection.length + 1);
    Int! index = 0;
    while (index < future_place.projection.length) {
        projection.add(future_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: field_index)));
    if (future_place.base is .global(global_ref)) {
        return mir.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return mir.local_place(future_place.local_id, output.projection_array(projection$.ref()));
}

mir.MirPlace projected_field_place(
    mir.MirStore& output,
    mir.MirPlace base_place,
    Int field_index
) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(base_place.projection.length + 1);
    Int! index = 0;
    while (index < base_place.projection.length) {
        projection.add(base_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: field_index)));
    if (base_place.base is .global(global_ref)) {
        return mir.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return mir.local_place(base_place.local_id, output.projection_array(projection$.ref()));
}

mir.MirStatement assign_statement(mir.MirPlace destination, mir.MirOperand value, token.Span span) {
    return assign_rvalue_statement(destination, mir.use_rvalue(mir.MirUseRvalue (value: value)), span);
}

mir.MirStatement assign_rvalue_statement(mir.MirPlace destination, mir.MirRvalue value, token.Span span) {
    return mir.MirStatement (
        span: span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: destination,
            value: value
        ))
    );
}

mir.MirConst state_const(mir.MirCoroutineFrameLayout& layout, token.Span span, Int state_id) {
    return mir.MirConst (
        type_id: layout.fields[layout.state_field_index].type_id,
        span: span,
        value: mir.int_const_kind(mir.MirIntConst (
            bits: UInt64(state_id),
            signed_value: true
        ))
    );
}
