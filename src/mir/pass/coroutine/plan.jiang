// 每个协程实例的代码生成计划。
//
// 分析阶段只在这里记录可选执行入口，后续 frame layout、Task root 选择和
// resume 生成消费同一份计划，避免为同一个函数维护多张并行 shim 表。

import qid = "../../../store/id.jiang";
import table = "../../../support/table.jiang";
import mir = "../../mir.jiang";

public struct FunctionPlan {
    public qid.DefId? confined_resume;
    public qid.DefId? rtc_resume;
}

public struct Store: Movable {
    table.HashTable<mir.MirFunctionKey, FunctionPlan> functions;

    public init(self) {
        self.functions = table.HashTable<mir.MirFunctionKey, FunctionPlan>();
    }

    public FunctionPlan get(self, mir.MirFunctionKey key) {
        if (table.hash_table_get_value<mir.MirFunctionKey, FunctionPlan>(
                self.functions$.ref(), key
            ) is .some(value)
        ) {
            return value;
        }
        return FunctionPlan (
            confined_resume: null,
            rtc_resume: null
        );
    }

    public () set_confined_resume(
        self,
        mir.MirFunctionKey key,
        qid.DefId resume
    ) {
        FunctionPlan value! = self.get(key);
        value.confined_resume = resume;
        self.functions.set(key, value);
    }

    public () set_rtc_resume(
        self,
        mir.MirFunctionKey key,
        qid.DefId resume
    ) {
        FunctionPlan value! = self.get(key);
        value.rtc_resume = resume;
        self.functions.set(key, value);
    }

}
