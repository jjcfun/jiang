    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    Int enabled,
    token.Span span
) {
    return assign_statement(
        projected_field_place(output, frame_place, layout.cancellation_enabled_field_index),
        mir.const_operand_value(state_const(layout, span, enabled)),
        span
