}

mir.MirStatement cancellation_context_null_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    qid.TypeId type_id = layout.fields[layout.cancellation_context_field_index].type_id;
    return assign_statement(
        projected_field_place(output, frame_place, layout.cancellation_context_field_index),
        mir.const_operand_value(mir.MirConst (
            type_id: type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        )),
        span
    );
}

mir.MirStatement cancellation_context_initializer(
    mir.MirStore& output,
