public mir.MirPlace task_field_place(
    mir.MirStore& output,
    mir.MirPlace task_place,
    mir.MirSyntheticField field
) {
    list.ArrayList<mir.MirPlaceElem> projection! =
        list.ArrayList<mir.MirPlaceElem>(task_place.projection.length + 2);
    Int index! = 0;
    while (index < task_place.projection.length) {
        projection.add(task_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: 0)));
    projection.add(mir.field_projection_elem(mir.MirFieldProjection (
        field_def: field.def_id,
        field_type: field.type_id,
        field_index: field.index
    )));
    if (task_place.base is .global(global_ref)) {
        return mir.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return mir.local_place(task_place.local_id, output.projection_array(projection$.ref()));
}

public mir.MirPlace task_state_storage_place(
    mir.MirStore& output,
    mir.MirPlace task_place
) {
    return projected_field_place(output, task_place, 0);
}

public mir.MirPlace task_state_field_place(
    mir.MirStore& output,
    mir.MirPlace task_state_place,
    mir.MirSyntheticField field
) {
    list.ArrayList<mir.MirPlaceElem> projection! =
        list.ArrayList<mir.MirPlaceElem>(task_state_place.projection.length + 1);
    Int index! = 0;
    while (index < task_state_place.projection.length) {
        projection.add(task_state_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.field_projection_elem(mir.MirFieldProjection (
        field_def: field.def_id,
        field_type: field.type_id,
        field_index: field.index
    )));
    if (task_state_place.base is .global(global_ref)) {
        return mir.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return mir.local_place(task_state_place.local_id, output.projection_array(projection$.ref()));
}

public mir.MirPlace projected_field_place(
    mir.MirStore& output,
    mir.MirPlace base_place,
    Int field_index
) {
    list.ArrayList<mir.MirPlaceElem> projection! = list.ArrayList<mir.MirPlaceElem>(base_place.projection.length + 1);
    Int index! = 0;
    while (index < base_place.projection.length) {
        projection.add(base_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.constant_index_projection_elem(mir.MirConstantIndexProjection (offset: field_index)));
    if (base_place.base is .global(global_ref)) {
        return mir.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return mir.local_place(base_place.local_id, output.projection_array(projection$.ref()));
}

@life(destination > return, value > return)
mir.MirStatement assign_statement(mir.MirPlace destination, mir.MirOperand value, token.Span span) {
    return assign_rvalue_statement(destination, mir.use_rvalue(mir.MirUseRvalue (value: value)), span);
}

@life(destination > return, value > return)
mir.MirStatement assign_rvalue_statement(mir.MirPlace destination, mir.MirRvalue value, token.Span span) {
    return mir.MirStatement (
        span: span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: destination,
            value: value
        ))
    );
}

mir.MirConst state_const(mir.MirCoroutineFrameLayout& layout, token.Span span, Int state_id) {
    return mir.MirConst (
        type_id: layout.fields[layout.state_field_index].type_id,
        span: span,
        value: mir.int_const_kind(mir.MirIntConst (
            bits: UInt64(state_id),
            signed_value: true
        ))
    );
}
