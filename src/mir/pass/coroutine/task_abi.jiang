    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirFunctionRef drop_function,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, layout.task_abi.result_drop_field),
        mir.function_operand_value(drop_function),
        span
    );
}

public mir.MirStatement task_state_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    token.Span span
) {
    return assign_rvalue_statement(
        projected_field_place(output, task_place, layout.task_abi.handle_pointer_field_index),
        mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: layout.task_abi.task_state_type_id)),
        span
    );
}

mir.MirStatement waiter_domain_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(state_const(layout, span, -1)),
        span
    );
}

mir.MirStatement task_int_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    Int value,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(state_const(layout, span, value)),
        span
    );
}

mir.MirStatement task_null_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(mir.MirConst (
            type_id: field.type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        )),
        span
    );
}

public mir.MirStatement frame_state_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_statement(
        projected_field_place(output, frame_place, layout.state_field_index),
        mir.const_operand_value(state_const(layout, span, layout.state_dispatch.entry_state_id)),
        span
    );
}

public mir.MirStatement resume_token_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_statement(
        projected_field_place(output, frame_place, layout.resume_token_field_index),
        mir.const_operand_value(mir.MirConst (
            type_id: layout.fields[layout.resume_token_field_index].type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        )),
        span
    );
}

() append_frame_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    Int! domain_id = -1;
    Int! domain_kind = -1;
    if (layout.effects.domain_const is .some(domain_def)) {
        domain_id = domain_def.to_index();
        domain_kind = layout.domain_kind;
    }
    statements.add(assign_statement(
        projected_field_place(output, frame_place, layout.current_domain_id_field_index),
        mir.const_operand_value(state_const(layout, span, domain_id)),
        span
    ));
    statements.add(assign_statement(
        projected_field_place(output, frame_place, layout.current_domain_kind_field_index),
        mir.const_operand_value(state_const(layout, span, domain_kind)),
        span
    ));
}

public mir.MirStatement[]& frame_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>(4);
    append_frame_domain_initializers(output, layout, frame_place, span, statements$.ref());
    statements.add(cancellation_enabled_initializer(output, layout, frame_place, 0, span));
    statements.add(cancellation_context_null_initializer(output, layout, frame_place, span));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& direct_continuation_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    mir.MirPlace result_place,
    mir.MirPlace parent_marker,
    mir.MirFunctionRef parent_resume,
    token.Span span
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>(4);
    statements.add(resume_token_initializer(output, layout, frame_place, span));
    statements.add(frame_state_initializer(output, layout, frame_place, span));
    append_frame_domain_initializers(output, layout, frame_place, span, statements$.ref());
    statements.add(cancellation_enabled_initializer(output, layout, frame_place, 2, span));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.cancellation_context_field_index),
        mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
            observed: false,
            cancellation_context: true
        )),
        span
    ));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_result_field_index),
        mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: result_place,
            frame_root: false
        )),
        span
    ));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_context_field_index),
        mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: parent_marker,
            frame_root: true
        )),
        span
    ));
    statements.add(continuation_function_initializer(output, layout, frame_place, parent_resume, span));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement continuation_context_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_context_field_index),
        mir.use_rvalue(mir.MirUseRvalue (
            value: mir.copy_operand_value(mir.MirCopyOperand (
                place: projected_field_place(output, task_place, layout.task_abi.handle_pointer_field_index)
            ))
        )),
        span
    );
}

