// MIR helpers for compiler-internal Task storage ABI.

import mir = "../../mir.jiang";
import qid = "../../../store/id.jiang";
import list = "../../../support/list.jiang";
import token = "../../../syntax/token.jiang";

public mir.MirStatement[]& initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    mir.MirFunctionRef resume_function,
    mir.MirFunctionRef completion_function,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(17);
    append_initialized_task_statements(
        output, layout, task_place, frame_place, resume_function, completion_function, span, statements$.ref()
    );
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.lifetime_state_field, 0, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.cleanup_function_field, span
    ));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& initialized_task_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    mir.MirFunctionRef resume_function,
    mir.MirFunctionRef completion_function,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(17);
    append_initialized_task_statements(
        output, layout, task_place, frame_place, resume_function, completion_function, span, statements$.ref()
    );
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& external_task_state_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(18);
    append_task_schedule_initializers(output, layout, task_place, span, statements$.ref());
    statements.add(state_initializer(output, layout, task_place, span));
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.cancellation_requested_field, 0, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.execution_executor_field, span
    ));
    append_inactive_cancel_target_initializers(output, layout, task_place, span, statements$.ref());
    return output.statement_array(statements$.ref());
}

() append_initialized_task_statements(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    mir.MirFunctionRef resume_function,
    mir.MirFunctionRef completion_function,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    append_task_schedule_initializers(output, layout, task_place, span, statements);
    statements.add(state_initializer(output, layout, task_place, span));
    statements.add(frame_state_initializer(output, layout, frame_place, span));
    append_frame_domain_initializers(output, layout, frame_place, span, statements);
    append_task_execution_domain_initializers(output, layout, task_place, frame_place, span, statements);
    statements.add(cancellation_enabled_initializer(output, layout, frame_place, 1, span));
    statements.add(cancellation_context_initializer(output, layout, task_place, frame_place, span));
    statements.add(frame_initializer(output, layout, task_place, frame_place, span));
    statements.add(resume_function_initializer(output, layout, task_place, resume_function, span));
    statements.add(continuation_result_initializer(output, layout, task_place, frame_place, span));
    statements.add(continuation_context_initializer(output, layout, task_place, frame_place, span));
    statements.add(continuation_function_initializer(output, layout, frame_place, completion_function, span));
    statements.add(continuation_executor_null_initializer(output, layout, frame_place, span));
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.cancellation_requested_field, 0, span
    ));
    append_inactive_cancel_target_initializers(output, layout, task_place, span, statements);
}

() append_task_schedule_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.schedule_state_field, 0, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.schedule_executor_field, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.schedule_context_field, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.schedule_resume_field, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.schedule_active_executor_field, span
    ));
}

public mir.MirStatement[]& execution_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(1);
    append_task_execution_domain_initializers(
        output, layout, task_place, frame_place, span, statements$.ref()
    );
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& lifetime_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirFunctionRef cleanup_function,
    Bool heap_owned,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(2);
    Int lifetime_state! = 0;
    if (heap_owned) { lifetime_state = 1; }
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.lifetime_state_field, lifetime_state, span
    ));
    statements.add(assign_statement(
        task_field_place(output, task_place, layout.task_abi.cleanup_function_field),
        mir.function_operand_value(cleanup_function),
        span
    ));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& inactive_lifetime_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(2);
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.lifetime_state_field, 0, span
    ));
    statements.add(task_null_initializer(
        output, layout, task_place, layout.task_abi.cleanup_function_field, span
    ));
    return output.statement_array(statements$.ref());
}

() append_task_execution_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    statements.add(assign_statement(
        task_field_place(output, task_place, layout.task_abi.execution_executor_field),
        mir.copy_operand_value(mir.MirCopyOperand (
            place: projected_field_place(output, frame_place, layout.current_executor_field_index)
        )),
        span
    ));
}

() append_inactive_cancel_target_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    statements.add(task_int_initializer(
        output, layout, task_place, layout.task_abi.cancel_target_word_field, 0, span
    ));
}

mir.MirStatement waiter_domain_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(state_const(layout, span, -1)),
        span
    );
}

mir.MirStatement task_int_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    Int value,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(state_const(layout, span, value)),
        span
    );
}

mir.MirStatement task_null_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirSyntheticField field,
    token.Span span
) {
    return assign_statement(
        task_field_place(output, task_place, field),
        mir.const_operand_value(mir.MirConst (
            type_id: field.type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        )),
        span
    );
}

public mir.MirStatement frame_state_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_statement(
        projected_field_place(output, frame_place, layout.state_field_index),
        mir.const_operand_value(state_const(layout, span, layout.state_dispatch.entry_state_id)),
        span
    );
}

() append_frame_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (layout.effects.domain is .some(domain)) {
        statements.add(assign_rvalue_statement(
            projected_field_place(output, frame_place, layout.current_executor_field_index),
            mir.domain_executor_rvalue(mir.MirDomainExecutorRvalue (
                domain_def: domain.binding,
                domain_kind: layout.domain_kind
            )),
            span
        ));
        return;
    }
    statements.add(assign_statement(
        projected_field_place(output, frame_place, layout.current_executor_field_index),
        mir.const_operand_value(mir.MirConst (
            type_id: layout.fields[layout.current_executor_field_index].type_id,
            span: span,
            value: mir.null_const_kind(mir.MirNullConst (typed_null: true))
        )),
        span
    ));
}

public mir.MirStatement[]& frame_domain_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(3);
    append_frame_domain_initializers(output, layout, frame_place, span, statements$.ref());
    statements.add(cancellation_enabled_initializer(output, layout, frame_place, 0, span));
    statements.add(cancellation_context_null_initializer(output, layout, frame_place, span));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement[]& direct_continuation_initializers(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace frame_place,
    mir.MirPlace result_place,
    mir.MirPlace parent_marker,
    mir.MirFunctionRef parent_resume,
    token.Span span
) {
    list.ArrayList<mir.MirStatement> statements! = list.ArrayList<mir.MirStatement>(4);
    statements.add(frame_state_initializer(output, layout, frame_place, span));
    append_frame_domain_initializers(output, layout, frame_place, span, statements$.ref());
    statements.add(cancellation_enabled_initializer(output, layout, frame_place, 2, span));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.cancellation_context_field_index),
        mir.current_task_rvalue(mir.MirCurrentTaskRvalue (
            observed: false,
            cancellation_context: true
        )),
        span
    ));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_result_field_index),
        mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: result_place,
            frame_root: false
        )),
        span
    ));
    statements.add(assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_context_field_index),
        mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: parent_marker,
            frame_root: true
        )),
        span
    ));
    statements.add(continuation_function_initializer(output, layout, frame_place, parent_resume, span));
    statements.add(continuation_executor_initializer(output, layout, frame_place, span));
    return output.statement_array(statements$.ref());
}

public mir.MirStatement continuation_context_initializer(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& layout,
    mir.MirPlace task_place,
    mir.MirPlace frame_place,
    token.Span span
) {
    return assign_rvalue_statement(
        projected_field_place(output, frame_place, layout.continuation_context_field_index),
        mir.coroutine_address_rvalue(mir.MirCoroutineAddressRvalue (
            place: task_state_storage_place(output, task_place),
            frame_root: false
        )),
        span
    );
}

