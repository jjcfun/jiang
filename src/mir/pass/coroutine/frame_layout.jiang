// Coroutine frame layout construction for stackless coroutine lowering.

import qid = "../../../store/id.jiang";
import types = "../../../sema/type.jiang";
import list = "../../../support/list.jiang";
import token = "../../../syntax/token.jiang";
import mir = "../../mir.jiang";
import live_across_suspend = "./live_across_suspend.jiang";
import state_dispatch = "./state_dispatch.jiang";
import suspend_points = "./suspend_points.jiang";

public mir.MirCoroutineFrameLayout? build_frame_layout(
    mir.MirStore& output,
    types.TypeStore& type_store,
    mir.MirBody body,
    types.EffectSet effects,
    qid.TypeId state_type,
    mir.MirTaskStateLayout& task_state,
    mir.MirBlockId cancellation_entry
) {
    unsafe {
        if (!effects.has_async) { return null; }
        live_across_suspend.FrameLiveness liveness =
            live_across_suspend.analyze_frame_liveness(body);
        Bool*! live_locals = liveness.live_locals;
        list.ArrayList<mir.MirCoroutineFrameField> fields! = list.ArrayList<mir.MirCoroutineFrameField>();
        list.ArrayList<mir.MirCoroutineLocalFrameField> mappings! =
            list.ArrayList<mir.MirCoroutineLocalFrameField>();
        qid.TypeId raw_pointer_type = type_store.raw_pointer_type(type_store.uint8_type(), body.span);
        fields.add(frame_field(.resume_token, raw_pointer_type, null, false));
        fields.add(frame_field(.state, state_type, null, false));
        fields.add(frame_field(
            .return_slot,
            body.locals[body.return_local.to_index()].type_id,
            body.return_local,
            false
        ));
        mappings.add(local_mapping(body.return_local, 2));
        qid.TypeId result_type = body.locals[body.return_local.to_index()].type_id;
        qid.TypeId task_type = type_store.task_type(result_type, effects.domain, body.span);
        qid.TypeId context_type = type_store.raw_pointer_type(task_state.type_id, body.span);
        qid.TypeId result_pointer_type = type_store.raw_pointer_type(result_type, body.span);
        qid.TypeId continuation_type = build_continuation_function_type(type_store, context_type, body.span);
        qid.TypeId executor_type = type_store.opaque_pointer_type(body.span);
        fields.add(frame_field(.continuation_result, result_pointer_type, null, false));
        fields.add(frame_field(.continuation_context, context_type, null, false));
        fields.add(frame_field(.continuation_function, continuation_type, null, false));
        fields.add(frame_field(.continuation_executor, executor_type, null, false));
        fields.add(frame_field(.current_executor, executor_type, null, false));
        fields.add(frame_field(.temp, state_type, null, false));
        fields.add(frame_field(.temp, context_type, null, false));
        fields.add(frame_field(.external_continuation, executor_type, null, false));
        Int index! = 0;
        while (index < body.locals.length) {
            mir.MirLocalDecl local = body.locals[index];
            if (local_should_get_frame_field(local, live_locals)) {
                Int field_index! = reusable_frame_field_index(
                    body,
                    local,
                    liveness$.ref(),
                    fields$.ref(),
                    mappings$.ref()
                );
                if (field_index < 0) {
                    field_index = fields.len();
                    fields.add(frame_field(
                        frame_field_kind_for_local(local.kind),
                        local.type_id,
                        local.id,
                        live_locals[local.id.to_index()]
                    ));
                }
                mappings.add(local_mapping(local.id, field_index));
            }
            index = index + 1;
        }
        mir.MirCoroutineSuspendPoint[]& points = suspend_points.collect(output, body);
        qid.TypeId frame_type_id = build_frame_type(type_store, fields$.ref(), body.span);
        return mir.MirCoroutineFrameLayout (
            frame_type_id: frame_type_id,
            task_abi: build_task_abi(
                type_store, frame_type_id, result_type, state_type, effects.domain, task_state, body.span
            ),
            fields: output.coroutine_frame_field_array(fields$.ref()),
            local_mappings: output.coroutine_local_frame_field_array(mappings$.ref()),
            suspend_points: points,
            state_dispatch: state_dispatch.build(output, points),
            cancellation_entry: cancellation_entry,
            resume_token_field_index: 0,
            state_field_index: 1,
            return_field_index: 2,
            continuation_result_field_index: 3,
            continuation_context_field_index: 4,
            continuation_function_field_index: 5,
            continuation_executor_field_index: 6,
            current_executor_field_index: 7,
            cancellation_enabled_field_index: 8,
            cancellation_context_field_index: 9,
            external_continuation_field_index: 10,
            domain_kind: -1,
            effects: effects
        );
    }
}

qid.TypeId build_continuation_function_type(
    types.TypeStore& type_store,
    qid.TypeId context_type,
    token.Span span
) {
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
    params.add(context_type);
    return type_store.function_type(params$.move(), type_store.unit_type(), span);
}

qid.TypeId build_frame_type(
    types.TypeStore& type_store,
    list.ArrayList<mir.MirCoroutineFrameField>& fields,
    token.Span span
) {
    list.ArrayList<qid.TypeId> field_types! = list.ArrayList<qid.TypeId>(fields.len());
    Int index! = 0;
    while (index < fields.len()) {
        field_types.add(fields.get(index).type_id);
        index = index + 1;
    }
    return type_store.tuple_type(field_types$.move(), span);
}

mir.MirTaskAbiLayout build_task_abi(
    types.TypeStore& type_store,
    qid.TypeId frame_type_id,
    qid.TypeId result_type_id,
    qid.TypeId state_type,
    types.DomainEffect? domain,
    mir.MirTaskStateLayout& task_state,
    token.Span span
) {
    qid.TypeId frame_pointer_type_id = type_store.raw_pointer_type(frame_type_id, span);
    qid.TypeId task_type_id = type_store.task_type(result_type_id, domain, span);
    qid.TypeId resume_function_type_id = build_resume_function_type(type_store, span);
    return mir.MirTaskAbiLayout (
        task_type_id: task_type_id,
        task_state_type_id: task_state.type_id,
        task_state_pointer_type_id: type_store.raw_pointer_type(task_state.type_id, span),
        result_type_id: result_type_id,
        frame_pointer_type_id: frame_pointer_type_id,
        resume_return_type_id: type_store.unit_type(),
        resume_function_type_id: resume_function_type_id,
        waiter_resume_function_type_id: build_resume_function_type(type_store, span),
        bool_type_id: type_store.bool_type(),
        handle_pointer_field_index: 0,
        state_field: task_state.state,
        frame_field: task_state.frame,
        resume_function_field: task_state.resume_function,
        execution_executor_field: task_state.execution_executor,
        result_field: task_state.result,
        result_drop_field: task_state.result_drop,
        result_initialized_field: task_state.result_initialized,
        waiter_registered_field: task_state.waiter_registered,
        waiter_context_field: task_state.waiter_context,
        waiter_resume_field: task_state.waiter_resume,
        waiter_executor_field: task_state.waiter_executor,
        cancellation_requested_field: task_state.cancellation_requested,
        cancel_target_word_field: task_state.cancel_target_word,
        cancel_target_context_field: task_state.cancel_target_context,
        cancel_target_function_field: task_state.cancel_target_function,
        cancel_target_frame_field: task_state.cancel_target_frame,
        cancel_target_resume_field: task_state.cancel_target_resume,
        cancel_target_executor_field: task_state.cancel_target_executor,
        external_continuation_field: task_state.external_continuation,
        allocation_pointer_field: task_state.allocation_pointer,
        ownership_state_field: task_state.ownership_state
    );
}

qid.TypeId build_resume_function_type(
    types.TypeStore& type_store,
    token.Span span
) {
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
    params.add(type_store.opaque_pointer_type(span));
    return type_store.function_type(params$.move(), type_store.unit_type(), span);
}

mir.MirCoroutineLocalFrameField local_mapping(mir.MirLocalId local_id, Int field_index) {
    return mir.MirCoroutineLocalFrameField (
        local_id: local_id,
        field_index: field_index
    );
}

mir.MirCoroutineFrameField frame_field(
    mir.MirCoroutineFrameFieldKind kind,
    qid.TypeId type_id,
    mir.MirLocalId? local_id,
    Bool live_across_suspend
) {
    return mir.MirCoroutineFrameField (
        kind: kind,
        type_id: type_id,
        local_id: local_id,
        live_across_suspend: live_across_suspend,
        needs_drop: false
    );
}

Bool local_should_get_frame_field(
    mir.MirLocalDecl local,
    Bool*! live_locals
) {
    unsafe {
        if (local.kind == .return_place) { return false; }
        if (local.kind == .param) { return true; }
        return live_locals[local.id.to_index()];
    }
}

Int reusable_frame_field_index(
    mir.MirBody body,
    mir.MirLocalDecl local,
    live_across_suspend.FrameLiveness& liveness,
    list.ArrayList<mir.MirCoroutineFrameField>& fields,
    list.ArrayList<mir.MirCoroutineLocalFrameField>& mappings
) {
    unsafe {
        // 参数必须在首次 resume 前就由 caller 写入 frame；被取地址的 local 则可能被
        // MIR liveness 看不到的引用间接访问。这两类 storage 暂不参与 slot 复用。
        if (local.kind == .param || liveness.address_preserved[local.id.to_index()]) {
            return -1;
        }
        Int mapping_index! = 0;
        while (mapping_index < mappings.len()) {
            Int field_index = mappings.get(mapping_index).field_index;
            if (frame_field_can_store_local(body, local, field_index, liveness, fields, mappings)) {
                return field_index;
            }
            mapping_index = mapping_index + 1;
        }
        return -1;
    }
}

Bool frame_field_can_store_local(
    mir.MirBody body,
    mir.MirLocalDecl local,
    Int field_index,
    live_across_suspend.FrameLiveness& liveness,
    list.ArrayList<mir.MirCoroutineFrameField>& fields,
    list.ArrayList<mir.MirCoroutineLocalFrameField>& mappings
) {
    mir.MirCoroutineFrameField field = fields.get(field_index);
    if (!reusable_local_field_kind(field.kind)) { return false; }

    // 只复用完全相同的 TypeId。这样 field projection 的类型、ABI size/alignment 和显式
    // drop lowering 都无需引入 union storage 或额外的 active-type tag。
    if (field.type_id.to_index() != local.type_id.to_index()) { return false; }

    Int mapping_index! = 0;
    while (mapping_index < mappings.len()) {
        mir.MirCoroutineLocalFrameField mapping = mappings.get(mapping_index);
        if (mapping.field_index == field_index) {
            mir.MirLocalDecl existing = body.locals[mapping.local_id.to_index()];
            if (!locals_can_share_frame_slot(local, existing, liveness)) { return false; }
        }
        mapping_index = mapping_index + 1;
    }
    return true;
}

Bool reusable_local_field_kind(mir.MirCoroutineFrameFieldKind kind) {
    return kind == .local || kind == .temp;
}

Bool locals_can_share_frame_slot(
    mir.MirLocalDecl lhs,
    mir.MirLocalDecl rhs,
    live_across_suspend.FrameLiveness& liveness
) {
    unsafe {
        if (rhs.kind == .param || liveness.address_preserved[rhs.id.to_index()]) {
            return false;
        }
        return !live_across_suspend.locals_interfere(liveness, lhs.id, rhs.id);
    }
}

mir.MirCoroutineFrameFieldKind frame_field_kind_for_local(mir.MirLocalKind kind) {
    if (kind == .param) { return .param; }
    if (kind == .user_local) { return .local; }
    return .temp;
}
