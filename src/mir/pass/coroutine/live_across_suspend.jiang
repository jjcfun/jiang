// 协程挂起点之间的局部变量逆向活跃性分析。

import list = "../../../support/list.jiang";
import mir = "../../mir.jiang";

struct LiveState: Movable {
    list.ArrayList<mir.MirLocalId> locals!;

    public init(self) {
        self.locals = list.ArrayList<mir.MirLocalId>();
    }
}

public struct FrameLiveness {
    public Bool*! live_locals;
    public Bool*! address_preserved;
    public UInt64*! interference;
    public Int local_count;
}

public Bool*! analyze(mir.MirBody body) {
    return analyze_frame_liveness(body).live_locals;
}

public FrameLiveness analyze_frame_liveness(mir.MirBody body) {
    unsafe {
        Bool*! result = Bool$.alloc(body.locals.length);
        Bool*! address_preserved = Bool$.alloc(body.locals.length);
        // 干涉关系使用稠密索引和位图存储。
        // 保留 O(N²) 查询，同时避免 Bool 矩阵的字节级膨胀。
        Int interference_words = interference_word_count(body.locals.length);
        UInt64*! interference = UInt64$.alloc(interference_words);
        init_bool_array(result, body.locals.length);
        init_bool_array(address_preserved, body.locals.length);
        init_uint64_array(interference, interference_words);
        if (body.blocks.length == 0) {
            return FrameLiveness (
                live_locals: result,
                address_preserved: address_preserved,
                interference: interference,
                local_count: body.locals.length
            );
        }

        Bool*! reachable = compute_reachable(body);
        LiveState*! in_states = LiveState$.alloc(body.blocks.length);
        init_live_states(in_states, body.blocks.length);
        FrameLiveness analysis = FrameLiveness (
            live_locals: result,
            address_preserved: address_preserved,
            interference: interference,
            local_count: body.locals.length
        );
        solve_liveness(body, reachable, in_states, analysis$.ref());
        Bool has_suspend = has_suspend_point(body, reachable);
        if (has_suspend) {
            merge_bool_arrays(result, address_preserved, body.locals.length);
        } else {
            init_bool_array(address_preserved, body.locals.length);
        }
        return analysis;
    }
}

public Bool locals_interfere(
    FrameLiveness& analysis,
    mir.MirLocalId lhs,
    mir.MirLocalId rhs
) {
    unsafe {
        Int bit_index = lhs.to_index() * analysis.local_count + rhs.to_index();
        UInt64 mask = UInt64(1) << UInt64(bit_index % 64);
        return (analysis.interference[bit_index / 64] & mask) != UInt64(0);
    }
}

Int interference_word_count(Int local_count) {
    Int bit_count = local_count * local_count;
    return (bit_count + 63) / 64;
}

() init_bool_array(Bool*! values, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            values[index] = false;
            index = index + 1;
        }
    }
}

() init_uint64_array(UInt64*! values, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            values[index] = UInt64(0);
            index = index + 1;
        }
    }
}

() merge_bool_arrays(Bool*! target, Bool*! source, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            target[index] = target[index] || source[index];
            index = index + 1;
        }
    }
}

() init_live_states(LiveState*! states, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            states[index] = LiveState();
            index = index + 1;
        }
    }
}

Bool*! compute_reachable(mir.MirBody body) {
    unsafe {
        Bool*! reachable = Bool$.alloc(body.blocks.length);
        init_bool_array(reachable, body.blocks.length);
        list.ArrayList<Int> worklist! = list.ArrayList<Int>();
        Int entry_index = body.entry.to_index();
        if (!valid_block_index(body, entry_index)) { return reachable; }
        reachable[entry_index] = true;
        worklist.add(entry_index);
        while (!worklist.empty()) {
            mark_reachable_successors(body, body.blocks[worklist.pop()], reachable, worklist$.ref());
        }
        return reachable;
    }
}

() mark_reachable_successors(
    mir.MirBody body,
    mir.MirBlock block,
    Bool*! reachable,
    list.ArrayList<Int>& worklist
) {
    unsafe {
        Int successor_index! = 0;
        while (successor_index < mir.terminator_successor_count(block.terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(block.terminator, successor_index);
            Int block_index = successor.to_index();
            if (valid_block_index(body, block_index) && !reachable[block_index]) {
                reachable[block_index] = true;
                worklist.add(block_index);
            }
            successor_index = successor_index + 1;
        }
    }
}

() solve_liveness(
    mir.MirBody body,
    Bool*! reachable,
    LiveState*! in_states,
    FrameLiveness& analysis
) {
    unsafe {
        Bool changed! = true;
        while (changed) {
            changed = false;
            Int block_index! = body.blocks.length;
            while (block_index > 0) {
                block_index = block_index - 1;
                changed = solve_liveness_block(
                    body, block_index, reachable, in_states, analysis
                ) || changed;
            }
        }
    }
}

Bool solve_liveness_block(
    mir.MirBody body,
    Int block_index,
    Bool*! reachable,
    LiveState*! in_states,
    FrameLiveness& analysis
) {
    unsafe {
        if (!reachable[block_index]) { return false; }
        mir.MirBlock block = body.blocks[block_index];
        LiveState state = successor_live_state(body, block, reachable, in_states);
        mark_live_pairs(state$.ref(), analysis.interference, analysis.local_count);
        collect_suspend_facts(block.terminator, state$.ref(), analysis);
        transfer_terminator_backward(body, block.terminator, state$.ref());
        mark_live_pairs(state$.ref(), analysis.interference, analysis.local_count);
        Int statement_index! = block.statements.length;
        while (statement_index > 0) {
            statement_index = statement_index - 1;
            mir.MirStatement statement = block.statements[statement_index];
            mark_addressed_in_statement(statement, analysis.address_preserved);
            transfer_statement_backward(statement, state$.ref());
            mark_live_pairs(state$.ref(), analysis.interference, analysis.local_count);
        }
        return merge_state(in_states[block_index]$.ref(), state$.ref());
    }
}

LiveState successor_live_state(
    mir.MirBody body,
    mir.MirBlock block,
    Bool*! reachable,
    LiveState*! in_states
) {
    unsafe {
        LiveState state! = LiveState();
        Int successor_index! = 0;
        while (successor_index < mir.terminator_successor_count(block.terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(block.terminator, successor_index);
            Int block_index = successor.to_index();
            if (valid_block_index(body, block_index) && reachable[block_index]) {
                merge_state(state$.ref(), in_states[block_index]$.ref());
            }
            successor_index = successor_index + 1;
        }
        return state$.move();
    }
}

() transfer_statement_backward(mir.MirStatement statement, LiveState& state) {
    if (statement.kind is .assign_stmt(assign_stmt)) {
        write_place(state, assign_stmt.destination);
        use_rvalue(state, assign_stmt.value);
        return;
    }
    if (statement.kind is .atomic_store_stmt(atomic_store)) {
        write_place(state, atomic_store.destination);
        use_operand(state, atomic_store.value);
        return;
    }
    if (statement.kind is .executor_leave_stmt(executor_leave)) {
        add_live_local(state, executor_leave.executor);
        add_live_local(state, executor_leave.previous_context);
        return;
    }
    if (statement.kind is .resume_token_complete_stmt(complete)) {
        use_place(state, complete.token);
        return;
    }
    if (statement.kind is .storage_live_stmt(storage_live)) {
        remove_live_local(state, storage_live.local_id);
        return;
    }
    if (statement.kind is .storage_dead_stmt(storage_dead)) {
        remove_live_local(state, storage_dead.local_id);
        return;
    }
    transfer_effect_statement_backward(statement, state);
}

() transfer_effect_statement_backward(mir.MirStatement statement, LiveState& state) {
    if (statement.kind is .set_discriminant_stmt(set_discriminant)) {
        write_place(state, set_discriminant.destination);
        return;
    }
    if (statement.kind is .forget_stmt(forget_stmt)) {
        use_place(state, forget_stmt.place);
        return;
    }
    if (statement.kind is .exclusive_stmt(exclusive_stmt)) {
        use_place(state, exclusive_stmt.place);
        return;
    }
    if (statement.kind is .task_consume_stmt(consume)) {
        use_place(state, consume.task);
        return;
    }
    if (statement.kind is .task_allocation_stmt(allocation)) {
        write_place(state, allocation.pointer);
        return;
    }
    if (statement.kind is .task_wait_stmt(wait)) {
        use_place(state, wait.state);
        return;
    }
    if (statement.kind is .task_release_stmt(release)) {
        use_task_release(state, release);
    }
}

() use_task_release(LiveState& state, mir.MirTaskReleaseStatement release) {
    use_place(state, release.task_pointer);
    use_place(state, release.frame);
    use_place(state, release.allocation_pointer);
    use_place(state, release.ownership_state);
    use_place(state, release.result);
    use_place(state, release.result_drop);
    use_place(state, release.result_initialized);
}

() transfer_terminator_backward(mir.MirBody body, mir.MirTerminator terminator, LiveState& state) {
    if (terminator.kind is .branch_term(branch_term)) {
        use_operand(state, branch_term.condition);
        return;
    }
    if (terminator.kind is .switch_term(switch_term)) {
        use_operand(state, switch_term.discriminator);
        return;
    }
    if (terminator.kind is .call_term(call_term)) {
        transfer_call_backward(call_term, state);
        return;
    }
    if (terminator.kind is .drop_term(drop_term)) {
        use_place(state, drop_term.place);
        return;
    }
    if (terminator.kind is .assert_term(assert_term)) {
        use_operand(state, assert_term.condition);
        return;
    }
    if (terminator.kind is .suspend_pending_term(suspend_pending)) {
        if (suspend_pending.task is .some(task)) { use_place(state, task); }
        return;
    }
    if (terminator.kind is .return_term(_)) {
        add_live_local(state, body.return_local);
        return;
    }
    if (terminator.kind is .throw_term(throw_term)) {
        use_operand(state, throw_term.error_value);
    }
}

() transfer_call_backward(mir.MirCallTerminator call_term, LiveState& state) {
    write_place(state, call_term.destination);
    if (call_term.initialized_place is .some(initialized_place)) {
        write_place(state, initialized_place);
    }
    use_callee(state, call_term.callee);
    use_operands(state, call_term.args);
    Int index! = 0;
    while (index < call_term.exclusive_places.length) {
        use_place(state, call_term.exclusive_places[index]);
        index = index + 1;
    }
}

() use_callee(LiveState& state, mir.MirCallCallee callee) {
    if (callee is .indirect_operand(operand)) {
        use_operand(state, operand);
        return;
    }
    if (callee is .domain_enqueue(enqueue)) {
        use_operand(state, enqueue.resume);
        return;
    }
    if (callee is .dynamic_domain_enqueue(enqueue)) {
        use_operand(state, enqueue.executor);
        use_operand(state, enqueue.resume);
    }
}

() use_rvalue(LiveState& state, mir.MirRvalue value) {
    if (value is .use_value(use_value)) { use_operand(state, use_value.value); return; }
    if (value is .unary_value(unary_value)) { use_operand(state, unary_value.value); return; }
    if (value is .binary_value(binary_value)) {
        use_operand(state, binary_value.lhs);
        use_operand(state, binary_value.rhs);
        return;
    }
    if (value is .cast_value(cast_value)) { use_operand(state, cast_value.value); return; }
    if (value is .inline_asm_value(inline_asm)) { use_inline_asm(state, inline_asm); return; }
    if (value is .borrow_value(borrow_value)) { use_place(state, borrow_value.place); return; }
    if (value is .address_of_value(address_of)) { use_place(state, address_of.place); return; }
    if (value is .coroutine_address_value(address)) { use_place(state, address.place); return; }
    if (value is .executor_enter_value(executor_enter)) {
        add_live_local(state, executor_enter.executor);
        add_live_local(state, executor_enter.context);
        return;
    }
    use_non_scalar_rvalue(state, value);
}

() use_non_scalar_rvalue(LiveState& state, mir.MirRvalue value) {
    if (value is .atomic_load_value(load)) { use_place(state, load.place); return; }
    if (value is .atomic_compare_exchange_value(compare_exchange)) {
        use_place(state, compare_exchange.place);
        use_operand(state, compare_exchange.expected);
        use_operand(state, compare_exchange.desired);
        return;
    }
    if (value is .alloc_value(alloc_value)) { use_operand(state, alloc_value.value); return; }
    if (value is .alloc_array_value(alloc_array)) { use_operand(state, alloc_array.count); return; }
    if (value is .free_value(free_value)) { use_operand(state, free_value.pointer); return; }
    if (value is .slice_value(slice_value)) { use_slice_rvalue(state, slice_value); return; }
    if (value is .len_value(len_value)) { use_place(state, len_value.place); return; }
    if (value is .discriminant_value(discriminant)) { use_place(state, discriminant.place); return; }
    use_aggregate_like_rvalue(state, value);
}

() use_slice_rvalue(LiveState& state, mir.MirSliceRvalue value) {
    use_place(state, value.base);
    if (value.start is .some(start)) { use_operand(state, start); }
    if (value.end is .some(end)) { use_operand(state, end); }
}

() use_aggregate_like_rvalue(LiveState& state, mir.MirRvalue value) {
    if (value is .aggregate_value(aggregate)) {
        if (aggregate.tag is .some(tag)) { use_operand(state, tag); }
        use_operands(state, aggregate.fields);
        return;
    }
    if (value is .optional_value(optional_value)) {
        use_operand(state, optional_value.value);
        return;
    }
    if (value is .error_union_value(error_union)) {
        use_operand(state, error_union.value);
    }
}

() use_inline_asm(LiveState& state, mir.MirInlineAsmRvalue value) {
    Int index! = 0;
    while (index < value.operands.length) {
        if (value.operands[index] is .input(input)) {
            use_operand(state, input.value);
        }
        index = index + 1;
    }
}

() use_operands(LiveState& state, mir.MirOperand[]& operands) {
    Int index! = 0;
    while (index < operands.length) {
        use_operand(state, operands[index]);
        index = index + 1;
    }
}

() use_operand(LiveState& state, mir.MirOperand operand) {
    if (operand is .copy_operand(copy_operand)) {
        use_place(state, copy_operand.place);
        return;
    }
    if (operand is .move_operand(move_operand)) {
        use_place(state, move_operand.place);
        return;
    }
    if (operand is .out_operand(out_operand)) {
        write_place(state, out_operand.place);
    }
}

() use_place(LiveState& state, mir.MirPlace place) {
    if (mir.place_local_id(place) is .some(local_id)) {
        add_live_local(state, local_id);
    }
    use_projection_indices(state, place);
}

() write_place(LiveState& state, mir.MirPlace place) {
    if (place.projection.length == 0) {
        if (mir.place_local_id(place) is .some(local_id)) {
            remove_live_local(state, local_id);
        }
        return;
    }
    use_place(state, place);
}

() use_projection_indices(LiveState& state, mir.MirPlace place) {
    Int index! = 0;
    while (index < place.projection.length) {
        if (place.projection[index] is .index_projection(index_projection)) {
            add_live_local(state, index_projection.index_local);
        }
        index = index + 1;
    }
}

Bool collect_suspend_facts(
    mir.MirTerminator terminator,
    LiveState& live_out,
    FrameLiveness& analysis
) {
    if (terminator.kind is .call_term(call_term)) {
        if (!call_term.is_suspend_point) { return false; }
        mark_live_state(live_out, analysis.live_locals);
        mark_place_local(call_term.destination, analysis.live_locals);
        mark_suspend_destination_interference(call_term, live_out, analysis);
        if (call_term.initialized_place is .some(initialized_place)) {
            mark_place_local(initialized_place, analysis.live_locals);
        }
        return true;
    }
    guard terminator.kind is .suspend_pending_term(suspend_pending) else { return false; }
    mark_live_state(live_out, analysis.live_locals);
    if (suspend_pending.task is .some(task)) { mark_place_local(task, analysis.live_locals); }
    return true;
}

Bool has_suspend_point(mir.MirBody body, Bool*! reachable) {
    unsafe {
        Int block_index! = 0;
        while (block_index < body.blocks.length) {
            if (reachable[block_index] && is_suspend_terminator(body.blocks[block_index].terminator)) {
                return true;
            }
            block_index = block_index + 1;
        }
        return false;
    }
}

Bool is_suspend_terminator(mir.MirTerminator terminator) {
    if (terminator.kind is .suspend_pending_term(_)) { return true; }
    guard terminator.kind is .call_term(call) else { return false; }
    return call.is_suspend_point;
}

() mark_suspend_destination_interference(
    mir.MirCallTerminator call,
    LiveState& live_out,
    FrameLiveness& analysis
) {
    // continuation 在恢复时写 destination，因此它不能覆盖任何 live-out local。
    mark_place_against_state(
        call.destination, live_out, analysis.interference, analysis.local_count
    );
    guard call.initialized_place is .some(initialized_place) else { return; }
    mark_place_against_state(
        initialized_place, live_out, analysis.interference, analysis.local_count
    );
    mark_places_interfere(
        call.destination, initialized_place, analysis.interference, analysis.local_count
    );
}

() mark_live_pairs(LiveState& state, UInt64*! interference, Int local_count) {
    Int lhs_index! = 0;
    while (lhs_index < state.locals.len()) {
        Int rhs_index! = lhs_index + 1;
        while (rhs_index < state.locals.len()) {
            mark_local_pair(
                state.locals.get(lhs_index),
                state.locals.get(rhs_index),
                interference,
                local_count
            );
            rhs_index = rhs_index + 1;
        }
        lhs_index = lhs_index + 1;
    }
}

() mark_place_against_state(
    mir.MirPlace place,
    LiveState& state,
    UInt64*! interference,
    Int local_count
) {
    if (mir.place_local_id(place) is .some(local_id)) {
        mark_local_against_state(local_id, state, interference, local_count);
    }
    Int index! = 0;
    while (index < place.projection.length) {
        if (place.projection[index] is .index_projection(index_projection)) {
            mark_local_against_state(index_projection.index_local, state, interference, local_count);
        }
        index = index + 1;
    }
}

() mark_local_against_state(
    mir.MirLocalId local_id,
    LiveState& state,
    UInt64*! interference,
    Int local_count
) {
    Int index! = 0;
    while (index < state.locals.len()) {
        mark_local_pair(local_id, state.locals.get(index), interference, local_count);
        index = index + 1;
    }
}

() mark_places_interfere(
    mir.MirPlace lhs,
    mir.MirPlace rhs,
    UInt64*! interference,
    Int local_count
) {
    guard mir.place_local_id(lhs) is .some(lhs_local) else { return; }
    guard mir.place_local_id(rhs) is .some(rhs_local) else { return; }
    mark_local_pair(lhs_local, rhs_local, interference, local_count);
}

() mark_local_pair(
    mir.MirLocalId lhs,
    mir.MirLocalId rhs,
    UInt64*! interference,
    Int local_count
) {
    if (lhs.to_index() == rhs.to_index()) { return; }
    unsafe {
        set_interference_bit(
            interference,
            lhs.to_index() * local_count + rhs.to_index()
        );
        set_interference_bit(
            interference,
            rhs.to_index() * local_count + lhs.to_index()
        );
    }
}

() set_interference_bit(UInt64*! interference, Int bit_index) {
    unsafe {
        Int word_index = bit_index / 64;
        UInt64 mask = UInt64(1) << UInt64(bit_index % 64);
        interference[word_index] = interference[word_index] | mask;
    }
}

() mark_live_state(LiveState& state, Bool*! result) {
    unsafe {
        Int index! = 0;
        while (index < state.locals.len()) {
            result[state.locals.get(index).to_index()] = true;
            index = index + 1;
        }
    }
}

() mark_place_local(mir.MirPlace place, Bool*! result) {
    unsafe {
        if (mir.place_local_id(place) is .some(local_id)) {
            result[local_id.to_index()] = true;
        }
        Int index! = 0;
        while (index < place.projection.length) {
            if (place.projection[index] is .index_projection(index_projection)) {
                result[index_projection.index_local.to_index()] = true;
            }
            index = index + 1;
        }
    }
}

() mark_addressed_in_statement(mir.MirStatement statement, Bool*! result) {
    if (statement.kind is .assign_stmt(assign_stmt)) {
        mark_addressed_in_rvalue(assign_stmt.value, result);
        return;
    }
}

() mark_addressed_in_rvalue(mir.MirRvalue value, Bool*! result) {
    if (value is .borrow_value(borrow_value)) {
        mark_place_local(borrow_value.place, result);
        return;
    }
    if (value is .address_of_value(address_of)) {
        mark_place_local(address_of.place, result);
        return;
    }
    if (value is .coroutine_address_value(address)) {
        if (!address.frame_root) { mark_place_local(address.place, result); }
    }
}

Bool merge_state(LiveState& target, LiveState& source) {
    Bool changed! = false;
    Int index! = 0;
    while (index < source.locals.len()) {
        changed = add_live_local(target, source.locals.get(index)) || changed;
        index = index + 1;
    }
    return changed;
}

Bool add_live_local(LiveState& state, mir.MirLocalId local_id) {
    if (has_live_local(state, local_id)) { return false; }
    state.locals.add(local_id);
    return true;
}

() remove_live_local(LiveState& state, mir.MirLocalId local_id) {
    Int index! = 0;
    while (index < state.locals.len()) {
        if (state.locals.get(index).to_index() == local_id.to_index()) {
            remove_live_local_at(state, index);
            return;
        }
        index = index + 1;
    }
}

() remove_live_local_at(LiveState& state, Int index) {
    Int last_index = state.locals.len() - 1;
    if (index != last_index) {
        state.locals.set(index, state.locals.get(last_index));
    }
    state.locals.truncate(last_index);
}

Bool has_live_local(LiveState& state, mir.MirLocalId local_id) {
    Int index! = 0;
    while (index < state.locals.len()) {
        if (state.locals.get(index).to_index() == local_id.to_index()) { return true; }
        index = index + 1;
    }
    return false;
}

Bool valid_block_index(mir.MirBody body, Int index) {
    return index >= 0 && index < body.blocks.length;
}
