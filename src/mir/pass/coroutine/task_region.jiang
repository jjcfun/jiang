// 收集结构化 Task 的词法 origin、消费和 cleanup 位置。
// storage plan 是编译期事实，backend 不再从 allocation pointer 猜测所有权。

import list = "../../../support/list.jiang";
import mir = "../../mir.jiang";

public mir.MirTaskRegion[]& analyze(mir.MirStore& output, mir.MirBody body) {
    list.ArrayList<mir.MirTaskRegion> regions! = list.ArrayList<mir.MirTaskRegion>();
    collect_origins(body, regions$.ref());
    collect_uses(body, regions$.mut_ref());
    return output.task_region_array(regions$.ref());
}

() collect_origins(mir.MirBody body, list.ArrayList<mir.MirTaskRegion>& regions) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        mir.MirBlock block = body.blocks[block_index];
        collect_block_origins(block, regions);
        block_index = block_index + 1;
    }
}

() collect_block_origins(mir.MirBlock block, list.ArrayList<mir.MirTaskRegion>& regions) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        mir.MirStatement statement = block.statements[statement_index];
        if (statement.kind is .task_region_start_stmt(start)) {
            append_origin(block.id, statement_index, start, regions);
        }
        statement_index = statement_index + 1;
    }
}

() append_origin(
    mir.MirBlockId block_id,
    Int statement_index,
    mir.MirTaskRegionStartStatement start,
    list.ArrayList<mir.MirTaskRegion>& regions
) {
    guard mir.place_local_id(start.task) is .some(task_local) else { return; }
    regions.add(mir.MirTaskRegion (
        task_local: task_local,
        origin_block: block_id,
        origin_statement_index: statement_index,
        release_block: null,
        release_statement_index: -1,
        consume_count: 0,
        release_count: 0,
        storage: start.storage,
        child_resume: start.child_resume
    ));
}

() collect_uses(mir.MirBody body, list.ArrayList<mir.MirTaskRegion>&! regions) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        mir.MirBlock block = body.blocks[block_index];
        collect_block_uses(block, regions);
        block_index = block_index + 1;
    }
}

() collect_block_uses(mir.MirBlock block, list.ArrayList<mir.MirTaskRegion>&! regions) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        collect_statement_use(
            block.id, statement_index, block.statements[statement_index], regions
        );
        statement_index = statement_index + 1;
    }
}

() collect_statement_use(
    mir.MirBlockId block_id,
    Int statement_index,
    mir.MirStatement statement,
    list.ArrayList<mir.MirTaskRegion>&! regions
) {
    if (statement.kind is .task_consume_stmt(consume)) {
        increment_region(regions, consume.task, true);
        return;
    }
    if (statement.kind is .task_release_stmt(release)) {
        record_release(regions, release.task_pointer, block_id, statement_index);
    }
}

() increment_region(
    list.ArrayList<mir.MirTaskRegion>&! regions,
    mir.MirPlace place,
    Bool consumed
) {
    guard mir.place_local_id(place) is .some(task_local) else { return; }
    Int index! = 0;
    while (index < regions.len()) {
        mir.MirTaskRegion region! = regions.get(index);
        if (region.task_local == task_local) {
            if (consumed) { region.consume_count = region.consume_count + 1; }
            else { region.release_count = region.release_count + 1; }
            regions.set(index, region$.move());
            return;
        }
        index = index + 1;
    }
}

() record_release(
    list.ArrayList<mir.MirTaskRegion>&! regions,
    mir.MirPlace place,
    mir.MirBlockId block_id,
    Int statement_index
) {
    guard mir.place_local_id(place) is .some(task_local) else { return; }
    Int index! = 0;
    while (index < regions.len()) {
        mir.MirTaskRegion region! = regions.get(index);
        if (region.task_local == task_local) {
            region.release_count = region.release_count + 1;
            if (region.release_count == 1) {
                region.release_block = block_id;
                region.release_statement_index = statement_index;
            }
            regions.set(index, region$.move());
            return;
        }
        index = index + 1;
    }
}

public Bool regions_do_not_overlap(
    mir.MirBody body,
    mir.MirTaskRegion lhs,
    mir.MirTaskRegion rhs
) {
    if (region_precedes(body, lhs, rhs)) { return true; }
    return region_precedes(body, rhs, lhs);
}

Bool region_precedes(
    mir.MirBody body,
    mir.MirTaskRegion earlier,
    mir.MirTaskRegion later
) {
    if (earlier.release_count == 0) { return false; }
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        if (block_has_preceding_release(body, body.blocks[block_index], earlier, later)) {
            return true;
        }
        block_index = block_index + 1;
    }
    return false;
}

Bool block_has_preceding_release(
    mir.MirBody body,
    mir.MirBlock block,
    mir.MirTaskRegion earlier,
    mir.MirTaskRegion later
) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        mir.MirStatement statement = block.statements[statement_index];
        if (statement_releases_task(statement, earlier.task_local)) {
            if (release_precedes_origin(body, block.id, statement_index, later)) { return true; }
        }
        statement_index = statement_index + 1;
    }
    return false;
}

Bool statement_releases_task(mir.MirStatement statement, mir.MirLocalId task_local) {
    guard statement.kind is .task_release_stmt(release) else { return false; }
    guard mir.place_local_id(release.task_pointer) is .some(released_task) else { return false; }
    return released_task == task_local;
}

Bool release_precedes_origin(
    mir.MirBody body,
    mir.MirBlockId release_block,
    Int release_statement_index,
    mir.MirTaskRegion later
) {
    if (release_block == later.origin_block) {
        return release_statement_index < later.origin_statement_index;
    }
    if (!block_dominates(body, release_block, later.origin_block)) { return false; }
    // 循环回边会让同一物理 region 的不同迭代重叠，存在环时不复用。
    return !block_reaches(body, later.origin_block, release_block);
}

Bool block_dominates(
    mir.MirBody body,
    mir.MirBlockId dominator,
    mir.MirBlockId target
) {
    if (dominator == body.entry || dominator == target) { return true; }
    // 删除候选 dominator 后 target 不可达，等价于 dominator 支配 target。
    return !block_reaches_without(body, body.entry, target, dominator);
}

Bool block_reaches(
    mir.MirBody body,
    mir.MirBlockId start,
    mir.MirBlockId target
) {
    return block_reaches_without(body, start, target, null);
}

Bool block_reaches_without(
    mir.MirBody body,
    mir.MirBlockId start,
    mir.MirBlockId target,
    mir.MirBlockId? excluded
) {
    unsafe {
        if (excluded is .some(block) && start == block) { return false; }
        Bool*! visited = Bool$.alloc(body.blocks.length);
        init_visited(visited, body.blocks.length);
        list.ArrayList<mir.MirBlockId> worklist! = list.ArrayList<mir.MirBlockId>();
        visited[start.to_index()] = true;
        worklist.add(start);
        while (!worklist.empty()) {
            mir.MirBlockId current = worklist.pop();
            if (current == target) { return true; }
            push_successors(body, current, excluded, visited, worklist$.ref());
        }
        return false;
    }
}

() init_visited(Bool*! visited, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            visited[index] = false;
            index = index + 1;
        }
    }
}

() push_successors(
    mir.MirBody body,
    mir.MirBlockId current,
    mir.MirBlockId? excluded,
    Bool*! visited,
    list.ArrayList<mir.MirBlockId>& worklist
) {
    unsafe {
        mir.MirTerminator terminator = body.blocks[current.to_index()].terminator;
        Int index! = 0;
        while (index < mir.terminator_successor_count(terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(terminator, index);
            if (!is_excluded(successor, excluded)) {
                push_unvisited(successor, visited, worklist);
            }
            index = index + 1;
        }
    }
}

Bool is_excluded(mir.MirBlockId block, mir.MirBlockId? excluded) {
    guard excluded is .some(excluded_block) else { return false; }
    return block == excluded_block;
}

() push_unvisited(
    mir.MirBlockId block,
    Bool*! visited,
    list.ArrayList<mir.MirBlockId>& worklist
) {
    unsafe {
        if (visited[block.to_index()]) { return; }
        visited[block.to_index()] = true;
        worklist.add(block);
    }
}
