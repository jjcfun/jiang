// 无等待 coroutine DAG 的同步执行变体。
//
// RTC resume 仍接收现有 frame pointer 并把结果写入 continuation_result，
// 但完成时直接返回调用者。这样静态 direct child 可以成为普通可内联调用；
// recursive start shim、Task suspend 和任何真实 wake 边都不会进入该 ABI。

import list = "../../../support/list.jiang";
import mir = "../../mir.jiang";
import plan = "./plan.jiang";

public list.ArrayList<Bool> analyze(mir.MirStore& output) {
    list.ArrayList<Bool> eligible! = initial_eligibility(output);
    Bool changed! = true;
    while (changed) {
        changed = refine_eligibility(output, eligible$.mut_ref());
    }
    return eligible$.move();
}

list.ArrayList<Bool> initial_eligibility(mir.MirStore& output) {
    list.ArrayList<Bool> eligible! = list.ArrayList<Bool>(output.functions.len());
    Int index! = 0;
    while (index < output.functions.len()) {
        eligible.add(function_has_rtc_shape(
            output, output.functions.get(index)
        ));
        index = index + 1;
    }
    return eligible$.move();
}

Bool function_has_rtc_shape(
    mir.MirStore& output,
    mir.MirFunction function
) {
    if (!function.is_coroutine || function.is_external) { return false; }
    guard function.coroutine_frame is .some(frame) else { return false; }
    if (frame.may_defer) { return false; }
    Int index! = 0;
    while (index < function.body.blocks.length) {
        if (!terminator_has_rtc_shape(
                output, frame$.ref(), function.body.blocks[index].terminator
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool terminator_has_rtc_shape(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirTerminator terminator
) {
    if (terminator.kind is .suspend_pending_term(suspend)) {
        return task_suspend_completes_inline(output, frame, suspend);
    }
    guard terminator.kind is .call_term(call) else { return true; }
    if (!call.is_suspend_point) {
        return observed_task_has_static_child(call);
    }
    guard call.suspend_child is .some(child) else { return false; }
    if (call.suspend_wake != .direct_child && call.suspend_wake != .cross_executor) {
        return false;
    }
    return call_directly_names_child(call.callee, child);
}

Bool observed_task_has_static_child(mir.MirCallTerminator call) {
    guard call.async_start is .some(kind) else { return true; }
    if (kind != .observed_task) { return true; }
    guard call.suspend_child is .some(child) else { return false; }
    return call_directly_names_child(call.callee, child);
}

Bool refine_eligibility(
    mir.MirStore& output,
    list.ArrayList<Bool>&! eligible
) {
    Bool changed! = false;
    Int index! = 0;
    while (index < output.functions.len()) {
        if (eligible.get(index) && !children_are_eligible(
                output, output.functions.get(index), eligible
            )
        ) {
            eligible.set(index, false);
            changed = true;
        }
        index = index + 1;
    }
    return changed;
}

Bool children_are_eligible(
    mir.MirStore& output,
    mir.MirFunction function,
    list.ArrayList<Bool>& eligible
) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        mir.MirTerminator terminator = function.body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (!call_child_is_eligible(output, call, eligible)) { return false; }
        }
        if (terminator.kind is .suspend_pending_term(suspend)) {
            if (!task_suspend_child_is_eligible(
                    output, function, suspend, eligible
                )
            ) { return false; }
        }
        index = index + 1;
    }
    return true;
}

Bool call_child_is_eligible(
    mir.MirStore& output,
    mir.MirCallTerminator call,
    list.ArrayList<Bool>& eligible
) {
    Bool observed! = false;
    if (call.async_start is .some(kind)) { observed = kind == .observed_task; }
    if (!call.is_suspend_point && !observed) { return true; }
    guard call.suspend_child is .some(child) else { return false; }
    guard function_id(output, child) is .some(function_id) else { return false; }
    Int index = function_id.to_index();
    return index >= 0 && index < eligible.len() && eligible.get(index);
}

Bool task_suspend_child_is_eligible(
    mir.MirStore& output,
    mir.MirFunction function,
    mir.MirSuspendPendingTerminator suspend,
    list.ArrayList<Bool>& eligible
) {
    if (suspend.suspend_wake != .task_child) { return false; }
    guard function.coroutine_frame is .some(frame) else { return false; }
    guard task_region(frame$.ref(), suspend) is .some(region) else { return false; }
    guard region.child_resume is .some(child) else { return false; }
    guard function_id(output, child) is .some(function_id) else { return false; }
    return function_is_eligible(eligible, function_id);
}

public Bool function_is_eligible(
    list.ArrayList<Bool>& eligible,
    mir.MirFunctionId function_id
) {
    Int index = function_id.to_index();
    return index >= 0 && index < eligible.len() && eligible.get(index);
}

public mir.MirFunctionRef? eligible_child(
    mir.MirStore& output,
    list.ArrayList<Bool>& eligible,
    mir.MirCallTerminator call
) {
    if (!call.is_suspend_point) { return null; }
    guard call.suspend_child is .some(child) else { return null; }
    if (!call_directly_names_child(call.callee, child)) { return null; }
    guard function_id(output, child) is .some(function_id) else { return null; }
    if (!function_is_eligible(eligible, function_id)) { return null; }
    return child;
}

public mir.MirBody rewrite_body(
    mir.MirStore& output,
    mir.MirBody body,
    mir.MirCoroutineFrameLayout& frame,
    plan.Store& plans
) {
    list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        blocks.add(rewrite_block(output, body.blocks[index], frame, plans));
        index = index + 1;
    }
    return mir.MirBody (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: output.block_array(blocks$.ref()),
        entry: body.entry,
        return_local: body.return_local
    );
}

public Bool body_uses_rtc(
    mir.MirStore& output,
    mir.MirBody body,
    mir.MirCoroutineFrameLayout& frame,
    plan.Store& plans
) {
    Int index! = 0;
    while (index < body.blocks.length) {
        mir.MirTerminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (call_uses_rtc(call, plans)) { return true; }
        }
        if (terminator.kind is .suspend_pending_term(suspend)) {
            if (task_suspend_completes_inline(output, frame, suspend)) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

public Bool body_has_direct_rtc_child(
    mir.MirBody body,
    plan.Store& plans
) {
    Int index! = 0;
    while (index < body.blocks.length) {
        mir.MirTerminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (direct_call_uses_rtc(call, plans)) { return true; }
        }
        index = index + 1;
    }
    return false;
}

public Bool body_has_cross_executor_child(mir.MirBody body) {
    Int index! = 0;
    while (index < body.blocks.length) {
        mir.MirTerminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (call.is_suspend_point && call.suspend_wake == .cross_executor) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

public mir.MirBody rewrite_direct_rtc_children(
    mir.MirStore& output,
    mir.MirBody body,
    plan.Store& plans
) {
    list.ArrayList<mir.MirBlock> blocks! = list.ArrayList<mir.MirBlock>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        mir.MirBlock block = body.blocks[index];
        blocks.add(mir.MirBlock (
            id: block.id,
            span: block.span,
            statements: block.statements,
            terminator: direct_rtc_terminator(output, block.terminator, plans)
        ));
        index = index + 1;
    }
    return mir.MirBody (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: output.block_array(blocks$.ref()),
        entry: body.entry,
        return_local: body.return_local
    );
}

Bool direct_call_uses_rtc(
    mir.MirCallTerminator call,
    plan.Store& plans
) {
    if (call.suspend_wake != .direct_child) { return false; }
    return call_uses_rtc(call, plans);
}

mir.MirTerminator direct_rtc_terminator(
    mir.MirStore& output,
    mir.MirTerminator terminator,
    plan.Store& plans
) {
    guard terminator.kind is .call_term(call) else { return terminator; }
    if (!direct_call_uses_rtc(call, plans)) { return terminator; }
    return rewrite_rtc_call(output, terminator, plans);
}

Bool call_uses_rtc(
    mir.MirCallTerminator call,
    plan.Store& plans
) {
    guard call.suspend_child is .some(child) else { return false; }
    mir.MirFunctionKey key = mir.MirFunctionKey(
        child.function_def, child.type_args, child.const_args
    );
    return plans.get(key).rtc_resume != null;
}

mir.MirBlock rewrite_block(
    mir.MirStore& output,
    mir.MirBlock block,
    mir.MirCoroutineFrameLayout& frame,
    plan.Store& plans
) {
    return mir.MirBlock (
        id: block.id,
        span: block.span,
        statements: block.statements,
        terminator: rewrite_terminator(
            output, block.terminator, frame, plans
        )
    );
}

mir.MirTerminator rewrite_terminator(
    mir.MirStore& output,
    mir.MirTerminator terminator,
    mir.MirCoroutineFrameLayout& frame,
    plan.Store& plans
) {
    if (terminator.kind is .suspend_pending_term(suspend)) {
        if (task_suspend_completes_inline(output, frame, suspend)) {
            return mir.MirTerminator (
                span: terminator.span,
                kind: mir.goto_terminator_kind(mir.MirGotoTerminator (
                    target: suspend.target
                ))
            );
        }
        return terminator;
    }
    return rewrite_rtc_call(output, terminator, plans);
}

mir.MirTerminator rewrite_rtc_call(
    mir.MirStore& output,
    mir.MirTerminator terminator,
    plan.Store& plans
) {
    guard terminator.kind is .call_term(call) else { return terminator; }
    guard call.suspend_child is .some(child) else { return terminator; }
    mir.MirFunctionKey key = mir.MirFunctionKey(
        child.function_def, child.type_args, child.const_args
    );
    guard plans.get(key).rtc_resume is .some(variant_def) else { return terminator; }
    mir.MirFunctionRef variant = mir.MirFunctionRef (
        function_def: variant_def,
        type_args: output.empty_type_args(),
        const_args: output.empty_const_args(),
        coroutine_resume: false,
        coroutine_completion: false,
        type_id: child.type_id,
        span: child.span
    );
    return mir.MirTerminator (
        span: terminator.span,
        kind: mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.direct_function_callee(variant),
            args: call.args,
            current_effects: call.current_effects,
            is_suspend_point: false,
            destination: call.destination,
            target: call.target,
            initialized_place: call.initialized_place,
            exclusive_places: call.exclusive_places,
            cleanup: call.cleanup
        ))
    );
}

Bool task_suspend_completes_inline(
    mir.MirStore& output,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirSuspendPendingTerminator suspend
) {
    if (suspend.suspend_wake != .task_child) { return false; }
    guard task_region(frame, suspend) is .some(region) else { return false; }
    if (region.storage.sync != .local_serial) { return false; }
    guard region.child_resume is .some(child) else { return false; }
    guard function_id(output, child) is .some(function_id) else { return false; }
    mir.MirFunction child_function = output.function(function_id);
    guard child_function.coroutine_frame is .some(child_frame) else { return false; }
    return !child_frame.may_defer;
}

mir.MirTaskRegion? task_region(
    mir.MirCoroutineFrameLayout& frame,
    mir.MirSuspendPendingTerminator suspend
) {
    guard suspend.task_local is .some(task_local) else { return null; }
    Int index! = 0;
    while (index < frame.task_regions.length) {
        mir.MirTaskRegion region = frame.task_regions[index];
        if (region.task_local == task_local) { return region; }
        index = index + 1;
    }
    return null;
}

Bool call_directly_names_child(
    mir.MirCallCallee callee,
    mir.MirFunctionRef child
) {
    if (callee is .direct_function(function_ref)) {
        return function_ref_equal(function_ref, child);
    }
    if (callee is .domain_enqueue(enqueue)) {
        guard enqueue.resume is .function_operand(function_ref) else { return false; }
        return function_ref_equal(function_ref, child);
    }
    return false;
}

Bool function_ref_equal(mir.MirFunctionRef lhs, mir.MirFunctionRef rhs) {
    if (lhs.coroutine_resume != rhs.coroutine_resume) { return false; }
    if (lhs.coroutine_completion != rhs.coroutine_completion) { return false; }
    mir.MirFunctionKey left = mir.MirFunctionKey(
        lhs.function_def, lhs.type_args, lhs.const_args
    );
    mir.MirFunctionKey right = mir.MirFunctionKey(
        rhs.function_def, rhs.type_args, rhs.const_args
    );
    return mir.MirFunctionKey.equal(left$.ref(), right$.ref());
}

mir.MirFunctionId? function_id(
    mir.MirStore& output,
    mir.MirFunctionRef child
) {
    if (child.type_args.length == 0 && child.const_args.length == 0) {
        return output.function_id_for_def(child.function_def);
    }
    return output.function_id_for_instance(
        child.function_def, child.type_args, child.const_args
    );
}
