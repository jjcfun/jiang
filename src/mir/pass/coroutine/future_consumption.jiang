// Future consumption analysis runs on initial MIR before coroutine frame layout.

import mir = "../../mir.jiang";
import list = "../../../support/list.jiang";

public mir.MirFutureConsumption[]& analyze(mir.MirStore& output, mir.MirBody body) {
    list.ArrayList<mir.MirFutureConsumption>! consumptions = list.ArrayList<mir.MirFutureConsumption>();
    Int! index = 0;
    while (index < body.blocks.length) {
        mir.MirBlock block = body.blocks[index];
        if (observed_future_start(block) is .some(future_local)) {
            consumptions.add(classify_start(body, block, future_local));
        }
        index = index + 1;
    }
    return output.future_consumption_array(consumptions$.ref());
}

mir.MirLocalId? observed_future_start(mir.MirBlock block) {
    guard block.terminator.kind is .call_term(call) else { return null; }
    guard call.async_start is .some(kind) else { return null; }
    if (kind != mir.MirAsyncStartKind.observed_future) { return null; }
    guard async_resume_operand(call.callee) is .some(operand) else { return null; }
    guard operand_place(operand) is .some(place) else { return null; }
    return mir.place_local_id(place);
}

mir.MirOperand? async_resume_operand(mir.MirCallCallee callee) {
    if (callee is .indirect_operand(operand)) { return operand; }
    if (callee is .domain_enqueue(enqueue)) { return enqueue.resume; }
    if (callee is .dynamic_domain_enqueue(enqueue)) { return enqueue.resume; }
    return null;
}

mir.MirPlace? operand_place(mir.MirOperand operand) {
    if (operand is .copy_operand(copy_operand)) { return copy_operand.place; }
    if (operand is .move_operand(move_operand)) { return move_operand.place; }
    return null;
}

mir.MirFutureConsumption classify_start(
    mir.MirBody body,
    mir.MirBlock start,
    mir.MirLocalId future_local
) {
    Bool![*] visiting = unsafe {
        Bool!$.alloc_many(body.blocks.length)
    };
    init_bool_array(visiting, body.blocks.length);
    Bool! consumed = false;
    if (!start_crosses_domain(start)) {
        consumed = all_paths_consume(body, start.terminator, future_local, visiting);
    }
    mir.MirFutureStorageKind! storage = .heap_observed;
    if (consumed) { storage = .inline_observed; }
    return mir.MirFutureConsumption (
        future_local: future_local,
        start_block: start.id,
        consume_block: first_consume_block(body, future_local),
        storage: storage
    );
}

Bool start_crosses_domain(mir.MirBlock start) {
    guard start.terminator.kind is .call_term(call) else { return false; }
    if (call.callee is .domain_enqueue(_)) { return true; }
    return call.callee is .dynamic_domain_enqueue(_);
}

() init_bool_array(Bool![*] values, Int count) {
    Int! index = 0;
    while (index < count) {
        values[index] = false;
        index = index + 1;
    }
}

Bool all_paths_consume(
    mir.MirBody body,
    mir.MirTerminator start,
    mir.MirLocalId future_local,
    Bool![*] visiting
) {
    Int successor_count = mir.terminator_successor_count(start);
    if (successor_count == 0) { return false; }
    Int! index = 0;
    while (index < successor_count) {
        mir.MirBlockId successor = mir.terminator_successor_at(start, index);
        if (!block_paths_consume(body, successor, future_local, visiting)) { return false; }
        index = index + 1;
    }
    return true;
}

Bool block_paths_consume(
    mir.MirBody body,
    mir.MirBlockId block_id,
    mir.MirLocalId future_local,
    Bool![*] visiting
) {
    Int index = block_id.to_index();
    if (visiting[index]) { return false; }
    mir.MirBlock block = body.blocks[index];
    if (block_consumes_future(block, future_local)) { return true; }
    visiting[index] = true;
    Bool result = all_paths_consume(body, block.terminator, future_local, visiting);
    visiting[index] = false;
    return result;
}

Bool block_consumes_future(mir.MirBlock block, mir.MirLocalId future_local) {
    Int! index = 0;
    while (index < block.statements.length) {
        mir.MirStatement statement = block.statements[index];
        if (statement.kind is .future_consume_stmt(consume)) {
            if (mir.place_local_id(consume.future) is .some(local_id)) {
                if (local_id.to_index() == future_local.to_index()) { return true; }
            }
        }
        index = index + 1;
    }
    return false;
}

mir.MirBlockId? first_consume_block(mir.MirBody body, mir.MirLocalId future_local) {
    Int! index = 0;
    while (index < body.blocks.length) {
        if (block_consumes_future(body.blocks[index], future_local)) {
            return body.blocks[index].id;
        }
        index = index + 1;
    }
    return null;
}
