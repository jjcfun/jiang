// Suspend point collection for stackless coroutine lowering.

import list = "../../../support/list.jiang";
import mir = "../../mir.jiang";

public mir.MirCoroutineSuspendPoint[]& collect(
    mir.MirStore& output,
    mir.MirBody body
) {
    list.ArrayList<mir.MirCoroutineSuspendPoint> points! =
        list.ArrayList<mir.MirCoroutineSuspendPoint>();
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        collect_block(points$.ref(), body.blocks[block_index]);
        block_index = block_index + 1;
    }
    return output.coroutine_suspend_point_array(points$.ref());
}

() collect_block(
    list.ArrayList<mir.MirCoroutineSuspendPoint>& points,
    mir.MirBlock block
) {
    if (block.terminator.kind is .suspend_pending_term(suspend_pending)) {
        points.add(mir.MirCoroutineSuspendPoint (
            state_id: points.len() + 1,
            block_id: block.id,
            resume_target: suspend_pending.target
        ));
        return;
    }
    guard block.terminator.kind is .call_term(call_term) else { return; }
    if (!call_term.is_suspend_point) { return; }
    points.add(mir.MirCoroutineSuspendPoint (
        state_id: points.len() + 1,
        block_id: block.id,
        resume_target: call_term.target
    ));
}
