// Coroutine state dispatch skeleton for stackless coroutine lowering.

import list = "../../../support/list.jiang";
import mir = "../../mir.jiang";

@life(return: output)
public mir.MirCoroutineStateDispatch build(
    mir.MirStore& output,
    mir.MirCoroutineSuspendPoint[]& suspend_points
) {
    list.ArrayList<mir.MirCoroutineResumeCase> cases! =
        list.ArrayList<mir.MirCoroutineResumeCase>(suspend_points.length);
    Int index! = 0;
    while (index < suspend_points.length) {
        mir.MirCoroutineSuspendPoint point = suspend_points[index];
        cases.add(mir.MirCoroutineResumeCase (
            state_id: point.state_id,
            target: point.resume_target
        ));
        index = index + 1;
    }
    return mir.MirCoroutineStateDispatch (
        entry_state_id: 0,
        completed_state_id: suspend_points.length + 1,
        resume_cases: output.coroutine_resume_case_array(cases$.ref())
    );
}
