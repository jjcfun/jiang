import context = "../context.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import drop_semantics = "../sema/drop.jiang";
import types = "../sema/type.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";

struct DropFlagMap {
    public Int![*] flag_indexes;
    public Int! length;
    public Int! flag_count;

    public init(Int length) {
        self.length = length;
        self.flag_count = 0;
        self.flag_indexes = Int!$.alloc_array(length);
        Int! index = 0;
        while (index < length) {
            self.flag_indexes[index] = -1;
            index = index + 1;
        }
    }

    public Bool has_flag(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        return index >= 0 && index < self.length && self.flag_indexes[index] >= 0;
    }

    public mir.MirLocalId flag_for(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        assert(index >= 0 && index < self.length);
        assert(self.flag_indexes[index] >= 0);
        return mir.MirLocalId(self.flag_indexes[index]);
    }

    public () add_flag_for(mir.MirLocalId local_id, Int flag_index) {
        Int index = local_id.to_index();
        if (index < 0 || index >= self.length) {
            return;
        }
        self.flag_indexes[index] = flag_index;
        self.flag_count = self.flag_count + 1;
    }
}

struct DropExpansion {
    public mir.MirBlockId target;
    public Bool expanded;

    public init(mir.MirBlockId target, Bool expanded) {
        self.target = target;
        self.expanded = expanded;
    }
}

public mir.MirStore^ elaborate_package(
    context.CompilerContext& ctx,
    mir.MirStore^ input,
    layout.LayoutStore& layouts
) {
    mir.MirStore^ output = new mir.MirStore(input.ok && !layouts.has_errors());
    if (input.has_errors() || layouts.has_errors()) {
        return output$.move();
    }

    Int! function_index = 0;
    while (function_index < input.functions.len()) {
        mir.MirFunction function = input.functions.get(function_index);
        output.add_function(elaborate_function(ctx, output$.ref(), function));
        function_index = function_index + 1;
    }
    return output$.move();
}

mir.MirFunction elaborate_function(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirFunction function
) {
    mir.MirBody! body = function.body;
    if (body.locals.length == 0 || body.blocks.length == 0) {
        return copy_function(output, function, body.blocks);
    }

    DropFlagMap flags = build_drop_flags(ctx, body);
    // cleanup 临时位既用于自定义 deinit 的 unit 结果，也用于 owner pointer 的 free statement。
    Bool needs_cleanup_result = flags.flag_count > 0;
    mir.MirLocalId? deinit_result = deinit_result_local_id(body, flags, needs_cleanup_result);
    mir.MirLocalDecl[] locals = copy_locals_with_drop_flags(ctx, output, body.locals, flags, needs_cleanup_result);
    body = body_with_locals(body, locals);

    Int original_block_count = body.blocks.length;
    list.ArrayList<mir.MirBlock>! blocks = copy_blocks(body.blocks);
    instrument_drop_flag_blocks(ctx, output, body, flags, original_block_count, blocks$.ref());
    elaborate_storage_dead_blocks(
        ctx,
        output,
        body,
        flags,
        deinit_result,
        original_block_count,
        blocks$.ref()
    );

    mir.MirBody storage_body = body_with_blocks(output, body, blocks$.ref());
    Int return_block_count = blocks.len();
    elaborate_return_blocks(
        ctx,
        output,
        storage_body,
        flags,
        deinit_result,
        return_block_count,
        blocks$.ref()
    );

    return copy_function_with_body(output, function, body_with_blocks(output, body, blocks$.ref()));
}

mir.MirBody body_with_locals(mir.MirBody body, mir.MirLocalDecl[] locals) {
    return mir.MirBody {
        id: body.id,
        span: body.span,
        locals: locals,
        blocks: body.blocks,
        entry: body.entry,
        return_local: body.return_local
    };
}

mir.MirBody body_with_blocks(mir.MirStore& output, mir.MirBody body, list.ArrayList<mir.MirBlock>& blocks) {
    return mir.MirBody {
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: output.block_array(blocks),
        entry: body.entry,
        return_local: body.return_local
    };
}

list.ArrayList<mir.MirBlock> copy_blocks(mir.MirBlock[] source_blocks) {
    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>(source_blocks.length);
    Int! block_index = 0;
    while (block_index < source_blocks.length) {
        blocks.add(source_blocks[block_index]);
        block_index = block_index + 1;
    }
    return blocks$.move();
}

DropFlagMap build_drop_flags(context.CompilerContext& ctx, mir.MirBody body) {
    DropFlagMap! flags = DropFlagMap(body.locals.length);
    Int! next_flag = body.locals.length;
    Int! local_index = 0;
    while (local_index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[local_index];
        if (local_has_drop_flag(ctx, local, body.return_local)) {
            flags.add_flag_for(local.id, next_flag);
            next_flag = next_flag + 1;
        }
        local_index = local_index + 1;
    }
    return flags;
}

mir.MirLocalId? deinit_result_local_id(mir.MirBody body, DropFlagMap flags, Bool needs_deinit_result) {
    if (!needs_deinit_result) {
        return null;
    }
    return mir.MirLocalId.from_index(body.locals.length + flags.flag_count);
}

Bool local_has_drop_flag(context.CompilerContext& ctx, mir.MirLocalDecl local, mir.MirLocalId return_local) {
    if (local.id.to_index() == return_local.to_index()) {
        return false;
    }
    if (local_is_init_self(ctx, local)) {
        return false;
    }
    if (local.kind == .compiler_temp) {
        return false;
    }
    drop_semantics.DropQuery query = drop_semantics.DropQuery(ctx);
    return query.type_needs_runtime_drop(local.type_id);
}

Bool local_is_init_self(context.CompilerContext& ctx, mir.MirLocalDecl local) {
    guard local.def_id is some local_def else { return false; }
    guard local.name is some symbol else { return false; }
    if (!string.equal(ctx.query.symbols.text(symbol), "self")) {
        return false;
    }
    guard ctx.query.defs.get(local_def).owner_def is some owner_def else { return false; }
    return ctx.query.defs.get(owner_def).kind == .init_def;
}

mir.MirLocalDecl[] copy_locals_with_drop_flags(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalDecl[] locals,
    DropFlagMap flags,
    Bool needs_cleanup_result
) {
    Int! extra_cleanup_result = 0;
    if (needs_cleanup_result) {
        extra_cleanup_result = 1;
    }
    mir.MirLocalDecl![*] copied = output.alloc_local_array(locals.length + flags.flag_count + extra_cleanup_result);
    Int! index = 0;
    while (index < locals.length) {
        copied[index] = locals[index];
        index = index + 1;
    }
    Int! local_index = 0;
    while (local_index < locals.length) {
        mir.MirLocalDecl local = locals[local_index];
        if (flags.has_flag(local.id)) {
            mir.MirLocalId flag = flags.flag_for(local.id);
            copied[flag.to_index()] = drop_flag_local(ctx, flag, local.span);
        }
        local_index = local_index + 1;
    }
    Int total = locals.length + flags.flag_count + extra_cleanup_result;
    if (needs_cleanup_result) {
        mir.MirLocalId id = mir.MirLocalId.from_index(total - 1);
        copied[id.to_index()] = deinit_result_local(ctx, id, token.Span());
    }
    return copied[0..total];
}

mir.MirLocalDecl drop_flag_local(context.CompilerContext& ctx, mir.MirLocalId flag, token.Span span) {
    return mir.MirLocalDecl {
        id: flag,
        kind: mir.MirLocalKind.compiler_temp,
        type_id: ctx.query.types.bool_type(),
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    };
}

mir.MirLocalDecl deinit_result_local(context.CompilerContext& ctx, mir.MirLocalId id, token.Span span) {
    return mir.MirLocalDecl {
        id: id,
        kind: mir.MirLocalKind.compiler_temp,
        type_id: ctx.query.types.unit_type(),
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    };
}

() instrument_drop_flag_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        Bool is_entry = block_index == body.entry.to_index();
        mir.MirBlock instrumented = instrument_drop_flag_block(
            ctx,
            output,
            body,
            flags,
            blocks.get(block_index),
            is_entry,
            blocks
        );
        blocks.set(block_index, instrumented);
        block_index = block_index + 1;
    }
}

mir.MirBlock instrument_drop_flag_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirBlock block,
    Bool is_entry,
    list.ArrayList<mir.MirBlock>& blocks
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    if (is_entry) {
        push_initial_drop_flags(ctx, output, body, flags, statements$.ref());
    }
    Int! index = 0;
    while (index < block.statements.length) {
        instrument_drop_flag_statement(ctx, output, flags, block.statements[index], statements$.ref());
        index = index + 1;
    }
    mir.MirTerminator terminator = instrument_drop_flag_terminator(
        ctx,
        output,
        flags,
        block.terminator,
        statements$.ref(),
        blocks
    );
    return replace_block(output, block, statements$.ref(), terminator);
}

() push_initial_drop_flags(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    list.ArrayList<mir.MirStatement>& statements
) {
    Int! index = 0;
    while (index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[index];
        if (flags.has_flag(local.id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(local.id), false, local.span, statements);
            if (local.kind == .param && !is_self_param(ctx, local)) {
                push_set_drop_flag(ctx, output, flags.flag_for(local.id), true, local.span, statements);
            }
        }
        index = index + 1;
    }
}

() instrument_drop_flag_statement(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirStatement statement,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (statement.kind is .storage_live_stmt(storage_live)) {
        statements.add(statement);
        if (flags.has_flag(storage_live.local_id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(storage_live.local_id), false, statement.span, statements);
        }
        return;
    }
    if (statement.kind is .assign_stmt(assign_stmt)) {
        push_move_flag_clears(ctx, output, flags, assign_stmt.value, statement.span, statements);
        statements.add(statement);
        if (assign_stmt.destination.projection.length == 0 && flags.has_flag(assign_stmt.destination.local_id)) {
            mir.MirLocalId flag = flags.flag_for(assign_stmt.destination.local_id);
            push_set_drop_flag(ctx, output, flag, true, statement.span, statements);
        }
        return;
    }
    statements.add(statement);
}

mir.MirTerminator instrument_drop_flag_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirTerminator terminator,
    list.ArrayList<mir.MirStatement>& statements,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard terminator.kind is .call_term(call_term) else {
        return terminator;
    }
    push_call_callee_move_flag_clear(ctx, output, flags, call_term.callee, terminator.span, statements);
    push_operand_array_move_flag_clears(ctx, output, flags, call_term.args, terminator.span, statements);
    if (!call_destination_needs_flag(call_term.destination, flags)) {
        return terminator;
    }
    mir.MirLocalId flag = flags.flag_for(call_term.destination.local_id);
    mir.MirBlockId target = append_call_destination_flag_block(ctx, output, flag, terminator, call_term.target, blocks);
    return call_terminator_with_target(terminator, call_term, target);
}

() push_call_callee_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirCallCallee callee,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (callee is .indirect_operand(operand)) {
        push_operand_move_flag_clear(ctx, output, flags, operand, span, statements);
    }
}

Bool call_destination_needs_flag(mir.MirPlace destination, DropFlagMap flags) {
    if (destination.projection.length != 0) {
        return false;
    }
    return flags.has_flag(destination.local_id);
}

mir.MirBlockId append_call_destination_flag_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId flag,
    mir.MirTerminator source,
    mir.MirBlockId original_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    push_set_drop_flag(ctx, output, flag, true, source.span, statements$.ref());
    blocks.add(mir.MirBlock {
        id: id,
        span: source.span,
        statements: output.statement_array(statements$.ref()),
        terminator: mir.MirTerminator {
            span: source.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator {target: original_target})
        }
    });
    return id;
}

mir.MirTerminator call_terminator_with_target(
    mir.MirTerminator source,
    mir.MirCallTerminator call_term,
    mir.MirBlockId target
) {
    return mir.MirTerminator {
        span: source.span,
        kind: mir.call_terminator_kind(mir.MirCallTerminator {
            callee: call_term.callee,
            args: call_term.args,
            destination: call_term.destination,
            target: target,
            initialized_place: call_term.initialized_place,
            cleanup: call_term.cleanup
        })
    };
}

() elaborate_storage_dead_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        elaborate_storage_dead_block(
            ctx,
            output,
            body,
            flags,
            deinit_result,
            blocks.get(block_index),
            blocks
        );
        block_index = block_index + 1;
    }
}

() elaborate_storage_dead_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    mir.MirBlock block,
    list.ArrayList<mir.MirBlock>& blocks
) {
    list.ArrayList<mir.MirStatement>! kept = list.ArrayList<mir.MirStatement>(block.statements.length);
    Int! statement_index = 0;
    while (statement_index < block.statements.length) {
        mir.MirStatement statement = block.statements[statement_index];
        if (storage_dead_needs_drop(ctx, body, flags, statement) is some local) {
            split_storage_dead_block(
                ctx,
                output,
                body,
                flags,
                deinit_result,
                block,
                kept$.ref(),
                statement_index,
                local,
                blocks
            );
            return;
        }
        kept.add(statement);
        statement_index = statement_index + 1;
    }
    blocks.set(block.id.to_index(), replace_block_statements(output, block, kept$.ref()));
}

mir.MirLocalDecl? storage_dead_needs_drop(
    context.CompilerContext& ctx,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirStatement statement
) {
    guard statement.kind is .storage_dead_stmt(storage_dead) else {
        return null;
    }
    mir.MirLocalDecl local = body.locals[storage_dead.local_id.to_index()];
    if (!flags.has_flag(local.id)) {
        return null;
    }
    return local;
}

() split_storage_dead_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    mir.MirBlock block,
    list.ArrayList<mir.MirStatement>& kept,
    Int statement_index,
    mir.MirLocalDecl local,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId continuation = append_storage_dead_continuation(
        output,
        block,
        statement_index,
        blocks
    );
    mir.MirBlockId drop_target = append_local_drop_block(
        ctx,
        output,
        flags,
        deinit_result,
        block,
        local,
        continuation,
        blocks
    );
    blocks.set(
        block.id.to_index(),
        branch_on_drop_flag(ctx, output, flags, block, kept, local, drop_target, continuation)
    );

    mir.MirBlock next_block = blocks.get(continuation.to_index());
    elaborate_storage_dead_block(ctx, output, body, flags, deinit_result, next_block, blocks);
}

mir.MirBlockId append_storage_dead_continuation(
    mir.MirStore& output,
    mir.MirBlock block,
    Int statement_index,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId continuation = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! rest = list.ArrayList<mir.MirStatement>();
    Int! index = statement_index + 1;
    while (index < block.statements.length) {
        rest.add(block.statements[index]);
        index = index + 1;
    }
    blocks.add(mir.MirBlock {
        id: continuation,
        span: block.span,
        statements: output.statement_array(rest$.ref()),
        terminator: block.terminator
    });
    return continuation;
}

mir.MirBlockId append_local_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirLocalDecl local,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId drop_id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, drop_id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    push_set_drop_flag(ctx, output, flags.flag_for(local.id), false, source_block.terminator.span, statements$.ref());
    blocks.set(drop_id.to_index(), drop_block(
        ctx,
        output,
        deinit_result,
        drop_id,
        source_block,
        local_place(output, local.id),
        local.type_id,
        statements$.ref(),
        next_target,
        blocks
    ));
    return drop_id;
}

() elaborate_return_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        elaborate_return_block(ctx, output, body, flags, deinit_result, blocks.get(block_index), blocks);
        block_index = block_index + 1;
    }
}

() elaborate_return_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    mir.MirBlock block,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard block.terminator.kind is .return_term(return_term) else {
        return;
    }

    mir.MirBlockId final_return = mir.MirBlockId.from_index(blocks.len());
    blocks.add(return_block(output, final_return, block, return_term));

    mir.MirBlockId target = append_drop_chain(ctx, output, body, flags, deinit_result, block, final_return, blocks);
    blocks.set(block.id.to_index(), goto_block(output, block, target));
}

mir.MirBlockId append_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirLocalId? deinit_result,
    mir.MirBlock block,
    mir.MirBlockId final_return,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId! target = final_return;
    Int! local_index = body.locals.length - 1;
    while (local_index >= 0) {
        mir.MirLocalDecl local = body.locals[local_index];
        local_index = local_index - 1;
        if (!return_fallback_needs_drop(ctx, local, flags)) {
            continue;
        }
        mir.MirBlockId drop_target = append_local_drop_block(
            ctx,
            output,
            flags,
            deinit_result,
            block,
            local,
            target,
            blocks
        );
        target = append_drop_flag_branch(ctx, output, flags, block, local, drop_target, target, blocks);
    }
    return target;
}

Bool return_fallback_needs_drop(context.CompilerContext& ctx, mir.MirLocalDecl local, DropFlagMap flags) {
    if (!flags.has_flag(local.id)) {
        return false;
    }
    // block/local scope 的 cleanup 已由 lowering 在各个离开路径插入 StorageDead。
    // return chain 只兜底函数入口即 live 的 local，目前就是 by-value param。
    return local.kind == .param && !is_self_param(ctx, local);
}

Bool is_self_param(context.CompilerContext& ctx, mir.MirLocalDecl local) {
    guard local.name is some name else {
        return false;
    }
    return name.to_index() == ctx.query.symbols.intern("self").to_index();
}

mir.MirBlock return_block(
    mir.MirStore& output,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirReturnTerminator return_term
) {
    return mir.MirBlock {
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator {
            span: source_block.terminator.span,
            kind: mir.return_terminator_kind(return_term)
        }
    };
}

mir.MirBlock placeholder_block(
    mir.MirStore& output,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirBlockId target
) {
    return mir.MirBlock {
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator {
            span: source_block.terminator.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator {target: target})
        }
    };
}

mir.MirBlock drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    DropExpansion expansion = append_drop_expansion_chain(
        ctx,
        output,
        deinit_result,
        source_block,
        place,
        type_id,
        next_target,
        blocks
    );
    return mir.MirBlock {
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements),
        terminator: drop_terminator(ctx, output, source_block, place, type_id, deinit_result, expansion)
    };
}

mir.MirTerminator drop_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirLocalId? deinit_result,
    DropExpansion expansion
) {
    if (custom_deinit_def_for_type(ctx, type_id) is some deinit_def) {
        if (deinit_result is some destination) {
            return custom_deinit_terminator(
                ctx,
                output,
                source_block,
                place,
                deinit_def,
                custom_deinit_type_args(ctx, output, type_id),
                destination,
                expansion.target
            );
        }
    }
    if (expansion.expanded) {
        return goto_terminator(source_block, expansion.target);
    }
    return mir.MirTerminator {
        span: source_block.terminator.span,
        kind: mir.drop_terminator_kind(mir.MirDropTerminator {
            place: place,
            target: expansion.target,
            cleanup: null
        })
    };
}

DropExpansion append_drop_expansion_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    if (info.data is .optional(optional_type)) {
        return append_optional_payload_drop_chain(
            ctx,
            output,
            deinit_result,
            source_block,
            place,
            optional_type,
            next_target,
            blocks
        );
    }
    if (info.data is .error_union(error_union_type)) {
        return append_error_union_payload_drop_chain(
            ctx,
            output,
            deinit_result,
            source_block,
            place,
            error_union_type,
            next_target,
            blocks
        );
    }
    if (info.data is .handle_type(handle_type)) {
        if (handle_type.kind == .owner_pointer) {
            return append_owner_pointer_drop_chain(
                ctx,
                output,
                deinit_result,
                source_block,
                place,
                handle_type.element,
                next_target,
                blocks
            );
        }
        return DropExpansion(next_target, false);
    }
    return append_owned_field_drop_chain(ctx, output, deinit_result, source_block, place, type_id, next_target, blocks);
}

DropExpansion append_owner_pointer_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId element_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard deinit_result is some cleanup_result else {
        return DropExpansion(next_target, false);
    }
    mir.MirBlockId free_target = append_owner_pointer_free_block(
        output,
        cleanup_result,
        source_block,
        place,
        next_target,
        blocks
    );
    if (!type_needs_drop(ctx, element_type)) {
        return DropExpansion(free_target, true);
    }

    mir.MirPlace pointee = deref_place(output, place);
    mir.MirBlockId pointee_drop = append_place_drop_block(
        ctx,
        output,
        deinit_result,
        source_block,
        pointee,
        element_type,
        free_target,
        blocks
    );
    return DropExpansion(pointee_drop, true);
}

mir.MirBlockId append_owner_pointer_free_block(
    mir.MirStore& output,
    mir.MirLocalId cleanup_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement {
        span: source_block.terminator.span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement {
            destination: local_place(output, cleanup_result),
            value: mir.free_rvalue(mir.MirFreeRvalue {pointer: copy_operand_for_place(place)})
        })
    });
    blocks.add(mir.MirBlock {
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(source_block, next_target)
    });
    return id;
}

DropExpansion append_optional_payload_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    types.OptionalType optional_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    if (!type_needs_drop(ctx, optional_type.element)) {
        return DropExpansion(next_target, false);
    }

    mir.MirBlockId payload_drop = append_layout_field_drop_block(
        ctx,
        output,
        deinit_result,
        source_block,
        place,
        1,
        optional_type.element,
        next_target,
        blocks
    );
    mir.MirBlockId branch = append_layout_tag_branch(output, source_block, place, payload_drop, next_target, blocks);
    return DropExpansion(branch, true);
}

DropExpansion append_error_union_payload_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    types.ErrorUnionType error_union_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Bool value_needs_drop = type_needs_drop(ctx, error_union_type.value);
    Bool error_needs_drop = type_needs_drop(ctx, error_union_type.error);
    if (!value_needs_drop && !error_needs_drop) {
        return DropExpansion(next_target, false);
    }

    mir.MirBlockId! value_target = next_target;
    mir.MirBlockId! error_target = next_target;
    if (value_needs_drop) {
        value_target = append_layout_field_drop_block(
            ctx,
            output,
            deinit_result,
            source_block,
            place,
            1,
            error_union_type.value,
            next_target,
            blocks
        );
    }
    if (error_needs_drop) {
        error_target = append_layout_field_drop_block(
            ctx,
            output,
            deinit_result,
            source_block,
            place,
            2,
            error_union_type.error,
            next_target,
            blocks
        );
    }
    mir.MirBlockId branch = append_layout_tag_branch(output, source_block, place, error_target, value_target, blocks);
    return DropExpansion(branch, true);
}

DropExpansion append_owned_field_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    if (!type_has_drop_expandable_fields(ctx, type_id)) {
        return DropExpansion(next_target, false);
    }
    layout.TypeLayout type_layout = layout_for_type(ctx, type_id);
    mir.MirBlockId! target = next_target;
    Bool! expanded = false;
    Int! field_index = type_layout.fields.length - 1;
    while (field_index >= 0) {
        layout.FieldLayout field = type_layout.fields[field_index];
        if (field_needs_drop(ctx, field)) {
            target = append_field_drop_block(
                ctx,
                output,
                deinit_result,
                source_block,
                place,
                field,
                field_index,
                target,
                blocks
            );
            expanded = true;
        }
        field_index = field_index - 1;
    }
    return DropExpansion(target, expanded);
}

Bool type_has_drop_expandable_fields(context.CompilerContext& ctx, qid.TypeId type_id) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    guard info.data is .named(named) else {
        return false;
    }
    def.DefKind kind = ctx.query.defs.get(named.def_id).kind;
    return kind == .struct_def || kind == .record_def;
}

layout.TypeLayout layout_for_type(context.CompilerContext& ctx, qid.TypeId type_id) {
    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx, type_id);
    return ctx.query.layouts.layout(layout_id);
}

Bool field_needs_drop(context.CompilerContext& ctx, layout.FieldLayout field) {
    if (field.field_def == null) {
        return false;
    }
    return type_needs_drop(ctx, field.field_type);
}

Bool type_needs_drop(context.CompilerContext& ctx, qid.TypeId type_id) {
    drop_semantics.DropQuery query = drop_semantics.DropQuery(ctx);
    return query.type_needs_runtime_drop(type_id);
}

mir.MirBlockId append_field_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    layout.FieldLayout field,
    Int field_index,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    return append_place_drop_block(
        ctx,
        output,
        deinit_result,
        source_block,
        field_place(output, owner_place, field, field_index),
        field.field_type,
        next_target,
        blocks
    );
}

mir.MirBlockId append_place_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    blocks.set(id.to_index(), drop_block(
        ctx,
        output,
        deinit_result,
        id,
        source_block,
        place,
        type_id,
        statements$.ref(),
        next_target,
        blocks
    ));
    return id;
}

mir.MirBlockId append_layout_field_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId? deinit_result,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    Int field_index,
    qid.TypeId field_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    mir.MirPlace field_place_value = field_index_place(output, owner_place, field_index);
    mir.MirBlock generated = drop_block(
        ctx,
        output,
        deinit_result,
        id,
        source_block,
        field_place_value,
        field_type,
        statements$.ref(),
        next_target,
        blocks
    );
    blocks.set(id.to_index(), generated);
    return id;
}

mir.MirBlockId append_layout_tag_branch(
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    mir.MirBlockId true_target,
    mir.MirBlockId false_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    mir.MirPlace tag_place = field_index_place(output, owner_place, 0);
    mir.MirOperand condition = copy_operand_for_place(tag_place);
    blocks.add(mir.MirBlock {
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator {
            span: source_block.terminator.span,
            kind: mir.branch_terminator_kind(mir.MirBranchTerminator {
                condition: condition,
                then_target: true_target,
                else_target: false_target
            })
        }
    });
    return id;
}

mir.MirPlace field_place(mir.MirStore& output, mir.MirPlace owner_place, layout.FieldLayout field, Int field_index) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.field_projection_elem(mir.MirFieldProjection {
        field_def: field.field_def$.some(),
        field_type: field.field_type,
        field_index: field_index
    }));
    return mir.MirPlace {
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    };
}

mir.MirPlace field_index_place(mir.MirStore& output, mir.MirPlace owner_place, Int field_index) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    mir.MirConstantIndexProjection field_projection = mir.MirConstantIndexProjection {offset: field_index};
    projection.add(mir.constant_index_projection_elem(field_projection));
    return mir.MirPlace {
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    };
}

mir.MirPlace deref_place(mir.MirStore& output, mir.MirPlace owner_place) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.deref_projection_elem(mir.MirDerefProjection {raw_pointer: false}));
    return mir.MirPlace {
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    };
}

mir.MirPlace local_place(mir.MirStore& output, mir.MirLocalId local_id) {
    return mir.MirPlace {
        local_id: local_id,
        projection: output.empty_projection()
    };
}

mir.MirTerminator goto_terminator(mir.MirBlock source_block, mir.MirBlockId target) {
    return mir.MirTerminator {
        span: source_block.terminator.span,
        kind: mir.goto_terminator_kind(mir.MirGotoTerminator {target: target})
    };
}

mir.MirTerminator custom_deinit_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.DefId deinit_def,
    qid.TypeId[] type_args,
    mir.MirLocalId destination,
    mir.MirBlockId next_target
) {
    list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>();
    args.add(mir.move_operand_value(mir.MirMoveOperand {place: place}));
    return mir.MirTerminator {
        span: source_block.terminator.span,
        kind: mir.call_terminator_kind(mir.MirCallTerminator {
            callee: mir.direct_function_callee(mir.MirFunctionRef {
                function_def: deinit_def,
                type_args: output.type_arg_array(type_args),
                type_id: deinit_function_type(ctx, deinit_def),
                span: source_block.terminator.span,
            }),
            args: output.operand_array(args$.ref()),
            destination: mir.MirPlace {
                local_id: destination,
                projection: output.empty_projection()
            },
            target: next_target,
            initialized_place: null,
            cleanup: null
        })
    };
}

qid.TypeId[] custom_deinit_type_args(context.CompilerContext& ctx, mir.MirStore& output, qid.TypeId type_id) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    if (info.data is .named(named)) {
        return named.args;
    }
    return output.empty_type_args();
}

qid.TypeId deinit_function_type(context.CompilerContext& ctx, qid.DefId deinit_def) {
    if (ctx.query.typeck.def_type(deinit_def) is some type_id) {
        return type_id;
    }
    return ctx.query.types.invalid_type();
}

qid.DefId? custom_deinit_def_for_type(context.CompilerContext& ctx, qid.TypeId type_id) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    guard info.data is .named(named) else {
        return null;
    }
    guard ctx.query.hirs.def(named.def_id) is some hir_def else {
        return null;
    }
    return hir_def.custom_deinit_def;
}

mir.MirBlockId append_drop_flag_branch(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirBlock source_block,
    mir.MirLocalDecl local,
    mir.MirBlockId drop_target,
    mir.MirBlockId skip_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    blocks.add(branch_on_drop_flag(
        ctx,
        output,
        flags,
        block_with_id(source_block, id),
        statements$.ref(),
        local,
        drop_target,
        skip_target
    ));
    return id;
}

mir.MirBlock branch_on_drop_flag(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirLocalDecl local,
    mir.MirBlockId drop_target,
    mir.MirBlockId skip_target
) {
    return mir.MirBlock {
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: mir.MirTerminator {
            span: source_block.terminator.span,
            kind: mir.branch_terminator_kind(mir.MirBranchTerminator {
                condition: drop_flag_operand(output, flags.flag_for(local.id)),
                then_target: drop_target,
                else_target: skip_target
            })
        }
    };
}

mir.MirBlock block_with_id(mir.MirBlock block, mir.MirBlockId id) {
    return mir.MirBlock {
        id: id,
        span: block.span,
        statements: block.statements,
        terminator: block.terminator
    };
}

mir.MirBlock goto_block(mir.MirStore& output, mir.MirBlock source_block, mir.MirBlockId target) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    Int! index = 0;
    while (index < source_block.statements.length) {
        statements.add(source_block.statements[index]);
        index = index + 1;
    }
    return goto_block_with_statements(output, source_block, statements$.ref(), target);
}

mir.MirBlock goto_block_with_statements(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirBlockId target
) {
    return mir.MirBlock {
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: mir.MirTerminator {
            span: source_block.terminator.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator {target: target})
        }
    };
}

mir.MirBlock replace_block_statements(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements
) {
    return replace_block(output, source_block, statements, source_block.terminator);
}

mir.MirBlock replace_block(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirTerminator terminator
) {
    return mir.MirBlock {
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: terminator
    };
}

() push_move_flag_clears(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirRvalue value,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (value is .use_value(use_value)) {
        push_operand_move_flag_clear(ctx, output, flags, use_value.value, span, statements);
    }
    if (value is .unary_value(unary_value)) {
        push_operand_move_flag_clear(ctx, output, flags, unary_value.value, span, statements);
    }
    if (value is .binary_value(binary_value)) {
        push_operand_move_flag_clear(ctx, output, flags, binary_value.lhs, span, statements);
        push_operand_move_flag_clear(ctx, output, flags, binary_value.rhs, span, statements);
    }
    if (value is .cast_value(cast_value)) {
        push_operand_move_flag_clear(ctx, output, flags, cast_value.value, span, statements);
    }
    if (value is .alloc_value(alloc_value)) {
        push_operand_move_flag_clear(ctx, output, flags, alloc_value.value, span, statements);
    }
    if (value is .slice_value(slice_value)) {
        push_optional_operand_move_flag_clear(ctx, output, flags, slice_value.start, span, statements);
        push_optional_operand_move_flag_clear(ctx, output, flags, slice_value.end, span, statements);
    }
    if (value is .aggregate_value(aggregate_value)) {
        push_operand_array_move_flag_clears(ctx, output, flags, aggregate_value.fields, span, statements);
    }
    if (value is .optional_value(optional_value)) {
        push_operand_move_flag_clear(ctx, output, flags, optional_value.value, span, statements);
    }
    if (value is .error_union_value(error_union_value)) {
        push_operand_move_flag_clear(ctx, output, flags, error_union_value.value, span, statements);
    }
}

() push_optional_operand_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand? operand,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (operand is some value) {
        push_operand_move_flag_clear(ctx, output, flags, value, span, statements);
    }
}

() push_operand_array_move_flag_clears(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand[] operands,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    Int! index = 0;
    while (index < operands.length) {
        push_operand_move_flag_clear(ctx, output, flags, operands[index], span, statements);
        index = index + 1;
    }
}

() push_operand_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand operand,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (operand is .move_operand(move_operand)) {
        if (move_operand.place.projection.length == 0 && flags.has_flag(move_operand.place.local_id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(move_operand.place.local_id), false, span, statements);
        }
    }
}

() push_set_drop_flag(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId flag,
    Bool value,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    statements.add(mir.MirStatement {
        span: span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement {
            destination: flag_place(output, flag),
            value: mir.use_rvalue(mir.MirUseRvalue {value: bool_operand(ctx, value, span)})
        })
    });
}

mir.MirOperand bool_operand(context.CompilerContext& ctx, Bool value, token.Span span) {
    return mir.const_operand_value(mir.MirConst {
        type_id: ctx.query.types.bool_type(),
        span: span,
        value: mir.bool_const_kind(mir.MirBoolConst {value: value})
    });
}

mir.MirOperand drop_flag_operand(mir.MirStore& output, mir.MirLocalId flag) {
    return mir.copy_operand_value(mir.MirCopyOperand {place: flag_place(output, flag)});
}

mir.MirOperand copy_operand_for_place(mir.MirPlace place) {
    return mir.copy_operand_value(mir.MirCopyOperand {place: place});
}

mir.MirPlace flag_place(mir.MirStore& output, mir.MirLocalId flag) {
    return mir.MirPlace {
        local_id: flag,
        projection: output.empty_projection()
    };
}

mir.MirFunction copy_function(mir.MirStore& output, mir.MirFunction function, mir.MirBlock[] blocks) {
    mir.MirBody! body = function.body;
    body = body_with_block_array(output, body, blocks);
    return copy_function_with_body(output, function, body);
}

mir.MirBody body_with_block_array(mir.MirStore& output, mir.MirBody body, mir.MirBlock[] blocks) {
    return mir.MirBody {
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: blocks,
        entry: body.entry,
        return_local: body.return_local
    };
}

mir.MirFunction copy_function_with_body(mir.MirStore& output, mir.MirFunction function, mir.MirBody body) {
    return mir.MirFunction {
        id: function.id,
        def_id: function.def_id,
        type_args: output.type_arg_array(function.type_args),
        signature_id: function.signature_id,
        is_runtime_entry: function.is_runtime_entry,
        is_external: function.is_external,
        span: function.span,
        body: mir.MirBody {
            id: body.id,
            span: body.span,
            locals: copy_locals(output, body.locals),
            blocks: body.blocks,
            entry: body.entry,
            return_local: body.return_local
        }
    };
}

mir.MirLocalDecl[] copy_locals(mir.MirStore& output, mir.MirLocalDecl[] locals) {
    mir.MirLocalDecl![*] copied = output.alloc_local_array(locals.length);
    Int! index = 0;
    while (index < locals.length) {
        copied[index] = locals[index];
        index = index + 1;
    }
    return copied[0..locals.length];
}
