import context = "../context.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import qid = "../store/id.jiang";
import def = "../resolve/def.jiang";
import contiguous = "../sema/contiguous.jiang";
import drop_semantics = "../sema/drop.jiang";
import types = "../sema/type.jiang";
import token = "../syntax/token.jiang";
import mir = "./mir.jiang";

struct DropFlagMap {
    public Int![*] flag_indexes;
    public Int! length;
    public Int! flag_count;

    public init(Int length) {
        self.length = length;
        self.flag_count = 0;
        self.flag_indexes = Int!$.alloc_many(length);
        Int! index = 0;
        while (index < length) {
            self.flag_indexes[index] = -1;
            index = index + 1;
        }
    }

    public Bool has_flag(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        return index >= 0 && index < self.length && self.flag_indexes[index] >= 0;
    }

    public mir.MirLocalId flag_for(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        assert(index >= 0 && index < self.length);
        assert(self.flag_indexes[index] >= 0);
        return mir.MirLocalId(self.flag_indexes[index]);
    }

    public () add_flag_for(mir.MirLocalId local_id, Int flag_index) {
        Int index = local_id.to_index();
        if (index < 0 || index >= self.length) {
            return;
        }
        self.flag_indexes[index] = flag_index;
        self.flag_count = self.flag_count + 1;
    }
}

struct DropExpansion {
    public mir.MirBlockId target;
    public Bool expanded;

    public init(mir.MirBlockId target, Bool expanded) {
        self.target = target;
        self.expanded = expanded;
    }
}

struct DropTemps {
    public mir.MirLocalId? cleanup_result;
    public mir.MirLocalId? slice_drop_index;
    public mir.MirLocalId? slice_drop_condition;
}

public mir.MirStore^ elaborate_package(
    context.CompilerContext& ctx,
    mir.MirStore^ input,
    layout.LayoutStore& layouts
) {
    mir.MirStore^ output = new mir.MirStore(input.ok && !layouts.has_errors());
    if (input.has_errors() || layouts.has_errors()) {
        return output$.move();
    }

    Int! function_index = 0;
    while (function_index < input.functions.len()) {
        mir.MirFunction function = input.functions.get(function_index);
        mir.MirFunction elaborated = elaborate_function(ctx, output$.ref(), function);
        output.add_function(elaborated);
        function_index = function_index + 1;
    }
    return output$.move();
}

mir.MirFunction elaborate_function(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirFunction function
) {
    mir.MirBody! body = function.body;
    if (body.locals.length == 0 || body.blocks.length == 0) {
        return copy_function(output, function, body.blocks);
    }

    DropFlagMap flags = build_drop_flags(ctx, body);
    // cleanup 临时位既用于自定义 deinit 的 unit 结果，也用于 owner pointer 的 free statement。
    Bool needs_cleanup_result = flags.flag_count > 0;
    Bool needs_slice_drop_temps = body_needs_contiguous_drop_temps(ctx, body);
    DropTemps temps = drop_temps(body, flags, needs_cleanup_result, needs_slice_drop_temps);
    mir.MirLocalDecl[]& locals = copy_locals_with_drop_flags(
        ctx,
        output,
        body.locals,
        flags,
        needs_cleanup_result,
        needs_slice_drop_temps
    );
    body = body_with_locals(body, locals);

    Int original_block_count = body.blocks.length;
    list.ArrayList<mir.MirBlock>! blocks = copy_blocks(output, body.blocks);
    instrument_drop_flag_blocks(ctx, output, body, flags, original_block_count, blocks$.ref());
    elaborate_storage_dead_blocks(
        ctx,
        output,
        body,
        flags,
        temps,
        original_block_count,
        blocks$.ref()
    );

    mir.MirBody storage_body = body_with_blocks(output, body, blocks$.ref());
    Int return_block_count = blocks.len();
    elaborate_return_blocks(
        ctx,
        output,
        storage_body,
        flags,
        temps,
        return_block_count,
        blocks$.ref()
    );

    return copy_function_with_body(output, function, body_with_blocks(output, body, blocks$.ref()));
}

mir.MirBody body_with_locals(mir.MirBody body, mir.MirLocalDecl[]& locals) {
    return mir.MirBody (
        id: body.id,
        span: body.span,
        locals: locals,
        blocks: body.blocks,
        entry: body.entry,
        return_local: body.return_local
    );
}

mir.MirBody body_with_blocks(mir.MirStore& output, mir.MirBody body, list.ArrayList<mir.MirBlock>& blocks) {
    return mir.MirBody (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: output.block_array(blocks),
        entry: body.entry,
        return_local: body.return_local
    );
}

list.ArrayList<mir.MirBlock> copy_blocks(mir.MirStore& output, mir.MirBlock[]& source_blocks) {
    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>(source_blocks.length);
    Int! block_index = 0;
    while (block_index < source_blocks.length) {
        blocks.add(copy_block(output, source_blocks[block_index]$.ref()));
        block_index = block_index + 1;
    }
    return blocks$.move();
}

mir.MirBlock copy_block(mir.MirStore& output, mir.MirBlock& block) {
    return mir.MirBlock (
        id: block.id,
        span: block.span,
        statements: copy_statements(output, block.statements),
        terminator: copy_terminator(output, block.terminator$.ref())
    );
}

mir.MirStatement[]& copy_statements(mir.MirStore& output, mir.MirStatement[]& statements) {
    list.ArrayList<mir.MirStatement>! copied = list.ArrayList<mir.MirStatement>(statements.length);
    Int! index = 0;
    while (index < statements.length) {
        copied.add(copy_statement(output, statements[index]$.ref()));
        index = index + 1;
    }
    return output.statement_array(copied$.ref());
}

mir.MirStatement copy_statement(mir.MirStore& output, mir.MirStatement& statement) {
    return mir.MirStatement (
        span: statement.span,
        kind: copy_statement_kind(output, statement.kind$.ref())
    );
}

mir.MirStatementKind copy_statement_kind(mir.MirStore& output, mir.MirStatementKind& kind) {
    if (kind is .assign_stmt(assign_stmt)) {
        return mir.assign_statement_kind(mir.MirAssignStatement (
            destination: copy_place(output, assign_stmt.destination),
            value: copy_rvalue(output, assign_stmt.value$.ref())
        ));
    }
    if (kind is .set_discriminant_stmt(set_discriminant)) {
        return mir.set_discriminant_statement_kind(mir.MirSetDiscriminantStatement (
            destination: copy_place(output, set_discriminant.destination),
            discriminant: set_discriminant.discriminant
        ));
    }
    if (kind is .forget_stmt(forget_stmt)) {
        return mir.forget_statement_kind(mir.MirForgetStatement (place: copy_place(output, forget_stmt.place)));
    }
    if (kind is .storage_live_stmt(storage_live)) {
        return mir.storage_live_statement_kind(storage_live);
    }
    guard kind is .storage_dead_stmt(storage_dead) else { return mir.storage_dead_statement_kind(mir.MirStorageDeadStatement (local_id: mir.MirLocalId(0))); }
    return mir.storage_dead_statement_kind(storage_dead);
}

mir.MirTerminator copy_terminator(mir.MirStore& output, mir.MirTerminator& terminator) {
    return mir.MirTerminator (
        span: terminator.span,
        kind: copy_terminator_kind(output, terminator.kind$.ref())
    );
}

mir.MirTerminatorKind copy_terminator_kind(mir.MirStore& output, mir.MirTerminatorKind& kind) {
    if (kind is .call_term(call_term)) {
        return mir.call_terminator_kind(mir.MirCallTerminator (
            callee: copy_callee(output, call_term.callee$.ref()),
            args: copy_operands(output, call_term.args),
            destination: copy_place(output, call_term.destination),
            target: call_term.target,
            initialized_place: copy_optional_place(output, call_term.initialized_place),
            cleanup: call_term.cleanup
        ));
    }
    if (kind is .branch_term(branch_term)) {
        return mir.branch_terminator_kind(mir.MirBranchTerminator (
            condition: copy_operand(output, branch_term.condition$.ref()),
            then_target: branch_term.then_target,
            else_target: branch_term.else_target
        ));
    }
    if (kind is .switch_term(switch_term)) {
        return mir.switch_terminator_kind(mir.MirSwitchTerminator (
            discriminator: copy_operand(output, switch_term.discriminator$.ref()),
            cases: output.switch_case_slice(switch_term.cases),
            default_target: switch_term.default_target
        ));
    }
    if (kind is .drop_term(drop_term)) {
        return mir.drop_terminator_kind(mir.MirDropTerminator (
            place: copy_place(output, drop_term.place),
            target: drop_term.target,
            cleanup: drop_term.cleanup
        ));
    }
    if (kind is .assert_term(assert_term)) {
        return mir.assert_terminator_kind(mir.MirAssertTerminator (
            condition: copy_operand(output, assert_term.condition$.ref()),
            expected: assert_term.expected,
            message: assert_term.message,
            target: assert_term.target,
            cleanup: assert_term.cleanup
        ));
    }
    if (kind is .throw_term(throw_term)) {
        return .throw_term(mir.MirThrowTerminator (error_value: copy_operand(output, throw_term.error_value$.ref())));
    }
    if (kind is .goto_term(goto_term)) { return mir.goto_terminator_kind(goto_term); }
    if (kind is .return_term(return_term)) { return mir.return_terminator_kind(return_term); }
    guard kind is .unreachable_term(unreachable_term) else {
        return mir.unreachable_terminator_kind(mir.MirUnreachableTerminator (generated_by_check: false));
    }
    return mir.unreachable_terminator_kind(unreachable_term);
}

mir.MirCallCallee copy_callee(mir.MirStore& output, mir.MirCallCallee& callee) {
    if (callee is .indirect_operand(operand)) {
        return mir.indirect_operand_callee(copy_operand(output, operand$.ref()));
    }
    guard callee is .direct_function(function_ref) else {
        return mir.direct_function_callee(mir.MirFunctionRef (
            function_def: qid.DefId(0),
            type_args: output.empty_type_args(),
            const_args: output.empty_const_args(),
            type_id: qid.TypeId(0),
            span: token.Span(0, 0)
        ));
    }
    return mir.direct_function_callee(mir.MirFunctionRef (
        function_def: function_ref.function_def,
        type_args: output.type_arg_array(function_ref.type_args),
        const_args: output.const_arg_array(function_ref.const_args),
        type_id: function_ref.type_id,
        span: function_ref.span
    ));
}

mir.MirRvalue copy_rvalue(mir.MirStore& output, mir.MirRvalue& value) {
    if (value is .use_value(use_value)) {
        return mir.use_rvalue(mir.MirUseRvalue (value: copy_operand(output, use_value.value$.ref())));
    }
    if (value is .unary_value(unary_value)) {
        return mir.unary_rvalue(mir.MirUnaryRvalue (op: unary_value.op, value: copy_operand(output, unary_value.value$.ref())));
    }
    if (value is .binary_value(binary_value)) {
        return mir.binary_rvalue(mir.MirBinaryRvalue (
            op: binary_value.op,
            lhs: copy_operand(output, binary_value.lhs$.ref()),
            rhs: copy_operand(output, binary_value.rhs$.ref())
        ));
    }
    if (value is .cast_value(cast_value)) {
        return mir.cast_rvalue(mir.MirCastRvalue (
            kind: cast_value.kind,
            value: copy_operand(output, cast_value.value$.ref()),
            target_type: cast_value.target_type
        ));
    }
    if (value is .borrow_value(borrow_value)) {
        return mir.borrow_rvalue(mir.MirBorrowRvalue (place: copy_place(output, borrow_value.place)));
    }
    if (value is .address_of_value(address_of)) {
        return mir.address_of_rvalue(mir.MirAddressOfRvalue (
            mutable_pointer: address_of.mutable_pointer,
            place: copy_place(output, address_of.place)
        ));
    }
    if (value is .alloc_value(alloc_value)) {
        return mir.alloc_rvalue(mir.MirAllocValueRvalue (
            value_type: alloc_value.value_type,
            value: copy_operand(output, alloc_value.value$.ref())
        ));
    }
    if (value is .alloc_array_value(alloc_array)) {
        return mir.alloc_array_rvalue(mir.MirAllocArrayRvalue (
            element_type: alloc_array.element_type,
            count: copy_operand(output, alloc_array.count$.ref())
        ));
    }
    if (value is .free_value(free_value)) {
        return mir.free_rvalue(mir.MirFreeRvalue (pointer: copy_operand(output, free_value.pointer$.ref())));
    }
    if (value is .slice_value(slice_value)) {
        return mir.slice_rvalue(mir.MirSliceRvalue (
            base: copy_place(output, slice_value.base),
            start: copy_optional_operand(output, slice_value.start),
            end: copy_optional_operand(output, slice_value.end)
        ));
    }
    if (value is .len_value(len_value)) {
        return mir.len_rvalue(mir.MirLenRvalue (place: copy_place(output, len_value.place)));
    }
    if (value is .discriminant_value(discriminant_value)) {
        return mir.discriminant_rvalue(mir.MirDiscriminantRvalue (place: copy_place(output, discriminant_value.place)));
    }
    if (value is .aggregate_value(aggregate)) {
        return mir.aggregate_rvalue(mir.MirAggregateRvalue (
            kind: aggregate.kind,
            def_id: aggregate.def_id,
            type_id: aggregate.type_id,
            tag: copy_optional_operand(output, aggregate.tag),
            payload_field_index: aggregate.payload_field_index,
            fields: copy_operands(output, aggregate.fields)
        ));
    }
    if (value is .optional_value(optional_value)) {
        return mir.optional_rvalue(mir.MirOptionalRvalue (
            op: optional_value.op,
            value: copy_operand(output, optional_value.value$.ref())
        ));
    }
    if (value is .error_union_value(error_union)) {
        return mir.error_union_rvalue(mir.MirErrorUnionRvalue (
            op: error_union.op,
            value: copy_operand(output, error_union.value$.ref())
        ));
    }
    guard value is .alloc_box_value(alloc_box) else {
        return mir.alloc_box_rvalue(mir.MirAllocBoxRvalue (value_type: qid.TypeId(0)));
    }
    return mir.alloc_box_rvalue(alloc_box);
}

mir.MirOperand[]& copy_operands(mir.MirStore& output, mir.MirOperand[]& operands) {
    list.ArrayList<mir.MirOperand>! copied = list.ArrayList<mir.MirOperand>(operands.length);
    Int! index = 0;
    while (index < operands.length) {
        copied.add(copy_operand(output, operands[index]$.ref()));
        index = index + 1;
    }
    return output.operand_array(copied$.ref());
}

mir.MirOperand? copy_optional_operand(mir.MirStore& output, mir.MirOperand? operand) {
    if (operand is .some(value)) {
        mir.MirOperand copied = copy_operand(output, value$.ref());
        return copied;
    }
    return null;
}

mir.MirOperand copy_operand(mir.MirStore& output, mir.MirOperand& operand) {
    if (operand is .copy_operand(copy_operand)) {
        return mir.copy_operand_value(mir.MirCopyOperand (place: copy_place(output, copy_operand.place)));
    }
    if (operand is .move_operand(move_operand)) {
        return mir.move_operand_value(mir.MirMoveOperand (place: copy_place(output, move_operand.place)));
    }
    if (operand is .out_operand(out_operand)) {
        return mir.out_operand_value(mir.MirOutOperand (place: copy_place(output, out_operand.place)));
    }
    if (operand is .function_operand(function_ref)) {
        return mir.function_operand_value(mir.MirFunctionRef (
            function_def: function_ref.function_def,
            type_args: output.type_arg_array(function_ref.type_args),
            const_args: output.const_arg_array(function_ref.const_args),
            type_id: function_ref.type_id,
            span: function_ref.span
        ));
    }
    if (operand is .global_operand(global_ref)) {
        return mir.global_operand_value(global_ref);
    }
    guard operand is .const_operand(const_value) else {
        return mir.const_operand_value(mir.MirConst (
            type_id: qid.TypeId(0),
            span: token.Span(),
            value: mir.unit_const_kind(mir.MirUnitConst (unit_value: true))
        ));
    }
    return mir.const_operand_value(const_value);
}

mir.MirPlace? copy_optional_place(mir.MirStore& output, mir.MirPlace? place) {
    if (place is .some(value)) {
        mir.MirPlace copied = copy_place(output, value);
        return copied;
    }
    return null;
}

mir.MirPlace copy_place(mir.MirStore& output, mir.MirPlace place) {
    return mir.MirPlace (
        local_id: place.local_id,
        projection: output.projection_slice(place.projection)
    );
}

DropFlagMap build_drop_flags(context.CompilerContext& ctx, mir.MirBody body) {
    DropFlagMap! flags = DropFlagMap(body.locals.length);
    Int! next_flag = body.locals.length;
    Int! local_index = 0;
    while (local_index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[local_index];
        if (local_has_drop_flag(ctx, local, body.return_local)) {
            flags.add_flag_for(local.id, next_flag);
            next_flag = next_flag + 1;
        }
        local_index = local_index + 1;
    }
    return flags;
}

DropTemps drop_temps(
    mir.MirBody body,
    DropFlagMap flags,
    Bool needs_cleanup_result,
    Bool needs_slice_drop_temps
) {
    Int! next_index = body.locals.length + flags.flag_count;
    mir.MirLocalId?! cleanup_result = null;
    mir.MirLocalId?! slice_drop_index = null;
    mir.MirLocalId?! slice_drop_condition = null;
    if (needs_cleanup_result) {
        cleanup_result = mir.MirLocalId.from_index(next_index);
        next_index = next_index + 1;
    }
    if (needs_slice_drop_temps) {
        slice_drop_index = mir.MirLocalId.from_index(next_index);
        next_index = next_index + 1;
        slice_drop_condition = mir.MirLocalId.from_index(next_index);
    }
    return DropTemps (
        cleanup_result: cleanup_result,
        slice_drop_index: slice_drop_index,
        slice_drop_condition: slice_drop_condition
    );
}

Bool local_has_drop_flag(context.CompilerContext& ctx, mir.MirLocalDecl local, mir.MirLocalId return_local) {
    if (local.id.to_index() == return_local.to_index()) {
        return false;
    }
    if (local_is_init_self(ctx, local)) {
        return false;
    }
    if (local.kind == .compiler_temp) {
        return false;
    }
    drop_semantics.DropQuery query = drop_semantics.DropQuery(ctx);
    return query.type_needs_runtime_drop(local.type_id);
}

Bool local_is_init_self(context.CompilerContext& ctx, mir.MirLocalDecl local) {
    guard local.def_id is .some(local_def) else { return false; }
    guard local.name is .some(symbol) else { return false; }
    if (!string.equal(ctx.store.symbols.text(symbol), "self")) {
        return false;
    }
    guard ctx.store.defs.get(local_def).owner_def is .some(owner_def) else { return false; }
    return ctx.store.defs.get(owner_def).kind == .init_def;
}

mir.MirLocalDecl[]& copy_locals_with_drop_flags(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalDecl[]& locals,
    DropFlagMap flags,
    Bool needs_cleanup_result,
    Bool needs_slice_drop_temps
) {
    Int! extra_cleanup_result = 0;
    if (needs_cleanup_result) {
        extra_cleanup_result = 1;
    }
    Int! extra_slice_drop_temps = 0;
    if (needs_slice_drop_temps) {
        extra_slice_drop_temps = 2;
    }
    mir.MirLocalDecl![*] copied = output.alloc_local_array(
        locals.length + flags.flag_count + extra_cleanup_result + extra_slice_drop_temps
    );
    Int! index = 0;
    while (index < locals.length) {
        copied[index] = locals[index];
        index = index + 1;
    }
    Int! local_index = 0;
    while (local_index < locals.length) {
        mir.MirLocalDecl local = locals[local_index];
        if (flags.has_flag(local.id)) {
            mir.MirLocalId flag = flags.flag_for(local.id);
            copied[flag.to_index()] = drop_flag_local(ctx, flag, local.span);
        }
        local_index = local_index + 1;
    }
    Int total = locals.length + flags.flag_count + extra_cleanup_result + extra_slice_drop_temps;
    Int! temp_index = locals.length + flags.flag_count;
    if (needs_cleanup_result) {
        mir.MirLocalId id = mir.MirLocalId.from_index(temp_index);
        copied[id.to_index()] = deinit_result_local(ctx, id, token.Span());
        temp_index = temp_index + 1;
    }
    if (needs_slice_drop_temps) {
        mir.MirLocalId index_id = mir.MirLocalId.from_index(temp_index);
        copied[index_id.to_index()] = slice_drop_index_local(ctx, index_id, token.Span());
        temp_index = temp_index + 1;
        mir.MirLocalId condition_id = mir.MirLocalId.from_index(temp_index);
        copied[condition_id.to_index()] = drop_flag_local(ctx, condition_id, token.Span());
    }
    return copied[0..total];
}

mir.MirLocalDecl drop_flag_local(context.CompilerContext& ctx, mir.MirLocalId flag, token.Span span) {
    return mir.MirLocalDecl (
        id: flag,
        kind: mir.MirLocalKind.compiler_temp,
        type_id: ctx.store.types.bool_type(),
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

mir.MirLocalDecl slice_drop_index_local(context.CompilerContext& ctx, mir.MirLocalId id, token.Span span) {
    return mir.MirLocalDecl (
        id: id,
        kind: mir.MirLocalKind.compiler_temp,
        type_id: ctx.store.types.uint_type(),
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

mir.MirLocalDecl deinit_result_local(context.CompilerContext& ctx, mir.MirLocalId id, token.Span span) {
    return mir.MirLocalDecl (
        id: id,
        kind: mir.MirLocalKind.compiler_temp,
        type_id: ctx.store.types.unit_type(),
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

Bool body_needs_contiguous_drop_temps(context.CompilerContext& ctx, mir.MirBody body) {
    Int! index = 0;
    while (index < body.locals.length) {
        if (type_needs_contiguous_drop_loop(ctx, body.locals[index].type_id)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool type_needs_contiguous_drop_loop(context.CompilerContext& ctx, qid.TypeId type_id) {
    contiguous.ContiguousQuery query = contiguous.ContiguousQuery(ctx.store$.ref());
    if (query.info_for_type(type_id) is .some(info)) {
        if (info.static_count is .some(count)) {
            return count > 0 && type_needs_drop(ctx, info.element);
        }
        if (info.owned_storage) {
            return type_needs_drop(ctx, info.element);
        }
    }
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .optional(optional_type)) {
        return type_needs_contiguous_drop_loop(ctx, optional_type.element);
    }
    if (info.data is .error_union(error_union_type)) {
        return type_needs_contiguous_drop_loop(ctx, error_union_type.value)
            || type_needs_contiguous_drop_loop(ctx, error_union_type.error);
    }
    if (info.data is .array_type(array_type)) {
        return type_needs_contiguous_drop_loop(ctx, array_type.element);
    }
    if (info.data is .tuple_type(tuple_type)) {
        Int! index = 0;
        while (index < tuple_type.items.length) {
            if (type_needs_contiguous_drop_loop(ctx, tuple_type.items[index])) {
                return true;
            }
            index = index + 1;
        }
    }
    if (info.data is .named(named)) {
        if (ctx.store.defs.get(named.def_id).kind != .struct_def) {
            return false;
        }
        layout.TypeLayout type_layout = layout_for_type(ctx, type_id);
        Int! index = 0;
        while (index < type_layout.fields.length) {
            if (type_needs_contiguous_drop_loop(ctx, type_layout.fields[index].field_type)) {
                return true;
            }
            index = index + 1;
        }
    }
    return false;
}

() instrument_drop_flag_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        Bool is_entry = block_index == body.entry.to_index();
        mir.MirBlock instrumented = instrument_drop_flag_block(
            ctx,
            output,
            body,
            flags,
            blocks.get(block_index),
            is_entry,
            blocks
        );
        blocks.set(block_index, instrumented);
        block_index = block_index + 1;
    }
}

mir.MirBlock instrument_drop_flag_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirBlock block,
    Bool is_entry,
    list.ArrayList<mir.MirBlock>& blocks
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    if (is_entry) {
        push_initial_drop_flags(ctx, output, body, flags, statements$.ref());
    }
    Int! index = 0;
    while (index < block.statements.length) {
        instrument_drop_flag_statement(ctx, output, flags, block.statements[index], statements$.ref());
        index = index + 1;
    }
    mir.MirTerminator terminator = instrument_drop_flag_terminator(
        ctx,
        output,
        flags,
        block.terminator,
        statements$.ref(),
        blocks
    );
    return replace_block(output, block, statements$.ref(), terminator);
}

() push_initial_drop_flags(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    list.ArrayList<mir.MirStatement>& statements
) {
    Int! index = 0;
    while (index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[index];
        if (flags.has_flag(local.id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(local.id), false, local.span, statements);
            if (local.kind == .param && !is_self_param(ctx, local)) {
                push_set_drop_flag(ctx, output, flags.flag_for(local.id), true, local.span, statements);
            }
        }
        index = index + 1;
    }
}

() instrument_drop_flag_statement(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirStatement statement,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (statement.kind is .storage_live_stmt(storage_live)) {
        statements.add(statement);
        if (flags.has_flag(storage_live.local_id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(storage_live.local_id), false, statement.span, statements);
        }
        return;
    }
    if (statement.kind is .assign_stmt(assign_stmt)) {
        push_move_flag_clears(ctx, output, flags, assign_stmt.value, statement.span, statements);
        statements.add(statement);
        if (assign_stmt.destination.projection.length == 0 && flags.has_flag(assign_stmt.destination.local_id)) {
            mir.MirLocalId flag = flags.flag_for(assign_stmt.destination.local_id);
            push_set_drop_flag(ctx, output, flag, true, statement.span, statements);
        }
        return;
    }
    if (statement.kind is .forget_stmt(forget_stmt)) {
        push_forget_flag_clear(ctx, output, flags, forget_stmt.place, statement.span, statements);
        statements.add(statement);
        return;
    }
    statements.add(statement);
}

mir.MirTerminator instrument_drop_flag_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirTerminator terminator,
    list.ArrayList<mir.MirStatement>& statements,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard terminator.kind is .call_term(call_term) else {
        return terminator;
    }
    push_call_callee_move_flag_clear(ctx, output, flags, call_term.callee, terminator.span, statements);
    push_operand_array_move_flag_clears(ctx, output, flags, call_term.args, terminator.span, statements);
    if (!call_destination_needs_flag(call_term.destination, flags)) {
        return terminator;
    }
    mir.MirLocalId flag = flags.flag_for(call_term.destination.local_id);
    mir.MirBlockId target = append_call_destination_flag_block(ctx, output, flag, terminator, call_term.target, blocks);
    return call_terminator_with_target(terminator, call_term, target);
}

() push_call_callee_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirCallCallee callee,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (callee is .indirect_operand(operand)) {
        push_operand_move_flag_clear(ctx, output, flags, operand, span, statements);
    }
}

Bool call_destination_needs_flag(mir.MirPlace destination, DropFlagMap flags) {
    if (destination.projection.length != 0) {
        return false;
    }
    return flags.has_flag(destination.local_id);
}

mir.MirBlockId append_call_destination_flag_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId flag,
    mir.MirTerminator source,
    mir.MirBlockId original_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    push_set_drop_flag(ctx, output, flag, true, source.span, statements$.ref());
    blocks.add(mir.MirBlock (
        id: id,
        span: source.span,
        statements: output.statement_array(statements$.ref()),
        terminator: mir.MirTerminator (
            span: source.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator (target: original_target))
        )
    ));
    return id;
}

mir.MirTerminator call_terminator_with_target(
    mir.MirTerminator source,
    mir.MirCallTerminator call_term,
    mir.MirBlockId target
) {
    return mir.MirTerminator (
        span: source.span,
        kind: mir.call_terminator_kind(mir.MirCallTerminator (
            callee: call_term.callee,
            args: call_term.args,
            destination: call_term.destination,
            target: target,
            initialized_place: call_term.initialized_place,
            cleanup: call_term.cleanup
        ))
    );
}

() elaborate_storage_dead_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        elaborate_storage_dead_block(
            ctx,
            output,
            body,
            flags,
            temps,
            blocks.get(block_index),
            blocks
        );
        block_index = block_index + 1;
    }
}

() elaborate_storage_dead_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    mir.MirBlock block,
    list.ArrayList<mir.MirBlock>& blocks
) {
    list.ArrayList<mir.MirStatement>! kept = list.ArrayList<mir.MirStatement>(block.statements.length);
    Int! statement_index = 0;
    while (statement_index < block.statements.length) {
        mir.MirStatement statement = block.statements[statement_index];
        if (storage_dead_needs_drop(ctx, body, flags, statement) is .some(local)) {
            split_storage_dead_block(
                ctx,
                output,
                body,
                flags,
                temps,
                block,
                kept$.ref(),
                statement_index,
                local,
                blocks
            );
            return;
        }
        kept.add(statement);
        statement_index = statement_index + 1;
    }
    blocks.set(block.id.to_index(), replace_block_statements(output, block, kept$.ref()));
}

mir.MirLocalDecl? storage_dead_needs_drop(
    context.CompilerContext& ctx,
    mir.MirBody body,
    DropFlagMap flags,
    mir.MirStatement statement
) {
    guard statement.kind is .storage_dead_stmt(storage_dead) else {
        return null;
    }
    mir.MirLocalDecl local = body.locals[storage_dead.local_id.to_index()];
    if (!flags.has_flag(local.id)) {
        return null;
    }
    return local;
}

() split_storage_dead_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    mir.MirBlock block,
    list.ArrayList<mir.MirStatement>& kept,
    Int statement_index,
    mir.MirLocalDecl local,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId continuation = append_storage_dead_continuation(
        output,
        block,
        statement_index,
        blocks
    );
    mir.MirBlockId drop_target = append_local_drop_block(
        ctx,
        output,
        flags,
        temps,
        block,
        local,
        continuation,
        blocks
    );
    blocks.set(
        block.id.to_index(),
        branch_on_drop_flag(ctx, output, flags, block, kept, local, drop_target, continuation)
    );

    mir.MirBlock next_block = blocks.get(continuation.to_index());
    elaborate_storage_dead_block(ctx, output, body, flags, temps, next_block, blocks);
}

mir.MirBlockId append_storage_dead_continuation(
    mir.MirStore& output,
    mir.MirBlock block,
    Int statement_index,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId continuation = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! rest = list.ArrayList<mir.MirStatement>();
    Int! index = statement_index + 1;
    while (index < block.statements.length) {
        rest.add(block.statements[index]);
        index = index + 1;
    }
    blocks.add(mir.MirBlock (
        id: continuation,
        span: block.span,
        statements: output.statement_array(rest$.ref()),
        terminator: block.terminator
    ));
    return continuation;
}

mir.MirBlockId append_local_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirLocalDecl local,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId drop_id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, drop_id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    push_set_drop_flag(ctx, output, flags.flag_for(local.id), false, source_block.terminator.span, statements$.ref());
    blocks.set(drop_id.to_index(), drop_block(
        ctx,
        output,
        temps,
        drop_id,
        source_block,
        local_place(output, local.id),
        local.type_id,
        statements$.ref(),
        next_target,
        blocks
    ));
    return drop_id;
}

() elaborate_return_blocks(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    Int original_block_count,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Int! block_index = 0;
    while (block_index < original_block_count) {
        elaborate_return_block(ctx, output, body, flags, temps, blocks.get(block_index), blocks);
        block_index = block_index + 1;
    }
}

() elaborate_return_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    mir.MirBlock block,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard block.terminator.kind is .return_term(return_term) else {
        return;
    }

    mir.MirBlockId final_return = mir.MirBlockId.from_index(blocks.len());
    blocks.add(return_block(output, final_return, block, return_term));

    mir.MirBlockId target = append_drop_chain(ctx, output, body, flags, temps, block, final_return, blocks);
    blocks.set(block.id.to_index(), goto_block(output, block, target));
}

mir.MirBlockId append_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBody body,
    DropFlagMap flags,
    DropTemps temps,
    mir.MirBlock block,
    mir.MirBlockId final_return,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId! target = final_return;
    Int! local_index = body.locals.length - 1;
    while (local_index >= 0) {
        mir.MirLocalDecl local = body.locals[local_index];
        local_index = local_index - 1;
        if (!return_fallback_needs_drop(ctx, local, flags)) {
            continue;
        }
        mir.MirBlockId drop_target = append_local_drop_block(
            ctx,
            output,
            flags,
            temps,
            block,
            local,
            target,
            blocks
        );
        target = append_drop_flag_branch(ctx, output, flags, block, local, drop_target, target, blocks);
    }
    return target;
}

Bool return_fallback_needs_drop(context.CompilerContext& ctx, mir.MirLocalDecl local, DropFlagMap flags) {
    if (!flags.has_flag(local.id)) {
        return false;
    }
    // block/local scope 的 cleanup 已由 lowering 在各个离开路径插入 StorageDead。
    // return chain 只兜底函数入口即 live 的 local，目前就是 by-value param。
    return local.kind == .param && !is_self_param(ctx, local);
}

Bool is_self_param(context.CompilerContext& ctx, mir.MirLocalDecl local) {
    guard local.name is .some(name) else {
        return false;
    }
    return name.to_index() == ctx.store.symbols.intern("self").to_index();
}

mir.MirBlock return_block(
    mir.MirStore& output,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirReturnTerminator return_term
) {
    return mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.return_terminator_kind(return_term)
        )
    );
}

mir.MirBlock placeholder_block(
    mir.MirStore& output,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirBlockId target
) {
    return mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator (target: target))
        )
    );
}

mir.MirBlock drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    DropExpansion expansion = append_drop_expansion_chain(
        ctx,
        output,
        temps,
        source_block,
        place,
        type_id,
        next_target,
        blocks
    );
    return mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements),
        terminator: drop_terminator(ctx, output, source_block, place, type_id, temps.cleanup_result, expansion)
    );
}

mir.MirTerminator drop_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirLocalId? deinit_result,
    DropExpansion expansion
) {
    if (custom_deinit_def_for_type(ctx, type_id) is .some(deinit_def)) {
        if (deinit_result is .some(destination)) {
            return custom_deinit_terminator(
                ctx,
                output,
                source_block,
                place,
                deinit_def,
                custom_deinit_type_args(ctx, output, type_id),
                destination,
                expansion.target
            );
        }
    }
    if (expansion.expanded) {
        return goto_terminator(source_block, expansion.target);
    }
    return mir.MirTerminator (
        span: source_block.terminator.span,
        kind: mir.drop_terminator_kind(mir.MirDropTerminator (
            place: place,
            target: expansion.target,
            cleanup: null
        ))
    );
}

DropExpansion append_drop_expansion_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .optional(optional_type)) {
        return append_optional_payload_drop_chain(
            ctx,
            output,
            temps,
            source_block,
            place,
            optional_type,
            next_target,
            blocks
        );
    }
    if (info.data is .error_union(error_union_type)) {
        return append_error_union_payload_drop_chain(
            ctx,
            output,
            temps,
            source_block,
            place,
            error_union_type,
            next_target,
            blocks
        );
    }
    if (info.data is .array_type(array_type)) {
        if (array_type.count == 0 || !type_needs_drop(ctx, array_type.element)) {
            return DropExpansion(next_target, false);
        }
        return append_contiguous_element_drop_chain(
            ctx,
            output,
            temps,
            source_block,
            place,
            array_type.element,
            uint_operand(ctx, array_type.count, source_block.terminator.span),
            next_target,
            blocks
        );
    }
    if (info.data is .handle_type(handle_type)) {
        if (handle_type.kind == .owner_pointer) {
            return append_owner_pointer_drop_chain(
                ctx,
                output,
                temps,
                source_block,
                place,
                handle_type,
                next_target,
                blocks
            );
        }
        return DropExpansion(next_target, false);
    }
    return append_owned_field_drop_chain(ctx, output, temps, source_block, place, type_id, next_target, blocks);
}

DropExpansion append_owner_pointer_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    types.HandleType handle_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard temps.cleanup_result is .some(cleanup_result) else {
        return DropExpansion(next_target, false);
    }
    mir.MirBlockId free_target = append_owner_pointer_free_block(
        output,
        cleanup_result,
        source_block,
        place,
        next_target,
        blocks
    );
    contiguous.ContiguousQuery query = contiguous.ContiguousQuery(ctx.store$.ref());
    if (query.owned_storage_info_for_handle(handle_type) is .some(storage)) {
        if (!type_needs_drop(ctx, storage.element)) {
            return DropExpansion(free_target, true);
        }
        return append_contiguous_element_drop_chain(
            ctx,
            output,
            temps,
            source_block,
            place,
            storage.element,
            copy_operand_for_place(field_index_place(output, place, 1)),
            free_target,
            blocks
        );
    }
    qid.TypeId element_type = handle_type.element;
    if (!type_needs_drop(ctx, element_type)) {
        return DropExpansion(free_target, true);
    }

    mir.MirPlace pointee = deref_place(output, place);
    mir.MirBlockId pointee_drop = append_place_drop_block(
        ctx,
        output,
        temps,
        source_block,
        pointee,
        element_type,
        free_target,
        blocks
    );
    return DropExpansion(pointee_drop, true);
}

mir.MirBlockId append_owner_pointer_free_block(
    mir.MirStore& output,
    mir.MirLocalId cleanup_result,
    mir.MirBlock source_block,
    mir.MirPlace place,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: source_block.terminator.span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: local_place(output, cleanup_result),
            value: mir.free_rvalue(mir.MirFreeRvalue (pointer: copy_operand_for_place(place)))
        ))
    ));
    blocks.add(mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(source_block, next_target)
    ));
    return id;
}

DropExpansion append_contiguous_element_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId element_type,
    mir.MirOperand count,
    mir.MirBlockId done_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    guard temps.slice_drop_index is .some(index_local) else { return DropExpansion(done_target, true); }
    guard temps.slice_drop_condition is .some(condition_local) else { return DropExpansion(done_target, true); }
    mir.MirBlockId condition_id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, condition_id, source_block, done_target));

    mir.MirPlace element_place = indexed_place(output, place, index_local);
    mir.MirBlockId element_drop = append_place_drop_block(
        ctx,
        output,
        temps,
        source_block,
        element_place,
        element_type,
        condition_id,
        blocks
    );
    mir.MirBlockId decrement = append_contiguous_drop_decrement_block(
        ctx,
        output,
        source_block,
        index_local,
        element_drop,
        blocks
    );
    mir.MirBlockId init_block = append_contiguous_drop_init_block(
        output,
        source_block,
        index_local,
        count,
        condition_id,
        blocks
    );
    blocks.set(condition_id.to_index(), contiguous_drop_condition_block(
        ctx,
        output,
        condition_id,
        source_block,
        index_local,
        condition_local,
        decrement,
        done_target
    ));
    return DropExpansion(init_block, true);
}

mir.MirBlockId append_contiguous_drop_init_block(
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirLocalId index_local,
    mir.MirOperand count,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: source_block.terminator.span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: local_place(output, index_local),
            value: mir.use_rvalue(mir.MirUseRvalue (value: count))
        ))
    ));
    blocks.add(mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(source_block, next_target)
    ));
    return id;
}

mir.MirBlockId append_contiguous_drop_decrement_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirLocalId index_local,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: source_block.terminator.span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: local_place(output, index_local),
            value: mir.binary_rvalue(mir.MirBinaryRvalue (
                op: .sub,
                lhs: copy_operand_for_place(local_place(output, index_local)),
                rhs: uint_operand(ctx, 1, source_block.terminator.span)
            ))
        ))
    ));
    blocks.add(mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(source_block, next_target)
    ));
    return id;
}

mir.MirBlock contiguous_drop_condition_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlockId id,
    mir.MirBlock source_block,
    mir.MirLocalId index_local,
    mir.MirLocalId condition_local,
    mir.MirBlockId drop_target,
    mir.MirBlockId done_target
) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: source_block.terminator.span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: local_place(output, condition_local),
            value: mir.binary_rvalue(mir.MirBinaryRvalue (
                op: .ne,
                lhs: copy_operand_for_place(local_place(output, index_local)),
                rhs: uint_operand(ctx, 0, source_block.terminator.span)
            ))
        ))
    ));
    return mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.statement_array(statements$.ref()),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.branch_terminator_kind(mir.MirBranchTerminator (
                condition: copy_operand_for_place(local_place(output, condition_local)),
                then_target: drop_target,
                else_target: done_target
            ))
        )
    );
}

DropExpansion append_optional_payload_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    types.OptionalType optional_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    if (!type_needs_drop(ctx, optional_type.element)) {
        return DropExpansion(next_target, false);
    }

    mir.MirBlockId payload_drop = append_layout_field_drop_block(
        ctx,
        output,
        temps,
        source_block,
        place,
        1,
        optional_type.element,
        next_target,
        blocks
    );
    mir.MirBlockId branch = append_layout_tag_branch(output, source_block, place, payload_drop, next_target, blocks);
    return DropExpansion(branch, true);
}

DropExpansion append_error_union_payload_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    types.ErrorUnionType error_union_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    Bool value_needs_drop = type_needs_drop(ctx, error_union_type.value);
    Bool error_needs_drop = type_needs_drop(ctx, error_union_type.error);
    if (!value_needs_drop && !error_needs_drop) {
        return DropExpansion(next_target, false);
    }

    mir.MirBlockId! value_target = next_target;
    mir.MirBlockId! error_target = next_target;
    if (value_needs_drop) {
        value_target = append_layout_field_drop_block(
            ctx,
            output,
            temps,
            source_block,
            place,
            1,
            error_union_type.value,
            next_target,
            blocks
        );
    }
    if (error_needs_drop) {
        error_target = append_layout_field_drop_block(
            ctx,
            output,
            temps,
            source_block,
            place,
            2,
            error_union_type.error,
            next_target,
            blocks
        );
    }
    mir.MirBlockId branch = append_layout_tag_branch(output, source_block, place, error_target, value_target, blocks);
    return DropExpansion(branch, true);
}

DropExpansion append_owned_field_drop_chain(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    if (!type_has_drop_expandable_fields(ctx, type_id)) {
        return DropExpansion(next_target, false);
    }
    layout.TypeLayout type_layout = layout_for_type(ctx, type_id);
    mir.MirBlockId! target = next_target;
    Bool! expanded = false;
    Int! field_index = type_layout.fields.length - 1;
    while (field_index >= 0) {
        layout.FieldLayout field = type_layout.fields[field_index];
        if (field_needs_drop(ctx, field)) {
            target = append_field_drop_block(
                ctx,
                output,
                temps,
                source_block,
                place,
                field,
                field_index,
                target,
                blocks
            );
            expanded = true;
        }
        field_index = field_index - 1;
    }
    return DropExpansion(target, expanded);
}

Bool type_has_drop_expandable_fields(context.CompilerContext& ctx, qid.TypeId type_id) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    guard info.data is .named(named) else {
        return false;
    }
    def.DefKind kind = ctx.store.defs.get(named.def_id).kind;
    return kind == .struct_def;
}

layout.TypeLayout layout_for_type(context.CompilerContext& ctx, qid.TypeId type_id) {
    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx, type_id);
    return ctx.store.layouts.layout(layout_id);
}

Bool field_needs_drop(context.CompilerContext& ctx, layout.FieldLayout field) {
    if (field.field_def == null) {
        return false;
    }
    return type_needs_drop(ctx, field.field_type);
}

Bool type_needs_drop(context.CompilerContext& ctx, qid.TypeId type_id) {
    drop_semantics.DropQuery query = drop_semantics.DropQuery(ctx);
    return query.type_needs_runtime_drop(type_id);
}

mir.MirBlockId append_field_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    layout.FieldLayout field,
    Int field_index,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    return append_place_drop_block(
        ctx,
        output,
        temps,
        source_block,
        field_place(output, owner_place, field, field_index),
        field.field_type,
        next_target,
        blocks
    );
}

mir.MirBlockId append_place_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.TypeId type_id,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    blocks.set(id.to_index(), drop_block(
        ctx,
        output,
        temps,
        id,
        source_block,
        place,
        type_id,
        statements$.ref(),
        next_target,
        blocks
    ));
    return id;
}

mir.MirBlockId append_layout_field_drop_block(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropTemps temps,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    Int field_index,
    qid.TypeId field_type,
    mir.MirBlockId next_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    blocks.add(placeholder_block(output, id, source_block, next_target));
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    mir.MirPlace field_place_value = field_index_place(output, owner_place, field_index);
    mir.MirBlock generated = drop_block(
        ctx,
        output,
        temps,
        id,
        source_block,
        field_place_value,
        field_type,
        statements$.ref(),
        next_target,
        blocks
    );
    blocks.set(id.to_index(), generated);
    return id;
}

mir.MirBlockId append_layout_tag_branch(
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace owner_place,
    mir.MirBlockId true_target,
    mir.MirBlockId false_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    mir.MirPlace tag_place = field_index_place(output, owner_place, 0);
    mir.MirOperand condition = copy_operand_for_place(tag_place);
    blocks.add(mir.MirBlock (
        id: id,
        span: source_block.terminator.span,
        statements: output.empty_statements(),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.branch_terminator_kind(mir.MirBranchTerminator (
                condition: condition,
                then_target: true_target,
                else_target: false_target
            ))
        )
    ));
    return id;
}

mir.MirPlace field_place(mir.MirStore& output, mir.MirPlace owner_place, layout.FieldLayout field, Int field_index) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.field_projection_elem(mir.MirFieldProjection (
        field_def: field.field_def$.some(),
        field_type: field.field_type,
        field_index: field_index
    )));
    return mir.MirPlace (
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    );
}

mir.MirPlace field_index_place(mir.MirStore& output, mir.MirPlace owner_place, Int field_index) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    mir.MirConstantIndexProjection field_projection = mir.MirConstantIndexProjection (offset: field_index);
    projection.add(mir.constant_index_projection_elem(field_projection));
    return mir.MirPlace (
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    );
}

mir.MirPlace indexed_place(mir.MirStore& output, mir.MirPlace owner_place, mir.MirLocalId index_local) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.index_projection_elem(mir.MirIndexProjection (index_local: index_local)));
    return mir.MirPlace (
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    );
}

mir.MirPlace deref_place(mir.MirStore& output, mir.MirPlace owner_place) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>(owner_place.projection.length + 1);
    Int! index = 0;
    while (index < owner_place.projection.length) {
        projection.add(owner_place.projection[index]);
        index = index + 1;
    }
    projection.add(mir.deref_projection_elem(mir.MirDerefProjection (raw_pointer: false)));
    return mir.MirPlace (
        local_id: owner_place.local_id,
        projection: output.projection_array(projection$.ref())
    );
}

mir.MirPlace local_place(mir.MirStore& output, mir.MirLocalId local_id) {
    return mir.MirPlace (
        local_id: local_id,
        projection: output.empty_projection()
    );
}

mir.MirTerminator goto_terminator(mir.MirBlock source_block, mir.MirBlockId target) {
    return mir.MirTerminator (
        span: source_block.terminator.span,
        kind: mir.goto_terminator_kind(mir.MirGotoTerminator (target: target))
    );
}

mir.MirTerminator custom_deinit_terminator(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirBlock source_block,
    mir.MirPlace place,
    qid.DefId deinit_def,
    qid.TypeId[]& type_args,
    mir.MirLocalId destination,
    mir.MirBlockId next_target
) {
    list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>();
    args.add(mir.move_operand_value(mir.MirMoveOperand (place: place)));
    return mir.MirTerminator (
        span: source_block.terminator.span,
        kind: mir.call_terminator_kind(mir.MirCallTerminator (
            callee: mir.direct_function_callee(mir.MirFunctionRef (
                function_def: deinit_def,
                type_args: output.type_arg_array(type_args),
                const_args: output.empty_const_args(),
                type_id: deinit_function_type(ctx, deinit_def),
                span: source_block.terminator.span,
            )),
            args: output.operand_array(args$.ref()),
            destination: mir.MirPlace (
                local_id: destination,
                projection: output.empty_projection()
            ),
            target: next_target,
            initialized_place: null,
            cleanup: null
        ))
    );
}

qid.TypeId[]& custom_deinit_type_args(context.CompilerContext& ctx, mir.MirStore& output, qid.TypeId type_id) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .named(named)) {
        return named.type_args;
    }
    return output.empty_type_args();
}

qid.TypeId deinit_function_type(context.CompilerContext& ctx, qid.DefId deinit_def) {
    if (ctx.store.typeck.def_type(deinit_def) is .some(type_id)) {
        return type_id;
    }
    return ctx.store.types.invalid_type();
}

qid.DefId? custom_deinit_def_for_type(context.CompilerContext& ctx, qid.TypeId type_id) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    guard info.data is .named(named) else {
        return null;
    }
    guard ctx.store.hirs.def(named.def_id) is .some(hir_def) else {
        return null;
    }
    return hir_def.custom_deinit_def;
}

mir.MirBlockId append_drop_flag_branch(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirBlock source_block,
    mir.MirLocalDecl local,
    mir.MirBlockId drop_target,
    mir.MirBlockId skip_target,
    list.ArrayList<mir.MirBlock>& blocks
) {
    mir.MirBlockId id = mir.MirBlockId.from_index(blocks.len());
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    blocks.add(branch_on_drop_flag(
        ctx,
        output,
        flags,
        block_with_id(source_block, id),
        statements$.ref(),
        local,
        drop_target,
        skip_target
    ));
    return id;
}

mir.MirBlock branch_on_drop_flag(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirLocalDecl local,
    mir.MirBlockId drop_target,
    mir.MirBlockId skip_target
) {
    return mir.MirBlock (
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.branch_terminator_kind(mir.MirBranchTerminator (
                condition: drop_flag_operand(output, flags.flag_for(local.id)),
                then_target: drop_target,
                else_target: skip_target
            ))
        )
    );
}

mir.MirBlock block_with_id(mir.MirBlock block, mir.MirBlockId id) {
    return mir.MirBlock (
        id: id,
        span: block.span,
        statements: block.statements,
        terminator: block.terminator
    );
}

mir.MirBlock goto_block(mir.MirStore& output, mir.MirBlock source_block, mir.MirBlockId target) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    Int! index = 0;
    while (index < source_block.statements.length) {
        statements.add(source_block.statements[index]);
        index = index + 1;
    }
    return goto_block_with_statements(output, source_block, statements$.ref(), target);
}

mir.MirBlock goto_block_with_statements(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirBlockId target
) {
    return mir.MirBlock (
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: mir.MirTerminator (
            span: source_block.terminator.span,
            kind: mir.goto_terminator_kind(mir.MirGotoTerminator (target: target))
        )
    );
}

mir.MirBlock replace_block_statements(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements
) {
    return replace_block(output, source_block, statements, source_block.terminator);
}

mir.MirBlock replace_block(
    mir.MirStore& output,
    mir.MirBlock source_block,
    list.ArrayList<mir.MirStatement>& statements,
    mir.MirTerminator terminator
) {
    return mir.MirBlock (
        id: source_block.id,
        span: source_block.span,
        statements: output.statement_array(statements),
        terminator: terminator
    );
}

() push_move_flag_clears(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirRvalue value,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (value is .use_value(use_value)) {
        push_operand_move_flag_clear(ctx, output, flags, use_value.value, span, statements);
    }
    if (value is .unary_value(unary_value)) {
        push_operand_move_flag_clear(ctx, output, flags, unary_value.value, span, statements);
    }
    if (value is .binary_value(binary_value)) {
        push_operand_move_flag_clear(ctx, output, flags, binary_value.lhs, span, statements);
        push_operand_move_flag_clear(ctx, output, flags, binary_value.rhs, span, statements);
    }
    if (value is .cast_value(cast_value)) {
        push_operand_move_flag_clear(ctx, output, flags, cast_value.value, span, statements);
    }
    if (value is .alloc_value(alloc_value)) {
        push_operand_move_flag_clear(ctx, output, flags, alloc_value.value, span, statements);
    }
    if (value is .slice_value(slice_value)) {
        push_optional_operand_move_flag_clear(ctx, output, flags, slice_value.start, span, statements);
        push_optional_operand_move_flag_clear(ctx, output, flags, slice_value.end, span, statements);
    }
    if (value is .aggregate_value(aggregate_value)) {
        push_operand_array_move_flag_clears(ctx, output, flags, aggregate_value.fields, span, statements);
    }
    if (value is .optional_value(optional_value)) {
        push_operand_move_flag_clear(ctx, output, flags, optional_value.value, span, statements);
    }
    if (value is .error_union_value(error_union_value)) {
        push_operand_move_flag_clear(ctx, output, flags, error_union_value.value, span, statements);
    }
}

() push_optional_operand_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand? operand,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (operand is .some(value)) {
        push_operand_move_flag_clear(ctx, output, flags, value, span, statements);
    }
}

() push_operand_array_move_flag_clears(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand[]& operands,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    Int! index = 0;
    while (index < operands.length) {
        push_operand_move_flag_clear(ctx, output, flags, operands[index], span, statements);
        index = index + 1;
    }
}

() push_operand_move_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirOperand operand,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (operand is .move_operand(move_operand)) {
        if (move_operand.place.projection.length == 0 && flags.has_flag(move_operand.place.local_id)) {
            push_set_drop_flag(ctx, output, flags.flag_for(move_operand.place.local_id), false, span, statements);
        }
    }
}

() push_forget_flag_clear(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    DropFlagMap flags,
    mir.MirPlace place,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    if (place.projection.length == 0 && flags.has_flag(place.local_id)) {
        push_set_drop_flag(ctx, output, flags.flag_for(place.local_id), false, span, statements);
    }
}

() push_set_drop_flag(
    context.CompilerContext& ctx,
    mir.MirStore& output,
    mir.MirLocalId flag,
    Bool value,
    token.Span span,
    list.ArrayList<mir.MirStatement>& statements
) {
    statements.add(mir.MirStatement (
        span: span,
        kind: mir.assign_statement_kind(mir.MirAssignStatement (
            destination: flag_place(output, flag),
            value: mir.use_rvalue(mir.MirUseRvalue (value: bool_operand(ctx, value, span)))
        ))
    ));
}

mir.MirOperand bool_operand(context.CompilerContext& ctx, Bool value, token.Span span) {
    return mir.const_operand_value(mir.MirConst (
        type_id: ctx.store.types.bool_type(),
        span: span,
        value: mir.bool_const_kind(mir.MirBoolConst (value: value))
    ));
}

mir.MirOperand uint_operand(context.CompilerContext& ctx, Int value, token.Span span) {
    return mir.const_operand_value(mir.MirConst (
        type_id: ctx.store.types.uint_type(),
        span: span,
        value: mir.int_const_kind(mir.MirIntConst (bits: UInt64(value), signed_value: false))
    ));
}

mir.MirOperand drop_flag_operand(mir.MirStore& output, mir.MirLocalId flag) {
    return mir.copy_operand_value(mir.MirCopyOperand (place: flag_place(output, flag)));
}

mir.MirOperand copy_operand_for_place(mir.MirPlace place) {
    return mir.copy_operand_value(mir.MirCopyOperand (place: place));
}

mir.MirPlace flag_place(mir.MirStore& output, mir.MirLocalId flag) {
    return mir.MirPlace (
        local_id: flag,
        projection: output.empty_projection()
    );
}

mir.MirFunction copy_function(mir.MirStore& output, mir.MirFunction function, mir.MirBlock[]& blocks) {
    mir.MirBody! body = function.body;
    body = body_with_block_array(output, body, blocks);
    return copy_function_with_body(output, function, body);
}

mir.MirBody body_with_block_array(mir.MirStore& output, mir.MirBody body, mir.MirBlock[]& blocks) {
    return mir.MirBody (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: blocks,
        entry: body.entry,
        return_local: body.return_local
    );
}

mir.MirFunction copy_function_with_body(mir.MirStore& output, mir.MirFunction function, mir.MirBody body) {
    return mir.MirFunction (
        id: function.id,
        def_id: function.def_id,
        type_args: output.type_arg_array(function.type_args),
        const_args: output.const_arg_array(function.const_args),
        signature_id: function.signature_id,
        is_language_entry: function.is_language_entry,
        is_runtime_entry: function.is_runtime_entry,
        is_external: function.is_external,
        span: function.span,
        body: mir.MirBody (
            id: body.id,
            span: body.span,
            locals: copy_locals(output, body.locals),
            blocks: body.blocks,
            entry: body.entry,
            return_local: body.return_local
        )
    );
}

mir.MirLocalDecl[]& copy_locals(mir.MirStore& output, mir.MirLocalDecl[]& locals) {
    mir.MirLocalDecl![*] copied = output.alloc_local_array(locals.length);
    Int! index = 0;
    while (index < locals.length) {
        copied[index] = locals[index];
        index = index + 1;
    }
    return copied[0..locals.length];
}
