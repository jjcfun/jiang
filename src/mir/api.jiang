// MIR 阶段 facade。
//
// pipeline 只通过这里进入 MIR lowering 和 drop elaboration。具体 pass 的
// 实现文件仍可被阶段 smoke 直接测试。

import context = "../context.jiang";
import monomorph = "../sema/monomorph.jiang";
import module_graph = "../resolve/module_graph.jiang";
import mir = "./mir.jiang";
import drop_elaborate = "./drop_elaborate.jiang";
import lower = "./lower.jiang";

public mir.MirStore^ lower_package(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph
) {
    return lower.lower_package(ctx, instances, graph);
}

public mir.MirStore^ elaborate_drops(
    context.CompilerContext& ctx,
    mir.MirStore^ lowered
) {
    return drop_elaborate.elaborate_package(ctx, lowered);
}
