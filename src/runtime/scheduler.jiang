// Jiang coroutine scheduler runtime.
//
// This module owns the stable backend ABI. Scheduling policy belongs here;
// platform thread and synchronization primitives come from system.thread.

import thread = "../system/thread.jiang";
import domain_executor = "./domain_executor.jiang";

const Int resume_idle = 0;
const Int resume_running = 1;
const Int resume_pending = 2;
const Int resume_completed_word = 0;
const Int resume_state_word = 1;
const Int resume_queue_word = 2;
const Int resume_context_word = 3;
const Int resume_function_word = 4;
const Int resume_callback_word = 5;
const Int resume_token_words = 6;

struct RuntimeState {
    thread.Group! group;
    Bool! initialized;

    init(self) {
        self.group = thread.Group(null);
        self.initialized = false;
    }
}

RuntimeState! runtime_state = RuntimeState();

public Bool initialize() {
    if (!thread.supported()) { return false; }
    runtime_state.group = thread.create_group();
    if (!domain_executor.initialize()) { return false; }
    runtime_state.initialized = true;
    return true;
}

public () shutdown() {
    if (!runtime_state.initialized) { return; }
    thread.wait_group(runtime_state.group);
    domain_executor.shutdown();
    runtime_state.initialized = false;
}

@link_symbol("__jiang_runtime_domain_enqueue")
public () enqueue(
    Int domain_id,
    Int domain_kind,
    Void* context,
    UInt8* token_slot,
    Void* resume,
    Void* callback
) {
    assert(runtime_state.initialized);
    Void* executor = domain_executor.materialize(domain_id, domain_kind);
    enqueue_executor(executor, context, token_slot, resume, callback);
}

@link_symbol("__jiang_runtime_executor_enqueue")
public () enqueue_executor(
    Void* executor,
    Void* context,
    UInt8* token_slot,
    Void* resume,
    Void* callback
) {
    assert(runtime_state.initialized);
    thread.Queue queue = domain_executor.queue(executor);
    if (!domain_executor.is_concurrent(executor)) {
        if (domain_executor.can_inline(executor, context)) {
            invoke_resume(resume, context);
            return;
        }
        assert(thread.enqueue(runtime_state.group, queue, context, resume));
        return;
    }
    UInt8* token = resume_token(token_slot, queue, context, resume, callback);
    schedule_or_mark_pending(token);
}

() invoke_resume(Void* resume, Void* context) {
    RawFn<(), Void*> function = unsafe { resume$.as(RawFn<(), Void*>) };
    function(context);
}

@link_symbol("__jiang_runtime_resume_token_complete")
public () complete_resume_token(UInt8* raw_token) {
    if (raw_token == null) { return; }
    unsafe { thread.atomic_compare_exchange(resume_token_word(raw_token, resume_completed_word), 0, 1); }
}

UInt8* resume_token(
    UInt8* raw_slot,
    thread.Queue queue,
    Void* context,
    Void* resume,
    Void* callback
) {
    Int existing_address = load_storage_word(raw_slot, 0);
    if (existing_address != 0) { return unsafe { existing_address$.as(UInt8*) }; }
    UInt8* candidate = allocate_resume_token(queue, context, resume, callback);
    store_storage_word(raw_slot, 0, unsafe { candidate$.as(Int) });
    return candidate;
}

UInt8* allocate_resume_token(thread.Queue queue, Void* context, Void* resume, Void* callback) {
    UInt8* storage = thread.allocate_storage(resume_token_words * Int$.size());
    assert(storage != null);
    store_storage_word(storage, resume_completed_word, 0);
    store_storage_word(storage, resume_state_word, resume_idle);
    store_storage_word(storage, resume_queue_word, unsafe { thread.queue_handle(queue)$.as(Int) });
    store_storage_word(storage, resume_context_word, unsafe { context$.as(Int) });
    store_storage_word(storage, resume_function_word, unsafe { resume$.as(Int) });
    store_storage_word(storage, resume_callback_word, unsafe { callback$.as(Int) });
    return storage;
}

() schedule_or_mark_pending(UInt8* token) {
    while (true) {
        Int!* state = resume_token_word(token, resume_state_word);
        if (thread.atomic_compare_exchange(state, resume_idle, resume_running)) {
            enqueue_token(token);
            return;
        }
        if (thread.atomic_compare_exchange(state, resume_running, resume_pending)) {
            return;
        }
        if (thread.atomic_compare_exchange(state, resume_pending, resume_pending)) {
            return;
        }
    }
}

() enqueue_token(UInt8* token) {
    Int queue_handle = load_storage_word(token, resume_queue_word);
    thread.Queue queue = thread.Queue(unsafe { queue_handle$.as(Void*) });
    Int callback_address = load_storage_word(token, resume_callback_word);
    Void* callback_pointer = unsafe { callback_address$.as(Void*) };
    Void* context = unsafe { token$.as(Void*) };
    assert(thread.enqueue(runtime_state.group, queue, context, callback_pointer));
}

@link_symbol("__jiang_runtime_run_scheduled_resume")
() run_scheduled_resume(Void* context) {
}

@link_symbol("__jiang_runtime_release_resume_token")
() release_resume_token(UInt8* token) {
    while (true) {
        Int!* completed = resume_token_word(token, resume_completed_word);
        Int!* state = resume_token_word(token, resume_state_word);
        if (thread.atomic_compare_exchange(completed, 1, 1)) {
            finish_resume_token(token);
            return;
        }
        if (thread.atomic_compare_exchange(state, resume_pending, resume_running)) {
            enqueue_token(token);
            return;
        }
        if (thread.atomic_compare_exchange(state, resume_running, resume_idle)) {
            return;
        }
    }
}

() finish_resume_token(UInt8* token) {
    while (true) {
        Int!* state = resume_token_word(token, resume_state_word);
        if (thread.atomic_compare_exchange(state, resume_pending, resume_idle)) {
            break;
        }
        if (thread.atomic_compare_exchange(state, resume_running, resume_idle)) {
            break;
        }
    }
    thread.deallocate_storage(token);
}

Int!* resume_token_word(UInt8* token, Int index) {
    return storage_word(token, index);
}

Int load_storage_word(UInt8* storage, Int index) {
    return unsafe { storage_word(storage, index)$.get() };
}

() store_storage_word(UInt8* storage, Int index, Int value) {
    unsafe { storage_word(storage, index)$.set(value); }
}

Int!* storage_word(UInt8* storage, Int index) {
    Int address = unsafe { storage$.as(Int) } + index * Int$.size();
    return unsafe { address$.as(Int!*) };
}
