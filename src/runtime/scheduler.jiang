// Jiang coroutine scheduler runtime.
//
// AsyncContext 只保存函数状态；可并发调度的状态属于 TaskState 的固定前缀。
// 没有 TaskState 的 continuation 直接调用或直接入队，不承担原子状态机成本。

import thread = "../system/thread.jiang";
import domain_executor = "./domain_executor.jiang";

const Int schedule_idle = 0;
const Int schedule_queued = 1;
const Int schedule_running = 2;
const Int schedule_pending = 3;
const Int schedule_completed = 4;
const Int schedule_publishing_idle = 5;
const Int schedule_publishing_pending = 6;
const Int schedule_publishing_handoff = 7;
const Int schedule_kind_mask = 7;
const Int schedule_generation_step = 8;

// TaskState 的固定 runtime header。
const Int schedule_state_word = 0;
const Int schedule_executor_word = 1;
const Int schedule_context_word = 2;
const Int schedule_resume_word = 3;
const Int schedule_active_executor_word = 4;
const Int task_frame_word = 6;
const Int task_resume_word = 7;
const Int task_execution_executor_word = 8;
const Int task_cancellation_requested_word = 9;
const Int task_cancel_target_word = 10;
const Int task_external_ref_count_word = 11;

const Int continuation_executor_word = 3;
const Int continuation_context_word = 4;
const Int continuation_resume_word = 5;
const Int continuation_task_word = 6;

struct RuntimeState: Copyable {
    thread.Group group!;
    Bool initialized!;

    init(self) {
        self.group = thread.Group(null);
        self.initialized = false;
    }
}

RuntimeState runtime_state! = RuntimeState();

public Bool initialize() {
    if (!thread.supported()) { return false; }
    runtime_state.group = thread.create_group();
    if (!domain_executor.initialize()) { return false; }
    run_scheduled_continuation(null);
    keep_local_task_abi_reachable(false);
    runtime_state.initialized = true;
    return true;
}

public () shutdown() {
    if (!runtime_state.initialized) { return; }
    thread.wait_group(runtime_state.group);
    domain_executor.shutdown();
    runtime_state.initialized = false;
}

@link_symbol("__jiang_runtime_task_retain")
public () task_retain(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int*! count = task_word(task, task_external_ref_count_word);
    while (true) {
        Int observed = thread.atomic_load(count);
        assert(observed > 0);
        if (thread.atomic_compare_exchange(count, observed, observed + 1)) { return; }
    }
}

@link_symbol("__jiang_runtime_task_release")
public () task_release(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int*! count = task_word(task, task_external_ref_count_word);
    while (true) {
        Int observed = thread.atomic_load(count);
        assert(observed > 0);
        if (!thread.atomic_compare_exchange(count, observed, observed - 1)) { continue; }
        if (observed == 1) { thread.deallocate_storage(task); }
        return;
    }
}

// C/runtime 探针使用 binding id；编译器生成代码直接传 canonical executor。
@link_symbol("__jiang_runtime_domain_enqueue")
public () request_domain(
    Int domain_id,
    Int domain_kind,
    Void* context,
    Void* raw_task,
    Void* resume,
    Void* callback
) {
    Void* executor = domain_executor.materialize_uncached(domain_id, domain_kind);
    request(executor, raw_task, context, resume);
}

@link_symbol("__jiang_runtime_task_request")
public () request(
    Void* executor,
    Void* raw_task,
    Void* context,
    Void* resume
) {
    assert(runtime_state.initialized);
    if (raw_task == null) {
        schedule_raw(executor, context, resume);
        return;
    }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    request_task(task, executor, context, resume);
}

@link_symbol("__jiang_runtime_task_handoff")
public () handoff(
    Void* executor,
    Void* raw_task,
    Void* context,
    Void* resume
) {
    assert(runtime_state.initialized);
    if (raw_task == null) {
        schedule_raw(executor, context, resume);
        return;
    }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    if (target_can_inline(task, executor, context, true)) {
        while (true) {
            Int*! state = task_word(task, schedule_state_word);
            Int observed = thread.atomic_load(state);
            if (schedule_kind(observed) != schedule_idle) { break; }
            Int running = schedule_next(observed, schedule_running);
            if (!thread.atomic_compare_exchange(state, observed, running)) { continue; }
            store_word(task, schedule_active_executor_word, unsafe { executor$.as(Int) });
            invoke_resume(resume, context);
            return;
        }
    }
    Int publishing = claim_handoff(task);
    if (publishing < 0) { return; }
    publish_target(task, executor, context, resume);
    schedule_published(task, publishing, true);
}

@link_symbol("__jiang_runtime_task_suspend")
public () suspend_task(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    while (true) {
        Int*! state = task_word(task, schedule_state_word);
        Int observed = thread.atomic_load(state);
        Int kind = schedule_kind(observed);
        if (kind == schedule_running) {
            if (thread.atomic_compare_exchange(
                    state, observed, schedule_as(observed, schedule_idle)
                )
            ) {
                return;
            }
            continue;
        }
        if (kind == schedule_pending) {
            Int publishing = schedule_as(observed, schedule_publishing_handoff);
            if (!thread.atomic_compare_exchange(state, observed, publishing)) { continue; }
            schedule_published(task, publishing, true);
            return;
        }
        if (kind == schedule_completed) { return; }
        if (schedule_is_publishing(kind)) { continue; }
        assert(false);
    }
}

@link_symbol("__jiang_runtime_task_complete")
public () complete_task(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    while (true) {
        Int*! state = task_word(task, schedule_state_word);
        Int observed = thread.atomic_load(state);
        Int kind = schedule_kind(observed);
        if (kind == schedule_running || kind == schedule_pending) {
            if (thread.atomic_compare_exchange(
                    state, observed, schedule_as(observed, schedule_completed)
                )
            ) {
                return;
            }
            continue;
        }
        if (kind == schedule_completed) { return; }
        if (schedule_is_publishing(kind)) { continue; }
        assert(false);
    }
}

// confined 变体只有单一 serial executor 能访问调度字；保留状态机语义但不付原子成本。
@link_symbol("__jiang_runtime_task_suspend_local")
@inline(always)
() suspend_task_local(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int state = load_word(task, schedule_state_word);
    Int kind = schedule_kind(state);
    if (kind == schedule_running) {
        store_word(task, schedule_state_word, schedule_as(state, schedule_idle));
        return;
    }
    if (kind == schedule_pending) {
        store_word(task, schedule_state_word, schedule_as(state, schedule_running));
        invoke_published_target(task);
        return;
    }
    if (kind == schedule_completed) { return; }
    assert(false);
}

@link_symbol("__jiang_runtime_task_complete_local")
@inline(always)
() complete_task_local(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int state = load_word(task, schedule_state_word);
    Int kind = schedule_kind(state);
    if (kind == schedule_running || kind == schedule_pending) {
        store_word(task, schedule_state_word, schedule_as(state, schedule_completed));
        return;
    }
    if (kind == schedule_completed) { return; }
    assert(false);
}

// confined 调用链已经持有唯一 serial executor；本地 request 只发布下一次运行，
// 不进入跨线程 publishing 状态，也不执行原子 RMW。
@link_symbol("__jiang_runtime_task_request_local")
@inline(always)
() request_local(
    Void* executor,
    Void* raw_task,
    Void* context,
    Void* resume
) {
    if (raw_task == null) {
        invoke_resume(resume, context);
        return;
    }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int state = load_word(task, schedule_state_word);
    Int kind = schedule_kind(state);
    if (kind == schedule_idle) {
        publish_and_invoke_local(task, executor, context, resume, state);
        return;
    }
    if (kind == schedule_running) {
        publish_target(task, executor, context, resume);
        store_word(task, schedule_state_word, schedule_next(state, schedule_pending));
        return;
    }
    if (kind == schedule_pending) {
        assert(published_target_matches(task, executor, context, resume));
        return;
    }
    if (kind == schedule_completed) { return; }
    assert(false);
}

// local handoff 是对当前 executor 的对称转移。目标已经持有发布信息，
// 因而这里只需直接调用 continuation，不需要重新发布协议槽或递增 generation。
@link_symbol("__jiang_runtime_task_handoff_local")
@inline(always)
() handoff_local(
    Void* executor,
    Void* raw_task,
    Void* context,
    Void* resume
) {
    if (raw_task == null) {
        invoke_resume(resume, context);
        return;
    }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int state = load_word(task, schedule_state_word);
    Int kind = schedule_kind(state);
    if (kind == schedule_completed) { return; }
    if (!local_handoff_kind(kind)) {
        assert(false);
        return;
    }
    invoke_resume(resume, context);
}

Bool local_handoff_kind(Int kind) {
    return kind == schedule_running || kind == schedule_pending;
}

@inline(always)
() publish_and_invoke_local(
    UInt8* task,
    Void* executor,
    Void* context,
    Void* resume,
    Int state
) {
    publish_target(task, executor, context, resume);
    store_word(task, schedule_active_executor_word, unsafe { executor$.as(Int) });
    store_word(task, schedule_state_word, schedule_next(state, schedule_running));
    invoke_resume(resume, context);
}

// backend 以固定 symbol 生成 local protocol call；这个不可执行锚点只负责让
// private Jiang 定义进入 MIR，O2 会连同已内联后的独立函数副本一起删除。
() keep_local_task_abi_reachable(Bool enabled) {
    if (!enabled) { return; }
    suspend_task_local(null);
    complete_task_local(null);
    request_local(null, null, null, null);
    handoff_local(null, null, null, null);
}

() invoke_published_target(UInt8* task) {
    store_word(
        task,
        schedule_active_executor_word,
        unsafe { load_pointer(task, schedule_executor_word)$.as(Int) }
    );
    invoke_resume(
        load_pointer(task, schedule_resume_word),
        load_pointer(task, schedule_context_word)
    );
}

@link_symbol("__jiang_runtime_scheduled_continuation_resume")
() run_scheduled_continuation(Void* raw_continuation) {
    if (raw_continuation == null) { return; }
    UInt8* continuation = unsafe { raw_continuation$.as(UInt8*) };
    request(
        load_pointer(continuation, continuation_executor_word),
        load_pointer(continuation, continuation_task_word),
        load_pointer(continuation, continuation_context_word),
        load_pointer(continuation, continuation_resume_word)
    );
}

() request_task(UInt8* task, Void* executor, Void* context, Void* resume) {
    while (true) {
        Int*! state = task_word(task, schedule_state_word);
        Int observed = thread.atomic_load(state);
        Int kind = schedule_kind(observed);
        if (kind == schedule_idle) {
            Int publishing = schedule_next(observed, schedule_publishing_idle);
            if (!thread.atomic_compare_exchange(state, observed, publishing)) { continue; }
            publish_target(task, executor, context, resume);
            schedule_published(task, publishing, false);
            return;
        }
        if (kind == schedule_running) {
            Int publishing = schedule_next(observed, schedule_publishing_pending);
            if (!thread.atomic_compare_exchange(state, observed, publishing)) { continue; }
            publish_target(task, executor, context, resume);
            assert(thread.atomic_compare_exchange(
                state, publishing, schedule_as(publishing, schedule_pending)
            ));
            return;
        }
        if (kind == schedule_pending || kind == schedule_queued) {
            Bool matches = published_target_matches(task, executor, context, resume);
            if (!published_target_is_stable(task, observed)) { continue; }
            assert(matches);
            return;
        }
        if (kind == schedule_completed) { return; }
        // 先等待发布完成，再验证重复 wake 是否仍指向同一 continuation。
        if (schedule_is_publishing(kind)) { continue; }
        assert(false);
    }
}

Int claim_handoff(UInt8* task) {
    while (true) {
        Int*! state = task_word(task, schedule_state_word);
        Int observed = thread.atomic_load(state);
        Int kind = schedule_kind(observed);
        if (kind == schedule_idle) {
            Int publishing = schedule_next(observed, schedule_publishing_handoff);
            if (!thread.atomic_compare_exchange(state, observed, publishing)) { continue; }
            return publishing;
        }
        if (kind == schedule_running || kind == schedule_pending) {
            Int publishing = schedule_next(observed, schedule_publishing_handoff);
            if (thread.atomic_compare_exchange(
                    state, observed, publishing
                )
            ) {
                return publishing;
            }
            continue;
        }
        if (kind == schedule_completed) { return -1; }
        if (schedule_is_publishing(kind)) { continue; }
        assert(false);
    }
    return -1;
}

() schedule_published(UInt8* task, Int expected, Bool handoff) {
    Void* executor = load_pointer(task, schedule_executor_word);
    Void* context = load_pointer(task, schedule_context_word);
    Void* resume = load_pointer(task, schedule_resume_word);
    if (target_can_inline(task, executor, context, handoff)) {
        assert(thread.atomic_compare_exchange(
            task_word(task, schedule_state_word),
            expected,
            schedule_as(expected, schedule_running)
        ));
        store_word(task, schedule_active_executor_word, unsafe { executor$.as(Int) });
        invoke_resume(resume, context);
        return;
    }
    assert(thread.atomic_compare_exchange(
        task_word(task, schedule_state_word),
        expected,
        schedule_as(expected, schedule_queued)
    ));
    enqueue_task(task, executor);
}

Bool target_can_inline(UInt8* task, Void* executor, Void* context, Bool handoff) {
    if (executor == null) { return true; }
    if (!handoff) {
        return !domain_executor.is_concurrent(executor)
            && domain_executor.can_inline(executor, context);
    }
    Void* current = load_pointer(task, schedule_active_executor_word);
    if (current == executor && domain_executor.is_concurrent(executor)) { return true; }
    return !domain_executor.is_concurrent(executor)
        && domain_executor.can_inline(executor, context);
}

() schedule_raw(Void* executor, Void* context, Void* resume) {
    if (executor == null) {
        invoke_resume(resume, context);
        return;
    }
    if (!domain_executor.is_concurrent(executor)
        && domain_executor.can_inline(executor, context)
    ) {
        invoke_resume(resume, context);
        return;
    }
    assert(thread.enqueue(
        runtime_state.group, domain_executor.queue(executor), context, resume
    ));
}

() enqueue_task(UInt8* task, Void* executor) {
    assert(executor != null);
    RawFn<(), Void*> callback = run_scheduled_task;
    assert(thread.enqueue(
        runtime_state.group,
        domain_executor.queue(executor),
        unsafe { task$.as(Void*) },
        unsafe { callback$.as(Void*) }
    ));
}

() run_scheduled_task(Void* raw_task) {
    if (raw_task == null) { return; }
    UInt8* task = unsafe { raw_task$.as(UInt8*) };
    Int*! state = task_word(task, schedule_state_word);
    Int observed = thread.atomic_load(state);
    if (schedule_kind(observed) != schedule_queued) { return; }
    Void* executor = load_pointer(task, schedule_executor_word);
    Void* context = load_pointer(task, schedule_context_word);
    Void* resume = load_pointer(task, schedule_resume_word);
    if (!thread.atomic_compare_exchange(
            state, observed, schedule_as(observed, schedule_running)
        )
    ) {
        return;
    }
    store_word(task, schedule_active_executor_word, unsafe { executor$.as(Int) });
    invoke_resume(resume, context);
}

() invoke_resume(Void* resume, Void* context) {
    RawFn<(), Void*> function = unsafe { resume$.as(RawFn<(), Void*>) };
    function(context);
}

() publish_target(UInt8* task, Void* executor, Void* context, Void* resume) {
    store_word(task, schedule_executor_word, unsafe { executor$.as(Int) });
    store_word(task, schedule_context_word, unsafe { context$.as(Int) });
    store_word(task, schedule_resume_word, unsafe { resume$.as(Int) });
}

Bool published_target_matches(
    UInt8* task,
    Void* executor,
    Void* context,
    Void* resume
) {
    return load_pointer(task, schedule_executor_word) == executor
        && load_pointer(task, schedule_context_word) == context
        && load_pointer(task, schedule_resume_word) == resume;
}

Bool published_target_is_stable(UInt8* task, Int observed) {
    return thread.atomic_load(task_word(task, schedule_state_word)) == observed;
}

Int schedule_kind(Int state) {
    return state & schedule_kind_mask;
}

Int schedule_as(Int state, Int kind) {
    return (state & -schedule_generation_step) | kind;
}

Int schedule_next(Int state, Int kind) {
    return schedule_as(state + schedule_generation_step, kind);
}

Bool schedule_is_publishing(Int kind) {
    return kind == schedule_publishing_idle
        || kind == schedule_publishing_pending
        || kind == schedule_publishing_handoff;
}

Void* load_pointer(UInt8* storage, Int index) {
    return unsafe { load_word(storage, index)$.as(Void*) };
}

Int load_word(UInt8* storage, Int index) {
    return unsafe { task_word(storage, index)$.get() };
}

() store_word(UInt8* storage, Int index, Int value) {
    unsafe { task_word(storage, index)$.set(value); }
}

Int*! task_word(UInt8* storage, Int index) {
    Int address = unsafe { storage$.as(Int) } + index * Int$.size();
    return unsafe { address$.as(Int*!) };
}
