// Jiang coroutine scheduler runtime.
//
// This module owns the stable backend ABI. Scheduling policy belongs here;
// platform thread and synchronization primitives come from system.thread.

import thread = "../system/thread.jiang";

const Int concurrent_domain_kind = 1;

struct RuntimeState {
    thread.Group! group;
    thread.Queue! concurrent_queue;
    Bool! initialized;

    init(self) {
        self.group = thread.Group(null);
        self.concurrent_queue = thread.Queue(null);
        self.initialized = false;
    }
}

RuntimeState! runtime_state = RuntimeState();
thread.Mutex! serial_domains_mutex = thread.Mutex(null);
UInt8*! serial_domain_ids = null;
UInt8*! serial_queue_handles = null;
Int! serial_domain_count = 0;
Int! serial_domain_capacity = 0;

public Bool initialize() {
    if (!thread.supported()) { return false; }
    runtime_state.group = thread.create_group();
    runtime_state.concurrent_queue = thread.concurrent_queue();
    serial_domains_mutex = thread.create_mutex();
    if (!thread.mutex_valid(serial_domains_mutex)) { return false; }
    runtime_state.initialized = true;
    return true;
}

public () shutdown() {
    if (!runtime_state.initialized) { return; }
    thread.wait_group(runtime_state.group);
    free_serial_domains();
    thread.destroy(serial_domains_mutex);
    serial_domains_mutex = thread.Mutex(null);
    runtime_state.initialized = false;
}

@link_symbol("__jiang_runtime_domain_enqueue")
public () enqueue(Int domain_id, Int domain_kind, UInt8* context, UInt8* resume) {
    assert(runtime_state.initialized);
    thread.Queue queue = queue_for(domain_id, domain_kind);
    assert(thread.enqueue(runtime_state.group, queue, context, resume));
}

thread.Queue queue_for(Int domain_id, Int domain_kind) {
    if (domain_kind == concurrent_domain_kind) {
        return runtime_state.concurrent_queue;
    }
    thread.lock(serial_domains_mutex);
    thread.Queue queue = serial_queue_for(domain_id);
    thread.unlock(serial_domains_mutex);
    return queue;
}

thread.Queue serial_queue_for(Int domain_id) {
    Int! index = 0;
    while (index < serial_domain_count) {
        if (load_storage_word(serial_domain_ids, index) == domain_id) {
            Int handle = load_storage_word(serial_queue_handles, index);
            return thread.Queue(unsafe { handle$.as(UInt8*) });
        }
        index = index + 1;
    }
    return add_serial_queue(domain_id);
}

thread.Queue add_serial_queue(Int domain_id) {
    ensure_serial_domain_capacity();
    thread.Queue queue = thread.serial_queue();
    Int index = serial_domain_count;
    store_storage_word(serial_domain_ids, index, domain_id);
    UInt8* handle = thread.queue_handle(queue);
    store_storage_word(serial_queue_handles, index, unsafe { handle$.as(Int) });
    serial_domain_count = index + 1;
    return queue;
}

() ensure_serial_domain_capacity() {
    if (serial_domain_count < serial_domain_capacity) { return; }
    Int! capacity = serial_domain_capacity * 2;
    if (capacity == 0) { capacity = 8; }
    UInt8* next_domain_ids = thread.reallocate_storage(serial_domain_ids, capacity * Int$.size());
    assert(next_domain_ids != null);
    serial_domain_ids = next_domain_ids;
    Int handles_size = capacity * UInt8*$.size();
    UInt8* next_handles = thread.reallocate_storage(serial_queue_handles, handles_size);
    assert(next_handles != null);
    serial_queue_handles = next_handles;
    serial_domain_capacity = capacity;
}

Int load_storage_word(UInt8* storage, Int index) {
    return unsafe { storage_word(storage, index)$.get() };
}

() store_storage_word(UInt8* storage, Int index, Int value) {
    unsafe { storage_word(storage, index)$.set(value); }
}

Int!* storage_word(UInt8* storage, Int index) {
    Int address = unsafe { storage$.as(Int) } + index * Int$.size();
    return unsafe { address$.as(Int!*) };
}

() free_serial_domains() {
    free_storage(serial_domain_ids);
    free_storage(serial_queue_handles);
    serial_domain_ids = null;
    serial_queue_handles = null;
    serial_domain_count = 0;
    serial_domain_capacity = 0;
}

() free_storage(UInt8* storage) {
    if (storage != null) { thread.deallocate_storage(storage); }
}
