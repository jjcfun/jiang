// Compiler-known type interfaces.
//
// These declarations provide source-level names, generic parameters and
// namespaces for builtin types. Layout, ABI and canonical type construction are
// still bound by the compiler.

public extern(type) Bool;
public extern(type) Int;
public extern(type) UInt;
public extern(type) Int8;
public extern(type) Int16;
public extern(type) Int32;
public extern(type) Int64;
public extern(type) UInt8;
public extern(type) UInt16;
public extern(type) UInt32;
public extern(type) UInt64;
public extern(type) Float;
public extern(type) Float32;
public extern(type) Float64;
public extern(type) Double;
public extern(type) Char;

public extern(type) Option<T>;
public extern(type) Result<T, E>;
public extern(type) Fn<R>;
public extern(type) Reference<T>;
public extern(type) Box<T>;
public extern(type) RawPointer<T>;
public extern(type) ManyPointer<T>;
public extern(type) SentinelPointer<T, const T S>;
public extern(type) Slice<T>;
public extern(type) SentinelSlice<T, const T S>;
public extern(type) Array<T, const Int N>;
public extern(type) SentinelArray<T, const Int N, const T S>;
