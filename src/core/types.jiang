// 编译器已知类型接口。
//
// 这些声明为 builtin type 提供源码层名字、泛型参数和 namespace。
// 布局、ABI 和 canonical type 构造仍由编译器约束。

import * = "traits.jiang";

public extern(type) Bool: Hashable;
public extern(type) Int: Hashable;
public extern(type) UInt: Hashable;
public extern(type) Int8: Hashable;
public extern(type) Int16: Hashable;
public extern(type) Int32: Hashable;
public extern(type) Int64: Hashable;
public extern(type) UInt8: Hashable;
public extern(type) UInt16: Hashable;
public extern(type) UInt32: Hashable;
public extern(type) UInt64: Hashable;
public extern(type) Float: Hashable;
public extern(type) Float32: Hashable;
public extern(type) Float64: Hashable;
public extern(type) Double: Hashable;
public extern(type) Char: Hashable;

public extern(type) Option<T>;
public extern(type) Result<T, E>;
public extern(type) Fn<R>;
public extern(type) Reference<T>;
public extern(type) Box<T>;
public extern(type) RawPointer<T>;
public extern(type) ManyPointer<T>;
public extern(type) SentinelPointer<T, const T S>;
public extern(type) Slice<T>;
public extern(type) SentinelSlice<T, const T S>;
public extern(type) Array<T, const Int N>;
public extern(type) SentinelArray<T, const Int N, const T S>;
