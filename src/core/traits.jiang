public trait Movable;

public trait Mutable;

public enum DomainKind {
    serial,
    concurrent,
}

public trait Domain {
    associated Kind;
}

public trait DomainExecutor {
    () enqueue(UInt8* context, RawFn<(), UInt8*> resume);
}

public trait Equatable {
    Bool equal(Self& lhs, Self& rhs);
}

public trait Hashable: Equatable {
    UInt64 hash(self);
}

public trait Iterator {
    associated Element;

    Element? next(self);
}

public trait Sequence {
    associated Element;

    associated Iter: Iterator;

    Iter make_iterator(self);
}

public trait Contiguous {
    associated Element;

    Element[*] many_pointer(self);

    Int length(self);
}
