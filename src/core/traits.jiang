public trait Movable;

public trait Copyable: Movable;

public trait Mutable;

public trait Sendable;

public trait Equatable {
    Bool equal(Self& lhs, Self& rhs);
}

public trait Hasher {
    Void write(Self&! self, UInt8[]& bytes);

    Void write(Self&! self, UInt8 value);

    Void write(Self&! self, Int value) {
        self.write(Int64(value));
    }

    Void write(Self&! self, Int8 value) {
        self.write(UInt8(value));
    }

    Void write(Self&! self, Int16 value) {
        self.write(UInt16(value));
    }

    Void write(Self&! self, Int32 value) {
        self.write(UInt32(value));
    }

    Void write(Self&! self, Int64 value) {
        self.write(UInt64(value));
    }

    Void write(Self&! self, Bool value) {
        if (value) {
            self.write(UInt8(1));
            return;
        }
        self.write(UInt8(0));
    }

    Void write(Self&! self, UInt value) {
        self.write(UInt64(value));
    }

    Void write(Self&! self, UInt16 value) {
        self.write(UInt8(value & 255));
        self.write(UInt8(value >> 8));
    }

    Void write(Self&! self, UInt32 value) {
        self.write(UInt8(value & 255));
        self.write(UInt8(value >> 8));
        self.write(UInt8(value >> 16));
        self.write(UInt8(value >> 24));
    }

    Void write(Self&! self, UInt64 value) {
        self.write(UInt8(value & 255));
        self.write(UInt8(value >> 8));
        self.write(UInt8(value >> 16));
        self.write(UInt8(value >> 24));
        self.write(UInt8(value >> 32));
        self.write(UInt8(value >> 40));
        self.write(UInt8(value >> 48));
        self.write(UInt8(value >> 56));
    }

    UInt64 finish(self);
}

public trait Hashable: Equatable {
    Void hash<H: Hasher>(self, H&! hasher);
}

public trait Iterator {
    associated Element;

    Element? next(self);
}

public trait Sequence {
    associated Element;

    associated Iter: Iterator;

    @life(return: self)
    Iter make_iterator(self);
}

public trait Contiguous {
    associated Element;

    Element* ptr(self);

    Int length(self);
}
