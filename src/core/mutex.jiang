// 语言级互斥容器。
//
// Mutex<T> 将值与 system provider 的 opaque lock 绑定。用户只能在 with_lock
// 回调的同步作用域中取得值的可变引用，不接触 pthread、os_unfair_lock 等平台类型。

import thread = "../system/thread.jiang";

@region(a)
public struct Mutex<T>: !Movable {
    Void* handle;

    @life(a)
    T value;

    public init(self, T value) {
        thread.Mutex mutex = thread.create_mutex();
        assert(thread.mutex_valid(mutex));
        self.handle = thread.mutex_handle(mutex);
        self.value = value;
    }

    public deinit(self) {
        thread.destroy(thread.mutex_from_handle(self.handle));
    }

    @inline
    public R with_lock<R>(self, FnOnce<R, T&!> action) {
        thread.lock(thread.mutex_from_handle(self.handle));
        MutexLock lock = MutexLock(self.handle);
        T&! value = unsafe {
            self.value$.ptr()$.as(T&!)
        };
        return action(value);
    }

    @life(return: self)
    public MutexGuard<T> lock(self) {
        thread.lock(thread.mutex_from_handle(self.handle));
        T&! value = unsafe {
            self.value$.ptr()$.as(T&!)
        };
        Void& lifetime = unsafe {
            self$.ptr()$.as(Void&)
        };
        MutexGuard<T>(self.handle, value, lifetime)
    }
}

struct MutexLock: !Movable {
    Void* handle;

    init(self, Void* handle) {
        self.handle = handle;
    }

    public deinit(self) {
        thread.unlock(thread.mutex_from_handle(self.handle));
    }
}

@region(a)
public struct MutexGuard<T>: !Movable {
    Void* handle;

    @life()
    T*! value_pointer;

    @life(a)
    Void& lifetime;

    init(self, Void* handle, T&! value, Void& lifetime) {
        self.handle = handle;
        self.value_pointer = unsafe { value$.ptr()$.as(T*!) };
        self.lifetime = lifetime;
    }

    @life(return: self)
    public T&! get(self) {
        return unsafe { self.value_pointer$.as(T&!) };
    }

    public deinit(self) {
        thread.unlock(thread.mutex_from_handle(self.handle));
    }
}

// Mutex 固定自身地址并通过锁保护 value。
// 跨 Domain 时移动的是 owner handle，而不是 Mutex 本体。
@where(T: Sendable)
public extend <T> Mutex<T>: Sendable;
