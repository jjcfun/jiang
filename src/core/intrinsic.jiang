// Compiler-internal `$` operations.
//
// The source declarations live in core so builtin type interfaces are
// centralized; type checking and lowering still route these members through the
// intrinsic operation pipeline.

import * = "primitives.jiang";
import * = "traits.jiang";

@intrinsic(value, _)
{
    () move();
    () ref();
    () addr();
    () ptr();
    () as();
}

@intrinsic(value, <T>)
@where(T: Movable)
{
    () forget();
}

@intrinsic(value, Reference<_>)
{
    () get();
    () set();
}

@intrinsic(value, RawPointer<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, Box<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, ManyPointer<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, SentinelPointer<_, _>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, Option<RawPointer<_>>)
{
    () free();
}

@intrinsic(value, Option<Box<_>>)
{
    () free();
}

@intrinsic(value, Option<ManyPointer<_>>)
{
    () free();
}

@intrinsic(value, Option<SentinelPointer<_, _>>)
{
    () free();
}

@intrinsic(value, Option<_>)
{
    () some();
}

@intrinsic(type, _)
{
    () alloc();
    () alloc_many();
    () size();
    () align();
    () max_align();
}
