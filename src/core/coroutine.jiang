// 公开协程 API。底层原语由 compiler builtin 模块提供。

import builtin = "../builtin/coroutine.jiang";
import runtime = "../runtime/scheduler.jiang";

public alias Continuation = builtin.Continuation;
public alias suspend = builtin.coroutine_suspend;

// 可逃逸的取消能力。它不拥有 Task，也不等待 Task 完成。
public struct Cancellation: Movable, Sendable {
    UInt state;

    public () cancel(self) {
        runtime.cancellation_cancel(unsafe { self.state$.as(Void*) });
    }

    public deinit(self) {
        runtime.cancellation_release(unsafe { self.state$.as(Void*) });
    }
}
