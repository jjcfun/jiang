// 公开协程 API。底层原语由 compiler builtin 模块提供。

import builtin = "../builtin/coroutine.jiang";

// 在指定 Domain 执行 closure。同步 caller 阻塞等待，async caller 挂起后恢复。
@life()
extern [builtin] T coroutine_sync<T, D>(D domain, Fn<T> closure);

public alias Continuation = builtin.Continuation;
public alias suspend = builtin.coroutine_suspend;
public alias check_cancelled = builtin.coroutine_check_cancelled;
public alias sync = coroutine_sync;
