// 底层协程原语。
//
// suspend 的 registration 同步执行；Continuation 可以在当前调用中完成，
// 也可以被异步操作持有后跨线程恢复。具体状态和调度由编译器/runtime lowering。

import * = "primitives.jiang";
import * = "traits.jiang";
import * = "value.jiang";

public struct Continuation<T>: Movable {
    UInt state;

    public () on_cancel(self, Fn<()> handler);

    public () resume(self, T value);
}

public async T suspend<T>(Fn<(), Continuation<T>> registration);
