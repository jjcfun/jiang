// 协程公开 API 与编译器 intrinsic 声明。
//
// coroutine_suspend 的 registration 同步执行；Continuation 可以在当前调用中完成，
// 也可以被异步操作持有后跨线程恢复。具体状态和调度由编译器/runtime lowering。

import traits = "traits.jiang";

public struct Continuation<T>: traits.Movable {
    UInt state;

    public Void on_cancel(self, Fn<Void> handler);

    public Void resume(self, T value);
}

// Continuation 的 runtime state 支持跨线程完成；result 只有可安全转移时才能一并跨 Domain。
@where(T: traits.Sendable)
public extend <T> Continuation<T>: traits.Sendable;

extern [builtin] async T coroutine_suspend<T>(
    Fn<Void, Continuation<T>> registration
);

// 显式协作取消检查点。没有取消请求时立即返回；
// 有请求时直接进入当前 coroutine 的 cleanup。
extern [builtin] async Void coroutine_check_cancelled();

// 在指定 Domain 执行 closure。同步 caller 阻塞等待，async caller 挂起后恢复。
@life()
extern [builtin] T coroutine_sync<T, D>(D domain, Fn<T> closure);

public alias suspend = coroutine_suspend;
public alias check_cancelled = coroutine_check_cancelled;
public alias sync = coroutine_sync;
