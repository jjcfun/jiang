// Compiler core module source.
//
// Module graph loading imports this file before user roots. Selected definitions
// are still compiler-known, but their members and signatures come from source.

public trait Movable;

public trait Mutable;

public trait Equatable {
    static Bool equal(Self& lhs, Self& rhs);
}

public trait Hashable: Equatable {
    UInt64 hash();
}

public trait Iterator {
    associated Element;

    Element? next();
}

public trait Sequence {
    associated Element;

    associated Iter: Iterator;

    Iter make_iterator();
}

public trait Contiguous {
    associated Element;

    Element[*] many_pointer();

    Int length();
}
