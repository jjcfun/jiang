// 编译器 core 模块源码。
//
// module graph 会先于用户 root 加载这个入口。这里保持为较小的聚合文件；
// 各个 core 领域仍放在相邻文件中。

public import * = "types.jiang";
public import * = "traits.jiang";
public import * = "contiguous.jiang";
public import * = "value.jiang";
import * = "intrinsic.jiang";

public extend Int: Hashable {
    public UInt64 hash() {
        self$.as(UInt64)
    }

    public static Bool equal(Int& lhs, Int& rhs) {
        lhs$.get() == rhs$.get()
    }
}

public extend UInt: Hashable {
    public UInt64 hash() {
        self$.as(UInt64)
    }

    public static Bool equal(UInt& lhs, UInt& rhs) {
        lhs$.get() == rhs$.get()
    }
}

