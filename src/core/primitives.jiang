// 编译器已知类型能力声明。
//
// builtin type 的 DefId、泛型参数和 namespace 由编译器启动期创建；
// 这里只声明源码层 trait 关系。没有函数体的 extend 仅允许在 core 中使用，
// 具体实现仍由 type check / MIR 的 builtin 路径处理。

import * = "traits.jiang";

public extend Bool: Hashable;
public extend Int: Hashable;
public extend UInt: Hashable;
public extend Int8: Hashable;
public extend Int16: Hashable;
public extend Int32: Hashable;
public extend Int64: Hashable;
public extend UInt8: Hashable;
public extend UInt16: Hashable;
public extend UInt32: Hashable;
public extend UInt64: Hashable;
public extend Float16: Hashable;
public extend Float: Hashable;
public extend Float32: Hashable;
public extend Float64: Hashable;
public extend Double: Hashable;
public extend Char: Hashable;
