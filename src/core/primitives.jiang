// 编译器已知类型能力声明。
//
// builtin type 的 DefId、泛型参数和 namespace 由编译器启动期创建；
// 这里只声明源码层 trait 关系。没有函数体的 extend 仅允许在 core 中使用，
// 具体实现仍由 type check / JIL 的 builtin 路径处理。

import traits = "traits.jiang";

public extend Bool: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Int: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend UInt: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Int8: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Int16: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Int32: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Int64: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend UInt8: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend UInt16: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend UInt32: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend UInt64: traits.Hashable {
    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(unsafe { self$.get() });
    }
}

public extend Float16: traits.Hashable {
    public UInt16 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt16*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}

public extend Float: traits.Hashable {
    public UInt32 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt32*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}

public extend Float32: traits.Hashable {
    public UInt32 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt32*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}

public extend Float64: traits.Hashable {
    public UInt64 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt64*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}

public extend Double: traits.Hashable {
    public UInt64 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt64*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}

public extend Char: traits.Hashable {
    public UInt32 to_bits(self) {
        return unsafe { self$.ptr()$.as(UInt32*)$.get() };
    }

    public Void hash<H: traits.Hasher>(self, H&! hasher) {
        hasher.write(self.to_bits());
    }
}
