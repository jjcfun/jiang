// Atomic 只支持后端保证 lock-free 的标量 storage。

public trait AtomicValue;

public extend Bool: AtomicValue;
public extend Int: AtomicValue;
public extend UInt: AtomicValue;
public extend Int8: AtomicValue;
public extend Int16: AtomicValue;
public extend Int32: AtomicValue;
public extend Int64: AtomicValue;
public extend UInt8: AtomicValue;
public extend UInt16: AtomicValue;
public extend UInt32: AtomicValue;
public extend UInt64: AtomicValue;
public extend <T> T*: AtomicValue;
