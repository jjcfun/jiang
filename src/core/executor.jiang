// 公开异步执行器 contract。
//
// Domain 通过 associated ExecutorType 选择运行时调度策略。ExecutorJob 是 runtime
// 交给 Executor 的一次性执行权；平台线程、队列和 coroutine frame 均不进入公开表示。

import * = "primitives.jiang";
import * = "traits.jiang";

public enum DomainKind {
    serial,
    concurrent,
}

public struct ExecutorJob: Movable, Sendable {
    Int context;
    RawFn<(), Int> callback;
    Bool pending!;

    public () run(Self self!) {
        self.pending = false;
        RawFn<(), Int> callback = self.callback;
        callback(self.context);
    }

    deinit(self) {
        assert(!self.pending);
    }
}

public trait Executor {
    () enqueue(Self& self, ExecutorJob job);
}

public trait Domain {
    associated kind: const DomainKind;
    associated ExecutorType: Executor;

    ExecutorType make_executor(Self& self);
}

// 标准串行执行器由 runtime descriptor 接入 system.thread serial queue。
public struct SerialExecutor: Copyable, Executor {
    public () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

// 标准并发执行器由 runtime descriptor 接入 system.thread concurrent queue。
public struct ConcurrentExecutor: Copyable, Executor {
    public () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}
