// 公开异步执行器 contract。
//
// Domain 通过 associated ExecutorType 选择运行时调度策略。ExecutorJob 是 runtime
// 交给 Executor 的一次性执行权；平台线程、队列和 coroutine frame 均不进入公开表示。

import * = "primitives.jiang";
import * = "traits.jiang";

public enum DomainKind {
    serial,
    concurrent,
}

public struct ExecutorJob: Movable, Sendable {
    Int context;
    RawFn<(), Int> callback;
    Bool pending!;

    public () run(Self self!) {
        self.pending = false;
        RawFn<(), Int> callback = self.callback;
        callback(self.context);
    }

    deinit(self) {
        assert(!self.pending);
    }
}

public trait Executor {
    () enqueue(Self& self, ExecutorJob job);
}

public trait Domain {
    associated kind: const DomainKind;
    associated ExecutorType: Executor;

    ExecutorType make_executor(Self& self);
}

// 标准串行执行器由 runtime descriptor 接入 system.thread serial queue。
public struct SerialExecutor: Copyable, Executor {
    public () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

// 标准并发执行器由 runtime descriptor 接入 system.thread concurrent queue。
public struct ConcurrentExecutor: Copyable, Executor {
    public () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

// 标准主线程执行器由 runtime 接入 system.thread main queue。
public struct MainExecutor: Copyable, Executor {
    public () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

// 进程级共享并发 Domain。具体工作线程由 system.thread 的平台 provider 管理。
public struct GlobalDomain: Copyable, Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    public ConcurrentExecutor make_executor(Self& self) {
        ConcurrentExecutor()
    }
}

public const GlobalDomain global_domain = GlobalDomain();

// 绑定进程启动线程的标准串行 Domain。
public struct MainDomain: Copyable, Domain<kind = .serial> {
    associated ExecutorType = MainExecutor;

    public MainExecutor make_executor(Self& self) {
        MainExecutor()
    }
}

public const MainDomain main_domain = MainDomain();
