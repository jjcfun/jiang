// 编译器已知连续存储类型的源码级 Contiguous 声明。
//
// body-less extend 只声明 trait 关系；关联类型和 ptr()/length()
// 的实际调用仍由编译器的 builtin 静态派发路径处理。

import traits = "traits.jiang";

public extend <T> T[]: traits.Contiguous;

public extend <T, S: const T> T[:S]: traits.Contiguous;

public extend <T, N: const Int> T[N]: traits.Contiguous;

public extend <T, N: const Int, S: const T> T[N:S]: traits.Contiguous;
