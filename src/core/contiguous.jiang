// 编译器已知连续存储类型的源码级 Contiguous 实现。
//
// 这些实现定义 core 中公开的 trait 表面；布局和指针投影仍由 builtin
// Slice/Array 操作下沉。

import * = "types.jiang";
import * = "traits.jiang";

public extend Slice<T>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self$.ptr()
    }

    public Int length() {
        self.length
    }
}

public extend SentinelSlice<T, S>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self$.ptr()$.as(T[*])
    }

    public Int length() {
        self.length
    }
}

public extend Array<T, N>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self[..]$.ptr()$.as(T[*])
    }

    public Int length() {
        N
    }
}

public extend SentinelArray<T, N, S>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self[..]$.ptr()$.as(T[*])
    }

    public Int length() {
        N
    }
}
