// Source-level Contiguous implementations for compiler-known storage types.
//
// These impls define the public trait surface in core while layout and pointer
// projection are still lowered through builtin slice/array operations.

import * = "types.jiang";
import * = "traits.jiang";

public extend Slice<T>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self$.ptr()
    }

    public Int length() {
        self.length
    }
}

public extend SentinelSlice<T, S>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self$.ptr()$.as(T[*])
    }

    public Int length() {
        self.length
    }
}

public extend Array<T, N>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self[..]$.ptr()$.as(T[*])
    }

    public Int length() {
        N
    }
}

public extend SentinelArray<T, N, S>: Contiguous {
    associated Element = T;

    public T[*] many_pointer() {
        self[..]$.ptr()$.as(T[*])
    }

    public Int length() {
        N
    }
}
