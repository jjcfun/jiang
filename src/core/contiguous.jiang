// 编译器已知连续存储类型的源码级 Contiguous 声明。
//
// body-less extend 只声明 trait 关系；关联类型和 many_pointer()/length()
// 的实际调用仍由编译器的 builtin 静态派发路径处理。

import * = "primitives.jiang";
import * = "traits.jiang";

public extend <T> T[]: Contiguous;

public extend <T, S: const T> T[:S]: Contiguous;

public extend <T, N: const Int> T[N]: Contiguous;

public extend <T, N: const Int, S: const T> T[N:S]: Contiguous;
