// syntax 阶段稳定入口，串联 lexer、parser 与 lang provider。
//
// This file is the boundary that wires lexer and parser together. Callers
// that need a parsed source unit should use this instead of constructing the
// lexer and parser separately.

import lexer = "./syntax/lexer.jiang";
import parser = "./syntax/parser.jiang";
import ast = "./syntax/ast.jiang";
public import builder = "./syntax/builder.jiang";
public import tree_converter = "./syntax/tree_converter.jiang";
import context = "./context.jiang";
import diagnostic = "./diagnostic.jiang";
import lang_block = "./lang/block.jiang";
import lang_registry = "./lang/registry.jiang";
import source = "./source.jiang";

public struct SyntaxResult: Movable {
    public ast.AstUnit unit!;
    public Bool ok;
    public diagnostic.DiagnosticScope diagnostics;

    public init(self, ast.AstUnit unit, Bool ok, diagnostic.DiagnosticScope diagnostics) {
        self.unit = unit;
        self.ok = ok;
        self.diagnostics = diagnostics;
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public ast.AstUnit take_unit(Self&! self) {
        return self.unit.take();
    }
}

public SyntaxResult parse_source(context.CompilerContext&! ctx, UInt8[]& text, source.SourceId source_id) {
    diagnostic.DiagnosticScope scope! = ctx.store.diagnostics.scope();
    lang_registry.Registry registry! = lang_registry.Registry();
    lang_block.LangBlockStore blocks! = lang_block.LangBlockStore();
    lexer.Lexer lex! = lexer.Lexer(
        ctx.store$.mut_ref(), text, source_id, registry$.mut_ref(), blocks$.mut_ref()
    );
    lexer.LexResult lexed! = lex.tokenize();

    parser.ParseResult parsed! = parser.parse_tokens(
        ctx.store$.mut_ref(),
        lexed.tokens$.ref(),
        blocks$.mut_ref(),
        text,
        source_id
    );
    scope.finish(ctx.store.diagnostics$.ref());
    return SyntaxResult(parsed.take_unit(), !scope.has_errors(), scope);
}

public SyntaxResult parse_source_with_lang(
    context.CompilerContext&! ctx,
    UInt8[]& text,
    source.SourceId source_id,
    lang_registry.Registry&! registry
) {
    diagnostic.DiagnosticScope scope! = ctx.store.diagnostics.scope();
    lang_block.LangBlockStore blocks! = lang_block.LangBlockStore();
    lexer.Lexer lex! = lexer.Lexer(
        ctx.store$.mut_ref(), text, source_id, registry, blocks$.mut_ref()
    );
    lexer.LexResult lexed! = lex.tokenize();

    parser.ParseResult parsed! = parser.parse_tokens(
        ctx.store$.mut_ref(),
        lexed.tokens$.ref(),
        blocks$.mut_ref(),
        text,
        source_id
    );
    scope.finish(ctx.store.diagnostics$.ref());
    return SyntaxResult(parsed.take_unit(), !scope.has_errors(), scope);
}
