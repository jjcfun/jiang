// 标准库 hash collection 的默认哈希函数。
//
// HashMap 不公开具体哈希值或 bucket 布局；后续可以替换算法而不改变 collection API。

import core;
import system_random = "../../compiler/system/random.jiang";

UInt64 word(UInt64 high, UInt64 low) {
    return (high << 32) | low;
}

UInt64 secret1() { return word(3875765969, 2696161499); }
UInt64 secret2() { return word(2394712816, 2626209507); }
UInt64 mask32() { return 4294967295; }
UInt64 mask56() { return 72057594037927935; }
UInt64 fallback_seed() { return 15111065706836454659; }

UInt64 shift_right(UInt64 value, UInt64 amount) {
    UInt64 shifted! = value >> amount;
    if (amount == 8) { return shifted & mask56(); }
    if (amount == 32) { return shifted & mask32(); }
    return shifted;
}

UInt64 mix(UInt64 left, UInt64 right) {
    UInt64 low_mask = mask32();
    UInt64 left_low! = left & low_mask;
    UInt64 left_high! = shift_right(left, 32);
    UInt64 right_low! = right & low_mask;
    UInt64 right_high! = shift_right(right, 32);
    UInt64 product_low_low! = left_low * right_low;
    UInt64 product_low_high! = left_low * right_high;
    UInt64 product_high_low! = left_high * right_low;
    UInt64 product_high_high! = left_high * right_high;
    UInt64 carry! = shift_right(product_low_low, 32)
        + (product_low_high & low_mask)
        + (product_high_low & low_mask);
    UInt64 high! = product_high_high
        + shift_right(product_low_high, 32)
        + shift_right(product_high_low, 32)
        + shift_right(carry, 32);
    UInt64 low! = (carry << 32) | (product_low_low & low_mask);
    return high ^ low;
}

public struct TableHasher: Copyable, core.Hasher {
    UInt64 state!;
    UInt64 tail_low!;
    UInt64 tail_high!;
    Int tail_length!;
    Int byte_length!;

    public init(self, UInt64 seed) {
        self.state = mix(seed ^ UInt64(2302960717771869484), secret2());
        self.tail_low = 0;
        self.tail_high = 0;
        self.tail_length = 0;
        self.byte_length = 0;
    }

    public Void write(Self&! self, UInt8[]& bytes) {
        Int index! = 0;
        while (index < bytes.length) {
            self.write(bytes[index]);
            index = index + 1;
        }
    }

    public Void write(Self&! self, UInt8 byte) {
        UInt64 shift! = UInt64((self.tail_length % 8) * 8);
        UInt64 shifted! = UInt64(byte) << shift;
        if (self.tail_length < 8) {
            self.tail_low = self.tail_low | shifted;
        } else {
            self.tail_high = self.tail_high | shifted;
        }
        self.tail_length = self.tail_length + 1;
        self.byte_length = self.byte_length + 1;
        if (self.tail_length == 16) {
            self.write_block(self.tail_low, self.tail_high);
            self.tail_low = 0;
            self.tail_high = 0;
            self.tail_length = 0;
        }
    }

    public Void write(Self&! self, UInt64 value) {
        if (self.tail_length == 0) {
            self.tail_low = value;
            self.tail_length = 8;
            self.byte_length = self.byte_length + 8;
            return;
        }
        if (self.tail_length == 8) {
            self.tail_high = value;
            self.byte_length = self.byte_length + 8;
            self.write_block(self.tail_low, self.tail_high);
            self.tail_low = 0;
            self.tail_high = 0;
            self.tail_length = 0;
            return;
        }
        self.write(UInt8(value & 255));
        self.write(UInt8(value >> 8));
        self.write(UInt8(value >> 16));
        self.write(UInt8(value >> 24));
        self.write(UInt8(value >> 32));
        self.write(UInt8(value >> 40));
        self.write(UInt8(value >> 48));
        self.write(UInt8(value >> 56));
    }

    public UInt64 finish(self) {
        UInt64 tail_high! = self.tail_high;
        if (self.tail_length <= 8) { tail_high = secret2(); }
        return mix(
            secret1() ^ UInt64(self.byte_length),
            mix(self.tail_low ^ secret1(), tail_high ^ self.state)
        );
    }

    Void write_block(Self&! self, UInt64 left, UInt64 right) {
        self.state = mix(left ^ secret1(), right ^ self.state);
    }
}

// 为一个 hash collection 生成实例 seed；无系统 entropy 时保持可用但不承诺抗攻击随机性。
public UInt64 make_seed() {
    UInt8[8] bytes! = [0, 0, 0, 0, 0, 0, 0, 0];
    if (!system_random.fill_entropy(bytes[..])) { return fallback_seed(); }
    UInt64 result! = UInt64(0);
    Int index! = 0;
    while (index < 8) {
        result = result | (UInt64(bytes[index]) << UInt64(index * 8));
        index = index + 1;
    }
    return result;
}
