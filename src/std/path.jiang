// POSIX hosted target 的 native path byte value、builder 与纯 lexical operation。
// 本模块不把 path 当作 UTF-8，也不访问 filesystem 或解析 symlink。

import vector = "collection/vector.jiang";

// 拥有一份 native path bytes；构造会复制输入，move 会转移 storage。
public struct Path: Movable {
    UInt8[]^ bytes!;

    // 复制输入 bytes，复杂度为 O(n)。
    public init(self, UInt8[]& source) {
        vector.Vector<UInt8> storage! = vector.Vector<UInt8>(source.length);
        append_bytes(storage$.mut_ref(), source);
        self.bytes = storage.into_slice();
    }

    // 第二参数只区分 bootstrap 可识别的 internal storage-transfer constructor。
    init(self, UInt8[]^ bytes, Bool storage_transfer) {
        self.bytes = bytes;
    }

    // 返回绑定 Path storage 的 byte view，复杂度为 O(1)。
    @life(return: self)
    public UInt8[]& bytes(self) {
        return self.bytes[..];
    }

    // 返回 path 是否以 POSIX root separator 开始，复杂度为 O(1)。
    public Bool is_absolute(self) {
        return is_absolute(self.bytes());
    }

    // 返回绑定 Path storage 的 parent byte view，纯 lexical 扫描，复杂度为 O(n)。
    @life(return: self)
    public UInt8[]& dirname(self) {
        return dirname(self.bytes());
    }

    // 消耗 Path 并以 O(1) 转移 byte storage。
    public UInt8[]^ into_slice(Self self!) {
        return self.bytes;
    }
}

// 可增长的 owned path byte builder；finish 会消耗 builder。
public struct PathBuilder: Movable {
    vector.Vector<UInt8> bytes!;

    // 建立空 builder，复杂度为 O(1)。
    public init(self) {
        self.bytes = vector.Vector<UInt8>();
    }

    // 复制 base bytes，复杂度为 O(n)。
    public init(self, UInt8[]& base) {
        self.bytes = vector.Vector<UInt8>(base.length);
        append_bytes(self.bytes$.mut_ref(), base);
    }

    // 追加 relative path；absolute segment 会替换当前内容。复杂度为 O(segment.length) amortized。
    public Void append(Self&! self, UInt8[]& segment) {
        if (segment.length == 0) {
            return;
        }
        if (is_absolute(segment)) {
            self.bytes.clear();
            append_bytes(self.bytes$.mut_ref(), segment);
            return;
        }
        UInt8[]& current = self.bytes.slice();
        if (current.length > 0 && current[current.length - 1] != '/') {
            self.bytes.append(UInt8(47));
        }
        append_bytes(self.bytes$.mut_ref(), segment);
    }

    // 消耗 builder 并以 O(1) 把 storage 转移给 Path。
    public Path finish(Self self!) {
        vector.Vector<UInt8> bytes = self.bytes;
        return Path(bytes.into_slice(), true);
    }
}

// 返回 path 是否以 POSIX root separator 开始，复杂度为 O(1)。
public Bool is_absolute(UInt8[]& path) {
    return path.length > 0 && path[0] == '/';
}

// 按 byte 比较两条 path，复杂度为 O(n)。
public Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// 返回绑定输入的 parent byte view；无 separator 时为空，root 的 parent 仍为 root。
@life(return: path)
public UInt8[]& dirname(UInt8[]& path) {
    Int slash! = -1;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            slash = index;
        }
        index = index + 1;
    }
    if (slash < 0) {
        return "";
    }
    if (slash == 0) {
        return "/";
    }
    return path[0..slash];
}

// lexical join；空 relative 保留 base，absolute relative 替换 base，复杂度为 O(n)。
public Path join(UInt8[]& base, UInt8[]& relative) {
    if (relative.length == 0) {
        return Path(base);
    }
    if (is_absolute(relative)) {
        return Path(relative);
    }
    if (base.length == 0) {
        return Path(relative);
    }
    PathBuilder builder! = PathBuilder(base);
    builder.append(relative);
    return builder.finish();
}

// 返回 basename 是否有非空 extension；basename 的 leading dot 不算 extension。
public Bool has_extension(UInt8[]& path) {
    guard extension_dot(path) is .some(dot) else { return false; }
    return dot < path.length - 1;
}

// 替换 basename extension；extension 不带 leading dot/separator，空值表示删除。
public Path with_extension(UInt8[]& path, UInt8[]& extension) {
    assert(valid_extension(extension));
    Int base_end! = path.length;
    if (extension_dot(path) is .some(dot)) { base_end = dot; }
    Int extra! = extension.length;
    if (extension.length > 0) { extra = extra + 1; }
    vector.Vector<UInt8> bytes! = vector.Vector<UInt8>(base_end + extra);
    append_bytes(bytes$.mut_ref(), path[0..base_end]);
    if (extension.length > 0) {
        bytes.append(UInt8(46));
        append_bytes(bytes$.mut_ref(), extension);
    }
    return Path(bytes.into_slice(), true);
}

// lexical normalize separator、`.` 与 `..`；不访问 filesystem 或解析 symlink，复杂度为 O(n)。
public Path normalize(UInt8[]& input) {
    if (input.length == 0) {
        return Path(input);
    }
    UInt8[]^ bytes = normalized(input);
    return Path(bytes, true);
}

UInt8[]^ normalized(UInt8[]& input) {
    unsafe {
        Bool absolute = is_absolute(input);
        UInt8*! bytes = unsafe {
            UInt8$.alloc(input.length + 1)
        };
        Int write! = 0;
        if (absolute) {
            bytes[0] = '/';
            write = 1;
        }

        Int index! = 0;
        while (index < input.length) {
            while (index < input.length && input[index] == '/') {
                index = index + 1;
            }
            Int segment_start = index;
            while (index < input.length && input[index] != '/') {
                index = index + 1;
            }
            Int segment_len = index - segment_start;
            if (segment_len == 0 || segment_is(input, segment_start, segment_len, ".")) {
                continue;
            }
            if (segment_is(input, segment_start, segment_len, "..")) {
                if (can_pop_segment(bytes, write, absolute)) {
                    write = pop_segment(bytes, write);
                } else if (!absolute) {
                    write = append_segment(bytes, write, input, segment_start, segment_len);
                }
                continue;
            }
            write = append_segment(bytes, write, input, segment_start, segment_len);
        }

        if (absolute && write == 0) {
            bytes[0] = '/';
            write = 1;
        }
        return bytes[0..write]$.as(UInt8[]^);
    }
}

Void append_bytes(vector.Vector<UInt8>&! bytes, UInt8[]& text) {
    Int index! = 0;
    while (index < text.length) {
        bytes.append(text[index]);
        index = index + 1;
    }
}

Bool segment_is(UInt8[]& input, Int start, Int len, UInt8[]& expected) {
    if (len != expected.length) {
        return false;
    }
    Int index! = 0;
    while (index < len) {
        if (input[start + index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int? extension_dot(UInt8[]& path) {
    Int basename_start! = 0;
    Int? result! = null;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            basename_start = index + 1;
            result = null;
        } else if (path[index] == '.' && index > basename_start) {
            result = index;
        }
        index = index + 1;
    }
    return result;
}

Bool valid_extension(UInt8[]& extension) {
    if (extension.length > 0 && extension[0] == '.') { return false; }
    Int index! = 0;
    while (index < extension.length) {
        if (extension[index] == '/') { return false; }
        index = index + 1;
    }
    return true;
}

Int append_segment(UInt8*! bytes, Int write, UInt8[]& input, Int start, Int len) {
    unsafe {
        Int out! = write;
        if (out > 0 && bytes[out - 1] != '/') {
            bytes[out] = '/';
            out = out + 1;
        }
        Int index! = 0;
        while (index < len) {
            bytes[out] = input[start + index];
            out = out + 1;
            index = index + 1;
        }
        return out;
    }
}

Bool can_pop_segment(UInt8*! bytes, Int write, Bool absolute) {
    if (write == 0) {
        return false;
    }
    if (absolute && write == 1) {
        return false;
    }
    return !last_segment_is_dot_dot(bytes, write, absolute);
}

Bool last_segment_is_dot_dot(UInt8*! bytes, Int write, Bool absolute) {
    unsafe {
        Int start! = write - 1;
        while (start >= 0 && bytes[start] != '/') {
            start = start - 1;
        }
        start = start + 1;
        if (write - start != 2) {
            return false;
        }
        return bytes[start] == '.' && bytes[start + 1] == '.';
    }
}

Int pop_segment(UInt8*! bytes, Int write) {
    unsafe {
        Int out! = write - 1;
        while (out >= 0 && bytes[out] != '/') {
            out = out - 1;
        }
        if (out < 0) {
            return 0;
        }
        return out;
    }
}
