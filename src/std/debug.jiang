// 面向普通程序的最小 debug 工具。
//
// 输出复用标准 stderr，主动 trap 复用 system provider。
// 本模块不承担错误恢复、debugger 或 profiler。

import io = "../compiler/system/io.jiang";
import abort = "../compiler/system/abort.jiang";

// 向 stderr 写入 message；成功完整写入时返回 true，复杂度为 O(n)。
public Bool write(UInt8[]& message) {
    return io.stderr().write_all(message);
}

// 向 stderr 写入 message 和换行；任一步失败时返回 false，复杂度为 O(n)。
public Bool write_line(UInt8[]& message) {
    if (!write(message)) {
        return false;
    }
    return write("\n");
}

// 通过当前 target 的 debug trap provider 立即终止；不 unwind，也不保证析构。
public Void trap() {
    abort.trap();
}
