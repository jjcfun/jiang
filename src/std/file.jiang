// `std.fs` 与 `std.io` 共用的公开 File value。

import system_fs = "../compiler/system/fs.jiang";

// 文件操作的可移植错误分类，不公开 errno。
public alias FileError = system_fs.FileError;
// 文件大小和修改时间 metadata。
public alias FileMetadata = system_fs.FileMetadata;

// 打开文件或进程 stream handle 的唯一 owner；move 转移所有权。
public struct File: Movable {
    system_fs.File handle!;

    init(self, system_fs.File handle) {
        self.handle = handle;
    }

    // 作用域退出时自动关闭 owned handle。deinit 不能传播 close error，因此这里只执行
    // best-effort close；需要观察关闭失败时，调用方应提前显式调用 close()。
    // system File 的 close 是幂等的，随后字段析构再次触发 close 也不会重复关闭 fd。
    deinit(self) {
        self.handle.close();
    }

    // 返回当前 value 是否仍含可用 handle，复杂度为 O(1)。
    public Bool is_open(self) {
        return self.handle.is_open();
    }

    // 把完整文件读入独立 owned bytes，复杂度为 O(file size)。
    public UInt8[]^@FileError read_all(self) {
        self.handle.read_all_owned()
    }

    // 从 offset 读取恰好 length 个 byte 到独立 owned bytes，复杂度为 O(length)。
    public UInt8[]^@FileError read_at(self, Int offset, Int length) {
        self.handle.read_at_owned(offset, length)
    }

    // 写入全部 byte，失败时返回可移植 FileError。
    public Void@FileError write_all(self, UInt8[]& bytes) {
        self.handle.write_all_checked(bytes)
    }

    // 返回已打开文件的大小和修改时间。
    public FileMetadata@FileError metadata(self) {
        self.handle.metadata_checked()
    }

    // 显式关闭并让当前 value 失效；重复 close 成功，provider close 失败时返回错误。
    // 无论 provider 是否报告失败，handle 都不会再次参与 IO 或被二次关闭。
    public Void@FileError close(Self&! self) {
        self.handle.close_checked()
    }
}

// 把内部 handle 转成 std facade；只供 std 模块边界使用。
public File wrap(system_fs.File handle) {
    return File(handle);
}
