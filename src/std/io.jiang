/// 将格式化结果与换行一起写出，stdout 的借用 handle 不会关闭进程流。
Void write_print_line(string.StringBuilder output!) {
    output.append("\n");
    Void written = try stdout().write_all(output.slice()) catch {
        panic_impl.panic("print failed to write to stdout");
    };
}
