#doc(module)
    hosted 程序的标准进程流与单值 print；格式化复用 StringBuilder，输出到 stdout。
#end

alias file = import "file.jiang";
alias string = import "string.jiang";
alias format = import "format.jiang";
alias panic_impl = import "panic.jiang";
alias system_io = import "../compiler/system/io.jiang";

/// 返回非 owning stdout handle；close 只让返回的 File value 失效。
public file.File stdout() {
    return file.wrap(system_io.stdout());
}

/// 返回非 owning stderr handle；close 只让返回的 File value 失效。
public file.File stderr() {
    return file.wrap(system_io.stderr());
}

/// 借用自定义值，使用其 Formattable 实现输出文本，并在末尾添加换行。
@where(T: format.Formattable)
public Void print<T>(T& value) {
    string.StringBuilder output! = string.StringBuilder();
    value.format(output$.mut_ref());
    write_print_line(output);
}

/// 将 bytes 容错解码为 UTF-8 文本后输出并换行；无效序列替换为 U+FFFD。
public Void print(UInt8[]& value) {
    string.StringBuilder output! = string.StringBuilder();
    output.append_utf8_lossy(value);
    write_print_line(output);
}

/// 将单个值输出到 stdout，并在末尾添加换行；输出失败时 panic。
public Void print(string.String& value) {
    string.StringBuilder output! = string.StringBuilder();
    output.append(value);
    write_print_line(output);
}

/// 消费 owned String 并输出；可直接接收字符串插值产生的临时结果。
public Void print(string.String value) {
    string.StringBuilder output! = string.StringBuilder();
    output.append(value$.ref());
    write_print_line(output);
}

/// 将单个值输出到 stdout，并在末尾添加换行；输出失败时 panic。
public Void print(Bool value) {
    string.StringBuilder output! = string.StringBuilder();
