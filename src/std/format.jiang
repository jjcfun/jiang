#doc(module)
    用户类型向 StringBuilder 追加文本的格式化协议，供 print 等标准库输出接口复用。
#end

alias string = import "string.jiang";

/// 类型通过 format 把文本追加到调用方拥有的 builder。
public trait Formattable {
    Void format(self, string.StringBuilder&! out);
}

/// 公开格式化目标类型，避免实现者依赖内部模块路径。
public alias StringBuilder = string.StringBuilder;
