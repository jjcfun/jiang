// 标准库 collection 的稳定入口。
//
// 常用 Vector 同时由 std.Vector 直接导出；其余容器通过 std.collection 组织。

alias vector = import "collection/vector.jiang";
alias iterator = import "collection/iterator.jiang";
alias map = import "collection/map.jiang";
alias set = import "collection/set.jiang";

public alias Vector = vector.Vector;
public alias SliceIterator = iterator.SliceIterator;
public alias HashMap = map.HashMap;
public alias HashMapIterator = map.HashMapIterator;
public alias HashMapKeyIterator = map.HashMapKeyIterator;
public alias HashSet = set.HashSet;
public alias HashSetIterator = map.HashMapKeyIterator;
