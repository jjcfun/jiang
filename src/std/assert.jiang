// `assert` 的失败输出实现。public import 保证该 helper 对每个程序均可用，
// backend 只依赖稳定 link symbol，不依赖当前 codegen unit 的 JIL 顺序。

import io = "../compiler/system/io.jiang";

@link_symbol("__jiang_assert_fail")
public Void assert_fail(UInt8* location, UInt8* message) {
    write_c_string(location);
    if (unsafe { message[0] != 0 }) {
        io.stderr().write_all(": ");
        write_c_string(message);
    }
    io.stderr().write_all("\n");
}

Void write_c_string(UInt8* text) {
    unsafe {
        Int length! = 0;
        while (text[length] != 0) {
            length = length + 1;
        }
        io.stderr().write_all(text[0..length]);
    }
}
