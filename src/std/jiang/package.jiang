#doc(module)
    包声明的可物化数据；构造与读取使用普通常量语义，不持有编译器模块或 Provider 实例。
#end

public enum PackageType {
    lib,
    bin,
    lang,
}

@region(a)
public struct PackageDependency: Copyable {
    @life(a)
    public UInt8[]& name;
    @life(a)
    public UInt8[]& path;
}

@region(a)
public struct PackageLang: Copyable {
    @life(a)
    public UInt8[]& name;
    @life(a)
    public UInt8[]& package = "";
    @life(a, a)
    public UInt8[]&[]& extensions = empty_extensions[..];
}

@region(a)
public struct PackageGenerate: Copyable {
    @life(a)
    public UInt8[]& name;
    @life(a)
    public UInt8[]& package = "";
    @life(a)
    public UInt8[]& module = "";
}

@region(a)
public struct PackageInfo: Copyable {
    @life(a)
    public UInt8[]& name = "";
    @life(a)
    public UInt8[]& version = "";
    public PackageType type = .lib;
    @life(a)
    public UInt8[]& root = "";
    @life(a, a)
    public PackageDependency[]& dependencies = empty_dependencies[..];
    @life(a, a)
    public PackageLang[]& lang = empty_lang[..];
    @life(a, a)
    public PackageGenerate[]& generate = empty_generate[..];
}

const UInt8[]&[0] empty_extensions = [];
const PackageDependency[0] empty_dependencies = [];
const PackageLang[0] empty_lang = [];
const PackageGenerate[0] empty_generate = [];
