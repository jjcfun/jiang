// UTF-8 helpers shared by Jiang-facing syntax tools.
//
// This module only handles UTF-8 byte/scalar operations. Jiang identifier
// rules live in ident.jiang and use the generated XID tables.

public Bool is_utf8_lead(UInt8 value) {
    return value >= 194 && value <= 244;
}

public Bool is_utf8_continue(UInt8 value) {
    return value >= 128 && value <= 191;
}

public Int utf8_len(UInt8 first) {
    if (first >= 194 && first <= 223) { return 2; }
    if (first >= 224 && first <= 239) { return 3; }
    if (first >= 240 && first <= 244) { return 4; }
    return 0;
}

public Int utf8_len_at(UInt8[]& text, Int index) {
    if (index >= text.length) { return 0; }
    return utf8_len(text[index]);
}

public Bool is_valid_utf8_at(UInt8[]& text, Int index) {
    if (index >= text.length) { return false; }

    UInt8 first = text[index];
    Int length! = utf8_len(first);
    if (length == 0 || index + length > text.length) { return false; }

    UInt8 second = text[index + 1];
    if (!is_utf8_continue(second)) { return false; }
    if (length == 2) { return true; }

    if (first == 224 && second < 160) { return false; }
    if (first == 237 && second > 159) { return false; }
    if (first == 240 && second < 144) { return false; }
    if (first == 244 && second > 143) { return false; }

    UInt8 third = text[index + 2];
    if (!is_utf8_continue(third)) { return false; }
    if (length == 3) { return true; }

    return is_utf8_continue(text[index + 3]);
}

public Int utf8_scalar_at(UInt8[]& text, Int index) {
    UInt8 first = text[index];
    Int length! = utf8_len(first);

    if (length == 2) {
        return ((Int(first) & 31) << 6) |
            (Int(text[index + 1]) & 63);
    }
    if (length == 3) {
        return ((Int(first) & 15) << 12) |
            ((Int(text[index + 1]) & 63) << 6) |
            (Int(text[index + 2]) & 63);
    }
    if (length == 4) {
        return ((Int(first) & 7) << 18) |
            ((Int(text[index + 1]) & 63) << 12) |
            ((Int(text[index + 2]) & 63) << 6) |
            (Int(text[index + 3]) & 63);
    }
    return -1;
}
