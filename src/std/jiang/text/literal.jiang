// Literal text decoding shared by Jiang tokenizer and parser-side generated
// string segments.

public UInt8[]& unescape(UInt8[]& text) {
    unsafe {
        if (!has_escape(text)) {
            return text;
        }
        UInt8*! buffer = unsafe {
            UInt8$.alloc(text.length)
        };
        Int read! = 0;
        Int write! = 0;
        while (read < text.length) {
            if (text[read] != '\\') {
                buffer[write] = text[read];
                read = read + 1;
                write = write + 1;
                continue;
            }
            if (is_escaped_newline(text, read)) {
                read = skip_escaped_newline(text, read);
                continue;
            }
            if (is_unicode_escape(text, read)) {
                Int scalar = unicode_escape_scalar(text, read);
                write = write_utf8_scalar(buffer, write, scalar);
                read = unicode_escape_end(text, read);
                continue;
            }
            buffer[write] = escape_value(text[read + 1]);
            read = read + 2;
            write = write + 1;
        }
        return buffer[0..write];
    }
}

public Bool has_escape(UInt8[]& text) {
    Int index! = 0;
    while (index < text.length) {
        if (text[index] == '\\') {
            return true;
        }
        index = index + 1;
    }
    return false;
}

public Bool is_unicode_escape(UInt8[]& text, Int index) {
    return index + 2 < text.length && text[index + 1] == 'u' && text[index + 2] == '{';
}

public Bool valid_unicode_scalar(Int scalar) {
    if (scalar > 1114111) { return false; }
    return scalar < 55296 || scalar > 57343;
}

public Int hex_value(UInt8 byte) {
    if (byte >= '0' && byte <= '9') { return Int(byte - '0'); }
    if (byte >= 'a' && byte <= 'f') { return Int(byte - 'a') + 10; }
    if (byte >= 'A' && byte <= 'F') { return Int(byte - 'A') + 10; }
    return -1;
}

Bool is_escaped_newline(UInt8[]& text, Int index) {
    if (index + 1 >= text.length) { return false; }
    UInt8 next = text[index + 1];
    return next == '\n' || next == '\r';
}

Int skip_escaped_newline(UInt8[]& text, Int index) {
    Int next! = index + 2;
    if (text[index + 1] == '\r' && next < text.length && text[next] == '\n') {
        next = next + 1;
    }
    while (next < text.length && is_string_continuation_space(text[next])) {
        next = next + 1;
    }
    return next;
}

Bool is_string_continuation_space(UInt8 byte) {
    return byte == ' ' || byte == '\t';
}

Int unicode_escape_scalar(UInt8[]& text, Int index) {
    Int read! = index + 3;
    Int value! = 0;
    while (read < text.length && text[read] != '}') {
        value = (value << 4) + hex_value(text[read]);
        read = read + 1;
    }
    return value;
}

Int unicode_escape_end(UInt8[]& text, Int index) {
    Int read! = index + 3;
    while (read < text.length && text[read] != '}') {
        read = read + 1;
    }
    return read + 1;
}

Int write_utf8_scalar(UInt8*! buffer, Int write, Int scalar) {
    unsafe {
        if (scalar <= 127) {
            buffer[write] = UInt8(scalar);
            return write + 1;
        }
        if (scalar <= 2047) {
            buffer[write] = UInt8(192 | (scalar >> 6));
            buffer[write + 1] = UInt8(128 | (scalar & 63));
            return write + 2;
        }
        if (scalar <= 65535) {
            buffer[write] = UInt8(224 | (scalar >> 12));
            buffer[write + 1] = UInt8(128 | ((scalar >> 6) & 63));
            buffer[write + 2] = UInt8(128 | (scalar & 63));
            return write + 3;
        }
        buffer[write] = UInt8(240 | (scalar >> 18));
        buffer[write + 1] = UInt8(128 | ((scalar >> 12) & 63));
        buffer[write + 2] = UInt8(128 | ((scalar >> 6) & 63));
        buffer[write + 3] = UInt8(128 | (scalar & 63));
        return write + 4;
    }
}

UInt8 escape_value(UInt8 value) {
    if (value == 'n') { return UInt8(10); }
    if (value == 'r') { return UInt8(13); }
    if (value == 't') { return UInt8(9); }
    if (value == '0') { return UInt8(0); }
    if (value == '"') { return UInt8(34); }
    if (value == '\'') { return UInt8(39); }
    return UInt8(92);
}
