#doc(module)
    一次自定义语法调用的固定地址 capability；provider 借用上下文访问诊断与共享符号表。
#end

alias source = import "source.jiang";
alias abi = import "abi.jiang";

public alias Delimiter = abi.Delimiter;
public alias ScanResult = abi.ScanResult;
public alias Input = abi.Input;
public alias SyntaxDiagnosticKind = abi.SyntaxDiagnosticKind;
public alias SyntaxCallbacks = abi.SyntaxContext;

public alias intern = abi.intern;

#doc 不需要语言级数据的 Provider 使用空上下文。
public struct EmptyLangContext: Copyable {
    public init(self) {}
}

#doc 每次扫描或解析借用块级回调和语言级只读数据；两者均由宿主持有。
@region(c, l)
public struct SyntaxContext<L>: !Movable {
    @life(c)
    public SyntaxCallbacks& syntax;
    @life(l)
    public L& lang;

    public init(self, SyntaxCallbacks& syntax, L& lang) {
        self.syntax = syntax;
        self.lang = lang;
    }
}
