// SyntaxContext 是一次 custom syntax invocation 的固定地址 capability。
// provider 只能借用它；raw callback 构造入口仅供 compiler 建立 ABI 边界。

import source = "source.jiang";
import abi = "abi.jiang";

public alias Delimiter = abi.Delimiter;
public alias ScanResult = abi.ScanResult;
public alias Input = abi.Input;
public alias SyntaxDiagnosticKind = abi.SyntaxDiagnosticKind;
public alias SyntaxContext = abi.SyntaxContext;
