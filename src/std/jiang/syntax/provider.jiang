#doc(module)
    Provider 声明语言上下文与块级解析行为；Invocation 是宿主调用的类型擦除接口。
#end

alias context = import "context.jiang";
alias abi = import "abi.jiang";
alias parser = import "parser.jiang";
alias token = import "token.jiang";
alias vector = import "../../collection/vector.jiang";

alias session = import "session.jiang";

public trait Provider {
    associated LangContext = context.EmptyLangContext;

    @life()
    @where(LangContext == context.EmptyLangContext)
    LangContext create_context(session.Session& session) {
        return context.EmptyLangContext();
    }

    context.ScanResult scan(
        Self&! self, context.Input input, context.SyntaxContext<LangContext>& syntax
    ) {
        return scan_default(syntax.syntax, input);
    }

    parser.Ast parse(
        Self&! self, context.Input input, context.SyntaxContext<LangContext>& syntax
    );
}

public trait Invocation {
    context.ScanResult scan(
        Self&! self,
        context.Input input,
        context.SyntaxCallbacks&! syntax
    ) {
        return scan_default(syntax, input);
    }

    parser.Ast parse(
        Self&! self,
        context.Input input,
        context.SyntaxCallbacks&! syntax
    );
}

public context.ScanResult scan_default(
    context.SyntaxCallbacks& syntax,
    context.Input input
) {
    return abi.scan_default(syntax, input);
}

public vector.Vector<token.Token<token.TokenKind>> take_scanned_tokens(
    context.SyntaxCallbacks& syntax
) {
    return abi.take_default_tokens(syntax);
}

#doc 宿主持有语言级对象，通过它为各块创建独立的 Invocation。
public trait Language {
    @life()
    unsafe Invocation.Any^ create(self);
}

#doc 包装具体 Provider 及其关联上下文；宿主保证语言对象晚于所有块释放。
@where(P: Provider<LangContext = L>)
public struct LanguageAdapter<P, L>: Movable, Language {
    L lang;
    RawFn<P> constructor;

    public init(self, L lang, RawFn<P> constructor) {
        self.lang = lang;
        self.constructor = constructor;
    }

    @life()
    public unsafe Invocation.Any^ create(self) {
        _ constructor = self.constructor;
        L& value = self.lang$.ref();
        L* lang = unsafe { value$.ptr()$.as(L*) };
        return Invocation$.new(InvocationAdapter<P, L>(constructor(), lang));
    }
}

@where(P: Provider<LangContext = L>)
struct InvocationAdapter<P, L>: Movable, Invocation {
    P provider!;
    @life()
    L* lang;

    init(self, P provider, L* lang) {
        self.provider = provider;
        self.lang = lang;
    }

    public context.ScanResult scan(
        Self&! self, context.Input input, context.SyntaxCallbacks&! syntax
    ) {
        L& lang = unsafe { self.lang$.as(L&) };
        context.SyntaxContext<L> call = context.SyntaxContext<L>(syntax, lang);
        return self.provider.scan(input, call$.ref());
    }

    public parser.Ast parse(
        Self&! self, context.Input input, context.SyntaxCallbacks&! syntax
    ) {
        L& lang = unsafe { self.lang$.as(L&) };
        context.SyntaxContext<L> call = context.SyntaxContext<L>(syntax, lang);
        return self.provider.parse(input, call$.ref());
    }
}

public context.ScanResult scan_default<L>(context.SyntaxContext<L>& syntax, context.Input input) {
    return abi.scan_default(syntax.syntax, input);
}

public vector.Vector<token.Token<token.TokenKind>> take_scanned_tokens<L>(context.SyntaxContext<L>& syntax) {
    return abi.take_default_tokens(syntax.syntax);
}
