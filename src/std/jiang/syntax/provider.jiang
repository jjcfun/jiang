import context = "context.jiang";
import abi = "abi.jiang";
import parser = "parser.jiang";

public trait Provider {
    context.ScanResult scan(
        Self&! self,
        context.Input input,
        context.SyntaxContext&! syntax
    ) {
        return scan_default(syntax, input);
    }

    parser.Expansion parse(
        Self&! self,
        context.Input input,
        context.ExpansionKind expected,
        context.SyntaxContext&! syntax
    );
}

public context.ScanResult scan_default(
    context.SyntaxContext& syntax,
    context.Input input
) {
    return abi.scan_default(syntax, input);
}
