import context = "context.jiang";
import abi = "abi.jiang";
import parser = "parser.jiang";
import token = "token.jiang";
import vector = "../../collection/vector.jiang";

public trait Provider {
    context.ScanResult scan(
        Self&! self,
        context.Input input,
        context.SyntaxContext&! syntax
    ) {
        return scan_default(syntax, input);
    }

    parser.Ast parse(
        Self&! self,
        context.Input input,
        context.SyntaxContext&! syntax
    );
}

public context.ScanResult scan_default(
    context.SyntaxContext& syntax,
    context.Input input
) {
    return abi.scan_default(syntax, input);
}

public vector.Vector<token.Token<token.TokenKind>> take_scanned_tokens(
    context.SyntaxContext& syntax
) {
    return abi.take_default_tokens(syntax);
}
