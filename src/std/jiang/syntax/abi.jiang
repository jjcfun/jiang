#doc(module)
    自定义语法的回调边界，向 provider 暴露编译器持有的扫描、符号表及 AST 构造能力。
#end

alias source = import "source.jiang";
alias vector = import "../../collection/vector.jiang";
alias token = import "token.jiang";
alias symbol = import "symbol.jiang";

public enum Delimiter: Copyable {
    none,
    line,
    terminated,
    brace,
    paren,
    bracket,
}

public struct ScanResult: Copyable {
    public enum Status: Copyable {
        ok,
        error,
    }

    public Status status;
    public source.Span body_span;

    public init(self, Status status, source.Span body_span) {
        self.status = status;
        self.body_span = body_span;
    }

    public ScanResult ok(source.Span body_span) {
        return ScanResult(.ok, body_span);
    }

    public ScanResult error(source.Span body_span) {
        return ScanResult(.error, body_span);
    }
}

@region(a)
public struct Input: Copyable {
    @life(a)
    public source.Source source;

    public source.Span name_span;
    public Int body_start;
    public Delimiter delimiter;

    public init(
        self,
        source.Source source,
        source.Span name_span,
        Int body_start,
        Delimiter delimiter
    ) {
        self.source = source;
        self.name_span = name_span;
        self.body_start = body_start;
        self.delimiter = delimiter;
    }
}

public enum SyntaxDiagnosticKind: Copyable {
    expected_token,
    expected_identifier,
    expected_literal,
    expected_keyword,
    invalid_character,
    invalid_escape,
    unterminated_string,
    unterminated_comment,
    invalid_number,
    doc_expected_module_target,
    doc_expected_separator,
    doc_empty_body,
    doc_requires_line_or_terminated_delimiter,
    doc_unterminated_block,
    inline_asm_missing_code,
    inline_asm_requires_brace_delimiter,
    inline_asm_unterminated_block,
    syntax_error,
}

public struct SyntaxContext: !Movable {
    Void* state;
    RawFn<symbol.SymbolId, Void*, UInt8[]&>? intern_callback;
    RawFn<ScanResult, Void*, Input> default_scan_callback;
    RawFn<vector.Vector<token.Token<token.TokenKind>>, Void*> take_default_tokens_callback;
    RawFn<Void, Void*, SyntaxDiagnosticKind, source.Span, UInt8[]&> add_diagnostic_callback;
    RawFn<Int, Void*> diagnostic_mark_callback;
    RawFn<Void, Void*, Int> rewind_diagnostics_callback;
    RawFn<Int, Void*, Int, source.Span, Int[]&, UInt8[]&> add_node_callback;
    RawFn<Int, Void*> mark_children_callback;
    RawFn<Void, Void*, Int> add_child_callback;
    RawFn<Bool, Void*, Int, Int> finish_callback;
    RawFn<Int, Void*, Int, source.Source, token.Token<token.TokenKind>[]&, Int&!>
        parse_fragment_callback;

    public init(
        self,
        Void* state,
        RawFn<ScanResult, Void*, Input> default_scan_callback,
        RawFn<vector.Vector<token.Token<token.TokenKind>>, Void*> take_default_tokens_callback,
        RawFn<Void, Void*, SyntaxDiagnosticKind, source.Span, UInt8[]&> add_diagnostic_callback,
        RawFn<Int, Void*> diagnostic_mark_callback,
        RawFn<Void, Void*, Int> rewind_diagnostics_callback,
        RawFn<Int, Void*, Int, source.Span, Int[]&, UInt8[]&> add_node_callback,
        RawFn<Int, Void*> mark_children_callback,
        RawFn<Void, Void*, Int> add_child_callback,
        RawFn<Bool, Void*, Int, Int> finish_callback,
        RawFn<symbol.SymbolId, Void*, UInt8[]&>? intern_callback = null
    ) {
        self.state = state;
        self.intern_callback = intern_callback;
        self.default_scan_callback = default_scan_callback;
        self.take_default_tokens_callback = take_default_tokens_callback;
        self.add_diagnostic_callback = add_diagnostic_callback;
        self.diagnostic_mark_callback = diagnostic_mark_callback;
        self.rewind_diagnostics_callback = rewind_diagnostics_callback;
        self.add_node_callback = add_node_callback;
        self.mark_children_callback = mark_children_callback;
        self.add_child_callback = add_child_callback;
        self.finish_callback = finish_callback;
        self.parse_fragment_callback = unavailable_fragment;
    }

    public init(
        self,
        Void* state,
        RawFn<ScanResult, Void*, Input> default_scan_callback,
        RawFn<vector.Vector<token.Token<token.TokenKind>>, Void*> take_default_tokens_callback,
        RawFn<Void, Void*, SyntaxDiagnosticKind, source.Span, UInt8[]&> add_diagnostic_callback,
        RawFn<Int, Void*> diagnostic_mark_callback,
        RawFn<Void, Void*, Int> rewind_diagnostics_callback,
        RawFn<Int, Void*, Int, source.Span, Int[]&, UInt8[]&> add_node_callback,
        RawFn<Int, Void*> mark_children_callback,
        RawFn<Void, Void*, Int> add_child_callback,
        RawFn<Bool, Void*, Int, Int> finish_callback,
        RawFn<Int, Void*, Int, source.Source, token.Token<token.TokenKind>[]&, Int&!>
            parse_fragment_callback,
        RawFn<symbol.SymbolId, Void*, UInt8[]&>? intern_callback = null
    ) {
        self.state = state;
        self.intern_callback = intern_callback;
        self.default_scan_callback = default_scan_callback;
        self.take_default_tokens_callback = take_default_tokens_callback;
        self.add_diagnostic_callback = add_diagnostic_callback;
        self.diagnostic_mark_callback = diagnostic_mark_callback;
        self.rewind_diagnostics_callback = rewind_diagnostics_callback;
        self.add_node_callback = add_node_callback;
        self.mark_children_callback = mark_children_callback;
        self.add_child_callback = add_child_callback;
        self.finish_callback = finish_callback;
        self.parse_fragment_callback = parse_fragment_callback;
    }
}

#doc 在当前编译器符号表中驻留文本；符号 ID 仅可在同一符号表内比较。
public symbol.SymbolId intern(SyntaxContext& syntax, UInt8[]& text) {
    assert(syntax.intern_callback != null, "syntax context does not provide symbol interning");
    _ callback = syntax.intern_callback$.some();
    return callback(syntax.state, text);
}

Int unavailable_fragment(
    Void* state,
    Int kind,
    source.Source source,
    token.Token<token.TokenKind>[]& tokens,
    Int&! current
) {
    return -1;
}

public ScanResult scan_default(SyntaxContext& syntax, Input input) {
    RawFn<ScanResult, Void*, Input> callback = syntax.default_scan_callback;
    return callback(syntax.state, input);
}

public vector.Vector<token.Token<token.TokenKind>> take_default_tokens(
    SyntaxContext& syntax
) {
    RawFn<vector.Vector<token.Token<token.TokenKind>>, Void*> callback =
        syntax.take_default_tokens_callback;
    return callback(syntax.state);
}

public Void add_diagnostic(
    SyntaxContext& syntax,
    SyntaxDiagnosticKind kind,
    source.Span span,
    UInt8[]& message = ""
) {
    RawFn<Void, Void*, SyntaxDiagnosticKind, source.Span, UInt8[]&> callback =
        syntax.add_diagnostic_callback;
    callback(syntax.state, kind, span, message);
}

public Int diagnostic_mark(SyntaxContext& syntax) {
    RawFn<Int, Void*> callback = syntax.diagnostic_mark_callback;
    return callback(syntax.state);
}

public Void rewind_diagnostics(SyntaxContext& syntax, Int mark) {
    assert(mark >= 0);
    RawFn<Void, Void*, Int> callback = syntax.rewind_diagnostics_callback;
    callback(syntax.state, mark);
}

public Int parse_fragment(
    SyntaxContext& syntax,
    Int kind,
    source.Source source,
    token.Token<token.TokenKind>[]& tokens,
    Int&! current
) {
    RawFn<Int, Void*, Int, source.Source, token.Token<token.TokenKind>[]&, Int&!>
        callback = syntax.parse_fragment_callback;
    return callback(syntax.state, kind, source, tokens, current);
}

public Int add_node(
    SyntaxContext& syntax,
    Int operation,
    source.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    RawFn<Int, Void*, Int, source.Span, Int[]&, UInt8[]&> callback = syntax.add_node_callback;
    Int node_id = callback(syntax.state, operation, span, arguments, text);
    assert(node_id >= 0);
    return node_id;
}

public Int mark_children(SyntaxContext& syntax) {
    RawFn<Int, Void*> callback = syntax.mark_children_callback;
    return callback(syntax.state);
}

public Void add_child(SyntaxContext& syntax, Int node_id) {
    RawFn<Void, Void*, Int> callback = syntax.add_child_callback;
    callback(syntax.state, node_id);
}

public Void* identity(SyntaxContext& syntax) {
    return unsafe { syntax$.ptr()$.as(Void*) };
}

public Bool finish(SyntaxContext& syntax, Int node_id, Int role) {
    RawFn<Bool, Void*, Int, Int> callback = syntax.finish_callback;
    return callback(syntax.state, node_id, role);
}
