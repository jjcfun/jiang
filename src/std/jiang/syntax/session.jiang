#doc(module)
    语言上下文初始化时借用的编译会话能力；intern 与当前宿主的 token 共用符号表。
#end

alias symbol = import "symbol.jiang";

public struct Session: !Movable {
    Void* state;
    RawFn<symbol.SymbolId, Void*, UInt8[]&> intern_callback;

    public init(self, Void* state, RawFn<symbol.SymbolId, Void*, UInt8[]&> intern_callback) {
        self.state = state;
        self.intern_callback = intern_callback;
    }

    public symbol.SymbolId intern(self, UInt8[]& text) {
        _ callback = self.intern_callback;
        return callback(self.state, text);
    }
}
