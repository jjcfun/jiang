alias context = import "context.jiang";
alias abi = import "abi.jiang";
alias source = import "source.jiang";

// 发出 compiler 已知的 syntax 诊断；message 仅用于需要补充上下文的场景。
public Void report(
    context.SyntaxCallbacks& syntax,
    context.SyntaxDiagnosticKind kind,
    source.Span span,
    UInt8[]& message = ""
) {
    abi.add_diagnostic(syntax, kind, span, message);
}

public Void report<L>(
    context.SyntaxContext<L>& syntax,
    context.SyntaxDiagnosticKind kind,
    source.Span span,
    UInt8[]& message = ""
) {
    abi.add_diagnostic(syntax.syntax, kind, span, message);
}
