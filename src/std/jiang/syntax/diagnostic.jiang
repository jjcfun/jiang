import context = "context.jiang";
import abi = "abi.jiang";
import source = "source.jiang";

// 发出 compiler 已知的 syntax 诊断；message 仅用于需要补充上下文的场景。
public Void report(
    context.SyntaxContext& syntax,
    context.SyntaxDiagnosticKind kind,
    source.Span span,
    UInt8[]& message = ""
) {
    abi.add_diagnostic(syntax, kind, span, message);
}
