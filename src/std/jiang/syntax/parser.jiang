    }

    Int add_lambda_parameter_children(Self&! self, LambdaParameter[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            LambdaParameter value = values[index];
            self.require_handle(value.id.context_id, value.id.node_id);
            self.add_child(value.id.node_id);
            index = index + 1;
        }
        return start;
    }

    Int add_lambda_capture_children(Self&! self, LambdaCapture[]& values) {
