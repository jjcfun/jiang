    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        self.require_handle(type_syntax.id.context_id, type_syntax.id.node_id);
        Int[4] arguments = [
            name.id.node_id,
            type_syntax.id.node_id,
            bool_int(public_flag),
            bool_int(mutable_binding),
        ];
        return ExternItem(
            self.identity(),
            self.add_node_arguments(89, span, arguments[..], "")
        );
    }

