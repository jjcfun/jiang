        self.require_handle(value.id.context_id, value.id.node_id);
        return self.add_associated_type(
            span, name.id.node_id, value.id.node_id, -1, false, -1,
            self.mark_children(), 0, false, false
        );
    }

    public Member associated_const_implementation(
        Self&! self,
        source.Span span,
        Path name,
        Expr value
    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        self.require_handle(value.id.context_id, value.id.node_id);
        return self.add_associated_type(
            span, name.id.node_id, -1, value.id.node_id, true, -1,
            self.mark_children(), 0, false, false
        );
    }

    Member add_associated_type(
        Self&! self,
        source.Span span,
        Int name,
        Int value,
        Int const_value,
        Bool is_const,
        Int type_ref,
        Int constraint_start,
        Int constraint_length,
        Bool member,
        Bool public_flag
    ) {
        Int[9] arguments = [
            name, value, const_value, bool_int(is_const), type_ref,
            constraint_start, constraint_length, bool_int(member), bool_int(public_flag),
        ];
        return Member(
            self.identity(),
            self.add_node_arguments(85, span, arguments[..], "")
        );
    }

    Int add_declaration_children(Self&! self, Decl[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Decl value = values[index];
            self.require_handle(value.id.context_id, value.id.node_id);
            self.add_child(value.id.node_id);
            index = index + 1;
        }
        return start;
    }

    public Decl with_annotations(
        Self&! self,
        Decl declaration,
        Annotation[]& annotations
    ) {
        self.require_handle(declaration.id.context_id, declaration.id.node_id);
        Int start = self.add_annotation_children(annotations);
        Int[3] arguments = [declaration.id.node_id, start, annotations.length];
        self.add_node_arguments(99, source.Span(), arguments[..], "");
        return declaration;
    }

    public Member with_annotations(
        Self&! self,
        Member member,
        Annotation[]& annotations
    ) {
        self.require_handle(member.id.context_id, member.id.node_id);
        Int start = self.add_annotation_children(annotations);
        Int[3] arguments = [member.id.node_id, start, annotations.length];
        self.add_node_arguments(100, source.Span(), arguments[..], "");
        return member;
    }

