    public Expr call(
        Self&! self,
        source.Span span,
        Expr callee,
        GenericArgument[]& type_arguments,
        Argument[]& arguments
    ) {
        self.require_no_contract_names(type_arguments);
        self.require_handle(callee.id.context_id, callee.id.node_id);
        Int type_start = self.add_generic_argument_children(type_arguments);
        return self.add_call_arguments(
            span,
            callee,
            type_start,
            type_arguments.length,
            arguments
        );
    }

    Expr add_call(
        Self&! self,
        source.Span span,
        Expr callee,
        Type[]& type_arguments,
        Argument[]& arguments
    ) {
        self.require_handle(callee.id.context_id, callee.id.node_id);
        Int type_start = self.add_type_children(type_arguments);
        return self.add_call_arguments(
            span,
            callee,
            type_start,
            type_arguments.length,
            arguments
        );
    }

    Expr add_call_arguments(
        Self&! self,
        source.Span span,
        Expr callee,
        Int type_start,
        Int type_length,
        Argument[]& arguments
    ) {
        Int argument_start = self.mark_children();
        Int index! = 0;
        while (index < arguments.length) {
            Argument argument = arguments[index];
            self.require_handle(argument.id.context_id, argument.id.node_id);
            self.add_child(argument.id.node_id);
            index = index + 1;
        }
        Int[5] factory_arguments = [
            callee.id.node_id,
            type_start,
            type_length,
            argument_start,
            arguments.length,
        ];
        return Expr(
            self.identity(),
            self.add_node_arguments(3, span, factory_arguments[..], "")
        );
    }

