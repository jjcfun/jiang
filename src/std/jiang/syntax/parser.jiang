    Decl add_generic_nominal_declaration(
        Self&! self,
        source.Span span,
        Ident name,
        GenericParameters? generics,
        Type? underlying_type,
        TypeBound[]& traits,
        Member[]& members,
        Bool public_flag,
        Bool packed,
        Int align,
        Bool enum_flag
    ) {
        assert(align >= 0);
        self.require_handle(name.id.context_id, name.id.node_id);
        Int trait_start = self.add_type_bound_children(traits);
        Int member_start = self.add_member_children(members);
        Int[11] arguments = [
            bool_int(enum_flag),
            name.id.node_id,
            self.optional_generic_parameters(generics),
            self.optional_type(underlying_type),
            trait_start,
            traits.length,
            member_start,
            members.length,
            bool_int(public_flag),
            bool_int(packed),
            align,
        ];
        return Decl(
            self.identity(),
            self.add_node_arguments(80, span, arguments[..], "")
        );
    }

    Decl add_nominal_declaration(
        Self&! self,
        source.Span span,
        Ident name,
        Type? underlying_type,
        Member[]& members,
        Bool public_flag,
        Bool packed,
        Int align,
        Bool enum_flag
    ) {
        assert(align >= 0);
        self.require_handle(name.id.context_id, name.id.node_id);
        Int start = self.add_member_children(members);
        Int[8] arguments = [
            bool_int(enum_flag),
            name.id.node_id,
            self.optional_type(underlying_type),
            start,
            members.length,
            bool_int(public_flag),
            bool_int(packed),
            align,
        ];
        return Decl(
            self.identity(),
            self.add_node_arguments(66, span, arguments[..], "")
        );
    }

