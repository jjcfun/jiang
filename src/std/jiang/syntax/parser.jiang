    public Type tuple_type(
        Self&! self,
        source.Span span,
        GenericArgument[]& elements
    ) {
        Int item_start = self.add_generic_argument_children(elements);
        Int contract_start = self.add_contract_name_children(elements);
        Int contract_length! = 0;
        if (self.generic_arguments_have_contract_names(elements)) {
            contract_length = elements.length;
        }
        Int[4] arguments = [
            item_start,
            elements.length,
            contract_start,
            contract_length,
        ];
        return Type(
            self.identity(),
            self.add_node_arguments(74, span, arguments[..], "")
        );
    }

