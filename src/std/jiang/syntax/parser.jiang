    public Pattern binding_pattern(
        Self&! self,
        source.Span span,
        source.Span name_span,
        UInt8[]& name,
        Type? type_syntax = null,
        Bool mutable_binding = false,
        Bool borrow_binding = false,
        Bool mutable_borrow = false
    ) {
        Int flags = bool_int(mutable_binding) | (bool_int(borrow_binding) << 1)
            | (bool_int(mutable_borrow) << 2);
        Int[4] arguments = [self.optional_type(type_syntax), name_span.start, name_span.length, flags];
        return Pattern(
            self.identity(),
            self.add_node_arguments(25, span, arguments[..], name)
        );
    }

