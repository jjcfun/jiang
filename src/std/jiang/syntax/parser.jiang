    Int mark_children(self) {
        return abi.mark_children(self.context);
    }

    Void add_child(Self&! self, Int node_id) {
        abi.add_child(self.context, node_id);
    }

    Int add_expr_children(Self&! self, Expr[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Expr value = values[index];
            self.require_handle(value.id.context_id, value.id.node_id);
            self.add_child(value.id.node_id);
            index = index + 1;
        }
        return start;
    }

    Int add_name_children(Self&! self, Ident[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Ident value = values[index];
            self.require_handle(value.id.context_id, value.id.node_id);
            self.add_child(value.id.node_id);
            index = index + 1;
        }
        return start;
    }

