    public Ast declarations(Self&! self, source.Span span, Decl[]& values) {
        if (values.length == 1) {
            self.require_handle(values[0].id.context_id, values[0].id.node_id);
            return Ast(values[0].id, .decl);
        }
        Int start = self.add_declaration_children(values);
        Int[2] arguments = [start, values.length];
        Decl root = Decl(
            self.identity(),
            self.add_node_arguments(86, span, arguments[..], "")
        );
        return self.ast(root);
    }

    public Decl comptime_block(
        Self&! self,
        source.Span span,
        Decl[]& declarations
    ) {
        Int start = self.add_declaration_children(declarations);
        Int[2] arguments = [start, declarations.length];
        return Decl(
            self.identity(),
            self.add_node_arguments(86, span, arguments[..], "")
        );
    }

    public Decl comptime_if(
        Self&! self,
        source.Span span,
        Expr condition,
        Decl then_body,
        Decl? else_body = null
    ) {
        self.require_handle(condition.id.context_id, condition.id.node_id);
        self.require_handle(then_body.id.context_id, then_body.id.node_id);
        Int[3] arguments = [
            condition.id.node_id,
            then_body.id.node_id,
            self.optional_decl(else_body),
        ];
        return Decl(
            self.identity(),
            self.add_node_arguments(87, span, arguments[..], "")
        );
    }

    public ExternItem extern_function(
        Self&! self,
        source.Span span,
        Ident name,
        GenericParameters? generics,
        Parameter[]& parameters,
        Type result_type,
        Bool public_flag = false,
        Bool unsafe_flag = false,
        Bool async_flag = false,
        Expr? domain = null,
        Expr? async_context = null
    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        self.require_handle(result_type.id.context_id, result_type.id.node_id);
        Int start = self.add_parameter_children(parameters);
        Int[10] arguments = [
            name.id.node_id,
            self.optional_generic_parameters(generics),
            result_type.id.node_id,
            start,
            parameters.length,
            bool_int(public_flag),
            bool_int(unsafe_flag),
            bool_int(async_flag),
            self.optional_expr(domain),
            self.optional_expr(async_context),
        ];
        return ExternItem(
            self.identity(),
            self.add_node_arguments(88, span, arguments[..], "")
        );
    }

