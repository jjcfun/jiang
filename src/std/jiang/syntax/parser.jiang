GenericArgument make_generic_argument(
    Void* context_id,
    Int node_id,
    Int contract_name_identity,
    source.Span span
) {
    return GenericArgument(AstId(context_id, node_id), contract_name_identity, span);
}

Int contract_name_identity(GenericArgument value) {
    return value.contract_name_identity;
}

source.Span generic_argument_span(GenericArgument value) {
    return value.span;
}

public Bool finish_ast(abi.SyntaxContext& syntax, Ast value) {
    assert(value.id.context_id == abi.identity(syntax));
    assert(value.id.node_id >= 0);
    return abi.finish(syntax, value.id.node_id, value.role);
}

@region(c, s, k: K)
@where(K: Copyable & Equatable)
public struct Parser<K>: Movable {
    @life(c)
    context.SyntaxContext& context;

    @life(s)
    source.Source source;

    @life(k)
    vector.Vector<token.Token<K>> tokens!;

    @life(k)
    K eof_kind;

    Int current!;

    public init(
        self,
        context.SyntaxContext& context,
        source.Source source,
        vector.Vector<token.Token<K>> tokens,
        K eof_kind
    ) {
        assert(tokens.length() > 0, "Parser requires an EOF token");
        assert(tokens[tokens.length() - 1].kind == eof_kind, "Parser EOF token kind mismatch");
        self.context = context;
        self.source = source;
        self.tokens = tokens;
        self.eof_kind = eof_kind;
        self.current = 0;
    }

    public Bool at(self, K kind) {
        return self.current_token().kind == kind;
    }

    public Bool match(Self&! self, K kind) {
        if (!self.at(kind)) { return false; }
        self.advance();
        return true;
    }

    @life(return.k: self & self.k & kind)
    public token.Token<K> expect(Self&! self, K kind) {
        if (self.at(kind)) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_token, span);
        return token.Token<K>.missing(kind, span);
    }

    @life(return.k: self & self.k & kind)
    public token.Token<K> expect(Self&! self, K kind, UInt8[]& message) {
        if (self.at(kind)) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_token, span, message);
        return token.Token<K>.missing(kind, span);
    }

    @life(return.k: self & self.k)
    public token.Token<K> advance(Self&! self) {
        token.Token<K> value = self.current_token();
        if (value.kind != self.eof_kind) {
            self.current = self.current + 1;
        }
        return value;
    }

    @life(return.k: self & self.k)
    public token.Token<K> current_token(self) {
        assert(self.current >= 0 && self.current < self.tokens.length());
        return self.tokens[self.current];
    }

    @life(return.k: self & self.k)
    public token.Token<K> previous_token(self) {
        assert(self.current > 0);
        return self.tokens[self.current - 1];
    }

    public Bool at_end(self) {
        return self.at(self.eof_kind);
    }

    public Void recover_until(Self&! self, K[]& kinds) {
        while (!self.at_end() && !contains_kind<K>(kinds, self.current_token().kind)) {
            self.advance();
        }
    }

    public Void error(Self&! self, source.Span span) {
        abi.add_diagnostic(self.context, .syntax_error, span);
    }

    public Void error(Self&! self, source.Span span, UInt8[]& message) {
        abi.add_diagnostic(self.context, .syntax_error, span, message);
    }

    public Void report(Self&! self, context.SyntaxDiagnosticKind kind, source.Span span) {
        abi.add_diagnostic(self.context, kind, span);
    }

    public source.Span insertion_span(self) {
        return source.Span(self.current_token().span.start, 0);
    }

    public source.Span span_from(self, token.Token<K> start) {
        Int end! = self.current_token().span.start;
        if (self.current > 0) {
            end = self.previous_token().span.end();
        }
        assert(start.span.start <= end);
        return source.Span(start.span.start, end - start.span.start);
    }

    @life(return: self.s)
    public UInt8[]& token_text(self, token.Token<K> value) {
        assert(value.span.start >= 0 && value.span.end() <= self.source.length());
        return self.source.bytes[value.span.start..value.span.end()];
    }

}

@life(return.c: syntax, return.s: input)
public Parser<token.TokenKind> default_parser(
    context.SyntaxContext& syntax,
    context.Input input
) {
    vector.Vector<token.Token<token.TokenKind>> tokens! = abi.take_default_tokens(syntax);
    return Parser<token.TokenKind>(syntax, input.source, tokens$.move(), .eof());
}

@where(K: Copyable & Equatable)
Bool contains_kind<K>(K[]& kinds, K expected) {
    Int index! = 0;
    while (index < kinds.length) {
        if (kinds[index] == expected) { return true; }
        index = index + 1;
    }
    return false;
}

// 默认 Jiang token helper 只解释 TokenKind；custom K 仍使用上面的通用 cursor API。
public extend Parser<token.TokenKind> {
    public Expr parse_expression(Self&! self) {
        return Expr(
        self.identity(),
            self.parse_fragment(.expr)
        );
    }

    public Stmt parse_statement(Self&! self) {
        return Stmt(
        self.identity(),
            self.parse_fragment(.stmt)
        );
    }

    public Type parse_type(Self&! self) {
        return Type(
            self.identity(),
            self.parse_fragment(.type_syntax)
        );
    }

    public Pattern parse_pattern(Self&! self) {
        return Pattern(
            self.identity(),
            self.parse_fragment(.pattern)
        );
    }

    public Decl parse_declaration(Self&! self) {
        return Decl(
            self.identity(),
            self.parse_fragment(.decl)
        );
    }

    public token.Token<token.TokenKind> expect_identifier(Self&! self) {
        if (self.current_token().kind.is_identifier()) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_identifier, span);
        return token.missing_token(.error(), span);
    }

    public token.Token<token.TokenKind> expect_literal(Self&! self) {
        if (self.current_token().kind.is_literal()) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_literal, span);
        return token.missing_token(.error(), span);
    }

    public token.Token<token.TokenKind> expect_keyword(Self&! self, UInt8[]& keyword) {
        token.Token<token.TokenKind> current = self.current_token();
        if (current.kind is .ident && bytes_equal(self.token_text(current), keyword)) {
            return self.advance();
        }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_keyword, span);
        return token.missing_token(.error(), span);
    }

    public Void synchronize(Self&! self, token.TokenKind[]& boundaries) {
        while (!self.at_end() && !contains_token_case(boundaries, self.current_token().kind)) {
            self.advance();
        }
    }

    Int parse_fragment(Self&! self, AstRole kind) {
        token.Token<token.TokenKind>[]& values = self.tokens.slice();
        Int start = self.current;
        Int next! = self.current;
        Int node_id = abi.parse_fragment(
            self.context,
            Int(kind),
            self.source,
            values,
            next$.mut_ref()
        );
        self.current = next;
        assert(self.current >= start && self.current < self.tokens.length());
        assert(node_id >= 0, "Jiang fragment parser did not produce requested syntax");
        return node_id;
    }
}

Bool contains_token_case(token.TokenKind[]& kinds, token.TokenKind expected) {
    Int index! = 0;
    while (index < kinds.length) {
        if (kinds[index].same_case(expected)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

public enum LiteralKind: Copyable {
    int_literal,
    float_literal,
    char_literal,
    string_literal,
    bool_literal,
    null_literal,
}

public enum UnaryOperator: Copyable {
    negative,
    logical_not,
    bit_not,
    address_of,
    dereference,
    new_value,
}

public enum BinaryOperator: Copyable {
    add,
    subtract,
    multiply,
    divide,
    remainder,
    bit_and,
    bit_or,
    bit_xor,
    logical_and,
    logical_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public enum AssignmentOperator: Copyable {
    assign,
    add,
    subtract,
    multiply,
    divide,
    remainder,
    bit_and,
    bit_or,
    bit_xor,
    shift_left,
    shift_right,
}

public enum ControlStatementKind: Copyable {
    return_value,
    break_loop,
    continue_loop,
    throw_value,
}

public enum TypeLayer: Copyable {
    optional,
    mutable_type,
    reference,
    owner_pointer,
    raw_pointer,
    slice,
}

public enum SyntaxExternKind: Copyable {
    none,
    native,
    c_abi,
    builtin,
}

// Parser 同时是 typed syntax factory；所有节点必须归属当前 parse invocation。
public extend <K: Copyable & Equatable> Parser<K> {
    public Ast ast(Self&! self, Expr value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .expr);
    }

    public Ast ast(Self&! self, Stmt value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .stmt);
    }

    public Ast ast(Self&! self, Type value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .type_syntax);
    }

    public Ast ast(Self&! self, Pattern value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .pattern);
    }

    public Ast ast(Self&! self, Decl value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .decl);
    }

    public Ast ast(Self&! self, Annotation value) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return Ast(value.id, .annotation);
    }

    public Expr name(Self&! self, source.Span span, UInt8[]& name) {
        return Expr(
            self.identity(),
            self.add_node(0, span, -1, -1, -1, name)
        );
    }

    public Ident identifier(Self&! self, source.Span span, UInt8[]& text) {
        return Ident(
            self.identity(),
            self.add_node(39, span, -1, -1, -1, text)
        );
    }

    public Path path(Self&! self, source.Span span, Ident[]& segments) {
        assert(segments.length > 0);
        Int start = self.add_name_children(segments);
        Int[2] arguments = [start, segments.length];
        return Path(
            self.identity(),
            self.add_node_arguments(40, span, arguments[..], "")
        );
    }

    public Expr path_expression(Self&! self, source.Span span, Path path) {
        self.require_handle(path.id.context_id, path.id.node_id);
        Int[1] arguments = [path.id.node_id];
        return Expr(
            self.identity(),
            self.add_node_arguments(41, span, arguments[..], "")
        );
    }

    public Expr int_literal(Self&! self, source.Span span, UInt8[]& text) {
        return Expr(
            self.identity(),
            self.add_node(1, span, -1, -1, -1, text)
        );
    }

    public GenericArgument type_argument(
        Self&! self,
        source.Span span,
        Type value,
        Ident? contract_name = null
    ) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return make_generic_argument(
            self.identity(),
            value.id.node_id,
            self.optional_name(contract_name),
            span
        );
    }

    public GenericArgument value_argument(
        Self&! self,
        source.Span span,
        Expr value,
        Ident? contract_name = null
    ) {
        self.require_handle(value.id.context_id, value.id.node_id);
        return make_generic_argument(
            self.identity(),
            value.id.node_id,
            self.optional_name(contract_name),
            span
        );
    }

    public GenericArgument associated_type_argument(
        Self&! self,
        source.Span span,
        Ident name,
        Type value
    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        self.require_handle(value.id.context_id, value.id.node_id);
        Int[2] arguments = [name.id.node_id, value.id.node_id];
        Int node_id = self.add_node_arguments(77, span, arguments[..], "");
        return make_generic_argument(self.identity(), node_id, -1, span);
    }

    public GenericParameter generic_parameter(
        Self&! self,
        source.Span span,
        Ident name,
        TypeBound? bound = null
    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        Int[4] arguments = [name.id.node_id, -1, self.optional_type_bound(bound), 0];
        return GenericParameter(
            self.identity(),
            self.add_node_arguments(75, span, arguments[..], "")
        );
    }

    public GenericParameter const_generic_parameter(
        Self&! self,
        source.Span span,
        Ident name,
        Type type_syntax
    ) {
        self.require_handle(name.id.context_id, name.id.node_id);
        self.require_handle(type_syntax.id.context_id, type_syntax.id.node_id);
        Int[4] arguments = [name.id.node_id, type_syntax.id.node_id, -1, 1];
        return GenericParameter(
            self.identity(),
            self.add_node_arguments(75, span, arguments[..], "")
        );
    }

    public GenericParameters generic_parameters(
        Self&! self,
        source.Span span,
        GenericParameter[]& parameters
    ) {
        Int start = self.add_generic_parameter_children(parameters);
        Int[2] arguments = [start, parameters.length];
        return GenericParameters(
            self.identity(),
            self.add_node_arguments(76, span, arguments[..], "")
        );
    }

    public TypeBound trait_bound(
        Self&! self,
        source.Span span,
        Path path,
        Bool negative = false
    ) {
        GenericArgument[0] arguments = [];
        return self.trait_bound(span, path, arguments[..], negative);
    }

    public TypeBound trait_bound(
        Self&! self,
        source.Span span,
        Path path,
        GenericArgument[]& values,
        Bool negative = false
    ) {
        self.require_handle(path.id.context_id, path.id.node_id);
        self.require_no_contract_names(values);
        Int start = self.add_generic_argument_children(values);
        Int[4] arguments = [path.id.node_id, start, values.length, bool_int(negative)];
        return TypeBound(
            self.identity(),
            self.add_node_arguments(78, span, arguments[..], "")
        );
    }

    public TypeBound type_bound_intersection(
        Self&! self,
        source.Span span,
        TypeBound left,
        TypeBound right
    ) {
        self.require_handle(left.id.context_id, left.id.node_id);
        self.require_handle(right.id.context_id, right.id.node_id);
        Int[2] arguments = [left.id.node_id, right.id.node_id];
        return TypeBound(
            self.identity(),
            self.add_node_arguments(79, span, arguments[..], "")
        );
    }

    public Annotation where_const(
        Self&! self,
        source.Span span,
        Ident parameter,
        Type type_syntax
    ) {
        self.require_handle(parameter.id.context_id, parameter.id.node_id);
        self.require_handle(type_syntax.id.context_id, type_syntax.id.node_id);
        Int[2] arguments = [parameter.id.node_id, type_syntax.id.node_id];
        return Annotation(
            self.identity(),
            self.add_node_arguments(94, span, arguments[..], "")
        );
    }

    public Annotation where_type_bound(
        Self&! self,
        source.Span span,
        Ident parameter,
        TypeBound bound
    ) {
        self.require_handle(parameter.id.context_id, parameter.id.node_id);
        self.require_handle(bound.id.context_id, bound.id.node_id);
        Int[2] arguments = [parameter.id.node_id, bound.id.node_id];
        return Annotation(
            self.identity(),
            self.add_node_arguments(95, span, arguments[..], "")
        );
    }

    public Annotation where_equal(
        Self&! self,
        source.Span span,
        Ident parameter,
        Type value
    ) {
        return self.add_where_equal(
            span, parameter, value.id.context_id, value.id.node_id, false
        );
    }

    public Annotation where_equal(
        Self&! self,
        source.Span span,
        Ident parameter,
        Expr value
    ) {
        return self.add_where_equal(
            span, parameter, value.id.context_id, value.id.node_id, false
        );
    }

    public Annotation where_not_equal(
        Self&! self,
        source.Span span,
        Ident parameter,
        Type value
    ) {
        return self.add_where_equal(
            span, parameter, value.id.context_id, value.id.node_id, true
        );
    }

    public Annotation where_not_equal(
        Self&! self,
        source.Span span,
        Ident parameter,
        Expr value
    ) {
        return self.add_where_equal(
            span, parameter, value.id.context_id, value.id.node_id, true
        );
    }

    Annotation add_where_equal(
        Self&! self,
        source.Span span,
        Ident parameter,
        Void* value_context,
        Int value,
        Bool negative
    ) {
        self.require_handle(parameter.id.context_id, parameter.id.node_id);
        self.require_handle(value_context, value);
        Int[2] arguments = [parameter.id.node_id, value];
        Int operation! = 96;
        if (negative) { operation = 97; }
        return Annotation(
            self.identity(),
