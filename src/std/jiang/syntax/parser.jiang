// Parser<K> 是自定义语法的通用 token cursor。
// 本阶段只固定静态 cursor 与 span 行为；诊断和 typed factory 随 SyntaxContext 接入。

import context = "context.jiang";
import abi = "abi.jiang";
import vector = "../../collection/vector.jiang";
import source = "source.jiang";
import token = "token.jiang";

enum AstRole { expr, stmt, decl, type_syntax, pattern, annotation, child }

struct AstId: Copyable {
    Void* context_id;
    Int node_id;

    init(self, Void* context_id, Int node_id) {
        self.context_id = context_id;
        self.node_id = node_id;
    }
}

// Provider 只持有 opaque AST identity，compiler-owned AST storage 不进入 std API。
public struct Ast: Copyable {
    AstId id;
    Int role;

    init(self, AstId id, AstRole role) {
        self.id = id;
        self.role = Int(role);
    }
}

public struct Ident: Copyable {
    AstId id;
    init(self, Void* context_id, Int node_id) {
        self.id = AstId(context_id, node_id);
    }
}

public struct Path: Copyable {
    AstId id;
    init(self, Void* context_id, Int node_id) {
        self.id = AstId(context_id, node_id);
    }
}

