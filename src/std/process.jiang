// hosted 程序的参数、环境变量与 child process 操作。

import system_process = "../compiler/system/process.jiang";
import system_env = "../compiler/system/env.jiang";
import system_abort = "../compiler/system/abort.jiang";
import string = "string.jiang";

// 借用的进程参数 view；storage 存活到进程结束。
public alias ProgramArguments = system_process.ProgramArguments;
// 选择继承、丢弃或捕获 child process stream。
public alias StreamBehavior = system_process.StreamBehavior;
// 配置 child process 的 stdout 与 stderr 行为。
public alias RunOptions = system_process.RunOptions;
// 拥有已完成 child process 的结果和捕获输出。
public alias ProcessResult = system_process.ProcessResult;
// 返回 process-lifetime 参数借用 view，复杂度为 O(1)。
public alias arguments = system_process.arguments;
// 从 process storage 借用环境变量值；不存在时返回 null。
public alias env = system_env.get;
// 返回通过 PATH 找到的独立 owned executable path；未找到时返回 null。
public alias find_executable = system_env.find_executable;
// 立即以 code 终止当前进程；不 unwind，也不保证 Jiang value 析构。
public alias exit = system_abort.exit;

// 同步运行 executable；arguments 只在调用期间借用，默认继承 stdout/stderr。
@life()
public ProcessResult run(UInt8[]& executable, string.String[]& arguments) {
    RunOptions options = RunOptions();
    return run(executable, arguments, options$.ref());
}

// 同步运行 executable；返回前不会保存 arguments 中的 String 或 byte view。
@life()
public ProcessResult run(UInt8[]& executable, string.String[]& arguments, RunOptions& options) {
    system_process.ArgumentList argument_bytes! = system_process.ArgumentList(arguments.length);
    Int index! = 0;
    while (index < arguments.length) {
        argument_bytes.append(arguments[index]$.ref().bytes());
        index = index + 1;
    }
    return system_process.run(executable, argument_bytes$.ref(), options);
}
