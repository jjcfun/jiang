// 编译器 builtin 初始化。
//
// 这里创建 compiler core 必须存在的 Def/Semantic Model/namespace/type 映射。普通声明的
// 类型结果只写入 TypeCheckStore；这里的 type 映射只服务 Bool/Int 这类
// 启动期内建类型名。

import qid = "./id.jiang";
import qkey = "./incremental/key.jiang";
import sem = "./sema/model.jiang";
import sem_store = "./sema/model/store.jiang";
import incremental_store = "./incremental/symbol_store.jiang";
import def = "./resolve/def.jiang";
import interner = "./resolve/interner.jiang";
import store = "./resolve/store.jiang";
import source_map = "./source/source_map.jiang";
import list = "./support/list.jiang";
import token = "./syntax/token.jiang";
import sema_type = "./sema/type.jiang";

public struct BuiltinSymbols: Copyable {
    public qid.SymbolId jiang_root!;
    public qid.SymbolId asm_name!;
    public qid.SymbolId doc_name!;

    public init(self) {
        self.jiang_root = qid.SymbolId(0);
        self.asm_name = qid.SymbolId(0);
        self.doc_name = qid.SymbolId(0);
    }

    public Void load(Self&! self, interner.SymbolStore&! symbols) {
        self.jiang_root = symbols.intern("jiang");
        self.asm_name = symbols.intern("asm");
        self.doc_name = symbols.intern("doc");
    }
}

struct BuiltinStableScope: Copyable {
    qid.SymbolId package_name!;
    qid.SymbolId module_path!;

    init(self) {
        self.package_name = qid.SymbolId(0);
        self.module_path = qid.SymbolId(0);
    }

    Void load(Self&! self, interner.SymbolStore&! symbols) {
        self.package_name = symbols.intern("__builtin");
        self.module_path = self.package_name;
    }
}

Void record_builtin_stable_symbol(
    interner.SymbolStore& symbols,
    def.DefStore& defs,
    incremental_store.IncrementalSymbolStore&! incremental,
    BuiltinStableScope stable,
    qid.DefId def_id,
    qkey.StableSymbolKind kind,
    qid.DefId? owner_def
) {
    def.DefRecord def_record = defs.get(def_id);
    incremental.record_symbol(
        symbols,
        qkey.StableSymbolKey (
            kind: kind,
            package_name: stable.package_name,
            module_path: stable.module_path,
            owner: builtin_owner_stable_id(incremental, owner_def),
            name: def_record.name.symbol,
            domain: def_record.domain
        ),
        def_id
    );
}

qkey.StableSymbolId? builtin_owner_stable_id(
    incremental_store.IncrementalSymbolStore& incremental,
    qid.DefId? owner_def
) {
    guard owner_def is .some(owner) else { return null; }
    return incremental.stable_id_for_def(owner);
}

public Void init_builtins(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    sema_type.TypeStore&! types,
    incremental_store.IncrementalSymbolStore&! incremental
) {
    BuiltinStableScope stable! = BuiltinStableScope();
    stable.load(symbols);
    add_primitive_type(
        symbols, defs, resolve, model, sources, types, incremental, stable, "Void", types.unit_type()
    );
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Bool", types.bool_type());
    qid.DefId int_def =
        add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Int", types.int_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "UInt", types.uint_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Int8", types.int8_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Int16", types.int16_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Int32", types.int32_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Int64", types.int64_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "UInt8", types.uint8_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "UInt16", types.uint16_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "UInt32", types.uint32_type());
    qid.DefId uint64_def = add_primitive_type(
        symbols,
        defs,
        resolve,
        model,
        sources,
        types,
        incremental,
        stable,
        "UInt64",
        types.uint64_type()
    );
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Float16", types.float16_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Float", types.float_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Float32", types.float_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Float64", types.double_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Double", types.double_type());
    add_primitive_type(symbols, defs, resolve, model, sources, types, incremental, stable, "Char", types.char_type());
    qid.DefId option_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Option"
    );
    qid.DefId result_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Result"
    );
    qid.DefId task_def = add_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "Task");
    qid.DefId raw_fn_def = add_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "RawFn");
    qid.DefId fn_def = add_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "Fn");
    qid.DefId fn_once_def = add_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "FnOnce"
    );
    qid.DefId ref_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Ref"
    );
    qid.DefId box_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Box"
    );
    qid.DefId raw_pointer_def =
        add_internal_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "RawPointer");
    qid.DefId slice_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Slice"
    );
    qid.DefId sentinel_slice_def =
        add_internal_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "SentinelSlice");
    qid.DefId array_def = add_internal_unbound_type(
        symbols, defs, resolve, model, sources, incremental, stable, "Array"
    );
    qid.DefId sentinel_array_def =
        add_internal_unbound_type(symbols, defs, resolve, model, sources, incremental, stable, "SentinelArray");
    resolve.set_core_types(
        option_def,
        result_def,
        task_def,
        raw_fn_def,
        fn_def,
        fn_once_def,
        ref_def,
        box_def,
        raw_pointer_def,
        slice_def,
        sentinel_slice_def,
        array_def,
        sentinel_array_def
    );
    add_builtin_generic_param(symbols, defs, model, sources, types, option_def, "T");
    add_builtin_generic_param(symbols, defs, model, sources, types, result_def, "T");
    qid.DefId result_error_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, result_def, "E");
    add_builtin_generic_param(symbols, defs, model, sources, types, task_def, "T");
    qid.DefId ref_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, ref_def, "T");
    qid.DefId box_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, box_def, "T");
    qid.DefId raw_pointer_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, raw_pointer_def, "T");
    qid.DefId slice_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, slice_def, "T");
    qid.DefId sentinel_slice_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, sentinel_slice_def, "T");
    qid.DefId sentinel_slice_value_param =
        add_builtin_const_generic_param(symbols, defs, model, sources, sentinel_slice_def, "S", sentinel_slice_param);
    qid.DefId array_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, array_def, "T");
    qid.DefId array_count_param =
        add_builtin_const_generic_param(symbols, defs, model, sources, array_def, "N", int_def);
    qid.DefId sentinel_array_param =
        add_builtin_generic_param(symbols, defs, model, sources, types, sentinel_array_def, "T");
    qid.DefId sentinel_array_count_param =
        add_builtin_const_generic_param(symbols, defs, model, sources, sentinel_array_def, "N", int_def);
    qid.DefId sentinel_array_value_param =
        add_builtin_const_generic_param(symbols, defs, model, sources, sentinel_array_def, "S", sentinel_array_param);
    add_builtin_trait_bound(model, sentinel_slice_def, sentinel_slice_param, resolve.core_traits.copyable_trait);
    add_builtin_trait_bound(model, sentinel_array_def, sentinel_array_param, resolve.core_traits.copyable_trait);
    add_restricted_handle_type_constraints(
        model,
        ref_def,
        ref_param,
        box_def,
        ref_def,
        raw_pointer_def
    );
    add_restricted_handle_type_constraints(
        model,
        box_def,
        box_param,
        box_def,
        ref_def,
        raw_pointer_def
    );
    add_pointer_type_constraints(model, raw_pointer_def, raw_pointer_param, box_def, ref_def);
}

qid.DefId add_primitive_type(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    sema_type.TypeStore&! types,
    incremental_store.IncrementalSymbolStore&! incremental,
    BuiltinStableScope stable,
    UInt8[]& name,
    qid.TypeId type_id
) {
    qid.DefId def_id = add_type(symbols, defs, resolve, sources, types, incremental, stable, name, type_id);
    resolve.set_core_primitive_type(name, def_id);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        def_id,
        null,
        token.Span()
    );
    defs.set_owned_namespace(def_id, namespace_id);
    model.declare_def(def_id, .type_decl);
    return def_id;
}

qid.DefId add_type(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    source_map.SourceMap&! sources,
    sema_type.TypeStore&! types,
    incremental_store.IncrementalSymbolStore&! incremental,
    BuiltinStableScope stable,
    UInt8[]& name,
    qid.TypeId type_id
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    sources.set_sourceless_def_span(def_id, token.Span());
    types.bind_builtin_type_def(def_id, type_id);
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .type_symbol, null);
    return def_id;
}

qid.DefId add_unbound_type(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    incremental_store.IncrementalSymbolStore&! incremental,
    BuiltinStableScope stable,
    UInt8[]& name
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        def_id,
        null,
        token.Span()
    );
    defs.set_owned_namespace(def_id, namespace_id);
    model.declare_def(def_id, .type_decl);
    sources.set_sourceless_def_span(def_id, token.Span());
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .type_symbol, null);
    return def_id;
}

qid.DefId add_internal_unbound_type(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    incremental_store.IncrementalSymbolStore&! incremental,
    BuiltinStableScope stable,
    UInt8[]& name
) {
    qid.DefId def_id = create_internal_type_def(symbols, defs, resolve, name);
    qid.NamespaceId namespace_id = resolve.create_namespace(
        .declaration_namespace,
        resolve.builtin_namespace,
        def_id,
        null,
        token.Span()
    );
    defs.set_owned_namespace(def_id, namespace_id);
    model.declare_def(def_id, .type_decl);
    sources.set_sourceless_def_span(def_id, token.Span());
    record_builtin_stable_symbol(symbols, defs, incremental, stable, def_id, .type_symbol, null);
    return def_id;
}

Void bind_builtin_type_alias(
    interner.SymbolStore&! symbols,
    store.ResolveStore&! resolve,
    UInt8[]& name,
    qid.DefId def_id
) {
    resolve.bind_builtin_name(symbols.intern(name), .type_name, def_id, token.Span());
}

qid.DefId add_builtin_generic_param(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    sema_type.TypeStore&! types,
    qid.DefId owner_def,
    UInt8[]& name
) {
    guard defs.get(owner_def).owned_namespace_id is .some(namespace_id) else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .generic_param_def,
        .type_name,
        .private_visibility,
        def.Name (symbol: symbol, span: span),
        owner_def,
        null,
        namespace_id,
        null
    );
    model.declare_def(def_id, .generic_param_decl);
    model.add_generic_param(owner_def, def_id);
    sources.set_sourceless_def_span(def_id, span);
    qid.TypeId type_id = types.substitutable_named_type(def_id, span);
    types.bind_named_type_def(def_id, type_id);
    return def_id;
}

qid.DefId add_builtin_const_generic_param(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    sem_store.Store&! model,
    source_map.SourceMap&! sources,
    qid.DefId owner_def,
    UInt8[]& name,
    qid.DefId type_def
) {
    guard defs.get(owner_def).owned_namespace_id is .some(namespace_id) else { return qid.DefId.from_index(0); }
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .generic_param_def,
        .value_name,
        .private_visibility,
        def.Name(symbol: symbol, span: span),
        owner_def,
        null,
        namespace_id,
        null
    );
    model.declare_def(def_id, .generic_param_decl);
    model.add_generic_param(owner_def, def_id);
    model.set_decl_type_ref(def_id, builtin_named_type_ref(model, def_id, type_def));
    sources.set_sourceless_def_span(def_id, span);
    return def_id;
}

Void add_restricted_handle_type_constraints(
    sem_store.Store&! model,
    qid.DefId owner_def,
    qid.DefId param_def,
    qid.DefId box_def,
    qid.DefId ref_def,
    qid.DefId raw_pointer_def
) {
    sem.NodeId subject = builtin_named_type_ref(model, owner_def, param_def);
    add_type_not_equal_pattern(model, owner_def, subject, box_def);
    add_type_not_equal_pattern(model, owner_def, subject, ref_def);
    add_type_not_equal_pattern(model, owner_def, subject, raw_pointer_def);
}

Void add_pointer_type_constraints(
    sem_store.Store&! model,
    qid.DefId owner_def,
    qid.DefId param_def,
    qid.DefId box_def,
    qid.DefId ref_def
) {
    sem.NodeId subject = builtin_named_type_ref(model, owner_def, param_def);
    add_type_not_equal_pattern(model, owner_def, subject, box_def);
    add_type_not_equal_pattern(model, owner_def, subject, ref_def);
}

Void add_builtin_trait_bound(
    sem_store.Store&! model,
    qid.DefId owner_def,
    qid.DefId param_def,
    qid.DefId? trait_def
) {
    guard trait_def is .some(bound_def) else { return; }
    sem.NodeId subject = builtin_named_type_ref(model, owner_def, param_def);
    model.add_where_predicate(owner_def, .type_bound(sem.WhereTypeBound(
        subject: subject,
        bound: builtin_named_type_ref(model, owner_def, bound_def)
    )));
}

Void add_type_not_equal_pattern(
    sem_store.Store&! model,
    qid.DefId owner_def,
    sem.NodeId subject,
    qid.DefId pattern_def
) {
    model.add_where_predicate(owner_def, .not_equal(sem.WhereEqual(
        subject: subject,
        value: builtin_single_arg_pattern_ref(model, owner_def, pattern_def)
    )));
}

sem.ParamDefault[]& empty_param_defaults(sem_store.Store&! model) {
    unsafe {
        sem.ParamDefault*! stored = model.storage.alloc_array<sem.ParamDefault>(1);
        return stored[0..0];
    }
}

sem.NodeId builtin_named_type_ref(
    sem_store.Store&! model,
    qid.DefId owner_def,
    qid.DefId type_def
) {
    list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(0);
    return model.add_node(owner_def, .named_type_ref(sem.NamedTypeRef (
        def_id: type_def,
        args: freeze_model_ids(model, args)
    )));
}

sem.NodeId builtin_single_arg_pattern_ref(
    sem_store.Store&! model,
    qid.DefId owner_def,
    qid.DefId type_def
) {
    list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(1);
    args.add(model.add_node(owner_def, .infer_type_ref()));
    return model.add_node(owner_def, .named_type_ref(sem.NamedTypeRef (
        def_id: type_def,
        args: freeze_model_ids(model, args)
    )));
}

sem.NodeId[]& empty_model_ids(sem_store.Store&! model) {
    list.ArrayList<sem.NodeId> values! = list.ArrayList<sem.NodeId>(0);
    return freeze_model_ids(model, values);
}

sem.NodeId[]& freeze_model_ids(sem_store.Store&! model, list.ArrayList<sem.NodeId> values) {
    unsafe {
        Int count = values.len();
        Int capacity! = count;
        if (capacity == 0) {
            capacity = 1;
        }
        sem.NodeId*! stored = model.storage.alloc_array<sem.NodeId>(capacity);
        Int index! = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }
}

qid.SymbolId[]& empty_symbol_ids(sem_store.Store&! model) {
    unsafe {
        Int capacity = 1;
        qid.SymbolId*! stored = model.storage.alloc_array<qid.SymbolId>(capacity);
        return stored[0..0];
    }
}

qid.DefId create_type_def(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    UInt8[]& name
) {
    return create_builtin_def(symbols, defs, resolve, name, .builtin_type_def, .type_name);
}

qid.DefId create_internal_type_def(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    UInt8[]& name
) {
    token.Span span = token.Span();
    return defs.create(
        .builtin_type_def,
        .type_name,
        .private_visibility,
        def.Name(symbol: symbols.intern(name), span: span),
        null,
        null,
        resolve.builtin_namespace,
        null
    );
}

qid.DefId create_builtin_def(
    interner.SymbolStore&! symbols,
    def.DefStore&! defs,
    store.ResolveStore&! resolve,
    UInt8[]& name,
    def.DefKind kind,
    def.NameDomain domain
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        kind,
        domain,
        .public_visibility,
        def.Name (symbol: symbol, span: span),
        null,
        null,
        resolve.builtin_namespace,
        null
    );
    resolve.bind_builtin_name(symbol, domain, def_id, span);
    return def_id;
}
