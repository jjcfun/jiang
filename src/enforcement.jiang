// 编译器严格规则的执行策略。
//
// 所有模式运行同一套分析；bootstrap audit 只把迁移期违规降级为可比对的诊断，
// 不改变类型、JIL、loan 或 provenance 的计算方式。

import diagnostic = "./diagnostic.jiang";
import string = "./support/string.jiang";

public enum Mode {
    strict,
    bootstrap_audit,
}

public Bool is_bootstrap_audit(Mode mode) {
    return mode == .bootstrap_audit;
}

public Bool audits_type_check_code(Mode mode, UInt8[]& code) {
    if (!is_bootstrap_audit(mode)) { return false; }
    if (string.equal(code, "immutable_assignment_target")) { return true; }
    if (string.equal(code, "empty_field_life_binding")) { return true; }
    if (string.equal(code, "field_life_shape_mismatch")) { return true; }
    if (string.equal(code, "missing_field_life_binding")) { return true; }
    if (string.equal(code, "dangling_region_name")) { return true; }
    if (string.equal(code, "incompatible_lifetime_shapes")) { return true; }
    if (string.equal(code, "implicit_lifetime_contract_requires_annotation")) {
        return true;
    }
    if (string.equal(code, "invalid_generic_outlives_binding")) { return true; }
    if (string.equal(code, "projection_move_not_allowed")) { return true; }
    if (string.equal(code, "raw_pointer_storage_policy_required")) { return true; }
    return string.equal(code, "immutable_borrow_source");
}

public Bool audits_type_check_source(Mode mode, UInt8[]& source_name, UInt8[]& code) {
    return audits_type_check_code(mode, code) && is_migration_source(source_name);
}

public Bool audits_borrow_check_source(Mode mode, UInt8[]& source_name) {
    return is_bootstrap_audit(mode) && is_migration_source(source_name);
}

public diagnostic.DiagnosticSeverity type_check_severity(
    Mode mode,
    UInt8[]& source_name,
    UInt8[]& code
) {
    if (audits_type_check_source(mode, source_name, code)) { return .warning; }
    return .error;
}

public diagnostic.DiagnosticSeverity borrow_check_severity(Mode mode, UInt8[]& source_name) {
    if (audits_borrow_check_source(mode, source_name)) { return .warning; }
    return .error;
}

Bool is_migration_source(UInt8[]& source_name) {
    if (is_strict_migration_source(source_name)) { return false; }
    if (starts_with(source_name, "src/")) { return true; }
    if (starts_with(source_name, "std/")) { return true; }
    if (contains(source_name, "/src/")) { return true; }
    return contains(source_name, "/std/");
}

Bool is_strict_migration_source(UInt8[]& source_name) {
    if (string.equal(source_name, "src/syntax.jiang")) { return true; }
    if (starts_with(source_name, "src/syntax/")) { return true; }
    if (contains(source_name, "/src/syntax/")) { return true; }
    return ends_with(source_name, "/src/syntax.jiang");
}

Bool ends_with(UInt8[]& text, UInt8[]& suffix) {
    if (text.length < suffix.length) { return false; }
    Int offset = text.length - suffix.length;
    return string.equal(text[offset..], suffix);
}

Bool starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (text.length < prefix.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Bool contains(UInt8[]& text, UInt8[]& pattern) {
    if (pattern.length == 0) { return true; }
    Int start! = 0;
    while (start + pattern.length <= text.length) {
        Int index! = 0;
        while (index < pattern.length && text[start + index] == pattern[index]) {
            index = index + 1;
        }
        if (index == pattern.length) { return true; }
        start = start + 1;
    }
    return false;
}
