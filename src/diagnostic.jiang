// CLI、测试、IDE 与 LSP adapter 共用的诊断数据模型入口。
//
// Internal diagnostics are anchored by source file + byte span. Line/character
// positions are cached beside the span when available, but can be recomputed by
// source_map.jiang from the source text.

import source = "./source.jiang";
import token = "./syntax/token.jiang";
import list = "./support/list.jiang";
import std;

public enum DiagnosticSeverity {
    error,
    warning,
    information,
    hint,
}

public Int lsp_severity_code(DiagnosticSeverity severity) {
    if (severity == .error) { return 1; }
    if (severity == .warning) { return 2; }
    if (severity == .information) { return 3; }
    return 4;
}

public enum DiagnosticCategory {
    lexer,
    parser,
    name_resolution,
    type_check,
    borrow_check,
    layout,
    trait_solve,
    lowering,
    codegen,
    incremental,
    package,
    internal,
}

public enum DiagnosticCodeKind {
    numeric,
    string,
}

@region(a)
public struct DiagnosticCode: Copyable {
    public DiagnosticCodeKind kind;
    public Int number;
    @life(a)
    public UInt8[]& text;

    public init(self) {
        self.kind = .string;
        self.number = 0;
        self.text = "";
    }

    public init(self, UInt8[]& text) {
        self.kind = .string;
        self.number = 0;
        self.text = text;
    }

    public init(self, Int number) {
        self.kind = .numeric;
        self.number = number;
        self.text = "";
    }
}

public struct SourcePosition: Copyable {
    // 0-based byte offset in source text.
    public Int byte_offset;

    // 0-based line number. LSP also uses 0-based lines.
    public Int line;

    // 0-based UTF-16 code unit offset. This matches LSP's default position
    // encoding and can also be used by older clients.
    public Int character;

    public init(self) {
        self.byte_offset = 0;
        self.line = 0;
        self.character = 0;
    }

    public init(self, Int byte_offset, Int line, Int character) {
        self.byte_offset = byte_offset;
        self.line = line;
        self.character = character;
    }
}

public struct SourceRange: Copyable {
    public source.SourceId? source_id;

    // Byte span is the canonical compiler location.
    public token.Span span;

    // LSP-facing range. End is exclusive.
    public SourcePosition start;
    public SourcePosition end;

    public init(self) {
        self.source_id = null;
        self.span = token.Span();
        self.start = SourcePosition();
        self.end = SourcePosition();
    }

    public init(self, source.SourceId source_id, token.Span span) {
        self.source_id = source_id;
        self.span = span;
        self.start = SourcePosition(span.start, 0, 0);
        self.end = SourcePosition(span.end(), 0, 0);
    }

    public init(self, source.SourceId source_id, token.Span span, SourcePosition start, SourcePosition end) {
        self.source_id = source_id;
        self.span = span;
        self.start = start;
        self.end = end;
    }
}

public enum DiagnosticTag {
    unnecessary,
    deprecated,
}

public Int lsp_tag_code(DiagnosticTag tag) {
    if (tag == .unnecessary) { return 1; }
    return 2;
}

public enum DiagnosticLabelStyle {
    primary,
    secondary,
}

public struct DiagnosticLabel: Movable {
    public DiagnosticLabelStyle style;
    public SourceRange range;
    public std.String message;

    public init(self) {
        self.style = .primary;
        self.range = SourceRange();
        self.message = "";
    }

    public init(self, DiagnosticLabelStyle style, SourceRange range, UInt8[]& message) {
        self.style = style;
        self.range = range;
        self.message = std.String(message);
    }
}

public struct DiagnosticRelatedInformation: Movable {
    public SourceRange range;
    public std.String message;

    public init(self) {
        self.range = SourceRange();
        self.message = "";
    }

    public init(self, SourceRange range, UInt8[]& message) {
        self.range = range;
        self.message = std.String(message);
    }
}

public enum TextEditKind {
    insert,
    replace,
    delete,
}

public struct TextEdit: Movable {
    public TextEditKind kind;
    public SourceRange range;
    public std.String replacement;

    public init(self) {
        self.kind = .replace;
        self.range = SourceRange();
        self.replacement = "";
    }

    public init(self, TextEditKind kind, SourceRange range, UInt8[]& replacement) {
        self.kind = kind;
        self.range = range;
        self.replacement = std.String(replacement);
    }
}

public enum FixApplicability {
    machine_applicable,
    maybe_incorrect,
    has_placeholders,
    manual,
}

public struct DiagnosticFix: Movable {
    public std.String title;
    public FixApplicability applicability;
    public list.ArrayList<TextEdit> edits!;

    public init(self) {
        self.title = "";
        self.applicability = .manual;
        self.edits = list.ArrayList<TextEdit>();
    }

    public init(self, UInt8[]& title, FixApplicability applicability) {
        self.title = std.String(title);
        self.applicability = applicability;
        self.edits = list.ArrayList<TextEdit>();
    }

    public Void add_edit(Self&! self, TextEdit edit) {
        self.edits.add(edit);
    }
}

@region(a)
public struct Diagnostic: Movable {
    public DiagnosticSeverity severity;
    public DiagnosticCategory category;
    @life(a)
    public DiagnosticCode code;

    // Main range should be present for source diagnostics. A null source_id
    // means the diagnostic is global, e.g. command line or package config.
    public SourceRange range;

    public std.String message;
    @life(a)
    public UInt8[]& source_name;

    public list.ArrayList<DiagnosticLabel> labels!;
    public list.ArrayList<DiagnosticRelatedInformation> related!;
    public list.ArrayList<DiagnosticTag> tags!;
    public list.ArrayList<DiagnosticFix> fixes!;

    public init(self) {
        self.severity = .error;
        self.category = .internal;
        self.code = DiagnosticCode();
        self.range = SourceRange();
        self.message = "";
        self.source_name = "jiang";
        self.labels = list.ArrayList<DiagnosticLabel>();
        self.related = list.ArrayList<DiagnosticRelatedInformation>();
        self.tags = list.ArrayList<DiagnosticTag>();
        self.fixes = list.ArrayList<DiagnosticFix>();
    }

    public init(self,
        DiagnosticSeverity severity,
        DiagnosticCategory category,
        DiagnosticCode code,
        SourceRange range,
        UInt8[]& message
    ) {
        self.severity = severity;
        self.category = category;
        self.code = code;
        self.range = range;
        self.message = std.String(message);
        self.source_name = "jiang";
        self.labels = list.ArrayList<DiagnosticLabel>();
        self.related = list.ArrayList<DiagnosticRelatedInformation>();
        self.tags = list.ArrayList<DiagnosticTag>();
        self.fixes = list.ArrayList<DiagnosticFix>();
    }

    public Void add_label(Self&! self, DiagnosticLabel label) {
        self.labels.add(label);
    }

    public Void add_related(Self&! self, DiagnosticRelatedInformation info) {
        self.related.add(info);
    }

    public Void add_tag(Self&! self, DiagnosticTag tag) {
        self.tags.add(tag);
    }

    public Void add_fix(Self&! self, DiagnosticFix fix) {
        self.fixes.add(fix);
    }
}

public struct DiagnosticStore: Movable {
    public list.ArrayList<Diagnostic> items!;
    public Int error_count!;
    public Int warning_count!;

    public init(self) {
        self.items = list.ArrayList<Diagnostic>();
        self.error_count = 0;
        self.warning_count = 0;
    }

    public Int len(self) {
        return self.items.len();
    }

    public Bool empty(self) {
        return self.items.empty();
    }

    public Diagnostic& get(self, Int index) {
        return self.items.ref_at(index);
    }

    public DiagnosticScope scope(self) {
        return DiagnosticScope(self.items.len(), self.error_count);
    }

    public Void add(Self&! self, Diagnostic diagnostic) {
        if (diagnostic.severity == .error) {
            self.error_count = self.error_count + 1;
        } else if (diagnostic.severity == .warning) {
            self.warning_count = self.warning_count + 1;
        }
        self.items.add(diagnostic);
    }

    public Bool has_errors(self) {
        return self.error_count > 0;
    }

    public DiagnosticStore take(Self&! self) {
        DiagnosticStore result! = DiagnosticStore();
        result.items = self.items.take();
        result.error_count = self.error_count;
        result.warning_count = self.warning_count;
        self.error_count = 0;
        self.warning_count = 0;
        return result;
    }

    public Void append(Self&! self, DiagnosticStore source!) {
        list.ArrayList<Diagnostic> reversed! = list.ArrayList<Diagnostic>(
            source.items.len()
        );
        while (!source.items.empty()) {
            reversed.add(source.items.pop());
        }
        while (!reversed.empty()) {
            self.add(reversed.pop());
        }
    }

    public Void clear(Self&! self) {
        self.items.clear();
        self.error_count = 0;
        self.warning_count = 0;
    }

    public Void truncate(Self&! self, Int len) {
        self.items.truncate(len);
        self.recount();
    }

    Void recount(Self&! self) {
        self.error_count = 0;
        self.warning_count = 0;
        Int index! = 0;
        while (index < self.items.len()) {
            Diagnostic& diagnostic = self.items.ref_at(index);
            if (diagnostic.severity == .error) {
                self.error_count = self.error_count + 1;
            } else if (diagnostic.severity == .warning) {
                self.warning_count = self.warning_count + 1;
            }
            index = index + 1;
        }
    }
}

public struct DiagnosticScope: Copyable {
    Int start_index;
    public Int length!;
    Int start_error_count;
    Int error_count!;

    public init(self, Int start_index, Int start_error_count) {
        self.start_index = start_index;
        self.length = 0;
        self.start_error_count = start_error_count;
        self.error_count = 0;
    }

    public Void finish(Self&! self, DiagnosticStore& store) {
        self.length = store.items.len() - self.start_index;
        self.error_count = store.error_count - self.start_error_count;
    }

    public Bool has_errors(self) {
        return self.error_count > 0;
    }

    public Int count(self) {
        return self.length;
    }

    @life(return: store)
    public Diagnostic& get(self, DiagnosticStore& store, Int offset) {
        assert(offset >= 0 && offset < self.length);
        return store.get(self.start_index + offset);
    }
}
