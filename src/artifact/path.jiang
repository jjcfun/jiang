// Backend artifact path 规划。
//
// 这里只生成 cache path，不创建目录、不写文件。driver/长驻服务拿到路径后
// 再负责文件系统操作，避免 backend cache 和 OS 能力耦合。

import object_key = "./object_key.jiang";
import qkey = "../incremental/key.jiang";
import hash = "../support/hash.jiang";
import path = "../support/path.jiang";
import string = "../support/string.jiang";
import artifact_cache = "./object.jiang";

public UInt8[]& object_dir(UInt8[]& cache_root) {
    return path.join(cache_root, "objects");
}

public UInt8[]& source_dir(UInt8[]& cache_root) {
    return path.join(cache_root, "sources");
}

public UInt8[]& source_ji_path(
    UInt8[]& cache_root,
    qkey.StableSymbolId source_stable_id,
    UInt64 source_hash
) {
    UInt8[]&! name = string.append("source_", stable_id_text(source_stable_id));
    name = string.append(name, "_");
    name = string.append(name, uint64_text(source_hash));
    name = string.append(name, ".ji");
    return path.join(source_dir(cache_root), name);
}

public UInt8[]& source_object_path(
    UInt8[]& cache_root,
    artifact_cache.SourceObjectKey key
) {
    UInt8[]&! name = string.append("source_", uint64_text(key.hash()));
    name = string.append(name, ".o");
    return path.join(object_dir(cache_root), name);
}

public UInt8[]& monomorph_object_path(
    UInt8[]& cache_root,
    object_key.StableInstanceKey& key
) {
    qkey.Fingerprint128 fingerprint = object_key.stable_instance_fingerprint(key);
    UInt8[]&! name = string.append("mono_", fingerprint_text(fingerprint));
    name = string.append(name, ".o");
    return path.join(object_dir(cache_root), name);
}

public UInt8[]& release_package_object_path(
    UInt8[]& cache_root,
    UInt8[]& target_triple,
    UInt8[]& compiler_version,
    UInt8[]& backend_profile,
    UInt64 root_source_hash
) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write_bytes("release-package-object");
    hasher.write_bytes(target_triple);
    hasher.write_bytes(compiler_version);
    hasher.write_bytes(backend_profile);
    hasher.write_uint64(root_source_hash);
    UInt8[]&! name = string.append("release_pkg_", uint64_text(hasher.finish()));
    name = string.append(name, ".o");
    return path.join(object_dir(cache_root), name);
}

UInt8[]& fingerprint_text(qkey.Fingerprint128 fingerprint) {
    UInt8[]&! text = uint64_text(fingerprint.low);
    text = string.append(text, "_");
    return string.append(text, uint64_text(fingerprint.high));
}

UInt8[]& stable_id_text(qkey.StableSymbolId stable_id) {
    UInt8[]&! text = uint64_text(stable_id.low);
    text = string.append(text, "_");
    return string.append(text, uint64_text(stable_id.high));
}

UInt8[]& uint64_text(UInt64 value) {
    if (value == 0) {
        return "0";
    }

    UInt64! remaining = value;
    Int! digit_count = 0;
    while (remaining > 0) {
        digit_count = digit_count + 1;
        remaining = remaining / UInt64(10);
    }

    UInt8![*] bytes = UInt8!$.alloc_array(digit_count + 1);
    remaining = value;
    Int! write = digit_count - 1;
    while (write >= 0) {
        UInt64 digit = remaining % UInt64(10);
        bytes[write] = UInt8(UInt64(48) + digit);
        remaining = remaining / UInt64(10);
        write = write - 1;
    }
    bytes[digit_count] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..digit_count];
}
