// Backend artifact path 规划。
//
// 这里只生成 cache path，不创建目录、不写文件。driver/长驻服务拿到路径后
// 再负责文件系统操作，避免 backend cache 和 OS 能力耦合。

import object_key = "./object_key.jiang";
import qkey = "../incremental/key.jiang";
import artifact_cache = "./object.jiang";
import std;

public UInt8[]^ object_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("objects");
    return path.finish().into_slice();
}

public UInt8[]^ source_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("sources");
    return path.finish().into_slice();
}

public UInt8[]^ lang_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("lang");
    return path.finish().into_slice();
}

public UInt8[]^ source_ji_path(
    UInt8[]& cache_root,
    qkey.StableSymbolId source_stable_id,
    UInt64 source_hash,
    UInt64 compiler_version_hash
) {
    UInt8[]^ stable_id = stable_id_text(source_stable_id);
    UInt8[]^ version = uint64_text_owned(compiler_version_hash);
    UInt8[]^ hash = uint64_text_owned(source_hash);
    std.StringBuilder builder = std.StringBuilder();
    builder.append("source_");
    builder.append(stable_id[..]);
    builder.append("_");
    builder.append(version[..]);
    builder.append("_");
    builder.append(hash[..]);
    builder.append(".ji");
    PathBuilder path = PathBuilder(cache_root);
    path.append("sources");
    path.append(builder.slice());
    return path.finish().into_slice();
}

public UInt8[]^ source_object_path(
    UInt8[]& cache_root,
    artifact_cache.SourceObjectKey key
) {
    UInt8[]^ hash = uint64_text_owned(key.hash());
    std.StringBuilder builder = std.StringBuilder();
    builder.append("source_");
    builder.append(hash[..]);
    builder.append(".o");
    PathBuilder path = PathBuilder(cache_root);
    path.append("objects");
    path.append(builder.slice());
    return path.finish().into_slice();
}

public UInt8[]^ monomorph_object_path(
    UInt8[]& cache_root,
    object_key.StableInstanceKey& key
) {
    qkey.Fingerprint128 fingerprint = object_key.stable_instance_fingerprint(key);
    UInt8[]^ fingerprint_name = fingerprint_text(fingerprint);
    std.StringBuilder builder = std.StringBuilder();
    builder.append("mono_");
    builder.append(fingerprint_name[..]);
    builder.append(".o");
    PathBuilder path = PathBuilder(cache_root);
    path.append("objects");
    path.append(builder.slice());
    return path.finish().into_slice();
}

UInt8[]^ fingerprint_text(qkey.Fingerprint128 fingerprint) {
    UInt8[]^ low = uint64_text_owned(fingerprint.low);
    UInt8[]^ high = uint64_text_owned(fingerprint.high);
    std.StringBuilder builder = std.StringBuilder();
    builder.append(low[..]);
    builder.append("_");
    builder.append(high[..]);
    return builder$.move().into_slice();
}

UInt8[]^ stable_id_text(qkey.StableSymbolId stable_id) {
    UInt8[]^ low = uint64_text_owned(stable_id.low);
    UInt8[]^ high = uint64_text_owned(stable_id.high);
    std.StringBuilder builder = std.StringBuilder();
    builder.append(low[..]);
    builder.append("_");
    builder.append(high[..]);
    return builder$.move().into_slice();
}

UInt8[]& uint64_text(UInt64 value) {
    if (value == 0) {
        return "0";
    }

    UInt64 remaining! = value;
    Int digit_count! = 0;
    while (remaining > 0) {
        digit_count = digit_count + 1;
        remaining = remaining / UInt64(10);
    }

    unsafe {
        UInt8[*]! bytes = UInt8!$.alloc_many(digit_count + 1);
        remaining = value;
        Int write! = digit_count - 1;
        while (write >= 0) {
            UInt64 digit = remaining % UInt64(10);
            bytes[write] = UInt8(UInt64(48) + digit);
            remaining = remaining / UInt64(10);
            write = write - 1;
        }
        bytes[digit_count] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..digit_count];
    }
}

UInt8[]^ uint64_text_owned(UInt64 value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(value);
    return builder$.move().into_slice();
}
