// Backend artifact path 规划。
//
// 这里只生成 cache path，不创建目录、不写文件。driver/长驻服务拿到路径后
// 再负责文件系统操作，避免 backend cache 和 OS 能力耦合。

import cache_identity = "./cache_identity.jiang";
import qkey = "../incremental/key.jiang";
import system_fs = "../system/fs.jiang";
import std;

public UInt8[]^ context_cache_root(
    UInt8[]& cache_root,
    cache_identity.ContextKey context_key
) {
    UInt8[]^ name = fingerprint_text(context_key.fingerprint);
    PathBuilder path = PathBuilder(cache_root);
    path.append(name[..]);
    return path.finish().into_slice();
}

public UInt8[]^ temporary_artifact_path(
    UInt8[]& final_path,
    UInt8[]& marker
) {
    std.StringBuilder path = std.StringBuilder();
    path.append(final_path);
    path.append(marker);
    path.append(system_fs.process_id());
    return path.into_slice();
}

public UInt8[]^ object_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("objects");
    return path.finish().into_slice();
}

public UInt8[]^ source_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("sources");
    return path.finish().into_slice();
}

public UInt8[]^ lang_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("lang");
    return path.finish().into_slice();
}

public UInt8[]^ build_dir(UInt8[]& context_root) {
    PathBuilder path = PathBuilder(context_root);
    path.append("builds");
    return path.finish().into_slice();
}

public UInt8[]^ build_state_path(
    UInt8[]& context_root,
    qkey.Fingerprint128 target_identity
) {
    UInt8[]^ fingerprint_name = fingerprint_text(target_identity);
    std.StringBuilder name = std.StringBuilder();
    name.append(fingerprint_name[..]);
    name.append(".jbuild");
    UInt8[]^ directory = build_dir(context_root);
    return std.path.join(directory[..], name.slice()).into_slice();
}

public UInt8[]^ lock_dir(UInt8[]& cache_root) {
    PathBuilder path = PathBuilder(cache_root);
    path.append("locks");
    return path.finish().into_slice();
}

// 固定数量的 lock stripe 避免为每个 object 建立持久 sidecar，同时让
// 不同 source 的发布通常可以并行。
public UInt8[]^ source_lock_path(
    UInt8[]& cache_root,
    cache_identity.StableSourceIdentity source_identity
) {
    UInt64 stripe = source_identity.fingerprint.low & UInt64(63);
    std.StringBuilder name = std.StringBuilder();
    name.append("source-");
    name.append(stripe);
    name.append(".lock");
    UInt8[]^ directory = lock_dir(cache_root);
    return std.path.join(directory[..], name.slice()).into_slice();
}

public UInt8[]^ target_build_lock_path(
    UInt8[]& context_root,
    qkey.Fingerprint128 target_identity
) {
    UInt8[]^ fingerprint_name = fingerprint_text(target_identity);
    std.StringBuilder name = std.StringBuilder();
    name.append("build-");
    name.append(fingerprint_name[..]);
    name.append(".lock");
    UInt8[]^ directory = lock_dir(context_root);
    return std.path.join(directory[..], name.slice()).into_slice();
}

public UInt8[]^ stable_source_ji_path(
    UInt8[]& context_root,
    cache_identity.StableSourceIdentity source_identity
) {
    return stable_source_path(context_root, "sources", source_identity, ".ji");
}

public UInt8[]^ stable_source_object_path(
    UInt8[]& context_root,
    cache_identity.StableSourceIdentity source_identity
) {
    UInt8[]^ relative = stable_source_object_relative_path(source_identity);
    return std.path.join(context_root, relative[..]).into_slice();
}

public UInt8[]^ stable_source_object_relative_path(
    cache_identity.StableSourceIdentity source_identity
) {
    return stable_source_path("", "objects", source_identity, ".o");
}

public UInt8[]^ stable_source_monomorph_object_path(
    UInt8[]& context_root,
    cache_identity.StableSourceIdentity source_identity
) {
    return stable_source_path(context_root, "objects", source_identity, ".mono.o");
}

public UInt8[]^ stable_source_object_path_for_identity(
    UInt8[]& context_root,
    qkey.Fingerprint128 identity
) {
    return stable_source_object_path(
        context_root,
        cache_identity.StableSourceIdentity(identity)
    );
}

UInt8[]^ fingerprint_text(qkey.Fingerprint128 fingerprint) {
    UInt8[]^ low = uint64_text_owned(fingerprint.low);
    UInt8[]^ high = uint64_text_owned(fingerprint.high);
    std.StringBuilder builder = std.StringBuilder();
    builder.append(low[..]);
    builder.append("_");
    builder.append(high[..]);
    return builder.into_slice();
}

UInt8[]^ stable_source_path(
    UInt8[]& context_root,
    UInt8[]& directory,
    cache_identity.StableSourceIdentity source_identity,
    UInt8[]& extension
) {
    UInt8[]^ name = fingerprint_text(source_identity.fingerprint);
    std.StringBuilder builder = std.StringBuilder();
    builder.append(name[..]);
    builder.append(extension);
    PathBuilder path = PathBuilder(context_root);
    path.append(directory);
    path.append(builder.slice());
    return path.finish().into_slice();
}

@life()
UInt8[]& uint64_text(UInt64 value) {
    if (value == 0) {
        return "0";
    }

    UInt64 remaining! = value;
    Int digit_count! = 0;
    while (remaining > 0) {
        digit_count = digit_count + 1;
        remaining = remaining / UInt64(10);
    }

    unsafe {
        UInt8*! bytes = UInt8$.alloc(digit_count + 1);
        remaining = value;
        Int write! = digit_count - 1;
        while (write >= 0) {
            UInt64 digit = remaining % UInt64(10);
            bytes[write] = UInt8(UInt64(48) + digit);
            remaining = remaining / UInt64(10);
            write = write - 1;
        }
        bytes[digit_count] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..digit_count];
    }
}

UInt8[]^ uint64_text_owned(UInt64 value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(value);
    return builder.into_slice();
}
