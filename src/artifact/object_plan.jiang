// Object artifact 复用计划。
//
// CodegenUnitKey 只是本轮 JIL 分组 key，里面包含 session-local module/def/type
// index，不能直接作为本地 cache key。这里把 codegen unit 转成稳定 object key、
// 规划 cache path，并统一执行 object lookup。pipeline 后续只消费这个计划，不
// 需要知道 object key/path 的拼装细节。

import codegen_unit = "../backend/codegen_unit.jiang";
import context = "../context.jiang";
import driver_options = "../driver/options.jiang";
import jil = "../jil.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import resolve_store = "../resolve/store.jiang";
import source = "../source.jiang";
import list = "../support/list.jiang";
import object_artifact = "./object.jiang";
import object_closure = "./object_closure.jiang";
import object_hash = "./object_hash.jiang";
import object_index = "./object_index.jiang";
import object_key = "./object_key.jiang";
import object_key_builder = "./object_key_builder.jiang";
import object_lookup = "./object_lookup.jiang";
import artifact_path = "./path.jiang";
import source_artifact = "./source.jiang";
import std;

public enum ObjectPlanEntryKind {
    source_object,
    monomorph_object,
    unsupported,
}

public struct ObjectPlanEntry: Copyable {
    public ObjectPlanEntryKind kind;
    public Int unit_index;
    public Int path_index!;
    public object_artifact.ObjectArtifactStatus lookup_status!;
    public Int source_key_index!;
    public Int monomorph_key_index!;
    public qkey.Fingerprint128 stable_unit_key;
    public qkey.Fingerprint128 definition_key;
    public qkey.Fingerprint128 dependency_fingerprint;
    public Int package_index;

    public init(self,
        ObjectPlanEntryKind kind,
        Int unit_index
    ) {
        self.kind = kind;
        self.unit_index = unit_index;
        self.path_index = -1;
        self.lookup_status = .missing;
        self.source_key_index = -1;
        self.monomorph_key_index = -1;
        self.stable_unit_key = qkey.Fingerprint128();
        self.definition_key = qkey.Fingerprint128();
        self.dependency_fingerprint = qkey.Fingerprint128();
        self.package_index = -1;
    }

    public ObjectPlanEntry unsupported(Int unit_index) {
        return ObjectPlanEntry(.unsupported, unit_index);
    }

    public Bool can_reuse(self) {
        return self.lookup_status == .hit;
    }
}

struct PackageInterfacePart: Copyable {
    qkey.StableSymbolId module_stable_id;
    qkey.Fingerprint128 interface_hash;

    init(self,
        qkey.StableSymbolId module_stable_id,
        qkey.Fingerprint128 interface_hash
    ) {
        self.module_stable_id = module_stable_id;
        self.interface_hash = interface_hash;
    }
}

public struct ObjectReusePlan: Movable {
    public list.ArrayList<ObjectPlanEntry> entries;
    public list.ArrayList<std.String> paths;
    public list.ArrayList<object_artifact.SourceObjectKey> source_keys;
    public list.ArrayList<object_key.StableInstanceKey> monomorph_keys;
    public object_index.ObjectIndexContext index_context;
    public std.String cache_root;

    public init(self) {
        self.entries = list.ArrayList<ObjectPlanEntry>();
        self.paths = list.ArrayList<std.String>();
        self.source_keys = list.ArrayList<object_artifact.SourceObjectKey>();
        self.monomorph_keys = list.ArrayList<object_key.StableInstanceKey>();
        self.index_context = object_index.ObjectIndexContext(
            qkey.Fingerprint128(),
            qkey.Fingerprint128(),
            qkey.Fingerprint128(),
            qkey.Fingerprint128(),
            qkey.Fingerprint128()
        );
        self.cache_root = std.String("");
    }

    public Int len(self) {
        return self.entries.len();
    }
    public ObjectPlanEntry& entry_at(self, Int index) {
        return self.entries.ref_at(index);
    }

    public std.String path_at(self, Int index) {
        return std.String(self.paths.ref_at(index).bytes());
    }

    public object_artifact.SourceObjectKey source_key_at(self, Int index) {
        return self.source_keys.get(index);
    }
    public object_key.StableInstanceKey& monomorph_key_at(self, Int index) {
        return self.monomorph_keys.ref_at(index);
    }

    public Int reusable_count(self) {
        return self.status_count(.hit);
    }

    public Int missing_count(self) {
        return self.status_count(.missing);
    }

    public Int stale_count(self) {
        return self.status_count(.stale);
    }

    public Bool owns_definition(self, qkey.Fingerprint128 definition_key) {
        Int index! = 0;
        while (index < self.entries.len()) {
            ObjectPlanEntry& entry = self.entries.ref_at(index);
            if (entry.kind != .unsupported && entry.definition_key == definition_key) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public ObjectReuseSummary summary(self) {
        ObjectReuseSummary result! = ObjectReuseSummary();
        Int index! = 0;
        while (index < self.entries.len()) {
            result.add(self.entries.ref_at(index));
            index = index + 1;
        }
        return result;
    }

    public qkey.Fingerprint128? closure_fingerprint(self) {
        return self.closure_fingerprint_for_package(-1);
    }

    public qkey.Fingerprint128? closure_fingerprint_for_package(self, Int package_index) {
        list.ArrayList<qkey.Fingerprint128> parts = list.ArrayList<qkey.Fingerprint128>();
        Int index! = 0;
        while (index < self.entries.len()) {
            ObjectPlanEntry& entry = self.entries.ref_at(index);
            if (package_index >= 0 && entry.package_index != package_index) {
                index = index + 1;
                continue;
            }
            if (entry.kind == .unsupported) {
                return null;
            }
            std.String path = self.path_at(entry.path_index);
            guard object_hash.hash_file(path.bytes()) is .some(hash) else { return null; }
            parts.add(entry.stable_unit_key);
            parts.add(hash);
            index = index + 1;
        }
        if (parts.len() == 0) { return null; }
        return object_key.combine_fingerprints(UInt64(105), parts$.ref());
    }

    Int status_count(self, object_artifact.ObjectArtifactStatus status) {
        Int count! = 0;
        Int index! = 0;
        while (index < self.entries.len()) {
            if (self.entries.ref_at(index).lookup_status == status) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }
}

public struct ObjectReuseSummary: Copyable {
    public Int source_hit!;
    public Int source_missing!;
    public Int source_stale!;
    public Int monomorph_hit!;
    public Int monomorph_missing!;
    public Int monomorph_stale!;
    public Int unsupported!;

    public init(self) {
        self.source_hit = 0;
        self.source_missing = 0;
        self.source_stale = 0;
        self.monomorph_hit = 0;
        self.monomorph_missing = 0;
        self.monomorph_stale = 0;
        self.unsupported = 0;
    }

    public Int hit_count(self) {
        return self.source_hit + self.monomorph_hit;
    }

    public Int missing_count(self) {
        return self.source_missing + self.monomorph_missing;
    }

    public Int stale_count(self) {
        return self.source_stale + self.monomorph_stale;
    }

    () add(self, ObjectPlanEntry& entry) {
        if (entry.kind == .unsupported) {
            self.unsupported = self.unsupported + 1;
            return;
        }
        if (entry.kind == .source_object) {
            self.add_source(entry.lookup_status);
            return;
        }
        self.add_monomorph(entry.lookup_status);
    }

    () add_source(self, object_artifact.ObjectArtifactStatus status) {
        if (status == .hit) {
            self.source_hit = self.source_hit + 1;
        } else if (status == .missing) {
            self.source_missing = self.source_missing + 1;
        } else {
            self.source_stale = self.source_stale + 1;
        }
    }

    () add_monomorph(self, object_artifact.ObjectArtifactStatus status) {
        if (status == .hit) {
            self.monomorph_hit = self.monomorph_hit + 1;
        } else if (status == .missing) {
            self.monomorph_missing = self.monomorph_missing + 1;
        } else {
            self.monomorph_stale = self.monomorph_stale + 1;
        }
    }
}

public ObjectReusePlan build_object_reuse_plan(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet& units,
    UInt8[]& cache_root,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_version,
    driver_options.CompileMode mode
) {
    return build_object_reuse_plan(
        ctx,
        store,
        units,
        cache_root,
        target_cache_key,
        compiler_version,
        compiler_version,
        "unknown-toolchain",
        mode
    );
}

public ObjectReusePlan build_object_reuse_plan(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet& units,
    UInt8[]& cache_root,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_build,
    UInt8[]& language_version,
    UInt8[]& toolchain_version,
    driver_options.CompileMode mode
) {
    ObjectReusePlan plan! = ObjectReusePlan();
    qkey.Fingerprint128 target_hash = object_key_builder.target_fingerprint(target_cache_key);
    qkey.Fingerprint128 compiler_hash = object_key_builder.compiler_fingerprint(compiler_build);
    qkey.Fingerprint128 backend_profile_hash = object_key_builder.backend_profile_fingerprint(mode);
    plan.index_context = object_index.ObjectIndexContext(
        compiler_hash,
        object_key_builder.language_version_fingerprint(language_version),
        target_hash,
        object_key_builder.toolchain_fingerprint(toolchain_version),
        backend_profile_hash
    );
    plan.cache_root = std.String(cache_root);
    Int index! = 0;
    while (index < units.len()) {
        plan.entries.add(plan_entry_for_unit(
            plan$.ref(),
            ctx,
            store,
            units.unit_at(index),
            index,
            cache_root,
            target_hash,
            compiler_hash,
            backend_profile_hash
        ));
        index = index + 1;
    }
    sort_plan_entries(plan.entries$.ref());
    return plan;
}

ObjectPlanEntry plan_entry_for_unit(
    ObjectReusePlan& plan,
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    Int unit_index,
    UInt8[]& cache_root,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    if (unit.key.kind == .source_unit) {
        return source_entry_for_unit(
            plan,
            ctx,
            unit,
            unit_index,
            cache_root,
            target_hash,
            compiler_hash,
            backend_profile_hash
        );
    }
    return monomorph_entry_for_unit(
        plan,
        ctx,
        store,
        unit,
        unit_index,
        cache_root,
        target_hash,
        compiler_hash,
        backend_profile_hash
    );
}

ObjectPlanEntry source_entry_for_unit(
    ObjectReusePlan& plan,
    context.CompilerContext& ctx,
    codegen_unit.CodegenUnit& unit,
    Int unit_index,
    UInt8[]& cache_root,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    qid.ModuleId module_id = qid.ModuleId.from_index(unit.key.module_index);
    object_key_builder.SourceObjectFingerprints local_fingerprints =
        object_key_builder.source_object_fingerprints_for_module(ctx, module_id);
    qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
    object_key_builder.SourceObjectFingerprints fingerprints =
        source_fingerprints_with_dependency_closure(ctx, local_fingerprints, package_id);
    guard object_key_builder.source_object_key_for_module(
        ctx,
        module_id,
        fingerprints,
        target_hash,
        compiler_hash,
        backend_profile_hash
    ) is .some(key) else {
        return ObjectPlanEntry.unsupported(unit_index);
    }

    UInt8[]^ path = artifact_path.source_object_path(cache_root, key);
    UInt8[]^ relative_path = artifact_path.source_object_relative_path(key);
    object_artifact.ObjectArtifactStatus lookup_status = object_lookup.lookup_source_object_status(
        ctx.store.object_artifacts$.ref(),
        cache_root,
        key,
        plan.index_context,
        relative_path[..]
    );
    Int path_index = plan.paths.len();
    plan.paths.add(std.String(path[..]));
    Int key_index = plan.source_keys.len();
    plan.source_keys.add(key);
    ObjectPlanEntry entry! = ObjectPlanEntry(.source_object, unit_index);
    entry.path_index = path_index;
    entry.lookup_status = lookup_status;
    entry.source_key_index = key_index;
    entry.stable_unit_key = object_artifact.source_object_fingerprint(key);
    entry.definition_key = object_artifact.source_object_definition_fingerprint(key);
    entry.dependency_fingerprint = key.interface_hash;
    entry.package_index = unit.key.package_index;
    return entry;
}

object_key_builder.SourceObjectFingerprints source_fingerprints_with_dependency_closure(
    context.CompilerContext& ctx,
    object_key_builder.SourceObjectFingerprints local,
    qid.PackageId package_id
) {
    list.ArrayList<qkey.Fingerprint128> parts = list.ArrayList<qkey.Fingerprint128>();
    parts.add(local.interface_hash);
    parts.add(package_interface_fingerprint(ctx, package_id));
    return object_key_builder.SourceObjectFingerprints(
        object_key.combine_fingerprints(UInt64(106), parts$.ref()),
        local.body_hash,
        local.layout_hash
    );
}

qkey.Fingerprint128 package_interface_fingerprint(
    context.CompilerContext& ctx,
    qid.PackageId package_id
) {
    list.ArrayList<PackageInterfacePart> interfaces = list.ArrayList<PackageInterfacePart>();
    list.ArrayList<Int> packages = package_closure(ctx, package_id);
    Int index! = 0;
    while (index < ctx.store.resolve.modules.len()) {
        qid.ModuleId module_id = qid.ModuleId.from_index(index);
        resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
        if (contains_package(packages$.ref(), module.package_id.to_index())) {
            add_module_interface_part(ctx, interfaces$.ref(), module);
        }
        index = index + 1;
    }
    sort_interface_parts(interfaces$.ref());
    return hash_interface_parts(interfaces$.ref());
}

() add_module_interface_part(
    context.CompilerContext& ctx,
    list.ArrayList<PackageInterfacePart>& interfaces,
    resolve_store.ModuleRecord& module
) {
    guard ctx.store.incremental.stable_id_for_def(module.def_id) is .some(stable_id) else {
        return;
    }
    guard ctx.store.artifacts.load_interface(module.source_id) is .some(module_interface) else {
        return;
    }
    interfaces.add(PackageInterfacePart(stable_id, module_interface.interface_hash));
}

qkey.Fingerprint128 hash_interface_parts(list.ArrayList<PackageInterfacePart>& interfaces) {
    list.ArrayList<qkey.Fingerprint128> parts = list.ArrayList<qkey.Fingerprint128>();
    Int index! = 0;
    while (index < interfaces.len()) {
        PackageInterfacePart part = interfaces.get(index);
        parts.add(qkey.Fingerprint128(part.module_stable_id.low, part.module_stable_id.high));
        parts.add(part.interface_hash);
        index = index + 1;
    }
    return object_key.combine_fingerprints(UInt64(107), parts$.ref());
}

ObjectPlanEntry monomorph_entry_for_unit(
    ObjectReusePlan& plan,
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    Int unit_index,
    UInt8[]& cache_root,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    if (unit.functions.len() == 0) {
        return ObjectPlanEntry.unsupported(unit_index);
    }
    jil.Function function = store.function(unit.functions.get(0));
    guard object_key_builder.stable_instance_key_for_function(
        ctx,
        function,
        target_hash,
        compiler_hash,
        backend_profile_hash
    ) is .some(key) else {
        return ObjectPlanEntry.unsupported(unit_index);
    }

    UInt8[]^ path = artifact_path.monomorph_object_path(cache_root, key$.ref());
    UInt8[]^ relative_path = artifact_path.monomorph_object_relative_path(key$.ref());
    object_artifact.ObjectArtifactStatus lookup_status = object_lookup.lookup_monomorph_object_status(
        ctx.store.object_artifacts$.ref(),
        cache_root,
        key$.ref(),
        plan.index_context,
        relative_path[..]
    );
    Int path_index = plan.paths.len();
    plan.paths.add(std.String(path[..]));
    Int key_index = plan.monomorph_keys.len();
    qkey.Fingerprint128 stable_unit_key = object_key.stable_instance_fingerprint(key$.ref());
    plan.monomorph_keys.add(key);
    ObjectPlanEntry entry! = ObjectPlanEntry(.monomorph_object, unit_index);
    entry.path_index = path_index;
    entry.lookup_status = lookup_status;
    entry.monomorph_key_index = key_index;
    entry.stable_unit_key = stable_unit_key;
    entry.definition_key = object_key.stable_instance_definition_fingerprint(
        plan.monomorph_key_at(key_index)
    );
    entry.dependency_fingerprint = object_index.monomorph_dependency_fingerprint(
        plan.monomorph_key_at(key_index)
    );
    entry.package_index = unit.key.package_index;
    return entry;
}

public () record_package_closure(
    context.CompilerContext& ctx,
    ObjectReusePlan& plan
) {
    Int index! = 0;
    while (index < ctx.store.resolve.modules.len()) {
        qid.ModuleId module_id = qid.ModuleId.from_index(index);
        resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (ctx.store.artifacts.load_interface(source_id) is .some(module_interface)) {
            record_interface_closure(
                ctx,
                module_interface,
                plan,
                module.package_id
            );
        }
        index = index + 1;
    }
}

() record_interface_closure(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    ObjectReusePlan& plan,
    qid.PackageId package_id
) {
    list.ArrayList<Int> packages = package_closure(ctx, package_id);
    Int index! = 0;
    while (index < plan.entries.len()) {
        ObjectPlanEntry entry = plan.entries.get(index);
        if (entry.kind != .unsupported
            && contains_package(packages$.ref(), entry.package_index)
        ) {
            module_interface.add_object_unit(interface_object_unit(entry));
        }
        index = index + 1;
    }
    guard object_closure.compute_fingerprint(
        plan.cache_root.bytes(),
        module_interface,
        plan.index_context
    ) is .some(closure_key) else {
        return;
    }
    module_interface.set_object_closure(closure_key, closure_key);
}

list.ArrayList<Int> package_closure(
    context.CompilerContext& ctx,
    qid.PackageId owner_package
) {
    list.ArrayList<Int> packages = list.ArrayList<Int>();
    packages.add(owner_package.to_index());
    Int index! = 0;
    while (index < ctx.store.resolve.packages.len()) {
        qid.PackageId candidate = qid.PackageId.from_index(index);
        if (ctx.store.resolve.package_ref(candidate).kind == .core) {
            add_package_once(packages$.ref(), index);
        }
        index = index + 1;
    }
    index = 0;
    while (index < packages.len()) {
        add_declared_dependencies(ctx, packages$.ref(), qid.PackageId.from_index(packages.get(index)));
        index = index + 1;
    }
    return packages;
}

() add_declared_dependencies(
    context.CompilerContext& ctx,
    list.ArrayList<Int>& packages,
    qid.PackageId package_id
) {
    resolve_store.PackageRecord& package = ctx.store.resolve.package_ref(package_id);
    Int index! = 0;
    while (index < package.dependencies.len()) {
        resolve_store.PackageDependencyRecord dependency = package.dependencies.get(index);
        if (ctx.store.resolve.package_for_dir(dependency.path_symbol) is .some(dependency_id)) {
            add_package_once(packages, dependency_id.to_index());
        }
        index = index + 1;
    }
}

() add_package_once(list.ArrayList<Int>& packages, Int package_index) {
    if (!contains_package(packages, package_index)) {
        packages.add(package_index);
    }
}

Bool contains_package(list.ArrayList<Int>& packages, Int package_index) {
    Int index! = 0;
    while (index < packages.len()) {
        if (packages.get(index) == package_index) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

() sort_interface_parts(list.ArrayList<PackageInterfacePart>& parts) {
    Int index! = 1;
    while (index < parts.len()) {
        Int current! = index;
        while (current > 0 && interface_part_less(parts.get(current), parts.get(current - 1))) {
            PackageInterfacePart previous = parts.get(current - 1);
            parts.set(current - 1, parts.get(current));
            parts.set(current, previous);
            current = current - 1;
        }
        index = index + 1;
    }
}

Bool interface_part_less(PackageInterfacePart lhs, PackageInterfacePart rhs) {
    if (lhs.module_stable_id.high != rhs.module_stable_id.high) {
        return lhs.module_stable_id.high < rhs.module_stable_id.high;
    }
    return lhs.module_stable_id.low < rhs.module_stable_id.low;
}

source_artifact.InterfaceObjectUnit interface_object_unit(ObjectPlanEntry entry) {
    if (entry.kind == .monomorph_object) {
        return source_artifact.InterfaceObjectUnit(
            .monomorph_unit,
            entry.stable_unit_key,
            entry.definition_key,
            entry.dependency_fingerprint
        );
    }
    return source_artifact.InterfaceObjectUnit(
        .source_unit,
        entry.stable_unit_key,
        entry.definition_key,
        entry.dependency_fingerprint
    );
}

() sort_plan_entries(list.ArrayList<ObjectPlanEntry>& entries) {
    Int index! = 1;
    while (index < entries.len()) {
        Int current! = index;
        while (current > 0 && entry_less(entries.get(current), entries.get(current - 1))) {
            swap_entries(entries, current, current - 1);
            current = current - 1;
        }
        index = index + 1;
    }
}

Bool entry_less(ObjectPlanEntry lhs, ObjectPlanEntry rhs) {
    if (lhs.kind != rhs.kind) {
        return Int(lhs.kind) < Int(rhs.kind);
    }
    if (lhs.stable_unit_key.high != rhs.stable_unit_key.high) {
        return lhs.stable_unit_key.high < rhs.stable_unit_key.high;
    }
    return lhs.stable_unit_key.low < rhs.stable_unit_key.low;
}

() swap_entries(list.ArrayList<ObjectPlanEntry>& entries, Int lhs_index, Int rhs_index) {
    ObjectPlanEntry lhs = entries.get(lhs_index);
    entries.set(lhs_index, entries.get(rhs_index));
    entries.set(rhs_index, lhs);
}
