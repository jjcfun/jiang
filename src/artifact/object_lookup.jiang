// Object artifact 的文件校验入口。
//
// ObjectArtifactCache 只保存 key -> path/hash 的内存记录；这里负责把记录和
// 文件系统里的 object 文件 hash 对齐。pipeline 后续只调用这一层，不直接拆
// cache record。

import object_artifact = "./object.jiang";
import object_hash = "./object_hash.jiang";
import object_index = "./object_index.jiang";
import object_key = "./object_key.jiang";
import qkey = "../incremental/key.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";

public object_artifact.ObjectArtifactLookup lookup_source_object_file(
    object_artifact.ObjectArtifactCache& cache,
    object_artifact.SourceObjectKey key
) {
    guard cache.load_source_object(key) is .some(artifact) else {
        return object_artifact.ObjectArtifactLookup.make_missing(.source_object);
    }
    guard object_hash.hash_file(artifact.path) is .some(actual_hash) else {
        return object_artifact.ObjectArtifactLookup.make_stale(
            artifact.kind,
            artifact.object_hash,
            artifact.path
        );
    }
    return cache.validate_source_object(key, actual_hash);
}

public object_artifact.ObjectArtifactStatus lookup_source_object_status(
    object_artifact.ObjectArtifactCache& cache,
    UInt8[]& cache_root,
    object_artifact.SourceObjectKey key,
    object_index.ObjectIndexContext context,
    UInt8[]& expected_relative_path
) {
    object_artifact.ObjectArtifactLookup memory = lookup_source_object_file(cache, key);
    if (memory.status != .missing) {
        return memory.status;
    }
    qkey.Fingerprint128 unit_key = object_artifact.source_object_fingerprint(key);
    guard object_index.load(cache_root, .source_object, unit_key) is .some(record) else {
        return missing_or_stale_index_status(cache_root, .source_object, unit_key);
    }
    if (!object_index.record_matches(record$.ref(), .source_object, unit_key, context)) {
        return .stale;
    }
    if (!object_index.source_dependency_matches(record$.ref(), key)) {
        return .stale;
    }
    return validate_index_object_status(cache_root, expected_relative_path, record$.ref());
}

@life(return: cache)
public object_artifact.ObjectArtifactLookup lookup_monomorph_object_file(
    object_artifact.ObjectArtifactCache& cache,
    object_key.StableInstanceKey& key
) {
    guard cache.load_monomorph_object(key) is .some(artifact) else {
        return object_artifact.ObjectArtifactLookup.make_missing(.monomorph_object);
    }
    guard object_hash.hash_file(artifact.path) is .some(actual_hash) else {
        return object_artifact.ObjectArtifactLookup.make_stale(
            artifact.kind,
            artifact.object_hash,
            artifact.path
        );
    }
    return cache.validate_monomorph_object(key, actual_hash);
}

public object_artifact.ObjectArtifactStatus lookup_monomorph_object_status(
    object_artifact.ObjectArtifactCache& cache,
    UInt8[]& cache_root,
    object_key.StableInstanceKey& key,
    object_index.ObjectIndexContext context,
    UInt8[]& expected_relative_path
) {
    object_artifact.ObjectArtifactLookup memory = lookup_monomorph_object_file(cache, key);
    if (memory.status != .missing) {
        return memory.status;
    }
    qkey.Fingerprint128 unit_key = object_key.stable_instance_fingerprint(key);
    guard object_index.load(cache_root, .monomorph_object, unit_key) is .some(record) else {
        return missing_or_stale_index_status(cache_root, .monomorph_object, unit_key);
    }
    if (!object_index.record_matches(record$.ref(), .monomorph_object, unit_key, context)) {
        return .stale;
    }
    if (!object_index.monomorph_dependency_matches(record$.ref(), key)) {
        return .stale;
    }
    return validate_index_object_status(cache_root, expected_relative_path, record$.ref());
}

object_artifact.ObjectArtifactStatus validate_index_object_status(
    UInt8[]& cache_root,
    UInt8[]& expected_relative_path,
    object_index.ObjectIndexRecord& record
) {
    if (!string.equal(record.relative_object_path.bytes(), expected_relative_path)) {
        return .stale;
    }
    guard object_index.object_path(cache_root, record) is .some(path) else {
        return .stale;
    }
    guard object_hash.hash_file(path.bytes()) is .some(actual_hash) else {
        return .stale;
    }
    if (actual_hash != record.object_hash) {
        return .stale;
    }
    return .hit;
}

object_artifact.ObjectArtifactStatus missing_or_stale_index_status(
    UInt8[]& cache_root,
    object_artifact.ObjectArtifactKind kind,
    qkey.Fingerprint128 unit_key
) {
    UInt8[]^ path = object_index.record_path(cache_root, kind, unit_key);
    if (system_fs.file_exists(path[..])) {
        return .stale;
    }
    return .missing;
}
