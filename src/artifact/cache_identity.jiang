// Artifact cache 的跨编译身份。
//
// 这里把编译上下文和 source 身份收敛为稳定的 128 位 key。路径层只消费这些 key，
// 不能重新解释 compiler、target、package 或源码内容。

import object_key = "./object_key.jiang";
import qkey = "../incremental/key.jiang";
import blake3 = "../support/blake3.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import string_support = "../support/string.jiang";
import env = "../system/env.jiang";
import std;

public struct ContextKey: Copyable, Hashable, Equatable {
    public qkey.Fingerprint128 fingerprint;

    public init(self, qkey.Fingerprint128 fingerprint) {
        self.fingerprint = fingerprint;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.fingerprint.hash(hasher);
    }

    public Bool equal(ContextKey& lhs, ContextKey& rhs) {
        return lhs.fingerprint == rhs.fingerprint;
    }
}

public struct StableSourceId: Copyable, Hashable, Equatable {
    public qkey.Fingerprint128 fingerprint;

    public init(self, qkey.Fingerprint128 fingerprint) {
        self.fingerprint = fingerprint;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.fingerprint.hash(hasher);
    }

    public Bool equal(StableSourceId& lhs, StableSourceId& rhs) {
        return lhs.fingerprint == rhs.fingerprint;
    }
}

public ContextKey context_key(
    qkey.Fingerprint128 compiler,
    qkey.Fingerprint128 language,
    qkey.Fingerprint128 target,
    qkey.Fingerprint128 toolchain,
    qkey.Fingerprint128 profile,
    qkey.Fingerprint128 import_resolution
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>();
    parts.add(compiler);
    parts.add(language);
    parts.add(target);
    parts.add(toolchain);
    parts.add(profile);
    parts.add(import_resolution);
    return ContextKey(object_key.combine_fingerprints(UInt64(120), parts$.ref()));
}

public StableSourceId stable_source_identity(
    UInt8[]& package_identity,
    UInt8[]& package_relative_path
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>();
    parts.add(text_fingerprint("source-package:", package_identity));
    parts.add(text_fingerprint("source-path:", package_relative_path));
    return StableSourceId(object_key.combine_fingerprints(UInt64(121), parts$.ref()));
}

public StableSourceId stable_source_identity(
    qkey.StableSymbolId package_identity,
    UInt8[]& package_dir,
    UInt8[]& source_path
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>();
    parts.add(qkey.Fingerprint128(package_identity.low, package_identity.high));
    UInt8[]^ relative_path = package_relative_source_path(package_dir, source_path);
    parts.add(text_fingerprint("source-path:", relative_path[..]));
    return StableSourceId(object_key.combine_fingerprints(UInt64(121), parts$.ref()));
}

public qkey.Fingerprint128 import_resolution_fingerprint(UInt8[]& configuration) {
    return text_fingerprint("import-resolution:", configuration);
}

public qkey.Fingerprint128 build_target_identity(UInt8[]& output_path) {
    return text_fingerprint("build-target:", output_path);
}

public qkey.Fingerprint128 build_invocation_fingerprint(
    UInt8[]& output_path,
    UInt8[]& linker_path,
    list.ArrayList<UInt8[]&>& link_args
) {
    list.ArrayList<qkey.Fingerprint128> parts! = list.ArrayList<qkey.Fingerprint128>();
    parts.add(text_fingerprint("build-output:", output_path));
    parts.add(text_fingerprint("build-linker:", linker_path));
    Int index! = 0;
    while (index < link_args.len()) {
        parts.add(text_fingerprint("build-link-arg:", link_args.get(index)));
        index = index + 1;
    }
    return object_key.combine_fingerprints(UInt64(122), parts$.ref());
}

public qkey.Fingerprint128 text_fingerprint(UInt8[]& domain, UInt8[]& text) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>(domain.length + text.length);
    append_bytes(bytes$.mut_ref(), domain);
    append_bytes(bytes$.mut_ref(), text);
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes.slice());
    return qkey.Fingerprint128(digest.a, digest.b);
}

public UInt8[]^ package_relative_source_path(UInt8[]& package_dir, UInt8[]& source_path) {
    Path normalized_dir = std.path.normalize(package_dir);
    Path normalized_source = std.path.normalize(source_path);
    UInt8[]& directory = normalized_dir.bytes();
    UInt8[]& source = normalized_source.bytes();
    if (!path_is_inside(source, directory)) {
        return normalized_source.into_slice();
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(source[directory.length + 1..source.length]);
    return builder.into_slice();
}

public UInt8[]^ relative_path(UInt8[]& base_dir, UInt8[]& source_path) {
    UInt8[]^ absolute_base = absolute_path(base_dir);
    UInt8[]^ absolute_source = absolute_path(source_path);
    Path normalized_base = std.path.normalize(absolute_base[..]);
    Path normalized_source = std.path.normalize(absolute_source[..]);
    UInt8[]& base = normalized_base.bytes();
    UInt8[]& source = normalized_source.bytes();
    if (path_is_inside(source, base)) {
        return copy_path(source[base.length + 1..source.length]);
    }
    if (path_is_inside(base, source)) {
        return parent_steps(base, source.length + 1);
    }
    Int common = common_directory_end(base, source);
    if (common < 0) { return copy_path(source); }
    std.StringBuilder builder! = std.StringBuilder();
    append_parent_steps(builder$.mut_ref(), base, common + 1);
    builder.append_valid_utf8(source[common + 1..source.length]);
    return builder.into_slice();
}

public UInt8[]^ resolve_relative_path(UInt8[]& base_dir, UInt8[]& relative) {
    Path normalized_base = std.path.normalize(base_dir);
    UInt8[]& base = normalized_base.bytes();
    Int relative_start! = 0;
    Int base_end! = base.length;
    while (has_parent_prefix(relative, relative_start)) {
        base_end = parent_directory_end(base, base_end);
        relative_start = relative_start + 3;
    }
    if (relative_start >= relative.length) {
        return copy_path(base[0..base_end]);
    }
    Path joined = std.path.join(base[0..base_end], relative[relative_start..relative.length]);
    return std.path.normalize(joined.bytes()).into_slice();
}

public Bool path_is_within(UInt8[]& path, UInt8[]& directory) {
    UInt8[]^ absolute_path_value = absolute_path(path);
    UInt8[]^ absolute_directory = absolute_path(directory);
    return path_is_inside(absolute_path_value[..], absolute_directory[..]);
}

public UInt8[]^ absolute_path(UInt8[]& path) {
    Path normalized = std.path.normalize(path);
    if (normalized.is_absolute()) { return copy_path(normalized.bytes()); }
    guard env.get("PWD") is .some(cwd) else { return copy_path(normalized.bytes()); }
    return std.path.join(cwd[..], normalized.bytes()).into_slice();
}

UInt8[]^ parent_steps(UInt8[]& path, Int start) {
    std.StringBuilder builder! = std.StringBuilder();
    append_parent_steps(builder$.mut_ref(), path, start);
    return builder.into_slice();
}

Bool has_parent_prefix(UInt8[]& path, Int start) {
    if (start + 3 > path.length) { return false; }
    return path[start] == UInt8(46)
        && path[start + 1] == UInt8(46)
        && path[start + 2] == UInt8(47);
}

Int parent_directory_end(UInt8[]& path, Int end) {
    Int index! = end;
    while (index > 1 && path[index - 1] == UInt8(47)) {
        index = index - 1;
    }
    while (index > 1 && path[index - 1] != UInt8(47)) {
        index = index - 1;
    }
    if (index > 1) { return index - 1; }
    return index;
}

Void append_parent_steps(std.StringBuilder&! builder, UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length) {
        if (index == start || path[index - 1] == UInt8(47)) {
            builder.append("../");
        }
        index = index + 1;
    }
}

Int common_directory_end(UInt8[]& lhs, UInt8[]& rhs) {
    Int limit! = lhs.length;
    if (rhs.length < limit) { limit = rhs.length; }
    Int common! = -1;
    Int index! = 0;
    while (index < limit && lhs[index] == rhs[index]) {
        if (lhs[index] == UInt8(47)) { common = index; }
        index = index + 1;
    }
    return common;
}

UInt8[]^ copy_path(UInt8[]& path) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(path);
    return builder.into_slice();
}

Bool path_is_inside(UInt8[]& path, UInt8[]& directory) {
    if (directory.length == 0 || path.length <= directory.length) {
        return false;
    }
    if (path[directory.length] != UInt8(47)) {
        return false;
    }
    Int index! = 0;
    while (index < directory.length) {
        if (path[index] != directory[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Void append_bytes(list.ArrayList<UInt8>&! bytes, UInt8[]& value) {
    Int index! = 0;
    while (index < value.length) {
        bytes.add(value[index]);
        index = index + 1;
    }
}
