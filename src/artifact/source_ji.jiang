// Source artifact 到 `.ji` 物理容器的适配层。
//
// `source.jiang` 定义 import/interface 的内存表示；这里负责把这些 section
// 编码成 `.ji` 容器。读取命中时也先拿到 section bytes，再由后续 decoder
// 恢复成当前 session 的 SymbolId/StableSymbolId 结构。

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source/source.jiang";
import list = "../support/list.jiang";
import ji = "./ji_file.jiang";
import source_artifact = "./source.jiang";
import source_fingerprint = "./source_fingerprint.jiang";

public UInt64 artifact_version_hash(UInt8[]& compiler_version) {
    // `.ji` 的版本 hash 同时包含编译器版本和 source artifact schema seed。
    // 只要 section payload 编码发生变化，就 bump seed，让旧缓存自动失效。
    return source.content_hash(compiler_version) ^ source.content_hash("source-ji-v35");
}

public struct SourceJiSections: Movable {
    public Bool! has_import_summary;
    public list.ArrayList<UInt8>! import_summary;
    public Bool! has_interface_section;
    public list.ArrayList<UInt8>! interface_section;
    public Bool! has_generic_templates;
    public list.ArrayList<UInt8>! generic_templates;

    public init() {
        self.has_import_summary = false;
        self.import_summary = list.ArrayList<UInt8>();
        self.has_interface_section = false;
        self.interface_section = list.ArrayList<UInt8>();
        self.has_generic_templates = false;
        self.generic_templates = list.ArrayList<UInt8>();
    }
}

public ji.JiFileImage? build_source_ji_image(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    UInt64 compiler_version
) {
    list.ArrayList<ji.JiSectionPayload>! payloads = list.ArrayList<ji.JiSectionPayload>();
    UInt64?! source_hash = null;

    if (cache.load_import_summary(source_id) is .some(summary)) {
        source_hash = summary.source_hash;
        add_import_summary_payload(ctx, payloads$.ref(), summary);
    }

    if (cache.load_interface(source_id) is .some(module_interface)) {
        if (source_hash == null) {
            source_hash = module_interface.source_hash;
        }
        add_interface_payload(ctx, payloads$.ref(), module_interface);
        add_generic_templates_payload(ctx, payloads$.ref(), module_interface);
    }

    if (payloads.empty()) {
        return null;
    }
    guard source_hash is .some(hash) else { return null; }
    return ji.build_ji_file_image(compiler_version, hash, payloads$.move());
}

public Bool write_source_ji_file(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    UInt64 compiler_version,
    UInt8[]& path
) {
    guard build_source_ji_image(ctx, cache, source_id, compiler_version) is .some(image) else {
        return false;
    }
    return ji.write_ji_file(path, image$.ref());
}

public SourceJiSections? read_source_ji_sections(UInt8[]& path) {
    guard ji.read_ji_file(path) is .some(image) else { return null; }
    SourceJiSections! sections = SourceJiSections();
    Int! index = 0;
    while (index < image.sections.len()) {
        ji.JiSectionEntry entry = image.sections.entry_at(index);
        guard image.read_at(entry.offset, entry.length) is .some(bytes) else { return null; }
        record_source_section(sections$.ref(), entry.kind, bytes);
        index = index + 1;
    }
    return sections$.move();
}

public Bool load_source_artifacts_from_ji(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    UInt8[]& path,
    UInt64 expected_compiler_version
) {
    guard ji.read_ji_file(path) is .some(image) else {
        add_source_ji_warning(ctx, "failed to decode source artifact file", "source_ji_decode_failed");
        return false;
    }
    return load_source_artifacts_from_image(ctx, cache, source_id, image$.ref(), expected_compiler_version);
}

public Bool load_source_artifacts_from_image(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    ji.JiFileImage& image,
    UInt64 expected_compiler_version
) {
    if (image.header.compiler_version != expected_compiler_version) {
        add_source_ji_warning(ctx, "source artifact compiler version mismatch", "source_ji_version_mismatch");
        return false;
    }

    UInt64 expected_source_hash = ctx.store.sources.get(source_id).content_hash;
    if (image.header.source_hash != expected_source_hash) {
        add_source_ji_warning(ctx, "source artifact source hash mismatch", "source_ji_hash_mismatch");
        return false;
    }
    if (!load_import_summary_from_image(ctx, cache, source_id, image)) {
        add_source_ji_warning(ctx, "failed to decode source import summary", "source_ji_import_decode_failed");
        return false;
    }
    if (!load_interface_from_image(ctx, cache, source_id, image)) {
        add_source_ji_warning(ctx, "failed to decode source module interface", "source_ji_interface_decode_failed");
        return false;
    }
    return true;
}

() add_source_ji_warning(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .warning,
            .incremental,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

() add_import_summary_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>& payloads,
    source_artifact.ImportSummary& summary
) {
    payloads.add(source_fingerprint.import_summary_payload(ctx, summary));
}

() add_interface_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>& payloads,
    source_artifact.ModuleInterface& module_interface
) {
    payloads.add(source_fingerprint.module_interface_payload(ctx, module_interface));
}

() add_generic_templates_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>& payloads,
    source_artifact.ModuleInterface& module_interface
) {
    if (module_interface.generic_templates.len() == 0) {
        return;
    }
    payloads.add(source_fingerprint.generic_templates_payload(ctx, module_interface));
}

Bool load_import_summary_from_image(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    ji.JiFileImage& image
) {
    guard image.read_section(.import_summary) is .some(bytes) else { return true; }
    guard source_fingerprint.decode_import_summary_section(ctx, source_id, bytes) is .some(summary) else {
        return false;
    }
    cache.store_import_summary(source_id, summary$.move());
    return true;
}

Bool load_interface_from_image(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    ji.JiFileImage& image
) {
    guard image.read_section(.interface_section) is .some(bytes) else { return true; }
    UInt64 source_hash = image.header.source_hash;
    guard source_fingerprint.decode_module_interface_section(ctx, source_id, source_hash, bytes) is .some(iface) else {
        return false;
    }
    source_artifact.ModuleInterface! loaded = iface$.move();
    if (!load_generic_templates_from_image(ctx, loaded$.ref(), image)) {
        return false;
    }
    cache.store_interface(source_id, loaded$.move());
    return true;
}

Bool load_generic_templates_from_image(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    ji.JiFileImage& image
) {
    guard image.read_section(.generic_templates) is .some(bytes) else { return true; }
    return source_fingerprint.decode_generic_templates_section(ctx, module_interface, bytes);
}

() record_source_section(SourceJiSections!& sections, ji.JiSectionKind kind, UInt8[]& bytes) {
    if (kind == .import_summary) {
        sections.has_import_summary = true;
        sections.import_summary = copy_bytes(bytes);
        return;
    }
    if (kind == .interface_section) {
        sections.has_interface_section = true;
        sections.interface_section = copy_bytes(bytes);
        return;
    }
    if (kind == .generic_templates) {
        sections.has_generic_templates = true;
        sections.generic_templates = copy_bytes(bytes);
        return;
    }
}

list.ArrayList<UInt8> copy_bytes(UInt8[]& bytes) {
    list.ArrayList<UInt8> result = list.ArrayList<UInt8>(bytes.length);
    Int! index = 0;
    while (index < bytes.length) {
        result.add(bytes[index]);
        index = index + 1;
    }
    return result$.move();
}
