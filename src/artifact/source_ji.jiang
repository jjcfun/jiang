// Source artifact 到 `.ji` 物理容器的适配层。
//
// `source.jiang` 定义 import/interface 的内存表示；这里负责把这些 section
// 编码成 `.ji` 容器。读取命中时也先拿到 section bytes，再由后续 decoder
// 恢复成当前 session 的 SymbolId/StableSymbolId 结构。

import context = "../context.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source_identity = "../incremental/source_identity.jiang";
import module_graph = "../resolve/module_graph.jiang";
import resolve_store = "../resolve/store.jiang";
import source = "../source.jiang";
import system_fs = "../system/fs.jiang";
import list = "../support/list.jiang";
import ji = "./ji_file.jiang";
import artifact_path = "./path.jiang";
import cache_identity = "./cache_identity.jiang";
import source_artifact = "./source.jiang";
import source_fingerprint = "./source_fingerprint.jiang";

public UInt64 artifact_version_hash(UInt8[]& compiler_version) {
    // `.ji` 的版本 hash 同时包含编译器版本和 source artifact schema seed。
    // 只要 section payload 编码发生变化，就 bump seed，让旧缓存自动失效。
    return source.content_hash(compiler_version) ^ source.content_hash("source-ji-v69");
}

public struct SourceJiSections: Movable {
    public Bool has_import_summary!;
    public list.ArrayList<UInt8> import_summary!;
    public Bool has_interface_section!;
    public list.ArrayList<UInt8> interface_section!;
    public Bool has_generic_templates!;
    public list.ArrayList<UInt8> generic_templates!;
    public Bool has_declaration_observations!;
    public list.ArrayList<UInt8> declaration_observations!;

    public init(self) {
        self.has_import_summary = false;
        self.import_summary = list.ArrayList<UInt8>();
        self.has_interface_section = false;
        self.interface_section = list.ArrayList<UInt8>();
        self.has_generic_templates = false;
        self.generic_templates = list.ArrayList<UInt8>();
        self.has_declaration_observations = false;
        self.declaration_observations = list.ArrayList<UInt8>();
    }
}

public ji.JiFileImage? build_source_ji_image(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    UInt64 compiler_version,
    ji.JiSourceMetadata? metadata = null
) {
    list.ArrayList<ji.JiSectionPayload> payloads! = list.ArrayList<ji.JiSectionPayload>();
    UInt64? source_hash! = null;

    if (cache.load_import_summary(source_id) is .some(summary)) {
        source_hash = summary.source_hash;
        add_import_summary_payload(ctx, payloads$.mut_ref(), summary);
    }

    if (cache.load_interface(source_id) is .some(module_interface)) {
        if (source_hash == null) {
            source_hash = module_interface.source_hash;
        }
        add_interface_payload(ctx, payloads$.mut_ref(), module_interface);
        add_generic_templates_payload(ctx, payloads$.mut_ref(), module_interface);
    }

    if (cache.load_observations(source_id) is .some(observations)) {
        payloads.add(source_fingerprint.declaration_observations_payload(observations));
    }

    if (payloads.empty()) {
        return null;
    }
    guard source_hash is .some(hash) else { return null; }
    ji.JiSourceMetadata effective! = ji.JiSourceMetadata(hash);
    if (metadata is .some(provided)) {
        effective = provided;
    } else if (cache.load_interface(source_id) is .some(module_interface)) {
        effective.package_interface_fingerprint = module_interface.interface_hash;
        effective.public_interface_fingerprint = module_interface.public_interface_hash;
    }
    return ji.build_ji_file_image(compiler_version, effective, payloads);
}

public Bool write_source_ji_file(
    context.CompilerContext& ctx,
    source_artifact.SourceArtifactCache& cache,
    source.SourceId source_id,
    UInt64 compiler_version,
    UInt8[]& path,
    ji.JiSourceMetadata? metadata = null
) {
    guard build_source_ji_image(
        ctx,
        cache,
        source_id,
        compiler_version,
        metadata
    ) is .some(image) else {
        return false;
    }
    return ji.write_ji_file(path, image$.ref());
}

// 写入整个 package 的 source interface cache。source artifact 只缓存跨编译
// 可复用的公开事实，不能写入 session-local Semantic Model/Type/JIL 对象。
public Void write_package_source_artifact_cache(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version
) {
    UInt8[]^ source_dir = artifact_path.source_dir(artifact_cache_dir);
    if (!system_fs.create_dirs(source_dir[..])) {
        return;
    }

    UInt64 version_hash = artifact_version_hash(compiler_version);
    Int index! = 0;
    while (index < graph.module_count()) {
        write_module_source_artifact(ctx, graph.module_at(index), artifact_cache_dir, version_hash);
        index = index + 1;
    }
}

public cache_identity.StableSourceId? source_identity_for_module(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    return source_identity.for_module(ctx.store$.ref(), module_id);
}

// 为单个 module 写入 `.ji` interface。没有 stable source identity 的 module
// 不具备跨编译身份，不能进入本地 artifact cache。
Void write_module_source_artifact(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& artifact_cache_dir,
    UInt64 compiler_version
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    if (ctx.store.sources.has_overlay(module.source_id)) { return; }
    // interface-only 模块沿用磁盘中的成功快照。只发布本轮真正从源码
    // lower 的模块，避免单文件修改后重写整个 package 的 `.ji`。
    if (module.interface_only) { return; }
    if (!source_snapshot_matches(ctx, module_id)) { return; }
    guard source_identity_for_module(ctx, module_id) is .some(source_identity) else {
        return;
    }
    guard acquire_source_artifact_lock(
        artifact_cache_dir,
        source_identity
    ) is .some(held_lock) else {
        return;
    }
    system_fs.FileLock lock! = held_lock;
    UInt8[]^ artifact_file = artifact_path.stable_source_ji_path(
        artifact_cache_dir,
        source_identity
    );
    ji.JiSourceMetadata metadata = source_metadata(ctx, module_id, source_identity);
    write_source_ji_file(
        ctx,
        ctx.store.artifacts$.ref(),
        module.source_id,
        compiler_version,
        artifact_file[..],
        metadata
    );
}

public system_fs.FileLock? acquire_module_artifact_lock(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& artifact_cache_dir
) {
    guard source_identity_for_module(ctx, module_id) is .some(source_identity) else {
        return null;
    }
    return acquire_source_artifact_lock(artifact_cache_dir, source_identity);
}

system_fs.FileLock? acquire_source_artifact_lock(
    UInt8[]& artifact_cache_dir,
    cache_identity.StableSourceId source_identity
) {
    UInt8[]^ directory = artifact_path.lock_dir(artifact_cache_dir);
    if (!system_fs.create_dirs(directory[..])) { return null; }
    UInt8[]^ path = artifact_path.source_lock_path(artifact_cache_dir, source_identity);
    return system_fs.acquire_file_lock(path[..]);
}

// artifact 只能对应本轮读取到的源码快照。文件在分析期间发生变化时，
// 放弃发布旧 interface，由下一次编译重新读取。
public Bool source_snapshot_matches(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    if (source_record.key.kind != .file) { return true; }
    guard system_fs.read_all(source_record.key.value) is .some(text) else {
        return false;
    }
    return source.content_hash(text) == source_record.content_hash;
}

ji.JiSourceMetadata source_metadata(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    cache_identity.StableSourceId source_identity
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    ji.JiSourceMetadata metadata! = ji.JiSourceMetadata(source_record.content_hash);
    metadata.stable_source_identity = source_identity.fingerprint;
    record_source_file_metadata(metadata$.mut_ref(), source_record);
    if (ctx.store.artifacts.load_interface(module.source_id) is .some(module_interface)) {
        metadata.package_interface_fingerprint = module_interface.interface_hash;
        metadata.public_interface_fingerprint = module_interface.public_interface_hash;
    }
    return metadata;
}

Void record_source_file_metadata(
    ji.JiSourceMetadata&! metadata,
    source.SourceRecord source_record
) {
    if (source_record.key.kind != .file) { return; }
    guard system_fs.file_metadata(source_record.key.value) is .some(file_metadata) else {
        return;
    }
    if (file_metadata.size < 0) { return; }
    metadata.source_modified_ns = file_metadata.modified_ns;
    metadata.source_size = UInt64(file_metadata.size);
}

public SourceJiSections? read_source_ji_sections(UInt8[]& path) {
    guard ji.read_ji_file(path) is .some(image) else { return null; }
    SourceJiSections sections! = SourceJiSections();
    Int index! = 0;
    while (index < image.sections.len()) {
        ji.JiSectionEntry entry = image.sections.entry_at(index);
        guard image.read_at(entry.offset, entry.length) is .some(bytes) else { return null; }
        record_source_section(sections$.mut_ref(), entry.kind, bytes);
        index = index + 1;
    }
    return sections;
}

public Bool load_source_artifacts_from_ji(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    UInt64 expected_compiler_version,
    qkey.Fingerprint128 expected_source_identity
) {
    guard ji.read_ji_layout(path) is .some(layout) else {
        // 旧格式、损坏或并发留下的半成品 source artifact 都按 cache miss 处理。
        return false;
    }
    return load_source_artifacts_from_layout(
        store,
        source_id,
        path,
        layout$.ref(),
        expected_compiler_version,
        expected_source_identity
    );
}

// Import discovery 只读取 header、section table 和 import summary。interface、
// generic template 留到真正消费它的阶段再读取。
public Bool load_import_summary_from_ji(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    UInt64 expected_compiler_version,
    qkey.Fingerprint128 expected_source_identity
) {
    guard ji.read_ji_layout(path) is .some(layout) else { return false; }
    if (layout.header.compiler_version != expected_compiler_version) { return false; }
    if (layout.header.stable_source_identity != expected_source_identity) { return false; }
    UInt64 expected_source_hash = store.sources.get(source_id).content_hash;
    if (layout.header.source_hash != expected_source_hash) { return false; }
    return load_import_summary_from_layout(store, source_id, path, layout$.ref());
}

// Importer freshness 只读取 declaration observation metadata，不解码
// ModuleInterface 或 generic template payload。
public Bool load_declaration_observations_from_ji(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    UInt64 expected_compiler_version,
    qkey.Fingerprint128 expected_source_identity
) {
    guard ji.read_ji_layout(path) is .some(layout) else { return false; }
    if (layout.header.compiler_version != expected_compiler_version) { return false; }
    if (layout.header.stable_source_identity != expected_source_identity) { return false; }
    UInt64 expected_source_hash = store.sources.get(source_id).content_hash;
    if (layout.header.source_hash != expected_source_hash) { return false; }
    return load_observations_from_layout(
        store.artifacts$.mut_ref(),
        source_id,
        path,
        layout$.ref()
    );
}

Bool load_source_artifacts_from_layout(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    ji.JiDiskLayout& layout,
    UInt64 expected_compiler_version,
    qkey.Fingerprint128 expected_source_identity
) {
    if (layout.header.compiler_version != expected_compiler_version) {
        return false;
    }
    if (layout.header.stable_source_identity != expected_source_identity) {
        return false;
    }
    if (!has_semantic_section(layout)) {
        return false;
    }

    UInt64 expected_source_hash = store.sources.get(source_id).content_hash;
    if (layout.header.source_hash != expected_source_hash) {
        return false;
    }
    if (!load_import_summary_from_layout(store, source_id, path, layout)) {
        return false;
    }
    if (!load_interface_from_layout(store, source_id, path, layout)) {
        return false;
    }
    return true;
}

Bool has_semantic_section(ji.JiDiskLayout& layout) {
    if (layout.sections.find(.import_summary) != null) { return true; }
    if (layout.sections.find(.interface_section) != null) { return true; }
    return layout.sections.find(.generic_templates) != null;
}

Void add_import_summary_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>&! payloads,
    source_artifact.ImportSummary& summary
) {
    payloads.add(source_fingerprint.import_summary_payload(ctx, summary));
}

Void add_interface_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>&! payloads,
    source_artifact.ModuleInterface& module_interface
) {
    payloads.add(source_fingerprint.module_interface_payload(ctx, module_interface));
}

Void add_generic_templates_payload(
    context.CompilerContext& ctx,
    list.ArrayList<ji.JiSectionPayload>&! payloads,
    source_artifact.ModuleInterface& module_interface
) {
    if (module_interface.generic_templates.len() == 0) {
        return;
    }
    payloads.add(source_fingerprint.generic_templates_payload(ctx, module_interface));
}

Bool load_import_summary_from_layout(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    ji.JiDiskLayout& layout
) {
    if (layout.sections.find(.import_summary) == null) { return true; }
    guard read_section(store.artifacts$.mut_ref(), path, layout, .import_summary)
        is .some(bytes) else {
        return false;
    }
    UInt64 started = store.artifacts.section_timing_start();
    guard source_fingerprint.decode_import_summary_section(
        store.symbols$.mut_ref(),
        source_id,
        bytes
    )
        is .some(summary) else {
        return false;
    }
    store.artifacts.record_section_decode(.import_summary, started);
    store.artifacts.store_import_summary(source_id, summary);
    return true;
}

Bool load_interface_from_layout(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    UInt8[]& path,
    ji.JiDiskLayout& layout
) {
    if (layout.sections.find(.interface_section) == null) { return true; }
    guard read_section(store.artifacts$.mut_ref(), path, layout, .interface_section)
        is .some(bytes) else {
        return false;
    }
    UInt64 source_hash = layout.header.source_hash;
    UInt64 started = store.artifacts.section_timing_start();
    guard source_fingerprint.decode_module_interface_section(
        store.symbols$.mut_ref(),
        source_id,
        source_hash,
        bytes,
        layout.header.package_interface_fingerprint,
        layout.header.public_interface_fingerprint
    ) is .some(iface) else {
        return false;
    }
    store.artifacts.record_section_decode(.interface_section, started);
    source_artifact.ModuleInterface loaded! = iface;
    if (!load_generic_templates_from_layout(
        store.artifacts$.mut_ref(),
        loaded$.mut_ref(),
        path,
        layout
    )) {
        return false;
    }
    store.artifacts.store_interface(source_id, loaded);
    return true;
}

Bool load_observations_from_layout(
    source_artifact.SourceArtifactCache&! cache,
    source.SourceId source_id,
    UInt8[]& path,
    ji.JiDiskLayout& layout
) {
    if (layout.sections.find(.declaration_observations) == null) { return false; }
    guard read_section(cache, path, layout, .declaration_observations)
        is .some(bytes) else {
        return false;
    }
    UInt64 started = cache.section_timing_start();
    guard source_fingerprint.decode_declaration_observations_section(bytes)
        is .some(observations) else {
        return false;
    }
    cache.record_section_decode(.declaration_observations, started);
    cache.store_observations(source_id, observations);
    return true;
}

Bool load_generic_templates_from_layout(
    source_artifact.SourceArtifactCache&! cache,
    source_artifact.ModuleInterface&! module_interface,
    UInt8[]& path,
    ji.JiDiskLayout& layout
) {
    if (layout.sections.find(.generic_templates) == null) { return true; }
    guard read_section(cache, path, layout, .generic_templates) is .some(bytes) else {
        return false;
    }
    UInt64 started = cache.section_timing_start();
    Bool decoded =
        source_fingerprint.decode_generic_templates_section(module_interface, bytes);
    cache.record_section_decode(.generic_templates, started);
    return decoded;
}

@life()
public UInt8[]&? read_section(
    source_artifact.SourceArtifactCache&! cache,
    UInt8[]& path,
    ji.JiDiskLayout& layout,
    ji.JiSectionKind kind
) {
    UInt64 started = cache.section_timing_start();
    UInt8[]&? result = ji.read_ji_section(path, layout, kind);
    Int length! = 0;
    if (layout.sections.find(kind) is .some(entry)) {
        length = entry.length;
    }
    cache.record_section_read(kind, length, started);
    return result;
}

Void record_source_section(SourceJiSections&! sections, ji.JiSectionKind kind, UInt8[]& bytes) {
    if (kind == .import_summary) {
        sections.has_import_summary = true;
        sections.import_summary = copy_bytes(bytes);
        return;
    }
    if (kind == .interface_section) {
        sections.has_interface_section = true;
        sections.interface_section = copy_bytes(bytes);
        return;
    }
    if (kind == .generic_templates) {
        sections.has_generic_templates = true;
        sections.generic_templates = copy_bytes(bytes);
        return;
    }
    if (kind == .declaration_observations) {
        sections.has_declaration_observations = true;
        sections.declaration_observations = copy_bytes(bytes);
        return;
    }
}

list.ArrayList<UInt8> copy_bytes(UInt8[]& bytes) {
    list.ArrayList<UInt8> result! = list.ArrayList<UInt8>(bytes.length);
    Int index! = 0;
    while (index < bytes.length) {
        result.add(bytes[index]);
        index = index + 1;
    }
    return result;
}
