// Artifact cache 根目录的显式维护操作。
//
// 清理只接受不含 `.`/`..` 路径段的具体目录，避免空路径、文件系统根
// 或路径折叠把删除范围扩大到用户没有选择的位置。

import system_fs = "../system/fs.jiang";

public enum CleanResult {
    cleaned,
    unsafe_path,
    failed,
}

public CleanResult clean(UInt8[]& root) {
    if (!clean_path_is_safe(root)) { return .unsafe_path; }
    if (system_fs.remove_tree(root)) { return .cleaned; }
    return .failed;
}

Bool clean_path_is_safe(UInt8[]& path) {
    Int segment_count! = 0;
    Int index! = 0;
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment(path, index);
        if (start == index) { continue; }
        if (segment_is_dot(path[start..index])) { return false; }
        segment_count = segment_count + 1;
    }
    return segment_count > 0;
}

Int skip_separators(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && is_separator(path[index])) {
        index = index + 1;
    }
    return index;
}

Int scan_segment(UInt8[]& path, Int start) {
    Int index! = start;
    while (index < path.length && !is_separator(path[index])) {
        index = index + 1;
    }
    return index;
}

Bool is_separator(UInt8 value) {
    return value == UInt8(47) || value == UInt8(92);
}

Bool segment_is_dot(UInt8[]& segment) {
    if (segment.length == 1 && segment[0] == UInt8(46)) { return true; }
    return segment.length == 2
        && segment[0] == UInt8(46)
        && segment[1] == UInt8(46);
}
