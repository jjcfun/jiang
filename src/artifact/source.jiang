// 增量编译的 source artifact 边界。
//
// 这里的结构是 `.ji` section 解码后的内存表示：SymbolId/DefKind 等值只在
// 当前 session 内有效；真正落盘时由 section encoder 负责写入文本和稳定 key。

import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import query_dependency = "../db/query_dependency.jiang";
import def = "../resolve/def.jiang";
import store = "../resolve/store.jiang";
import source = "../source.jiang";
import ji = "./ji_file.jiang";
import system_time = "../system/time.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public enum ArtifactStatus {
    missing,
    hit,
    stale,
}

public struct ImportSummaryEntry: Copyable {
    public store.ImportKind kind;
    public def.Visibility visibility;
    public Bool flatten;
    public qid.SymbolId path_symbol;
    public qid.SymbolId? alias_symbol;
    public qkey.Fingerprint128? target_source_identity;

    public init(self,
        store.ImportKind kind,
        def.Visibility visibility,
        Bool flatten,
        qid.SymbolId path_symbol,
        qid.SymbolId? alias_symbol,
        qkey.Fingerprint128? target_source_identity = null
    ) {
        self.kind = kind;
        self.visibility = visibility;
        self.flatten = flatten;
        self.path_symbol = path_symbol;
        self.alias_symbol = alias_symbol;
        self.target_source_identity = target_source_identity;
    }
}

public struct AliasExportSummary: Copyable {
    public qid.SymbolId alias_symbol;
    public qkey.StableSymbolId target_stable_id;

    public init(self, qid.SymbolId alias_symbol, qkey.StableSymbolId target_stable_id) {
        self.alias_symbol = alias_symbol;
        self.target_stable_id = target_stable_id;
    }
}

public struct ImportSummary: Movable {
    public source.SourceId source_id;
    public UInt64 source_hash;
    public Int source_revision;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public qid.SymbolId source_path;
    public qkey.Fingerprint128 import_context_fingerprint;
    public list.ArrayList<ImportSummaryEntry> imports;
    public list.ArrayList<AliasExportSummary> public_aliases;

    public init(self,
        source.SourceId source_id,
        UInt64 source_hash,
        Int source_revision,
        qid.SymbolId package_name,
        qid.SymbolId module_path,
        qid.SymbolId source_path,
        qkey.Fingerprint128 import_context_fingerprint
    ) {
        self.source_id = source_id;
        self.source_hash = source_hash;
        self.source_revision = source_revision;
        self.package_name = package_name;
        self.module_path = module_path;
        self.source_path = source_path;
        self.import_context_fingerprint = import_context_fingerprint;
        self.imports = list.ArrayList<ImportSummaryEntry>();
        self.public_aliases = list.ArrayList<AliasExportSummary>();
    }

    public Void add_import(self, ImportSummaryEntry entry) {
        self.imports.add(entry);
    }

    public Void add_public_alias(self, AliasExportSummary alias_export) {
        self.public_aliases.add(alias_export);
    }
}

public struct InterfaceDeclSummary: Copyable {
    public qkey.StableSymbolId stable_id;
    public def.DefKind kind;
    public def.NameDomain domain;
    public def.Visibility visibility;
    public qid.SymbolId name;
    public qkey.StableSymbolId? owner;
    public qkey.Fingerprint128? disambiguator;
    public qkey.Fingerprint128 signature_fingerprint!;
    public qkey.Fingerprint128 body_fingerprint!;
    public Bool mutable_binding;
    public Bool is_const;
    public Bool is_external;
    public Int extern_kind;
    public Int inline_mode;
    public Bool naked;
    public qid.SymbolId? link_symbol;
    public Bool has_explicit_empty_lifetime_contract;

    public init(self,
        qkey.StableSymbolId stable_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        qid.SymbolId name,
        qkey.StableSymbolId? owner
    ) {
        self.stable_id = stable_id;
        self.kind = kind;
        self.domain = domain;
        self.visibility = visibility;
        self.name = name;
        self.owner = owner;
        self.disambiguator = null;
        self.signature_fingerprint = qkey.Fingerprint128();
        self.body_fingerprint = qkey.Fingerprint128();
        self.mutable_binding = false;
        self.is_const = false;
        self.is_external = false;
        self.extern_kind = 0;
        self.inline_mode = 0;
        self.naked = false;
        self.link_symbol = null;
        self.has_explicit_empty_lifetime_contract = false;
    }
}

// `.ji` 内与 declaration 语义 section 同步持久化的精确 query observation。
// 这里只保存 stable key/fingerprint，不保存 QueryValue 或 session-local 句柄。
public struct InterfaceQueryObservation: Copyable {
    public query_dependency.StableQueryKey query;
    public query_dependency.ObservedQueryDependency dependency;

    public init(
        self,
        query_dependency.StableQueryKey query,
        query_dependency.ObservedQueryDependency dependency
    ) {
        self.query = query;
        self.dependency = dependency;
    }
}

public enum InterfaceTypeRefKind {
    invalid_type,
    unit_type,
    named_type,
    layered_type,
    array_type,
    errorable_type,
    function_type,
    tuple_type,
    infer_type,
    trait_companion_type,
    const_expression,
    effect_type,
    self_type,
}

public struct InterfaceTypeRef: Movable {
    public Int kind_tag!;
    public Bool has_stable_def!;
    public UInt64 stable_def_low!;
    public UInt64 stable_def_high!;
    public list.ArrayList<UInt8[]&> args;
    public list.ArrayList<UInt8[]&> contract_names;
    public Int count_kind!;
    public UInt64 count_value!;
    public Int sentinel_kind!;
    public UInt64 sentinel_value!;

    public init(self, InterfaceTypeRefKind kind) {
        self.kind_tag = interface_type_ref_kind_tag(kind);
        self.has_stable_def = false;
        self.stable_def_low = 0;
        self.stable_def_high = 0;
        self.args = list.ArrayList<UInt8[]&>();
        self.contract_names = list.ArrayList<UInt8[]&>();
        self.count_kind = 0;
        self.count_value = 0;
        self.sentinel_kind = 0;
        self.sentinel_value = 0;
    }

    public InterfaceTypeRef invalid_type() {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.invalid_type);
        type_ref.kind_tag = 0;
        return type_ref;
    }

    public InterfaceTypeRef unit_type() {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.unit_type);
        type_ref.kind_tag = 1;
        return type_ref;
    }

    public InterfaceTypeRef named_type(UInt64 stable_def_low, UInt64 stable_def_high) {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.named_type);
        type_ref.kind_tag = 2;
        type_ref.has_stable_def = true;
        type_ref.stable_def_low = stable_def_low;
        type_ref.stable_def_high = stable_def_high;
        return type_ref;
    }

    public InterfaceTypeRef function_type() {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.function_type);
        type_ref.kind_tag = 6;
        return type_ref;
    }

    public Void set_function_effects(self, Bool has_unsafe, Bool has_async, qkey.StableSymbolId? domain) {
        self.count_kind = function_effect_flags(has_unsafe, has_async);
        if (domain is .some(stable_id)) {
            self.sentinel_kind = 1;
            self.count_value = stable_id.low;
            self.sentinel_value = stable_id.high;
            return;
        }
        self.sentinel_kind = 0;
        self.count_value = 0;
        self.sentinel_value = 0;
    }

    public Bool function_has_unsafe(self) {
        return (self.count_kind & 1) != 0;
    }

    public Bool function_has_async(self) {
        return (self.count_kind & 2) != 0;
    }

    public qkey.StableSymbolId? function_domain_stable_id(self) {
        if (self.sentinel_kind == 0) { return null; }
        return qkey.StableSymbolId(self.count_value, self.sentinel_value);
    }

    public InterfaceTypeRef tuple_type() {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.tuple_type);
        type_ref.kind_tag = 7;
        return type_ref;
    }

    public InterfaceTypeRef infer_type() {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.infer_type);
        type_ref.kind_tag = 8;
        return type_ref;
    }

    public InterfaceTypeRef trait_companion_type(
        UInt64 stable_def_low,
        UInt64 stable_def_high,
        Int companion_kind
    ) {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.trait_companion_type);
        type_ref.kind_tag = 9;
        type_ref.has_stable_def = true;
        type_ref.stable_def_low = stable_def_low;
        type_ref.stable_def_high = stable_def_high;
        type_ref.count_kind = companion_kind;
        return type_ref;
    }

    public InterfaceTypeRef self_type(UInt64 stable_def_low, UInt64 stable_def_high) {
        InterfaceTypeRef type_ref! = InterfaceTypeRef(InterfaceTypeRefKind.self_type);
        type_ref.kind_tag = 12;
        type_ref.has_stable_def = true;
        type_ref.stable_def_low = stable_def_low;
        type_ref.stable_def_high = stable_def_high;
        return type_ref;
    }

    public Void add_arg(self, InterfaceTypeRef arg) {
        self.args.add(encode_type_ref_payload(arg$.ref()));
    }

    public Int arg_count(self) {
        return self.args.len();
    }

    public InterfaceTypeRef arg_at(self, Int index) {
        return decode_type_ref_payload(self.args.get(index));
    }

    public Void add_contract_name(self, UInt8[]& name) {
        self.contract_names.add(name);
    }

    public Int contract_name_count(self) {
        return self.contract_names.len();
    }

    public UInt8[]& contract_name_at(self, Int index) {
        return self.contract_names.get(index);
    }
}

UInt8[]& encode_type_ref_payload(InterfaceTypeRef& type_ref) {
    TypeRefPayloadWriter writer! = TypeRefPayloadWriter();
    writer.write_int(persistent_type_ref_tag(type_ref));
    writer.write_bool(type_ref.has_stable_def);
    if (type_ref.has_stable_def) {
        writer.write_uint64(type_ref.stable_def_low);
        writer.write_uint64(type_ref.stable_def_high);
    }
    writer.write_int(type_ref.count_kind);
    writer.write_uint64(type_ref.count_value);
    writer.write_int(type_ref.sentinel_kind);
    writer.write_uint64(type_ref.sentinel_value);
    writer.write_int(type_ref.args.len());
    Int index! = 0;
    while (index < type_ref.args.len()) {
        UInt8[]& arg = type_ref.args.get(index);
        writer.write_bytes_with_length(arg);
        index = index + 1;
    }
    writer.write_int(type_ref.contract_names.len());
    index = 0;
    while (index < type_ref.contract_names.len()) {
        writer.write_bytes_with_length(type_ref.contract_names.get(index));
        index = index + 1;
    }
    return writer.finish();
}

InterfaceTypeRef decode_type_ref_payload(UInt8[]& bytes) {
    TypeRefPayloadReader reader! = TypeRefPayloadReader(bytes);
    Int kind_tag = reader.read_int();
    InterfaceTypeRef type_ref! = InterfaceTypeRef(type_ref_kind_from_value(kind_tag));
    type_ref.kind_tag = kind_tag;
    type_ref.has_stable_def = reader.read_bool();
    if (type_ref.has_stable_def) {
        type_ref.stable_def_low = reader.read_uint64();
        type_ref.stable_def_high = reader.read_uint64();
    }
    type_ref.count_kind = reader.read_int();
    type_ref.count_value = reader.read_uint64();
    type_ref.sentinel_kind = reader.read_int();
    type_ref.sentinel_value = reader.read_uint64();
    Int count = reader.read_int();
    Int index! = 0;
    while (index < count) {
        type_ref.args.add(reader.read_bytes_with_length());
        index = index + 1;
    }
    Int name_count = reader.read_int();
    index = 0;
    while (index < name_count) {
        type_ref.contract_names.add(reader.read_bytes_with_length());
        index = index + 1;
    }
    if (!reader.ok) {
        return InterfaceTypeRef.invalid_type();
    }
    return type_ref;
}

public Int persistent_type_ref_tag(InterfaceTypeRef& type_ref) {
    if (type_ref.kind_tag == 9 || type_ref.kind_tag == 12) {
        return type_ref.kind_tag;
    }
    if (type_ref.has_stable_def) {
        return 2;
    }
    return type_ref.kind_tag;
}

public InterfaceTypeRefKind type_ref_kind_from_value(Int value) {
    if (value == 1) { return InterfaceTypeRefKind.unit_type; }
    if (value == 2) { return InterfaceTypeRefKind.named_type; }
    if (value == 3) { return InterfaceTypeRefKind.layered_type; }
    if (value == 4) { return InterfaceTypeRefKind.array_type; }
    if (value == 5) { return InterfaceTypeRefKind.errorable_type; }
    if (value == 6) { return InterfaceTypeRefKind.function_type; }
    if (value == 7) { return InterfaceTypeRefKind.tuple_type; }
    if (value == 8) { return InterfaceTypeRefKind.infer_type; }
    if (value == 9) { return InterfaceTypeRefKind.trait_companion_type; }
    if (value == 10) { return InterfaceTypeRefKind.const_expression; }
    if (value == 11) { return InterfaceTypeRefKind.effect_type; }
    if (value == 12) { return InterfaceTypeRefKind.self_type; }
    return InterfaceTypeRefKind.invalid_type;
}

public Int function_effect_flags(Bool has_unsafe, Bool has_async) {
    Int flags! = 0;
    if (has_unsafe) { flags = flags | 1; }
    if (has_async) { flags = flags | 2; }
    return flags;
}

public Int interface_type_ref_kind_tag(InterfaceTypeRefKind kind) {
    if (kind == InterfaceTypeRefKind.unit_type) { return 1; }
    if (kind == InterfaceTypeRefKind.named_type) { return 2; }
    if (kind == InterfaceTypeRefKind.layered_type) { return 3; }
    if (kind == InterfaceTypeRefKind.array_type) { return 4; }
    if (kind == InterfaceTypeRefKind.errorable_type) { return 5; }
    if (kind == InterfaceTypeRefKind.function_type) { return 6; }
    if (kind == InterfaceTypeRefKind.tuple_type) { return 7; }
    if (kind == InterfaceTypeRefKind.infer_type) { return 8; }
    if (kind == InterfaceTypeRefKind.trait_companion_type) { return 9; }
    if (kind == InterfaceTypeRefKind.const_expression) { return 10; }
    if (kind == InterfaceTypeRefKind.effect_type) { return 11; }
    if (kind == InterfaceTypeRefKind.self_type) { return 12; }
    return 0;
}

struct TypeRefPayloadWriter: Movable {
    list.ArrayList<UInt8> bytes;

    init(self) {
        self.bytes = list.ArrayList<UInt8>();
    }

    @life()
    UInt8[]& finish(self) {
        unsafe {
            UInt8*! result = UInt8$.alloc(self.bytes.len() + 1);
            Int index! = 0;
            while (index < self.bytes.len()) {
                result[index] = self.bytes.get(index);
                index = index + 1;
            }
            result[self.bytes.len()] = 0;
            UInt8* frozen = result$.as(UInt8*);
            return frozen[0..self.bytes.len()];
        }
    }

    Void write_bool(self, Bool value) {
        if (value) {
            self.bytes.add(1);
            return;
        }
        self.bytes.add(0);
    }

    Void write_int(self, Int value) {
        self.write_uint64(UInt64(value));
    }

    Void write_uint64(self, UInt64 value) {
        Int index! = 0;
        while (index < 8) {
            self.bytes.add(UInt8((value >> UInt64(index * 8)) & UInt64(255)));
            index = index + 1;
        }
    }

    Void write_bytes_with_length(self, UInt8[]& value) {
        self.write_int(value.length);
        Int index! = 0;
        while (index < value.length) {
            self.bytes.add(value[index]);
            index = index + 1;
        }
    }
}

@region(a)
struct TypeRefPayloadReader: Movable {
    @life(a)
    UInt8[]& bytes;
    Int offset!;
    Bool ok!;

    init(self, UInt8[]& bytes) {
        self.bytes = bytes;
        self.offset = 0;
        self.ok = true;
    }

    Bool read_bool(self) {
        return self.read_byte() != 0;
    }

    Int read_int(self) {
        return Int(self.read_uint64());
    }

    UInt64 read_uint64(self) {
        UInt64 value! = 0;
        Int index! = 0;
        while (index < 8) {
            value = value | (UInt64(self.read_byte()) << UInt64(index * 8));
            index = index + 1;
        }
        return value;
    }

    UInt8[]& read_bytes_with_length(self) {
        Int length = self.read_int();
        if (length < 0 || self.offset + length > self.bytes.length) {
            self.ok = false;
            return "";
        }
        unsafe {
            UInt8*! buffer = UInt8$.alloc(length + 1);
            Int index! = 0;
            while (index < length) {
                buffer[index] = self.read_byte();
                index = index + 1;
            }
            buffer[length] = 0;
            UInt8* frozen = buffer$.as(UInt8*);
            return frozen[0..length];
        }
    }

    UInt8 read_byte(self) {
        if (self.offset >= self.bytes.length) {
            self.ok = false;
            return 0;
        }
        UInt8 value = self.bytes[self.offset];
        self.offset = self.offset + 1;
        return value;
    }
}

public struct InterfaceParamSummary: Movable {
    public qid.SymbolId symbol;
    public InterfaceTypeRef type_ref;

    public init(self, qid.SymbolId symbol, InterfaceTypeRef type_ref) {
        self.symbol = symbol;
        self.type_ref = type_ref;
    }
}

public enum InterfaceLiteralKind {
    invalid_literal,
    int_value,
    float_value,
    bool_value,
    string_value,
    char_value,
    null_value,
    unit_value,
}

public struct InterfaceLiteral: Copyable {
    public InterfaceLiteralKind kind;
    public UInt64 int_bits!;
    public Bool signed_int!;
    public Float64 float_value!;
    public Bool bool_value!;
    public qid.SymbolId? string_symbol!;
    public UInt32 char_value!;

    public init(self, InterfaceLiteralKind kind) {
        self.kind = kind;
        self.int_bits = 0;
        self.signed_int = false;
        self.float_value = 0.0;
        self.bool_value = false;
        self.string_symbol = null;
        self.char_value = 0;
    }
}

public struct InterfaceParamDefault: Copyable {
    public Int param_index;
    public InterfaceLiteral value;

    public init(self, Int param_index, InterfaceLiteral value) {
        self.param_index = param_index;
        self.value = value;
    }
}

public struct InterfaceFunctionSignature: Movable {
    public Bool has_receiver;
    public Int receiver_mode;
    public Bool has_unsafe;
    public Bool has_async;
    public qkey.StableSymbolId? domain_stable_id;
    public list.ArrayList<qid.SymbolId> exclusive_symbols;
    public list.ArrayList<InterfaceParamSummary> params;
    public list.ArrayList<InterfaceParamDefault> param_defaults;
    list.ArrayList<UInt8> result_payload!;

    public init(self, Bool has_receiver, InterfaceTypeRef result) {
        self.has_receiver = has_receiver;
        self.receiver_mode = 0;
        self.has_unsafe = false;
        self.has_async = false;
        self.domain_stable_id = null;
        self.exclusive_symbols = list.ArrayList<qid.SymbolId>();
        self.params = list.ArrayList<InterfaceParamSummary>();
        self.param_defaults = list.ArrayList<InterfaceParamDefault>();
        self.result_payload = copy_type_ref_payload(encode_type_ref_payload(result$.ref()));
    }

    public InterfaceFunctionSignature empty(Bool has_receiver) {
        InterfaceFunctionSignature signature! = InterfaceFunctionSignature(
            has_receiver,
            InterfaceTypeRef.invalid_type()
        );
        return signature;
    }

    public Void add_param(self, InterfaceParamSummary param) {
        self.params.add(param);
    }

    public Void add_param_default(self, InterfaceParamDefault param_default) {
        self.param_defaults.add(param_default);
    }

    public InterfaceTypeRef result_type_ref(self) {
        return decode_type_ref_payload(self.result_payload.slice());
    }

    public Void set_result(self, InterfaceTypeRef result) {
        self.result_payload = copy_type_ref_payload(encode_type_ref_payload(result$.ref()));
    }

    public Void set_result_ref(self, InterfaceTypeRef& result) {
        self.result_payload = copy_type_ref_payload(encode_type_ref_payload(result));
    }
}

list.ArrayList<UInt8> copy_type_ref_payload(UInt8[]& payload) {
    list.ArrayList<UInt8> result = list.ArrayList<UInt8>(payload.length);
    Int index! = 0;
    while (index < payload.length) {
        result.add(payload[index]);
        index = index + 1;
    }
    return result;
}

public enum InterfaceWherePredicateKind {
    type_bound,
    negative_type_bound,
    type_equal,
    type_not_equal,
    projection_equal,
    const_type,
}

public struct InterfaceWherePredicate: Movable {
    public InterfaceWherePredicateKind kind!;
    public Int subject_index!;
    public Int bound_or_value_index!;
    public Int trait_ref_index!;
    public qid.SymbolId? assoc_symbol!;

    public init(self, InterfaceWherePredicateKind kind) {
        self.kind = kind;
        self.subject_index = -1;
        self.bound_or_value_index = -1;
        self.trait_ref_index = -1;
        self.assoc_symbol = null;
    }
}

public struct InterfaceWherePredicateEntry: Movable {
    public qkey.StableSymbolId owner_stable_id;
    public InterfaceWherePredicate predicate;

    public init(self, qkey.StableSymbolId owner_stable_id, InterfaceWherePredicate predicate) {
        self.owner_stable_id = owner_stable_id;
        self.predicate = predicate;
    }
}

// extension group 是源码模块向目标类型追加的语义表面。
// 这里只保存稳定声明身份和可重建的类型引用，不保存 AST/Span/NodeId。
public struct InterfaceExtensionConstraint: Movable {
    public qkey.StableSymbolId param_stable_id;
    public InterfaceTypeRef type_ref;

    public init(self, qkey.StableSymbolId param_stable_id, InterfaceTypeRef type_ref) {
        self.param_stable_id = param_stable_id;
        self.type_ref = type_ref;
    }
}

public struct InterfaceExtensionGroup: Movable {
    public qkey.StableSymbolId target_owner;
    public qkey.StableSymbolId binding_owner;
    public Bool public_flag;
    public InterfaceTypeRef? trait_ref;
    public list.ArrayList<InterfaceWherePredicate> where_predicates;
    public list.ArrayList<InterfaceExtensionConstraint> generic_constraints;
    public list.ArrayList<qkey.StableSymbolId> members;

    public init(
        self,
        qkey.StableSymbolId target_owner,
        qkey.StableSymbolId binding_owner,
        Bool public_flag
    ) {
        self.target_owner = target_owner;
        self.binding_owner = binding_owner;
        self.public_flag = public_flag;
        self.trait_ref = null;
        self.where_predicates = list.ArrayList<InterfaceWherePredicate>();
        self.generic_constraints = list.ArrayList<InterfaceExtensionConstraint>();
        self.members = list.ArrayList<qkey.StableSymbolId>();
    }
}

public struct InterfaceTraitRefEntry: Movable {
    public qkey.StableSymbolId owner_stable_id;
    public Bool negative;
    public InterfaceTypeRef trait_ref;

    public init(self, qkey.StableSymbolId owner_stable_id, Bool negative, InterfaceTypeRef trait_ref) {
        self.owner_stable_id = owner_stable_id;
        self.negative = negative;
        self.trait_ref = trait_ref;
    }
}

public struct InterfaceLifetimeName: Copyable {
    public Int kind;
    public qid.SymbolId? symbol;
    public Int projection_path;

    public init(
        self,
        Int kind,
        qid.SymbolId? symbol,
        Int projection_path = 0
    ) {
        self.kind = kind;
        self.symbol = symbol;
        self.projection_path = projection_path;
    }
}

public struct InterfaceLifetimePathNode: Copyable {
    public Int parent;
    public Int kind;
    public qid.SymbolId? symbol;
    public qkey.StableSymbolId? field_stable_id = null;
    public Int tuple_index;
}

public struct InterfaceLifetimeExpression: Copyable {
    public Int kind;
    public InterfaceLifetimeName name;
    public Int left;
    public Int right;
}

public struct InterfaceLifetimeConstraint: Copyable {
    public qkey.StableSymbolId owner_stable_id;
    public InterfaceLifetimeName longer;
    public InterfaceLifetimeName shorter;
    public Int relation;

    public init(self,
        qkey.StableSymbolId owner_stable_id,
        InterfaceLifetimeName longer,
        InterfaceLifetimeName shorter,
        Int relation = 0
    ) {
        self.owner_stable_id = owner_stable_id;
        self.longer = longer;
        self.shorter = shorter;
        self.relation = relation;
    }
}

public struct InterfaceRegionName: Copyable {
    public qkey.StableSymbolId owner_stable_id;
    public qid.SymbolId symbol;
}

public struct InterfaceRegionConstraint: Copyable {
    public qkey.StableSymbolId owner_stable_id;
    public qid.SymbolId target;
    public qid.SymbolId source;
}

public struct InterfaceLifeClause: Copyable {
    public qkey.StableSymbolId owner_stable_id;
    public InterfaceLifetimeName? target;
    public InterfaceLifetimeName source;
    public Int source_expression = 0;
}

public struct GenericTemplate: Movable {
    public qkey.StableSymbolId owner_stable_id;
    public qkey.Fingerprint128 body_fingerprint;
    public list.ArrayList<UInt8> payload;

    public init(self,
        qkey.StableSymbolId owner_stable_id,
        qkey.Fingerprint128 body_fingerprint,
        UInt8[]& payload
    ) {
        self.owner_stable_id = owner_stable_id;
        self.body_fingerprint = body_fingerprint;
        self.payload = copy_bytes(payload);
    }

}

public struct InterfaceFunctionSignatureEntry: Movable {
    public qkey.StableSymbolId stable_id;
    public InterfaceFunctionSignature signature!;

    public init(self, qkey.StableSymbolId stable_id, InterfaceFunctionSignature signature) {
        self.stable_id = stable_id;
        self.signature = signature;
    }
}

public struct InterfaceFieldDefaultEntry: Movable {
    public qkey.StableSymbolId stable_id;
    public list.ArrayList<UInt8> payload;

    public init(self, qkey.StableSymbolId stable_id, UInt8[]& payload) {
        self.stable_id = stable_id;
        self.payload = copy_bytes(payload);
    }
}

public enum InterfaceConstValueKind {
    invalid,
    bool_value,
    int_value,
    uint_value,
    char_value,
    float_value,
    string_value,
    symbol_value,
    enum_case_value,
    struct_value,
    tuple_value,
    array_value,
    unit_value,
}

@region(a)
public struct InterfaceConstFieldValue: Copyable {
    public qkey.StableSymbolId field_stable_id;
    @life(a)
    public InterfaceConstValue value;
}

@region(a)
public union InterfaceConstValueData: Copyable {
    Void invalid;
    Void unit_value;
    Bool bool_value;
    Int int_value;
    UInt64 uint_value;
    UInt64 char_value;
    UInt64 float_bits;
    @life(a)
    UInt8[]& string_value;
    qid.SymbolId symbol_value;
    qkey.StableSymbolId enum_case_value;
    @life(a, a)
    InterfaceConstFieldValue[]& struct_value;

    @life(a, a)
    InterfaceConstValue[]& tuple_value;

    @life(a, a)
    InterfaceConstValue[]& array_value;
}

@region(a)
public struct InterfaceConstValue: Copyable {
    @life(a)
    public InterfaceConstValueData data;
}

@region(a)
public struct InterfaceConstValueEntry: Copyable {
    public qkey.StableSymbolId stable_id;
    @life(a)
    public InterfaceConstValue value!;

    public init(self, qkey.StableSymbolId stable_id, InterfaceConstValue value) {
        self.stable_id = stable_id;
        self.value = value;
    }
}

public struct ModuleInterface: Movable {
    public source.SourceId source_id;
    public UInt64 source_hash;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public qkey.Fingerprint128 interface_hash!;
    public qkey.Fingerprint128 public_interface_hash!;
    public list.ArrayList<InterfaceDeclSummary> declarations;
    public list.ArrayList<InterfaceQueryObservation> query_observations;
    public list.ArrayList<ImportSummaryEntry> public_imports;
    public list.ArrayList<AliasExportSummary> public_aliases;
    public list.ArrayList<InterfaceExtensionGroup> extension_groups;
    public list.ArrayList<InterfaceTraitRefEntry> trait_refs;
    public list.ArrayList<InterfaceWherePredicateEntry> where_predicates;
    public list.ArrayList<InterfaceTypeRef> where_type_refs;
    public list.ArrayList<InterfaceLifetimeConstraint> lifetime_constraints;
    public list.ArrayList<InterfaceLifetimePathNode> lifetime_path_nodes;
    public list.ArrayList<InterfaceLifetimeExpression> lifetime_expressions;
    public list.ArrayList<InterfaceRegionName> region_names;
    public list.ArrayList<InterfaceRegionConstraint> region_constraints;
    public list.ArrayList<InterfaceLifeClause> life_clauses;
    public list.ArrayList<GenericTemplate> generic_templates;
    public list.ArrayList<InterfaceFunctionSignatureEntry> function_signature_entries;
    public list.ArrayList<InterfaceFieldDefaultEntry> field_default_entries;
    public list.ArrayList<InterfaceConstValueEntry> const_value_entries;
    table.HashTable<qkey.StableSymbolId, InterfaceTypeRef> decl_type_refs;

    public init(self,
        source.SourceId source_id,
        UInt64 source_hash,
        qid.SymbolId package_name,
        qid.SymbolId module_path
    ) {
        self.source_id = source_id;
        self.source_hash = source_hash;
        self.package_name = package_name;
        self.module_path = module_path;
        self.interface_hash = qkey.Fingerprint128();
        self.public_interface_hash = qkey.Fingerprint128();
        self.declarations = list.ArrayList<InterfaceDeclSummary>();
        self.query_observations = list.ArrayList<InterfaceQueryObservation>();
        self.public_imports = list.ArrayList<ImportSummaryEntry>();
        self.public_aliases = list.ArrayList<AliasExportSummary>();
        self.extension_groups = list.ArrayList<InterfaceExtensionGroup>();
        self.trait_refs = list.ArrayList<InterfaceTraitRefEntry>();
        self.where_predicates = list.ArrayList<InterfaceWherePredicateEntry>();
        self.where_type_refs = list.ArrayList<InterfaceTypeRef>();
        self.lifetime_constraints = list.ArrayList<InterfaceLifetimeConstraint>();
        self.lifetime_path_nodes = list.ArrayList<InterfaceLifetimePathNode>();
        self.lifetime_expressions = list.ArrayList<InterfaceLifetimeExpression>();
        self.region_names = list.ArrayList<InterfaceRegionName>();
        self.region_constraints = list.ArrayList<InterfaceRegionConstraint>();
        self.life_clauses = list.ArrayList<InterfaceLifeClause>();
        self.generic_templates = list.ArrayList<GenericTemplate>();
        self.function_signature_entries = list.ArrayList<InterfaceFunctionSignatureEntry>();
        self.field_default_entries = list.ArrayList<InterfaceFieldDefaultEntry>();
        self.const_value_entries = list.ArrayList<InterfaceConstValueEntry>();
        self.decl_type_refs = table.HashTable<qkey.StableSymbolId, InterfaceTypeRef>();
    }

    public Void add_declaration(self, InterfaceDeclSummary declaration) {
        self.declarations.add(declaration);
    }

    public Void add_query_observation(self, InterfaceQueryObservation observation) {
        self.query_observations.add(observation);
    }

    public list.ArrayList<query_dependency.ObservedQueryDependency>
    observations_for_query(
        self,
        query_dependency.StableQueryKey query
    ) {
        list.ArrayList<query_dependency.ObservedQueryDependency> result! =
            list.ArrayList<query_dependency.ObservedQueryDependency>();
        Int index! = 0;
        while (index < self.query_observations.len()) {
            InterfaceQueryObservation observation = self.query_observations.get(index);
            if (observation.query == query) {
                result.add(observation.dependency);
            }
            index = index + 1;
        }
        return result;
    }

    public Bool has_declaration(self, qkey.StableSymbolId stable_id) {
        Int index! = 0;
        while (index < self.declarations.len()) {
            if (self.declarations.get(index).stable_id == stable_id) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Void add_extension_group(self, InterfaceExtensionGroup group) {
        self.extension_groups.add(group);
    }

    public Void add_public_import(self, ImportSummaryEntry entry) {
        self.public_imports.add(entry);
    }

    public Void add_public_alias(self, AliasExportSummary alias_export) {
        self.public_aliases.add(alias_export);
    }

    public Void add_trait_ref(self, qkey.StableSymbolId stable_id, InterfaceTypeRef trait_ref) {
        self.trait_refs.add(InterfaceTraitRefEntry(stable_id, false, trait_ref));
    }

    public Void add_negative_trait_ref(self, qkey.StableSymbolId stable_id, InterfaceTypeRef trait_ref) {
        self.trait_refs.add(InterfaceTraitRefEntry(stable_id, true, trait_ref));
    }

    public Void add_where_predicate(self, qkey.StableSymbolId stable_id, InterfaceWherePredicate predicate) {
        self.where_predicates.add(InterfaceWherePredicateEntry(stable_id, predicate));
    }

    public Void add_where_predicate_parts(self,
        qkey.StableSymbolId stable_id,
        InterfaceWherePredicateKind kind,
        InterfaceTypeRef subject,
        InterfaceTypeRef bound_or_value,
        InterfaceTypeRef trait_ref,
        qid.SymbolId? assoc_symbol
    ) {
        InterfaceWherePredicate predicate! = InterfaceWherePredicate(kind);
        predicate.subject_index = self.add_where_type_ref(subject);
        predicate.bound_or_value_index = self.add_where_type_ref(bound_or_value);
        predicate.trait_ref_index = self.add_where_type_ref(trait_ref);
        predicate.assoc_symbol = assoc_symbol;
        self.add_where_predicate(stable_id, predicate);
    }
    public InterfaceTypeRef& where_type_ref_at(self, Int index) {
        return self.where_type_refs.ref_at(index);
    }

    public Int add_where_type_ref(self, InterfaceTypeRef type_ref) {
        Int index = self.where_type_refs.len();
        self.where_type_refs.add(type_ref);
        return index;
    }

    public Void add_lifetime_constraint(self, InterfaceLifetimeConstraint constraint) {
        self.lifetime_constraints.add(constraint);
    }

    public Void add_region_name(self, InterfaceRegionName name) {
        self.region_names.add(name);
    }

    public Void add_region_constraint(self, InterfaceRegionConstraint constraint) {
        self.region_constraints.add(constraint);
    }

    public Void add_life_clause(self, InterfaceLifeClause clause) {
        self.life_clauses.add(clause);
    }

    public Int add_lifetime_path_node(self, InterfaceLifetimePathNode node) {
        self.lifetime_path_nodes.add(node);
        return self.lifetime_path_nodes.len();
    }

    public Int add_lifetime_expression(self, InterfaceLifetimeExpression expression) {
        self.lifetime_expressions.add(expression);
        return self.lifetime_expressions.len();
    }

    public Void set_function_signature(self,
        qkey.StableSymbolId stable_id,
        InterfaceFunctionSignature signature
    ) {
        Int index! = 0;
        while (index < self.function_signature_entries.len()) {
            InterfaceFunctionSignatureEntry& entry = self.function_signature_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                entry.signature = signature;
                return;
            }
            index = index + 1;
        }
        self.function_signature_entries.add(InterfaceFunctionSignatureEntry(stable_id, signature));
    }

    public InterfaceFunctionSignature&? function_signature(self, qkey.StableSymbolId stable_id) {
        Int index! = 0;
        while (index < self.function_signature_entries.len()) {
            InterfaceFunctionSignatureEntry& entry = self.function_signature_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                return entry.signature$.ref();
            }
            index = index + 1;
        }
        return null;
    }

    public Void set_field_default(self, qkey.StableSymbolId stable_id, UInt8[]& payload) {
        Int index! = 0;
        while (index < self.field_default_entries.len()) {
            InterfaceFieldDefaultEntry& entry = self.field_default_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                return;
            }
            index = index + 1;
        }
        self.field_default_entries.add(InterfaceFieldDefaultEntry(stable_id, payload));
    }

    public UInt8[]&? field_default(self, qkey.StableSymbolId stable_id) {
        Int index! = 0;
        while (index < self.field_default_entries.len()) {
            InterfaceFieldDefaultEntry& entry = self.field_default_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                return entry.payload.slice();
            }
            index = index + 1;
        }
        return null;
    }

    public Void set_const_value(self, qkey.StableSymbolId stable_id, InterfaceConstValue value) {
        Int index! = 0;
        while (index < self.const_value_entries.len()) {
            InterfaceConstValueEntry& entry = self.const_value_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                entry.value = value;
                return;
            }
            index = index + 1;
        }
        self.const_value_entries.add(InterfaceConstValueEntry(stable_id, value));
    }

    public InterfaceConstValue? const_value(self, qkey.StableSymbolId stable_id) {
        Int index! = 0;
        while (index < self.const_value_entries.len()) {
            InterfaceConstValueEntry& entry = self.const_value_entries.ref_at(index);
            if (entry.stable_id == stable_id) {
                return entry.value;
            }
            index = index + 1;
        }
        return null;
    }

    public Void set_decl_type_ref(self, qkey.StableSymbolId stable_id, InterfaceTypeRef type_ref) {
        self.decl_type_refs.set(stable_id, type_ref);
    }
    public InterfaceTypeRef&? decl_type_ref(self, qkey.StableSymbolId stable_id) {
        return self.decl_type_refs.get(stable_id);
    }

    public Void add_generic_template(self, GenericTemplate generic_template) {
        self.generic_templates.add(generic_template);
    }

}

public struct SourceArtifactCache: Movable {
    table.HashTable<source.SourceId, ImportSummary> import_summaries;
    table.HashTable<source.SourceId, ModuleInterface> interfaces;
    table.HashTable<qkey.StableSymbolId, GenericTemplate> generic_templates;
    Bool timing_enabled!;
    public SourceArtifactStats stats!;

    public init(self) {
        self.import_summaries = table.HashTable<source.SourceId, ImportSummary>();
        self.interfaces = table.HashTable<source.SourceId, ModuleInterface>();
        self.generic_templates = table.HashTable<qkey.StableSymbolId, GenericTemplate>();
        self.timing_enabled = false;
        self.stats = SourceArtifactStats();
    }

    public Void store_import_summary(self, source.SourceId source_id, ImportSummary summary) {
        self.import_summaries.set(source_id, summary);
    }
    public ImportSummary&? load_import_summary(self, source.SourceId source_id) {
        return self.import_summaries.get(source_id);
    }

    public Void store_interface(self, source.SourceId source_id, ModuleInterface module_interface) {
        self.index_generic_templates(module_interface$.ref());
        self.interfaces.set(source_id, module_interface);
    }
    public ModuleInterface&? load_interface(self, source.SourceId source_id) {
        return self.interfaces.get(source_id);
    }

    public Void store_generic_template(self, GenericTemplate generic_template) {
        self.generic_templates.set(generic_template.owner_stable_id, generic_template);
    }
    public GenericTemplate&? load_generic_template(self, qkey.StableSymbolId owner_stable_id) {
        return self.generic_templates.get(owner_stable_id);
    }

    public Void reset_stats(self) {
        self.stats = SourceArtifactStats();
    }

    public Void record_import_lookup(self, ArtifactStatus status) {
        self.stats.add_import(status);
    }

    public Void record_interface_lookup(self, ArtifactStatus status) {
        self.stats.add_interface(status);
    }

    public Void enable_timing(self, Bool enabled) {
        self.timing_enabled = enabled;
    }

    public UInt64 section_timing_start(self) {
        if (!self.timing_enabled) { return UInt64(0); }
        return system_time.monotonic_time_ns();
    }

    public Void record_section_read(
        self,
        ji.JiSectionKind kind,
        Int length,
        UInt64 started
    ) {
        self.stats.section_reads = self.stats.section_reads + 1;
        self.stats.section_bytes = self.stats.section_bytes + length;
        self.add_section_timing(kind, self.elapsed_ns(started), false);
    }

    public Void record_section_decode(self, ji.JiSectionKind kind, UInt64 started) {
        self.add_section_timing(kind, self.elapsed_ns(started), true);
    }

    Void add_section_timing(
        self,
        ji.JiSectionKind kind,
        UInt64 elapsed,
        Bool decode
    ) {
        if (!self.timing_enabled) { return; }
        if (decode) {
            self.stats.section_decode_ns = self.stats.section_decode_ns + elapsed;
        } else {
            self.stats.section_read_ns = self.stats.section_read_ns + elapsed;
        }
        if (kind != .interface_section) { return; }
        if (decode) {
            self.stats.interface_decode_ns = self.stats.interface_decode_ns + elapsed;
        } else {
            self.stats.interface_read_ns = self.stats.interface_read_ns + elapsed;
        }
    }

    UInt64 elapsed_ns(self, UInt64 started) {
        if (!self.timing_enabled) { return UInt64(0); }
        UInt64 finished = system_time.monotonic_time_ns();
        if (finished < started) { return UInt64(0); }
        return finished - started;
    }

    public Void record_source_parse(self) {
        self.stats.parsed_sources = self.stats.parsed_sources + 1;
    }

    Void index_generic_templates(self, ModuleInterface& module_interface) {
        Int index! = 0;
        while (index < module_interface.generic_templates.len()) {
            GenericTemplate& generic_template = module_interface.generic_templates.ref_at(index);
            self.store_generic_template(GenericTemplate(
                generic_template.owner_stable_id,
                generic_template.body_fingerprint,
                generic_template.payload.slice()
            ));
            index = index + 1;
        }
    }

}

public struct SourceArtifactStats: Copyable {
    public Int import_hit!;
    public Int import_missing!;
    public Int import_stale!;
    public Int interface_hit!;
    public Int interface_missing!;
    public Int interface_stale!;
    public Int section_reads!;
    public Int section_bytes!;
    public UInt64 section_read_ns!;
    public UInt64 section_decode_ns!;
    public UInt64 interface_read_ns!;
    public UInt64 interface_decode_ns!;
    public Int parsed_sources!;

    public init(self) {
        self.import_hit = 0;
        self.import_missing = 0;
        self.import_stale = 0;
        self.interface_hit = 0;
        self.interface_missing = 0;
        self.interface_stale = 0;
        self.section_reads = 0;
        self.section_bytes = 0;
        self.section_read_ns = UInt64(0);
        self.section_decode_ns = UInt64(0);
        self.interface_read_ns = UInt64(0);
        self.interface_decode_ns = UInt64(0);
        self.parsed_sources = 0;
    }

    public Int hit_count(self) {
        return self.import_hit + self.interface_hit;
    }

    public Int missing_count(self) {
        return self.import_missing + self.interface_missing;
    }

    public Int stale_count(self) {
        return self.import_stale + self.interface_stale;
    }

    Void add_import(self, ArtifactStatus status) {
        if (status == .hit) {
            self.import_hit = self.import_hit + 1;
        } else if (status == .missing) {
            self.import_missing = self.import_missing + 1;
        } else {
            self.import_stale = self.import_stale + 1;
        }
    }

    Void add_interface(self, ArtifactStatus status) {
        if (status == .hit) {
            self.interface_hit = self.interface_hit + 1;
        } else if (status == .missing) {
            self.interface_missing = self.interface_missing + 1;
        } else {
            self.interface_stale = self.interface_stale + 1;
        }
    }
}

public list.ArrayList<UInt8> copy_bytes(UInt8[]& bytes) {
    list.ArrayList<UInt8> result = list.ArrayList<UInt8>(bytes.length);
    Int index! = 0;
    while (index < bytes.length) {
        result.add(bytes[index]);
        index = index + 1;
    }
    return result;
}
