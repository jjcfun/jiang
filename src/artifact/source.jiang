// 增量编译的 source artifact 边界。
//
// 这里的结构是 `.ji` section 解码后的内存表示：SymbolId/DefKind 等值只在
// 当前 session 内有效；真正落盘时由 section encoder 负责写入文本和稳定 key。

import qid = "../query/id.jiang";
import qkey = "../query/key.jiang";
import def = "../resolve/def.jiang";
import store = "../resolve/store.jiang";
import source = "../source/source.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public enum ArtifactStatus {
    missing,
    hit,
    stale,
}

public struct ImportSummaryEntry {
    public store.ImportKind kind;
    public def.Visibility visibility;
    public qid.SymbolId path_symbol;
    public qid.SymbolId? alias_symbol;

    public init(
        store.ImportKind kind,
        def.Visibility visibility,
        qid.SymbolId path_symbol,
        qid.SymbolId? alias_symbol
    ) {
        self.kind = kind;
        self.visibility = visibility;
        self.path_symbol = path_symbol;
        self.alias_symbol = alias_symbol;
    }
}

public struct AliasExportSummary {
    public qid.SymbolId alias_symbol;
    public qkey.StableSymbolId target_stable_id;

    public init(qid.SymbolId alias_symbol, qkey.StableSymbolId target_stable_id) {
        self.alias_symbol = alias_symbol;
        self.target_stable_id = target_stable_id;
    }
}

public struct ImportSummary: Movable {
    public source.SourceId source_id;
    public UInt64 source_hash;
    public Int source_revision;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public qid.SymbolId source_path;
    public list.ArrayList<ImportSummaryEntry> imports;
    public list.ArrayList<AliasExportSummary> public_aliases;

    public init(
        source.SourceId source_id,
        UInt64 source_hash,
        Int source_revision,
        qid.SymbolId package_name,
        qid.SymbolId module_path,
        qid.SymbolId source_path
    ) {
        self.source_id = source_id;
        self.source_hash = source_hash;
        self.source_revision = source_revision;
        self.package_name = package_name;
        self.module_path = module_path;
        self.source_path = source_path;
        self.imports = list.ArrayList<ImportSummaryEntry>();
        self.public_aliases = list.ArrayList<AliasExportSummary>();
    }

    public () add_import(ImportSummaryEntry entry) {
        self.imports.add(entry);
    }

    public () add_public_alias(AliasExportSummary alias_export) {
        self.public_aliases.add(alias_export);
    }
}

public struct InterfaceDeclSummary {
    public qkey.StableSymbolId stable_id;
    public def.DefKind kind;
    public def.NameDomain domain;
    public def.Visibility visibility;
    public qid.SymbolId name;
    public qkey.StableSymbolId? owner;
    public qkey.Fingerprint128 signature_fingerprint;
    public qkey.Fingerprint128 body_fingerprint;

    public init(
        qkey.StableSymbolId stable_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        qid.SymbolId name,
        qkey.StableSymbolId? owner
    ) {
        self.stable_id = stable_id;
        self.kind = kind;
        self.domain = domain;
        self.visibility = visibility;
        self.name = name;
        self.owner = owner;
        self.signature_fingerprint = qkey.Fingerprint128();
        self.body_fingerprint = qkey.Fingerprint128();
    }
}

public enum InterfaceTypeRefKind {
    invalid_type,
    unit_type,
    named_type,
}

public struct InterfaceTypeRef: Movable {
    public InterfaceTypeRefKind kind;
    public qkey.StableSymbolId? stable_def;
    public list.ArrayList<InterfaceTypeRef> args;

    public init(InterfaceTypeRefKind kind, qkey.StableSymbolId? stable_def) {
        self.kind = kind;
        self.stable_def = stable_def;
        self.args = list.ArrayList<InterfaceTypeRef>();
    }

    public static InterfaceTypeRef invalid_type() {
        return InterfaceTypeRef(.invalid_type, null);
    }

    public static InterfaceTypeRef unit_type() {
        return InterfaceTypeRef(.unit_type, null);
    }

    public static InterfaceTypeRef named_type(qkey.StableSymbolId stable_def) {
        return InterfaceTypeRef(.named_type, stable_def);
    }

    public () add_arg(InterfaceTypeRef arg) {
        self.args.add(arg$.move());
    }
}

public struct InterfaceParamSummary: Movable {
    public qid.SymbolId symbol;
    public InterfaceTypeRef type_ref;

    public init(qid.SymbolId symbol, InterfaceTypeRef type_ref) {
        self.symbol = symbol;
        self.type_ref = type_ref$.move();
    }
}

public struct InterfaceFunctionSignature: Movable {
    public Bool has_receiver;
    public list.ArrayList<InterfaceParamSummary> params;
    public InterfaceTypeRef result;

    public init(Bool has_receiver, InterfaceTypeRef result) {
        self.has_receiver = has_receiver;
        self.params = list.ArrayList<InterfaceParamSummary>();
        self.result = result$.move();
    }

    public () add_param(InterfaceParamSummary param) {
        self.params.add(param$.move());
    }
}

public struct GenericTemplateIndexEntry {
    public qkey.StableSymbolId owner_stable_id;
    public qkey.Fingerprint128 body_fingerprint;

    public init(qkey.StableSymbolId owner_stable_id, qkey.Fingerprint128 body_fingerprint) {
        self.owner_stable_id = owner_stable_id;
        self.body_fingerprint = body_fingerprint;
    }
}

public struct ModuleInterface: Movable {
    public source.SourceId source_id;
    public UInt64 source_hash;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public qkey.Fingerprint128 interface_hash;
    public list.ArrayList<InterfaceDeclSummary> declarations;
    public list.ArrayList<ImportSummaryEntry> public_imports;
    public list.ArrayList<AliasExportSummary> public_aliases;
    public list.ArrayList<GenericTemplateIndexEntry> generic_templates;
    table.HashTable<qkey.StableSymbolId, InterfaceFunctionSignature> function_signatures;

    public init(
        source.SourceId source_id,
        UInt64 source_hash,
        qid.SymbolId package_name,
        qid.SymbolId module_path
    ) {
        self.source_id = source_id;
        self.source_hash = source_hash;
        self.package_name = package_name;
        self.module_path = module_path;
        self.interface_hash = qkey.Fingerprint128();
        self.declarations = list.ArrayList<InterfaceDeclSummary>();
        self.public_imports = list.ArrayList<ImportSummaryEntry>();
        self.public_aliases = list.ArrayList<AliasExportSummary>();
        self.generic_templates = list.ArrayList<GenericTemplateIndexEntry>();
        self.function_signatures = table.HashTable<qkey.StableSymbolId, InterfaceFunctionSignature>();
    }

    public () add_declaration(InterfaceDeclSummary declaration) {
        self.declarations.add(declaration);
    }

    public () add_public_import(ImportSummaryEntry entry) {
        self.public_imports.add(entry);
    }

    public () add_public_alias(AliasExportSummary alias_export) {
        self.public_aliases.add(alias_export);
    }

    // interface 只记录 public 泛型 body template 的索引。真实编码后的 body
    // payload 存在 SourceArtifactCache.generic_templates / `.ji` template payload。
    public () add_generic_template_index(GenericTemplateIndexEntry entry) {
        self.generic_templates.add(entry);
    }

    public Bool has_generic_template(qkey.StableSymbolId stable_id) {
        return self.generic_template_fingerprint(stable_id) != null;
    }

    public qkey.Fingerprint128? generic_template_fingerprint(qkey.StableSymbolId stable_id) {
        Int! index = 0;
        while (index < self.generic_templates.len()) {
            GenericTemplateIndexEntry entry = self.generic_templates.get(index);
            if (entry.owner_stable_id == stable_id) {
                return entry.body_fingerprint;
            }
            index = index + 1;
        }
        return null;
    }

    public () set_function_signature(
        qkey.StableSymbolId stable_id,
        InterfaceFunctionSignature signature
    ) {
        self.function_signatures.set(stable_id, signature$.move());
    }

    @life(self > return)
    public InterfaceFunctionSignature&? function_signature(qkey.StableSymbolId stable_id) {
        return self.function_signatures.get(stable_id);
    }
}

public struct GenericTemplate: Movable {
    public qkey.StableSymbolId owner_stable_id;
    public qkey.Fingerprint128 body_fingerprint;
    public UInt8[] encoded_body;

    public init(
        qkey.StableSymbolId owner_stable_id,
        qkey.Fingerprint128 body_fingerprint,
        UInt8[] encoded_body
    ) {
        self.owner_stable_id = owner_stable_id;
        self.body_fingerprint = body_fingerprint;
        self.encoded_body = encoded_body;
    }
}

public struct SourceArtifactCache: Movable {
    table.HashTable<source.SourceId, ImportSummary> import_summaries;
    table.HashTable<source.SourceId, ModuleInterface> interfaces;
    table.HashTable<qkey.StableSymbolId, GenericTemplate> generic_templates;

    public init() {
        self.import_summaries = table.HashTable<source.SourceId, ImportSummary>();
        self.interfaces = table.HashTable<source.SourceId, ModuleInterface>();
        self.generic_templates = table.HashTable<qkey.StableSymbolId, GenericTemplate>();
    }

    public () store_import_summary(source.SourceId source_id, ImportSummary summary) {
        self.import_summaries.set(source_id, summary$.move());
    }

    @life(self > return)
    public ImportSummary&? load_import_summary(source.SourceId source_id) {
        return self.import_summaries.get(source_id);
    }

    public () store_interface(source.SourceId source_id, ModuleInterface module_interface) {
        self.interfaces.set(source_id, module_interface$.move());
    }

    @life(self > return)
    public ModuleInterface&? load_interface(source.SourceId source_id) {
        return self.interfaces.get(source_id);
    }

    public () store_generic_template(qkey.StableSymbolId owner_stable_id, GenericTemplate template) {
        self.generic_templates.set(owner_stable_id, template$.move());
    }

    @life(self > return)
    public GenericTemplate&? load_generic_template(qkey.StableSymbolId owner_stable_id) {
        return self.generic_templates.get(owner_stable_id);
    }
}
