// Generic HIR body template 编码。
//
// `.ji` 里的 generic template 不能保存 session-local ID。这里编码 owner-local
// HIR graph：HirId 只写 local_index，外部 DefId 写 stable id，local DefId
// 通过 symbol 重建。span/source offset 不进入 payload。

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import store_api = "../store/api.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import list = "../support/list.jiang";
import memory = "../support/memory.jiang";
import token = "../syntax/token.jiang";

enum HirTemplateNodeTag {
    block = 1,
    name_ref = 2,
    member_access = 3,
    index_access = 4,
    slice_access = 5,
    struct_literal = 6,
    array_literal = 7,
    range_expr = 8,
    call = 9,
    implicit_call = 10,
    literal = 11,
    let_stmt = 12,
    defer_stmt = 14,
    guard_stmt = 15,
    assign_stmt = 16,
    return_stmt = 17,
    throw_stmt = 18,
    break_stmt = 19,
    continue_stmt = 20,
    unary = 21,
    binary = 22,
    if_expr = 23,
    loop_expr = 24,
    switch_expr = 25,
    catch_expr = 26,
    is_pattern = 27,
    binding_pattern = 28,
    literal_pattern = 29,
    optional_pattern = 30,
    variant_pattern = 31,
    wildcard_pattern = 32,
    named_type_ref = 33,
    layered_type_ref = 34,
    array_type_ref = 35,
    errorable_type_ref = 36,
    function_type_ref = 37,
    tuple_type_ref = 38,
    infer_type_ref = 39,
    unit_type_ref = 40,
    invalid_type_ref = 41,
    invalid_node = 42,
    tuple_literal = 43,
    destructure_stmt = 47,
}

enum HirTemplateNameRefKind {
    local = 1,
    def_ref = 2,
}

enum HirTemplateLiteralKind {
    int_value = 1,
    float_value = 2,
    bool_value = 3,
    string_value = 4,
    char_value = 5,
    null_value = 6,
    unit_value = 7,
}

public UInt8[] encode_body(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    HirTemplateWriter! writer = HirTemplateWriter(ctx);
    writer.write_bytes("jiang.hir-template.v1");
    writer.write_def(hir_def.def_id);
    writer.write_body(hir_def);
    if (!writer.ok) {
        add_template_encode_error(ctx);
        return "";
    }
    return writer.finish();
}

() add_template_encode_error(context.CompilerContext& ctx) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .incremental,
            diagnostic.DiagnosticCode("hir_template_encode_failed"),
            diagnostic.SourceRange(),
            "failed to encode generic HIR template"
        )
    );
}

public Bool decode_body(store_api.CompilerStore& store, qid.DefId owner_def, UInt8[] bytes) {
    HirTemplateReader! reader = HirTemplateReader(store, owner_def, bytes);
    if (!reader.read_header()) { return false; }
    reader.skip_owner_def();
    if (!reader.read_bool()) { return false; }

    hir.HirDef& hir_def = store.hirs.def_ref(owner_def);
    hir_def.nodes.clear();
    hir.HirId root = reader.read_hir_id();
    hir.HirBody! body = hir.HirBody(owner_def, root);
    reader.read_locals(body$.ref());
    reader.read_nodes(hir_def);
    if (!reader.ok) { return false; }
    store.hirs.load_body(owner_def, body$.move());
    return true;
}

struct HirTemplateLocal {
    hir.HirLocalKind kind;
    qid.SymbolId symbol;
    Bool mutable_binding;
    Bool borrow_binding;
    hir.HirId? type_ref;
}

struct HirTemplateReader: Movable {
    store_api.CompilerStore& store;
    qid.DefId owner_def;
    UInt8[] bytes;
    Int! offset;
    Bool! ok;

    init(store_api.CompilerStore& store, qid.DefId owner_def, UInt8[] bytes) {
        self.store = store;
        self.owner_def = owner_def;
        self.bytes = bytes;
        self.offset = 0;
        self.ok = true;
    }

    Bool read_header() {
        UInt8[] header = "jiang.hir-template.v1";
        if (self.bytes.length < header.length) { return false; }
        Int! index = 0;
        while (index < header.length) {
            if (self.bytes[index] != header[index]) { return false; }
            index = index + 1;
        }
        self.offset = header.length;
        return true;
    }

    () skip_owner_def() {
        self.read_def();
    }

    () read_locals(hir.HirBody& body) {
        Int count = self.read_int();
        Int! index = 0;
        while (index < count) {
            HirTemplateLocal local = self.read_template_local();
            qid.DefId def_id = self.create_local_def(local.symbol);
            body.add_local_with_borrow_binding(
                local.kind,
                local.symbol,
                def_id,
                local.mutable_binding,
                local.borrow_binding,
                local.type_ref
            );
            index = index + 1;
        }
    }

    HirTemplateLocal read_template_local() {
        self.read_int();
        hir.HirLocalKind kind = local_kind_from_tag(self.read_int());
        qid.SymbolId symbol = self.read_symbol();
        Bool mutable_binding = self.read_bool();
        Bool borrow_binding = self.read_bool();
        hir.HirId? type_ref = self.read_optional_hir_id();
        return HirTemplateLocal (
            kind: kind,
            symbol: symbol,
            mutable_binding: mutable_binding,
            borrow_binding: borrow_binding,
            type_ref: type_ref
        );
    }

    qid.DefId create_local_def(qid.SymbolId symbol) {
        def.DefRecord owner = self.store.defs.get(self.owner_def);
        token.Span span = token.Span();
        qid.DefId def_id = self.store.defs.create(
            .local_def,
            .value_name,
            .private_visibility,
            def.Name (symbol: symbol, span: span),
            self.owner_def,
            owner.module_id,
            owner.decl_namespace_id,
            null
        );
        self.store.source_map.set_sourceless_def_span(def_id, span);
        return def_id;
    }

    () read_nodes(hir.HirDef& hir_def) {
        Int count = self.read_int();
        Int! index = 0;
        while (index < count) {
            hir.HirId node_id = self.read_hir_id();
            hir.HirNodeData data = self.read_node_data();
            if (node_id.owner_def != self.owner_def || node_id.local_index != index) {
                self.ok = false;
                return;
            }
            hir_def.nodes.add(hir.HirNode(node_id, data$.move()));
            index = index + 1;
        }
    }

    hir.HirNodeData read_node_data() {
        guard node_tag_from_int(self.read_int()) is some tag else {
            self.ok = false;
            return .invalid();
        }
        if (tag == .block) { return .block(self.read_block()); }
        if (tag == .name_ref) { return .name_ref(self.read_name_ref()); }
        if (tag == .member_access) { return .member_access(self.read_member_access()); }
        if (tag == .index_access) { return .index_access(self.read_index_access()); }
        if (tag == .slice_access) { return .slice_access(self.read_slice_access()); }
        if (tag == .struct_literal) { return .struct_literal(self.read_struct_literal()); }
        if (tag == .tuple_literal) {
            hir.HirTupleLiteral tuple_literal = hir.HirTupleLiteral (items: self.read_hir_id_array());
            return .tuple_literal(tuple_literal);
        }
        if (tag == .array_literal) {
            hir.HirArrayLiteral array_literal = hir.HirArrayLiteral (items: self.read_hir_id_array());
            return .array_literal(array_literal);
        }
        if (tag == .range_expr) { return .range_expr(self.read_range()); }
        if (tag == .call) { return .call(self.read_call()); }
        if (tag == .implicit_call) { return .implicit_call(self.read_implicit_call()); }
        if (tag == .literal) { return .literal(self.read_literal_payload()); }
        if (tag == .let_stmt) { return .let_stmt(self.read_let()); }
        if (tag == .destructure_stmt) { return .destructure_stmt(self.read_destructure()); }
        if (tag == .defer_stmt) {
            hir.HirDefer defer_stmt = hir.HirDefer (body: self.read_hir_id());
            return .defer_stmt(defer_stmt);
        }
        if (tag == .guard_stmt) { return .guard_stmt(self.read_guard()); }
        if (tag == .assign_stmt) { return .assign_stmt(self.read_assign()); }
        if (tag == .return_stmt) {
            hir.HirReturn return_stmt = hir.HirReturn (value: self.read_optional_hir_id());
            return .return_stmt(return_stmt);
        }
        if (tag == .throw_stmt) {
            hir.HirThrow throw_stmt = hir.HirThrow (value: self.read_hir_id());
            return .throw_stmt(throw_stmt);
        }
        if (tag == .break_stmt) { return .break_stmt(); }
        if (tag == .continue_stmt) { return .continue_stmt(); }
        if (tag == .unary) { return .unary(self.read_unary()); }
        if (tag == .binary) { return .binary(self.read_binary()); }
        if (tag == .if_expr) { return .if_expr(self.read_if()); }
        if (tag == .loop_expr) { return .loop_expr(self.read_loop()); }
        if (tag == .switch_expr) { return .switch_expr(self.read_switch()); }
        if (tag == .catch_expr) { return .catch_expr(self.read_catch()); }
        if (tag == .is_pattern) { return .is_pattern(self.read_is_pattern()); }
        if (tag == .binding_pattern) { return .binding_pattern(self.read_binding_pattern()); }
        if (tag == .literal_pattern) { return .literal_pattern(self.read_literal_pattern()); }
        if (tag == .optional_pattern) {
            hir.HirOptionalPattern pattern = hir.HirOptionalPattern (nested: self.read_optional_hir_id());
            return .optional_pattern(pattern);
        }
        if (tag == .variant_pattern) { return .variant_pattern(self.read_variant_pattern()); }
        if (tag == .wildcard_pattern) { return .wildcard_pattern(); }
        if (tag == .named_type_ref) { return .named_type_ref(self.read_named_type_ref()); }
        if (tag == .layered_type_ref) {
            return .layered_type_ref(self.read_layered_type_ref());
        }
        if (tag == .array_type_ref) { return .array_type_ref(self.read_array_type_ref()); }
        if (tag == .errorable_type_ref) {
            return .errorable_type_ref(self.read_errorable_type_ref());
        }
        if (tag == .function_type_ref) {
            return .function_type_ref(self.read_function_type_ref());
        }
        if (tag == .tuple_type_ref) {
            hir.HirTupleTypeRef tuple_type_ref = hir.HirTupleTypeRef (items: self.read_hir_id_array());
            return .tuple_type_ref(tuple_type_ref);
        }
        if (tag == .infer_type_ref) { return .infer_type_ref(); }
        if (tag == .unit_type_ref) { return .unit_type_ref(); }
        if (tag == .invalid_type_ref) { return .invalid_type_ref(); }
        if (tag == .invalid_node) { return .invalid(); }
        self.ok = false;
        return .invalid();
    }

    hir.HirBlock read_block() {
        hir.HirId[] statements = self.read_hir_id_array();
        hir.HirId? result = self.read_optional_hir_id();
        return hir.HirBlock (statements: statements, result: result);
    }

    hir.HirNameRef read_name_ref() {
        guard name_ref_kind_from_int(self.read_int()) is some kind else {
            self.ok = false;
            return .def_ref(qid.DefId.from_index(0));
        }
        if (kind == .local) { return .local(hir.HirLocalId.from_index(self.read_int())); }
        if (kind == .def_ref) { return .def_ref(self.read_def()); }
        self.ok = false;
        return .def_ref(qid.DefId.from_index(0));
    }

    hir.HirMemberAccess read_member_access() {
        return hir.HirMemberAccess (base: self.read_hir_id(), member_symbol: self.read_symbol());
    }

    hir.HirIndexAccess read_index_access() {
        return hir.HirIndexAccess (base: self.read_hir_id(), index: self.read_hir_id());
    }

    hir.HirSliceAccess read_slice_access() {
        return hir.HirSliceAccess (
            base: self.read_hir_id(),
            start: self.read_optional_hir_id(),
            end: self.read_optional_hir_id()
        );
    }

    hir.HirStructLiteral read_struct_literal() {
        hir.HirId type_ref = self.read_hir_id();
        Int count = self.read_int();
        hir.HirFieldInit[] fields = self.read_field_inits(count);
        return hir.HirStructLiteral (type_ref: type_ref, fields: fields);
    }

    hir.HirRange read_range() {
        return hir.HirRange (start: self.read_hir_id(), end: self.read_hir_id());
    }

    hir.HirCall read_call() {
        hir.HirId callee = self.read_hir_id();
        hir.HirId[] type_args = self.read_hir_id_array();
        hir.HirCallArg[] args = self.read_call_args();
        hir.HirCallTarget?! target = null;
        if (self.read_bool()) {
            target = hir.HirCallTarget (def_id: self.read_def(), signature_id: null);
        }
        return hir.HirCall (callee: callee, type_args: type_args, args: args, target: target);
    }

    hir.HirImplicitCall read_implicit_call() {
        hir.HirId base = self.read_hir_id();
        hir.HirImplicitOp op = implicit_op_from_tag(self.read_int());
        hir.HirId[] args = self.read_hir_id_array();
        Bool optional_chain = self.read_bool();
        return hir.HirImplicitCall (
            base: base,
            op: op,
            args: args,
            optional_chain: optional_chain
        );
    }

    hir.HirLiteral read_literal_payload() {
        guard literal_kind_from_int(self.read_int()) is some kind else {
            self.ok = false;
            return hir.HirLiteral (value: .unit_value());
        }
        if (kind == .int_value) {
            hir.HirIntLiteral int_literal = hir.HirIntLiteral (
                bits: self.read_u64(),
                signed_value: self.read_bool()
            );
            return hir.HirLiteral (value: .int_value(int_literal));
        }
        if (kind == .float_value) {
            hir.HirFloatLiteral float_literal = hir.HirFloatLiteral (value: float64_from_bits(self.read_u64()));
            return hir.HirLiteral (value: .float_value(float_literal));
        }
        if (kind == .bool_value) { return hir.HirLiteral (value: .bool_value(self.read_bool())); }
        if (kind == .string_value) { return hir.HirLiteral (value: .string_value(self.read_symbol())); }
        if (kind == .char_value) { return hir.HirLiteral (value: .char_value(UInt32(self.read_u64()))); }
        if (kind == .null_value) { return hir.HirLiteral (value: .null_value()); }
        if (kind == .unit_value) { return hir.HirLiteral (value: .unit_value()); }
        self.ok = false;
        return hir.HirLiteral (value: .unit_value());
    }

    hir.HirLet read_let() {
        hir.HirLocalId local_id = hir.HirLocalId.from_index(self.read_int());
        hir.HirId? initializer = self.read_optional_hir_id();
        return hir.HirLet (local_id: local_id, initializer: initializer);
    }

    hir.HirDestructure read_destructure() {
        hir.HirId[] bindings = self.read_hir_id_array();
        hir.HirId initializer = self.read_hir_id();
        return hir.HirDestructure (bindings: bindings, initializer: initializer);
    }

    hir.HirGuard read_guard() {
        return hir.HirGuard (condition: self.read_hir_id(), else_body: self.read_hir_id());
    }

    hir.HirAssign read_assign() {
        hir.HirAssignOp op = assign_op_from_tag(self.read_int());
        hir.HirId target = self.read_hir_id();
        hir.HirId value = self.read_hir_id();
        return hir.HirAssign (op: op, target: target, value: value);
    }

    hir.HirUnary read_unary() {
        hir.HirUnaryOp op = unary_op_from_tag(self.read_int());
        hir.HirId value = self.read_hir_id();
        return hir.HirUnary (op: op, value: value);
    }

    hir.HirBinary read_binary() {
        return hir.HirBinary (
            op: binary_op_from_tag(self.read_int()),
            left: self.read_hir_id(),
            right: self.read_hir_id()
        );
    }

    hir.HirIf read_if() {
        return hir.HirIf (
            condition: self.read_hir_id(),
            then_body: self.read_hir_id(),
            else_body: self.read_optional_hir_id()
        );
    }

    hir.HirLoop read_loop() {
        return hir.HirLoop (
            condition: self.read_optional_hir_id(),
            pattern: self.read_optional_hir_id(),
            iterable: self.read_optional_hir_id(),
            body: self.read_hir_id()
        );
    }

    hir.HirSwitch read_switch() {
        hir.HirId value = self.read_hir_id();
        Int count = self.read_int();
        Int capacity = max_one(count);
        hir.HirSwitchCase![*] stored = self.store.hirs.storage.alloc_array<hir.HirSwitchCase>(capacity);
        Int! index = 0;
        while (index < count) {
            hir.HirId[] patterns = self.read_hir_id_array();
            hir.HirId body = self.read_hir_id();
            stored[index] = hir.HirSwitchCase (
                patterns: patterns,
                body: body
            );
            index = index + 1;
        }
        hir.HirSwitchCase[] cases = stored[0..count];
        return hir.HirSwitch (value: value, cases: cases);
    }

    hir.HirCatch read_catch() {
        return hir.HirCatch (
            value: self.read_hir_id(),
            pattern: self.read_optional_hir_id(),
            body: self.read_hir_id()
        );
    }

    hir.HirIsPattern read_is_pattern() {
        return hir.HirIsPattern (value: self.read_hir_id(), pattern: self.read_hir_id());
    }

    hir.HirBindingPattern read_binding_pattern() {
        return hir.HirBindingPattern (local_id: hir.HirLocalId.from_index(self.read_int()));
    }

    hir.HirLiteralPattern read_literal_pattern() {
        return hir.HirLiteralPattern (literal: self.read_literal_payload());
    }

    hir.HirVariantPattern read_variant_pattern() {
        return hir.HirVariantPattern (
            variant_def: self.read_optional_def(),
            member_symbol: self.read_optional_symbol(),
            payload: self.read_hir_id_array()
        );
    }

    hir.HirNamedTypeRef read_named_type_ref() {
        return hir.HirNamedTypeRef (def_id: self.read_def(), args: self.read_hir_id_array());
    }

    hir.HirLayeredTypeRef read_layered_type_ref() {
        return hir.HirLayeredTypeRef (
            kind: type_layer_kind_from_tag(self.read_int()),
            element: self.read_hir_id()
        );
    }

    hir.HirArrayTypeRef read_array_type_ref() {
        return hir.HirArrayTypeRef (
            element: self.read_hir_id(),
            count_kind: array_count_kind_from_tag(self.read_int()),
            count_value: self.read_u64()
        );
    }

    hir.HirErrorableTypeRef read_errorable_type_ref() {
        return hir.HirErrorableTypeRef (
            value_type: self.read_hir_id(),
            error_type: self.read_optional_hir_id()
        );
    }

    hir.HirFunctionTypeRef read_function_type_ref() {
        hir.HirId[] params = self.read_hir_id_array();
        hir.HirId result = self.read_hir_id();
        return hir.HirFunctionTypeRef (params: params, result: result);
    }

    hir.HirId[] read_hir_id_array() {
        Int count = self.read_int();
        Int capacity = max_one(count);
        hir.HirId![*] stored = self.store.hirs.storage.alloc_array<hir.HirId>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = self.read_hir_id();
            index = index + 1;
        }
        return stored[0..count];
    }

    hir.HirCallArg[] read_call_args() {
        Int count = self.read_int();
        Int capacity = max_one(count);
        hir.HirCallArg![*] stored = self.store.hirs.storage.alloc_array<hir.HirCallArg>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = hir.HirCallArg (
                label: self.read_optional_symbol(),
                value: self.read_hir_id()
            );
            index = index + 1;
        }
        return stored[0..count];
    }

    hir.HirFieldInit[] read_field_inits(Int count) {
        Int capacity = max_one(count);
        hir.HirFieldInit![*] stored = self.store.hirs.storage.alloc_array<hir.HirFieldInit>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = hir.HirFieldInit (
                field_symbol: self.read_symbol(),
                value: self.read_hir_id()
            );
            index = index + 1;
        }
        return stored[0..count];
    }

    hir.HirId read_hir_id() {
        return hir.HirId(self.owner_def, self.read_int());
    }

    hir.HirId? read_optional_hir_id() {
        if (self.read_bool()) { return self.read_hir_id(); }
        return null;
    }

    qid.DefId? read_optional_def() {
        if (self.read_bool()) { return self.read_def(); }
        return null;
    }

    qid.SymbolId? read_optional_symbol() {
        if (self.read_bool()) { return self.read_symbol(); }
        return null;
    }

    qid.DefId read_def() {
        if (self.read_bool()) {
            qkey.StableSymbolId stable_id = qkey.StableSymbolId(self.read_u64(), self.read_u64());
            if (self.store.incremental.current_def_for_stable(stable_id) is some def_id) {
                return def_id;
            }
            self.ok = false;
            return qid.DefId.from_index(0);
        }
        return self.create_local_def(self.read_symbol());
    }

    qid.SymbolId read_symbol() {
        Int length = self.read_int();
        UInt8![*] buffer = UInt8!$.alloc_array(length + 1);
        Int! index = 0;
        while (index < length) {
            buffer[index] = self.read_byte();
            index = index + 1;
        }
        buffer[length] = 0;
        UInt8[*] frozen = buffer$.as(UInt8[*]);
        return self.store.symbols.intern(frozen[0..length]);
    }

    Bool read_bool() {
        return self.read_byte() != 0;
    }

    Int read_int() {
        return Int(self.read_u64());
    }

    UInt64 read_u64() {
        UInt64! value = 0;
        Int! index = 0;
        while (index < 8) {
            value = value | (UInt64(self.read_byte()) << UInt64(index * 8));
            index = index + 1;
        }
        return value;
    }

    UInt8 read_byte() {
        if (self.offset >= self.bytes.length) {
            self.ok = false;
            return 0;
        }
        UInt8 value = self.bytes[self.offset];
        self.offset = self.offset + 1;
        return value;
    }
}

struct HirTemplateWriter: Movable {
    context.CompilerContext& ctx;
    list.ArrayList<UInt8>! bytes;
    Bool! ok;
    init(context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.bytes = list.ArrayList<UInt8>();
        self.ok = true;
    }

    UInt8[] finish() {
        UInt8![*] result = UInt8!$.alloc_array(self.bytes.len() + 1);
        Int! index = 0;
        while (index < self.bytes.len()) {
            result[index] = self.bytes.get(index);
            index = index + 1;
        }
        result[self.bytes.len()] = 0;
        UInt8[*] frozen = result$.as(UInt8[*]);
        return frozen[0..self.bytes.len()];
    }

    () write_body(hir.HirDef& hir_def) {
        if (hir_def.body is some _& body_ref) {
            self.write_bool(true);
            self.write_hir_id(body_ref.root);
            self.write_int(body_ref.locals.len());
            Int! index = 0;
            while (index < body_ref.locals.len()) {
                hir.HirLocal& local = body_ref.locals.ref_at_index(index);
                self.write_int(local.id.to_index());
                self.write_int(local_kind_tag(local.kind));
                self.write_symbol(local.symbol);
                self.write_bool(local.mutable_binding);
                self.write_bool(local.borrow_binding);
                self.write_optional_hir_id(local.type_ref);
                index = index + 1;
            }
            self.write_nodes(hir_def);
            return;
        }
        self.write_bool(false);
    }

    () write_nodes(hir.HirDef& hir_def) {
        self.write_int(hir_def.nodes.len());
        Int! index = 0;
        while (index < hir_def.nodes.len()) {
            hir.HirNode& node = hir_def.nodes.ref_at(index);
            self.write_int(node.id.local_index);
            self.write_node_data(node.data);
            index = index + 1;
        }
    }

    () write_node_data(hir.HirNodeData data) {
        if (data is .block(block)) { self.write_block(block); return; }
        if (data is .name_ref(name_ref)) { self.write_name_ref(name_ref); return; }
        if (data is .member_access(member)) { self.write_member_access(member); return; }
        if (data is .index_access(index_access)) { self.write_index_access(index_access); return; }
        if (data is .slice_access(slice_access)) { self.write_slice_access(slice_access); return; }
        if (data is .struct_literal(literal)) { self.write_struct_literal(literal); return; }
        if (data is .tuple_literal(literal)) {
            self.write_hir_id_array(Int(HirTemplateNodeTag.tuple_literal), literal.items);
            return;
        }
        if (data is .array_literal(literal)) {
            self.write_hir_id_array(Int(HirTemplateNodeTag.array_literal), literal.items);
            return;
        }
        if (data is .range_expr(range)) {
            self.write_binary_ids(Int(HirTemplateNodeTag.range_expr), range.start, range.end);
            return;
        }
        if (data is .call(call)) { self.write_call(call); return; }
        if (data is .implicit_call(call)) { self.write_implicit_call(call); return; }
        if (data is .literal(literal)) { self.write_literal(literal); return; }
        if (data is .let_stmt(let_stmt)) { self.write_let(let_stmt); return; }
        if (data is .destructure_stmt(destructure)) { self.write_destructure(destructure); return; }
        if (data is .defer_stmt(defer_stmt)) {
            self.write_unary_id(Int(HirTemplateNodeTag.defer_stmt), defer_stmt.body);
            return;
        }
        if (data is .guard_stmt(guard_stmt)) { self.write_guard(guard_stmt); return; }
        if (data is .assign_stmt(assign_stmt)) { self.write_assign(assign_stmt); return; }
        if (data is .return_stmt(return_stmt)) { self.write_return(return_stmt); return; }
        if (data is .throw_stmt(throw_stmt)) {
            self.write_unary_id(Int(HirTemplateNodeTag.throw_stmt), throw_stmt.value);
            return;
        }
        if (data is .break_stmt) { self.write_tag(Int(HirTemplateNodeTag.break_stmt)); return; }
        if (data is .continue_stmt) { self.write_tag(Int(HirTemplateNodeTag.continue_stmt)); return; }
        if (data is .unary(unary)) { self.write_unary(unary); return; }
        if (data is .binary(binary)) { self.write_binary(binary); return; }
        if (data is .if_expr(if_expr)) { self.write_if(if_expr); return; }
        if (data is .loop_expr(loop_expr)) { self.write_loop(loop_expr); return; }
        if (data is .switch_expr(switch_expr)) { self.write_switch(switch_expr); return; }
        if (data is .catch_expr(catch_expr)) { self.write_catch(catch_expr); return; }
        if (data is .is_pattern(is_pattern)) {
            self.write_binary_ids(Int(HirTemplateNodeTag.is_pattern), is_pattern.value, is_pattern.pattern);
            return;
        }
        if (data is .binding_pattern(pattern)) { self.write_binding_pattern(pattern); return; }
        if (data is .literal_pattern(pattern)) { self.write_literal_pattern(pattern); return; }
        if (data is .optional_pattern(pattern)) {
            self.write_tag(Int(HirTemplateNodeTag.optional_pattern));
            self.write_optional_hir_id(pattern.nested);
            return;
        }
        if (data is .variant_pattern(pattern)) { self.write_variant_pattern(pattern); return; }
        if (data is .wildcard_pattern) { self.write_tag(Int(HirTemplateNodeTag.wildcard_pattern)); return; }
        if (data is .named_type_ref(named)) { self.write_named_type_ref(named); return; }
        if (data is .layered_type_ref(layered)) { self.write_layered_type_ref(layered); return; }
        if (data is .array_type_ref(array_type)) { self.write_array_type_ref(array_type); return; }
        if (data is .errorable_type_ref(errorable)) { self.write_errorable_type_ref(errorable); return; }
        if (data is .function_type_ref(function_type)) { self.write_function_type_ref(function_type); return; }
        if (data is .tuple_type_ref(tuple_type)) {
            self.write_hir_id_array(Int(HirTemplateNodeTag.tuple_type_ref), tuple_type.items);
            return;
        }
        if (data is .infer_type_ref) { self.write_tag(Int(HirTemplateNodeTag.infer_type_ref)); return; }
        if (data is .unit_type_ref) { self.write_tag(Int(HirTemplateNodeTag.unit_type_ref)); return; }
        if (data is .invalid_type_ref) { self.write_tag(Int(HirTemplateNodeTag.invalid_type_ref)); return; }
        if (data is .invalid) { self.write_tag(Int(HirTemplateNodeTag.invalid_node)); return; }
        self.ok = false;
        self.write_tag(Int(HirTemplateNodeTag.unit_type_ref));
    }

    () write_block(hir.HirBlock block) {
        self.write_tag(Int(HirTemplateNodeTag.block));
        self.write_hir_id_array_payload(block.statements);
        self.write_optional_hir_id(block.result);
    }

    () write_name_ref(hir.HirNameRef name_ref) {
        self.write_tag(Int(HirTemplateNodeTag.name_ref));
        if (name_ref is .local(local_id)) {
            self.write_int(Int(HirTemplateNameRefKind.local));
            self.write_int(local_id.to_index());
            return;
        }
        if (name_ref is .def_ref(def_id)) {
            self.write_int(Int(HirTemplateNameRefKind.def_ref));
            self.write_def(def_id);
            return;
        }
        self.ok = false;
        self.write_int(Int(HirTemplateNameRefKind.local));
        self.write_int(0);
    }

    () write_member_access(hir.HirMemberAccess member) {
        self.write_tag(Int(HirTemplateNodeTag.member_access));
        self.write_hir_id(member.base);
        self.write_symbol(member.member_symbol);
    }

    () write_index_access(hir.HirIndexAccess index_access) {
        self.write_binary_ids(Int(HirTemplateNodeTag.index_access), index_access.base, index_access.index);
    }

    () write_slice_access(hir.HirSliceAccess slice_access) {
        self.write_tag(Int(HirTemplateNodeTag.slice_access));
        self.write_hir_id(slice_access.base);
        self.write_optional_hir_id(slice_access.start);
        self.write_optional_hir_id(slice_access.end);
    }

    () write_struct_literal(hir.HirStructLiteral literal) {
        self.write_tag(Int(HirTemplateNodeTag.struct_literal));
        self.write_hir_id(literal.type_ref);
        self.write_int(literal.fields.length);
        Int! index = 0;
        while (index < literal.fields.length) {
            self.write_symbol(literal.fields[index].field_symbol);
            self.write_hir_id(literal.fields[index].value);
            index = index + 1;
        }
    }

    () write_call(hir.HirCall call) {
        self.write_tag(Int(HirTemplateNodeTag.call));
        self.write_hir_id(call.callee);
        self.write_hir_id_array_payload(call.type_args);
        self.write_int(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            self.write_optional_symbol(call.args[index].label);
            self.write_hir_id(call.args[index].value);
            index = index + 1;
        }
        if (call.target is some target) {
            self.write_bool(true);
            self.write_def(target.def_id);
            return;
        }
        self.write_bool(false);
    }

    () write_implicit_call(hir.HirImplicitCall call) {
        self.write_tag(Int(HirTemplateNodeTag.implicit_call));
        self.write_hir_id(call.base);
        self.write_int(implicit_op_tag(call.op));
        self.write_hir_id_array_payload(call.args);
        self.write_bool(call.optional_chain);
    }

    () write_literal(hir.HirLiteral literal) {
        self.write_tag(Int(HirTemplateNodeTag.literal));
        self.write_literal_payload(literal);
    }

    () write_literal_payload(hir.HirLiteral literal) {
        if (literal.value is .int_value(value)) {
            self.write_int(Int(HirTemplateLiteralKind.int_value));
            self.write_u64(value.bits);
            self.write_bool(value.signed_value);
            return;
        }
        if (literal.value is .float_value(value)) {
            self.write_int(Int(HirTemplateLiteralKind.float_value));
            self.write_u64(float64_to_bits(value.value));
            return;
        }
        if (literal.value is .bool_value(value)) {
            self.write_int(Int(HirTemplateLiteralKind.bool_value));
            self.write_bool(value);
            return;
        }
        if (literal.value is .string_value(value)) {
            self.write_int(Int(HirTemplateLiteralKind.string_value));
            self.write_symbol(value);
            return;
        }
        if (literal.value is .char_value(value)) {
            self.write_int(Int(HirTemplateLiteralKind.char_value));
            self.write_u64(UInt64(value));
            return;
        }
        if (literal.value is .null_value) {
            self.write_int(Int(HirTemplateLiteralKind.null_value));
            return;
        }
        self.write_int(Int(HirTemplateLiteralKind.unit_value));
    }

    () write_let(hir.HirLet let_stmt) {
        self.write_tag(Int(HirTemplateNodeTag.let_stmt));
        self.write_int(let_stmt.local_id.to_index());
        self.write_optional_hir_id(let_stmt.initializer);
    }

    () write_destructure(hir.HirDestructure destructure) {
        self.write_tag(Int(HirTemplateNodeTag.destructure_stmt));
        self.write_hir_id_array_payload(destructure.bindings);
        self.write_hir_id(destructure.initializer);
    }

    () write_guard(hir.HirGuard guard_stmt) {
        self.write_tag(Int(HirTemplateNodeTag.guard_stmt));
        self.write_hir_id(guard_stmt.condition);
        self.write_hir_id(guard_stmt.else_body);
    }

    () write_assign(hir.HirAssign assign_stmt) {
        self.write_tag(Int(HirTemplateNodeTag.assign_stmt));
        self.write_int(assign_op_tag(assign_stmt.op));
        self.write_hir_id(assign_stmt.target);
        self.write_hir_id(assign_stmt.value);
    }

    () write_return(hir.HirReturn return_stmt) {
        self.write_tag(Int(HirTemplateNodeTag.return_stmt));
        self.write_optional_hir_id(return_stmt.value);
    }

    () write_unary(hir.HirUnary unary) {
        self.write_tag(Int(HirTemplateNodeTag.unary));
        self.write_int(unary_op_tag(unary.op));
        self.write_hir_id(unary.value);
    }

    () write_binary(hir.HirBinary binary) {
        self.write_tag(Int(HirTemplateNodeTag.binary));
        self.write_int(binary_op_tag(binary.op));
        self.write_hir_id(binary.left);
        self.write_hir_id(binary.right);
    }

    () write_if(hir.HirIf if_expr) {
        self.write_tag(Int(HirTemplateNodeTag.if_expr));
        self.write_hir_id(if_expr.condition);
        self.write_hir_id(if_expr.then_body);
        self.write_optional_hir_id(if_expr.else_body);
    }

    () write_loop(hir.HirLoop loop_expr) {
        self.write_tag(Int(HirTemplateNodeTag.loop_expr));
        self.write_optional_hir_id(loop_expr.condition);
        self.write_optional_hir_id(loop_expr.pattern);
        self.write_optional_hir_id(loop_expr.iterable);
        self.write_hir_id(loop_expr.body);
    }

    () write_switch(hir.HirSwitch switch_expr) {
        self.write_tag(Int(HirTemplateNodeTag.switch_expr));
        self.write_hir_id(switch_expr.value);
        self.write_int(switch_expr.cases.length);
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            self.write_hir_id_array_payload(switch_expr.cases[index].patterns);
            self.write_hir_id(switch_expr.cases[index].body);
            index = index + 1;
        }
    }

    () write_catch(hir.HirCatch catch_expr) {
        self.write_tag(Int(HirTemplateNodeTag.catch_expr));
        self.write_hir_id(catch_expr.value);
        self.write_optional_hir_id(catch_expr.pattern);
        self.write_hir_id(catch_expr.body);
    }

    () write_binding_pattern(hir.HirBindingPattern pattern) {
        self.write_tag(Int(HirTemplateNodeTag.binding_pattern));
        self.write_int(pattern.local_id.to_index());
    }

    () write_literal_pattern(hir.HirLiteralPattern pattern) {
        self.write_tag(Int(HirTemplateNodeTag.literal_pattern));
        self.write_literal_payload(pattern.literal);
    }

    () write_variant_pattern(hir.HirVariantPattern pattern) {
        self.write_tag(Int(HirTemplateNodeTag.variant_pattern));
        self.write_optional_def(pattern.variant_def);
        self.write_optional_symbol(pattern.member_symbol);
        self.write_hir_id_array_payload(pattern.payload);
    }

    () write_named_type_ref(hir.HirNamedTypeRef named) {
        self.write_tag(Int(HirTemplateNodeTag.named_type_ref));
        self.write_def(named.def_id);
        self.write_hir_id_array_payload(named.args);
    }

    () write_layered_type_ref(hir.HirLayeredTypeRef layered) {
        self.write_tag(Int(HirTemplateNodeTag.layered_type_ref));
        self.write_int(type_layer_kind_tag(layered.kind));
        self.write_hir_id(layered.element);
    }

    () write_array_type_ref(hir.HirArrayTypeRef array_type) {
        self.write_tag(Int(HirTemplateNodeTag.array_type_ref));
        self.write_hir_id(array_type.element);
        self.write_int(array_count_kind_tag(array_type.count_kind));
        self.write_u64(array_type.count_value);
    }

    () write_errorable_type_ref(hir.HirErrorableTypeRef errorable) {
        self.write_tag(Int(HirTemplateNodeTag.errorable_type_ref));
        self.write_hir_id(errorable.value_type);
        self.write_optional_hir_id(errorable.error_type);
    }

    () write_function_type_ref(hir.HirFunctionTypeRef function_type) {
        self.write_tag(Int(HirTemplateNodeTag.function_type_ref));
        self.write_hir_id_array_payload(function_type.params);
        self.write_hir_id(function_type.result);
    }

    () write_hir_id_array(Int tag, hir.HirId[] values) {
        self.write_tag(tag);
        self.write_hir_id_array_payload(values);
    }

    () write_binary_ids(Int tag, hir.HirId left, hir.HirId right) {
        self.write_tag(tag);
        self.write_hir_id(left);
        self.write_hir_id(right);
    }

    () write_unary_id(Int tag, hir.HirId value) {
        self.write_tag(tag);
        self.write_hir_id(value);
    }

    () write_tag(Int tag) {
        self.write_int(tag);
    }

    () write_hir_id_array_payload(hir.HirId[] values) {
        self.write_int(values.length);
        Int! index = 0;
        while (index < values.length) {
            self.write_hir_id(values[index]);
            index = index + 1;
        }
    }

    () write_hir_id(hir.HirId id) {
        self.write_int(id.local_index);
    }

    () write_optional_hir_id(hir.HirId? id) {
        if (id is some value) {
            self.write_bool(true);
            self.write_hir_id(value);
            return;
        }
        self.write_bool(false);
    }

    () write_optional_def(qid.DefId? def_id) {
        if (def_id is some value) {
            self.write_bool(true);
            self.write_def(value);
            return;
        }
        self.write_bool(false);
    }

    () write_def(qid.DefId def_id) {
        if (self.ctx.store.incremental.stable_id_for_def(def_id) is some stable_id) {
            self.write_bool(true);
            self.write_u64(stable_id.low);
            self.write_u64(stable_id.high);
            return;
        }
        self.write_bool(false);
        self.write_symbol(self.ctx.store.defs.get(def_id).name.symbol);
    }

    () write_optional_symbol(qid.SymbolId? symbol_id) {
        if (symbol_id is some symbol) {
            self.write_bool(true);
            self.write_symbol(symbol);
            return;
        }
        self.write_bool(false);
    }

    () write_symbol(qid.SymbolId symbol_id) {
        UInt8[] text = self.ctx.store.symbols.text(symbol_id);
        self.write_int(text.length);
        self.write_bytes(text);
    }

    () write_bool(Bool value) {
        if (value) { self.bytes.add(UInt8(1)); return; }
        self.bytes.add(UInt8(0));
    }

    () write_int(Int value) {
        self.write_u64(UInt64(value));
    }

    () write_u64(UInt64 value) {
        Int! index = 0;
        while (index < 8) {
            self.bytes.add(UInt8((value >> UInt64(index * 8)) & UInt64(255)));
            index = index + 1;
        }
    }

    () write_bytes(UInt8[] value) {
        Int! index = 0;
        while (index < value.length) {
            self.bytes.add(value[index]);
            index = index + 1;
        }
    }
}

HirTemplateNodeTag? node_tag_from_int(Int value) {
    if (value == Int(HirTemplateNodeTag.block)) { return HirTemplateNodeTag.block; }
    if (value == Int(HirTemplateNodeTag.name_ref)) { return HirTemplateNodeTag.name_ref; }
    if (value == Int(HirTemplateNodeTag.member_access)) { return HirTemplateNodeTag.member_access; }
    if (value == Int(HirTemplateNodeTag.index_access)) { return HirTemplateNodeTag.index_access; }
    if (value == Int(HirTemplateNodeTag.slice_access)) { return HirTemplateNodeTag.slice_access; }
    if (value == Int(HirTemplateNodeTag.struct_literal)) { return HirTemplateNodeTag.struct_literal; }
    if (value == Int(HirTemplateNodeTag.array_literal)) { return HirTemplateNodeTag.array_literal; }
    if (value == Int(HirTemplateNodeTag.range_expr)) { return HirTemplateNodeTag.range_expr; }
    if (value == Int(HirTemplateNodeTag.call)) { return HirTemplateNodeTag.call; }
    if (value == Int(HirTemplateNodeTag.implicit_call)) { return HirTemplateNodeTag.implicit_call; }
    if (value == Int(HirTemplateNodeTag.literal)) { return HirTemplateNodeTag.literal; }
    if (value == Int(HirTemplateNodeTag.let_stmt)) { return HirTemplateNodeTag.let_stmt; }
    if (value == Int(HirTemplateNodeTag.destructure_stmt)) { return HirTemplateNodeTag.destructure_stmt; }
    if (value == Int(HirTemplateNodeTag.defer_stmt)) { return HirTemplateNodeTag.defer_stmt; }
    if (value == Int(HirTemplateNodeTag.guard_stmt)) { return HirTemplateNodeTag.guard_stmt; }
    if (value == Int(HirTemplateNodeTag.assign_stmt)) { return HirTemplateNodeTag.assign_stmt; }
    if (value == Int(HirTemplateNodeTag.return_stmt)) { return HirTemplateNodeTag.return_stmt; }
    if (value == Int(HirTemplateNodeTag.throw_stmt)) { return HirTemplateNodeTag.throw_stmt; }
    if (value == Int(HirTemplateNodeTag.break_stmt)) { return HirTemplateNodeTag.break_stmt; }
    if (value == Int(HirTemplateNodeTag.continue_stmt)) { return HirTemplateNodeTag.continue_stmt; }
    if (value == Int(HirTemplateNodeTag.unary)) { return HirTemplateNodeTag.unary; }
    if (value == Int(HirTemplateNodeTag.binary)) { return HirTemplateNodeTag.binary; }
    if (value == Int(HirTemplateNodeTag.if_expr)) { return HirTemplateNodeTag.if_expr; }
    if (value == Int(HirTemplateNodeTag.loop_expr)) { return HirTemplateNodeTag.loop_expr; }
    if (value == Int(HirTemplateNodeTag.switch_expr)) { return HirTemplateNodeTag.switch_expr; }
    if (value == Int(HirTemplateNodeTag.catch_expr)) { return HirTemplateNodeTag.catch_expr; }
    if (value == Int(HirTemplateNodeTag.is_pattern)) { return HirTemplateNodeTag.is_pattern; }
    if (value == Int(HirTemplateNodeTag.binding_pattern)) { return HirTemplateNodeTag.binding_pattern; }
    if (value == Int(HirTemplateNodeTag.literal_pattern)) { return HirTemplateNodeTag.literal_pattern; }
    if (value == Int(HirTemplateNodeTag.optional_pattern)) { return HirTemplateNodeTag.optional_pattern; }
    if (value == Int(HirTemplateNodeTag.variant_pattern)) { return HirTemplateNodeTag.variant_pattern; }
    if (value == Int(HirTemplateNodeTag.wildcard_pattern)) { return HirTemplateNodeTag.wildcard_pattern; }
    if (value == Int(HirTemplateNodeTag.named_type_ref)) { return HirTemplateNodeTag.named_type_ref; }
    if (value == Int(HirTemplateNodeTag.layered_type_ref)) { return HirTemplateNodeTag.layered_type_ref; }
    if (value == Int(HirTemplateNodeTag.array_type_ref)) { return HirTemplateNodeTag.array_type_ref; }
    if (value == Int(HirTemplateNodeTag.errorable_type_ref)) { return HirTemplateNodeTag.errorable_type_ref; }
    if (value == Int(HirTemplateNodeTag.function_type_ref)) { return HirTemplateNodeTag.function_type_ref; }
    if (value == Int(HirTemplateNodeTag.tuple_type_ref)) { return HirTemplateNodeTag.tuple_type_ref; }
    if (value == Int(HirTemplateNodeTag.infer_type_ref)) { return HirTemplateNodeTag.infer_type_ref; }
    if (value == Int(HirTemplateNodeTag.unit_type_ref)) { return HirTemplateNodeTag.unit_type_ref; }
    if (value == Int(HirTemplateNodeTag.invalid_type_ref)) { return HirTemplateNodeTag.invalid_type_ref; }
    if (value == Int(HirTemplateNodeTag.invalid_node)) { return HirTemplateNodeTag.invalid_node; }
    if (value == Int(HirTemplateNodeTag.tuple_literal)) { return HirTemplateNodeTag.tuple_literal; }
    return null;
}

HirTemplateNameRefKind? name_ref_kind_from_int(Int value) {
    if (value == Int(HirTemplateNameRefKind.local)) { return HirTemplateNameRefKind.local; }
    if (value == Int(HirTemplateNameRefKind.def_ref)) { return HirTemplateNameRefKind.def_ref; }
    return null;
}

HirTemplateLiteralKind? literal_kind_from_int(Int value) {
    if (value == Int(HirTemplateLiteralKind.int_value)) { return HirTemplateLiteralKind.int_value; }
    if (value == Int(HirTemplateLiteralKind.float_value)) { return HirTemplateLiteralKind.float_value; }
    if (value == Int(HirTemplateLiteralKind.bool_value)) { return HirTemplateLiteralKind.bool_value; }
    if (value == Int(HirTemplateLiteralKind.string_value)) { return HirTemplateLiteralKind.string_value; }
    if (value == Int(HirTemplateLiteralKind.char_value)) { return HirTemplateLiteralKind.char_value; }
    if (value == Int(HirTemplateLiteralKind.null_value)) { return HirTemplateLiteralKind.null_value; }
    if (value == Int(HirTemplateLiteralKind.unit_value)) { return HirTemplateLiteralKind.unit_value; }
    return null;
}

Int local_kind_tag(hir.HirLocalKind kind) {
    if (kind == .parameter) { return 1; }
    if (kind == .generic_parameter) { return 2; }
    if (kind == .local_variable) { return 3; }
    return 4;
}

hir.HirLocalKind local_kind_from_tag(Int tag) {
    if (tag == 1) { return .parameter; }
    if (tag == 2) { return .generic_parameter; }
    if (tag == 3) { return .local_variable; }
    return .pattern_binding;
}

Int implicit_op_tag(hir.HirImplicitOp op) {
    if (op == .get) { return 1; }
    if (op == .set) { return 2; }
    if (op == .move) { return 3; }
    if (op == .ref) { return 4; }
    if (op == .addr) { return 5; }
    if (op == .cast) { return 6; }
    if (op == .free) { return 7; }
    if (op == .optional_some) { return 8; }
    if (op == .alloc_array) { return 9; }
    if (op == .size) { return 10; }
    if (op == .align) { return 11; }
    if (op == .max_align) { return 12; }
    return 0;
}

hir.HirImplicitOp implicit_op_from_tag(Int tag) {
    if (tag == 1) { return .get; }
    if (tag == 2) { return .set; }
    if (tag == 3) { return .move; }
    if (tag == 4) { return .ref; }
    if (tag == 5) { return .addr; }
    if (tag == 6) { return .cast; }
    if (tag == 7) { return .free; }
    if (tag == 8) { return .optional_some; }
    if (tag == 9) { return .alloc_array; }
    if (tag == 10) { return .size; }
    if (tag == 11) { return .align; }
    if (tag == 12) { return .max_align; }
    return .unknown;
}

Int assign_op_tag(hir.HirAssignOp op) {
    if (op == .assign) { return 1; }
    if (op == .add_assign) { return 2; }
    if (op == .sub_assign) { return 3; }
    if (op == .mul_assign) { return 4; }
    if (op == .div_assign) { return 5; }
    if (op == .mod_assign) { return 6; }
    if (op == .bit_and_assign) { return 7; }
    if (op == .bit_or_assign) { return 8; }
    if (op == .bit_xor_assign) { return 9; }
    if (op == .shift_left_assign) { return 10; }
    return 11;
}

hir.HirAssignOp assign_op_from_tag(Int tag) {
    if (tag == 1) { return .assign; }
    if (tag == 2) { return .add_assign; }
    if (tag == 3) { return .sub_assign; }
    if (tag == 4) { return .mul_assign; }
    if (tag == 5) { return .div_assign; }
    if (tag == 6) { return .mod_assign; }
    if (tag == 7) { return .bit_and_assign; }
    if (tag == 8) { return .bit_or_assign; }
    if (tag == 9) { return .bit_xor_assign; }
    if (tag == 10) { return .shift_left_assign; }
    return .shift_right_assign;
}

Int unary_op_tag(hir.HirUnaryOp op) {
    if (op == .negate) { return 1; }
    if (op == .not) { return 2; }
    if (op == .bit_not) { return 3; }
    if (op == .address_of) { return 4; }
    if (op == .deref) { return 5; }
    return 6;
}

hir.HirUnaryOp unary_op_from_tag(Int tag) {
    if (tag == 1) { return .negate; }
    if (tag == 2) { return .not; }
    if (tag == 3) { return .bit_not; }
    if (tag == 4) { return .address_of; }
    if (tag == 5) { return .deref; }
    return .new_value;
}

Int binary_op_tag(hir.HirBinaryOp op) {
    if (op == .add) { return 1; }
    if (op == .sub) { return 2; }
    if (op == .mul) { return 3; }
    if (op == .div) { return 4; }
    if (op == .mod) { return 5; }
    if (op == .bit_and) { return 6; }
    if (op == .bit_or) { return 7; }
    if (op == .bit_xor) { return 8; }
    if (op == .logic_and) { return 9; }
    if (op == .logic_or) { return 10; }
    if (op == .coalesce) { return 11; }
    if (op == .shift_left) { return 12; }
    if (op == .shift_right) { return 13; }
    if (op == .equal) { return 14; }
    if (op == .not_equal) { return 15; }
    if (op == .less) { return 16; }
    if (op == .less_equal) { return 17; }
    if (op == .greater) { return 18; }
    return 19;
}

hir.HirBinaryOp binary_op_from_tag(Int tag) {
    if (tag == 1) { return .add; }
    if (tag == 2) { return .sub; }
    if (tag == 3) { return .mul; }
    if (tag == 4) { return .div; }
    if (tag == 5) { return .mod; }
    if (tag == 6) { return .bit_and; }
    if (tag == 7) { return .bit_or; }
    if (tag == 8) { return .bit_xor; }
    if (tag == 9) { return .logic_and; }
    if (tag == 10) { return .logic_or; }
    if (tag == 11) { return .coalesce; }
    if (tag == 12) { return .shift_left; }
    if (tag == 13) { return .shift_right; }
    if (tag == 14) { return .equal; }
    if (tag == 15) { return .not_equal; }
    if (tag == 16) { return .less; }
    if (tag == 17) { return .less_equal; }
    if (tag == 18) { return .greater; }
    return .greater_equal;
}

Int type_layer_kind_tag(hir.HirTypeLayerKind kind) {
    if (kind == .optional_type) { return 1; }
    if (kind == .mutable_type) { return 2; }
    if (kind == .reference) { return 3; }
    if (kind == .owner_pointer) { return 4; }
    if (kind == .raw_pointer) { return 5; }
    if (kind == .many_pointer) { return 6; }
    return 7;
}

hir.HirTypeLayerKind type_layer_kind_from_tag(Int tag) {
    if (tag == 1) { return .optional_type; }
    if (tag == 2) { return .mutable_type; }
    if (tag == 3) { return .reference; }
    if (tag == 4) { return .owner_pointer; }
    if (tag == 5) { return .raw_pointer; }
    if (tag == 6) { return .many_pointer; }
    return .slice;
}

Int array_count_kind_tag(hir.HirArrayCountKind kind) {
    if (kind == .inferred) { return 1; }
    return 2;
}

hir.HirArrayCountKind array_count_kind_from_tag(Int tag) {
    if (tag == 1) { return .inferred; }
    return .int_lit;
}

Int max_one(Int value) {
    if (value > 0) { return value; }
    return 1;
}

UInt64 float64_to_bits(Float64 value) {
    Float64![*] input = Float64!$.alloc_array(1);
    UInt64![*] output = UInt64!$.alloc_array(1);
    input[0] = value;
    memory.copy_bytes(output[0]$.addr()$.as(UInt8[*]), input[0]$.addr()$.as(UInt8[*]), 8);
    return output[0];
}

Float64 float64_from_bits(UInt64 bits) {
    UInt64![*] input = UInt64!$.alloc_array(1);
    Float64![*] output = Float64!$.alloc_array(1);
    input[0] = bits;
    memory.copy_bytes(output[0]$.addr()$.as(UInt8[*]), input[0]$.addr()$.as(UInt8[*]), 8);
    return output[0];
}
