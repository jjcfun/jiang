// Source artifact 的稳定 interface fingerprint。
//
// 这里刻意不写入 SourceId、SourceHash、SymbolId.to_index() 等 session-local 或
// source-local 数据。Interface hash 只描述对依赖方可见的语义表面：公开声明、
// public import / alias、trait/where/lifetime 约束以及签名信息。

import context = "../context.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import store = "../resolve/store.jiang";
import blake3 = "../support/blake3.jiang";
import list = "../support/list.jiang";
import memory = "../support/memory.jiang";
import source = "../source.jiang";
import ji = "./ji_file.jiang";
import source_artifact = "./source.jiang";
import cache_identity = "./cache_identity.jiang";

public struct SourceSectionImage: Movable {
    public list.ArrayList<UInt8> bytes;
    public qkey.Fingerprint128 fingerprint;

    public init(self, list.ArrayList<UInt8> bytes, qkey.Fingerprint128 fingerprint) {
        self.bytes = bytes;
        self.fingerprint = fingerprint;
    }
}

public SourceSectionImage encode_import_summary_section(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    write_import_summary(ctx, writer$.ref(), summary);
    qkey.Fingerprint128 fingerprint = writer.finish();
    return SourceSectionImage(bytes, fingerprint);
}

public ji.JiSectionPayload import_summary_payload(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    write_import_summary(ctx, writer$.ref(), summary);
    qkey.Fingerprint128 fingerprint = writer.finish();
    return ji.JiSectionPayload(.import_summary, bytes, fingerprint);
}

