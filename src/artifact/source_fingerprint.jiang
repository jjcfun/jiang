    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    write_generic_templates(ctx, writer$.ref(), module_interface);
    qkey.Fingerprint128 fingerprint = writer.finish();
    return ji.JiSectionPayload(.generic_templates, bytes, fingerprint);
}

public ji.JiSectionPayload declaration_observations_payload(
    source_artifact.DeclarationObservationSet& observations
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    writer.write_bytes("jiang.declaration-observations.v1");
    writer.write_int(observations.entries.len());
    Int index! = 0;
    while (index < observations.entries.len()) {
        source_artifact.DeclarationObservation observation =
            observations.entries.get(index);
        write_fingerprint(writer$.ref(), observation.dependency_source.fingerprint);
        write_stable_id(writer$.ref(), observation.subject);
        writer.write_int(Int(observation.aspect));
        write_fingerprint(writer$.ref(), observation.name);
        write_fingerprint(writer$.ref(), observation.observed);
        index = index + 1;
    }
    qkey.Fingerprint128 fingerprint = writer.finish();
    return ji.JiSectionPayload(.declaration_observations, bytes, fingerprint);
}

public source_artifact.DeclarationObservationSet? decode_declaration_observations_section(
    UInt8[]& bytes
) {
    SourceSectionReader reader! = SourceSectionReader(bytes);
    if (!reader.read_magic("jiang.declaration-observations.v1")) { return null; }
    guard reader.read_int() is .some(count) else { return null; }
    if (count < 0) { return null; }
    source_artifact.DeclarationObservationSet observations! =
        source_artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < count) {
        guard reader.read_fingerprint() is .some(dependency_source) else { return null; }
        guard reader.read_stable_id() is .some(subject) else { return null; }
        guard reader.read_int() is .some(aspect_value) else { return null; }
        guard observation_aspect(aspect_value) is .some(aspect) else { return null; }
        guard reader.read_fingerprint() is .some(name) else { return null; }
        guard reader.read_fingerprint() is .some(observed) else { return null; }
        observations.add(source_artifact.DeclarationObservation(
            cache_identity.StableSourceId(dependency_source),
            subject,
            aspect,
            name,
            observed
        ));
        index = index + 1;
    }
    if (!reader.finished()) { return null; }
    return observations;
}

source_artifact.ObservationAspect? observation_aspect(Int value) {
    source_artifact.ObservationAspect signature = .signature;
    source_artifact.ObservationAspect body = .body;
    source_artifact.ObservationAspect namespace = .namespace;
    source_artifact.ObservationAspect namespace_name = .namespace_name;
    if (value == Int(signature)) { return source_artifact.ObservationAspect.signature; }
    if (value == Int(body)) { return source_artifact.ObservationAspect.body; }
    if (value == Int(namespace)) { return source_artifact.ObservationAspect.namespace; }
    if (value == Int(namespace_name)) { return source_artifact.ObservationAspect.namespace_name; }
    return null;
}

public source_artifact.ImportSummary? decode_import_summary_section(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    UInt8[]& bytes
) {
    SourceSectionReader reader! = SourceSectionReader(bytes);
    if (!reader.read_magic("jiang.import-summary.v2")) {
        return null;
    }
    guard reader.read_uint64() is .some(source_hash) else { return null; }
    guard reader.read_int() is .some(source_revision) else { return null; }
    guard reader.read_fingerprint() is .some(import_context_fingerprint) else { return null; }
    guard reader.read_symbol(ctx) is .some(package_name) else { return null; }
    guard reader.read_symbol(ctx) is .some(module_path) else { return null; }
    guard reader.read_symbol(ctx) is .some(source_path) else { return null; }

    source_artifact.ImportSummary summary! = source_artifact.ImportSummary(
        source_id,
        source_hash,
        source_revision,
        package_name,
        module_path,
        source_path,
        import_context_fingerprint
    );
    if (!read_import_entries(ctx, reader$.ref(), summary$.ref())) { return null; }
    if (!read_alias_entries(ctx, reader$.ref(), summary$.ref())) { return null; }
    if (!reader.finished()) { return null; }
    return summary;
}

public source_artifact.ModuleInterface? decode_module_interface_section(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    UInt64 source_hash,
    UInt8[]& bytes,
    qkey.Fingerprint128? interface_hash = null,
    qkey.Fingerprint128? public_interface_hash = null
) {
    SourceSectionReader reader! = SourceSectionReader(bytes);
    if (!reader.read_magic("jiang.interface.v15")) {
        return null;
    }
    guard reader.read_symbol(ctx) is .some(package_name) else { return null; }
    guard reader.read_symbol(ctx) is .some(module_path) else { return null; }

    source_artifact.ModuleInterface module_interface! = source_artifact.ModuleInterface(
        source_id,
        source_hash,
        package_name,
        module_path
    );
    if (!read_interface_declarations(ctx, reader$.ref(), module_interface$.ref())) { return null; }
    if (!read_interface_imports(ctx, reader$.ref(), module_interface$.ref())) { return null; }
    if (!read_interface_aliases(ctx, reader$.ref(), module_interface$.ref())) { return null; }
    if (!read_extension_groups(ctx, reader$.ref(), module_interface$.ref())) { return null; }
    if (!reader.finished()) { return null; }
    if (interface_hash is .some(cached) && cached != qkey.Fingerprint128()) {
        module_interface.interface_hash = cached;
    } else {
        module_interface.interface_hash =
            module_interface_fingerprint(ctx, module_interface$.ref());
    }
    if (public_interface_hash is .some(cached) && cached != qkey.Fingerprint128()) {
        module_interface.public_interface_hash = cached;
    } else {
        module_interface.public_interface_hash =
            module_public_interface_fingerprint(ctx, module_interface$.ref());
    }
    module_interface.public_extension_hash =
        module_public_extension_fingerprint(ctx, module_interface$.ref());
    return module_interface;
}

public Bool decode_generic_templates_section(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    UInt8[]& bytes
) {
    SourceSectionReader reader! = SourceSectionReader(bytes);
    if (!reader.read_magic("jiang.generic-templates.v2")) {
        return false;
    }
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        if (!read_generic_template(ctx, reader$.ref(), module_interface)) {
            return false;
        }
        index = index + 1;
    }
    return reader.finished();
}

public qkey.Fingerprint128 module_interface_fingerprint(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    writer.write_bytes("jiang.package-interface.v1");
    write_symbol_text(ctx, writer$.ref(), module_interface.package_name);
    write_symbol_text(ctx, writer$.ref(), module_interface.module_path);
    write_package_surface_declarations(ctx, writer$.ref(), module_interface);
    write_public_imports(ctx, writer$.ref(), module_interface);
    write_public_aliases(ctx, writer$.ref(), module_interface);
    write_extension_groups(ctx, writer$.ref(), module_interface, false);
    return writer.finish();
}

public qkey.Fingerprint128 module_public_interface_fingerprint(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    writer.write_bytes("jiang.public-interface.v1");
    write_symbol_text(ctx, writer$.ref(), module_interface.package_name);
    write_symbol_text(ctx, writer$.ref(), module_interface.module_path);
    write_public_surface_declarations(ctx, writer$.ref(), module_interface);
    write_public_imports(ctx, writer$.ref(), module_interface);
    write_public_aliases(ctx, writer$.ref(), module_interface);
    write_extension_groups(ctx, writer$.ref(), module_interface, true);
    return writer.finish();
}

public qkey.Fingerprint128 module_public_extension_fingerprint(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
    SourceSectionWriter writer! = SourceSectionWriter(bytes$.ref());
    writer.write_bytes("jiang.public-extension-surface.v1");
    write_extension_groups(ctx, writer$.ref(), module_interface, true);
    return writer.finish();
}

@region(a)
struct SourceSectionWriter: Movable {
    @life(a)
    list.ArrayList<UInt8>& bytes;
    init(self, list.ArrayList<UInt8>& bytes) {
        self.bytes = bytes;
    }

    Void write_bytes(self, UInt8[]& data) {
        Int index! = 0;
        while (index < data.length) {
            self.bytes.add(data[index]);
            index = index + 1;
        }
    }

    Void write_bool(self, Bool value) {
        if (value) {
            self.bytes.add(1);
            return;
        }
        self.bytes.add(0);
    }

    Void write_int(self, Int value) {
        self.write_uint64(UInt64(value));
    }

    Void write_uint64(self, UInt64 value) {
        UInt64 current! = value;
        Int index! = 0;
        while (index < 8) {
            self.bytes.add(UInt8(current & 255));
            current = current >> 8;
            index = index + 1;
        }
    }

    qkey.Fingerprint128 finish(self) {
        blake3.Blake3Hash digest = blake3.blake3_hash(self.bytes.slice());
        return qkey.Fingerprint128(digest.a, digest.b);
    }
}

@region(a)
struct SourceSectionReader: Copyable {
    @life(a)
    UInt8[]& bytes;
    Int offset!;

    init(self, UInt8[]& bytes) {
        self.bytes = bytes;
        self.offset = 0;
    }

    Bool finished(self) {
        return self.offset == self.bytes.length;
    }

    Bool read_magic(self, UInt8[]& text) {
        guard self.read_bytes(text.length) is .some(bytes) else { return false; }
        return bytes_equal(bytes, text);
    }

    Int? read_int(self) {
        guard self.read_uint64() is .some(value) else { return null; }
        return Int(value);
    }

    UInt64? read_uint64(self) {
        guard self.read_bytes(8) is .some(bytes) else { return null; }
        UInt64 value! = 0;
        Int index! = 7;
        while (index >= 0) {
            value = value << 8;
            value = value | UInt64(bytes[index]);
            index = index - 1;
        }
        return value;
    }

    qkey.StableSymbolId? read_stable_id(self) {
        guard self.read_uint64() is .some(low) else { return null; }
        guard self.read_uint64() is .some(high) else { return null; }
        return qkey.StableSymbolId(low, high);
    }

    qkey.Fingerprint128? read_fingerprint(self) {
        guard self.read_uint64() is .some(low) else { return null; }
        guard self.read_uint64() is .some(high) else { return null; }
        return qkey.Fingerprint128(low, high);
    }

    UInt8[]&? read_bytes(self, Int length) {
        if (length < 0) {
            return null;
        }
        if (self.offset + length > self.bytes.length) {
            return null;
        }
        Int start = self.offset;
        self.offset = self.offset + length;
        return self.bytes[start..self.offset];
    }

    UInt8[]&? read_bytes_with_length(self) {
        guard self.read_int() is .some(length) else { return null; }
        return self.read_bytes(length);
    }

    qid.SymbolId? read_symbol(self, context.CompilerContext& ctx) {
        guard self.read_int() is .some(length) else { return null; }
        guard self.read_bytes(length) is .some(text) else { return null; }
        return ctx.store.symbols.intern(text);
    }

    qid.SymbolId? read_optional_symbol(self, context.CompilerContext& ctx) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_symbol(ctx);
    }

    qkey.StableSymbolId? read_optional_stable_id(self) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_stable_id();
    }

    qkey.Fingerprint128? read_optional_fingerprint(self) {
        guard self.read_bool() is .some(has_value) else { return null; }
        if (!has_value) {
            return null;
        }
        return self.read_fingerprint();
    }

    Bool? read_bool(self) {
        guard self.read_bytes(1) is .some(bytes) else { return null; }
        return bytes[0] != 0;
    }
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool read_import_entries(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ImportSummary& summary
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_import_entry(ctx, reader) is .some(entry) else { return false; }
        summary.add_import(entry);
        index = index + 1;
    }
    return true;
}

Bool read_alias_entries(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ImportSummary& summary
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_alias_entry(ctx, reader) is .some(alias_export) else { return false; }
        summary.add_public_alias(alias_export);
        index = index + 1;
    }
    return true;
}

source_artifact.ImportSummaryEntry? read_import_entry(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    guard reader.read_int() is .some(kind_value) else { return null; }
    guard reader.read_int() is .some(visibility_value) else { return null; }
    guard reader.read_int() is .some(flatten_value) else { return null; }
    guard reader.read_symbol(ctx) is .some(path_symbol) else { return null; }
    qid.SymbolId? alias_symbol = reader.read_optional_symbol(ctx);
    qkey.Fingerprint128? target_source_identity = reader.read_optional_fingerprint();
    return source_artifact.ImportSummaryEntry(
        import_kind_from_int(kind_value),
        visibility_from_int(visibility_value),
        flatten_value != 0,
        path_symbol,
        alias_symbol,
        target_source_identity
    );
}

source_artifact.AliasExportSummary? read_alias_entry(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    guard reader.read_symbol(ctx) is .some(alias_symbol) else { return null; }
    guard reader.read_stable_id() is .some(target_stable_id) else { return null; }
    return source_artifact.AliasExportSummary(alias_symbol, target_stable_id);
}

Bool read_interface_declarations(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_interface_declaration(ctx, reader, module_interface) is .some(decl) else { return false; }
        module_interface.add_declaration(decl);
        index = index + 1;
    }
    return true;
}

source_artifact.InterfaceDeclSummary? read_interface_declaration(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_stable_id() is .some(stable_id) else { return null; }
    guard reader.read_int() is .some(kind_value) else { return null; }
    guard reader.read_int() is .some(domain_value) else { return null; }
    guard reader.read_int() is .some(visibility_value) else { return null; }
    guard reader.read_symbol(ctx) is .some(name) else { return null; }
    qkey.StableSymbolId? owner = reader.read_optional_stable_id();
    qkey.Fingerprint128? disambiguator = reader.read_optional_fingerprint();
    guard reader.read_fingerprint() is .some(signature_fingerprint) else { return null; }
    guard reader.read_fingerprint() is .some(body_fingerprint) else { return null; }
    guard reader.read_bool() is .some(mutable_binding) else { return null; }
    guard reader.read_bool() is .some(is_const) else { return null; }
    guard reader.read_bool() is .some(is_external) else { return null; }
    guard reader.read_int() is .some(extern_kind) else { return null; }
    guard reader.read_int() is .some(inline_mode) else { return null; }
    guard reader.read_bool() is .some(naked) else { return null; }
    qid.SymbolId? link_symbol = reader.read_optional_symbol(ctx);

    source_artifact.InterfaceDeclSummary decl! = source_artifact.InterfaceDeclSummary(
        stable_id,
        def_kind_from_int(kind_value),
        domain_from_int(domain_value),
        visibility_from_int(visibility_value),
        name,
        owner
    );
    decl.disambiguator = disambiguator;
    decl.signature_fingerprint = signature_fingerprint;
    decl.body_fingerprint = body_fingerprint;
    decl.mutable_binding = mutable_binding;
    decl.is_const = is_const;
    decl.is_external = is_external;
    decl.extern_kind = extern_kind;
    decl.inline_mode = inline_mode;
    decl.naked = naked;
    decl.link_symbol = link_symbol;
    guard reader.read_bool() is .some(has_explicit_empty_lifetime_contract) else { return null; }
    decl.has_explicit_empty_lifetime_contract = has_explicit_empty_lifetime_contract;
    guard reader.read_bool() is .some(has_type_ref) else { return null; }
    if (has_type_ref) {
        guard read_type_ref(ctx, reader) is .some(type_ref) else { return null; }
        module_interface.set_decl_type_ref(stable_id, type_ref);
    }
    if (!read_trait_refs(ctx, reader, module_interface, stable_id)) {
        return null;
    }
    if (!read_where_predicates(ctx, reader, module_interface, stable_id)) {
        return null;
    }
    if (!read_lifetime_constraints(ctx, reader, module_interface, stable_id)) {
        return null;
    }
    if (!read_region_schema(ctx, reader, module_interface, stable_id)) { return null; }
    if (!read_life_clauses(ctx, reader, module_interface, stable_id)) { return null; }
    guard reader.read_bool() is .some(has_signature) else { return null; }
    if (has_signature && !read_function_signature(ctx, reader, module_interface, stable_id)) {
        return null;
    }
    guard reader.read_bool() is .some(has_field_default) else { return null; }
    if (has_field_default) {
        guard reader.read_bytes_with_length() is .some(payload) else { return null; }
        module_interface.set_field_default(stable_id, payload);
    }
    guard reader.read_bool() is .some(has_const_value) else { return null; }
    if (has_const_value) {
        guard read_const_value(ctx, reader) is .some(const_value) else { return null; }
        module_interface.set_const_value(stable_id, const_value);
    }
    return decl;
}

Bool read_trait_refs(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_bool() is .some(negative) else { return false; }
        guard read_type_ref(ctx, reader) is .some(trait_ref) else { return false; }
        if (negative) {
            module_interface.add_negative_trait_ref(stable_id, trait_ref);
        } else {
            module_interface.add_trait_ref(stable_id, trait_ref);
        }
        index = index + 1;
    }
    return true;
}

Bool read_where_predicates(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        if (!read_where_predicate(ctx, reader, module_interface, stable_id)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool read_where_predicate(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard read_where_predicate_value(ctx, reader, module_interface)
        is .some(predicate) else {
        return false;
    }
    module_interface.add_where_predicate(stable_id, predicate);
    return true;
}

source_artifact.InterfaceWherePredicate? read_where_predicate_value(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(kind_value) else { return null; }
    guard read_type_ref(ctx, reader) is .some(subject) else { return null; }
    guard read_type_ref(ctx, reader) is .some(bound_or_value) else { return null; }
    guard read_type_ref(ctx, reader) is .some(trait_ref) else { return null; }
    qid.SymbolId? assoc_symbol = reader.read_optional_symbol(ctx);
    source_artifact.InterfaceWherePredicateKind kind = where_predicate_kind_from_int(kind_value);
    if (kind == .projection_equal && assoc_symbol == null) {
        return null;
    }
    source_artifact.InterfaceWherePredicate predicate! =
        source_artifact.InterfaceWherePredicate(kind);
    predicate.subject_index = module_interface.add_where_type_ref(subject);
    predicate.bound_or_value_index = module_interface.add_where_type_ref(bound_or_value);
    predicate.trait_ref_index = module_interface.add_where_type_ref(trait_ref);
    predicate.assoc_symbol = assoc_symbol;
    return predicate;
}

Bool read_lifetime_constraints(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_lifetime_constraint(ctx, reader, module_interface, stable_id)
            is .some(constraint) else {
            return false;
        }
        module_interface.add_lifetime_constraint(constraint);
        index = index + 1;
    }
    return true;
}

Bool read_region_schema(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_int() is .some(name_count) else { return false; }
    Int index! = 0;
    while (index < name_count) {
        guard reader.read_symbol(ctx) is .some(symbol) else { return false; }
        module_interface.add_region_name(source_artifact.InterfaceRegionName (
            owner_stable_id: stable_id,
            symbol: symbol
        ));
        index = index + 1;
    }
    guard reader.read_int() is .some(constraint_count) else { return false; }
    index = 0;
    while (index < constraint_count) {
        guard reader.read_symbol(ctx) is .some(target) else { return false; }
        guard reader.read_symbol(ctx) is .some(source) else { return false; }
        module_interface.add_region_constraint(source_artifact.InterfaceRegionConstraint (
            owner_stable_id: stable_id,
            target: target,
            source: source
        ));
        index = index + 1;
    }
    return true;
}

Bool read_life_clauses(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_bool() is .some(has_target) else { return false; }
        source_artifact.InterfaceLifetimeName? target! = null;
        if (has_target) {
            guard read_lifetime_name(ctx, reader, module_interface) is .some(value) else {
                return false;
            }
            target = value;
        }
        guard reader.read_bool() is .some(has_source_expression) else { return false; }
        source_artifact.InterfaceLifetimeName source! =
            source_artifact.InterfaceLifetimeName(0, null);
        Int source_expression! = 0;
        if (has_source_expression) {
            guard read_lifetime_expression(ctx, reader, module_interface)
                is .some(expression) else {
                return false;
            }
            source_expression = expression;
        } else {
            guard read_lifetime_name(ctx, reader, module_interface)
                is .some(source_name) else {
                return false;
            }
            source = source_name;
        }
        module_interface.add_life_clause(source_artifact.InterfaceLifeClause (
            owner_stable_id: stable_id,
            target: target,
            source: source,
            source_expression: source_expression
        ));
        index = index + 1;
    }
    return true;
}

Int? read_lifetime_expression(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(kind) else { return null; }
    if (kind == 0) {
        guard read_lifetime_name(ctx, reader, module_interface)
            is .some(name) else {
            return null;
        }
        return module_interface.add_lifetime_expression(
            source_artifact.InterfaceLifetimeExpression (
                kind: kind,
                name: name,
                left: 0,
                right: 0
            )
        );
    }
    guard read_lifetime_expression(ctx, reader, module_interface)
        is .some(left) else {
        return null;
    }
    guard read_lifetime_expression(ctx, reader, module_interface)
        is .some(right) else {
        return null;
    }
    return module_interface.add_lifetime_expression(
        source_artifact.InterfaceLifetimeExpression (
            kind: kind,
            name: source_artifact.InterfaceLifetimeName(0, null),
            left: left,
            right: right
        )
    );
}

source_artifact.InterfaceLifetimeConstraint? read_lifetime_constraint(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard read_lifetime_name(ctx, reader, module_interface) is .some(longer) else { return null; }
    guard read_lifetime_name(ctx, reader, module_interface) is .some(shorter) else { return null; }
    guard reader.read_int() is .some(relation) else { return null; }
    return source_artifact.InterfaceLifetimeConstraint(stable_id, longer, shorter, relation);
}

source_artifact.InterfaceLifetimeName? read_lifetime_name(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(kind) else { return null; }
    qid.SymbolId? symbol = reader.read_optional_symbol(ctx);
    guard reader.read_int() is .some(projection_count) else { return null; }
    Int projection_path! = 0;
    Int index! = 0;
    while (index < projection_count) {
        guard read_lifetime_projection(ctx, reader, projection_path)
            is .some(projection) else {
            return null;
        }
        projection_path = module_interface.add_lifetime_path_node(projection);
        index = index + 1;
    }
    return source_artifact.InterfaceLifetimeName(kind, symbol, projection_path);
}

source_artifact.InterfaceLifetimePathNode? read_lifetime_projection(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    Int parent
) {
    guard reader.read_int() is .some(kind) else { return null; }
    qid.SymbolId? symbol = reader.read_optional_symbol(ctx);
    qkey.StableSymbolId? field_stable_id = reader.read_optional_stable_id();
    guard reader.read_int() is .some(tuple_index) else { return null; }
    return source_artifact.InterfaceLifetimePathNode (
        parent: parent,
        kind: kind,
        symbol: symbol,
        field_stable_id: field_stable_id,
        tuple_index: tuple_index
    );
}

Bool read_function_signature(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    guard reader.read_bool() is .some(has_receiver) else { return false; }
    guard reader.read_int() is .some(receiver_mode) else { return false; }
    guard reader.read_bool() is .some(has_unsafe) else { return false; }
    guard reader.read_bool() is .some(has_async) else { return false; }
    qkey.StableSymbolId? domain_stable_id = reader.read_optional_stable_id();
    guard reader.read_int() is .some(exclusive_count) else { return false; }
    source_artifact.InterfaceFunctionSignature signature! =
        source_artifact.InterfaceFunctionSignature(has_receiver, source_artifact.InterfaceTypeRef.invalid_type());
    signature.receiver_mode = receiver_mode;
    signature.has_unsafe = has_unsafe;
    signature.has_async = has_async;
    signature.domain_stable_id = domain_stable_id;
    Int index! = 0;
    while (index < exclusive_count) {
        guard reader.read_symbol(ctx) is .some(symbol) else { return false; }
        signature.exclusive_symbols.add(symbol);
        index = index + 1;
    }
    guard reader.read_int() is .some(param_count) else { return false; }
    index = 0;
    while (index < param_count) {
        guard read_signature_param(ctx, reader) is .some(param) else { return false; }
        signature.add_param(param);
        index = index + 1;
    }
    if (!read_param_defaults(ctx, reader, signature$.ref())) {
        return false;
    }
    guard read_type_ref(ctx, reader) is .some(result) else { return false; }
    signature.set_result_ref(result$.ref());
    module_interface.set_function_signature(stable_id, signature);
    return true;
}

@life(return: ctx)
source_artifact.InterfaceConstValue? read_const_value(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    guard reader.read_int() is .some(kind_value) else { return null; }
    source_artifact.InterfaceConstValueKind kind = const_value_kind_from_int(kind_value);
    // Const value section 只保存 payload。跨 module 的声明类型来自同一
    // declaration 的 decl_type_ref，不能在这里重复编码 TypeId 或 type ref。
    if (kind == .unit_value) {
        return source_artifact.InterfaceConstValue(data: .unit_value());
    }
    if (kind == .bool_value) {
        guard reader.read_bool() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .bool_value(value));
    }
    if (kind == .int_value) {
        guard reader.read_int() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .int_value(value));
    }
    if (kind == .uint_value) {
        guard reader.read_uint64() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .uint_value(value));
    }
    if (kind == .char_value) {
        guard reader.read_uint64() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .char_value(value));
    }
    if (kind == .float_value) {
        guard reader.read_uint64() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .float_bits(value));
    }
    if (kind == .string_value) {
        guard reader.read_bytes_with_length() is .some(value) else { return null; }
        qid.SymbolId symbol = ctx.store.symbols.intern(value);
        return source_artifact.InterfaceConstValue(data: .string_value(ctx.store.symbols.text(symbol)));
    }
    if (kind == .symbol_value) {
        guard reader.read_symbol(ctx) is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .symbol_value(value));
    }
    if (kind == .enum_case_value) {
        guard reader.read_stable_id() is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .enum_case_value(value));
    }
    if (kind == .struct_value) {
        guard read_const_fields(ctx, reader) is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .struct_value(value));
    }
    if (kind == .tuple_value) {
        guard read_const_values(ctx, reader) is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .tuple_value(value));
    }
    if (kind == .array_value) {
        guard read_const_values(ctx, reader) is .some(value) else { return null; }
        return source_artifact.InterfaceConstValue(data: .array_value(value));
    }
    return null;
}

@life()
source_artifact.InterfaceConstFieldValue[]&? read_const_fields(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    unsafe {
        guard reader.read_int() is .some(count) else { return null; }
        source_artifact.InterfaceConstFieldValue*! values = unsafe {
            source_artifact.InterfaceConstFieldValue$.alloc(count)
        };
        Int index! = 0;
        while (index < count) {
            guard reader.read_stable_id() is .some(field_stable_id) else { return null; }
            guard read_const_value(ctx, reader) is .some(value) else { return null; }
            values[index] = source_artifact.InterfaceConstFieldValue(
                field_stable_id: field_stable_id,
                value: value
            );
            index = index + 1;
        }
        return values[0..count];
    }
}

@life()
source_artifact.InterfaceConstValue[]&? read_const_values(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    unsafe {
        guard reader.read_int() is .some(count) else { return null; }
        source_artifact.InterfaceConstValue*! values = unsafe {
            source_artifact.InterfaceConstValue$.alloc(count)
        };
        Int index! = 0;
        while (index < count) {
            guard read_const_value(ctx, reader) is .some(value) else { return null; }
            values[index] = value;
            index = index + 1;
        }
        return values[0..count];
    }
}

source_artifact.InterfaceConstValueKind const_value_kind_from_int(Int value) {
    if (value == Int(source_artifact.InterfaceConstValueKind.unit_value)) {
        return .unit_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.bool_value)) {
        return .bool_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.int_value)) {
        return .int_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.uint_value)) {
        return .uint_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.char_value)) {
        return .char_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.float_value)) {
        return .float_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.string_value)) {
        return .string_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.symbol_value)) {
        return .symbol_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.enum_case_value)) {
        return .enum_case_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.struct_value)) {
        return .struct_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.tuple_value)) {
        return .tuple_value;
    }
    if (value == Int(source_artifact.InterfaceConstValueKind.array_value)) {
        return .array_value;
    }
    return .invalid;
}

source_artifact.InterfaceParamSummary? read_signature_param(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    guard reader.read_symbol(ctx) is .some(symbol) else { return null; }
    guard read_type_ref(ctx, reader) is .some(type_ref) else { return null; }
    return source_artifact.InterfaceParamSummary(symbol, type_ref);
}

Bool read_param_defaults(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.InterfaceFunctionSignature& signature
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_int() is .some(param_index) else { return false; }
        guard read_literal(ctx, reader) is .some(value) else { return false; }
        signature.add_param_default(source_artifact.InterfaceParamDefault(param_index, value));
        index = index + 1;
    }
    return true;
}

source_artifact.InterfaceLiteral? read_literal(context.CompilerContext& ctx, SourceSectionReader& reader) {
    guard reader.read_int() is .some(kind_value) else { return null; }
    source_artifact.InterfaceLiteral literal! = source_artifact.InterfaceLiteral(literal_kind_from_int(kind_value));
    guard reader.read_uint64() is .some(int_bits) else { return null; }
    guard reader.read_bool() is .some(signed_int) else { return null; }
    guard reader.read_uint64() is .some(float_bits) else { return null; }
    guard reader.read_bool() is .some(bool_value) else { return null; }
    qid.SymbolId? string_symbol = reader.read_optional_symbol(ctx);
    guard reader.read_uint64() is .some(char_value) else { return null; }
    literal.int_bits = int_bits;
    literal.signed_int = signed_int;
    literal.float_value = float64_from_bits(float_bits);
    literal.bool_value = bool_value;
    literal.string_symbol = string_symbol;
    literal.char_value = UInt32(char_value);
    return literal;
}

source_artifact.InterfaceTypeRef? read_type_ref(
    context.CompilerContext& ctx,
    SourceSectionReader& reader
) {
    guard reader.read_int() is .some(kind_value) else { return null; }
    qkey.StableSymbolId? stable_def = reader.read_optional_stable_id();
    guard reader.read_int() is .some(count_kind) else { return null; }
    guard reader.read_uint64() is .some(count_value) else { return null; }
    guard reader.read_int() is .some(sentinel_kind) else { return null; }
    guard reader.read_uint64() is .some(sentinel_value) else { return null; }
    guard reader.read_int() is .some(arg_count) else { return null; }
    source_artifact.InterfaceTypeRef type_ref! =
        source_artifact.InterfaceTypeRef(type_ref_kind_from_int(kind_value));
    type_ref.kind_tag = kind_value;
    if (stable_def is .some(stable_id)) {
        type_ref.has_stable_def = true;
        type_ref.stable_def_low = stable_id.low;
        type_ref.stable_def_high = stable_id.high;
    }
    type_ref.count_kind = count_kind;
    type_ref.count_value = count_value;
    type_ref.sentinel_kind = sentinel_kind;
    type_ref.sentinel_value = sentinel_value;
    Int index! = 0;
    while (index < arg_count) {
        guard read_type_ref(ctx, reader) is .some(arg) else { return null; }
        type_ref.add_arg(arg);
        index = index + 1;
    }
    guard reader.read_int() is .some(contract_name_count) else { return null; }
    index = 0;
    while (index < contract_name_count) {
        guard reader.read_bytes_with_length() is .some(name) else { return null; }
        qid.SymbolId symbol = ctx.store.symbols.intern(name);
        type_ref.add_contract_name(ctx.store.symbols.text(symbol));
        index = index + 1;
    }
    return type_ref;
}

Bool read_interface_imports(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_import_entry(ctx, reader) is .some(entry) else { return false; }
        module_interface.add_public_import(entry);
        index = index + 1;
    }
    return true;
}

Bool read_interface_aliases(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_alias_entry(ctx, reader) is .some(alias_export) else { return false; }
        module_interface.add_public_alias(alias_export);
        index = index + 1;
    }
    return true;
}

Bool read_extension_groups(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_extension_group(ctx, reader, module_interface) is .some(group) else {
            return false;
        }
        module_interface.add_extension_group(group);
        index = index + 1;
    }
    return true;
}

source_artifact.InterfaceExtensionGroup? read_extension_group(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_stable_id() is .some(target_owner) else { return null; }
    guard reader.read_stable_id() is .some(binding_owner) else { return null; }
    guard reader.read_bool() is .some(public_flag) else { return null; }
    source_artifact.InterfaceExtensionGroup group! =
        source_artifact.InterfaceExtensionGroup(target_owner, binding_owner, public_flag);
    guard reader.read_bool() is .some(has_trait_ref) else { return null; }
    if (has_trait_ref) {
        guard read_type_ref(ctx, reader) is .some(trait_ref) else { return null; }
        group.trait_ref = trait_ref;
    }
    if (!read_extension_where_predicates(ctx, reader, module_interface, group$.ref())) {
        return null;
    }
    if (!read_extension_constraints(ctx, reader, group$.ref())) { return null; }
    if (!read_extension_members(reader, group$.ref())) { return null; }
    return group;
}

Bool read_extension_where_predicates(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceExtensionGroup& group
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard read_where_predicate_value(ctx, reader, module_interface)
            is .some(predicate) else {
            return false;
        }
        group.where_predicates.add(predicate);
        index = index + 1;
    }
    return true;
}

Bool read_extension_constraints(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.InterfaceExtensionGroup& group
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_stable_id() is .some(param_stable_id) else { return false; }
        guard read_type_ref(ctx, reader) is .some(type_ref) else { return false; }
        group.generic_constraints.add(source_artifact.InterfaceExtensionConstraint(
            param_stable_id,
            type_ref
        ));
        index = index + 1;
    }
    return true;
}

Bool read_extension_members(
    SourceSectionReader& reader,
    source_artifact.InterfaceExtensionGroup& group
) {
    guard reader.read_int() is .some(count) else { return false; }
    Int index! = 0;
    while (index < count) {
        guard reader.read_stable_id() is .some(member) else { return false; }
        group.members.add(member);
        index = index + 1;
    }
    return true;
}

store.ImportKind import_kind_from_int(Int value) {
    store.ImportKind package_import = .package_import;
    store.ImportKind module_import = .module_import;
    if (value == Int(package_import)) { return .package_import; }
    if (value == Int(module_import)) { return .module_import; }
    return .file_import;
}

def.Visibility visibility_from_int(Int value) {
    def.Visibility public_visibility = .public_visibility;
    if (value == Int(public_visibility)) { return .public_visibility; }
    return .private_visibility;
}

def.NameDomain domain_from_int(Int value) {
    def.NameDomain value_name = .value_name;
    def.NameDomain member_name = .member_name;
    def.NameDomain label_name = .label_name;
    def.NameDomain namespace_name = .namespace_name;
    if (value == Int(value_name)) { return .value_name; }
    if (value == Int(member_name)) { return .member_name; }
    if (value == Int(label_name)) { return .label_name; }
    if (value == Int(namespace_name)) { return .namespace_name; }
    return .type_name;
}

def.DefKind def_kind_from_int(Int value) {
    def.DefKind package_def = .package_def;
    def.DefKind module_def = .module_def;
    def.DefKind import_alias_def = .import_alias_def;
    def.DefKind alias_def = .alias_def;
    def.DefKind extension_def = .extension_def;
    def.DefKind struct_def = .struct_def;
    def.DefKind enum_def = .enum_def;
    def.DefKind union_def = .union_def;
    def.DefKind trait_def = .trait_def;
    def.DefKind trait_companion_type_def = .trait_companion_type_def;
    def.DefKind function_def = .function_def;
    def.DefKind init_def = .init_def;
    def.DefKind deinit_def = .deinit_def;
    def.DefKind global_def = .global_def;
    def.DefKind field_def = .field_def;
    def.DefKind enum_case_def = .enum_case_def;
    def.DefKind union_variant_def = .union_variant_def;
    def.DefKind associated_type_def = .associated_type_def;
    def.DefKind generic_param_def = .generic_param_def;
    def.DefKind parameter_def = .parameter_def;
    def.DefKind local_def = .local_def;
    def.DefKind builtin_type_def = .builtin_type_def;
    def.DefKind builtin_value_def = .builtin_value_def;
    def.DefKind error_def = .error_def;
    if (value == Int(package_def)) { return .package_def; }
    if (value == Int(module_def)) { return .module_def; }
    if (value == Int(import_alias_def)) { return .import_alias_def; }
    if (value == Int(alias_def)) { return .alias_def; }
    if (value == Int(extension_def)) { return .extension_def; }
    if (value == Int(struct_def)) { return .struct_def; }
    if (value == Int(enum_def)) { return .enum_def; }
    if (value == Int(union_def)) { return .union_def; }
    if (value == Int(trait_def)) { return .trait_def; }
    if (value == Int(trait_companion_type_def)) { return .trait_companion_type_def; }
    if (value == Int(function_def)) { return .function_def; }
    if (value == Int(init_def)) { return .init_def; }
    if (value == Int(deinit_def)) { return .deinit_def; }
    if (value == Int(global_def)) { return .global_def; }
    if (value == Int(field_def)) { return .field_def; }
    if (value == Int(enum_case_def)) { return .enum_case_def; }
    if (value == Int(union_variant_def)) { return .union_variant_def; }
    if (value == Int(associated_type_def)) { return .associated_type_def; }
    if (value == Int(generic_param_def)) { return .generic_param_def; }
    if (value == Int(parameter_def)) { return .parameter_def; }
    if (value == Int(local_def)) { return .local_def; }
    if (value == Int(builtin_type_def)) { return .builtin_type_def; }
    if (value == Int(builtin_value_def)) { return .builtin_value_def; }
    if (value == Int(error_def)) { return .error_def; }
    return .error_def;
}

source_artifact.InterfaceTypeRefKind type_ref_kind_from_int(Int value) {
    return source_artifact.type_ref_kind_from_value(value);
}

source_artifact.InterfaceWherePredicateKind where_predicate_kind_from_int(Int value) {
    source_artifact.InterfaceWherePredicateKind type_bound = .type_bound;
    source_artifact.InterfaceWherePredicateKind negative_type_bound = .negative_type_bound;
    source_artifact.InterfaceWherePredicateKind type_equal = .type_equal;
    source_artifact.InterfaceWherePredicateKind type_not_equal = .type_not_equal;
    source_artifact.InterfaceWherePredicateKind projection_equal = .projection_equal;
    source_artifact.InterfaceWherePredicateKind const_type = .const_type;
    if (value == Int(type_bound)) { return .type_bound; }
    if (value == Int(negative_type_bound)) { return .negative_type_bound; }
    if (value == Int(type_equal)) { return .type_equal; }
    if (value == Int(type_not_equal)) { return .type_not_equal; }
    if (value == Int(projection_equal)) { return .projection_equal; }
    if (value == Int(const_type)) { return .const_type; }
    return .type_bound;
}

source_artifact.InterfaceLiteralKind literal_kind_from_int(Int value) {
    source_artifact.InterfaceLiteralKind int_value = .int_value;
    source_artifact.InterfaceLiteralKind float_value = .float_value;
    source_artifact.InterfaceLiteralKind bool_value = .bool_value;
    source_artifact.InterfaceLiteralKind string_value = .string_value;
    source_artifact.InterfaceLiteralKind char_value = .char_value;
    source_artifact.InterfaceLiteralKind null_value = .null_value;
    source_artifact.InterfaceLiteralKind unit_value = .unit_value;
    if (value == Int(int_value)) { return .int_value; }
    if (value == Int(float_value)) { return .float_value; }
    if (value == Int(bool_value)) { return .bool_value; }
    if (value == Int(string_value)) { return .string_value; }
    if (value == Int(char_value)) { return .char_value; }
    if (value == Int(null_value)) { return .null_value; }
    if (value == Int(unit_value)) { return .unit_value; }
    return .invalid_literal;
}

Void write_import_summary(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ImportSummary& summary
) {
    writer.write_bytes("jiang.import-summary.v2");
    writer.write_uint64(summary.source_hash);
    writer.write_int(summary.source_revision);
    write_fingerprint(writer, summary.import_context_fingerprint);
    write_symbol_text(ctx, writer, summary.package_name);
    write_symbol_text(ctx, writer, summary.module_path);
    write_symbol_text(ctx, writer, summary.source_path);
    write_summary_imports(ctx, writer, summary);
    write_summary_public_aliases(ctx, writer, summary);
}

Void write_module_interface(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    writer.write_bytes("jiang.interface.v15");
    write_symbol_text(ctx, writer, module_interface.package_name);
    write_symbol_text(ctx, writer, module_interface.module_path);
    write_declarations(ctx, writer, module_interface);
    write_public_imports(ctx, writer, module_interface);
    write_public_aliases(ctx, writer, module_interface);
    write_extension_groups(ctx, writer, module_interface, false);
}

Void write_generic_templates(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    writer.write_bytes("jiang.generic-templates.v2");
    writer.write_int(module_interface.generic_templates.len());
    Int index! = 0;
    while (index < module_interface.generic_templates.len()) {
        source_artifact.GenericTemplate& generic_template = module_interface.generic_templates.ref_at(index);
        write_stable_id(writer, generic_template.owner_stable_id);
        write_fingerprint(writer, generic_template.body_fingerprint);
        write_bytes_with_length(writer, generic_template.payload.slice());
        index = index + 1;
    }
}

Bool read_generic_template(
    context.CompilerContext& ctx,
    SourceSectionReader& reader,
    source_artifact.ModuleInterface& module_interface
) {
    guard reader.read_stable_id() is .some(owner_stable_id) else { return false; }
    guard reader.read_fingerprint() is .some(body_fingerprint) else { return false; }
    guard reader.read_bytes_with_length() is .some(payload) else { return false; }
    module_interface.add_generic_template(source_artifact.GenericTemplate(
        owner_stable_id,
        body_fingerprint,
        payload
    ));
    return true;
}

Void write_declarations(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    writer.write_int(module_interface.declarations.len());
    list.ArrayList<Int> indexes = sorted_declaration_indexes(module_interface);
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        source_artifact.InterfaceDeclSummary decl = module_interface.declarations.get(indexes.get(index));
        write_declaration(ctx, writer, module_interface, decl, true);
        index = index + 1;
    }
}

Void write_package_surface_declarations(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<Int> indexes = sorted_declaration_indexes(module_interface);
    writer.write_int(indexes.len());
    Int index! = 0;
    while (index < indexes.len()) {
        source_artifact.InterfaceDeclSummary decl = module_interface.declarations.get(indexes.get(index));
        write_declaration(ctx, writer, module_interface, decl, false);
        index = index + 1;
    }
}

Void write_public_surface_declarations(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<Int> indexes = sorted_declaration_indexes(module_interface);
    writer.write_int(public_surface_declaration_count(module_interface));
    Int index! = 0;
    while (index < indexes.len()) {
        source_artifact.InterfaceDeclSummary decl = module_interface.declarations.get(indexes.get(index));
        if (declaration_is_public_surface(module_interface, decl)) {
            write_declaration(ctx, writer, module_interface, decl, false);
        }
        index = index + 1;
    }
}

Int public_surface_declaration_count(source_artifact.ModuleInterface& module_interface) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        if (declaration_is_public_surface(
            module_interface,
            module_interface.declarations.get(index)
        )) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Bool declaration_is_public_surface(
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary declaration
) {
    source_artifact.InterfaceDeclSummary current! = declaration;
    Int depth! = 0;
    while (current.owner is .some(owner) && depth < module_interface.declarations.len()) {
        guard declaration_with_id(module_interface, owner) is .some(parent) else {
            return false;
        }
        current = parent;
        depth = depth + 1;
    }
    return current.visibility == .public_visibility;
}

source_artifact.InterfaceDeclSummary? declaration_with_id(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        source_artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.stable_id == stable_id) { return declaration; }
        index = index + 1;
    }
    return null;
}

Void write_declaration(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary decl,
    Bool persist_body_fingerprint
) {
    write_stable_id(writer, decl.stable_id);
    writer.write_int(Int(decl.kind));
    writer.write_int(Int(decl.domain));
    writer.write_int(Int(decl.visibility));
    write_symbol_text(ctx, writer, decl.name);
    write_optional_stable_id(writer, decl.owner);
    write_optional_fingerprint(writer, decl.disambiguator);
    write_fingerprint(writer, decl.signature_fingerprint);
    write_fingerprint(
        writer,
        declaration_body_fingerprint(module_interface, decl, persist_body_fingerprint)
    );
    writer.write_bool(decl.mutable_binding);
    writer.write_bool(decl.is_const);
    writer.write_bool(decl.is_external);
    writer.write_int(decl.extern_kind);
    writer.write_int(decl.inline_mode);
    writer.write_bool(decl.naked);
    write_optional_symbol_text(ctx, writer, decl.link_symbol);
    writer.write_bool(decl.has_explicit_empty_lifetime_contract);
    write_decl_type_ref(writer, module_interface, decl.stable_id);
    write_trait_refs(writer, module_interface, decl.stable_id);
    write_where_predicates(ctx, writer, module_interface, decl.stable_id);
    write_lifetime_constraints(ctx, writer, module_interface, decl.stable_id);
    write_region_schema(ctx, writer, module_interface, decl.stable_id);
    write_life_clauses(ctx, writer, module_interface, decl.stable_id);
    write_function_signature(ctx, writer, module_interface, decl.stable_id);
    write_field_default(writer, module_interface, decl.stable_id);
    write_const_value(ctx, writer, module_interface, decl.stable_id);
}

qkey.Fingerprint128 declaration_body_fingerprint(
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary declaration,
    Bool persist_all
) {
    if (persist_all || declaration.inline_mode != 0) {
        return declaration.body_fingerprint;
    }
    if (declaration_has_generic_parameters(module_interface, declaration)) {
        return declaration.body_fingerprint;
    }
    if (declaration_is_trait_member(module_interface, declaration)) {
        // trait 默认实现会在调用方实例化；即使方法没有显式泛型参数，
        // body 变化也属于调用方可见 interface 变化。
        return declaration.body_fingerprint;
    }
    return qkey.Fingerprint128();
}

Bool declaration_is_trait_member(
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary declaration
) {
    guard declaration.owner is .some(owner) else { return false; }
    guard declaration_with_id(module_interface, owner) is .some(parent) else { return false; }
    return parent.kind == .trait_def;
}

Bool declaration_has_generic_parameters(
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary declaration
) {
    source_artifact.InterfaceDeclSummary current! = declaration;
    Int depth! = 0;
    while (depth < module_interface.declarations.len()) {
        if (declaration_owns_generic_parameter(module_interface, current.stable_id)) {
            return true;
        }
        guard current.owner is .some(owner) else { return false; }
        guard declaration_with_id(module_interface, owner) is .some(parent) else {
            return false;
        }
        current = parent;
        depth = depth + 1;
    }
    return false;
}

Bool declaration_owns_generic_parameter(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId owner
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        source_artifact.InterfaceDeclSummary candidate =
            module_interface.declarations.get(index);
        if (candidate.kind == .generic_param_def
            && declaration_owner_matches(candidate, owner)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool declaration_owner_matches(
    source_artifact.InterfaceDeclSummary declaration,
    qkey.StableSymbolId owner
) {
    guard declaration.owner is .some(candidate) else { return false; }
    return candidate == owner;
}

Void write_field_default(
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    if (module_interface.field_default(stable_id) is .some(payload)) {
        writer.write_bool(true);
        write_bytes_with_length(writer, payload);
        return;
    }
    writer.write_bool(false);
}

Void write_decl_type_ref(
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    if (module_interface.decl_type_ref(stable_id) is .some(type_ref)) {
        writer.write_bool(true);
        write_type_ref(writer, type_ref);
        return;
    }
    writer.write_bool(false);
}

Void write_trait_refs(
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    writer.write_int(trait_ref_count(module_interface, stable_id));
    Int index! = 0;
    while (index < module_interface.trait_refs.len()) {
        source_artifact.InterfaceTraitRefEntry& entry = module_interface.trait_refs.ref_at(index);
        if (entry.owner_stable_id == stable_id) {
            writer.write_bool(entry.negative);
            write_type_ref(writer, entry.trait_ref$.ref());
        }
        index = index + 1;
    }
}

Int trait_ref_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.trait_refs.len()) {
        if (module_interface.trait_refs.ref_at(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Void write_where_predicates(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    writer.write_int(where_predicate_count(module_interface, stable_id));
    Int index! = 0;
    while (index < module_interface.where_predicates.len()) {
        source_artifact.InterfaceWherePredicateEntry& entry = module_interface.where_predicates.ref_at(index);
        if (entry.owner_stable_id == stable_id) {
            write_where_predicate(ctx, writer, module_interface, entry.predicate$.ref());
        }
        index = index + 1;
    }
}

Int where_predicate_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.where_predicates.len()) {
        if (module_interface.where_predicates.ref_at(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Void write_where_predicate(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceWherePredicate& predicate
) {
    writer.write_int(Int(predicate.kind));
    write_type_ref(writer, module_interface.where_type_ref_at(predicate.subject_index));
    write_type_ref(writer, module_interface.where_type_ref_at(predicate.bound_or_value_index));
    write_type_ref(writer, module_interface.where_type_ref_at(predicate.trait_ref_index));
    write_optional_symbol_text(ctx, writer, predicate.assoc_symbol);
}

Void write_lifetime_constraints(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    writer.write_int(lifetime_constraint_count(module_interface, stable_id));
    Int index! = 0;
    while (index < module_interface.lifetime_constraints.len()) {
        source_artifact.InterfaceLifetimeConstraint& constraint = module_interface.lifetime_constraints.ref_at(index);
        if (constraint.owner_stable_id == stable_id) {
            write_lifetime_name(ctx, writer, module_interface, constraint.longer$.ref());
            write_lifetime_name(ctx, writer, module_interface, constraint.shorter$.ref());
            writer.write_int(constraint.relation);
        }
        index = index + 1;
    }
}

Void write_region_schema(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    writer.write_int(region_name_count(module_interface, stable_id));
    Int index! = 0;
    while (index < module_interface.region_names.len()) {
        source_artifact.InterfaceRegionName name = module_interface.region_names.get(index);
        if (name.owner_stable_id == stable_id) {
            write_symbol_text(ctx, writer, name.symbol);
        }
        index = index + 1;
    }
    writer.write_int(region_constraint_count(module_interface, stable_id));
    index = 0;
    while (index < module_interface.region_constraints.len()) {
        source_artifact.InterfaceRegionConstraint constraint =
            module_interface.region_constraints.get(index);
        if (constraint.owner_stable_id == stable_id) {
            write_symbol_text(ctx, writer, constraint.target);
            write_symbol_text(ctx, writer, constraint.source);
        }
        index = index + 1;
    }
}

Int region_name_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.region_names.len()) {
        if (module_interface.region_names.get(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Int region_constraint_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.region_constraints.len()) {
        if (module_interface.region_constraints.get(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Void write_life_clauses(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    writer.write_int(life_clause_count(module_interface, stable_id));
    Int index! = 0;
    while (index < module_interface.life_clauses.len()) {
        source_artifact.InterfaceLifeClause clause = module_interface.life_clauses.get(index);
        index = index + 1;
        if (clause.owner_stable_id != stable_id) { continue; }
        writer.write_bool(clause.target != null);
        if (clause.target is .some(target)) {
            write_lifetime_name(ctx, writer, module_interface, target$.ref());
        }
        writer.write_bool(clause.source_expression > 0);
        if (clause.source_expression > 0) {
            write_lifetime_expression(
                ctx,
                writer,
                module_interface,
                clause.source_expression
            );
        } else {
            write_lifetime_name(ctx, writer, module_interface, clause.source$.ref());
        }
    }
}

Void write_lifetime_expression(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    Int expression_index
) {
    source_artifact.InterfaceLifetimeExpression& expression =
        module_interface.lifetime_expressions.ref_at(expression_index - 1);
    writer.write_int(expression.kind);
    if (expression.kind == 0) {
        write_lifetime_name(ctx, writer, module_interface, expression.name$.ref());
        return;
    }
    write_lifetime_expression(ctx, writer, module_interface, expression.left);
    write_lifetime_expression(ctx, writer, module_interface, expression.right);
}

Int life_clause_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.life_clauses.len()) {
        if (module_interface.life_clauses.get(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Int lifetime_constraint_count(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.lifetime_constraints.len()) {
        if (module_interface.lifetime_constraints.ref_at(index).owner_stable_id == stable_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Void write_lifetime_name(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceLifetimeName& name
) {
    writer.write_int(name.kind);
    write_optional_symbol_text(ctx, writer, name.symbol);
    writer.write_int(lifetime_path_length(module_interface, name.projection_path));
    write_lifetime_path(ctx, writer, module_interface, name.projection_path);
}

Int lifetime_path_length(source_artifact.ModuleInterface& module_interface, Int path_index) {
    Int length! = 0;
    Int current! = path_index;
    while (current > 0) {
        length = length + 1;
        current = module_interface.lifetime_path_nodes.ref_at(current - 1).parent;
    }
    return length;
}

Void write_lifetime_path(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    Int path_index
) {
    if (path_index <= 0) { return; }
    source_artifact.InterfaceLifetimePathNode& node = module_interface.lifetime_path_nodes.ref_at(path_index - 1);
    write_lifetime_path(ctx, writer, module_interface, node.parent);
    writer.write_int(node.kind);
    write_optional_symbol_text(ctx, writer, node.symbol);
    write_optional_stable_id(writer, node.field_stable_id);
    writer.write_int(node.tuple_index);
}

Void write_function_signature(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    if (module_interface.function_signature(stable_id) is .some(signature)) {
        writer.write_bool(true);
        write_signature(ctx, writer, signature);
        return;
    }
    writer.write_bool(false);
}

Void write_const_value(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    if (module_interface.const_value(stable_id) is .some(const_value)) {
        writer.write_bool(true);
        write_comptime_value(ctx, writer, const_value);
        return;
    }
    writer.write_bool(false);
}

Void write_comptime_value(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceConstValue value
) {
    // 只写稳定 payload；持久化类型由 declaration signature 负责。
    writer.write_int(Int(interface_const_value_kind(value)));
    if (value.data is .unit_value) {
        return;
    }
    if (value.data is .bool_value(bool_value)) {
        writer.write_bool(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        writer.write_int(int_value);
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        writer.write_uint64(uint_value);
        return;
    }
    if (value.data is .char_value(char_value)) {
        writer.write_uint64(char_value);
        return;
    }
    if (value.data is .float_bits(float_bits)) {
        writer.write_uint64(float_bits);
        return;
    }
    if (value.data is .string_value(string_value)) {
        write_bytes_with_length(writer, string_value);
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        write_symbol_text(ctx, writer, symbol_value);
        return;
    }
    if (value.data is .enum_case_value(case_stable_id)) {
        write_stable_id(writer, case_stable_id);
        return;
    }
    if (value.data is .struct_value(fields)) {
        write_const_fields(ctx, writer, fields);
        return;
    }
    if (value.data is .tuple_value(items)) {
        write_const_values(ctx, writer, items);
        return;
    }
    if (value.data is .array_value(items)) {
        write_const_values(ctx, writer, items);
        return;
    }
}

source_artifact.InterfaceConstValueKind interface_const_value_kind(source_artifact.InterfaceConstValue value) {
    if (value.data is .unit_value) { return .unit_value; }
    if (value.data is .bool_value(_)) { return .bool_value; }
    if (value.data is .int_value(_)) { return .int_value; }
    if (value.data is .uint_value(_)) { return .uint_value; }
    if (value.data is .char_value(_)) { return .char_value; }
    if (value.data is .float_bits(_)) { return .float_value; }
    if (value.data is .string_value(_)) { return .string_value; }
    if (value.data is .symbol_value(_)) { return .symbol_value; }
    if (value.data is .enum_case_value(_)) { return .enum_case_value; }
    if (value.data is .struct_value(_)) { return .struct_value; }
    if (value.data is .tuple_value(_)) { return .tuple_value; }
    if (value.data is .array_value(_)) { return .array_value; }
    return .invalid;
}

Void write_const_fields(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceConstFieldValue[]& fields
) {
    writer.write_int(fields.length);
    Int index! = 0;
    while (index < fields.length) {
        write_stable_id(writer, fields[index].field_stable_id);
        write_comptime_value(ctx, writer, fields[index].value);
        index = index + 1;
    }
}

Void write_const_values(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceConstValue[]& items
) {
    writer.write_int(items.length);
    Int index! = 0;
    while (index < items.length) {
        write_comptime_value(ctx, writer, items[index]);
        index = index + 1;
    }
}

Void write_signature(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceFunctionSignature& signature
) {
    writer.write_bool(signature.has_receiver);
    writer.write_int(signature.receiver_mode);
    writer.write_bool(signature.has_unsafe);
    writer.write_bool(signature.has_async);
    write_optional_stable_id(writer, signature.domain_stable_id);
    writer.write_int(signature.exclusive_symbols.len());
    Int exclusive_index! = 0;
    while (exclusive_index < signature.exclusive_symbols.len()) {
        write_symbol_text(ctx, writer, signature.exclusive_symbols.get(exclusive_index));
        exclusive_index = exclusive_index + 1;
    }
    writer.write_int(signature.params.len());
    Int index! = 0;
    while (index < signature.params.len()) {
        source_artifact.InterfaceParamSummary& param = signature.params.ref_at(index);
        write_symbol_text(ctx, writer, param.symbol);
        write_type_ref(writer, param.type_ref$.ref());
        index = index + 1;
    }
    write_param_defaults(ctx, writer, signature);
    source_artifact.InterfaceTypeRef result = signature.result_type_ref();
    write_type_ref(writer, result$.ref());
}

Void write_param_defaults(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceFunctionSignature& signature
) {
    writer.write_int(signature.param_defaults.len());
    Int index! = 0;
    while (index < signature.param_defaults.len()) {
        source_artifact.InterfaceParamDefault param_default = signature.param_defaults.get(index);
        writer.write_int(param_default.param_index);
        write_literal(ctx, writer, param_default.value);
        index = index + 1;
    }
}

Void write_literal(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.InterfaceLiteral literal
) {
    writer.write_int(Int(literal.kind));
    writer.write_uint64(literal.int_bits);
    writer.write_bool(literal.signed_int);
    writer.write_uint64(float64_to_bits(literal.float_value));
    writer.write_bool(literal.bool_value);
    write_optional_symbol_text(ctx, writer, literal.string_symbol);
    writer.write_uint64(UInt64(literal.char_value));
}

Void write_type_ref(SourceSectionWriter& writer, source_artifact.InterfaceTypeRef& type_ref) {
    writer.write_int(source_artifact.persistent_type_ref_tag(type_ref));
    writer.write_bool(type_ref.has_stable_def);
    if (type_ref.has_stable_def) {
        writer.write_uint64(type_ref.stable_def_low);
        writer.write_uint64(type_ref.stable_def_high);
    }
    writer.write_int(type_ref.count_kind);
    writer.write_uint64(type_ref.count_value);
    writer.write_int(type_ref.sentinel_kind);
    writer.write_uint64(type_ref.sentinel_value);
    writer.write_int(type_ref.arg_count());
    Int index! = 0;
    while (index < type_ref.arg_count()) {
        source_artifact.InterfaceTypeRef arg = type_ref.arg_at(index);
        write_type_ref(writer, arg$.ref());
        index = index + 1;
    }
    writer.write_int(type_ref.contract_name_count());
    index = 0;
    while (index < type_ref.contract_name_count()) {
        write_bytes_with_length(writer, type_ref.contract_name_at(index));
        index = index + 1;
    }
}

Void write_public_imports(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    writer.write_int(module_interface.public_imports.len());
    list.ArrayList<Int> indexes = sorted_import_indexes(ctx, module_interface);
    Int index! = 0;
    while (index < module_interface.public_imports.len()) {
        source_artifact.ImportSummaryEntry entry = module_interface.public_imports.get(indexes.get(index));
        write_import(ctx, writer, entry);
        index = index + 1;
    }
}

Void write_import(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ImportSummaryEntry entry
) {
    writer.write_int(Int(entry.kind));
    writer.write_int(Int(entry.visibility));
    if (entry.flatten) {
        writer.write_int(1);
    } else {
        writer.write_int(0);
    }
    write_symbol_text(ctx, writer, entry.path_symbol);
    write_optional_symbol_text(ctx, writer, entry.alias_symbol);
    write_optional_fingerprint(writer, entry.target_source_identity);
}

Void write_public_aliases(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface
) {
    writer.write_int(module_interface.public_aliases.len());
    list.ArrayList<Int> indexes = sorted_alias_indexes(ctx, module_interface);
    Int index! = 0;
    while (index < module_interface.public_aliases.len()) {
        source_artifact.AliasExportSummary alias_export = module_interface.public_aliases.get(indexes.get(index));
        write_symbol_text(ctx, writer, alias_export.alias_symbol);
        write_stable_id(writer, alias_export.target_stable_id);
        index = index + 1;
    }
}

Void write_extension_groups(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    Bool public_only
) {
    writer.write_int(extension_group_count(module_interface, public_only));
    Int index! = 0;
    while (index < module_interface.extension_groups.len()) {
        source_artifact.InterfaceExtensionGroup& group =
            module_interface.extension_groups.ref_at(index);
        if (!public_only || group.public_flag) {
            write_extension_group(ctx, writer, module_interface, group);
        }
        index = index + 1;
    }
}

Int extension_group_count(
    source_artifact.ModuleInterface& module_interface,
    Bool public_only
) {
    if (!public_only) { return module_interface.extension_groups.len(); }
    Int count! = 0;
    Int index! = 0;
    while (index < module_interface.extension_groups.len()) {
        if (module_interface.extension_groups.ref_at(index).public_flag) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

Void write_extension_group(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceExtensionGroup& group
) {
    write_stable_id(writer, group.target_owner);
    write_stable_id(writer, group.binding_owner);
    writer.write_bool(group.public_flag);
    writer.write_bool(group.trait_ref != null);
    if (group.trait_ref is .some(ref _ trait_ref)) {
        write_type_ref(writer, trait_ref);
    }
    writer.write_int(group.where_predicates.len());
    Int index! = 0;
    while (index < group.where_predicates.len()) {
        write_where_predicate(
            ctx,
            writer,
            module_interface,
            group.where_predicates.ref_at(index)
        );
        index = index + 1;
    }
    writer.write_int(group.generic_constraints.len());
    index = 0;
    while (index < group.generic_constraints.len()) {
        source_artifact.InterfaceExtensionConstraint& constraint =
            group.generic_constraints.ref_at(index);
        write_stable_id(writer, constraint.param_stable_id);
        write_type_ref(writer, constraint.type_ref$.ref());
        index = index + 1;
    }
    writer.write_int(group.members.len());
    index = 0;
    while (index < group.members.len()) {
        write_stable_id(writer, group.members.get(index));
        index = index + 1;
    }
}

Void write_summary_imports(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ImportSummary& summary
) {
    writer.write_int(summary.imports.len());
    list.ArrayList<Int> indexes = sorted_summary_import_indexes(ctx, summary);
    Int index! = 0;
    while (index < summary.imports.len()) {
        source_artifact.ImportSummaryEntry entry = summary.imports.get(indexes.get(index));
        write_import(ctx, writer, entry);
        index = index + 1;
    }
}

Void write_summary_public_aliases(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    source_artifact.ImportSummary& summary
) {
    writer.write_int(summary.public_aliases.len());
    list.ArrayList<Int> indexes = sorted_summary_alias_indexes(ctx, summary);
    Int index! = 0;
    while (index < summary.public_aliases.len()) {
        source_artifact.AliasExportSummary alias_export = summary.public_aliases.get(indexes.get(index));
        write_symbol_text(ctx, writer, alias_export.alias_symbol);
        write_stable_id(writer, alias_export.target_stable_id);
        index = index + 1;
    }
}

Void write_symbol_text(context.CompilerContext& ctx, SourceSectionWriter& writer, qid.SymbolId symbol) {
    UInt8[]& text = ctx.store.symbols.text(symbol);
    writer.write_int(text.length);
    writer.write_bytes(text);
}

Void write_optional_symbol_text(
    context.CompilerContext& ctx,
    SourceSectionWriter& writer,
    qid.SymbolId? symbol
) {
    if (symbol is .some(symbol_id)) {
        writer.write_bool(true);
        write_symbol_text(ctx, writer, symbol_id);
        return;
    }
    writer.write_bool(false);
}

Void write_optional_stable_id(SourceSectionWriter& writer, qkey.StableSymbolId? stable_id) {
    if (stable_id is .some(id)) {
        writer.write_bool(true);
        write_stable_id(writer, id);
        return;
    }
    writer.write_bool(false);
}

Void write_optional_fingerprint(SourceSectionWriter& writer, qkey.Fingerprint128? fingerprint) {
    if (fingerprint is .some(value)) {
        writer.write_bool(true);
        write_fingerprint(writer, value);
        return;
    }
    writer.write_bool(false);
}

Void write_stable_id(SourceSectionWriter& writer, qkey.StableSymbolId stable_id) {
    writer.write_uint64(stable_id.low);
    writer.write_uint64(stable_id.high);
}

Void write_fingerprint(SourceSectionWriter& writer, qkey.Fingerprint128 fingerprint) {
    writer.write_uint64(fingerprint.low);
    writer.write_uint64(fingerprint.high);
}

Void write_bytes_with_length(SourceSectionWriter& writer, UInt8[]& bytes) {
    writer.write_int(bytes.length);
    writer.write_bytes(bytes);
}

list.ArrayList<Int> sorted_declaration_indexes(source_artifact.ModuleInterface& module_interface) {
    list.ArrayList<Int> indexes = index_list(module_interface.declarations.len());
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (declaration_index_less(module_interface, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes$.ref(), index, min_index);
        index = index + 1;
    }
    return indexes;
}

Bool declaration_index_less(
    source_artifact.ModuleInterface& module_interface,
    Int lhs_index,
    Int rhs_index
) {
    source_artifact.InterfaceDeclSummary lhs = module_interface.declarations.get(lhs_index);
    source_artifact.InterfaceDeclSummary rhs = module_interface.declarations.get(rhs_index);
    qkey.StableSymbolId lhs_group = declaration_root_group(module_interface, lhs);
    qkey.StableSymbolId rhs_group = declaration_root_group(module_interface, rhs);
    if (stable_id_less(lhs_group, rhs_group)) { return true; }
    if (stable_id_less(rhs_group, lhs_group)) { return false; }
    // 同一顶层 owner 内的顺序属于 ABI，字段、tag 和 trait vtable 都依赖它。
    return lhs_index < rhs_index;
}

qkey.StableSymbolId declaration_root_group(
    source_artifact.ModuleInterface& module_interface,
    source_artifact.InterfaceDeclSummary declaration
) {
    qkey.StableSymbolId root! = declaration.stable_id;
    qkey.StableSymbolId? owner! = declaration.owner;
    Int remaining! = module_interface.declarations.len();
    while (owner is .some(owner_id) && remaining > 0) {
        guard declaration_index(module_interface, owner_id) is .some(owner_index) else {
            return root;
        }
        source_artifact.InterfaceDeclSummary owner_declaration =
            module_interface.declarations.get(owner_index);
        root = owner_id;
        owner = owner_declaration.owner;
        remaining = remaining - 1;
    }
    return root;
}

Int? declaration_index(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        source_artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.stable_id == stable_id) { return index; }
        index = index + 1;
    }
    return null;
}

list.ArrayList<Int> sorted_import_indexes(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<Int> indexes = index_list(module_interface.public_imports.len());
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (import_index_less(ctx, module_interface, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes$.ref(), index, min_index);
        index = index + 1;
    }
    return indexes;
}

list.ArrayList<Int> sorted_summary_import_indexes(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary
) {
    list.ArrayList<Int> indexes = index_list(summary.imports.len());
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (summary_import_index_less(ctx, summary, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes$.ref(), index, min_index);
        index = index + 1;
    }
    return indexes;
}

Bool import_index_less(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    Int lhs_index,
    Int rhs_index
) {
    source_artifact.ImportSummaryEntry lhs = module_interface.public_imports.get(lhs_index);
    source_artifact.ImportSummaryEntry rhs = module_interface.public_imports.get(rhs_index);
    return import_less(ctx, lhs, rhs, lhs_index, rhs_index);
}

Bool summary_import_index_less(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary,
    Int lhs_index,
    Int rhs_index
) {
    source_artifact.ImportSummaryEntry lhs = summary.imports.get(lhs_index);
    source_artifact.ImportSummaryEntry rhs = summary.imports.get(rhs_index);
    return import_less(ctx, lhs, rhs, lhs_index, rhs_index);
}

Bool import_less(
    context.CompilerContext& ctx,
    source_artifact.ImportSummaryEntry lhs,
    source_artifact.ImportSummaryEntry rhs,
    Int lhs_index,
    Int rhs_index
) {
    store.ImportKind lhs_kind = lhs.kind;
    store.ImportKind rhs_kind = rhs.kind;
    Int lhs_kind_value = Int(lhs_kind);
    Int rhs_kind_value = Int(rhs_kind);
    if (lhs_kind_value != rhs_kind_value) { return lhs_kind_value < rhs_kind_value; }
    def.Visibility lhs_visibility = lhs.visibility;
    def.Visibility rhs_visibility = rhs.visibility;
    Int lhs_visibility_value = Int(lhs_visibility);
    Int rhs_visibility_value = Int(rhs_visibility);
    if (lhs_visibility_value != rhs_visibility_value) {
        return lhs_visibility_value < rhs_visibility_value;
    }
    if (symbol_less(ctx, lhs.path_symbol, rhs.path_symbol)) { return true; }
    if (symbol_less(ctx, rhs.path_symbol, lhs.path_symbol)) { return false; }
    if (optional_symbol_less(ctx, lhs.alias_symbol, rhs.alias_symbol)) { return true; }
    if (optional_symbol_less(ctx, rhs.alias_symbol, lhs.alias_symbol)) { return false; }
    return lhs_index < rhs_index;
}

list.ArrayList<Int> sorted_alias_indexes(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface
) {
    list.ArrayList<Int> indexes = index_list(module_interface.public_aliases.len());
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (alias_index_less(ctx, module_interface, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes$.ref(), index, min_index);
        index = index + 1;
    }
    return indexes;
}

list.ArrayList<Int> sorted_summary_alias_indexes(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary
) {
    list.ArrayList<Int> indexes = index_list(summary.public_aliases.len());
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (summary_alias_index_less(ctx, summary, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes$.ref(), index, min_index);
        index = index + 1;
    }
    return indexes;
}

Bool alias_index_less(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    Int lhs_index,
    Int rhs_index
) {
    source_artifact.AliasExportSummary lhs = module_interface.public_aliases.get(lhs_index);
    source_artifact.AliasExportSummary rhs = module_interface.public_aliases.get(rhs_index);
    return alias_less(ctx, lhs, rhs, lhs_index, rhs_index);
}

Bool summary_alias_index_less(
    context.CompilerContext& ctx,
    source_artifact.ImportSummary& summary,
    Int lhs_index,
    Int rhs_index
) {
    source_artifact.AliasExportSummary lhs = summary.public_aliases.get(lhs_index);
    source_artifact.AliasExportSummary rhs = summary.public_aliases.get(rhs_index);
    return alias_less(ctx, lhs, rhs, lhs_index, rhs_index);
}

Bool alias_less(
    context.CompilerContext& ctx,
    source_artifact.AliasExportSummary lhs,
    source_artifact.AliasExportSummary rhs,
    Int lhs_index,
    Int rhs_index
) {
    if (symbol_less(ctx, lhs.alias_symbol, rhs.alias_symbol)) { return true; }
    if (symbol_less(ctx, rhs.alias_symbol, lhs.alias_symbol)) { return false; }
    if (stable_id_less(lhs.target_stable_id, rhs.target_stable_id)) { return true; }
    if (stable_id_less(rhs.target_stable_id, lhs.target_stable_id)) { return false; }
    return lhs_index < rhs_index;
}

list.ArrayList<Int> index_list(Int len) {
    list.ArrayList<Int> indexes = list.ArrayList<Int>(len);
    Int index! = 0;
    while (index < len) {
        indexes.add(index);
        index = index + 1;
    }
    return indexes;
}

Void swap_indexes(list.ArrayList<Int>& indexes, Int lhs_index, Int rhs_index) {
    if (lhs_index == rhs_index) {
        return;
    }
    Int lhs = indexes.get(lhs_index);
    indexes.set(lhs_index, indexes.get(rhs_index));
    indexes.set(rhs_index, lhs);
}

Bool stable_id_less(qkey.StableSymbolId lhs, qkey.StableSymbolId rhs) {
    if (lhs.low != rhs.low) {
        return lhs.low < rhs.low;
    }
    return lhs.high < rhs.high;
}

Bool optional_symbol_less(
    context.CompilerContext& ctx,
    qid.SymbolId? lhs,
    qid.SymbolId? rhs
) {
    if (lhs is .some(lhs_symbol)) {
        if (rhs is .some(rhs_symbol)) {
            return symbol_less(ctx, lhs_symbol, rhs_symbol);
        }
        return false;
    }
    return rhs != null;
}

Bool symbol_less(context.CompilerContext& ctx, qid.SymbolId lhs, qid.SymbolId rhs) {
    return bytes_less(ctx.store.symbols.text(lhs), ctx.store.symbols.text(rhs));
}

Bool bytes_less(UInt8[]& lhs, UInt8[]& rhs) {
    Int index! = 0;
    while (index < lhs.length && index < rhs.length) {
        if (lhs[index] != rhs[index]) {
            return lhs[index] < rhs[index];
        }
        index = index + 1;
    }
    return lhs.length < rhs.length;
}

UInt64 float64_to_bits(Float64 value) {
    unsafe {
        Float64*! input = Float64$.alloc(1);
        UInt64*! output = UInt64$.alloc(1);
        input[0] = value;
        memory.copy_bytes(output[0]$.ptr()$.as(UInt8*), input[0]$.ptr()$.as(UInt8*), 8);
        UInt64 result = output[0];
        input$.dealloc();
        output$.dealloc();
        return result;
    }
}

Float64 float64_from_bits(UInt64 bits) {
    unsafe {
        UInt64*! input = UInt64$.alloc(1);
        Float64*! output = Float64$.alloc(1);
        input[0] = bits;
        memory.copy_bytes(output[0]$.ptr()$.as(UInt8*), input[0]$.ptr()$.as(UInt8*), 8);
        Float64 result = output[0];
        input$.dealloc();
        output$.dealloc();
        return result;
    }
}
