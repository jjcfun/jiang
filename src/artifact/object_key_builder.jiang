// Object cache stable key 构建。
//
// 这里负责把 session-local TypeId 转成 StableTypeKey。object_key.jiang 只保留
// 纯数据结构和 hash 逻辑，避免它反向依赖 CompilerContext。

import context = "../context.jiang";
import fingerprint = "../incremental/fingerprint.jiang";
import hir = "../hir/hir.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import mir = "../mir/mir.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import driver_options = "../driver/options.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import types = "../sema/type.jiang";
import blake3 = "../support/blake3.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import object_artifact = "./object.jiang";
import object_key = "./object_key.jiang";

public struct SourceObjectFingerprints: Copyable {
    public qkey.Fingerprint128 interface_hash;
    public qkey.Fingerprint128 body_hash;
    public qkey.Fingerprint128 layout_hash;

    public init(self,
        qkey.Fingerprint128 interface_hash,
        qkey.Fingerprint128 body_hash,
        qkey.Fingerprint128 layout_hash
    ) {
        self.interface_hash = interface_hash;
        self.body_hash = body_hash;
        self.layout_hash = layout_hash;
    }
}

public object_key.StableTypeKey stable_type_key_for_type(
    context.CompilerContext& ctx,
    qid.TypeId type_id
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    return stable_type_key_for_data(ctx, info.data);
}

public object_key.StableInstanceKey? stable_instance_key_for_function(
    context.CompilerContext& ctx,
    mir.MirFunction function,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    guard ctx.store.incremental.stable_id_for_def(function.def_id) is .some(stable_def) else {
        return null;
    }
    object_key.StableInstanceKey key! = object_key.StableInstanceKey(
        stable_def,
        stable_function_body_hash(ctx, function.def_id),
        stable_instance_layout_hash(ctx, function.type_args),
        target_hash,
        compiler_hash,
        backend_profile_hash
    );
    Int index! = 0;
    while (index < function.type_args.length) {
        key.add_type_arg(stable_type_key_for_type(ctx, function.type_args[index]));
        index = index + 1;
    }
    return key;
}

public SourceObjectFingerprints source_object_fingerprints_for_module(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    list.ArrayList<qkey.Fingerprint128> interface_parts = list.ArrayList<qkey.Fingerprint128>();
    list.ArrayList<qkey.Fingerprint128> body_parts = list.ArrayList<qkey.Fingerprint128>();
    list.ArrayList<qkey.Fingerprint128> layout_parts = list.ArrayList<qkey.Fingerprint128>();
    collect_source_object_fingerprint_parts(
        ctx,
        module_def,
        interface_parts$.ref(),
        body_parts$.ref(),
        layout_parts$.ref()
    );
    return SourceObjectFingerprints(
        object_key.combine_fingerprints(UInt64(101), interface_parts$.ref()),
        object_key.combine_fingerprints(UInt64(102), body_parts$.ref()),
        object_key.combine_fingerprints(UInt64(103), layout_parts$.ref())
    );
}

qkey.Fingerprint128 stable_function_body_hash(context.CompilerContext& ctx, qid.DefId def_id) {
    if (ctx.store.hirs.def(def_id) is .some(hir_def)) {
        return fingerprint.hir_body_fingerprint(ctx, hir_def);
    }
    return qkey.Fingerprint128();
}

qkey.Fingerprint128 stable_instance_layout_hash(context.CompilerContext& ctx, qid.TypeId[]& type_args) {
    list.ArrayList<qkey.Fingerprint128> parts = list.ArrayList<qkey.Fingerprint128>();
    Int index! = 0;
    while (index < type_args.length) {
        layout.TypeLayout type_layout = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx, type_args[index]));
        parts.add(fingerprint.type_layout_fingerprint(ctx, type_layout));
        index = index + 1;
    }
    return object_key.combine_fingerprints(UInt64(104), parts$.ref());
}

public object_artifact.SourceObjectKey? source_object_key_for_module(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    qkey.Fingerprint128 interface_hash,
    qkey.Fingerprint128 body_hash,
    qkey.Fingerprint128 layout_hash,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    guard ctx.store.incremental.stable_id_for_def(module_def) is .some(stable_module) else {
        return null;
    }

    UInt64 source_hash = source_hash_for_module(ctx, module_id);
    return object_artifact.SourceObjectKey(
        stable_module,
        source_hash,
        interface_hash,
        body_hash,
        layout_hash,
        target_hash,
        compiler_hash,
        backend_profile_hash
    );
}

public object_artifact.SourceObjectKey? source_object_key_for_module(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    SourceObjectFingerprints fingerprints,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    return source_object_key_for_module(
        ctx,
        module_id,
        fingerprints.interface_hash,
        fingerprints.body_hash,
        fingerprints.layout_hash,
        target_hash,
        compiler_hash,
        backend_profile_hash
    );
}

public qkey.Fingerprint128 target_fingerprint(UInt8[]& target_triple) {
    return domain_fingerprint("target:", target_triple);
}

public qkey.Fingerprint128 compiler_fingerprint(UInt8[]& compiler_version) {
    return domain_fingerprint("compiler:", compiler_version);
}

public qkey.Fingerprint128 backend_profile_fingerprint(driver_options.CompileMode mode) {
    return domain_fingerprint("backend-profile:", driver_options.backend_profile(mode));
}

UInt64 source_hash_for_module(context.CompilerContext& ctx, qid.ModuleId module_id) {
    return ctx.store.sources.get(ctx.store.resolve.module_ref(module_id).source_id).content_hash;
}

() collect_source_object_fingerprint_parts(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    list.ArrayList<qkey.Fingerprint128>& interface_parts,
    list.ArrayList<qkey.Fingerprint128>& body_parts,
    list.ArrayList<qkey.Fingerprint128>& layout_parts
) {
    if (ctx.store.hirs.def(def_id) == null) {
        return;
    }
    hir.HirDef& hir_def = ctx.store.hirs.def_ref(def_id);
    collect_def_fingerprint_parts(ctx, hir_def, interface_parts, body_parts, layout_parts);
    list.ArrayList<Int> member_indexes = sorted_member_indexes(ctx, hir_def);
    Int index! = 0;
    while (index < member_indexes.len()) {
        collect_source_object_fingerprint_parts(
            ctx,
            hir_def.members.get(member_indexes.get(index)),
            interface_parts,
            body_parts,
            layout_parts
        );
        index = index + 1;
    }
}

() collect_def_fingerprint_parts(
    context.CompilerContext& ctx,
    hir.HirDef& hir_def,
    list.ArrayList<qkey.Fingerprint128>& interface_parts,
    list.ArrayList<qkey.Fingerprint128>& body_parts,
    list.ArrayList<qkey.Fingerprint128>& layout_parts
) {
    guard ctx.store.incremental.stable_id_for_def(hir_def.def_id) is .some(stable_id) else {
        return;
    }
    interface_parts.add(def_fingerprint_part(
        UInt64(201),
        stable_id,
        fingerprint.hir_signature_fingerprint(ctx, hir_def)
    ));
    body_parts.add(def_fingerprint_part(
        UInt64(202),
        stable_id,
        fingerprint.hir_body_fingerprint(ctx, hir_def)
    ));
    if (ctx.store.typeck.def_type(hir_def.def_id) is .some(type_id)
        && type_has_concrete_layout(ctx, type_id)
    ) {
        layout.TypeLayout type_layout = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx, type_id));
        layout_parts.add(def_fingerprint_part(
            UInt64(203),
            stable_id,
            fingerprint.type_layout_fingerprint(ctx, type_layout)
        ));
    }
}

Bool type_has_concrete_layout(context.CompilerContext& ctx, qid.TypeId type_id) {
    if (!ctx.store.types.has(type_id)) { return false; }
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .named(named)) {
        def.DefKind kind = ctx.store.defs.get(named.def_id).kind;
        if (kind != .struct_def && kind != .enum_def && kind != .union_def) {
            return false;
        }
        return type_list_has_concrete_layout(ctx, named.type_args);
    }
    if (info.data is .optional(optional)) {
        return type_has_concrete_layout(ctx, optional.element);
    }
    if (info.data is .error_union(error_union)) {
        return type_has_concrete_layout(ctx, error_union.value)
            && type_has_concrete_layout(ctx, error_union.error);
    }
    if (info.data is .handle_type(handle)) {
        return type_has_concrete_layout(ctx, handle.element);
    }
    if (info.data is .array_type(array_type)) {
        return type_has_concrete_layout(ctx, array_type.element);
    }
    if (info.data is .tuple_type(tuple_type)) {
        return type_list_has_concrete_layout(ctx, tuple_type.items);
    }
    if (info.data is .function_type(function_type)) {
        return type_list_has_concrete_layout(ctx, function_type.params)
            && type_has_concrete_layout(ctx, function_type.result);
    }
    if (info.data is .task_type(task_type)) {
        return type_has_concrete_layout(ctx, task_type.result);
    }
    return true;
}

Bool type_list_has_concrete_layout(context.CompilerContext& ctx, qid.TypeId[]& type_ids) {
    Int index! = 0;
    while (index < type_ids.length) {
        if (!type_has_concrete_layout(ctx, type_ids[index])) { return false; }
        index = index + 1;
    }
    return true;
}

qkey.Fingerprint128 def_fingerprint_part(
    UInt64 domain,
    qkey.StableSymbolId stable_id,
    qkey.Fingerprint128 fingerprint_part
) {
    list.ArrayList<qkey.Fingerprint128> parts = list.ArrayList<qkey.Fingerprint128>();
    parts.add(qkey.Fingerprint128(stable_id.low, stable_id.high));
    parts.add(fingerprint_part);
    return object_key.combine_fingerprints(domain, parts$.ref());
}

list.ArrayList<Int> sorted_member_indexes(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    list.ArrayList<Int> indexes = list.ArrayList<Int>(hir_def.members.len());
    Int index! = 0;
    while (index < hir_def.members.len()) {
        indexes.add(index);
        index = index + 1;
    }
    sort_member_indexes(ctx, hir_def, indexes$.ref());
    return indexes;
}

() sort_member_indexes(context.CompilerContext& ctx, hir.HirDef& hir_def, list.ArrayList<Int>& indexes) {
    Int index! = 0;
    while (index < indexes.len()) {
        Int min_index! = index;
        Int scan! = index + 1;
        while (scan < indexes.len()) {
            if (member_index_less(ctx, hir_def, indexes.get(scan), indexes.get(min_index))) {
                min_index = scan;
            }
            scan = scan + 1;
        }
        swap_indexes(indexes, index, min_index);
        index = index + 1;
    }
}

Bool member_index_less(context.CompilerContext& ctx, hir.HirDef& hir_def, Int lhs_index, Int rhs_index) {
    qid.DefId lhs_def = hir_def.members.get(lhs_index);
    qid.DefId rhs_def = hir_def.members.get(rhs_index);
    if (ctx.store.incremental.stable_id_for_def(lhs_def) is .some(lhs_stable)) {
        if (ctx.store.incremental.stable_id_for_def(rhs_def) is .some(rhs_stable)) {
            if (stable_id_less(lhs_stable, rhs_stable)) { return true; }
            if (stable_id_less(rhs_stable, lhs_stable)) { return false; }
        }
    }
    return lhs_index < rhs_index;
}

Bool stable_id_less(qkey.StableSymbolId lhs, qkey.StableSymbolId rhs) {
    if (lhs.low != rhs.low) {
        return lhs.low < rhs.low;
    }
    return lhs.high < rhs.high;
}

() swap_indexes(list.ArrayList<Int>& indexes, Int lhs_index, Int rhs_index) {
    if (lhs_index == rhs_index) {
        return;
    }
    Int lhs = indexes.get(lhs_index);
    indexes.set(lhs_index, indexes.get(rhs_index));
    indexes.set(rhs_index, lhs);
}

qkey.Fingerprint128 domain_fingerprint(UInt8[]& domain, UInt8[]& text) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(domain.length + text.length + 1);
        Int write! = 0;
        Int index! = 0;
        while (index < domain.length) {
            bytes[write] = domain[index];
            write = write + 1;
            index = index + 1;
        }
        index = 0;
        while (index < text.length) {
            bytes[write] = text[index];
            write = write + 1;
            index = index + 1;
        }
        bytes[write] = 0;
        blake3.Blake3Hash digest = blake3.blake3_hash(bytes$.as(UInt8*)[0..write]);
        return qkey.Fingerprint128(digest.a, digest.b);
    }
}

object_key.StableTypeKey stable_type_key_for_data(
    context.CompilerContext& ctx,
    types.TypeData data
) {
    if (data is .invalid) { return object_key.StableTypeKey(.invalid_type); }
    if (data is .never) { return stable_builtin(1); }
    if (data is .unit) { return stable_builtin(2); }
    if (data is .bool_type) { return stable_builtin(3); }
    if (data is .char_type) { return stable_builtin(4); }
    if (data is .int_type(int_type)) {
        return stable_builtin(int_builtin_tag(int_type));
    }
    if (data is .float_type(float_type)) {
        return stable_builtin(3000 + float_type.bits);
    }
    return stable_compound_type_key(ctx, data);
}

object_key.StableTypeKey stable_compound_type_key(
    context.CompilerContext& ctx,
    types.TypeData data
) {
    if (data is .named(named)) { return stable_named_type_key(ctx, named); }
    if (data is .optional(optional)) {
        object_key.StableTypeKey key! = object_key.StableTypeKey(.optional_type);
        key.add_arg(stable_type_key_for_type(ctx, optional.element));
        return key;
    }
    if (data is .error_union(error_union)) {
        object_key.StableTypeKey key! = object_key.StableTypeKey(.error_union_type);
        key.add_arg(stable_type_key_for_type(ctx, error_union.value));
        key.add_arg(stable_type_key_for_type(ctx, error_union.error));
        return key;
    }
    return stable_aggregate_type_key(ctx, data);
}

object_key.StableTypeKey stable_aggregate_type_key(
    context.CompilerContext& ctx,
    types.TypeData data
) {
    if (data is .handle_type(handle)) { return stable_handle_type_key(ctx, handle); }
    if (data is .slice_value_type(slice_value)) {
        object_key.StableTypeKey key! = object_key.StableTypeKey(.slice_value_type);
        key.sentinel = stable_sentinel(ctx, slice_value.sentinel);
        key.add_arg(stable_type_key_for_type(ctx, slice_value.element));
        return key;
    }
    if (data is .array_type(array_type)) {
        object_key.StableTypeKey key! = object_key.StableTypeKey(.array_type);
        key.array_length = array_type.count;
        key.sentinel = stable_sentinel(ctx, array_type.sentinel);
        key.add_arg(stable_type_key_for_type(ctx, array_type.element));
        return key;
    }
    if (data is .tuple_type(tuple_type)) {
        return stable_type_array_key(ctx, .tuple_type, tuple_type.items);
    }
    if (data is .function_type(function_type)) {
        object_key.StableTypeKey key! = stable_type_array_key(ctx, .function_type, function_type.params);
        key.add_arg(stable_type_key_for_type(ctx, function_type.result));
        key.builtin_tag = function_effect_tag(function_type.effects);
        if (function_type.effects.domain is .some(domain)) {
            guard ctx.store.incremental.stable_id_for_def(domain.binding) is .some(stable_def) else {
                return object_key.StableTypeKey(.invalid_type);
            }
            key.has_stable_def = true;
            key.stable_def_low = stable_def.low;
            key.stable_def_high = stable_def.high;
        }
        return key;
    }
    if (data is .trait_companion(companion)) {
        guard ctx.store.incremental.stable_id_for_def(companion.trait_def) is .some(stable_def) else {
            return object_key.StableTypeKey(.invalid_type);
        }
        object_key.StableTypeKey key! = object_key.StableTypeKey(.trait_companion_type);
        key.has_stable_def = true;
        key.stable_def_low = stable_def.low;
        key.stable_def_high = stable_def.high;
        key.builtin_tag = Int(companion.kind);
        return key;
    }
    return object_key.StableTypeKey(.invalid_type);
}

Int function_effect_tag(types.EffectSet effects) {
    Int tag! = 0;
    if (effects.has_unsafe) {
        tag = tag + 1;
    }
    if (effects.has_async) {
        tag = tag + 2;
    }
    return tag;
}

object_key.StableTypeKey stable_named_type_key(
    context.CompilerContext& ctx,
    types.NamedType named
) {
    guard ctx.store.incremental.stable_id_for_def(named.def_id) is .some(stable_def) else {
        return object_key.StableTypeKey(.invalid_type);
    }

    object_key.StableTypeKey key! = object_key.StableTypeKey.named_type(stable_def.low, stable_def.high);
    Int index! = 0;
    while (index < named.type_args.length) {
        key.add_arg(stable_type_key_for_type(ctx, named.type_args[index]));
        index = index + 1;
    }
    return key;
}

object_key.StableTypeKey stable_handle_type_key(
    context.CompilerContext& ctx,
    types.HandleType handle
) {
    object_key.StableTypeKey key! = object_key.StableTypeKey(stable_handle_kind(handle.kind));
    key.sentinel = stable_sentinel(ctx, handle.sentinel);
    key.add_arg(stable_type_key_for_type(ctx, handle.element));
    return key;
}

object_key.StableSentinel? stable_sentinel(context.CompilerContext& ctx, types.Sentinel? sentinel) {
    if (sentinel is .some(value)) {
        return object_key.StableSentinel(stable_comptime_value_fingerprint(ctx, value.value));
    }
    return null;
}

qkey.Fingerprint128 stable_comptime_value_fingerprint(
    context.CompilerContext& ctx,
    comptime_value.ComptimeValue value
) {
    // Sentinel 现在可以是 bool/char/enum/struct 等完整 comptime 值，object key
    // 不能再只记录整数；这里把类型和值一起写入稳定指纹，避免不同 sentinel 共用缓存产物。
    hash.WyHasher low! = hash.WyHasher();
    low.write(UInt64(1469598103934665603));
    ref! _ low_ref = low;
    write_stable_comptime_value(ctx, low_ref, value);

    hash.WyHasher high! = hash.WyHasher();
    high.write(UInt64(1099511628211));
    ref! _ high_ref = high;
    write_stable_comptime_value(ctx, high_ref, value);
    return qkey.Fingerprint128(low.finish(), high.finish());
}

() write_stable_comptime_value(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeValue value
) {
    // 同一个字面值在不同 expected type 下语义不同，例如 0 可是 Int 也可是 UInt8。
    // 因此稳定 key 必须先写 type key，再写具体 comptime payload。
    object_key.StableTypeKey type_key = stable_type_key_for_type(ctx, value.type_id);
    object_key.write_stable_type_key(hasher, type_key$.ref());
    write_stable_comptime_value_data(ctx, hasher, value.data);
}

() write_stable_comptime_value_data(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeValueData data
) {
    if (data is .invalid) { hasher.write(Int(1)); return; }
    if (data is .unit_value) { hasher.write(Int(2)); return; }
    if (data is .bool_value(bool_value)) {
        hasher.write(Int(3));
        hasher.write(bool_value);
        return;
    }
    if (data is .int_value(int_value)) {
        hasher.write(Int(4));
        hasher.write(Int(int_value));
        return;
    }
    if (data is .uint_value(uint_value)) {
        hasher.write(Int(5));
        hasher.write(UInt64(uint_value));
        return;
    }
    write_stable_aggregate_comptime_value(ctx, hasher, data);
}

() write_stable_aggregate_comptime_value(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeValueData data
) {
    if (data is .char_value(char_value)) {
        hasher.write(Int(6));
        hasher.write(UInt64(char_value));
        return;
    }
    if (data is .float_bits(float_bits)) {
        hasher.write(Int(7));
        hasher.write(UInt64(float_bits));
        return;
    }
    if (data is .string_value(string_value)) {
        hasher.write(Int(8));
        hasher.write(Int(string_value.length));
        hasher.write(string_value);
        return;
    }
    if (data is .symbol_value(symbol_value)) {
        hasher.write(Int(9));
        hasher.write(ctx.store.symbols.text(symbol_value));
        return;
    }
    write_stable_named_comptime_value(ctx, hasher, data);
}

() write_stable_named_comptime_value(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeValueData data
) {
    if (data is .const_param_value(const_param)) {
        hasher.write(Int(10));
        write_stable_def_id(ctx, hasher, const_param);
        return;
    }
    if (data is .enum_case_value(case_def)) {
        hasher.write(Int(11));
        write_stable_def_id(ctx, hasher, case_def);
        return;
    }
    if (data is .struct_value(fields)) {
        hasher.write(Int(12));
        hasher.write(Int(fields.length));
        write_stable_comptime_fields(ctx, hasher, fields);
        return;
    }
    if (data is .tuple_value(items)) {
        hasher.write(Int(13));
        write_stable_comptime_values(ctx, hasher, items);
        return;
    }
    if (data is .array_value(items)) {
        hasher.write(Int(14));
        write_stable_comptime_values(ctx, hasher, items);
        return;
    }
    hasher.write(Int(0));
}

() write_stable_comptime_fields(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeAggregateField[]& fields
) {
    Int index! = 0;
    while (index < fields.length) {
        write_stable_def_id(ctx, hasher, fields[index].field_def);
        write_stable_comptime_value(ctx, hasher, fields[index].value);
        index = index + 1;
    }
}

() write_stable_comptime_values(
    context.CompilerContext& ctx,
    hash.WyHasher&! hasher,
    comptime_value.ComptimeValue[]& items
) {
    hasher.write(Int(items.length));
    Int index! = 0;
    while (index < items.length) {
        write_stable_comptime_value(ctx, hasher, items[index]);
        index = index + 1;
    }
}

() write_stable_def_id(context.CompilerContext& ctx, hash.WyHasher&! hasher, qid.DefId def_id) {
    // 跨编译会话优先使用 incremental stable id；没有 stable id 的临时 def 退回本次
    // 会话内 id，保证同一次构建内 object key 仍然可区分。
    if (ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id)) {
        hasher.write(UInt64(stable_id.low));
        hasher.write(UInt64(stable_id.high));
        return;
    }
    hasher.write(Int(def_id.to_index()));
    hasher.write(UInt64(0));
}

object_key.StableTypeKeyKind stable_handle_kind(types.HandleTypeKind kind) {
    if (kind == .owner_pointer) { return .owned_type; }
    if (kind == .reference) { return .reference_type; }
    if (kind == .raw_pointer) { return .raw_pointer_type; }
    return .slice_type;
}

object_key.StableTypeKey stable_type_array_key(
    context.CompilerContext& ctx,
    object_key.StableTypeKeyKind kind,
    qid.TypeId[]& items
) {
    object_key.StableTypeKey key! = object_key.StableTypeKey(kind);
    Int index! = 0;
    while (index < items.length) {
        key.add_arg(stable_type_key_for_type(ctx, items[index]));
        index = index + 1;
    }
    return key;
}

object_key.StableTypeKey stable_builtin(Int tag) {
    return object_key.StableTypeKey.builtin_type(tag);
}

Int int_builtin_tag(types.IntType int_type) {
    if (int_type.signed) {
        return 1000 + int_type.bits;
    }
    return 2000 + int_type.bits;
}
