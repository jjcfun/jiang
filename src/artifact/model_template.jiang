Int sentinel_kind_tag(sem.SentinelKind kind) {
    if (kind == .value) { return 1; }
    if (kind == .wildcard) { return 2; }
    if (kind == .const_name) { return 3; }
    if (kind == .char_value) { return 4; }
    if (kind == .bool_value) { return 5; }
    return 0;
}

sem.SentinelKind sentinel_kind_from_tag(Int tag) {
    if (tag == 1) { return .value; }
    if (tag == 2) { return .wildcard; }
    if (tag == 3) { return .const_name; }
    if (tag == 4) { return .char_value; }
    if (tag == 5) { return .bool_value; }
    return .none;
}

Int max_one(Int value) {
    if (value > 0) { return value; }
    return 1;
}

UInt64 float64_to_bits(Float64 value) {
    unsafe {
        Float64*! input = Float64$.alloc(1);
        UInt64*! output = UInt64$.alloc(1);
        input[0] = value;
        memory.copy_bytes(output[0]$.ptr()$.as(UInt8*), input[0]$.ptr()$.as(UInt8*), 8);
        UInt64 result = output[0];
        input$.dealloc();
        output$.dealloc();
        return result;
    }
}

Float64 float64_from_bits(UInt64 bits) {
    unsafe {
        UInt64*! input = UInt64$.alloc(1);
        Float64*! output = Float64$.alloc(1);
        input[0] = bits;
        memory.copy_bytes(output[0]$.ptr()$.as(UInt8*), input[0]$.ptr()$.as(UInt8*), 8);
        Float64 result = output[0];
        input$.dealloc();
        output$.dealloc();
        return result;
    }
}
