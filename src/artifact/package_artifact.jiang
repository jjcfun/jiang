// Package-level artifact cache keys and paths.
//
// This layer is intentionally narrow: it only covers artifacts whose cache
// boundary is a package. Per-source `.ji` files and debug source `.o` reuse keep
// their more precise source/module artifact logic.

import driver_options = "../driver/options.jiang";
import hash = "../support/hash.jiang";
import system_fs = "../system/fs.jiang";
import artifact_path = "./path.jiang";
import std;

public enum PackageArtifactKind {
    package_object,
    lang_provider_dynamic_library,
}

@region(a)
public struct PackageArtifactKey: Copyable {
    public PackageArtifactKind kind;

    public UInt64 package_hash;

    public UInt64 compiler_hash;

    public UInt64 wrapper_hash;

    @life(a)
    public UInt8[]& target_cache_key;

    public driver_options.CompileMode mode;

    public init(self,
        PackageArtifactKind kind,
        UInt64 package_hash,
        UInt64 compiler_hash,
        UInt64 wrapper_hash,
        UInt8[]& target_cache_key,
        driver_options.CompileMode mode
    ) {
        self.kind = kind;
        self.package_hash = package_hash;
        self.compiler_hash = compiler_hash;
        self.wrapper_hash = wrapper_hash;
        self.target_cache_key = target_cache_key;
        self.mode = mode;
    }
}

public UInt8[]^ artifact_path_for(
    UInt8[]& cache_root,
    PackageArtifactKey& key,
    UInt8[]& extension
) {
    UInt8[]^ hash_text = artifact_hash_text(key);
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(kind_prefix(key.kind));
    builder.append("_");
    builder.append(hash_text[..]);
    builder.append(extension);
    UInt8[]^ name = builder.into_slice();
    if (key.kind == .lang_provider_dynamic_library) {
        UInt8[]^ dir = artifact_path.lang_dir(cache_root);
        return std.path.join(dir[..], name[..]).into_slice();
    }
    UInt8[]^ dir = artifact_path.object_dir(cache_root);
    return std.path.join(dir[..], name[..]).into_slice();
}

public Bool exists(UInt8[]& cache_root, PackageArtifactKey& key, UInt8[]& extension) {
    UInt8[]^ path = artifact_path_for(cache_root, key, extension);
    return system_fs.file_exists(path[..]);
}

UInt8[]^ artifact_hash_text(PackageArtifactKey& key) {
    return uint64_text_owned(hash_key(key));
}

UInt64 hash_key(PackageArtifactKey& key) {
    hash.WyHasher hasher! = hash.WyHasher();
    hasher.write("package-artifact");
    hasher.write(Int(key.kind));
    hasher.write(UInt64(key.package_hash));
    hasher.write(UInt64(key.compiler_hash));
    hasher.write(UInt64(key.wrapper_hash));
    hasher.write(key.target_cache_key);
    hasher.write(Int(key.mode));
    return hasher.finish();
}

@life()
UInt8[]& kind_prefix(PackageArtifactKind kind) {
    if (kind == .lang_provider_dynamic_library) {
        return "lang";
    }
    return "package";
}

@life()
UInt8[]& uint64_text(UInt64 value) {
    if (value == 0) {
        return "0";
    }

    UInt64 remaining! = value;
    Int digit_count! = 0;
    while (remaining > 0) {
        digit_count = digit_count + 1;
        remaining = remaining / UInt64(10);
    }

    unsafe {
        UInt8*! bytes = UInt8$.alloc(digit_count + 1);
        remaining = value;
        Int write! = digit_count - 1;
        while (write >= 0) {
            UInt64 digit = remaining % UInt64(10);
            bytes[write] = UInt8(UInt64(48) + digit);
            remaining = remaining / UInt64(10);
            write = write - 1;
        }
        bytes[digit_count] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..digit_count];
    }
}

UInt8[]^ uint64_text_owned(UInt64 value) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(value);
    return builder.into_slice();
}
