// Object artifact cache 的内存边界。
//
// semantic interface 放在 source.jiang；这里仅记录 backend object 产物。
// 第一版只提供内存 API，后续再把 key/path/object hash 落盘。

import core_traits = "../core/traits.jiang";
import qkey = "../incremental/key.jiang";
import hash = "../support/hash.jiang";

public enum ObjectArtifactStatus {
    missing,
    hit,
    stale,
}

public struct SourceObjectKey: Copyable, Hashable, Equatable {
    public qkey.StableSymbolId module_stable_id;
    public UInt64 source_hash;
    public qkey.Fingerprint128 interface_hash;
    public qkey.Fingerprint128 body_hash;
    public qkey.Fingerprint128 layout_hash;
    public qkey.Fingerprint128 target_hash;
    public qkey.Fingerprint128 compiler_hash;
    public qkey.Fingerprint128 backend_profile_hash;

    public init(self,
        qkey.StableSymbolId module_stable_id,
        UInt64 source_hash,
        qkey.Fingerprint128 interface_hash,
        qkey.Fingerprint128 body_hash,
        qkey.Fingerprint128 layout_hash,
        qkey.Fingerprint128 target_hash,
        qkey.Fingerprint128 compiler_hash,
        qkey.Fingerprint128 backend_profile_hash
    ) {
        self.module_stable_id = module_stable_id;
        self.source_hash = source_hash;
        self.interface_hash = interface_hash;
        self.body_hash = body_hash;
        self.layout_hash = layout_hash;
        self.target_hash = target_hash;
        self.compiler_hash = compiler_hash;
        self.backend_profile_hash = backend_profile_hash;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.module_stable_id.hash(hasher);
        hasher.write(UInt64(self.source_hash));
        self.interface_hash.hash(hasher);
        self.body_hash.hash(hasher);
        self.layout_hash.hash(hasher);
        self.target_hash.hash(hasher);
        self.compiler_hash.hash(hasher);
        self.backend_profile_hash.hash(hasher);
    }

    public Bool equal(SourceObjectKey& lhs, SourceObjectKey& rhs) {
        if (lhs.module_stable_id != rhs.module_stable_id) { return false; }
        if (lhs.source_hash != rhs.source_hash) { return false; }
        if (lhs.interface_hash != rhs.interface_hash) { return false; }
        if (lhs.body_hash != rhs.body_hash) { return false; }
        if (lhs.layout_hash != rhs.layout_hash) { return false; }
        if (lhs.target_hash != rhs.target_hash) { return false; }
        if (lhs.compiler_hash != rhs.compiler_hash) { return false; }
        return lhs.backend_profile_hash == rhs.backend_profile_hash;
    }
}

public qkey.Fingerprint128 source_object_fingerprint(SourceObjectKey key) {
    hash.WyHasher low! = hash.WyHasher();
    low.write("source-object-key-low");
    hash.WyHasher&! low_ref = low$.mut_ref();
    key.hash(low_ref);

    hash.WyHasher high! = hash.WyHasher();
    high.write("source-object-key-high");
    hash.WyHasher&! high_ref = high$.mut_ref();
    key.hash(high_ref);
    return qkey.Fingerprint128(low.finish(), high.finish());
}

public qkey.Fingerprint128 source_object_definition_fingerprint(SourceObjectKey key) {
    hash.WyHasher low! = hash.WyHasher();
    low.write("source-object-definition-low");
    key.module_stable_id.hash(low$.mut_ref());

    hash.WyHasher high! = hash.WyHasher();
    high.write("source-object-definition-high");
    key.module_stable_id.hash(high$.mut_ref());
    return qkey.Fingerprint128(low.finish(), high.finish());
}

public struct ObjectArtifactCache: Movable {
    public ObjectArtifactStats stats!;

    public init(self) {
        self.stats = ObjectArtifactStats();
    }

    public Void reset_stats(self) {
        self.stats = ObjectArtifactStats();
    }

    public Void record_source_lookup(self, ObjectArtifactStatus status) {
        self.stats.add_source(status);
    }

    public Void record_monomorph_lookup(self, ObjectArtifactStatus status) {
        self.stats.add_monomorph(status);
    }

    public Void record_unsupported_unit(self) {
        self.stats.unsupported = self.stats.unsupported + 1;
    }

    public Void record_reused_unit(self) {
        self.stats.reused_units = self.stats.reused_units + 1;
    }

    public Void record_emitted_unit(self) {
        self.stats.emitted_units = self.stats.emitted_units + 1;
    }

    public Void record_linked_objects(self, Int count) {
        self.stats.linked_objects = count;
    }

    public Void record_no_op_hit(self) {
        self.stats.no_op_hits = 1;
    }

}

public struct ObjectArtifactStats: Copyable {
    public Int source_hit!;
    public Int source_missing!;
    public Int source_stale!;
    public Int monomorph_hit!;
    public Int monomorph_missing!;
    public Int monomorph_stale!;
    public Int unsupported!;
    public Int emitted_units!;
    public Int reused_units!;
    public Int linked_objects!;
    public Int no_op_hits!;

    public init(self) {
        self.source_hit = 0;
        self.source_missing = 0;
        self.source_stale = 0;
        self.monomorph_hit = 0;
        self.monomorph_missing = 0;
        self.monomorph_stale = 0;
        self.unsupported = 0;
        self.emitted_units = 0;
        self.reused_units = 0;
        self.linked_objects = 0;
        self.no_op_hits = 0;
    }

    public Int hit_count(self) {
        return self.source_hit + self.monomorph_hit;
    }

    public Int missing_count(self) {
        return self.source_missing + self.monomorph_missing;
    }

    public Int stale_count(self) {
        return self.source_stale + self.monomorph_stale;
    }

    Void add_source(self, ObjectArtifactStatus status) {
        if (status == .hit) {
            self.source_hit = self.source_hit + 1;
        } else if (status == .missing) {
            self.source_missing = self.source_missing + 1;
        } else {
            self.source_stale = self.source_stale + 1;
        }
    }

    Void add_monomorph(self, ObjectArtifactStatus status) {
        if (status == .hit) {
            self.monomorph_hit = self.monomorph_hit + 1;
        } else if (status == .missing) {
            self.monomorph_missing = self.monomorph_missing + 1;
        } else {
            self.monomorph_stale = self.monomorph_stale + 1;
        }
    }

}

Void write_fingerprint(hash.WyHasher&! hasher, qkey.Fingerprint128 fingerprint) {
    hasher.write(UInt64(fingerprint.low));
    hasher.write(UInt64(fingerprint.high));
}
