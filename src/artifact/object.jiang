// Object artifact cache 的内存边界。
//
// semantic interface 放在 source.jiang；这里仅记录 backend object 产物。
// 第一版只提供内存 API，后续再把 key/path/object hash 落盘。

import object_key = "./object_key.jiang";
import qkey = "../query/key.jiang";
import hash = "../support/hash.jiang";
import table = "../support/table.jiang";

public enum ObjectArtifactKind {
    source_object,
    monomorph_object,
}

public enum ObjectArtifactStatus {
    missing,
    hit,
    stale,
}

public struct SourceObjectKey: Hashable, Equatable {
    public qkey.StableSymbolId module_stable_id;
    public UInt64 source_hash;
    public qkey.Fingerprint128 interface_hash;
    public qkey.Fingerprint128 body_hash;
    public qkey.Fingerprint128 layout_hash;
    public qkey.Fingerprint128 target_hash;
    public qkey.Fingerprint128 compiler_hash;

    public init(
        qkey.StableSymbolId module_stable_id,
        UInt64 source_hash,
        qkey.Fingerprint128 interface_hash,
        qkey.Fingerprint128 body_hash,
        qkey.Fingerprint128 layout_hash,
        qkey.Fingerprint128 target_hash,
        qkey.Fingerprint128 compiler_hash
    ) {
        self.module_stable_id = module_stable_id;
        self.source_hash = source_hash;
        self.interface_hash = interface_hash;
        self.body_hash = body_hash;
        self.layout_hash = layout_hash;
        self.target_hash = target_hash;
        self.compiler_hash = compiler_hash;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_uint64(self.module_stable_id.low);
        hasher.write_uint64(self.module_stable_id.high);
        hasher.write_uint64(self.source_hash);
        write_fingerprint(hasher$.ref(), self.interface_hash);
        write_fingerprint(hasher$.ref(), self.body_hash);
        write_fingerprint(hasher$.ref(), self.layout_hash);
        write_fingerprint(hasher$.ref(), self.target_hash);
        write_fingerprint(hasher$.ref(), self.compiler_hash);
        return hasher.finish();
    }

    public static Bool equal(SourceObjectKey& lhs, SourceObjectKey& rhs) {
        if (lhs.module_stable_id != rhs.module_stable_id) { return false; }
        if (lhs.source_hash != rhs.source_hash) { return false; }
        if (lhs.interface_hash != rhs.interface_hash) { return false; }
        if (lhs.body_hash != rhs.body_hash) { return false; }
        if (lhs.layout_hash != rhs.layout_hash) { return false; }
        if (lhs.target_hash != rhs.target_hash) { return false; }
        return lhs.compiler_hash == rhs.compiler_hash;
    }
}

public struct ObjectArtifactRecord: Movable {
    public ObjectArtifactKind kind;
    public qkey.Fingerprint128 object_hash;
    public UInt8[] path;

    public init(ObjectArtifactKind kind, qkey.Fingerprint128 object_hash, UInt8[] path) {
        self.kind = kind;
        self.object_hash = object_hash;
        self.path = path;
    }
}

public struct ObjectArtifactLookup {
    public ObjectArtifactStatus status;
    public ObjectArtifactKind kind;
    public qkey.Fingerprint128 object_hash;
    public UInt8[] path;

    public init(
        ObjectArtifactStatus status,
        ObjectArtifactKind kind,
        qkey.Fingerprint128 object_hash,
        UInt8[] path
    ) {
        self.status = status;
        self.kind = kind;
        self.object_hash = object_hash;
        self.path = path;
    }

    public static ObjectArtifactLookup make_missing(ObjectArtifactKind kind) {
        return ObjectArtifactLookup(.missing, kind, qkey.Fingerprint128(), "");
    }

    public static ObjectArtifactLookup make_hit(
        ObjectArtifactKind kind,
        qkey.Fingerprint128 object_hash,
        UInt8[] path
    ) {
        return ObjectArtifactLookup(.hit, kind, object_hash, path);
    }

    public static ObjectArtifactLookup make_stale(
        ObjectArtifactKind kind,
        qkey.Fingerprint128 object_hash,
        UInt8[] path
    ) {
        return ObjectArtifactLookup(.stale, kind, object_hash, path);
    }
}

public struct ObjectArtifactCache: Movable {
    table.HashTable<SourceObjectKey, ObjectArtifactRecord> source_objects;
    table.HashTable<qkey.Fingerprint128, ObjectArtifactRecord> monomorph_objects;

    public init() {
        self.source_objects = table.HashTable<SourceObjectKey, ObjectArtifactRecord>();
        self.monomorph_objects = table.HashTable<qkey.Fingerprint128, ObjectArtifactRecord>();
    }

    public () store_source_object(SourceObjectKey key, ObjectArtifactRecord artifact) {
        self.source_objects.set(key, artifact$.move());
    }

    @life(self > return)
    public ObjectArtifactRecord&? load_source_object(SourceObjectKey key) {
        return self.source_objects.get(key);
    }

    public ObjectArtifactLookup lookup_source_object(SourceObjectKey key) {
        guard self.load_source_object(key) is some artifact else {
            return ObjectArtifactLookup.make_missing(.source_object);
        }
        return ObjectArtifactLookup.make_hit(artifact.kind, artifact.object_hash, artifact.path);
    }

    // validate_* 不读文件。调用方负责从磁盘读取 object 并计算 actual hash；
    // cache 这里只比较记录值，避免 backend cache 依赖具体文件系统实现。
    public ObjectArtifactLookup validate_source_object(
        SourceObjectKey key,
        qkey.Fingerprint128 actual_hash
    ) {
        guard self.load_source_object(key) is some artifact else {
            return ObjectArtifactLookup.make_missing(.source_object);
        }
        if (artifact.object_hash != actual_hash) {
            return ObjectArtifactLookup.make_stale(artifact.kind, artifact.object_hash, artifact.path);
        }
        return ObjectArtifactLookup.make_hit(artifact.kind, artifact.object_hash, artifact.path);
    }

    public () store_monomorph_object(
        object_key.StableInstanceKey& key,
        ObjectArtifactRecord artifact
    ) {
        self.monomorph_objects.set(object_key.stable_instance_fingerprint(key), artifact$.move());
    }

    @life(self > return)
    public ObjectArtifactRecord&? load_monomorph_object(object_key.StableInstanceKey& key) {
        return self.monomorph_objects.get(object_key.stable_instance_fingerprint(key));
    }

    public ObjectArtifactLookup lookup_monomorph_object(object_key.StableInstanceKey& key) {
        guard self.load_monomorph_object(key) is some artifact else {
            return ObjectArtifactLookup.make_missing(.monomorph_object);
        }
        return ObjectArtifactLookup.make_hit(artifact.kind, artifact.object_hash, artifact.path);
    }

    public ObjectArtifactLookup validate_monomorph_object(
        object_key.StableInstanceKey& key,
        qkey.Fingerprint128 actual_hash
    ) {
        guard self.load_monomorph_object(key) is some artifact else {
            return ObjectArtifactLookup.make_missing(.monomorph_object);
        }
        if (artifact.object_hash != actual_hash) {
            return ObjectArtifactLookup.make_stale(artifact.kind, artifact.object_hash, artifact.path);
        }
        return ObjectArtifactLookup.make_hit(artifact.kind, artifact.object_hash, artifact.path);
    }
}

() write_fingerprint(hash.WyHasher& hasher, qkey.Fingerprint128 fingerprint) {
    hasher.write_uint64(fingerprint.low);
    hasher.write_uint64(fingerprint.high);
}
