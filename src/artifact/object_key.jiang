// Object cache 使用的稳定 key。
//
// sema/monomorph.InstanceKey 使用 DefId + TypeId[]&，只适合一次 session 内的
// 去重。这里的 key 不保存 session-local id，只保存 stable symbol 和 fingerprint。

import qkey = "../incremental/key.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";

public enum StableTypeKeyKind {
    invalid_type,
    builtin_type,
    named_type,
    optional_type,
    error_union_type,
    owned_type,
    reference_type,
    raw_pointer_type,
    many_pointer_type,
    slice_type,
    slice_value_type,
    array_type,
    tuple_type,
    function_type,
}

public struct StableSentinel {
    public UInt64 integer_value;

    public init(UInt64 integer_value) {
        self.integer_value = integer_value;
    }
}

public struct StableTypeKey: Movable, Hashable, Equatable {
    public StableTypeKeyKind kind;
    public Int! builtin_tag;
    public Int! array_length;
    public StableSentinel? sentinel;
    public Bool! has_stable_def;
    public UInt64! stable_def_low;
    public UInt64! stable_def_high;
    public list.ArrayList<StableTypeKey> args;

    public init(StableTypeKeyKind kind) {
        self.kind = kind;
        self.builtin_tag = 0;
        self.array_length = 0;
        self.sentinel = null;
        self.has_stable_def = false;
        self.stable_def_low = 0;
        self.stable_def_high = 0;
        self.args = list.ArrayList<StableTypeKey>();
    }

    public static StableTypeKey builtin_type(Int builtin_tag) {
        StableTypeKey! key = StableTypeKey(.builtin_type);
        key.builtin_tag = builtin_tag;
        return key$.move();
    }

    public static StableTypeKey named_type(UInt64 stable_def_low, UInt64 stable_def_high) {
        StableTypeKey! key = StableTypeKey(.named_type);
        key.has_stable_def = true;
        key.stable_def_low = stable_def_low;
        key.stable_def_high = stable_def_high;
        return key$.move();
    }

    public () add_arg(StableTypeKey arg) {
        self.args.add(arg$.move());
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(Int(self.kind));
        hasher.write_int(self.builtin_tag);
        hasher.write_int(self.array_length);
        write_stable_sentinel(hasher$.ref(), self.sentinel);
        hasher.write_bool(self.has_stable_def);
        hasher.write_uint64(self.stable_def_low);
        hasher.write_uint64(self.stable_def_high);
        write_stable_type_args(hasher$.ref(), self.args$.ref());
        return hasher.finish();
    }

    public static Bool equal(StableTypeKey& lhs, StableTypeKey& rhs) {
        StableTypeKeyKind lhs_kind = lhs.kind;
        StableTypeKeyKind rhs_kind = rhs.kind;
        Int lhs_kind_value = Int(lhs_kind);
        Int rhs_kind_value = Int(rhs_kind);
        if (lhs_kind_value != rhs_kind_value) { return false; }
        if (lhs.builtin_tag != rhs.builtin_tag) { return false; }
        if (lhs.array_length != rhs.array_length) { return false; }
        if (!stable_sentinel_equal(lhs.sentinel, rhs.sentinel)) { return false; }
        if (lhs.has_stable_def != rhs.has_stable_def) { return false; }
        if (lhs.stable_def_low != rhs.stable_def_low) { return false; }
        if (lhs.stable_def_high != rhs.stable_def_high) { return false; }
        if (lhs.args.len() != rhs.args.len()) { return false; }

        Int! index = 0;
        while (index < lhs.args.len()) {
            StableTypeKey& left_arg = lhs.args.ref_at(index);
            StableTypeKey& right_arg = rhs.args.ref_at(index);
            if (!StableTypeKey.equal(left_arg, right_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public struct StableInstanceKey: Movable, Hashable, Equatable {
    public qkey.StableSymbolId owner;
    public list.ArrayList<StableTypeKey> type_args;
    public list.ArrayList<qkey.Fingerprint128> comptime_args;
    public qkey.Fingerprint128 body_hash;
    public qkey.Fingerprint128 layout_hash;
    public qkey.Fingerprint128 target_hash;
    public qkey.Fingerprint128 compiler_hash;
    public qkey.Fingerprint128 backend_profile_hash;

    public init(
        qkey.StableSymbolId owner,
        qkey.Fingerprint128 body_hash,
        qkey.Fingerprint128 layout_hash,
        qkey.Fingerprint128 target_hash,
        qkey.Fingerprint128 compiler_hash,
        qkey.Fingerprint128 backend_profile_hash
    ) {
        self.owner = owner;
        self.type_args = list.ArrayList<StableTypeKey>();
        self.comptime_args = list.ArrayList<qkey.Fingerprint128>();
        self.body_hash = body_hash;
        self.layout_hash = layout_hash;
        self.target_hash = target_hash;
        self.compiler_hash = compiler_hash;
        self.backend_profile_hash = backend_profile_hash;
    }

    public () add_type_arg(StableTypeKey type_arg) {
        self.type_args.add(type_arg$.move());
    }

    public () add_comptime_arg(qkey.Fingerprint128 comptime_arg) {
        self.comptime_args.add(comptime_arg);
    }

    public UInt64 hash() {
        hash.WyHasher low = hash.WyHasher();
        low.write_uint64(6148914691236517205);
        write_stable_instance_key_fields(
            low$.ref(),
            self.owner,
            self.type_args$.ref(),
            self.comptime_args$.ref(),
            self.body_hash,
            self.layout_hash,
            self.target_hash,
            self.compiler_hash,
            self.backend_profile_hash
        );
        return low.finish();
    }

    public static Bool equal(StableInstanceKey& lhs, StableInstanceKey& rhs) {
        if (lhs.owner != rhs.owner) { return false; }
        if (lhs.body_hash != rhs.body_hash) { return false; }
        if (lhs.layout_hash != rhs.layout_hash) { return false; }
        if (lhs.target_hash != rhs.target_hash) { return false; }
        if (lhs.compiler_hash != rhs.compiler_hash) { return false; }
        if (lhs.backend_profile_hash != rhs.backend_profile_hash) { return false; }
        if (!stable_type_args_equal(lhs.type_args$.ref(), rhs.type_args$.ref())) { return false; }
        return fingerprint_args_equal(lhs.comptime_args$.ref(), rhs.comptime_args$.ref());
    }
}

public qkey.Fingerprint128 stable_instance_fingerprint(StableInstanceKey& key) {
    hash.WyHasher low = hash.WyHasher();
    low.write_uint64(6148914691236517205);
    write_stable_instance_key(low$.ref(), key);

    hash.WyHasher high = hash.WyHasher();
    high.write_uint64(12297829382473034410);
    write_stable_instance_key(high$.ref(), key);
    return qkey.Fingerprint128(low.finish(), high.finish());
}

public qkey.Fingerprint128 combine_fingerprints(UInt64 domain, list.ArrayList<qkey.Fingerprint128>& parts) {
    hash.WyHasher low = hash.WyHasher();
    low.write_uint64(3141592653589793238);
    low.write_uint64(domain);
    write_fingerprint_list(low$.ref(), parts);

    hash.WyHasher high = hash.WyHasher();
    high.write_uint64(2718281828459045235);
    high.write_uint64(domain);
    write_fingerprint_list(high$.ref(), parts);
    return qkey.Fingerprint128(low.finish(), high.finish());
}

public () write_stable_instance_key(hash.WyHasher& hasher, StableInstanceKey& key) {
    write_stable_instance_key_fields(
        hasher,
        key.owner,
        key.type_args$.ref(),
        key.comptime_args$.ref(),
        key.body_hash,
        key.layout_hash,
        key.target_hash,
        key.compiler_hash,
        key.backend_profile_hash
    );
}

() write_stable_instance_key_fields(
    hash.WyHasher& hasher,
    qkey.StableSymbolId owner,
    list.ArrayList<StableTypeKey>& type_args,
    list.ArrayList<qkey.Fingerprint128>& comptime_args,
    qkey.Fingerprint128 body_hash,
    qkey.Fingerprint128 layout_hash,
    qkey.Fingerprint128 target_hash,
    qkey.Fingerprint128 compiler_hash,
    qkey.Fingerprint128 backend_profile_hash
) {
    write_stable_id(hasher, owner);
    write_stable_type_args(hasher, type_args);
    write_fingerprint_args(hasher, comptime_args);
    write_fingerprint(hasher, body_hash);
    write_fingerprint(hasher, layout_hash);
    write_fingerprint(hasher, target_hash);
    write_fingerprint(hasher, compiler_hash);
    write_fingerprint(hasher, backend_profile_hash);
}

() write_fingerprint_list(hash.WyHasher& hasher, list.ArrayList<qkey.Fingerprint128>& parts) {
    hasher.write_int(parts.len());
    Int! index = 0;
    while (index < parts.len()) {
        write_fingerprint(hasher, parts.get(index));
        index = index + 1;
    }
}

public () write_stable_type_key(hash.WyHasher& hasher, StableTypeKey& key) {
    hasher.write_int(Int(key.kind));
    hasher.write_int(key.builtin_tag);
    hasher.write_int(key.array_length);
    write_stable_sentinel(hasher, key.sentinel);
    hasher.write_bool(key.has_stable_def);
    hasher.write_uint64(key.stable_def_low);
    hasher.write_uint64(key.stable_def_high);
    write_stable_type_args(hasher, key.args$.ref());
}

() write_stable_sentinel(hash.WyHasher& hasher, StableSentinel? sentinel) {
    if (sentinel is some value) {
        hasher.write_bool(true);
        hasher.write_uint64(value.integer_value);
        return;
    }
    hasher.write_bool(false);
    hasher.write_uint64(UInt64(0));
}

Bool stable_sentinel_equal(StableSentinel? lhs, StableSentinel? rhs) {
    if (lhs is some lhs_value) {
        guard rhs is some rhs_value else { return false; }
        return lhs_value.integer_value == rhs_value.integer_value;
    }
    return rhs == null;
}

() write_stable_type_args(hash.WyHasher& hasher, list.ArrayList<StableTypeKey>& args) {
    hasher.write_int(args.len());
    Int! index = 0;
    while (index < args.len()) {
        StableTypeKey& arg = args.ref_at(index);
        write_stable_type_key(hasher, arg);
        index = index + 1;
    }
}

() write_fingerprint_args(hash.WyHasher& hasher, list.ArrayList<qkey.Fingerprint128>& args) {
    hasher.write_int(args.len());
    Int! index = 0;
    while (index < args.len()) {
        write_fingerprint(hasher, args.get(index));
        index = index + 1;
    }
}

() write_stable_id(hash.WyHasher& hasher, qkey.StableSymbolId stable_id) {
    hasher.write_uint64(stable_id.low);
    hasher.write_uint64(stable_id.high);
}

() write_fingerprint(hash.WyHasher& hasher, qkey.Fingerprint128 fingerprint) {
    hasher.write_uint64(fingerprint.low);
    hasher.write_uint64(fingerprint.high);
}

Bool stable_type_args_equal(list.ArrayList<StableTypeKey>& lhs, list.ArrayList<StableTypeKey>& rhs) {
    if (lhs.len() != rhs.len()) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.len()) {
        StableTypeKey& left_arg = lhs.ref_at(index);
        StableTypeKey& right_arg = rhs.ref_at(index);
        if (!StableTypeKey.equal(left_arg, right_arg)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool fingerprint_args_equal(
    list.ArrayList<qkey.Fingerprint128>& lhs,
    list.ArrayList<qkey.Fingerprint128>& rhs
) {
    if (lhs.len() != rhs.len()) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.len()) {
        if (lhs.get(index) != rhs.get(index)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}
