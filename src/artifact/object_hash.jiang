// Backend artifact 内容 hash。
//
// ObjectArtifactCache 只比较调用方传入的 hash；这里提供文件/字节到稳定
// fingerprint 的转换，避免 cache 本身依赖文件系统。

import qkey = "../incremental/key.jiang";
import blake3 = "../support/blake3.jiang";
import fs = "../system/fs.jiang";

public qkey.Fingerprint128 hash_bytes(UInt8[] bytes) {
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes);
    return qkey.Fingerprint128(digest.a, digest.b);
}

public qkey.Fingerprint128? hash_file(UInt8[] path) {
    guard fs.read_all(path) is some bytes else { return null; }
    return hash_bytes(bytes);
}
