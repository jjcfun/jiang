// 从当前 session 的 Def/HIR facts 构造可落盘 ModuleInterface。
//
// Interface 保存 public 语义事实和 private 声明壳。
//
// public declaration 需要完整签名，供依赖方继续 type check；private 声明只保存
// name/kind/owner/visibility，让跨模块访问能稳定报 private_access，而不是退化成
// unresolved。复杂 type ref 如果暂时不能稳定编码，宁可写成 invalid_type，也不能把
// session-local TypeId/HirId 写入 artifact。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import hir_template = "./hir_template.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import diagnostics = "../resolve/diagnostics.jiang";
import store = "../resolve/store.jiang";
import source = "../source/source.jiang";
import source_map = "../source/source_map.jiang";
import source_artifact = "./source.jiang";
import source_fingerprint = "./source_fingerprint.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import string = "../support/string.jiang";
import std;
import token = "../syntax/token.jiang";

public Bool store_module_interface(context.CompilerContext& ctx, qid.ModuleId module_id) {
    guard build_module_interface(ctx, module_id) is .some(module_interface) else {
        return false;
    }
    source.SourceId source_id = module_interface.source_id;
    ctx.store.artifacts.store_interface(source_id, module_interface);
    return true;
}

public source_artifact.ModuleInterface? build_module_interface(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    if (module_has_extension_group(ctx, module_id)) {
        // ModuleInterface does not encode extension groups yet. Emitting only their member
        // declarations would lose target patterns, trait refs, and where predicates on a hit.
        return null;
    }
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(module.package_id);
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    source_artifact.ModuleInterface module_interface! = source_artifact.ModuleInterface(
        module.source_id,
        source_record.content_hash,
        package_record.name,
        module.path_symbol
    );

    add_public_imports(ctx, module_interface$.ref(), module);
    add_public_members(ctx, module_interface$.ref(), module.def_id, module_is_package_root(ctx, module));
    module_interface.interface_hash = source_fingerprint.module_interface_fingerprint(
        ctx,
        module_interface$.ref()
    );
    return module_interface;
}

Bool module_has_extension_group(context.CompilerContext& ctx, qid.ModuleId module_id) {
    Int index! = 0;
    while (index < ctx.store.hirs.extension_group_len()) {
        hir.HirExtensionGroup& group = ctx.store.hirs.extension_group_ref(index);
        if (group.module_id == module_id) { return true; }
        index = index + 1;
    }
    return false;
}

() add_public_imports(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ModuleRecord& module
) {
    Int index! = 0;
    while (index < module.imports.len()) {
        store.ImportRecord import_record = module.imports.get(index);
        add_public_import(ctx, module_interface, import_record);
        index = index + 1;
    }
}

() add_public_import(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ImportRecord import_record
) {
    if (import_record.visibility != .public_visibility) {
        return;
    }
    module_interface.add_public_import(source_artifact.ImportSummaryEntry(
        import_record.kind,
        import_record.visibility,
        import_record.flatten,
        import_record.path_symbol,
        import_record.alias_symbol
    ));
    add_public_import_alias(ctx, module_interface, import_record);
}

() add_public_import_alias(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ImportRecord import_record
) {
    guard import_record.alias_def is .some(alias_def) else { return; }
    guard import_record.target_module is .some(target_module) else { return; }
    store.ModuleRecord& target = ctx.store.resolve.module_ref(target_module);
    guard ctx.store.incremental.stable_id_for_def(target.def_id) is .some(target_stable_id) else { return; }
    def.DefRecord alias_record = ctx.store.defs.get(alias_def);
    module_interface.add_public_alias(source_artifact.AliasExportSummary(
        alias_record.name.symbol,
        target_stable_id
    ));
}

() add_public_members(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qid.DefId owner_def,
    Bool validate_surface
) {
    hir.HirDef& owner_hir = ctx.store.hirs.def_ref(owner_def);
    Int index! = 0;
    while (index < owner_hir.members.len()) {
        qid.DefId member_def = owner_hir.members.get(index);
        add_public_member(ctx, module_interface, member_def, validate_surface);
        index = index + 1;
    }
}

() add_public_member(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qid.DefId member_def,
    Bool validate_surface
) {
    def.DefRecord def_record = ctx.store.defs.get(member_def);
    guard ctx.store.hirs.def(member_def) is .some(hir_def) else { return; }
    if (hir_def.decl.alias_target != null) {
        if (def_record.visibility != .public_visibility) { return; }
        if (validate_surface) {
            validate_public_alias_target(ctx, member_def, hir_def);
        }
        add_symbol_alias(ctx, module_interface, def_record, hir_def);
        return;
    }
    guard ctx.store.incremental.stable_id_for_def(member_def) is .some(stable_id) else { return; }
    source_artifact.InterfaceDeclSummary summary! = source_artifact.InterfaceDeclSummary(
        stable_id,
        def_record.kind,
        def_record.domain,
        def_record.visibility,
        def_record.name.symbol,
        stable_owner(ctx, def_record.owner_def)
    );
    summary.disambiguator = ctx.store.incremental.disambiguator_for_def(member_def);
    summary.signature_fingerprint = ctx.store.incremental.signature_fingerprint(stable_id);
    summary.mutable_binding = hir_def.decl.mutable_binding;
    summary.is_const = hir_def.decl.is_const;
    summary.is_external = hir_def.decl.is_external;
    summary.extern_kind = Int(hir_def.decl.extern_kind);
    summary.inline_mode = Int(hir_def.decl.inline_mode);
    summary.naked = hir_def.decl.naked;
    summary.link_symbol = hir_def.decl.link_symbol;
    summary.has_explicit_empty_lifetime_contract = hir_def.has_explicit_empty_lifetime_contract;
    module_interface.add_declaration(summary);
    // private 声明不会成为 public API，但依赖方仍需要它们的类型事实来完成
    // public nominal 的成员检查和 public generic template 的按需 type check。
    add_decl_type_ref(ctx, module_interface, stable_id, hir_def);
    add_trait_refs(ctx, module_interface, stable_id, hir_def);
    add_where_predicates(ctx, module_interface, stable_id, hir_def);
    add_lifetime_constraints(ctx, module_interface, stable_id, hir_def);
    add_region_schema(module_interface, stable_id, hir_def);
    add_life_clauses(ctx, module_interface, stable_id, hir_def);
    add_function_signature(ctx, module_interface, stable_id, hir_def);
    add_field_default(ctx, module_interface, stable_id, hir_def);
    add_const_value(ctx, module_interface, stable_id, member_def, hir_def);
    Bool is_public = def_record.visibility == .public_visibility;
    if (is_public && validate_surface) {
        validate_public_member(ctx, member_def, hir_def);
    }
    add_generic_template(ctx, module_interface, stable_id, hir_def);
    add_generic_params(ctx, module_interface, hir_def, is_public && validate_surface);
    if (!is_public) { return; }
    add_public_members(ctx, module_interface, member_def, validate_surface);
}

() add_field_default(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.field_default is .some(value) else { return; }
    UInt8[]& payload = hir_template.encode_expression(ctx, hir_def, value);
    if (payload.length == 0) { return; }
    module_interface.set_field_default(stable_id, payload);
}

() add_generic_params(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    hir.HirDef& owner,
    Bool validate_surface
) {
    Int index! = 0;
    while (index < owner.generic_params.len()) {
        add_public_member(ctx, module_interface, owner.generic_params.get(index), validate_surface);
        index = index + 1;
    }
}

Bool module_is_package_root(context.CompilerContext& ctx, store.ModuleRecord& module) {
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(module.package_id);
    if (module.path_symbol == package_record.root_path) { return true; }
    UInt8[]& module_path = ctx.store.symbols.text(module.path_symbol);
    UInt8[]& root_path = ctx.store.symbols.text(package_record.root_path);
    return string.equal(module_path, root_path);
}

() validate_public_member(context.CompilerContext& ctx, qid.DefId member_def, hir.HirDef& hir_def) {
    validate_public_decl_type_ref(ctx, member_def, hir_def);
    validate_public_trait_refs(ctx, member_def, hir_def);
    validate_public_where_predicates(ctx, member_def, hir_def);
    validate_public_function_signature(ctx, member_def, hir_def);
    validate_public_alias_target(ctx, member_def, hir_def);
}

() validate_public_decl_type_ref(context.CompilerContext& ctx, qid.DefId api_def, hir.HirDef& hir_def) {
    guard hir_def.decl.type_ref is .some(type_ref) else { return; }
    validate_public_type_ref(ctx, api_def, type_ref);
}

() validate_public_trait_refs(context.CompilerContext& ctx, qid.DefId api_def, hir.HirDef& hir_def) {
    Int index! = 0;
    while (index < hir_def.trait_refs.len()) {
        validate_public_type_ref(ctx, api_def, hir_def.trait_refs.get(index));
        index = index + 1;
    }
    index = 0;
    while (index < hir_def.negative_trait_refs.len()) {
        validate_public_type_ref(ctx, api_def, hir_def.negative_trait_refs.get(index));
        index = index + 1;
    }
}

() validate_public_where_predicates(context.CompilerContext& ctx, qid.DefId api_def, hir.HirDef& hir_def) {
    Int index! = 0;
    while (index < hir_def.where_predicates.len()) {
        validate_public_where_predicate(ctx, api_def, hir_def.where_predicates.get(index));
        index = index + 1;
    }
}

() validate_public_where_predicate(
    context.CompilerContext& ctx,
    qid.DefId api_def,
    hir.HirWherePredicate predicate
) {
    if (predicate is .const_type(constraint)) {
        validate_public_type_ref(ctx, api_def, constraint.type_ref);
        return;
    }
    if (predicate is .type_bound(bound)) {
        validate_public_type_bound(ctx, api_def, bound);
        return;
    }
    if (predicate is .negative_type_bound(bound)) {
        validate_public_type_bound(ctx, api_def, bound);
        return;
    }
    if (predicate is .equal(equal)) {
        validate_public_type_equal(ctx, api_def, equal);
        return;
    }
    if (predicate is .not_equal(equal)) {
        validate_public_type_equal(ctx, api_def, equal);
        return;
    }
    guard predicate is .projection_equal(projection) else { return; }
    validate_public_type_ref(ctx, api_def, projection.subject);
    validate_public_type_ref(ctx, api_def, projection.trait_ref);
    validate_public_type_ref(ctx, api_def, projection.value);
}

() validate_public_type_bound(context.CompilerContext& ctx, qid.DefId api_def, hir.HirWhereTypeBound bound) {
    validate_public_type_ref(ctx, api_def, bound.subject);
    validate_public_type_ref(ctx, api_def, bound.bound);
}

() validate_public_type_equal(context.CompilerContext& ctx, qid.DefId api_def, hir.HirWhereEqual equal) {
    validate_public_type_ref(ctx, api_def, equal.subject);
    validate_public_type_ref(ctx, api_def, equal.value);
}

() validate_public_function_signature(context.CompilerContext& ctx, qid.DefId api_def, hir.HirDef& hir_def) {
    guard hir_def.decl.function_signature is .some(signature) else { return; }
    validate_public_type_ref(ctx, api_def, signature.result);
    Int index! = 0;
    while (index < signature.params.length) {
        validate_public_type_ref(ctx, api_def, signature.params[index]);
        index = index + 1;
    }
}

() validate_public_alias_target(context.CompilerContext& ctx, qid.DefId api_def, hir.HirDef& hir_def) {
    guard hir_def.decl.alias_target is .some(target_def) else { return; }
    qid.DefId resolved = resolve_alias_target(ctx, target_def);
    validate_public_type_def(ctx, api_def, resolved);
    guard resolved.to_index() != api_def.to_index() else { return; }
    guard ctx.store.hirs.def(resolved) is .some(target_hir) else { return; }
    validate_public_member(ctx, resolved, target_hir);
}

() validate_public_type_ref(context.CompilerContext& ctx, qid.DefId api_def, hir.HirId type_ref) {
    hir.HirNode node = ctx.store.hirs.node(type_ref);
    if (node.data is .named_type_ref(named)) {
        validate_public_named_type_ref(ctx, api_def, named);
        return;
    }
    if (node.data is .trait_companion_type_ref(companion)) {
        validate_public_type_def(ctx, api_def, companion.trait_def);
        return;
    }
    if (node.data is .self_type_ref(self_def)) {
        validate_public_type_def(ctx, api_def, self_def);
        return;
    }
    validate_public_composite_type_ref(ctx, api_def, node.data);
}

() validate_public_named_type_ref(context.CompilerContext& ctx, qid.DefId api_def, hir.HirNamedTypeRef named) {
    if (validate_public_named_trait_companion_type_ref(ctx, api_def, named.def_id)) {
        return;
    }
    validate_public_type_def(ctx, api_def, named.def_id);
    Int index! = 0;
    while (index < named.args.length) {
        validate_public_type_ref(ctx, api_def, named.args[index]);
        index = index + 1;
    }
}

Bool validate_public_named_trait_companion_type_ref(
    context.CompilerContext& ctx,
    qid.DefId api_def,
    qid.DefId def_id
) {
    def.DefRecord record = ctx.store.defs.get(def_id);
    guard record.kind == .trait_companion_type_def else { return false; }
    guard record.trait_companion is .some(companion) else { return false; }
    validate_public_type_def(ctx, api_def, companion.trait_def);
    return true;
}

() validate_public_composite_type_ref(context.CompilerContext& ctx, qid.DefId api_def, hir.HirNodeData data) {
    if (data is .layered_type_ref(layered)) {
        validate_public_type_ref(ctx, api_def, layered.element);
        return;
    }
    if (data is .array_type_ref(array)) {
        validate_public_type_ref(ctx, api_def, array.element);
        return;
    }
    if (data is .errorable_type_ref(errorable)) {
        validate_public_errorable_type_ref(ctx, api_def, errorable);
        return;
    }
    validate_public_callable_or_tuple_type_ref(ctx, api_def, data);
}

() validate_public_errorable_type_ref(
    context.CompilerContext& ctx,
    qid.DefId api_def,
    hir.HirErrorableTypeRef errorable
) {
    validate_public_type_ref(ctx, api_def, errorable.value_type);
    guard errorable.error_type is .some(error_type) else { return; }
    validate_public_type_ref(ctx, api_def, error_type);
}

() validate_public_callable_or_tuple_type_ref(context.CompilerContext& ctx, qid.DefId api_def, hir.HirNodeData data) {
    if (data is .function_type_ref(function_type)) {
        validate_public_function_type_ref(ctx, api_def, function_type);
        return;
    }
    guard data is .tuple_type_ref(tuple) else { return; }
    Int index! = 0;
    while (index < tuple.items.length) {
        validate_public_type_ref(ctx, api_def, tuple.items[index]);
        index = index + 1;
    }
}

() validate_public_function_type_ref(
    context.CompilerContext& ctx,
    qid.DefId api_def,
    hir.HirFunctionTypeRef function_type
) {
    Int index! = 0;
    while (index < function_type.params.length) {
        validate_public_type_ref(ctx, api_def, function_type.params[index]);
        index = index + 1;
    }
    validate_public_type_ref(ctx, api_def, function_type.result);
}

() validate_public_type_def(context.CompilerContext& ctx, qid.DefId api_def, qid.DefId type_def) {
    qid.DefId resolved = resolve_alias_target(ctx, type_def);
    if (!same_package_def(ctx, api_def, resolved)) { return; }
    if (type_def_is_scoped_api_local(ctx, resolved)) { return; }
    if (public_type_has_package_path(ctx, resolved)) { return; }
    add_unexported_public_type_diagnostic(ctx, api_def, resolved);
}

Bool same_package_def(context.CompilerContext& ctx, qid.DefId lhs, qid.DefId rhs) {
    guard ctx.store.defs.get(lhs).module_id is .some(lhs_module) else { return false; }
    guard ctx.store.defs.get(rhs).module_id is .some(rhs_module) else { return false; }
    store.ModuleRecord& lhs_record = ctx.store.resolve.module_ref(lhs_module);
    store.ModuleRecord& rhs_record = ctx.store.resolve.module_ref(rhs_module);
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(lhs_record.package_id);
    if (package_record.kind == .core) { return false; }
    if (ctx.store.symbols.text(package_record.name) == "__main_package") { return false; }
    if (ctx.store.symbols.text(package_record.name) == "jiang") { return false; }
    return lhs_record.package_id.to_index() == rhs_record.package_id.to_index();
}

Bool type_def_is_scoped_api_local(context.CompilerContext& ctx, qid.DefId type_def) {
    def.DefRecord record = ctx.store.defs.get(type_def);
    if (record.kind == .generic_param_def) { return true; }
    if (def_source_is_compiler_core(ctx, type_def)) { return true; }
    return record.kind == .associated_type_def;
}

Bool def_source_is_compiler_core(context.CompilerContext& ctx, qid.DefId def_id) {
    guard ctx.store.source_map.def_span(def_id) is .some(loc) else { return false; }
    guard loc.source_id is .some(source_id) else { return false; }
    source.SourceRecord record = ctx.store.sources.get(source_id);
    return contains_bytes(record.name(), "src/core/");
}

Bool contains_bytes(UInt8[]& text, UInt8[]& pattern) {
    if (pattern.length == 0) { return true; }
    if (text.length < pattern.length) { return false; }
    Int index! = 0;
    while (index + pattern.length <= text.length) {
        if (bytes_at(text, pattern, index)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool bytes_at(UInt8[]& text, UInt8[]& pattern, Int offset) {
    Int index! = 0;
    while (index < pattern.length) {
        if (text[offset + index] != pattern[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Bool public_type_has_package_path(context.CompilerContext& ctx, qid.DefId type_def) {
    if (public_nested_type_has_owner_path(ctx, type_def)) { return true; }
    guard ctx.store.defs.get(type_def).module_id is .some(module_id) else { return true; }
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    guard root_module_for_package(ctx, module.package_id) is .some(root_module) else { return true; }
    if (module_exports_type(ctx, root_module, type_def)) { return true; }
    return public_import_exports_type(ctx, root_module, type_def);
}

Bool public_nested_type_has_owner_path(context.CompilerContext& ctx, qid.DefId type_def) {
    def.DefRecord record = ctx.store.defs.get(type_def);
    if (record.visibility != .public_visibility) { return false; }
    guard record.owner_def is .some(owner_def) else { return false; }
    if (ctx.store.defs.get(owner_def).kind == .module_def) { return false; }
    return public_type_has_package_path(ctx, owner_def);
}

qid.ModuleId? root_module_for_package(context.CompilerContext& ctx, qid.PackageId package_id) {
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(package_id);
    Int index! = 0;
    while (index < package_record.modules.len()) {
        qid.ModuleId module_id = package_record.modules.get(index);
        store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
        if (module.path_symbol == package_record.root_path) { return module_id; }
        index = index + 1;
    }
    return null;
}

Bool public_import_exports_type(context.CompilerContext& ctx, qid.ModuleId root_module, qid.DefId type_def) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(root_module);
    Int index! = 0;
    while (index < module.imports.len()) {
        if (public_import_at_exports_type(ctx, module.imports.get(index), type_def)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool public_import_at_exports_type(context.CompilerContext& ctx, store.ImportRecord import_record, qid.DefId type_def) {
    if (import_record.visibility != .public_visibility) { return false; }
    guard import_record.target_module is .some(target_module) else { return false; }
    return module_exports_type(ctx, target_module, type_def);
}

Bool module_exports_type(context.CompilerContext& ctx, qid.ModuleId module_id, qid.DefId type_def) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    guard ctx.store.hirs.def(module.def_id) is .some(module_hir) else { return false; }
    Int index! = 0;
    while (index < module_hir.members.len()) {
        if (public_member_exports_type(ctx, module_hir.members.get(index), type_def)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool public_member_exports_type(context.CompilerContext& ctx, qid.DefId member_def, qid.DefId type_def) {
    def.DefRecord member = ctx.store.defs.get(member_def);
    if (member.visibility != .public_visibility) { return false; }
    if (member_def.to_index() == type_def.to_index()) { return true; }
    guard member.kind == .alias_def else { return false; }
    guard ctx.store.hirs.def(member_def) is .some(hir_def) else { return false; }
    guard hir_def.decl.alias_target is .some(target_def) else { return false; }
    qid.DefId target = resolve_alias_target(ctx, target_def);
    return target.to_index() == type_def.to_index();
}

qid.DefId resolve_alias_target(context.CompilerContext& ctx, qid.DefId def_id) {
    qid.DefId current! = def_id;
    Int depth! = 0;
    while (depth < 64) {
        if (ctx.store.defs.get(current).kind != .alias_def) { return current; }
        guard ctx.store.hirs.def(current) is .some(hir_def) else { return current; }
        guard hir_def.decl.alias_target is .some(target_def) else { return current; }
        current = target_def;
        depth = depth + 1;
    }
    return current;
}

() add_unexported_public_type_diagnostic(context.CompilerContext& ctx, qid.DefId api_def, qid.DefId type_def) {
    source_map.SourceLoc loc = public_api_diag_loc(ctx, api_def, type_def);
    guard loc.source_id is .some(source_id) else { return; }
    std.String message = unexported_public_type_message(ctx, type_def);
    diagnostics.add_error(
        ctx,
        source_id,
        loc.span,
        message.bytes(),
        "public_api_unexported_type"
    );
    ctx.store.hirs.mark_error();
}

source_map.SourceLoc public_api_diag_loc(context.CompilerContext& ctx, qid.DefId api_def, qid.DefId type_def) {
    if (ctx.store.source_map.def_span(api_def) is .some(loc)) { return loc; }
    if (ctx.store.source_map.def_span(type_def) is .some(loc)) { return loc; }
    return source_map.SourceLoc(token.Span());
}

std.String unexported_public_type_message(context.CompilerContext& ctx, qid.DefId type_def) {
    def.DefRecord record = ctx.store.defs.get(type_def);
    UInt8[]& name = ctx.store.symbols.text(record.name.symbol);
    std.StringBuilder builder = std.StringBuilder();
    builder.append("public API exposes type that is not exported from package root: ");
    builder.append(name);
    return builder.into_string();
}

() add_const_value(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    qid.DefId def_id,
    hir.HirDef& hir_def
) {
    if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
        return;
    }
    if (ctx.store.comptime_store.const_value(def_id) is .some(value)) {
        module_interface.set_const_value(stable_id, interface_const_value(ctx, value));
    }
}

@life(return: value)
source_artifact.InterfaceConstValue interface_const_value(
    context.CompilerContext& ctx,
    comptime_value.ComptimeValue value
) {
    if (value.data is .unit_value) {
        return source_artifact.InterfaceConstValue(data: .unit_value());
    }
    if (value.data is .bool_value(bool_value)) {
        return source_artifact.InterfaceConstValue(data: .bool_value(bool_value));
    }
    if (value.data is .int_value(int_value)) {
        return source_artifact.InterfaceConstValue(data: .int_value(int_value));
    }
    if (value.data is .uint_value(uint_value)) {
        return source_artifact.InterfaceConstValue(data: .uint_value(uint_value));
    }
    if (value.data is .char_value(char_value)) {
        return source_artifact.InterfaceConstValue(data: .char_value(char_value));
    }
    if (value.data is .float_bits(float_bits)) {
        return source_artifact.InterfaceConstValue(data: .float_bits(float_bits));
    }
    if (value.data is .string_value(string_value)) {
        return source_artifact.InterfaceConstValue(data: .string_value(string_value));
    }
    if (value.data is .symbol_value(symbol_value)) {
        return source_artifact.InterfaceConstValue(data: .symbol_value(symbol_value));
    }
    if (value.data is .enum_case_value(case_def)) {
        guard ctx.store.incremental.stable_id_for_def(case_def) is .some(stable_id) else {
            return source_artifact.InterfaceConstValue(data: .invalid());
        }
        return source_artifact.InterfaceConstValue(data: .enum_case_value(stable_id));
    }
    if (value.data is .struct_value(fields)) {
        return source_artifact.InterfaceConstValue(data: .struct_value(interface_const_fields(ctx, fields)));
    }
    if (value.data is .tuple_value(items)) {
        return source_artifact.InterfaceConstValue(data: .tuple_value(interface_const_values(ctx, items)));
    }
    if (value.data is .array_value(items)) {
        return source_artifact.InterfaceConstValue(data: .array_value(interface_const_values(ctx, items)));
    }
    return source_artifact.InterfaceConstValue(data: .invalid());
}

@life()
source_artifact.InterfaceConstFieldValue[]& interface_const_fields(
    context.CompilerContext& ctx,
    comptime_value.ComptimeAggregateField[]& fields
) {
    unsafe {
        source_artifact.InterfaceConstFieldValue*! values = unsafe {
            source_artifact.InterfaceConstFieldValue$.alloc(fields.length)
        };
        Int index! = 0;
        while (index < fields.length) {
            qkey.StableSymbolId stable_id! = qkey.StableSymbolId(0, 0);
            if (ctx.store.incremental.stable_id_for_def(fields[index].field_def) is .some(field_stable_id)) {
                stable_id = field_stable_id;
            }
            values[index] = source_artifact.InterfaceConstFieldValue(
                field_stable_id: stable_id,
                value: interface_const_value(ctx, fields[index].value)
            );
            index = index + 1;
        }
        return values[0..fields.length];
    }
}

@life()
source_artifact.InterfaceConstValue[]& interface_const_values(
    context.CompilerContext& ctx,
    comptime_value.ComptimeValue[]& items
) {
    unsafe {
        source_artifact.InterfaceConstValue*! values = unsafe {
            source_artifact.InterfaceConstValue$.alloc(items.length)
        };
        Int index! = 0;
        while (index < items.length) {
            values[index] = interface_const_value(ctx, items[index]);
            index = index + 1;
        }
        return values[0..items.length];
    }
}


() add_symbol_alias(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    def.DefRecord def_record,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.alias_target is .some(target_def) else { return; }
    guard ctx.store.incremental.stable_id_for_def(target_def) is .some(target_stable_id) else { return; }
    module_interface.add_public_alias(source_artifact.AliasExportSummary(
        def_record.name.symbol,
        target_stable_id
    ));
}

qkey.StableSymbolId? stable_owner(context.CompilerContext& ctx, qid.DefId? owner_def) {
    guard owner_def is .some(owner) else { return null; }
    return ctx.store.incremental.stable_id_for_def(owner);
}

() add_decl_type_ref(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.type_ref is .some(type_ref) else { return; }
    module_interface.set_decl_type_ref(stable_id, interface_type_ref(ctx, type_ref));
}

() add_trait_refs(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int index! = 0;
    while (index < hir_def.trait_refs.len()) {
        module_interface.add_trait_ref(stable_id, interface_type_ref(ctx, hir_def.trait_refs.get(index)));
        index = index + 1;
    }
    index = 0;
    while (index < hir_def.negative_trait_refs.len()) {
        module_interface.add_negative_trait_ref(
            stable_id,
            interface_type_ref(ctx, hir_def.negative_trait_refs.get(index))
        );
        index = index + 1;
    }
}

() add_where_predicates(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int index! = 0;
    while (index < hir_def.where_predicates.len()) {
        add_interface_where_predicate(module_interface, ctx, stable_id, hir_def.where_predicates.get(index));
        index = index + 1;
    }
}

() add_interface_where_predicate(
    source_artifact.ModuleInterface& module_interface,
    context.CompilerContext& ctx,
    qkey.StableSymbolId stable_id,
    hir.HirWherePredicate predicate
) {
    if (predicate is .const_type(constraint)) {
        module_interface.add_where_predicate_parts(
            stable_id,
            .const_type,
            const_constraint_subject_type_ref(ctx, constraint.param_def),
            interface_type_ref(ctx, constraint.type_ref),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    if (predicate is .type_bound(bound)) {
        add_interface_type_bound(module_interface, ctx, stable_id, .type_bound, bound);
        return;
    }
    if (predicate is .negative_type_bound(bound)) {
        add_interface_type_bound(module_interface, ctx, stable_id, .negative_type_bound, bound);
        return;
    }
    if (predicate is .equal(equal)) {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_equal,
            interface_type_ref(ctx, equal.subject),
            interface_type_ref(ctx, equal.value),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    if (predicate is .not_equal(equal)) {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_not_equal,
            interface_type_ref(ctx, equal.subject),
            interface_type_ref(ctx, equal.value),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    guard predicate is .projection_equal(projection) else {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_bound,
            source_artifact.InterfaceTypeRef.invalid_type(),
            source_artifact.InterfaceTypeRef.invalid_type(),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    module_interface.add_where_predicate_parts(
        stable_id,
        .projection_equal,
        interface_type_ref(ctx, projection.subject),
        interface_projection_value_ref(ctx, stable_id, projection),
        interface_type_ref(ctx, projection.trait_ref),
        projection.assoc_symbol
    );
}

source_artifact.InterfaceTypeRef interface_projection_value_ref(
    context.CompilerContext& ctx,
    qkey.StableSymbolId owner_stable_id,
    hir.HirWhereProjectionEqual projection
) {
    guard ctx.store.incremental.current_def_for_stable(owner_stable_id) is .some(owner_def) else {
        return interface_type_ref(ctx, projection.value);
    }
    hir.HirDef& owner = ctx.store.hirs.def_ref(owner_def);
    Int index! = 0;
    while (index < owner.members.len()) {
        qid.DefId member_def = owner.members.get(index);
        def.DefRecord member = ctx.store.defs.get(member_def);
        if (associated_member_matches(ctx, member, projection.assoc_symbol)) {
            if (ctx.store.comptime_store.const_value(member_def) is .some(value)) {
                return interface_const_expression_ref(ctx, value);
            }
        }
        index = index + 1;
    }
    return interface_type_ref(ctx, projection.value);
}

Bool associated_member_matches(
    context.CompilerContext& ctx,
    def.DefRecord member,
    qid.SymbolId assoc_symbol
) {
    guard member.associated_trait_member is .some(trait_member) else { return false; }
    return ctx.store.defs.get(trait_member).name.symbol == assoc_symbol;
}

source_artifact.InterfaceTypeRef interface_const_expression_ref(
    context.CompilerContext& ctx,
    comptime_value.ComptimeValue value
) {
    source_artifact.InterfaceTypeRef result! = source_artifact.InterfaceTypeRef.invalid_type();
    reset_interface_type_ref(result$.mut_ref(), 10);
    if (value.data is .enum_case_value(case_def)) {
        fill_interface_def_ref(ctx, result$.mut_ref(), case_def);
        return result;
    }
    if (value.data is .int_value(int_value)) {
        set_interface_int_expression(result$.mut_ref(), UInt64(int_value), true);
        return result;
    }
    if (value.data is .uint_value(uint_value)) {
        set_interface_int_expression(result$.mut_ref(), uint_value, false);
        return result;
    }
    if (value.data is .bool_value(bool_value)) {
        result.count_kind = 3;
        result.count_value = if (bool_value) { 1 } else { 0 };
        return result;
    }
    if (value.data is .char_value(char_value)) {
        result.count_kind = 5;
        result.count_value = char_value;
        return result;
    }
    if (value.data is .float_bits(float_bits)) {
        result.count_kind = 2;
        result.count_value = float_bits;
        return result;
    }
    if (value.data is .string_value(text)) {
        result.count_kind = 4;
        result.add_contract_name(text);
        return result;
    }
    if (value.data is .unit_value) { result.count_kind = 7; return result; }
    return source_artifact.InterfaceTypeRef.invalid_type();
}

() set_interface_int_expression(
    source_artifact.InterfaceTypeRef& result,
    UInt64 bits,
    Bool signed_value
) {
    result.count_kind = 1;
    result.count_value = bits;
    result.sentinel_kind = if (signed_value) { 1 } else { 0 };
}

source_artifact.InterfaceTypeRef const_constraint_subject_type_ref(
    context.CompilerContext& ctx,
    qid.DefId param_def
) {
    guard ctx.store.incremental.stable_id_for_def(param_def) is .some(stable_id) else {
        return source_artifact.InterfaceTypeRef.invalid_type();
    }
    return source_artifact.InterfaceTypeRef.named_type(stable_id.low, stable_id.high);
}

() add_interface_type_bound(
    source_artifact.ModuleInterface& module_interface,
    context.CompilerContext& ctx,
    qkey.StableSymbolId stable_id,
    source_artifact.InterfaceWherePredicateKind kind,
    hir.HirWhereTypeBound bound
) {
    module_interface.add_where_predicate_parts(
        stable_id,
        kind,
        interface_type_ref(ctx, bound.subject),
        interface_type_ref(ctx, bound.bound),
        source_artifact.InterfaceTypeRef.invalid_type(),
        null
    );
}

() add_lifetime_constraints(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int index! = 0;
    while (index < hir_def.lifetime_constraints.len()) {
        hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
        module_interface.add_lifetime_constraint(source_artifact.InterfaceLifetimeConstraint(
            stable_id,
            interface_lifetime_name(ctx, module_interface, constraint.longer),
            interface_lifetime_name(ctx, module_interface, constraint.shorter),
            Int(constraint.relation)
        ));
        index = index + 1;
    }
}

() add_region_schema(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int index! = 0;
    while (index < hir_def.region_params.len()) {
        module_interface.add_region_name(source_artifact.InterfaceRegionName (
            owner_stable_id: stable_id,
            symbol: hir_def.region_params.get(index).name
        ));
        index = index + 1;
    }
    index = 0;
    while (index < hir_def.region_constraints.len()) {
        hir.HirRegionConstraint constraint = hir_def.region_constraints.get(index);
        module_interface.add_region_constraint(source_artifact.InterfaceRegionConstraint (
            owner_stable_id: stable_id,
            target: constraint.target,
            source: constraint.source
        ));
        index = index + 1;
    }
}

() add_life_clauses(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int index! = 0;
    while (index < hir_def.life_clauses.len()) {
        hir.HirLifeClause clause = hir_def.life_clauses.get(index);
        source_artifact.InterfaceLifetimeName? target! = null;
        if (clause.target is .some(target_name)) {
            target = interface_lifetime_name(ctx, module_interface, target_name);
        }
        Int source_expression! = 0;
        if (clause.source_expression is .some(expression)) {
            source_expression = interface_lifetime_expression(
                ctx,
                module_interface,
                expression
            );
        }
        module_interface.add_life_clause(source_artifact.InterfaceLifeClause (
            owner_stable_id: stable_id,
            target: target,
            source: interface_lifetime_name(ctx, module_interface, clause.source),
            source_expression: source_expression
        ));
        index = index + 1;
    }
}

Int interface_lifetime_expression(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    hir.HirLifetimeExpressionId expression_id
) {
    hir.HirLifetimeExpression expression =
        ctx.store.hirs.lifetime_expression(expression_id);
    if (expression.data is .name(name)) {
        return module_interface.add_lifetime_expression(
            source_artifact.InterfaceLifetimeExpression (
                kind: 0,
                name: interface_lifetime_name(ctx, module_interface, name),
                left: 0,
                right: 0
            )
        );
    }
    hir.HirLifetimeExpressionBinary binary!;
    Int kind! = 1;
    if (expression.data is .product(product)) {
        binary = product;
    } else {
        guard expression.data is .meet(meet) else { return 0; }
        binary = meet;
        kind = 2;
    }
    Int left = interface_lifetime_expression(ctx, module_interface, binary.left);
    Int right = interface_lifetime_expression(ctx, module_interface, binary.right);
    return module_interface.add_lifetime_expression(
        source_artifact.InterfaceLifetimeExpression (
            kind: kind,
            name: source_artifact.InterfaceLifetimeName(0, null),
            left: left,
            right: right
        )
    );
}

source_artifact.InterfaceLifetimeName interface_lifetime_name(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    hir.HirLifetimeName name
) {
    Int projection_path! = 0;
    if (name.projection_path is .some(path_id)) {
        projection_path = interface_lifetime_path(ctx, module_interface, path_id);
    }
    return source_artifact.InterfaceLifetimeName(
        Int(name.kind),
        name.symbol,
        projection_path
    );
}

Int interface_lifetime_path(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    hir.HirLifetimePathId path_id
) {
    hir.HirLifetimePathNode node = ctx.store.hirs.lifetime_path_node(path_id);
    Int parent! = 0;
    if (node.parent is .some(parent_id)) {
        parent = interface_lifetime_path(ctx, module_interface, parent_id);
    }
    return module_interface.add_lifetime_path_node(source_artifact.InterfaceLifetimePathNode (
        parent: parent,
        kind: Int(node.projection.kind),
        symbol: node.projection.symbol,
        field_stable_id: interface_lifetime_field_stable_id(ctx, node.projection),
        tuple_index: node.projection.tuple_index
    ));
}

qkey.StableSymbolId? interface_lifetime_field_stable_id(
    context.CompilerContext& ctx,
    hir.HirLifetimeProjection projection
) {
    guard projection.field_def is .some(field_def) else { return null; }
    return ctx.store.incremental.stable_id_for_def(field_def);
}

() add_function_signature(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.function_signature is .some(signature) else { return; }
    source_artifact.InterfaceFunctionSignature iface_signature! =
        source_artifact.InterfaceFunctionSignature.empty(signature.has_receiver);
    iface_signature.receiver_mode = Int(signature.receiver_mode);
    set_interface_signature_effects(ctx, iface_signature$.mut_ref(), signature.effects);
    Int exclusive_index! = 0;
    while (exclusive_index < signature.exclusive_symbols.length) {
        iface_signature.exclusive_symbols.add(signature.exclusive_symbols[exclusive_index]);
        exclusive_index = exclusive_index + 1;
    }
    source_artifact.InterfaceTypeRef result_ref! = source_artifact.InterfaceTypeRef.invalid_type();
    fill_interface_type_ref(ctx, result_ref$.mut_ref(), signature.result);
    iface_signature.set_result_ref(result_ref$.ref());
    Int index! = 0;
    while (index < signature.params.length) {
        iface_signature.add_param(source_artifact.InterfaceParamSummary(
            signature.param_symbols[index],
            interface_type_ref(ctx, signature.params[index])
        ));
        index = index + 1;
    }
    add_param_defaults(ctx, iface_signature$.ref(), signature);
    module_interface.set_function_signature(stable_id, iface_signature);
}

() fill_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef&! result,
    hir.HirId type_ref
) {
    hir.HirNode node = ctx.store.hirs.node(type_ref);
    if (node.data is .unit_type_ref) {
        reset_interface_type_ref(result, 1);
        return;
    }
    if (node.data is .named_type_ref(named)) {
        fill_named_interface_type_ref(ctx, result, named);
        return;
    }
    if (node.data is .name_ref(name_ref)) {
        if (name_ref is .def_ref(def_id)) {
            fill_interface_def_ref(ctx, result, def_id);
            return;
        }
    }
    if (node.data is .member_access(_)) {
        if (ctx.store.typeck.member_selection(type_ref) is .some(def_id)) {
            fill_interface_def_ref(ctx, result, def_id);
            return;
        }
    }
    if (node.data is .literal(literal)) {
        fill_interface_literal_ref(ctx, result, literal);
        return;
    }
    if (node.data is .trait_companion_type_ref(companion)) {
        fill_trait_companion_interface_type_ref(ctx, result, companion);
        return;
    }
    if (node.data is .layered_type_ref(layered)) {
        reset_interface_type_ref(result, 3);
        result.count_kind = Int(layered.kind);
        result.sentinel_kind = Int(layered.sentinel_kind);
        result.sentinel_value = layered.sentinel_value;
        add_interface_type_ref_arg(ctx, result, layered.element);
        add_interface_sentinel_name(ctx, result, layered.sentinel_kind, layered.sentinel_value);
        return;
    }
    if (node.data is .array_type_ref(array)) {
        reset_interface_type_ref(result, 4);
        result.count_kind = Int(array.count_kind);
        result.count_value = array.count_value;
        result.sentinel_kind = Int(array.sentinel_kind);
        result.sentinel_value = array.sentinel_value;
        add_interface_type_ref_arg(ctx, result, array.element);
        if (array.count_kind == .const_name) {
            result.add_contract_name(ctx.store.symbols.text(qid.SymbolId(Int(array.count_value))));
        }
        add_interface_sentinel_name(ctx, result, array.sentinel_kind, array.sentinel_value);
        return;
    }
    if (node.data is .errorable_type_ref(errorable)) {
        reset_interface_type_ref(result, 5);
        add_interface_type_ref_arg(ctx, result, errorable.value_type);
        if (errorable.error_type is .some(error_ref)) {
            add_interface_type_ref_arg(ctx, result, error_ref);
        }
        return;
    }
    if (node.data is .function_type_ref(function_type)) {
        reset_interface_type_ref(result, 6);
        set_interface_type_ref_effects(ctx, result, function_type.effects);
        Int index! = 0;
        while (index < function_type.params.length) {
            add_interface_type_ref_arg(ctx, result, function_type.params[index]);
            index = index + 1;
        }
        add_interface_type_ref_arg(ctx, result, function_type.result);
        return;
    }
    if (node.data is .effect_type_ref(effect_type)) {
        reset_interface_type_ref(result, 11);
        set_interface_type_ref_effects(ctx, result, effect_type.effects);
        add_interface_type_ref_arg(ctx, result, effect_type.base);
        return;
    }
    if (node.data is .tuple_type_ref(tuple)) {
        reset_interface_type_ref(result, 7);
        Int index! = 0;
        while (index < tuple.items.length) {
            add_interface_type_ref_arg(ctx, result, tuple.items[index]);
            index = index + 1;
        }
        add_type_contract_names(ctx, result, tuple.contract_names);
        return;
    }
    if (node.data is .infer_type_ref) {
        reset_interface_type_ref(result, 8);
        return;
    }
    reset_interface_type_ref(result, 0);
}

() add_interface_sentinel_name(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirSentinelKind kind,
    UInt64 value
) {
    if (kind != .const_name) { return; }
    result.add_contract_name(ctx.store.symbols.text(qid.SymbolId(Int(value))));
}

() fill_interface_def_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    qid.DefId def_id
) {
    guard ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id) else {
        reset_interface_type_ref(result, 0);
        return;
    }
    reset_interface_type_ref(result, 2);
    result.has_stable_def = true;
    result.stable_def_low = stable_id.low;
    result.stable_def_high = stable_id.high;
}

() fill_interface_literal_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirLiteral literal
) {
    reset_interface_type_ref(result, 10);
    if (literal.value is .int_value(value)) {
        result.count_kind = 1;
        result.count_value = value.bits;
        result.sentinel_kind = if (value.signed_value) { 1 } else { 0 };
        return;
    }
    if (literal.value is .float_value(value)) {
        result.count_kind = 2;
        result.count_value = float64_interface_bits(value.value);
        return;
    }
    if (literal.value is .bool_value(value)) {
        result.count_kind = 3;
        result.count_value = if (value) { 1 } else { 0 };
        return;
    }
    if (literal.value is .string_value(symbol)) {
        result.count_kind = 4;
        result.add_contract_name(ctx.store.symbols.text(symbol));
        return;
    }
    if (literal.value is .char_value(value)) {
        result.count_kind = 5;
        result.count_value = UInt64(value);
        return;
    }
    if (literal.value is .null_value) { result.count_kind = 6; return; }
    if (literal.value is .unit_value) { result.count_kind = 7; return; }
    reset_interface_type_ref(result, 0);
}

UInt64 float64_interface_bits(Float64 value) {
    unsafe {
        return value$.ptr()$.as(UInt64*)$.get();
    }
}

() reset_interface_type_ref(source_artifact.InterfaceTypeRef& result, Int kind_tag) {
    result.kind_tag = kind_tag;
    result.has_stable_def = false;
    result.stable_def_low = 0;
    result.stable_def_high = 0;
    result.count_kind = 0;
    result.count_value = 0;
    result.sentinel_kind = 0;
    result.sentinel_value = 0;
    result.args.clear();
    result.contract_names.clear();
}

() fill_trait_companion_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirTraitCompanionTypeRef companion
) {
    guard ctx.store.incremental.stable_id_for_def(companion.trait_def) is .some(stable_id) else {
        reset_interface_type_ref(result, 0);
        return;
    }
    reset_interface_type_ref(result, 9);
    result.has_stable_def = true;
    result.stable_def_low = stable_id.low;
    result.stable_def_high = stable_id.high;
    result.count_kind = Int(companion.kind);
}

() fill_named_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirNamedTypeRef named
) {
    if (fill_named_trait_companion_interface_type_ref(ctx, result, named.def_id)) {
        return;
    }
    guard ctx.store.incremental.stable_id_for_def(named.def_id) is .some(stable_id) else {
        reset_interface_type_ref(result, 0);
        return;
    }
    reset_interface_type_ref(result, 2);
    result.has_stable_def = true;
    result.stable_def_low = stable_id.low;
    result.stable_def_high = stable_id.high;
    Int index! = 0;
    while (index < named.args.length) {
        add_interface_type_ref_arg(ctx, result, named.args[index]);
        index = index + 1;
    }
    add_type_contract_names(ctx, result, named.contract_names);
}

() add_type_contract_names(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    qid.SymbolId[]&? contract_names
) {
    guard contract_names is .some(names) else { return; }
    Int index! = 0;
    while (index < names.length) {
        result.add_contract_name(ctx.store.symbols.text(names[index]));
        index = index + 1;
    }
}

Bool fill_named_trait_companion_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    qid.DefId def_id
) {
    def.DefRecord record = ctx.store.defs.get(def_id);
    guard record.kind == .trait_companion_type_def else { return false; }
    guard record.trait_companion is .some(companion) else { return false; }
    hir.HirTraitCompanionTypeRef type_ref = hir.HirTraitCompanionTypeRef (
        trait_def: companion.trait_def,
        kind: hir_trait_companion_kind(companion.kind)
    );
    fill_trait_companion_interface_type_ref(ctx, result, type_ref);
    return true;
}

hir.HirTraitCompanionKind hir_trait_companion_kind(def.TraitCompanionKind kind) {
    if (kind == .vtable) {
        return .vtable;
    }
    if (kind == .receiver) {
        return .receiver;
    }
    return .any;
}

() add_interface_type_ref_arg(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirId arg
) {
    source_artifact.InterfaceTypeRef arg_ref! = source_artifact.InterfaceTypeRef.invalid_type();
    fill_interface_type_ref(ctx, arg_ref$.mut_ref(), arg);
    result.add_arg(arg_ref);
}

() add_generic_template(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    if (hir_def.body == null || generic_param_count(ctx, hir_def.def_id) == 0) {
        return;
    }
    UInt8[]& payload = hir_template.encode_body(ctx, hir_def);
    if (payload.length == 0) {
        return;
    }
    module_interface.add_generic_template(source_artifact.GenericTemplate(
        stable_id,
        ctx.store.incremental.body_fingerprint(stable_id),
        payload
    ));
}

Int generic_param_count(context.CompilerContext& ctx, qid.DefId def_id) {
    Int count! = 0;
    qid.DefId? current! = def_id;
    while (current is .some(current_def)) {
        count = count + ctx.store.hirs.def_ref(current_def).generic_params.len();
        current = ctx.store.defs.get(current_def).owner_def;
    }
    return count;
}

() add_param_defaults(
    context.CompilerContext& ctx,
    source_artifact.InterfaceFunctionSignature& iface_signature,
    hir.HirFunctionSignature signature
) {
    Int index! = 0;
    while (index < signature.param_defaults.length) {
        hir.HirParamDefault param_default = signature.param_defaults[index];
        iface_signature.add_param_default(source_artifact.InterfaceParamDefault(
            param_default.param_index,
            interface_default_literal(ctx, param_default.value)
        ));
        index = index + 1;
    }
}

source_artifact.InterfaceLiteral interface_default_literal(context.CompilerContext& ctx, hir.HirId value) {
    hir.HirNode node = ctx.store.hirs.node(value);
    guard node.data is .literal(literal) else {
        return source_artifact.InterfaceLiteral(.invalid_literal);
    }
    return interface_literal(literal);
}

source_artifact.InterfaceLiteral interface_literal(hir.HirLiteral literal) {
    if (literal.value is .int_value(int_value)) {
        source_artifact.InterfaceLiteral result! = source_artifact.InterfaceLiteral(.int_value);
        result.int_bits = int_value.bits;
        result.signed_int = int_value.signed_value;
        return result;
    }
    if (literal.value is .bool_value(bool_value)) {
        source_artifact.InterfaceLiteral result! = source_artifact.InterfaceLiteral(.bool_value);
        result.bool_value = bool_value;
        return result;
    }
    if (literal.value is .float_value(float_value)) {
        source_artifact.InterfaceLiteral result! = source_artifact.InterfaceLiteral(.float_value);
        result.float_value = float_value.value;
        return result;
    }
    if (literal.value is .string_value(symbol)) {
        source_artifact.InterfaceLiteral result! = source_artifact.InterfaceLiteral(.string_value);
        result.string_symbol = symbol;
        return result;
    }
    if (literal.value is .char_value(char_value)) {
        source_artifact.InterfaceLiteral result! = source_artifact.InterfaceLiteral(.char_value);
        result.char_value = char_value;
        return result;
    }
    if (literal.value is .null_value) {
        return source_artifact.InterfaceLiteral(.null_value);
    }
    if (literal.value is .unit_value) {
        return source_artifact.InterfaceLiteral(.unit_value);
    }
    return source_artifact.InterfaceLiteral(.invalid_literal);
}

source_artifact.InterfaceTypeRef interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirId type_ref
) {
    source_artifact.InterfaceTypeRef result! = source_artifact.InterfaceTypeRef.invalid_type();
    fill_interface_type_ref(ctx, result$.mut_ref(), type_ref);
    return result;
}

() set_interface_signature_effects(
    context.CompilerContext& ctx,
    source_artifact.InterfaceFunctionSignature&! signature,
    hir.HirEffectSet effects
) {
    signature.has_unsafe = effects.has_unsafe;
    signature.has_async = effects.has_async;
    signature.domain_stable_id = interface_effect_domain_stable_id(ctx, effects);
}

() set_interface_type_ref_effects(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef&! type_ref,
    hir.HirEffectSet effects
) {
    type_ref.set_function_effects(
        effects.has_unsafe,
        effects.has_async,
        interface_effect_domain_stable_id(ctx, effects)
    );
}

qkey.StableSymbolId? interface_effect_domain_stable_id(context.CompilerContext& ctx, hir.HirEffectSet effects) {
    guard effects.domain is .some(domain) else { return null; }
    guard effect_domain_binding_def(ctx, domain) is .some(def_id) else { return null; }
    return ctx.store.incremental.stable_id_for_def(def_id);
}

qid.DefId? effect_domain_binding_def(context.CompilerContext& ctx, hir.HirId domain) {
    hir.HirNode node = ctx.store.hirs.node(domain);
    if (node.data is .name_ref(name_ref)) {
        if (name_ref is .def_ref(def_id)) { return resolve_alias_target(ctx, def_id); }
    }
    return null;
}
