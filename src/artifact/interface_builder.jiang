// 从当前 session 的 Def/HIR facts 构造可落盘 ModuleInterface。
//
// Interface 保存 public 语义事实和 private 声明壳。
//
// public declaration 需要完整签名，供依赖方继续 type check；private 声明只保存
// name/kind/owner/visibility，让跨模块访问能稳定报 private_access，而不是退化成
// unresolved。复杂 type ref 如果暂时不能稳定编码，宁可写成 invalid_type，也不能把
// session-local TypeId/HirId 写入 artifact。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import hir_template = "./hir_template.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import def = "../resolve/def.jiang";
import store = "../resolve/store.jiang";
import source = "../source/source.jiang";
import source_artifact = "./source.jiang";
import source_fingerprint = "./source_fingerprint.jiang";
import comptime_value = "../sema/comptime/value.jiang";

public Bool store_module_interface(context.CompilerContext& ctx, qid.ModuleId module_id) {
    guard build_module_interface(ctx, module_id) is .some(module_interface) else {
        return false;
    }
    source.SourceId source_id = module_interface.source_id;
    ctx.store.artifacts.store_interface(source_id, module_interface$.move());
    return true;
}

public source_artifact.ModuleInterface? build_module_interface(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(module.package_id);
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    source_artifact.ModuleInterface! module_interface = source_artifact.ModuleInterface(
        module.source_id,
        source_record.content_hash,
        package_record.name,
        module.path_symbol
    );

    add_public_imports(ctx, module_interface$.ref(), module);
    add_public_members(ctx, module_interface$.ref(), module.def_id);
    module_interface.interface_hash = source_fingerprint.module_interface_fingerprint(
        ctx,
        module_interface$.ref()
    );
    return module_interface$.move();
}

() add_public_imports(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ModuleRecord& module
) {
    Int! index = 0;
    while (index < module.imports.len()) {
        store.ImportRecord import_record = module.imports.get(index);
        add_public_import(ctx, module_interface, import_record);
        index = index + 1;
    }
}

() add_public_import(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ImportRecord import_record
) {
    if (import_record.visibility != .public_visibility) {
        return;
    }
    module_interface.add_public_import(source_artifact.ImportSummaryEntry(
        import_record.kind,
        import_record.visibility,
        import_record.path_symbol,
        import_record.alias_symbol
    ));
    add_public_import_alias(ctx, module_interface, import_record);
}

() add_public_import_alias(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    store.ImportRecord import_record
) {
    guard import_record.alias_def is .some(alias_def) else { return; }
    guard import_record.target_module is .some(target_module) else { return; }
    store.ModuleRecord& target = ctx.store.resolve.module_ref(target_module);
    guard ctx.store.incremental.stable_id_for_def(target.def_id) is .some(target_stable_id) else { return; }
    def.DefRecord alias_record = ctx.store.defs.get(alias_def);
    module_interface.add_public_alias(source_artifact.AliasExportSummary(
        alias_record.name.symbol,
        target_stable_id
    ));
}

() add_public_members(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qid.DefId owner_def
) {
    hir.HirDef& owner_hir = ctx.store.hirs.def_ref(owner_def);
    Int! index = 0;
    while (index < owner_hir.members.len()) {
        qid.DefId member_def = owner_hir.members.get(index);
        add_public_member(ctx, module_interface, member_def);
        index = index + 1;
    }
}

() add_public_member(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qid.DefId member_def
) {
    def.DefRecord def_record = ctx.store.defs.get(member_def);
    guard ctx.store.hirs.def(member_def) is .some(hir_def) else { return; }
    guard ctx.store.incremental.stable_id_for_def(member_def) is .some(stable_id) else { return; }
    source_artifact.InterfaceDeclSummary! summary = source_artifact.InterfaceDeclSummary(
        stable_id,
        def_record.kind,
        def_record.domain,
        def_record.visibility,
        def_record.name.symbol,
        stable_owner(ctx, def_record.owner_def)
    );
    summary.signature_fingerprint = ctx.store.incremental.signature_fingerprint(stable_id);
    summary.body_fingerprint = ctx.store.incremental.body_fingerprint(stable_id);
    module_interface.add_declaration(summary);
    // private 声明不会成为 public API，但依赖方仍需要它们的类型事实来完成
    // public nominal 的成员检查和 public generic template 的按需 type check。
    add_decl_type_ref(ctx, module_interface, stable_id, hir_def);
    add_trait_refs(ctx, module_interface, stable_id, hir_def);
    add_where_predicates(ctx, module_interface, stable_id, hir_def);
    add_lifetime_constraints(module_interface, stable_id, hir_def);
    add_function_signature(ctx, module_interface, stable_id, hir_def);
    add_const_value(ctx, module_interface, stable_id, member_def, def_record, hir_def);
    if (def_record.visibility != .public_visibility) {
        return;
    }
    add_generic_template(ctx, module_interface, stable_id, hir_def);
    add_symbol_alias(ctx, module_interface, def_record, hir_def);
    add_public_members(ctx, module_interface, member_def);
}

() add_const_value(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    qid.DefId def_id,
    def.DefRecord def_record,
    hir.HirDef& hir_def
) {
    if (def_record.visibility != .public_visibility) {
        return;
    }
    if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
        return;
    }
    if (ctx.store.comptime_store.const_value(def_id) is .some(value)) {
        module_interface.set_const_value(stable_id, interface_const_value(ctx, value));
    }
}

source_artifact.InterfaceConstValue interface_const_value(context.CompilerContext& ctx, comptime_value.ComptimeValue value) {
    if (value.data is .unit_value) {
        return source_artifact.InterfaceConstValue(data: .unit_value());
    }
    if (value.data is .bool_value(bool_value)) {
        return source_artifact.InterfaceConstValue(data: .bool_value(bool_value));
    }
    if (value.data is .int_value(int_value)) {
        return source_artifact.InterfaceConstValue(data: .int_value(int_value));
    }
    if (value.data is .uint_value(uint_value)) {
        return source_artifact.InterfaceConstValue(data: .uint_value(uint_value));
    }
    if (value.data is .char_value(char_value)) {
        return source_artifact.InterfaceConstValue(data: .char_value(char_value));
    }
    if (value.data is .float_bits(float_bits)) {
        return source_artifact.InterfaceConstValue(data: .float_bits(float_bits));
    }
    if (value.data is .string_value(string_value)) {
        return source_artifact.InterfaceConstValue(data: .string_value(string_value));
    }
    if (value.data is .symbol_value(symbol_value)) {
        return source_artifact.InterfaceConstValue(data: .symbol_value(symbol_value));
    }
    if (value.data is .enum_case_value(case_def)) {
        guard ctx.store.incremental.stable_id_for_def(case_def) is .some(stable_id) else {
            return source_artifact.InterfaceConstValue(data: .invalid());
        }
        return source_artifact.InterfaceConstValue(data: .enum_case_value(stable_id));
    }
    if (value.data is .struct_value(fields)) {
        return source_artifact.InterfaceConstValue(data: .struct_value(interface_const_fields(ctx, fields)));
    }
    if (value.data is .tuple_value(items)) {
        return source_artifact.InterfaceConstValue(data: .tuple_value(interface_const_values(ctx, items)));
    }
    if (value.data is .array_value(items)) {
        return source_artifact.InterfaceConstValue(data: .array_value(interface_const_values(ctx, items)));
    }
    return source_artifact.InterfaceConstValue(data: .invalid());
}

source_artifact.InterfaceConstFieldValue[]& interface_const_fields(
    context.CompilerContext& ctx,
    comptime_value.ComptimeAggregateField[]& fields
) {
    source_artifact.InterfaceConstFieldValue![*] values = source_artifact.InterfaceConstFieldValue!$.alloc_array(fields.length);
    Int! index = 0;
    while (index < fields.length) {
        qkey.StableSymbolId! stable_id = qkey.StableSymbolId(0, 0);
        if (ctx.store.incremental.stable_id_for_def(fields[index].field_def) is .some(field_stable_id)) {
            stable_id = field_stable_id;
        }
        values[index] = source_artifact.InterfaceConstFieldValue(
            field_stable_id: stable_id,
            value: interface_const_value(ctx, fields[index].value)
        );
        index = index + 1;
    }
    return values[0..fields.length];
}

source_artifact.InterfaceConstValue[]& interface_const_values(
    context.CompilerContext& ctx,
    comptime_value.ComptimeValue[]& items
) {
    source_artifact.InterfaceConstValue![*] values = source_artifact.InterfaceConstValue!$.alloc_array(items.length);
    Int! index = 0;
    while (index < items.length) {
        values[index] = interface_const_value(ctx, items[index]);
        index = index + 1;
    }
    return values[0..items.length];
}


() add_symbol_alias(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    def.DefRecord def_record,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.alias_target is .some(target_def) else { return; }
    guard ctx.store.incremental.stable_id_for_def(target_def) is .some(target_stable_id) else { return; }
    module_interface.add_public_alias(source_artifact.AliasExportSummary(
        def_record.name.symbol,
        target_stable_id
    ));
}

qkey.StableSymbolId? stable_owner(context.CompilerContext& ctx, qid.DefId? owner_def) {
    guard owner_def is .some(owner) else { return null; }
    return ctx.store.incremental.stable_id_for_def(owner);
}

() add_decl_type_ref(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.type_ref is .some(type_ref) else { return; }
    module_interface.set_decl_type_ref(stable_id, interface_type_ref(ctx, type_ref));
}

() add_trait_refs(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int! index = 0;
    while (index < hir_def.trait_refs.len()) {
        module_interface.add_trait_ref(stable_id, interface_type_ref(ctx, hir_def.trait_refs.get(index)));
        index = index + 1;
    }
}

() add_where_predicates(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int! index = 0;
    while (index < hir_def.where_predicates.len()) {
        add_interface_where_predicate(module_interface, ctx, stable_id, hir_def.where_predicates.get(index));
        index = index + 1;
    }
}

() add_interface_where_predicate(
    source_artifact.ModuleInterface& module_interface,
    context.CompilerContext& ctx,
    qkey.StableSymbolId stable_id,
    hir.HirWherePredicate predicate
) {
    if (predicate is .type_bound(bound)) {
        add_interface_type_bound(module_interface, ctx, stable_id, .type_bound, bound);
        return;
    }
    if (predicate is .negative_type_bound(bound)) {
        add_interface_type_bound(module_interface, ctx, stable_id, .negative_type_bound, bound);
        return;
    }
    if (predicate is .type_equal(equal)) {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_equal,
            interface_type_ref(ctx, equal.subject),
            interface_type_ref(ctx, equal.value),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    if (predicate is .type_not_equal(equal)) {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_not_equal,
            interface_type_ref(ctx, equal.subject),
            interface_type_ref(ctx, equal.value),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    guard predicate is .projection_equal(projection) else {
        module_interface.add_where_predicate_parts(
            stable_id,
            .type_bound,
            source_artifact.InterfaceTypeRef.invalid_type(),
            source_artifact.InterfaceTypeRef.invalid_type(),
            source_artifact.InterfaceTypeRef.invalid_type(),
            null
        );
        return;
    }
    module_interface.add_where_predicate_parts(
        stable_id,
        .projection_equal,
        interface_type_ref(ctx, projection.subject),
        interface_type_ref(ctx, projection.value),
        interface_type_ref(ctx, projection.trait_ref),
        projection.assoc_symbol
    );
}

() add_interface_type_bound(
    source_artifact.ModuleInterface& module_interface,
    context.CompilerContext& ctx,
    qkey.StableSymbolId stable_id,
    source_artifact.InterfaceWherePredicateKind kind,
    hir.HirWhereTypeBound bound
) {
    module_interface.add_where_predicate_parts(
        stable_id,
        kind,
        interface_type_ref(ctx, bound.subject),
        interface_type_ref(ctx, bound.bound),
        source_artifact.InterfaceTypeRef.invalid_type(),
        null
    );
}

() add_lifetime_constraints(
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    Int! index = 0;
    while (index < hir_def.lifetime_constraints.len()) {
        hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
        module_interface.add_lifetime_constraint(source_artifact.InterfaceLifetimeConstraint(
            stable_id,
            interface_lifetime_name(constraint.longer),
            interface_lifetime_name(constraint.shorter)
        ));
        index = index + 1;
    }
}

source_artifact.InterfaceLifetimeName interface_lifetime_name(hir.HirLifetimeName name) {
    return source_artifact.InterfaceLifetimeName(Int(name.kind), name.symbol);
}

() add_function_signature(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    guard hir_def.decl.function_signature is .some(signature) else { return; }
    source_artifact.InterfaceFunctionSignature! iface_signature =
        source_artifact.InterfaceFunctionSignature.empty(signature.has_receiver);
    iface_signature.receiver_mode = Int(signature.receiver_mode);
    source_artifact.InterfaceTypeRef! result_ref = source_artifact.InterfaceTypeRef.invalid_type();
    fill_interface_type_ref(ctx, result_ref$.ref(), signature.result);
    iface_signature.set_result_ref(result_ref$.ref());
    Int! index = 0;
    while (index < signature.params.length) {
        iface_signature.add_param(source_artifact.InterfaceParamSummary(
            signature.param_symbols[index],
            interface_type_ref(ctx, signature.params[index])
        ));
        index = index + 1;
    }
    add_param_defaults(ctx, iface_signature$.ref(), signature);
    module_interface.set_function_signature(stable_id, iface_signature$.move());
}

() fill_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirId type_ref
) {
    hir.HirNode node = ctx.store.hirs.node(type_ref);
    if (node.data is .unit_type_ref) {
        reset_interface_type_ref(result, 1);
        return;
    }
    if (node.data is .named_type_ref(named)) {
        fill_named_interface_type_ref(ctx, result, named);
        return;
    }
    if (node.data is .layered_type_ref(layered)) {
        reset_interface_type_ref(result, 3);
        result.count_kind = Int(layered.kind);
        result.sentinel_kind = Int(layered.sentinel_kind);
        result.sentinel_value = layered.sentinel_value;
        add_interface_type_ref_arg(ctx, result, layered.element);
        return;
    }
    if (node.data is .array_type_ref(array)) {
        reset_interface_type_ref(result, 4);
        result.count_kind = Int(array.count_kind);
        result.count_value = array.count_value;
        result.sentinel_kind = Int(array.sentinel_kind);
        result.sentinel_value = array.sentinel_value;
        add_interface_type_ref_arg(ctx, result, array.element);
        return;
    }
    if (node.data is .errorable_type_ref(errorable)) {
        reset_interface_type_ref(result, 5);
        add_interface_type_ref_arg(ctx, result, errorable.value_type);
        if (errorable.error_type is .some(error_ref)) {
            add_interface_type_ref_arg(ctx, result, error_ref);
        }
        return;
    }
    if (node.data is .function_type_ref(function_type)) {
        reset_interface_type_ref(result, 6);
        Int! index = 0;
        while (index < function_type.params.length) {
            add_interface_type_ref_arg(ctx, result, function_type.params[index]);
            index = index + 1;
        }
        add_interface_type_ref_arg(ctx, result, function_type.result);
        return;
    }
    if (node.data is .tuple_type_ref(tuple)) {
        reset_interface_type_ref(result, 7);
        Int! index = 0;
        while (index < tuple.items.length) {
            add_interface_type_ref_arg(ctx, result, tuple.items[index]);
            index = index + 1;
        }
        return;
    }
    if (node.data is .infer_type_ref) {
        reset_interface_type_ref(result, 8);
        return;
    }
    reset_interface_type_ref(result, 0);
}

() reset_interface_type_ref(source_artifact.InterfaceTypeRef& result, Int kind_tag) {
    result.kind_tag = kind_tag;
    result.has_stable_def = false;
    result.stable_def_low = 0;
    result.stable_def_high = 0;
    result.count_kind = 0;
    result.count_value = 0;
    result.sentinel_kind = 0;
    result.sentinel_value = 0;
    result.args.clear();
}

() fill_named_interface_type_ref(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirNamedTypeRef named
) {
    guard ctx.store.incremental.stable_id_for_def(named.def_id) is .some(stable_id) else {
        reset_interface_type_ref(result, 0);
        return;
    }
    reset_interface_type_ref(result, 2);
    result.has_stable_def = true;
    result.stable_def_low = stable_id.low;
    result.stable_def_high = stable_id.high;
    Int! index = 0;
    while (index < named.args.length) {
        add_interface_type_ref_arg(ctx, result, named.args[index]);
        index = index + 1;
    }
}

() add_interface_type_ref_arg(
    context.CompilerContext& ctx,
    source_artifact.InterfaceTypeRef& result,
    hir.HirId arg
) {
    source_artifact.InterfaceTypeRef! arg_ref = source_artifact.InterfaceTypeRef.invalid_type();
    fill_interface_type_ref(ctx, arg_ref$.ref(), arg);
    result.add_arg(arg_ref$.move());
}

() add_generic_template(
    context.CompilerContext& ctx,
    source_artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id,
    hir.HirDef& hir_def
) {
    if (hir_def.body == null || generic_param_count(ctx, hir_def.def_id) == 0) {
        return;
    }
    UInt8[]& payload = hir_template.encode_body(ctx, hir_def);
    if (payload.length == 0) {
        return;
    }
    module_interface.add_generic_template(source_artifact.GenericTemplate(
        stable_id,
        ctx.store.incremental.body_fingerprint(stable_id),
        payload
    ));
}

Int generic_param_count(context.CompilerContext& ctx, qid.DefId def_id) {
    Int! count = 0;
    qid.DefId?! current = def_id;
    while (current is .some(current_def)) {
        count = count + ctx.store.hirs.def_ref(current_def).generic_params.len();
        current = ctx.store.defs.get(current_def).owner_def;
    }
    return count;
}

() add_param_defaults(
    context.CompilerContext& ctx,
    source_artifact.InterfaceFunctionSignature& iface_signature,
    hir.HirFunctionSignature signature
) {
    Int! index = 0;
    while (index < signature.param_defaults.length) {
        hir.HirParamDefault param_default = signature.param_defaults[index];
        iface_signature.add_param_default(source_artifact.InterfaceParamDefault(
            param_default.param_index,
            interface_default_literal(ctx, param_default.value)
        ));
        index = index + 1;
    }
}

source_artifact.InterfaceLiteral interface_default_literal(context.CompilerContext& ctx, hir.HirId value) {
    hir.HirNode node = ctx.store.hirs.node(value);
    guard node.data is .literal(literal) else {
        return source_artifact.InterfaceLiteral(.invalid_literal);
    }
    return interface_literal(literal);
}

source_artifact.InterfaceLiteral interface_literal(hir.HirLiteral literal) {
    if (literal.value is .int_value(int_value)) {
        source_artifact.InterfaceLiteral! result = source_artifact.InterfaceLiteral(.int_value);
        result.int_bits = int_value.bits;
        result.signed_int = int_value.signed_value;
        return result;
    }
    if (literal.value is .bool_value(bool_value)) {
        source_artifact.InterfaceLiteral! result = source_artifact.InterfaceLiteral(.bool_value);
        result.bool_value = bool_value;
        return result;
    }
    if (literal.value is .float_value(float_value)) {
        source_artifact.InterfaceLiteral! result = source_artifact.InterfaceLiteral(.float_value);
        result.float_value = float_value.value;
        return result;
    }
    if (literal.value is .string_value(symbol)) {
        source_artifact.InterfaceLiteral! result = source_artifact.InterfaceLiteral(.string_value);
        result.string_symbol = symbol;
        return result;
    }
    if (literal.value is .char_value(char_value)) {
        source_artifact.InterfaceLiteral! result = source_artifact.InterfaceLiteral(.char_value);
        result.char_value = char_value;
        return result;
    }
    if (literal.value is .null_value) {
        return source_artifact.InterfaceLiteral(.null_value);
    }
    if (literal.value is .unit_value) {
        return source_artifact.InterfaceLiteral(.unit_value);
    }
    return source_artifact.InterfaceLiteral(.invalid_literal);
}

source_artifact.InterfaceTypeRef interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirId type_ref
) {
    hir.HirNode node = ctx.store.hirs.node(type_ref);
    if (node.data is .unit_type_ref) {
        return source_artifact.InterfaceTypeRef.unit_type();
    }
    if (node.data is .named_type_ref(named)) {
        return named_interface_type_ref(ctx, named);
    }
    if (node.data is .layered_type_ref(layered)) {
        source_artifact.InterfaceTypeRef! result =
            source_artifact.InterfaceTypeRef(source_artifact.InterfaceTypeRefKind.layered_type);
        result.kind_tag = 3;
        result.count_kind = Int(layered.kind);
        result.add_arg(interface_type_ref(ctx, layered.element));
        return result$.move();
    }
    if (node.data is .array_type_ref(array)) {
        source_artifact.InterfaceTypeRef! result =
            source_artifact.InterfaceTypeRef(source_artifact.InterfaceTypeRefKind.array_type);
        result.kind_tag = 4;
        result.count_kind = Int(array.count_kind);
        result.count_value = array.count_value;
        result.add_arg(interface_type_ref(ctx, array.element));
        return result$.move();
    }
    if (node.data is .errorable_type_ref(errorable)) {
        return errorable_interface_type_ref(ctx, errorable);
    }
    if (node.data is .function_type_ref(function_type)) {
        return function_interface_type_ref(ctx, function_type);
    }
    if (node.data is .tuple_type_ref(tuple)) {
        return tuple_interface_type_ref(ctx, tuple);
    }
    if (node.data is .infer_type_ref) {
        return source_artifact.InterfaceTypeRef.infer_type();
    }
    return source_artifact.InterfaceTypeRef.invalid_type();
}

source_artifact.InterfaceTypeRef errorable_interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirErrorableTypeRef errorable
) {
    source_artifact.InterfaceTypeRef! type_ref =
        source_artifact.InterfaceTypeRef(source_artifact.InterfaceTypeRefKind.errorable_type);
    type_ref.kind_tag = 5;
    type_ref.add_arg(interface_type_ref(ctx, errorable.value_type));
    if (errorable.error_type is .some(error_ref)) {
        type_ref.add_arg(interface_type_ref(ctx, error_ref));
    }
    return type_ref$.move();
}

source_artifact.InterfaceTypeRef function_interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirFunctionTypeRef function_type
) {
    source_artifact.InterfaceTypeRef! type_ref = source_artifact.InterfaceTypeRef.function_type();
    Int! index = 0;
    while (index < function_type.params.length) {
        type_ref.add_arg(interface_type_ref(ctx, function_type.params[index]));
        index = index + 1;
    }
    type_ref.add_arg(interface_type_ref(ctx, function_type.result));
    return type_ref$.move();
}

source_artifact.InterfaceTypeRef tuple_interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirTupleTypeRef tuple
) {
    source_artifact.InterfaceTypeRef! type_ref = source_artifact.InterfaceTypeRef.tuple_type();
    Int! index = 0;
    while (index < tuple.items.length) {
        type_ref.add_arg(interface_type_ref(ctx, tuple.items[index]));
        index = index + 1;
    }
    return type_ref$.move();
}

source_artifact.InterfaceTypeRef named_interface_type_ref(
    context.CompilerContext& ctx,
    hir.HirNamedTypeRef named
) {
    guard ctx.store.incremental.stable_id_for_def(named.def_id) is .some(stable_id) else {
        return source_artifact.InterfaceTypeRef.invalid_type();
    }
    source_artifact.InterfaceTypeRef! type_ref =
        source_artifact.InterfaceTypeRef.named_type(stable_id.low, stable_id.high);
    Int! index = 0;
    while (index < named.args.length) {
        type_ref.add_arg(interface_type_ref(ctx, named.args[index]));
        index = index + 1;
    }
    return type_ref$.move();
}
