// Diagnostic data model shared by CLI, tests, IDE, and LSP adapters.
//
// Internal diagnostics are anchored by source file + byte span. Line/character
// positions are cached beside the span when available, but can be recomputed by
// source_map.jiang from the source text.

import source = "../source/source.jiang";
import token = "../syntax/token.jiang";
import list = "../support/list.jiang";

public enum DiagnosticSeverity {
    error,
    warning,
    information,
    hint,
}

public Int lsp_severity_code(DiagnosticSeverity severity) {
    if (severity == .error) { return 1; }
    if (severity == .warning) { return 2; }
    if (severity == .information) { return 3; }
    return 4;
}

public enum DiagnosticCategory {
    lexer,
    parser,
    name_resolution,
    type_check,
    borrow_check,
    layout,
    trait_solve,
    lowering,
    codegen,
    incremental,
    package,
    internal,
}

public enum DiagnosticCodeKind {
    numeric,
    string,
}

public struct DiagnosticCode {
    public DiagnosticCodeKind kind;
    public Int number;
    public UInt8[] text;

    public init() {
        self.kind = .string;
        self.number = 0;
        self.text = "";
    }

    public init(UInt8[] text) {
        self.kind = .string;
        self.number = 0;
        self.text = text;
    }

    public init(Int number) {
        self.kind = .numeric;
        self.number = number;
        self.text = "";
    }
}

public struct SourcePosition {
    // 0-based byte offset in source text.
    public Int byte_offset;

    // 0-based line number. LSP also uses 0-based lines.
    public Int line;

    // 0-based UTF-16 code unit offset. This matches LSP's default position
    // encoding and can also be used by older clients.
    public Int character;

    public init() {
        self.byte_offset = 0;
        self.line = 0;
        self.character = 0;
    }

    public init(Int byte_offset, Int line, Int character) {
        self.byte_offset = byte_offset;
        self.line = line;
        self.character = character;
    }
}

public struct SourceRange {
    public source.SourceId? source_id;

    // Byte span is the canonical compiler location.
    public token.Span span;

    // LSP-facing range. End is exclusive.
    public SourcePosition start;
    public SourcePosition end;

    public init() {
        self.source_id = null;
        self.span = token.Span();
        self.start = SourcePosition();
        self.end = SourcePosition();
    }

    public init(source.SourceId source_id, token.Span span) {
        self.source_id = source_id;
        self.span = span;
        self.start = SourcePosition(span.start, 0, 0);
        self.end = SourcePosition(span.end(), 0, 0);
    }

    public init(source.SourceId source_id, token.Span span, SourcePosition start, SourcePosition end) {
        self.source_id = source_id;
        self.span = span;
        self.start = start;
        self.end = end;
    }
}

public enum DiagnosticTag {
    unnecessary,
    deprecated,
}

public Int lsp_tag_code(DiagnosticTag tag) {
    if (tag == .unnecessary) { return 1; }
    return 2;
}

public enum DiagnosticLabelStyle {
    primary,
    secondary,
}

public struct DiagnosticLabel {
    public DiagnosticLabelStyle style;
    public SourceRange range;
    public UInt8[] message;

    public init() {
        self.style = .primary;
        self.range = SourceRange();
        self.message = "";
    }

    public init(DiagnosticLabelStyle style, SourceRange range, UInt8[] message) {
        self.style = style;
        self.range = range;
        self.message = message;
    }
}

public struct DiagnosticRelatedInformation {
    public SourceRange range;
    public UInt8[] message;

    public init() {
        self.range = SourceRange();
        self.message = "";
    }

    public init(SourceRange range, UInt8[] message) {
        self.range = range;
        self.message = message;
    }
}

public enum TextEditKind {
    insert,
    replace,
    delete,
}

public struct TextEdit {
    public TextEditKind kind;
    public SourceRange range;
    public UInt8[] replacement;

    public init() {
        self.kind = .replace;
        self.range = SourceRange();
        self.replacement = "";
    }

    public init(TextEditKind kind, SourceRange range, UInt8[] replacement) {
        self.kind = kind;
        self.range = range;
        self.replacement = replacement;
    }
}

public enum FixApplicability {
    machine_applicable,
    maybe_incorrect,
    has_placeholders,
    manual,
}

public struct DiagnosticFix: Movable {
    public UInt8[] title;
    public FixApplicability applicability;
    public list.ArrayList<TextEdit>! edits;

    public init() {
        self.title = "";
        self.applicability = .manual;
        self.edits = list.ArrayList<TextEdit>();
    }

    public init(UInt8[] title, FixApplicability applicability) {
        self.title = title;
        self.applicability = applicability;
        self.edits = list.ArrayList<TextEdit>();
    }

    public () add_edit(TextEdit edit) {
        self.edits.add(edit$.move());
    }
}

public struct Diagnostic: Movable {
    public DiagnosticSeverity severity;
    public DiagnosticCategory category;
    public DiagnosticCode code;

    // Main range should be present for source diagnostics. A null source_id
    // means the diagnostic is global, e.g. command line or package config.
    public SourceRange range;

    public UInt8[] message;
    public UInt8[] source_name;

    public list.ArrayList<DiagnosticLabel>! labels;
    public list.ArrayList<DiagnosticRelatedInformation>! related;
    public list.ArrayList<DiagnosticTag>! tags;
    public list.ArrayList<DiagnosticFix>! fixes;

    public init() {
        self.severity = .error;
        self.category = .internal;
        self.code = DiagnosticCode();
        self.range = SourceRange();
        self.message = "";
        self.source_name = "jiang";
        self.labels = list.ArrayList<DiagnosticLabel>();
        self.related = list.ArrayList<DiagnosticRelatedInformation>();
        self.tags = list.ArrayList<DiagnosticTag>();
        self.fixes = list.ArrayList<DiagnosticFix>();
    }

    public init(
        DiagnosticSeverity severity,
        DiagnosticCategory category,
        DiagnosticCode code,
        SourceRange range,
        UInt8[] message
    ) {
        self.severity = severity;
        self.category = category;
        self.code = code;
        self.range = range;
        self.message = message;
        self.source_name = "jiang";
        self.labels = list.ArrayList<DiagnosticLabel>();
        self.related = list.ArrayList<DiagnosticRelatedInformation>();
        self.tags = list.ArrayList<DiagnosticTag>();
        self.fixes = list.ArrayList<DiagnosticFix>();
    }

    public () add_label(DiagnosticLabel label) {
        self.labels.add(label$.move());
    }

    public () add_related(DiagnosticRelatedInformation info) {
        self.related.add(info$.move());
    }

    public () add_tag(DiagnosticTag tag) {
        self.tags.add(tag$.move());
    }

    public () add_fix(DiagnosticFix fix) {
        self.fixes.add(fix$.move());
    }
}

public struct DiagnosticStore: Movable {
    public list.ArrayList<Diagnostic>! items;
    public Int! error_count;
    public Int! warning_count;

    public init() {
        self.items = list.ArrayList<Diagnostic>();
        self.error_count = 0;
        self.warning_count = 0;
    }

    public Int len() {
        return self.items.len();
    }

    public Bool empty() {
        return self.items.empty();
    }

    public Diagnostic& get(Int index) {
        return self.items.ref_at(index);
    }

    public DiagnosticScope scope() {
        return DiagnosticScope(self, self.items.len(), self.error_count, self.warning_count);
    }

    public () add(Diagnostic diagnostic) {
        if (diagnostic.severity == .error) {
            self.error_count = self.error_count + 1;
        } else if (diagnostic.severity == .warning) {
            self.warning_count = self.warning_count + 1;
        }
        self.items.add(diagnostic$.move());
    }

    public Bool has_errors() {
        return self.error_count > 0;
    }

    public () clear() {
        self.items.clear();
        self.error_count = 0;
        self.warning_count = 0;
    }

    public () truncate(Int len) {
        self.items.truncate(len);
        self.recount();
    }

    () recount() {
        self.error_count = 0;
        self.warning_count = 0;
        Int! index = 0;
        while (index < self.items.len()) {
            Diagnostic& diagnostic = self.items.ref_at(index);
            if (diagnostic.severity == .error) {
                self.error_count = self.error_count + 1;
            } else if (diagnostic.severity == .warning) {
                self.warning_count = self.warning_count + 1;
            }
            index = index + 1;
        }
    }
}

public struct DiagnosticScope {
    DiagnosticStore& store;
    public Int start_index;
    Int start_error_count;
    Int start_warning_count;

    public init(
        DiagnosticStore& store,
        Int start_index,
        Int start_error_count,
        Int start_warning_count
    ) {
        self.store = store;
        self.start_index = start_index;
        self.start_error_count = start_error_count;
        self.start_warning_count = start_warning_count;
    }

    public Bool has_errors() {
        return self.store.error_count > self.start_error_count;
    }

    public Int count() {
        return self.store.items.len() - self.start_index;
    }
    public Diagnostic& get(Int offset) {
        return self.store.get(self.start_index + offset);
    }

    public () rollback() {
        self.store.truncate(self.start_index);
    }
}
