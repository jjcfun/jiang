// Source byte span to LSP-compatible line/character mapping.

import diag = "../diagnostic.jiang";
import source = "../source.jiang";
import token = "../syntax/token.jiang";
import unicode = "../support/unicode.jiang";
import "../support/list.jiang";

public enum PositionEncoding {
    utf8,
    utf16,
}

Int utf16_width_at(UInt8[]& text, Int index) {
    if (index >= text.length) {
        return 0;
    }

    UInt8 byte = text[index];
    if (byte < 128) {
        return 1;
    }

    if (!unicode.is_valid_utf8_at(text, index)) {
        return 1;
    }

    Int scalar = unicode.utf8_scalar_at(text, index);
    if (scalar > 65535) {
        return 2;
    }
    return 1;
}

Int byte_width_at(UInt8[]& text, Int index) {
    if (index >= text.length) {
        return 0;
    }

    UInt8 byte = text[index];
    if (byte < 128) {
        return 1;
    }

    if (!unicode.is_valid_utf8_at(text, index)) {
        return 1;
    }
    return unicode.utf8_len_at(text, index);
}

public diag.SourcePosition position_at(UInt8[]& text, Int byte_offset, PositionEncoding encoding) {
    Int line! = 0;
    Int character! = 0;
    Int index! = 0;

    while (index < byte_offset && index < text.length) {
        UInt8 byte = text[index];
        if (byte == UInt8(10)) {
            line = line + 1;
            character = 0;
            index = index + 1;
            continue;
        }

        if (byte == UInt8(13)) {
            line = line + 1;
            character = 0;
            index = index + 1;
            if (index < text.length && text[index] == UInt8(10)) {
                index = index + 1;
            }
            continue;
        }

        if (encoding == .utf16) {
            character = character + utf16_width_at(text, index);
        } else {
            character = character + byte_width_at(text, index);
        }
        index = index + byte_width_at(text, index);
    }

    return diag.SourcePosition(byte_offset, line, character);
}

public diag.SourcePosition position_at_source(
    source.Source&! source_record,
    Int byte_offset,
    PositionEncoding encoding
) {
    source_record.ensure_line_starts();
    UInt8[]& text = source_record.text$.ref();
    Int target! = byte_offset;
    if (target < 0) { target = 0; }
    if (target > text.length) { target = text.length; }
    Int line = source_record.line_index_at(target);
    Int line_start = source_record.line_starts.get(line);
    Int character = character_at(text, line_start, target, encoding);
    return diag.SourcePosition(byte_offset, line, character);
}

Int character_at(UInt8[]& text, Int start, Int end, PositionEncoding encoding) {
    Int character! = 0;
    Int index! = start;
    while (index < end) {
        if (encoding == .utf16) {
            character = character + utf16_width_at(text, index);
        } else {
            character = character + byte_width_at(text, index);
        }
        index = index + byte_width_at(text, index);
    }
    return character;
}

public diag.SourceRange range_for_span(
    source.SourceId source_id,
    UInt8[]& text,
    token.Span span,
    PositionEncoding encoding
) {
    diag.SourcePosition start = position_at(text, span.start, encoding);
    diag.SourcePosition end = position_at(text, span.end(), encoding);
    return diag.SourceRange(source_id, span, start, end);
}

public diag.SourceRange lsp_range_for_span(source.SourceId source_id, UInt8[]& text, token.Span span) {
    return range_for_span(source_id, text, span, .utf16);
}
