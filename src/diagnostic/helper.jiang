// 诊断便捷方法。
//
// 各阶段可以把常用诊断构造收敛到这里，避免重复拼 Diagnostic 结构。

import context = "../context.jiang";
import diagnostic = "./diagnostic.jiang";

public () add_package_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
