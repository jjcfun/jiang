// 诊断便捷方法。
//
// 各阶段可以把常用诊断构造收敛到这里，避免重复拼 Diagnostic 结构。

import diagnostic = "../diagnostic.jiang";
import std;

public Void add_package_error(diagnostic.DiagnosticStore&! store, UInt8[]& message, UInt8[]& code) {
    store.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

public Void add_package_error(diagnostic.DiagnosticStore&! store, std.String message, UInt8[]& code) {
    store.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message.bytes()
        )
    );
}

public Void add_warning(
    diagnostic.DiagnosticStore&! store,
    diagnostic.SourceRange range,
    UInt8[]& message,
    UInt8[]& code
) {
    store.add(
        diagnostic.Diagnostic(
            .warning,
            .package,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}
