// 诊断发布与终端展示适配器。
//
// 编译阶段只向 DiagnosticStore 写入事实；CLI、测试和未来 LSP 在编译结束后
// 通过各自的 Sink 消费诊断，展示策略不进入 CompilerStore。

import diagnostic = "../diagnostic.jiang";
import source = "../source.jiang";
import source_store = "../source/store.jiang";
import source_map = "./source_map.jiang";
import string_support = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_io = "../system/io.jiang";
import token = "../syntax/token.jiang";
import std;

public trait Sink {
    Void emit(Self&! self, diagnostic.Diagnostic& item);
}

@where(S: Sink)
public Void publish<S>(diagnostic.DiagnosticStore& store, S&! sink) {
    Int index! = 0;
    while (index < store.len()) {
        sink.emit(store.get(index));
        index = index + 1;
    }
}

@region(a)
struct TerminalSink: Sink {
    @life(a)
    source_store.SourceStore&! sources;

    init(self, source_store.SourceStore&! sources) {
        self.sources = sources;
    }

    Void emit(Self&! self, diagnostic.Diagnostic& item) {
        self.write_primary(item);
        Int related_index! = 0;
        while (related_index < item.related.len()) {
            self.write_related(item.related.ref_at(related_index));
            related_index = related_index + 1;
        }
    }

    Void write_primary(Self&! self, diagnostic.Diagnostic& item) {
        if (item.range.source_id is .some(source_id)) {
            self.write_location(source_id, item.range.span);
        }
        if (item.code.text.length > 0) { write_error_line(item.code.text); }
        UInt8[]& message = item.message.bytes();
        if (message.length > 0) { write_error_line(message); }
    }

    Void write_related(Self&! self, diagnostic.DiagnosticRelatedInformation& related) {
        if (related.range.source_id is .some(source_id)) {
            self.write_location(source_id, related.range.span);
        }
        UInt8[]& message = related.message.bytes();
        if (message.length == 0) { return; }
        std.StringBuilder builder! = std.StringBuilder();
        builder.append_valid_utf8("note: ");
        builder.append_valid_utf8(message);
        write_error_line(builder.slice());
    }

    Void write_location(Self&! self, source.SourceId source_id, token.Span span) {
        UInt8[]^ location = diagnostic_location(self.sources, source_id, span);
        if (location.length == 0) { return; }
        write_error_line(location[..]);
    }
}

public Void report_to_stderr(diagnostic.DiagnosticStore& store, source_store.SourceStore&! sources) {
    TerminalSink sink! = TerminalSink(sources);
    publish<TerminalSink>(store, sink$.mut_ref());
}

UInt8[]^ diagnostic_location(
    source_store.SourceStore&! sources,
    source.SourceId source_id,
    token.Span span
) {
    source.SourceInfo& source_info = sources.entry(source_id);
    UInt8[]& source_name = source_info.name();
    if (source_name.length == 0) { return empty_text(); }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(source_name);
    if (!sources.has_source(source_id)) { return builder.into_slice(); }
    source.Source&! loaded = sources.mut_ref_at(source_id);
    builder.append_valid_utf8(":");
    diagnostic.SourcePosition position = source_map.position_at_source(loaded, span.start, .utf8);
    builder.append(position.line + 1);
    builder.append_valid_utf8(":");
    builder.append(position.character + 1);
    return builder.into_slice();
}

UInt8[]^ empty_text() {
    std.StringBuilder builder! = std.StringBuilder();
    return builder.into_slice();
}

Void write_error_line(UInt8[]& text) {
    system_fs.File err! = system_io.stderr();
    err.write_all(text);
    err.write_all("\n");
}
