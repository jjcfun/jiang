// 后端输出请求校验。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import driver_options = "../driver/options.jiang";
import system_target = "../system/target.jiang";
import string = "../support/string.jiang";
import std;

public Bool validate_output_request(
    context.CompilerContext& ctx,
    driver_options.CompileOptions& options
) {
    system_target.TargetInfo& target = ctx.target$.ref();
    if (!supports_output(target, options.emit)) {
        std.String message = unsupported_output_message(target, options.emit);
        diagnostic_helper.add_package_error(
            ctx,
            message.bytes(),
            unsupported_output_code(target, options.emit)
        );
        return false;
    }
    if (!target.link_libc && options.emit == .executable && !system_target.is_linux_no_libc(target)) {
        diagnostic_helper.add_package_error(
            ctx,
            "--no-link-libc executable output is not supported yet; select object/llvm output or use --link-libc",
            "no_link_libc_executable_unsupported"
        );
        return false;
    }
    return true;
}

Bool supports_output(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit != .executable) {
        return true;
    }
    return system_target.target_supports_executable(target);
}

std.String unsupported_output_message(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit == .executable) {
        system_target.ExecutableSupport support = system_target.executable_support(target);
        if (support == .requires_toolchain) {
            return string.concat(
                "executable output requires target linker/toolchain support: ",
                target.requested_triple
            );
        }
        if (support == .requires_runtime) {
            return string.concat("executable output requires target runtime object support: ", target.requested_triple);
        }
        if (support == .unsupported_runtime) {
            return string.concat("executable output requires target runtime support: ", target.requested_triple);
        }
        return string.concat("executable output is not supported for target yet: ", target.requested_triple);
    }
    return string.concat("output is not supported for target: ", target.requested_triple);
}

UInt8[]& unsupported_output_code(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit == .executable) {
        system_target.ExecutableSupport support = system_target.executable_support(target);
        if (support == .requires_toolchain) {
            return "target_executable_requires_toolchain";
        }
        if (support == .requires_runtime) {
            return "target_executable_requires_runtime";
        }
        if (support == .unsupported_runtime) {
            return "target_executable_runtime_unsupported";
        }
        return "target_executable_unsupported";
    }
    return "target_output_unsupported";
}
