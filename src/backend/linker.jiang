// Linker driver。
//
// LinkPlan 只描述输入；这里负责把输入转换成 argv，并通过 system/process
// 执行外部 linker。pipeline 只调用这个边界，不拼 shell command。

import link_plan = "./link_plan.jiang";
import driver_options = "../driver/options.jiang";
import build_sdk = "../build/sdk.jiang";
import list = "../support/list.jiang";
import process = "../system/process.jiang";
import string = "../support/string.jiang";
import system_target = "../system/target.jiang";
import std;

public struct LinkResult: Copyable {
    public Bool ok;
    public Bool started;
    public Int exit_code;

    public init(self, Bool ok, Bool started, Int exit_code) {
        self.ok = ok;
        self.started = started;
        self.exit_code = exit_code;
    }
}

public LinkResult link(
    link_plan.LinkPlan& plan,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    list.ArrayList<UInt8[]&> args! = link_args(plan, output_path, extra_args);
    process.ProcessResult result = process.run(linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public LinkResult link_for_target(
    link_plan.LinkPlan& plan,
    system_target.TargetInfo& target,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    Path? wasi_sysroot = target_wasi_sysroot(target);
    UInt8[]&? wasi_text! = null;
    if (wasi_sysroot is .some(ref _ path)) {
        wasi_text = path.text();
    }
    list.ArrayList<UInt8[]&> args! = target_link_args(
        plan,
        target,
        output_path,
        extra_args,
        build_sdk.sdkroot_for_target(target),
        wasi_text
    );
    process.ProcessResult result = process.run(linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public LinkResult link_dynamic_library_for_target(
    link_plan.LinkPlan& plan,
    system_target.TargetInfo& target,
    driver_options.CompileOptions& options
) {
    list.ArrayList<UInt8[]&> args! = target_dynamic_library_link_args_for_options(plan, target, options);
    process.ProcessResult result = process.run(options.linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public std.String failure_message(
    LinkResult result,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    link_plan.LinkPlan& links
) {
    UInt8[]& status_label! = ", spawn_errno=";
    if (result.started) {
        status_label = ", exit_code=";
    }
    Int exit_code = result.exit_code;
    Int input_count = links.len();
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("linker execution failed: linker=");
    builder.append_valid_utf8(linker_path);
    builder.append_valid_utf8(status_label);
    builder.append(exit_code);
    builder.append(", output=");
    builder.append_valid_utf8(output_path_or_default(output_path));
    builder.append(", inputs=");
    builder.append(input_count);
    return builder.into_string();
}

UInt8[]& output_path_or_default(UInt8[]& output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}

@life(return: plan & output_path & extra_args)
public list.ArrayList<UInt8[]&> link_args(
    link_plan.LinkPlan& plan,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>(plan.len() + extra_args.len() + 2);
    Int index! = 0;
    while (index < plan.len()) {
        append_link_input(args$.mut_ref(), plan.input_at(index));
        index = index + 1;
    }
    index = 0;
    while (index < extra_args.len()) {
        args.add(extra_args.get(index));
        index = index + 1;
    }
    args.add("-o");
    args.add(final_output_path(output_path));
    return args;
}

@life(return: plan & target & output_path & extra_args & sdkroot & wasi_sysroot)
public list.ArrayList<UInt8[]&> target_link_args(
    link_plan.LinkPlan& plan,
    system_target.TargetInfo& target,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args,
    UInt8[]&? sdkroot,
    UInt8[]&? wasi_sysroot
) {
    Int target_arg_count! = 0;
    if (!target.is_default && !system_target.is_linux_no_libc(target)) {
        target_arg_count = 2;
    }
    Int sdkroot_arg_count = sdkroot_arg_count_for(target, sdkroot);
    Int no_libc_arg_count = no_libc_executable_arg_count(target);
    Int linux_hosted_arg_count = linux_hosted_executable_arg_count(target);
    Int wasi_arg_count = wasi_executable_arg_count(target);
    Int hosted_system_arg_count = hosted_system_link_arg_count(target);
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>(
        plan.len() + extra_args.len() + target_arg_count + sdkroot_arg_count + no_libc_arg_count +
            linux_hosted_arg_count + wasi_arg_count + hosted_system_arg_count + 2
    );
    append_target_args(args$.mut_ref(), target);
    append_sdkroot_args(args$.mut_ref(), target, sdkroot);
    append_no_libc_executable_args(args$.mut_ref(), target);
    append_wasi_executable_args(args$.mut_ref(), target, wasi_sysroot);
    append_plan_inputs(args$.mut_ref(), plan);
    append_extra_args(args$.mut_ref(), extra_args);
    append_linux_hosted_executable_args(args$.mut_ref(), target);
    append_hosted_system_link_args(args$.mut_ref(), target);
    args.add("-o");
    args.add(final_output_path(output_path));
    return args;
}

@life(return: plan & target & options)
list.ArrayList<UInt8[]&> target_dynamic_library_link_args_for_options(
    link_plan.LinkPlan& plan,
    system_target.TargetInfo& target,
    driver_options.CompileOptions& options
) {
    UInt8[]&? sdkroot = build_sdk.sdkroot_for_target(target);
    Int target_arg_count! = 0;
    if (!target.is_default) {
        target_arg_count = 2;
    }
    Int sdkroot_arg_count = sdkroot_arg_count_for(target, sdkroot);
    Int hosted_system_arg_count = hosted_system_link_arg_count(target);
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>(
        plan.len() + options.link_args.len() + target_arg_count + sdkroot_arg_count + hosted_system_arg_count + 5
    );
    append_target_args(args$.mut_ref(), target);
    append_sdkroot_args(args$.mut_ref(), target, sdkroot);
    append_dynamic_library_arg(args$.mut_ref(), target);
    append_plan_inputs(args$.mut_ref(), plan);
    append_extra_args(args$.mut_ref(), options.link_args$.ref());
    append_hosted_system_link_args(args$.mut_ref(), target);
    args.add("-o");
    args.add(final_output_path(dynamic_library_output_path(options)));
    return args;
}

UInt8[]& dynamic_library_output_path(driver_options.CompileOptions& options) {
    if (string.equal(options.output_path, "new") && has_suffix(options.input_path, ".wrapper")) {
        return options.input_path[0..(options.input_path.length - ".wrapper".length)];
    }
    return options.output_path;
}

Bool has_suffix(UInt8[]& text, UInt8[]& suffix) {
    if (text.length < suffix.length) {
        return false;
    }
    Int index! = 0;
    Int start = text.length - suffix.length;
    while (index < suffix.length) {
        if (text[start + index] != suffix[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

@life(return: plan & target & output_path & extra_args & sdkroot)
public list.ArrayList<UInt8[]&> target_dynamic_library_link_args_with_sdkroot(
    link_plan.LinkPlan& plan,
    system_target.TargetInfo& target,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args,
    UInt8[]&? sdkroot
) {
    Int target_arg_count! = 0;
    if (!target.is_default) {
        target_arg_count = 2;
    }
    Int sdkroot_arg_count = sdkroot_arg_count_for(target, sdkroot);
    Int hosted_system_arg_count = hosted_system_link_arg_count(target);
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>(
        plan.len() + extra_args.len() + target_arg_count + sdkroot_arg_count + hosted_system_arg_count + 5
    );
    append_target_args(args$.mut_ref(), target);
    append_sdkroot_args(args$.mut_ref(), target, sdkroot);
    append_dynamic_library_arg(args$.mut_ref(), target);
    append_plan_inputs(args$.mut_ref(), plan);
    append_extra_args(args$.mut_ref(), extra_args);
    append_hosted_system_link_args(args$.mut_ref(), target);
    args.add("-o");
    args.add(final_output_path(output_path));
    return args;
}

Int sdkroot_arg_count_for(system_target.TargetInfo& target, UInt8[]&? sdkroot) {
    if (!target_needs_sdkroot(target)) {
        return 0;
    }
    if (sdkroot == null) {
        return 0;
    }
    return 2;
}

Int no_libc_executable_arg_count(system_target.TargetInfo& target) {
    if (system_target.is_linux_no_libc(target)) {
        return 2;
    }
    return 0;
}

Int wasi_executable_arg_count(system_target.TargetInfo& target) {
    if (target.provider == .wasi) {
        return 2;
    }
    return 0;
}

Int hosted_system_link_arg_count(system_target.TargetInfo& target) {
    if (target.provider == .linux_hosted && target.link_libc) {
        return 2;
    }
    return 0;
}

Int linux_hosted_executable_arg_count(system_target.TargetInfo& target) {
    if (target.provider == .linux_hosted && target.link_libc) {
        return 1;
    }
    return 0;
}

Bool target_needs_sdkroot(system_target.TargetInfo& target) {
    return build_sdk.target_needs_sdkroot(target);
}

@life(args.a: target)
Void append_target_args(list.ArrayList<UInt8[]&>&! args, system_target.TargetInfo& target) {
    if (target.is_default) {
        return;
    }
    if (system_target.is_linux_no_libc(target)) {
        return;
    }
    args.add("-target");
    args.add(target.llvm_triple.bytes());
}

@life(args.a: sdkroot)
Void append_sdkroot_args(
    list.ArrayList<UInt8[]&>&! args,
    system_target.TargetInfo& target,
    UInt8[]&? sdkroot
) {
    if (!target_needs_sdkroot(target)) {
        return;
    }
    guard sdkroot is .some(path) else {
        return;
    }
    args.add("-isysroot");
    args.add(path);
}

Void append_no_libc_executable_args(list.ArrayList<UInt8[]&>&! args, system_target.TargetInfo& target) {
    if (!system_target.is_linux_no_libc(target)) {
        return;
    }
    args.add("-m");
    args.add(linux_no_libc_emulation(target));
    args.add("-static");
}

Path? target_wasi_sysroot(system_target.TargetInfo& target) {
    if (target.provider != .wasi) {
        return null;
    }
    return build_sdk.wasi_sysroot_path();
}

Void append_wasi_executable_args(
    list.ArrayList<UInt8[]&>&! args,
    system_target.TargetInfo& target,
    UInt8[]&? sysroot
) {
    if (target.provider != .wasi) {
        return;
    }
    guard sysroot is .some(path) else {
        return;
    }
    args.add("--sysroot");
    args.add(path);
}

@life()
UInt8[]& linux_no_libc_emulation(system_target.TargetInfo& target) {
    if (target.arch == .arm64) {
        return "aarch64linux";
    }
    return "elf_x86_64";
}

@life(args.a: plan)
Void append_plan_inputs(list.ArrayList<UInt8[]&>&! args, link_plan.LinkPlan& plan) {
    Int index! = 0;
    while (index < plan.len()) {
        append_link_input(args, plan.input_at(index));
        index = index + 1;
    }
}

@life(args.a: extra_args.a)
Void append_extra_args(list.ArrayList<UInt8[]&>&! args, list.ArrayList<UInt8[]&>& extra_args) {
    Int index! = 0;
    while (index < extra_args.len()) {
        args.add(extra_args.get(index));
        index = index + 1;
    }
}

Void append_hosted_system_link_args(
    list.ArrayList<UInt8[]&>&! args,
    system_target.TargetInfo& target
) {
    if (target.provider != .linux_hosted || !target.link_libc) {
        return;
    }
    args.add("-pthread");
    args.add("-ldl");
}

Void append_linux_hosted_executable_args(
    list.ArrayList<UInt8[]&>&! args,
    system_target.TargetInfo& target
) {
    if (target.provider == .linux_hosted && target.link_libc) {
        args.add("-no-pie");
    }
}

@life(args.a: input)
Void append_link_input(list.ArrayList<UInt8[]&>&! args, link_plan.LinkInput& input) {
    // 当前所有 linker input 都按 path 传给 linker driver。static/dynamic library 的
    // `-l`/`-L` 细分由后续 package dependency metadata 决定。
    args.add(input.path.bytes());
}

Void append_dynamic_library_arg(list.ArrayList<UInt8[]&>&! args, system_target.TargetInfo& target) {
    if (target.os == .host || target.os == .macos) {
        args.add("-dynamiclib");
        args.add("-undefined");
        args.add("dynamic_lookup");
        return;
    }
    args.add("-shared");
}

UInt8[]& final_output_path(UInt8[]& output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}
