// Linker driver。
//
// LinkPlan 只描述输入；这里负责把输入转换成 argv，并通过 support/process
// 执行外部 linker。pipeline 只调用这个边界，不拼 shell command。

import link_plan = "./link_plan.jiang";
import list = "../support/list.jiang";
import process = "../support/process.jiang";

public struct LinkResult {
    public Bool ok;
    public Bool started;
    public Int exit_code;

    public init(Bool ok, Bool started, Int exit_code) {
        self.ok = ok;
        self.started = started;
        self.exit_code = exit_code;
    }
}

public LinkResult link(
    link_plan.LinkPlan& plan,
    UInt8[] linker_path,
    UInt8[] output_path
) {
    list.ArrayList<UInt8[]>! args = link_args(plan, output_path);
    process.ProcessResult result = process.run(linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public list.ArrayList<UInt8[]> link_args(link_plan.LinkPlan& plan, UInt8[] output_path) {
    list.ArrayList<UInt8[]>! args = list.ArrayList<UInt8[]>(plan.len() + 2);
    Int! index = 0;
    while (index < plan.len()) {
        append_link_input(args$.ref(), plan.input_at(index));
        index = index + 1;
    }
    args.add("-o");
    args.add(final_output_path(output_path));
    return args$.move();
}

() append_link_input(list.ArrayList<UInt8[]>& args, link_plan.LinkInput& input) {
    // 当前所有 linker input 都按 path 传给 linker driver。static/dynamic library 的
    // `-l`/`-L` 细分由后续 package dependency metadata 决定。
    args.add(input.path);
}

UInt8[] final_output_path(UInt8[] output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}
