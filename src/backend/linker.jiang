// Linker driver。
//
// LinkPlan 只描述输入；这里负责把输入转换成 argv，并通过 system/process
// 执行外部 linker。pipeline 只调用这个边界，不拼 shell command。

import link_plan = "./link_plan.jiang";
import driver_target = "../driver/target.jiang";
import list = "../support/list.jiang";
import env = "../system/env.jiang";
import process = "../system/process.jiang";

public struct LinkResult {
    public Bool ok;
    public Bool started;
    public Int exit_code;

    public init(Bool ok, Bool started, Int exit_code) {
        self.ok = ok;
        self.started = started;
        self.exit_code = exit_code;
    }
}

public LinkResult link(
    link_plan.LinkPlan& plan,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    list.ArrayList<UInt8[]&>! args = link_args(plan, output_path, extra_args);
    process.ProcessResult result = process.run(linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public LinkResult link_for_target(
    link_plan.LinkPlan& plan,
    driver_target.TargetInfo& target,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    list.ArrayList<UInt8[]&>! args = target_link_args(plan, target, output_path, extra_args);
    process.ProcessResult result = process.run(linker_path, args$.ref());
    return LinkResult(result.ok(), result.started, result.exit_code);
}

public list.ArrayList<UInt8[]&> link_args(
    link_plan.LinkPlan& plan,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    list.ArrayList<UInt8[]&>! args = list.ArrayList<UInt8[]&>(plan.len() + extra_args.len() + 2);
    Int! index = 0;
    while (index < plan.len()) {
        append_link_input(args$.ref(), plan.input_at(index));
        index = index + 1;
    }
    index = 0;
    while (index < extra_args.len()) {
        args.add(extra_args.get(index));
        index = index + 1;
    }
    args.add("-o");
    args.add(final_output_path(output_path));
    return args$.move();
}

public list.ArrayList<UInt8[]&> target_link_args(
    link_plan.LinkPlan& plan,
    driver_target.TargetInfo& target,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args
) {
    return target_link_args_with_sdkroot(plan, target, output_path, extra_args, macos_sdkroot(target));
}

public list.ArrayList<UInt8[]&> target_link_args_with_sdkroot(
    link_plan.LinkPlan& plan,
    driver_target.TargetInfo& target,
    UInt8[]& output_path,
    list.ArrayList<UInt8[]&>& extra_args,
    UInt8[]&? sdkroot
) {
    Int! target_arg_count = 0;
    if (!target.is_default) {
        target_arg_count = 2;
    }
    Int sdkroot_arg_count = sdkroot_arg_count_for(target, sdkroot);
    list.ArrayList<UInt8[]&>! args = list.ArrayList<UInt8[]&>(
        plan.len() + extra_args.len() + target_arg_count + sdkroot_arg_count + 2
    );
    append_target_args(args$.ref(), target);
    append_sdkroot_args(args$.ref(), target, sdkroot);
    append_plan_inputs(args$.ref(), plan);
    append_extra_args(args$.ref(), extra_args);
    args.add("-o");
    args.add(final_output_path(output_path));
    return args$.move();
}

UInt8[]&? macos_sdkroot(driver_target.TargetInfo& target) {
    if (!target_needs_sdkroot(target)) {
        return null;
    }
    guard env.get("SDKROOT") is some sdkroot else {
        return macos_sdkroot_from_xcrun();
    }
    if (sdkroot.length == 0) {
        return macos_sdkroot_from_xcrun();
    }
    return sdkroot[..];
}

UInt8[]&? macos_sdkroot_from_xcrun() {
    list.ArrayList<UInt8[]&>! args = list.ArrayList<UInt8[]&>();
    args.add("--sdk");
    args.add("macosx");
    args.add("--show-sdk-path");
    process.RunOptions! options = process.RunOptions();
    options.stdout = .pipe;
    options.stderr = .discard;
    process.ProcessResult result = process.run("xcrun", args$.ref(), options$.ref());
    if (!result.ok()) {
        return null;
    }
    UInt8[]& path = trim_trailing_newline(result.stdout);
    if (path.length == 0) {
        return null;
    }
    return path;
}

UInt8[]& trim_trailing_newline(UInt8[]& text) {
    if (text.length == 0) {
        return text;
    }
    if (text[text.length - 1] == UInt8(10)) {
        return text[0..(text.length - 1)];
    }
    return text;
}

Int sdkroot_arg_count_for(driver_target.TargetInfo& target, UInt8[]&? sdkroot) {
    if (!target_needs_sdkroot(target)) {
        return 0;
    }
    if (sdkroot == null) {
        return 0;
    }
    return 2;
}

Bool target_needs_sdkroot(driver_target.TargetInfo& target) {
    return !target.is_default && driver_target.target_needs_macos_sdkroot(target);
}

() append_target_args(list.ArrayList<UInt8[]&>& args, driver_target.TargetInfo& target) {
    if (target.is_default) {
        return;
    }
    args.add("-target");
    args.add(target.llvm_triple);
}

() append_sdkroot_args(
    list.ArrayList<UInt8[]&>& args,
    driver_target.TargetInfo& target,
    UInt8[]&? sdkroot
) {
    if (!target_needs_sdkroot(target)) {
        return;
    }
    guard sdkroot is some path else {
        return;
    }
    args.add("-isysroot");
    args.add(path);
}

() append_plan_inputs(list.ArrayList<UInt8[]&>& args, link_plan.LinkPlan& plan) {
    Int! index = 0;
    while (index < plan.len()) {
        append_link_input(args, plan.input_at(index));
        index = index + 1;
    }
}

() append_extra_args(list.ArrayList<UInt8[]&>& args, list.ArrayList<UInt8[]&>& extra_args) {
    Int! index = 0;
    while (index < extra_args.len()) {
        args.add(extra_args.get(index));
        index = index + 1;
    }
}

() append_link_input(list.ArrayList<UInt8[]&>& args, link_plan.LinkInput& input) {
    // 当前所有 linker input 都按 path 传给 linker driver。static/dynamic library 的
    // `-l`/`-L` 细分由后续 package dependency metadata 决定。
    args.add(input.path);
}

UInt8[]& final_output_path(UInt8[]& output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}
