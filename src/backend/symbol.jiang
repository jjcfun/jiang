// Backend 符号身份。
//
// JIL 已经把泛型函数展开成 concrete function。backend 不应该只用 DefId
// 生成符号，否则同一个泛型函数的不同 type args 会冲突。这里先定义
// backend-independent key，后续真实 codegen/mangling 都从这个 key 派生。

import jil = "../jil.jiang";
import object_key_builder = "../artifact/object_key_builder.jiang";
import core_traits = "../core/traits.jiang";
import context = "../context.jiang";
import lang_abi = "../lang/abi.jiang";
import def = "../resolve/def.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import std;

@region(a, b, c)
public struct BackendSymbolKey: Copyable, Hashable, Equatable {
    public Int package_index;
    public Int module_index;
    public qid.DefId def_id;
    @life(a)
    public qid.TypeId[]& type_args;

    @life(b, c)
    public comptime_value.ComptimeValue[]& const_args;
    public Bool runtime_entry;
    public Bool coroutine_resume;
    public Bool coroutine_completion;

    public init(self,
        Int package_index,
        Int module_index,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        Bool runtime_entry,
        Bool coroutine_resume,
        Bool coroutine_completion
    ) {
        self.package_index = package_index;
        self.module_index = module_index;
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = const_args;
        self.runtime_entry = runtime_entry;
        self.coroutine_resume = coroutine_resume;
        self.coroutine_completion = coroutine_completion;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.package_index));
        hasher.write(Int(self.module_index));
        hasher.write(Int(self.def_id.to_index()));
        Bool runtime_entry = self.runtime_entry;
        Bool coroutine_resume = self.coroutine_resume;
        Bool coroutine_completion = self.coroutine_completion;
        hasher.write(runtime_entry);
        hasher.write(coroutine_resume);
        hasher.write(coroutine_completion);
        hasher.write(Int(self.type_args.length));
        Int index! = 0;
        while (index < self.type_args.length) {
            hasher.write(Int(self.type_args[index].to_index()));
            index = index + 1;
        }
        hasher.write(Int(self.const_args.length));
        index = 0;
        while (index < self.const_args.length) {
            write_comptime_value_hash(hasher, self.const_args[index]);
            index = index + 1;
        }
    }

    public Bool equal(BackendSymbolKey& lhs, BackendSymbolKey& rhs) {
        if (lhs.package_index != rhs.package_index) {
            return false;
        }
        if (lhs.module_index != rhs.module_index) {
            return false;
        }
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.runtime_entry != rhs.runtime_entry) {
            return false;
        }
        if (lhs.coroutine_resume != rhs.coroutine_resume) {
            return false;
        }
        if (lhs.coroutine_completion != rhs.coroutine_completion) { return false; }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return comptime_value_slices_equal(lhs.const_args, rhs.const_args);
    }
}

@life(return: (value, value, value))
public BackendSymbolKey symbol_key_for_function_ref(
    context.CompilerContext& ctx,
    jil.FunctionRef value,
    Bool runtime_entry
) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(value.function_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        value.function_def,
        value.type_args,
        value.const_args,
        runtime_entry,
        value.coroutine_resume,
        value.coroutine_completion
    );
}

@life(return: (function.a, function.b, function.c))
public BackendSymbolKey function_symbol_key(context.CompilerContext& ctx, jil.Function& function) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(function.def_id).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        function.def_id,
        function.type_args,
        function.const_args,
        function.is_runtime_entry,
        function.is_coroutine_resume,
        function.is_coroutine_completion
    );
}

// backend 对外发出的符号名必须从 BackendSymbolKey 派生，而不是直接使用源码名字。
// 源码名字可能在不同 namespace 重复；泛型函数的不同 concrete type args 也需要
// 生成不同 symbol。这里先用纯数字 key 生成 backend-independent 名字，LLVM backend
// 后续只消费这个结果。
public std.String function_symbol_name(context.CompilerContext& ctx, jil.Function& function) {
    if (function.is_runtime_entry) {
        return std.String(language_entry_symbol());
    }
    if (function.is_coroutine_resume || function.is_coroutine_completion) {
        return symbol_name(function_symbol_key(ctx, function));
    }
    if (is_lang_provider_entry(ctx, function)) {
        qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
        return std.String(ctx.store.symbols.text(symbol_id));
    }
    if (link_symbol_for_def(ctx, function.def_id) is .some(link_symbol)) {
        return std.String(ctx.store.symbols.text(link_symbol));
    }
    if (function_uses_source_abi_symbol(ctx, function)) {
        qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
        return std.String(ctx.store.symbols.text(symbol_id));
    }
    return stable_function_symbol_name(ctx, function);
}

public Bool function_uses_source_abi_symbol(context.CompilerContext& ctx, jil.Function& function) {
    if (function.is_coroutine_resume || function.is_coroutine_completion) {
        return false;
    }
    guard ctx.store.model.def(function.def_id) is .some(model_def) else {
        return function.is_external;
    }
    return model_def.decl.extern_kind != .none;
}

std.String stable_function_symbol_name(context.CompilerContext& ctx, jil.Function& function) {
    guard ctx.store.incremental.stable_id_for_def(function.def_id) is .some(stable_id) else {
        return symbol_name(function_symbol_key(ctx, function));
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("_Js");
    builder.append(Int(stable_id.low));
    builder.append("_");
    builder.append(Int(stable_id.high));
    std.String name! = builder.into_string();
    Int index! = 0;
    while (index < function.type_args.length) {
        qkey.Fingerprint128 fingerprint = object_key_builder.stable_type_fingerprint_for_type(
            ctx,
            function.type_args[index]
        );
        name = append_fingerprint_part(name, "_T", fingerprint);
        index = index + 1;
    }
    index = 0;
    while (index < function.const_args.length) {
        qkey.Fingerprint128 fingerprint =
            object_key_builder.stable_comptime_value_fingerprint(ctx, function.const_args[index]);
        name = append_fingerprint_part(name, "_C", fingerprint);
        index = index + 1;
    }
    if (function.is_coroutine_resume) { name = append_text(name, "_Resume"); }
    if (function.is_coroutine_completion) { name = append_text(name, "_Complete"); }
    return name;
}

Bool is_lang_provider_entry(context.CompilerContext& ctx, jil.Function& function) {
    if (function.type_args.length != 0 || function.const_args.length != 0) {
        return false;
    }
    if (ctx.store.defs.get(function.def_id).kind != .function_def) {
        return false;
    }
    qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
    return is_lang_provider_entry_name(ctx.store.symbols.text(symbol_id));
}

Bool is_lang_provider_entry_name(UInt8[]& name) {
    return string.equal(name, lang_abi.create_symbol());
}

public std.String global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    return global_symbol_name_for_def(ctx, global_def, false);
}

public std.String global_symbol_name_for_def(context.CompilerContext& ctx, qid.DefId global_def, Bool is_external) {
    if (link_symbol_for_def(ctx, global_def) is .some(link_symbol)) {
        return std.String(ctx.store.symbols.text(link_symbol));
    }
    if (is_external) {
        return source_global_symbol_name(ctx, global_def);
    }
    std.String owner_prefix = global_def_owner_prefix(ctx, global_def);
    return global_backend_symbol_name(owner_prefix.bytes(), global_def);
}

qid.SymbolId? link_symbol_for_def(context.CompilerContext& ctx, qid.DefId def_id) {
    guard ctx.store.model.def(def_id) is .some(model_def) else { return null; }
    return model_def.decl.link_symbol;
}

public std.String global_backend_symbol_name(UInt8[]& owner_prefix, qid.DefId global_def) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(owner_prefix);
    builder.append("_g");
    builder.append(global_def.to_index());
    return builder.into_string();
}

std.String global_def_owner_prefix(context.CompilerContext& ctx, qid.DefId global_def) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(global_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    std.StringBuilder builder = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    return builder.into_string();
}

public std.String source_global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    qid.SymbolId symbol_id = ctx.store.defs.get(global_def).name.symbol;
    return std.String(ctx.store.symbols.text(symbol_id));
}

public std.String symbol_name(BackendSymbolKey key) {
    std.String name! = symbol_base_name(key.package_index, key.module_index, key.def_id.to_index());
    Int index! = 0;
    while (index < key.type_args.length) {
        name = append_int_part(name, "_T", key.type_args[index].to_index());
        index = index + 1;
    }
    index = 0;
    while (index < key.const_args.length) {
        std.String part = comptime_value_symbol_part(key.const_args[index]);
        name = append_text(name, "_C");
        name = append_text(name, part.bytes());
        index = index + 1;
    }
    if (key.coroutine_resume) {
        name = append_text(name, "_Resume");
    }
    if (key.coroutine_completion) {
        name = append_text(name, "_Complete");
    }
    return name;
}

std.String symbol_base_name(Int package_index, Int module_index, Int def_index) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    builder.append("_f");
    builder.append(def_index);
    return builder.into_string();
}

std.String append_int_part(std.String prefix, UInt8[]& marker, Int value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(marker);
    builder.append(value);
    return builder.into_string();
}

std.String append_fingerprint_part(
    std.String prefix,
    UInt8[]& marker,
    qkey.Fingerprint128 fingerprint
) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(marker);
    builder.append(Int(fingerprint.low));
    builder.append("_");
    builder.append(Int(fingerprint.high));
    return builder.into_string();
}

std.String append_text(std.String prefix, UInt8[]& text) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(text);
    return builder.into_string();
}

public () write_comptime_value_hash<H: core_traits.Hasher>(
    H&! hasher,
    comptime_value.ComptimeValue value
) {
    hasher.write(Int(value.type_id.to_index()));
    if (value.data is .invalid) { hasher.write(Int(1)); return; }
    if (value.data is .unit_value) { hasher.write(Int(2)); return; }
    if (value.data is .bool_value(bool_value)) {
        hasher.write(Int(3));
        hasher.write(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        hasher.write(Int(4));
        hasher.write(Int(int_value));
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        hasher.write(Int(5));
        hasher.write(UInt64(uint_value));
        return;
    }
    if (value.data is .char_value(char_value)) {
        hasher.write(Int(6));
        hasher.write(UInt64(char_value));
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        hasher.write(Int(7));
        hasher.write(Int(symbol_value.to_index()));
        return;
    }
    if (value.data is .const_param_value(const_param)) {
        hasher.write(Int(8));
        hasher.write(Int(const_param.to_index()));
        return;
    }
    if (value.data is .enum_case_value(enum_case)) {
        hasher.write(Int(9));
        hasher.write(Int(enum_case.to_index()));
        return;
    }
    hasher.write(Int(99));
}

public Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    return false;
}

std.String comptime_value_symbol_part(comptime_value.ComptimeValue value) {
    std.StringBuilder builder = std.StringBuilder();
    if (value.data is .bool_value(bool_value)) {
        if (bool_value) { return std.String("b1"); }
        builder.append("b0");
        return builder.into_string();
    }
    if (value.data is .int_value(int_value)) {
        builder.append("i");
        builder.append(int_value);
        return builder.into_string();
    }
    if (value.data is .uint_value(uint_value)) {
        builder.append("u");
        builder.append(Int(uint_value));
        return builder.into_string();
    }
    if (value.data is .char_value(char_value)) {
        builder.append("c");
        builder.append(Int(char_value));
        return builder.into_string();
    }
    if (value.data is .symbol_value(symbol_value)) {
        builder.append("s");
        builder.append(symbol_value.to_index());
        return builder.into_string();
    }
    if (value.data is .enum_case_value(enum_case)) {
        builder.append("e");
        builder.append(enum_case.to_index());
        return builder.into_string();
    }
    if (value.data is .const_param_value(const_param)) {
        builder.append("p");
        builder.append(const_param.to_index());
        return builder.into_string();
    }
    return std.String("x");
}

public Bool validate_unique_function_symbols(context.CompilerContext& ctx, jil.Store& store) {
    table.HashTable<BackendSymbolKey, Bool> seen! = table.HashTable<BackendSymbolKey, Bool>();
    Int index! = 0;
    while (index < store.functions.len()) {
        jil.Function& function = store.functions.ref_at(index);
        BackendSymbolKey key = function_symbol_key(ctx, function);
        if (seen.has(key)) {
            return false;
        }
        seen.set(key, true);
        index = index + 1;
    }
    return true;
}

public Bool validate_unique_function_symbol_names(context.CompilerContext& ctx, jil.Store& store) {
    return duplicate_function_symbol_name(ctx, store) == null;
}

public std.String? duplicate_function_symbol_name(context.CompilerContext& ctx, jil.Store& store) {
    table.MultiTable<UInt64, Int> indexes! = table.MultiTable<UInt64, Int>();
    Int index! = 0;
    while (index < store.functions.len()) {
        jil.Function& function = store.functions.ref_at(index);
        std.String symbol_name = function_symbol_name(ctx, function);
        UInt64 name_hash = hash.hash_bytes(symbol_name.bytes());
        Int? previous_index = duplicate_symbol_function_index(
            ctx,
            store,
            indexes$.ref(),
            name_hash,
            symbol_name.bytes()
        );
        if (previous_index is .some(existing_index)) {
            Int previous_index = existing_index;
            jil.Function& previous = store.functions.ref_at(previous_index);
            if (!compatible_duplicate_function_name(ctx, previous, function)) {
                return duplicate_function_symbol_description(ctx, symbol_name.bytes(), previous, function);
            }
        }
        indexes.add(name_hash, index);
        index = index + 1;
    }
    return null;
}

Int? duplicate_symbol_function_index(
    context.CompilerContext& ctx,
    jil.Store& store,
    table.MultiTable<UInt64, Int>& indexes,
    UInt64 name_hash,
    UInt8[]& symbol_name
) {
    table.MultiTableCursor cursor! = indexes.first(name_hash);
    while (cursor.valid()) {
        Int previous_index = indexes.get(cursor);
        jil.Function& previous = store.functions.ref_at(previous_index);
        std.String previous_name = function_symbol_name(ctx, previous);
        if (string.equal(previous_name.bytes(), symbol_name)) {
            return previous_index;
        }
        cursor = indexes.next(cursor);
    }
    return null;
}

std.String duplicate_function_symbol_description(
    context.CompilerContext& ctx,
    UInt8[]& symbol_name,
    jil.Function& lhs,
    jil.Function& rhs
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(symbol_name);
    append_function_instance_description(ctx, builder$.mut_ref(), lhs);
    append_function_instance_description(ctx, builder$.mut_ref(), rhs);
    return builder.into_string();
}

() append_function_instance_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    jil.Function& function
) {
    builder.append(" [");
    builder.append(ctx.store.symbols.text(ctx.store.defs.get(function.def_id).name.symbol));
    builder.append(" types:");
    Int index! = 0;
    while (index < function.type_args.length) {
        builder.append(" ");
        builder.append(function.type_args[index].to_index());
        append_type_instance_description(ctx, builder, function.type_args[index]);
        index = index + 1;
    }
    builder.append("]");
}

() append_type_instance_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.TypeId type_id
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.is_mutable) { builder.append(":mutable"); }
    if (info.type_owner_def is .some(owner_def)) {
        builder.append(":owner=");
        builder.append(ctx.store.symbols.text(ctx.store.defs.get(owner_def).name.symbol));
    }
    append_type_data_description(ctx, builder, info.data);
}

() append_type_data_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    types.TypeData data
) {
    if (data is .invalid) { builder.append(":invalid"); return; }
    if (data is .never) { builder.append(":never"); return; }
    if (data is .unit) { builder.append(":unit"); return; }
    if (data is .bool_type) { builder.append(":bool"); return; }
    if (data is .char_type) { builder.append(":char"); return; }
    if (data is .int_type(value)) { builder.append(":int="); builder.append(value.bits); return; }
    if (data is .float_type(value)) { builder.append(":float="); builder.append(value.bits); return; }
    if (data is .named(value)) {
        builder.append(":named=");
        builder.append(ctx.store.symbols.text(ctx.store.defs.get(value.def_id).name.symbol));
        return;
    }
    if (data is .trait_companion) { builder.append(":trait-companion"); return; }
    if (data is .optional) { builder.append(":optional"); return; }
    if (data is .error_union) { builder.append(":error-union"); return; }
    if (data is .handle_type(value)) {
        builder.append(":handle=");
        builder.append(Int(value.kind));
        return;
    }
    if (data is .slice_value_type) { builder.append(":slice-value"); return; }
    if (data is .array_type) { builder.append(":array"); return; }
    if (data is .tuple_type) { builder.append(":tuple"); return; }
    if (data is .function_type) { builder.append(":function"); return; }
    builder.append(":task");
}

Bool compatible_duplicate_function_name(context.CompilerContext& ctx, jil.Function& lhs, jil.Function& rhs) {
    if (lhs.is_external && rhs.is_external) {
        return external_function_signature_equal(ctx, lhs, rhs);
    }
    if (same_stable_function_instance(ctx, lhs, rhs)) {
        return true;
    }
    return runtime_entry_extern_duplicate(ctx, lhs, rhs);
}

public Bool same_stable_function_instance(
    context.CompilerContext& ctx,
    jil.Function& lhs,
    jil.Function& rhs
) {
    if (lhs.def_id != rhs.def_id) { return false; }
    if (lhs.is_runtime_entry != rhs.is_runtime_entry) { return false; }
    if (lhs.is_coroutine_resume != rhs.is_coroutine_resume) { return false; }
    if (lhs.is_coroutine_completion != rhs.is_coroutine_completion) { return false; }
    std.String lhs_name = function_symbol_name(ctx, lhs);
    std.String rhs_name = function_symbol_name(ctx, rhs);
    return string.equal(lhs_name.bytes(), rhs_name.bytes());
}

Bool runtime_entry_extern_duplicate(context.CompilerContext& ctx, jil.Function& lhs, jil.Function& rhs) {
    std.String lhs_name = function_symbol_name(ctx, lhs);
    if (!string.equal(lhs_name.bytes(), language_entry_symbol())) { return false; }
    std.String rhs_name = function_symbol_name(ctx, rhs);
    if (!string.equal(rhs_name.bytes(), language_entry_symbol())) { return false; }
    return (lhs.is_runtime_entry && rhs.is_external) || (lhs.is_external && rhs.is_runtime_entry);
}

@life()
UInt8[]& language_entry_symbol() {
    return "__jiang_main";
}

// 同一个 ABI symbol 可以在多个 module 里重复声明 extern 函数，但这些声明
// 必须描述同一个函数签名。真正的 Jiang 函数仍然必须有唯一 backend symbol。
Bool external_function_signature_equal(context.CompilerContext& ctx, jil.Function& lhs, jil.Function& rhs) {
    if (!ctx.store.types.same_type(function_return_type(lhs), function_return_type(rhs))) {
        return false;
    }
    if (function_param_count(lhs) != function_param_count(rhs)) {
        return false;
    }
    Int param_index! = 0;
    while (param_index < function_param_count(lhs)) {
        if (!ctx.store.types.same_type(function_param_type(lhs, param_index), function_param_type(rhs, param_index))) {
            return false;
        }
        param_index = param_index + 1;
    }
    return true;
}

qid.TypeId function_return_type(jil.Function& function) {
    return function.body.locals[function.body.return_local.to_index()].type_id;
}

Int function_param_count(jil.Function& function) {
    Int count! = 0;
    Int index! = 0;
    while (index < function.body.locals.length) {
        if (function.body.locals[index].kind == .param) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

qid.TypeId function_param_type(jil.Function& function, Int param_index) {
    Int current_param! = 0;
    Int local_index! = 0;
    while (local_index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[local_index];
        if (local.kind == .param) {
            if (current_param == param_index) {
                return local.type_id;
            }
            current_param = current_param + 1;
        }
        local_index = local_index + 1;
    }
    return function_return_type(function);
}
