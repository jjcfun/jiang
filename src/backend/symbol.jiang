// Backend 符号身份。
//
// JIL 已经把泛型函数展开成 concrete function。backend 不应该只用 DefId
// 生成符号，否则同一个泛型函数的不同 type args 会冲突。这里先定义
// backend-independent key，后续真实 codegen/mangling 都从这个 key 派生。

import jil = "../jil.jiang";
import codegen_unit = "./codegen_unit/model.jiang";
import object_key_builder = "../artifact/object_key_builder.jiang";
import object_hash = "../artifact/object_hash.jiang";
import core_traits = "../core/traits.jiang";
import context = "../context.jiang";
import def = "../resolve/def.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import std;

@region(a)
public struct BackendSymbolKey: Copyable, Hashable, Equatable {
    public Int package_index;
    public Int module_index;
    public qid.DefId def_id;
    @life(a)
    public types.GenericArg[]& args;
    public Bool runtime_entry;
    public Bool coroutine_resume;
    public jil.CoroutineResumeMode coroutine_resume_mode;
    public Bool coroutine_completion;
    // 0 表示源码函数；其余值是当前 session 内生成函数的符号身份加一。
    public Int generated_symbol_index;

    public init(self,
        Int package_index,
        Int module_index,
        qid.DefId def_id,
        types.GenericArg[]& args,
        Bool runtime_entry,
        Bool coroutine_resume,
        Bool coroutine_completion,
        jil.CoroutineResumeMode coroutine_resume_mode,
        Int generated_symbol_index = 0
    ) {
        self.package_index = package_index;
        self.module_index = module_index;
        self.def_id = def_id;
        self.args = args;
        self.runtime_entry = runtime_entry;
        self.coroutine_resume = coroutine_resume;
        self.coroutine_resume_mode = coroutine_resume_mode;
        self.coroutine_completion = coroutine_completion;
        self.generated_symbol_index = generated_symbol_index;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.package_index));
        hasher.write(Int(self.module_index));
        hasher.write(Int(self.def_id.to_index()));
        Bool runtime_entry = self.runtime_entry;
        Bool coroutine_resume = self.coroutine_resume;
        jil.CoroutineResumeMode coroutine_resume_mode = self.coroutine_resume_mode;
        Bool coroutine_completion = self.coroutine_completion;
        hasher.write(runtime_entry);
        hasher.write(coroutine_resume);
        hasher.write(Int(coroutine_resume_mode));
        hasher.write(coroutine_completion);
        hasher.write(self.generated_symbol_index);
        hasher.write(Int(self.args.length));
        Int index! = 0;
        while (index < self.args.length) {
            jil.write_generic_arg_hash(hasher, self.args[index]);
            index = index + 1;
        }
    }

    public Bool equal(BackendSymbolKey& lhs, BackendSymbolKey& rhs) {
        if (lhs.package_index != rhs.package_index) {
            return false;
        }
        if (lhs.module_index != rhs.module_index) {
            return false;
        }
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.runtime_entry != rhs.runtime_entry) {
            return false;
        }
        if (lhs.coroutine_resume != rhs.coroutine_resume) {
            return false;
        }
        if (lhs.coroutine_resume_mode != rhs.coroutine_resume_mode) { return false; }
        if (lhs.coroutine_completion != rhs.coroutine_completion) { return false; }
        if (lhs.generated_symbol_index != rhs.generated_symbol_index) { return false; }
        if (lhs.args.length != rhs.args.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.args.length) {
            if (!jil.generic_arg_equal(lhs.args[index], rhs.args[index])) { return false; }
            index = index + 1;
        }
        return true;
    }
}

@life(return: value)
public BackendSymbolKey symbol_key_for_function_ref(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.FunctionRef value,
    Bool runtime_entry
) {
    Int package_index! = 0;
    Int module_index! = 0;
    qid.DefId provenance_def! = jil.function_target_provenance_def(value.target);
    Int generated_symbol_index! = 0;
    if (jil.function_target_generated(value.target) is .some(generated)) {
        jil.Function function = store.program.function(generated.id);
        if (jil.function_generated_origin(function.origin) is .some(origin)) {
            generated_symbol_index = origin.name.to_index() + 1;
        } else {
            assert(false, "generated FunctionRef requires generated Function");
        }
    }
    if (ctx.store.defs.get(provenance_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    Bool coroutine_resume! = false;
    Bool coroutine_completion! = false;
    jil.CoroutineResumeMode resume_mode! = .standard;
    if (value.variant is .coroutine_resume(mode)) {
        coroutine_resume = true;
        resume_mode = mode;
    } else if (value.variant is .coroutine_completion
        || value.variant is .coroutine_serial_completion) {
        coroutine_completion = true;
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        provenance_def,
        value.args,
        runtime_entry,
        coroutine_resume,
        coroutine_completion,
        resume_mode,
        generated_symbol_index
    );
}

@life(return: args)
public BackendSymbolKey source_function_symbol_key(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    types.GenericArg[]& args
) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(def_id).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        def_id,
        args,
        false,
        false,
        false,
        .standard
    );
}

@life(return: function.a)
public BackendSymbolKey function_symbol_key(context.CompilerContext& ctx, jil.Function& function) {
    Int package_index! = 0;
    Int module_index! = 0;
    qid.DefId provenance_def! = jil.function_provenance_def(function.origin);
    Int generated_symbol_index! = 0;
    if (jil.function_generated_origin(function.origin) is .some(generated)) {
        generated_symbol_index = generated.name.to_index() + 1;
    }
    if (ctx.store.defs.get(provenance_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        provenance_def,
        function.args,
        function.is_runtime_entry,
        function.is_coroutine_resume,
        function.is_coroutine_completion,
        function.coroutine_resume_mode,
        generated_symbol_index
    );
}

// backend 对外发出的符号名必须从 BackendSymbolKey 派生，而不是直接使用源码名字。
// 源码名字可能在不同 namespace 重复；泛型函数的不同 concrete type args 也需要
// 生成不同 symbol。这里先用纯数字 key 生成 backend-independent 名字，LLVM backend
// 后续只消费这个结果。
public std.String function_symbol_name(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Function& function
) {
    if (jil.function_generated_origin(function.origin) is .some(generated)) {
        if (function.is_runtime_entry) {
            return std.String.from_valid_utf8(store.program.generated_name(generated.name));
        }
        return stable_generated_function_symbol_name(
            ctx, store, generated, function.args
        );
    }
    if (function.is_runtime_entry) {
        return std.String.from_valid_utf8(language_entry_symbol());
    }
    qid.DefId function_def = jil.function_provenance_def(function.origin);
    if (!function.is_coroutine_resume && !function.is_coroutine_completion) {
        if (link_symbol_for_def(ctx, function_def) is .some(link_symbol)) {
            return std.String.from_valid_utf8(ctx.store.symbols.text(link_symbol));
        }
        if (function_uses_source_abi_symbol(ctx, function)) {
            qid.SymbolId symbol_id = ctx.store.defs.get(function_def).name.symbol;
            return std.String.from_valid_utf8(ctx.store.symbols.text(symbol_id));
        }
    }
    return stable_function_symbol_name(ctx, function);
}

std.String stable_generated_function_symbol_name(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.GeneratedFunctionOrigin generated,
    types.GenericArg[]& args
) {
    guard ctx.store.incremental.stable_id_for_def(generated.provenance_def)
        is .some(stable_id) else {
        std.String fallback! =
            std.String.from_valid_utf8(store.program.generated_name(generated.name));
        fallback = append_generic_arg_fingerprints(ctx, fallback, args);
        return append_generated_identity_type(ctx, fallback, generated.identity_type);
    }
    std.StringBuilder identity! = std.StringBuilder();
    identity.append(Int(generated.kind));
    identity.append("_");
    identity.append(Int(stable_id.low));
    identity.append("_");
    identity.append(Int(stable_id.high));
    std.String key! = append_generic_arg_fingerprints(
        ctx, identity.into_string(), args
    );
    key = append_generated_identity_type(ctx, key, generated.identity_type);
    return compact_generated_symbol(
        "_Jgf", Int(generated.kind), object_hash.hash_bytes(key.bytes())
    );
}

std.String append_generated_identity_type(
    context.CompilerContext& ctx,
    std.String name,
    qid.TypeId? identity_type
) {
    guard identity_type is .some(type_id) else { return name; }
    qkey.Fingerprint128 fingerprint =
        object_key_builder.stable_type_fingerprint_for_type(ctx, type_id);
    return append_fingerprint_part(name, "_T", fingerprint);
}

public Bool function_uses_source_abi_symbol(context.CompilerContext& ctx, jil.Function& function) {
    guard jil.function_source_def(function.origin) is .some(function_def) else { return false; }
    if (function.is_coroutine_resume || function.is_coroutine_completion) {
        return false;
    }
    guard ctx.store.model.def(function_def) is .some(model_def) else {
        return function.is_external;
    }
    return model_def.decl.extern_kind != .none;
}

std.String stable_function_symbol_name(context.CompilerContext& ctx, jil.Function& function) {
    qid.DefId function_def = jil.function_provenance_def(function.origin);
    guard ctx.store.incremental.stable_id_for_def(function_def) is .some(stable_id) else {
        return symbol_name(function_symbol_key(ctx, function));
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("_Js");
    builder.append(Int(stable_id.low));
    builder.append("_");
    builder.append(Int(stable_id.high));
    std.String name! = builder.into_string();
    name = append_generic_arg_fingerprints(ctx, name, function.args);
    if (function.is_coroutine_resume) {
        name = append_text(name, "_Resume");
        if (function.coroutine_resume_mode == .confined) {
            name = append_text(name, "_Confined");
        } else if (function.coroutine_resume_mode == .run_to_completion) {
            name = append_text(name, "_RTC");
        }
    }
    if (function.is_coroutine_completion) { name = append_text(name, "_Complete"); }
    return name;
}

public std.String global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    return global_symbol_name_for_def(ctx, global_def, false);
}

public std.String global_symbol_name_for_ref(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.GlobalRef global_ref
) {
    jil.Global& global = store.program.globals.ref_at(global_ref.id.to_index());
    return global_symbol_name_for_global(ctx, store, global);
}

public std.String global_symbol_name_for_global(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Global& global
) {
    if (global.origin is .source(def_id)) {
        return global_symbol_name_for_def(ctx, def_id, global.is_external);
    }
    guard global.origin is .generated(generated) else {
        std.String empty = "";
        return empty;
    }
    return stable_generated_global_symbol_name(ctx, store, generated);
}

std.String stable_generated_global_symbol_name(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.GeneratedGlobalOrigin generated
) {
    guard ctx.store.incremental.stable_id_for_def(generated.provenance_def)
        is .some(stable_id) else {
        std.String fallback =
            std.String.from_valid_utf8(store.program.generated_name(generated.name));
        return append_generated_identity_type(ctx, fallback, generated.identity_type);
    }
    std.StringBuilder identity! = std.StringBuilder();
    identity.append(Int(generated.kind));
    identity.append("_");
    identity.append(Int(stable_id.low));
    identity.append("_");
    identity.append(Int(stable_id.high));
    std.String key = append_generated_identity_type(
        ctx, identity.into_string(), generated.identity_type
    );
    return compact_generated_symbol(
        "_Jgg", Int(generated.kind), object_hash.hash_bytes(key.bytes())
    );
}

std.String compact_generated_symbol(
    UInt8[]& prefix,
    Int kind,
    qkey.Fingerprint128 fingerprint
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix);
    builder.append(kind);
    std.String name = builder.into_string();
    return append_fingerprint_part(name, "_", fingerprint);
}

public qid.ModuleId? global_module_id(context.CompilerContext& ctx, jil.Global& global) {
    if (global.origin is .source(def_id)) {
        return ctx.store.defs.get(def_id).module_id;
    }
    guard global.origin is .generated(generated) else { return null; }
    return generated.module_id;
}

public std.String global_symbol_name_for_def(context.CompilerContext& ctx, qid.DefId global_def, Bool is_external) {
    if (link_symbol_for_def(ctx, global_def) is .some(link_symbol)) {
        return std.String.from_valid_utf8(ctx.store.symbols.text(link_symbol));
    }
    if (is_external) {
        return source_global_symbol_name(ctx, global_def);
    }
    std.String owner_prefix = global_def_owner_prefix(ctx, global_def);
    return global_backend_symbol_name(owner_prefix.bytes(), global_def);
}

qid.SymbolId? link_symbol_for_def(context.CompilerContext& ctx, qid.DefId def_id) {
    guard ctx.store.model.def(def_id) is .some(model_def) else { return null; }
    return model_def.decl.link_symbol;
}

public std.String global_backend_symbol_name(UInt8[]& owner_prefix, qid.DefId global_def) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(owner_prefix);
    builder.append("_g");
    builder.append(global_def.to_index());
    return builder.into_string();
}

std.String global_def_owner_prefix(context.CompilerContext& ctx, qid.DefId global_def) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(global_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    return builder.into_string();
}

public std.String source_global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    qid.SymbolId symbol_id = ctx.store.defs.get(global_def).name.symbol;
    return std.String.from_valid_utf8(ctx.store.symbols.text(symbol_id));
}

public std.String symbol_name(BackendSymbolKey key) {
    std.String name! = symbol_base_name(key.package_index, key.module_index, key.def_id.to_index());
    Int index! = 0;
    while (index < key.args.length) {
        if (key.args[index] is .type_arg(value)) {
            name = append_int_part(name, "_T", value.value.to_index());
        } else if (key.args[index] is .const_arg(value)) {
            std.String part = comptime_value_symbol_part(value.value);
            name = append_text(name, "_C");
            name = append_text(name, part.bytes());
        }
        index = index + 1;
    }
    if (key.coroutine_resume) {
        name = append_text(name, "_Resume");
        if (key.coroutine_resume_mode == .confined) {
            name = append_text(name, "_Confined");
        } else if (key.coroutine_resume_mode == .run_to_completion) {
            name = append_text(name, "_RTC");
        }
    }
    if (key.coroutine_completion) {
        name = append_text(name, "_Complete");
    }
    return name;
}

std.String symbol_base_name(Int package_index, Int module_index, Int def_index) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    builder.append("_f");
    builder.append(def_index);
    return builder.into_string();
}

std.String append_int_part(std.String prefix, UInt8[]& marker, Int value) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix.bytes());
    builder.append_valid_utf8(marker);
    builder.append(value);
    return builder.into_string();
}

std.String append_fingerprint_part(
    std.String prefix,
    UInt8[]& marker,
    qkey.Fingerprint128 fingerprint
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix.bytes());
    builder.append_valid_utf8(marker);
    builder.append(Int(fingerprint.low));
    builder.append("_");
    builder.append(Int(fingerprint.high));
    return builder.into_string();
}

std.String append_generic_arg_fingerprints(
    context.CompilerContext& ctx,
    std.String name,
    types.GenericArg[]& args
) {
    std.String result! = name;
    Int index! = 0;
    while (index < args.length) {
        if (args[index] is .type_arg(value)) {
            qkey.Fingerprint128 fingerprint =
                object_key_builder.stable_type_fingerprint_for_type(
                ctx, value.value
            );
            result = append_fingerprint_part(result, "_T", fingerprint);
        } else if (args[index] is .const_arg(value)) {
            qkey.Fingerprint128 fingerprint =
                object_key_builder.stable_comptime_value_fingerprint(ctx, value.value);
            result = append_fingerprint_part(result, "_C", fingerprint);
        }
        index = index + 1;
    }
    return result;
}

std.String append_text(std.String prefix, UInt8[]& text) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix.bytes());
    builder.append_valid_utf8(text);
    return builder.into_string();
}


std.String comptime_value_symbol_part(comptime_value.ComptimeValue value) {
    std.StringBuilder builder! = std.StringBuilder();
    if (value.data is .bool_value(bool_value)) {
        if (bool_value) {
            std.String value = "b1";
            return value;
        }
        builder.append("b0");
        return builder.into_string();
    }
    if (value.data is .int_value(int_value)) {
        builder.append("i");
        builder.append(int_value);
        return builder.into_string();
    }
    if (value.data is .uint_value(uint_value)) {
        builder.append("u");
        builder.append(Int(uint_value));
        return builder.into_string();
    }
    if (value.data is .char_value(char_value)) {
        builder.append("c");
        builder.append(Int(char_value));
        return builder.into_string();
    }
    if (value.data is .symbol_value(symbol_value)) {
        builder.append("s");
        builder.append(symbol_value.to_index());
        return builder.into_string();
    }
    if (value.data is .enum_case_value(enum_case)) {
        builder.append("e");
        builder.append(enum_case.to_index());
        return builder.into_string();
    }
    if (value.data is .const_param_value(const_param)) {
        builder.append("p");
        builder.append(const_param.to_index());
        return builder.into_string();
    }
    std.String value = "x";
    return value;
}

public Bool validate_unique_function_symbols(context.CompilerContext& ctx, jil.Store& store) {
    map.WyHashMap<BackendSymbolKey, Bool> seen! =
        map.WyHashMap<BackendSymbolKey, Bool>();
    list.ArrayList<jil.MonoItem> functions =
        backend_functions(store);
    Int index! = 0;
    while (index < functions.len()) {
        jil.Function function = codegen_unit.codegen_function(
            ctx, store, functions.get(index)
        );
        BackendSymbolKey key = function_symbol_key(ctx, function$.ref());
        if (seen.has(key)) {
            return false;
        }
        seen.set(key, true);
        index = index + 1;
    }
    return true;
}

public Bool validate_unique_function_symbol_names(context.CompilerContext& ctx, jil.Store& store) {
    return duplicate_function_symbol_name(ctx, store) == null;
}

public std.String? duplicate_function_symbol_name(context.CompilerContext& ctx, jil.Store& store) {
    table.MultiTable<UInt64, jil.MonoItem> indexes! =
        table.MultiTable<UInt64, jil.MonoItem>();
    list.ArrayList<jil.MonoItem> functions =
        backend_functions(store);
    Int index! = 0;
    while (index < functions.len()) {
        jil.MonoItem item = functions.get(index);
        jil.Function function = codegen_unit.codegen_function(ctx, store, item);
        std.String symbol_name = function_symbol_name(
            ctx, store, function$.ref()
        );
        UInt64 name_hash = hash.hash_bytes(symbol_name.bytes());
        jil.MonoItem? previous_item = duplicate_symbol_function(
            ctx,
            store,
            indexes$.ref(),
            name_hash,
            symbol_name.bytes()
        );
        if (previous_item is .some(existing)) {
            jil.Function previous = codegen_unit.codegen_function(
                ctx, store, existing
            );
            if (!compatible_duplicate_function_name(
                ctx, store, previous$.ref(), function$.ref()
            )) {
                return duplicate_function_symbol_description(
                    ctx, symbol_name.bytes(), previous$.ref(), function$.ref()
                );
            }
        }
        indexes.add(name_hash, item);
        index = index + 1;
    }
    return null;
}

jil.MonoItem? duplicate_symbol_function(
    context.CompilerContext& ctx,
    jil.Store& store,
    table.MultiTable<UInt64, jil.MonoItem>& indexes,
    UInt64 name_hash,
    UInt8[]& symbol_name
) {
    table.MultiTableCursor cursor! = indexes.first(name_hash);
    while (cursor.valid()) {
        jil.MonoItem previous_item = indexes.get(cursor);
        jil.Function previous = codegen_unit.codegen_function(
            ctx, store, previous_item
        );
        std.String previous_name = function_symbol_name(
            ctx, store, previous$.ref()
        );
        if (string.equal(previous_name.bytes(), symbol_name)) {
            return previous_item;
        }
        cursor = indexes.next(cursor);
    }
    return null;
}

list.ArrayList<jil.MonoItem> backend_functions(jil.Store& store) {
    list.ArrayList<jil.MonoItem> result! =
        list.ArrayList<jil.MonoItem>();
    Int index! = 0;
    while (index < store.program.source_instance_count()) {
        Int identity = store.program.source_instance_identity_at(index);
        result.add(jil.source_instance_mono_item(identity));
        jil.InstanceKey instance = store.program.function_instance_at(identity);
        if (store.program.has_source_resume_template(instance.def_id, .standard)) {
            result.add(jil.source_resume_instance_mono_item(identity));
        }
        if (store.program.has_source_resume_template(instance.def_id, .confined)) {
            result.add(jil.source_resume_mono_item(identity, .confined));
        }
        if (store.program.has_source_resume_template(
                instance.def_id, .run_to_completion
            )
        ) {
            result.add(jil.source_resume_mono_item(identity, .run_to_completion));
        }
        index = index + 1;
    }
    index = 0;
    while (index < store.program.functions.len()) {
        jil.Function& function = store.program.functions.ref_at(index);
        if (function.origin is .generated(_)) {
            result.add(jil.generated_function_mono_item(function.id));
        }
        index = index + 1;
    }
    return result;
}

std.String duplicate_function_symbol_description(
    context.CompilerContext& ctx,
    UInt8[]& symbol_name,
    jil.Function& lhs,
    jil.Function& rhs
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(symbol_name);
    append_function_instance_description(ctx, builder$.mut_ref(), lhs);
    append_function_instance_description(ctx, builder$.mut_ref(), rhs);
    return builder.into_string();
}

Void append_function_instance_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    jil.Function& function
) {
    builder.append(" [");
    qid.DefId provenance_def = jil.function_provenance_def(function.origin);
    builder.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(provenance_def).name.symbol));
    builder.append(" args:");
    Int index! = 0;
    while (index < function.args.length) {
        if (function.args[index] is .type_arg(value)) {
            builder.append(" type=");
            builder.append(value.value.to_index());
            append_type_instance_description(ctx, builder, value.value);
        } else {
            builder.append(" const");
        }
        index = index + 1;
    }
    builder.append("]");
}

Void append_type_instance_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.TypeId type_id
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.is_mutable) { builder.append(":mutable"); }
    if (ctx.store.types.type_owner_def(type_id) is .some(owner_def)) {
        builder.append(":owner=");
        builder.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(owner_def).name.symbol));
    }
    append_type_data_description(ctx, builder, info.data);
}

Void append_type_data_description(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    types.TypeData data
) {
    if (data is .invalid) { builder.append(":invalid"); return; }
    if (data is .never) { builder.append(":never"); return; }
    if (data is .unit) { builder.append(":unit"); return; }
    if (data is .bool_type) { builder.append(":bool"); return; }
    if (data is .char_type) { builder.append(":char"); return; }
    if (data is .int_type(value)) { builder.append(":int="); builder.append(value.bits); return; }
    if (data is .float_type(value)) { builder.append(":float="); builder.append(value.bits); return; }
    if (data is .named(value)) {
        builder.append(":named=");
        builder.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(value.def_id).name.symbol));
        return;
    }
    if (data is .trait_companion) { builder.append(":trait-companion"); return; }
    if (data is .optional) { builder.append(":optional"); return; }
    if (data is .error_union) { builder.append(":error-union"); return; }
    if (data is .handle_type(value)) {
        builder.append(":handle=");
        builder.append(Int(value.kind));
        return;
    }
    if (data is .slice_value_type) { builder.append(":slice-value"); return; }
    if (data is .array_type) { builder.append(":array"); return; }
    if (data is .tuple_type) { builder.append(":tuple"); return; }
    if (data is .closure_environment_type) { builder.append(":closure-environment"); return; }
    if (data is .task_state_type) { builder.append(":task-state"); return; }
    if (data is .function_type) { builder.append(":function"); return; }
    builder.append(":task");
}

Bool compatible_duplicate_function_name(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Function& lhs,
    jil.Function& rhs
) {
    if (lhs.is_external && rhs.is_external) {
        return external_function_signature_equal(ctx, lhs, rhs);
    }
    if (same_stable_function_instance(ctx, store, lhs, rhs)) {
        return true;
    }
    return runtime_entry_extern_duplicate(ctx, store, lhs, rhs);
}

public Bool same_stable_function_instance(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Function& lhs,
    jil.Function& rhs
) {
    if (jil.function_provenance_def(lhs.origin) != jil.function_provenance_def(rhs.origin)) {
        return false;
    }
    if (lhs.is_runtime_entry != rhs.is_runtime_entry) { return false; }
    if (lhs.is_coroutine_resume != rhs.is_coroutine_resume) { return false; }
    if (lhs.coroutine_resume_mode != rhs.coroutine_resume_mode) { return false; }
    if (lhs.is_coroutine_completion != rhs.is_coroutine_completion) { return false; }
    std.String lhs_name = function_symbol_name(ctx, store, lhs);
    std.String rhs_name = function_symbol_name(ctx, store, rhs);
    return string.equal(lhs_name.bytes(), rhs_name.bytes());
}

Bool runtime_entry_extern_duplicate(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.Function& lhs,
    jil.Function& rhs
) {
    std.String lhs_name = function_symbol_name(ctx, store, lhs);
    if (!string.equal(lhs_name.bytes(), language_entry_symbol())) { return false; }
    std.String rhs_name = function_symbol_name(ctx, store, rhs);
    if (!string.equal(rhs_name.bytes(), language_entry_symbol())) { return false; }
    return (lhs.is_runtime_entry && rhs.is_external) || (lhs.is_external && rhs.is_runtime_entry);
}

@life()
UInt8[]& language_entry_symbol() {
    return "__jiang_main";
}

// 同一个 ABI symbol 可以在多个 module 里重复声明 extern 函数，但这些声明
// 必须描述同一个函数签名。真正的 Jiang 函数仍然必须有唯一 backend symbol。
Bool external_function_signature_equal(context.CompilerContext& ctx, jil.Function& lhs, jil.Function& rhs) {
    if (!ctx.store.types.same_type(function_return_type(lhs), function_return_type(rhs))) {
        return false;
    }
    if (function_param_count(lhs) != function_param_count(rhs)) {
        return false;
    }
    Int param_index! = 0;
    while (param_index < function_param_count(lhs)) {
        if (!ctx.store.types.same_type(function_param_type(lhs, param_index), function_param_type(rhs, param_index))) {
            return false;
        }
        param_index = param_index + 1;
    }
    return true;
}

qid.TypeId function_return_type(jil.Function& function) {
    return function.body.locals[function.body.return_local.to_index()].type_id;
}

Int function_param_count(jil.Function& function) {
    Int count! = 0;
    Int index! = 0;
    while (index < function.body.locals.length) {
        if (function.body.locals[index].kind == .param) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

qid.TypeId function_param_type(jil.Function& function, Int param_index) {
    Int current_param! = 0;
    Int local_index! = 0;
    while (local_index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[local_index];
        if (local.kind == .param) {
            if (current_param == param_index) {
                return local.type_id;
            }
            current_param = current_param + 1;
        }
        local_index = local_index + 1;
    }
    return function_return_type(function);
}
