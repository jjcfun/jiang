// Backend 符号身份。
//
// MIR 已经把泛型函数展开成 concrete function。backend 不应该只用 DefId
// 生成符号，否则同一个泛型函数的不同 type args 会冲突。这里先定义
// backend-independent key，后续真实 codegen/mangling 都从这个 key 派生。

import mir = "../mir/mir.jiang";
import context = "../context.jiang";
import lang_abi = "../lang/abi.jiang";
import resolve_store = "../resolve/store.jiang";
import qid = "../store/id.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import startup = "../system/startup.jiang";
import hash = "../support/hash.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";

public struct BackendSymbolKey: Hashable, Equatable {
    public Int package_index;
    public Int module_index;
    public qid.DefId def_id;
    public qid.TypeId[]& type_args;
    public comptime_value.ComptimeValue[]& const_args;
    public Bool runtime_entry;

    public init(
        Int package_index,
        Int module_index,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        Bool runtime_entry
    ) {
        self.package_index = package_index;
        self.module_index = module_index;
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = const_args;
        self.runtime_entry = runtime_entry;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.package_index);
        hasher.write_int(self.module_index);
        hasher.write_int(self.def_id.to_index());
        hasher.write_bool(self.runtime_entry);
        hasher.write_int(self.type_args.length);
        Int! index = 0;
        while (index < self.type_args.length) {
            hasher.write_int(self.type_args[index].to_index());
            index = index + 1;
        }
        hasher.write_int(self.const_args.length);
        index = 0;
        while (index < self.const_args.length) {
            write_comptime_value_hash(hasher$.ref(), self.const_args[index]);
            index = index + 1;
        }
        return hasher.finish();
    }

    public static Bool equal(BackendSymbolKey& lhs, BackendSymbolKey& rhs) {
        if (lhs.package_index != rhs.package_index) {
            return false;
        }
        if (lhs.module_index != rhs.module_index) {
            return false;
        }
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.runtime_entry != rhs.runtime_entry) {
            return false;
        }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return comptime_value_slices_equal(lhs.const_args, rhs.const_args);
    }
}

struct BackendSymbolName: Hashable, Equatable {
    UInt8[]& text;

    init(UInt8[]& text) {
        self.text = text;
    }

    UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_bytes(self.text);
        return hasher.finish();
    }

    static Bool equal(BackendSymbolName& lhs, BackendSymbolName& rhs) {
        return string.equal(lhs.text, rhs.text);
    }
}

public BackendSymbolKey symbol_key_for_def(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    qid.TypeId[]& type_args,
    comptime_value.ComptimeValue[]& const_args,
    Bool runtime_entry
) {
    Int! package_index = 0;
    Int! module_index = 0;
    if (ctx.store.defs.get(def_id).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(package_index, module_index, def_id, type_args, const_args, runtime_entry);
}

public BackendSymbolKey function_symbol_key(context.CompilerContext& ctx, mir.MirFunction& function) {
    return symbol_key_for_def(
        ctx,
        function.def_id,
        function.type_args,
        function.const_args,
        function.is_runtime_entry
    );
}

// backend 对外发出的符号名必须从 BackendSymbolKey 派生，而不是直接使用源码名字。
// 源码名字可能在不同 namespace 重复；泛型函数的不同 concrete type args 也需要
// 生成不同 symbol。这里先用纯数字 key 生成 backend-independent 名字，LLVM backend
// 后续只消费这个结果。
public UInt8[]& function_symbol_name(context.CompilerContext& ctx, mir.MirFunction& function) {
    if (function.is_runtime_entry) {
        return startup.hosted_entry_symbol();
    }
    if (function.is_language_entry) {
        return startup.language_entry_symbol();
    }
    if (is_lang_provider_entry(ctx, function)) {
        return lang_abi.entry_symbol();
    }
    if (function.is_external) {
        qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
        return ctx.store.symbols.text(symbol_id);
    }
    return symbol_name(function_symbol_key(ctx, function));
}

Bool is_lang_provider_entry(context.CompilerContext& ctx, mir.MirFunction& function) {
    if (function.type_args.length != 0 || function.const_args.length != 0) {
        return false;
    }
    qid.DefId def_id = function.def_id;
    if (ctx.store.defs.get(def_id).kind != .function_def) {
        return false;
    }
    qid.SymbolId symbol_id = ctx.store.defs.get(def_id).name.symbol;
    if (!string.equal(ctx.store.symbols.text(symbol_id), lang_abi.entry_symbol())) {
        return false;
    }
    guard ctx.store.defs.get(def_id).module_id is .some(module_id) else {
        return false;
    }
    qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
    resolve_store.PackageRecord& package_record = ctx.store.resolve.package_ref(package_id);
    return package_record.kind == .lang;
}

public UInt8[]& global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    return global_symbol_name_for_def(ctx, global_def, false);
}

public UInt8[]& global_symbol_name_for_def(context.CompilerContext& ctx, qid.DefId global_def, Bool is_external) {
    if (is_external) {
        return source_global_symbol_name(ctx, global_def);
    }
    return global_backend_symbol_name(global_def_owner_prefix(ctx, global_def), global_def);
}

public UInt8[]& global_backend_symbol_name(UInt8[]& owner_prefix, qid.DefId global_def) {
    UInt8[]&! name = owner_prefix;
    name = string.append(name, "_g");
    return string.append(name, string.int_text(global_def.to_index()));
}

UInt8[]& global_def_owner_prefix(context.CompilerContext& ctx, qid.DefId global_def) {
    Int! package_index = 0;
    Int! module_index = 0;
    if (ctx.store.defs.get(global_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    UInt8[]&! prefix = string.append("_Jp", string.int_text(package_index));
    prefix = string.append(prefix, "_m");
    return string.append(prefix, string.int_text(module_index));
}

public UInt8[]& source_global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    qid.SymbolId symbol_id = ctx.store.defs.get(global_def).name.symbol;
    return ctx.store.symbols.text(symbol_id);
}

public UInt8[]& symbol_name(BackendSymbolKey key) {
    UInt8[]&! name = symbol_owner_prefix(key);
    name = string.append(name, "_f");
    name = string.append(name, string.int_text(key.def_id.to_index()));
    Int! index = 0;
    while (index < key.type_args.length) {
        name = string.append(name, "_T");
        name = string.append(name, string.int_text(key.type_args[index].to_index()));
        index = index + 1;
    }
    index = 0;
    while (index < key.const_args.length) {
        name = string.append(name, "_C");
        name = string.append(name, comptime_value_symbol_part(key.const_args[index]));
        index = index + 1;
    }
    return name;
}

() write_comptime_value_hash(hash.WyHasher& hasher, comptime_value.ComptimeValue value) {
    hasher.write_int(value.type_id.to_index());
    if (value.data is .invalid) { hasher.write_int(1); return; }
    if (value.data is .unit_value) { hasher.write_int(2); return; }
    if (value.data is .bool_value(bool_value)) {
        hasher.write_int(3);
        hasher.write_bool(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        hasher.write_int(4);
        hasher.write_int(int_value);
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        hasher.write_int(5);
        hasher.write_uint64(uint_value);
        return;
    }
    if (value.data is .char_value(char_value)) {
        hasher.write_int(6);
        hasher.write_uint64(char_value);
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        hasher.write_int(7);
        hasher.write_int(symbol_value.to_index());
        return;
    }
    if (value.data is .const_param_value(const_param)) {
        hasher.write_int(8);
        hasher.write_int(const_param.to_index());
        return;
    }
    if (value.data is .enum_case_value(enum_case)) {
        hasher.write_int(9);
        hasher.write_int(enum_case.to_index());
        return;
    }
    hasher.write_int(99);
}

Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    return false;
}

UInt8[]& comptime_value_symbol_part(comptime_value.ComptimeValue value) {
    if (value.data is .bool_value(bool_value)) {
        if (bool_value) { return "b1"; }
        return "b0";
    }
    if (value.data is .int_value(int_value)) {
        return string.append("i", string.int_text(int_value));
    }
    if (value.data is .uint_value(uint_value)) {
        return string.append("u", string.int_text(Int(uint_value)));
    }
    if (value.data is .char_value(char_value)) {
        return string.append("c", string.int_text(Int(char_value)));
    }
    if (value.data is .symbol_value(symbol_value)) {
        return string.append("s", string.int_text(symbol_value.to_index()));
    }
    if (value.data is .enum_case_value(enum_case)) {
        return string.append("e", string.int_text(enum_case.to_index()));
    }
    if (value.data is .const_param_value(const_param)) {
        return string.append("p", string.int_text(const_param.to_index()));
    }
    return "x";
}

UInt8[]& symbol_owner_prefix(BackendSymbolKey key) {
    UInt8[]&! prefix = string.append("_Jp", string.int_text(key.package_index));
    prefix = string.append(prefix, "_m");
    return string.append(prefix, string.int_text(key.module_index));
}

public Bool validate_unique_function_symbols(context.CompilerContext& ctx, mir.MirStore& store) {
    table.HashTable<BackendSymbolKey, Bool>! seen = table.HashTable<BackendSymbolKey, Bool>();
    Int! index = 0;
    while (index < store.functions.len()) {
        mir.MirFunction& function = store.functions.ref_at(index);
        BackendSymbolKey key = function_symbol_key(ctx, function);
        if (seen.has(key)) {
            return false;
        }
        seen.set(key, true);
        index = index + 1;
    }
    return true;
}

public Bool validate_unique_function_symbol_names(context.CompilerContext& ctx, mir.MirStore& store) {
    return string.equal(duplicate_function_symbol_name(ctx, store), "");
}

public UInt8[]& duplicate_function_symbol_name(context.CompilerContext& ctx, mir.MirStore& store) {
    table.HashTable<BackendSymbolName, Int>! seen = table.HashTable<BackendSymbolName, Int>();
    Int! index = 0;
    while (index < store.functions.len()) {
        mir.MirFunction& function = store.functions.ref_at(index);
        UInt8[]& symbol_name = function_symbol_name(ctx, function);
        BackendSymbolName name = BackendSymbolName(symbol_name);
        if (table.hash_table_get_value<BackendSymbolName, Int>(seen$.ref(), name) is .some(previous_index)) {
            mir.MirFunction& previous = store.functions.ref_at(previous_index);
            if (!compatible_duplicate_function_name(ctx, previous, function)) {
                return symbol_name;
            }
        } else {
            seen.set(name, index);
        }
        index = index + 1;
    }
    return "";
}

Bool compatible_duplicate_function_name(context.CompilerContext& ctx, mir.MirFunction& lhs, mir.MirFunction& rhs) {
    if (!lhs.is_external || !rhs.is_external) {
        return false;
    }
    return external_function_signature_equal(ctx, lhs, rhs);
}

// 同一个 ABI symbol 可以在多个 module 里重复声明 extern 函数，但这些声明
// 必须描述同一个函数签名。真正的 Jiang 函数仍然必须有唯一 backend symbol。
Bool external_function_signature_equal(context.CompilerContext& ctx, mir.MirFunction& lhs, mir.MirFunction& rhs) {
    if (!ctx.store.types.same_type(function_return_type(lhs), function_return_type(rhs))) {
        return false;
    }
    if (function_param_count(lhs) != function_param_count(rhs)) {
        return false;
    }
    Int! param_index = 0;
    while (param_index < function_param_count(lhs)) {
        if (!ctx.store.types.same_type(function_param_type(lhs, param_index), function_param_type(rhs, param_index))) {
            return false;
        }
        param_index = param_index + 1;
    }
    return true;
}

qid.TypeId function_return_type(mir.MirFunction& function) {
    return function.body.locals[function.body.return_local.to_index()].type_id;
}

Int function_param_count(mir.MirFunction& function) {
    Int! count = 0;
    Int! index = 0;
    while (index < function.body.locals.length) {
        if (function.body.locals[index].kind == .param) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

qid.TypeId function_param_type(mir.MirFunction& function, Int param_index) {
    Int! current_param = 0;
    Int! local_index = 0;
    while (local_index < function.body.locals.length) {
        mir.MirLocalDecl local = function.body.locals[local_index];
        if (local.kind == .param) {
            if (current_param == param_index) {
                return local.type_id;
            }
            current_param = current_param + 1;
        }
        local_index = local_index + 1;
    }
    return function_return_type(function);
}
