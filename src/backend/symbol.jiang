// Backend 符号身份。
//
// MIR 已经把泛型函数展开成 concrete function。backend 不应该只用 DefId
// 生成符号，否则同一个泛型函数的不同 type args 会冲突。这里先定义
// backend-independent key，后续真实 codegen/mangling 都从这个 key 派生。

import mir = "../mir/mir.jiang";
import context = "../context.jiang";
import lang_abi = "../lang/abi.jiang";
import def = "../resolve/def.jiang";
import qid = "../store/id.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import std;

@region(a, b, c)
public struct BackendSymbolKey: Copyable, Hashable, Equatable {
    public Int package_index;
    public Int module_index;
    public qid.DefId def_id;
    @life(a)
    public qid.TypeId[]& type_args;

    @life(b, c)
    public comptime_value.ComptimeValue[]& const_args;
    public Bool runtime_entry;
    public Bool coroutine_resume;
    public Bool coroutine_completion;

    public init(self,
        Int package_index,
        Int module_index,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        Bool runtime_entry,
        Bool coroutine_resume,
        Bool coroutine_completion
    ) {
        self.package_index = package_index;
        self.module_index = module_index;
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = const_args;
        self.runtime_entry = runtime_entry;
        self.coroutine_resume = coroutine_resume;
        self.coroutine_completion = coroutine_completion;
    }

    public UInt64 hash(self) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.package_index);
        hasher.write_int(self.module_index);
        hasher.write_int(self.def_id.to_index());
        hasher.write_bool(self.runtime_entry);
        hasher.write_bool(self.coroutine_resume);
        hasher.write_bool(self.coroutine_completion);
        hasher.write_int(self.type_args.length);
        Int index! = 0;
        while (index < self.type_args.length) {
            hasher.write_int(self.type_args[index].to_index());
            index = index + 1;
        }
        hasher.write_int(self.const_args.length);
        index = 0;
        while (index < self.const_args.length) {
            write_comptime_value_hash(hasher$.ref(), self.const_args[index]);
            index = index + 1;
        }
        return hasher.finish();
    }

    public Bool equal(BackendSymbolKey& lhs, BackendSymbolKey& rhs) {
        if (lhs.package_index != rhs.package_index) {
            return false;
        }
        if (lhs.module_index != rhs.module_index) {
            return false;
        }
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.runtime_entry != rhs.runtime_entry) {
            return false;
        }
        if (lhs.coroutine_resume != rhs.coroutine_resume) {
            return false;
        }
        if (lhs.coroutine_completion != rhs.coroutine_completion) { return false; }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return comptime_value_slices_equal(lhs.const_args, rhs.const_args);
    }
}

struct BackendSymbolName: Copyable, Hashable, Equatable {
    UInt8[]& text;

    init(self, UInt8[]& text) {
        self.text = text;
    }

    UInt64 hash(self) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_bytes(self.text);
        return hasher.finish();
    }

    Bool equal(BackendSymbolName& lhs, BackendSymbolName& rhs) {
        return string.equal(lhs.text, rhs.text);
    }
}

@life(return: (value, value, value))
public BackendSymbolKey symbol_key_for_function_ref(
    context.CompilerContext& ctx,
    mir.MirFunctionRef value,
    Bool runtime_entry
) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(value.function_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        value.function_def,
        value.type_args,
        value.const_args,
        runtime_entry,
        value.coroutine_resume,
        value.coroutine_completion
    );
}

@life(return: (function.a, function.b, function.c))
public BackendSymbolKey function_symbol_key(context.CompilerContext& ctx, mir.MirFunction& function) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(function.def_id).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    return BackendSymbolKey(
        package_index,
        module_index,
        function.def_id,
        function.type_args,
        function.const_args,
        function.is_runtime_entry,
        function.is_coroutine_resume,
        function.is_coroutine_completion
    );
}

// backend 对外发出的符号名必须从 BackendSymbolKey 派生，而不是直接使用源码名字。
// 源码名字可能在不同 namespace 重复；泛型函数的不同 concrete type args 也需要
// 生成不同 symbol。这里先用纯数字 key 生成 backend-independent 名字，LLVM backend
// 后续只消费这个结果。
public std.String function_symbol_name(context.CompilerContext& ctx, mir.MirFunction& function) {
    if (function.is_runtime_entry) {
        return std.String(language_entry_symbol());
    }
    if (function.is_coroutine_resume || function.is_coroutine_completion) {
        return symbol_name(function_symbol_key(ctx, function));
    }
    if (is_lang_provider_entry(ctx, function)) {
        qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
        return std.String(ctx.store.symbols.text(symbol_id));
    }
    if (link_symbol_for_def(ctx, function.def_id) is .some(link_symbol)) {
        return std.String(ctx.store.symbols.text(link_symbol));
    }
    if (function.is_external || function_uses_source_abi_symbol(ctx, function)) {
        qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
        return std.String(ctx.store.symbols.text(symbol_id));
    }
    return symbol_name(function_symbol_key(ctx, function));
}

Bool function_uses_source_abi_symbol(context.CompilerContext& ctx, mir.MirFunction& function) {
    guard ctx.store.hirs.def(function.def_id) is .some(hir_def) else {
        return false;
    }
    guard ctx.store.defs.get(function.def_id).owner_def is .some(owner_def) else {
        return false;
    }
    def.DefKind owner_kind = ctx.store.defs.get(owner_def).kind;
    if (owner_kind != .module_def && owner_kind != .package_def) {
        return false;
    }
    return hir_def.decl.extern_kind != .none;
}

Bool is_lang_provider_entry(context.CompilerContext& ctx, mir.MirFunction& function) {
    if (function.type_args.length != 0 || function.const_args.length != 0) {
        return false;
    }
    if (ctx.store.defs.get(function.def_id).kind != .function_def) {
        return false;
    }
    qid.SymbolId symbol_id = ctx.store.defs.get(function.def_id).name.symbol;
    return is_lang_provider_entry_name(ctx.store.symbols.text(symbol_id));
}

Bool is_lang_provider_entry_name(UInt8[]& name) {
    return string.equal(name, lang_abi.create_symbol());
}

public std.String global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    return global_symbol_name_for_def(ctx, global_def, false);
}

public std.String global_symbol_name_for_def(context.CompilerContext& ctx, qid.DefId global_def, Bool is_external) {
    if (link_symbol_for_def(ctx, global_def) is .some(link_symbol)) {
        return std.String(ctx.store.symbols.text(link_symbol));
    }
    if (is_external) {
        return source_global_symbol_name(ctx, global_def);
    }
    std.String owner_prefix = global_def_owner_prefix(ctx, global_def);
    return global_backend_symbol_name(owner_prefix.bytes(), global_def);
}

qid.SymbolId? link_symbol_for_def(context.CompilerContext& ctx, qid.DefId def_id) {
    guard ctx.store.hirs.def(def_id) is .some(hir_def) else { return null; }
    return hir_def.decl.link_symbol;
}

public std.String global_backend_symbol_name(UInt8[]& owner_prefix, qid.DefId global_def) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(owner_prefix);
    builder.append("_g");
    builder.append(global_def.to_index());
    return builder.into_string();
}

std.String global_def_owner_prefix(context.CompilerContext& ctx, qid.DefId global_def) {
    Int package_index! = 0;
    Int module_index! = 0;
    if (ctx.store.defs.get(global_def).module_id is .some(module_id)) {
        module_index = module_id.to_index();
        package_index = ctx.store.resolve.module_ref(module_id).package_id.to_index();
    }
    std.StringBuilder builder = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    return builder.into_string();
}

public std.String source_global_symbol_name(context.CompilerContext& ctx, qid.DefId global_def) {
    qid.SymbolId symbol_id = ctx.store.defs.get(global_def).name.symbol;
    return std.String(ctx.store.symbols.text(symbol_id));
}

public std.String symbol_name(BackendSymbolKey key) {
    std.String name! = symbol_base_name(key.package_index, key.module_index, key.def_id.to_index());
    Int index! = 0;
    while (index < key.type_args.length) {
        name = append_int_part(name, "_T", key.type_args[index].to_index());
        index = index + 1;
    }
    index = 0;
    while (index < key.const_args.length) {
        std.String part = comptime_value_symbol_part(key.const_args[index]);
        name = append_text(name, "_C");
        name = append_text(name, part.bytes());
        index = index + 1;
    }
    if (key.coroutine_resume) {
        name = append_text(name, "_Resume");
    }
    if (key.coroutine_completion) {
        name = append_text(name, "_Complete");
    }
    return name;
}

std.String symbol_base_name(Int package_index, Int module_index, Int def_index) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("_Jp");
    builder.append(package_index);
    builder.append("_m");
    builder.append(module_index);
    builder.append("_f");
    builder.append(def_index);
    return builder.into_string();
}

std.String append_int_part(std.String prefix, UInt8[]& marker, Int value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(marker);
    builder.append(value);
    return builder.into_string();
}

std.String append_text(std.String prefix, UInt8[]& text) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(text);
    return builder.into_string();
}

() write_comptime_value_hash(hash.WyHasher& hasher, comptime_value.ComptimeValue value) {
    hasher.write_int(value.type_id.to_index());
    if (value.data is .invalid) { hasher.write_int(1); return; }
    if (value.data is .unit_value) { hasher.write_int(2); return; }
    if (value.data is .bool_value(bool_value)) {
        hasher.write_int(3);
        hasher.write_bool(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        hasher.write_int(4);
        hasher.write_int(int_value);
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        hasher.write_int(5);
        hasher.write_uint64(uint_value);
        return;
    }
    if (value.data is .char_value(char_value)) {
        hasher.write_int(6);
        hasher.write_uint64(char_value);
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        hasher.write_int(7);
        hasher.write_int(symbol_value.to_index());
        return;
    }
    if (value.data is .const_param_value(const_param)) {
        hasher.write_int(8);
        hasher.write_int(const_param.to_index());
        return;
    }
    if (value.data is .enum_case_value(enum_case)) {
        hasher.write_int(9);
        hasher.write_int(enum_case.to_index());
        return;
    }
    hasher.write_int(99);
}

Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    return false;
}

std.String comptime_value_symbol_part(comptime_value.ComptimeValue value) {
    std.StringBuilder builder = std.StringBuilder();
    if (value.data is .bool_value(bool_value)) {
        if (bool_value) { return std.String("b1"); }
        builder.append("b0");
        return builder.into_string();
    }
    if (value.data is .int_value(int_value)) {
        builder.append("i");
        builder.append(int_value);
        return builder.into_string();
    }
    if (value.data is .uint_value(uint_value)) {
        builder.append("u");
        builder.append(Int(uint_value));
        return builder.into_string();
    }
    if (value.data is .char_value(char_value)) {
        builder.append("c");
        builder.append(Int(char_value));
        return builder.into_string();
    }
    if (value.data is .symbol_value(symbol_value)) {
        builder.append("s");
        builder.append(symbol_value.to_index());
        return builder.into_string();
    }
    if (value.data is .enum_case_value(enum_case)) {
        builder.append("e");
        builder.append(enum_case.to_index());
        return builder.into_string();
    }
    if (value.data is .const_param_value(const_param)) {
        builder.append("p");
        builder.append(const_param.to_index());
        return builder.into_string();
    }
    return std.String("x");
}

public Bool validate_unique_function_symbols(context.CompilerContext& ctx, mir.MirStore& store) {
    table.HashTable<BackendSymbolKey, Bool> seen! = table.HashTable<BackendSymbolKey, Bool>();
    Int index! = 0;
    while (index < store.functions.len()) {
        mir.MirFunction& function = store.functions.ref_at(index);
        BackendSymbolKey key = function_symbol_key(ctx, function);
        if (seen.has(key)) {
            return false;
        }
        seen.set(key, true);
        index = index + 1;
    }
    return true;
}

public Bool validate_unique_function_symbol_names(context.CompilerContext& ctx, mir.MirStore& store) {
    return duplicate_function_symbol_name(ctx, store) == null;
}

public std.String? duplicate_function_symbol_name(context.CompilerContext& ctx, mir.MirStore& store) {
    list.ArrayList<std.String> names! = list.ArrayList<std.String>();
    list.ArrayList<Int> indexes! = list.ArrayList<Int>();
    Int index! = 0;
    while (index < store.functions.len()) {
        mir.MirFunction& function = store.functions.ref_at(index);
        std.String symbol_name = function_symbol_name(ctx, function);
        Int? existing_name_index! = null;
        {
            existing_name_index = duplicate_symbol_name_index(names$.ref(), symbol_name.bytes());
        }
        if (existing_name_index is .some(name_index)) {
            Int previous_index = indexes.get(name_index);
            mir.MirFunction& previous = store.functions.ref_at(previous_index);
            if (!compatible_duplicate_function_name(ctx, previous, function)) {
                return std.String(symbol_name.bytes());
            }
        } else {
            names.add(std.String(symbol_name.bytes()));
            indexes.add(index);
        }
        index = index + 1;
    }
    return null;
}

Int? duplicate_symbol_name_index(list.ArrayList<std.String>& names, UInt8[]& name) {
    Int index! = 0;
    while (index < names.len()) {
        if (string.equal(names.ref_at(index).bytes(), name)) {
            return index;
        }
        index = index + 1;
    }
    return null;
}

Bool compatible_duplicate_function_name(context.CompilerContext& ctx, mir.MirFunction& lhs, mir.MirFunction& rhs) {
    if (lhs.is_external && rhs.is_external) {
        return external_function_signature_equal(ctx, lhs, rhs);
    }
    return runtime_entry_extern_duplicate(ctx, lhs, rhs);
}

Bool runtime_entry_extern_duplicate(context.CompilerContext& ctx, mir.MirFunction& lhs, mir.MirFunction& rhs) {
    std.String lhs_name = function_symbol_name(ctx, lhs);
    if (!string.equal(lhs_name.bytes(), language_entry_symbol())) { return false; }
    std.String rhs_name = function_symbol_name(ctx, rhs);
    if (!string.equal(rhs_name.bytes(), language_entry_symbol())) { return false; }
    return (lhs.is_runtime_entry && rhs.is_external) || (lhs.is_external && rhs.is_runtime_entry);
}

@life()
UInt8[]& language_entry_symbol() {
    return "__jiang_main";
}

// 同一个 ABI symbol 可以在多个 module 里重复声明 extern 函数，但这些声明
// 必须描述同一个函数签名。真正的 Jiang 函数仍然必须有唯一 backend symbol。
Bool external_function_signature_equal(context.CompilerContext& ctx, mir.MirFunction& lhs, mir.MirFunction& rhs) {
    if (!ctx.store.types.same_type(function_return_type(lhs), function_return_type(rhs))) {
        return false;
    }
    if (function_param_count(lhs) != function_param_count(rhs)) {
        return false;
    }
    Int param_index! = 0;
    while (param_index < function_param_count(lhs)) {
        if (!ctx.store.types.same_type(function_param_type(lhs, param_index), function_param_type(rhs, param_index))) {
            return false;
        }
        param_index = param_index + 1;
    }
    return true;
}

qid.TypeId function_return_type(mir.MirFunction& function) {
    return function.body.locals[function.body.return_local.to_index()].type_id;
}

Int function_param_count(mir.MirFunction& function) {
    Int count! = 0;
    Int index! = 0;
    while (index < function.body.locals.length) {
        if (function.body.locals[index].kind == .param) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

qid.TypeId function_param_type(mir.MirFunction& function, Int param_index) {
    Int current_param! = 0;
    Int local_index! = 0;
    while (local_index < function.body.locals.length) {
        mir.MirLocalDecl local = function.body.locals[local_index];
        if (local.kind == .param) {
            if (current_param == param_index) {
                return local.type_id;
            }
            current_param = current_param + 1;
        }
        local_index = local_index + 1;
    }
    return function_return_type(function);
}
