// Backend stage entry.

import context = "../context.jiang";
import hir_lower = "../ir/hir_lower/api.jiang";

public struct BackendResult {
    public Bool ok;

    public init(Bool ok) {
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

public BackendResult emit(context.CompilerContext& ctx, hir_lower.MirLowerResult& module) {
    return BackendResult(module.ok);
}
