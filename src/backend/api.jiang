// Backend stage entry.

import context = "../context.jiang";
import mir = "../ir/mir.jiang";

public struct BackendResult {
    public Bool ok;

    public init(Bool ok) {
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

public BackendResult emit(context.CompilerContext& ctx, mir.MirFile& file) {
    return BackendResult(file.ok);
}
