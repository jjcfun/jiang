// Backend stage entry.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import mir = "../mir/mir.jiang";
import codegen_unit = "./codegen_unit.jiang";
import llvm_backend = "./llvm/api.jiang";
import symbol = "./symbol.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";

public struct BackendResult {
    public Bool ok;

    public init(Bool ok) {
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

public BackendResult emit(context.CompilerContext& ctx, mir.MirStore& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit(ctx, store));
}

public BackendResult emit_object(context.CompilerContext& ctx, mir.MirStore& store, UInt8[*] output_path) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit_object(ctx, store, output_path));
}

public BackendResult emit_object_for_unit(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    codegen_unit.CodegenUnit& unit,
    UInt8[*] output_path
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit_object_for_unit(ctx, store, unit, output_path));
}

public BackendResult emit_llvm_ir(context.CompilerContext& ctx, mir.MirStore& store, UInt8[*] output_path) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        add_backend_error(ctx, duplicate_symbol_key_message(ctx, store), "backend_duplicate_symbol_key");
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        add_backend_error(ctx, "duplicate backend function symbol name", "backend_duplicate_symbol_name");
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit_llvm_ir(ctx, store, output_path));
}

UInt8[] duplicate_symbol_key_message(context.CompilerContext& ctx, mir.MirStore& store) {
    table.HashTable<symbol.BackendSymbolKey, Int>! seen = table.HashTable<symbol.BackendSymbolKey, Int>();
    Int! index = 0;
    while (index < store.functions.len()) {
        mir.MirFunction function = store.functions.get(index);
        symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function);
        if (seen.has(key)) {
            UInt8[] name = symbol.function_symbol_name(ctx, function);
            UInt8[]! message = string.append("duplicate backend function symbol key: ", name);
            message = string.append(message, " ");
            return string.append(message, ctx.query.symbols.text(ctx.query.defs.get(function.def_id).name.symbol));
        }
        seen.set(key, index);
        index = index + 1;
    }
    return "duplicate backend function symbol key";
}

() add_backend_error(context.CompilerContext& ctx, UInt8[] message, UInt8[] code) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
