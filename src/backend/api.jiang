// 后端输出编排。
//
// pipeline 负责阶段顺序；这里负责 package artifact 准备、object 复用、
// 后端生成、运行时 object 选择和链接。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import object_artifact = "../artifact/object.jiang";
import object_hash = "../artifact/object_hash.jiang";
import object_plan = "../artifact/object_plan.jiang";
import artifact_path = "../artifact/path.jiang";
import package_artifact = "../artifact/package_artifact.jiang";
import source_ji = "../artifact/source_ji.jiang";
import codegen = "./codegen.jiang";
import codegen_unit = "./codegen_unit.jiang";
import link_plan = "./link_plan.jiang";
import linker = "./linker.jiang";
import driver_options = "../driver/options.jiang";
import mir = "../mir/mir.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_io = "../system/io.jiang";
import system_target = "../system/target.jiang";

public Bool validate_output_request(
    context.CompilerContext& ctx,
    driver_options.CompileOptions& options
) {
    system_target.TargetInfo& target = ctx.target$.ref();
    if (!supports_output(target, options.emit)) {
        diagnostic_helper.add_package_error(
            ctx,
            unsupported_output_message(target, options.emit),
            unsupported_output_code(target, options.emit)
        );
        return false;
    }
    if (!target.link_libc && options.emit == .executable && !system_target.is_linux_no_libc(target)) {
        diagnostic_helper.add_package_error(
            ctx,
            "--no-link-libc executable output is not supported yet; select object/llvm output or use --link-libc",
            "no_link_libc_executable_unsupported"
        );
        return false;
    }
    return true;
}

public codegen.BackendResult emit_package(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt64 package_hash,
    Bool link_libc
) {
    if (options.emit == .check_only) {
        return codegen.BackendResult(true);
    }
    if (!prepare_artifact_cache(ctx, options.emit, options.artifact_cache_dir)) {
        return codegen.BackendResult(false);
    }
    codegen.BackendResult result = emit_backend(
        ctx,
        lowered,
        options,
        llvm_triple,
        target_cache_key,
        target_info,
        package_hash,
        link_libc
    );
    if (result.has_errors()) {
        diagnostic_helper.add_package_error(ctx, "backend emission failed", "backend_emit_failed");
    }
    return result;
}

public UInt8[]& llvm_version_text() {
    return codegen.llvm_version_text();
}

public UInt8[]& default_target_triple_text() {
    return codegen.default_target_triple_text();
}

Bool supports_output(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit != .executable) {
        return true;
    }
    return system_target.target_supports_executable(target);
}

UInt8[]& unsupported_output_message(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit == .executable) {
        system_target.ExecutableSupport support = system_target.executable_support(target);
        if (support == .requires_toolchain) {
            return string.append("executable output requires target linker/toolchain support: ", target.requested_triple);
        }
        if (support == .requires_runtime) {
            return string.append("executable output requires target runtime object support: ", target.requested_triple);
        }
        if (support == .unsupported_runtime) {
            return string.append("executable output requires target runtime support: ", target.requested_triple);
        }
        return string.append("executable output is not supported for target yet: ", target.requested_triple);
    }
    return string.append("output is not supported for target: ", target.requested_triple);
}

UInt8[]& unsupported_output_code(system_target.TargetInfo& target, driver_options.EmitKind emit) {
    if (emit == .executable) {
        system_target.ExecutableSupport support = system_target.executable_support(target);
        if (support == .requires_toolchain) {
            return "target_executable_requires_toolchain";
        }
        if (support == .requires_runtime) {
            return "target_executable_requires_runtime";
        }
        if (support == .unsupported_runtime) {
            return "target_executable_runtime_unsupported";
        }
        return "target_executable_unsupported";
    }
    return "target_output_unsupported";
}

// 确保需要 object cache 的 emit 模式有 cache 目录。check/llvm-ir 不产生 object，
// 因此不创建 artifact 目录。
Bool prepare_artifact_cache(
    context.CompilerContext& ctx,
    driver_options.EmitKind emit,
    UInt8[]& artifact_cache_dir
) {
    if (emit == .check_only || emit == .llvm_ir) {
        return true;
    }
    UInt8[]& object_dir = artifact_path.object_dir(artifact_cache_dir);
    if (!system_fs.create_dirs(object_dir)) {
        diagnostic_helper.add_package_error(
            ctx,
            string.append("failed to create artifact cache directory: ", object_dir),
            "cache_dir_failed"
        );
        return false;
    }
    if (emit != .dynamic_library) {
        return true;
    }
    UInt8[]& lang_dir = artifact_path.lang_dir(artifact_cache_dir);
    if (system_fs.create_dirs(lang_dir)) {
        return true;
    }
    diagnostic_helper.add_package_error(ctx, string.append("failed to create lang artifact cache directory: ", lang_dir), "cache_dir_failed");
    return false;
}

// 根据 emit kind 分发 backend 输出。executable/object 可以使用 object cache；
// llvm-ir 是调试输出，直接消费最终 MIR。
codegen.BackendResult emit_backend(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt64 package_hash,
    Bool link_libc
) {
    if (options.emit == .object_file) {
        return emit_object_with_cache(
            ctx,
            lowered,
            options.output_path,
            options.artifact_cache_dir,
            llvm_triple,
            target_cache_key,
            options.compiler_version,
            package_hash,
            options.mode,
            link_libc
        );
    }
    if (options.emit == .llvm_ir) {
        if (options.output_path.length == 0) {
            codegen.BackendTextResult text = codegen.emit_llvm_ir_text(ctx, lowered, link_libc, llvm_triple);
            if (!text.ok) {
                return codegen.BackendResult(false);
            }
            system_fs.File out = system_io.stdout();
            return codegen.BackendResult(out.write_all(text.text));
        }
        return codegen.emit_llvm_ir(ctx, lowered, options.output_path, link_libc, llvm_triple);
    }
    if (options.emit == .dynamic_library) {
        return emit_dynamic_library(
            ctx,
            lowered,
            options,
            llvm_triple,
            target_cache_key,
            target_info,
            package_hash,
            link_libc
        );
    }
    if (options.mode == .release) {
        return emit_release_executable(
            ctx,
            lowered,
            options.output_path,
            options.artifact_cache_dir,
            llvm_triple,
            target_cache_key,
            target_info,
            options.compiler_version,
            options.linker_path,
            options.link_args$.ref(),
            package_hash,
            link_libc
        );
    }
    return emit_debug_package_executable(
        ctx,
        lowered,
        options.output_path,
        options.artifact_cache_dir,
        llvm_triple,
        target_cache_key,
        target_info,
        options.compiler_version,
        options.linker_path,
        options.link_args$.ref(),
        package_hash,
        link_libc
    );
}

codegen.BackendResult emit_debug_package_executable(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    list.ArrayList<UInt8[]&>& link_args,
    UInt64 package_hash,
    Bool link_libc
) {
    UInt8[]& object_path = package_object_path(
        artifact_cache_dir,
        target_cache_key,
        compiler_version,
        driver_options.CompileMode.debug,
        package_hash
    );
    if (!emit_debug_package_object(ctx, lowered, object_path, link_libc, llvm_triple)) {
        return codegen.BackendResult(false);
    }
    link_plan.LinkPlan! links = link_plan.LinkPlan();
    links.add_user_object(object_path);
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    linker.LinkResult result = linker.link_for_target(links$.ref(), target_info, linker_path, output_path, link_args);
    if (!result.ok) {
        diagnostic_helper.add_package_error(ctx, linker_failure_message(result, linker_path, output_path, links$.ref()), "linker_execution_failed");
    }
    return codegen.BackendResult(result.ok);
}

UInt8[]& package_object_path(
    UInt8[]& artifact_cache_dir,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_version,
    driver_options.CompileMode mode,
    UInt64 package_hash
) {
    package_artifact.PackageArtifactKey! key = package_artifact.PackageArtifactKey(
        .package_object,
        package_hash,
        source_artifact_version_hash(compiler_version),
        UInt64(0),
        target_cache_key,
        mode
    );
    return package_artifact.artifact_path_for(artifact_cache_dir, key$.ref(), ".o");
}

codegen.BackendResult emit_release_executable(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    list.ArrayList<UInt8[]&>& link_args,
    UInt64 package_hash,
    Bool link_libc
) {
    UInt8[]& object_path = package_object_path(
        artifact_cache_dir,
        target_cache_key,
        compiler_version,
        driver_options.CompileMode.release,
        package_hash
    );
    if (!emit_release_package_object(ctx, lowered, object_path, link_libc, llvm_triple)) {
        return codegen.BackendResult(false);
    }
    link_plan.LinkPlan! links = link_plan.LinkPlan();
    links.add_user_object(object_path);
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    linker.LinkResult result = linker.link_for_target(links$.ref(), target_info, linker_path, output_path, link_args);
    if (!result.ok) {
        diagnostic_helper.add_package_error(ctx, linker_failure_message(result, linker_path, output_path, links$.ref()), "linker_execution_failed");
    }
    return codegen.BackendResult(result.ok);
}

codegen.BackendResult emit_dynamic_library(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt64 package_hash,
    Bool link_libc
) {
    UInt8[]& object_path = package_object_path(
        options.artifact_cache_dir,
        target_cache_key,
        options.compiler_version,
        options.mode,
        package_hash
    );
    if (options.mode == .release) {
        if (!emit_release_package_object(ctx, lowered, object_path, link_libc, llvm_triple)) {
            return codegen.BackendResult(false);
        }
    } else if (!emit_debug_package_object(ctx, lowered, object_path, link_libc, llvm_triple)) {
        return codegen.BackendResult(false);
    }

    link_plan.LinkPlan! links = link_plan.LinkPlan();
    links.add_user_object(object_path);
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    linker.LinkResult result = linker.link_dynamic_library_for_target(
        links$.ref(),
        target_info,
        options
    );
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx,
            linker_failure_message(result, options.linker_path, options.output_path, links$.ref()),
            "linker_execution_failed"
        );
    }
    return codegen.BackendResult(result.ok);
}

Bool append_runtime_objects(
    context.CompilerContext& ctx,
    link_plan.LinkPlan& links,
    system_target.TargetInfo& target
) {
    if (!system_target.is_linux_no_libc(target)) {
        return true;
    }
    UInt8[]& runtime_object = system_target.linux_no_libc_runtime_object_path(target);
    if (runtime_object.length == 0 || !system_fs.file_exists(runtime_object)) {
        diagnostic_helper.add_package_error(
            ctx,
            string.append("missing Linux no-libc runtime object: ", runtime_object),
            "linux_no_libc_runtime_missing"
        );
        return false;
    }
    links.add_runtime_object(runtime_object);
    return true;
}

Bool emit_debug_package_object(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    codegen.BackendResult emitted = codegen.emit_object(
        ctx,
        lowered,
        output_path,
        driver_options.CompileMode.debug,
        link_libc,
        target_triple
    );
    return !emitted.has_errors();
}

Bool emit_release_package_object(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    codegen.BackendResult emitted = codegen.emit_object(
        ctx,
        lowered,
        output_path,
        driver_options.CompileMode.release,
        link_libc,
        target_triple
    );
    return !emitted.has_errors();
}

UInt8[]& linker_failure_message(
    linker.LinkResult result,
    UInt8[]& linker_path,
    UInt8[]& output_path,
    link_plan.LinkPlan& links
) {
    UInt8[]&! message = "linker execution failed: linker=";
    message = string.append(message, linker_path);
    if (result.started) {
        message = string.append(message, ", exit_code=");
    } else {
        message = string.append(message, ", spawn_errno=");
    }
    message = string.append(message, string.int_text(result.exit_code));
    message = string.append(message, ", output=");
    message = string.append(message, linker_output_path(output_path));
    message = string.append(message, ", inputs=");
    return string.append(message, string.int_text(links.len()));
}

UInt8[]& linker_output_path(UInt8[]& output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}

// 生成单个 object 输出。能复用单个 cache object 时直接复制；多 codegen unit
// 当前仍回退为整包 object 输出，避免输出路径语义不清。
codegen.BackendResult emit_object_with_cache(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_version,
    UInt64 package_hash,
    driver_options.CompileMode mode,
    Bool link_libc
) {
    if (mode == .release) {
        UInt8[]&! final_path = output_path;
        if (final_path.length == 0) {
            final_path = package_object_path(
                artifact_cache_dir,
                target_cache_key,
                compiler_version,
                driver_options.CompileMode.release,
                package_hash
            );
        }
        if (emit_release_package_object(ctx, lowered, final_path, link_libc, llvm_triple)) {
            return codegen.BackendResult(true);
        }
        return codegen.BackendResult(false);
    }
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx, lowered);
    object_plan.ObjectReusePlan plan = object_plan.build_object_reuse_plan(
        ctx,
        lowered,
        units$.ref(),
        artifact_cache_dir,
        target_cache_key,
        compiler_version,
        mode
    );
    record_object_plan_stats(ctx, plan$.ref());
    if (plan.len() == 1) {
        return emit_single_object_unit_with_cache(
            ctx,
            lowered,
            units$.ref(),
            plan$.ref(),
            plan.entry_at(0),
            output_path,
            mode,
            link_libc,
            llvm_triple
        );
    }
    if (!emit_plan_cache_objects(ctx, lowered, units$.ref(), plan$.ref(), mode, link_libc, llvm_triple)) {
        return codegen.BackendResult(false);
    }
    return codegen.emit_object(ctx, lowered, output_path, mode, link_libc, llvm_triple);
}

// 将 object reuse plan 的命中情况记录到 store，供 smoke 和后续增量诊断使用。
() record_object_plan_stats(context.CompilerContext& ctx, object_plan.ObjectReusePlan& plan) {
    Int! index = 0;
    while (index < plan.len()) {
        object_plan.ObjectPlanEntry& entry = plan.entry_at(index);
        if (entry.kind == .unsupported) {
            ctx.store.object_artifacts.record_unsupported_unit();
        } else if (entry.kind == .source_object) {
            ctx.store.object_artifacts.record_source_lookup(entry.lookup_status);
        } else {
            ctx.store.object_artifacts.record_monomorph_lookup(entry.lookup_status);
        }
        index = index + 1;
    }
}

// 按 object plan 补齐所有缺失 cache object。命中的 entry 不触发 backend。
Bool emit_plan_cache_objects(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    Int! index = 0;
    while (index < plan.len()) {
        if (!emit_plan_cache_object(ctx, lowered, units, plan, plan.entry_at(index), mode, link_libc, target_triple)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// 为一个 codegen unit 生成 cache object，并在成功后登记实际文件 hash。
Bool emit_plan_cache_object(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (entry.kind == .unsupported || entry.can_reuse()) {
        return true;
    }
    UInt8[]& cache_path = plan.path_at(entry.path_index);
    codegen.BackendResult emitted = codegen.emit_object_for_unit(
        ctx,
        lowered,
        units.unit_at(entry.unit_index),
        cache_path,
        mode,
        link_libc,
        target_triple
    );
    if (emitted.has_errors()) {
        return false;
    }
    record_emitted_object(ctx, plan, entry);
    return true;
}

// 单 codegen unit 的 object 输出路径可以直接使用 cache artifact。这个路径同时覆盖
// `--emit-obj` 未指定 `-o` 时的默认输出行为。
codegen.BackendResult emit_single_object_unit_with_cache(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (entry.kind == .unsupported) {
        return codegen.emit_object(ctx, lowered, output_path, mode, link_libc, target_triple);
    }

    UInt8[]& cache_path = plan.path_at(entry.path_index);
    UInt8[]& final_path = final_object_path(output_path, cache_path);
    if (entry.can_reuse()) {
        return codegen.BackendResult(copy_cached_object(ctx, cache_path, final_path));
    }

    if (!emit_plan_cache_object(ctx, lowered, units, plan, entry, mode, link_libc, target_triple)) {
        return codegen.BackendResult(false);
    }
    return codegen.BackendResult(copy_cached_object(ctx, cache_path, final_path));
}

// 没有显式 output path 时，cache path 就是最终 object path。
@life(output_path > return, cache_path > return)
UInt8[]& final_object_path(UInt8[]& output_path, UInt8[]& cache_path) {
    if (output_path.length == 0) {
        return cache_path;
    }
    return output_path;
}

// 将 cache object 复制到用户指定输出路径。源和目标相同时直接视为成功。
Bool copy_cached_object(context.CompilerContext& ctx, UInt8[]& cache_path, UInt8[]& output_path) {
    if (string.equal(cache_path, output_path)) {
        return true;
    }
    if (system_fs.copy_file(cache_path, output_path)) {
        return true;
    }
    diagnostic_helper.add_package_error(ctx, "failed to copy cached object file", "cached_object_copy_failed");
    return false;
}

// 记录刚生成的 object artifact。source object 和 monomorph object 使用不同 key，
// 但都只保存文件 hash 和路径，不保存 backend 内存对象。
() record_emitted_object(
    context.CompilerContext& ctx,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry
) {
    UInt8[]& cache_path = plan.path_at(entry.path_index);
    guard object_hash.hash_file(cache_path) is .some(emitted_hash) else {
        return;
    }
    if (entry.kind == .source_object && entry.source_key_index >= 0) {
        ctx.store.object_artifacts.store_source_object(
            plan.source_key_at(entry.source_key_index),
            object_artifact.ObjectArtifactRecord(.source_object, emitted_hash, cache_path)
        );
        return;
    }
    if (entry.kind == .monomorph_object && entry.monomorph_key_index >= 0) {
        ctx.store.object_artifacts.store_monomorph_object(
            plan.monomorph_key_at(entry.monomorph_key_index),
            object_artifact.ObjectArtifactRecord(.monomorph_object, emitted_hash, cache_path)
        );
    }
}

UInt64 source_artifact_version_hash(UInt8[]& compiler_version) {
    return source_ji.artifact_version_hash(compiler_version);
}
