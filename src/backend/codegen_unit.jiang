// Backend codegen unit 的通用分组。
//
// 这里不做 LLVM lowering，也不读写 object 文件。它只把 Store 中的
// function definition 分成后续可以独立 emission/cache 的 unit。

import context = "../context.jiang";
import core_traits = "../core/traits.jiang";
import jil = "../jil.jiang";
import qid = "../store/id.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import symbol = "./symbol.jiang";

public enum CodegenUnitKind {
    source_unit,
    monomorph_unit,
}

@region(a)
public struct CodegenUnitKey: Copyable, Hashable, Equatable {
    public CodegenUnitKind kind;
    public Int package_index;
    public Int module_index;
    public Int def_index;
    public Bool runtime_entry;
    @life(a)
    public qid.TypeId[]& type_args;

    public init(self,
        CodegenUnitKind kind,
        Int package_index,
        Int module_index,
        Int def_index,
        Bool runtime_entry,
        qid.TypeId[]& type_args
    ) {
        self.kind = kind;
        self.package_index = package_index;
        self.module_index = module_index;
        self.def_index = def_index;
        self.runtime_entry = runtime_entry;
        self.type_args = type_args;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.kind));
        hasher.write(Int(self.package_index));
        hasher.write(Int(self.module_index));
        hasher.write(Int(self.def_index));
        Bool runtime_entry = self.runtime_entry;
        hasher.write(runtime_entry);
        hasher.write(Int(self.type_args.length));
        Int index! = 0;
        while (index < self.type_args.length) {
            hasher.write(Int(self.type_args[index].to_index()));
            index = index + 1;
        }
    }

    public Bool equal(CodegenUnitKey& lhs, CodegenUnitKey& rhs) {
        CodegenUnitKind lhs_kind = lhs.kind;
        CodegenUnitKind rhs_kind = rhs.kind;
        Int lhs_kind_value = Int(lhs_kind);
        Int rhs_kind_value = Int(rhs_kind);
        if (lhs_kind_value != rhs_kind_value) { return false; }
        if (lhs.package_index != rhs.package_index) { return false; }
        if (lhs.module_index != rhs.module_index) { return false; }
        if (lhs.def_index != rhs.def_index) { return false; }
        if (lhs.runtime_entry != rhs.runtime_entry) { return false; }
        if (lhs.type_args.length != rhs.type_args.length) { return false; }
        return type_args_equal(lhs.type_args, rhs.type_args);
    }
}

@region(a)
public struct CodegenUnit: Movable {
    @life(a)
    public CodegenUnitKey key;
    public list.ArrayList<jil.FunctionId> functions;

    public init(self, CodegenUnitKey key) {
        self.key = key;
        self.functions = list.ArrayList<jil.FunctionId>();
    }

    public () add_function(self, jil.FunctionId function_id) {
        self.functions.add(function_id);
    }
}

public struct CodegenUnitSet: Movable {
    public list.ArrayList<CodegenUnit> units;
    table.HashTable<CodegenUnitKey, Int> indexes;

    public init(self) {
        self.units = list.ArrayList<CodegenUnit>();
        self.indexes = table.HashTable<CodegenUnitKey, Int>();
    }

    public Int len(self) {
        return self.units.len();
    }
    public CodegenUnit& unit_at(self, Int index) {
        return self.units.ref_at(index);
    }

    public Int add_function(self, CodegenUnitKey key, jil.FunctionId function_id) {
        if (table.hash_table_get_value<CodegenUnitKey, Int>(self.indexes$.ref(), key) is .some(index)) {
            self.units.ref_at(index).add_function(function_id);
            return index;
        }

        Int index = self.units.len();
        CodegenUnit unit! = CodegenUnit(key);
        unit.add_function(function_id);
        self.units.add(unit);
        self.indexes.set(key, index);
        return index;
    }
}

public CodegenUnitSet build_codegen_units(context.CompilerContext& ctx, jil.Store& store) {
    CodegenUnitSet units! = CodegenUnitSet();
    Int index! = 0;
    while (index < store.functions.len()) {
        jil.Function& function = store.functions.ref_at(index);
        if (!function.is_external) {
            units.add_function(unit_key_for_function(ctx, function), function.id);
        }
        index = index + 1;
    }
    return units;
}

@life(return: function.a)
public CodegenUnitKey unit_key_for_function(
    context.CompilerContext& ctx,
    jil.Function& function
) {
    symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function);
    if (function.type_args.length > 0) {
        return CodegenUnitKey(
            .monomorph_unit,
            key.package_index,
            key.module_index,
            function.def_id.to_index(),
            key.runtime_entry,
            function.type_args
        );
    }

    return CodegenUnitKey(
        .source_unit,
        key.package_index,
        key.module_index,
        -1,
        false,
        function.type_args
    );
}

Bool type_args_equal(qid.TypeId[]& lhs, qid.TypeId[]& rhs) {
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index].to_index() != rhs[index].to_index()) {
            return false;
        }
        index = index + 1;
    }
    return true;
}
