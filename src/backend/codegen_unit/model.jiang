// Backend codegen unit 的阶段内模型。
//
// source unit 保存普通源码定义，monomorph unit 保存该源码实际引用的
// concrete instance。模型与引用闭包算法分离，避免入口模块形成循环依赖。

import core_traits = "../../core/traits.jiang";
import jil = "../../jil.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";

public enum CodegenUnitKind {
    source_unit,
    monomorph_unit,
}

public struct CodegenUnitKey: Copyable, Hashable, Equatable {
    public CodegenUnitKind kind;
    public Int package_index;
    public Int module_index;

    public init(self,
        CodegenUnitKind kind,
        Int package_index,
        Int module_index
    ) {
        self.kind = kind;
        self.package_index = package_index;
        self.module_index = module_index;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.kind));
        hasher.write(Int(self.package_index));
        hasher.write(Int(self.module_index));
    }

    public Bool equal(CodegenUnitKey& lhs, CodegenUnitKey& rhs) {
        CodegenUnitKind lhs_kind = lhs.kind;
        CodegenUnitKind rhs_kind = rhs.kind;
        Int lhs_kind_value = Int(lhs_kind);
        Int rhs_kind_value = Int(rhs_kind);
        if (lhs_kind_value != rhs_kind_value) { return false; }
        if (lhs.package_index != rhs.package_index) { return false; }
        return lhs.module_index == rhs.module_index;
    }
}

public struct CodegenUnit: Movable {
    public CodegenUnitKey key;
    public list.ArrayList<jil.FunctionId> functions;
    public Bool weak_monomorph_definitions;

    public init(self, CodegenUnitKey key) {
        self.key = key;
        self.functions = list.ArrayList<jil.FunctionId>();
        self.weak_monomorph_definitions = false;
    }

    public Void add_function(self, jil.FunctionId function_id) {
        self.functions.add(function_id);
    }
}

public struct CodegenUnitSet: Movable {
    public list.ArrayList<CodegenUnit> units;
    table.HashTable<CodegenUnitKey, Int> indexes;

    public init(self) {
        self.units = list.ArrayList<CodegenUnit>();
        self.indexes = table.HashTable<CodegenUnitKey, Int>();
    }

    public Int len(self) {
        return self.units.len();
    }

    public CodegenUnit& unit_at(self, Int index) {
        return self.units.ref_at(index);
    }

    public Int add_function(self, CodegenUnitKey key, jil.FunctionId function_id) {
        Int index = self.ensure_unit(key);
        self.units.ref_at(index).add_function(function_id);
        return index;
    }

    public Void mark_weak_monomorph_definitions(self, Int index) {
        self.units.ref_at(index).weak_monomorph_definitions = true;
    }

    public Int ensure_unit(self, CodegenUnitKey key) {
        if (table.hash_table_get_value<CodegenUnitKey, Int>(
            self.indexes$.ref(), key
        ) is .some(index)) {
            return index;
        }
        Int index = self.units.len();
        self.units.add(CodegenUnit(key));
        self.indexes.set(key, index);
        return index;
    }
}

public struct Statistics: Copyable {
    public Int source_units!;
    public Int monomorph_units!;
    public Int functions!;
    public Int largest_unit_functions!;

    public init(self) {
        self.source_units = 0;
        self.monomorph_units = 0;
        self.functions = 0;
        self.largest_unit_functions = 0;
    }
}

public Statistics statistics(CodegenUnitSet& units) {
    Statistics result! = Statistics();
    Int index! = 0;
    while (index < units.len()) {
        CodegenUnit& unit = units.unit_at(index);
        if (unit.key.kind == .source_unit) {
            result.source_units = result.source_units + 1;
        } else {
            result.monomorph_units = result.monomorph_units + 1;
        }
        Int function_count = unit.functions.len();
        result.functions = result.functions + function_count;
        if (function_count > result.largest_unit_functions) {
            result.largest_unit_functions = function_count;
        }
        index = index + 1;
    }
    return result;
}
