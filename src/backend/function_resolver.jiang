// Backend function reference 到 source instance / generated function 的统一解析。

import jil = "../jil.jiang";
import qid = "../id.jiang";
import types = "../sema/type.jiang";

public jil.MonoItem? for_ref(
    jil.Store& store,
    jil.FunctionRef value
) {
    if (value.target is .generated(generated)) {
        return jil.generated_function_mono_item(generated.id);
    }
    guard value.target is .source(def_id) else { return null; }
    if (value.coroutine_start) {
        guard store.program.async_start_function(def_id, value.args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    if (value.coroutine_sync) {
        guard store.program.async_sync_function(def_id, value.args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    if (value.coroutine_resume) {
        return store.program.mono_item_for_ref(value);
    }
    if (value.coroutine_completion) {
        if (value.coroutine_serial_completion) {
            guard store.program.serial_completion_function(def_id, value.args)
                is .some(function_id) else { return null; }
            return jil.generated_function_mono_item(function_id);
        }
        guard store.program.coroutine_completion_function(def_id, value.args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    return source(store, def_id, value.args);
}

public jil.MonoItem? source(
    jil.Store& store,
    qid.DefId def_id,
    types.GenericArg[]& args
) {
    guard store.program.existing_function_instance_identity(def_id, args)
        is .some(identity) else { return null; }
    if (!store.program.is_source_instance(identity)) { return null; }
    return jil.source_instance_mono_item(identity);
}
