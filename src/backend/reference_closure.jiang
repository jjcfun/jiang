// 按最终 JIL 引用建立泛型实例闭包。
//
// 每个 MonoItem 的直接引用只从 generic JIL 解析一次。source unit 仍分别遍历
// 传递闭包，并按稳定 source 顺序给 concrete instance 和 generated body 分配唯一 owner。

import codegen_unit = "./codegen_unit/model.jiang";
import context = "../context.jiang";
import jil = "../jil.jiang";
import instance_reader = "../jil/instance_reader.jiang";
import jil_references = "../jil/references.jiang";
import function_resolver = "./function_resolver.jiang";
import symbol = "./symbol.jiang";
import source_ji = "../artifact/source_ji.jiang";
import generic_bindings = "../sema/generic/bindings.jiang";
import types = "../sema/type.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import table = "../support/table.jiang";

struct DirectReferenceCache: Movable {
    map.WyHashMap<Int, Bool> ready!;
    table.MultiTable<Int, jil.MonoItem> references!;

    init(self) {
        self.ready = map.WyHashMap<Int, Bool>();
        self.references = table.MultiTable<Int, jil.MonoItem>();
    }
}

struct SourceUnitCandidate: Copyable {
    Int index;
    qkey.Fingerprint128 identity;
}

public Void assign(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units
) {
    map.WyHashMap<Int, Int> visited! = map.WyHashMap<Int, Int>();
    map.WyHashMap<symbol.BackendSymbolKey, Bool> assigned! =
        map.WyHashMap<symbol.BackendSymbolKey, Bool>();
    DirectReferenceCache references! = DirectReferenceCache();
    list.ArrayList<SourceUnitCandidate> source_units = stable_source_units(ctx, units);
    Int index! = 0;
    while (index < source_units.len()) {
        Int unit_index = source_units.get(index).index;
        codegen_unit.CodegenUnitKey key = units.unit_at(unit_index).key;
        assign_source(
            ctx,
            store,
            units,
            unit_index,
            key,
            visited$.mut_ref(),
            assigned$.mut_ref(),
            references$.mut_ref()
        );
        index = index + 1;
    }
}

list.ArrayList<SourceUnitCandidate> stable_source_units(
    context.CompilerContext& ctx,
    codegen_unit.CodegenUnitSet& units
) {
    list.ArrayList<SourceUnitCandidate> result! =
        list.ArrayList<SourceUnitCandidate>();
    Int index! = 0;
    while (index < units.len()) {
        codegen_unit.CodegenUnitKey key = units.unit_at(index).key;
        if (key.kind == .source_unit) {
            qid.ModuleId module_id = qid.ModuleId.from_index(key.module_index);
            qkey.Fingerprint128 identity! = qkey.Fingerprint128(
                UInt64(key.module_index), UInt64(key.package_index)
            );
            if (source_ji.source_identity_for_module(ctx, module_id) is .some(stable)) {
                identity = stable.fingerprint;
            }
            insert_source_unit(result$.mut_ref(), SourceUnitCandidate(
                index: index,
                identity: identity
            ));
        }
        index = index + 1;
    }
    return result;
}

Void insert_source_unit(
    list.ArrayList<SourceUnitCandidate>&! units,
    SourceUnitCandidate candidate
) {
    units.add(candidate);
    Int index! = units.len() - 1;
    while (index > 0 && source_unit_less(candidate, units.get(index - 1))) {
        units.set(index, units.get(index - 1));
        index = index - 1;
    }
    units.set(index, candidate);
}

Bool source_unit_less(SourceUnitCandidate lhs, SourceUnitCandidate rhs) {
    if (lhs.identity.high != rhs.identity.high) {
        return lhs.identity.high < rhs.identity.high;
    }
    return lhs.identity.low < rhs.identity.low;
}

Void assign_source(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units,
    Int source_unit_index,
    codegen_unit.CodegenUnitKey source_key,
    map.WyHashMap<Int, Int>&! visited,
    map.WyHashMap<symbol.BackendSymbolKey, Bool>&! assigned,
    DirectReferenceCache&! references
) {
    list.ArrayList<jil.MonoItem> worklist! = list.ArrayList<jil.MonoItem>();
    Int generation = source_key.module_index + 1;
    enqueue_source_roots(
        units, source_unit_index, generation, visited, worklist$.mut_ref()
    );
    enqueue_global_references(
        ctx,
        store,
        units,
        source_unit_index,
        source_key,
        visited,
        assigned,
        worklist$.mut_ref()
    );
    while (!worklist.empty()) {
        jil.MonoItem function = worklist.pop();
        collect_function_references(
            ctx,
            store,
            units,
            source_key,
            function,
            visited,
            assigned,
            worklist$.mut_ref(),
            references
        );
    }
}

Void enqueue_source_roots(
    codegen_unit.CodegenUnitSet&! units,
    Int source_unit_index,
    Int generation,
    map.WyHashMap<Int, Int>&! visited,
    list.ArrayList<jil.MonoItem>&! worklist
) {
    codegen_unit.CodegenUnit& unit = units.unit_at(source_unit_index);
    Int index! = 0;
    while (index < unit.functions.len()) {
        enqueue_function(unit.functions.get(index), generation, visited, worklist);
        index = index + 1;
    }
}

Void enqueue_function(
    jil.MonoItem function,
    Int generation,
    map.WyHashMap<Int, Int>&! visited,
    list.ArrayList<jil.MonoItem>&! worklist
) {
    Int identity = jil.mono_item_identity(function);
    if (visited.get(identity) is .some(value) && value$.get() == generation) {
        return;
    }
    visited.set(identity, generation);
    worklist.add(function);
}

Void enqueue_global_references(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units,
    Int source_unit_index,
    codegen_unit.CodegenUnitKey source_key,
    map.WyHashMap<Int, Int>&! visited,
    map.WyHashMap<symbol.BackendSymbolKey, Bool>&! assigned,
    list.ArrayList<jil.MonoItem>&! worklist
) {
    Int global_count = units.unit_at(source_unit_index).globals.len();
    Int index! = 0;
    while (index < global_count) {
        jil.GlobalId global_id = units.unit_at(source_unit_index).globals.get(index);
        jil.Global& global = store.program.globals.ref_at(global_id.to_index());
        if (global.initializer is .some(value)) {
            collect_static_value(
                ctx, store, units, source_key, value, visited, assigned, worklist
            );
        }
        index = index + 1;
    }
}

Void collect_static_value(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units,
    codegen_unit.CodegenUnitKey source_key,
    jil.StaticValue value,
    map.WyHashMap<Int, Int>&! visited,
    map.WyHashMap<symbol.BackendSymbolKey, Bool>&! assigned,
    list.ArrayList<jil.MonoItem>&! worklist
) {
    if (value is .function(function_ref)) {
        guard function_resolver.for_ref(store, function_ref)
            is .some(function) else { return; }
        collect_codegen_function(
            ctx, store, units, source_key, function, visited, assigned, worklist
        );
        return;
    }
    guard value is .aggregate(fields) else { return; }
    Int index! = 0;
    while (index < fields.length) {
        collect_static_value(
            ctx,
            store,
            units,
            source_key,
            fields[index].value,
            visited,
            assigned,
            worklist
        );
        index = index + 1;
    }
}

Void collect_function_references(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units,
    codegen_unit.CodegenUnitKey source_key,
    jil.MonoItem item,
    map.WyHashMap<Int, Int>&! visited,
    map.WyHashMap<symbol.BackendSymbolKey, Bool>&! assigned,
    list.ArrayList<jil.MonoItem>&! worklist,
    DirectReferenceCache&! references
) {
    Int identity = jil.mono_item_identity(item);
    if (!references.ready.has(identity)) {
        cache_direct_references(ctx, store, item, references);
        references.ready.set(identity, true);
    }
    table.MultiTableCursor cursor! = references.references.first(identity);
    while (cursor.valid()) {
        collect_codegen_function(
            ctx,
            store,
            units,
            source_key,
            references.references.get(cursor),
            visited,
            assigned,
            worklist
        );
        cursor = references.references.next(cursor);
    }
}

Void cache_direct_references(
    context.CompilerContext& ctx,
    jil.Store& store,
    jil.MonoItem item,
    DirectReferenceCache&! references
) {
    Int identity = jil.mono_item_identity(item);
    if (item is .source_instance(instance_identity)) {
        jil.InstanceKey instance = store.program.function_instance_at(instance_identity);
        cache_source_references(
            ctx,
            store,
            identity,
            instance,
            store.program.source_function(instance.def_id),
            references
        );
        return;
    }
    if (item is .source_resume_instance(resume)) {
        jil.InstanceKey instance = store.program.function_instance_at(resume.identity);
        jil.CoroutineResumeTemplate source =
            store.program.source_resume_template(instance.def_id, resume.mode);
        cache_source_references(
            ctx, store, identity, instance, source.function, references
        );
        return;
    }
    jil.Function function = codegen_unit.codegen_function(ctx, store, item);
    jil_references.References direct = jil_references.collect_function_refs(function);
    cache_resolved_references(ctx, store, identity, direct$.ref(), references);
}

Void cache_source_references(
    context.CompilerContext& ctx,
    jil.Store& store,
    Int identity,
    jil.InstanceKey instance,
    jil.Function source,
    DirectReferenceCache&! references
) {
    generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
    generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
        ctx.store.defs$.ref(),
        ctx.store.model$.ref(),
        ctx.store.types$.ref(),
        instance.def_id,
        instance.args,
        empty$.ref()
    );
    jil_references.References direct = jil_references.collect_instance_function_refs(
        ctx.store$.ref(), bindings$.ref(), source
    );
    cache_resolved_references(ctx, store, identity, direct$.ref(), references);
    instance_reader.InstanceReader reader = instance_reader.InstanceReader(
        ctx.store$.ref(), bindings$.ref()
    );
    cache_source_drop_glues(
        ctx, store, identity, reader$.ref(), source, references
    );
}

Void cache_resolved_references(
    context.CompilerContext& ctx,
    jil.Store& store,
    Int identity,
    jil_references.References& direct,
    DirectReferenceCache&! references
) {
    Int index! = 0;
    while (index < direct.functions.len()) {
        jil_references.FunctionReference& reference = direct.functions.ref_at(index);
        if (codegen_function_for_reference(store, reference)
            is .some(function)) {
            cache_reference(ctx, store, identity, function, references);
        }
        index = index + 1;
    }
    index = 0;
    while (index < direct.generated_functions.len()) {
        cache_reference(
            ctx,
            store,
            identity,
            jil.generated_function_mono_item(direct.generated_functions.get(index)),
            references
        );
        index = index + 1;
    }
}

Void cache_source_drop_glues(
    context.CompilerContext& ctx,
    jil.Store& store,
    Int identity,
    instance_reader.InstanceReader& reader,
    jil.Function source,
    DirectReferenceCache&! references
) {
    Int index! = 0;
    while (index < source.body.blocks.length) {
        jil.Terminator terminator = source.body.blocks[index].terminator;
        index = index + 1;
        guard terminator.kind is .drop_term(drop) else { continue; }
        qid.TypeId type_id = ctx.store.types.canonical_substitution_type(
            reader.place_type(source.body$.ref(), drop.place)
        );
        if (store.program.drop_glue(type_id) is .some(glue_id)) {
            cache_reference(
                ctx,
                store,
                identity,
                jil.generated_function_mono_item(glue_id),
                references
            );
        }
    }
}

Void cache_reference(
    context.CompilerContext& ctx,
    jil.Store& store,
    Int identity,
    jil.MonoItem item,
    DirectReferenceCache&! references
) {
    jil.Function function = codegen_unit.codegen_function(ctx, store, item);
    if (!codegen_unit.requires_demand_owner(function$.ref())) { return; }
    references.references.add(identity, item);
}

jil.MonoItem? codegen_function_for_reference(
    jil.Store& store,
    jil_references.FunctionReference& reference
) {
    types.GenericArg[]& args = reference.args.slice();
    if (reference.variant is .coroutine_start) {
        guard store.program.async_start_function(reference.def_id, args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    if (reference.variant is .coroutine_sync) {
        guard store.program.async_sync_function(reference.def_id, args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    if (reference.variant is .coroutine_resume(mode)) {
        guard store.program.coroutine_resume_item(reference.def_id, args)
            is .some(item) else { return null; }
        if (item is .source_resume_instance(resume)) {
            return jil.source_resume_mono_item(
                resume.identity, mode
            );
        }
        return item;
    }
    if (reference.variant is .coroutine_serial_completion) {
        guard store.program.serial_completion_function(reference.def_id, args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    if (reference.variant is .coroutine_completion) {
        guard store.program.coroutine_completion_function(reference.def_id, args)
            is .some(function_id) else { return null; }
        return jil.generated_function_mono_item(function_id);
    }
    return function_resolver.source(store, reference.def_id, args);
}

Void collect_codegen_function(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnitSet&! units,
    codegen_unit.CodegenUnitKey source_key,
    jil.MonoItem item,
    map.WyHashMap<Int, Int>&! visited,
    map.WyHashMap<symbol.BackendSymbolKey, Bool>&! assigned,
    list.ArrayList<jil.MonoItem>&! worklist
) {
    jil.Function function = codegen_unit.codegen_function(ctx, store, item);
    if (!codegen_unit.requires_demand_owner(function$.ref())) { return; }
    Int generation = source_key.module_index + 1;
    Int identity = jil.mono_item_identity(item);
    if (visited.get(identity) is .some(value) && value$.get() == generation) {
        return;
    }
    symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function$.ref());
    if (assigned.has(key)) {
        enqueue_function(item, generation, visited, worklist);
        return;
    }
    codegen_unit.CodegenUnitKey mono_key = codegen_unit.CodegenUnitKey(
        .monomorph_unit, source_key.package_index, source_key.module_index
    );
    Int unit_index = units.add_function(mono_key, item);
    units.mark_weak_monomorph_definitions(unit_index);
    assigned.set(key, true);
    enqueue_function(item, generation, visited, worklist);
}
