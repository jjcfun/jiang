// MIR -> LLVM C API lowering。
//
// 这里不再维护 backend 自己的 LLVM IR 中间层。LLVM module、type、
// value 和 builder 已经由 LLVM C API 表达；本层只负责把 MIR facts 映射
// 成必要的 LLVM calls。

import context = "../../context.jiang";
import diagnostic = "../../diagnostic/diagnostic.jiang";
import mir = "../../mir/mir.jiang";
import qid = "../../store/id.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import system_memory = "../../system/memory.jiang";
import backend_abi = "../abi.jiang";
import codegen_unit = "../codegen_unit.jiang";
import symbol = "../symbol.jiang";
import llvm_abi = "./abi.jiang";
import ffi = "./ffi.jiang";
import llvm_place = "./place.jiang";
import llvm_state = "./state.jiang";
import llvm_terminator = "./terminator.jiang";
import llvm_type = "./type.jiang";
import llvm_value = "./value.jiang";

public Bool lower_module(context.CompilerContext& ctx, mir.MirStore& store) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx, true, "default-target");
    return lowerer.lower_module(store);
}

public Bool emit_object_file(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx, link_libc, target_triple);
    return lowerer.emit_object_file(store, output_path, opt_level, pass_pipeline);
}

public Bool emit_object_unit_file(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    codegen_unit.CodegenUnit& unit,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx, link_libc, target_triple);
    return lowerer.emit_object_unit_file(store, unit, output_path, opt_level, pass_pipeline);
}

public Bool emit_llvm_ir_file(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx, link_libc, target_triple);
    return lowerer.emit_llvm_ir_file(store, output_path);
}

public UInt8[]&? emit_llvm_ir_text(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Bool link_libc,
    UInt8[]& target_triple
) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx, link_libc, target_triple);
    return lowerer.emit_llvm_ir_text(store);
}

struct LlvmLowerer: Movable {
    context.CompilerContext& ctx;
    ffi.Context llvm_context;
    ffi.Module module;
    ffi.Builder builder;
    table.HashTable<symbol.BackendSymbolKey, Int> declared_function_indexes;
    list.ArrayList<ffi.Value> declared_function_values;
    table.HashTable<qid.SymbolId, Int> declared_external_function_indexes;
    table.HashTable<qid.SymbolId, Int> external_function_indexes;
    list.ArrayList<ffi.Value> external_function_values;
    system_memory.RuntimeAllocator allocator;
    UInt8[]&! target_triple;

    init(context.CompilerContext& ctx, Bool link_libc, UInt8[]& target_triple) {
        self.ctx = ctx;
        self.llvm_context = ffi.Context();
        self.module = ffi.Module(self.llvm_context$.ref(), "jiang_module");
        self.target_triple = self.effective_target_triple(target_triple);
        ffi.module_set_target_text(self.module$.ref(), self.target_triple);
        if (!ffi.module_set_target_data_layout_text(self.module$.ref(), self.target_triple)) {
            self.add_codegen_error("failed to initialize LLVM target data layout", "llvm_target_data_layout_failed");
        }
        self.builder = ffi.Builder(self.llvm_context$.ref());
        self.declared_function_indexes = table.HashTable<symbol.BackendSymbolKey, Int>();
        self.declared_function_values = list.ArrayList<ffi.Value>();
        self.declared_external_function_indexes = table.HashTable<qid.SymbolId, Int>();
        self.external_function_indexes = table.HashTable<qid.SymbolId, Int>();
        self.external_function_values = list.ArrayList<ffi.Value>();
        self.allocator = system_memory.runtime_allocator(link_libc);
    }

    UInt8[]& effective_target_triple(UInt8[]& target_triple) {
        if (target_triple.length == 0 || string.equal(target_triple, "default-target")) {
            return ffi.default_target_triple_text();
        }
        return target_triple;
    }

    Bool lower_module(mir.MirStore& store) {
        Bool ok = self.lower_store(store);
        self.dispose();
        return ok;
    }

    Bool emit_object_file(mir.MirStore& store, UInt8[]& output_path, Int opt_level, UInt8[]& pass_pipeline) {
        Bool! ok = self.lower_store(store);
        if (ok) {
            ok = ffi.module_emit_object(self.module$.ref(), output_path, opt_level, pass_pipeline, self.target_triple);
        }
        self.dispose();
        return ok;
    }

    Bool emit_object_unit_file(
        mir.MirStore& store,
        codegen_unit.CodegenUnit& unit,
        UInt8[]& output_path,
        Int opt_level,
        UInt8[]& pass_pipeline
    ) {
        Bool! ok = self.lower_unit(store, unit);
        if (ok) {
            ok = ffi.module_emit_object(self.module$.ref(), output_path, opt_level, pass_pipeline, self.target_triple);
        }
        self.dispose();
        return ok;
    }

    Bool emit_llvm_ir_file(mir.MirStore& store, UInt8[]& output_path) {
        Bool! ok = self.lower_store(store);
        if (ok) {
            ok = ffi.module_emit_llvm_ir(self.module$.ref(), output_path);
            if (!ok) {
                self.add_codegen_error("LLVM failed to write IR file", "llvm_write_ir_failed");
            }
        } else {
            self.add_codegen_error("LLVM lowering failed before writing IR", "llvm_lowering_failed");
        }
        self.dispose();
        return ok;
    }

    UInt8[]&? emit_llvm_ir_text(mir.MirStore& store) {
        Bool! ok = self.lower_store(store);
        if (!ok) {
            self.add_codegen_error("LLVM lowering failed before writing IR", "llvm_lowering_failed");
            self.dispose();
            return null;
        }
        UInt8[]&? text = ffi.module_llvm_ir_text(self.module$.ref());
        if (text == null) {
            self.add_codegen_error("LLVM failed to print IR", "llvm_print_ir_failed");
        }
        self.dispose();
        return text;
    }

    Bool lower_unit(mir.MirStore& store, codegen_unit.CodegenUnit& unit) {
        if (!self.declare_store_functions(store)) {
            return false;
        }
        if (unit.key.kind == .source_unit) {
            return self.lower_source_unit(store, unit);
        }

        Int! index = 0;
        while (index < unit.functions.len()) {
            mir.MirFunction& function = store.functions.ref_at(unit.functions.get(index).to_index());
            if (function.is_external) {
                index = index + 1;
                continue;
            }
            if (!self.lower_function(function)) {
                self.add_function_codegen_error(
                    function,
                    "failed to lower LLVM function body",
                    "llvm_function_body_lower_failed"
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool lower_source_unit(mir.MirStore& store, codegen_unit.CodegenUnit& unit) {
        Int! index = 0;
        while (index < store.functions.len()) {
            mir.MirFunction& function = store.functions.ref_at(index);
            if (function.is_external) {
                index = index + 1;
                continue;
            }
            if (!self.source_unit_contains_function(unit, function)) {
                index = index + 1;
                continue;
            }
            if (!self.lower_function(function)) {
                self.add_function_codegen_error(
                    function,
                    "failed to lower LLVM function body",
                    "llvm_function_body_lower_failed"
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool source_unit_contains_function(codegen_unit.CodegenUnit& unit, mir.MirFunction& function) {
        if (function.type_args.length != 0) {
            return false;
        }
        symbol.BackendSymbolKey key = symbol.function_symbol_key(self.ctx, function);
        if (key.package_index != unit.key.package_index) {
            return false;
        }
        return key.module_index == unit.key.module_index;
    }

    Bool lower_store(mir.MirStore& store) {
        if (!self.declare_store_functions(store)) {
            return false;
        }

        Int! index = 0;
        while (index < store.functions.len()) {
            mir.MirFunction& function = store.functions.ref_at(index);
            if (function.is_external) {
                index = index + 1;
                continue;
            }
            Bool ok = self.lower_function(function);
            if (!ok) {
                self.add_function_codegen_error(
                    function,
                    "failed to lower LLVM function body",
                    "llvm_function_body_lower_failed"
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool declare_store_functions(mir.MirStore& store) {
        Bool! ok = ffi.context_valid(self.llvm_context$.ref())
            && ffi.module_valid(self.module$.ref())
            && ffi.builder_valid(self.builder$.ref());
        Int! index = 0;
        while (ok && index < store.functions.len()) {
            mir.MirFunction& function = store.functions.ref_at(index);
            ffi.Value llvm_function = self.declare_function(function);
            ok = ffi.value_valid(llvm_function);
            if (!ok) {
                self.add_function_codegen_error(
                    function,
                    "failed to declare LLVM function",
                    "llvm_function_declare_failed"
                );
            }
            index = index + 1;
        }
        return ok;
    }

    () dispose() {
        ffi.builder_dispose(self.builder$.ref());
        ffi.module_dispose(self.module$.ref());
        ffi.context_dispose(self.llvm_context$.ref());
    }

    ffi.Value declare_function(mir.MirFunction& function) {
        if (function.is_external) {
            return self.declare_external_function(function);
        }
        return self.declare_new_function(function);
    }

    ffi.Value declare_external_function(mir.MirFunction& function) {
        qid.SymbolId symbol_id = self.ctx.store.defs.get(function.def_id).name.symbol;
        if (
            table.hash_table_get_value<qid.SymbolId, Int>(
                self.declared_external_function_indexes$.ref(),
                symbol_id
            ) is some index
        ) {
            self.declared_function_indexes.set(symbol.function_symbol_key(self.ctx, function), index);
            return self.declared_function_values.get(index);
        }

        ffi.Value llvm_function = self.declare_new_function(function);
        if (ffi.value_valid(llvm_function)) {
            self.declared_external_function_indexes.set(symbol_id, self.declared_function_values.len() - 1);
        }
        return llvm_function;
    }

    ffi.Value declare_new_function(mir.MirFunction& function) {
        mir.MirBody& body = function.body$.ref();
        backend_abi.FunctionAbi! function_abi = backend_abi.classify_mir_body(self.ctx, body);
        llvm_state.LowerState! state = self.lower_state();
        ffi.Type function_type = llvm_abi.function_type(state$.ref(), function_abi$.ref());
        if (!ffi.type_valid(function_type)) {
            self.add_function_codegen_error(
                function,
                "failed to lower LLVM function ABI type",
                "llvm_function_abi_type_lower_failed"
            );
            return ffi.Value();
        }
        UInt8[]& name = symbol.function_symbol_name(self.ctx, function);
        ffi.Value llvm_function = ffi.module_add_function(self.module$.ref(), name, function_type);
        if (ffi.value_valid(llvm_function)) {
            llvm_abi.add_function_attributes(state$.ref(), llvm_function, function_abi$.ref());
            self.declared_function_indexes.set(
                symbol.function_symbol_key(self.ctx, function),
                self.declared_function_values.len()
            );
            self.declared_function_values.add(llvm_function);
        }
        return llvm_function;
    }

    Bool lower_function(
        mir.MirFunction& function
    ) {
        ffi.Value llvm_function = self.function_value(function);
        if (!ffi.value_valid(llvm_function)) {
            return false;
        }
        if (function.is_runtime_entry) {
            return self.lower_runtime_entry_function(function, llvm_function);
        }
        return self.lower_body(function.body$.ref(), llvm_function);
    }

    Bool lower_runtime_entry_function(mir.MirFunction& function, ffi.Value llvm_function) {
        llvm_state.LowerState! state = self.lower_state();
        if (!self.declare_process_argument_globals(state$.ref())) {
            return false;
        }
        ffi.BasicBlock block = ffi.context_append_block(self.llvm_context$.ref(), llvm_function, "entry");
        if (!ffi.block_valid(block)) {
            self.add_codegen_error("failed to create LLVM runtime entry block", "llvm_runtime_entry_block_failed");
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), block);
        ffi.Value argc = ffi.function_param(llvm_function, 0);
        ffi.Value argv = ffi.function_param(llvm_function, 1);
        if (!self.store_process_argument_globals(state$.ref(), argc, argv)) {
            return false;
        }
        return self.call_language_main_from_runtime_entry(state$.ref(), function);
    }

    Bool declare_process_argument_globals(llvm_state.LowerState& state) {
        ffi.Type int_type = llvm_type.lower_type(state, self.ctx.store.types.int_type());
        if (!ffi.type_valid(int_type)) {
            self.add_codegen_error("failed to lower runtime argc type", "llvm_runtime_argc_type_lower_failed");
            return false;
        }
        ffi.Value argc_global = self.runtime_global("__jiang_process_argc", int_type);
        if (!ffi.value_valid(argc_global)) {
            self.add_codegen_error("failed to declare runtime argc global", "llvm_runtime_argc_global_failed");
            return false;
        }
        ffi.global_set_initializer(argc_global, ffi.const_int(int_type, UInt64(0)));

        ffi.Type argv_type = ffi.context_pointer_type(self.llvm_context$.ref());
        ffi.Value argv_global = self.runtime_global("__jiang_process_argv", argv_type);
        if (!ffi.value_valid(argv_global)) {
            self.add_codegen_error("failed to declare runtime argv global", "llvm_runtime_argv_global_failed");
            return false;
        }
        ffi.global_set_initializer(argv_global, ffi.const_null(argv_type));
        return true;
    }

    Bool store_process_argument_globals(llvm_state.LowerState& state, ffi.Value argc, ffi.Value argv) {
        ffi.Type int_type = llvm_type.lower_type(state, self.ctx.store.types.int_type());
        ffi.Value argc_global = self.runtime_global("__jiang_process_argc", int_type);
        ffi.Type argv_type = ffi.context_pointer_type(self.llvm_context$.ref());
        ffi.Value argv_global = self.runtime_global("__jiang_process_argv", argv_type);
        if (!ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), argc, argc_global))) {
            self.add_codegen_error("failed to store runtime argc", "llvm_runtime_argc_store_failed");
            return false;
        }
        if (!ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), argv, argv_global))) {
            self.add_codegen_error("failed to store runtime argv", "llvm_runtime_argv_store_failed");
            return false;
        }
        return true;
    }

    ffi.Value runtime_global(UInt8[]& name, ffi.Type type) {
        ffi.Value existing = ffi.module_get_global(self.module$.ref(), name);
        if (ffi.value_valid(existing)) {
            return existing;
        }
        return ffi.module_add_global(self.module$.ref(), name, type);
    }

    Bool call_language_main_from_runtime_entry(llvm_state.LowerState& state, mir.MirFunction& runtime_function) {
        symbol.BackendSymbolKey main_key = symbol.symbol_key_for_def(
            self.ctx,
            runtime_function.def_id,
            runtime_function.type_args,
            false
        );
        guard table.hash_table_get_value<symbol.BackendSymbolKey, Int>(
            self.declared_function_indexes$.ref(),
            main_key
        ) is some main_index else {
            self.add_codegen_error("failed to find language main symbol", "llvm_language_main_missing");
            return false;
        }
        ffi.Value main_function = self.declared_function_values.get(main_index);
        qid.TypeId main_type = self.ctx.store.typeck.def_type(runtime_function.def_id)$.some();
        backend_abi.FunctionAbi main_abi = backend_abi.classify_function_type(self.ctx, main_type);
        ffi.Type main_function_type = llvm_abi.function_type(state, main_abi$.ref());
        list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(0);
        ffi.Value result = ffi.builder_build_call(self.builder$.ref(), main_function_type, main_function, args$.ref());
        qid.TypeId unit_type = self.ctx.store.types.unit_type();
        qid.TypeId result_type = self.language_main_result_type(main_type);
        if (result_type.to_index() == unit_type.to_index()) {
            ffi.Type int_type = llvm_type.lower_type(state, self.ctx.store.types.int_type());
            return ffi.value_valid(ffi.builder_build_return(self.builder$.ref(), ffi.const_int(int_type, UInt64(0))));
        }
        ffi.Value exit_code = self.runtime_exit_code_value(state, result, result_type);
        return ffi.value_valid(ffi.builder_build_return(self.builder$.ref(), exit_code));
    }

    ffi.Value runtime_exit_code_value(llvm_state.LowerState& state, ffi.Value result, qid.TypeId result_type) {
        qid.TypeId int_type_id = self.ctx.store.types.int_type();
        ffi.Type int_type = llvm_type.lower_type(state, int_type_id);
        if (result_type.to_index() == int_type_id.to_index()) {
            return result;
        }
        Int source_bits = llvm_type.int_type_bits(state, result_type);
        Int target_bits = llvm_type.int_type_bits(state, int_type_id);
        if (target_bits < source_bits) {
            return ffi.builder_build_cast(self.builder$.ref(), 1, result, int_type);
        }
        return ffi.builder_build_cast(self.builder$.ref(), 0, result, int_type);
    }

    qid.TypeId language_main_result_type(qid.TypeId main_type) {
        types.TypeInfo info = self.ctx.store.types.get(main_type);
        if (info.data is .function_type(function_type)) {
            return function_type.result;
        }
        return self.ctx.store.types.unit_type();
    }

    ffi.Value function_value(mir.MirFunction& function) {
        if (
            table.hash_table_get_value<symbol.BackendSymbolKey, Int>(
                self.declared_function_indexes$.ref(),
                symbol.function_symbol_key(self.ctx, function)
            ) is some index
        ) {
            return self.declared_function_values.get(index);
        }
        return ffi.Value();
    }

    Bool lower_body(
        mir.MirBody& body,
        ffi.Value llvm_function
    ) {
        if (body.blocks.length == 0) {
            return true;
        }
        list.ArrayList<ffi.BasicBlock>! blocks = self.create_basic_blocks(body, llvm_function);
        if (blocks.len() != body.blocks.length) {
            self.add_codegen_error("failed to create LLVM basic blocks", "llvm_block_create_failed");
            return false;
        }
        ffi.builder_position_at_end(self.builder$.ref(), blocks.get(body.entry.to_index()));
        list.ArrayList<ffi.Value>! local_slots = self.allocate_local_slots(body);
        if (local_slots.len() != body.locals.length) {
            self.add_codegen_error("failed to allocate LLVM local slots", "llvm_local_slot_alloc_failed");
            return false;
        }
        backend_abi.FunctionAbi! function_abi = backend_abi.classify_mir_body(self.ctx, body);
        if (!self.store_function_params(body, function_abi$.ref(), llvm_function, local_slots$.ref())) {
            self.add_codegen_error("failed to store LLVM function parameters", "llvm_param_store_failed");
            return false;
        }
        return self.lower_blocks(body, function_abi$.ref(), llvm_function, blocks$.ref(), local_slots$.ref());
    }

    list.ArrayList<ffi.BasicBlock> create_basic_blocks(mir.MirBody& body, ffi.Value llvm_function) {
        list.ArrayList<ffi.BasicBlock>! blocks = list.ArrayList<ffi.BasicBlock>(body.blocks.length);
        Int! index = 0;
        while (index < body.blocks.length) {
            ffi.BasicBlock block = ffi.context_append_block(
                self.llvm_context$.ref(),
                llvm_function,
                "bb"
            );
            if (!ffi.block_valid(block)) {
                return blocks$.move();
            }
            blocks.add(block);
            index = index + 1;
        }
        return blocks$.move();
    }

    Bool store_function_params(
        mir.MirBody& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int! llvm_index = 0;
        if (function_abi.result.is_indirect()) {
            llvm_index = 1;
        }
        Int! source_param_index = 0;
        Int! local_index = 0;
        while (local_index < body.locals.length) {
            mir.MirLocalDecl local = body.locals[local_index];
            if (local.kind == .param) {
                backend_abi.AbiArg param_abi = function_abi.params.get(source_param_index);
                if (param_abi.kind == .direct) {
                    ffi.Value param = ffi.function_param(llvm_function, llvm_index);
                    if (!self.store_local_value(local, local_slots, param)) { return false; }
                    llvm_index = llvm_index + 1;
                } else if (param_abi.kind == .indirect) {
                    ffi.Value param = ffi.function_param(llvm_function, llvm_index);
                    if (!self.store_indirect_param(local, local_slots, param)) { return false; }
                    llvm_index = llvm_index + 1;
                }
                source_param_index = source_param_index + 1;
            }
            local_index = local_index + 1;
        }
        return true;
    }

    Bool store_indirect_param(
        mir.MirLocalDecl local,
        list.ArrayList<ffi.Value>& local_slots,
        ffi.Value param_pointer
    ) {
        llvm_state.LowerState! state = self.lower_state();
        ffi.Value pointer = local_slots.get(local.id.to_index());
        if (!ffi.value_valid(pointer)) {
            return false;
        }
        // indirect 参数在 LLVM ABI 中已经是指针；本地 slot 需要拷贝参数指向的
        // 实际对象，不能先 load 成聚合值再 store。
        return self.copy_pointer_bytes(state$.ref(), param_pointer, pointer, local.type_id);
    }

    Bool store_local_value(
        mir.MirLocalDecl local,
        list.ArrayList<ffi.Value>& local_slots,
        ffi.Value value
    ) {
        if (!ffi.value_valid(value)) {
            return false;
        }
        ffi.Value pointer = local_slots.get(local.id.to_index());
        if (!ffi.value_valid(pointer)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), value, pointer));
    }

    list.ArrayList<ffi.Value> allocate_local_slots(mir.MirBody& body) {
        list.ArrayList<ffi.Value>! values = list.ArrayList<ffi.Value>(body.locals.length);
        Int! index = 0;
        while (index < body.locals.length) {
            ffi.Value slot = self.allocate_local_slot(body.locals[index]);
            if (!ffi.value_valid(slot)) {
                return values$.move();
            }
            values.add(slot);
            index = index + 1;
        }
        return values$.move();
    }

    ffi.Value allocate_local_slot(mir.MirLocalDecl local) {
        llvm_state.LowerState! state = self.lower_state();
        if (!llvm_type.type_has_abi_value(state$.ref(), local.type_id)) {
            return ffi.const_null(ffi.context_pointer_type(self.llvm_context$.ref()));
        }
        ffi.Type type = llvm_type.lower_type(state$.ref(), local.type_id);
        if (!ffi.type_valid(type)) {
            return ffi.Value();
        }
        return ffi.builder_build_alloca(self.builder$.ref(), type);
    }

    // MIR 是 place-based、非 SSA。LLVM lowering 的 baseline 先把 local
    // 映射为 stack slot，assignment 生成 store，operand 生成 load。
    Bool lower_statements(
        mir.MirBody& body,
        mir.MirBlock& block,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int! index = 0;
        while (index < block.statements.length) {
            if (!self.lower_statement(body, block.statements[index], local_slots)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool lower_blocks(
        mir.MirBody& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        list.ArrayList<ffi.BasicBlock>& blocks,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        Int! index = 0;
        while (index < body.blocks.length) {
            ffi.builder_position_at_end(self.builder$.ref(), blocks.get(index));
            if (!self.lower_statements(body, body.blocks[index]$.ref(), local_slots)) {
                return false;
            }
            if (!self.lower_terminator(body, function_abi, llvm_function, body.blocks[index].terminator$.ref(), blocks, local_slots)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool lower_statement(
        mir.MirBody& body,
        mir.MirStatement statement,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            if (!self.lower_assign(body, assign_stmt, local_slots)) {
                self.add_codegen_error("failed to lower LLVM assignment", "llvm_assign_lower_failed");
                return false;
            }
            return true;
        }
        if (statement.kind is .storage_live_stmt(_)) {
            return true;
        }
        if (statement.kind is .storage_dead_stmt(_)) {
            return true;
        }
        if (statement.kind is .set_discriminant_stmt(set_discriminant)) {
            llvm_state.LowerState! state = self.lower_state();
            return llvm_value.lower_set_discriminant(
                state$.ref(),
                body,
                set_discriminant,
                local_slots
            );
        }
        self.add_codegen_error("unsupported MIR statement in LLVM lowering", "llvm_statement_unsupported");
        return false;
    }

    Bool lower_assign(
        mir.MirBody& body,
        mir.MirAssignStatement assign_stmt,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        llvm_state.LowerState! state = self.lower_state();
        qid.TypeId result_type = llvm_place.place_type(state$.ref(), body, assign_stmt.destination);
        // 大 struct/union/optional 的赋值优先直接写入目标 place。这样可以保留
        // layout 计算出的真实字节布局，避免 LLVM aggregate value 在大 payload 上
        // 产生不可靠的按值 load/store。
        if (llvm_value.lower_optional_into_place(
                state$.ref(),
                body,
                assign_stmt.value,
                assign_stmt.destination,
                local_slots,
                result_type
            )
        ) {
            return true;
        }
        if (llvm_value.lower_aggregate_into_place(
                state$.ref(),
                body,
                assign_stmt.value,
                assign_stmt.destination,
                local_slots
            )
        ) {
            return true;
        }
        if (self.lower_place_copy_assign(state$.ref(), body, assign_stmt, result_type, local_slots)) {
            return true;
        }
        ffi.Value value = llvm_value.lower_rvalue(
            state$.ref(),
            body,
            assign_stmt.value,
            local_slots,
            result_type
        );
        if (!llvm_type.type_has_abi_value(state$.ref(), result_type)) {
            return true;
        }
        if (!ffi.value_valid(value)) {
            self.add_assign_rvalue_error(assign_stmt.value);
            return false;
        }
        ffi.Value pointer = llvm_place.lower_place_pointer(
            state$.ref(),
            body,
            assign_stmt.destination,
            local_slots
        );
        if (!ffi.value_valid(pointer)) {
            self.add_codegen_error("failed to lower LLVM assignment destination", "llvm_assign_place_lower_failed");
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(self.builder$.ref(), value, pointer));
    }

    Bool lower_place_copy_assign(
        llvm_state.LowerState& state,
        mir.MirBody& body,
        mir.MirAssignStatement assign_stmt,
        qid.TypeId result_type,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        if (!llvm_type.type_has_abi_value(state, result_type)) {
            return false;
        }
        guard assign_stmt.value is .use_value(use_value) else {
            return false;
        }
        if (use_value.value is .copy_operand(copy_operand)) {
            return self.copy_place_bytes(state, body, copy_operand.place, assign_stmt.destination, result_type, local_slots);
        }
        if (use_value.value is .move_operand(move_operand)) {
            return self.copy_place_bytes(state, body, move_operand.place, assign_stmt.destination, result_type, local_slots);
        }
        return false;
    }

    Bool copy_place_bytes(
        llvm_state.LowerState& state,
        mir.MirBody& body,
        mir.MirPlace source,
        mir.MirPlace destination,
        qid.TypeId type_id,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        // MIR 的 copy/move 语义是按值复制；backend 对大聚合用 memcpy 实现这层语义。
        ffi.Value source_pointer = llvm_place.lower_place_pointer(state, body, source, local_slots);
        if (!ffi.value_valid(source_pointer)) {
            return false;
        }
        ffi.Value destination_pointer = llvm_place.lower_place_pointer(state, body, destination, local_slots);
        if (!ffi.value_valid(destination_pointer)) {
            return false;
        }
        return self.copy_pointer_bytes(state, source_pointer, destination_pointer, type_id);
    }

    Bool copy_pointer_bytes(
        llvm_state.LowerState& state,
        ffi.Value source_pointer,
        ffi.Value destination_pointer,
        qid.TypeId type_id
    ) {
        ffi.Type size_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
        ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
        Int align = llvm_type.layout_align(state, type_id);
        return ffi.value_valid(ffi.builder_build_memcpy(
                self.builder$.ref(),
                destination_pointer,
                align,
                source_pointer,
                align,
                size
            )
        );
    }

    () add_assign_rvalue_error(mir.MirRvalue value) {
        if (value is .use_value(use_value)) {
            self.add_use_rvalue_error(use_value.value);
            return;
        }
        if (value is .binary_value(_)) {
            self.add_codegen_error("failed to lower LLVM binary rvalue", "llvm_binary_rvalue_lower_failed");
            return;
        }
        if (value is .cast_value(_)) {
            self.add_codegen_error("failed to lower LLVM cast rvalue", "llvm_cast_rvalue_lower_failed");
            return;
        }
        if (value is .aggregate_value(_)) {
            self.add_codegen_error("failed to lower LLVM aggregate rvalue", "llvm_aggregate_rvalue_lower_failed");
            return;
        }
        if (value is .optional_value(_)) {
            self.add_codegen_error("failed to lower LLVM optional rvalue", "llvm_optional_rvalue_lower_failed");
            return;
        }
        if (value is .error_union_value(_)) {
            self.add_codegen_error("failed to lower LLVM error union rvalue", "llvm_error_union_rvalue_lower_failed");
            return;
        }
        self.add_codegen_error("failed to lower LLVM assignment rvalue", "llvm_assign_rvalue_lower_failed");
    }

    () add_use_rvalue_error(mir.MirOperand operand) {
        if (operand is .const_operand(const_value)) {
            self.add_const_operand_error(const_value.value);
            return;
        }
        if (operand is .copy_operand(_)) {
            self.add_codegen_error("failed to lower LLVM copy operand", "llvm_copy_operand_lower_failed");
            return;
        }
        if (operand is .move_operand(_)) {
            self.add_codegen_error("failed to lower LLVM move operand", "llvm_move_operand_lower_failed");
            return;
        }
        if (operand is .function_operand(_)) {
            self.add_codegen_error("failed to lower LLVM function operand", "llvm_function_operand_lower_failed");
            return;
        }
        self.add_codegen_error("failed to lower LLVM use rvalue", "llvm_use_rvalue_lower_failed");
    }

    () add_const_operand_error(mir.MirConstValue value) {
        if (mir.string_const_value(value) is some _) {
            self.add_codegen_error("failed to lower LLVM string const", "llvm_string_const_lower_failed");
            return;
        }
        if (mir.int_const_value(value) is some _) {
            self.add_codegen_error("failed to lower LLVM int const", "llvm_int_const_lower_failed");
            return;
        }
        if (mir.is_null_const_value(value)) {
            self.add_codegen_error("failed to lower LLVM null const", "llvm_null_const_lower_failed");
            return;
        }
        self.add_codegen_error("failed to lower LLVM const operand", "llvm_const_operand_lower_failed");
    }

    Bool lower_terminator(
        mir.MirBody& body,
        backend_abi.FunctionAbi& function_abi,
        ffi.Value llvm_function,
        mir.MirTerminator& terminator,
        list.ArrayList<ffi.BasicBlock>& blocks,
        list.ArrayList<ffi.Value>& local_slots
    ) {
        llvm_state.LowerState! state = self.lower_state();
        return llvm_terminator.lower_terminator(
            state$.ref(),
            body,
            function_abi,
            llvm_function,
            terminator,
            blocks,
            local_slots
        );
    }

    llvm_state.LowerState lower_state() {
        return llvm_state.LowerState(
            self.ctx,
            self.llvm_context$.ref(),
            self.module$.ref(),
            self.builder$.ref(),
            self.declared_function_indexes$.ref(),
            self.declared_function_values$.ref(),
            self.external_function_indexes$.ref(),
            self.external_function_values$.ref(),
            self.allocator
        );
    }

    () add_codegen_error(UInt8[]& message, UInt8[]& code) {
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .codegen,
                diagnostic.DiagnosticCode(code),
                diagnostic.SourceRange(),
                message
            )
        );
    }

    () add_function_codegen_error(mir.MirFunction& function, UInt8[]& message, UInt8[]& code) {
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .codegen,
                diagnostic.DiagnosticCode(code),
                self.def_source_range(function.def_id),
                message
            )
        );
    }

    diagnostic.SourceRange def_source_range(qid.DefId def_id) {
        guard self.ctx.store.source_map.def_span(def_id) is some loc else {
            return diagnostic.SourceRange();
        }
        guard loc.source_id is some source_id else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, loc.span);
    }
}
