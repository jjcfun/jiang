// MIR -> LLVM C API lowering。
//
// 这里不再维护 backend 自己的 LLVM IR 中间层。LLVM module、type、
// value 和 builder 已经由 LLVM C API 表达；本层只负责把 MIR facts 映射
// 成必要的 LLVM calls。

import context = "../../context.jiang";
import layout_compute = "../../layout/compute.jiang";
import layout = "../../layout/layout.jiang";
import mir = "../../mir/mir.jiang";
import qid = "../../query/id.jiang";
import types = "../../sema/type.jiang";
import symbol = "../symbol.jiang";
import ffi = "./ffi.jiang";

public Bool lower_module(context.CompilerContext& ctx, mir.MirStore& store) {
    LlvmLowerer! lowerer = LlvmLowerer(ctx);
    return lowerer.lower_module(store);
}

struct LlvmLowerer {
    context.CompilerContext& ctx;
    ffi.Context context;
    ffi.Module module;
    ffi.Builder builder;

    init(context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.context = ffi.Context();
        self.module = ffi.Module(self.context$.ref(), "jiang_module");
        self.builder = ffi.Builder(self.context$.ref());
    }

    Bool lower_module(mir.MirStore& store) {
        Bool! ok = self.context.valid() && self.module.valid() && self.builder.valid();
        Int! index = 0;
        while (ok && index < store.functions.len()) {
            ok = self.declare_function(store.functions.get(index));
            index = index + 1;
        }
        self.dispose();
        return ok;
    }

    () dispose() {
        self.builder.dispose();
        self.module.dispose();
        self.context.dispose();
    }

    Bool declare_function(mir.MirFunction function) {
        mir.MirLocalDecl return_local = function.body.locals[function.body.return_local.to_index()];
        ffi.Type return_type = self.lower_type(return_local.type_id);
        if (!return_type.valid()) {
            return false;
        }
        ffi.Type function_type = ffi.function_type(return_type);
        if (!function_type.valid()) {
            return false;
        }
        UInt8[] name = symbol.function_symbol_name(function);
        return self.module.add_function(name$.as(UInt8[*]), function_type).valid();
    }

    ffi.Type lower_type(qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.query.types.get(type_id);
        if (info.data is .invalid) {
            return ffi.Type();
        }
        if (info.data is .never || info.data is .unit) {
            return self.context.void_type();
        }
        if (info.data is .bool_type) {
            return self.context.int_type(1);
        }
        if (info.data is .char_type) {
            return self.context.int_type(32);
        }
        if (info.data is .int_type(int_type)) {
            return self.lower_int_type(int_type);
        }
        if (info.data is .float_type(float_type)) {
            return self.lower_float_type(float_type);
        }
        if (info.data is .handle_type || info.data is .function_type) {
            return self.context.pointer_type();
        }
        return self.lower_layout_backed_type(type_id);
    }

    ffi.Type lower_int_type(types.IntType int_type) {
        Int! bits = int_type.bits;
        if (bits == 0) {
            bits = self.ctx.query.layouts.target.pointer_size * 8;
        }
        return self.context.int_type(bits);
    }

    ffi.Type lower_float_type(types.FloatType float_type) {
        if (float_type.bits == 32) {
            return self.context.float_type();
        }
        return self.context.double_type();
    }

    ffi.Type lower_layout_backed_type(qid.TypeId type_id) {
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.ctx, type_id);
        layout.TypeLayout type_layout = self.ctx.query.layouts.layout(layout_id);
        if (type_layout.kind == .invalid) {
            return ffi.Type();
        }
        return self.context.pointer_type();
    }
}
