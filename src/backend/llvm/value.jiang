// MIR operand/rvalue/const -> LLVM value lowering。
//
// 这里不处理 CFG terminator，只负责生成可被 statement/terminator 使用的 LLVM
// value。place projection 和 type/layout 规则分别委托给同目录 helper。

import mir = "../../mir/mir.jiang";
import diagnostic = "../../diagnostic/diagnostic.jiang";
import qid = "../../store/id.jiang";
import list = "../../support/list.jiang";
import symbol = "../symbol.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_state = "./state.jiang";
import llvm_place = "./place.jiang";
import llvm_type = "./type.jiang";

public qid.TypeId operand_type(llvm_state.LowerState& state, mir.MirBody body, mir.MirOperand operand) {
    if (operand is .const_operand(const_value)) {
        return const_value.type_id;
    }
    if (operand is .function_operand(function_value)) {
        return function_value.type_id;
    }
    if (operand is .global_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.place_type(state, body, copy_operand.place);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.place_type(state, body, move_operand.place);
    }
    return state.ctx.store.types.invalid_type();
}

public ffi.Value lower_rvalue(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value is .use_value(use_value)) {
        if (use_value.value is .const_operand(const_value)) {
            return lower_const_as_type(state, const_value, result_type);
        }
        return lower_operand(state, body, use_value.value, local_slots);
    }
    if (value is .unary_value(unary_value)) {
        return lower_unary(state, body, unary_value, local_slots, result_type);
    }
    if (value is .binary_value(binary_value)) {
        return lower_binary(state, body, binary_value, local_slots);
    }
    if (value is .cast_value(cast_value)) {
        return lower_cast(state, body, cast_value, local_slots);
    }
    if (value is .borrow_value(borrow_value)) {
        return llvm_place.lower_place_pointer(state, body, borrow_value.place, local_slots);
    }
    if (value is .address_of_value(address_of_value)) {
        return llvm_place.lower_place_pointer(state, body, address_of_value.place, local_slots);
    }
    if (value is .alloc_box_value(alloc_box_value)) {
        return lower_alloc_box(state, alloc_box_value, result_type);
    }
    if (value is .alloc_value(alloc_value)) {
        return lower_alloc_value(state, body, alloc_value, local_slots, result_type);
    }
    if (value is .alloc_array_value(alloc_array_value)) {
        return lower_alloc_array(state, body, alloc_array_value, local_slots, result_type);
    }
    if (value is .free_value(free_value)) {
        return lower_free(state, body, free_value, local_slots, result_type);
    }
    if (value is .slice_value(slice_value)) {
        return lower_slice(state, body, slice_value, local_slots, result_type);
    }
    if (value is .len_value(len_value)) {
        return lower_len(state, body, len_value, local_slots);
    }
    if (value is .discriminant_value(discriminant_value)) {
        return lower_discriminant(state, body, discriminant_value, local_slots);
    }
    if (value is .aggregate_value(aggregate_value)) {
        return lower_aggregate(state, body, aggregate_value, local_slots);
    }
    if (value is .optional_value(optional_value)) {
        return lower_optional(state, body, optional_value, local_slots, result_type);
    }
    if (value is .error_union_value(error_union_value)) {
        return lower_error_union(state, body, error_union_value, local_slots, result_type);
    }
    return ffi.Value();
}

public ffi.Value lower_operand(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand operand,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .const_operand(const_value)) {
        return lower_const(state, const_value);
    }
    if (operand is .function_operand(function_value)) {
        return function_value_for_ref(state, function_value);
    }
    if (operand is .global_operand(global_value)) {
        return global_value_for_ref(state, global_value);
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.lower_place_value(state, body, copy_operand.place, local_slots);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.lower_place_value(state, body, move_operand.place, local_slots);
    }
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, body, out_operand.place, local_slots);
    }
    return ffi.Value();
}

public Bool lower_aggregate_into_place(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirRvalue rvalue,
    mir.MirPlace destination,
    list.ArrayList<ffi.Value>& local_slots
) {
    guard rvalue is .aggregate_value(value) else {
        return false;
    }
    // 构造聚合值时直接写目标 slot，避免先构造一个 LLVM aggregate value。
    // union 的 payload 存在共享存储区，尤其不能依赖普通 struct extract/insert。
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(state, body, destination, local_slots);
    if (!ffi.value_valid(destination_pointer)) {
        return false;
    }
    if (value.kind != .union_variant) {
        return lower_plain_aggregate_into_pointer(state, body, value, destination_pointer, local_slots);
    }
    guard value.tag is some tag_operand else {
        return false;
    }
    ffi.Value tag = lower_operand(state, body, tag_operand, local_slots);
    if (!ffi.value_valid(tag)) {
        return false;
    }
    if (!store_layout_field(state, value.type_id, destination_pointer, 0, tag)) {
        return false;
    }
    if (value.fields.length == 0) {
        return true;
    }
    if (value.payload_field_index < 0) {
        return false;
    }
    qid.TypeId payload_type = llvm_type.constant_index_type(state, value.type_id, value.payload_field_index);
    if (value.fields.length != 1) {
        return lower_union_payload_fields_into_pointer(
            state,
            body,
            value,
            destination_pointer,
            payload_type,
            local_slots
        );
    }
    if (copy_operand_into_layout_field(
            state,
            body,
            value.fields[0],
            local_slots,
            value.type_id,
            destination_pointer,
            value.payload_field_index,
            payload_type
        )
    ) {
        return true;
    }
    ffi.Value payload = lower_operand(state, body, value.fields[0], local_slots);
    if (!ffi.value_valid(payload)) {
        return false;
    }
    return store_layout_field(state, value.type_id, destination_pointer, value.payload_field_index, payload);
}

Bool lower_union_payload_fields_into_pointer(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAggregateRvalue value,
    ffi.Value destination_pointer,
    qid.TypeId payload_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value payload_pointer = lower_payload_storage_field_pointer(
        state,
        value.type_id,
        destination_pointer,
        value.payload_field_index
    );
    if (!ffi.value_valid(payload_pointer)) {
        return false;
    }
    Int! index = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, payload_type, index);
        // 多字段 union payload 先定位到 payload storage，再按 payload struct 的
        // 字段布局逐个写入；大字段继续走 memcpy。
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        if (copy_operand_into_layout_field(
                state,
                body,
                value.fields[index],
                local_slots,
                payload_type,
                payload_pointer,
                index,
                field_type
            )
        ) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(state, body, value.fields[index], local_slots, field_type);
        if (!ffi.value_valid(field_value)) {
            return false;
        }
        if (!store_layout_field(state, payload_type, payload_pointer, index, field_value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public Bool lower_optional_into_place(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirRvalue rvalue,
    mir.MirPlace destination,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    guard rvalue is .optional_value(value) else {
        return false;
    }
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(state, body, destination, local_slots);
    if (!ffi.value_valid(destination_pointer)) {
        return false;
    }
    if (value.op == .make_some) {
        if (!store_layout_field(state, result_type, destination_pointer, 0, bool_value(state, true))) {
            return false;
        }
        qid.TypeId payload_type = llvm_type.element_type(state, result_type);
        if (copy_operand_into_layout_field(
                state,
                body,
                value.value,
                local_slots,
                result_type,
                destination_pointer,
                1,
                payload_type
            )
        ) {
            return true;
        }
        ffi.Value payload = lower_operand(state, body, value.value, local_slots);
        if (!ffi.value_valid(payload)) {
            return false;
        }
        return store_layout_field(state, result_type, destination_pointer, 1, payload);
    }
    if (value.op == .unwrap_some) {
        qid.TypeId source_type = operand_type(state, body, value.value);
        qid.TypeId payload_type = llvm_type.element_type(state, source_type);
        guard operand_place(value.value) is some source_place else {
            return false;
        }
        // optional 解包到 place 时直接复制 payload 字节，保证大 payload 不经过
        // LLVM aggregate value。
        ffi.Value source_pointer = llvm_place.lower_place_pointer(state, body, source_place, local_slots);
        if (!ffi.value_valid(source_pointer)) {
            return false;
        }
        ffi.Value payload_pointer = lower_payload_storage_field_pointer(state, source_type, source_pointer, 1);
        if (!ffi.value_valid(payload_pointer)) {
            return false;
        }
        return copy_pointer_bytes(state, payload_pointer, destination_pointer, payload_type);
    }
    if (value.op == .make_none) {
        ffi.Value zero = zero_aggregate(state, result_type);
        if (!ffi.value_valid(zero)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(state.builder, zero, destination_pointer));
    }
    return false;
}

Bool lower_plain_aggregate_into_pointer(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAggregateRvalue value,
    ffi.Value destination_pointer,
    list.ArrayList<ffi.Value>& local_slots
) {
    Int! index = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, value.type_id, index);
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        if (copy_operand_into_layout_field(
                state,
                body,
                value.fields[index],
                local_slots,
                value.type_id,
                destination_pointer,
                index,
                field_type
            )
        ) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(state, body, value.fields[index], local_slots, field_type);
        if (!ffi.value_valid(field_value)) {
            return false;
        }
        if (!store_layout_field(state, value.type_id, destination_pointer, index, field_value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool copy_operand_into_layout_field(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand operand,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId owner_type,
    ffi.Value destination_pointer,
    Int field_index,
    qid.TypeId field_type
) {
    if (!type_should_copy_bytes(state, field_type)) {
        return false;
    }
    guard operand_place(operand) is some source_place else {
        return false;
    }
    // 只有源值仍能追溯到 MIR place 时才能 memcpy；常量和计算结果仍回退到
    // 普通 value lowering。
    ffi.Value source_pointer = llvm_place.lower_place_pointer(state, body, source_place, local_slots);
    if (!ffi.value_valid(source_pointer)) {
        return false;
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, owner_type, destination_pointer, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return false;
    }
    return copy_pointer_bytes(state, source_pointer, field_pointer, field_type);
}

mir.MirPlace? operand_place(mir.MirOperand operand) {
    if (operand is .copy_operand(copy_operand)) {
        return copy_operand.place;
    }
    if (operand is .move_operand(move_operand)) {
        return move_operand.place;
    }
    return null;
}

Bool type_should_copy_bytes(llvm_state.LowerState& state, qid.TypeId type_id) {
    if (!llvm_type.type_has_abi_value(state, type_id)) {
        return false;
    }
    return llvm_type.layout_size(state, type_id) > state.ctx.store.layouts.target.pointer_size * 2;
}

Bool copy_pointer_bytes(
    llvm_state.LowerState& state,
    ffi.Value source_pointer,
    ffi.Value destination_pointer,
    qid.TypeId type_id
) {
    ffi.Type size_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
    ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    Int align = llvm_type.layout_align(state, type_id);
    return ffi.value_valid(ffi.builder_build_memcpy(
            state.builder,
            destination_pointer,
            align,
            source_pointer,
            align,
            size
        )
    );
}

public ffi.Value global_value_for_ref(llvm_state.LowerState& state, mir.MirGlobalRef value) {
    ffi.Type value_type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    ffi.Value global = declare_global(state, value.global_def, value_type);
    if (!ffi.value_valid(global)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder, value_type, global);
}

ffi.Value declare_global(llvm_state.LowerState& state, qid.DefId global_def, ffi.Type value_type) {
    UInt8[] name = symbol.global_symbol_name(state.ctx, global_def);
    CString raw_name = name$.as(UInt8[*])$.as(CString);
    ffi.Value existing = ffi.module_get_global(state.module, raw_name);
    if (ffi.value_valid(existing)) {
        return existing;
    }
    return ffi.module_add_global(state.module, raw_name, value_type);
}

public ffi.Value lower_operand_as_type(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand operand,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (operand is .const_operand(const_value)) {
        return lower_const_as_type(state, const_value, result_type);
    }
    return lower_operand(state, body, operand, local_slots);
}

public ffi.Value lower_const(llvm_state.LowerState& state, mir.MirConst value) {
    return lower_const_as_type(state, value, value.type_id);
}

public ffi.Value lower_const_as_type(llvm_state.LowerState& state, mir.MirConst value, qid.TypeId result_type) {
    mir.MirConstValue const_value = value.value;
    if (mir.string_const_value(const_value) is some string_value) {
        return lower_string_const(state, string_value, result_type);
    }
    if (mir.is_null_const_value(const_value)) {
        return lower_null_const(state, result_type);
    }
    ffi.Type value_type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    if (mir.int_const_value(const_value) is some int_value) {
        return ffi.const_int(value_type, int_value.bits);
    }
    if (mir.float_const_value(const_value) is some float_value) {
        return ffi.const_real(value_type, float_value.value);
    }
    if (mir.bool_const_value(const_value) is some bool_value) {
        return bool_const(state, value_type, bool_value.value);
    }
    if (mir.is_unit_const_value(const_value)) {
        return ffi.Value();
    }
    return ffi.Value();
}

ffi.Value lower_null_const(llvm_state.LowerState& state, qid.TypeId result_type) {
    ffi.Type value_type = llvm_type.lower_type(state, result_type);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    return ffi.const_null(value_type);
}

ffi.Value lower_string_const(
    llvm_state.LowerState& state,
    mir.MirStringConst value,
    qid.TypeId result_type
) {
    UInt8[] text = state.ctx.store.symbols.text(value.symbol_id);
    UInt8![*] c_text = null_terminated_bytes(text);
    ffi.Value data = ffi.builder_build_global_string_ptr(state.builder, c_text$.as(UInt8[*])$.as(CString));
    if (!ffi.value_valid(data)) {
        add_value_codegen_error(state, "failed to build LLVM global string", "llvm_global_string_lower_failed");
        return ffi.Value();
    }
    if (value.nul_terminated) {
        return data;
    }
    if (!llvm_type.type_is_slice(state, result_type)) {
        return data;
    }
    ffi.Value! aggregate = zero_aggregate(state, result_type);
    aggregate = insert_layout_field(state, result_type, aggregate, 0, data);
    if (!ffi.value_valid(aggregate)) {
        add_value_codegen_error(
            state,
            "failed to store string data in LLVM slice",
            "llvm_string_slice_data_lower_failed"
        );
        return ffi.Value();
    }
    ffi.Type int_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
    ffi.Value length = insert_layout_field(
        state,
        result_type,
        aggregate,
        1,
        ffi.const_int(int_type, UInt64(text.length))
    );
    if (!ffi.value_valid(length)) {
        add_value_codegen_error(
            state,
            "failed to store string length in LLVM slice",
            "llvm_string_slice_length_lower_failed"
        );
    }
    return length;
}

UInt8![*] null_terminated_bytes(UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}

() add_value_codegen_error(llvm_state.LowerState& state, UInt8[] message, UInt8[] code) {
    state.ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

ffi.Value bool_const(llvm_state.LowerState& state, ffi.Type value_type, Bool value) {
    if (value) {
        return ffi.const_int(value_type, 1);
    }
    return ffi.const_int(value_type, 0);
}

ffi.Value lower_alloc_value(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAllocValueRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value initialized = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(initialized)) {
        return ffi.Value();
    }
    ffi.Value raw = malloc_bytes_for_type(state, value.value_type);
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    ffi.Value pointer = ffi.builder_build_cast(state.builder, 6, raw, llvm_type.lower_type(state, result_type));
    if (!ffi.value_valid(pointer)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder, initialized, pointer))) {
        return ffi.Value();
    }
    return pointer;
}

ffi.Value lower_alloc_box(
    llvm_state.LowerState& state,
    mir.MirAllocBoxRvalue value,
    qid.TypeId result_type
) {
    ffi.Value raw = malloc_bytes_for_type(state, value.value_type);
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    return ffi.builder_build_cast(state.builder, 6, raw, llvm_type.lower_type(state, result_type));
}

ffi.Value lower_alloc_array(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAllocArrayRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value count = lower_operand(state, body, value.count, local_slots);
    if (!ffi.value_valid(count)) {
        return ffi.Value();
    }
    ffi.Type int_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
    ffi.Value element_size = ffi.const_int(int_type, UInt64(llvm_type.layout_size(state, value.element_type)));
    ffi.Value bytes = ffi.builder_build_binary(state.builder, 2, count, element_size);
    if (!ffi.value_valid(bytes)) {
        return ffi.Value();
    }
    ffi.Value malloc_fn = declare_malloc(state);
    if (!ffi.value_valid(malloc_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type>! param_types = list.ArrayList<ffi.Type>(1);
    param_types.add(int_type);
    ffi.Type malloc_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context), param_types$.ref());
    list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(1);
    args.add(bytes);
    ffi.Value raw = ffi.builder_build_call(state.builder, malloc_type, malloc_fn, args$.ref());
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    return ffi.builder_build_cast(state.builder, 6, raw, llvm_type.lower_type(state, result_type));
}

ffi.Value malloc_bytes_for_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type int_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
    ffi.Value bytes = ffi.const_int(int_type, UInt64(llvm_type.layout_size(state, type_id)));
    ffi.Value malloc_fn = declare_malloc(state);
    if (!ffi.value_valid(malloc_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type>! param_types = list.ArrayList<ffi.Type>(1);
    param_types.add(int_type);
    ffi.Type malloc_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context), param_types$.ref());
    list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(1);
    args.add(bytes);
    return ffi.builder_build_call(state.builder, malloc_type, malloc_fn, args$.ref());
}

ffi.Value lower_free(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirFreeRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value pointer = lower_operand(state, body, value.pointer, local_slots);
    if (!ffi.value_valid(pointer)) {
        return ffi.Value();
    }
    ffi.Value free_fn = declare_free(state);
    if (!ffi.value_valid(free_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type>! param_types = list.ArrayList<ffi.Type>(1);
    param_types.add(ffi.context_pointer_type(state.llvm_context));
    ffi.Type free_type = ffi.function_type(ffi.context_void_type(state.llvm_context), param_types$.ref());
    list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(1);
    args.add(pointer);
    return ffi.builder_build_call(state.builder, free_type, free_fn, args$.ref());
}

ffi.Value declare_malloc(llvm_state.LowerState& state) {
    qid.SymbolId symbol_id = state.ctx.store.symbols.intern("malloc");
    if (table.hash_table_get_value<qid.SymbolId, Int>(state.external_function_indexes, symbol_id) is some existing) {
        return state.external_function_values.get(existing);
    }
    list.ArrayList<ffi.Type>! params = list.ArrayList<ffi.Type>(1);
    params.add(ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8));
    ffi.Type fn_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context), params$.ref());
    ffi.Value function = ffi.module_add_function(state.module, "malloc", fn_type);
    if (ffi.value_valid(function)) {
        state.external_function_indexes.set(symbol_id, state.external_function_values.len());
        state.external_function_values.add(function);
    }
    return function;
}

ffi.Value declare_free(llvm_state.LowerState& state) {
    qid.SymbolId symbol_id = state.ctx.store.symbols.intern("free");
    if (table.hash_table_get_value<qid.SymbolId, Int>(state.external_function_indexes, symbol_id) is some existing) {
        return state.external_function_values.get(existing);
    }
    list.ArrayList<ffi.Type>! params = list.ArrayList<ffi.Type>(1);
    params.add(ffi.context_pointer_type(state.llvm_context));
    ffi.Type fn_type = ffi.function_type(ffi.context_void_type(state.llvm_context), params$.ref());
    ffi.Value function = ffi.module_add_function(state.module, "free", fn_type);
    if (ffi.value_valid(function)) {
        state.external_function_indexes.set(symbol_id, state.external_function_values.len());
        state.external_function_values.add(function);
    }
    return function;
}

ffi.Value lower_slice(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirSliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    qid.TypeId base_type = llvm_place.place_type(state, body, value.base);
    ffi.Value data_pointer = lower_slice_data_pointer(state, body, value, local_slots, base_type);
    ffi.Value start = lower_optional_bound_or_zero(state, body, value.start, local_slots);
    ffi.Value end = lower_slice_end(state, body, value, local_slots, base_type);
    if (!ffi.value_valid(data_pointer) || !ffi.value_valid(start) || !ffi.value_valid(end)) {
        return ffi.Value();
    }
    ffi.Value shifted_data = lower_slice_shifted_data(state, data_pointer, result_type, start);
    ffi.Value length = ffi.builder_build_binary(state.builder, 1, end, start);
    if (!ffi.value_valid(shifted_data) || !ffi.value_valid(length)) {
        return ffi.Value();
    }
    ffi.Value! aggregate = zero_aggregate(state, result_type);
    aggregate = insert_layout_field(state, result_type, aggregate, 0, shifted_data);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, 1, length);
}

ffi.Value lower_slice_data_pointer(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirSliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId base_type
) {
    if (llvm_type.type_is_slice(state, base_type)) {
        ffi.Value aggregate = llvm_place.lower_place_value(state, body, value.base, local_slots);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        return extract_layout_field(state, base_type, aggregate, 0);
    }
    if (llvm_type.type_is_handle(state, base_type)) {
        return llvm_place.lower_place_value(state, body, value.base, local_slots);
    }
    return llvm_place.lower_place_pointer(state, body, value.base, local_slots);
}

ffi.Value lower_optional_bound_or_zero(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand? bound,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (bound is some operand) {
        return lower_operand(state, body, operand, local_slots);
    }
    return ffi.const_int(ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8), 0);
}

ffi.Value lower_slice_end(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirSliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId base_type
) {
    if (value.end is some end) {
        return lower_operand(state, body, end, local_slots);
    }
    if (!llvm_type.type_is_slice(state, base_type)) {
        return ffi.Value();
    }
    ffi.Value aggregate = llvm_place.lower_place_value(state, body, value.base, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return extract_layout_field(state, base_type, aggregate, 1);
}

ffi.Value lower_slice_shifted_data(
    llvm_state.LowerState& state,
    ffi.Value data_pointer,
    qid.TypeId slice_type,
    ffi.Value start
) {
    qid.TypeId element_type = llvm_type.element_type(state, slice_type);
    ffi.Type element_llvm_type = llvm_type.lower_type(state, element_type);
    if (!ffi.type_valid(element_llvm_type)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Value>! indices = list.ArrayList<ffi.Value>(1);
    indices.add(start);
    return ffi.builder_build_gep(state.builder, element_llvm_type, data_pointer, indices$.ref());
}

ffi.Value lower_len(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirLenRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, value.place);
    Int array_count = llvm_type.array_count(state, place_type_id);
    if (array_count >= 0) {
        return ffi.const_int(ffi.context_int_type(state.llvm_context, 64), UInt64(array_count));
    }
    if (!llvm_type.type_is_slice(state, place_type_id)) {
        return ffi.Value();
    }
    ffi.Value aggregate = llvm_place.lower_place_value(state, body, value.place, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return extract_layout_field(state, place_type_id, aggregate, 1);
}

ffi.Value lower_discriminant(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirDiscriminantRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, value.place);
    if (llvm_type.layout_field_count(state, place_type_id) == 0) {
        return llvm_place.lower_place_value(state, body, value.place, local_slots);
    }
    ffi.Value place_pointer = llvm_place.lower_place_pointer(state, body, value.place, local_slots);
    if (!ffi.value_valid(place_pointer)) {
        return ffi.Value();
    }
    ffi.Value tag_pointer = lower_payload_storage_field_pointer(state, place_type_id, place_pointer, 0);
    if (!ffi.value_valid(tag_pointer)) {
        return ffi.Value();
    }
    ffi.Type tag_type = llvm_type.lower_type(state, llvm_type.constant_index_type(state, place_type_id, 0));
    if (!ffi.type_valid(tag_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder, tag_type, tag_pointer);
}

public Bool lower_set_discriminant(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirSetDiscriminantStatement statement,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, statement.destination);
    if (llvm_type.layout_field_count(state, place_type_id) == 0) {
        return true;
    }
    ffi.Value! aggregate = llvm_place.lower_place_value(state, body, statement.destination, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return false;
    }
    ffi.Value tag = llvm_discriminant_value(state, statement.discriminant);
    aggregate = insert_layout_field(state, place_type_id, aggregate, 0, tag);
    if (!ffi.value_valid(aggregate)) {
        return false;
    }
    ffi.Value pointer = llvm_place.lower_place_pointer(state, body, statement.destination, local_slots);
    if (!ffi.value_valid(pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder, aggregate, pointer));
}

ffi.Value llvm_discriminant_value(llvm_state.LowerState& state, Int discriminant) {
    ffi.Type tag_type = llvm_type.lower_type(state, state.ctx.store.types.int_type());
    if (!ffi.type_valid(tag_type)) {
        return ffi.Value();
    }
    return ffi.const_int(tag_type, UInt64(discriminant));
}

ffi.Value lower_aggregate(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAggregateRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (value.kind == .union_variant) {
        return lower_union_variant_aggregate(state, body, value, local_slots);
    }
    ffi.Type type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    ffi.Value! aggregate = ffi.const_null(type);
    Int! index = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, value.type_id, index);
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(state, body, value.fields[index], local_slots, field_type);
        if (!ffi.value_valid(field_value)) {
            return ffi.Value();
        }
        aggregate = insert_layout_field(state, value.type_id, aggregate, index, field_value);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        index = index + 1;
    }
    return aggregate;
}

ffi.Value lower_union_variant_aggregate(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirAggregateRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value! aggregate = zero_aggregate(state, value.type_id);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }

    guard value.tag is some tag_operand else {
        return ffi.Value();
    }
    ffi.Value tag = lower_operand(state, body, tag_operand, local_slots);
    if (!ffi.value_valid(tag)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, value.type_id, aggregate, 0, tag);
    if (!ffi.value_valid(aggregate) || value.fields.length == 0) {
        return aggregate;
    }
    if (value.fields.length != 1) {
        return ffi.Value();
    }
    if (value.payload_field_index < 0) {
        return ffi.Value();
    }
    ffi.Value payload = lower_operand(state, body, value.fields[0], local_slots);
    return insert_layout_field(state, value.type_id, aggregate, value.payload_field_index, payload);
}

ffi.Value lower_optional(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOptionalRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value.op == .make_none) {
        return zero_aggregate(state, result_type);
    }
    if (value.op == .make_some) {
        return lower_make_some(state, body, value, local_slots, result_type);
    }
    qid.TypeId value_type = operand_type(state, body, value.value);
    if (operand_place(value.value) is some source_place) {
        ffi.Value source_pointer = llvm_place.lower_place_pointer(state, body, source_place, local_slots);
        if (!ffi.value_valid(source_pointer)) {
            return ffi.Value();
        }
        if (value.op == .is_some) {
            return load_layout_field(state, value_type, source_pointer, 0);
        }
        if (value.op == .unwrap_some) {
            qid.TypeId payload_type = llvm_type.element_type(state, value_type);
            if (type_should_copy_bytes(state, payload_type)) {
                add_value_codegen_error(state, "large optional payload must lower into a place", "llvm_optional_large_payload_value_lower_failed");
                return ffi.Value();
            }
            return load_layout_field(state, value_type, source_pointer, 1);
        }
    }
    ffi.Value aggregate = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate)) {
        add_value_codegen_error(state, "failed to lower LLVM optional operand", "llvm_optional_operand_lower_failed");
        return ffi.Value();
    }
    if (value.op == .is_some) {
        ffi.Value result = extract_layout_field(state, value_type, aggregate, 0);
        if (!ffi.value_valid(result)) {
            add_value_codegen_error(state, "failed to extract LLVM optional tag", "llvm_optional_tag_lower_failed");
        }
        return result;
    }
    if (value.op == .unwrap_some) {
        qid.TypeId payload_type = llvm_type.element_type(state, value_type);
        if (!llvm_type.type_has_abi_value(state, payload_type)) {
            return ffi.const_null(ffi.context_pointer_type(state.llvm_context));
        }
        ffi.Value result = extract_layout_field(state, value_type, aggregate, 1);
        if (!ffi.value_valid(result)) {
            add_value_codegen_error(
                state,
                "failed to extract LLVM optional payload",
                "llvm_optional_payload_lower_failed"
            );
        }
        return result;
    }
    return ffi.Value();
}

ffi.Value lower_make_some(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOptionalRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value! aggregate = zero_aggregate(state, result_type);
    ffi.Value payload = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate) || !ffi.value_valid(payload)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, result_type, aggregate, 0, bool_value(state, true));
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, 1, payload);
}

ffi.Value lower_error_union(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirErrorUnionRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value.op == .make_value) {
        return lower_make_error_union(state, body, value, local_slots, result_type, false, 1);
    }
    if (value.op == .make_error) {
        return lower_make_error_union(state, body, value, local_slots, result_type, true, 2);
    }
    ffi.Value aggregate = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    qid.TypeId source_type = operand_type(state, body, value.value);
    if (value.op == .is_error) {
        return extract_layout_field(state, source_type, aggregate, 0);
    }
    if (value.op == .unwrap_value) {
        return extract_layout_field(state, source_type, aggregate, 1);
    }
    if (value.op == .unwrap_error) {
        return extract_layout_field(state, source_type, aggregate, 2);
    }
    return ffi.Value();
}

ffi.Value lower_make_error_union(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirErrorUnionRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type,
    Bool is_error,
    Int payload_field
) {
    ffi.Value! aggregate = zero_aggregate(state, result_type);
    ffi.Value payload = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate) || !ffi.value_valid(payload)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, result_type, aggregate, 0, bool_value(state, is_error));
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, payload_field, payload);
}

ffi.Value lower_cast(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirCastRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value operand = lower_operand(state, body, value.value, local_slots);
    ffi.Type target_type = llvm_type.lower_type(state, value.target_type);
    if (!ffi.value_valid(operand) || !ffi.type_valid(target_type)) {
        return ffi.Value();
    }
    if (value.kind == .int_to_int) {
        return lower_int_cast(state, body, value.value, operand, target_type, value.target_type);
    }
    if (value.kind == .int_to_float) {
        return ffi.builder_build_cast(state.builder, 2, operand, target_type);
    }
    if (value.kind == .float_to_int) {
        return ffi.builder_build_cast(state.builder, 3, operand, target_type);
    }
    if (value.kind == .float_to_float) {
        return lower_float_cast(state, body, value.value, operand, target_type, value.target_type);
    }
    if (value.kind == .ptr_to_ptr) {
        return ffi.builder_build_cast(state.builder, 6, operand, target_type);
    }
    if (value.kind == .ptr_to_int) {
        return ffi.builder_build_cast(state.builder, 7, operand, target_type);
    }
    if (value.kind == .int_to_ptr) {
        return ffi.builder_build_cast(state.builder, 8, operand, target_type);
    }
    if (value.kind == .bitcast) {
        return ffi.builder_build_cast(state.builder, 9, operand, target_type);
    }
    return ffi.Value();
}

ffi.Value lower_int_cast(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand operand,
    ffi.Value value,
    ffi.Type target_type,
    qid.TypeId target_type_id
) {
    Int source_bits = llvm_type.int_type_bits(state, operand_type(state, body, operand));
    Int target_bits = llvm_type.int_type_bits(state, target_type_id);
    if (target_bits < source_bits) {
        return ffi.builder_build_cast(state.builder, 1, value, target_type);
    }
    return ffi.builder_build_cast(state.builder, 0, value, target_type);
}

ffi.Value lower_float_cast(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirOperand operand,
    ffi.Value value,
    ffi.Type target_type,
    qid.TypeId target_type_id
) {
    Int source_bits = llvm_type.float_type_bits(state, operand_type(state, body, operand));
    Int target_bits = llvm_type.float_type_bits(state, target_type_id);
    if (target_bits < source_bits) {
        return ffi.builder_build_cast(state.builder, 5, value, target_type);
    }
    return ffi.builder_build_cast(state.builder, 4, value, target_type);
}

ffi.Value lower_unary(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirUnaryRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value operand = lower_operand(state, body, value.value, local_slots);
    if (!ffi.value_valid(operand)) {
        return ffi.Value();
    }
    if (value.op == .logic_not) {
        return lower_int_compare(state, 32, operand, zero_value(state, result_type));
    }
    if (value.op == .bit_not) {
        return ffi.builder_build_binary(state.builder, 7, operand, all_ones_value(state, result_type));
    }
    if (value.op == .neg) {
        return ffi.builder_build_binary(state.builder, 1, zero_value(state, result_type), operand);
    }
    return ffi.Value();
}

ffi.Value lower_binary(
    llvm_state.LowerState& state,
    mir.MirBody body,
    mir.MirBinaryRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId lhs_type = operand_type(state, body, value.lhs);
    qid.TypeId rhs_type = operand_type(state, body, value.rhs);
    qid.TypeId compare_type = binary_compare_type(state, lhs_type, rhs_type);
    ffi.Value lhs = lower_operand_as_type(state, body, value.lhs, local_slots, compare_type);
    ffi.Value rhs = lower_operand_as_type(state, body, value.rhs, local_slots, compare_type);
    if (!ffi.value_valid(lhs) || !ffi.value_valid(rhs)) {
        return ffi.Value();
    }
    if (value.op == .eq || value.op == .ne) {
        guard int_predicate(state, value.op) is some predicate else {
            return ffi.Value();
        }
        return lower_int_compare(state, predicate, lhs, rhs);
    }
    if (binary_op_code(state, value.op, compare_type) is some op) {
        return ffi.builder_build_binary(state.builder, op, lhs, rhs);
    }
    if (int_predicate_for_type(state, value.op, compare_type) is some predicate) {
        return lower_int_compare(state, predicate, lhs, rhs);
    }
    return ffi.Value();
}

qid.TypeId binary_compare_type(llvm_state.LowerState& state, qid.TypeId lhs_type, qid.TypeId rhs_type) {
    if (type_id_valid(lhs_type)) { return lhs_type; }
    if (type_id_valid(rhs_type)) { return rhs_type; }
    return state.ctx.store.types.invalid_type();
}

Bool type_id_valid(qid.TypeId type_id) {
    return type_id.to_index() >= 0;
}

ffi.Value lower_int_compare(llvm_state.LowerState& state, Int32 predicate, ffi.Value lhs, ffi.Value rhs) {
    return ffi.builder_build_icmp(state.builder, predicate, lhs, rhs);
}

Int? binary_op_code(llvm_state.LowerState& state, mir.MirBinaryOp op, qid.TypeId operand_type) {
    if (op == .add) { return 0; }
    if (op == .sub) { return 1; }
    if (op == .mul) { return 2; }
    if (op == .div) {
        if (integer_type_is_unsigned(state, operand_type)) { return 10; }
        return 3;
    }
    if (op == .rem) {
        if (integer_type_is_unsigned(state, operand_type)) { return 11; }
        return 4;
    }
    if (op == .bit_and) { return 5; }
    if (op == .bit_or) { return 6; }
    if (op == .bit_xor) { return 7; }
    if (op == .shl) { return 8; }
    if (op == .shr) {
        if (integer_type_is_unsigned(state, operand_type)) { return 12; }
        return 9;
    }
    return null;
}

Int32? int_predicate_for_type(llvm_state.LowerState& state, mir.MirBinaryOp op, qid.TypeId operand_type) {
    if (integer_type_is_unsigned(state, operand_type)) {
        return unsigned_int_predicate(state, op);
    }
    return int_predicate(state, op);
}

Int32? int_predicate(llvm_state.LowerState& state, mir.MirBinaryOp op) {
    if (op == .eq) { return Int32(32); }
    if (op == .ne) { return Int32(33); }
    if (op == .gt) { return Int32(38); }
    if (op == .ge) { return Int32(39); }
    if (op == .lt) { return Int32(40); }
    if (op == .le) { return Int32(41); }
    return null;
}

Int32? unsigned_int_predicate(llvm_state.LowerState& state, mir.MirBinaryOp op) {
    if (op == .eq) { return Int32(32); }
    if (op == .ne) { return Int32(33); }
    if (op == .gt) { return Int32(34); }
    if (op == .ge) { return Int32(35); }
    if (op == .lt) { return Int32(36); }
    if (op == .le) { return Int32(37); }
    return null;
}

Bool integer_type_is_unsigned(llvm_state.LowerState& state, qid.TypeId type_id) {
    // MIR 的 binary op 不编码 signedness；LLVM 指令选择必须回看 semantic type。
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .int_type(int_type) else { return false; }
    return !int_type.signed;
}

ffi.Value zero_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_int(type, 0);
}

ffi.Value all_ones_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_int(type, 18446744073709551615);
}

ffi.Value bool_value(llvm_state.LowerState& state, Bool value) {
    if (value) {
        return ffi.const_int(ffi.context_int_type(state.llvm_context, 1), 1);
    }
    return ffi.const_int(ffi.context_int_type(state.llvm_context, 1), 0);
}

ffi.Value zero_aggregate(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_null(type);
}

ffi.Value insert_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index,
    ffi.Value field_value
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    // 重叠 payload 不能用 insertvalue 直接写入；先落到临时 storage，
    // 再把具体 payload type store 到 payload byte 区起点。
    if (llvm_type.layout_field_uses_payload_storage(state, type_id, field_index)) {
        return insert_payload_storage_field(state, type_id, aggregate, field_index, field_value);
    }
    Int element_index = llvm_type.layout_field_element_index(state, type_id, field_index);
    return ffi.builder_build_insert_value(state.builder, aggregate, field_value, element_index);
}

ffi.Value insert_payload_storage_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index,
    ffi.Value field_value
) {
    ffi.Type aggregate_type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(aggregate_type)) {
        return ffi.Value();
    }
    ffi.Value slot = ffi.builder_build_alloca(state.builder, aggregate_type);
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder, aggregate, slot))) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder, field_value, field_pointer))) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder, aggregate_type, slot);
}

ffi.Value lower_payload_storage_field_pointer(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index
) {
    list.ArrayList<ffi.Value>! indices = list.ArrayList<ffi.Value>(2);
    indices.add(ffi.const_int(ffi.context_int_type(state.llvm_context, 32), 0));
    indices.add(ffi.const_int(
            ffi.context_int_type(state.llvm_context, 32),
            UInt64(llvm_type.layout_field_element_index(state, type_id, field_index))
        )
    );
    return ffi.builder_build_gep(state.builder, llvm_type.lower_type(state, type_id), slot, indices$.ref());
}

Bool store_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index,
    ffi.Value field_value
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return false;
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder, field_value, field_pointer));
}

ffi.Value load_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    qid.TypeId field_type = llvm_type.constant_index_type(state, type_id, field_index);
    ffi.Type llvm_field_type = llvm_type.lower_type(state, field_type);
    if (!ffi.type_valid(llvm_field_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder, llvm_field_type, field_pointer);
}

ffi.Value extract_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    if (llvm_type.layout_field_uses_payload_storage(state, type_id, field_index)) {
        return extract_payload_storage_field(state, type_id, aggregate, field_index);
    }
    Int element_index = llvm_type.layout_field_element_index(state, type_id, field_index);
    return ffi.builder_build_extract_value(state.builder, aggregate, element_index);
}

ffi.Value extract_payload_storage_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index
) {
    ffi.Type aggregate_type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(aggregate_type)) {
        return ffi.Value();
    }
    ffi.Value slot = ffi.builder_build_alloca(state.builder, aggregate_type);
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder, aggregate, slot))) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    qid.TypeId field_type = llvm_type.constant_index_type(state, type_id, field_index);
    ffi.Type llvm_field_type = llvm_type.lower_type(state, field_type);
    if (!ffi.type_valid(llvm_field_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder, llvm_field_type, field_pointer);
}

public ffi.Value function_value_for_ref(llvm_state.LowerState& state, mir.MirFunctionRef value) {
    symbol.BackendSymbolKey key = symbol.symbol_key_for_def(state.ctx, value.function_def, value.type_args, false);
    UInt8[] name = symbol.symbol_name(key);
    if (table.hash_table_get_value<symbol.BackendSymbolKey, Int>(state.declared_function_indexes, key) is some index) {
        return state.declared_function_values.get(index);
    }
    add_missing_function_error(state, value.function_def, name);
    return ffi.Value();
}

() add_missing_function_error(llvm_state.LowerState& state, qid.DefId function_def, UInt8[] name) {
    diagnostic.SourceRange! range = diagnostic.SourceRange();
    if (state.ctx.store.source_map.def_span(function_def) is some loc) {
        guard loc.source_id is some source_id else {
            add_value_codegen_error(
                state,
                string.append("LLVM function symbol was not declared: ", name),
                "llvm_function_symbol_missing"
            );
            return;
        }
        range = diagnostic.SourceRange(source_id, loc.span);
    }
    state.ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode("llvm_function_symbol_missing"),
            range,
            string.append("LLVM function symbol was not declared: ", name)
        )
    );
}
