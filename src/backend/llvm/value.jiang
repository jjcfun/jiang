// JIL operand/rvalue/const -> LLVM value lowering。
//
// 这里不处理 CFG terminator，只负责生成可被 statement/terminator 使用的 LLVM
// value。place projection 和 type/layout 规则分别委托给同目录 helper。

import jil = "../../jil.jiang";
import diagnostic = "../../diagnostic.jiang";
import qid = "../../id.jiang";
import layout = "../../layout.jiang";
import list = "../../support/list.jiang";
import backend_abi = "../abi.jiang";
import symbol = "../symbol.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_abi = "./abi.jiang";
import llvm_state = "./state.jiang";
import llvm_place = "./place.jiang";
import llvm_type = "./type.jiang";
import std;

public Int32 atomic_ordering(jil.AtomicOrdering ordering) {
    if (ordering == .relaxed) { return Int32(2); }
    if (ordering == .acquire) { return Int32(4); }
    if (ordering == .release) { return Int32(5); }
    if (ordering == .acquire_release) { return Int32(6); }
    return Int32(7);
}

ffi.Value lower_local_exchange(
    llvm_state.LowerState& state,
    qid.TypeId result_type,
    ffi.Value pointer,
    ffi.Value desired
) {
    ffi.Type value_type = llvm_type.lower_type(state, result_type);
    ffi.Value previous = ffi.builder_build_load(state.builder$.ref(), value_type, pointer);
    if (!ffi.value_valid(previous)) { return ffi.Value(); }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), desired, pointer))) {
        return ffi.Value();
    }
    return previous;
}

ffi.Value lower_local_compare_exchange(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.Operand expected_operand,
    ffi.Value pointer,
    ffi.Value expected,
    ffi.Value desired
) {
    ffi.Type value_type = llvm_type.lower_type(state, operand_type(state, body, expected_operand));
    ffi.Value previous = ffi.builder_build_load(state.builder$.ref(), value_type, pointer);
    ffi.Value matched = ffi.builder_build_icmp(state.builder$.ref(), 32, previous, expected);
    ffi.Value next = ffi.builder_build_select(state.builder$.ref(), matched, desired, previous);
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), next, pointer))) {
        return ffi.Value();
    }
    return matched;
}

public qid.TypeId operand_type(llvm_state.LowerState& state, jil.Body& body, jil.Operand operand) {
    if (operand is .const_operand(const_value)) {
        return const_value.type_id;
    }
    if (operand is .function_operand(function_value)) {
        return function_value.type_id;
    }
    if (operand is .global_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .global_address_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.place_type(state, body, copy_operand.place);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.place_type(state, body, move_operand.place);
    }
    return state.ctx.store.types.invalid_type();
}

public ffi.Value lower_rvalue(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Rvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value is .use_value(use_value)) {
        if (use_value.value is .const_operand(const_value)) {
            return lower_const_as_type(state, output, const_value, result_type);
        }
        return lower_operand(state, output, body, use_value.value, local_slots);
    }
    if (value is .unary_value(unary_value)) {
        return lower_unary(state, output, body, unary_value, local_slots, result_type);
    }
    if (value is .binary_value(binary_value)) {
        return lower_binary(state, output, body, binary_value, local_slots);
    }
    if (value is .cast_value(cast_value)) {
        return lower_cast(state, output, body, cast_value, local_slots);
    }
    if (value is .inline_asm_value(inline_asm)) {
        return lower_inline_asm(state, output, body, inline_asm, local_slots);
    }
    if (value is .borrow_value(borrow_value)) {
        return llvm_place.lower_place_pointer(state, output, body, borrow_value.place, local_slots);
    }
    if (value is .address_of_value(address_of_value)) {
        return llvm_place.lower_place_pointer(state, output, body, address_of_value.place, local_slots);
    }
    if (value is .coroutine_address_value(coroutine_address)) {
        return llvm_place.lower_place_pointer(state, output, body, coroutine_address.place, local_slots);
    }
    if (value is .domain_executor_value(domain_executor)) {
        return lower_domain_executor(state, domain_executor);
    }
    if (value is .scheduled_continuation_resume_value(_)) {
        return ffi.module_get_function(state.module$.ref(), "__jiang_runtime_scheduled_continuation_resume");
    }
    if (value is .executor_enter_value(executor_enter)) {
        ffi.Value runtime = ffi.module_get_function(
            state.module$.ref(), "__jiang_runtime_executor_enter"
        );
        if (!ffi.value_valid(runtime)) { return ffi.Value(); }
        ffi.Type function_type = ffi.global_value_type(runtime);
        list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(2);
        args.add(llvm_place.lower_local_load(
            state, body.locals[executor_enter.executor.to_index()], local_slots
        ));
        args.add(llvm_place.lower_local_load(
            state, body.locals[executor_enter.context.to_index()], local_slots
        ));
        return ffi.builder_build_call(state.builder$.ref(), function_type, runtime, args$.ref());
    }
    if (value is .atomic_load_value(atomic_load)) {
        ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, atomic_load.place, local_slots);
        ffi.Type value_type = llvm_type.lower_type(state, result_type);
        if (atomic_load.mode == .coroutine_local) {
            return ffi.builder_build_load(state.builder$.ref(), value_type, pointer);
        }
        return ffi.builder_build_atomic_load(
            state.builder$.ref(), value_type, pointer, atomic_ordering(atomic_load.ordering)
        );
    }
    if (value is .atomic_exchange_value(exchange)) {
        ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, exchange.place, local_slots);
        ffi.Value desired = lower_operand(state, output, body, exchange.desired, local_slots);
        if (exchange.mode == .coroutine_local) {
            return lower_local_exchange(state, result_type, pointer, desired);
        }
        return ffi.builder_build_atomic_exchange(
            state.builder$.ref(), pointer, desired, atomic_ordering(exchange.ordering)
        );
    }
    if (value is .atomic_compare_exchange_value(compare_exchange)) {
        ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, compare_exchange.place, local_slots);
        ffi.Value expected = lower_operand(state, output, body, compare_exchange.expected, local_slots);
        ffi.Value desired = lower_operand(state, output, body, compare_exchange.desired, local_slots);
        if (compare_exchange.mode == .coroutine_local) {
            return lower_local_compare_exchange(
                state, body, compare_exchange.expected, pointer, expected, desired
            );
        }
        return ffi.builder_build_atomic_cmpxchg_success(
            state.builder$.ref(),
            pointer,
            expected,
            desired,
            atomic_ordering(compare_exchange.success_ordering),
            atomic_ordering(compare_exchange.failure_ordering)
        );
    }
    if (value is .alloc_box_value(alloc_box_value)) {
        return lower_alloc_box(state, output, alloc_box_value, result_type);
    }
    if (value is .coroutine_frame_alloc_value(frame_alloc)) {
        return lower_coroutine_frame_alloc(state, output, body, frame_alloc, local_slots, result_type);
    }
    if (value is .alloc_value(alloc_value)) {
        return lower_alloc_value(state, output, body, alloc_value, local_slots, result_type);
    }
    if (value is .alloc_array_value(alloc_array_value)) {
        return lower_alloc_array(state, output, body, alloc_array_value, local_slots, result_type);
    }
    if (value is .free_value(free_value)) {
        return lower_free(state, output, body, free_value, local_slots, result_type);
    }
    if (value is .coroutine_frame_free_value(frame_free)) {
        return lower_coroutine_frame_free(state, output, body, frame_free, local_slots, result_type);
    }
    if (value is .slice_value(slice_value)) {
        return lower_slice(state, output, body, slice_value, local_slots, result_type);
    }
    if (value is .len_value(len_value)) {
        return lower_len(state, output, body, len_value, local_slots);
    }
    if (value is .discriminant_value(discriminant_value)) {
        return lower_discriminant(state, output, body, discriminant_value, local_slots);
    }
    if (value is .aggregate_value(aggregate_value)) {
        return lower_aggregate(state, output, body, aggregate_value, local_slots);
    }
    if (value is .optional_value(optional_value)) {
        return lower_optional(state, output, body, optional_value, local_slots, result_type);
    }
    if (value is .error_union_value(error_union_value)) {
        return lower_error_union(state, output, body, error_union_value, local_slots, result_type);
    }
    return ffi.Value();
}

public ffi.Value lower_domain_executor(
    llvm_state.LowerState& state,
    jil.DomainExecutorRvalue domain_executor
) {
    ffi.Value materialize = ffi.module_get_function(state.module$.ref(), "__jiang_runtime_domain_executor");
    if (!ffi.value_valid(materialize)) { return ffi.Value(); }
    ffi.Type int_type = ffi.context_int_type(state.llvm_context$.ref(), 64);
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    ffi.Value slot = domain_executor_slot(state, domain_executor.domain_def, int_type);
    if (!ffi.value_valid(slot)) { return ffi.Value(); }
    ffi.Value cached = ffi.builder_build_atomic_load(state.builder$.ref(), int_type, slot, Int32(4));
    if (!ffi.value_valid(cached)) { return ffi.Value(); }
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(7);
    params.add(pointer_type);
    params.add(int_type);
    params.add(int_type);
    params.add(int_type);
    params.add(int_type);
    params.add(pointer_type);
    params.add(pointer_type);
    ffi.Type function_type = ffi.function_type(pointer_type, params$.ref());
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(7);
    args.add(slot);
    args.add(cached);
    args.add(ffi.const_int(int_type, UInt64(domain_executor.domain_def.to_index())));
    args.add(ffi.const_int(int_type, UInt64(domain_executor.domain_kind)));
    Int main_thread! = 0;
    if (state.store.program.main_domain_def is .some(main_domain)) {
        if (main_domain == domain_executor.domain_def) { main_thread = 1; }
    }
    args.add(ffi.const_int(int_type, UInt64(main_thread)));
    ffi.Value descriptor! = ffi.const_null(pointer_type);
    ffi.Value domain_config! = ffi.const_null(pointer_type);
    if (state.store.program.domain_executor_descriptor(domain_executor.domain_def) is .some(info)) {
        descriptor = global_address_for_ref(state, info.descriptor);
        domain_config = global_address_for_ref(state, info.domain_config);
    }
    args.add(descriptor);
    args.add(domain_config);
    return ffi.builder_build_call(state.builder$.ref(), function_type, materialize, args$.ref());
}

ffi.Value domain_executor_slot(
    llvm_state.LowerState& state,
    qid.DefId domain_def,
    ffi.Type int_type
) {
    std.String global_name = symbol.global_symbol_name_for_def(state.ctx, domain_def, false);
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(global_name.bytes());
    builder.append("_DomainExecutor");
    std.String slot_name = builder.into_string();
    ffi.Value slot! = ffi.module_get_global(state.module$.ref(), slot_name.bytes());
    if (ffi.value_valid(slot)) { return slot; }
    slot = ffi.module_add_global(state.module$.ref(), slot_name.bytes(), int_type);
    if (ffi.value_valid(slot)) {
        ffi.global_set_initializer(slot, ffi.const_int(int_type, UInt64(0)));
        // 多个 codegen unit 可以使用同一 Domain；链接时必须合并为一个进程级缓存槽。
        ffi.value_set_link_once_odr_linkage(slot);
    }
    return slot;
}

public ffi.Value lower_inline_asm(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.InlineAsmRvalue inline_asm,
    list.ArrayList<ffi.Value>& local_slots
) {
    list.ArrayList<ffi.Type> param_types! = list.ArrayList<ffi.Type>();
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>();
    std.String constraints = inline_asm_constraints(state, inline_asm);
    Int index! = 0;
    while (index < inline_asm.operands.length) {
        lower_inline_asm_operand(
            state,
            output,
            body,
            inline_asm.operands[index],
            local_slots,
            param_types$.mut_ref(),
            args$.mut_ref()
        );
        index = index + 1;
    }
    ffi.Type result_type = llvm_type.lower_type(state, inline_asm.result_type);
    ffi.Type function_type = ffi.function_type(result_type, param_types$.ref());
    UInt8[]& code = state.ctx.store.symbols.text(inline_asm.code_symbol);
    Bool side_effects = inline_asm.volatile || inline_asm.memory || inline_asm.noreturn;
    ffi.Value asm_value = ffi.inline_asm_value(function_type, code, constraints.bytes(), side_effects);
    if (!ffi.value_valid(asm_value)) {
        return ffi.Value();
    }
    return ffi.builder_build_call(state.builder$.ref(), function_type, asm_value, args$.ref());
}

Void lower_inline_asm_operand(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.InlineAsmOperand operand,
    list.ArrayList<ffi.Value>& local_slots,
    list.ArrayList<ffi.Type>&! param_types,
    list.ArrayList<ffi.Value>&! args
) {
    if (operand is .input(input)) {
        ffi.Value value = lower_operand(state, output, body, input.value, local_slots);
        if (!ffi.value_valid(value)) {
            return;
        }
        param_types.add(llvm_type.lower_type(state, operand_type(state, body, input.value)));
        args.add(value);
    }
}

std.String inline_asm_constraints(llvm_state.LowerState& state, jil.InlineAsmRvalue inline_asm) {
    std.String result! = std.String("");
    Int count! = 0;
    Int index! = 0;
    while (index < inline_asm.operands.length) {
        if (inline_asm.operands[index] is .output(output)) {
            std.String constraint = inline_asm_output_constraint(state, output);
            result = append_inline_asm_constraint(result.bytes(), constraint.bytes(), count);
            count = count + 1;
        }
        index = index + 1;
    }
    index = 0;
    while (index < inline_asm.operands.length) {
        if (inline_asm.operands[index] is .input(input)) {
            std.String constraint = inline_asm_constraint_text(state, input.constraint_symbol);
            result = append_inline_asm_constraint(result.bytes(), constraint.bytes(), count);
            count = count + 1;
        }
        index = index + 1;
    }
    return append_inline_asm_clobbers(state, inline_asm, result, count);
}

std.String append_inline_asm_clobbers(
    llvm_state.LowerState& state,
    jil.InlineAsmRvalue inline_asm,
    std.String constraints,
    Int count
) {
    std.String result! = constraints;
    Int next_count! = count;
    Int index! = 0;
    while (index < inline_asm.clobbers.length) {
        std.String clobber = inline_asm_clobber_constraint(state, inline_asm.clobbers[index]);
        result = append_inline_asm_constraint(result.bytes(), clobber.bytes(), next_count);
        next_count = next_count + 1;
        index = index + 1;
    }
    if (inline_asm.memory) {
        result = append_inline_asm_constraint(result.bytes(), "~{memory}", next_count);
    }
    return result;
}

std.String append_inline_asm_constraint(UInt8[]& text, UInt8[]& constraint, Int count) {
    if (count == 0) {
        return std.String(constraint);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(text);
    builder.append(",");
    builder.append(constraint);
    return builder.into_string();
}

std.String inline_asm_output_constraint(llvm_state.LowerState& state, jil.InlineAsmOutput output) {
    std.String text = inline_asm_constraint_text(state, output.constraint_symbol);
    return string.concat("=", text.bytes());
}

std.String inline_asm_clobber_constraint(llvm_state.LowerState& state, qid.SymbolId symbol) {
    std.String text = inline_asm_constraint_text(state, symbol);
    return string.concat("~", text.bytes());
}

std.String inline_asm_constraint_text(llvm_state.LowerState& state, qid.SymbolId symbol) {
    UInt8[]& text = state.ctx.store.symbols.text(symbol);
    if (text.length == 0) {
        return std.String(text);
    }
    if (text.length == 1) {
        return std.String(text);
    }
    if (text[0] == UInt8(123)) {
        return std.String(text);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("{");
    builder.append(text);
    builder.append("}");
    return builder.into_string();
}

public ffi.Value lower_operand(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand operand,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .const_operand(const_value)) {
        return lower_const(state, output, const_value);
    }
    if (operand is .function_operand(function_value)) {
        return function_value_for_ref(state, output, function_value);
    }
    if (operand is .global_operand(global_value)) {
        return global_value_for_ref(state, global_value);
    }
    if (operand is .global_address_operand(global_value)) {
        return global_address_for_ref(state, global_value);
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.lower_place_value(state, output, body, copy_operand.place, local_slots);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.lower_place_value(state, output, body, move_operand.place, local_slots);
    }
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, output, body, out_operand.place, local_slots);
    }
    return ffi.Value();
}

public Bool lower_aggregate_into_place(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Rvalue rvalue,
    jil.Place destination,
    list.ArrayList<ffi.Value>& local_slots
) {
    guard rvalue is .aggregate_value(value) else {
        return false;
    }
    if (!llvm_type.type_has_abi_value(state, value.type_id)) {
        return true;
    }
    // 构造聚合值时直接写目标 slot，避免先构造一个 LLVM aggregate value。
    // union 的 payload 存在共享存储区，尤其不能依赖普通 struct extract/insert。
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(state, output, body, destination, local_slots);
    if (!ffi.value_valid(destination_pointer)) {
        return false;
    }
    if (value.kind != .union_variant) {
        return lower_plain_aggregate_into_pointer(state, output, body, value, destination_pointer, local_slots);
    }
    guard value.tag is .some(tag_operand) else {
        return false;
    }
    ffi.Value tag = lower_operand(state, output, body, tag_operand, local_slots);
    if (!ffi.value_valid(tag)) {
        return false;
    }
    if (!store_layout_field(state, value.type_id, destination_pointer, 0, tag)) {
        return false;
    }
    if (value.fields.length == 0) {
        return true;
    }
    if (value.payload_field_index < 0) {
        return false;
    }
    qid.TypeId payload_type = llvm_type.constant_index_type(state, value.type_id, value.payload_field_index);
    if (!llvm_type.type_has_abi_value(state, payload_type)) {
        return true;
    }
    if (value.fields.length != 1) {
        return lower_union_payload_fields_into_pointer(
            state,
            output,
            body,
            value,
            destination_pointer,
            payload_type,
            local_slots
        );
    }
    if (copy_operand_into_layout_field(
            state,
            output,
            body,
            value.fields[0],
            local_slots,
            value.type_id,
            destination_pointer,
            value.payload_field_index,
            payload_type
        )
    ) {
        return true;
    }
    ffi.Value payload = lower_operand(state, output, body, value.fields[0], local_slots);
    if (!ffi.value_valid(payload)) {
        return false;
    }
    return store_layout_field(state, value.type_id, destination_pointer, value.payload_field_index, payload);
}

public Bool lower_closure_into_place(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Rvalue rvalue,
    jil.Place destination,
    list.ArrayList<ffi.Value>& local_slots
) {
    guard rvalue is .closure_value(value) else {
        return false;
    }
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(
        state, output, body, destination, local_slots
    );
    if (!ffi.value_valid(destination_pointer)) {
        return false;
    }
    ffi.Value environment = lower_closure_environment(state, output, body, value, local_slots);
    if (!ffi.value_valid(environment)) {
        return false;
    }
    ffi.Value vtable = lower_operand(state, output, body, value.vtable, local_slots);
    if (!ffi.value_valid(vtable)) {
        return false;
    }
    return store_closure_value(state, output, value, destination_pointer, environment, vtable);
}

ffi.Value lower_closure_environment(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.ClosureRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (value.captures.length == 0) {
        return ffi.const_null(ffi.context_pointer_type(state.llvm_context$.ref()));
    }
    ffi.Value environment!;
    if (value.environment_storage == .heap) {
        environment = malloc_bytes_for_type(state, output, value.environment_type);
    } else {
        guard value.stack_environment is .some(stack_environment) else {
            return ffi.Value();
        }
        environment = llvm_place.lower_place_pointer(
            state, output, body, stack_environment, local_slots
        );
    }
    if (!ffi.value_valid(environment)) {
        return ffi.Value();
    }
    if (!store_closure_captures(state, output, body, value, environment, local_slots)) {
        return ffi.Value();
    }
    return environment;
}

Bool store_closure_captures(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.ClosureRvalue value,
    ffi.Value environment,
    list.ArrayList<ffi.Value>& local_slots
) {
    Int index! = 0;
    while (index < value.captures.length) {
        qid.TypeId capture_type = llvm_type.constant_index_type(state, value.environment_type, index);
        if (!store_closure_capture(
                state, output, body, value, environment, local_slots, index, capture_type
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool store_closure_capture(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.ClosureRvalue value,
    ffi.Value environment,
    list.ArrayList<ffi.Value>& local_slots,
    Int index,
    qid.TypeId capture_type
) {
    if (!llvm_type.type_has_abi_value(state, capture_type)) {
        return true;
    }
    if (copy_operand_into_layout_field(
            state,
            output,
            body,
            value.captures[index],
            local_slots,
            value.environment_type,
            environment,
            index,
            capture_type
        )
    ) {
        return true;
    }
    ffi.Value capture = lower_operand_as_type(
        state, output, body, value.captures[index], local_slots, capture_type
    );
    if (!ffi.value_valid(capture)) {
        return false;
    }
    return store_layout_field(state, value.environment_type, environment, index, capture);
}

Bool store_closure_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.ClosureRvalue value,
    ffi.Value destination_pointer,
    ffi.Value environment,
    ffi.Value vtable
) {
    ffi.Value closure_pointer! = destination_pointer;
    if (value.storage == .heap) {
        closure_pointer = malloc_bytes_for_type(state, output, value.closure_type);
        if (!ffi.value_valid(closure_pointer)) {
            return false;
        }
    }
    if (!store_layout_field(state, value.closure_type, closure_pointer, 0, environment)) {
        return false;
    }
    if (!store_layout_field(state, value.closure_type, closure_pointer, 1, vtable)) {
        return false;
    }
    if (value.storage == .stack) {
        return true;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), closure_pointer, destination_pointer));
}

Bool lower_union_payload_fields_into_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AggregateRvalue value,
    ffi.Value destination_pointer,
    qid.TypeId payload_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value payload_pointer = lower_payload_storage_field_pointer(
        state,
        value.type_id,
        destination_pointer,
        value.payload_field_index
    );
    if (!ffi.value_valid(payload_pointer)) {
        return false;
    }
    Int index! = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, payload_type, index);
        // 多字段 union payload 先定位到 payload storage，再按 payload struct 的
        // 字段布局逐个写入；大字段继续走 memcpy。
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        if (copy_operand_into_layout_field(
                state,
                output,
                body,
                value.fields[index],
                local_slots,
                payload_type,
                payload_pointer,
                index,
                field_type
            )
        ) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(
            state, output, body, value.fields[index], local_slots, field_type
        );
        if (!ffi.value_valid(field_value)) {
            return false;
        }
        if (!store_layout_field(state, payload_type, payload_pointer, index, field_value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public Bool lower_optional_into_place(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Rvalue rvalue,
    jil.Place destination,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    guard rvalue is .optional_value(value) else {
        return false;
    }
    ffi.Value destination_pointer = llvm_place.lower_place_pointer(state, output, body, destination, local_slots);
    if (!ffi.value_valid(destination_pointer)) {
        return false;
    }
    if (value.op == .make_some) {
        if (!store_layout_field(state, result_type, destination_pointer, 0, bool_value(state, true))) {
            return false;
        }
        qid.TypeId payload_type = llvm_type.element_type(state, result_type);
        if (copy_operand_into_layout_field(
                state,
                output,
                body,
                value.value,
                local_slots,
                result_type,
                destination_pointer,
                1,
                payload_type
            )
        ) {
            return true;
        }
        ffi.Value payload = lower_operand(state, output, body, value.value, local_slots);
        if (!ffi.value_valid(payload)) {
            return false;
        }
        return store_layout_field(state, result_type, destination_pointer, 1, payload);
    }
    if (value.op == .unwrap_some) {
        qid.TypeId source_type = operand_type(state, body, value.value);
        qid.TypeId payload_type = llvm_type.element_type(state, source_type);
        guard operand_place(value.value) is .some(source_place) else {
            return false;
        }
        // optional 解包到 place 时直接复制 payload 字节，保证大 payload 不经过
        // LLVM aggregate value。
        ffi.Value source_pointer = llvm_place.lower_place_pointer(state, output, body, source_place, local_slots);
        if (!ffi.value_valid(source_pointer)) {
            return false;
        }
        ffi.Value payload_pointer = lower_payload_storage_field_pointer(state, source_type, source_pointer, 1);
        if (!ffi.value_valid(payload_pointer)) {
            return false;
        }
        return copy_pointer_bytes(state, payload_pointer, destination_pointer, payload_type);
    }
    if (value.op == .make_none) {
        ffi.Value zero = zero_aggregate(state, result_type);
        if (!ffi.value_valid(zero)) {
            return false;
        }
        return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), zero, destination_pointer));
    }
    return false;
}

Bool lower_plain_aggregate_into_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AggregateRvalue value,
    ffi.Value destination_pointer,
    list.ArrayList<ffi.Value>& local_slots
) {
    Int index! = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, value.type_id, index);
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        if (copy_operand_into_layout_field(
                state,
                output,
                body,
                value.fields[index],
                local_slots,
                value.type_id,
                destination_pointer,
                index,
                field_type
            )
        ) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(
            state, output, body, value.fields[index], local_slots, field_type
        );
        if (!ffi.value_valid(field_value)) {
            return false;
        }
        if (!store_layout_field(state, value.type_id, destination_pointer, index, field_value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool copy_operand_into_layout_field(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand operand,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId owner_type,
    ffi.Value destination_pointer,
    Int field_index,
    qid.TypeId field_type
) {
    if (!type_should_copy_bytes(state, field_type)) {
        return false;
    }
    guard operand_place(operand) is .some(source_place) else {
        return false;
    }
    // 只有源值仍能追溯到 JIL place 时才能 memcpy；常量和计算结果仍回退到
    // 普通 value lowering。
    ffi.Value source_pointer = llvm_place.lower_place_pointer(state, output, body, source_place, local_slots);
    if (!ffi.value_valid(source_pointer)) {
        return false;
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, owner_type, destination_pointer, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return false;
    }
    return copy_pointer_bytes(state, source_pointer, field_pointer, field_type);
}

jil.Place? operand_place(jil.Operand operand) {
    if (operand is .copy_operand(copy_operand)) {
        return copy_operand.place;
    }
    if (operand is .move_operand(move_operand)) {
        return move_operand.place;
    }
    return null;
}

Bool type_should_copy_bytes(llvm_state.LowerState& state, qid.TypeId type_id) {
    if (!llvm_type.type_has_abi_value(state, type_id)) {
        return false;
    }
    return llvm_type.layout_size(state, type_id) > state.ctx.query.layout.target().pointer_size * 2;
}

Bool copy_pointer_bytes(
    llvm_state.LowerState& state,
    ffi.Value source_pointer,
    ffi.Value destination_pointer,
    qid.TypeId type_id
) {
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type size_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    Int align = llvm_type.layout_align(state, type_id);
    return ffi.value_valid(ffi.builder_build_memcpy(
            state.builder$.ref(),
            destination_pointer,
            align,
            source_pointer,
            align,
            size
        )
    );
}

public ffi.Value global_value_for_ref(llvm_state.LowerState& state, jil.GlobalRef value) {
    ffi.Type value_type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    ffi.Value global = declare_global(state, value, value_type);
    if (!ffi.value_valid(global)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), value_type, global);
}

public ffi.Value global_address_for_ref(llvm_state.LowerState& state, jil.GlobalRef value) {
    if (llvm_type.is_trait_vtable_type(state, value.type_id)) {
        ffi.Type storage_type = llvm_type.trait_vtable_storage_type(state, value.type_id);
        if (!ffi.type_valid(storage_type)) {
            return ffi.Value();
        }
        return declare_global(state, value, storage_type);
    }
    types.TypeInfo info = state.ctx.store.types.get(value.type_id);
    guard info.data is .handle_type(handle) else {
        return ffi.Value();
    }
    ffi.Type value_type = llvm_type.lower_type(state, handle.element);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    return declare_global(state, value, value_type);
}

ffi.Value declare_global(llvm_state.LowerState& state, jil.GlobalRef global_ref, ffi.Type value_type) {
    std.String name = symbol.global_symbol_name_for_ref(state.ctx, state.store, global_ref);
    ffi.Value existing = ffi.module_get_global(state.module$.ref(), name.bytes());
    if (ffi.value_valid(existing)) {
        return existing;
    }
    return ffi.module_add_global(state.module$.ref(), name.bytes(), value_type);
}

public ffi.Value lower_operand_as_type(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand operand,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (operand is .const_operand(const_value)) {
        return lower_const_as_type(state, output, const_value, result_type);
    }
    return lower_operand(state, output, body, operand, local_slots);
}

public ffi.Value lower_const(llvm_state.LowerState& state, llvm_state.LowerOutput&! output, jil.Const value) {
    return lower_const_as_type(state, output, value, value.type_id);
}

public ffi.Value lower_const_as_type(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Const value,
    qid.TypeId result_type
) {
    jil.ConstValue const_value = value.value;
    if (jil.string_const_value(const_value) is .some(string_value)) {
        return lower_string_const(state, output, string_value, result_type);
    }
    if (jil.is_null_const_value(const_value)) {
        return lower_null_const(state, result_type);
    }
    ffi.Type value_type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    if (jil.int_const_value(const_value) is .some(int_value)) {
        return ffi.const_int(value_type, int_value.bits);
    }
    if (jil.float_const_value(const_value) is .some(float_value)) {
        return ffi.const_real(value_type, float_value.value);
    }
    if (jil.bool_const_value(const_value) is .some(bool_value)) {
        return bool_const(state, value_type, bool_value.value);
    }
    if (jil.is_unit_const_value(const_value)) {
        return ffi.Value();
    }
    return ffi.Value();
}

public ffi.Value lower_static_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.StaticValue value,
    qid.TypeId type_id
) {
    if (value is .scalar(scalar)) {
        return lower_const_as_type(state, output, scalar, type_id);
    }
    if (value is .function(function_ref)) {
        return function_value_for_ref(state, output, function_ref);
    }
    if (value is .global_address(global_ref)) {
        return global_address_for_ref(state, global_ref);
    }
    if (llvm_type.is_trait_vtable_type(state, type_id)) {
        return lower_trait_vtable_static_value(state, output, value, type_id);
    }
    guard value is .aggregate(fields) else {
        return ffi.Value();
    }
    return lower_static_aggregate(state, output, fields, type_id);
}

ffi.Value lower_static_aggregate(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.StaticField[]& fields,
    qid.TypeId type_id
) {
    layout.TypeLayout type_layout = llvm_type.layout_for_type(state, type_id);
    if (type_layout.payload_storage_offset >= 0) {
        return lower_static_aggregate_with_insert(state, output, fields, type_id);
    }
    if (fields.length != type_layout.fields.length) {
        return lower_static_aggregate_with_insert(state, output, fields, type_id);
    }
    list.ArrayList<ffi.Value> values! = list.ArrayList<ffi.Value>(fields.length);
    Int offset! = 0;
    Int index! = 0;
    while (index < fields.length) {
        layout.FieldLayout field = type_layout.fields[index];
        layout.TypeLayout field_layout = llvm_type.layout_for_type(state, field.field_type);
        if (field_layout.kind == .zero_sized) {
            index = index + 1;
            continue;
        }
        if (field.offset < offset) {
            return lower_static_aggregate_with_insert(state, output, fields, type_id);
        }
        add_static_padding(state, values$.mut_ref(), field.offset - offset);
        ffi.Value field_value = lower_static_value(state, output, fields[index].value, fields[index].type_id);
        if (!ffi.value_valid(field_value)) { return ffi.Value(); }
        values.add(field_value);
        offset = field.offset + field_layout.size;
        index = index + 1;
    }
    add_static_padding(state, values$.mut_ref(), type_layout.size - offset);
    return ffi.const_struct(state.llvm_context$.ref(), values$.ref());
}

Void add_static_padding(
    llvm_state.LowerState& state,
    list.ArrayList<ffi.Value>&! values,
    Int byte_count
) {
    if (byte_count <= 0) { return; }
    ffi.Type byte_type = ffi.context_int_type(state.llvm_context$.ref(), 8);
    values.add(ffi.const_null(ffi.array_type(byte_type, byte_count)));
}

ffi.Value lower_static_aggregate_with_insert(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.StaticField[]& fields,
    qid.TypeId type_id
) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    ffi.Value aggregate! = ffi.const_null(type);
    Int index! = 0;
    while (index < fields.length) {
        qid.TypeId field_type = fields[index].type_id;
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_static_value(state, output, fields[index].value, field_type);
        if (!ffi.value_valid(field_value)) {
            return ffi.Value();
        }
        aggregate = insert_layout_field(state, type_id, aggregate, index, field_value);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        index = index + 1;
    }
    return aggregate;
}

ffi.Value lower_trait_vtable_static_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.StaticValue value,
    qid.TypeId type_id
) {
    guard value is .aggregate(fields) else {
        return ffi.Value();
    }
    list.ArrayList<ffi.Value> values! = list.ArrayList<ffi.Value>(fields.length);
    Int index! = 0;
    while (index < fields.length) {
        ffi.Value field_value = lower_static_value(state, output, fields[index].value, fields[index].type_id);
        if (!ffi.value_valid(field_value)) {
            return ffi.Value();
        }
        values.add(field_value);
        index = index + 1;
    }
    return ffi.const_struct(state.llvm_context$.ref(), values$.ref());
}

ffi.Value lower_null_const(llvm_state.LowerState& state, qid.TypeId result_type) {
    if (!llvm_type.type_has_abi_value(state, result_type)) {
        return ffi.Value();
    }
    ffi.Type value_type = llvm_type.lower_type(state, result_type);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    return ffi.const_null(value_type);
}

ffi.Value lower_string_const(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.StringConst value,
    qid.TypeId result_type
) {
    UInt8[]& text = state.ctx.store.symbols.text(value.symbol_id);
    if (string_const_array_type(state, result_type) is .some(array_type)) {
        return lower_string_array_const(state, output, text, result_type, array_type);
    }
    UInt8*! c_text = null_terminated_bytes(text);
    ffi.Value data = unsafe {
        ffi.builder_build_global_string_ptr(state.builder$.ref(), c_text$.as(UInt8*))
    };
    if (!ffi.value_valid(data)) {
        add_value_codegen_error(output, "failed to build LLVM global string", "llvm_global_string_lower_failed");
        return ffi.Value();
    }
    if (value.nul_terminated) {
        return data;
    }
    if (!llvm_type.type_is_slice(state, result_type)) {
        return data;
    }
    ffi.Value aggregate! = zero_aggregate(state, result_type);
    aggregate = insert_layout_field(state, result_type, aggregate, 0, data);
    if (!ffi.value_valid(aggregate)) {
        add_value_codegen_error(
            output,
            "failed to store string data in LLVM slice",
            "llvm_string_slice_data_lower_failed"
        );
        return ffi.Value();
    }
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type int_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value length = insert_layout_field(
        state,
        result_type,
        aggregate,
        1,
        ffi.const_int(int_type, UInt64(text.length))
    );
    if (!ffi.value_valid(length)) {
        add_value_codegen_error(
            output,
            "failed to store string length in LLVM slice",
            "llvm_string_slice_length_lower_failed"
        );
    }
    return length;
}

types.ArrayType? string_const_array_type(llvm_state.LowerState& state, qid.TypeId result_type) {
    types.TypeInfo info = state.ctx.store.types.get(result_type);
    if (info.data is .array_type(array_type)) {
        return array_type;
    }
    return null;
}

ffi.Value lower_string_array_const(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    UInt8[]& text,
    qid.TypeId result_type,
    types.ArrayType array_type
) {
    ffi.Value aggregate! = zero_aggregate(state, result_type);
    ffi.Type element_type = llvm_type.lower_type(state, array_type.element);
    if (!ffi.type_valid(element_type)) {
        return ffi.Value();
    }
    Int index! = 0;
    while (index < text.length) {
        aggregate = insert_layout_field(
            state,
            result_type,
            aggregate,
            index,
            ffi.const_int(element_type, UInt64(text[index]))
        );
        if (!ffi.value_valid(aggregate)) {
            add_value_codegen_error(
                output,
                "failed to store string byte in LLVM array",
                "llvm_string_array_byte_lower_failed"
            );
            return ffi.Value();
        }
        index = index + 1;
    }
    if (array_type.sentinel is .some(sentinel)) {
        aggregate = insert_layout_field(
            state,
            result_type,
            aggregate,
            array_type.count,
            ffi.const_int(element_type, types.sentinel_value(array_type.sentinel))
        );
        if (!ffi.value_valid(aggregate)) {
            add_value_codegen_error(
                output,
                "failed to store string sentinel in LLVM array",
                "llvm_string_array_sentinel_lower_failed"
            );
            return ffi.Value();
        }
    }
    return aggregate;
}

UInt8*! null_terminated_bytes(UInt8[]& text) {
    unsafe {
        UInt8*! bytes = unsafe {
            UInt8$.alloc(text.length + 1)
        };
        Int index! = 0;
        while (index < text.length) {
            bytes[index] = text[index];
            index = index + 1;
        }
        bytes[text.length] = 0;
        return bytes;
    }
}

Void add_value_codegen_error(
    llvm_state.LowerOutput&! output,
    UInt8[]& message,
    UInt8[]& code
) {
    output.add_diagnostic(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

ffi.Value bool_const(llvm_state.LowerState& state, ffi.Type value_type, Bool value) {
    if (value) {
        return ffi.const_int(value_type, 1);
    }
    return ffi.const_int(value_type, 0);
}

ffi.Value lower_alloc_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AllocValueRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value initialized = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(initialized)) {
        return ffi.Value();
    }
    ffi.Value raw = malloc_bytes_for_type(state, output, value.value_type);
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    ffi.Value pointer = ffi.builder_build_cast(state.builder$.ref(), 6, raw, llvm_type.lower_type(state, result_type));
    if (!ffi.value_valid(pointer)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), initialized, pointer))) {
        return ffi.Value();
    }
    return pointer;
}

ffi.Value lower_alloc_box(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.AllocBoxRvalue value,
    qid.TypeId result_type
) {
    ffi.Value raw = malloc_bytes_for_type(state, output, value.value_type);
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    return ffi.builder_build_cast(state.builder$.ref(), 6, raw, llvm_type.lower_type(state, result_type));
}

ffi.Value lower_coroutine_frame_alloc(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CoroutineFrameAllocRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value runtime = ffi.module_get_function(
        state.module$.ref(), "__jiang_runtime_coroutine_frame_alloc"
    );
    if (!ffi.value_valid(runtime)) { return ffi.Value(); }
    ffi.Value executor = lower_operand(state, output, body, value.executor, local_slots);
    if (!ffi.value_valid(executor)) { return ffi.Value(); }
    ffi.Type size_type = allocator_size_type(state);
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(3);
    args.add(executor);
    args.add(ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, value.value_type))));
    args.add(ffi.const_int(size_type, UInt64(llvm_type.layout_align(state, value.value_type))));
    ffi.Value raw = ffi.builder_build_call(
        state.builder$.ref(), ffi.global_value_type(runtime), runtime, args$.ref()
    );
    if (!ffi.value_valid(raw)) { return ffi.Value(); }
    return ffi.builder_build_cast(state.builder$.ref(), 6, raw, llvm_type.lower_type(state, result_type));
}

ffi.Value lower_alloc_array(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AllocArrayRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value count = lower_operand(state, output, body, value.count, local_slots);
    if (!ffi.value_valid(count)) {
        return ffi.Value();
    }
    ffi.Type size_type = allocator_size_type(state);
    ffi.Value element_size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, value.element_type)));
    ffi.Value allocation_count! = owned_slice_allocation_count(state, result_type, count);
    if (!ffi.value_valid(allocation_count)) {
        return ffi.Value();
    }
    allocation_count = cast_allocator_size_value(state, allocation_count);
    if (!ffi.value_valid(allocation_count)) {
        return ffi.Value();
    }
    ffi.Value bytes = ffi.builder_build_binary(state.builder$.ref(), .int_mul, allocation_count, element_size);
    if (!ffi.value_valid(bytes)) {
        return ffi.Value();
    }
    ffi.Value malloc_fn = declare_malloc(state, output);
    if (!ffi.value_valid(malloc_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type> param_types! = list.ArrayList<ffi.Type>(1);
    param_types.add(size_type);
    ffi.Type malloc_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context$.ref()), param_types$.ref());
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
    args.add(bytes);
    ffi.Value raw = ffi.builder_build_call(state.builder$.ref(), malloc_type, malloc_fn, args$.ref());
    if (!ffi.value_valid(raw)) {
        return ffi.Value();
    }
    ffi.Value data = ffi.builder_build_cast(state.builder$.ref(), 6, raw, owned_array_data_type(state, result_type));
    if (!ffi.value_valid(data)) {
        return ffi.Value();
    }
    if (llvm_type.type_is_owned_slice_value(state, result_type)) {
        ffi.Value aggregate! = zero_aggregate(state, result_type);
        aggregate = insert_layout_field(state, result_type, aggregate, 0, data);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        return insert_layout_field(state, result_type, aggregate, 1, count);
    }
    return data;
}

ffi.Value owned_slice_allocation_count(llvm_state.LowerState& state, qid.TypeId result_type, ffi.Value count) {
    if (!llvm_type.type_is_owned_slice_value(state, result_type)) {
        return count;
    }
    types.TypeInfo info = state.ctx.store.types.get(result_type);
    guard info.data is .handle_type(handle) else { return count; }
    types.TypeInfo element_info = state.ctx.store.types.get(handle.element);
    guard element_info.data is .slice_value_type(slice_value) else { return count; }
    if (!types.sentinel_has(slice_value.sentinel)) {
        return count;
    }
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type int_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value one = ffi.const_int(int_type, 1);
    return ffi.builder_build_binary(state.builder$.ref(), .int_add, count, one);
}

ffi.Type owned_array_data_type(llvm_state.LowerState& state, qid.TypeId result_type) {
    if (llvm_type.type_is_owned_slice_value(state, result_type)) {
        return ffi.context_pointer_type(state.llvm_context$.ref());
    }
    return llvm_type.lower_type(state, result_type);
}

ffi.Value malloc_bytes_for_type(llvm_state.LowerState& state, llvm_state.LowerOutput&! output, qid.TypeId type_id) {
    ffi.Type size_type = allocator_size_type(state);
    if (llvm_type.layout_size(state, type_id) == 0) {
        return nonnull_zero_sized_pointer(state);
    }
    ffi.Value bytes = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    ffi.Value malloc_fn = declare_malloc(state, output);
    if (!ffi.value_valid(malloc_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type> param_types! = list.ArrayList<ffi.Type>(1);
    param_types.add(size_type);
    ffi.Type malloc_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context$.ref()), param_types$.ref());
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
    args.add(bytes);
    return ffi.builder_build_call(state.builder$.ref(), malloc_type, malloc_fn, args$.ref());
}

ffi.Value nonnull_zero_sized_pointer(llvm_state.LowerState& state) {
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    ffi.Type int_type = ffi.context_int_type(state.llvm_context$.ref(), pointer_bits);
    ffi.Value address = ffi.const_int(int_type, UInt64(1));
    return ffi.builder_build_cast(
        state.builder$.ref(), 8, address, ffi.context_pointer_type(state.llvm_context$.ref())
    );
}

ffi.Value lower_free(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.FreeRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value pointer! = lower_operand(state, output, body, value.pointer, local_slots);
    if (!ffi.value_valid(pointer)) {
        return ffi.Value();
    }
    qid.TypeId pointer_type = operand_type(state, body, value.pointer);
    if (free_pointer_has_zero_sized_element(state, pointer_type)) {
        return zero_aggregate(state, result_type);
    }
    if (llvm_type.type_is_owned_slice_value(state, pointer_type)) {
        pointer = extract_layout_field(state, pointer_type, pointer, 0);
        if (!ffi.value_valid(pointer)) {
            return ffi.Value();
        }
    }
    if (llvm_type.type_is_trait_object_handle(state, pointer_type)) {
        pointer = extract_layout_field(state, pointer_type, pointer, 0);
        if (!ffi.value_valid(pointer)) {
            return ffi.Value();
        }
    }
    return lower_heap_pointer_free(state, output, pointer);
}

ffi.Value lower_coroutine_frame_free(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CoroutineFrameFreeRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value runtime = ffi.module_get_function(
        state.module$.ref(), "__jiang_runtime_coroutine_frame_free"
    );
    if (!ffi.value_valid(runtime)) { return ffi.Value(); }
    ffi.Value executor = lower_operand(state, output, body, value.executor, local_slots);
    ffi.Value pointer = lower_operand(state, output, body, value.pointer, local_slots);
    if (!ffi.value_valid(executor) || !ffi.value_valid(pointer)) { return ffi.Value(); }
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(2);
    args.add(executor);
    args.add(pointer);
    ffi.Value call = ffi.builder_build_call(
        state.builder$.ref(), ffi.global_value_type(runtime), runtime, args$.ref()
    );
    if (!ffi.value_valid(call)) { return ffi.Value(); }
    return zero_aggregate(state, result_type);
}

public ffi.Value lower_heap_pointer_free(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer
) {
    ffi.Value free_fn = declare_free(state, output);
    if (!ffi.value_valid(free_fn)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Type> param_types! = list.ArrayList<ffi.Type>(1);
    param_types.add(ffi.context_pointer_type(state.llvm_context$.ref()));
    ffi.Type free_type = ffi.function_type(ffi.context_void_type(state.llvm_context$.ref()), param_types$.ref());
    list.ArrayList<ffi.Value> args! = list.ArrayList<ffi.Value>(1);
    args.add(pointer);
    return ffi.builder_build_call(state.builder$.ref(), free_type, free_fn, args$.ref());
}

Bool free_pointer_has_zero_sized_element(llvm_state.LowerState& state, qid.TypeId pointer_type) {
    if (llvm_type.type_is_owned_slice_value(state, pointer_type)) {
        return false;
    }
    if (llvm_type.type_is_trait_object_handle(state, pointer_type)) {
        return false;
    }
    qid.TypeId element = llvm_type.element_type(state, pointer_type);
    if (element == state.ctx.store.types.invalid_type()) {
        return false;
    }
    return llvm_type.layout_size(state, element) == 0;
}

public ffi.Value declare_malloc(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output
) {
    guard state.ctx.store.symbols.find(state.allocator.alloc_symbol)
        is .some(symbol_id) else {
        add_value_codegen_error(
            output,
            "allocator symbol was not prepared before LLVM lowering",
            "llvm_allocator_symbol_missing"
        );
        return ffi.Value();
    }
    if (output.external_function_indexes.get(symbol_id) is .some(existing)) {
        return output.external_function_values.get(existing$.get());
    }
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
    params.add(allocator_size_type(state));
    ffi.Type fn_type = ffi.function_type(ffi.context_pointer_type(state.llvm_context$.ref()), params$.ref());
    ffi.Value function = ffi.module_add_function(state.module$.ref(), state.allocator.alloc_symbol, fn_type);
    if (ffi.value_valid(function)) {
        output.external_function_indexes.set(symbol_id, output.external_function_values.len());
        output.external_function_values.add(function);
    }
    return function;
}

public ffi.Type allocator_size_type(llvm_state.LowerState& state) {
    return ffi.context_int_type(state.llvm_context$.ref(), allocator_size_bits(state));
}

Int allocator_size_bits(llvm_state.LowerState& state) {
    if (state.ctx.target.provider == .wasi) {
        return 32;
    }
    return state.ctx.query.layout.target().pointer_size * 8;
}

ffi.Value cast_allocator_size_value(llvm_state.LowerState& state, ffi.Value value) {
    Int target_bits = allocator_size_bits(state);
    Int source_bits = state.ctx.query.layout.target().pointer_size * 8;
    if (source_bits == target_bits) {
        return value;
    }
    if (source_bits > target_bits) {
        return ffi.builder_build_cast(state.builder$.ref(), 1, value, allocator_size_type(state));
    }
    return ffi.builder_build_cast(state.builder$.ref(), 0, value, allocator_size_type(state));
}

public ffi.Value declare_free(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output
) {
    guard state.ctx.store.symbols.find(state.allocator.free_symbol)
        is .some(symbol_id) else {
        add_value_codegen_error(
            output,
            "allocator symbol was not prepared before LLVM lowering",
            "llvm_allocator_symbol_missing"
        );
        return ffi.Value();
    }
    if (output.external_function_indexes.get(symbol_id) is .some(existing)) {
        return output.external_function_values.get(existing$.get());
    }
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(1);
    params.add(ffi.context_pointer_type(state.llvm_context$.ref()));
    ffi.Type fn_type = ffi.function_type(ffi.context_void_type(state.llvm_context$.ref()), params$.ref());
    ffi.Value function = ffi.module_add_function(state.module$.ref(), state.allocator.free_symbol, fn_type);
    if (ffi.value_valid(function)) {
        output.external_function_indexes.set(symbol_id, output.external_function_values.len());
        output.external_function_values.add(function);
    }
    return function;
}

ffi.Value lower_slice(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.SliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    qid.TypeId base_type = llvm_place.place_type(state, body, value.base);
    ffi.Value data_pointer = lower_slice_data_pointer(state, output, body, value, local_slots, base_type);
    ffi.Value start = lower_optional_bound_or_zero(state, output, body, value.start, local_slots);
    ffi.Value end = lower_slice_end(state, output, body, value, local_slots, base_type);
    if (!ffi.value_valid(data_pointer) || !ffi.value_valid(start) || !ffi.value_valid(end)) {
        return ffi.Value();
    }
    ffi.Value shifted_data = lower_slice_shifted_data(state, data_pointer, result_type, start);
    ffi.Value length = ffi.builder_build_binary(state.builder$.ref(), .int_sub, end, start);
    if (!ffi.value_valid(shifted_data) || !ffi.value_valid(length)) {
        return ffi.Value();
    }
    ffi.Value aggregate! = zero_aggregate(state, result_type);
    aggregate = insert_layout_field(state, result_type, aggregate, 0, shifted_data);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, 1, length);
}

ffi.Value lower_slice_data_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.SliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId base_type
) {
    if (llvm_type.type_is_slice(state, base_type)) {
        ffi.Value aggregate = llvm_place.lower_place_value(state, output, body, value.base, local_slots);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        return extract_layout_field(state, base_type, aggregate, 0);
    }
    if (llvm_type.type_is_owned_slice_value(state, base_type)) {
        ffi.Value aggregate = llvm_place.lower_place_value(state, output, body, value.base, local_slots);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        return extract_layout_field(state, base_type, aggregate, 0);
    }
    if (llvm_type.type_is_handle(state, base_type)) {
        return llvm_place.lower_place_value(state, output, body, value.base, local_slots);
    }
    return llvm_place.lower_place_pointer(state, output, body, value.base, local_slots);
}

ffi.Value lower_optional_bound_or_zero(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Operand? bound,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (bound is .some(operand)) {
        return lower_operand(state, output, body, operand, local_slots);
    }
    Int pointer_bits = state.ctx.query.layout.target().pointer_size * 8;
    return ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), pointer_bits), 0);
}

ffi.Value lower_slice_end(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.SliceRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId base_type
) {
    if (value.end is .some(end)) {
        return lower_operand(state, output, body, end, local_slots);
    }
    if (!llvm_type.type_is_slice(state, base_type) && !llvm_type.type_is_owned_slice_value(state, base_type)) {
        return ffi.Value();
    }
    ffi.Value aggregate = llvm_place.lower_place_value(state, output, body, value.base, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return extract_layout_field(state, base_type, aggregate, 1);
}

ffi.Value lower_slice_shifted_data(
    llvm_state.LowerState& state,
    ffi.Value data_pointer,
    qid.TypeId slice_type,
    ffi.Value start
) {
    qid.TypeId element_type = llvm_type.element_type(state, slice_type);
    ffi.Type element_llvm_type = llvm_type.lower_type(state, element_type);
    if (!ffi.type_valid(element_llvm_type)) {
        return ffi.Value();
    }
    list.ArrayList<ffi.Value> indices! = list.ArrayList<ffi.Value>(1);
    indices.add(start);
    return ffi.builder_build_gep(state.builder$.ref(), element_llvm_type, data_pointer, indices$.ref());
}

ffi.Value lower_len(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.LenRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, value.place);
    Int array_count = llvm_type.array_count(state, place_type_id);
    if (array_count >= 0) {
        return ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), 64), UInt64(array_count));
    }
    if (!llvm_type.type_is_slice(state, place_type_id)) {
        return ffi.Value();
    }
    ffi.Value aggregate = llvm_place.lower_place_value(state, output, body, value.place, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return extract_layout_field(state, place_type_id, aggregate, 1);
}

ffi.Value lower_discriminant(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.DiscriminantRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, value.place);
    if (llvm_type.layout_field_count(state, place_type_id) == 0) {
        return llvm_place.lower_place_value(state, output, body, value.place, local_slots);
    }
    ffi.Value place_pointer = llvm_place.lower_place_pointer(state, output, body, value.place, local_slots);
    if (!ffi.value_valid(place_pointer)) {
        return ffi.Value();
    }
    ffi.Value tag_pointer = lower_payload_storage_field_pointer(state, place_type_id, place_pointer, 0);
    if (!ffi.value_valid(tag_pointer)) {
        return ffi.Value();
    }
    ffi.Type tag_type = llvm_type.lower_type(state, llvm_type.constant_index_type(state, place_type_id, 0));
    if (!ffi.type_valid(tag_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), tag_type, tag_pointer);
}

public Bool lower_set_discriminant(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.SetDiscriminantStatement statement,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId place_type_id = llvm_place.place_type(state, body, statement.destination);
    if (llvm_type.layout_field_count(state, place_type_id) == 0) {
        return true;
    }
    ffi.Value aggregate! = llvm_place.lower_place_value(state, output, body, statement.destination, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return false;
    }
    ffi.Value tag = llvm_discriminant_value(state, statement.discriminant);
    aggregate = insert_layout_field(state, place_type_id, aggregate, 0, tag);
    if (!ffi.value_valid(aggregate)) {
        return false;
    }
    ffi.Value pointer = llvm_place.lower_place_pointer(state, output, body, statement.destination, local_slots);
    if (!ffi.value_valid(pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), aggregate, pointer));
}

ffi.Value llvm_discriminant_value(llvm_state.LowerState& state, Int discriminant) {
    ffi.Type tag_type = llvm_type.lower_type(state, state.ctx.store.types.int_type());
    if (!ffi.type_valid(tag_type)) {
        return ffi.Value();
    }
    return ffi.const_int(tag_type, UInt64(discriminant));
}

ffi.Value lower_aggregate(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AggregateRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (value.kind == .union_variant) {
        return lower_union_variant_aggregate(state, output, body, value, local_slots);
    }
    ffi.Type type = llvm_type.lower_type(state, value.type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    ffi.Value aggregate! = ffi.const_null(type);
    Int index! = 0;
    while (index < value.fields.length) {
        qid.TypeId field_type = llvm_type.constant_index_type(state, value.type_id, index);
        if (!llvm_type.type_has_abi_value(state, field_type)) {
            index = index + 1;
            continue;
        }
        ffi.Value field_value = lower_operand_as_type(
            state, output, body, value.fields[index], local_slots, field_type
        );
        if (!ffi.value_valid(field_value)) {
            return ffi.Value();
        }
        aggregate = insert_layout_field(state, value.type_id, aggregate, index, field_value);
        if (!ffi.value_valid(aggregate)) {
            return ffi.Value();
        }
        index = index + 1;
    }
    return aggregate;
}

ffi.Value lower_union_variant_aggregate(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.AggregateRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value aggregate! = zero_aggregate(state, value.type_id);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }

    guard value.tag is .some(tag_operand) else {
        return ffi.Value();
    }
    ffi.Value tag = lower_operand(state, output, body, tag_operand, local_slots);
    if (!ffi.value_valid(tag)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, value.type_id, aggregate, 0, tag);
    if (!ffi.value_valid(aggregate) || value.fields.length == 0) {
        return aggregate;
    }
    if (value.fields.length != 1) {
        return ffi.Value();
    }
    if (value.payload_field_index < 0) {
        return ffi.Value();
    }
    qid.TypeId payload_type = llvm_type.constant_index_type(state, value.type_id, value.payload_field_index);
    if (!llvm_type.type_has_abi_value(state, payload_type)) {
        return aggregate;
    }
    ffi.Value payload = lower_operand(state, output, body, value.fields[0], local_slots);
    return insert_layout_field(state, value.type_id, aggregate, value.payload_field_index, payload);
}

ffi.Value lower_optional(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.OptionalRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value.op == .make_none) {
        return zero_aggregate(state, result_type);
    }
    if (value.op == .make_some) {
        return lower_make_some(state, output, body, value, local_slots, result_type);
    }
    qid.TypeId value_type = operand_type(state, body, value.value);
    if (operand_place(value.value) is .some(source_place)) {
        ffi.Value source_pointer = llvm_place.lower_place_pointer(state, output, body, source_place, local_slots);
        if (!ffi.value_valid(source_pointer)) {
            return ffi.Value();
        }
        if (value.op == .is_some) {
            return load_layout_field(state, value_type, source_pointer, 0);
        }
        if (value.op == .unwrap_some) {
            qid.TypeId payload_type = llvm_type.element_type(state, value_type);
            if (type_should_copy_bytes(state, payload_type)) {
                add_value_codegen_error(
                    output,
                    "large optional payload must lower into a place",
                    "llvm_optional_large_payload_value_lower_failed"
                );
                return ffi.Value();
            }
            return load_layout_field(state, value_type, source_pointer, 1);
        }
    }
    ffi.Value aggregate = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate)) {
        add_value_codegen_error(output, "failed to lower LLVM optional operand", "llvm_optional_operand_lower_failed");
        return ffi.Value();
    }
    if (value.op == .is_some) {
        ffi.Value result = extract_layout_field(state, value_type, aggregate, 0);
        if (!ffi.value_valid(result)) {
            add_value_codegen_error(output, "failed to extract LLVM optional tag", "llvm_optional_tag_lower_failed");
        }
        return result;
    }
    if (value.op == .unwrap_some) {
        qid.TypeId payload_type = llvm_type.element_type(state, value_type);
        if (!llvm_type.type_has_abi_value(state, payload_type)) {
            return ffi.const_null(ffi.context_pointer_type(state.llvm_context$.ref()));
        }
        ffi.Value result = extract_layout_field(state, value_type, aggregate, 1);
        if (!ffi.value_valid(result)) {
            add_value_codegen_error(
                output,
                "failed to extract LLVM optional payload",
                "llvm_optional_payload_lower_failed"
            );
        }
        return result;
    }
    return ffi.Value();
}

ffi.Value lower_make_some(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.OptionalRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value aggregate! = zero_aggregate(state, result_type);
    ffi.Value payload = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate) || !ffi.value_valid(payload)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, result_type, aggregate, 0, bool_value(state, true));
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, 1, payload);
}

ffi.Value lower_error_union(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.ErrorUnionRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    if (value.op == .make_value) {
        return lower_make_error_union(state, output, body, value, local_slots, result_type, false, 1);
    }
    if (value.op == .make_error) {
        return lower_make_error_union(state, output, body, value, local_slots, result_type, true, 2);
    }
    ffi.Value aggregate = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    qid.TypeId source_type = operand_type(state, body, value.value);
    if (value.op == .is_error) {
        return extract_layout_field(state, source_type, aggregate, 0);
    }
    if (value.op == .unwrap_value) {
        return extract_layout_field(state, source_type, aggregate, 1);
    }
    if (value.op == .unwrap_error) {
        return extract_layout_field(state, source_type, aggregate, 2);
    }
    return ffi.Value();
}

ffi.Value lower_make_error_union(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.ErrorUnionRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type,
    Bool is_error,
    Int payload_field
) {
    ffi.Value aggregate! = zero_aggregate(state, result_type);
    ffi.Value payload = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(aggregate) || !ffi.value_valid(payload)) {
        return ffi.Value();
    }
    aggregate = insert_layout_field(state, result_type, aggregate, 0, bool_value(state, is_error));
    if (!ffi.value_valid(aggregate)) {
        return ffi.Value();
    }
    return insert_layout_field(state, result_type, aggregate, payload_field, payload);
}

ffi.Value lower_cast(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.CastRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value operand = lower_operand(state, output, body, value.value, local_slots);
    ffi.Type target_type = llvm_type.lower_type(state, value.target_type);
    if (!ffi.value_valid(operand) || !ffi.type_valid(target_type)) {
        return ffi.Value();
    }
    if (value.kind == .int_to_int) {
        return lower_int_cast(state, body, value.value, operand, target_type, value.target_type);
    }
    if (value.kind == .int_to_float) {
        return ffi.builder_build_cast(state.builder$.ref(), 2, operand, target_type);
    }
    if (value.kind == .float_to_int) {
        return ffi.builder_build_cast(state.builder$.ref(), 3, operand, target_type);
    }
    if (value.kind == .float_to_float) {
        return lower_float_cast(state, body, value.value, operand, target_type, value.target_type);
    }
    if (value.kind == .ptr_to_ptr) {
        return ffi.builder_build_cast(state.builder$.ref(), 6, operand, target_type);
    }
    if (value.kind == .ptr_to_int) {
        return ffi.builder_build_cast(state.builder$.ref(), 7, operand, target_type);
    }
    if (value.kind == .int_to_ptr) {
        return ffi.builder_build_cast(state.builder$.ref(), 8, operand, target_type);
    }
    if (value.kind == .bitcast) {
        return ffi.builder_build_cast(state.builder$.ref(), 9, operand, target_type);
    }
    return ffi.Value();
}

ffi.Value lower_int_cast(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.Operand operand,
    ffi.Value value,
    ffi.Type target_type,
    qid.TypeId target_type_id
) {
    qid.TypeId source_type = operand_type(state, body, operand);
    Int source_bits = llvm_type.int_type_bits(state, source_type);
    Int target_bits = llvm_type.int_type_bits(state, target_type_id);
    if (target_bits < source_bits) {
        return ffi.builder_build_cast(state.builder$.ref(), 1, value, target_type);
    }
    if (target_bits == source_bits) {
        return value;
    }
    if (integer_type_is_unsigned(state, source_type)) {
        return ffi.builder_build_cast(state.builder$.ref(), 10, value, target_type);
    }
    return ffi.builder_build_cast(state.builder$.ref(), 0, value, target_type);
}

ffi.Value lower_float_cast(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.Operand operand,
    ffi.Value value,
    ffi.Type target_type,
    qid.TypeId target_type_id
) {
    Int source_bits = llvm_type.float_type_bits(state, operand_type(state, body, operand));
    Int target_bits = llvm_type.float_type_bits(state, target_type_id);
    if (target_bits < source_bits) {
        return ffi.builder_build_cast(state.builder$.ref(), 5, value, target_type);
    }
    return ffi.builder_build_cast(state.builder$.ref(), 4, value, target_type);
}

ffi.Value lower_unary(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.UnaryRvalue value,
    list.ArrayList<ffi.Value>& local_slots,
    qid.TypeId result_type
) {
    ffi.Value operand = lower_operand(state, output, body, value.value, local_slots);
    if (!ffi.value_valid(operand)) {
        return ffi.Value();
    }
    if (value.op == .logic_not) {
        return lower_int_compare(state, 32, operand, zero_value(state, result_type));
    }
    if (value.op == .bit_not) {
        return ffi.builder_build_binary(state.builder$.ref(), .int_xor, operand, all_ones_value(state, result_type));
    }
    if (value.op == .neg) {
        return ffi.builder_build_binary(state.builder$.ref(), .int_sub, zero_value(state, result_type), operand);
    }
    return ffi.Value();
}

ffi.Value lower_binary(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.BinaryRvalue value,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId lhs_type = operand_type(state, body, value.lhs);
    qid.TypeId rhs_type = operand_type(state, body, value.rhs);
    qid.TypeId compare_type = binary_compare_type(state, lhs_type, rhs_type);
    ffi.Value lhs = lower_operand_as_type(state, output, body, value.lhs, local_slots, compare_type);
    ffi.Value rhs = lower_operand_as_type(state, output, body, value.rhs, local_slots, compare_type);
    if (!ffi.value_valid(lhs) || !ffi.value_valid(rhs)) {
        return ffi.Value();
    }
    if (type_is_float(state, compare_type)) {
        return lower_float_binary(state, value.op, lhs, rhs);
    }
    if (value.op == .eq || value.op == .ne) {
        guard int_predicate(state, value.op) is .some(predicate) else {
            return ffi.Value();
        }
        return lower_int_compare(state, predicate, lhs, rhs);
    }
    if (binary_op_code(state, value.op, compare_type) is .some(op)) {
        return ffi.builder_build_binary(state.builder$.ref(), op, lhs, rhs);
    }
    if (int_predicate_for_type(state, value.op, compare_type) is .some(predicate)) {
        return lower_int_compare(state, predicate, lhs, rhs);
    }
    return ffi.Value();
}

ffi.Value lower_float_binary(llvm_state.LowerState& state, jil.BinaryOp op, ffi.Value lhs, ffi.Value rhs) {
    if (float_binary_op_code(op) is .some(code)) {
        return ffi.builder_build_binary(state.builder$.ref(), code, lhs, rhs);
    }
    if (float_predicate(op) is .some(predicate)) {
        return ffi.builder_build_fcmp(state.builder$.ref(), predicate, lhs, rhs);
    }
    return ffi.Value();
}

qid.TypeId binary_compare_type(llvm_state.LowerState& state, qid.TypeId lhs_type, qid.TypeId rhs_type) {
    if (type_id_valid(lhs_type)) { return lhs_type; }
    if (type_id_valid(rhs_type)) { return rhs_type; }
    return state.ctx.store.types.invalid_type();
}

Bool type_id_valid(qid.TypeId type_id) {
    return type_id.to_index() >= 0;
}

ffi.Value lower_int_compare(llvm_state.LowerState& state, Int32 predicate, ffi.Value lhs, ffi.Value rhs) {
    return ffi.builder_build_icmp(state.builder$.ref(), predicate, lhs, rhs);
}

ffi.BinaryOp? binary_op_code(llvm_state.LowerState& state, jil.BinaryOp op, qid.TypeId operand_type) {
    if (op == .add) { return ffi.BinaryOp.int_add; }
    if (op == .sub) { return ffi.BinaryOp.int_sub; }
    if (op == .mul) { return ffi.BinaryOp.int_mul; }
    if (op == .div) {
        if (integer_type_is_unsigned(state, operand_type)) { return ffi.BinaryOp.int_unsigned_div; }
        return ffi.BinaryOp.int_signed_div;
    }
    if (op == .rem) {
        if (integer_type_is_unsigned(state, operand_type)) { return ffi.BinaryOp.int_unsigned_rem; }
        return ffi.BinaryOp.int_signed_rem;
    }
    if (op == .bit_and) { return ffi.BinaryOp.int_and; }
    if (op == .bit_or) { return ffi.BinaryOp.int_or; }
    if (op == .bit_xor) { return ffi.BinaryOp.int_xor; }
    if (op == .shl) { return ffi.BinaryOp.int_shift_left; }
    if (op == .shr) {
        if (integer_type_is_unsigned(state, operand_type)) { return ffi.BinaryOp.int_logical_shift_right; }
        return ffi.BinaryOp.int_arithmetic_shift_right;
    }
    return null;
}

ffi.BinaryOp? float_binary_op_code(jil.BinaryOp op) {
    if (op == .add) { return ffi.BinaryOp.float_add; }
    if (op == .sub) { return ffi.BinaryOp.float_sub; }
    if (op == .mul) { return ffi.BinaryOp.float_mul; }
    if (op == .div) { return ffi.BinaryOp.float_div; }
    if (op == .rem) { return ffi.BinaryOp.float_rem; }
    return null;
}

Int32? int_predicate_for_type(llvm_state.LowerState& state, jil.BinaryOp op, qid.TypeId operand_type) {
    if (integer_type_is_unsigned(state, operand_type)) {
        return unsigned_int_predicate(state, op);
    }
    return int_predicate(state, op);
}

Int32? int_predicate(llvm_state.LowerState& state, jil.BinaryOp op) {
    if (op == .eq) { return Int32(32); }
    if (op == .ne) { return Int32(33); }
    if (op == .gt) { return Int32(38); }
    if (op == .ge) { return Int32(39); }
    if (op == .lt) { return Int32(40); }
    if (op == .le) { return Int32(41); }
    return null;
}

Int32? unsigned_int_predicate(llvm_state.LowerState& state, jil.BinaryOp op) {
    if (op == .eq) { return Int32(32); }
    if (op == .ne) { return Int32(33); }
    if (op == .gt) { return Int32(34); }
    if (op == .ge) { return Int32(35); }
    if (op == .lt) { return Int32(36); }
    if (op == .le) { return Int32(37); }
    return null;
}

Int32? float_predicate(jil.BinaryOp op) {
    if (op == .eq) { return Int32(1); }
    if (op == .ne) { return Int32(6); }
    if (op == .gt) { return Int32(2); }
    if (op == .ge) { return Int32(3); }
    if (op == .lt) { return Int32(4); }
    if (op == .le) { return Int32(5); }
    return null;
}

Bool type_is_float(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    return info.data is .float_type(_);
}

Bool integer_type_is_unsigned(llvm_state.LowerState& state, qid.TypeId type_id) {
    // JIL 的 binary op 不编码 signedness；LLVM 指令选择必须回看 semantic type。
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .int_type(int_type) else { return false; }
    return !int_type.signed;
}

ffi.Value zero_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_int(type, 0);
}

ffi.Value all_ones_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_int(type, 18446744073709551615);
}

ffi.Value bool_value(llvm_state.LowerState& state, Bool value) {
    if (value) {
        return ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), 1), 1);
    }
    return ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), 1), 0);
}

ffi.Value zero_aggregate(llvm_state.LowerState& state, qid.TypeId type_id) {
    if (!llvm_type.type_has_abi_value(state, type_id)) {
        return ffi.Value();
    }
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    return ffi.const_null(type);
}

ffi.Value insert_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index,
    ffi.Value field_value
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    // 重叠 payload 不能用 insertvalue 直接写入；先落到临时 storage，
    // 再把具体 payload type store 到 payload byte 区起点。
    if (llvm_type.layout_field_uses_payload_storage(state, type_id, field_index)) {
        return insert_payload_storage_field(state, type_id, aggregate, field_index, field_value);
    }
    Int element_index = llvm_type.layout_field_element_index(state, type_id, field_index);
    return ffi.builder_build_insert_value(state.builder$.ref(), aggregate, field_value, element_index);
}

ffi.Value insert_payload_storage_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index,
    ffi.Value field_value
) {
    ffi.Type aggregate_type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(aggregate_type)) {
        return ffi.Value();
    }
    ffi.Value slot = ffi.builder_build_alloca(state.builder$.ref(), aggregate_type);
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), aggregate, slot))) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), field_value, field_pointer))) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), aggregate_type, slot);
}

ffi.Value lower_payload_storage_field_pointer(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index
) {
    list.ArrayList<ffi.Value> indices! = list.ArrayList<ffi.Value>(2);
    indices.add(ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), 32), 0));
    indices.add(ffi.const_int(
            ffi.context_int_type(state.llvm_context$.ref(), 32),
            UInt64(llvm_type.layout_field_element_index(state, type_id, field_index))
        )
    );
    return ffi.builder_build_gep(state.builder$.ref(), llvm_type.lower_type(state, type_id), slot, indices$.ref());
}

Bool store_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index,
    ffi.Value field_value
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return false;
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), field_value, field_pointer));
}

ffi.Value load_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value slot,
    Int field_index
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    qid.TypeId field_type = llvm_type.constant_index_type(state, type_id, field_index);
    ffi.Type llvm_field_type = llvm_type.lower_type(state, field_type);
    if (!ffi.type_valid(llvm_field_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), llvm_field_type, field_pointer);
}

ffi.Value extract_layout_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index
) {
    if (field_index >= llvm_type.layout_field_count(state, type_id)) {
        return ffi.Value();
    }
    if (llvm_type.layout_field_uses_payload_storage(state, type_id, field_index)) {
        return extract_payload_storage_field(state, type_id, aggregate, field_index);
    }
    Int element_index = llvm_type.layout_field_element_index(state, type_id, field_index);
    return ffi.builder_build_extract_value(state.builder$.ref(), aggregate, element_index);
}

ffi.Value extract_payload_storage_field(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value aggregate,
    Int field_index
) {
    ffi.Type aggregate_type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(aggregate_type)) {
        return ffi.Value();
    }
    ffi.Value slot = ffi.builder_build_alloca(state.builder$.ref(), aggregate_type);
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder$.ref(), aggregate, slot))) {
        return ffi.Value();
    }
    ffi.Value field_pointer = lower_payload_storage_field_pointer(state, type_id, slot, field_index);
    if (!ffi.value_valid(field_pointer)) {
        return ffi.Value();
    }
    qid.TypeId field_type = llvm_type.constant_index_type(state, type_id, field_index);
    ffi.Type llvm_field_type = llvm_type.lower_type(state, field_type);
    if (!ffi.type_valid(llvm_field_type)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), llvm_field_type, field_pointer);
}

public ffi.Value function_value_for_ref(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.FunctionRef value
) {
    symbol.BackendSymbolKey key =
        symbol.symbol_key_for_function_ref(state.ctx, state.store, value, false);
    std.String name = symbol.symbol_name(key);
    ffi.Value function = ensure_function_for_ref(state, output, value);
    if (ffi.value_valid(function)) {
        return function;
    }
    add_missing_function_error(
        state,
        output,
        jil.function_target_provenance_def(value.target),
        name.bytes()
    );
    return ffi.Value();
}

public ffi.Value ensure_function_for_ref(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.FunctionRef value
) {
    // unit object 只预声明自己的函数；跨 unit 直接引用在首次使用时补 external declaration。
    guard function_for_ref(state, value) is .some(function_id) else { return ffi.Value(); }
    jil.Function& function = state.store.program.functions.ref_at(function_id.to_index());
    std.String name = symbol.function_symbol_name(state.ctx, state.store, function);
    if (output.declared_function_index(function_id) is .some(index)) {
        return output.declared_function_values.get(index);
    }
    backend_abi.FunctionAbi function_abi! = backend_abi.classify_jil_body(state.ctx, function.body$.ref());
    ffi.Type function_type = llvm_abi.function_type(state, function_abi$.ref());
    if (!ffi.type_valid(function_type)) { return ffi.Value(); }
    ffi.Value llvm_function! = ffi.module_get_function(state.module$.ref(), name.bytes());
    if (!ffi.value_valid(llvm_function)) {
        llvm_function = ffi.module_add_function(state.module$.ref(), name.bytes(), function_type);
    }
    if (!ffi.value_valid(llvm_function)) { return ffi.Value(); }
    llvm_abi.add_function_attributes(state, llvm_function, function_abi$.ref());
    Int index = output.declared_function_values.len();
    output.bind_declared_function(function_id, index);
    output.declared_function_values.add(llvm_function);
    return llvm_function;
}

jil.FunctionId? function_for_ref(llvm_state.LowerState& state, jil.FunctionRef value) {
    jil.FunctionId? candidate = state.store.program.function_id_for_ref(value);
    if (candidate is .some(function_id)) {
        jil.Function& function = state.store.program.functions.ref_at(function_id.to_index());
        if (function_ref_matches(state, value, function)) { return function_id; }
    }
    return scan_function_for_ref(state, value);
}

jil.FunctionId? scan_function_for_ref(llvm_state.LowerState& state, jil.FunctionRef value) {
    symbol.BackendSymbolKey expected =
        symbol.symbol_key_for_function_ref(state.ctx, state.store, value, false);
    Int index! = 0;
    while (index < state.store.program.functions.len()) {
        jil.Function& function = state.store.program.functions.ref_at(index);
        symbol.BackendSymbolKey actual = symbol.function_symbol_key(state.ctx, function);
        if (symbol.BackendSymbolKey.equal(expected$.ref(), actual$.ref())) {
            return function.id;
        }
        index = index + 1;
    }
    return null;
}

Bool function_ref_matches(
    llvm_state.LowerState& state,
    jil.FunctionRef value,
    jil.Function& function
) {
    symbol.BackendSymbolKey expected =
        symbol.symbol_key_for_function_ref(state.ctx, state.store, value, false);
    symbol.BackendSymbolKey actual = symbol.function_symbol_key(state.ctx, function);
    return symbol.BackendSymbolKey.equal(expected$.ref(), actual$.ref());
}

Void add_missing_function_error(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    qid.DefId function_def,
    UInt8[]& name
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (state.ctx.store.source_map.def_span(function_def) is .some(loc)) {
        guard loc.source_id is .some(source_id) else {
            std.String message = string.concat("LLVM function symbol was not declared: ", name);
            add_value_codegen_error(
                output,
                message.bytes(),
                "llvm_function_symbol_missing"
            );
            return;
        }
        range = diagnostic.SourceRange(source_id, loc.span);
    }
    std.String message = string.concat("LLVM function symbol was not declared: ", name);
    output.add_diagnostic(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode("llvm_function_symbol_missing"),
            range,
            message.bytes()
        )
    );
}
