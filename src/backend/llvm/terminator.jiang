// MIR terminator -> LLVM terminator instruction lowering。
//
// terminator 是 CFG 的唯一出口。本文件只负责 block 之间的跳转、return、
// call terminator 等控制流指令，表达式值统一委托给 value helper。

import mir = "../../mir/mir.jiang";
import qid = "../../store/id.jiang";
import diagnostic = "../../diagnostic/diagnostic.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import symbol = "../symbol.jiang";
import backend_abi = "../abi.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_abi = "./abi.jiang";
import llvm_state = "./state.jiang";
import llvm_place = "./place.jiang";
import llvm_type = "./type.jiang";
import llvm_value = "./value.jiang";
import std;

public Bool lower_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    backend_abi.FunctionAbi& function_abi,
    ffi.Value llvm_function,
    mir.MirTerminator& terminator,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (terminator.kind is .goto_term(goto_term)) {
        return ffi.value_valid(ffi.builder_build_br(state.builder, blocks.get(goto_term.target.to_index())));
    }
    if (terminator.kind is .branch_term(branch_term)) {
        return lower_branch_terminator(state, body, branch_term, blocks, local_slots);
    }
    if (terminator.kind is .switch_term(switch_term)) {
        return lower_switch_terminator(state, body, switch_term, blocks, local_slots);
    }
    if (terminator.kind is .call_term(ref _ call_term)) {
        return lower_call_terminator(state, body, call_term, blocks, local_slots);
    }
    if (terminator.kind is .return_term(return_term)) {
        return lower_return_terminator(state, body, function_abi, llvm_function, return_term, local_slots);
    }
    if (terminator.kind is .unreachable_term(_)) {
        return ffi.value_valid(ffi.builder_build_unreachable(state.builder));
    }
    if (terminator.kind is .assert_term(assert_term)) {
        return lower_assert_terminator(state, body, llvm_function, assert_term, blocks, local_slots);
    }
    if (terminator.kind is .suspend_pending_term(_)) {
        return ffi.value_valid(ffi.builder_build_unreachable(state.builder));
    }
    return ffi.value_valid(ffi.builder_build_unreachable(state.builder));
}

Bool lower_branch_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirBranchTerminator branch_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value condition = llvm_value.lower_operand(state, body, branch_term.condition, local_slots);
    if (!ffi.value_valid(condition)) {
        return false;
    }
    return ffi.value_valid(
        ffi.builder_build_cond_br(
            state.builder,
            condition,
            blocks.get(branch_term.then_target.to_index()),
            blocks.get(branch_term.else_target.to_index())
        )
    );
}

Bool lower_switch_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirSwitchTerminator switch_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value discriminator = llvm_value.lower_operand(
        state,
        body,
        switch_term.discriminator,
        local_slots
    );
    if (!ffi.value_valid(discriminator)) {
        return false;
    }
    ffi.Value switch_value = ffi.builder_build_switch(
        state.builder,
        discriminator,
        blocks.get(switch_term.default_target.to_index()),
        switch_term.cases.length
    );
    if (!ffi.value_valid(switch_value)) {
        return false;
    }
    Int! index = 0;
    while (index < switch_term.cases.length) {
        mir.MirSwitchCase switch_case = switch_term.cases[index];
        ffi.Value case_value = llvm_value.lower_const(state, switch_case.value);
        if (!ffi.value_valid(case_value)) {
            return false;
        }
        ffi.switch_add_case(switch_value, case_value, blocks.get(switch_case.target.to_index()));
        index = index + 1;
    }
    return true;
}

Bool lower_call_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallTerminator& call_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_term.callee is .domain_enqueue(enqueue)) {
        return lower_domain_enqueue_call(state, body, call_term, enqueue, blocks, local_slots);
    }
    if (!call_callee_is_declared(state, call_term.callee)) {
        std.String message = call_callee_error_message(state, call_term.callee);
        add_backend_error(state, message.bytes(), "llvm_call_callee_not_declared");
        return false;
    }
    ffi.Value callee = lower_call_callee(state, body, call_term.callee, local_slots);
    if (!ffi.value_valid(callee)) {
        add_backend_error(state, "failed to lower call callee", "llvm_call_callee_lower_failed");
        return false;
    }
    qid.TypeId function_type_id = call_callee_type(state, body, call_term.callee);
    backend_abi.FunctionAbi! call_abi = backend_abi.classify_function_type(state.ctx, function_type_id);
    list.ArrayList<ffi.Value>! args = lower_call_args(state, body, call_term, call_abi$.ref(), local_slots);
    if (args.len() != call_abi.llvm_param_count()) {
        std.StringBuilder builder = std.StringBuilder();
        builder.append("failed to lower call arguments: lowered ");
        builder.append(args.len());
        builder.append(", expected ");
        builder.append(call_abi.llvm_param_count());
        builder.append(", MIR operands ");
        builder.append(Int(call_term.args.length));
        add_backend_error(state, builder$.move().into_string().bytes(), "llvm_call_args_lower_failed");
        return false;
    }
    qid.TypeId result_type = call_result_type(state, body, call_term);
    ffi.Type function_type = llvm_abi.function_type(state, call_abi$.ref());
    if (!ffi.type_valid(function_type)) {
        add_backend_error(state, "failed to lower call function type", "llvm_call_type_lower_failed");
        return false;
    }
    ffi.Value result = ffi.builder_build_call(state.builder, function_type, callee, args$.ref());
    if (!ffi.value_valid(result)) {
        add_backend_error(state, "failed to build llvm call", "llvm_call_build_failed");
        return false;
    }
    llvm_abi.add_call_attributes(state, result, call_abi$.ref());
    if (!store_call_result(state, body, call_term.destination, result, result_type, call_abi$.ref(), local_slots)) {
        add_backend_error(state, "failed to store call result", "llvm_call_result_store_failed");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(state.builder, blocks.get(call_term.target.to_index())));
}

Bool lower_domain_enqueue_call(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallTerminator& call_term,
    mir.MirDomainEnqueueCallee enqueue,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_term.args.length != 1) {
        add_backend_error(state, "domain enqueue requires one context operand", "llvm_domain_enqueue_arity");
        return false;
    }
    ffi.Value context_value = llvm_value.lower_operand(state, body, call_term.args[0], local_slots);
    ffi.Value resume = llvm_value.lower_operand(state, body, enqueue.resume, local_slots);
    ffi.Value runtime = ffi.module_get_function(state.module, "__jiang_domain_enqueue");
    if (!ffi.value_valid(context_value) || !ffi.value_valid(resume) || !ffi.value_valid(runtime)) {
        add_backend_error(state, "failed to lower domain enqueue operands", "llvm_domain_enqueue_operand");
        return false;
    }
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context);
    ffi.Type domain_type = ffi.context_int_type(state.llvm_context, 64);
    list.ArrayList<ffi.Type>! params = list.ArrayList<ffi.Type>(3);
    params.add(domain_type);
    params.add(pointer_type);
    params.add(pointer_type);
    ffi.Type runtime_type = ffi.function_type(ffi.context_void_type(state.llvm_context), params$.ref());
    list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(3);
    args.add(ffi.const_int(domain_type, UInt64(enqueue.domain_def.to_index())));
    args.add(context_value);
    args.add(resume);
    ffi.Value call = ffi.builder_build_call(state.builder, runtime_type, runtime, args$.ref());
    if (!ffi.value_valid(call)) {
        add_backend_error(state, "failed to call domain enqueue runtime", "llvm_domain_enqueue_call");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_br(state.builder, blocks.get(call_term.target.to_index())));
}

Bool lower_assert_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    ffi.Value llvm_function,
    mir.MirAssertTerminator assert_term,
    list.ArrayList<ffi.BasicBlock>& blocks,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value condition = llvm_value.lower_operand(state, body, assert_term.condition, local_slots);
    if (!ffi.value_valid(condition)) {
        return false;
    }
    ffi.BasicBlock target = blocks.get(assert_term.target.to_index());
    ffi.BasicBlock fail_block = ffi.context_append_block(
        state.llvm_context,
        llvm_function,
        "assert_fail"
    );
    if (!ffi.block_valid(fail_block)) {
        return false;
    }
    if (!build_assert_branch(state, assert_term.expected, condition, target, fail_block)) {
        return false;
    }
    ffi.builder_position_at_end(state.builder, fail_block);
    return ffi.value_valid(ffi.builder_build_unreachable(state.builder));
}

Bool build_assert_branch(
    llvm_state.LowerState& state,
    Bool expected,
    ffi.Value condition,
    ffi.BasicBlock target,
    ffi.BasicBlock fail_block
) {
    if (expected) {
        return ffi.value_valid(ffi.builder_build_cond_br(state.builder, condition, target, fail_block));
    }
    return ffi.value_valid(ffi.builder_build_cond_br(state.builder, condition, fail_block, target));
}

ffi.Value lower_call_callee(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallCallee callee,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (callee is .direct_function(function_value)) {
        return llvm_value.function_value_for_ref(state, function_value);
    }
    if (callee is .indirect_operand(operand)) {
        return llvm_value.lower_operand(state, body, operand, local_slots);
    }
    if (callee is .domain_enqueue(enqueue)) {
        return llvm_value.lower_operand(state, body, enqueue.resume, local_slots);
    }
    return ffi.Value();
}

Bool call_callee_is_declared(llvm_state.LowerState& state, mir.MirCallCallee callee) {
    if (callee is .indirect_operand(_) || callee is .domain_enqueue(_)) {
        return true;
    }
    guard callee is .direct_function(function_value) else { return false; }
    symbol.BackendSymbolKey key = symbol.symbol_key_for_def(
        state.ctx,
        function_value.function_def,
        function_value.type_args,
        function_value.const_args,
        false,
        function_value.coroutine_resume,
        function_value.coroutine_completion
    );
    return table.hash_table_get_value<symbol.BackendSymbolKey, Int>(
        state.declared_function_indexes,
        key
    ) != null;
}

std.String call_callee_error_message(llvm_state.LowerState& state, mir.MirCallCallee callee) {
    if (callee is .indirect_operand(_)) {
        return std.String("indirect call callee is not a declared function");
    }
    if (callee is .domain_enqueue(_)) {
        return std.String("domain enqueue resume function is not callable");
    }
    guard callee is .direct_function(function_value) else {
        return std.String("call callee is not a function reference");
    }
    symbol.BackendSymbolKey key = symbol.symbol_key_for_def(
        state.ctx,
        function_value.function_def,
        function_value.type_args,
        function_value.const_args,
        false,
        function_value.coroutine_resume,
        function_value.coroutine_completion
    );
    std.String symbol_name = symbol.symbol_name(key);
    qid.SymbolId name = state.ctx.store.defs.get(function_value.function_def).name.symbol;
    UInt8[]& source_name = state.ctx.store.symbols.text(name);
    return call_callee_message_with_args(state, symbol_name.bytes(), source_name, function_value.type_args);
}

std.String call_callee_message_with_args(
    llvm_state.LowerState& state,
    UInt8[]& symbol_name,
    UInt8[]& source_name,
    qid.TypeId[]& type_args
) {
    std.String! message = call_callee_base_message(symbol_name, source_name);
    if (type_args.length == 0) {
        return message$.move();
    }
    message = append_text(message$.move(), " type_args=");
    Int! index = 0;
    while (index < type_args.length) {
        if (index > 0) {
            message = append_text(message$.move(), ",");
        }
        message = append_text(message$.move(), type_arg_message_text(state, type_args[index]));
        index = index + 1;
    }
    return message$.move();
}

std.String call_callee_base_message(UInt8[]& symbol_name, UInt8[]& source_name) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("call callee is not declared: ");
    builder.append(symbol_name);
    builder.append(" ");
    builder.append(source_name);
    return builder$.move().into_string();
}

std.String append_text(std.String prefix, UInt8[]& text) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix.bytes());
    builder.append(text);
    return builder$.move().into_string();
}

UInt8[]& type_arg_message_text(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .named(named)) {
        qid.SymbolId symbol = state.ctx.store.defs.get(named.def_id).name.symbol;
        return state.ctx.store.symbols.text(symbol);
    }
    return "type";
}

() add_backend_error(llvm_state.LowerState& state, UInt8[]& message, UInt8[]& code) {
    state.ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

list.ArrayList<ffi.Value> lower_call_args(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallTerminator& call_term,
    backend_abi.FunctionAbi& call_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    list.ArrayList<ffi.Value>! args = list.ArrayList<ffi.Value>(call_abi.llvm_param_count());
    if (call_abi.result.is_indirect()) {
        ffi.Value result_pointer = llvm_place.lower_place_pointer(state, body, call_term.destination, local_slots);
        if (!ffi.value_valid(result_pointer)) {
            return args$.move();
        }
        args.add(result_pointer);
    }
    Int! index = 0;
    while (index < call_term.args.length) {
        backend_abi.AbiArg param_abi = call_abi.params.get(index);
        if (param_abi.kind == .none) {
            index = index + 1;
            continue;
        }
        mir.MirOperand& operand = call_term.args[index]$.ref();
        ffi.Value arg = lower_call_arg(state, body, operand, param_abi, local_slots);
        if (!ffi.value_valid(arg)) {
            add_call_arg_error(state, operand);
            return args$.move();
        }
        args.add(arg);
        index = index + 1;
    }
    return args$.move();
}

ffi.Value lower_call_arg(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirOperand& operand,
    backend_abi.AbiArg param_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, body, out_operand.place, local_slots);
    }
    if (param_abi.kind == .indirect) {
        // indirect 参数的 ABI 形态是指针，传入 place 指针即可；临时 rvalue 才需要
        // 先落到 stack slot。
        return lower_indirect_call_arg(state, body, operand, param_abi.type_id, local_slots);
    }
    if (should_pass_reference_place_pointer(state, body, operand, param_abi.type_id)) {
        guard operand_place(operand) is .some(place) else {
            return lower_call_arg_value(state, body, operand, local_slots);
        }
        return llvm_place.lower_place_pointer(state, body, place, local_slots);
    }
    return lower_call_arg_value(state, body, operand, local_slots);
}

ffi.Value lower_indirect_call_arg(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirOperand& operand,
    qid.TypeId param_type,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand_place(operand) is .some(place)) {
        ffi.Value pointer = llvm_place.lower_place_pointer(state, body, place, local_slots);
        if (!ffi.value_valid(pointer)) {
            add_backend_error(state, "failed to lower indirect LLVM call argument place", "llvm_indirect_call_arg_place_lower_failed");
        }
        return pointer;
    }
    ffi.Value value = lower_call_arg_value(state, body, operand, local_slots);
    if (!ffi.value_valid(value)) {
        return ffi.Value();
    }
    ffi.Type value_type = llvm_type.lower_type(state, param_type);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    ffi.Value temp = ffi.builder_build_alloca(state.builder, value_type);
    if (!ffi.value_valid(temp)) {
        return ffi.Value();
    }
    if (!ffi.value_valid(ffi.builder_build_store(state.builder, value, temp))) {
        return ffi.Value();
    }
    return temp;
}

ffi.Value lower_call_arg_value(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirOperand& operand,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (operand is .const_operand(const_value)) {
        return llvm_value.lower_const(state, const_value);
    }
    if (operand is .function_operand(function_value)) {
        return llvm_value.function_value_for_ref(state, function_value);
    }
    if (operand is .global_operand(global_value)) {
        return llvm_value.global_value_for_ref(state, global_value);
    }
    if (operand is .global_address_operand(global_value)) {
        return llvm_value.global_address_for_ref(state, global_value);
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.lower_place_value(state, body, copy_operand.place, local_slots);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.lower_place_value(state, body, move_operand.place, local_slots);
    }
    if (operand is .out_operand(out_operand)) {
        return llvm_place.lower_place_pointer(state, body, out_operand.place, local_slots);
    }
    return ffi.Value();
}

Bool should_pass_reference_place_pointer(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirOperand& operand,
    qid.TypeId param_type
) {
    if (!type_is_reference(state, param_type)) {
        return false;
    }
    if (type_is_reference(state, call_arg_operand_type(state, body, operand))) {
        return false;
    }
    return operand_place(operand) != null;
}

qid.TypeId call_arg_operand_type(llvm_state.LowerState& state, mir.MirBody& body, mir.MirOperand& operand) {
    if (operand is .const_operand(const_value)) {
        return const_value.type_id;
    }
    if (operand is .function_operand(function_value)) {
        return function_value.type_id;
    }
    if (operand is .global_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .global_address_operand(global_value)) {
        return global_value.type_id;
    }
    if (operand is .copy_operand(copy_operand)) {
        return llvm_place.place_type(state, body, copy_operand.place);
    }
    if (operand is .move_operand(move_operand)) {
        return llvm_place.place_type(state, body, move_operand.place);
    }
    return state.ctx.store.types.invalid_type();
}

mir.MirPlace? operand_place(mir.MirOperand& operand) {
    if (operand is .copy_operand(copy_operand)) {
        return copy_operand.place;
    }
    if (operand is .move_operand(move_operand)) {
        return move_operand.place;
    }
    if (operand is .out_operand(out_operand)) {
        return out_operand.place;
    }
    return null;
}

Bool type_is_reference(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .handle_type(handle) else { return false; }
    return handle.kind == .reference;
}

() add_call_arg_error(llvm_state.LowerState& state, mir.MirOperand& operand) {
    if (operand is .const_operand(_)) {
        add_backend_error(state, "failed to lower LLVM const call argument", "llvm_call_const_arg_lower_failed");
        return;
    }
    if (operand is .copy_operand(_)) {
        add_backend_error(state, "failed to lower LLVM copy call argument", "llvm_call_copy_arg_lower_failed");
        return;
    }
    if (operand is .move_operand(_)) {
        add_backend_error(state, "failed to lower LLVM move call argument", "llvm_call_move_arg_lower_failed");
        return;
    }
    if (operand is .out_operand(_)) {
        add_backend_error(state, "failed to lower LLVM out call argument", "llvm_call_out_arg_lower_failed");
        return;
    }
    if (operand is .function_operand(_)) {
        add_backend_error(state, "failed to lower LLVM function call argument", "llvm_call_function_arg_lower_failed");
        return;
    }
    if (operand is .global_operand(_)) {
        add_backend_error(state, "failed to lower LLVM global call argument", "llvm_call_global_arg_lower_failed");
        return;
    }
    if (operand is .global_address_operand(_)) {
        add_backend_error(state, "failed to lower LLVM global address call argument", "llvm_call_global_address_arg_lower_failed");
        return;
    }
    add_backend_error(state, "failed to lower LLVM call argument", "llvm_call_arg_lower_failed");
}

qid.TypeId call_result_type(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallTerminator& call_term
) {
    qid.TypeId function_type_id = call_callee_type(state, body, call_term.callee);
    if (state.ctx.store.types.get(function_type_id).data is .function_type(function_info)) {
        return function_info.result;
    }
    return local_type(state, body, call_term.destination.local_id);
}

qid.TypeId call_callee_type(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirCallCallee callee
) {
    if (callee is .direct_function(function_value)) {
        return function_value.type_id;
    }
    if (callee is .indirect_operand(operand)) {
        return llvm_value.operand_type(state, body, operand);
    }
    if (callee is .domain_enqueue(enqueue)) {
        return llvm_value.operand_type(state, body, enqueue.resume);
    }
    return state.ctx.store.types.invalid_type();
}

Bool store_call_result(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    mir.MirPlace destination,
    ffi.Value result,
    qid.TypeId result_type,
    backend_abi.FunctionAbi& call_abi,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (call_abi.result.is_indirect()) {
        return true;
    }
    if (llvm_type.type_is_unit_or_never(state, result_type)) {
        return true;
    }
    ffi.Value pointer = llvm_place.lower_place_pointer(state, body, destination, local_slots);
    if (!ffi.value_valid(pointer)) {
        return false;
    }
    return ffi.value_valid(ffi.builder_build_store(state.builder, result, pointer));
}

Bool lower_return_terminator(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    backend_abi.FunctionAbi& function_abi,
    ffi.Value llvm_function,
    mir.MirReturnTerminator return_term,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (return_term.implicit_unit) {
        return ffi.value_valid(ffi.builder_build_return_void(state.builder));
    }
    qid.TypeId return_type = local_type(state, body, body.return_local);
    if (function_abi.result.kind == .none || !llvm_type.type_has_abi_value(state, return_type)) {
        return ffi.value_valid(ffi.builder_build_return_void(state.builder));
    }
    if (function_abi.result.is_indirect()) {
        return lower_indirect_return_value(state, body, llvm_function, local_slots);
    }
    return lower_return_value(state, body, local_slots);
}

Bool lower_indirect_return_value(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    ffi.Value llvm_function,
    list.ArrayList<ffi.Value>& local_slots
) {
    mir.MirLocalDecl return_local = body.locals[body.return_local.to_index()];
    ffi.Value source_pointer = local_slots.get(return_local.id.to_index());
    if (!ffi.value_valid(source_pointer)) {
        add_backend_error(state, "failed to lower LLVM indirect return source", "llvm_indirect_return_source_lower_failed");
        return false;
    }
    ffi.Value return_pointer = ffi.function_param(llvm_function, 0);
    // sret 返回值同样是调用方提供的指针，按布局字节复制 return local。
    if (!copy_return_bytes(state, return_local.type_id, source_pointer, return_pointer)) {
        add_backend_error(state, "failed to copy LLVM indirect return value", "llvm_indirect_return_copy_failed");
        return false;
    }
    return ffi.value_valid(ffi.builder_build_return_void(state.builder));
}

Bool copy_return_bytes(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    ffi.Value source_pointer,
    ffi.Value destination_pointer
) {
    ffi.Type size_type = ffi.context_int_type(state.llvm_context, state.ctx.store.layouts.target.pointer_size * 8);
    ffi.Value size = ffi.const_int(size_type, UInt64(llvm_type.layout_size(state, type_id)));
    Int align = llvm_type.layout_align(state, type_id);
    return ffi.value_valid(ffi.builder_build_memcpy(
            state.builder,
            destination_pointer,
            align,
            source_pointer,
            align,
            size
        )
    );
}

Bool lower_return_value(
    llvm_state.LowerState& state,
    mir.MirBody& body,
    list.ArrayList<ffi.Value>& local_slots
) {
    mir.MirLocalDecl return_local = body.locals[body.return_local.to_index()];
    ffi.Value llvm_value = llvm_place.lower_local_load(state, return_local, local_slots);
    if (!ffi.value_valid(llvm_value)) {
        add_backend_error(state, "failed to load LLVM return value", "llvm_return_value_load_failed");
        return false;
    }
    if (!ffi.value_valid(ffi.builder_build_return(state.builder, llvm_value))) {
        add_backend_error(state, "failed to build LLVM return", "llvm_return_build_failed");
        return false;
    }
    return true;
}

qid.TypeId local_type(llvm_state.LowerState& state, mir.MirBody& body, mir.MirLocalId local_id) {
    return body.locals[local_id.to_index()].type_id;
}
