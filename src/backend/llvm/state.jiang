// LLVM lowering 共享状态。
//
// type/place/value/terminator lowering 都需要访问同一组 LLVM handle。
// 这些 helper 本身不拥有状态，只通过 LowerState 读取编译上下文并发出 LLVM C API 调用。

import context = "../../context.jiang";
import qid = "../../store/id.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import system_memory = "../../system/memory.jiang";
import symbol = "../symbol.jiang";
import ffi = "./ffi.jiang";

public struct LowerState {
    public context.CompilerContext& ctx;
    public ffi.Context& llvm_context;
    public ffi.Module& module;
    public ffi.Builder& builder;
    public table.HashTable<symbol.BackendSymbolKey, Int>& declared_function_indexes;
    public list.ArrayList<ffi.Value>& declared_function_values;
    public table.HashTable<qid.SymbolId, Int>& external_function_indexes;
    public list.ArrayList<ffi.Value>& external_function_values;
    public system_memory.Allocator allocator;
    public init(self,
        context.CompilerContext& ctx,
        ffi.Context& llvm_context,
        ffi.Module& module,
        ffi.Builder& builder,
        table.HashTable<symbol.BackendSymbolKey, Int>& declared_function_indexes,
        list.ArrayList<ffi.Value>& declared_function_values,
        table.HashTable<qid.SymbolId, Int>& external_function_indexes,
        list.ArrayList<ffi.Value>& external_function_values,
        system_memory.Allocator allocator
    ) {
        self.ctx = ctx;
        self.llvm_context = llvm_context;
        self.module = module;
        self.builder = builder;
        self.declared_function_indexes = declared_function_indexes;
        self.declared_function_values = declared_function_values;
        self.external_function_indexes = external_function_indexes;
        self.external_function_values = external_function_values;
        self.allocator = allocator;
    }
}
