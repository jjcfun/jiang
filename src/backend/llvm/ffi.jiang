public struct Type {
    public LLVMType*?! raw;
    public Bool! valid;

    public init(self) {
        self.raw = null;
        self.valid = false;
    }

    public init(self, LLVMType* raw) {
        self.raw = raw;
        self.valid = unsafe {
            raw$.as(Int) != 0
        };
    }
}

public Bool type_valid(Type value) {
    return value.valid;
}

public struct Value {
    public LLVMValue*?! raw;
    public Bool! valid;

    public init(self) {
        self.raw = null;
        self.valid = false;
    }

    public init(self, LLVMValue* raw) {
        self.raw = raw;
        self.valid = unsafe {
            raw$.as(Int) != 0
        };
    }
}

public Bool value_valid(Value value) {
    return value.valid;
}

public struct BasicBlock {
    public LLVMBasicBlock*?! raw;
    public Bool! valid;

    public init(self) {
        self.raw = null;
        self.valid = false;
    }

    public init(self, LLVMBasicBlock* raw) {
        self.raw = raw;
        self.valid = unsafe {
            raw$.as(Int) != 0
        };
    }
}

public Bool block_valid(BasicBlock value) {
    return value.valid;
}

public struct Context {
    public LLVMContext*?! raw;

    public init(self) {
        self.raw = unsafe {
            LLVMContextCreate()
        };
    }
}

public Bool context_valid(Context& context) {
    return context.raw != null;
}

public () context_dispose(Context& context) {
    if (context_valid(context)) {
        unsafe {
            LLVMContextDispose(context.raw$.some());
        }
        context.raw = null;
    }
}

public Type context_void_type(Context& context) {
    return unsafe {
        Type(LLVMVoidTypeInContext(context.raw$.some()))
    };
}

public Type context_int_type(Context& context, Int bits) {
    return unsafe {
        Type(LLVMIntTypeInContext(context.raw$.some(), UInt32(bits)))
    };
}

public Type context_half_type(Context& context) {
    return unsafe {
        Type(LLVMHalfTypeInContext(context.raw$.some()))
    };
}

public Type context_float_type(Context& context) {
    return unsafe {
        Type(LLVMFloatTypeInContext(context.raw$.some()))
    };
}

public Type context_double_type(Context& context) {
    return unsafe {
        Type(LLVMDoubleTypeInContext(context.raw$.some()))
    };
}

public Type context_pointer_type(Context& context) {
    return unsafe {
        Type(LLVMPointerTypeInContext(context.raw$.some(), 0))
    };
}

public Type global_value_type(Value value) {
    return unsafe { Type(LLVMGlobalGetValueType(value.raw$.some())) };
}

public Type context_struct_type(Context& context, list.ArrayList<Type>& element_types) {
    Int count = element_types.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    unsafe {
        LLVMType*![*] raw_elements = LLVMType*$.alloc_many(capacity);
        Int! index = 0;
        while (index < count) {
            raw_elements[index] = element_types.get(index).raw$.some();
            index = index + 1;
        }
        Type result = Type(LLVMStructTypeInContext(
            context.raw$.some(),
            raw_elements$.as(LLVMType*[*]),
            UInt32(count),
            // Layout lowering 已经显式插入 padding byte，LLVM struct 必须 packed。
            1
        ));
        raw_elements$.dealloc();
        return result;
    }
}

public Type array_type(Type element_type, Int element_count) {
    return unsafe {
        Type(LLVMArrayType(element_type.raw$.some(), UInt32(element_count)))
    };
}

public BasicBlock context_append_block(Context& context, Value function, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    unsafe {
        BasicBlock result = BasicBlock(
            LLVMAppendBasicBlockInContext(context.raw$.some(), function.raw$.some(), c_name)
        );
        c_name$.dealloc();
        return result;
    }
}

public struct Module {
    public LLVMModule*?! raw;

    public init(self, Context& context, UInt8[]& name) {
        UInt8[*:0] c_name = c_string_buffer(name);
        unsafe {
            self.raw = LLVMModuleCreateWithNameInContext(c_name, context.raw$.some());
            c_name$.dealloc();
        }
    }
}

public Bool module_valid(Module& module) {
    return module.raw != null;
}

public () module_dispose(Module& module) {
    if (module_valid(module)) {
        unsafe {
            LLVMDisposeModule(module.raw$.some());
        }
        module.raw = null;
    }
}

public () module_set_target(Module& module, UInt8[*:0] triple) {
    unsafe {
        LLVMSetTarget(module.raw$.some(), triple);
    }
}

public () module_set_data_layout(Module& module, UInt8[*:0] data_layout) {
    unsafe {
        LLVMSetDataLayout(module.raw$.some(), data_layout);
    }
}

public () module_set_target_text(Module& module, UInt8[]& triple) {
    UInt8[*:0] c_triple = c_string_buffer(triple);
    module_set_target(module, c_triple);
    unsafe {
        c_triple$.dealloc();
    }
}

public Bool module_set_target_data_layout_text(Module& module, UInt8[]& triple) {
    // LLVM IR 需要同时带 target triple 和 datalayout。只设置 triple 时，
    // object emission 仍可能靠 TargetMachine 工作，但 IR 文件本身缺少目标布局，
    // 后续跨 target 复用/缓存时容易退回 host 假设。
    TargetMachine! target_machine = TargetMachine();
    Bool ok = target_machine.init_for_module(module, 0, triple);
    target_machine.dispose();
    return ok;
}

public std.String llvm_version_text() {
    unsafe {
        UInt32![*] major = UInt32!$.alloc_many(1);
        UInt32![*] minor = UInt32!$.alloc_many(1);
        UInt32![*] patch = UInt32!$.alloc_many(1);
        LLVMGetVersion(major$.as(UInt32[*]), minor$.as(UInt32[*]), patch$.as(UInt32[*]));
        std.StringBuilder builder = std.StringBuilder();
        builder.append(Int(major[0]));
        builder.append(".");
        builder.append(Int(minor[0]));
        builder.append(".");
        builder.append(Int(patch[0]));
        std.String text = builder$.move().into_string();
        major$.dealloc();
        minor$.dealloc();
        patch$.dealloc();
        return text$.move();
    }
}

public UInt8[]& default_target_triple_text() {
    unsafe {
        UInt8[*:0] raw = LLVMGetDefaultTargetTriple();
        if (raw == null) {
            return "";
        }
        UInt8[]& text = c_string_copy(raw);
        LLVMDisposeMessage(raw);
        return text;
    }
}

public Bool module_emit_object(
    Module& module,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    UInt8[]& target_triple
) {
    TargetMachine! target_machine = TargetMachine();
    if (!target_machine.init_for_module(module, opt_level, target_triple)) {
        return false;
    }
    Bool! ok = true;
    if (pass_pipeline.length > 0) {
        ok = target_machine.run_passes(module, pass_pipeline);
    }
    if (ok) {
        UInt8[*:0] c_output_path = c_string_buffer(output_path);
        ok = target_machine.emit_object(module, c_output_path);
        unsafe {
            c_output_path$.dealloc();
        }
    }
    target_machine.dispose();
    return ok;
}

public Bool module_emit_llvm_ir(Module& module, UInt8[]& output_path) {
    UInt8[*:0]![*] error_slot;
    UInt8[*:0] c_output_path = c_string_buffer(output_path);
    Int32 result;
    unsafe {
        error_slot = UInt8[*:0]$.alloc_many(1);
        result = LLVMPrintModuleToFile(module.raw$.some(), c_output_path, error_slot$.as(UInt8[*:0][*]));
        c_output_path$.dealloc();
        error_slot$.dealloc();
    }
    return result == 0;
}

public UInt8[]&? module_llvm_ir_text(Module& module) {
    unsafe {
        UInt8[*:0] raw = LLVMPrintModuleToString(module.raw$.some());
        if (raw == null) {
            return null;
        }
        Int length = c_string_length(raw);
        UInt8![*] bytes = UInt8!$.alloc_many(length + 1);
        Int! index = 0;
        while (index < length) {
            bytes[index] = raw[index];
            index = index + 1;
        }
        bytes[length] = 0;
        LLVMDisposeMessage(raw);
        UInt8[*:0] frozen = bytes$.as(UInt8[*:0]);
        return frozen[0..length];
    }
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

UInt8[]& c_string_copy(UInt8[*:0] raw) {
    unsafe {
        Int length = c_string_length(raw);
        UInt8![*] bytes = UInt8!$.alloc_many(length + 1);
        Int! index = 0;
        while (index < length) {
            bytes[index] = raw[index];
            index = index + 1;
        }
        bytes[length] = 0;
        UInt8[*:0] frozen = bytes$.as(UInt8[*:0]);
        return frozen[0..length];
    }
}

// LLVM 的 NativeTarget helper 是 C header 便利层，不一定作为动态符号导出。
// FFI 只能声明真实导出的 target-specific 初始化函数。
() init_supported_targets() {
    unsafe {
        LLVMInitializeAArch64TargetInfo();
        LLVMInitializeAArch64Target();
        LLVMInitializeAArch64TargetMC();
        LLVMInitializeAArch64AsmParser();
        LLVMInitializeAArch64AsmPrinter();
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        LLVMInitializeX86AsmParser();
        LLVMInitializeX86AsmPrinter();
        LLVMInitializeWebAssemblyTargetInfo();
        LLVMInitializeWebAssemblyTarget();
        LLVMInitializeWebAssemblyTargetMC();
        LLVMInitializeWebAssemblyAsmPrinter();
    }
}

public Value module_add_function(Module& module, UInt8[]& name, Type function_type) {
    UInt8[*:0] c_name = c_string_buffer(name);
    unsafe {
        Value result = Value(LLVMAddFunction(module.raw$.some(), c_name, function_type.raw$.some()));
        c_name$.dealloc();
        return result;
    }
}

public Value module_add_global(Module& module, UInt8[]& name, Type type) {
    UInt8[*:0] c_name = c_string_buffer(name);
    unsafe {
        Value result = Value(LLVMAddGlobal(module.raw$.some(), type.raw$.some(), c_name));
        c_name$.dealloc();
        return result;
    }
}

public () global_set_initializer(Value global, Value constant_value) {
    unsafe {
        LLVMSetInitializer(global.raw$.some(), constant_value.raw$.some());
    }
}

public () global_set_constant(Value global, Bool is_constant) {
    Int32! value = 0;
    if (is_constant) {
        value = 1;
    }
    unsafe {
        LLVMSetGlobalConstant(global.raw$.some(), value);
    }
}

public Value module_get_global(Module& module, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    unsafe {
        LLVMValue* raw = LLVMGetNamedGlobal(module.raw$.some(), c_name);
        Bool missing = raw$.as(Int) == 0;
        c_name$.dealloc();
        if (missing) {
            return Value();
        }
        return Value(raw);
    }
}

public Value module_get_function(Module& module, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    unsafe {
        LLVMValue* raw = LLVMGetNamedFunction(module.raw$.some(), c_name);
        Bool missing = raw$.as(Int) == 0;
        c_name$.dealloc();
        if (missing) {
            return Value();
        }
        return Value(raw);
    }
}

struct TargetMachine {
    LLVMTargetMachine*?! raw;

    init(self) {
        self.raw = null;
    }

    Bool init_for_module(self, Module& module, Int opt_level, UInt8[]& target_triple) {
        init_supported_targets();

        UInt8[*:0] triple = c_string_buffer(target_triple);
        module_set_target(module, triple);
        LLVMTarget*![*] target_slot;
        UInt8[*:0]![*] error_slot;
        Bool! ok;
        unsafe {
            target_slot = LLVMTarget*$.alloc_many(1);
            error_slot = UInt8[*:0]$.alloc_many(1);
            ok = LLVMGetTargetFromTriple(
                triple,
                target_slot$.as(LLVMTarget*[*]),
                error_slot$.as(UInt8[*:0][*])
            ) == 0;
        }
        if (ok) {
            UInt8[*:0] cpu = c_string_buffer("generic");
            UInt8[*:0] features = c_string_buffer("");
            unsafe {
                self.raw = LLVMCreateTargetMachine(
                    target_slot[0],
                    triple,
                    cpu,
                    features,
                    Int32(opt_level),
                    0,
                    0
                );
                cpu$.dealloc();
                features$.dealloc();
            }
            ok = self.raw != null;
        }
        if (ok) {
            ok = self.apply_data_layout(module);
        }
        unsafe {
            target_slot$.dealloc();
            error_slot$.dealloc();
            triple$.dealloc();
        }
        return ok;
    }

    Bool apply_data_layout(self, Module& module) {
        // datalayout 字符串由 LLVM 的 TargetMachine 生成；不要在 Jiang 侧手写
        // macOS/Linux/Wasm/Windows 的 layout，避免和当前 LLVM 版本脱节。
        if (self.raw == null) {
            return false;
        }
        unsafe {
            LLVMTargetData* target_data = LLVMCreateTargetDataLayout(self.raw$.some());
            Bool missing = target_data$.as(Int) == 0;
            if (missing) {
                return false;
            }
            UInt8[*:0] data_layout = LLVMCopyStringRepOfTargetData(target_data);
            Bool ok = data_layout != null;
            if (ok) {
                module_set_data_layout(module, data_layout);
                LLVMDisposeMessage(data_layout);
            }
            LLVMDisposeTargetData(target_data);
            return ok;
        }
    }

    Bool emit_object(self, Module& module, UInt8[*:0] output_path) {
        if (self.raw == null) {
            return false;
        }
        UInt8[*:0]![*] error_slot;
        Int32 result;
        unsafe {
            error_slot = UInt8[*:0]$.alloc_many(1);
            result = LLVMTargetMachineEmitToFile(
                self.raw$.some(),
                module.raw$.some(),
                output_path,
                1,
                error_slot$.as(UInt8[*:0][*])
            );
            error_slot$.dealloc();
        }
        return result == 0;
    }

    Bool run_passes(self, Module& module, UInt8[]& pass_pipeline) {
        if (self.raw == null || pass_pipeline.length == 0) {
            return self.raw != null;
        }
        LLVMPassBuilderOptions* options;
        unsafe {
            options = LLVMCreatePassBuilderOptions();
            if (options$.as(Int) == 0) {
                return false;
            }
        }
        UInt8[*:0] c_passes = c_string_buffer(pass_pipeline);
        LLVMError* error;
        unsafe {
            error = LLVMRunPasses(
                module.raw$.some(),
                c_passes,
                self.raw$.some(),
                options
            );
            c_passes$.dealloc();
            LLVMDisposePassBuilderOptions(options);
            Bool no_error = error$.as(Int) == 0;
            if (no_error) {
                return true;
            }
            LLVMConsumeError(error);
            return false;
        }
    }

    () dispose(self) {
        if (self.raw == null) {
            return;
        }
        unsafe {
            LLVMDisposeTargetMachine(self.raw$.some());
        }
        self.raw = null;
    }
}

UInt8[*:0] c_string_buffer(UInt8[]& text) {
    unsafe {
        UInt8![*] buffer = UInt8!$.alloc_many(text.length + 1);
        Int! index = 0;
        while (index < text.length) {
            buffer[index] = text[index];
            index = index + 1;
        }
        buffer[text.length] = 0;
        return buffer$.as(UInt8[*:0]);
    }
}

public Value function_param(Value function, Int index) {
    return unsafe {
        Value(LLVMGetParam(function.raw$.some(), UInt32(index)))
    };
}

public () function_add_type_attribute(Context& context, Value function, Int index, UInt8[]& name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    unsafe {
        LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
        LLVMAddAttributeAtIndex(function.raw$.some(), UInt32(index), attribute);
    }
}

public () function_add_enum_attribute(Context& context, Value function, Int index, UInt8[]& name) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    unsafe {
        LLVMAttribute* attribute = LLVMCreateEnumAttribute(context.raw$.some(), kind, UInt64(0));
        LLVMAddAttributeAtIndex(function.raw$.some(), UInt32(index), attribute);
    }
}

public () call_add_type_attribute(Context& context, Value call, Int index, UInt8[]& name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    unsafe {
        LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
        LLVMAddCallSiteAttribute(call.raw$.some(), UInt32(index), attribute);
    }
}

UInt32 attribute_kind(UInt8[]& name) {
    if (name.length == 0) {
        return 0;
    }
    UInt32 kind = unsafe {
        LLVMGetEnumAttributeKindForName(name[0]$.ptr()$.as(UInt8[*]), name.length)
    };
    return kind;
}

public struct Builder {
    public LLVMBuilder*?! raw;

    public init(self, Context& context) {
        self.raw = unsafe {
            LLVMCreateBuilderInContext(context.raw$.some())
        };
    }
}

public Bool builder_valid(Builder& builder) {
    return builder.raw != null;
}

public () builder_dispose(Builder& builder) {
    if (builder_valid(builder)) {
        unsafe {
            LLVMDisposeBuilder(builder.raw$.some());
        }
        builder.raw = null;
    }
}

public () builder_position_at_end(Builder& builder, BasicBlock block) {
    unsafe {
        LLVMPositionBuilderAtEnd(builder.raw$.some(), block.raw$.some());
    }
}

public Value builder_build_return(Builder& builder, Value value) {
    return unsafe {
        Value(LLVMBuildRet(builder.raw$.some(), value.raw$.some()))
    };
}

public enum BinaryOp {
    int_add,
    int_sub,
    int_mul,
    int_signed_div,
    int_signed_rem,
    int_and,
    int_or,
    int_xor,
    int_shift_left,
    int_arithmetic_shift_right,
    int_unsigned_div,
    int_unsigned_rem,
    int_logical_shift_right,
    float_add,
    float_sub,
    float_mul,
    float_div,
    float_rem,
}

public Value builder_build_binary(Builder& builder, BinaryOp op, Value left, Value right) {
    UInt8[*:0] name = c_string_buffer("");
    Value! result = Value();
    unsafe {
        if (op == .int_add) {
            result = Value(LLVMBuildAdd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_sub) {
            result = Value(LLVMBuildSub(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_mul) {
            result = Value(LLVMBuildMul(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_signed_div) {
            result = Value(LLVMBuildSDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_signed_rem) {
            result = Value(LLVMBuildSRem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_and) {
            result = Value(LLVMBuildAnd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_or) {
            result = Value(LLVMBuildOr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_xor) {
            result = Value(LLVMBuildXor(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_shift_left) {
            result = Value(LLVMBuildShl(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_arithmetic_shift_right) {
            result = Value(LLVMBuildAShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_unsigned_div) {
            result = Value(LLVMBuildUDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_unsigned_rem) {
            result = Value(LLVMBuildURem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .int_logical_shift_right) {
            result = Value(LLVMBuildLShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .float_add) {
            result = Value(LLVMBuildFAdd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .float_sub) {
            result = Value(LLVMBuildFSub(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .float_mul) {
            result = Value(LLVMBuildFMul(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .float_div) {
            result = Value(LLVMBuildFDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        if (op == .float_rem) {
            result = Value(LLVMBuildFRem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name));
        }
        name$.dealloc();
    }
    return result;
}

public Value builder_build_alloca(Builder& builder, Type type) {
    UInt8[*:0] name = c_string_buffer("");
    unsafe {
        Value result = Value(LLVMBuildAlloca(builder.raw$.some(), type.raw$.some(), name));
        name$.dealloc();
        return result;
    }
}

public Value builder_build_store(Builder& builder, Value value, Value pointer) {
    if (!value_valid(value) || !value_valid(pointer)) {
        return Value();
    }
    return unsafe {
        Value(LLVMBuildStore(builder.raw$.some(), value.raw$.some(), pointer.raw$.some()))
    };
}

public Value builder_build_memcpy(Builder& builder, Value destination, Int destination_align, Value source, Int source_align, Value size) {
    return unsafe {
        Value(LLVMBuildMemCpy(
            builder.raw$.some(),
            destination.raw$.some(),
            UInt32(destination_align),
            source.raw$.some(),
            UInt32(source_align),
            size.raw$.some()
        )
        )
    };
}

public Value builder_build_load(Builder& builder, Type type, Value pointer) {
    if (!type_valid(type) || !value_valid(pointer)) {
        return Value();
    }
    UInt8[*:0] name = c_string_buffer("");
    unsafe {
        Value result = Value(LLVMBuildLoad2(
            builder.raw$.some(),
            type.raw$.some(),
            pointer.raw$.some(),
            name
        )
        );
        name$.dealloc();
        return result;
    }
}

public Value builder_build_atomic_load_acquire(Builder& builder, Type type, Value pointer) {
    Value result = builder_build_load(builder, type, pointer);
    if (!value_valid(result)) { return result; }
    unsafe {
        LLVMSetOrdering(result.raw$.some(), 4);
    }
    return result;
}

public Value builder_build_atomic_store_release(Builder& builder, Value value, Value pointer) {
    Value result = builder_build_store(builder, value, pointer);
    if (!value_valid(result)) { return result; }
    unsafe {
        LLVMSetOrdering(result.raw$.some(), 5);
    }
    return result;
}

public Value builder_build_atomic_cmpxchg_success(
    Builder& builder,
    Value pointer,
    Value expected,
    Value desired
) {
    if (!value_valid(pointer) || !value_valid(expected) || !value_valid(desired)) {
        return Value();
    }
    Value pair = unsafe {
        Value(LLVMBuildAtomicCmpXchg(
            builder.raw$.some(),
            pointer.raw$.some(),
            expected.raw$.some(),
            desired.raw$.some(),
            6,
            4,
            0
        ))
    };
    if (!value_valid(pair)) { return Value(); }
    return builder_build_extract_value(builder, pair, 1);
}

public Value builder_build_gep(Builder& builder, Type type, Value pointer, list.ArrayList<Value>& indices) {
    Int count = indices.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    unsafe {
        LLVMValue*![*] raw_indices = LLVMValue*$.alloc_many(capacity);
        Int! index = 0;
        while (index < count) {
            raw_indices[index] = indices.get(index).raw$.some();
            index = index + 1;
        }

        UInt8[*:0] name = c_string_buffer("");
        Value result = Value(LLVMBuildGEP2(
            builder.raw$.some(),
            type.raw$.some(),
            pointer.raw$.some(),
            raw_indices$.as(LLVMValue*[*]),
            UInt32(count),
            name
        ));
        name$.dealloc();
        raw_indices$.dealloc();
        return result;
    }
}

public Value builder_build_cast(Builder& builder, Int op, Value value, Type dest_type) {
    UInt8[*:0] name = c_string_buffer("");
    Value! result = Value();
    unsafe {
        if (op == 0) {
            result = Value(LLVMBuildSExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 1) {
            result = Value(LLVMBuildTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 2) {
            result = Value(LLVMBuildSIToFP(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 3) {
            result = Value(LLVMBuildFPToSI(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 4) {
            result = Value(LLVMBuildFPExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 5) {
            result = Value(LLVMBuildFPTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 6) {
            result = Value(LLVMBuildPointerCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 7) {
            result = Value(LLVMBuildPtrToInt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 8) {
            result = Value(LLVMBuildIntToPtr(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        if (op == 9) {
            result = Value(LLVMBuildBitCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name));
        }
        name$.dealloc();
    }
    return result;
}

