public Value builder_build_call(
    Builder& builder,
    Type function_type,
    Value function,
    list.ArrayList<Value>& args
) {
    Int count = args.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    unsafe {
        LLVMValue*![*] raw_args = LLVMValue*$.alloc_many(capacity);
        Int! index = 0;
        while (index < count) {
            raw_args[index] = args.get(index).raw$.some();
            index = index + 1;
        }

        UInt8[*:0] name = c_string_buffer("");
        Value result = Value(LLVMBuildCall2(
            builder.raw$.some(),
            function_type.raw$.some(),
            function.raw$.some(),
            raw_args$.as(LLVMValue*[*]),
            UInt32(count),
            name
        ));
        name$.dealloc();
        raw_args$.dealloc();
        return result;
    }
}

public Value inline_asm_value(
    Type function_type,
    UInt8[]& code,
    UInt8[]& constraints,
    Bool has_side_effects
) {
    Int32! side_effects = 0;
    if (has_side_effects) {
        side_effects = 1;
    }
    UInt8[*:0] c_code = c_string_buffer(code);
    UInt8[*:0] c_constraints = c_string_buffer(constraints);
    unsafe {
        Value result = Value(
            LLVMGetInlineAsm(
                function_type.raw$.some(),
                c_code$.as(UInt8[*]),
                code.length,
                c_constraints$.as(UInt8[*]),
                constraints.length,
                side_effects,
                0,
                0,
                0
            )
        );
        c_code$.dealloc();
        c_constraints$.dealloc();
        return result;
    }
}

