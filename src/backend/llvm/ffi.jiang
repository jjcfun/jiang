    LLVMType* LLVMFloatTypeInContext(LLVMContext* context);
    LLVMType* LLVMPointerTypeInContext(LLVMContext* context, UInt32 address_space);
    LLVMType* LLVMArrayType(LLVMType* element_type, UInt32 element_count);
    LLVMType* LLVMStructTypeInContext(
        LLVMContext* context,
        LLVMType*[*] element_types,
