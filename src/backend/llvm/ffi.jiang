public struct Type {
    public LLVMType*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMType* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool type_valid(Type value) {
    return value.valid;
}

public struct Value {
    public LLVMValue*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMValue* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool value_valid(Value value) {
    return value.valid;
}

public struct BasicBlock {
    public LLVMBasicBlock*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMBasicBlock* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool block_valid(BasicBlock value) {
    return value.valid;
}

public struct Context {
    public LLVMContext*?! raw;

    public init() {
        self.raw = LLVMContextCreate();
    }
}

public Bool context_valid(Context& context) {
    return context.raw != null;
}

public () context_dispose(Context& context) {
    if (context_valid(context)) {
        LLVMContextDispose(context.raw$.some());
        context.raw = null;
    }
}

public Type context_void_type(Context& context) {
    return Type(LLVMVoidTypeInContext(context.raw$.some()));
}

public Type context_int_type(Context& context, Int bits) {
    return Type(LLVMIntTypeInContext(context.raw$.some(), UInt32(bits)));
}

public Type context_float_type(Context& context) {
    return Type(LLVMFloatTypeInContext(context.raw$.some()));
}

public Type context_double_type(Context& context) {
    return Type(LLVMDoubleTypeInContext(context.raw$.some()));
}

public Type context_pointer_type(Context& context) {
    return Type(LLVMPointerTypeInContext(context.raw$.some(), 0));
}

public Type context_struct_type(Context& context, list.ArrayList<Type>& element_types) {
    Int count = element_types.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMType*![*] raw_elements = LLVMType*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_elements[index] = element_types.get(index).raw$.some();
        index = index + 1;
    }

    Type result = Type(
        LLVMStructTypeInContext(
            context.raw$.some(),
            raw_elements$.as(LLVMType*[*]),
            UInt32(count),
            // Layout lowering 已经显式插入 padding byte，LLVM struct 必须 packed。
            1
        )
    );
    raw_elements$.free();
    return result;
}

public Type array_type(Type element_type, Int element_count) {
    return Type(LLVMArrayType(element_type.raw$.some(), UInt32(element_count)));
}

public BasicBlock context_append_block(Context& context, Value function, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    BasicBlock result = BasicBlock(
        LLVMAppendBasicBlockInContext(context.raw$.some(), function.raw$.some(), c_name)
    );
    c_name$.free();
    return result;
}

public struct Module {
    public LLVMModule*?! raw;

    public init(Context& context, UInt8[]& name) {
        UInt8[*:0] c_name = c_string_buffer(name);
        self.raw = LLVMModuleCreateWithNameInContext(c_name, context.raw$.some());
        c_name$.free();
    }
}

public Bool module_valid(Module& module) {
    return module.raw != null;
}

public () module_dispose(Module& module) {
    if (module_valid(module)) {
        LLVMDisposeModule(module.raw$.some());
        module.raw = null;
    }
}

public () module_set_target(Module& module, UInt8[*:0] triple) {
    LLVMSetTarget(module.raw$.some(), triple);
}

public () module_set_target_text(Module& module, UInt8[]& triple) {
    UInt8[*:0] c_triple = c_string_buffer(triple);
    module_set_target(module, c_triple);
    c_triple$.free();
}

public UInt8[]& llvm_version_text() {
    UInt32![*] major = UInt32!$.alloc_array(1);
    UInt32![*] minor = UInt32!$.alloc_array(1);
    UInt32![*] patch = UInt32!$.alloc_array(1);
    LLVMGetVersion(major$.as(UInt32[*]), minor$.as(UInt32[*]), patch$.as(UInt32[*]));
    UInt8[]&! text = string.int_text(Int(major[0]));
    text = string.append(text, ".");
    text = string.append(text, string.int_text(Int(minor[0])));
    text = string.append(text, ".");
    text = string.append(text, string.int_text(Int(patch[0])));
    major$.free();
    minor$.free();
    patch$.free();
    return text;
}

public UInt8[]& default_target_triple_text() {
    UInt8[*:0] raw = LLVMGetDefaultTargetTriple();
    if (raw == null) {
        return "";
    }
    UInt8[]& text = c_string_copy(raw);
    LLVMDisposeMessage(raw);
    return text;
}

public Bool module_emit_object(
    Module& module,
    UInt8[]& output_path,
    Int opt_level,
    UInt8[]& pass_pipeline,
    UInt8[]& target_triple
) {
    TargetMachine! target_machine = TargetMachine();
    if (!target_machine.init_for_module(module, opt_level, target_triple)) {
        return false;
    }
    Bool! ok = true;
    if (pass_pipeline.length > 0) {
        ok = target_machine.run_passes(module, pass_pipeline);
    }
    if (ok) {
        UInt8[*:0] c_output_path = c_string_buffer(output_path);
        ok = target_machine.emit_object(module, c_output_path);
        c_output_path$.free();
    }
    target_machine.dispose();
    return ok;
}

public Bool module_emit_llvm_ir(Module& module, UInt8[]& output_path) {
    UInt8[*:0]![*] error_slot = UInt8[*:0]$.alloc_array(1);
    UInt8[*:0] c_output_path = c_string_buffer(output_path);
    Int32 result = LLVMPrintModuleToFile(module.raw$.some(), c_output_path, error_slot$.as(UInt8[*:0][*]));
    c_output_path$.free();
    error_slot$.free();
    return result == 0;
}

public UInt8[]&? module_llvm_ir_text(Module& module) {
    UInt8[*:0] raw = LLVMPrintModuleToString(module.raw$.some());
    if (raw == null) {
        return null;
    }
    Int length = c_string_length(raw);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int! index = 0;
    while (index < length) {
        bytes[index] = raw[index];
        index = index + 1;
    }
    bytes[length] = 0;
    LLVMDisposeMessage(raw);
    UInt8[*:0] frozen = bytes$.as(UInt8[*:0]);
    return frozen[0..length];
}

Int c_string_length(UInt8[*:0] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

UInt8[]& c_string_copy(UInt8[*:0] raw) {
    Int length = c_string_length(raw);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int! index = 0;
    while (index < length) {
        bytes[index] = raw[index];
        index = index + 1;
    }
    bytes[length] = 0;
    UInt8[*:0] frozen = bytes$.as(UInt8[*:0]);
    return frozen[0..length];
}

// LLVM 的 NativeTarget helper 是 C header 便利层，不一定作为动态符号导出。
// FFI 只能声明真实导出的 target-specific 初始化函数。
() init_supported_targets() {
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
}

public Value module_add_function(Module& module, UInt8[]& name, Type function_type) {
    UInt8[*:0] c_name = c_string_buffer(name);
    Value result = Value(LLVMAddFunction(module.raw$.some(), c_name, function_type.raw$.some()));
    c_name$.free();
    return result;
}

public Value module_add_global(Module& module, UInt8[]& name, Type type) {
    UInt8[*:0] c_name = c_string_buffer(name);
    Value result = Value(LLVMAddGlobal(module.raw$.some(), type.raw$.some(), c_name));
    c_name$.free();
    return result;
}

public () global_set_initializer(Value global, Value constant_value) {
    LLVMSetInitializer(global.raw$.some(), constant_value.raw$.some());
}

public Value module_get_global(Module& module, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    LLVMValue* raw = LLVMGetNamedGlobal(module.raw$.some(), c_name);
    c_name$.free();
    if (raw$.as(Int) == 0) {
        return Value();
    }
    return Value(raw);
}

public Value module_get_function(Module& module, UInt8[]& name) {
    UInt8[*:0] c_name = c_string_buffer(name);
    LLVMValue* raw = LLVMGetNamedFunction(module.raw$.some(), c_name);
    c_name$.free();
    if (raw$.as(Int) == 0) {
        return Value();
    }
    return Value(raw);
}

struct TargetMachine {
    LLVMTargetMachine*?! raw;

    init() {
        self.raw = null;
    }

    Bool init_for_module(Module& module, Int opt_level, UInt8[]& target_triple) {
        init_supported_targets();

        UInt8[*:0] triple = c_string_buffer(target_triple);
        module_set_target(module, triple);
        LLVMTarget*![*] target_slot = LLVMTarget*$.alloc_array(1);
        UInt8[*:0]![*] error_slot = UInt8[*:0]$.alloc_array(1);
        Bool! ok = LLVMGetTargetFromTriple(
            triple,
            target_slot$.as(LLVMTarget*[*]),
            error_slot$.as(UInt8[*:0][*])
        ) == 0;
        if (ok) {
            UInt8[*:0] cpu = c_string_buffer("generic");
            UInt8[*:0] features = c_string_buffer("");
            self.raw = LLVMCreateTargetMachine(
                target_slot[0],
                triple,
                cpu,
                features,
                Int32(opt_level),
                0,
                0
            );
            cpu$.free();
            features$.free();
            ok = self.raw != null;
        }
        target_slot$.free();
        error_slot$.free();
        triple$.free();
        return ok;
    }

    Bool emit_object(Module& module, UInt8[*:0] output_path) {
        if (self.raw == null) {
            return false;
        }
        UInt8[*:0]![*] error_slot = UInt8[*:0]$.alloc_array(1);
        Int32 result = LLVMTargetMachineEmitToFile(
            self.raw$.some(),
            module.raw$.some(),
            output_path,
            1,
            error_slot$.as(UInt8[*:0][*])
        );
        error_slot$.free();
        return result == 0;
    }

    Bool run_passes(Module& module, UInt8[]& pass_pipeline) {
        if (self.raw == null || pass_pipeline.length == 0) {
            return self.raw != null;
        }
        LLVMPassBuilderOptions* options = LLVMCreatePassBuilderOptions();
        if (options$.as(Int) == 0) {
            return false;
        }
        UInt8[*:0] c_passes = c_string_buffer(pass_pipeline);
        LLVMError* error = LLVMRunPasses(
            module.raw$.some(),
            c_passes,
            self.raw$.some(),
            options
        );
        c_passes$.free();
        LLVMDisposePassBuilderOptions(options);
        if (error$.as(Int) == 0) {
            return true;
        }
        LLVMConsumeError(error);
        return false;
    }

    () dispose() {
        if (self.raw == null) {
            return;
        }
        LLVMDisposeTargetMachine(self.raw$.some());
        self.raw = null;
    }
}

UInt8[*:0] c_string_buffer(UInt8[]& text) {
    UInt8![*] buffer = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        buffer[index] = text[index];
        index = index + 1;
    }
    buffer[text.length] = 0;
    return buffer$.as(UInt8[*:0]);
}

public Value function_param(Value function, Int index) {
    return Value(LLVMGetParam(function.raw$.some(), UInt32(index)));
}

public () function_add_type_attribute(Context& context, Value function, Int index, UInt8[]& name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
    LLVMAddAttributeAtIndex(function.raw$.some(), UInt32(index), attribute);
}

public () call_add_type_attribute(Context& context, Value call, Int index, UInt8[]& name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
    LLVMAddCallSiteAttribute(call.raw$.some(), UInt32(index), attribute);
}

UInt32 attribute_kind(UInt8[]& name) {
    if (name.length == 0) {
        return 0;
    }
    return LLVMGetEnumAttributeKindForName(name[0]$.addr()$.as(UInt8[*]), name.length);
}

public struct Builder {
    public LLVMBuilder*?! raw;

    public init(Context& context) {
        self.raw = LLVMCreateBuilderInContext(context.raw$.some());
    }
}

public Bool builder_valid(Builder& builder) {
    return builder.raw != null;
}

public () builder_dispose(Builder& builder) {
    if (builder_valid(builder)) {
        LLVMDisposeBuilder(builder.raw$.some());
        builder.raw = null;
    }
}

public () builder_position_at_end(Builder& builder, BasicBlock block) {
    LLVMPositionBuilderAtEnd(builder.raw$.some(), block.raw$.some());
}

public Value builder_build_return(Builder& builder, Value value) {
    return Value(LLVMBuildRet(builder.raw$.some(), value.raw$.some()));
}

public Value builder_build_binary(Builder& builder, Int op, Value left, Value right) {
    UInt8[*:0] name = c_string_buffer("");
    Value! result = Value();
    if (op == 0) { result = Value(LLVMBuildAdd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 1) { result = Value(LLVMBuildSub(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 2) { result = Value(LLVMBuildMul(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 3) { result = Value(LLVMBuildSDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 4) { result = Value(LLVMBuildSRem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 5) { result = Value(LLVMBuildAnd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 6) { result = Value(LLVMBuildOr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 7) { result = Value(LLVMBuildXor(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 8) { result = Value(LLVMBuildShl(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 9) { result = Value(LLVMBuildAShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 10) { result = Value(LLVMBuildUDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 11) { result = Value(LLVMBuildURem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    if (op == 12) { result = Value(LLVMBuildLShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), name)); }
    name$.free();
    return result;
}

public Value builder_build_alloca(Builder& builder, Type type) {
    UInt8[*:0] name = c_string_buffer("");
    Value result = Value(LLVMBuildAlloca(builder.raw$.some(), type.raw$.some(), name));
    name$.free();
    return result;
}

public Value builder_build_store(Builder& builder, Value value, Value pointer) {
    return Value(LLVMBuildStore(builder.raw$.some(), value.raw$.some(), pointer.raw$.some()));
}

public Value builder_build_memcpy(Builder& builder, Value destination, Int destination_align, Value source, Int source_align, Value size) {
    return Value(LLVMBuildMemCpy(
            builder.raw$.some(),
            destination.raw$.some(),
            UInt32(destination_align),
            source.raw$.some(),
            UInt32(source_align),
            size.raw$.some()
        )
    );
}

public Value builder_build_load(Builder& builder, Type type, Value pointer) {
    UInt8[*:0] name = c_string_buffer("");
    Value result = Value(LLVMBuildLoad2(
            builder.raw$.some(),
            type.raw$.some(),
            pointer.raw$.some(),
            name
        )
    );
    name$.free();
    return result;
}

public Value builder_build_gep(Builder& builder, Type type, Value pointer, list.ArrayList<Value>& indices) {
    Int count = indices.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMValue*![*] raw_indices = LLVMValue*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_indices[index] = indices.get(index).raw$.some();
        index = index + 1;
    }

    UInt8[*:0] name = c_string_buffer("");
    Value result = Value(
        LLVMBuildGEP2(
            builder.raw$.some(),
            type.raw$.some(),
            pointer.raw$.some(),
            raw_indices$.as(LLVMValue*[*]),
            UInt32(count),
            name
        )
    );
    name$.free();
    raw_indices$.free();
    return result;
}

public Value builder_build_cast(Builder& builder, Int op, Value value, Type dest_type) {
    UInt8[*:0] name = c_string_buffer("");
    Value! result = Value();
    if (op == 0) { result = Value(LLVMBuildSExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 1) { result = Value(LLVMBuildTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 2) { result = Value(LLVMBuildSIToFP(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 3) { result = Value(LLVMBuildFPToSI(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 4) { result = Value(LLVMBuildFPExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 5) { result = Value(LLVMBuildFPTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 6) { result = Value(LLVMBuildPointerCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 7) { result = Value(LLVMBuildPtrToInt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 8) { result = Value(LLVMBuildIntToPtr(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    if (op == 9) { result = Value(LLVMBuildBitCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), name)); }
    name$.free();
    return result;
}

public Value builder_build_icmp(Builder& builder, Int32 predicate, Value left, Value right) {
    UInt8[*:0] name = c_string_buffer("");
    Value result = Value(LLVMBuildICmp(builder.raw$.some(), predicate, left.raw$.some(), right.raw$.some(), name));
    name$.free();
    return result;
}

public Value builder_build_return_void(Builder& builder) {
    return Value(LLVMBuildRetVoid(builder.raw$.some()));
}

public Value builder_build_br(Builder& builder, BasicBlock destination) {
    return Value(LLVMBuildBr(builder.raw$.some(), destination.raw$.some()));
}

public Value builder_build_cond_br(
    Builder& builder,
    Value condition,
    BasicBlock then_block,
    BasicBlock else_block
) {
    return Value(
        LLVMBuildCondBr(
            builder.raw$.some(),
            condition.raw$.some(),
            then_block.raw$.some(),
            else_block.raw$.some()
        )
    );
