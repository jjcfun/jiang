    () LLVMInitializeX86TargetInfo();
    () LLVMInitializeX86Target();
    () LLVMInitializeX86TargetMC();
    () LLVMInitializeX86AsmPrinter();

    LLVMModule* LLVMModuleCreateWithNameInContext(CString module_id, LLVMContext* context);
    () LLVMDisposeModule(LLVMModule* module);
    () LLVMSetTarget(LLVMModule* module, CString triple);
