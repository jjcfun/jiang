public struct Type {
    public LLVMType*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMType* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool type_valid(Type value) {
    return value.valid;
}

public struct Value {
    public LLVMValue*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMValue* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool value_valid(Value value) {
    return value.valid;
}

public struct BasicBlock {
    public LLVMBasicBlock*?! raw;
    public Bool! valid;

    public init() {
        self.raw = null;
        self.valid = false;
    }

    public init(LLVMBasicBlock* raw) {
        self.raw = raw;
        self.valid = raw$.as(Int) != 0;
    }
}

public Bool block_valid(BasicBlock value) {
    return value.valid;
}

public struct Context {
    public LLVMContext*?! raw;

    public init() {
        self.raw = LLVMContextCreate();
    }
}

public Bool context_valid(Context& context) {
    return context.raw != null;
}

public () context_dispose(Context& context) {
    if (context_valid(context)) {
        LLVMContextDispose(context.raw$.some());
        context.raw = null;
    }
}

public Type context_void_type(Context& context) {
    return Type(LLVMVoidTypeInContext(context.raw$.some()));
}

public Type context_int_type(Context& context, Int bits) {
    return Type(LLVMIntTypeInContext(context.raw$.some(), UInt32(bits)));
}

public Type context_float_type(Context& context) {
    return Type(LLVMFloatTypeInContext(context.raw$.some()));
}

public Type context_double_type(Context& context) {
    return Type(LLVMDoubleTypeInContext(context.raw$.some()));
}

public Type context_pointer_type(Context& context) {
    return Type(LLVMPointerTypeInContext(context.raw$.some(), 0));
}

public Type context_struct_type(Context& context, list.ArrayList<Type>& element_types) {
    Int count = element_types.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMType*![*] raw_elements = LLVMType*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_elements[index] = element_types.get(index).raw$.some();
        index = index + 1;
    }

    Type result = Type(
        LLVMStructTypeInContext(
            context.raw$.some(),
            raw_elements$.as(LLVMType*[*]),
            UInt32(count),
            // Layout lowering 已经显式插入 padding byte，LLVM struct 必须 packed。
            1
        )
    );
    raw_elements$.free();
    return result;
}

public Type array_type(Type element_type, Int element_count) {
    return Type(LLVMArrayType(element_type.raw$.some(), UInt32(element_count)));
}

public BasicBlock context_append_block(Context& context, Value function, CString name) {
    return BasicBlock(LLVMAppendBasicBlockInContext(context.raw$.some(), function.raw$.some(), name));
}

public struct Module {
    public LLVMModule*?! raw;

    public init(Context& context, CString name) {
        self.raw = LLVMModuleCreateWithNameInContext(name, context.raw$.some());
    }
}

public Bool module_valid(Module& module) {
    return module.raw != null;
}

public () module_dispose(Module& module) {
    if (module_valid(module)) {
        LLVMDisposeModule(module.raw$.some());
        module.raw = null;
    }
}

public () module_set_target(Module& module, CString triple) {
    LLVMSetTarget(module.raw$.some(), triple);
}

public Bool module_emit_object(Module& module, CString output_path, Int opt_level) {
    TargetMachine! target_machine = TargetMachine();
    if (!target_machine.init_default_for_module(module, opt_level)) {
        return false;
    }
    Bool ok = target_machine.emit_object(module, output_path);
    target_machine.dispose();
    return ok;
}

public Bool module_emit_llvm_ir(Module& module, CString output_path) {
    UInt8[*]![*] error_slot = UInt8[*]$.alloc_array(1);
    Int32 result = LLVMPrintModuleToFile(module.raw$.some(), output_path, error_slot$.as(UInt8[*][*]));
    error_slot$.free();
    return result == 0;
}

public UInt8[]? module_llvm_ir_text(Module& module) {
    UInt8[*] raw = LLVMPrintModuleToString(module.raw$.some());
    if (raw == null) {
        return null;
    }
    Int length = c_string_length(raw);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int! index = 0;
    while (index < length) {
        bytes[index] = raw[index];
        index = index + 1;
    }
    bytes[length] = 0;
    LLVMDisposeMessage(raw);
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..length];
}

Int c_string_length(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

// LLVM 的 NativeTarget helper 是 C header 便利层，不一定作为动态符号导出。
// FFI 只能声明真实导出的 target-specific 初始化函数。
() init_supported_targets() {
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
}

public Value module_add_function(Module& module, CString name, Type function_type) {
    return Value(LLVMAddFunction(module.raw$.some(), name, function_type.raw$.some()));
}

public Value module_add_global(Module& module, CString name, Type type) {
    return Value(LLVMAddGlobal(module.raw$.some(), type.raw$.some(), name));
}

public Value module_get_global(Module& module, CString name) {
    LLVMValue* raw = LLVMGetNamedGlobal(module.raw$.some(), name);
    if (raw$.as(Int) == 0) {
        return Value();
    }
    return Value(raw);
}

public Value module_get_function(Module& module, CString name) {
    LLVMValue* raw = LLVMGetNamedFunction(module.raw$.some(), name);
    if (raw$.as(Int) == 0) {
        return Value();
    }
    return Value(raw);
}

struct TargetMachine {
    LLVMTargetMachine*?! raw;

    init() {
        self.raw = null;
    }

    Bool init_default_for_module(Module& module, Int opt_level) {
        init_supported_targets();

        CString triple = LLVMGetDefaultTargetTriple()$.as(CString);
        module_set_target(module, triple);
        LLVMTarget*![*] target_slot = LLVMTarget*$.alloc_array(1);
        UInt8[*]![*] error_slot = UInt8[*]$.alloc_array(1);
        Bool! ok = LLVMGetTargetFromTriple(
            triple,
            target_slot$.as(LLVMTarget*[*]),
            error_slot$.as(UInt8[*][*])
        ) == 0;
        if (ok) {
            self.raw = LLVMCreateTargetMachine(target_slot[0], triple, "generic", "", Int32(opt_level), 0, 0);
            ok = self.raw != null;
        }
        target_slot$.free();
        error_slot$.free();
        return ok;
    }

    Bool emit_object(Module& module, CString output_path) {
        if (self.raw == null) {
            return false;
        }
        UInt8[*]![*] error_slot = UInt8[*]$.alloc_array(1);
        Int32 result = LLVMTargetMachineEmitToFile(
            self.raw$.some(),
            module.raw$.some(),
            output_path,
            1,
            error_slot$.as(UInt8[*][*])
        );
        error_slot$.free();
        return result == 0;
    }

    () dispose() {
        if (self.raw == null) {
            return;
        }
        LLVMDisposeTargetMachine(self.raw$.some());
        self.raw = null;
    }
}

public Value function_param(Value function, Int index) {
    return Value(LLVMGetParam(function.raw$.some(), UInt32(index)));
}

public () function_add_type_attribute(Context& context, Value function, Int index, UInt8[] name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
    LLVMAddAttributeAtIndex(function.raw$.some(), UInt32(index), attribute);
}

public () call_add_type_attribute(Context& context, Value call, Int index, UInt8[] name, Type type) {
    UInt32 kind = attribute_kind(name);
    if (kind == 0) {
        return;
    }
    LLVMAttribute* attribute = LLVMCreateTypeAttribute(context.raw$.some(), kind, type.raw$.some());
    LLVMAddCallSiteAttribute(call.raw$.some(), UInt32(index), attribute);
}

UInt32 attribute_kind(UInt8[] name) {
    if (name.length == 0) {
        return 0;
    }
    return LLVMGetEnumAttributeKindForName(name[0]$.addr()$.as(UInt8[*]), name.length);
}

public struct Builder {
    public LLVMBuilder*?! raw;

    public init(Context& context) {
        self.raw = LLVMCreateBuilderInContext(context.raw$.some());
    }
}

public Bool builder_valid(Builder& builder) {
    return builder.raw != null;
}

public () builder_dispose(Builder& builder) {
    if (builder_valid(builder)) {
        LLVMDisposeBuilder(builder.raw$.some());
        builder.raw = null;
    }
}

public () builder_position_at_end(Builder& builder, BasicBlock block) {
    LLVMPositionBuilderAtEnd(builder.raw$.some(), block.raw$.some());
}

public Value builder_build_return(Builder& builder, Value value) {
    return Value(LLVMBuildRet(builder.raw$.some(), value.raw$.some()));
}

public Value builder_build_binary(Builder& builder, Int op, Value left, Value right) {
    if (op == 0) { return Value(LLVMBuildAdd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 1) { return Value(LLVMBuildSub(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 2) { return Value(LLVMBuildMul(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 3) { return Value(LLVMBuildSDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 4) { return Value(LLVMBuildSRem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 5) { return Value(LLVMBuildAnd(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 6) { return Value(LLVMBuildOr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 7) { return Value(LLVMBuildXor(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 8) { return Value(LLVMBuildShl(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 9) { return Value(LLVMBuildAShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 10) { return Value(LLVMBuildUDiv(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 11) { return Value(LLVMBuildURem(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    if (op == 12) { return Value(LLVMBuildLShr(builder.raw$.some(), left.raw$.some(), right.raw$.some(), "")); }
    return Value();
}

public Value builder_build_alloca(Builder& builder, Type type) {
    return Value(LLVMBuildAlloca(builder.raw$.some(), type.raw$.some(), ""));
}

public Value builder_build_store(Builder& builder, Value value, Value pointer) {
    return Value(LLVMBuildStore(builder.raw$.some(), value.raw$.some(), pointer.raw$.some()));
}

public Value builder_build_memcpy(Builder& builder, Value destination, Int destination_align, Value source, Int source_align, Value size) {
    return Value(LLVMBuildMemCpy(
            builder.raw$.some(),
            destination.raw$.some(),
            UInt32(destination_align),
            source.raw$.some(),
            UInt32(source_align),
            size.raw$.some()
        )
    );
}

public Value builder_build_load(Builder& builder, Type type, Value pointer) {
    return Value(LLVMBuildLoad2(builder.raw$.some(), type.raw$.some(), pointer.raw$.some(), ""));
}

public Value builder_build_gep(Builder& builder, Type type, Value pointer, list.ArrayList<Value>& indices) {
    Int count = indices.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMValue*![*] raw_indices = LLVMValue*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_indices[index] = indices.get(index).raw$.some();
        index = index + 1;
    }

    Value result = Value(
        LLVMBuildGEP2(
            builder.raw$.some(),
            type.raw$.some(),
            pointer.raw$.some(),
            raw_indices$.as(LLVMValue*[*]),
            UInt32(count),
            ""
        )
    );
    raw_indices$.free();
    return result;
}

public Value builder_build_cast(Builder& builder, Int op, Value value, Type dest_type) {
    if (op == 0) { return Value(LLVMBuildSExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 1) { return Value(LLVMBuildTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 2) { return Value(LLVMBuildSIToFP(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 3) { return Value(LLVMBuildFPToSI(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 4) { return Value(LLVMBuildFPExt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 5) { return Value(LLVMBuildFPTrunc(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 6) {
        return Value(LLVMBuildPointerCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), ""));
    }
    if (op == 7) { return Value(LLVMBuildPtrToInt(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 8) { return Value(LLVMBuildIntToPtr(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    if (op == 9) { return Value(LLVMBuildBitCast(builder.raw$.some(), value.raw$.some(), dest_type.raw$.some(), "")); }
    return Value();
}

public Value builder_build_icmp(Builder& builder, Int32 predicate, Value left, Value right) {
    return Value(LLVMBuildICmp(builder.raw$.some(), predicate, left.raw$.some(), right.raw$.some(), ""));
}

public Value builder_build_return_void(Builder& builder) {
    return Value(LLVMBuildRetVoid(builder.raw$.some()));
}

public Value builder_build_br(Builder& builder, BasicBlock destination) {
    return Value(LLVMBuildBr(builder.raw$.some(), destination.raw$.some()));
}

public Value builder_build_cond_br(
    Builder& builder,
    Value condition,
    BasicBlock then_block,
    BasicBlock else_block
) {
    return Value(
        LLVMBuildCondBr(
            builder.raw$.some(),
            condition.raw$.some(),
            then_block.raw$.some(),
            else_block.raw$.some()
        )
    );
}

public Value builder_build_switch(
    Builder& builder,
    Value value,
    BasicBlock default_block,
    Int case_count
) {
    return Value(
        LLVMBuildSwitch(
            builder.raw$.some(),
            value.raw$.some(),
            default_block.raw$.some(),
            UInt32(case_count)
        )
    );
}

public () switch_add_case(Value switch_value, Value on_value, BasicBlock destination) {
    LLVMAddCase(switch_value.raw$.some(), on_value.raw$.some(), destination.raw$.some());
}

public Value builder_build_call(
    Builder& builder,
    Type function_type,
    Value function,
    list.ArrayList<Value>& args
) {
    Int count = args.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMValue*![*] raw_args = LLVMValue*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_args[index] = args.get(index).raw$.some();
        index = index + 1;
    }

    Value result = Value(
        LLVMBuildCall2(
            builder.raw$.some(),
            function_type.raw$.some(),
            function.raw$.some(),
            raw_args$.as(LLVMValue*[*]),
            UInt32(count),
            ""
        )
    );
    raw_args$.free();
    return result;
}

public Value builder_build_insert_value(Builder& builder, Value aggregate, Value element, Int index) {
    return Value(
        LLVMBuildInsertValue(
            builder.raw$.some(),
            aggregate.raw$.some(),
            element.raw$.some(),
            UInt32(index),
            ""
        )
    );
}

public Value builder_build_extract_value(Builder& builder, Value aggregate, Int index) {
    return Value(
        LLVMBuildExtractValue(
            builder.raw$.some(),
            aggregate.raw$.some(),
            UInt32(index),
            ""
        )
    );
}

public Value builder_build_global_string_ptr(Builder& builder, CString text) {
    return Value(LLVMBuildGlobalStringPtr(builder.raw$.some(), text, ""));
}

public Value builder_build_unreachable(Builder& builder) {
    return Value(LLVMBuildUnreachable(builder.raw$.some()));
}

public Type function_type(Type return_type, list.ArrayList<Type>& param_types) {
    Int count = param_types.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    LLVMType*![*] raw_params = LLVMType*$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        raw_params[index] = param_types.get(index).raw$.some();
        index = index + 1;
    }

    Type result = Type(LLVMFunctionType(return_type.raw$.some(), raw_params$.as(LLVMType*[*]), UInt32(count), 0));
    raw_params$.free();
    return result;
}

public Value const_int(Type int_type, UInt64 value) {
    return Value(LLVMConstInt(int_type.raw$.some(), value, 0));
}

public Value const_real(Type real_type, Float64 value) {
    return Value(LLVMConstReal(real_type.raw$.some(), value));
}

public Value const_null(Type type) {
    return Value(LLVMConstNull(type.raw$.some()));
}
