// LLVM C API 最小 FFI 边界。
//
// `LLVMContext` / `LLVMModule` 等空 struct 只用于表达 C opaque pointee
// type；真正对外使用的是 `Context` / `Module` / `Builder` / `Type` /
// `Value` wrapper。wrapper 内部保留 raw pointer，但上层 backend 不直接
// 调用 LLVM C 函数。

public struct LLVMContext {}
public struct LLVMModule {}
public struct LLVMBuilder {}
public struct LLVMType {}
public struct LLVMValue {}

extern {
    LLVMContext* LLVMContextCreate();
    () LLVMContextDispose(LLVMContext* context);

    LLVMModule* LLVMModuleCreateWithNameInContext(UInt8[*] module_id, LLVMContext* context);
    () LLVMDisposeModule(LLVMModule* module);

    LLVMBuilder* LLVMCreateBuilderInContext(LLVMContext* context);
    () LLVMDisposeBuilder(LLVMBuilder* builder);

    LLVMType* LLVMVoidTypeInContext(LLVMContext* context);
    LLVMType* LLVMIntTypeInContext(LLVMContext* context, UInt32 bit_count);
    LLVMType* LLVMDoubleTypeInContext(LLVMContext* context);
    LLVMType* LLVMFloatTypeInContext(LLVMContext* context);
    LLVMType* LLVMPointerTypeInContext(LLVMContext* context, UInt32 address_space);

    LLVMType* LLVMFunctionType(
        LLVMType* return_type,
        LLVMType*[*] param_types,
        UInt32 param_count,
        Int32 is_var_arg
    );
    LLVMValue* LLVMAddFunction(LLVMModule* module, UInt8[*] name, LLVMType* function_type);
}

public struct Type {
    public LLVMType*?! raw;

    public init() {
        self.raw = null;
    }

    public init(LLVMType* raw) {
        self.raw = raw;
    }
}

extend Type {
    public Bool valid() {
        return self.raw != null;
    }
}

public struct Value {
    public LLVMValue*?! raw;

    public init() {
        self.raw = null;
    }

    public init(LLVMValue* raw) {
        self.raw = raw;
    }
}

extend Value {
    public Bool valid() {
        return self.raw != null;
    }
}

public struct Context {
    public LLVMContext*?! raw;

    public init() {
        self.raw = LLVMContextCreate();
    }
}

extend Context {
    public Bool valid() {
        return self.raw != null;
    }

    public () dispose() {
        if (self.valid()) {
            LLVMContextDispose(self.raw$.some());
            self.raw = null;
        }
    }

    public Type void_type() {
        return Type(LLVMVoidTypeInContext(self.raw$.some()));
    }

    public Type int_type(Int bits) {
        return Type(LLVMIntTypeInContext(self.raw$.some(), UInt32(bits)));
    }

    public Type float_type() {
        return Type(LLVMFloatTypeInContext(self.raw$.some()));
    }

    public Type double_type() {
        return Type(LLVMDoubleTypeInContext(self.raw$.some()));
    }

    public Type pointer_type() {
        return Type(LLVMPointerTypeInContext(self.raw$.some(), 0));
    }
}

public struct Module {
    public LLVMModule*?! raw;

    public init(Context^ context, UInt8[*] name) {
        self.raw = LLVMModuleCreateWithNameInContext(name, context.raw$.some());
    }
}

extend Module {
    public Bool valid() {
        return self.raw != null;
    }

    public () dispose() {
        if (self.valid()) {
            LLVMDisposeModule(self.raw$.some());
            self.raw = null;
        }
    }

    public Value add_function(UInt8[*] name, Type function_type) {
        return Value(LLVMAddFunction(self.raw$.some(), name, function_type.raw$.some()));
    }
}

public struct Builder {
    public LLVMBuilder*?! raw;

    public init(Context^ context) {
        self.raw = LLVMCreateBuilderInContext(context.raw$.some());
    }
}

extend Builder {
    public Bool valid() {
        return self.raw != null;
    }

    public () dispose() {
        if (self.valid()) {
            LLVMDisposeBuilder(self.raw$.some());
            self.raw = null;
        }
    }
}

public Type function_type(Type return_type) {
    LLVMType*![*] params = LLVMType*$.alloc_array(1);
    return Type(LLVMFunctionType(return_type.raw$.some(), params$.as(LLVMType*[*]), 0, 0));
}
