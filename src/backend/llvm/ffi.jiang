    LLVMValue* LLVMConstReal(LLVMType* real_type, Float64 value);
    LLVMValue* LLVMConstNull(LLVMType* type);
    LLVMValue* LLVMBuildAdd(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
    LLVMValue* LLVMBuildSub(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
    LLVMValue* LLVMBuildMul(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
    LLVMValue* LLVMBuildSDiv(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
