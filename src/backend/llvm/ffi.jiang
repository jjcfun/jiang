public Value const_struct(Context& context, list.ArrayList<Value>& values) {
    Int count = values.len();
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }

    unsafe {
        LLVMValue*![*] raw_values = LLVMValue*$.alloc_many(capacity);
        Int! index = 0;
        while (index < count) {
            raw_values[index] = values.get(index).raw$.some();
            index = index + 1;
        }

        Value result = Value(LLVMConstStructInContext(
            context.raw$.some(),
            raw_values$.as(LLVMValue*[*]),
            UInt32(count),
            1
        ));
        raw_values$.dealloc();
        return result;
    }
}
