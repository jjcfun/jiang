    LLVMValue* LLVMBuildXor(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
    LLVMValue* LLVMBuildShl(LLVMBuilder* builder, LLVMValue* left, LLVMValue* right, CString name);
