// LLVM C API 最小 FFI 边界。
//
// `LLVMContext` / `LLVMModule` 等空 struct 只用于表达 C opaque pointee
// type；真正对外使用的是 `Context` / `Module` / `Builder` / `Type` /
// `Value` wrapper。wrapper 内部保留 raw pointer，但上层 backend 不直接
// 调用 LLVM C 函数。

import list = "../../support/list.jiang";
import std;

public struct LLVMContext {}
public struct LLVMModule {}
public struct LLVMBuilder {}
public struct LLVMType {}
public struct LLVMValue {}
public struct LLVMBasicBlock {}
public struct LLVMTarget {}
public struct LLVMTargetMachine {}
public struct LLVMTargetData {}
public struct LLVMAttribute {}
public struct LLVMError {}
public struct LLVMPassBuilderOptions {}

