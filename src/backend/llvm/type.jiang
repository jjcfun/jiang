// LLVM type lowering。
//
// 这一层只负责把 semantic TypeId / layout fact 映射成 LLVM Type，并提供
// projection lowering 需要的 layout field 查询。它不生成 LLVM instruction。

import layout_compute = "../../layout/compute.jiang";
import layout = "../../layout/layout.jiang";
import qid = "../../store/id.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import token = "../../syntax/token.jiang";
import backend_abi = "../abi.jiang";
import ffi = "./ffi.jiang";
import llvm_state = "./state.jiang";

public ffi.Type lower_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .invalid) {
        return ffi.Type();
    }
    if (info.data is .never) {
        return ffi.context_void_type(state.llvm_context);
    }
    if (info.data is .unit) {
        return ffi.context_void_type(state.llvm_context);
    }
    if (info.data is .bool_type) {
        return ffi.context_int_type(state.llvm_context, 1);
    }
    if (info.data is .char_type) {
        return ffi.context_int_type(state.llvm_context, 32);
    }
    if (info.data is .int_type(int_type)) {
        return lower_int_type(state, int_type);
    }
    if (info.data is .float_type(float_type)) {
        return lower_float_type(state, float_type);
    }
    if (info.data is .handle_type(handle_type)) {
        if (handle_type.kind == .slice
            || type_is_owned_slice_value_handle(state, handle_type)
            || handle_is_trait_object(state, handle_type)) {
            return lower_layout_backed_type(state, type_id);
        }
        return ffi.context_pointer_type(state.llvm_context);
    }
    if (info.data is .function_type(_)) {
        return ffi.context_pointer_type(state.llvm_context);
    }
    if (is_trait_vtable_type(state, type_id)) {
        return ffi.context_pointer_type(state.llvm_context);
    }
    return lower_layout_backed_type(state, type_id);
}

public ffi.Type lower_int_type(llvm_state.LowerState& state, types.IntType int_type) {
    Int! bits = int_type.bits;
    if (bits == 0) {
        bits = state.ctx.store.layouts.target.pointer_size * 8;
    }
    return ffi.context_int_type(state.llvm_context, bits);
}

public ffi.Type lower_float_type(llvm_state.LowerState& state, types.FloatType float_type) {
    if (float_type.bits == 16) {
        return ffi.context_half_type(state.llvm_context);
    }
    if (float_type.bits == 32) {
        return ffi.context_float_type(state.llvm_context);
    }
    return ffi.context_double_type(state.llvm_context);
}

public Int int_type_bits(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .int_type(int_type)) {
        if (int_type.bits == 0) {
            return state.ctx.store.layouts.target.pointer_size * 8;
        }
        return int_type.bits;
    }
    if (info.data is .bool_type) { return 1; }
    if (info.data is .char_type) { return 32; }
    return state.ctx.store.layouts.target.pointer_size * 8;
}

public Int float_type_bits(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .float_type(float_type)) {
        return float_type.bits;
    }
    return 64;
}

public Bool type_is_unit_or_never(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .unit) { return true; }
    if (info.data is .never) { return true; }
    return false;
}

public Bool type_has_abi_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    return backend_abi.type_has_abi_value(state.ctx, type_id);
}

public Bool type_is_slice(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .handle_type(handle_type)) {
        return handle_type.kind == .slice;
    }
    return false;
}

public Bool type_is_owned_slice_value(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .handle_type(handle_type) else { return false; }
    return type_is_owned_slice_value_handle(state, handle_type);
}

Bool type_is_owned_slice_value_handle(llvm_state.LowerState& state, types.HandleType handle_type) {
    if (handle_type.kind != .owner_pointer) { return false; }
    types.TypeInfo element_info = state.ctx.store.types.get(handle_type.element);
    return element_info.data is .slice_value_type(_);
}

public Bool type_is_trait_object_handle(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .handle_type(handle_type) else { return false; }
    return handle_is_trait_object(state, handle_type);
}

Bool handle_is_trait_object(llvm_state.LowerState& state, types.HandleType handle_type) {
    if (handle_type.kind != .reference && handle_type.kind != .owner_pointer) {
        return false;
    }
    types.TypeInfo element = state.ctx.store.types.get(handle_type.element);
    guard element.data is .trait_companion(companion) else { return false; }
    return companion.kind == .any;
}

public Int array_count(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .array_type(array_type)) {
        return array_type.count;
    }
    return -1;
}

public Bool type_is_handle(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    return info.data is .handle_type(_);
}

public qid.TypeId element_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    if (info.data is .array_type(array_type)) {
        return array_type.element;
    }
    if (info.data is .handle_type(handle_type)) {
        if (type_is_owned_slice_value_handle(state, handle_type)) {
            types.TypeInfo element_info = state.ctx.store.types.get(handle_type.element);
            guard element_info.data is .slice_value_type(array_type) else {
                return state.ctx.store.types.invalid_type();
            }
            return array_type.element;
        }
        return handle_type.element;
    }
    if (info.data is .optional(optional_type)) {
        return optional_type.element;
    }
    return state.ctx.store.types.invalid_type();
}

public qid.TypeId constant_index_type(llvm_state.LowerState& state, qid.TypeId type_id, Int offset) {
    if (trait_vtable_field_type(state, type_id, offset) is .some(field_type)) {
        return field_type;
    }
    if (offset < layout_field_count(state, type_id)) {
        return layout_for_type(state, type_id).fields[offset].field_type;
    }
    return element_type(state, type_id);
}

public Int layout_field_count(llvm_state.LowerState& state, qid.TypeId type_id) {
    layout.TypeLayout type_layout = layout_for_type(state, type_id);
    return type_layout.fields.length;
}

public Int layout_field_element_index(llvm_state.LowerState& state, qid.TypeId type_id, Int field_index) {
    layout.TypeLayout type_layout = layout_for_type(state, type_id);
    // Tagged union 的多个 variant payload 在 source layout 中共享同一段
    // offset；LLVM struct 里只保留一个 payload byte storage。
    if (layout_uses_payload_storage(state, type_layout, field_index) is .some(payload_element)) {
        return payload_element;
    }
    Int! element_index = 0;
    Int! offset = 0;
    Int! index = 0;
    while (index < field_index) {
        layout.FieldLayout field = type_layout.fields[index];
        layout.TypeLayout field_layout = layout_for_type(state, field.field_type);
        if (field_layout.kind == .zero_sized) {
            index = index + 1;
            continue;
        }
        if (field.offset > offset) {
            element_index = element_index + 1;
        }
        element_index = element_index + 1;
        offset = field.offset + field_layout.size;
        index = index + 1;
    }
    if (type_layout.fields[field_index].offset > offset) {
        element_index = element_index + 1;
    }
    return element_index;
}

public Bool is_trait_vtable_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .trait_companion(companion) else { return false; }
    return companion.kind == .vtable;
}

public ffi.Type trait_vtable_storage_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    guard trait_vtable_trait_def(state, type_id) is .some(trait_def) else {
        return ffi.Type();
    }
    list.ArrayList<ffi.Type>! fields = list.ArrayList<ffi.Type>();
    fields.add(ffi.context_pointer_type(state.llvm_context));
    Int! index = 0;
    while (index < trait_vtable_field_count(state, trait_def)) {
        guard trait_vtable_member_at(state, trait_def, index) is .some(member_def) else {
            return ffi.Type();
        }
        qid.TypeId field_type = trait_vtable_slot_type(state, trait_def, member_def);
        fields.add(lower_type(state, field_type));
        index = index + 1;
    }
    return ffi.context_struct_type(state.llvm_context, fields$.ref());
}

public qid.TypeId? trait_vtable_field_type(llvm_state.LowerState& state, qid.TypeId type_id, Int offset) {
    guard trait_vtable_trait_def(state, type_id) is .some(trait_def) else { return null; }
    if (offset == 0) {
        return receiver_type_info_pointer_type(state);
    }
    guard trait_vtable_member_at(state, trait_def, offset - 1) is .some(member_def) else { return null; }
    return trait_vtable_slot_type(state, trait_def, member_def);
}

qid.TypeId receiver_type_info_pointer_type(llvm_state.LowerState& state) {
    return state.ctx.store.types.raw_pointer_type(receiver_type_info_type(state), token.Span());
}

qid.TypeId receiver_type_info_type(llvm_state.LowerState& state) {
    list.ArrayList<qid.TypeId>! fields = list.ArrayList<qid.TypeId>(3);
    fields.add(receiver_drop_function_type(state));
    fields.add(state.ctx.store.types.int_type());
    fields.add(state.ctx.store.types.int_type());
    return state.ctx.store.types.tuple_type(fields$.move(), token.Span());
}

qid.TypeId receiver_drop_function_type(llvm_state.LowerState& state) {
    list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(1);
    params.add(state.ctx.store.types.raw_pointer_type(state.ctx.store.types.uint8_type(), token.Span()));
    return state.ctx.store.types.function_type(params$.move(), state.ctx.store.types.unit_type(), token.Span());
}

qid.DefId? trait_vtable_trait_def(llvm_state.LowerState& state, qid.TypeId type_id) {
    types.TypeInfo info = state.ctx.store.types.get(type_id);
    guard info.data is .trait_companion(companion) else { return null; }
    if (companion.kind != .vtable) { return null; }
    return companion.trait_def;
}

Int trait_vtable_field_count(llvm_state.LowerState& state, qid.DefId trait_def) {
    Int! count = 0;
    guard state.ctx.store.hirs.def(trait_def) is .some(hir_def) else { return 0; }
    Int! index = 0;
    while (index < hir_def.members.len()) {
        qid.DefId member_def = hir_def.members.get(index);
        if (state.ctx.store.defs.get(member_def).kind == .function_def) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

qid.DefId? trait_vtable_member_at(llvm_state.LowerState& state, qid.DefId trait_def, Int offset) {
    Int! slot = 0;
    guard state.ctx.store.hirs.def(trait_def) is .some(hir_def) else { return null; }
    Int! index = 0;
    while (index < hir_def.members.len()) {
        qid.DefId member_def = hir_def.members.get(index);
        if (state.ctx.store.defs.get(member_def).kind == .function_def) {
            if (slot == offset) { return member_def; }
            slot = slot + 1;
        }
        index = index + 1;
    }
    return null;
}

qid.TypeId trait_vtable_slot_type(llvm_state.LowerState& state, qid.DefId trait_def, qid.DefId method_def) {
    qid.TypeId method_type = state.ctx.store.typeck.def_type(method_def)$.some();
    types.TypeInfo info = state.ctx.store.types.get(method_type);
    guard info.data is .function_type(function_type) else { return state.ctx.store.types.invalid_type(); }
    list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
    Int! index = 0;
    while (index < function_type.params.length) {
        if (index == 0 && function_has_receiver(state, method_def)) {
            params.add(state.ctx.store.types.trait_companion_type(trait_def, .receiver, token.Span()));
        } else {
            params.add(function_type.params[index]);
        }
        index = index + 1;
    }
    return state.ctx.store.types.function_type(params$.move(), function_type.result, token.Span());
}

Bool function_has_receiver(llvm_state.LowerState& state, qid.DefId function_def) {
    guard state.ctx.store.hirs.def(function_def) is .some(hir_def) else { return false; }
    guard hir_def.decl.function_signature is .some(signature) else { return false; }
    return signature.has_receiver;
}

public Bool layout_field_uses_payload_storage(
    llvm_state.LowerState& state,
    qid.TypeId type_id,
    Int field_index
) {
    layout.TypeLayout type_layout = layout_for_type(state, type_id);
    return layout_uses_payload_storage(state, type_layout, field_index) != null;
}

public layout.TypeLayout layout_for_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    layout.LayoutId layout_id = layout_compute.layout_of_type(state.ctx, type_id);
    return state.ctx.store.layouts.layout(layout_id);
}

public Int layout_size(llvm_state.LowerState& state, qid.TypeId type_id) {
    return layout_for_type(state, type_id).size;
}

public Int layout_align(llvm_state.LowerState& state, qid.TypeId type_id) {
    return layout_for_type(state, type_id).align;
}

ffi.Type lower_layout_backed_type(llvm_state.LowerState& state, qid.TypeId type_id) {
    layout.TypeLayout type_layout = layout_for_type(state, type_id);
    if (type_layout.kind == .invalid) {
        return ffi.Type();
    }
    if (type_layout.kind == .zero_sized) {
        return ffi.context_void_type(state.llvm_context);
    }
    if (type_layout.kind == .scalar) {
        return ffi.context_int_type(state.llvm_context, type_layout.size * 8);
    }
    if (type_layout.kind == .function_pointer) {
        return ffi.context_pointer_type(state.llvm_context);
    }
    return lower_aggregate_layout_type(state, type_layout);
}

ffi.Type lower_aggregate_layout_type(llvm_state.LowerState& state, layout.TypeLayout type_layout) {
    // Layout 仍表达真实的重叠 payload；LLVM type 不能直接用多个同 offset
    // field 表达，所以 lowering 成 `{ tag, payload_bytes }` 形态。
    if (layout_payload_storage_offset(state, type_layout) is .some(payload_offset)) {
        return lower_payload_storage_layout_type(state, type_layout, payload_offset);
    }
    list.ArrayList<ffi.Type>! elements = list.ArrayList<ffi.Type>(type_layout.fields.length);
    Int! offset = 0;
    Int! index = 0;
    while (index < type_layout.fields.length) {
        layout.FieldLayout field = type_layout.fields[index];
        if (field.offset < offset) {
            return lower_byte_array_type(state, type_layout.size);
        }
        layout.TypeLayout field_layout = layout_for_type(state, field.field_type);
        if (field_layout.kind == .zero_sized) {
            index = index + 1;
            continue;
        }
        add_padding_elements(state, elements$.ref(), field.offset - offset);
        ffi.Type field_type = lower_type(state, field.field_type);
        if (!ffi.type_valid(field_type)) {
            return ffi.Type();
        }
        elements.add(field_type);
        offset = field.offset + field_layout.size;
        index = index + 1;
    }
    add_padding_elements(state, elements$.ref(), type_layout.size - offset);
    return ffi.context_struct_type(state.llvm_context, elements$.ref());
}

ffi.Type lower_payload_storage_layout_type(
    llvm_state.LowerState& state,
    layout.TypeLayout type_layout,
    Int payload_offset
) {
    list.ArrayList<ffi.Type>! elements = list.ArrayList<ffi.Type>(type_layout.fields.length);
    Int! offset = 0;
    Int! index = 0;
    while (index < type_layout.fields.length) {
        layout.FieldLayout field = type_layout.fields[index];
        if (field.offset >= payload_offset) {
            add_padding_elements(state, elements$.ref(), payload_offset - offset);
            elements.add(lower_byte_array_type(state, type_layout.size - payload_offset));
            return ffi.context_struct_type(state.llvm_context, elements$.ref());
        }
        layout.TypeLayout field_layout = layout_for_type(state, field.field_type);
        if (field_layout.kind == .zero_sized) {
            index = index + 1;
            continue;
        }
        add_padding_elements(state, elements$.ref(), field.offset - offset);
        ffi.Type field_type = lower_type(state, field.field_type);
        if (!ffi.type_valid(field_type)) {
            return ffi.Type();
        }
        elements.add(field_type);
        offset = field.offset + field_layout.size;
        index = index + 1;
    }
    add_padding_elements(state, elements$.ref(), type_layout.size - offset);
    return ffi.context_struct_type(state.llvm_context, elements$.ref());
}

Int? layout_uses_payload_storage(
    llvm_state.LowerState& state,
    layout.TypeLayout type_layout,
    Int field_index
) {
    guard layout_payload_storage_offset(state, type_layout) is .some(payload_offset) else {
        return null;
    }
    if (type_layout.fields[field_index].offset < payload_offset) {
        return null;
    }
    return layout_payload_storage_element_index(state, type_layout, payload_offset);
}

Int? layout_payload_storage_offset(llvm_state.LowerState& state, layout.TypeLayout type_layout) {
    if (type_layout.payload_storage_offset < 0) {
        return null;
    }
    return type_layout.payload_storage_offset;
}

Int layout_payload_storage_element_index(
    llvm_state.LowerState& state,
    layout.TypeLayout type_layout,
    Int payload_offset
) {
    Int! element_index = 0;
    Int! offset = 0;
    Int! index = 0;
    while (index < type_layout.fields.length) {
        layout.FieldLayout field = type_layout.fields[index];
        if (field.offset >= payload_offset) {
            if (payload_offset > offset) {
                element_index = element_index + 1;
            }
            return element_index;
        }
        layout.TypeLayout field_layout = layout_for_type(state, field.field_type);
        if (field_layout.kind == .zero_sized) {
            index = index + 1;
            continue;
        }
        if (field.offset > offset) {
            element_index = element_index + 1;
        }
        element_index = element_index + 1;
        offset = field.offset + field_layout.size;
        index = index + 1;
    }
    return element_index;
}

ffi.Type lower_byte_array_type(llvm_state.LowerState& state, Int size) {
    if (size <= 0) {
        return ffi.context_void_type(state.llvm_context);
    }
    return ffi.array_type(ffi.context_int_type(state.llvm_context, 8), size);
}

() add_padding_elements(llvm_state.LowerState& state, list.ArrayList<ffi.Type>& elements, Int size) {
    if (size <= 0) {
        return;
    }
    elements.add(lower_byte_array_type(state, size));
}
