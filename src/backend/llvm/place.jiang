// JIL place -> LLVM pointer/value lowering。
//
// JIL place 负责描述 local + projection。这里把 projection walk 集中起来，
// 避免 rvalue/terminator lowering 直接关心 field、deref、index 的 LLVM GEP 细节。

import jil = "../../jil.jiang";
import diagnostic = "../../diagnostic.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import list = "../../support/list.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_state = "./state.jiang";
import llvm_type = "./type.jiang";
import symbol = "../symbol.jiang";
import std;

public qid.TypeId place_type(llvm_state.LowerState& state, jil.Body& body, jil.Place place) {
    qid.TypeId current! = place_base_type(state, body, place);
    Int index! = 0;
    while (index < place.projection.length) {
        jil.PlaceElem elem = place.projection[index];
        current = next_projection_type(state, current, elem);
        if (current == state.ctx.store.types.invalid_type()) { return current; }
        index = index + 1;
    }
    return state.type_id(current);
}

public ffi.Value lower_local_load(
    llvm_state.LowerState& state,
    jil.LocalDecl local,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (!llvm_type.type_has_abi_value(state, local.type_id)) {
        return ffi.Value();
    }
    ffi.Type type = llvm_type.lower_type(state, local.type_id);
    if (!ffi.type_valid(type)) {
        return ffi.Value();
    }
    ffi.Value slot = local_slots.get(local.id.to_index());
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), type, slot);
}

public ffi.Value lower_place_value(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Place place,
    list.ArrayList<ffi.Value>& local_slots
) {
    qid.TypeId type_id = place_type(state, body, place);
    if (!llvm_type.type_has_abi_value(state, type_id)) {
        return ffi.Value();
    }
    ffi.Value pointer = lower_place_pointer(state, output, body, place, local_slots);
    if (!ffi.value_valid(pointer)) {
        add_place_codegen_error(output, "failed to lower LLVM place pointer", "llvm_place_pointer_lower_failed");
        return ffi.Value();
    }
    ffi.Type type = llvm_type.lower_type(state, type_id);
    if (!ffi.type_valid(type)) {
        add_place_codegen_error(output, "failed to lower LLVM place type", "llvm_place_type_lower_failed");
        return ffi.Value();
    }
    return ffi.builder_build_load(state.builder$.ref(), type, pointer);
}

public ffi.Value lower_place_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    jil.Body& body,
    jil.Place place,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value pointer! = lower_place_base_pointer(state, body, place, local_slots);
    qid.TypeId current_type! = place_base_type(state, body, place);
    Int index! = 0;
    while (index < place.projection.length) {
        jil.PlaceElem elem = place.projection[index];
        pointer = lower_projection_elem(state, output, pointer, current_type, elem, local_slots);
        if (!ffi.value_valid(pointer)) {
            add_projection_codegen_error(output, elem);
            return ffi.Value();
        }
        current_type = next_projection_type(state, current_type, elem);
        index = index + 1;
    }
    return pointer;
}

qid.TypeId place_base_type(llvm_state.LowerState& state, jil.Body& body, jil.Place place) {
    if (place.base is .global(global_ref)) {
        return global_ref.type_id;
    }
    return local_type(body, place.local_id);
}

ffi.Value lower_place_base_pointer(
    llvm_state.LowerState& state,
    jil.Body& body,
    jil.Place place,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (place.base is .global(global_ref)) {
        return lower_global_place_pointer(state, global_ref);
    }
    return local_slots.get(place.local_id.to_index());
}

ffi.Value lower_global_place_pointer(llvm_state.LowerState& state, jil.GlobalRef global_ref) {
    std.String name = symbol.global_symbol_name_for_ref(state.ctx, state.store, global_ref);
    ffi.Type value_type = llvm_type.lower_type(state, global_ref.type_id);
    if (!ffi.type_valid(value_type)) {
        return ffi.Value();
    }
    ffi.Value existing = ffi.module_get_global(state.module$.ref(), name.bytes());
    if (ffi.value_valid(existing)) {
        return existing;
    }
    return ffi.module_add_global(state.module$.ref(), name.bytes(), value_type);
}

Void add_projection_codegen_error(llvm_state.LowerOutput&! output, jil.PlaceElem elem) {
    if (elem is .field_projection(_)) {
        add_place_codegen_error(output, "failed to lower LLVM field projection", "llvm_field_projection_lower_failed");
        return;
    }
    if (elem is .frame_field_projection(_)) {
        add_place_codegen_error(
            output,
            "failed to lower LLVM coroutine frame field projection",
            "llvm_frame_field_projection_lower_failed"
        );
        return;
    }
    if (elem is .deref_projection(_)) {
        add_place_codegen_error(output, "failed to lower LLVM deref projection", "llvm_deref_projection_lower_failed");
        return;
    }
    if (elem is .index_projection(_)) {
        add_place_codegen_error(output, "failed to lower LLVM index projection", "llvm_index_projection_lower_failed");
        return;
    }
    if (elem is .constant_index_projection(_)) {
        add_place_codegen_error(
            output,
            "failed to lower LLVM constant index projection",
            "llvm_constant_index_projection_lower_failed"
        );
        return;
    }
    add_place_codegen_error(output, "failed to lower LLVM place projection", "llvm_place_projection_lower_failed");
}

Void add_place_codegen_error(
    llvm_state.LowerOutput&! output,
    UInt8[]& message,
    UInt8[]& code
) {
    output.add_diagnostic(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}

ffi.Value lower_projection_elem(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId current_type,
    jil.PlaceElem elem,
    list.ArrayList<ffi.Value>& local_slots
) {
    if (elem is .deref_projection(_)) {
        return lower_deref_pointer(state, pointer);
    }
    if (elem is .field_projection(field)) {
        guard llvm_type.layout_field_index_for_def(state, current_type, field.field_def)
            is .some(field_index) else {
            add_place_codegen_error(
                output,
                "failed to resolve LLVM field projection",
                "llvm_field_projection_resolve_failed"
            );
            return ffi.Value();
        }
        return lower_layout_field_pointer(state, output, pointer, current_type, field_index);
    }
    if (elem is .frame_field_projection(field)) {
        return lower_layout_field_pointer(state, output, pointer, current_type, field.field_index);
    }
    if (elem is .index_projection(index_projection)) {
        return lower_index_pointer(
            state, output, pointer, current_type, index_projection.index_local, local_slots
        );
    }
    if (elem is .constant_index_projection(constant_index)) {
        return lower_constant_index_pointer(state, output, pointer, current_type, constant_index.offset);
    }
    return ffi.Value();
}

qid.TypeId next_projection_type(llvm_state.LowerState& state, qid.TypeId current_type, jil.PlaceElem elem) {
    if (elem is .field_projection(field)) {
        guard llvm_type.layout_field_type_for_def(state, current_type, field.field_def)
            is .some(field_type) else {
            return state.ctx.store.types.invalid_type();
        }
        return field_type;
    }
    if (elem is .frame_field_projection(field)) {
        return state.type_id(field.field_type);
    }
    if (elem is .constant_index_projection(constant_index)) {
        return state.type_id(constant_index.field_type);
    }
    return llvm_type.element_type(state, current_type);
}

ffi.Value lower_deref_pointer(llvm_state.LowerState& state, ffi.Value pointer) {
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    return ffi.builder_build_load(state.builder$.ref(), pointer_type, pointer);
}

public ffi.Value lower_layout_field_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId owner_type,
    Int field_index
) {
    if (llvm_type.is_trait_vtable_type(state, owner_type)) {
        return lower_trait_vtable_field_pointer(state, pointer, owner_type, field_index);
    }
    layout.TypeLayout owner_layout = llvm_type.layout_for_type(state, owner_type);
    if (owner_layout.kind == .zero_sized) { return pointer; }
    if (field_index < owner_layout.fields.length) {
        layout.TypeLayout field_layout = llvm_type.layout_for_type(
            state, owner_layout.fields[field_index].field_type
        );
        if (field_layout.kind == .zero_sized) { return pointer; }
    }
    ffi.Type owner_llvm_type = llvm_type.lower_type(state, owner_type);
    if (!ffi.type_valid(owner_llvm_type)) {
        add_place_codegen_error(output, "failed to lower LLVM field owner type", "llvm_field_owner_type_lower_failed");
        return ffi.Value();
    }

    list.ArrayList<ffi.Value> indices! = list.ArrayList<ffi.Value>(2);
    indices.add(int32_value(state, 0));
    Int element_index = llvm_type.layout_field_element_index(
        state, owner_type, field_index
    );
    indices.add(int32_value(state, element_index));
    ffi.Value result = ffi.builder_build_gep(
        state.builder$.ref(), owner_llvm_type, pointer, indices$.ref()
    );
    if (ffi.value_valid(result)) { return result; }
    std.StringBuilder message! = std.StringBuilder();
    message.append("failed to build LLVM field GEP: owner TypeId ");
    message.append(state.type_id(owner_type).to_index());
    message.append(", field ");
    message.append(field_index);
    message.append(", element ");
    message.append(element_index);
    message.append(", fields ");
    message.append(llvm_type.layout_field_count(state, owner_type));
    add_place_codegen_error(
        output, message.into_string().bytes(), "llvm_field_gep_failed"
    );
    return ffi.Value();
}

ffi.Value lower_trait_vtable_field_pointer(
    llvm_state.LowerState& state,
    ffi.Value pointer,
    qid.TypeId owner_type,
    Int field_index
) {
    ffi.Type pointer_type = ffi.context_pointer_type(state.llvm_context$.ref());
    ffi.Value storage_pointer = ffi.builder_build_load(state.builder$.ref(), pointer_type, pointer);
    if (!ffi.value_valid(storage_pointer)) {
        return ffi.Value();
    }

    list.ArrayList<ffi.Value> indices! = list.ArrayList<ffi.Value>(2);
    indices.add(int32_value(state, 0));
    indices.add(int32_value(state, field_index));
    ffi.Type storage_type = llvm_type.trait_vtable_storage_type(state, owner_type);
    return ffi.builder_build_gep(
        state.builder$.ref(),
        storage_type,
        storage_pointer,
        indices$.ref()
    );
}

ffi.Value lower_index_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId owner_type,
    jil.LocalId index_local,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value index_value = lower_local_index_value(state, index_local, local_slots);
    return lower_dynamic_index_pointer(state, output, pointer, owner_type, index_value);
}

ffi.Value lower_constant_index_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId owner_type,
    Int offset
) {
    if (llvm_type.is_trait_vtable_type(state, owner_type)) {
        return lower_trait_vtable_field_pointer(state, pointer, owner_type, offset);
    }
    Int field_count = llvm_type.layout_field_count(state, owner_type);
    if (offset < field_count) {
        return lower_layout_field_pointer(state, output, pointer, owner_type, offset);
    }
    ffi.Value result = lower_dynamic_index_pointer(
        state, output, pointer, owner_type, int32_value(state, offset)
    );
    if (ffi.value_valid(result)) { return result; }
    std.StringBuilder message! = std.StringBuilder();
    message.append("failed to lower constant index: owner TypeId ");
    message.append(state.type_id(owner_type).to_index());
    message.append(", offset ");
    message.append(offset);
    message.append(", fields ");
    message.append(field_count);
    layout.TypeLayout owner_layout = llvm_type.layout_for_type(state, owner_type);
    message.append(", layout kind ");
    message.append(Int(owner_layout.kind));
    append_type_details(state, message$.mut_ref(), owner_type);
    add_place_codegen_error(
        output, message.into_string().bytes(), "llvm_constant_index_type_failed"
    );
    return ffi.Value();
}

Void append_type_details(
    llvm_state.LowerState& state,
    std.StringBuilder&! message,
    qid.TypeId type_id
) {
    types.TypeInfo info = llvm_type.type_info(state, type_id);
    if (info.data is .named(named)) {
        message.append(", named DefId ");
        message.append(named.def_id.to_index());
        return;
    }
    if (info.data is .function_type(function_type)) {
        message.append(", function kind ");
        message.append(Int(function_type.kind));
        return;
    }
    if (info.data is .handle_type(handle)) {
        message.append(", handle kind ");
        message.append(Int(handle.kind));
        return;
    }
    if (info.data is .tuple_type(tuple_type)) {
        message.append(", tuple items ");
        message.append(tuple_type.items.length);
        Int index! = 0;
        while (index < tuple_type.items.length && index < 2) {
            qid.TypeId item = state.type_id(tuple_type.items[index]);
            message.append(", item ");
            message.append(index);
            message.append(" TypeId ");
            message.append(item.to_index());
            append_type_kind(message, llvm_type.type_info(state, item));
            index = index + 1;
        }
        return;
    }
    if (info.data is .int_type(_)) { message.append(", int"); return; }
    if (info.data is .unit) { message.append(", void"); return; }
    message.append(", other type");
}

Void append_type_kind(std.StringBuilder&! message, types.TypeInfo info) {
    if (info.data is .named(named)) {
        message.append(" named DefId ");
        message.append(named.def_id.to_index());
        return;
    }
    if (info.data is .function_type(function_type)) {
        message.append(" function kind ");
        message.append(Int(function_type.kind));
        return;
    }
    if (info.data is .handle_type(handle)) {
        message.append(" handle kind ");
        message.append(Int(handle.kind));
        return;
    }
    if (info.data is .unit) { message.append(" void"); return; }
    message.append(" other");
}

ffi.Value lower_dynamic_index_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId owner_type,
    ffi.Value index_value
) {
    if (!ffi.value_valid(index_value)) {
        return ffi.Value();
    }
    qid.TypeId element_type = llvm_type.element_type(state, owner_type);
    ffi.Type element_llvm_type = llvm_type.lower_type(state, element_type);
    if (!ffi.type_valid(element_llvm_type)) {
        return ffi.Value();
    }

    ffi.Value data_pointer = lower_index_base_pointer(state, output, pointer, owner_type);
    if (!ffi.value_valid(data_pointer)) {
        return ffi.Value();
    }

    list.ArrayList<ffi.Value> indices! = list.ArrayList<ffi.Value>(1);
    indices.add(index_value);
    return ffi.builder_build_gep(state.builder$.ref(), element_llvm_type, data_pointer, indices$.ref());
}

ffi.Value lower_index_base_pointer(
    llvm_state.LowerState& state,
    llvm_state.LowerOutput&! output,
    ffi.Value pointer,
    qid.TypeId owner_type
) {
    if (llvm_type.type_is_slice(state, owner_type)) {
        ffi.Value data_field = lower_layout_field_pointer(state, output, pointer, owner_type, 0);
        return lower_deref_pointer(state, data_field);
    }
    if (llvm_type.type_is_owned_slice_value(state, owner_type)) {
        ffi.Value data_field = lower_layout_field_pointer(state, output, pointer, owner_type, 0);
        return lower_deref_pointer(state, data_field);
    }
    if (llvm_type.type_is_handle(state, owner_type)) {
        return lower_deref_pointer(state, pointer);
    }
    return pointer;
}

ffi.Value lower_local_index_value(
    llvm_state.LowerState& state,
    jil.LocalId index_local,
    list.ArrayList<ffi.Value>& local_slots
) {
    ffi.Value slot = local_slots.get(index_local.to_index());
    if (!ffi.value_valid(slot)) {
        return ffi.Value();
    }
    ffi.Type int_type = ffi.context_int_type(state.llvm_context$.ref(), 64);
    return ffi.builder_build_load(state.builder$.ref(), int_type, slot);
}

qid.TypeId local_type(jil.Body& body, jil.LocalId local_id) {
    return body.locals[local_id.to_index()].type_id;
}

ffi.Value int32_value(llvm_state.LowerState& state, Int value) {
    return ffi.const_int(ffi.context_int_type(state.llvm_context$.ref(), 32), UInt64(value));
}
