// LLVM backend facade。
//
// 这个目录是唯一允许承载 LLVM-specific lowering 的地方。上层 backend 只关心
// MIR/package 级输入和 BackendResult；真实 LLVM C binding 只能通过 ffi.jiang
// 访问，不能散落到 pipeline/MIR/layout 或 backend facade。

import context = "../../context.jiang";
import diagnostic = "../../diagnostic/diagnostic.jiang";
import mir = "../../mir/mir.jiang";
import codegen_unit = "../codegen_unit.jiang";
import symbol = "../symbol.jiang";
import ffi = "./ffi.jiang";
import llvm_lower = "./lower.jiang";

public UInt8[] llvm_version_text() {
    return ffi.llvm_version_text();
}

public UInt8[] default_target_triple_text() {
    return ffi.default_target_triple_text();
}

public Bool emit(context.CompilerContext& ctx, mir.MirStore& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return false;
    }
    if (!llvm_lower.lower_module(ctx, store)) {
        return false;
    }
    if (ctx.store.layouts.has_errors()) {
        return false;
    }
    return store.ok;
}

public Bool emit_object(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    UInt8[*] output_path,
    Int opt_level,
    UInt8[] pass_pipeline
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return false;
    }
    if (!llvm_lower.emit_object_file(ctx, store, output_path, opt_level, pass_pipeline)) {
        return false;
    }
    if (ctx.store.layouts.has_errors()) {
        return false;
    }
    return store.ok;
}

public Bool emit_object_for_unit(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    codegen_unit.CodegenUnit& unit,
    UInt8[*] output_path,
    Int opt_level,
    UInt8[] pass_pipeline
) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return false;
    }
    if (!llvm_lower.emit_object_unit_file(ctx, store, unit, output_path, opt_level, pass_pipeline)) {
        return false;
    }
    if (ctx.store.layouts.has_errors()) {
        return false;
    }
    return store.ok;
}

public Bool emit_llvm_ir(context.CompilerContext& ctx, mir.MirStore& store, UInt8[*] output_path) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol key", "llvm_duplicate_symbol_key");
        return false;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol name", "llvm_duplicate_symbol_name");
        return false;
    }
    if (!llvm_lower.emit_llvm_ir_file(ctx, store, output_path)) {
        add_codegen_error(ctx, "llvm ir file emission failed", "llvm_ir_emit_failed");
        return false;
    }
    if (ctx.store.layouts.has_errors()) {
        add_codegen_error(ctx, "layout error during llvm emission", "llvm_layout_error");
        return false;
    }
    if (!store.ok) {
        add_codegen_error(ctx, "MIR store has errors during llvm emission", "llvm_mir_store_error");
    }
    return store.ok;
}

public UInt8[]? emit_llvm_ir_text(context.CompilerContext& ctx, mir.MirStore& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol key", "llvm_duplicate_symbol_key");
        return null;
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        add_codegen_error(ctx, "duplicate llvm function symbol name", "llvm_duplicate_symbol_name");
        return null;
    }
    guard llvm_lower.emit_llvm_ir_text(ctx, store) is some text else {
        add_codegen_error(ctx, "llvm ir text emission failed", "llvm_ir_text_emit_failed");
        return null;
    }
    if (ctx.store.layouts.has_errors()) {
        add_codegen_error(ctx, "layout error during llvm emission", "llvm_layout_error");
        return null;
    }
    if (!store.ok) {
        add_codegen_error(ctx, "MIR store has errors during llvm emission", "llvm_mir_store_error");
        return null;
    }
    return text;
}

() add_codegen_error(context.CompilerContext& ctx, UInt8[] message, UInt8[] code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
