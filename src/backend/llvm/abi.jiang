// C ABI plan -> LLVM 表达。
//
// `backend/abi.jiang` 只做 backend-independent 分类；本文件只负责把分类结果
// 翻译成 LLVM function type 和 byval/sret attribute。

import backend_abi = "../abi.jiang";
import attributes = "../../jil/analysis/attributes.jiang";
import list = "../../support/list.jiang";
import types = "../../sema/type.jiang";
import ffi = "./ffi.jiang";
import llvm_state = "./state.jiang";
import llvm_type = "./type.jiang";

public ffi.Type function_type(llvm_state.LowerState& state, backend_abi.FunctionAbi& function_abi) {
    ffi.Type return_type = return_type(state, function_abi.result);
    if (!ffi.type_valid(return_type)) {
        return ffi.Type();
    }
    list.ArrayList<ffi.Type> params! = list.ArrayList<ffi.Type>(function_abi.llvm_param_count());
    if (function_abi.result.is_indirect()) {
        params.add(ffi.context_pointer_type(state.llvm_context$.ref()));
    }
    Int index! = 0;
    while (index < function_abi.params.len()) {
        backend_abi.AbiArg param = function_abi.params.get(index);
        if (param.has_llvm_param()) {
            ffi.Type lowered = param_type(state, param);
            if (!ffi.type_valid(lowered)) { return ffi.Type(); }
            params.add(lowered);
        }
        index = index + 1;
    }
    return ffi.function_type(return_type, params$.ref());
}

public ffi.Type return_type(llvm_state.LowerState& state, backend_abi.AbiArg result) {
    if (result.kind == .none || result.kind == .indirect) {
        return ffi.context_void_type(state.llvm_context$.ref());
    }
    return llvm_type.lower_type(state, result.type_id);
}

public ffi.Type param_type(llvm_state.LowerState& state, backend_abi.AbiArg param) {
    if (param.kind == .indirect) {
        return ffi.context_pointer_type(state.llvm_context$.ref());
    }
    return llvm_type.lower_type(state, param.type_id);
}

// function declaration 和 call site 都要携带同一组 type attribute，
// 否则 LLVM 只看到 pointer，C ABI 分类信息会丢失。
public Void add_function_attributes(
    llvm_state.LowerState& state,
    ffi.Value llvm_function,
    backend_abi.FunctionAbi& function_abi
) {
    add_attributes(state, llvm_function, function_abi, true);
}

public Void add_call_attributes(
    llvm_state.LowerState& state,
    ffi.Value call,
    backend_abi.FunctionAbi& function_abi
) {
    add_attributes(state, call, function_abi, false);
}

public Void add_proven_parameter_attributes(
    llvm_state.LowerState& state,
    ffi.Value llvm_function,
    backend_abi.FunctionAbi& function_abi,
    attributes.FunctionFacts& facts
) {
    Int llvm_index! = 1;
    if (function_abi.result.is_indirect()) {
        llvm_index = llvm_index + 1;
    }
    Int parameter_index! = 0;
    while (parameter_index < function_abi.params.len()) {
        backend_abi.AbiArg parameter = function_abi.params.get(parameter_index);
        if (parameter.has_llvm_param()) {
            if (parameter_accepts_pointer_attributes(state, parameter)) {
                add_parameter_facts(
                    state,
                    llvm_function,
                    llvm_index,
                    facts.parameters.get(parameter_index)
                );
            }
            llvm_index = llvm_index + 1;
        }
        parameter_index = parameter_index + 1;
    }
}

Bool parameter_accepts_pointer_attributes(
    llvm_state.LowerState& state,
    backend_abi.AbiArg parameter
) {
    types.TypeInfo info = state.ctx.store.types.get(parameter.type_id);
    guard info.data is .handle_type(handle) else { return false; }
    if (!types.is_reference_handle(handle)) { return false; }
    types.TypeInfo element = state.ctx.store.types.get(handle.element);
    if (element.data is .slice_value_type(_)) { return false; }
    if (element.data is .trait_companion(companion)) {
        return companion.kind != .any;
    }
    return true;
}

Void add_parameter_facts(
    llvm_state.LowerState& state,
    ffi.Value llvm_function,
    Int llvm_index,
    attributes.ParameterFacts facts
) {
    if (facts.nocapture) {
        // LLVM 22 将旧 nocapture 表达为 captures(none) 的 IntAttr。
        ffi.function_add_enum_attribute_value(
            state.llvm_context$.ref(),
            llvm_function,
            llvm_index,
            "captures",
            UInt64(0)
        );
    }
    if (facts.noalias) {
        ffi.function_add_enum_attribute(
            state.llvm_context$.ref(),
            llvm_function,
            llvm_index,
            "noalias"
        );
    }
    if (facts.readonly) {
        ffi.function_add_enum_attribute(
            state.llvm_context$.ref(),
            llvm_function,
            llvm_index,
            "readonly"
        );
    }
    if (facts.dereferenceable_bytes <= 0) { return; }
    ffi.function_add_enum_attribute_value(
        state.llvm_context$.ref(),
        llvm_function,
        llvm_index,
        "dereferenceable",
        UInt64(facts.dereferenceable_bytes)
    );
}

Void add_attributes(
    llvm_state.LowerState& state,
    ffi.Value value,
    backend_abi.FunctionAbi& function_abi,
    Bool is_function
) {
    Int llvm_index! = 1;
    if (function_abi.result.is_indirect()) {
        add_indirect_attribute(state, value, llvm_index, function_abi.result, is_function);
        llvm_index = llvm_index + 1;
    }
    Int param_index! = 0;
    while (param_index < function_abi.params.len()) {
        backend_abi.AbiArg param = function_abi.params.get(param_index);
        if (param.has_llvm_param()) {
            if (param.is_indirect()) {
                add_indirect_attribute(state, value, llvm_index, param, is_function);
            }
            llvm_index = llvm_index + 1;
        }
        param_index = param_index + 1;
    }
}

Void add_indirect_attribute(
    llvm_state.LowerState& state,
    ffi.Value value,
    Int llvm_index,
    backend_abi.AbiArg arg,
    Bool is_function
) {
    ffi.Type pointee_type = llvm_type.lower_type(state, arg.type_id);
    if (!ffi.type_valid(pointee_type)) {
        return;
    }
    UInt8[]& name = indirect_attribute_name(arg);
    if (is_function) {
        ffi.function_add_type_attribute(state.llvm_context$.ref(), value, llvm_index, name, pointee_type);
        return;
    }
    ffi.call_add_type_attribute(state.llvm_context$.ref(), value, llvm_index, name, pointee_type);
}

@life()
UInt8[]& indirect_attribute_name(backend_abi.AbiArg arg) {
    if (arg.indirect_kind == .sret) {
        return "sret";
    }
    return "byval";
}
