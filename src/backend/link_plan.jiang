// Linker 输入计划。
//
// 这里不执行链接，也不调用 shell/process。它只把已经规划好的 object artifact
// 转换成 linker 后续需要消费的输入列表。真正执行链接需要独立的 process/linker
// driver 能力，不能下沉到 pipeline。

import object_plan = "../artifact/object_plan.jiang";
import list = "../support/list.jiang";

public enum LinkInputKind {
    object_file,
    static_library,
    dynamic_library,
}

public struct LinkInput: Movable {
    public LinkInputKind kind;
    public UInt8[] path;

    public init(LinkInputKind kind, UInt8[] path) {
        self.kind = kind;
        self.path = path;
    }
}

public struct LinkPlan: Movable {
    public list.ArrayList<LinkInput> inputs;

    public init() {
        self.inputs = list.ArrayList<LinkInput>();
    }

    public Int len() {
        return self.inputs.len();
    }

    @life(self > return)
    public LinkInput& input_at(Int index) {
        return self.inputs.ref_at(index);
    }

    public () add_object(UInt8[] path) {
        self.inputs.add(LinkInput(.object_file, path));
    }
}

public LinkPlan link_plan_from_object_plan(object_plan.ObjectReusePlan& objects) {
    LinkPlan! plan = LinkPlan();
    Int! index = 0;
    while (index < objects.len()) {
        object_plan.ObjectPlanEntry& entry = objects.entry_at(index);
        if (entry.kind != .unsupported) {
            plan.add_object(objects.path_at(entry.path_index));
        }
        index = index + 1;
    }
    return plan$.move();
}
