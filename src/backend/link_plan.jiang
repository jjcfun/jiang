// Linker 输入计划。
//
// 这里不执行链接，也不调用 shell/process，只记录 linker 后续消费的输入列表。
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import std;

public enum LinkInputKind {
    object_file,
    static_library,
    dynamic_library,
}

public enum LinkInputRole {
    user_object,
    startup_object,
    runtime_object,
    system_library,
}

public struct LinkInput: Movable {
    public LinkInputKind kind;
    public LinkInputRole role;
    public std.String path;

    public init(self, LinkInputKind kind, UInt8[]& path) {
        self.kind = kind;
        self.role = .user_object;
        self.path = std.String(path);
    }

    public init(self, LinkInputKind kind, LinkInputRole role, UInt8[]& path) {
        self.kind = kind;
        self.role = role;
        self.path = std.String(path);
    }
}

public struct LinkPlan: Movable {
    public list.ArrayList<LinkInput> inputs!;
    table.MultiTable<UInt64, Int> path_indexes!;

    public init(self) {
        self.inputs = list.ArrayList<LinkInput>();
        self.path_indexes = table.MultiTable<UInt64, Int>();
    }

    public Int len(self) {
        return self.inputs.len();
    }
    public LinkInput& input_at(self, Int index) {
        return self.inputs.ref_at(index);
    }

    public Void add_object(Self&! self, UInt8[]& path) {
        self.add_user_object(path);
    }

    public Void add_user_object(Self&! self, UInt8[]& path) {
        self.add_unique_object(.user_object, path);
    }

    public Void add_startup_object(Self&! self, UInt8[]& path) {
        self.add_unique_object(.startup_object, path);
    }

    public Void add_runtime_object(Self&! self, UInt8[]& path) {
        self.add_unique_object(.runtime_object, path);
    }

    Void add_unique_object(Self&! self, LinkInputRole role, UInt8[]& path) {
        UInt64 path_hash = hash.hash_bytes(path);
        table.MultiTableCursor cursor! = self.path_indexes.first(path_hash);
        while (cursor.valid()) {
            LinkInput& input = self.inputs.ref_at(self.path_indexes.get(cursor));
            if (input.kind == .object_file && string.equal(input.path.bytes(), path)) {
                return;
            }
            cursor = self.path_indexes.next(cursor);
        }
        Int index = self.inputs.len();
        self.inputs.add(LinkInput(.object_file, role, path));
        self.path_indexes.add(path_hash, index);
    }
}
