// Linker 输入计划。
//
// 这里不执行链接，也不调用 shell/process。它只把已经规划好的 object artifact
// 转换成 linker 后续需要消费的输入列表。真正执行链接需要独立的 process/linker
// driver 能力，不能下沉到 pipeline。

import object_plan = "../artifact/object_plan.jiang";
import object_closure = "../artifact/object_closure.jiang";
import object_index = "../artifact/object_index.jiang";
import source_artifact = "../artifact/source.jiang";
import list = "../support/list.jiang";
import std;

public enum LinkInputKind {
    object_file,
    static_library,
    dynamic_library,
}

public enum LinkInputRole {
    user_object,
    startup_object,
    runtime_object,
    system_library,
}

public struct LinkInput: Movable {
    public LinkInputKind kind;
    public LinkInputRole role;
    public std.String path;

    public init(self, LinkInputKind kind, UInt8[]& path) {
        self.kind = kind;
        self.role = .user_object;
        self.path = std.String(path);
    }

    public init(self, LinkInputKind kind, LinkInputRole role, UInt8[]& path) {
        self.kind = kind;
        self.role = role;
        self.path = std.String(path);
    }
}

public struct LinkPlan: Movable {
    public list.ArrayList<LinkInput> inputs;

    public init(self) {
        self.inputs = list.ArrayList<LinkInput>();
    }

    public Int len(self) {
        return self.inputs.len();
    }
    public LinkInput& input_at(self, Int index) {
        return self.inputs.ref_at(index);
    }

    public () add_object(self, UInt8[]& path) {
        self.add_user_object(path);
    }

    public () add_user_object(self, UInt8[]& path) {
        self.add_unique_object(.user_object, path);
    }

    public () add_startup_object(self, UInt8[]& path) {
        self.add_unique_object(.startup_object, path);
    }

    public () add_runtime_object(self, UInt8[]& path) {
        self.add_unique_object(.runtime_object, path);
    }

    () add_unique_object(self, LinkInputRole role, UInt8[]& path) {
        Int index! = 0;
        while (index < self.inputs.len()) {
            LinkInput& input = self.inputs.ref_at(index);
            if (input.kind == .object_file && std.path.equal(input.path.bytes(), path)) {
                return;
            }
            index = index + 1;
        }
        self.inputs.add(LinkInput(.object_file, role, path));
    }

    public Bool add_interface_objects(
        self,
        UInt8[]& cache_root,
        source_artifact.ModuleInterface& module_interface,
        object_index.ObjectIndexContext context,
        object_plan.ObjectReusePlan& current_objects
    ) {
        if (!module_interface.object_closure_validated_for_codegen) {
            return true;
        }
        if (!object_closure.validate(cache_root, module_interface, context)) {
            return false;
        }
        Int index! = 0;
        while (index < module_interface.object_units.len()) {
            source_artifact.InterfaceObjectUnit unit = module_interface.object_units.get(index);
            if (current_objects.owns_definition(unit.definition_key)) {
                index = index + 1;
                continue;
            }
            guard object_closure.validated_unit(cache_root, unit, context) is .some(validated) else {
                return false;
            }
            self.add_user_object(validated.path.bytes());
            index = index + 1;
        }
        return true;
    }
}

public LinkPlan link_plan_from_object_plan(object_plan.ObjectReusePlan& objects) {
    LinkPlan plan! = LinkPlan();
    Int index! = 0;
    while (index < objects.len()) {
        object_plan.ObjectPlanEntry& entry = objects.entry_at(index);
        if (entry.kind != .unsupported) {
            std.String path = objects.path_at(entry.path_index);
            plan.add_object(path.bytes());
        }
        index = index + 1;
    }
    return plan;
}
