// backend 的 whole-package object 输出。
//
// release 始终使用该路径。debug 的 source/monomorph 增量 object 由独立的
// work-product 路径负责；这里保持用户可见 `--emit-obj` 的单文件契约。

import context = "../context.jiang";
import artifact_path = "../artifact/path.jiang";
import codegen = "./codegen.jiang";
import driver_options = "../driver/options.jiang";
import jil = "../jil.jiang";
import std;

public UInt8[]^ temporary_whole_package_object_path(
    UInt8[]& artifact_cache_dir,
    driver_options.CompileMode mode
) {
    UInt8[]^ object_dir = artifact_path.object_dir(artifact_cache_dir);
    UInt8[]& file_name! = "whole-debug.o";
    if (mode == .release) {
        file_name = "whole-release.o";
    }
    UInt8[]^ final_path = std.path.join(object_dir[..], file_name).into_slice();
    return artifact_path.temporary_artifact_path(final_path[..], ".object.tmp.");
}

public codegen.BackendResult emit_whole_package_object(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    return codegen.emit_object(
        ctx,
        lowered,
        output_path,
        mode,
        link_libc,
        target_triple
    );
}

public codegen.BackendResult emit_object(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    return codegen.emit_object(
        ctx,
        lowered,
        output_path,
        mode,
        link_libc,
        target_triple
    );
}
