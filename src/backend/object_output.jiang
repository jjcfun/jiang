// backend object 输出和 object artifact 复用。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import object_artifact = "../artifact/object.jiang";
import object_hash = "../artifact/object_hash.jiang";
import object_index = "../artifact/object_index.jiang";
import object_key = "../artifact/object_key.jiang";
import object_plan = "../artifact/object_plan.jiang";
import artifact_path = "../artifact/path.jiang";
import codegen = "./codegen.jiang";
import codegen_unit = "./codegen_unit.jiang";
import driver_options = "../driver/options.jiang";
import jil = "../jil.jiang";
import qkey = "../incremental/key.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import std;

public struct PreparedLinkObjects: Movable {
    public Bool ok;
    public object_plan.ObjectReusePlan plan;

    public init(self, Bool ok, object_plan.ObjectReusePlan plan) {
        self.ok = ok;
        self.plan = plan;
    }
}

// release 产物需要让 LLVM 同时看到整个 package；这个临时 object 不进入
// 细粒度 debug cache，链接完成后由调用方删除。
public UInt8[]^ temporary_whole_package_object_path(
    UInt8[]& artifact_cache_dir,
    driver_options.CompileMode mode
) {
    UInt8[]^ object_dir = artifact_path.object_dir(artifact_cache_dir);
    UInt8[]& file_name! = "whole-debug.o";
    if (mode == .release) {
        file_name = "whole-release.o";
    }
    UInt8[]^ final_path = std.path.join(object_dir[..], file_name).into_slice();
    return object_index.temporary_object_path(final_path[..]);
}

public codegen.BackendResult emit_whole_package_object(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    return codegen.emit_object(
        ctx,
        lowered,
        output_path,
        mode,
        link_libc,
        target_triple
    );
}

public PreparedLinkObjects prepare_link_objects(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& artifact_cache_dir,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx, lowered);
    std.String toolchain_version = codegen.llvm_version_text();
    object_plan.ObjectReusePlan plan = object_plan.build_object_reuse_plan(
        ctx,
        lowered,
        units$.ref(),
        artifact_cache_dir,
        target_cache_key,
        compiler_build,
        compiler_version,
        toolchain_version.bytes(),
        mode
    );
    record_object_plan_stats(ctx, plan$.ref());
    if (plan.summary().unsupported > 0) {
        diagnostic_helper.add_package_error(
            ctx,
            "codegen unit has no stable object identity",
            "object_unit_identity_missing"
        );
        return PreparedLinkObjects(false, plan$.move());
    }
    Bool ok = emit_plan_cache_objects(
        ctx,
        lowered,
        units$.ref(),
        plan$.ref(),
        mode,
        link_libc,
        target_triple
    );
    if (ok) {
        record_plan_closure(ctx, plan$.ref());
    }
    return PreparedLinkObjects(ok, plan$.move());
}

// 生成单个 object 输出。能复用单个 cache object 时直接复制；多 codegen unit
// 当前仍回退为整包 object 输出，避免输出路径语义不清。
public codegen.BackendResult emit_object_with_cache(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    driver_options.CompileMode mode,
    Bool link_libc
) {
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx, lowered);
    std.String toolchain_version = codegen.llvm_version_text();
    object_plan.ObjectReusePlan plan = object_plan.build_object_reuse_plan(
        ctx,
        lowered,
        units$.ref(),
        artifact_cache_dir,
        target_cache_key,
        compiler_build,
        compiler_version,
        toolchain_version.bytes(),
        mode
    );
    record_object_plan_stats(ctx, plan$.ref());
    if (plan.len() == 1) {
        return emit_single_object_unit_with_cache(
            ctx,
            lowered,
            units$.ref(),
            plan$.ref(),
            plan.entry_at(0),
            output_path,
            mode,
            link_libc,
            llvm_triple
        );
    }
    if (!emit_plan_cache_objects(ctx, lowered, units$.ref(), plan$.ref(), mode, link_libc, llvm_triple)) {
        return codegen.BackendResult(false);
    }
    record_plan_closure(ctx, plan$.ref());
    return emit_package_object_from_plan(
        ctx,
        lowered,
        plan$.ref(),
        output_path,
        mode,
        link_libc,
        llvm_triple
    );
}

() record_plan_closure(context.CompilerContext& ctx, object_plan.ObjectReusePlan& plan) {
    object_plan.record_package_closure(ctx, plan);
}

codegen.BackendResult emit_package_object_from_plan(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    object_plan.ObjectReusePlan& plan,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    guard plan.closure_fingerprint() is .some(closure_key) else {
        return codegen.emit_object(ctx, lowered, output_path, mode, link_libc, target_triple);
    }
    UInt8[]^ relative = artifact_path.package_object_relative_path(closure_key);
    UInt8[]^ cache_path = artifact_path.package_object_path(plan.cache_root.bytes(), closure_key);
    UInt8[]& final_path = final_object_path(output_path, cache_path[..]);
    if (package_object_is_valid(plan, closure_key, relative[..])) {
        return codegen.BackendResult(copy_cached_object(ctx, cache_path[..], final_path));
    }
    UInt8[]^ temporary = object_index.temporary_object_path(cache_path[..]);
    codegen.BackendResult emitted = codegen.emit_object(
        ctx,
        lowered,
        temporary[..],
        mode,
        link_libc,
        target_triple
    );
    if (emitted.has_errors()) {
        return emitted;
    }
    if (!publish_package_object(plan, closure_key, relative[..], temporary[..], cache_path[..])) {
        diagnostic_helper.add_package_error(ctx, "failed to publish package object", "package_object_publish_failed");
        return codegen.BackendResult(false);
    }
    return codegen.BackendResult(copy_cached_object(ctx, cache_path[..], final_path));
}

Bool package_object_is_valid(
    object_plan.ObjectReusePlan& plan,
    qkey.Fingerprint128 closure_key,
    UInt8[]& expected_relative
) {
    guard object_index.load(
        plan.cache_root.bytes(),
        .package_object,
        closure_key
    ) is .some(record) else {
        return false;
    }
    if (!object_index.record_matches(
        record$.ref(),
        .package_object,
        closure_key,
        plan.index_context
    )) {
        return false;
    }
    if (record.dependency_fingerprint != closure_key) {
        return false;
    }
    if (!string.equal(record.relative_object_path.bytes(), expected_relative)) {
        return false;
    }
    guard object_index.object_path(plan.cache_root.bytes(), record$.ref()) is .some(path) else {
        return false;
    }
    guard object_hash.hash_file(path.bytes()) is .some(actual_hash) else { return false; }
    return actual_hash == record.object_hash;
}

Bool publish_package_object(
    object_plan.ObjectReusePlan& plan,
    qkey.Fingerprint128 closure_key,
    UInt8[]& relative,
    UInt8[]& temporary,
    UInt8[]& final_path
) {
    if (!system_fs.atomic_replace(temporary, final_path)) {
        system_fs.remove_file(temporary);
        return false;
    }
    guard object_hash.hash_file(final_path) is .some(hash) else { return false; }
    object_index.ObjectIndexRecord record = object_index.ObjectIndexRecord(
        .package_object,
        closure_key,
        plan.index_context,
        closure_key,
        hash,
        relative
    );
    return object_index.publish(plan.cache_root.bytes(), record$.ref());
}

// 将 object reuse plan 的命中情况记录到 store，供 smoke 和后续增量诊断使用。
() record_object_plan_stats(context.CompilerContext& ctx, object_plan.ObjectReusePlan& plan) {
    Int index! = 0;
    while (index < plan.len()) {
        object_plan.ObjectPlanEntry& entry = plan.entry_at(index);
        if (entry.kind == .unsupported) {
            ctx.store.object_artifacts.record_unsupported_unit();
        } else if (entry.kind == .source_object) {
            ctx.store.object_artifacts.record_source_lookup(entry.lookup_status);
        } else {
            ctx.store.object_artifacts.record_monomorph_lookup(entry.lookup_status);
        }
        if (entry.can_reuse()) {
            ctx.store.object_artifacts.record_reused_unit();
        }
        index = index + 1;
    }
}

// 按 object plan 补齐所有缺失 cache object。命中的 entry 不触发 backend。
Bool emit_plan_cache_objects(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!plan_requires_emission(plan)) { return true; }
    codegen.PreparedStore prepared! = codegen.prepare_store(ctx, lowered, mode);
    if (!prepared.ok) { return false; }
    Int index! = 0;
    while (index < plan.len()) {
        if (!emit_plan_cache_object(
            ctx,
            lowered,
            units,
            plan,
            plan.entry_at(index),
            prepared$.ref(),
            mode,
            link_libc,
            target_triple
        )) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool plan_requires_emission(object_plan.ObjectReusePlan& plan) {
    Int index! = 0;
    while (index < plan.len()) {
        object_plan.ObjectPlanEntry& entry = plan.entry_at(index);
        if (entry.kind != .unsupported && !entry.can_reuse()) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// 为一个 codegen unit 生成 cache object，并在成功后登记实际文件 hash。
Bool emit_plan_cache_object(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    codegen.PreparedStore& prepared,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (entry.kind == .unsupported || entry.can_reuse()) {
        return true;
    }
    std.String cache_path = plan.path_at(entry.path_index);
    UInt8[]^ temporary_path = object_index.temporary_object_path(cache_path.bytes());
    codegen.BackendResult emitted = codegen.emit_object_for_prepared_unit(
        ctx,
        lowered,
        units.unit_at(entry.unit_index),
        prepared,
        temporary_path[..],
        mode,
        link_libc,
        target_triple
    );
    if (emitted.has_errors()) {
        return false;
    }
    return publish_emitted_object(ctx, plan, entry, temporary_path[..], cache_path.bytes());
}

// 单 codegen unit 的 object 输出路径可以直接使用 cache artifact。这个路径同时覆盖
// `--emit-obj` 未指定 `-o` 时的默认输出行为。
codegen.BackendResult emit_single_object_unit_with_cache(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (entry.kind == .unsupported) {
        return codegen.emit_object(ctx, lowered, output_path, mode, link_libc, target_triple);
    }

    std.String cache_path = plan.path_at(entry.path_index);
    UInt8[]& final_path = final_object_path(output_path, cache_path.bytes());
    if (entry.can_reuse()) {
        return codegen.BackendResult(copy_cached_object(ctx, cache_path.bytes(), final_path));
    }

    codegen.PreparedStore prepared! = codegen.prepare_store(ctx, lowered, mode);
    if (!prepared.ok) {
        return codegen.BackendResult(false);
    }
    if (!emit_plan_cache_object(
        ctx,
        lowered,
        units,
        plan,
        entry,
        prepared$.ref(),
        mode,
        link_libc,
        target_triple
    )) {
        return codegen.BackendResult(false);
    }
    return codegen.BackendResult(copy_cached_object(ctx, cache_path.bytes(), final_path));
}

// 没有显式 output path 时，cache path 就是最终 object path。
@life(return: output_path & cache_path)
UInt8[]& final_object_path(UInt8[]& output_path, UInt8[]& cache_path) {
    if (output_path.length == 0) {
        return cache_path;
    }
    return output_path;
}

// 将 cache object 复制到用户指定输出路径。源和目标相同时直接视为成功。
Bool copy_cached_object(context.CompilerContext& ctx, UInt8[]& cache_path, UInt8[]& output_path) {
    if (string.equal(cache_path, output_path)) {
        return true;
    }
    if (system_fs.copy_file(cache_path, output_path)) {
        return true;
    }
    diagnostic_helper.add_package_error(ctx, "failed to copy cached object file", "cached_object_copy_failed");
    return false;
}

// 记录刚生成的 object artifact。source object 和 monomorph object 使用不同 key，
// 但都只保存文件 hash 和路径，不保存 backend 内存对象。
Bool publish_emitted_object(
    context.CompilerContext& ctx,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    UInt8[]& temporary_path,
    UInt8[]& final_path
) {
    guard object_hash.hash_file(temporary_path) is .some(_) else {
        system_fs.remove_file(temporary_path);
        diagnostic_helper.add_package_error(ctx, "failed to hash emitted object", "object_cache_hash_failed");
        return false;
    }
    if (!system_fs.atomic_replace(temporary_path, final_path)) {
        system_fs.remove_file(temporary_path);
        diagnostic_helper.add_package_error(ctx, "failed to publish emitted object", "object_cache_publish_failed");
        return false;
    }
    guard object_hash.hash_file(final_path) is .some(emitted_hash) else {
        diagnostic_helper.add_package_error(ctx, "failed to verify published object", "object_cache_verify_failed");
        return false;
    }
    if (!record_emitted_object(ctx, plan, entry, emitted_hash, final_path)) {
        diagnostic_helper.add_package_error(ctx, "failed to publish object index", "object_index_publish_failed");
        return false;
    }
    ctx.store.object_artifacts.record_emitted_unit();
    return true;
}

Bool record_emitted_object(
    context.CompilerContext& ctx,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    qkey.Fingerprint128 emitted_hash,
    UInt8[]& final_path
) {
    if (entry.kind == .source_object && entry.source_key_index >= 0) {
        object_artifact.SourceObjectKey key = plan.source_key_at(entry.source_key_index);
        UInt8[]^ relative = artifact_path.source_object_relative_path(key);
        object_index.ObjectIndexRecord record = object_index.source_record(
            key,
            plan.index_context,
            emitted_hash,
            relative[..]
        );
        if (!object_index.publish(plan.cache_root.bytes(), record$.ref())) {
            return false;
        }
        ctx.store.object_artifacts.store_source_object(
            key,
            object_artifact.ObjectArtifactRecord(.source_object, emitted_hash, final_path)
        );
        return true;
    }
    if (entry.kind == .monomorph_object && entry.monomorph_key_index >= 0) {
        object_key.StableInstanceKey& key = plan.monomorph_key_at(entry.monomorph_key_index);
        UInt8[]^ relative = artifact_path.monomorph_object_relative_path(key);
        object_index.ObjectIndexRecord record = object_index.monomorph_record(
            key,
            plan.index_context,
            emitted_hash,
            relative[..]
        );
        if (!object_index.publish(plan.cache_root.bytes(), record$.ref())) {
            return false;
        }
        ctx.store.object_artifacts.store_monomorph_object(
            key,
            object_artifact.ObjectArtifactRecord(.monomorph_object, emitted_hash, final_path)
        );
        return true;
    }
    return false;
}
