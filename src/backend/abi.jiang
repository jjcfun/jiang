// C ABI classifier。
//
// backend 后续只消费这里产出的 ABI plan。这里不生成 LLVM instruction，也不决定
// backend symbol；只把 semantic TypeId 按目标 layout 分类成 direct/indirect/none。

import context = "../context.jiang";
import layout_compute = "../layout/compute.jiang";
import layout = "../layout/layout.jiang";
import mir = "../mir/mir.jiang";
import qid = "../store/id.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";

public enum AbiPassingKind {
    none,
    direct,
    indirect,
}

public enum AbiIndirectKind {
    none,
    byval,
    sret,
}

public struct AbiArg {
    public qid.TypeId type_id;
    public AbiPassingKind kind;
    public AbiIndirectKind indirect_kind;

    public init(self, qid.TypeId type_id, AbiPassingKind kind, AbiIndirectKind indirect_kind) {
        self.type_id = type_id;
        self.kind = kind;
        self.indirect_kind = indirect_kind;
    }

    public Bool has_llvm_param(self) {
        return self.kind == .direct || self.kind == .indirect;
    }

    public Bool is_indirect(self) {
        return self.kind == .indirect;
    }
}

public struct FunctionAbi: Movable {
    public AbiArg result;
    public list.ArrayList<AbiArg> params;

    public init(self, AbiArg result) {
        self.result = result;
        self.params = list.ArrayList<AbiArg>();
    }

    public () add_param(self, AbiArg param) {
        self.params.add(param);
    }

    public Int llvm_param_count(self) {
        Int! count = 0;
        if (self.result.is_indirect()) {
            count = count + 1;
        }
        Int! index = 0;
        while (index < self.params.len()) {
            if (self.params.get(index).has_llvm_param()) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }
}

public FunctionAbi classify_mir_body(context.CompilerContext& ctx, mir.MirBody& body) {
    qid.TypeId result_type = body.locals[body.return_local.to_index()].type_id;
    FunctionAbi! result = FunctionAbi(classify_result(ctx, result_type));
    Int! index = 0;
    while (index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[index];
        if (local.kind == .param) {
            result.add_param(classify_param(ctx, local.type_id));
        }
        index = index + 1;
    }
    return result$.move();
}

public FunctionAbi classify_function_type(context.CompilerContext& ctx, qid.TypeId function_type_id) {
    types.TypeInfo info = ctx.store.types.get(function_type_id);
    guard info.data is .function_type(function_info) else {
        FunctionAbi! invalid = FunctionAbi(AbiArg(ctx.store.types.invalid_type(), .none, .none));
        return invalid$.move();
    }
    FunctionAbi! result = FunctionAbi(classify_result(ctx, function_info.result));
    Int! index = 0;
    while (index < function_info.params.length) {
        result.add_param(classify_param(ctx, function_info.params[index]));
        index = index + 1;
    }
    return result$.move();
}

public AbiArg classify_result(context.CompilerContext& ctx, qid.TypeId type_id) {
    if (!type_has_abi_value(ctx, type_id)) {
        return AbiArg(type_id, .none, .none);
    }
    if (type_passes_indirect(ctx, type_id)) {
        return AbiArg(type_id, .indirect, .sret);
    }
    return AbiArg(type_id, .direct, .none);
}

public AbiArg classify_param(context.CompilerContext& ctx, qid.TypeId type_id) {
    if (!type_has_abi_value(ctx, type_id)) {
        return AbiArg(type_id, .none, .none);
    }
    if (type_passes_indirect(ctx, type_id)) {
        return AbiArg(type_id, .indirect, .byval);
    }
    return AbiArg(type_id, .direct, .none);
}

public Bool type_has_abi_value(context.CompilerContext& ctx, qid.TypeId type_id) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .invalid) { return false; }
    if (info.data is .unit) { return false; }
    if (info.data is .never) { return false; }
    if (info.data is .handle_type(_)) { return true; }
    if (info.data is .function_type(function_type)) {
        return function_type.kind == .raw || type_layout_has_abi_value(ctx, type_id);
    }
    return type_layout_has_abi_value(ctx, type_id);
}

Bool type_layout_has_abi_value(context.CompilerContext& ctx, qid.TypeId type_id) {
    layout.TypeLayout type_layout = layout_for_type(ctx, type_id);
    return type_layout.kind != .invalid && type_layout.kind != .zero_sized;
}

public Bool type_passes_indirect(context.CompilerContext& ctx, qid.TypeId type_id) {
    layout.TypeLayout type_layout = layout_for_type(ctx, type_id);
    if (type_layout.kind != .aggregate) {
        return false;
    }
    return type_layout.size > direct_aggregate_size_limit(ctx);
}

public Int direct_aggregate_size_limit(context.CompilerContext& ctx) {
    return ctx.store.layouts.target.pointer_size * 2;
}

layout.TypeLayout layout_for_type(context.CompilerContext& ctx, qid.TypeId type_id) {
    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx, type_id);
    return ctx.store.layouts.layout(layout_id);
}
