// Codegen facade。
//
// 这里只封装 JIL 到 LLVM backend 的生成入口。package 输出、artifact cache
// 和链接由 output 阶段负责。

import context = "../context.jiang";
import database = "../db.jiang";
import diagnostic = "../diagnostic.jiang";
import jil = "../jil.jiang";
import layout = "../layout.jiang";
import qid = "../id.jiang";
import sema_drop = "../sema/drop.jiang";
import types = "../sema/type.jiang";
import attributes = "../jil/analysis/attributes.jiang";
import codegen_unit = "./codegen_unit.jiang";
import driver_options = "../driver/options.jiang";
import llvm_backend = "./llvm.jiang";
import symbol = "./symbol.jiang";
import type_requirements = "../jil/type_requirements.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import string = "../support/string.jiang";
import system_memory = "../system/memory.jiang";
import std;

public alias ObjectUnit = llvm_backend.ObjectUnit;

public struct BackendResult: Copyable {
    public Bool ok;

    public init(self, Bool ok) {
        self.ok = ok;
    }

    public Bool has_errors(self) {
        return !self.ok;
    }
}

public struct PreparedStore: Movable {
    public Bool ok;
    public attributes.Mode attribute_mode;
    public list.ArrayList<jil.FunctionId> shared_runtime_functions;

    public init(
        self,
        Bool ok,
        attributes.Mode attribute_mode,
        list.ArrayList<jil.FunctionId> shared_runtime_functions
    ) {
        self.ok = ok;
        self.attribute_mode = attribute_mode;
        self.shared_runtime_functions = shared_runtime_functions;
    }
}

public PreparedStore prepare_store(
    context.CompilerContext&! ctx,
    jil.Store& store,
    driver_options.CompileMode mode
) {
    prepare_codegen_symbols(ctx);
    list.ArrayList<qid.TypeId> required_types! = type_requirements.collect(ctx.store$.ref(), store);
    prepare_codegen_types(ctx, required_types$.mut_ref());
    llvm_backend.initialize_supported_targets();
    if (!validate_store_symbols(ctx, store)) {
        return PreparedStore(
            false,
            .conservative,
            list.ArrayList<jil.FunctionId>()
        );
    }
    list.ArrayList<jil.FunctionId> runtime_functions =
        collect_shared_runtime_functions(ctx, store);
    if (mode == .debug) {
        return PreparedStore(true, .conservative, runtime_functions);
    }
    return PreparedStore(true, .flow, runtime_functions);
}

Void prepare_codegen_types(
    context.CompilerContext&! ctx,
    list.ArrayList<qid.TypeId>& required_types
) {
    sema_drop.DropQuery drop_query = sema_drop.DropQuery(ctx.store$.ref());
    map.WyHashMap<qid.TypeId, Bool> seen! = map.WyHashMap<qid.TypeId, Bool>();
    list.ArrayList<qid.TypeId> pending! = list.ArrayList<qid.TypeId>(required_types.len());
    Int index! = 0;
    while (index < required_types.len()) {
        type_requirements.append_type_closure(
            ctx.store$.ref(), required_types.get(index), seen$.mut_ref(), pending$.mut_ref()
        );
        index = index + 1;
    }
    index = 0;
    while (index < pending.len()) {
        qid.TypeId type_id = pending.get(index);
        index = index + 1;
        append_reachable_vtable_types(ctx, type_id, seen$.mut_ref(), pending$.mut_ref());
        if (!drop_query.type_has_concrete_layout(type_id)) { continue; }
        database.drop_category_of_type(
            ctx.query$.mut_ref(), ctx.store$.ref(), type_id
        );
        layout.LayoutId layout_id =
            database.layout_of_type(ctx.query$.mut_ref(), ctx.store$.ref(), type_id);
        layout.TypeLayout type_layout = database.type_layout(ctx.query$.ref(), layout_id);
        Int field_index! = 0;
        while (field_index < type_layout.fields.length) {
            type_requirements.append_type_closure(
                ctx.store$.ref(),
                type_layout.fields[field_index].field_type,
                seen$.mut_ref(),
                pending$.mut_ref()
            );
            field_index = field_index + 1;
        }
    }
}

list.ArrayList<jil.FunctionId> collect_shared_runtime_functions(
    context.CompilerContext& ctx,
    jil.Store& store
) {
    list.ArrayList<jil.FunctionId> result! = list.ArrayList<jil.FunctionId>();
    Int index! = 0;
    while (index < store.program.functions.len()) {
        jil.Function& function = store.program.functions.ref_at(index);
        index = index + 1;
        std.String name = symbol.function_symbol_name(ctx, store, function);
        if (text_starts_with(name.bytes(), "__jiang_runtime_")) {
            result.add(function.id);
        }
    }
    return result;
}

Bool text_starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (text.length < prefix.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Void prepare_codegen_symbols(context.CompilerContext&! ctx) {
    system_memory.Allocator libc = system_memory.allocator(true);
    system_memory.Allocator runtime = system_memory.allocator(false);
    ctx.store.symbols.intern(libc.alloc_symbol);
    ctx.store.symbols.intern(libc.free_symbol);
    ctx.store.symbols.intern(runtime.alloc_symbol);
    ctx.store.symbols.intern(runtime.free_symbol);
}

Void append_reachable_vtable_types(
    context.CompilerContext&! ctx,
    qid.TypeId type_id,
    map.WyHashMap<qid.TypeId, Bool>&! seen,
    list.ArrayList<qid.TypeId>&! pending
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    guard info.data is .trait_companion(companion) else { return; }
    if (companion.kind != .vtable) { return; }
    database.prepare_trait_vtable_field_types(
        ctx.query$.mut_ref(), ctx.store$.ref(), type_id
    );
    Int slot! = 0;
    while (database.trait_vtable_field_type(
        ctx.query$.ref(), companion.trait_def, slot
    ) is .some(field_type)) {
        type_requirements.append_type_closure(
            ctx.store$.ref(), field_type, seen, pending
        );
        slot = slot + 1;
    }
}

@region(a)
public struct BackendTextResult: Copyable {
    public Bool ok;
    @life(a)
    public UInt8[]& text;

    public init(self, Bool ok, UInt8[]& text) {
        self.ok = ok;
        self.text = text;
    }
}

public BackendResult emit(context.CompilerContext&! ctx, jil.Store& store) {
    prepare_codegen_symbols(ctx);
    list.ArrayList<qid.TypeId> required_types! = type_requirements.collect(ctx.store$.ref(), store);
    prepare_codegen_types(ctx, required_types$.mut_ref());
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit(ctx, store));
}

public BackendResult emit_object(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple,
    Bool position_independent
) {
    prepare_codegen_symbols(ctx);
    list.ArrayList<qid.TypeId> required_types! = type_requirements.collect(ctx.store$.ref(), store);
    prepare_codegen_types(ctx, required_types$.mut_ref());
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendResult(false);
    }
    Bool emitted = llvm_backend.emit_object(
        ctx,
        store,
        output_path,
        driver_options.backend_codegen_opt_level(mode),
        driver_options.backend_pass_pipeline(mode),
        link_libc,
        target_triple,
        position_independent
    );
    if (!emitted && ctx.store.diagnostics.error_count == 0) {
        add_backend_error(ctx, "LLVM object emission failed", "llvm_object_emit_failed");
    }
    return BackendResult(emitted);
}

public BackendResult emit_object_for_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    PreparedStore prepared! = prepare_store(ctx, store, mode);
    return emit_object_for_prepared_unit(
        ctx,
        store,
        unit,
        prepared$.ref(),
        output_path,
        mode,
        link_libc,
        target_triple
    );
}

public BackendResult emit_object_for_prepared_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    PreparedStore& prepared,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!prepared.ok) { return BackendResult(false); }
    Bool emitted = llvm_backend.emit_object_for_unit(
        ctx,
        store,
        unit,
        prepared.attribute_mode,
        prepared.shared_runtime_functions$.ref(),
        output_path,
        driver_options.backend_codegen_opt_level(mode),
        driver_options.backend_pass_pipeline(mode),
        link_libc,
        target_triple
    );
    if (!emitted && ctx.store.diagnostics.error_count == 0) {
        add_backend_error(ctx, "LLVM object unit emission failed", "llvm_object_unit_emit_failed");
    }
    return BackendResult(emitted);
}

public ObjectUnit^? prepare_object_for_prepared_unit(
    context.CompilerContext&! ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    PreparedStore& prepared,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!prepared.ok) { return null; }
    return llvm_backend.prepare_object_for_unit(
        ctx,
        store,
        unit,
        prepared.attribute_mode,
        prepared.shared_runtime_functions$.ref(),
        output_path,
        driver_options.backend_codegen_opt_level(mode),
        driver_options.backend_pass_pipeline(mode),
        link_libc,
        target_triple
    );
}

public BackendResult emit_llvm_ir(
    context.CompilerContext&! ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    prepare_codegen_symbols(ctx);
    list.ArrayList<qid.TypeId> required_types! = type_requirements.collect(ctx.store$.ref(), store);
    prepare_codegen_types(ctx, required_types$.mut_ref());
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit_llvm_ir(ctx, store, output_path, link_libc, target_triple));
}

@life()
public BackendTextResult emit_llvm_ir_text(
    context.CompilerContext&! ctx,
    jil.Store& store,
    Bool link_libc,
    UInt8[]& target_triple
) {
    prepare_codegen_symbols(ctx);
    list.ArrayList<qid.TypeId> required_types! = type_requirements.collect(ctx.store$.ref(), store);
    prepare_codegen_types(ctx, required_types$.mut_ref());
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendTextResult(false, "");
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendTextResult(false, "");
    }
    guard llvm_backend.emit_llvm_ir_text(ctx, store, link_libc, target_triple) is .some(text) else {
        return BackendTextResult(false, "");
    }
    return BackendTextResult(true, text);
}

public std.String llvm_version_text() {
    return llvm_backend.llvm_version_text();
}

@life()
public UInt8[]& default_target_triple_text() {
    return llvm_backend.default_target_triple_text();
}

Bool validate_store_symbols(context.CompilerContext&! ctx, jil.Store& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return false;
    }
    if (symbol.validate_unique_function_symbol_names(ctx, store)) {
        return true;
    }
    std.String message = duplicate_symbol_name_message(ctx, store);
    add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
    return false;
}

std.String duplicate_symbol_key_message(context.CompilerContext& ctx, jil.Store& store) {
    map.WyHashMap<symbol.BackendSymbolKey, Int> seen! =
        map.WyHashMap<symbol.BackendSymbolKey, Int>();
    Int index! = 0;
    while (index < store.program.functions.len()) {
        jil.Function& function = store.program.functions.ref_at(index);
        symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function);
        if (seen.has(key)) {
            std.String name = symbol.function_symbol_name(ctx, store, function);
            std.StringBuilder builder! = std.StringBuilder();
            builder.append("duplicate backend function symbol key: ");
            builder.append_valid_utf8(name.bytes());
            builder.append(" ");
            qid.DefId provenance_def = jil.function_provenance_def(function.origin);
            builder.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(provenance_def).name.symbol));
            return builder.into_string();
        }
        seen.set(key, index);
        index = index + 1;
    }
    std.String message = "duplicate backend function symbol key";
    return message;
}

std.String duplicate_symbol_name_message(context.CompilerContext& ctx, jil.Store& store) {
    guard symbol.duplicate_function_symbol_name(ctx, store) is .some(name) else {
        std.String message = "duplicate backend function symbol name";
        return message;
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("duplicate backend function symbol name: ");
    builder.append_valid_utf8(name.bytes());
    return builder.into_string();
}

Void add_backend_error(context.CompilerContext&! ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
