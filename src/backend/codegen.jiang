// Codegen facade。
//
// 这里只封装 JIL 到 LLVM backend 的生成入口。package 输出、artifact cache
// 和链接由 output 阶段负责。

import context = "../context.jiang";
import diagnostic = "../diagnostic.jiang";
import jil = "../jil.jiang";
import layout_compute = "../layout/compute.jiang";
import qid = "../id.jiang";
import sema_drop = "../sema/drop.jiang";
import attributes = "../jil/analysis/attributes.jiang";
import codegen_unit = "./codegen_unit.jiang";
import driver_options = "../driver/options.jiang";
import llvm_backend = "./llvm.jiang";
import symbol = "./symbol.jiang";
import string = "../support/string.jiang";
import system_memory = "../system/memory.jiang";
import table = "../support/table.jiang";
import std;

public struct BackendResult: Copyable {
    public Bool ok;

    public init(self, Bool ok) {
        self.ok = ok;
    }

    public Bool has_errors(self) {
        return !self.ok;
    }
}

public struct PreparedStore: Movable {
    public Bool ok;
    public attributes.Store attributes;

    public init(self, Bool ok, attributes.Store attributes) {
        self.ok = ok;
        self.attributes = attributes;
    }
}

public PreparedStore prepare_store(
    context.CompilerContext& ctx,
    jil.Store& store,
    driver_options.CompileMode mode
) {
    prepare_codegen_symbols(ctx);
    prepare_codegen_vtable_types(ctx);
    llvm_backend.initialize_supported_targets();
    if (!validate_store_symbols(ctx, store)) {
        return PreparedStore(false, attributes.Store());
    }
    if (mode == .debug) {
        prepare_codegen_layouts(ctx);
        return PreparedStore(true, attributes.conservative(store));
    }
    attributes.Store facts = attributes.analyze(ctx, store);
    prepare_codegen_layouts(ctx);
    return PreparedStore(true, facts);
}

() prepare_codegen_symbols(context.CompilerContext& ctx) {
    system_memory.Allocator libc = system_memory.allocator(true);
    system_memory.Allocator runtime = system_memory.allocator(false);
    ctx.store.symbols.intern(libc.alloc_symbol);
    ctx.store.symbols.intern(libc.free_symbol);
    ctx.store.symbols.intern(runtime.alloc_symbol);
    ctx.store.symbols.intern(runtime.free_symbol);
}

() prepare_codegen_vtable_types(context.CompilerContext& ctx) {
    Int index! = 0;
    while (index < ctx.store.types.types.len()) {
        qid.TypeId type_id = qid.TypeId.from_index(index);
        index = index + 1;
        layout_compute.prepare_trait_vtable_field_types(ctx, type_id);
    }
}

() prepare_codegen_layouts(context.CompilerContext& ctx) {
    sema_drop.DropQuery query = sema_drop.DropQuery(ctx);
    Int index! = 0;
    while (index < ctx.store.types.types.len()) {
        qid.TypeId type_id = qid.TypeId.from_index(index);
        index = index + 1;
        if (!query.type_has_concrete_layout(type_id)) { continue; }
        prepare_codegen_layout(ctx, type_id);
    }
}

() prepare_codegen_layout(context.CompilerContext& ctx, qid.TypeId type_id) {
    if (ctx.store.layouts.layout_id_for_type(type_id) != null) { return; }
    layout_compute.layout_of_type(ctx, type_id);
}

@region(a)
public struct BackendTextResult: Copyable {
    public Bool ok;
    @life(a)
    public UInt8[]& text;

    public init(self, Bool ok, UInt8[]& text) {
        self.ok = ok;
        self.text = text;
    }
}

public BackendResult emit(context.CompilerContext& ctx, jil.Store& store) {
    prepare_codegen_symbols(ctx);
    prepare_codegen_vtable_types(ctx);
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit(ctx, store));
}

public BackendResult emit_object(
    context.CompilerContext& ctx,
    jil.Store& store,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    prepare_codegen_symbols(ctx);
    prepare_codegen_vtable_types(ctx);
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendResult(false);
    }
    Bool emitted = llvm_backend.emit_object(
        ctx,
        store,
        output_path,
        driver_options.backend_codegen_opt_level(mode),
        driver_options.backend_pass_pipeline(mode),
        link_libc,
        target_triple
    );
    if (!emitted && ctx.store.diagnostics.error_count == 0) {
        add_backend_error(ctx, "LLVM object emission failed", "llvm_object_emit_failed");
    }
    return BackendResult(emitted);
}

public BackendResult emit_object_for_unit(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    PreparedStore prepared! = prepare_store(ctx, store, mode);
    return emit_object_for_prepared_unit(
        ctx,
        store,
        unit,
        prepared$.ref(),
        output_path,
        mode,
        link_libc,
        target_triple
    );
}

public BackendResult emit_object_for_prepared_unit(
    context.CompilerContext& ctx,
    jil.Store& store,
    codegen_unit.CodegenUnit& unit,
    PreparedStore& prepared,
    UInt8[]& output_path,
    driver_options.CompileMode mode,
    Bool link_libc,
    UInt8[]& target_triple
) {
    if (!prepared.ok) { return BackendResult(false); }
    Bool emitted = llvm_backend.emit_object_for_unit(
        ctx,
        store,
        unit,
        prepared.attributes$.ref(),
        output_path,
        driver_options.backend_codegen_opt_level(mode),
        driver_options.backend_pass_pipeline(mode),
        link_libc,
        target_triple
    );
    if (!emitted && ctx.store.diagnostics.error_count == 0) {
        add_backend_error(ctx, "LLVM object unit emission failed", "llvm_object_unit_emit_failed");
    }
    return BackendResult(emitted);
}

public BackendResult emit_llvm_ir(
    context.CompilerContext& ctx,
    jil.Store& store,
    UInt8[]& output_path,
    Bool link_libc,
    UInt8[]& target_triple
) {
    prepare_codegen_symbols(ctx);
    prepare_codegen_vtable_types(ctx);
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendResult(false);
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendResult(false);
    }
    return BackendResult(llvm_backend.emit_llvm_ir(ctx, store, output_path, link_libc, target_triple));
}

@life()
public BackendTextResult emit_llvm_ir_text(
    context.CompilerContext& ctx,
    jil.Store& store,
    Bool link_libc,
    UInt8[]& target_triple
) {
    prepare_codegen_symbols(ctx);
    prepare_codegen_vtable_types(ctx);
    llvm_backend.initialize_supported_targets();
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return BackendTextResult(false, "");
    }
    if (!symbol.validate_unique_function_symbol_names(ctx, store)) {
        std.String message = duplicate_symbol_name_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
        return BackendTextResult(false, "");
    }
    guard llvm_backend.emit_llvm_ir_text(ctx, store, link_libc, target_triple) is .some(text) else {
        return BackendTextResult(false, "");
    }
    return BackendTextResult(true, text);
}

public std.String llvm_version_text() {
    return llvm_backend.llvm_version_text();
}

@life()
public UInt8[]& default_target_triple_text() {
    return llvm_backend.default_target_triple_text();
}

Bool validate_store_symbols(context.CompilerContext& ctx, jil.Store& store) {
    if (!symbol.validate_unique_function_symbols(ctx, store)) {
        std.String message = duplicate_symbol_key_message(ctx, store);
        add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_key");
        return false;
    }
    if (symbol.validate_unique_function_symbol_names(ctx, store)) {
        return true;
    }
    std.String message = duplicate_symbol_name_message(ctx, store);
    add_backend_error(ctx, message.bytes(), "backend_duplicate_symbol_name");
    return false;
}

std.String duplicate_symbol_key_message(context.CompilerContext& ctx, jil.Store& store) {
    table.HashTable<symbol.BackendSymbolKey, Int> seen! = table.HashTable<symbol.BackendSymbolKey, Int>();
    Int index! = 0;
    while (index < store.functions.len()) {
        jil.Function& function = store.functions.ref_at(index);
        symbol.BackendSymbolKey key = symbol.function_symbol_key(ctx, function);
        if (seen.has(key)) {
            std.String name = symbol.function_symbol_name(ctx, function);
            std.StringBuilder builder = std.StringBuilder();
            builder.append("duplicate backend function symbol key: ");
            builder.append(name.bytes());
            builder.append(" ");
            qid.DefId provenance_def = jil.function_provenance_def(function.origin);
            builder.append(ctx.store.symbols.text(ctx.store.defs.get(provenance_def).name.symbol));
            return builder.into_string();
        }
        seen.set(key, index);
        index = index + 1;
    }
    return std.String("duplicate backend function symbol key");
}

std.String duplicate_symbol_name_message(context.CompilerContext& ctx, jil.Store& store) {
    guard symbol.duplicate_function_symbol_name(ctx, store) is .some(name) else {
        return std.String("duplicate backend function symbol name");
    }
    std.StringBuilder builder = std.StringBuilder();
    builder.append("duplicate backend function symbol name: ");
    builder.append(name.bytes());
    return builder.into_string();
}

() add_backend_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .codegen,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
