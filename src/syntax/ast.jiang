// Flat AST for Jiang syntax.
//
// AST only records source syntax facts. It does not store resolve, sema, IR,
// type, overload, or lowering results. AstId is local to one AstUnit; cross-file
// or cross-stage references should carry SourceId explicitly.

import std;
import list = "../support/list.jiang";
import source = "../source/source.jiang";

public struct AstId: Equatable {
    public Int index;

    public init(self, Int index) {
        assert(index >= 0);
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public AstId from_index(Int index) {
        return AstId(index);
    }

    public Bool equal(AstId& lhs, AstId& rhs) {
        return lhs.index == rhs.index;
    }
}

public struct AstRange {
    public Int start;

    public Int length;

    public init(self, Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end(self) {
        return self.start + self.length;
    }

    public Bool is_empty(self) {
        return self.length == 0;
    }
}

public struct AstUnit: Movable {
    public source.SourceId source_id;

    // Contiguous node table. AstId.index points here.
    public list.ArrayList<AstNode> nodes;

    // Contiguous child storage. Each AstRange points to one AstId slice here.
    public list.ArrayList<AstId> children;

    // Usually AstData.root. The root payload owns the top-level item range.
    public AstId?! root;

    public init(self, source.SourceId source_id) {
        self.source_id = source_id;
        self.nodes = list.ArrayList<AstNode>();
        self.children = list.ArrayList<AstId>();
        self.root = null;
    }

    public init(self,
        source.SourceId source_id,
        list.ArrayList<AstNode> nodes,
        list.ArrayList<AstId> children,
        AstId? root
    ) {
        self.source_id = source_id;
        self.nodes = nodes$.move();
        self.children = children$.move();
        self.root = root;
    }

    public AstUnit take(self) {
        AstUnit! result = AstUnit(self.source_id, self.nodes.take(), self.children.take(), self.root);
        self.root = null;
        return result$.move();
    }

    public AstId add_node(self, std.jiang.syntax.Span span, AstData data) {
        AstId! id = AstId(self.nodes.len());
        self.nodes.add(AstNode (span: span, data: data$.move()));
        return id;
    }

    public AstNode get(self, AstId id) {
        return self.nodes.get(id.to_index());
    }

    public AstNode& ref_at(self, AstId id) {
        return self.nodes.ref_at(id.to_index());
    }

    public AstRange add_child(self, AstId child) {
        Int! start = self.children.len();
        self.children.add(child);
        return AstRange(start, 1);
    }

    public AstId child_at(self, AstRange range, Int offset) {
        assert(offset >= 0 && offset < range.length);
        return self.children.get(range.start + offset);
    }
}

public struct AstNode {
    public std.jiang.syntax.Span span;
    public AstData data;
}

public union AstData {
    RootData root;
    NameData name;
    PathData path;
    GenericParamsData generic_params;
    GenericParamData generic_param;

    WhereConstData where_const;
    WhereTypeBoundData where_type_bound;
    WhereEqualData where_equal;
    WhereEqualData where_not_equal;
    WhereProjectionEqualData where_projection_equal;
    LifetimeNameData lifetime_name;
    LifetimeConstraintData lifetime_constraint;
    SelfAttributeData self_attribute;
    InlineAttributeData inline_attribute;
    NakedAttributeData naked_attribute;
    LinkSymbolAttributeData link_symbol_attribute;
    AliasAttributeData alias_attribute;
    TraitBoundData trait_bound;
    TypeBoundIntersectionData type_bound_intersection;
    AssocTypeBindingData assoc_type_binding;

    UnaryData unary;
    BinaryData binary;
    IsPatternData is_pattern;
    RangeData range;
    AstRange tuple_type, tuple_expr, array_expr;

    TopLevelDeclData top_level_decl;
    MemberDeclData member_decl;
    ExternBlockData extern_block;
    CompileBlockData compile_block;
    CompileIfData compile_if;
    ImportData import_decl;
    AliasData alias_decl;
    NominalData nominal_decl;
    FunctionData function_decl;
    GlobalData global_decl;
    GlobalDestructureData global_destructure_decl;
    ExtendData extend_decl;
    TraitData trait_decl;

    ExternItemData extern_item;
    ParamData param;
    FieldData field_decl;
    FieldDeclaratorData field_declarator;
    EnumCaseData enum_case;
    TypedUnionVariantsData typed_union_variants;
    AssocTypeData assoc_type;
    StmtData deinit_decl, paren_type, name_expr, stmt, defer_stmt;
    InitData init_decl;

    () infer_type;
    () unit_type;
    TypeData type_ref;
    NamedTypeData named_type;
    ArrayTypeData array_type;
    ErrorableTypeData errorable_type;
    FunctionTypeData function_type;
    EffectTypeData effect_type;

    LiteralData literal;
    LambdaData lambda_expr;
    LambdaParamData lambda_param;
    LambdaCaptureItemData lambda_capture_item;
    CallData call;
    CallArgData call_arg;
    FieldExprData field_expr;
    IndexExprData index_expr;
    SliceExprData slice_expr;
    ImplicitCallData implicit_call, type_implicit_call;
    ImplicitArgData implicit_arg;
    CastData cast_expr;
    StructLiteralData struct_literal;
    FieldInitData field_init;
    InlineAsmData inline_asm;
    InlineAsmData.Operand inline_asm_operand;
    InlineAsmData.Clobber inline_asm_clobber;
    BlockData block;
    IfData if_expr;
    GuardData guard_stmt;
    LoopData loop_expr;
    SwitchData switch_expr;
    SwitchCaseData switch_case;
    CatchExprData catch_expr;
    CatchClauseData catch_clause;
    StmtData await_expr;

    LetData let_stmt;
    GlobalDestructureData destructure_stmt;
    AssignData assign_stmt;
    ControlStmtData control_stmt;

    PatternData pattern;
}

public RootData? root_data(AstData data) {
    if (data is .root(root)) {
        return root;
    }
    return null;
}

public StmtData? stmt_data(AstData data) {
    if (data is .stmt(stmt)) {
        return stmt;
    }
    return null;
}

public PatternData? pattern_data(AstData data) {
    if (data is .pattern(pattern)) {
        return pattern;
    }
    return null;
}

public struct RootData {
    public AstRange items;
}

public struct NameData {
    public std.jiang.syntax.SymbolId? symbol_id;
}

public struct PathData {
    // children: name*
    public AstRange segments;
}

public struct GenericParamsData {
    // children: generic_param*
    public AstRange type_params;
}

public struct GenericParamData {
    public Bool is_const;
    public AstId? type_ref;
    public AstId? type_bound;
    public AstId name;
}

public struct WhereTypeBoundData {
    public AstId param;
    public AstId bound;
}

public struct WhereConstData {
    public AstId param;
    public AstId type_ref;
}

public struct WhereEqualData {
    public AstId param;
    public AstId value;
}

public struct WhereProjectionEqualData {
    public AstId param;
    public AstId trait_path;
    public AstId assoc_name;
    public AstId value;
}

public enum LifetimeNameKind {
    named_lifetime,
    self_lifetime,
    return_lifetime,
}

public struct LifetimeNameData {
    public LifetimeNameKind kind;
    public std.jiang.syntax.SymbolId? symbol_id;
}

public struct LifetimeConstraintData {
    public AstId longer;
    public AstId shorter;
}

public enum SelfReceiverMode {
    ref_receiver,
    move_receiver,
    unique_receiver,
}

public struct SelfAttributeData {
    public SelfReceiverMode mode;
}

public struct InlineAttributeData {
    public Bool always;
}

public struct NakedAttributeData {
}

public struct LinkSymbolAttributeData {
    public std.jiang.syntax.SymbolId? symbol_id;
}

public struct AliasAttributeData {
    public AstId name;
    public AstId value;
}

public struct TraitBoundData {
    public Bool negative;
    public AstId path;

    // children: type arg | assoc_type_binding*
    public AstRange args;
}

public struct TypeBoundIntersectionData {
    public AstId left;
    public AstId right;
}

public struct AssocTypeBindingData {
    public AstId name;
    public AstId value;
}

public struct UnaryData {
    public UnaryOp op;
    public AstId value;
}

public struct BinaryData {
    public BinaryOp op;
    public AstId left;
    public AstId right;
}

public struct IsPatternData {
    public AstId value;
    public AstId pattern;
}

public struct RangeData {
    public AstId start;
    public AstId end;
}

public struct AliasData {
    public AstId name;
    public AstId? target;
}

public enum ExternKind {
    none,
    native,
    c_abi,
    builtin,
}

public struct DeclModifiers {
    public Bool public_flag;
    public ExternKind extern_kind;
}

public enum MemberPublicAccess {
    all,
}

public union MemberVisibilityModifier {
    () private_modifier;
    MemberPublicAccess public_modifier;
}

public struct MemberModifiers {
    public MemberVisibilityModifier visibility;
    public Bool static_flag;
}

public struct TopLevelDeclData {
    public DeclModifiers modifiers;

    // children: where_annotation*
    public AstRange annotations;

    // Points to the concrete declaration body: function_decl, nominal_decl, etc.
    public AstId body;
}

public struct MemberDeclData {
    public MemberModifiers modifiers;

    // children: where_annotation*
    public AstRange annotations;

    // Points to the concrete member body: function_decl, nominal_decl, etc.
    public AstId body;
}

public enum ImportKind {
    string_path,
    package_name,
}

public struct ImportData {
    public ImportKind kind;
    public Bool flatten;
    public AstId? alias_name;
    public AstId path;
}

public struct ExternItemData {
    public MemberModifiers modifiers;
    public AstId body;
}

public struct ExternBlockData {
    public ExternKind extern_kind;

    // children: extern_item*
    public AstRange items;
}

public struct CompileBlockData {
    // children: top-level compile items
    public AstRange items;
}

public struct CompileIfData {
    public AstId condition;
    public AstId then_body;
    public AstId? else_body;
}

public enum NominalKind {
    struct_kind,
    enum_kind,
    union_kind,
}

public struct NominalData {
    public NominalKind nominal_kind;
    public AstId name;
    public AstId? generics;
    public AstId? enum_underlying_type;
    public NominalLayoutOptions layout_options;

    // children: trait path*
    public AstRange traits;

    // children: field/member/case/variant*
    public AstRange members;
}

public struct NominalLayoutOptions {
    public Bool packed;
    public Int align;

    public init(self, Bool packed = false, Int align = 0) {
        self.packed = packed;
        self.align = align;
    }
}

public struct FunctionData {
    public AstId result_type;
    public AstId name;
    public AstId? generics;
    public EffectSet effects;

    // children: param*
    public AstRange params;

    // null means a signature terminated by semicolon.
    public AstId? body;
}

public struct EffectSet {
    public Bool has_unsafe;
    public Bool has_async;
    public Bool has_sync;
    public AstId? domain;
    public AstId? context;

    public init(
        self,
        Bool has_unsafe = false,
        Bool has_async = false,
        Bool has_sync = false,
        AstId? domain = null,
        AstId? context = null
    ) {
        self.has_unsafe = has_unsafe;
        self.has_async = has_async;
        self.has_sync = has_sync;
        self.domain = domain;
        self.context = context;
    }

    public Bool is_empty(self) {
        return !self.has_unsafe && !self.has_async && !self.has_sync
            && self.domain == null && self.context == null;
    }
}

public struct GlobalData {
    public AstId type_ref;
    public AstId name;
    public Bool is_const;
    public AstId? initializer;
    public Bool mutable_binding = false;
}

public struct GlobalDestructureData {
    // children: destructure binding*
    public AstRange bindings;
    public AstId initializer;
}

public struct ExtendData {
    public AstId? generics;
    public AstId target_type;
    public AstId? trait_path;

    // children: assoc_type_impl | decl
    public AstRange members;
}

public struct TraitData {
    public AstId name;
    public AstId? generics;

    // children: parent path*
    public AstRange parents;

    // false means `trait T;`; true means the trait has a body.
    public Bool has_body;

    // children: assoc_type_decl | function_decl
    public AstRange members;
}

public struct ParamData {
    public AstId type_ref;
    public AstId name;
    public AstId? default_value;
    public SelfReceiverMode? receiver_mode = null;
    public Bool is_unique = false;
    public Bool mutable_binding = false;
}

public struct FieldData {
    public AstId type_ref;

    // children: field_declarator*
    public AstRange fields;
}

public struct FieldDeclaratorData {
    public AstId name;
    public AstId? default_value;
    public Bool mutable_binding = false;
}

public struct EnumCaseData {
    public AstId name;
    public AstId? value;
}

public struct TypedUnionVariantsData {
    public AstId type_ref;

    // children: name*
    public AstRange names;
}

public struct AssocTypeData {
    public AstId name;
    public AstId? value;
    public AstId? const_value;
    public Bool is_const;
    public AstId? type_ref;

    // children: type bound / where constraint*
    public AstRange constraints;
}

public struct InitData {
    public Bool failable;
    public AstId? name;

    // children: param*
    public AstRange params;
    public AstId body;
}

public enum TypeLayerKind {
    optional,
    mutable_type,
    reference,
    owner_pointer,
    raw_pointer,
    many_pointer,
    slice,
}

public struct SentinelTypeSyntax {
    public TypeSentinelKind kind = TypeSentinelKind.none;
    public std.jiang.syntax.Span span;
    public std.jiang.syntax.SymbolId? symbol_id = null;
}

public enum TypeSentinelKind {
    none,
    value,
    char_value,
    bool_true,
    bool_false,
    const_name,
    wildcard,
}

public struct TypeData {
    public AstId base;
    public TypeLayerKind layer;
    public TypeSentinelKind sentinel_kind = TypeSentinelKind.none;
    public std.jiang.syntax.Span sentinel_span;
    public std.jiang.syntax.SymbolId? sentinel_symbol_id = null;
}

public struct NamedTypeData {
    public AstId path;

    // children: type*
    public AstRange args;
}

public enum ArrayCountKind {
    inferred,
    int_lit,
    const_name,
}

public struct ArrayTypeData {
    public AstId element;
    public ArrayCountKind count_kind;
    public std.jiang.syntax.Span count_span;
    public std.jiang.syntax.SymbolId? count_symbol_id = null;
    public TypeSentinelKind sentinel_kind = TypeSentinelKind.none;
    public std.jiang.syntax.Span sentinel_span;
    public std.jiang.syntax.SymbolId? sentinel_symbol_id = null;
}

public struct ErrorableTypeData {
    public AstId value_type;
    public AstId? error_type;
}

public struct FunctionTypeData {
    // children: param type*
    public AstRange params;
    public AstId result;
    public EffectSet effects;
}

public struct EffectTypeData {
    public AstId base;
    public EffectSet effects;
}

public enum LiteralKind {
    int_lit,
    float_lit,
    char_lit,
    string_lit,
    bool_lit,
    null_lit,
}

public struct LiteralData {
    public LiteralKind kind;
    public Bool bool_value;
    public std.jiang.syntax.SymbolId? symbol_id = null;
}

public struct LambdaData {
    // children: lambda_param*
    public AstRange params;

    // children: lambda_capture_item*
    public AstRange captures;

    public AstId body;
}

public struct LambdaParamData {
    public AstId? name;
}

public struct LambdaCaptureItemData {
    public AstId? type_ref;
    public AstId name;
    public AstId value;
    public Bool mutable_binding = false;
    public Bool borrow_binding = false;
    public Bool is_unique = false;
}

public struct CallData {
    public AstId callee;

    // children: type*
    public AstRange type_args;

    // children: call_arg*
    public AstRange args;
}

public struct CallArgData {
    public AstId? label;
    public AstId value;
}

public union ImplicitArgData {
    AstId type_arg;
    AstId value_arg;
}

public struct FieldExprData {
    public AstId base;
    public AstId name;
    public Bool optional_chain;
}

public struct IndexExprData {
    public AstId base;
    public AstId index;
    public Bool optional_chain;
}

public struct SliceExprData {
    public AstId base;
    public AstId? start;
    public AstId? end;
    public Bool optional_chain;
}

public struct ImplicitCallData {
    public AstId base;
    public AstId name;
    public Bool optional_chain;

    // children: implicit_arg*
    public AstRange args;
}

public struct CastData {
    public AstId value;
    public AstId type_ref;
}

public struct StructLiteralData {
    public AstId? type_ref;

    // children: type_arg*
    public AstRange type_args;

    // children: field_init*
    public AstRange fields;
}

public struct FieldInitData {
    public AstId name;
    public AstId value;
}

public struct InlineAsmData {
    public AstId result_type;
    public std.jiang.syntax.SymbolId code_symbol;

    // children: inline_asm_operand*
    public AstRange operands;

    // children: inline_asm_clobber*
    public AstRange clobbers;
    public Options options;

    public union Operand {
        Input input;
        Output output;
    }

    public struct Input {
        public std.jiang.syntax.SymbolId name;
        public std.jiang.syntax.SymbolId constraint_symbol;
        public AstId value;
    }

    public struct Output {
        public std.jiang.syntax.SymbolId name;
        public std.jiang.syntax.SymbolId constraint_symbol;
        public AstId? type_ref;
    }

    public struct Clobber {
        public std.jiang.syntax.SymbolId name;
    }

    public struct Options {
        public Bool volatile;
        public Bool memory;
        public Bool noreturn;

        public init(self, Bool volatile = false, Bool memory = false, Bool noreturn = false) {
            self.volatile = volatile;
            self.memory = memory;
            self.noreturn = noreturn;
        }
    }
}

public struct BlockData {
    public EffectSet effects;

    // children: stmt*
    public AstRange statements;
    public AstId? tail_expr;
}

public struct IfData {
    public AstId condition;
    public AstId then_body;
    public AstId? else_body;
}

public struct GuardData {
    public AstId condition;
    public AstId else_body;
}

public struct LoopData {
    public AstId? condition;
    public AstId? pattern;
    public AstId? iterable;
    public AstId body;
}

public struct SwitchData {
    public AstId value;

    // children: switch_case*
    public AstRange cases;
}

public struct SwitchCaseData {
    // children: pattern*; `else` is stored as a single unit node at the else span.
    public AstRange patterns;
    public AstId body;
}

public struct CatchClauseData {
    public AstId? pattern;
    public AstId body;
}

public struct CatchExprData {
    public AstId value;
    public AstId catch_clause;
}

public struct StmtData {
    public AstId value;
}

public struct LetData {
    public AstId? type_ref;
    public AstId name;
    public AstId? initializer;
    public Bool mutable_binding = false;
    public Bool borrow_binding = false;
}

public struct AssignData {
    public AssignOp op;
    public AstId target;
    public AstId value;
}

public enum ControlStmtKind {
    return_value,
    break_loop,
    continue_loop,
    throw_value,
}

public struct ControlStmtData {
    public ControlStmtKind kind;
    public AstId? value;
}

public struct PatternData {
    public AstId? type_ref;
    public AstId? name;
    public AstId? value;
    public Bool optional_pattern = false;
    public Bool dot_prefix = false;
    public Bool mutable_binding = false;
    public Bool borrow_binding = false;

    // children: pattern*
    public AstRange payload;
}

public struct InferredBinding {
    public AstId name;
    public Bool mutable_binding;
    public Bool borrow_binding;
}

public enum UnaryOp {
    negate,
    not,
    bit_not,
    address_of,
    deref,
    new_value,
}

public enum BinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public enum AssignOp {
    assign,
    add_assign,
    sub_assign,
    mul_assign,
    div_assign,
    mod_assign,
    bit_and_assign,
    bit_or_assign,
    bit_xor_assign,
    shift_left_assign,
    shift_right_assign,
}
