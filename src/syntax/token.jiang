// Compiler syntax token API reuses the public Jiang tokenizer surface.

import std;

public alias Span = std.jiang.syntax.Span;
public alias SymbolId = std.jiang.syntax.SymbolId;
public alias TokenTag = std.jiang.TokenTag;
public alias TokenKind = std.jiang.TokenKind;
public alias Trivia = std.jiang.Trivia;
public alias TokenPresence = std.jiang.TokenPresence;
public alias Token = std.jiang.Token;

public enum Keyword {
    kw_new,
    kw_where,
    kw_life,
    kw_import,
    kw_public,
    kw_const,
    kw_alias,
    kw_extern,
    kw_return,
    kw_if,
    kw_else,
    kw_guard,
    kw_while,
    kw_for,
    kw_in,
    kw_is,
    kw_enum,
    kw_union,
    kw_struct,
    kw_trait,
    kw_extend,
    kw_associated,
    kw_init,
    kw_deinit,
    kw_static,
    kw_comptime,
    kw_switch,
    kw_try,
    kw_catch,
    kw_break,
    kw_continue,
    kw_defer,
    kw_throw,
    kw_true,
    kw_false,
    kw_null,
    kw_self,
    kw_ref,
    kw_self_type,
}

public enum KeywordIdentifierRole {
    reserved,
    contextual,
    special_name,
}

public KeywordIdentifierRole keyword_identifier_role(Keyword keyword) {
    if (keyword == .kw_ref) {
        return .contextual;
    }
    if (keyword == .kw_self || keyword == .kw_self_type) {
        return .special_name;
    }
    return .reserved;
}

public Bool keyword_is_reserved_identifier(Keyword keyword) {
    return keyword_identifier_role(keyword) == .reserved;
}

public TokenTag kind_tag(TokenKind kind) {
    return std.jiang.token_tag(kind);
}

public Bool kind_is(TokenKind kind, TokenTag tag) {
    return std.jiang.token_kind_is(kind, tag);
}

public Bool token_is(Token token, TokenTag tag) {
    return kind_is(token.kind, tag);
}

public SymbolId? symbol_id(Token token) {
    return token.symbol_id();
}

public Token missing_token(TokenTag tag, Span span) {
    return std.jiang.Token.missing(tag, span);
}

public Token make_token(
    TokenTag tag,
    Span span,
    Trivia leading,
    TokenPresence presence
) {
    return std.jiang.Token(std.jiang.token_kind(tag), span, leading, presence);
}

public Token make_token_with_kind(
    TokenKind kind,
    Span span,
    Trivia leading,
    TokenPresence presence
) {
    return std.jiang.Token(kind, span, leading, presence);
}
