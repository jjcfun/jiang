// Token only records lexical facts. Builtin types, modules, declarations, and
// other semantic facts are interpreted by resolve/sema.

import qid = "../store/id.jiang";

public enum TokenKind {
    eof,        // 输入结束。
    error,      // lexer 无法识别的输入片段。

    ident,      // 标识符；关键字也先按 ident 处理。
    escaped_ident,
    int_lit,    // 整数字面量。
    float_lit,  // 浮点字面量。
    char_lit,   // 字符字面量。
    string_lit, // UTF-8 字符串字面量。

    left_paren,    // (
    right_paren,   // )
    left_brace,    // {
    right_brace,   // }
    left_bracket,  // [
    right_bracket, // ]

    at,       // @
    hash,     // #
    comma,    // ,
    colon,    // :
    semicolon,// ;
    dot,      // .
    dot_dot,  // ..
    dollar,   // $
    underscore,// _

    question,          // ?
    question_dot,      // ?.
    question_question, // ??
    bang,              // !

    assign,          // =
    plus_assign,     // +=
    minus_assign,    // -=
    star_assign,     // *=
    slash_assign,    // /=
    percent_assign,  // %=
    amp_assign,      // &=
    pipe_assign,     // |=
    caret_assign,    // ^=
    lt_lt_assign,    // <<=
    gt_gt_assign,    // >>=
    fat_arrow,       // =>

    plus,    // +
    minus,   // -
    star,    // *
    slash,   // /
    percent, // %

    amp,     // &
    amp_amp, // &&
    pipe,    // |
    pipe_pipe,// ||
    caret,   // ^
    tilde,   // ~

    lt,      // <
    lt_eq,   // <=
    lt_lt,   // <<
    gt,      // >
    gt_eq,   // >=
    gt_gt,   // >>
    eq_eq,   // ==
    bang_eq, // !=
}

public enum Keyword {
    kw_new,
    kw_where,
    kw_life,
    kw_import,
    kw_public,
    kw_const,
    kw_alias,
    kw_extern,
    kw_return,
    kw_if,
    kw_else,
    kw_guard,
    kw_while,
    kw_for,
    kw_in,
    kw_is,
    kw_enum,
    kw_union,
    kw_struct,
    kw_trait,
    kw_extend,
    kw_associated,
    kw_init,
    kw_deinit,
    kw_static,
    kw_comptime,
    kw_switch,
    kw_try,
    kw_catch,
    kw_break,
    kw_continue,
    kw_defer,
    kw_throw,
    kw_true,
    kw_false,
    kw_null,
    kw_self,
    kw_some,
    kw_self_type,
}

public enum KeywordIdentifierRole {
    // 不能作为普通标识符，例如 `if`、`comptime`。
    reserved,
    // 只在特定语法位置生效；普通名字位置仍可使用，例如 `some`。
    contextual,
    // 不是声明名，但在表达式/类型位置可作为特殊名字，例如 `self` / `Self`。
    special_name,
}

public KeywordIdentifierRole keyword_identifier_role(Keyword keyword) {
    if (keyword == .kw_some) {
        return .contextual;
    }
    if (keyword == .kw_self || keyword == .kw_self_type) {
        return .special_name;
    }
    return .reserved;
}

public Bool keyword_is_reserved_identifier(Keyword keyword) {
    return keyword_identifier_role(keyword) == .reserved;
}

public struct Span {
    // 字节偏移；line/column 由 diagnostic 阶段按 source text 计算。
    public Int start;

    // 字节长度，不是 Unicode scalar 数量。
    public Int length;

    public init() {
        self.start = 0;
        self.length = 0;
    }

    public init(Int start, Int length) {
        self.start = start;
        self.length = length;
    }

    public Int end() {
        return self.start + self.length;
    }

    public Bool empty() {
        return self.length == 0;
    }
}

public struct Trivia {
    // 当前 token 前面是否跳过过任意空白字符。
    public Bool! has_whitespace = false;

    // 当前 token 前面是否跳过过换行；换行同时也算 whitespace。
    public Bool! has_newline = false;

    // 当前 token 前面是否跳过过注释。
    public Bool! has_comment = false;

    public Bool has_any() {
        return self.has_whitespace || self.has_comment;
    }
}

public enum TokenPresence {
    present,
    missing,
}

public struct Token {
    public TokenKind kind;
    public Span span;
    public Trivia leading = Trivia ();
    public TokenPresence presence = .present;

    // 标识符、字符串和数字字面量会指向 symbol 表；其他 token 使用 null。
    public qid.SymbolId? symbol_id = null;

    public static Token missing(TokenKind kind, Span span) {
        return Token (
            kind: kind,
            span: span,
            leading: Trivia (has_whitespace: false, has_newline: false, has_comment: false),
            presence: TokenPresence.missing,
            symbol_id: null
        );
    }
}
