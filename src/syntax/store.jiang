// Store 保存一次 package 编译中的 AST 阶段产物。
//
// AstId 仍然只在单个 AstUnit 内有效；这里按 SourceId 保存 AstUnit，
// 让 import discovery 和 Semantic Model lowering 共享 root/import closure 的解析结果。
// 这张表不挂在 CompilerStore 上，Semantic Model 生成完成后即可释放。

import table = "../support/table.jiang";
import source = "../source.jiang";
import ast = "./ast.jiang";

public struct UnitRecord: Movable {
    public source.SourceId source_id;
    public Int source_revision;
    public ast.AstUnit unit;
}

public struct Store: Movable {
    table.HashTable<source.SourceId, UnitRecord> units;

    public init(self) {
        self.units = table.HashTable<source.SourceId, UnitRecord>();
    }

    public () set_unit(self, ast.AstUnit unit, Int source_revision) {
        source.SourceId source_id = unit.source_id;
        self.units.set(source_id, UnitRecord (
            source_id: source_id,
            source_revision: source_revision,
            // set_unit 接收 owned AstUnit；这里把节点表所有权转入 Store。
            unit: unit
        ));
    }
    public ast.AstUnit&? unit(self, source.SourceId source_id, Int source_revision) {
        guard self.units.get_ref(source_id) is .some(entry) else {
            return null;
        }
        if (entry.source_revision != source_revision) {
            return null;
        }
        return entry.unit$.ref();
    }
}
