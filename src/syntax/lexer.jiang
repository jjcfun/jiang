import token = "./token.jiang";
import syntax_diagnostics = "./diagnostics.jiang";
import list = "../support/list.jiang";
import store_api = "../store/api.jiang";
import source = "../source/source.jiang";
import std;

struct LexBuilder: std.jiang.syntax.Builder {
    store_api.CompilerStore& store;
    source.SourceId source_id;

    init(store_api.CompilerStore& store, source.SourceId source_id) {
        self.store = store;
        self.source_id = source_id;
    }

    std.jiang.syntax.NodeId add_node(std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        return std.jiang.syntax.NodeId(0);
    }

    Int mark_children() {
        return 0;
    }

    () add_child(std.jiang.syntax.NodeId id) {}

    std.jiang.syntax.NodeRange take_children(Int start) {
        return std.jiang.syntax.NodeRange();
    }

    std.jiang.syntax.SymbolId intern_symbol(UInt8[]& text) {
        return self.store.symbols.intern(text);
    }

    UInt8[]& symbol_text(std.jiang.syntax.SymbolId symbol) {
        return self.store.symbols.text(symbol);
    }

    () add_diagnostic(std.jiang.syntax.Diagnostic value) {
        syntax_diagnostics.add_lexer_diagnostic(self.store, self.source_id, value);
    }

    () add_error(std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        self.add_diagnostic(std.jiang.syntax.Diagnostic.error(span, code, message));
    }
}

public struct LexResult: Movable {
    public list.ArrayList<token.Token> tokens;

    public init(list.ArrayList<token.Token> tokens) {
        self.tokens = tokens$.move();
    }

    public list.ArrayList<token.Token> take_tokens() {
        return self.tokens.take();
    }
}

public struct Lexer: Movable {
    store_api.CompilerStore& store;
    source.SourceId source_id;
    std.jiang.Tokenizer! tokenizer;

    public init(store_api.CompilerStore& store, UInt8[]& text, source.SourceId source_id) {
        std.jiang.syntax.SourceId std_source_id = std.jiang.syntax.SourceId(source_id.to_index());
        std.jiang.syntax.Source std_source = std.jiang.syntax.Source(std_source_id, text);
        self.store = store;
        self.source_id = source_id;
        self.tokenizer = std.jiang.Tokenizer.from_source(std_source);
    }

    public token.Token next() {
        LexBuilder! builder = LexBuilder(self.store, self.source_id);
        std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
        token.Token tok = self.tokenizer.next(syntax_builder);
        if (token.kind_is(tok.kind, .error)) {
            syntax_diagnostics.add_lexer_error(self.store, self.source_id, tok.span, "invalid_token");
        }
        return tok;
    }

    public LexResult tokenize() {
        list.ArrayList<token.Token>! buffer = list.ArrayList<token.Token>();
        while (true) {
            token.Token tok = self.next();
            buffer.add(tok);
            if (token.kind_is(tok.kind, .eof)) {
                return LexResult(buffer$.move());
            }
        }
        return LexResult(buffer$.move());
    }
}
