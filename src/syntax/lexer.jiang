import token = "./token.jiang";
import error = "./error.jiang";
import "../support/unicode.jiang";
import ident = "../support/ident.jiang";
import list = "../support/list.jiang";
import qid = "../query/id.jiang";
import query = "../query/api.jiang";

public struct LexResult: Movable {
    public list.ArrayList<token.Token> tokens;
    public list.ArrayList<error.LexError> errors;

    public init(list.ArrayList<token.Token> tokens, list.ArrayList<error.LexError> errors) {
        self.tokens = tokens$.move();
        self.errors = errors$.move();
    }
}

public struct Lexer: Movable {
    query.QuerySystem& query;
    UInt8[] text;
    Int! start;
    Int! current;
    token.Trivia! leading;
    list.ArrayList<error.LexError>! errors;

    public init(query.QuerySystem& query, UInt8[] text) {
        self.query = query;
        self.text = text;
        self.start = 0;
        self.current = 0;
        self.leading = token.Trivia();
        self.errors = list.ArrayList<error.LexError>();
    }

    public token.Token next() {
        self.leading = self.skip_trivia();
        self.start = self.current;

        if (self.at_end()) {
            return self.make(.eof);
        }

        UInt8! byte = self.peek();
        self.advance(1);
        if (byte == UInt8(34)) { return self.string_literal(); }
        if (byte == UInt8(39)) { return self.char_literal(); }
        if (byte == UInt8(40)) { return self.make(.left_paren); }
        if (byte == UInt8(41)) { return self.make(.right_paren); }
        if (byte == UInt8(123)) { return self.make(.left_brace); }
        if (byte == UInt8(125)) { return self.make(.right_brace); }
        if (byte == UInt8(91)) { return self.make(.left_bracket); }
        if (byte == UInt8(93)) { return self.make(.right_bracket); }
        if (byte == UInt8(64)) { return self.make(.at); }
        if (byte == UInt8(44)) { return self.make(.comma); }
        if (byte == UInt8(58)) { return self.make(.colon); }
        if (byte == UInt8(59)) { return self.make(.semicolon); }
        if (byte == UInt8(36)) { return self.make(.dollar); }
        if (byte == UInt8(126)) { return self.make(.tilde); }
        if (byte == UInt8(63)) { return self.question_operator(); }
        if (byte == UInt8(43)) { return self.plus_operator(); }
        if (byte == UInt8(45)) { return self.minus_operator(); }
        if (byte == UInt8(42)) { return self.star_operator(); }
        if (byte == UInt8(47)) { return self.slash_operator(); }
        if (byte == UInt8(37)) { return self.percent_operator(); }
        if (byte == UInt8(38)) { return self.amp_operator(); }
        if (byte == UInt8(124)) { return self.pipe_operator(); }
        if (byte == UInt8(94)) { return self.caret_operator(); }
        if (byte == UInt8(46)) { return self.dot_operator(); }
        if (byte == UInt8(61)) { return self.equal_operator(); }
        if (byte == UInt8(33)) { return self.bang_operator(); }
        if (byte == UInt8(60)) { return self.less_operator(); }
        if (byte == UInt8(62)) { return self.greater_operator(); }
        return self.identifier_number_or_error(byte);
    }

    public LexResult tokenize() {
        list.ArrayList<token.Token>! buffer = list.ArrayList<token.Token>();
        self.errors = list.ArrayList<error.LexError>();
        while (true) {
            token.Token tok = self.next();
            buffer.add(tok);
            if (tok.kind == .eof) {
                return LexResult(buffer$.move(), self.errors$.move());
            }
        }
        return LexResult(buffer$.move(), self.errors$.move());
    }

    Bool at_end() {
        return self.current >= self.text.length;
    }

    UInt8 peek() {
        if (self.at_end()) {
            return 0;
        }
        return self.text[self.current];
    }

    UInt8 peek_next() {
        if (self.current + 1 >= self.text.length) {
            return 0;
        }
        return self.text[self.current + 1];
    }

    () advance(Int offset) {
        self.current = self.current + offset;
    }

    Bool match(UInt8 expected) {
        if (self.at_end()) {
            return false;
        }
        if (self.text[self.current] != expected) {
            return false;
        }
        self.advance(1);
        return true;
    }

    token.Token make(token.TokenKind kind) {
        if (kind == .int_lit || kind == .float_lit) {
            qid.SymbolId symbol_id = self.query.symbols.intern(self.text[self.start .. self.current]);
            return token.Token {
                kind: kind,
                span: token.Span(self.start, self.current - self.start),
                leading: self.leading,
                presence: token.TokenPresence.present,
                symbol_id: symbol_id
            };
        }
        return token.Token {
            kind: kind, 
            span: token.Span(self.start, self.current - self.start),
            leading: self.leading,
            presence: token.TokenPresence.present,
            symbol_id: null
        };
    }

    token.Token make_error(error.LexErrorKind kind) {
        token.Span span = token.Span(self.start, self.current - self.start);
        self.errors.add(error.LexError(kind, span));
        return token.Token {
            kind: token.TokenKind.error, 
            span: span, 
            leading: self.leading,
            presence: token.TokenPresence.present,
            symbol_id: null
        };
    }

    token.Trivia skip_trivia() {
        token.Trivia leading = token.Trivia();
        while (!self.at_end()) {
            UInt8 byte = self.peek();
            if (self.is_space(byte)) {
                leading.has_whitespace = true;
                if (byte == UInt8(10) || byte == UInt8(13)) {
                    leading.has_newline = true;
                }
                self.advance(1);
                continue;
            }
            if (byte == UInt8(47) && self.peek_next() == UInt8(47)) {
                leading.has_comment = true;
                self.advance(2);
                while (!self.at_end() && self.peek() != UInt8(10)) {
                    self.advance(1);
                }
                continue;
            }
            return leading;
        }
        return leading;
    }

    token.Token identifier() {
        while (!self.at_end()) {
            UInt8 byte = self.peek();
            if (ident.is_ascii_ident_continue(byte)) {
                self.advance(1);
                continue;
            }
            if (unicode.is_utf8_ident_at(self.text, self.current)) {
                self.advance(unicode.utf8_len_at(self.text, self.current));
                continue;
            }
            return self.make_ident();
        }
        return self.make_ident();
    }

    token.Token make_ident() {
        token.Span span = token.Span(self.start, self.current - self.start);
        qid.SymbolId symbol_id = self.query.symbols.intern(self.text[self.start .. self.current]);
        return token.Token {
            kind: token.TokenKind.ident, 
            span: span, 
            leading: self.leading, 
            presence: token.TokenPresence.present,
            symbol_id: symbol_id
        };
    }

    token.Token make_string_literal() {
        token.Span span = token.Span(self.start, self.current - self.start);
        qid.SymbolId symbol_id = self.query.symbols.intern(self.text[self.start + 1 .. self.current - 1]);
        return token.Token {
            kind: token.TokenKind.string_lit,
            span: span,
            leading: self.leading,
            presence: token.TokenPresence.present,
            symbol_id: symbol_id
        };
    }

    token.Token unicode_identifier_or_error() {
        if (unicode.is_utf8_ident_at(self.text, self.start)) {
            self.advance(unicode.utf8_len_at(self.text, self.start) - 1);
            return self.identifier();
        }
        if (unicode.is_valid_utf8_at(self.text, self.start)) {
            self.advance(unicode.utf8_len_at(self.text, self.start) - 1);
        }
        return self.make_error(.unicode_punctuation);
    }

    token.Token identifier_number_or_error(UInt8 byte) {
        if (ident.is_ascii_ident_start(byte)) {
            return self.identifier();
        }
        if (self.is_digit(byte)) {
            return self.number();
        }
        if (unicode.is_utf8_lead(byte)) {
            return self.unicode_identifier_or_error();
        }
        return self.make_error(.unexpected_character);
    }

    token.Token number() {
        if (self.text[self.start] == UInt8(48)) {
            UInt8 prefix = self.peek();
            if (prefix == UInt8(98) || prefix == UInt8(66)) {
                self.advance(1);
                return self.radix_int_literal(2, .empty_binary_literal);
            }
            if (prefix == UInt8(111) || prefix == UInt8(79)) {
                self.advance(1);
                return self.radix_int_literal(8, .empty_octal_literal);
            }
            if (prefix == UInt8(120) || prefix == UInt8(88)) {
                self.advance(1);
                return self.radix_int_literal(16, .empty_hex_literal);
            }
        }

        self.consume_decimal_digits();

        Bool! is_float = false;
        if (self.peek() == UInt8(46) && self.is_digit(self.peek_next())) {
            is_float = true;
            self.advance(1);
            self.consume_decimal_digits();
        }

        if (self.peek() == UInt8(101) || self.peek() == UInt8(69)) {
            Int! exponent_start = self.current;
            self.advance(1);
            if (self.peek() == UInt8(43) || self.peek() == UInt8(45)) {
                self.advance(1);
            }
            if (!self.is_digit(self.peek())) {
                self.current = exponent_start;
                if (is_float) {
                    return self.make(.float_lit);
                }
                return self.make(.int_lit);
            }
            is_float = true;
            self.consume_decimal_digits();
        }

        if (is_float) {
            return self.make(.float_lit);
        }

        return self.make(.int_lit);
    }

    token.Token radix_int_literal(Int radix, error.LexErrorKind empty_kind) {
        Bool! has_digit = false;
        while (!self.at_end()) {
            UInt8 byte = self.peek();
            if (byte == UInt8(95)) {
                self.advance(1);
                continue;
            }
            if (!self.is_radix_digit(byte, radix)) {
                break;
            }
            has_digit = true;
            self.advance(1);
        }

        if (!has_digit) {
            return self.make_error(empty_kind);
        }
        return self.make(.int_lit);
    }

    () consume_decimal_digits() {
        while (!self.at_end()) {
            UInt8 byte = self.peek();
            if (byte == UInt8(95)) {
                self.advance(1);
                continue;
            }
            if (!self.is_digit(byte)) {
                return;
            }
            self.advance(1);
        }
    }

    token.Token string_literal() {
        while (!self.at_end()) {
            UInt8 byte = self.peek();
            if (byte == UInt8(34) || byte == UInt8(10)) {
                break;
            }
            if (byte == UInt8(92)) {
                self.advance(1);
                if (self.at_end()) {
                    return self.make_error(.unterminated_string);
                }
            }
            self.advance(1);
        }

        if (self.at_end() || self.peek() != UInt8(34)) {
            return self.make_error(.unterminated_string);
        }
        self.advance(1);
        return self.make_string_literal();
    }

    token.Token char_literal() {
        if (self.at_end() || self.peek() == UInt8(10)) {
            return self.make_error(.unterminated_char);
        }

        if (self.peek() == UInt8(92)) {
            self.advance(1);
            if (self.at_end() || self.peek() == UInt8(10)) {
                return self.make_error(.unterminated_char);
            }
            self.advance(1);
        } else {
            self.advance(1);
        }

        if (self.at_end() || self.peek() != UInt8(39)) {
            return self.make_error(.unterminated_char);
        }
        self.advance(1);
        return self.make(.char_lit);
    }

    token.Token question_operator() {
        if (self.match(UInt8(46))) {
            return self.make(.question_dot);
        }
        if (self.match(UInt8(63))) {
            return self.make(.question_question);
        }
        return self.make(.question);
    }

    token.Token plus_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.plus_assign);
        }
        return self.make(.plus);
    }

    token.Token minus_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.minus_assign);
        }
        return self.make(.minus);
    }

    token.Token star_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.star_assign);
        }
        return self.make(.star);
    }

    token.Token slash_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.slash_assign);
        }
        return self.make(.slash);
    }

    token.Token percent_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.percent_assign);
        }
        return self.make(.percent);
    }

    token.Token amp_operator() {
        if (self.match(UInt8(38))) {
            return self.make(.amp_amp);
        }
        if (self.match(UInt8(61))) {
            return self.make(.amp_assign);
        }
        return self.make(.amp);
    }

    token.Token pipe_operator() {
        if (self.match(UInt8(124))) {
            return self.make(.pipe_pipe);
        }
        if (self.match(UInt8(61))) {
            return self.make(.pipe_assign);
        }
        return self.make(.pipe);
    }

    token.Token caret_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.caret_assign);
        }
        return self.make(.caret);
    }

    token.Token dot_operator() {
        if (self.match(UInt8(46))) {
            return self.make(.dot_dot);
        }
        return self.make(.dot);
    }

    token.Token equal_operator() {
        if (self.match(UInt8(62))) {
            return self.make(.fat_arrow);
        }
        if (self.match(UInt8(61))) {
            return self.make(.eq_eq);
        }
        return self.make(.assign);
    }

    token.Token bang_operator() {
        if (self.match(UInt8(61))) {
            return self.make(.bang_eq);
        }
        return self.make(.bang);
    }

    token.Token less_operator() {
        if (self.match(UInt8(60))) {
            if (self.match(UInt8(61))) {
                return self.make(.lt_lt_assign);
            }
            return self.make(.lt_lt);
        }
        if (self.match(UInt8(61))) {
            return self.make(.lt_eq);
        }
        return self.make(.lt);
    }

    token.Token greater_operator() {
        if (self.match(UInt8(62))) {
            if (self.match(UInt8(61))) {
                return self.make(.gt_gt_assign);
            }
            return self.make(.gt_gt);
        }
        if (self.match(UInt8(61))) {
            return self.make(.gt_eq);
        }
        return self.make(.gt);
    }

    Bool is_space(UInt8 value) {
        return value == UInt8(32) || value == UInt8(13) || value == UInt8(9) || value == UInt8(10);
    }

    Bool is_digit(UInt8 value) {
        return value >= UInt8(48) && value <= UInt8(57);
    }

    Bool is_hex_digit(UInt8 value) {
        return self.is_digit(value) ||
            (value >= UInt8(65) && value <= UInt8(70)) ||
            (value >= UInt8(97) && value <= UInt8(102));
    }

    Bool is_radix_digit(UInt8 value, Int radix) {
        if (radix == 2) {
            return value == UInt8(48) || value == UInt8(49);
        }
        if (radix == 8) {
            return value >= UInt8(48) && value <= UInt8(55);
        }
        if (radix == 16) {
            return self.is_hex_digit(value);
        }
        return self.is_digit(value);
    }

}
