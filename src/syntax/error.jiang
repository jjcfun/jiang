// Syntax-stage errors. Lexer and parser keep structured errors here; the
// syntax/query driver converts them to user-facing diagnostics later.

import token = "./token.jiang";

public enum LexErrorKind {
    invalid_utf8,
    unexpected_character,
    unicode_punctuation,
    unterminated_string,
    unterminated_char,
    empty_binary_literal,
    empty_octal_literal,
    empty_hex_literal,
}

public struct LexError {
    public LexErrorKind kind;
    public token.Span span;

    public init(LexErrorKind kind, token.Span span) {
        self.kind = kind;
        self.span = span;
    }
}

public enum ParseErrorKind {
    unexpected_token,
    expected_token,
    expected_expression,
    expected_type,
    expected_name,
    expected_delimiter,
    unclosed_delimiter,
}

public struct ParseError {
    public ParseErrorKind kind;
    public token.Span span;
    public token.TokenKind expected;
    public token.TokenKind actual;

    public init(ParseErrorKind kind, token.Span span, token.TokenKind expected, token.TokenKind actual) {
        self.kind = kind;
        self.span = span;
        self.expected = expected;
        self.actual = actual;
    }
}
