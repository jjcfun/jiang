// Parser skeleton from token stream to flat AST.
//
// Parser 只记录语法事实。keyword 仍然先作为 identifier token，
// 再通过 keyword store 识别。

import ast = "./ast.jiang";
import syntax_builder = "./builder.jiang";
import syntax_diagnostics = "./diagnostics.jiang";
import lang_block = "../lang/block.jiang";
import lang_runtime = "../lang/runtime.jiang";
import keyword = "./keyword.jiang";
import std;
import list = "../support/list.jiang";
import store_api = "../store/api.jiang";
import qid = "../store/id.jiang";
import source = "../source/source.jiang";

public struct ParseResult: Movable {
    public ast.AstUnit unit;

    public init(self, ast.AstUnit unit) {
        self.unit = unit$.move();
    }

    public ast.AstUnit take_unit(self) {
        return self.unit.take();
    }
}

public ParseResult parse_tokens(
    store_api.CompilerStore& store,
    list.ArrayList<std.jiang.Token>& tokens,
    lang_block.LangBlockStore& blocks,
    UInt8[]& source_text,
    source.SourceId source_id
) {
    ast.AstUnit! unit = ast.AstUnit(source_id);
    Parser! parser = Parser(store, tokens, blocks, unit$.ref(), source_text, source_id);
    parser.parse();
    return ParseResult(unit$.move());
}

struct ParserMark {
    Int current;
    Int temp_len;
    Int node_len;
    Int child_len;
    Int diagnostic_len;
    Int pending_gt_start;

    init(self, Int current, Int temp_len, Int node_len, Int child_len, Int diagnostic_len, Int pending_gt_start) {
        self.current = current;
        self.temp_len = temp_len;
        self.node_len = node_len;
        self.child_len = child_len;
        self.diagnostic_len = diagnostic_len;
        self.pending_gt_start = pending_gt_start;
    }
}

struct BindingMode {
    Bool mutable_binding;
    Bool borrow_binding;

    init(self, Bool mutable_binding, Bool borrow_binding) {
        self.mutable_binding = mutable_binding;
        self.borrow_binding = borrow_binding;
    }
}

struct BindingType {
    ast.AstId type_ref;
    BindingMode mode;

    init(self, ast.AstId type_ref, BindingMode mode) {
        self.type_ref = type_ref;
        self.mode = mode;
    }
}

Bool token_is(std.jiang.Token tok, std.jiang.TokenTag tag) {
    return tok.tag() == tag;
}

std.jiang.Token make_token(
    std.jiang.TokenTag tag,
    std.jiang.syntax.Span span,
    std.jiang.Trivia leading,
    std.jiang.TokenPresence presence
) {
    return std.jiang.Token(std.jiang.token_kind(tag), span, leading, presence);
}

public struct Parser: Movable {
    store_api.CompilerStore& store;
    list.ArrayList<std.jiang.Token>& tokens;
    lang_block.LangBlockStore& blocks;
    Int! current;
    ast.AstUnit& unit;
    UInt8[]& source_text;
    source.SourceId source_id;
    list.ArrayList<ast.AstId>! temp;
    Int! pending_gt_start;

    public init(self,
        store_api.CompilerStore& store,
        list.ArrayList<std.jiang.Token>& tokens,
        lang_block.LangBlockStore& blocks,
        ast.AstUnit& unit,
        UInt8[]& source_text,
        source.SourceId source_id
    ) {
        self.store = store;
        self.tokens = tokens;
        self.blocks = blocks;
        self.current = 0;
        self.unit = unit;
        self.source_text = source_text;
        self.source_id = source_id;
        self.temp = list.ArrayList<ast.AstId>();
        self.pending_gt_start = -1;
    }

    public () parse(self) {
        self.parse_file();
    }

    () parse_file(self) {
        Int! item_start = self.temp.len();
        while (!self.at_end()) {
            if (self.parse_top_level_item() is .some(item)) {
                self.temp.add(item);
                continue;
            }
            self.recover_top_level_item();
        }

        ast.AstRange items = self.take_children(item_start);
        ast.AstId root = self.node(self.range_span(items), .root(ast.RootData (items: items)));
        self.unit.root = root;
    }

    // source_file <- top_level_item* EOF
    ast.AstId? parse_top_level_item(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.top_level_declaration);
        }
        if (self.check_compile_block_start()) {
            return self.parse_compile_block();
        }
        if (self.check_extern_block_start()) {
            return self.parse_extern_block();
        }
        if (self.check(.left_paren)) {
            ast.AstId? destructure = self.parse_global_destructure();
            if (destructure != null) { return destructure; }
        }
        return self.parse_top_level_decl();
    }

    ast.AstId? parse_extern_block(self) {
        std.jiang.Token start = self.expect_keyword(.kw_extern);
        ast.ExternKind extern_kind = self.parse_extern_block_kind();
        self.expect(.left_brace);
        Int item_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_extern_item() is .some(item)) {
                self.temp.add(item);
            } else {
                self.recover_member();
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange items = self.take_children(item_start);
        return self.node(
            self.span_from(start.span, end.span),
            .extern_block(ast.ExternBlockData (extern_kind: extern_kind, items: items))
        );
    }

    Bool check_extern_block_start(self) {
        if (!self.check_keyword(.kw_extern)) { return false; }
        if (token_is(self.peek_next(), .left_brace)) { return true; }
        if (!token_is(self.peek_next(), .left_bracket)) { return false; }
        return token_is(self.peek_offset(4), .left_brace);
    }

    ast.ExternKind parse_extern_block_kind(self) {
        if (!self.check(.left_bracket)) { return .c_abi; }
        return self.parse_extern_kind();
    }

    ast.AstId? parse_extern_item(self) {
        std.jiang.Token start = self.peek();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId?! body = self.parse_extern_function_decl();
        if (body == null) {
            body = self.parse_extern_global_decl();
        }
        if (body is .some(parsed)) {
            return self.node(
                self.span_from(start.span, self.unit.get(parsed).span),
                .extern_item(ast.ExternItemData (modifiers: modifiers, body: parsed))
            );
        }
        return null;
    }

    Bool check_compile_block_start(self) {
        return self.check_keyword(.kw_comptime);
    }

    ast.AstId parse_compile_block(self) {
        std.jiang.Token start = self.expect_keyword(.kw_comptime);
        return self.parse_compile_item_block_from_start(start.span);
    }

    ast.AstId parse_compile_item_block(self) {
        std.jiang.Token start = self.peek();
        return self.parse_compile_item_block_from_start(start.span);
    }

    ast.AstId parse_compile_item_block_from_start(self, std.jiang.syntax.Span start_span) {
        self.expect(.left_brace);
        Int item_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_compile_item() is .some(item)) {
                self.temp.add(item);
            } else {
                self.recover_top_level_item();
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange items = self.take_children(item_start);
        return self.node(
            self.span_from(start_span, end.span),
            .compile_block(ast.CompileBlockData (items: items))
        );
    }

    ast.AstId? parse_compile_item(self) {
        if (self.check_keyword(.kw_if)) {
            return self.parse_compile_if();
        }
        return self.parse_top_level_item();
    }

    ast.AstId parse_compile_if(self) {
        std.jiang.Token start = self.expect_keyword(.kw_if);
        ast.AstId condition = self.parse_expr_without_block();
        ast.AstId then_body = self.parse_compile_item_block();
        ast.AstId?! else_body = null;
        if (self.match_keyword(.kw_else)) {
            if (self.check_keyword(.kw_if)) {
                else_body = self.parse_compile_if();
            } else {
                else_body = self.parse_compile_item_block();
            }
        }
        return self.node(
            self.span_from(start.span, self.unit.get(then_body).span),
            .compile_if(ast.CompileIfData (
                condition: condition,
                then_body: then_body,
                else_body: else_body
            ))
        );
    }

    ast.AstId? parse_extern_function_decl(self) {
        return self.parse_named_function_decl(true);
    }

    ast.AstId? parse_extern_global_decl(self) {
        return self.parse_named_global_decl(true, false);
    }

    ast.AstId? parse_named_function_decl(self, Bool allow_escaped_name) {
        ParserMark mark = self.mark();
        ast.EffectSet effects = self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        if (!self.can_start_symbol_name(allow_escaped_name)) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_symbol_name(allow_escaped_name);
        if (self.check(.lt) || self.check(.left_paren)) {
            return self.parse_function_tail(type_ref, name, effects);
        }
        self.reset(mark);
        return null;
    }

    ast.AstId? parse_named_global_decl(self, Bool allow_escaped_name, Bool is_const) {
        ParserMark mark = self.mark();
        ast.AstId type_ref = self.parse_type();
        if (!self.can_start_symbol_name(allow_escaped_name)) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_symbol_name(allow_escaped_name);
        if (self.check(.lt) || self.check(.left_paren)) {
            self.reset(mark);
            return null;
        }
        ast.AstId?! initializer = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .global_decl(ast.GlobalData (
                type_ref: type_ref,
                name: name,
                is_const: is_const,
                initializer: initializer
            ))
        );
    }

    ast.AstId? parse_top_level_decl(self) {
        std.jiang.Token start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.DeclModifiers modifiers = self.parse_decl_modifiers();
        if (self.parse_top_level_decl_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            return self.node(
                self.span_from(start.span, self.unit.get(body).span),
                .top_level_decl(ast.TopLevelDeclData (
                    modifiers: modifiers,
                    annotations: annotations,
                    body: body
                ))
            );
        }
        return null;
    }

    ast.AstId? parse_member_decl(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.member_declaration);
        }
        std.jiang.Token start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_member_decl_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
            return self.member_decl_node(span, modifiers, annotations, body);
        }
        return null;
    }

    ast.AstId? parse_top_level_decl_body(self) {
        if (self.check_keyword(.kw_import)) { return self.parse_import_decl(); }
        if (self.check_keyword(.kw_alias)) { return self.parse_alias_decl(); }
        if (self.check_keyword(.kw_const)) { return self.parse_const_global_decl(); }
        if (self.can_start_nominal_decl()) { return self.parse_nominal_decl(); }
        if (self.check_keyword(.kw_trait)) { return self.parse_trait_decl(); }
        if (self.check_keyword(.kw_extend)) { return self.parse_extend_decl(); }
        ast.AstId? function_decl = self.parse_function_decl();
        if (function_decl != null) { return function_decl; }
        return self.parse_global_decl();
    }

    ast.AstId? parse_member_decl_body(self) {
        if (self.check_keyword(.kw_init)) { return self.parse_init_decl(); }
        if (self.check_keyword(.kw_alias)) { return self.parse_alias_decl(); }
        if (self.can_start_nominal_decl()) { return self.parse_nominal_decl(); }
        if (self.check_keyword(.kw_trait)) { return self.parse_trait_decl(); }
        return self.parse_function_decl();
    }

    () parse_annotations(self) {
        while (self.check(.at)) {
            ParserMark mark = self.mark();
            self.advance();
            self.reject_spacing();
            if (self.match_keyword(.kw_where)) {
                self.parse_where_annotation();
                continue;
            }
            if (self.match_keyword(.kw_life)) {
                self.parse_life_annotation();
                continue;
            }
            if (self.check_symbol_text("alias")) {
                self.parse_alias_attributes();
                continue;
            }
            if (self.match_keyword(.kw_self)) {
                self.temp.add(self.parse_self_attribute());
                continue;
            }
            if (self.check_symbol_text("inline")) {
                self.temp.add(self.parse_inline_attribute());
                continue;
            }
            if (self.check_symbol_text("naked")) {
                self.temp.add(self.parse_naked_attribute());
                continue;
            }
            if (self.check_symbol_text("link_symbol")) {
                self.temp.add(self.parse_link_symbol_attribute());
                continue;
            }
            self.reset(mark);
            return;
        }
    }

    ast.AstId parse_inline_attribute(self) {
        std.jiang.Token start = self.advance();
        std.jiang.Token! end = start;
        if (self.match(.left_paren)) {
            self.parse_inline_mode();
            end = self.expect(.right_paren);
        }
        return self.node(
            self.span_from(start.span, end.span),
            .inline_attribute(ast.InlineAttributeData(always: true))
        );
    }

    () parse_inline_mode(self) {
        if (self.check_symbol_text("always")) {
            self.advance();
            return;
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_inline_mode",
            "expected inline mode: always"
        );
        if (!self.at_end() && !self.check(.right_paren)) {
            self.advance();
        }
    }

    ast.AstId parse_naked_attribute(self) {
        std.jiang.Token start = self.advance();
        return self.node(start.span, .naked_attribute(ast.NakedAttributeData()));
    }

    ast.AstId parse_link_symbol_attribute(self) {
        std.jiang.Token start = self.advance();
        self.expect(.left_paren);
        std.jiang.Token symbol_token = self.expect(.string_lit);
        std.jiang.Token end = self.expect(.right_paren);
        qid.SymbolId?! symbol = null;
        if (self.token_symbol(symbol_token) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return self.node(
            self.span_from(start.span, end.span),
            .link_symbol_attribute(ast.LinkSymbolAttributeData(symbol_id: symbol))
        );
    }

    () parse_alias_attributes(self) {
        self.advance();
        self.expect(.left_paren);
        while (!self.at_end() && !self.check(.right_paren)) {
            self.temp.add(self.parse_alias_attribute_binding());
            if (!self.match(.comma)) { break; }
        }
        self.expect(.right_paren);
    }

    ast.AstId parse_alias_attribute_binding(self) {
        ast.AstId name = self.parse_name();
        self.expect(.assign);
        ast.AstId value = self.parse_type();
        return self.node(
            self.span_from(self.unit.get(name).span, self.unit.get(value).span),
            .alias_attribute(ast.AliasAttributeData(name: name, value: value))
        );
    }

    ast.AstId parse_self_attribute(self) {
        std.jiang.Token start = self.previous();
        self.expect(.left_paren);
        ast.SelfReceiverMode mode = self.parse_self_receiver_mode();
        std.jiang.Token end = self.expect(.right_paren);
        return self.node(
            self.span_from(start.span, end.span),
            .self_attribute(ast.SelfAttributeData(mode: mode))
        );
    }

    ast.SelfReceiverMode parse_self_receiver_mode(self) {
        if (self.check_symbol_text("ref")) {
            self.advance();
            return ast.SelfReceiverMode.ref_receiver;
        }
        if (self.check_symbol_text("move")) {
            self.advance();
            return ast.SelfReceiverMode.move_receiver;
        }
        if (self.check_symbol_text("unique")) {
            self.advance();
            return ast.SelfReceiverMode.unique_receiver;
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_self_receiver_mode",
            "expected self receiver mode: ref, move, or unique"
        );
        if (!self.at_end() && !self.check(.right_paren)) {
            self.advance();
        }
        return ast.SelfReceiverMode.ref_receiver;
    }

    () parse_where_annotation(self) {
        self.expect(.left_paren);
        Int constraint_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.parse_where_constraints();
        }
        self.expect(.right_paren);
        ast.AstRange constraints = self.take_children(constraint_start);
        self.append_child_range(constraints);
    }

    () parse_life_annotation(self) {
        self.expect(.left_paren);
        Int constraint_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.parse_life_constraints();
        }
        self.expect(.right_paren);
        ast.AstRange constraints = self.take_children(constraint_start);
        self.append_child_range(constraints);
    }

    () parse_life_constraints(self) {
        while (!self.at_end() && !self.check(.right_paren)) {
            if (self.parse_life_constraint() is .some(constraint)) {
                self.temp.add(constraint);
            } else {
                self.error_at_current_kind("expected_name");
                self.advance();
            }
            if (!self.match(.comma)) { return; }
        }
    }

    ast.AstId? parse_life_constraint(self) {
        ast.AstId longer = self.parse_life_name();
        if (!self.match(.gt)) {
            return null;
        }
        ast.AstId shorter = self.parse_life_name();
        return self.node_from_children(
            longer,
            shorter,
            .lifetime_constraint(ast.LifetimeConstraintData (longer: longer, shorter: shorter))
        );
    }

    ast.AstId parse_life_name(self) {
        if (self.check_keyword(.kw_self)) {
            return self.lifetime_name_node_from_token(self.advance(), ast.LifetimeNameKind.self_lifetime);
        }
        if (self.check_keyword(.kw_return)) {
            return self.lifetime_name_node_from_token(self.advance(), ast.LifetimeNameKind.return_lifetime);
        }
        if (self.can_start_name()) {
            return self.lifetime_name_node_from_token(self.advance(), ast.LifetimeNameKind.named_lifetime);
        }
        std.jiang.Token actual = self.peek();
        self.error_at_current("expected_name", .ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.node(actual.span, .lifetime_name(ast.LifetimeNameData (
            kind: ast.LifetimeNameKind.named_lifetime,
            symbol_id: null
        )));
    }

    ast.AstId lifetime_name_node_from_token(self, std.jiang.Token tok, ast.LifetimeNameKind kind) {
        qid.SymbolId?! symbol = null;
        if (self.token_symbol(tok) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return self.node(tok.span, .lifetime_name(ast.LifetimeNameData (
            kind: kind,
            symbol_id: symbol
        )));
    }

    () append_child_range(self, ast.AstRange range) {
        Int! index = 0;
        while (index < range.length) {
            self.temp.add(self.unit.child_at(range, index));
            index = index + 1;
        }
    }

    () reject_spacing(self) {
        std.jiang.Token next = self.peek();
        if (next.leading.has_any()) {
            self.add_parse_error(next.span, "unexpected_trivia");
        }
    }

    () parse_where_constraints(self) {
        while (!self.at_end() && !self.check(.right_paren)) {
            if (self.parse_where_constraint() is .some(constraint)) {
                self.temp.add(constraint);
            } else {
                self.error_at_current_kind("expected_type");
                self.advance();
            }
            if (!self.match(.comma)) { return; }
        }
    }

    ast.AstId? parse_where_constraint(self) {
        ast.AstId name = self.parse_name();
        if (self.check(.dot)) {
            return self.parse_projected_where_constraint(name);
        }
        if (self.match(.colon)) {
            ast.AstId bound = self.parse_type_bound();
            return self.node_from_children(
                name,
                bound,
                .where_type_bound(ast.WhereTypeBoundData (param: name, bound: bound))
            );
        }
        if (self.match(.eq_eq)) {
            ast.AstId value = self.parse_type();
            return self.node_from_children(
                name,
                value,
                .where_type_equal(ast.WhereTypeEqualData (param: name, value: value))
            );
        }
        if (self.match(.bang_eq)) {
            ast.AstId value = self.parse_type();
            return self.node_from_children(
                name,
                value,
                .where_type_not_equal(ast.WhereTypeEqualData (param: name, value: value))
            );
        }
        return null;
    }

    ast.AstId parse_projected_where_constraint(self, ast.AstId param) {
        self.expect(.dot);
        self.expect(.left_bracket);
        ast.AstId trait_path = self.parse_path();
        self.expect(.right_bracket);
        self.expect(.dot);
        ast.AstId assoc_name = self.parse_name();
        self.expect(.eq_eq);
        ast.AstId value = self.parse_type();
        return self.node_from_children(
            param,
            value,
            .where_projection_equal(ast.WhereProjectionEqualData (
                param: param,
                trait_path: trait_path,
                assoc_name: assoc_name,
                value: value
            ))
        );
    }

    ast.DeclModifiers parse_decl_modifiers(self) {
        Bool! public_flag = false;
        ast.ExternKind! extern_kind = .none;
        Bool! keep_going = true;
        while (keep_going) {
            if (self.match_keyword(.kw_public)) {
                public_flag = true;
            } else if (self.match_keyword(.kw_extern)) {
                extern_kind = self.parse_extern_kind();
            } else {
                keep_going = false;
            }
        }
        return ast.DeclModifiers (public_flag: public_flag, extern_kind: extern_kind);
    }

    ast.ExternKind parse_extern_kind(self) {
        if (!self.match(.left_bracket)) { return .native; }
        ast.ExternKind! kind = .native;
        if (self.check_symbol_text("C")) {
            self.advance();
            kind = .c_abi;
        } else if (self.check_symbol_text("builtin")) {
            self.advance();
            kind = .builtin;
        } else {
            self.add_parse_error_message(
                self.peek().span,
                "expected_extern_kind",
                "expected extern kind: C or builtin"
            );
            if (!self.at_end() && !self.check(.right_bracket)) {
                self.advance();
            }
        }
        self.expect(.right_bracket);
        return kind;
    }

    ast.MemberModifiers parse_member_modifiers(self) {
        Int! visibility_tag = 0;
        Bool! keep_going = true;
        while (keep_going) {
            if (self.match_keyword(.kw_public)) {
                visibility_tag = 1;
            } else {
                keep_going = false;
            }
        }
        return ast.MemberModifiers (
            visibility: self.member_visibility_modifier(visibility_tag),
            static_flag: false
        );
    }

    ast.MemberVisibilityModifier member_visibility_modifier(self, Int tag) {
        if (tag == 1) { return .public_modifier(.all); }
        return .private_modifier();
    }

    ast.AstId parse_import_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_import);
        ast.AstId?! alias_name = null;
        Bool! flatten = false;
        ast.ImportKind! kind = ast.ImportKind.package_name;
        ast.AstId! path = self.unit_node(start.span);
        if (self.match(.star)) {
            flatten = true;
            self.expect(.assign);
        } else if (self.check(.ident) && token_is(self.peek_next(), .assign)) {
            alias_name = self.parse_name();
            self.expect(.assign);
        }
        if (self.check(.string_lit)) {
            kind = ast.ImportKind.string_path;
            path = self.literal_node(self.advance(), ast.LiteralKind.string_lit);
        } else {
            path = self.parse_name();
        }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .import_decl(ast.ImportData (kind: kind, flatten: flatten, alias_name: alias_name, path: path))
        );
    }

    ast.AstId parse_alias_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_alias);
        ast.AstId name = self.parse_name();
        ast.AstId?! target = null;
        if (self.match(.assign)) {
            target = self.parse_alias_target();
        }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .alias_decl(ast.AliasData (name: name, target: target))
        );
    }

    ast.AstId parse_alias_target(self) {
        if (self.check(.escaped_ident)) {
            return self.parse_escaped_symbol_name();
        }
        return self.parse_type();
    }

    ast.AstId? parse_nominal_decl(self) {
        if (self.check_keyword(.kw_struct)) { return self.parse_struct_decl(); }
        if (self.check_keyword(.kw_enum)) { return self.parse_enum_decl(); }
        if (self.check_keyword(.kw_union)) { return self.parse_union_decl(); }
        return null;
    }

    ast.AstId parse_struct_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_struct);
        ast.NominalLayoutOptions layout_options = self.parse_struct_layout_options();
        ast.AstId name = self.parse_name();
        ast.AstId?! generics = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange traits = self.parse_trait_list();
        ast.AstRange members = self.parse_struct_body();
        std.jiang.syntax.Span span = self.span_from(start.span, self.previous().span);
        return self.node(
            span,
            .nominal_decl(ast.NominalData (
                nominal_kind: ast.NominalKind.struct_kind,
                name: name,
                generics: generics,
                enum_underlying_type: null,
                layout_options: layout_options,
                traits: traits,
                members: members
            ))
        );
    }

    ast.NominalLayoutOptions parse_struct_layout_options(self) {
        ast.NominalLayoutOptions! options = ast.NominalLayoutOptions();
        if (!self.match(.left_bracket)) {
            return options;
        }
        while (!self.at_end() && !self.check(.right_bracket)) {
            options = self.parse_struct_layout_option(options);
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return options;
    }

    ast.NominalLayoutOptions parse_struct_layout_option(self, ast.NominalLayoutOptions options) {
        if (self.check_symbol_text("packed")) {
            return self.parse_packed_struct_option(options);
        }
        if (self.check_symbol_text("align")) {
            return self.parse_align_struct_option(options);
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_struct_option",
            "expected struct option: packed or align"
        );
        if (self.at_end() || self.check(.right_bracket)) {
            return options;
        }
        self.advance();
        return options;
    }

    ast.NominalLayoutOptions parse_packed_struct_option(self, ast.NominalLayoutOptions options) {
        std.jiang.Token option = self.peek();
        self.advance();
        if (options.packed) {
            self.add_parse_error_message(
                option.span,
                "duplicate_struct_option",
                "duplicate struct option: packed"
            );
        }
        return ast.NominalLayoutOptions(packed: true, align: options.align);
    }

    ast.NominalLayoutOptions parse_align_struct_option(self, ast.NominalLayoutOptions options) {
        std.jiang.Token option = self.peek();
        self.advance();
        if (options.align != 0) {
            self.add_parse_error_message(
                option.span,
                "duplicate_struct_option",
                "duplicate struct option: align"
            );
        }
        self.expect(.colon);
        return ast.NominalLayoutOptions(packed: options.packed, align: self.parse_struct_align_value());
    }

    Int parse_struct_align_value(self) {
        std.jiang.Token value = self.expect(.int_lit);
        return self.decimal_int_token_value(value);
    }

    Int decimal_int_token_value(self, std.jiang.Token token) {
        Int! value = 0;
        Int! index = token.span.start;
        Bool! ok = true;
        while (index < token.span.end()) {
            UInt8 byte = self.source_text[index];
            if (byte == UInt8(95)) {
                index = index + 1;
                continue;
            }
            if (byte < UInt8(48) || byte > UInt8(57)) {
                ok = false;
                break;
            }
            value = value * 10 + Int(byte - UInt8(48));
            index = index + 1;
        }
        if (!ok) {
            self.add_parse_error_message(
                token.span,
                "invalid_struct_align",
                "struct align option requires a decimal integer literal"
            );
            return 0;
        }
        return value;
    }

    ast.AstId parse_enum_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_enum);
        ast.AstId?! underlying_type = null;
        if (self.match(.left_bracket)) {
            underlying_type = self.parse_type();
            self.expect(.right_bracket);
        }
        ast.AstId name = self.parse_name();
        ast.AstRange traits = self.parse_trait_list();
        ast.AstRange members = self.parse_enum_body();
        std.jiang.syntax.Span end = self.previous().span;
        return self.node(
            self.span_from(start.span, end),
            .nominal_decl(ast.NominalData (
                nominal_kind: ast.NominalKind.enum_kind,
                name: name,
                generics: null,
                enum_underlying_type: underlying_type,
                layout_options: ast.NominalLayoutOptions(),
                traits: traits,
                members: members
            ))
        );
    }

    ast.AstRange parse_enum_body(self) {
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        self.parse_enum_cases();
        if (self.match(.semicolon)) {
            self.parse_enum_members_after_cases();
        }
        self.expect(.right_brace);
        return self.take_children(member_start);
    }

    () parse_enum_cases(self) {
        while (!self.at_end() && !self.check(.right_brace) && !self.check(.semicolon)) {
            self.temp.add(self.parse_enum_case());
            if (!self.match(.comma)) {
                if (!self.check(.right_brace) && !self.check(.semicolon)) {
                    self.expect(.comma);
                }
                return;
            }
        }
    }

    () parse_enum_members_after_cases(self) {
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_enum_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
    }

    ast.AstId parse_union_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_union);
        if (self.match(.left_bracket)) {
            self.parse_name();
            self.expect(.right_bracket);
        }
        ast.AstId name = self.parse_name();
        ast.AstId?! generics = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange traits = self.parse_trait_list();
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_union_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange members = self.take_children(member_start);
        return self.node(
            self.span_from(start.span, end.span),
            .nominal_decl(ast.NominalData (
                nominal_kind: ast.NominalKind.union_kind,
                name: name,
                generics: generics,
                enum_underlying_type: null,
                layout_options: ast.NominalLayoutOptions(),
                traits: traits,
                members: members
            ))
        );
    }

    ast.AstId parse_trait_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_trait);
        ast.AstId name = self.parse_name();
        ast.AstId?! generics = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange parents = self.parse_trait_parents();
        Bool has_body = !self.match(.semicolon);
        Int member_start = self.temp.len();
        if (has_body) { self.parse_trait_body_members(); }
        ast.AstRange members = self.take_children(member_start);
        return self.node(
            self.span_from(start.span, self.previous().span),
            .trait_decl(ast.TraitData (
                name: name,
                generics: generics,
                parents: parents,
                has_body: has_body,
                members: members
            ))
        );
    }

    ast.AstRange parse_trait_parents(self) {
        return self.parse_trait_list();
    }

    () parse_trait_body_members(self) {
        self.expect(.left_brace);
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_trait_member() is .some(member)) {
                self.temp.add(member);
                continue;
            }
            self.recover_member();
        }
        self.expect(.right_brace);
    }

    ast.AstId parse_extend_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_extend);
        ast.AstId target = self.parse_type();
        ast.AstId?! trait_path = null;
        if (self.match(.colon)) { trait_path = self.parse_trait_bound(); }
        if (self.match(.semicolon)) {
            ast.AstRange members = self.take_children(self.temp.len());
            return self.node(
                self.span_from(start.span, self.previous().span),
                .extend_decl(ast.ExtendData (
                    target_type: target,
                    trait_path: trait_path,
                    members: members
                ))
            );
        }
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_extend_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange members = self.take_children(member_start);
        return self.node(
            self.span_from(start.span, end.span),
            .extend_decl(ast.ExtendData (
                target_type: target,
                trait_path: trait_path,
                members: members
            ))
        );
    }

    ast.AstId? parse_function_decl(self) {
        return self.parse_named_function_decl(false);
    }

    ast.AstId? parse_global_decl(self) {
        return self.parse_named_global_decl(false, false);
    }

    ast.AstId? parse_const_global_decl(self) {
        self.expect_keyword(.kw_const);
        return self.parse_named_global_decl(false, true);
    }

    ast.AstId parse_function_tail(self, ast.AstId result_type, ast.AstId name, ast.EffectSet effects) {
        ast.AstId?! generics = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        self.expect(.left_paren);
        ast.AstRange params = self.parse_param_list_until(.right_paren);
        self.expect(.right_paren);
        ast.AstId?! body = null;
        if (self.match(.semicolon)) {
            body = null;
        } else {
            body = self.parse_block();
        }
        std.jiang.syntax.Span end = self.previous().span;
        return self.node(
            self.span_from(self.unit.get(result_type).span, end),
            .function_decl(ast.FunctionData (
                result_type: result_type,
                name: name,
                generics: generics,
                params: params,
                body: body,
                effects: effects
            ))
        );
    }

    ast.AstId? parse_global_destructure(self) {
        ParserMark mark = self.mark();
        std.jiang.Token start = self.expect(.left_paren);
        Int binding_start = self.temp.len();
        self.temp.add(self.parse_destructure_binding());
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { break; }
            self.temp.add(self.parse_destructure_binding());
        }
        self.expect(.right_paren);
        if (!self.match(.assign)) {
            self.reset(mark);
            return null;
        }
        ast.AstId initializer = self.parse_expr();
        std.jiang.Token end = self.expect(.semicolon);
        ast.AstRange bindings = self.take_children(binding_start);
        return self.node(
            self.span_from(start.span, end.span),
            .global_destructure_decl(ast.GlobalDestructureData (
                bindings: bindings,
                initializer: initializer
            ))
        );
    }

    ast.AstId parse_destructure_binding(self) {
        if (self.check(.underscore)) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        ast.AstId name = self.parse_name();
        return self.node_from_child(
            name,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_generic_params(self) {
        std.jiang.Token start = self.expect(.lt);
        Int type_param_start = self.temp.len();
        if (!self.check(.gt)) {
            self.temp.add(self.parse_generic_param());
            while (self.match(.comma)) {
                if (self.check(.gt)) { break; }
                self.temp.add(self.parse_generic_param());
            }
        }
        std.jiang.Token end = self.expect(.gt);
        ast.AstRange type_params = self.take_children(type_param_start);
        return self.node(
            self.span_from(start.span, end.span),
            .generic_params(ast.GenericParamsData (type_params: type_params))
        );
    }

    ast.AstId parse_generic_param(self) {
        if (self.match_keyword(.kw_const)) {
            ast.AstId type_ref = self.parse_type();
            ast.AstId name = self.parse_name();
            return self.node_from_children(
                type_ref,
                name,
                .generic_param(ast.GenericParamData (
                    is_const: true,
                    type_ref: type_ref,
                    name: name
                ))
            );
        }
        ast.AstId name = self.parse_name();
        return self.node_from_child(name, .generic_param(ast.GenericParamData (
            is_const: false,
            type_ref: null,
            name: name
        )));
    }

    ast.AstRange parse_trait_list(self) {
        Int start = self.temp.len();
        if (self.match(.colon)) {
            self.temp.add(self.parse_type_bound());
            while (self.match(.comma)) {
                self.temp.add(self.parse_type_bound());
            }
        }
        return self.take_children(start);
    }

    ast.AstRange parse_struct_body(self) {
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_struct_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
        self.expect(.right_brace);
        return self.take_children(member_start);
    }

    ast.AstId? parse_struct_member(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.member_declaration);
        }
        std.jiang.Token start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_struct_member_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
            return self.member_decl_node(span, modifiers, annotations, body);
        }
        return null;
    }

    ast.AstId member_decl_node(self,
        std.jiang.syntax.Span span,
        ast.MemberModifiers modifiers,
        ast.AstRange annotations,
        ast.AstId body
    ) {
        return self.node(
            span,
            .member_decl(ast.MemberDeclData (
                modifiers: modifiers,
                annotations: annotations,
                body: body
            ))
        );
    }

    ast.AstId? parse_struct_member_body(self) {
        if (self.check_keyword(.kw_deinit)) { return self.parse_deinit_decl(); }
        if (self.check_keyword(.kw_init)) { return self.parse_init_decl(); }
        if (self.check_keyword(.kw_associated)) { return self.parse_assoc_type_impl(); }
        if (self.check_keyword(.kw_struct)
            || self.check_keyword(.kw_enum)
            || self.check_keyword(.kw_union)) {
            return self.parse_nominal_decl();
        }
        ParserMark mark = self.mark();
        ast.EffectSet effects = self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        if (!self.can_start_name()) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_name();
        if (self.check(.left_paren) || self.check(.lt)) {
            return self.parse_function_tail(type_ref, name, effects);
        }
        self.reset(mark);
        return self.parse_field_decl();
    }

    ast.AstId parse_field_decl(self) {
        ast.AstId type_ref = self.parse_type();
        Int field_start = self.temp.len();
        self.temp.add(self.parse_field_declarator());
        while (self.match(.comma)) {
            if (self.check(.semicolon)) { break; }
            self.temp.add(self.parse_field_declarator());
        }
        std.jiang.Token end = self.expect(.semicolon);
        ast.AstRange fields = self.take_children(field_start);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .field_decl(ast.FieldData (type_ref: type_ref, fields: fields))
        );
    }

    ast.AstId parse_field_declarator(self) {
        ast.AstId name = self.parse_name();
        ast.AstId?! default_value = null;
        if (self.match(.assign)) { default_value = self.parse_expr(); }
        std.jiang.syntax.Span! end = self.unit.get(name).span;
        if (default_value is .some(value)) { end = self.unit.get(value).span; }
        return self.node(
            self.span_from(self.unit.get(name).span, end),
            .field_declarator(ast.FieldDeclaratorData (
                name: name,
                default_value: default_value
            ))
        );
    }

    ast.AstId parse_deinit_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_deinit);
        self.expect(.left_paren);
        self.expect_keyword(.kw_self);
        self.expect(.right_paren);
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .deinit_decl(ast.StmtData (value: body))
        );
    }

    ast.AstId parse_init_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_init);
        Bool failable = self.match(.question);
        ast.AstId?! name = null;
        if (self.can_start_name() && token_is(self.peek_next(), .left_paren)) {
            name = self.parse_name();
        }
        self.expect(.left_paren);
        ast.AstRange params = self.parse_param_list_until(.right_paren);
        self.expect(.right_paren);
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .init_decl(ast.InitData (
                failable: failable,
                name: name,
                params: params,
                body: body
            ))
        );
    }

    ast.AstId parse_assoc_type_impl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_associated);
        ast.AstId name = self.parse_path();
        self.expect(.assign);
        ast.AstId value = self.parse_type();
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .assoc_type(ast.AssocTypeData (
                name: name,
                value: value,
                constraints: self.empty_range()
            ))
        );
    }

    ast.AstId parse_enum_case(self) {
        ast.AstId name = self.parse_name();
        ast.AstId?! value = null;
        if (self.match(.assign)) { value = self.parse_expr(); }
        return self.node_from_child(name, .enum_case(ast.EnumCaseData (name: name, value: value)));
    }

    ast.AstId? parse_enum_member(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.member_declaration);
        }
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_nominal_member(modifiers) is .some(member)) { return member; }
        if (self.parse_static_or_method_member(modifiers) is .some(method)) { return method; }
        return null;
    }

    ast.AstId? parse_union_member(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.member_declaration);
        }
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_nominal_member(modifiers) is .some(member)) { return member; }
        if (self.parse_static_or_method_member(modifiers) is .some(method)) { return method; }
        return self.parse_typed_union_variants();
    }

    Bool can_start_nominal_decl(self) {
        self.check_keyword(.kw_struct)
            || self.check_keyword(.kw_enum)
            || self.check_keyword(.kw_union)
    }

    ast.AstId? parse_nominal_member(self, ast.MemberModifiers modifiers) {
        if (!self.can_start_nominal_decl()) { return null; }
        guard self.parse_nominal_decl() is .some(nominal) else { return null; }
        return self.member_decl_node(
            self.unit.get(nominal).span,
            modifiers,
            self.empty_range(),
            nominal
        );
    }

    ast.AstId? parse_static_or_method_member(self, ast.MemberModifiers modifiers) {
        if (!self.looks_like_function_decl()) { return null; }
        if (self.parse_function_decl() is .some(method)) {
            ast.MemberModifiers effective_modifiers = ast.MemberModifiers (
                visibility: modifiers.visibility,
                static_flag: modifiers.static_flag
            );
            return self.member_decl_node(self.unit.get(method).span, effective_modifiers, self.empty_range(), method);
        }
        return null;
    }

    ast.AstId? parse_typed_union_variants(self) {
        ParserMark mark = self.mark();
        ast.AstId type_ref = self.parse_type();
        if (!self.can_start_variant_name()) {
            self.reset(mark);
            return null;
        }
        ast.AstId first_name = self.parse_variant_name();
        if (self.check(.comma) || self.check(.semicolon)) {
            return self.finish_typed_union_variants(type_ref, first_name);
        }
        self.reset(mark);
        return null;
    }

    ast.AstId finish_typed_union_variants(self, ast.AstId type_ref, ast.AstId first_name) {
        Int name_start = self.temp.len();
        self.temp.add(first_name);
        while (self.match(.comma)) {
            if (self.check(.semicolon)) { break; }
            self.temp.add(self.parse_variant_name());
        }
        self.expect(.semicolon);
        ast.AstRange names = self.take_children(name_start);
        return self.node_from_range(
            type_ref,
            names,
            .typed_union_variants(ast.TypedUnionVariantsData (
                type_ref: type_ref,
                names: names
            ))
        );
    }

    ast.AstId parse_variant_name(self) {
        return self.parse_name();
    }

    Bool can_start_variant_name(self) {
        return self.can_start_name();
    }

    ast.AstId? parse_trait_member(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.member_declaration);
        }
        std.jiang.Token start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId?! body = null;
        if (self.check_keyword(.kw_associated)) {
            body = self.parse_associated_type_decl();
        } else {
            body = self.parse_function_decl();
        }
        guard body is .some(parsed) else { return null; }
        ast.AstRange annotations = self.take_children(annotation_start);
        ast.MemberModifiers effective_modifiers = ast.MemberModifiers(
            visibility: modifiers.visibility,
            static_flag: modifiers.static_flag
        );
        return self.member_decl_node(
            self.span_from(start.span, self.unit.get(parsed).span),
            effective_modifiers,
            annotations,
            parsed
        );
    }

    ast.AstId parse_associated_type_decl(self) {
        std.jiang.Token start = self.expect_keyword(.kw_associated);
        ast.AstId name = self.parse_name();
        Int constraint_start = self.temp.len();
        if (self.match(.colon)) {
            self.temp.add(self.parse_type_bound());
        }
        std.jiang.Token end = self.expect(.semicolon);
        ast.AstRange constraints = self.take_children(constraint_start);
        return self.node(
            self.span_from(start.span, end.span),
            .assoc_type(ast.AssocTypeData (
                name: name,
                value: null,
                constraints: constraints
            ))
        );
    }

    ast.AstId? parse_extend_member(self) {
        if (self.check_keyword(.kw_associated)) { return self.parse_assoc_type_impl(); }
        return self.parse_member_decl();
    }

    ast.AstRange parse_param_list_until(self, std.jiang.TokenTag end_kind) {
        Int param_start = self.temp.len();
        if (!self.check(end_kind)) {
            self.temp.add(self.parse_param());
            while (self.match(.comma)) {
                if (self.check(end_kind)) { break; }
                self.temp.add(self.parse_param());
            }
        }
        return self.take_children(param_start);
    }

    ast.AstId parse_param(self) {
        Bool is_unique = self.parse_param_unique_modifier();
        if (self.match_keyword(.kw_self)) {
            std.jiang.Token self_token = self.previous();
            ast.AstId name = self.name_node_from_token(self_token);
            return self.node(
                self_token.span,
                .param(ast.ParamData (
                    type_ref: self.unit_node(self_token.span),
                    name: name,
                    default_value: null,
                    receiver_mode: ast.SelfReceiverMode.ref_receiver,
                    is_unique: is_unique
                ))
            );
        }
        ast.AstId type_ref = self.parse_type();
        ast.AstId name = self.parse_name();
        ast.AstId?! default_value = null;
        if (self.match(.assign)) { default_value = self.parse_expr(); }
        std.jiang.syntax.Span! end = self.unit.get(name).span;
        if (default_value is .some(value)) { end = self.unit.get(value).span; }
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end),
            .param(ast.ParamData (
                type_ref: type_ref,
                name: name,
                default_value: default_value,
                is_unique: is_unique
            ))
        );
    }

    Bool parse_param_unique_modifier(self) {
        if (!self.check_symbol_text("unique")) { return false; }
        self.advance();
        return true;
    }

    ast.AstId parse_type_bound(self) {
        ast.AstId! left = self.parse_trait_bound();
        while (self.match(.amp)) {
            ast.AstId right = self.parse_trait_bound();
            left = self.node_from_children(
                left,
                right,
                .type_bound_intersection(ast.TypeBoundIntersectionData (
                    left: left,
                    right: right
                ))
            );
        }
        return left;
    }

    ast.AstId parse_trait_bound(self) {
        Bool negative = self.match(.bang);
        ast.AstId path = self.parse_path();
        ast.AstRange args = self.parse_trait_bound_args_opt();
        return self.node_from_child(path, .trait_bound(ast.TraitBoundData (
            negative: negative,
            path: path,
            args: args
        )));
    }

    ast.AstRange parse_trait_bound_args_opt(self) {
        Int arg_start = self.temp.len();
        if (!self.match(.lt)) { return self.take_children(arg_start); }
        if (!self.check_type_arg_gt()) {
            self.parse_trait_bound_arg_list();
        }
        self.expect_type_arg_gt();
        return self.take_children(arg_start);
    }

    () parse_trait_bound_arg_list(self) {
        self.temp.add(self.parse_trait_bound_arg());
        while (self.match(.comma)) {
            if (self.check_type_arg_gt()) { return; }
            self.temp.add(self.parse_trait_bound_arg());
        }
    }

    ast.AstId parse_trait_bound_arg(self) {
        if (self.can_start_name() && token_is(self.peek_next(), .assign)) {
            ast.AstId name = self.parse_name();
            self.expect(.assign);
            ast.AstId value = self.parse_type();
            return self.node_from_children(
                name,
                value,
                .assoc_type_binding(ast.AssocTypeBindingData (name: name, value: value))
            );
        }
        return self.parse_type();
    }

    ast.AstId parse_type(self) {
        return self.parse_type_impl(true);
    }

    ast.AstId parse_ambiguous_stmt_type(self) {
        // block 里的声明和表达式共享起点；这里不能把 `??` 直接当作
        // optional 后缀消费，否则 `value ?? fallback;` 会被 var-decl probe
        // 误解析成 `value?? fallback;`。声明恢复点会在看到 decl name 后
        // 再把 `??` 补成两层 optional。
        return self.parse_type_impl(false);
    }

    ast.AstId parse_type_impl(self, Bool recover_double_question) {
        ast.AstId! result = self.parse_type_primary();
        Bool! seen_mutable = false;
        while (true) {
            if (recover_double_question && seen_mutable && self.match_type_postfix(.question_question)) {
                self.add_optional_after_mutable_type_error();
                continue;
            }
            if (recover_double_question && self.match_type_postfix(.question_question)) {
                result = self.type_layer_node(result, .optional);
                result = self.type_layer_node(result, .optional);
                continue;
            }
            if (seen_mutable && self.match_type_postfix(.question)) {
                self.add_optional_after_mutable_type_error();
                continue;
            }
            if (self.match_type_postfix(.question)) {
                result = self.type_layer_node(result, .optional);
                continue;
            }
            if (seen_mutable && self.match_type_postfix(.bang)) {
                self.add_repeated_mutable_type_error();
                continue;
            }
            if (self.match_type_postfix(.bang)) {
                seen_mutable = true;
                result = self.type_layer_node(result, .mutable_type);
                continue;
            }
            if (self.match_type_postfix(.amp)) {
                result = self.type_layer_node(result, .reference);
                // `&`/`^`/`*`/`[]` 会创建新的外层 type layer；前一层已经
                // 看到的 `?`/`!` 不能影响新外层的后缀检查。
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.caret)) {
                result = self.type_layer_node(result, .owner_pointer);
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.star)) {
                result = self.type_layer_node(result, .raw_pointer);
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.left_bracket)) {
                result = self.finish_type_bracket(result);
                seen_mutable = false;
                continue;
            }
            break;
        }
        return result;
    }

    ast.EffectSet parse_effect_set(self) {
        return self.parse_ordered_effect_keywords();
    }

    ast.EffectSet parse_ordered_effect_keywords(self) {
        ast.EffectSet! effects = ast.EffectSet();
        if (self.match_keyword(.kw_unsafe)) {
            effects = ast.EffectSet(has_unsafe: true);
        }
        if (self.match_keyword(.kw_async)) {
            effects = self.finish_async_effect(effects);
        } else if (self.match_keyword(.kw_sync)) {
            effects = self.finish_sync_effect(effects);
        }
        if (self.match_keyword(.kw_unsafe)) {
            self.add_parse_error_message(
                self.previous().span,
                "effect_keyword_order",
                "unsafe effect must appear before async or sync"
            );
            effects = ast.EffectSet(
                has_unsafe: true,
                has_async: effects.has_async,
                domain: effects.domain,
                context: effects.context
            );
        }
        return effects;
    }

    () add_optional_after_mutable_type_error(self) {
        self.add_type_postfix_error(
            "optional_after_mutable_type",
            "optional suffix cannot follow mutable suffix",
            "put ? before !, for example Int?!"
        );
    }

    () add_repeated_mutable_type_error(self) {
        self.add_type_postfix_error(
            "repeated_mutable_type",
            "mutable suffix cannot be repeated",
            "remove the extra !"
        );
    }

    () add_type_postfix_error(self, UInt8[]& code, UInt8[]& message, UInt8[]& help) {
        std.jiang.Token actual = self.previous();
        self.add_parse_error_message(actual.span, code, message);
    }

    ast.AstId parse_result_type(self) {
        ast.AstId value_type = self.parse_type();
        if (!self.match_type_postfix(.at)) { return value_type; }
        ast.AstId error_type = self.parse_type();
        ast.ErrorableTypeData data = ast.ErrorableTypeData (
            value_type: value_type,
            error_type: error_type
        );
        return self.node_from_children(
            value_type,
            error_type,
            .errorable_type(data)
        );
    }

    Bool match_type_postfix(self, std.jiang.TokenTag kind) {
        if (!self.check(kind)) { return false; }
        self.reject_spacing();
        self.advance();
        return true;
    }

    ast.AstId type_layer_node(self, ast.AstId base, ast.TypeLayerKind layer) {
        return self.type_layer_node_with_sentinel(base, layer, ast.TypeSentinelKind.none, std.jiang.syntax.Span(), null);
    }

    ast.AstId type_layer_node_with_sentinel(self,
        ast.AstId base,
        ast.TypeLayerKind layer,
        ast.TypeSentinelKind sentinel_kind,
        std.jiang.syntax.Span sentinel_span,
        qid.SymbolId? sentinel_symbol_id
    ) {
        return self.node_from_child(base, .type_ref(ast.TypeData (
            base: base,
            layer: layer,
            sentinel_kind: sentinel_kind,
            sentinel_span: sentinel_span,
            sentinel_symbol_id: sentinel_symbol_id
        )));
    }

    ast.SentinelTypeSyntax parse_sentinel_type_syntax(self) {
        if (self.check(.ident)) {
            std.jiang.Token sentinel_name = self.advance();
            return ast.SentinelTypeSyntax (
                kind: ast.TypeSentinelKind.const_name,
                span: sentinel_name.span,
                symbol_id: self.token_symbol_id(sentinel_name)
            );
        }
        std.jiang.Token sentinel = self.expect(.int_lit);
        return ast.SentinelTypeSyntax (
            kind: ast.TypeSentinelKind.value,
            span: sentinel.span,
            symbol_id: self.token_symbol_id(sentinel)
        );
    }

    ast.AstId finish_type_bracket(self, ast.AstId element) {
        if (self.match(.right_bracket)) {
            return self.type_layer_node(element, .slice);
        }
        if (self.match(.star)) {
            if (self.match(.colon)) {
                ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
                self.expect(.right_bracket);
                return self.type_layer_node_with_sentinel(
                    element,
                    .many_pointer,
                    sentinel.kind,
                    sentinel.span,
                    sentinel.symbol_id
                );
            }
            self.expect(.right_bracket);
            return self.type_layer_node(element, .many_pointer);
        }
        if (self.match(.colon)) {
            ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
            self.expect(.right_bracket);
            return self.type_layer_node_with_sentinel(
                element,
                .slice,
                sentinel.kind,
                sentinel.span,
                sentinel.symbol_id
            );
        }
        return self.finish_array_type(element);
    }

    ast.AstId finish_array_type(self, ast.AstId element) {
        ast.ArrayCountKind! kind = ast.ArrayCountKind.int_lit;
        std.jiang.syntax.Span! count_span = self.peek().span;
        qid.SymbolId?! count_symbol_id = null;
        if (self.check(.underscore)) {
            kind = ast.ArrayCountKind.inferred;
            std.jiang.Token count = self.advance();
            count_span = count.span;
        } else if (self.check(.ident)) {
            kind = ast.ArrayCountKind.const_name;
            std.jiang.Token count = self.advance();
            count_span = count.span;
            count_symbol_id = self.token_symbol_id(count);
        } else {
            std.jiang.Token count = self.expect(.int_lit);
            count_span = count.span;
            count_symbol_id = self.token_symbol_id(count);
        }
        ast.TypeSentinelKind! sentinel_kind = ast.TypeSentinelKind.none;
        std.jiang.syntax.Span! sentinel_span = std.jiang.syntax.Span();
        qid.SymbolId?! sentinel_symbol_id = null;
        if (self.match(.colon)) {
            ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
            sentinel_kind = sentinel.kind;
            sentinel_span = sentinel.span;
            sentinel_symbol_id = sentinel.symbol_id;
        }
        self.expect(.right_bracket);
        return self.node_from_child(
            element,
            .array_type(ast.ArrayTypeData (
                element: element,
                count_kind: kind,
                count_span: count_span,
                count_symbol_id: count_symbol_id,
                sentinel_kind: sentinel_kind,
                sentinel_span: sentinel_span,
                sentinel_symbol_id: sentinel_symbol_id
            ))
        );
    }

    qid.SymbolId? token_symbol_id(self, std.jiang.Token value) {
        return self.token_symbol(value);
    }

    ast.AstId parse_type_primary(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.type_reference);
        }
        if (self.match(.left_paren)) {
            return self.parse_paren_type(self.previous());
        }
        return self.parse_named_or_infer_type_primary();
    }

    ast.AstId parse_named_or_infer_type_primary(self) {
        if (self.check(.underscore)) {
            std.jiang.Token current_token = self.advance();
            return self.node(current_token.span, .infer_type);
        }
        if (self.check(.ident)) {
            ast.AstId path = self.parse_path();
            ast.AstRange! args = self.empty_range();
            if (self.check(.lt)) { args = self.parse_type_args(); }
            return self.node_from_child(path, .named_type(ast.NamedTypeData (path: path, args: args)));
        }
        if (self.match_keyword(.kw_self_type)) {
            ast.AstId name = self.name_node_from_token(self.previous());
            ast.AstId path = self.node_from_child(name, .path(ast.PathData (segments: self.unit.add_child(name))));
            return self.node_from_child(path, .named_type(ast.NamedTypeData (path: path, args: self.empty_range())));
        }
        self.error_at_current_kind("expected_type");
        std.jiang.Token current_token = self.advance();
        return self.unit_node(current_token.span);
    }

    ast.AstId parse_paren_type(self, std.jiang.Token start) {
        if (self.match(.right_paren)) {
            return self.node(self.span_from(start.span, self.previous().span), .unit_type);
        }
        ast.AstId first = self.parse_type();
        if (!self.match(.comma)) {
            self.expect(.right_paren);
            return first;
        }
        return self.finish_tuple_type(start, first);
    }

    ast.AstId finish_tuple_type(self, std.jiang.Token start, ast.AstId first) {
        Int item_start = self.temp.len();
        self.temp.add(first);
        if (self.check(.right_paren)) {
            self.error_at_current_kind("expected_type");
        } else {
            self.temp.add(self.parse_type());
            self.parse_remaining_tuple_types();
        }
        std.jiang.Token end = self.expect(.right_paren);
        ast.AstRange items = self.take_children(item_start);
        return self.node(self.span_from(start.span, end.span), .tuple_type(items));
    }

    () parse_remaining_tuple_types(self) {
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { return; }
            self.temp.add(self.parse_type());
        }
    }

    ast.AstRange parse_type_args(self) {
        self.expect(.lt);
        Int arg_start = self.temp.len();
        if (!self.check_type_arg_gt()) {
            self.temp.add(self.parse_generic_arg());
            while (self.match(.comma)) {
                if (self.check_type_arg_gt()) { break; }
                self.temp.add(self.parse_generic_arg());
            }
        }
        self.expect_type_arg_gt();
        return self.take_children(arg_start);
    }

    ast.AstId parse_generic_arg(self) {
        ast.EffectSet effects = self.parse_effect_set();
        if (self.generic_arg_starts_value()) {
            if (!effects.is_empty()) {
                self.add_parse_error_message(
                    self.previous().span,
                    "effect_requires_type",
                    "effect prefix requires a type"
                );
            }
            return self.parse_primary_expr(false);
        }
        ast.AstId result = self.parse_result_type();
        if (!effects.is_empty()) {
            return self.node_from_child(result, .effect_type(ast.EffectTypeData(base: result, effects: effects)));
        }
        return result;
    }

    Bool generic_arg_starts_value(self) {
        if (self.check(.int_lit)) { return true; }
        if (self.check(.float_lit)) { return true; }
        if (self.check(.char_lit)) { return true; }
        if (self.check(.string_lit)) { return true; }
        if (self.check_keyword(.kw_true)) { return true; }
        return self.check_keyword(.kw_false);
    }

    ast.AstId parse_block(self) {
        return self.parse_block_with_effects(ast.EffectSet());
    }

    ast.AstId parse_effect_block(self) {
        ast.EffectSet effects = self.parse_ordered_effect_keywords();
        return self.parse_block_with_effects(effects);
    }

    ast.AstId parse_do_block(self) {
        self.expect_keyword(.kw_do);
        ast.EffectSet effects = self.parse_do_effect_options();
        return self.parse_block_with_effects(effects);
    }

    ast.EffectSet parse_do_effect_options(self) {
        ast.EffectSet! effects = ast.EffectSet();
        self.expect(.left_bracket);
        while (!self.at_end() && !self.check(.right_bracket)) {
            effects = self.parse_do_effect_option(effects);
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return effects;
    }

    ast.EffectSet parse_do_effect_option(self, ast.EffectSet effects) {
        if (self.check_keyword(.kw_unsafe)) {
            return self.parse_unsafe_do_effect_option(effects);
        }
        if (self.check_keyword(.kw_async)) {
            return self.parse_async_do_effect_option(effects);
        }
        if (self.check_keyword(.kw_sync)) {
            return self.parse_sync_do_effect_option(effects);
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_do_effect_option",
            "expected do effect option: unsafe, async, or sync"
        );
        if (self.at_end() || self.check(.right_bracket)) {
            return effects;
        }
        self.advance();
        return effects;
    }

    ast.EffectSet parse_unsafe_do_effect_option(self, ast.EffectSet effects) {
        std.jiang.Token option = self.expect_keyword(.kw_unsafe);
        if (effects.has_unsafe) {
            self.add_parse_error_message(
                option.span,
                "duplicate_do_effect_option",
                "duplicate do effect option: unsafe"
            );
        }
        return ast.EffectSet(
            has_unsafe: true,
            has_async: effects.has_async,
            domain: effects.domain,
            context: effects.context
        );
    }

    ast.EffectSet parse_async_do_effect_option(self, ast.EffectSet effects) {
        std.jiang.Token option = self.expect_keyword(.kw_async);
        if (effects.has_async) {
            self.add_parse_error_message(
                option.span,
                "duplicate_do_effect_option",
                "duplicate do effect option: async"
            );
        }
        return self.finish_async_effect(effects);
    }

    ast.EffectSet parse_sync_do_effect_option(self, ast.EffectSet effects) {
        self.expect_keyword(.kw_sync);
        return self.finish_sync_effect(effects);
    }

    ast.EffectSet finish_async_effect(self, ast.EffectSet effects) {
        ast.EffectSet! result = ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: true,
            domain: effects.domain,
            context: effects.context
        );
        if (self.match(.left_bracket)) {
            result = self.parse_async_effect_options(result);
        }
        return result;
    }

    ast.EffectSet finish_sync_effect(self, ast.EffectSet effects) {
        ast.EffectSet! result = ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: effects.domain,
            context: effects.context
        );
        if (self.match(.left_bracket)) {
            result = self.parse_sync_effect_options(result);
        } else {
            self.add_parse_error_message(
                self.previous().span,
                "sync_effect_requires_options",
                "sync effect requires domain options"
            );
        }
        return result;
    }

    ast.EffectSet parse_sync_effect_options(self, ast.EffectSet effects) {
        Int! positional = 0;
        ast.EffectSet! result = effects;
        while (!self.at_end() && !self.check(.right_bracket)) {
            result = self.parse_sync_effect_option(result, positional);
            positional = positional + 1;
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return result;
    }

    ast.EffectSet parse_sync_effect_option(self, ast.EffectSet effects, Int positional) {
        if (self.check_effect_option_key("domain")) {
            self.advance();
            self.expect(.colon);
            return self.set_sync_effect_domain(effects, self.parse_primary_expr(false));
        }
        if (self.check(.ident) && token_is(self.peek_next(), .colon)) {
            self.add_parse_error_message(
                self.peek().span,
                "unknown_sync_effect_option",
                "unknown sync effect option"
            );
            self.advance();
            self.expect(.colon);
            self.parse_primary_expr(false);
            return effects;
        }
        if (positional == 0) {
            return self.set_sync_effect_domain(effects, self.parse_primary_expr(false));
        }
        self.add_parse_error_message(
            self.peek().span,
            "too_many_sync_effect_options",
            "too many sync effect options"
        );
        if (!self.at_end() && !self.check(.right_bracket)) {
            self.parse_primary_expr(false);
        }
        return effects;
    }

    ast.EffectSet parse_async_effect_options(self, ast.EffectSet effects) {
        Int! positional = 0;
        ast.EffectSet! result = effects;
        while (!self.at_end() && !self.check(.right_bracket)) {
            result = self.parse_async_effect_option(result, positional);
            positional = positional + 1;
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return result;
    }

    ast.EffectSet parse_async_effect_option(self, ast.EffectSet effects, Int positional) {
        if (self.check_effect_option_key("domain")) {
            self.advance();
            self.expect(.colon);
            return self.set_async_effect_domain(effects, self.parse_primary_expr(false));
        }
        if (self.check_effect_option_key("context")) {
            self.advance();
            self.expect(.colon);
            return self.set_async_effect_context(effects, self.parse_primary_expr(false));
        }
        if (self.check(.ident) && token_is(self.peek_next(), .colon)) {
            self.add_parse_error_message(
                self.peek().span,
                "unknown_async_effect_option",
                "unknown async effect option"
            );
            self.advance();
            self.expect(.colon);
            self.parse_primary_expr(false);
            return effects;
        }
        if (positional == 0) {
            return self.set_async_effect_domain(effects, self.parse_primary_expr(false));
        }
        if (positional == 1) {
            return self.set_async_effect_context(effects, self.parse_primary_expr(false));
        }
        self.add_parse_error_message(
            self.peek().span,
            "too_many_async_effect_options",
            "too many async effect options"
        );
        if (!self.at_end() && !self.check(.right_bracket)) {
            self.parse_primary_expr(false);
        }
        return effects;
    }

    Bool check_effect_option_key(self, UInt8[]& name) {
        return self.check_symbol_text(name) && token_is(self.peek_next(), .colon);
    }

    ast.EffectSet set_async_effect_domain(self, ast.EffectSet effects, ast.AstId domain) {
        if (effects.domain != null) {
            self.add_parse_error_message(
                self.unit.get(domain).span,
                "duplicate_async_effect_domain",
                "duplicate async effect domain"
            );
        }
        return ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: domain,
            context: effects.context
        );
    }

    ast.EffectSet set_async_effect_context(self, ast.EffectSet effects, ast.AstId context) {
        if (effects.context != null) {
            self.add_parse_error_message(
                self.unit.get(context).span,
                "duplicate_async_effect_context",
                "duplicate async effect context"
            );
        }
        return ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: effects.domain,
            context: context
        );
    }

    ast.EffectSet set_sync_effect_domain(self, ast.EffectSet effects, ast.AstId domain) {
        if (effects.domain != null) {
            self.add_parse_error_message(
                self.unit.get(domain).span,
                "duplicate_sync_effect_domain",
                "duplicate sync effect domain"
            );
        }
        return ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: domain,
            context: effects.context
        );
    }

    ast.AstId parse_block_with_effects(self, ast.EffectSet effects) {
        std.jiang.Token start = self.expect(.left_brace);
        Int stmt_start = self.temp.len();
        ast.AstId?! tail_expr = null;
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.current_starts_statement_only()) {
                if (self.parse_stmt() is .some(parsed)) {
                    self.temp.add(parsed);
                } else {
                    self.recover_stmt();
                }
                continue;
            }
            // grammar 规定 block 的值只来自最后一个不带分号的 tail_expr；
            // 普通 stmt 不贡献 block value。
            ParserMark tail_mark = self.mark();
            ast.AstId tail = self.parse_expr();
            if (self.check(.right_brace)) {
                tail_expr = tail;
                break;
            }
            self.reset(tail_mark);

            ast.AstId? stmt = self.parse_stmt();
            if (stmt is .some(parsed)) {
                self.temp.add(parsed);
            } else {
                self.recover_stmt();
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange statements = self.take_children(stmt_start);
        return self.node(
            self.span_from(start.span, end.span),
            .block(ast.BlockData (effects: effects, statements: statements, tail_expr: tail_expr))
        );
    }

    Bool current_starts_statement_only(self) {
        if (self.check_keyword(.kw_return)) { return true; }
        if (self.check_keyword(.kw_throw)) { return true; }
        if (self.check_keyword(.kw_break)) { return true; }
        if (self.check_keyword(.kw_continue)) { return true; }
        if (self.check_keyword(.kw_defer)) { return true; }
        if (self.check_keyword(.kw_guard)) { return true; }
        if (self.check_keyword(.kw_while)) { return true; }
        return self.check_keyword(.kw_for);
    }

    ast.AstId? parse_stmt(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_stmt();
        }
        if (self.check_keyword(.kw_return)) {
            return self.parse_control_stmt(ast.ControlStmtKind.return_value);
        }
        if (self.check_keyword(.kw_throw)) {
            return self.parse_control_stmt(ast.ControlStmtKind.throw_value);
        }
        if (self.check_keyword(.kw_break)) {
            return self.parse_control_stmt(ast.ControlStmtKind.break_loop);
        }
        if (self.check_keyword(.kw_continue)) {
            return self.parse_control_stmt(ast.ControlStmtKind.continue_loop);
        }
        if (self.check_keyword(.kw_defer)) { return self.parse_defer_stmt(); }
        if (self.check(.left_brace)) { return self.parse_block(); }
        if (self.effect_block_starts()) { return self.parse_effect_block(); }
        if (self.check_keyword(.kw_guard)) { return self.parse_guard_stmt(); }
        if (self.check_keyword(.kw_while)) { return self.parse_while_stmt(); }
        if (self.check_keyword(.kw_for)) { return self.parse_for_stmt(); }
        if (self.check(.left_paren)) {
            ParserMark mark = self.mark();
            ast.AstId? destructure = self.parse_destructure_stmt();
            if (destructure != null) { return destructure; }
            self.reset(mark);
        }
        ParserMark mark = self.mark();
        ast.AstId? var_decl = self.parse_var_decl_stmt();
        if (var_decl != null) { return var_decl; }
        self.reset(mark);
        ast.AstId expr = self.parse_expr();
        if (self.assign_op_from_current() is .some(op)) {
            self.advance();
            ast.AstId value = self.parse_expr();
            std.jiang.Token end = self.expect(.semicolon);
            return self.node(
                self.span_from(self.unit.get(expr).span, end.span),
                .assign_stmt(ast.AssignData (op: op, target: expr, value: value))
            );
        }
        if (self.match(.semicolon)) {
            if (!self.expr_is_call_stmt(expr)) {
                self.error_at_span("expected_statement", self.unit.get(expr).span);
            }
            return self.node(
                self.span_from(self.unit.get(expr).span, self.previous().span),
                .stmt(ast.StmtData (value: expr))
            );
        }
        if (self.expr_can_stand_as_stmt(expr)) {
            return expr;
        }
        return null;
    }

    ast.AstId parse_lang_block_stmt(self) {
        ast.AstId parsed = self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.statement);
        if (!self.expr_can_stand_as_stmt(parsed)) { return parsed; }
        return self.node(self.unit.get(parsed).span, .stmt(ast.StmtData(value: parsed)));
    }

    Bool expr_is_call_stmt(self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        if (expr.data is .call(_)) { return true; }
        if (expr.data is .type_implicit_call(_)) { return true; }
        return expr.data is .implicit_call(_);
    }

    Bool expr_can_stand_as_stmt(self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        if (expr.data is .block(_)) { return true; }
        if (expr.data is .if_expr(_)) { return true; }
        if (expr.data is .inline_asm(_)) { return true; }
        return expr.data is .switch_expr(_);
    }


    ast.AstId parse_control_stmt(self, ast.ControlStmtKind kind) {
        std.jiang.Token start = self.advance();
        ast.AstId?! value = null;
        if (kind == ast.ControlStmtKind.return_value) {
            if (!self.check(.semicolon)) { value = self.parse_expr(); }
        } else if (kind == ast.ControlStmtKind.throw_value) {
            value = self.parse_expr();
        }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .control_stmt(ast.ControlStmtData (kind: kind, value: value))
        );
    }

    ast.AstId parse_defer_stmt(self) {
        std.jiang.Token start = self.expect_keyword(.kw_defer);
        ast.AstId! value = self.unit_node(start.span);
        std.jiang.syntax.Span! end = start.span;
        if (self.check(.left_brace)) {
            value = self.parse_block();
            end = self.unit.get(value).span;
        } else {
            value = self.parse_expr();
            std.jiang.Token semicolon = self.expect(.semicolon);
            end = semicolon.span;
        }
        return self.node(self.span_from(start.span, end), .defer_stmt(ast.StmtData (value: value)));
    }

    ast.AstId parse_guard_stmt(self) {
        std.jiang.Token start = self.expect_keyword(.kw_guard);
        ast.AstId condition = self.parse_condition_list_without_block();
        self.expect_keyword(.kw_else);
        ast.AstId else_body = self.parse_block();
        if (!self.guard_else_body_exits(else_body)) {
            self.error_at_span("expected_guard_exit", self.unit.get(else_body).span);
        }
        return self.node(
            self.span_from(start.span, self.unit.get(else_body).span),
            .guard_stmt(ast.GuardData (condition: condition, else_body: else_body))
        );
    }

    Bool guard_else_body_exits(self, ast.AstId else_body) {
        ast.AstNode body = self.unit.get(else_body);
        if (body.data is .block(block_data)) {
            if (block_data.tail_expr != null) {
                return false;
            }
            if (block_data.statements.is_empty()) {
                return false;
            }
            ast.AstId last_stmt = self.unit.child_at(
                block_data.statements,
                block_data.statements.length - 1
            );
            ast.AstNode last = self.unit.get(last_stmt);
            if (last.data is .control_stmt(control_stmt)) {
                return true;
            }
        }
        return false;
    }

    ast.AstId? parse_var_decl_stmt(self) {
        if (self.parse_ref_var_decl_stmt() is .some(ref_decl)) {
            return ref_decl;
        }
        if (self.check(.underscore)) {
            return self.parse_inferred_var_decl_stmt();
        }
        if (!self.can_start_type()) { return null; }
        ast.AstId type_ref = self.parse_ambiguous_stmt_type();
        if (self.match(.question_question)) {
            ast.AstId nested_type_ref = self.double_optional_type_ref(type_ref);
            if (self.can_start_decl_name() || self.current_token_is_reserved_keyword()) {
                return self.finish_var_decl_stmt(nested_type_ref, BindingMode(false, false));
            }
            self.error_at_current("expected_decl_name", .ident);
            return self.finish_var_decl_stmt(nested_type_ref, BindingMode(false, false));
        }
        if (!self.can_start_decl_name()) {
            if (self.current_token_is_reserved_keyword()) {
                return self.finish_var_decl_stmt(type_ref, BindingMode(false, false));
            }
            return null;
        }
        return self.finish_var_decl_stmt(type_ref, BindingMode(false, false));
    }

    ast.AstId? parse_ref_var_decl_stmt(self) {
        if (!self.check_ref_binding_mode()) { return null; }
        BindingMode mode = self.parse_ref_binding_mode();
        BindingType binding_type = self.parse_binding_type(mode);
        return self.finish_var_decl_stmt(binding_type.type_ref, binding_type.mode);
    }

    ast.AstId double_optional_type_ref(self, ast.AstId type_ref) {
        return self.type_layer_node(self.type_layer_node(type_ref, .optional), .optional);
    }

    ast.AstId finish_var_decl_stmt(self, ast.AstId type_ref, BindingMode mode) {
        ast.AstId name = self.parse_decl_name();
        ast.AstId?! initializer = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .let_stmt(ast.LetData (
                type_ref: type_ref,
                name: name,
                initializer: initializer,
                mutable_binding: mode.mutable_binding,
                borrow_binding: mode.borrow_binding
            ))
        );
    }

    ast.AstId parse_inferred_var_decl_stmt(self) {
        std.jiang.syntax.Span start = self.peek().span;
        ast.AstId type_ref = self.node(start, .infer_type);
        ast.InferredBinding parsed = self.parse_inferred_binding();
        ast.AstId?! initializer = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token end = self.expect(.semicolon);
        return self.node(
            self.span_from(start, end.span),
            .let_stmt(ast.LetData (
                type_ref: type_ref,
                name: parsed.name,
                initializer: initializer,
                mutable_binding: parsed.mutable_binding,
                borrow_binding: parsed.borrow_binding
            ))
        );
    }

    ast.InferredBinding parse_inferred_binding(self) {
        self.advance();
        Bool! mutable_binding = false;
        if (self.match(.bang)) {
            mutable_binding = true;
        }
        ast.AstId name = self.parse_name();
        return ast.InferredBinding (name: name, mutable_binding: mutable_binding, borrow_binding: false);
    }

    ast.AstId? parse_destructure_stmt(self) {
        std.jiang.Token start = self.expect(.left_paren);
        Int binding_start = self.temp.len();
        self.temp.add(self.parse_destructure_binding());
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { break; }
            self.temp.add(self.parse_destructure_binding());
        }
        self.expect(.right_paren);
        if (!self.match(.assign)) { return null; }
        ast.AstId initializer = self.parse_expr();
        std.jiang.Token end = self.expect(.semicolon);
        ast.AstRange bindings = self.take_children(binding_start);
        return self.node(
            self.span_from(start.span, end.span),
            .destructure_stmt(ast.GlobalDestructureData (
                bindings: bindings,
                initializer: initializer
            ))
        );
    }

    ast.AstId parse_while_stmt(self) {
        std.jiang.Token start = self.expect_keyword(.kw_while);
        ast.AstId cond = self.parse_condition_list_without_block();
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .loop_expr(ast.LoopData (
                condition: cond,
                pattern: null,
                iterable: null,
                body: body
            ))
        );
    }

    ast.AstId parse_for_stmt(self) {
        std.jiang.Token start = self.expect_keyword(.kw_for);
        ast.AstId pattern = self.parse_binding_pattern();
        self.expect_keyword(.kw_in);
        ast.AstId iterable = self.parse_expr_without_block();
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .loop_expr(ast.LoopData (
                condition: null,
                pattern: pattern,
                iterable: iterable,
                body: body
            ))
        );
    }

    ast.AstId parse_expr(self) {
        if (self.starts_lambda_expr()) {
            return self.parse_lambda_expr(true);
        }
        return self.parse_range_expr(true);
    }

    ast.AstId parse_expr_without_block(self) {
        if (self.starts_lambda_expr()) {
            return self.parse_lambda_expr(false);
        }
        return self.parse_range_expr(false);
    }

    ast.AstId parse_condition_list_without_block(self) {
        ast.AstId! condition = self.parse_expr_without_block();
        while (self.match(.comma)) {
            ast.AstId right = self.parse_expr_without_block();
            condition = self.node_from_children(
                condition,
                right,
                .binary(ast.BinaryData (op: ast.BinaryOp.logic_and, left: condition, right: right))
            );
        }
        return condition;
    }

    ast.AstId parse_range_expr(self, Bool allow_with_block) {
        ast.AstId left = self.parse_logic_or_expr(allow_with_block);
        if (self.match(.dot_dot)) {
            ast.AstId right = self.parse_logic_or_expr(allow_with_block);
            return self.node_from_children(left, right, .range(ast.RangeData (start: left, end: right)));
        }
        return left;
    }

    ast.AstId parse_logic_or_expr(self, Bool allow_with_block) {
        return self.parse_binary_left_assoc(1, allow_with_block);
    }

    ast.AstId parse_binary_left_assoc(self, Int min_prec, Bool allow_with_block) {
        ast.AstId! left = self.parse_unary_expr(allow_with_block);
        Bool! keep_going = true;
        while (keep_going) {
            if (self.check_keyword(.kw_is)) {
                Int is_prec = 4;
                if (is_prec < min_prec) { return left; }
                self.advance();
                ast.AstId pattern = self.parse_match_pattern();
                left = self.node_from_children(
                    left,
                    pattern,
                    .is_pattern(ast.IsPatternData (value: left, pattern: pattern))
                );
                continue;
            }
            ast.BinaryOp? op = self.binary_op_from_current();
            if (op == null) { return left; }
            Int prec = self.binary_precedence(op$.some());
            if (prec < min_prec) { return left; }
            self.advance();
            ast.AstId right = self.parse_binary_left_assoc(prec + 1, allow_with_block);
            left = self.node_from_children(
                left,
                right,
                .binary(ast.BinaryData (op: op$.some(), left: left, right: right))
            );
        }
        return left;
    }

    ast.AstId parse_unary_expr(self, Bool allow_with_block) {
        if (self.unary_op_from_current() is .some(op)) {
            std.jiang.Token start = self.advance();
            ast.AstId value = self.parse_unary_expr(allow_with_block);
            return self.node(
                self.span_from(start.span, self.unit.get(value).span),
                .unary(ast.UnaryData (op: op, value: value))
            );
        }
        if (self.match_keyword(.kw_new)) {
            if (self.check_new_interpolated_string()) {
                return self.new_interpolated_string_block(self.advance());
            }
            std.jiang.Token start = self.previous();
            ast.AstId! value = ast.AstId(0);
            if (self.starts_lambda_expr()) {
                value = self.parse_lambda_expr(allow_with_block);
            } else {
                value = self.parse_unary_expr(allow_with_block);
            }
            return self.node(
                self.span_from(start.span, self.unit.get(value).span),
                .unary(ast.UnaryData (op: ast.UnaryOp.new_value, value: value))
            );
        }
        return self.parse_postfix_expr(allow_with_block);
    }

    ast.AstId parse_postfix_expr(self, Bool allow_with_block) {
        ast.AstId! result = self.parse_primary_expr(allow_with_block);
        while (true) {
            if (self.check(.left_paren)) {
                ast.AstRange type_args = self.empty_range();
                ast.AstRange args = self.parse_call_parens();
                result = self.call_expr_node(result, type_args, args);
                continue;
            }
            if (self.check(.lt) && self.type_args_before_call()) {
                ast.AstRange type_args = self.parse_type_args();
                ast.AstRange args = self.parse_call_parens();
                result = self.call_expr_node(result, type_args, args);
                continue;
            }
            if (self.match(.dot)) {
                ast.AstId name = self.parse_member_name();
                result = self.field_expr_node(result, name, false);
                continue;
            }
            if (self.match(.question_dot)) {
                ast.AstId name = self.parse_member_name();
                result = self.field_expr_node(result, name, true);
                continue;
            }
            if (self.match(.left_bracket)) {
                result = self.finish_index_or_slice(result, false);
                continue;
            }
            if (self.match(.question)) {
                if (self.finish_question_postfix(result) is .some(postfix)) {
                    result = postfix;
                    continue;
                }
                break;
            }
            if (self.match(.dollar)) {
                if (self.type_ref_from_name_expr(result) is .some(type_ref)) {
                    result = self.finish_implicit_call_data(type_ref, false, true);
                    continue;
                }
                result = self.finish_implicit_call(result, false);
                continue;
            }
            break;
        }
        return result;
    }

    ast.AstId call_expr_node(self, ast.AstId callee, ast.AstRange type_args, ast.AstRange args) {
        return self.node_from_range(
            callee,
            args,
            .call(ast.CallData (callee: callee, type_args: type_args, args: args))
        );
    }

    ast.AstId field_expr_node(self, ast.AstId base, ast.AstId name, Bool optional_chain) {
        return self.node_from_children(
            base,
            name,
            .field_expr(ast.FieldExprData (
                base: base,
                name: name,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId? finish_question_postfix(self, ast.AstId base) {
        if (self.match(.dollar)) { return self.finish_implicit_call(base, true); }
        if (self.match(.left_bracket)) { return self.finish_index_or_slice(base, true); }
        return null;
    }

    ast.AstId finish_implicit_call(self, ast.AstId base, Bool optional_chain) {
        return self.finish_implicit_call_data(base, optional_chain, false);
    }

    ast.AstId? type_ref_from_name_expr(self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        guard expr.data is .name_expr(name_expr) else { return null; }
        ast.AstNode value = self.unit.get(name_expr.value);
        guard value.data is .path(path) else { return null; }
        if (!self.path_looks_like_type_name(path)) { return null; }
        return self.node_from_child(
            name_expr.value,
            .named_type(ast.NamedTypeData (path: name_expr.value, args: self.empty_range()))
        );
    }

    Bool path_looks_like_type_name(self, ast.PathData path) {
        if (path.segments.length == 0) { return false; }
        ast.AstId last = self.unit.child_at(path.segments, path.segments.length - 1);
        return self.name_starts_uppercase(last);
    }

    Bool name_starts_uppercase(self, ast.AstId name_id) {
        ast.AstNode name = self.unit.get(name_id);
        guard name.data is .name(name_data) else { return false; }
        guard name_data.symbol_id is .some(symbol) else { return false; }
        if (self.store.symbols.keyword(symbol) is .some(_)) { return false; }
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length == 0) { return false; }
        return text[0] >= UInt8(65) && text[0] <= UInt8(90);
    }

    ast.AstId finish_implicit_call_data(self, ast.AstId base, Bool optional_chain, Bool type_receiver) {
        self.expect(.dot);
        ast.AstId name = self.parse_member_name();
        self.expect(.left_paren);
        Int arg_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.temp.add(self.parse_implicit_arg());
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                self.temp.add(self.parse_implicit_arg());
            }
        }
        self.expect(.right_paren);
        ast.AstRange args = self.take_children(arg_start);
        ast.ImplicitCallData data = ast.ImplicitCallData (
            base: base,
            name: name,
            optional_chain: optional_chain,
            args: args
        );
        if (type_receiver) {
            return self.node_from_range(base, args, .type_implicit_call(data));
        }
        return self.node_from_range(
            base,
            args,
            .implicit_call(data)
        );
    }

    ast.AstId parse_implicit_arg(self) {
        if (self.starts_implicit_type_arg()) {
            ast.AstId type_arg = self.parse_type();
            return self.node_from_child(type_arg, .implicit_arg(.type_arg(type_arg)));
        }
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .implicit_arg(.value_arg(value)));
    }

    ast.AstId finish_index_or_slice(self, ast.AstId base, Bool optional_chain) {
        if (self.match(.dot_dot)) {
            ast.AstId?! end_expr = null;
            if (!self.check(.right_bracket)) { end_expr = self.parse_slice_bound_expr(); }
            self.expect(.right_bracket);
            return self.slice_expr_node(base, null, end_expr, optional_chain);
        }
        ast.AstId index = self.parse_slice_bound_expr();
        if (self.match(.dot_dot)) {
            ast.AstId?! end_expr = null;
            if (!self.check(.right_bracket)) { end_expr = self.parse_slice_bound_expr(); }
            self.expect(.right_bracket);
            return self.slice_expr_node(base, index, end_expr, optional_chain);
        }
        self.expect(.right_bracket);
        return self.index_expr_node(base, index, optional_chain);
    }

    Bool starts_lambda_expr(self) {
        if (!self.check(.left_paren)) { return false; }
        ParserMark mark = self.mark();
        Bool result = self.probe_lambda_expr();
        self.reset(mark);
        return result;
    }

    Bool probe_lambda_expr(self) {
        self.expect(.left_paren);
        if (!self.probe_lambda_param_list()) { return false; }
        if (!self.match(.right_paren)) { return false; }
        if (self.check(.fat_arrow)) { return true; }
        if (!self.check(.left_bracket)) { return false; }
        self.parse_lambda_capture_list();
        return self.check(.fat_arrow);
    }

    Bool probe_lambda_param_list(self) {
        if (self.check(.right_paren)) { return true; }
        if (!self.probe_lambda_param()) { return false; }
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { return true; }
            if (!self.probe_lambda_param()) { return false; }
        }
        return true;
    }

    Bool probe_lambda_param(self) {
        if (self.match(.underscore)) { return true; }
        if (!self.can_start_name()) { return false; }
        self.advance();
        return true;
    }

    ast.AstId parse_lambda_expr(self, Bool allow_with_block) {
        std.jiang.Token start = self.expect(.left_paren);
        ast.AstRange params = self.parse_lambda_param_list();
        self.expect(.right_paren);
        ast.AstRange! captures = self.empty_range();
        if (self.check(.left_bracket)) {
            captures = self.parse_lambda_capture_list();
        }
        self.expect(.fat_arrow);
        ast.AstId body = self.parse_lambda_body(allow_with_block);
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .lambda_expr(ast.LambdaData (params: params, captures: captures, body: body))
        );
    }

    ast.AstRange parse_lambda_param_list(self) {
        Int param_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.temp.add(self.parse_lambda_param());
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                self.temp.add(self.parse_lambda_param());
            }
        }
        return self.take_children(param_start);
    }

    ast.AstId parse_lambda_param(self) {
        if (self.match(.underscore)) {
            return self.node(self.previous().span, .lambda_param(ast.LambdaParamData (name: null)));
        }
        ast.AstId name = self.parse_name();
        return self.node_from_child(name, .lambda_param(ast.LambdaParamData (name: name)));
    }

    ast.AstRange parse_lambda_capture_list(self) {
        self.expect(.left_bracket);
        Int capture_start = self.temp.len();
        if (!self.check(.right_bracket)) {
            self.temp.add(self.parse_lambda_capture_item());
            while (self.match(.comma)) {
                if (self.check(.right_bracket)) { break; }
                self.temp.add(self.parse_lambda_capture_item());
            }
        }
        self.expect(.right_bracket);
        return self.take_children(capture_start);
    }

    ast.AstId parse_lambda_capture_item(self) {
        Bool is_unique = self.parse_param_unique_modifier();
        ast.AstId pattern_id = self.parse_binding_pattern();
        ast.AstNode pattern_node = self.unit.get(pattern_id);
        ast.AstId?! type_ref = null;
        ast.AstId! name = pattern_id;
        Bool! mutable_binding = false;
        Bool! borrow_binding = false;
        if (pattern_node.data is .pattern(pattern)) {
            type_ref = pattern.type_ref;
            mutable_binding = pattern.mutable_binding;
            borrow_binding = pattern.borrow_binding;
            if (pattern.name is .some(pattern_name)) {
                name = pattern_name;
            } else {
                self.error_at_span("capture_binding_requires_name", pattern_node.span);
                name = self.name_node_from_token(std.jiang.Token.missing(.ident, pattern_node.span));
            }
        }
        self.expect(.assign);
        ast.AstId value = self.parse_expr();
        return self.node_from_children(
            name,
            value,
            .lambda_capture_item(ast.LambdaCaptureItemData (
                type_ref: type_ref,
                name: name,
                value: value,
                mutable_binding: mutable_binding,
                borrow_binding: borrow_binding,
                is_unique: is_unique
            ))
        );
    }

    ast.AstId parse_lambda_body(self, Bool allow_with_block) {
        if (allow_with_block && self.check(.left_brace)) {
            return self.parse_block();
        }
        return self.parse_expr_without_block();
    }

    ast.AstId slice_expr_node(self,
        ast.AstId base,
        ast.AstId?! start,
        ast.AstId?! end,
        Bool optional_chain
    ) {
        return self.node_from_child(
            base,
            .slice_expr(ast.SliceExprData (
                base: base,
                start: start,
                end: end,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId index_expr_node(self, ast.AstId base, ast.AstId index, Bool optional_chain) {
        return self.node_from_children(
            base,
            index,
            .index_expr(ast.IndexExprData (
                base: base,
                index: index,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId parse_slice_bound_expr(self) {
        return self.parse_logic_or_expr(true);
    }

    ast.AstRange parse_call_parens(self) {
        self.expect(.left_paren);
        Int arg_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.temp.add(self.parse_call_arg());
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                self.temp.add(self.parse_call_arg());
            }
        }
        self.expect(.right_paren);
        return self.take_children(arg_start);
    }

    ast.AstId parse_call_arg(self) {
        ast.AstId?! label = null;
        if (self.can_start_name() && token_is(self.peek_next(), .colon)) {
            label = self.parse_name();
            self.expect(.colon);
        }
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .call_arg(ast.CallArgData (label: label, value: value)));
    }

    ast.AstId parse_primary_expr(self, Bool allow_with_block) {
        if (self.check(.int_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.int_lit); }
        if (self.check(.float_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.float_lit); }
        if (self.check(.char_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.char_lit); }
        if (self.check(.string_lit)) { return self.parse_string_literal_expr(); }
        if (self.match_keyword(.kw_true)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.bool_lit, bool_value: true, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_false)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.bool_lit, bool_value: false, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_null)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.null_lit, bool_value: false, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_self)) { return self.name_expr_from_token(self.previous()); }
        if (self.match(.dollar)) {
            ast.AstId value = self.unit_node(self.previous().span);
            return self.node(self.previous().span, .name_expr(ast.StmtData (value: value)));
        }
        if (self.match(.dot)) {
            if (self.check(.left_paren)) {
                return self.parse_expected_type_constructor_call(self.previous());
            }
            ast.AstId name = self.parse_name();
            ast.AstId base = self.unit_node(self.unit.get(name).span);
            return self.field_expr_node(base, name, false);
        }
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.expression);
        }
        if (self.starts_type_implicit_expr()) {
            return self.parse_type_implicit_call_expr();
        }
        if (self.starts_type_member_expr()) {
            return self.parse_type_member_expr();
        }
        if (self.check(.left_paren)) { return self.parse_paren_expr(); }
        if (self.check(.left_bracket)) { return self.parse_array_expr(); }
        if (allow_with_block && self.check(.left_brace)) { return self.parse_block(); }
        if (allow_with_block && self.effect_block_starts()) { return self.parse_effect_block(); }
        if (allow_with_block && self.do_block_starts()) { return self.parse_do_block(); }
        if (allow_with_block && self.check_keyword(.kw_if)) { return self.parse_if_expr(false); }
        if (allow_with_block && self.check_keyword(.kw_switch)) { return self.parse_switch_expr(false); }
        if (allow_with_block && self.check_keyword(.kw_try)) { return self.parse_try_catch_expr(); }
        if (self.can_start_name()) {
            ast.AstId path = self.parse_expr_path();
            return self.node_from_child(path, .name_expr(ast.StmtData (value: path)));
        }
        self.error_at_current_kind("expected_expression");
        std.jiang.Token current_token = self.advance();
        return self.unit_node(current_token.span);
    }

    Bool do_block_starts(self) {
        if (!self.check_keyword(.kw_do)) { return false; }
        return token_is(self.peek_offset(1), .left_bracket);
    }

    Bool effect_block_starts(self) {
        if (self.check_keyword(.kw_unsafe)) {
            if (token_is(self.peek_offset(1), .left_brace)) { return true; }
            if (!self.check_keyword_at(1, .kw_async)) { return false; }
            return token_is(self.peek_offset(2), .left_brace);
        }
        if (!self.check_keyword(.kw_async)) { return false; }
        if (token_is(self.peek_offset(1), .left_brace)) { return true; }
        if (!self.check_keyword_at(1, .kw_unsafe)) { return false; }
        return token_is(self.peek_offset(2), .left_brace);
    }

    ast.AstId parse_lang_block_expr(self, std.jiang.syntax.Root.Kind entry_kind) {
        std.jiang.Token raw_block = self.expect(.raw_block);
        return self.parse_lang_block(raw_block, entry_kind);
    }

    ast.AstId parse_lang_block(self,
        std.jiang.Token raw_block,
        std.jiang.syntax.Root.Kind entry_kind
    ) {
        guard raw_block.raw_block_id() is .some(block_index) else {
            self.error_at_span("lang_block_missing_id", raw_block.span);
            return self.unit_node(raw_block.span);
        }
        lang_block.LangBlockId block_id = lang_block.LangBlockId(block_index);
        if (!self.blocks.contains(block_id)) {
            self.error_at_span("lang_block_missing", raw_block.span);
            return self.unit_node(raw_block.span);
        }
        lang_block.LangBlock&! block = self.blocks.ref_at(block_id);
        block.set_entry_kind(entry_kind);
        block.mark_consumed();
        if (!block.provider_found) {
            return self.unit_node(raw_block.span);
        }
        if (block.scan_result.status == .error) {
            return self.unit_node(raw_block.span);
        }
        block.builder.set_diagnostic_category(.parser);
        lang_runtime.ParseIntoResult parsed = lang_runtime.parse_into(self.unit, block);
        if (parsed.status == .ok) {
            guard parsed.root is .some(root) else {
                self.error_at_span("lang_provider_parse_missing_root", raw_block.span);
                return self.unit_node(raw_block.span);
            }
            return root;
        }
        self.report_lang_runtime_error(parsed.status, raw_block.span);
        return self.unit_node(raw_block.span);
    }

    () report_lang_runtime_error(self, lang_runtime.CallStatus status, std.jiang.syntax.Span span) {
        self.error_at_span(self.lang_runtime_error_code(status), span);
    }

    UInt8[]& lang_runtime_error_code(self, lang_runtime.CallStatus status) {
        if (status == .not_loaded) {
            return "lang_provider_not_loaded";
        }
        if (status == .unsupported_version) {
            return "lang_provider_unsupported_version";
        }
        if (status == .invalid_request) {
            return "lang_provider_invalid_request";
        }
        if (status == .not_implemented) {
            return "lang_provider_parse_not_implemented";
        }
        return "lang_provider_parse_failed";
    }

    ast.AstId parse_expected_type_constructor_call(self, std.jiang.Token dot) {
        ast.AstId callee = self.node(dot.span, .infer_type);
        ast.AstRange args = self.parse_call_parens();
        return self.call_expr_node(callee, self.empty_range(), args);
    }

    ast.AstId parse_type_implicit_call_expr(self) {
        ast.AstId type_ref = self.parse_type();
        self.expect(.dollar);
        return self.finish_implicit_call_data(type_ref, false, true);
    }

    ast.AstId parse_type_member_expr(self) {
        ast.AstId type_ref = self.parse_type();
        self.expect(.dot);
        ast.AstId name = self.parse_member_name();
        return self.field_expr_node(type_ref, name, false);
    }

    ast.AstId parse_paren_expr(self) {
        std.jiang.Token start = self.expect(.left_paren);
        if (self.match(.right_paren)) {
            return self.node(self.span_from(start.span, self.previous().span), .tuple_expr(self.empty_range()));
        }
        ast.AstId first = self.parse_expr();
        if (self.match(.comma)) {
            Int item_start = self.temp.len();
            self.temp.add(first);
            if (self.check(.right_paren)) {
                self.error_at_current_kind("expected_expression");
            } else {
                self.temp.add(self.parse_expr());
                while (self.match(.comma)) {
                    if (self.check(.right_paren)) { break; }
                    self.temp.add(self.parse_expr());
                }
            }
            std.jiang.Token end = self.expect(.right_paren);
            ast.AstRange items = self.take_children(item_start);
            return self.node(self.span_from(start.span, end.span), .tuple_expr(items));
        }
        self.expect(.right_paren);
        return first;
    }

    ast.AstId parse_array_expr(self) {
        std.jiang.Token start = self.expect(.left_bracket);
        Int item_start = self.temp.len();
        if (!self.check(.right_bracket)) {
            self.temp.add(self.parse_expr());
            while (self.match(.comma)) {
                if (self.check(.right_bracket)) { break; }
                self.temp.add(self.parse_expr());
            }
        }
        std.jiang.Token end = self.expect(.right_bracket);
        ast.AstRange items = self.take_children(item_start);
        return self.node(self.span_from(start.span, end.span), .array_expr(items));
    }

    ast.AstId parse_struct_literal(self, ast.AstId type_ref, ast.AstRange type_args) {
        std.jiang.Token start = self.expect(.left_brace);
        Int field_start = self.temp.len();
        if (!self.check(.right_brace)) {
            self.temp.add(self.parse_field_init_expr());
            while (self.match(.comma)) {
                if (self.check(.right_brace)) { break; }
                self.temp.add(self.parse_field_init_expr());
            }
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange fields = self.take_children(field_start);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .struct_literal(ast.StructLiteralData (
                type_ref: type_ref,
                type_args: type_args,
                fields: fields
            ))
        );
    }

    ast.AstId parse_field_init_expr(self) {
        ast.AstId name = self.parse_name();
        self.expect(.colon);
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .field_init(ast.FieldInitData (name: name, value: value)));
    }

    ast.AstId parse_if_expr(self, Bool statement_mode) {
        std.jiang.Token start = self.expect_keyword(.kw_if);
        ast.AstId condition = self.parse_condition_list_without_block();
        ast.AstId then_body = self.parse_block();
        ast.AstId?! else_body = null;
        if (self.match_keyword(.kw_else)) {
            else_body = self.parse_else_body(statement_mode);
        }
        return self.node(
            self.span_from(start.span, self.unit.get(then_body).span),
            .if_expr(ast.IfData (
                condition: condition,
                then_body: then_body,
                else_body: else_body
            ))
        );
    }

    ast.AstId parse_else_body(self, Bool statement_mode) {
        if (self.check_keyword(.kw_if)) { return self.parse_if_expr(statement_mode); }
        return self.parse_block();
    }

    ast.AstId parse_switch_expr(self, Bool statement_mode) {
        std.jiang.Token start = self.expect_keyword(.kw_switch);
        ast.AstId value = self.parse_expr_without_block();
        self.expect(.left_brace);
        Int case_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            self.temp.add(self.parse_switch_case());
        }
        std.jiang.Token end = self.expect(.right_brace);
        ast.AstRange cases = self.take_children(case_start);
        return self.node(
            self.span_from(start.span, end.span),
            .switch_expr(ast.SwitchData (value: value, cases: cases))
        );
    }

    ast.AstId parse_switch_case(self) {
        Int pattern_start = self.temp.len();
        if (self.match_keyword(.kw_else)) {
            self.temp.add(self.unit_node(self.previous().span));
        } else {
            self.temp.add(self.parse_match_pattern());
            while (self.match(.comma)) {
                self.temp.add(self.parse_match_pattern());
            }
        }
        ast.AstRange patterns = self.take_children(pattern_start);
        self.expect(.fat_arrow);
        ast.AstId body = self.parse_switch_case_body();
        if (!self.match(.comma)) { self.match(.semicolon); }
        return self.node_from_children(
            self.range_first(patterns),
            body,
            .switch_case(ast.SwitchCaseData (patterns: patterns, body: body))
        );
    }

    ast.AstId parse_switch_case_body(self) {
        if (self.check(.left_brace)) { return self.parse_block(); }
        return self.parse_expr();
    }

    ast.AstId parse_try_catch_expr(self) {
        std.jiang.Token start = self.expect_keyword(.kw_try);
        ast.AstId value = self.parse_expr();
        ast.AstId catch_clause = self.parse_catch_clause();
        return self.node(
            self.span_from(start.span, self.unit.get(catch_clause).span),
            .catch_expr(ast.CatchExprData (value: value, catch_clause: catch_clause))
        );
    }

    ast.AstId parse_catch_clause(self) {
        std.jiang.Token start = self.expect_keyword(.kw_catch);
        ast.AstId?! pattern = null;
        self.expect(.left_paren);
        if (!self.check(.right_paren)) {
            pattern = self.parse_catch_binding();
        }
        self.expect(.right_paren);
        self.expect(.fat_arrow);
        ast.AstId body = self.parse_catch_body();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .catch_clause(ast.CatchClauseData (pattern: pattern, body: body))
        );
    }

    ast.AstId parse_catch_body(self) {
        if (self.check(.left_brace)) { return self.parse_block(); }
        return self.parse_expr();
    }

    ast.AstId parse_catch_binding(self) {
        ParserMark mark = self.mark();
        ast.AstId type_ref = self.parse_type();
        if (self.can_start_name()) {
            ast.AstId name = self.parse_name();
            return self.node_from_children(
                type_ref,
                name,
                .param(ast.ParamData (type_ref: type_ref, name: name, default_value: null))
            );
        }
        self.reset(mark);
        return self.parse_pattern();
    }

    ast.AstId parse_pattern(self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(std.jiang.syntax.Root.Kind.pattern);
        }
        if (self.check(.underscore)) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.match(.dot)) {
            // `.case` pattern 需要显式记录 dot_prefix。不能靠 span 判断，
            // 因为后续 AST 形态调整会让 span 推断变脆。
            std.jiang.syntax.Span start = self.previous().span;
            ast.AstId name = self.parse_variant_name();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            return self.node(
                self.span_from(start, self.unit.get(self.pattern_end(name, payload)).span),
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: true,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
        }
        if (self.check(.int_lit) || self.check(.float_lit) || self.check(.char_lit) || self.check(.string_lit)) {
            ast.AstId literal = self.parse_primary_expr(true);
            return self.node_from_child(
                literal,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: null,
                    value: literal,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: self.empty_range()
                ))
            );
        }
        if (self.check_keyword(.kw_true) || self.check_keyword(.kw_false) || self.check_keyword(.kw_null)) {
            ast.AstId literal = self.parse_primary_expr(true);
            return self.node_from_child(
                literal,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: null,
                    value: literal,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: self.empty_range()
                ))
            );
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        if (self.check(.left_paren)) {
            return self.parse_invalid_tuple_pattern();
        }
        ast.AstId name = self.parse_path();
        ast.AstRange payload = self.parse_pattern_payload_opt();
        return self.node_from_range(
            name,
            payload,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: payload
            ))
        );
    }

    ast.AstId parse_match_pattern(self) {
        if (self.match(.dot)) {
            // match pattern 中的 `.case` 同样保留语法事实，供 type check
            // 根据 scrutinee type 做 owner/member lookup。
            std.jiang.syntax.Span start = self.previous().span;
            ast.AstId name = self.parse_variant_name();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            return self.node(
                self.span_from(start, self.unit.get(self.pattern_end(name, payload)).span),
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: true,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
        }
        if (self.check(.left_paren)) {
            return self.parse_invalid_tuple_pattern();
        }
        if (self.check(.int_lit) || self.check(.float_lit) || self.check(.char_lit) || self.check(.string_lit)) {
            return self.parse_literal_pattern();
        }
        if (self.check_keyword(.kw_true) || self.check_keyword(.kw_false) || self.check_keyword(.kw_null)) {
            return self.parse_literal_pattern();
        }
        if (self.can_start_name()) {
            ast.AstId name = self.parse_path();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            ast.AstId pattern = self.node_from_range(
                name,
                payload,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
            if (payload.is_empty() && self.path_segment_len(name) == 1) {
                self.error_at_span("expected_match_pattern", self.unit.get(pattern).span);
            }
            return pattern;
        }
        ast.AstId pattern = self.parse_pattern();
        self.error_at_span("expected_match_pattern", self.unit.get(pattern).span);
        return pattern;
    }

    ast.AstId parse_literal_pattern(self) {
        ast.AstId literal = self.parse_primary_expr(true);
        return self.node_from_child(
            literal,
            .pattern(ast.PatternData (
                type_ref: null,
                name: null,
                value: literal,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_binding_pattern(self) {
        if (self.check(.underscore)) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        ast.AstId name = self.parse_name();
        return self.node_from_child(
            name,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_wildcard_binding_pattern(self) {
        std.jiang.Token start = self.advance();
        ast.AstId?! name = null;
        Bool! mutable_binding = false;
        Bool! borrow_binding = false;
        if (self.match(.bang)) {
            mutable_binding = true;
            if (self.can_start_name()) {
                name = self.parse_name();
            } else {
                self.error_at_span("wildcard_binding_suffix_requires_name", start.span);
            }
        } else if (self.can_start_name()) {
            name = self.parse_name();
        }
        std.jiang.syntax.Span! end = start.span;
        if (name is .some(parsed)) {
            end = self.unit.get(parsed).span;
        }
        return self.node(
            self.span_from(start.span, end),
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: mutable_binding,
                borrow_binding: borrow_binding,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId? parse_typed_binding_pattern(self) {
        ParserMark mark = self.mark();
        BindingMode mode = self.parse_ref_binding_mode_if_type_follows();
        if (!mode.borrow_binding && !self.can_start_type()) {
            self.reset(mark);
            return null;
        }
        BindingType binding_type = self.parse_typed_pattern_binding_type(mode);
        if (self.can_start_decl_name()) {
            ast.AstId name = self.parse_name();
            return self.node_from_children(
                binding_type.type_ref,
                name,
                .pattern(ast.PatternData (
                    type_ref: binding_type.type_ref,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: binding_type.mode.mutable_binding,
                    borrow_binding: binding_type.mode.borrow_binding,
                    payload: self.empty_range()
                ))
            );
        }
        self.reset(mark);
        return null;
    }

    BindingMode parse_ref_binding_mode_if_type_follows(self) {
        if (!self.check_ref_binding_mode()) {
            return BindingMode(false, false);
        }
        return self.parse_ref_binding_mode();
    }

    Bool check_ref_binding_mode(self) {
        if (!self.check_keyword(.kw_ref)) { return false; }
        Int! offset = 1;
        if (token_is(self.peek_offset(offset), .bang)) {
            offset = offset + 1;
        }
        std.jiang.Token after_mode = self.peek_offset(offset);
        if (token_is(after_mode, .underscore)) { return true; }
        if (token_is(after_mode, .left_paren)) { return true; }
        if (!token_is(after_mode, .ident)) { return false; }
        if (self.token_keyword(after_mode) is .some(keyword)) {
            return keyword == .kw_self_type;
        }
        if (self.qualified_type_name_starts_at(offset)) { return true; }
        return self.token_starts_uppercase_name(after_mode);
    }

    Bool qualified_type_name_starts_at(self, Int offset) {
        if (!token_is(self.peek_offset(offset + 1), .dot)) { return false; }
        Int! current_offset = offset + 2;
        while (true) {
            std.jiang.Token segment = self.peek_offset(current_offset);
            if (!token_is(segment, .ident)) { return false; }
            if (self.token_starts_uppercase_name(segment)) { return true; }
            if (!token_is(self.peek_offset(current_offset + 1), .dot)) { return false; }
            current_offset = current_offset + 2;
        }
        return false;
    }

    BindingMode parse_ref_binding_mode(self) {
        self.expect_keyword(.kw_ref);
        Bool mutable_binding = self.match(.bang);
        return BindingMode(mutable_binding, true);
    }

    BindingType parse_binding_type(self, BindingMode mode) {
        ast.AstId type_ref = self.parse_type();
        if (mode.borrow_binding) {
            return BindingType(type_ref, mode);
        }
        return self.binding_type_from_outer_mutable(type_ref, mode);
    }

    BindingType parse_typed_pattern_binding_type(self, BindingMode mode) {
        ast.AstId type_ref = self.parse_type();
        if (mode.borrow_binding) {
            return BindingType(type_ref, mode);
        }
        return self.binding_type_from_outer_mutable(type_ref, mode);
    }

    BindingType binding_type_from_outer_mutable(self, ast.AstId type_ref, BindingMode mode) {
        ast.AstNode node = self.unit.get(type_ref);
        guard node.data is .type_ref(type_data) else {
            return BindingType(type_ref, mode);
        }
        if (type_data.layer != .mutable_type) {
            return BindingType(type_ref, mode);
        }
        return BindingType(type_data.base, BindingMode(true, mode.borrow_binding));
    }

    ast.AstRange parse_pattern_payload_opt(self) {
        Int payload_start = self.temp.len();
        if (self.match(.left_paren)) {
            self.parse_pattern_list_until_right_paren();
            self.expect(.right_paren);
        }
        return self.take_children(payload_start);
    }

    ast.AstId parse_invalid_tuple_pattern(self) {
        std.jiang.Token start = self.expect(.left_paren);
        Int item_start = self.temp.len();
        self.parse_pattern_list_until_right_paren();
        std.jiang.Token end = self.expect(.right_paren);
        ast.AstRange payload = self.take_children(item_start);
        std.jiang.syntax.Span span = self.span_from(start.span, end.span);
        self.error_at_span("expected_match_pattern", span);
        return self.node(
            span,
            .pattern(ast.PatternData (
                type_ref: null,
                name: null,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: payload
            ))
        );
    }

    () parse_pattern_list_until_right_paren(self) {
        if (self.check(.right_paren)) { return; }
        self.temp.add(self.parse_pattern());
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { return; }
            self.temp.add(self.parse_pattern());
        }
    }

    Int path_segment_len(self, ast.AstId path_id) {
        ast.AstNode path_node = self.unit.get(path_id);
        if (path_node.data is .path(path)) { return path.segments.length; }
        if (path_node.data is .name(_)) { return 1; }
        return 0;
    }

    Bool can_start_type(self) {
        if (self.check(.left_paren)) { return true; }
        if (self.check_keyword(.kw_self_type)) { return true; }
        if (!self.check(.ident)) { return false; }
        if (self.check_any_keyword()) { return false; }
        if (self.token_starts_uppercase_name(self.peek())) { return true; }
        return self.looks_like_qualified_type_name();
    }

    Bool looks_like_qualified_type_name(self) {
        if (!token_is(self.peek_next(), .dot)) { return false; }
        Int! offset = 2;
        while (true) {
            std.jiang.Token segment = self.peek_offset(offset);
            if (!token_is(segment, .ident)) { return false; }
            if (self.token_starts_uppercase_name(segment)) { return true; }
            if (!token_is(self.peek_offset(offset + 1), .dot)) { return false; }
            offset = offset + 2;
        }
        return false;
    }

    Bool token_starts_uppercase_name(self, std.jiang.Token current_token) {
        if (!token_is(current_token, .ident)) {
            return false;
        }
        if (self.token_keyword(current_token) != null) {
            return false;
        }
        guard self.token_symbol(current_token) is .some(symbol) else { return false; }
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length == 0) { return false; }
        return text[0] >= UInt8(65) && text[0] <= UInt8(90);
    }

    // After a failed top-level parse, skip to a boundary where another item may start.
    () recover_top_level_item(self) {
        self.error_at_current_kind("expected_top_level_item");
        Bool! consumed = false;
        while (!self.at_end()) {
            if (consumed && token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) {
                self.advance();
                return;
            }
            if (consumed && self.peek().leading.has_newline) { return; }
            self.advance();
            consumed = true;
        }
    }

    // After a failed member parse, skip to the next member boundary.
    () recover_member(self) {
        self.error_at_current_kind("expected_member");
        Bool! consumed = false;
        while (!self.at_end()) {
            if (consumed && token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) { return; }
            self.advance();
            consumed = true;
        }
    }

    // After a failed statement parse, skip to the next statement boundary.
    () recover_stmt(self) {
        self.error_at_current_kind("expected_statement");
        while (!self.at_end()) {
            if (token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) { return; }
            self.advance();
        }
    }

    ast.AstRange take_children(self, Int start) {
        Int! range_start = self.unit.children.len();
        Int! index = start;
        Int! end = self.temp.len();
        while (index < end) {
            self.unit.add_child(self.temp.get(index));
            index = index + 1;
        }
        self.temp.truncate(start);
        return ast.AstRange(range_start, end - start);
    }

    ast.AstRange empty_range(self) {
        return ast.AstRange(self.unit.children.len(), 0);
    }

    ast.AstId range_first(self, ast.AstRange range) {
        if (range.is_empty()) {
            return self.node(self.peek().span, .unit_type);
        }
        return self.unit.child_at(range, 0);
    }

    ast.AstId range_last(self, ast.AstRange range) {
        if (range.is_empty()) {
            return self.node(self.peek().span, .unit_type);
        }
        return self.unit.child_at(range, range.length - 1);
    }

    ast.AstId pattern_end(self, ast.AstId name, ast.AstRange payload) {
        // dot-prefix pattern 的 span 从 dot 开始，到 payload 最后一个
        // pattern 结束；无 payload 时只覆盖名字。
        if (payload.is_empty()) {
            return name;
        }
        return self.range_last(payload);
    }

    std.jiang.syntax.Span range_span(self, ast.AstRange range) {
        if (range.is_empty()) { return self.peek().span; }
        return self.span_from(self.unit.get(self.range_first(range)).span, self.unit.get(self.range_last(range)).span);
    }

    ast.AstId node(self, std.jiang.syntax.Span span, ast.AstData data) {
        return self.unit.add_node(span, data);
    }

    ast.AstId node_from_child(self, ast.AstId child, ast.AstData data) {
        return self.node(self.unit.get(child).span, data);
    }

    ast.AstId node_from_children(self, ast.AstId first, ast.AstId last, ast.AstData data) {
        return self.node(self.span_from(self.unit.get(first).span, self.unit.get(last).span), data);
    }

    ast.AstId node_from_range(self, ast.AstId first, ast.AstRange range, ast.AstData data) {
        if (range.is_empty()) { return self.node_from_child(first, data); }
        return self.node_from_children(first, self.range_last(range), data);
    }

    ast.AstId unit_node(self, std.jiang.syntax.Span span) {
        return self.node(span, .unit_type);
    }

    ast.AstId parse_string_literal_expr(self) {
        std.jiang.Token tok = self.advance();
        if (!self.string_token_has_interpolation(tok)) {
            return self.literal_node(tok, ast.LiteralKind.string_lit);
        }
        return self.interpolated_string_block(tok);
    }

    Bool string_token_has_interpolation(self, std.jiang.Token tok) {
        Int! index = tok.span.start + 1;
        Int end = tok.span.end() - 1;
        while (index < end) {
            if (self.source_text[index] == UInt8(92) && index + 1 < end && self.source_text[index + 1] == UInt8(40)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool check_new_interpolated_string(self) {
        if (!self.check(.string_lit)) { return false; }
        return self.string_token_has_interpolation(self.peek());
    }

    ast.AstId interpolated_string_block(self, std.jiang.Token tok) {
        return self.interpolated_string_block_with_tail(tok, "into_string");
    }

    ast.AstId new_interpolated_string_block(self, std.jiang.Token tok) {
        return self.interpolated_string_block_with_tail(tok, "into_slice");
    }

    ast.AstId interpolated_string_block_with_tail(self, std.jiang.Token tok, UInt8[]& tail_method) {
        qid.SymbolId builder_symbol = self.store.symbols.intern("__jiang_interpolation_builder");
        Int stmt_start = self.temp.len();
        self.temp.add(self.interpolation_builder_decl(builder_symbol, tok.span));

        Int! segment_start = tok.span.start + 1;
        Int! index = segment_start;
        Int end = tok.span.end() - 1;
        while (index < end) {
            if (self.source_text[index] == UInt8(92) && index + 1 < end && self.source_text[index + 1] == UInt8(40)) {
                self.add_interpolation_segment_statement(builder_symbol, segment_start, index);
                Int close_paren = self.interpolation_close_paren(index + 1, end);
                ast.AstRange args = self.parse_interpolation_args(index + 1, close_paren);
                self.temp.add(self.interpolation_append_statement(builder_symbol, args, tok.span));
                index = close_paren + 1;
                segment_start = index;
                continue;
            }
            index = index + 1;
        }
        self.add_interpolation_segment_statement(builder_symbol, segment_start, end);
        ast.AstRange statements = self.take_children(stmt_start);
        ast.AstId tail = self.interpolation_tail_call(builder_symbol, tail_method, tok.span);
        return self.node(
            tok.span,
            .block(ast.BlockData (effects: ast.EffectSet(), statements: statements, tail_expr: tail))
        );
    }

    ast.AstId interpolation_builder_decl(self, qid.SymbolId builder_symbol, std.jiang.syntax.Span span) {
        ast.AstId type_ref = self.named_type_from_symbol(self.store.symbols.intern("StringBuilder"), span);
        ast.AstId name = self.name_node_from_symbol(builder_symbol, span);
        ast.AstId initializer = self.empty_call(
            self.name_expr_from_symbol(self.store.symbols.intern("StringBuilder"), span)
        );
        return self.node(span, .let_stmt(ast.LetData (
            type_ref: type_ref,
            name: name,
            initializer: initializer,
            mutable_binding: true,
            borrow_binding: false
        )));
    }

    () add_interpolation_segment_statement(self, qid.SymbolId builder_symbol, Int start, Int end) {
        if (start >= end) {
            return;
        }
        std.jiang.syntax.Span span = std.jiang.syntax.Span(start, end - start);
        ast.AstId literal = self.string_literal_from_body(span, self.source_text[start..end]);
        ast.AstRange args = self.single_call_arg_range(literal);
        self.temp.add(self.interpolation_append_statement(builder_symbol, args, span));
    }

    ast.AstId interpolation_append_statement(self,
        qid.SymbolId builder_symbol,
        ast.AstRange args,
        std.jiang.syntax.Span span
    ) {
        ast.AstId call = self.interpolation_method_call(builder_symbol, "append", args, span);
        return self.node_from_child(call, .stmt(ast.StmtData (value: call)));
    }

    ast.AstId interpolation_tail_call(self,
        qid.SymbolId builder_symbol,
        UInt8[]& method_name,
        std.jiang.syntax.Span span
    ) {
        return self.interpolation_method_call(builder_symbol, method_name, self.empty_range(), span);
    }

    ast.AstId interpolation_method_call(self,
        qid.SymbolId builder_symbol,
        UInt8[]& method_name,
        ast.AstRange args,
        std.jiang.syntax.Span span
    ) {
        ast.AstId base = self.name_expr_from_symbol(builder_symbol, span);
        ast.AstId method = self.name_node_from_symbol(self.store.symbols.intern(method_name), span);
        ast.AstId callee = self.field_expr_node(base, method, false);
        return self.call_expr_node(callee, self.empty_range(), args);
    }

    ast.AstRange parse_interpolation_args(self, Int open_paren, Int close_paren) {
        list.ArrayList<std.jiang.Token>! tokens = self.tokenize_interpolation_args(open_paren, close_paren);
        Parser! parser = Parser(
            self.store,
            tokens$.ref(),
            self.blocks,
            self.unit,
            self.source_text,
            self.source_id
        );
        return parser.parse_call_parens();
    }

    list.ArrayList<std.jiang.Token> tokenize_interpolation_args(self, Int open_paren, Int close_paren) {
        std.jiang.syntax.SourceId std_source_id = std.jiang.syntax.SourceId(self.source_id.to_index());
        std.jiang.syntax.Source std_source = std.jiang.syntax.Source(std_source_id, self.source_text);
        std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer(std_source, std.jiang.syntax.Span(
            open_paren,
            close_paren - open_paren + 1
        ));
        syntax_builder.SyntaxBuilder! builder = syntax_builder.SyntaxBuilder(
            self.store,
            self.source_id,
            self.source_text,
            .parser
        );
        std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
        list.ArrayList<std.jiang.Token>! result = list.ArrayList<std.jiang.Token>();
        while (true) {
            std.jiang.Token token = tokenizer.next(builder_ref);
            result.add(token);
            if (token.tag() == .eof) {
                break;
            }
        }
        return result$.move();
    }

    Int interpolation_close_paren(self, Int open_paren, Int limit) {
        Int! depth = 0;
        Int! index = open_paren;
        while (index < limit) {
            UInt8 byte = self.source_text[index];
            if (byte == UInt8(34)) {
                index = self.skip_interpolation_quoted(index, limit, UInt8(34));
                continue;
            }
            if (byte == UInt8(39)) {
                index = self.skip_interpolation_quoted(index, limit, UInt8(39));
                continue;
            }
            if (byte == UInt8(96)) {
                index = self.skip_interpolation_raw_name(index, limit);
                continue;
            }
            if (byte == UInt8(40)) {
                depth = depth + 1;
            }
            if (byte == UInt8(41)) {
                depth = depth - 1;
                if (depth == 0) {
                    return index;
                }
            }
            index = index + 1;
        }
        self.error_at_span("unterminated_string_interpolation", std.jiang.syntax.Span(open_paren, 1));
        return limit;
    }

    Int skip_interpolation_quoted(self, Int start, Int limit, UInt8 delimiter) {
        Int! index = start + 1;
        Bool! escaped = false;
        while (index < limit) {
            UInt8 byte = self.source_text[index];
            if (escaped) {
                escaped = false;
            } else if (byte == UInt8(92)) {
                escaped = true;
            } else if (byte == delimiter) {
                return index + 1;
            }
            index = index + 1;
        }
        return limit;
    }

    Int skip_interpolation_raw_name(self, Int start, Int limit) {
        Int! index = start + 1;
        while (index < limit) {
            if (self.source_text[index] == UInt8(96)) {
                return index + 1;
            }
            index = index + 1;
        }
        return limit;
    }

    ast.AstRange single_call_arg_range(self, ast.AstId value) {
        ast.AstId arg = self.node_from_child(value, .call_arg(ast.CallArgData (label: null, value: value)));
        return self.unit.add_child(arg);
    }

    ast.AstId string_literal_from_body(self, std.jiang.syntax.Span span, UInt8[]& body) {
        qid.SymbolId symbol = self.store.symbols.intern(std.jiang.literal.unescape(body));
        return self.node(span, .literal(ast.LiteralData (
            kind: ast.LiteralKind.string_lit,
            bool_value: false,
            symbol_id: symbol
        )));
    }

    ast.AstId name_expr_from_symbol(self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        ast.AstId name = self.name_node_from_symbol(symbol, span);
        ast.AstRange segments = self.unit.add_child(name);
        ast.AstId path = self.node(span, .path(ast.PathData (segments: segments)));
        return self.node(span, .name_expr(ast.StmtData (value: path)));
    }

    ast.AstId named_type_from_symbol(self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        ast.AstId name = self.name_node_from_symbol(symbol, span);
        ast.AstRange segments = self.unit.add_child(name);
        ast.AstId path = self.node(span, .path(ast.PathData (segments: segments)));
        return self.node(span, .named_type(ast.NamedTypeData (path: path, args: self.empty_range())));
    }

    ast.AstId empty_call(self, ast.AstId callee) {
        return self.call_expr_node(callee, self.empty_range(), self.empty_range());
    }

    ast.AstId literal_node(self, std.jiang.Token tok, ast.LiteralKind kind) {
        if (self.token_symbol(tok) is .some(symbol_id)) {
            return self.node(tok.span, .literal(ast.LiteralData (
                kind: kind,
                bool_value: false,
                symbol_id: symbol_id
            )));
        }
        return self.node(tok.span, .literal(ast.LiteralData (
            kind: kind,
            bool_value: false,
            symbol_id: null
        )));
    }

    ast.AstId name_expr_from_token(self, std.jiang.Token tok) {
        ast.AstId name = self.name_node_from_token(tok);
        return self.node(tok.span, .name_expr(ast.StmtData (value: name)));
    }

    ast.AstId name_node_from_token(self, std.jiang.Token tok) {
        qid.SymbolId?! symbol = null;
        if (self.token_symbol(tok) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return self.node(tok.span, .name(ast.NameData (symbol_id: symbol)));
    }

    ast.AstId name_node_from_symbol(self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        return self.node(span, .name(ast.NameData (symbol_id: symbol)));
    }

    ast.AstId parse_name(self) {
        if (self.can_start_name()) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token actual = self.peek();
        if (self.current_token_is_reserved_keyword()) {
            self.add_parse_error_message(
                actual.span,
                "keyword_cannot_be_identifier",
                "keyword cannot be used as an identifier"
            );
        } else {
            self.error_at_current("expected_name", .ident);
        }
        // Error recovery must consume the offending token. Otherwise callers
        // that keep parsing member/name lists can retry the same token forever.
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.Token.missing(.ident, actual.span));
    }

    ast.AstId parse_symbol_name(self, Bool allow_escaped_name) {
        if (allow_escaped_name && self.check(.escaped_ident)) {
            return self.parse_escaped_symbol_name();
        }
        return self.parse_name();
    }

    ast.AstId parse_decl_name(self) {
        if (self.can_start_decl_name()) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token actual = self.peek();
        if (self.current_token_is_reserved_keyword()) {
            self.add_parse_error_message(
                actual.span,
                "keyword_cannot_be_identifier",
                "keyword cannot be used as an identifier"
            );
        } else {
            self.error_at_current("expected_name", .ident);
        }
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.Token.missing(.ident, actual.span));
    }

    ast.AstId parse_escaped_symbol_name(self) {
        if (self.check(.escaped_ident)) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token actual = self.peek();
        self.error_at_current("expected_name", .escaped_ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.Token.missing(.escaped_ident, actual.span));
    }

    ast.AstId parse_member_name(self) {
        // `value$.some()` 这类隐式操作名需要按成员名解析；
        // 声明名继续走 parse_name，保持关键字保护。
        if (self.check_keyword(.kw_new)) {
            std.jiang.Token name = self.advance();
            qid.SymbolId symbol = self.store.symbols.intern("new");
            return self.name_node_from_symbol(symbol, name.span);
        }
        if (self.check(.ident)) {
            if (self.check_symbol_text("init") && token_is(self.peek_next(), .question)) {
                std.jiang.Token name = self.advance();
                std.jiang.Token question = self.advance();
                qid.SymbolId symbol = self.store.symbols.intern("init?");
                return self.name_node_from_symbol(symbol, self.span_from(name.span, question.span));
            }
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token actual = self.peek();
        self.error_at_current("expected_name", .ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.Token.missing(.ident, actual.span));
    }

    ast.AstId parse_path(self) {
        Int segment_start = self.temp.len();
        ast.AstId first = self.parse_name();
        self.temp.add(first);
        while (self.match(.dot)) {
            self.temp.add(self.parse_name());
        }
        ast.AstRange segments = self.take_children(segment_start);
        return self.node_from_range(first, segments, .path(ast.PathData (segments: segments)));
    }

    ast.AstId parse_expr_path(self) {
        Int segment_start = self.temp.len();
        ast.AstId first = self.parse_name();
        self.temp.add(first);
        while (self.match(.dot)) {
            self.temp.add(self.parse_member_name());
        }
        ast.AstRange segments = self.take_children(segment_start);
        return self.node_from_range(first, segments, .path(ast.PathData (segments: segments)));
    }

    Bool can_start_name(self) {
        if (self.check_keyword(.kw_self)) { return true; }
        if (self.check_keyword(.kw_self_type)) { return true; }
        if (self.check(.ident)) { return !self.current_token_is_reserved_identifier_keyword(); }
        return false;
    }

    Bool can_start_symbol_name(self, Bool allow_escaped_name) {
        if (allow_escaped_name && self.check(.escaped_ident)) {
            return true;
        }
        return self.can_start_name();
    }

    Bool can_start_decl_name(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.check_keyword(.kw_self)) {
            return false;
        }
        if (self.check_keyword(.kw_self_type)) {
            return false;
        }
        return !self.current_token_is_reserved_identifier_keyword();
    }

    Bool current_token_is_reserved_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.check_keyword(.kw_self) || self.check_keyword(.kw_self_type)) {
            return true;
        }
        return self.current_token_is_reserved_identifier_keyword();
    }

    Bool current_token_is_reserved_identifier_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.token_keyword(self.peek()) is .some(keyword)) {
            return keyword.keyword_is_reserved_identifier(keyword);
        }
        return false;
    }

    Bool looks_like_function_decl(self) {
        ParserMark mark = self.mark();
        self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        Bool! result = false;
        if (self.can_start_name()) {
            self.advance();
            result = self.check(.left_paren) || self.check(.lt);
        }
        self.reset(mark);
        return result;
    }

    Bool type_args_before_call(self) {
        // 这里不能调用 parse_type_args 做试探。普通比较表达式也会出现 `<`，
        // 试探解析失败时即使回滚，也容易把错误诊断泄漏到真正的 parse 结果里。
        Int! angle_depth = 0;
        Int! paren_depth = 0;
        Int! bracket_depth = 0;
        Int! offset = 0;
        while (!self.type_arg_probe_stops(std.jiang.token_tag(self.peek_offset(offset).kind))) {
            std.jiang.TokenTag kind = std.jiang.token_tag(self.peek_offset(offset).kind);
            if (kind == .left_paren) { paren_depth = paren_depth + 1; }
            else if (kind == .right_paren) {
                if (paren_depth == 0) { return false; }
                paren_depth = paren_depth - 1;
            } else if (kind == .left_bracket) {
                bracket_depth = bracket_depth + 1;
            } else if (kind == .right_bracket) {
                if (bracket_depth == 0) { return false; }
                bracket_depth = bracket_depth - 1;
            } else if (kind == .lt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth + 1;
            } else if (kind == .gt_gt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth - 2;
                if (angle_depth == 0) {
                    return token_is(self.peek_offset(offset + 1), .left_paren);
                }
                if (angle_depth < 0) { return false; }
            } else if (kind == .gt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth - 1;
                if (angle_depth == 0) {
                    return token_is(self.peek_offset(offset + 1), .left_paren);
                }
                if (angle_depth < 0) { return false; }
            }
            offset = offset + 1;
        }
        return false;
    }

    Bool type_arg_probe_stops(self, std.jiang.TokenTag kind) {
        return kind == .eof || kind == .semicolon || kind == .right_brace;
    }

    Bool starts_type_member_expr(self) {
        if (!self.current_token_starts_type_name()) { return false; }
        ParserMark mark = self.mark();
        self.parse_type();
        Bool result = self.check(.dot);
        self.reset(mark);
        return result;
    }

    Bool starts_type_implicit_expr(self) {
        if (!self.current_token_starts_type_name()) {
            return false;
        }
        ParserMark mark = self.mark();
        self.parse_type();
        Bool result = self.check(.dollar);
        self.reset(mark);
        return result;
    }

    Bool starts_implicit_type_arg(self) {
        if (!self.current_token_starts_type_name()) {
            return false;
        }
        ParserMark mark = self.mark();
        self.parse_type();
        Bool result = self.check(.comma) || self.check(.right_paren);
        self.reset(mark);
        return result;
    }

    Bool current_token_starts_type_name(self) {
        std.jiang.Token current_token = self.peek();
        if (token_is(current_token, .ident)) {
            if (self.token_keyword(current_token) is .some(keyword)) {
                return keyword == .kw_self_type;
            }
        }
        return self.token_starts_uppercase_name(current_token) || self.looks_like_qualified_type_name();
    }

    ast.BinaryOp? binary_op_from_current(self) {
        if (self.check(.pipe_pipe)) { return ast.BinaryOp.logic_or; }
        if (self.check(.amp_amp)) { return ast.BinaryOp.logic_and; }
        if (self.check(.question_question)) { return ast.BinaryOp.coalesce; }
        if (self.check(.eq_eq)) { return ast.BinaryOp.equal; }
        if (self.check(.bang_eq)) { return ast.BinaryOp.not_equal; }
        if (self.check(.lt)) { return ast.BinaryOp.less; }
        if (self.check(.lt_eq)) { return ast.BinaryOp.less_equal; }
        if (self.check(.gt)) { return ast.BinaryOp.greater; }
        if (self.check(.gt_eq)) { return ast.BinaryOp.greater_equal; }
        if (self.check(.pipe)) { return ast.BinaryOp.bit_or; }
        if (self.check(.caret)) { return ast.BinaryOp.bit_xor; }
        if (self.check(.amp)) { return ast.BinaryOp.bit_and; }
        if (self.check(.lt_lt)) { return ast.BinaryOp.shift_left; }
        if (self.check(.gt_gt)) { return ast.BinaryOp.shift_right; }
        if (self.check(.plus)) { return ast.BinaryOp.add; }
        if (self.check(.minus)) { return ast.BinaryOp.sub; }
        if (self.check(.star)) { return ast.BinaryOp.mul; }
        if (self.check(.slash)) { return ast.BinaryOp.div; }
        if (self.check(.percent)) { return ast.BinaryOp.mod; }
        return null;
    }

    Int binary_precedence(self, ast.BinaryOp op) {
        if (op == ast.BinaryOp.logic_or) { return 1; }
        if (op == ast.BinaryOp.logic_and) { return 2; }
        if (op == ast.BinaryOp.coalesce) { return 3; }
        if (op == ast.BinaryOp.equal
            || op == ast.BinaryOp.not_equal
            || op == ast.BinaryOp.less
            || op == ast.BinaryOp.less_equal
            || op == ast.BinaryOp.greater
            || op == ast.BinaryOp.greater_equal) {
            return 4;
        }
        if (op == ast.BinaryOp.bit_or) { return 5; }
        if (op == ast.BinaryOp.bit_xor) { return 6; }
        if (op == ast.BinaryOp.bit_and) { return 7; }
        if (op == ast.BinaryOp.shift_left || op == ast.BinaryOp.shift_right) { return 8; }
        if (op == ast.BinaryOp.add || op == ast.BinaryOp.sub) { return 9; }
        return 10;
    }

    ast.UnaryOp? unary_op_from_current(self) {
        if (self.check(.minus)) { return ast.UnaryOp.negate; }
        if (self.check(.bang)) { return ast.UnaryOp.not; }
        if (self.check(.tilde)) { return ast.UnaryOp.bit_not; }
        if (self.check(.amp)) { return ast.UnaryOp.address_of; }
        return null;
    }

    ast.AssignOp? assign_op_from_current(self) {
        if (self.check(.assign)) { return ast.AssignOp.assign; }
        if (self.check(.plus_assign)) { return ast.AssignOp.add_assign; }
        if (self.check(.minus_assign)) { return ast.AssignOp.sub_assign; }
        if (self.check(.star_assign)) { return ast.AssignOp.mul_assign; }
        if (self.check(.slash_assign)) { return ast.AssignOp.div_assign; }
        if (self.check(.percent_assign)) { return ast.AssignOp.mod_assign; }
        if (self.check(.amp_assign)) { return ast.AssignOp.bit_and_assign; }
        if (self.check(.pipe_assign)) { return ast.AssignOp.bit_or_assign; }
        if (self.check(.caret_assign)) { return ast.AssignOp.bit_xor_assign; }
        if (self.check(.lt_lt_assign)) { return ast.AssignOp.shift_left_assign; }
        if (self.check(.gt_gt_assign)) { return ast.AssignOp.shift_right_assign; }
        return null;
    }

    ParserMark mark(self) {
        return ParserMark(
            self.current,
            self.temp.len(),
            self.unit.nodes.len(),
            self.unit.children.len(),
            self.store.diagnostics.len(),
            self.pending_gt_start
        );
    }

    () reset(self, ParserMark mark) {
        self.current = mark.current;
        self.temp.truncate(mark.temp_len);
        self.unit.nodes.truncate(mark.node_len);
        self.unit.children.truncate(mark.child_len);
        self.store.diagnostics.truncate(mark.diagnostic_len);
        self.pending_gt_start = mark.pending_gt_start;
    }

    Bool at_end(self) {
        return self.peek_kind() == .eof;
    }

    Bool check(self, std.jiang.TokenTag expected) {
        return self.peek_kind() == expected;
    }

    Bool match(self, std.jiang.TokenTag expected) {
        if (!self.check(expected)) { return false; }
        self.advance();
        return true;
    }

    std.jiang.Token expect(self, std.jiang.TokenTag expected) {
        if (self.check(expected)) { return self.advance(); }
        self.error_at_current("expected_token", expected);
        return std.jiang.Token.missing(expected, self.peek().span);
    }

    Bool check_type_arg_gt(self) {
        return self.check(.gt) || self.check(.gt_gt);
    }

    std.jiang.Token expect_type_arg_gt(self) {
        if (self.check(.gt)) { return self.advance(); }
        if (self.check(.gt_gt)) { return self.split_gt_gt_token(); }
        self.error_at_current("expected_token", .gt);
        return std.jiang.Token.missing(.gt, self.peek().span);
    }

    std.jiang.Token split_gt_gt_token(self) {
        std.jiang.Token current_token = self.peek();
        std.jiang.Token first = make_token(
            .gt,
            std.jiang.syntax.Span(current_token.span.start, 1),
            current_token.leading,
            current_token.presence
        );
        self.pending_gt_start = current_token.span.start + 1;
        self.current = self.current + 1;
        return first;
    }

    qid.SymbolId? token_symbol(self, std.jiang.Token tok) {
        if (tok.symbol_id() is .some(symbol)) {
            return symbol;
        }
        return null;
    }

    keyword.Keyword? token_keyword(self, std.jiang.Token tok) {
        guard self.token_symbol(tok) is .some(symbol) else {
            return null;
        }
        return self.store.symbols.keyword(symbol);
    }

    Bool check_keyword(self, keyword.Keyword keyword) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.token_keyword(self.peek()) is .some(actual)) {
            return actual == keyword;
        }
        return false;
    }

    Bool check_keyword_at(self, Int offset, keyword.Keyword keyword) {
        std.jiang.Token tok = self.peek_offset(offset);
        if (!token_is(tok, .ident)) { return false; }
        if (self.token_keyword(tok) is .some(actual)) {
            return actual == keyword;
        }
        return false;
    }

    Bool check_any_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        return self.token_keyword(self.peek()) != null;
    }

    Bool check_symbol_text(self, UInt8[]& expected) {
        return self.token_text_equal(self.peek(), expected);
    }

    Bool token_text_equal(self, std.jiang.Token tok, UInt8[]& expected) {
        if (!token_is(tok, .ident)) {
            return false;
        }
        guard self.token_symbol(tok) is .some(symbol) else { return false; }
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length != expected.length) { return false; }
        Int! index = 0;
        while (index < text.length) {
            if (text[index] != expected[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool match_keyword(self, keyword.Keyword keyword) {
        if (!self.check_keyword(keyword)) { return false; }
        self.advance();
        return true;
    }

    std.jiang.Token expect_keyword(self, keyword.Keyword keyword) {
        if (self.check_keyword(keyword)) { return self.advance(); }
        self.error_at_current_keyword(keyword);
        return std.jiang.Token.missing(.ident, self.peek().span);
    }

    std.jiang.Token advance(self) {
        std.jiang.Token current_token = self.peek();
        if (self.has_pending_gt()) {
            self.pending_gt_start = -1;
            return current_token;
        }
        if (!self.at_end()) { self.current = self.current + 1; }
        return current_token;
    }

    std.jiang.Token peek(self) {
        if (self.has_pending_gt()) {
            return make_token(
                .gt,
                std.jiang.syntax.Span(self.pending_gt_start, 1),
                std.jiang.Trivia(has_whitespace: false, has_newline: false, has_comment: false),
                .present
            );
        }
        return self.tokens.get(self.current);
    }

    std.jiang.TokenTag peek_kind(self) {
        return std.jiang.token_tag(self.peek().kind);
    }

    std.jiang.Token peek_next(self) {
        if (self.has_pending_gt()) {
            if (self.current >= self.tokens.len()) { return self.tokens.get(self.tokens.len() - 1); }
            return self.tokens.get(self.current);
        }
        if (self.current + 1 >= self.tokens.len()) { return self.tokens.get(self.current); }
        return self.tokens.get(self.current + 1);
    }

    std.jiang.Token peek_offset(self, Int offset) {
        Int! effective_offset = offset;
        if (self.has_pending_gt()) {
            if (effective_offset == 0) {
                return make_token(
                    .gt,
                    std.jiang.syntax.Span(self.pending_gt_start, 1),
                    std.jiang.Trivia(has_whitespace: false, has_newline: false, has_comment: false),
                    .present
                );
            }
            effective_offset = effective_offset - 1;
        }
        Int index = self.current + effective_offset;
        if (index >= self.tokens.len()) { return self.tokens.get(self.tokens.len() - 1); }
        return self.tokens.get(index);
    }

    Bool has_pending_gt(self) {
        return self.pending_gt_start >= 0;
    }

    std.jiang.Token previous(self) {
        if (self.current == 0) { return self.tokens.get(0); }
        return self.tokens.get(self.current - 1);
    }

    () error_at_current(self, UInt8[]& code, std.jiang.TokenTag expected) {
        std.jiang.Token actual = self.peek();
        self.add_parse_error(actual.span, code);
    }

    () error_at_current_keyword(self, keyword.Keyword expected) {
        std.jiang.Token actual = self.peek();
        self.add_parse_error(actual.span, "expected_keyword");
    }

    () error_at_current_kind(self, UInt8[]& code) {
        std.jiang.Token actual = self.peek();
        self.add_parse_error(actual.span, code);
    }

    () error_at_span(self, UInt8[]& code, std.jiang.syntax.Span span) {
        self.add_parse_error(span, code);
    }

    () add_parse_error(self, std.jiang.syntax.Span span, UInt8[]& code) {
        syntax_diagnostics.add_parse_error(self.store, self.source_id, span, code);
    }

    () add_parse_error_message(self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        syntax_diagnostics.add_parse_error_message(self.store, self.source_id, span, code, message);
    }

    std.jiang.syntax.Span span_from(self, std.jiang.syntax.Span start, std.jiang.syntax.Span end) {
        return std.jiang.syntax.Span(start.start, end.end() - start.start);
    }
}
