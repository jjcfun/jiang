// Compiler-only keyword classification.
//
// The public tokenizer emits identifiers for keywords. Parser keyword
// recognition stays in the compiler because keyword policy is part of the
// Jiang parser, not the reusable token data model.

public enum Keyword {
    kw_new,
    kw_where,
    kw_life,
    kw_import,
    kw_public,
    kw_const,
    kw_alias,
    kw_extern,
    kw_return,
    kw_if,
    kw_else,
    kw_guard,
    kw_while,
    kw_for,
    kw_in,
    kw_is,
    kw_enum,
    kw_union,
    kw_struct,
    kw_trait,
    kw_extend,
    kw_associated,
    kw_init,
    kw_deinit,
    kw_static,
    kw_comptime,
    kw_switch,
    kw_try,
    kw_catch,
    kw_break,
    kw_continue,
    kw_defer,
    kw_throw,
    kw_true,
    kw_false,
    kw_null,
    kw_self,
    kw_ref,
    kw_self_type,
}

public enum KeywordIdentifierRole {
    reserved,
    contextual,
    special_name,
}

public KeywordIdentifierRole keyword_identifier_role(Keyword keyword) {
    if (keyword == .kw_ref) {
        return .contextual;
    }
    if (keyword == .kw_self || keyword == .kw_self_type) {
        return .special_name;
    }
    return .reserved;
}

public Bool keyword_is_reserved_identifier(Keyword keyword) {
    return keyword_identifier_role(keyword) == .reserved;
}
