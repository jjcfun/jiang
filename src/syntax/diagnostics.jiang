// syntax 阶段的诊断 helper。
//
// lexer/parser 统一产出 std.jiang.syntax.Diagnostic；只有写入全局
// DiagnosticStore 时才转换成 compiler rich Diagnostic。

import diagnostic = "../diagnostic/diagnostic.jiang";
import qid = "../store/id.jiang";
import store_api = "../store/api.jiang";
import source = "../source/source.jiang";
import std;

public () add_lexer_error(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_lexer_diagnostic(store, source_id, std.jiang.syntax.Diagnostic.error(span, code, code));
}

public () add_lexer_diagnostic(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    std.jiang.syntax.Diagnostic value
) {
    add_syntax_diagnostic(store, source_id, .lexer, value);
}

public () add_parse_error(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_syntax_diagnostic(
        store,
        source_id,
        .parser,
        std.jiang.syntax.Diagnostic.error(span, code, code)
    );
}

public () add_parse_error_message(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    add_syntax_diagnostic(
        store,
        source_id,
        .parser,
        std.jiang.syntax.Diagnostic.error(span, code, message)
    );
}

public () add_parse_diagnostic(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    std.jiang.syntax.Diagnostic value
) {
    add_syntax_diagnostic(store, source_id, .parser, value);
}

public () add_syntax_diagnostic(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    diagnostic.DiagnosticCategory category,
    std.jiang.syntax.Diagnostic syntax_diagnostic
) {
    qid.SymbolId code_symbol = store.symbols.intern(syntax_diagnostic.code);
    UInt8[]& stable_code = store.symbols.text(code_symbol);
    store.diagnostics.add(
        diagnostic.Diagnostic(
            rich_severity(syntax_diagnostic.severity),
            category,
            diagnostic.DiagnosticCode(stable_code),
            diagnostic.SourceRange(source_id, syntax_diagnostic.span),
            syntax_diagnostic.message
        )
    );
}

diagnostic.DiagnosticSeverity rich_severity(std.jiang.syntax.Diagnostic.Severity severity) {
    if (severity == .warning) {
        return .warning;
    }
    if (severity == .note) {
        return .information;
    }
    return .error;
}
