// syntax 阶段的结构化错误到统一 DiagnosticBag 的转换。
//
// lexer/parser 只产出 LexError/ParseError；具体 diagnostic code 和 category
// 的映射留在 syntax 模块内，pipeline 只负责发现 syntax 失败后调用这里。

import diagnostic = "../diagnostic/diagnostic.jiang";
import source = "../source/source.jiang";
import token = "./token.jiang";
import syntax = "./api.jiang";
import error = "./error.jiang";

public () record_errors(
    diagnostic.DiagnosticBag& diagnostics,
    source.SourceId source_id,
    syntax.SyntaxResult& syntax_result
) {
    Int! lex_index = 0;
    while (lex_index < syntax_result.lex_errors.len()) {
        error.LexError lex_error = syntax_result.lex_errors.get(lex_index);
        add_source_error(
            diagnostics,
            source_id,
            lex_error.span,
            .lexer,
            lex_error_code(lex_error.kind),
            lex_error_code(lex_error.kind)
        );
        lex_index = lex_index + 1;
    }

    Int! parse_index = 0;
    while (parse_index < syntax_result.parse_errors.len()) {
        error.ParseError parse_error = syntax_result.parse_errors.get(parse_index);
        UInt8[] code = parse_error_code(parse_error.kind);
        UInt8[]! message = code;
        if (parse_error.message.length > 0) {
            message = parse_error.message;
        }
        add_source_error(diagnostics, source_id, parse_error.span, .parser, code, message);
        parse_index = parse_index + 1;
    }
}

UInt8[] lex_error_code(error.LexErrorKind kind) {
    if (kind == .invalid_utf8) { return "invalid_utf8"; }
    if (kind == .unexpected_character) { return "unexpected_character"; }
    if (kind == .unicode_punctuation) { return "unicode_punctuation"; }
    if (kind == .unterminated_string) { return "unterminated_string"; }
    if (kind == .unterminated_char) { return "unterminated_char"; }
    if (kind == .empty_binary_literal) { return "empty_binary_literal"; }
    if (kind == .empty_octal_literal) { return "empty_octal_literal"; }
    return "empty_hex_literal";
}

UInt8[] parse_error_code(error.ParseErrorKind kind) {
    if (kind == .unexpected_token) { return "unexpected_token"; }
    if (kind == .expected_token) { return "expected_token"; }
    if (kind == .expected_keyword) { return "expected_keyword"; }
    if (kind == .expected_expression) { return "expected_expression"; }
    if (kind == .expected_type) { return "expected_type"; }
    if (kind == .expected_name) { return "expected_name"; }
    if (kind == .expected_delimiter) { return "expected_delimiter"; }
    if (kind == .expected_top_level_item) { return "expected_top_level_item"; }
    if (kind == .expected_member) { return "expected_member"; }
    if (kind == .expected_statement) { return "expected_statement"; }
    if (kind == .expected_match_pattern) { return "expected_match_pattern"; }
    if (kind == .expected_guard_exit) { return "expected_guard_exit"; }
    if (kind == .optional_after_mutable_type) { return "optional_after_mutable_type"; }
    if (kind == .repeated_optional_type) { return "repeated_optional_type"; }
    if (kind == .repeated_mutable_type) { return "repeated_mutable_type"; }
    if (kind == .invalid_handle_type) { return "invalid_handle_type"; }
    if (kind == .unclosed_delimiter) { return "unclosed_delimiter"; }
    return "unexpected_trivia";
}

() add_source_error(
    diagnostic.DiagnosticBag& diagnostics,
    source.SourceId source_id,
    token.Span span,
    diagnostic.DiagnosticCategory category,
    UInt8[] code,
    UInt8[] message
) {
    diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            category,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(source_id, span),
            message
        )
    );
}
