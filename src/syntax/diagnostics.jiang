// syntax 阶段的诊断 helper。
//
// lexer/parser 只说明当前语法错误的 code、span 和必要消息；这里统一补全
// DiagnosticCategory、DiagnosticCode 和 SourceRange。

import diagnostic = "../diagnostic/diagnostic.jiang";
import store_api = "../store/api.jiang";
import source = "../source/source.jiang";
import token = "./token.jiang";

public () add_lexer_error(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    token.Span span,
    UInt8[]& code
) {
    add_source_error(store, source_id, span, .lexer, code, code);
}

public () add_parse_error(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    token.Span span,
    UInt8[]& code
) {
    add_source_error(store, source_id, span, .parser, code, code);
}

public () add_parse_error_message(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    token.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    add_source_error(store, source_id, span, .parser, code, message);
}

() add_source_error(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    token.Span span,
    diagnostic.DiagnosticCategory category,
    UInt8[]& code,
    UInt8[]& message
) {
    store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            category,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(source_id, span),
            message
        )
    );
}
