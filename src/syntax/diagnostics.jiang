// syntax 阶段直接写 compiler DiagnosticStore 的 helper。

import diagnostic = "../diagnostic.jiang";
import qid = "../id.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import std;

public Void add_lexer_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_error(store, source_id, .lexer, span, code, code);
}

public Void add_parse_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_error(store, source_id, .parser, span, code, code);
}

public Void add_parse_error_message(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    add_error(store, source_id, .parser, span, code, message);
}

public Void add_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    diagnostic.DiagnosticCategory category,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    qid.SymbolId code_symbol = store.symbols.intern(code);
    UInt8[]& stable_code = store.symbols.text(code_symbol);
    store.diagnostics.add(diagnostic.Diagnostic(
        .error,
        category,
        diagnostic.DiagnosticCode(stable_code),
        diagnostic.SourceRange(source_id, span),
        message
    ));
}
