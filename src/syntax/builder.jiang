// Compiler-owned implementation of std.jiang.syntax.Builder.
//
// Lang providers build public syntax nodes into this store. The compiler keeps
// its own AstId/AstRange internally; provider output is converted before it
// reaches resolve, sema, or lowering. SymbolId is shared through the compiler
// store so names and literals do not need string round-trips.

import syntax_diagnostics = "./diagnostics.jiang";
import diagnostic = "../diagnostic.jiang";
import list = "../support/list.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import std;

@region(a, b)
public struct SyntaxBuilder: std.jiang.syntax.Builder, Movable {
    @life(a)
    store_api.CompilerStore& store;

    source.SourceId source_id;

    diagnostic.DiagnosticCategory diagnostic_category!;

    @life(b)
    std.jiang.syntax.Source syntax_source;

    list.ArrayList<std.jiang.syntax.Node> nodes;

    list.ArrayList<std.jiang.syntax.NodeId> children;

    list.ArrayList<std.jiang.Token> tokens;

    public init(self,
        store_api.CompilerStore& store,
        source.SourceId source_id,
        UInt8[]& bytes,
        diagnostic.DiagnosticCategory diagnostic_category
    ) {
        self.store = store;
        self.source_id = source_id;
        self.diagnostic_category = diagnostic_category;
        self.syntax_source = std.jiang.syntax.Source(std_source_id(source_id), bytes);
        self.nodes = list.ArrayList<std.jiang.syntax.Node>();
        self.children = list.ArrayList<std.jiang.syntax.NodeId>();
        self.tokens = list.ArrayList<std.jiang.Token>();
    }

    public std.jiang.syntax.NodeId add_node(Self&! self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.Data data
    ) {
        std.jiang.syntax.NodeId id = std.jiang.syntax.NodeId(self.nodes.len());
        self.nodes.add(std.jiang.syntax.Node(span, data));
        return id;
    }

    public Int mark_children(self) {
        return self.children.len();
    }

    public Void add_child(Self&! self, std.jiang.syntax.NodeId id) {
        self.children.add(id);
    }

    public std.jiang.syntax.Range take_children(Self&! self, Int start) {
        assert(start >= 0 && start <= self.children.len());
        return std.jiang.syntax.Range(start, self.children.len() - start);
    }

    public Int mark_tokens(self) {
        return self.tokens.len();
    }

    public Void add_token(Self&! self, std.jiang.Token value) {
        self.tokens.add(value);
    }

    public std.jiang.syntax.Range take_tokens(Self&! self, Int start) {
        assert(start >= 0 && start <= self.tokens.len());
        return std.jiang.syntax.Range(start, self.tokens.len() - start);
    }

    public std.jiang.Token token_at(self, Int index) {
        return self.tokens.get(index);
    }

    public std.jiang.syntax.SymbolId intern_symbol(Self&! self, UInt8[]& text) {
        return self.store.symbols.intern(text);
    }

    public Bool contains_node(self, std.jiang.syntax.NodeId id) {
        return id.to_index() >= 0 && id.to_index() < self.nodes.len();
    }

    public UInt8[]& symbol_text(self, std.jiang.syntax.SymbolId symbol) {
        return self.store.symbols.text(symbol);
    }

    public Void add_diagnostic(Self&! self, std.jiang.syntax.Diagnostic value) {
        syntax_diagnostics.add_syntax_diagnostic(
            self.store,
            self.source_id,
            self.diagnostic_category,
            value
        );
    }

    public Void add_error(Self&! self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        self.add_diagnostic(std.jiang.syntax.Diagnostic.error(span, code, message));
    }

    public Void set_diagnostic_category(Self&! self, diagnostic.DiagnosticCategory category) {
        self.diagnostic_category = category;
    }

    public std.jiang.syntax.Tree tree(self, std.jiang.syntax.NodeId root) {
        return std.jiang.syntax.Tree(
            self.syntax_source,
            self.nodes.slice(),
            self.children.slice(),
            root
        );
    }
}

public std.jiang.syntax.SourceId std_source_id(source.SourceId source_id) {
    return std.jiang.syntax.SourceId(source_id.to_index());
}
