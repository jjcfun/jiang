// Converts public std.jiang.syntax.Tree values into compiler-owned AST.
//
// Lang providers build the public tree. Resolve, sema, and lowering continue to
// consume src/syntax/ast so compiler internals can evolve independently.

import ast = "./ast.jiang";
import source = "../source/source.jiang";
import std;

public ast.AstUnit convert_tree(source.SourceId source_id, std.jiang.syntax.Tree& tree) {
    ast.AstUnit unit! = ast.AstUnit(source_id);
    ast.AstId root = convert_into(unit$.ref(), tree, tree.root);
    unit.root = root;
    return unit.take();
}

public ast.AstId convert_into(
    ast.AstUnit& unit,
    std.jiang.syntax.Tree& tree,
    std.jiang.syntax.NodeId root
) {
    Converter converter! = Converter(unit, tree);
    return converter.convert_node(root);
}

struct Converter: Movable {
    std.jiang.syntax.Tree& tree;

    ast.AstUnit& unit;

    init(self, ast.AstUnit& unit, std.jiang.syntax.Tree& tree) {
        self.unit = unit;
        self.tree = tree;
    }

    ast.AstId convert_node(self, std.jiang.syntax.NodeId id) {
        std.jiang.syntax.Node& node = self.tree.node(id);
        return self.convert_data(node.span, node.data);
    }

    ast.AstRange convert_range(self, std.jiang.syntax.Range range) {
        Int start! = self.unit.children.len();
        Int index! = 0;
        while (index < range.length) {
            self.unit.children.add(self.convert_node(self.tree.child_at(range, index)));
            index = index + 1;
        }
        return ast.AstRange(start, range.length);
    }

    ast.AstId add_node(self, std.jiang.syntax.Span span, ast.AstData data) {
        return self.unit.add_node(span, data$.move());
    }

    ast.AstId name_node(self, std.jiang.syntax.Span span, std.jiang.syntax.Name name) {
        return self.add_node(span, .name(ast.NameData(symbol_id: name.symbol)));
    }

    ast.AstId convert_data(self, std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        if (data is .root(root)) { return self.convert_root(span, root); }
        if (data is .top_level_declaration(decl)) { return self.convert_top_level_declaration(span, decl); }
        if (data is .member_declaration(decl)) { return self.convert_member_declaration(span, decl); }
        if (data is .item(item)) { return self.convert_item(span, item); }
        if (data is .member(member)) { return self.convert_member(span, member); }
        if (data is .path(path)) { return self.add_node(span, .path(ast.PathData(segments: self.convert_range(path.segments)))); }
        if (data is .statement(stmt)) { return self.convert_statement(span, stmt); }
        if (data is .expression(expr)) { return self.convert_expression(span, expr); }
        if (data is .type_reference(type_ref)) { return self.convert_type_reference(span, type_ref); }
        if (data is .pattern(pattern)) { return self.convert_pattern(span, pattern); }
        if (data is .generic_parameter(param)) { return self.convert_generic_parameter(span, param); }
        if (data is .constraint(constraint)) { return self.convert_constraint(span, constraint); }
        if (data is .attribute(attribute)) { return self.convert_attribute(span, attribute); }
        if (data is .path_segment(segment)) { return self.name_node(span, segment.name); }
        if (data is .function_parameter(param)) { return self.convert_function_parameter(span, param); }
        if (data is .field_declarator(field)) { return self.convert_field_declarator(span, field); }
        if (data is .extern_item(item)) { return self.convert_extern_item(span, item); }
        if (data is .switch_case(switch_case)) { return self.convert_switch_case(span, switch_case); }
        if (data is .catch_clause(catch_clause)) { return self.convert_catch_clause(span, catch_clause); }
        if (data is .call_argument(arg)) { return self.convert_call_argument(span, arg); }
        if (data is .field_initializer(field)) { return self.convert_field_initializer(span, field); }
        if (data is .inline_asm_operand(operand)) { return self.convert_inline_asm_operand(span, operand); }
        if (data is .inline_asm_clobber(clobber)) { return self.convert_inline_asm_clobber(span, clobber); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_root(self, std.jiang.syntax.Span span, std.jiang.syntax.Root root) {
        return self.add_node(span, .root(ast.RootData(items: self.convert_range(root.nodes))));
    }

    ast.AstId convert_top_level_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.TopLevelDeclaration decl
    ) {
        return self.add_node(span, .top_level_decl(ast.TopLevelDeclData(
            modifiers: ast.DeclModifiers(
                public_flag: decl.modifiers.public_flag,
                extern_kind: self.convert_extern_kind(decl.modifiers.extern_kind)
            ),
            annotations: self.convert_attribute_range(decl.attributes),
            body: self.convert_node(decl.body)
        )));
    }

    ast.ExternKind convert_extern_kind(self, std.jiang.syntax.ExternKind kind) {
        if (kind == .native) { return .native; }
        if (kind == .c_abi) { return .c_abi; }
        if (kind == .builtin) { return .builtin; }
        return .none;
    }

    ast.AstId convert_member_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.MemberDeclaration decl
    ) {
        return self.add_node(span, .member_decl(ast.MemberDeclData(
            modifiers: ast.MemberModifiers(
                visibility: self.convert_member_visibility(decl.modifiers.visibility),
                static_flag: decl.modifiers.static_flag
            ),
            annotations: self.convert_attribute_range(decl.attributes),
            body: self.convert_node(decl.body)
        )));
    }

    ast.MemberVisibilityModifier convert_member_visibility(self, std.jiang.syntax.MemberVisibility visibility) {
        if (visibility is .public_visibility(_)) {
            return .public_modifier(ast.MemberPublicAccess.all);
        }
        return .private_modifier;
    }

    ast.AstRange convert_attribute_range(self, std.jiang.syntax.Range range) {
        Int start! = self.unit.children.len();
        Int index! = 0;
        while (index < range.length) {
            std.jiang.syntax.Node& node = self.tree.node(self.tree.child_at(range, index));
            self.add_attribute_children(node.span, node.data);
            index = index + 1;
        }
        return ast.AstRange(start, self.unit.children.len() - start);
    }

    () add_attribute_children(self, std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        if (data is .attribute(attribute)) {
            if (attribute is .where_attribute(where_attr)) {
                self.add_range_children(where_attr.constraints);
                return;
            }
            if (attribute is .life_attribute(life_attr)) {
                self.add_range_children(life_attr.constraints);
                return;
            }
        }
        self.unit.children.add(self.convert_data(span, data));
    }

    () add_range_children(self, std.jiang.syntax.Range range) {
        Int index! = 0;
        while (index < range.length) {
            self.unit.children.add(self.convert_node(self.tree.child_at(range, index)));
            index = index + 1;
        }
    }

    ast.AstId? convert_generic_parameters(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.Range range
    ) {
        if (range.is_empty()) { return null; }
        return self.add_node(span, .generic_params(ast.GenericParamsData(
            type_params: self.convert_range(range)
        )));
    }

    ast.AstId convert_item(self, std.jiang.syntax.Span span, std.jiang.syntax.Item item) {
        if (item is .import_declaration(decl)) { return self.convert_import_declaration(span, decl); }
        if (item is .alias_declaration(decl)) { return self.convert_alias_declaration(span, decl); }
        if (item is .nominal_declaration(decl)) { return self.convert_nominal_declaration(span, decl); }
        if (item is .function_declaration(decl)) { return self.convert_function_declaration(span, decl); }
        if (item is .global_declaration(decl)) { return self.convert_global_declaration(span, decl); }
        if (item is .global_destructure_declaration(decl)) { return self.convert_global_destructure_declaration(span, decl); }
        if (item is .extend_declaration(decl)) { return self.convert_extend_declaration(span, decl); }
        if (item is .trait_declaration(decl)) { return self.convert_trait_declaration(span, decl); }
        if (item is .extern_block(block)) {
            return self.add_node(span, .extern_block(ast.ExternBlockData(
                extern_kind: .c_abi,
                items: self.convert_range(block.items)
            )));
        }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_member(self, std.jiang.syntax.Span span, std.jiang.syntax.Member member) {
        if (member is .field_declaration(decl)) { return self.convert_field_declaration(span, decl); }
        if (member is .enum_case(enum_case)) { return self.convert_enum_case(span, enum_case); }
        if (member is .typed_union_variants(variants)) { return self.convert_typed_union_variants(span, variants); }
        if (member is .function_declaration(decl)) { return self.convert_function_declaration(span, decl); }
        if (member is .initializer_declaration(decl)) { return self.convert_initializer_declaration(span, decl); }
        if (member is .deinitializer_declaration(decl)) {
            return self.add_node(span, .deinit_decl(ast.StmtData(value: self.convert_node(decl.body))));
        }
        if (member is .associated_type_declaration(decl)) { return self.convert_associated_type_declaration(span, decl); }
        if (member is .nominal_declaration(decl)) { return self.convert_nominal_declaration(span, decl); }
        if (member is .alias_declaration(decl)) { return self.convert_alias_declaration(span, decl); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_import_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.ImportDeclaration decl
    ) {
        ast.ImportKind kind! = ast.ImportKind.package_name;
        if (decl.kind == .string_path) { kind = ast.ImportKind.string_path; }
        return self.add_node(span, .import_decl(ast.ImportData(
            kind: kind,
            flatten: decl.flatten,
            alias_name: self.convert_optional(decl.alias_name),
            path: self.convert_node(decl.path)
        )));
    }

    ast.AstId convert_alias_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.AliasDeclaration decl
    ) {
        return self.add_node(span, .alias_decl(ast.AliasData(
            name: self.name_node(span, decl.name),
            target: self.convert_optional(decl.target)
        )));
    }

    ast.AstId convert_nominal_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.NominalDeclaration decl
    ) {
        return self.add_node(span, .nominal_decl(ast.NominalData(
            nominal_kind: self.convert_nominal_kind(decl.kind),
            name: self.name_node(span, decl.name),
            generics: self.convert_generic_parameters(span, decl.generic_parameters),
            enum_underlying_type: self.convert_optional(decl.enum_underlying_type),
            layout_options: ast.NominalLayoutOptions(
                packed: decl.layout_options.packed,
                align: decl.layout_options.align
            ),
            traits: self.convert_range(decl.traits),
            members: self.convert_range(decl.members)
        )));
    }

    ast.NominalKind convert_nominal_kind(self, std.jiang.syntax.NominalDeclaration.Kind kind) {
        if (kind == .enum_kind) { return ast.NominalKind.enum_kind; }
        if (kind == .union_kind) { return ast.NominalKind.union_kind; }
        return ast.NominalKind.struct_kind;
    }

    ast.AstId convert_function_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FunctionDeclaration decl
    ) {
        return self.add_node(span, .function_decl(ast.FunctionData(
            result_type: self.convert_node(decl.result_type),
            name: self.name_node(span, decl.name),
            generics: self.convert_generic_parameters(span, decl.generic_parameters),
            params: self.convert_range(decl.parameters),
            body: self.convert_optional(decl.body),
            effects: ast.EffectSet()
        )));
    }

    ast.AstId convert_function_parameter(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FunctionParameter param
    ) {
        return self.add_node(span, .param(ast.ParamData(
            type_ref: self.convert_node(param.type_reference),
            name: self.name_node(span, param.name),
            default_value: self.convert_optional(param.default_value),
            is_unique: false
        )));
    }

    ast.AstId convert_global_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.GlobalDeclaration decl
    ) {
        return self.add_node(span, .global_decl(ast.GlobalData(
            type_ref: self.convert_node(decl.type_reference),
            name: self.name_node(span, decl.name),
            is_const: decl.is_const,
            initializer: self.convert_optional(decl.initializer)
        )));
    }

    ast.AstId convert_global_destructure_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.GlobalDestructureDeclaration decl
    ) {
        return self.add_node(span, .global_destructure_decl(ast.GlobalDestructureData(
            bindings: self.convert_range(decl.bindings),
            initializer: self.convert_node(decl.initializer)
        )));
    }

    ast.AstId convert_extend_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.ExtendDeclaration decl
    ) {
        return self.add_node(span, .extend_decl(ast.ExtendData(
            generics: self.convert_generic_parameters(span, decl.generic_parameters),
            target_type: self.convert_node(decl.target_type),
            trait_path: self.convert_optional(decl.trait_path),
            members: self.convert_range(decl.members)
        )));
    }

    ast.AstId convert_trait_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.TraitDeclaration decl
    ) {
        return self.add_node(span, .trait_decl(ast.TraitData(
            name: self.name_node(span, decl.name),
            generics: self.convert_generic_parameters(span, decl.generic_parameters),
            parents: self.convert_range(decl.parents),
            has_body: decl.has_body,
            members: self.convert_range(decl.members)
        )));
    }

    ast.AstId convert_field_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FieldDeclaration decl
    ) {
        return self.add_node(span, .field_decl(ast.FieldData(
            type_ref: self.convert_node(decl.type_reference),
            fields: self.convert_range(decl.declarators)
        )));
    }

    ast.AstId convert_field_declarator(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FieldDeclarator field
    ) {
        return self.add_node(span, .field_declarator(ast.FieldDeclaratorData(
            name: self.name_node(span, field.name),
            default_value: self.convert_optional(field.default_value)
        )));
    }

    ast.AstId convert_enum_case(self, std.jiang.syntax.Span span, std.jiang.syntax.EnumCase enum_case) {
        return self.add_node(span, .enum_case(ast.EnumCaseData(
            name: self.name_node(span, enum_case.name),
            value: self.convert_optional(enum_case.value)
        )));
    }

    ast.AstId convert_typed_union_variants(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.TypedUnionVariants variants
    ) {
        return self.add_node(span, .typed_union_variants(ast.TypedUnionVariantsData(
            type_ref: self.convert_node(variants.type_reference),
            names: self.convert_range(variants.names)
        )));
    }

    ast.AstId convert_initializer_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.InitializerDeclaration decl
    ) {
        ast.AstId? name! = null;
        if (decl.name is .some(value)) { name = self.name_node(span, value); }
        return self.add_node(span, .init_decl(ast.InitData(
            failable: decl.failable,
            name: name,
            params: self.convert_range(decl.parameters),
            body: self.convert_node(decl.body)
        )));
    }

    ast.AstId convert_associated_type_declaration(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.AssociatedTypeDeclaration decl
    ) {
        return self.add_node(span, .assoc_type(ast.AssocTypeData(
            name: self.name_node(span, decl.name),
            value: self.convert_optional(decl.default_type),
            const_value: self.convert_optional(decl.default_value),
            is_const: decl.is_const,
            type_ref: self.convert_optional(decl.type_reference),
            constraints: self.convert_range(decl.constraints)
        )));
    }

    ast.AstId convert_extern_item(self, std.jiang.syntax.Span span, std.jiang.syntax.ExternItem item) {
        return self.add_node(span, .extern_item(ast.ExternItemData(
            modifiers: ast.MemberModifiers(
                visibility: self.convert_member_visibility(item.modifiers.visibility),
                static_flag: item.modifiers.static_flag
            ),
            body: self.convert_node(item.body)
        )));
    }

    ast.AstId convert_statement(self, std.jiang.syntax.Span span, std.jiang.syntax.Statement stmt) {
        if (stmt is .let_statement(let_stmt)) { return self.convert_let_statement(span, let_stmt); }
        if (stmt is .destructure_statement(destructure)) { return self.convert_destructure_statement(span, destructure); }
        if (stmt is .assignment_statement(assign)) { return self.convert_assignment_statement(span, assign); }
        if (stmt is .defer_statement(defer_stmt)) {
            return self.add_node(span, .defer_stmt(ast.StmtData(value: self.convert_node(defer_stmt.body))));
        }
        if (stmt is .expression_statement(expr_stmt)) {
            return self.add_node(span, .stmt(ast.StmtData(value: self.convert_node(expr_stmt.expression))));
        }
        if (stmt is .control_statement(control)) { return self.convert_control_statement(span, control); }
        if (stmt is .guard_statement(guard_stmt)) {
            return self.add_node(span, .guard_stmt(ast.GuardData(
                condition: self.convert_node(guard_stmt.condition),
                else_body: self.convert_node(guard_stmt.else_body)
            )));
        }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_let_statement(self, std.jiang.syntax.Span span, std.jiang.syntax.LetStatement stmt) {
        return self.add_node(span, .let_stmt(ast.LetData(
            type_ref: self.convert_optional(stmt.type_reference),
            name: self.name_node(span, stmt.name),
            initializer: self.convert_optional(stmt.initializer),
            mutable_binding: stmt.mutable_binding,
            borrow_binding: stmt.borrow_binding
        )));
    }

    ast.AstId convert_destructure_statement(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.DestructureStatement stmt
    ) {
        return self.add_node(span, .destructure_stmt(ast.GlobalDestructureData(
            bindings: self.convert_range(stmt.bindings),
            initializer: self.convert_node(stmt.initializer)
        )));
    }

    ast.AstId convert_assignment_statement(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.AssignmentStatement stmt
    ) {
        return self.add_node(span, .assign_stmt(ast.AssignData(
            op: self.convert_assign_operator(stmt.op),
            target: self.convert_node(stmt.destination),
            value: self.convert_node(stmt.value)
        )));
    }

    ast.AssignOp convert_assign_operator(self, std.jiang.syntax.AssignmentStatement.Operator op) {
        if (op == .plus_assign) { return ast.AssignOp.add_assign; }
        if (op == .minus_assign) { return ast.AssignOp.sub_assign; }
        if (op == .star_assign) { return ast.AssignOp.mul_assign; }
        if (op == .slash_assign) { return ast.AssignOp.div_assign; }
        if (op == .percent_assign) { return ast.AssignOp.mod_assign; }
        if (op == .amp_assign) { return ast.AssignOp.bit_and_assign; }
        if (op == .pipe_assign) { return ast.AssignOp.bit_or_assign; }
        if (op == .caret_assign) { return ast.AssignOp.bit_xor_assign; }
        if (op == .left_shift_assign) { return ast.AssignOp.shift_left_assign; }
        if (op == .right_shift_assign) { return ast.AssignOp.shift_right_assign; }
        return ast.AssignOp.assign;
    }

    ast.AstId convert_control_statement(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.ControlStatement stmt
    ) {
        return self.add_node(span, .control_stmt(ast.ControlStmtData(
            kind: self.convert_control_kind(stmt.kind),
            value: self.convert_optional(stmt.value)
        )));
    }

    ast.ControlStmtKind convert_control_kind(self, std.jiang.syntax.ControlStatement.Kind kind) {
        if (kind == .break_kind) { return ast.ControlStmtKind.break_loop; }
        if (kind == .continue_kind) { return ast.ControlStmtKind.continue_loop; }
        if (kind == .throw_kind) { return ast.ControlStmtKind.throw_value; }
        return ast.ControlStmtKind.return_value;
    }

    ast.AstId convert_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.Expression expr) {
        if (expr is .name(name)) { return self.convert_name_expression(span, name); }
        if (expr is .path(path)) { return self.convert_path_expression(span, path); }
        if (expr is .literal(literal)) { return self.convert_literal_expression(span, literal); }
        if (expr is .tuple(tuple)) { return self.add_node(span, .tuple_expr(self.convert_range(tuple.elements))); }
        if (expr is .array(array)) { return self.add_node(span, .array_expr(self.convert_range(array.elements))); }
        if (expr is .struct_literal(literal)) { return self.convert_struct_literal_expression(span, literal); }
        if (expr is .call(call)) { return self.convert_call_expression(span, call); }
        if (expr is .member(member)) { return self.convert_member_expression(span, member); }
        if (expr is .index(index)) { return self.convert_index_expression(span, index); }
        if (expr is .slice(slice)) { return self.convert_slice_expression(span, slice); }
        if (expr is .unary(unary)) { return self.convert_unary_expression(span, unary); }
        if (expr is .binary(binary)) { return self.convert_binary_expression(span, binary); }
        if (expr is .range(range)) { return self.convert_range_expression(span, range); }
        if (expr is .is_pattern(is_pattern)) { return self.convert_is_pattern_expression(span, is_pattern); }
        if (expr is .cast(cast)) { return self.convert_cast_expression(span, cast); }
        if (expr is .inline_asm(inline_asm)) { return self.convert_inline_asm_expression(span, inline_asm); }
        if (expr is .block(block)) { return self.convert_block_expression(span, block); }
        if (expr is .if_expression(if_expr)) { return self.convert_if_expression(span, if_expr); }
        if (expr is .loop(loop_expr)) { return self.convert_loop_expression(span, loop_expr); }
        if (expr is .switch_expression(switch_expr)) { return self.convert_switch_expression(span, switch_expr); }
        if (expr is .catch_expression(catch_expr)) { return self.convert_catch_expression(span, catch_expr); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_name_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.NameExpression expr) {
        ast.AstId name = self.name_node(span, expr.name);
        return self.add_node(span, .name_expr(ast.StmtData(value: name)));
    }

    ast.AstId convert_path_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.PathExpression expr) {
        ast.AstId path = self.convert_node(expr.path);
        return self.add_node(span, .name_expr(ast.StmtData(value: path)));
    }

    ast.AstId convert_literal_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.LiteralExpression expr) {
        return self.add_node(span, .literal(self.convert_literal(span, expr.literal)));
    }

    ast.AstId convert_struct_literal_expression(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.StructLiteralExpression expr
    ) {
        return self.add_node(span, .struct_literal(ast.StructLiteralData(
            type_ref: self.convert_optional(expr.type_reference),
            type_args: self.convert_range(expr.type_arguments),
            fields: self.convert_range(expr.fields)
        )));
    }

    ast.AstId convert_call_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.CallExpression expr) {
        return self.add_node(span, .call(ast.CallData(
            callee: self.convert_node(expr.callee),
            type_args: self.convert_range(expr.type_arguments),
            args: self.convert_range(expr.arguments)
        )));
    }

    ast.AstId convert_call_argument(self, std.jiang.syntax.Span span, std.jiang.syntax.CallArgument arg) {
        ast.AstId? label! = null;
        if (arg.name is .some(name)) { label = self.name_node(span, name); }
        return self.add_node(span, .call_arg(ast.CallArgData(label: label, value: self.convert_node(arg.value))));
    }

    ast.AstId convert_member_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.MemberExpression expr) {
        return self.add_node(span, .field_expr(ast.FieldExprData(
            base: self.convert_node(expr.base),
            name: self.name_node(span, expr.member),
            optional_chain: expr.optional_chain
        )));
    }

    ast.AstId convert_index_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.IndexExpression expr) {
        return self.add_node(span, .index_expr(ast.IndexExprData(
            base: self.convert_node(expr.base),
            index: self.convert_node(expr.index),
            optional_chain: expr.optional_chain
        )));
    }

    ast.AstId convert_slice_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.SliceExpression expr) {
        return self.add_node(span, .slice_expr(ast.SliceExprData(
            base: self.convert_node(expr.base),
            start: self.convert_optional(expr.start),
            end: self.convert_optional(expr.end),
            optional_chain: expr.optional_chain
        )));
    }

    ast.AstId convert_unary_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.UnaryExpression expr) {
        return self.add_node(span, .unary(ast.UnaryData(
            op: self.convert_unary_operator(expr.op),
            value: self.convert_node(expr.value)
        )));
    }

    ast.UnaryOp convert_unary_operator(self, std.jiang.syntax.UnaryExpression.Operator op) {
        if (op == .logical_not) { return ast.UnaryOp.not; }
        if (op == .bit_not) { return ast.UnaryOp.bit_not; }
        if (op == .ref || op == .mutable_ref) { return ast.UnaryOp.address_of; }
        if (op == .deref) { return ast.UnaryOp.deref; }
        if (op == .move_value) { return ast.UnaryOp.new_value; }
        return ast.UnaryOp.negate;
    }

    ast.AstId convert_binary_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.BinaryExpression expr) {
        return self.add_node(span, .binary(ast.BinaryData(
            op: self.convert_binary_operator(expr.op),
            left: self.convert_node(expr.left),
            right: self.convert_node(expr.right)
        )));
    }

    ast.BinaryOp convert_binary_operator(self, std.jiang.syntax.BinaryExpression.Operator op) {
        if (op == .subtract) { return ast.BinaryOp.sub; }
        if (op == .multiply) { return ast.BinaryOp.mul; }
        if (op == .divide) { return ast.BinaryOp.div; }
        if (op == .remainder) { return ast.BinaryOp.mod; }
        if (op == .bit_and) { return ast.BinaryOp.bit_and; }
        if (op == .bit_or) { return ast.BinaryOp.bit_or; }
        if (op == .bit_xor) { return ast.BinaryOp.bit_xor; }
        if (op == .left_shift) { return ast.BinaryOp.shift_left; }
        if (op == .right_shift) { return ast.BinaryOp.shift_right; }
        if (op == .equal) { return ast.BinaryOp.equal; }
        if (op == .not_equal) { return ast.BinaryOp.not_equal; }
        if (op == .less) { return ast.BinaryOp.less; }
        if (op == .less_equal) { return ast.BinaryOp.less_equal; }
        if (op == .greater) { return ast.BinaryOp.greater; }
        if (op == .greater_equal) { return ast.BinaryOp.greater_equal; }
        if (op == .logical_and) { return ast.BinaryOp.logic_and; }
        if (op == .logical_or) { return ast.BinaryOp.logic_or; }
        if (op == .coalesce) { return ast.BinaryOp.coalesce; }
        return ast.BinaryOp.add;
    }

    ast.AstId convert_range_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.RangeExpression expr) {
        return self.add_node(span, .range(ast.RangeData(
            start: self.convert_node(expr.start),
            end: self.convert_node(expr.end)
        )));
    }

    ast.AstId convert_is_pattern_expression(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.IsPatternExpression expr
    ) {
        return self.add_node(span, .is_pattern(ast.IsPatternData(
            value: self.convert_node(expr.value),
            pattern: self.convert_node(expr.pattern)
        )));
    }

    ast.AstId convert_cast_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.CastExpression expr) {
        return self.add_node(span, .cast_expr(ast.CastData(
            value: self.convert_node(expr.value),
            type_ref: self.convert_node(expr.type_reference)
        )));
    }

    ast.AstId convert_inline_asm_expression(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.InlineAsmExpression expr
    ) {
        return self.add_node(span, .inline_asm(ast.InlineAsmData(
            result_type: self.convert_node(expr.result_type),
            code_symbol: expr.code,
            operands: self.convert_range(expr.operands),
            clobbers: self.convert_range(expr.clobbers),
            options: ast.InlineAsmData.Options(
                volatile: expr.options.volatile,
                memory: expr.options.memory,
                noreturn: expr.options.noreturn
            )
        )));
    }

    ast.AstId convert_inline_asm_operand(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.InlineAsmExpression.Operand operand
    ) {
        if (operand is .input(input)) {
            return self.add_node(span, .inline_asm_operand(.input(ast.InlineAsmData.Input(
                name: input.name.symbol,
                constraint_symbol: input.constraint,
                value: self.convert_node(input.value)
            ))));
        }
        if (operand is .output(output)) {
            return self.add_node(span, .inline_asm_operand(.output(ast.InlineAsmData.Output(
                name: output.name.symbol,
                constraint_symbol: output.constraint,
                type_ref: self.convert_optional(output.type_reference)
            ))));
        }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_inline_asm_clobber(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.InlineAsmExpression.Clobber clobber
    ) {
        return self.add_node(span, .inline_asm_clobber(ast.InlineAsmData.Clobber(name: clobber.name)));
    }

    ast.AstId convert_block_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.BlockExpression expr) {
        return self.add_node(span, .block(ast.BlockData(
            effects: ast.EffectSet(),
            statements: self.convert_range(expr.statements),
            tail_expr: self.convert_optional(expr.tail_expression)
        )));
    }

    ast.AstId convert_if_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.IfExpression expr) {
        return self.add_node(span, .if_expr(ast.IfData(
            condition: self.convert_node(expr.condition),
            then_body: self.convert_node(expr.then_body),
            else_body: self.convert_optional(expr.else_body)
        )));
    }

    ast.AstId convert_loop_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.LoopExpression expr) {
        return self.add_node(span, .loop_expr(ast.LoopData(
            condition: self.convert_optional(expr.condition),
            pattern: self.convert_optional(expr.pattern),
            iterable: self.convert_optional(expr.iterable),
            body: self.convert_node(expr.body)
        )));
    }

    ast.AstId convert_switch_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.SwitchExpression expr) {
        return self.add_node(span, .switch_expr(ast.SwitchData(
            value: self.convert_node(expr.value),
            cases: self.convert_range(expr.cases)
        )));
    }

    ast.AstId convert_switch_case(self, std.jiang.syntax.Span span, std.jiang.syntax.SwitchCase switch_case) {
        return self.add_node(span, .switch_case(ast.SwitchCaseData(
            patterns: self.convert_range(switch_case.patterns),
            body: self.convert_node(switch_case.body)
        )));
    }

    ast.AstId convert_catch_expression(self, std.jiang.syntax.Span span, std.jiang.syntax.CatchExpression expr) {
        return self.add_node(span, .catch_expr(ast.CatchExprData(
            value: self.convert_node(expr.value),
            catch_clause: self.convert_node(expr.catch_clause)
        )));
    }

    ast.AstId convert_catch_clause(self, std.jiang.syntax.Span span, std.jiang.syntax.CatchClause catch_clause) {
        return self.add_node(span, .catch_clause(ast.CatchClauseData(
            pattern: self.convert_optional(catch_clause.pattern),
            body: self.convert_node(catch_clause.body)
        )));
    }

    ast.AstId convert_type_reference(self, std.jiang.syntax.Span span, std.jiang.syntax.TypeReference type_ref) {
        if (type_ref is .infer) { return self.add_node(span, .infer_type); }
        if (type_ref is .unit) { return self.add_node(span, .unit_type); }
        if (type_ref is .named(named)) { return self.convert_named_type_reference(span, named); }
        if (type_ref is .tuple(tuple)) { return self.add_node(span, .tuple_type(self.convert_range(tuple.elements))); }
        if (type_ref is .array(array)) { return self.convert_array_type_reference(span, array); }
        if (type_ref is .function(function)) { return self.convert_function_type_reference(span, function); }
        if (type_ref is .layered(layered)) { return self.convert_layered_type_reference(span, layered); }
        if (type_ref is .errorable(errorable)) { return self.convert_errorable_type_reference(span, errorable); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_named_type_reference(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.NamedTypeReference type_ref
    ) {
        return self.add_node(span, .named_type(ast.NamedTypeData(
            path: self.convert_node(type_ref.path),
            args: self.convert_range(type_ref.arguments)
        )));
    }

    ast.AstId convert_array_type_reference(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.ArrayTypeReference type_ref
    ) {
        ast.ArrayTypeData data! = ast.ArrayTypeData(
            element: self.convert_node(type_ref.element),
            count_kind: self.convert_array_count_kind(type_ref.count),
            count_span: span,
            count_symbol_id: self.array_count_symbol(type_ref.count),
            sentinel_kind: self.convert_type_sentinel_kind(type_ref.sentinel),
            sentinel_span: span,
            sentinel_symbol_id: self.type_sentinel_symbol(type_ref.sentinel)
        );
        return self.add_node(span, .array_type(data));
    }

    ast.ArrayCountKind convert_array_count_kind(self, std.jiang.syntax.ArrayCount count) {
        if (count is .int_literal(_)) { return ast.ArrayCountKind.int_lit; }
        if (count is .const_name(_)) { return ast.ArrayCountKind.const_name; }
        return ast.ArrayCountKind.inferred;
    }

    std.jiang.syntax.SymbolId? array_count_symbol(self, std.jiang.syntax.ArrayCount count) {
        if (count is .int_literal(literal)) { return literal.symbol; }
        if (count is .const_name(name)) { return name.symbol; }
        return null;
    }

    ast.AstId convert_function_type_reference(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FunctionTypeReference type_ref
    ) {
        return self.add_node(span, .function_type(ast.FunctionTypeData(
            params: self.convert_range(type_ref.parameters),
            result: self.convert_node(type_ref.result),
            effects: ast.EffectSet()
        )));
    }

    ast.AstId convert_layered_type_reference(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.LayeredTypeReference type_ref
    ) {
        return self.add_node(span, .type_ref(ast.TypeData(
            base: self.convert_node(type_ref.base),
            layer: self.convert_type_layer(type_ref.layer),
            sentinel_kind: self.convert_type_sentinel_kind(type_ref.sentinel),
            sentinel_span: span,
            sentinel_symbol_id: self.type_sentinel_symbol(type_ref.sentinel)
        )));
    }

    ast.TypeLayerKind convert_type_layer(self, std.jiang.syntax.LayeredTypeReference.Layer layer) {
        if (layer == .mutable_type) { return ast.TypeLayerKind.mutable_type; }
        if (layer == .reference) { return ast.TypeLayerKind.reference; }
        if (layer == .owner_pointer) { return ast.TypeLayerKind.owner_pointer; }
        if (layer == .raw_pointer) { return ast.TypeLayerKind.raw_pointer; }
        if (layer == .many_pointer) { return ast.TypeLayerKind.many_pointer; }
        if (layer == .slice) { return ast.TypeLayerKind.slice; }
        return ast.TypeLayerKind.optional;
    }

    ast.TypeSentinelKind convert_type_sentinel_kind(self, std.jiang.syntax.TypeSentinel sentinel) {
        if (sentinel is .literal(literal)) {
            if (literal is .char_literal(_)) { return ast.TypeSentinelKind.char_value; }
            if (literal is .bool_literal(value)) {
                if (value.value) { return ast.TypeSentinelKind.bool_true; }
                return ast.TypeSentinelKind.bool_false;
            }
            return ast.TypeSentinelKind.value;
        }
        if (sentinel is .const_name(_)) { return ast.TypeSentinelKind.const_name; }
        if (sentinel is .wildcard) { return ast.TypeSentinelKind.wildcard; }
        return ast.TypeSentinelKind.none;
    }

    std.jiang.syntax.SymbolId? type_sentinel_symbol(self, std.jiang.syntax.TypeSentinel sentinel) {
        if (sentinel is .literal(literal)) { return self.literal_symbol(literal); }
        if (sentinel is .const_name(name)) { return name.symbol; }
        return null;
    }

    ast.AstId convert_errorable_type_reference(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.ErrorableTypeReference type_ref
    ) {
        return self.add_node(span, .errorable_type(ast.ErrorableTypeData(
            value_type: self.convert_node(type_ref.value_type),
            error_type: self.convert_optional(type_ref.error_type)
        )));
    }

    ast.AstId convert_pattern(self, std.jiang.syntax.Span span, std.jiang.syntax.Pattern pattern) {
        if (pattern is .name(name)) { return self.convert_name_pattern(span, name); }
        if (pattern is .literal(literal)) { return self.convert_literal_pattern(span, literal); }
        if (pattern is .tuple(tuple)) { return self.convert_tuple_pattern(span, tuple); }
        if (pattern is .variant(variant)) { return self.convert_variant_pattern(span, variant); }
        if (pattern is .optional_some(optional)) { return self.convert_optional_some_pattern(span, optional); }
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: null,
            value: null,
            optional_pattern: false,
            dot_prefix: false,
            mutable_binding: false,
            borrow_binding: false,
            payload: ast.AstRange(self.unit.children.len(), 0)
        )));
    }

    ast.AstId convert_name_pattern(self, std.jiang.syntax.Span span, std.jiang.syntax.NamePattern pattern) {
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: self.name_node(span, pattern.name),
            value: null,
            optional_pattern: false,
            dot_prefix: false,
            mutable_binding: pattern.mutable_binding,
            borrow_binding: pattern.borrowed_binding,
            payload: ast.AstRange(self.unit.children.len(), 0)
        )));
    }

    ast.AstId convert_literal_pattern(self, std.jiang.syntax.Span span, std.jiang.syntax.LiteralPattern pattern) {
        ast.AstId literal = self.add_node(span, .literal(self.convert_literal(span, pattern.literal)));
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: null,
            value: literal,
            optional_pattern: false,
            dot_prefix: false,
            mutable_binding: false,
            borrow_binding: false,
            payload: ast.AstRange(self.unit.children.len(), 0)
        )));
    }

    ast.AstId convert_tuple_pattern(self, std.jiang.syntax.Span span, std.jiang.syntax.TuplePattern pattern) {
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: null,
            value: null,
            optional_pattern: false,
            dot_prefix: false,
            mutable_binding: false,
            borrow_binding: false,
            payload: self.convert_range(pattern.elements)
        )));
    }

    ast.AstId convert_variant_pattern(self, std.jiang.syntax.Span span, std.jiang.syntax.VariantPattern pattern) {
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: self.convert_node(pattern.path),
            value: null,
            optional_pattern: false,
            dot_prefix: false,
            mutable_binding: false,
            borrow_binding: false,
            payload: self.convert_range(pattern.payloads)
        )));
    }

    ast.AstId convert_optional_some_pattern(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.OptionalSomePattern pattern
    ) {
        Int start! = self.unit.children.len();
        self.unit.children.add(self.convert_node(pattern.payload));
        return self.add_node(span, .pattern(ast.PatternData(
            type_ref: null,
            name: null,
            value: null,
            optional_pattern: true,
            dot_prefix: false,
            mutable_binding: false,
            borrow_binding: false,
            payload: ast.AstRange(start, 1)
        )));
    }

    ast.AstId convert_generic_parameter(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.GenericParameter param
    ) {
        return self.add_node(span, .generic_param(ast.GenericParamData(
            is_const: param.is_const,
            type_ref: self.convert_optional(param.type_reference),
            type_bound: self.convert_optional(param.type_bound),
            name: self.name_node(span, param.name)
        )));
    }

    ast.AstId convert_constraint(self, std.jiang.syntax.Span span, std.jiang.syntax.Constraint constraint) {
        if (constraint is .const_type(constraint)) {
            return self.add_node(span, .where_const(ast.WhereConstData(
                param: self.convert_node(constraint.parameter),
                type_ref: self.convert_node(constraint.type_reference)
            )));
        }
        if (constraint is .type_bound(bound)) {
            return self.add_node(span, .where_type_bound(ast.WhereTypeBoundData(
                param: self.convert_node(bound.target_type),
                bound: self.convert_node(bound.bound)
            )));
        }
        if (constraint is .type_equal(equal)) {
            return self.add_node(span, .where_equal(ast.WhereEqualData(
                param: self.convert_node(equal.left),
                value: self.convert_node(equal.right)
            )));
        }
        if (constraint is .type_not_equal(not_equal)) {
            return self.add_node(span, .where_not_equal(ast.WhereEqualData(
                param: self.convert_node(not_equal.left),
                value: self.convert_node(not_equal.right)
            )));
        }
        if (constraint is .projection_equal(equal)) {
            return self.add_node(span, .where_projection_equal(ast.WhereProjectionEqualData(
                param: self.convert_node(equal.target_type),
                trait_path: self.convert_node(equal.trait_path),
                assoc_name: self.name_node(span, equal.associated_type),
                value: self.convert_node(equal.value)
            )));
        }
        if (constraint is .lifetime(lifetime)) { return self.convert_lifetime_constraint(span, lifetime); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_lifetime_constraint(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.LifetimeConstraint constraint
    ) {
        return self.add_node(span, .lifetime_constraint(ast.LifetimeConstraintData(
            longer: self.lifetime_name_node(span, constraint.longer),
            shorter: self.lifetime_name_node(span, constraint.shorter)
        )));
    }

    ast.AstId convert_attribute(self, std.jiang.syntax.Span span, std.jiang.syntax.Attribute attribute) {
        if (attribute is .inline_attribute(inline_attr)) {
            return self.add_node(span, .inline_attribute(ast.InlineAttributeData(always: inline_attr.always)));
        }
        if (attribute is .naked_attribute(_)) {
            return self.add_node(span, .naked_attribute(ast.NakedAttributeData()));
        }
        if (attribute is .link_symbol_attribute(link_symbol)) {
            return self.add_node(span, .link_symbol_attribute(ast.LinkSymbolAttributeData(
                symbol_id: link_symbol.symbol
            )));
        }
        if (attribute is .self_attribute(self_attr)) {
            return self.add_node(span, .self_attribute(ast.SelfAttributeData(
                mode: self.convert_self_receiver_mode(self_attr.mode)
            )));
        }
        if (attribute is .where_attribute(where_attr)) {
            return self.add_node(span, .type_bound_intersection(ast.TypeBoundIntersectionData(
                left: self.range_or_unit(span, where_attr.constraints, 0),
                right: self.range_or_unit(span, where_attr.constraints, 1)
            )));
        }
        if (attribute is .life_attribute(life_attr)) {
            return self.add_node(span, .type_bound_intersection(ast.TypeBoundIntersectionData(
                left: self.range_or_unit(span, life_attr.constraints, 0),
                right: self.range_or_unit(span, life_attr.constraints, 1)
            )));
        }
        return self.add_node(span, .unit_type);
    }

    ast.SelfReceiverMode convert_self_receiver_mode(self, std.jiang.syntax.SelfAttribute.ReceiverMode mode) {
        if (mode == .move_receiver) { return ast.SelfReceiverMode.move_receiver; }
        if (mode == .unique_receiver) { return ast.SelfReceiverMode.unique_receiver; }
        return ast.SelfReceiverMode.ref_receiver;
    }

    ast.AstId range_or_unit(self, std.jiang.syntax.Span span, std.jiang.syntax.Range range, Int offset) {
        if (offset < range.length) { return self.convert_node(self.tree.child_at(range, offset)); }
        return self.add_node(span, .unit_type);
    }

    ast.AstId convert_field_initializer(self,
        std.jiang.syntax.Span span,
        std.jiang.syntax.FieldInitializer field
    ) {
        return self.add_node(span, .field_init(ast.FieldInitData(
            name: self.name_node(span, field.name),
            value: self.convert_node(field.value)
        )));
    }

    ast.AstId lifetime_name_node(self, std.jiang.syntax.Span span, std.jiang.syntax.LifetimeName name) {
        if (name is .named(value)) {
            return self.add_node(span, .lifetime_name(ast.LifetimeNameData(
                kind: ast.LifetimeNameKind.named_lifetime,
                symbol_id: value.symbol
            )));
        }
        if (name is .return_lifetime) {
            return self.add_node(span, .lifetime_name(ast.LifetimeNameData(
                kind: ast.LifetimeNameKind.return_lifetime,
                symbol_id: null
            )));
        }
        return self.add_node(span, .lifetime_name(ast.LifetimeNameData(
            kind: ast.LifetimeNameKind.self_lifetime,
            symbol_id: null
        )));
    }

    ast.LiteralData convert_literal(self, std.jiang.syntax.Span span, std.jiang.syntax.Literal literal) {
        if (literal is .int_literal(value)) {
            return ast.LiteralData(kind: .int_lit, bool_value: false, symbol_id: value.symbol);
        }
        if (literal is .float_literal(value)) {
            return ast.LiteralData(kind: .float_lit, bool_value: false, symbol_id: value.symbol);
        }
        if (literal is .char_literal(value)) {
            return ast.LiteralData(kind: .char_lit, bool_value: false, symbol_id: value.symbol);
        }
        if (literal is .string_literal(value)) {
            return ast.LiteralData(kind: .string_lit, bool_value: false, symbol_id: value.symbol);
        }
        if (literal is .bool_literal(value)) {
            return ast.LiteralData(kind: .bool_lit, bool_value: value.value, symbol_id: null);
        }
        return ast.LiteralData(kind: .null_lit, bool_value: false, symbol_id: null);
    }

    std.jiang.syntax.SymbolId? literal_symbol(self, std.jiang.syntax.Literal literal) {
        if (literal is .int_literal(value)) { return value.symbol; }
        if (literal is .float_literal(value)) { return value.symbol; }
        if (literal is .char_literal(value)) { return value.symbol; }
        if (literal is .string_literal(value)) { return value.symbol; }
        return null;
    }

    ast.AstId? convert_optional(self, std.jiang.syntax.NodeId? id) {
        if (id is .some(value)) { return self.convert_node(value); }
        return null;
    }
}
