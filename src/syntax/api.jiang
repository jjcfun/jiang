// Public syntax-stage API.
//
// This module is the boundary that wires lexer and parser together. Callers
// that need a parsed source file should use this instead of constructing the
// lexer and parser separately.

import ast = "./ast.jiang";
import error = "./error.jiang";
import lexer = "./lexer.jiang";
import parser = "./parser.jiang";
import token = "./token.jiang";
import list = "../support/list.jiang";
import context = "../context.jiang";

public struct SyntaxResult {
    public ast.AstFile file;
    public list.ArrayList<token.Token> tokens;
    public list.ArrayList<error.LexError> lex_errors;
    public list.ArrayList<error.ParseError> parse_errors;

    public init(
        ast.AstFile file,
        list.ArrayList<token.Token> tokens,
        list.ArrayList<error.LexError> lex_errors,
        list.ArrayList<error.ParseError> parse_errors,
    ) {
        self.file = file;
        self.tokens = tokens;
        self.lex_errors = lex_errors;
        self.parse_errors = parse_errors;
    }

    public Bool has_errors() {
        return self.lex_errors.len() > 0 || self.parse_errors.len() > 0;
    }
}

public SyntaxResult parse_source(context.CompilerContext& ctx, UInt8[] text, ast.AstSource source) {
    lexer.Lexer lex = lexer.Lexer(ctx.query$.ref(), text);
    lexer.LexResult lexed = lex.tokenize();

    parser.Parser p = parser.Parser(ctx.query$.ref(), lexed.tokens, source);
    parser.ParseResult parsed = p.parse();

    return SyntaxResult(parsed.file, lexed.tokens, lexed.errors, parsed.errors);
}
