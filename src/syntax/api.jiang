// Public syntax-stage API.
//
// This file is the boundary that wires lexer and parser together. Callers
// that need a parsed source unit should use this instead of constructing the
// lexer and parser separately.

import ast = "./ast.jiang";
import lexer = "./lexer.jiang";
import parser = "./parser.jiang";
import token = "./token.jiang";
import list = "../support/list.jiang";
import context = "../context.jiang";
import source = "../source/source.jiang";

public struct SyntaxResult: Movable {
    public ast.AstUnit unit;
    public list.ArrayList<token.Token> tokens;
    public Int diagnostic_start;
    public Int diagnostic_end;

    public init(
        ast.AstUnit unit,
        list.ArrayList<token.Token> tokens,
        Int diagnostic_start,
        Int diagnostic_end,
    ) {
        self.unit = unit$.move();
        self.tokens = tokens$.move();
        self.diagnostic_start = diagnostic_start;
        self.diagnostic_end = diagnostic_end;
    }

    public Bool has_errors() {
        return self.diagnostic_end > self.diagnostic_start;
    }

    public ast.AstUnit take_unit() {
        return self.unit.take();
    }
}

public SyntaxResult parse_source(context.CompilerContext& ctx, UInt8[] text, source.SourceId source_id) {
    Int diagnostic_start = ctx.store.diagnostics.len();
    lexer.Lexer! lex = lexer.Lexer(ctx.store$.ref(), text, source_id);
    lexer.LexResult! lexed = lex.tokenize();

    parser.ParseResult! parsed = parser.parse_tokens(ctx.store$.ref(), lexed.tokens$.ref(), source_id);

    return SyntaxResult(parsed.take_unit(), lexed.take_tokens(), diagnostic_start, ctx.store.diagnostics.len());
}
