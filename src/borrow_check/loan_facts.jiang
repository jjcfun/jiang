// Active loan facts 的小型容器。
//
// 这里不理解 move path 的父子关系，只负责保存、去重和顺序访问。
// 祖先/后代匹配仍由 FunctionBorrowChecker 基于 MovePathTree 判断。

import loan = "./loan.jiang";
import move_path = "./move_path.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";

public struct ActiveLoanFact: Copyable {
    public move_path.MovePathId target;
    public loan.LoanId loan_id;

    public init(self, move_path.MovePathId target, loan.LoanId loan_id) {
        self.target = target;
        self.loan_id = loan_id;
    }
}

struct ActiveLoanFactKey: Copyable, Hashable, Equatable {
    Int target;
    Int loan;

    init(self, ActiveLoanFact fact) {
        self.target = fact.target.to_index();
        self.loan = fact.loan_id.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(self.target);
        hasher.write(self.loan);
    }

    public Bool equal(ActiveLoanFactKey& lhs, ActiveLoanFactKey& rhs) {
        return lhs.target == rhs.target && lhs.loan == rhs.loan;
    }
}

public struct ActiveLoanFacts: Movable {
    public list.ArrayList<ActiveLoanFact> facts!;
    map.WyHashMap<ActiveLoanFactKey, Bool> exact!;

    public init(self) {
        self.facts = list.ArrayList<ActiveLoanFact>();
        self.exact = map.WyHashMap<ActiveLoanFactKey, Bool>();
    }

    public init(self, Int capacity) {
        self.facts = list.ArrayList<ActiveLoanFact>(capacity);
        self.exact = map.WyHashMap<ActiveLoanFactKey, Bool>();
        self.exact.reserve(capacity);
    }

    public Int len(self) {
        return self.facts.len();
    }

    public ActiveLoanFact get(self, Int index) {
        return self.facts.get(index);
    }

    public ActiveLoanFacts duplicate(self) {
        ActiveLoanFacts result! = ActiveLoanFacts(self.facts.len());
        Int index! = 0;
        while (index < self.facts.len()) {
            result.add(self.facts.get(index));
            index = index + 1;
        }
        return result;
    }

    public Bool add(Self&! self, ActiveLoanFact fact) {
        ActiveLoanFactKey key = ActiveLoanFactKey(fact);
        if (self.exact.has(key)) { return false; }
        self.facts.add(fact);
        self.exact.set(key, true);
        return true;
    }

    public Bool has_exact(self, move_path.MovePathId target, loan.LoanId loan_id) {
        return self.exact.has(ActiveLoanFactKey(ActiveLoanFact(target, loan_id)));
    }

    public loan.LoanId? first_exact(self, move_path.MovePathId target) {
        Int index! = 0;
        while (index < self.facts.len()) {
            ActiveLoanFact fact = self.facts.get(index);
            if (fact.target == target) {
                return fact.loan_id;
            }
            index = index + 1;
        }
        return null;
    }
}
