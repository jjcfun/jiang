// Active loan facts 的小型容器。
//
// 这里不理解 move path 的父子关系，只负责保存、去重和顺序访问。
// 祖先/后代匹配仍由 FunctionBorrowChecker 基于 MovePathTree 判断。

import loan = "./loan.jiang";
import move_path = "./move_path.jiang";
import list = "../support/list.jiang";

public struct ActiveLoanFact {
    public move_path.MovePathId target;
    public loan.LoanId loan_id;

    public init(move_path.MovePathId target, loan.LoanId loan_id) {
        self.target = target;
        self.loan_id = loan_id;
    }
}

public struct ActiveLoanFacts: Movable {
    public list.ArrayList<ActiveLoanFact>! facts;

    public init() {
        self.facts = list.ArrayList<ActiveLoanFact>();
    }

    public init(Int capacity) {
        self.facts = list.ArrayList<ActiveLoanFact>(capacity);
    }

    public Int len() {
        return self.facts.len();
    }

    public ActiveLoanFact get(Int index) {
        return self.facts.get(index);
    }

    public Bool add(ActiveLoanFact fact) {
        if (self.has_exact(fact.target, fact.loan_id)) {
            return false;
        }
        self.facts.add(fact);
        return true;
    }

    public Bool has_exact(move_path.MovePathId target, loan.LoanId loan_id) {
        Int! index = 0;
        while (index < self.facts.len()) {
            ActiveLoanFact fact = self.facts.get(index);
            if (fact.target == target && fact.loan_id.to_index() == loan_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public loan.LoanId? first_exact(move_path.MovePathId target) {
        Int! index = 0;
        while (index < self.facts.len()) {
            ActiveLoanFact fact = self.facts.get(index);
            if (fact.target == target) {
                return fact.loan_id;
            }
            index = index + 1;
        }
        return null;
    }
}
