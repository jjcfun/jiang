// 返回值 lifetime 推断与显式约束校验。
//
// Borrow checker 会把 active loan 的来源解析成参数符号；这里只判断这些
// 来源是否能通过默认唯一来源规则，或被显式 @life(... > return) 覆盖。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import list = "../support/list.jiang";

public enum ReturnLifetimeStatus {
    allowed,
    needs_explicit_lifetime,
    source_not_allowed,
}

public struct ReturnLifetimeChecker: Movable {
    public context.CompilerContext& ctx;
    public qid.DefId function_def;
    public list.ArrayList<qid.SymbolId>! sources;

    public init(context.CompilerContext& ctx, qid.DefId function_def) {
        self.ctx = ctx;
        self.function_def = function_def;
        self.sources = list.ArrayList<qid.SymbolId>();
    }

    public ReturnLifetimeStatus check_source(qid.SymbolId source_symbol) {
        self.add_source(source_symbol);
        guard self.ctx.store.hirs.def(self.function_def) is .some(hir_def) else {
            return .source_not_allowed;
        }
        if (self.hir_has_explicit_return_lifetime(hir_def)) {
            if (self.hir_allows_all_sources(hir_def)) {
                return .allowed;
            }
            return .source_not_allowed;
        }
        if (self.sources.len() == 1) {
            return .allowed;
        }
        return .needs_explicit_lifetime;
    }

    Bool add_source(qid.SymbolId source_symbol) {
        if (self.has_source(source_symbol)) {
            return false;
        }
        self.sources.add(source_symbol);
        return true;
    }

    Bool has_source(qid.SymbolId source_symbol) {
        Int! index = 0;
        while (index < self.sources.len()) {
            qid.SymbolId existing = self.sources.get(index);
            if (existing == source_symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool hir_has_explicit_return_lifetime(hir.HirDef& hir_def) {
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            if (constraint.shorter.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool hir_allows_all_sources(hir.HirDef& hir_def) {
        Int! index = 0;
        while (index < self.sources.len()) {
            qid.SymbolId source_symbol = self.sources.get(index);
            if (!self.hir_allows_source(hir_def, source_symbol)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool hir_allows_source(hir.HirDef& hir_def, qid.SymbolId source_symbol) {
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            if (self.is_return_lifetime_constraint(constraint, source_symbol)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool is_return_lifetime_constraint(hir.HirLifetimeConstraint constraint, qid.SymbolId source_symbol) {
        if (constraint.shorter.kind != .return_lifetime) {
            return false;
        }
        if (constraint.longer.kind == .self_lifetime) {
            return self.source_symbol_is_self(source_symbol);
        }
        if (constraint.longer.kind != .named_lifetime) { return false; }
        guard constraint.longer.symbol is .some(longer_symbol) else {
            return false;
        }
        return longer_symbol == source_symbol;
    }

    Bool source_symbol_is_self(qid.SymbolId source_symbol) {
        qid.SymbolId self_symbol = self.ctx.store.symbols.intern("self");
        return source_symbol == self_symbol;
    }
}
