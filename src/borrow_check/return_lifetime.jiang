// 返回值 lifetime 推断与显式约束校验。
//
// Borrow checker 会把 active loan 的来源解析成参数符号；这里只判断来源
// 是否符合由函数签名确定的显式或隐式 lifetime contract。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import types = "../sema/type.jiang";

public enum ReturnLifetimeStatus {
    allowed,
    source_not_allowed,
}

public struct ReturnLifetimeChecker: Movable {
    public context.CompilerContext& ctx;
    public qid.DefId function_def;

    public init(self, context.CompilerContext& ctx, qid.DefId function_def) {
        self.ctx = ctx;
        self.function_def = function_def;
    }

    public ReturnLifetimeStatus check_source(self, Bool semantic_contract_matches) {
        if (semantic_contract_matches) { return .allowed; }
        return .source_not_allowed;
    }

    public Int? source_param_index(self, qid.SymbolId source_symbol) {
        guard self.ctx.store.hirs.def(self.function_def) is .some(hir_def) else { return null; }
        guard self.ctx.store.typeck.def_type(self.function_def) is .some(type_id) else {
            return null;
        }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return null; }
        return self.function_source_param_index(hir_def, function_type, source_symbol);
    }

    Int? function_source_param_index(
        self,
        hir.HirDef& hir_def,
        types.FunctionType function_type,
        qid.SymbolId source_symbol
    ) {
        if (hir_def.decl.is_lambda_function) {
            return self.lambda_source_param_index(hir_def, function_type, source_symbol);
        }
        guard hir_def.decl.function_signature is .some(signature) else { return null; }
        if (signature.has_receiver && self.source_symbol_is_self(source_symbol)) { return 0; }
        Int offset! = 0;
        if (signature.has_receiver) { offset = 1; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == source_symbol) { return index + offset; }
            index = index + 1;
        }
        return null;
    }

    Int? lambda_source_param_index(
        self,
        hir.HirDef& hir_def,
        types.FunctionType function_type,
        qid.SymbolId source_symbol
    ) {
        guard hir_def.body is .some(ref _ body) else { return null; }
        Int param_count! = 0;
        Int source_ordinal! = -1;
        Int local_index! = 0;
        while (local_index < body.locals.len()) {
            hir.HirLocal local = body.locals.get(hir.HirLocalId(local_index));
            if (local.kind == .parameter) {
                if (local.symbol == source_symbol) { source_ordinal = param_count; }
                param_count = param_count + 1;
            }
            local_index = local_index + 1;
        }
        if (source_ordinal < 0) { return null; }
        if (function_type.params.length > param_count) { return source_ordinal + 1; }
        return source_ordinal;
    }

    Bool source_symbol_is_self(self, qid.SymbolId source_symbol) {
        qid.SymbolId self_symbol = self.ctx.store.symbols.intern("self");
        return source_symbol == self_symbol;
    }
}
