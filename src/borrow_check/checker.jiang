// Borrow check 的函数体检查器。
//
// 当前先实现 move/use 的基础语义：MIR operand 读 place 时，根据类型决定
// 是 implicit copy 还是 move；move 后再次读取同一个 move path、祖先 path
// 或子 path 都会把 BorrowCheckStore 标成失败。完整 CFG dataflow 后续会
// 在这里替换线性扫描状态，而不是改 MIR 结构。

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import mir = "../mir/mir.jiang";
import qid = "../store/id.jiang";
import copy_semantics = "../sema/copy.jiang";
import drop_semantics = "../sema/drop.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import loan = "./loan.jiang";
import location = "./location.jiang";
import move_path = "./move_path.jiang";
import borrow_store = "./store.jiang";
import carry = "./carry.jiang";
import loan_facts = "./loan_facts.jiang";
import return_lifetime = "./return_lifetime.jiang";

public struct PackageBorrowChecker {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;
    public layout.LayoutStore& layouts;
    public borrow_store.BorrowCheckStore& results;
    public init(self,
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
    }

    public () check_store(self, mir.MirStore& store) {
        Int! index = 0;
        while (index < store.functions.len()) {
            self.check_function(store.functions.get(index));
            index = index + 1;
        }
    }

    () check_function(self, mir.MirFunction function) {
        FunctionBorrowChecker! checker = FunctionBorrowChecker(
            self.ctx,
            self.typeck,
            self.layouts,
            self.results,
            function
        );
        checker.check();
    }
}

struct BorrowDataflowState: Movable {
    public table.HashTable<move_path.MovePathId, Bool>! moved;
    public loan_facts.ActiveLoanFacts! active_loans;
    public table.HashTable<move_path.MovePathId, Bool>! live_locals;

    public init(self) {
        self.moved = table.HashTable<move_path.MovePathId, Bool>();
        self.active_loans = loan_facts.ActiveLoanFacts();
        self.live_locals = table.HashTable<move_path.MovePathId, Bool>();
    }
}

struct BorrowDiagnosticKey: Hashable, Equatable {
    public mir.MirFunctionId function_id;
    public mir.MirBlockId block_id;
    public location.MirLocationKind kind;
    public Int statement_index;
    public Int code;

    public init(self, location.MirLocation current, Int code) {
        self.function_id = current.function_id;
        self.block_id = current.block_id;
        self.kind = current.kind;
        self.statement_index = current.statement_index;
        self.code = code;
    }

    public UInt64 hash(self) {
        hash.WyHasher! hasher = hash.WyHasher();
        hasher.write_int(self.function_id.to_index());
        hasher.write_int(self.block_id.to_index());
        hasher.write_int(self.kind_index());
        hasher.write_int(self.statement_index);
        hasher.write_int(self.code);
        return hasher.finish();
    }

    Int kind_index(self) {
        if (self.kind == .statement) {
            return 1;
        }
        return 2;
    }

    public Bool equal(BorrowDiagnosticKey& lhs, BorrowDiagnosticKey& rhs) {
        if (lhs.function_id.to_index() != rhs.function_id.to_index()) { return false; }
        if (lhs.block_id.to_index() != rhs.block_id.to_index()) { return false; }
        if (lhs.kind_index() != rhs.kind_index()) { return false; }
        if (lhs.statement_index != rhs.statement_index) { return false; }
        return lhs.code == rhs.code;
    }
}

struct FunctionBorrowChecker: Movable {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;
    public layout.LayoutStore& layouts;
    public borrow_store.BorrowCheckStore& results;
    public mir.MirFunctionId function_id;
    public qid.DefId function_def;
    public mir.MirBody body;
    public move_path.MovePathTree! paths;
    public BorrowDataflowState! dataflow;
    public location.MirLocation! current_location;
    public table.HashTable<BorrowDiagnosticKey, Bool>! reported_diagnostics;
    public table.HashTable<move_path.MovePathId, Bool>! reported_dead_loan_sources;
    public return_lifetime.ReturnLifetimeChecker! return_lifetimes;

    public init(self,
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results,
        mir.MirFunction function
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
        self.function_id = function.id;
        self.function_def = function.def_id;
        self.body = function.body;
        mir.MirBody! body = function.body;
        self.paths = move_path.build_move_path_tree(body$.ref());
        self.dataflow = BorrowDataflowState();
        self.current_location = location.MirLocation(function.id, body.entry, .terminator, -1);
        self.reported_diagnostics = table.HashTable<BorrowDiagnosticKey, Bool>();
        self.reported_dead_loan_sources = table.HashTable<move_path.MovePathId, Bool>();
        self.return_lifetimes = return_lifetime.ReturnLifetimeChecker(ctx, self.function_def);
    }

    public () check(self) {
        Int block_count = self.body.blocks.length;
        if (block_count == 0) {
            return;
        }

        BorrowDataflowState![*] in_states = BorrowDataflowState!$.alloc_many(block_count);
        Bool![*] reachable = Bool!$.alloc_many(block_count);
        Bool![*] queued = Bool!$.alloc_many(block_count);
        self.init_dataflow_arrays(in_states, reachable, queued, block_count);

        list.ArrayList<Int>! worklist = list.ArrayList<Int>();
        Int entry_index = self.body.entry.to_index();
        if (!self.valid_block_index(entry_index)) {
            return;
        }
        self.init_entry_live_locals(in_states[entry_index]$.ref());
        self.enqueue_block(entry_index, reachable, queued, worklist$.ref());

        while (!worklist.empty()) {
            Int block_index = worklist.pop();
            queued[block_index] = false;
            self.dataflow = self.clone_state(in_states[block_index]$.ref());
            self.check_block(self.body.blocks[block_index]);
            self.propagate_successors(
                self.body.blocks[block_index],
                in_states,
                reachable,
                queued,
                worklist$.ref()
            );
        }
    }

    () init_entry_live_locals(self, BorrowDataflowState& state) {
        Int! local_index = 0;
        while (local_index < self.body.locals.length) {
            mir.MirLocalDecl local = self.body.locals[local_index];
            if (self.local_is_live_at_entry(local)) {
                self.mark_state_local_live(state, local.id);
            }
            local_index = local_index + 1;
        }
    }

    Bool local_is_live_at_entry(self, mir.MirLocalDecl local) {
        if (local.id.to_index() == self.body.return_local.to_index()) {
            return true;
        }
        if (local.kind == .param) {
            return true;
        }
        return !self.local_has_storage_marker(local.id);
    }

    Bool local_has_storage_marker(self, mir.MirLocalId local_id) {
        Int! block_index = 0;
        while (block_index < self.body.blocks.length) {
            if (self.block_has_storage_marker(self.body.blocks[block_index], local_id)) {
                return true;
            }
            block_index = block_index + 1;
        }
        return false;
    }

    Bool block_has_storage_marker(self, mir.MirBlock block, mir.MirLocalId local_id) {
        Int! stmt_index = 0;
        while (stmt_index < block.statements.length) {
            mir.MirStatement statement = block.statements[stmt_index];
            if (self.statement_is_storage_marker_for_local(statement, local_id)) {
                return true;
            }
            stmt_index = stmt_index + 1;
        }
        return false;
    }

    Bool statement_is_storage_marker_for_local(self, mir.MirStatement statement, mir.MirLocalId local_id) {
        if (statement.kind is .storage_live_stmt(storage_live)) {
            return storage_live.local_id.to_index() == local_id.to_index();
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            return storage_dead.local_id.to_index() == local_id.to_index();
        }
        return false;
    }

    () init_dataflow_arrays(self,
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        Int block_count
    ) {
        Int! index = 0;
        while (index < block_count) {
            in_states[index] = BorrowDataflowState();
            reachable[index] = false;
            queued[index] = false;
            index = index + 1;
        }
    }

    Bool valid_block_index(self, Int block_index) {
        return block_index >= 0 && block_index < self.body.blocks.length;
    }

    () enqueue_block(self,
        Int block_index,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        reachable[block_index] = true;
        if (queued[block_index]) {
            return;
        }
        queued[block_index] = true;
        worklist.add(block_index);
    }

    () propagate_successors(self,
        mir.MirBlock block,
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        Int! successor_index = 0;
        while (successor_index < mir.terminator_successor_count(block.terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(block.terminator, successor_index);
            self.propagate_successor(successor, in_states, reachable, queued, worklist);
            successor_index = successor_index + 1;
        }
    }

    () propagate_successor(self,
        mir.MirBlockId successor,
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        Int successor_index = successor.to_index();
        if (!self.valid_block_index(successor_index)) {
            return;
        }

        Bool was_reachable = reachable[successor_index];
        Bool changed = self.merge_state(
            in_states[successor_index]$.ref(),
            self.dataflow$.ref(),
            was_reachable
        );
        if (!was_reachable || changed) {
            self.enqueue_block(successor_index, reachable, queued, worklist);
        }
    }

    BorrowDataflowState clone_state(self, BorrowDataflowState& source) {
        BorrowDataflowState! clone = BorrowDataflowState();
        self.merge_state(clone$.ref(), source, false);
        return clone$.move();
    }

    // CFG 合流采用 may-analysis：任一前驱 move/borrow 过的 path，在后继入口都视为可能存在。
    // live local 采用 must-analysis：只有所有前驱都 live 的 local，后继入口才视为 live。
    Bool merge_state(self, BorrowDataflowState& target, BorrowDataflowState& source, Bool target_reachable) {
        Bool! changed = false;
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId path = move_path.MovePathId(index);
            changed = self.merge_moved_path(target, source, path) || changed;
            changed = self.merge_live_local(target, source, path, target_reachable) || changed;
            index = index + 1;
        }
        changed = self.merge_active_loans(target, source) || changed;
        return changed;
    }

    Bool merge_live_local(self,
        BorrowDataflowState& target,
        BorrowDataflowState& source,
        move_path.MovePathId path,
        Bool target_reachable
    ) {
        Bool source_live = source.live_locals.has(path);
        Bool target_live = target.live_locals.has(path);
        if (!target_reachable) {
            if (!source_live) { return false; }
            target.live_locals.set(path, true);
            return true;
        }
        if (!target_live || source_live) {
            return false;
        }
        target.live_locals.remove(path);
        return true;
    }

    Bool merge_moved_path(self,
        BorrowDataflowState& target,
        BorrowDataflowState& source,
        move_path.MovePathId path
    ) {
        if (!source.moved.has(path)) {
            return false;
        }
        if (target.moved.has(path)) {
            return false;
        }
        target.moved.set(path, true);
        return true;
    }

    Bool merge_active_loans(self, BorrowDataflowState& target, BorrowDataflowState& source) {
        Bool! changed = false;
        Int! index = 0;
        while (index < source.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = source.active_loans.get(index);
            changed = self.merge_active_loan_fact(target, fact) || changed;
            index = index + 1;
        }
        return changed;
    }

    Bool merge_active_loan_fact(self, BorrowDataflowState& target, loan_facts.ActiveLoanFact fact) {
        return self.add_active_loan_fact(target, fact);
    }

    Bool add_active_loan_fact(self, BorrowDataflowState& state, loan_facts.ActiveLoanFact fact) {
        return state.active_loans.add(fact);
    }

    () check_block(self, mir.MirBlock block) {
        Int! stmt_index = 0;
        while (stmt_index < block.statements.length) {
            self.current_location = location.MirLocation(
                self.function_id,
                block.id,
                .statement,
                stmt_index
            );
            self.check_statement(block.statements[stmt_index]);
            stmt_index = stmt_index + 1;
        }
        self.current_location = location.MirLocation(self.function_id, block.id, .terminator, -1);
        self.check_terminator(block.terminator);
    }

    () check_statement(self, mir.MirStatement statement) {
        if (statement.kind is .storage_live_stmt(storage_live)) {
            self.mark_local_live(storage_live.local_id);
            return;
        }
        if (statement.kind is .assign_stmt(assign_stmt)) {
            self.check_rvalue(assign_stmt.value);
            self.check_assignment_escape(assign_stmt.destination, assign_stmt.value);
            self.clear_place(assign_stmt.destination);
            self.record_assignment_loan(assign_stmt.destination, assign_stmt.value);
            return;
        }
        if (statement.kind is .set_discriminant_stmt(discriminant_stmt)) {
            self.clear_place(discriminant_stmt.destination);
            return;
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            self.consume_place(forget_stmt.place);
            return;
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            self.clear_storage_dead_local(storage_dead.local_id);
        }
    }

    () clear_storage_dead_local(self, mir.MirLocalId local_id) {
        move_path.MovePathId path = self.paths.root_for_local(local_id);
        self.dataflow.live_locals.remove(path);
        self.clear_path_and_descendants(path);
    }

    () mark_local_live(self, mir.MirLocalId local_id) {
        self.mark_state_local_live(self.dataflow$.ref(), local_id);
    }

    () mark_state_local_live(self, BorrowDataflowState& state, mir.MirLocalId local_id) {
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        state.live_locals.set(root, true);
    }

    () check_assignment_escape(self, mir.MirPlace destination, mir.MirRvalue value) {
        if (!self.place_may_write_outside_current_body(destination)) {
            return;
        }
        if (self.rvalue_contains_borrowed_value(value)) {
            if (self.current_function_is_init() && self.destination_has_deref_projection(destination)) {
                return;
            }
            if (self.assignment_lifetime_allows_escape(destination, value)) {
                return;
            }
            self.results.mark_error();
            self.add_borrow_escape_diagnostic();
        }
    }

    Bool assignment_lifetime_allows_escape(self, mir.MirPlace destination, mir.MirRvalue value) {
        if (value is .borrow_value(borrow_value)) {
            return self.field_lifetime_allows_borrow_store(destination, borrow_value.place);
        }
        if (value is .address_of_value(address_of_value)) {
            return self.field_lifetime_allows_borrow_store(destination, address_of_value.place);
        }
        if (value is .use_value(use_value)) {
            return self.self_lifetime_allows_borrow_store(destination, use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.self_lifetime_allows_borrow_store(destination, cast_value.value);
        }
        return false;
    }

    Bool self_lifetime_allows_borrow_store(self, mir.MirPlace destination, mir.MirOperand operand) {
        guard self.operand_place(operand) is .some(source) else { return false; }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (!self.valid_move_path(source_path)) { return false; }
        return self.source_root_param_symbol(source_path) != null;
    }

    Bool destination_is_self_place(self, mir.MirPlace destination) {
        guard mir.place_local_id(destination) is .some(local_id) else { return false; }
        move_path.MovePath path = self.paths.get(self.paths.root_for_local(local_id));
        Int local_index = path.local_id.to_index();
        if (local_index < 0 || local_index >= self.body.locals.length) {
            return false;
        }
        mir.MirLocalDecl local = self.body.locals[local_index];
        guard local.name is .some(symbol) else { return false; }
        return self.source_symbol_is_self(symbol);
    }

    Bool field_lifetime_allows_borrow_store(self, mir.MirPlace destination, mir.MirPlace source) {
        guard self.destination_field_def(destination) is .some(_) else {
            return false;
        }
        if (self.same_local_base(destination, source)) {
            return true;
        }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (!self.valid_move_path(source_path)) { return false; }
        return self.source_root_param_symbol(source_path) != null;
    }

    Bool destination_may_be_initialized_self(self, mir.MirPlace destination) {
        if (self.destination_is_self_place(destination)) {
            return true;
        }
        return self.current_function_is_init() && self.destination_has_deref_projection(destination);
    }

    Bool current_function_is_init(self) {
        if (!self.ctx.store.defs.has(self.function_def)) {
            return false;
        }
        return self.ctx.store.defs.get(self.function_def).kind == .init_def;
    }

    Bool destination_has_deref_projection(self, mir.MirPlace destination) {
        Int! index = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? destination_field_def(self, mir.MirPlace destination) {
        qid.DefId?! field_def = null;
        Int! index = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .field_projection(field)) {
                field_def = field.field_def;
            }
            index = index + 1;
        }
        return field_def;
    }

    Bool place_may_write_outside_current_body(self, mir.MirPlace place) {
        Int! index = 0;
        while (index < place.projection.length) {
            if (place.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool rvalue_contains_borrowed_value(self, mir.MirRvalue value) {
        if (value is .borrow_value) {
            return true;
        }
        if (value is .address_of_value) {
            return true;
        }
        if (value is .slice_value(slice_value)) {
            return self.slice_rvalue_contains_active_loan(slice_value);
        }
        if (value is .use_value(use_value)) {
            return self.operand_contains_active_loan(use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.operand_contains_active_loan(cast_value.value);
        }
        if (value is .inline_asm_value(inline_asm)) {
            return self.inline_asm_contains_active_loan(inline_asm);
        }
        if (value is .optional_value(optional_value)) {
            return self.operand_contains_active_loan(optional_value.value);
        }
        if (value is .error_union_value(error_union_value)) {
            return self.operand_contains_active_loan(error_union_value.value);
        }
        if (value is .aggregate_value(aggregate_value)) {
            return self.operands_contain_active_loan(aggregate_value.fields);
        }
        return false;
    }

    Bool inline_asm_contains_active_loan(self, mir.MirInlineAsmRvalue value) {
        Int! index = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                if (self.operand_contains_active_loan(input.value)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool slice_rvalue_contains_active_loan(self, mir.MirSliceRvalue value) {
        if (self.has_active_loan_for_path(self.paths.path_for_place(value.base))) {
            return true;
        }
        if (self.optional_operand_contains_active_loan(value.start)) { return true; }
        return self.optional_operand_contains_active_loan(value.end);
    }

    Bool optional_operand_contains_active_loan(self, mir.MirOperand? operand) {
        if (operand is .some(value)) {
            return self.operand_contains_active_loan(value);
        }
        return false;
    }

    Bool operands_contain_active_loan(self, mir.MirOperand[]& operands) {
        Int! index = 0;
        while (index < operands.length) {
            if (self.operand_contains_active_loan(operands[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool operand_contains_active_loan(self, mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            if (!self.place_type_may_carry_borrow(copy_operand.place)) { return false; }
            return self.has_active_loan_for_path(self.paths.path_for_place(copy_operand.place));
        }
        if (operand is .move_operand(move_operand)) {
            if (!self.place_type_may_carry_borrow(move_operand.place)) { return false; }
            return self.has_active_loan_for_path(self.paths.path_for_place(move_operand.place));
        }
        return false;
    }

    () record_assignment_loan(self, mir.MirPlace destination, mir.MirRvalue value) {
        if (value is .borrow_value(borrow_value)) {
            self.add_loan(.reference_view, borrow_value.place, destination);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.add_loan(.raw_pointer_view, address_of_value.place, destination);
            return;
        }
        if (value is .use_value(use_value)) {
            self.record_operand_loan(destination, use_value.value);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.record_slice_loan(destination, slice_value);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.record_aggregate_loan(destination, aggregate_value);
        }
    }

    () record_aggregate_loan(self, mir.MirPlace destination, mir.MirAggregateRvalue value) {
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        if (!self.valid_move_path(destination_path)) { return; }
        Int! index = 0;
        while (index < value.fields.length) {
            move_path.MovePathId field_path = self.aggregate_field_path(destination_path, value, index);
            qid.TypeId field_type = self.aggregate_field_type(value, index);
            self.record_operand_loan_to_path(field_path, field_type, value.fields[index]);
            index = index + 1;
        }
    }

    move_path.MovePathId aggregate_field_path(self,
        move_path.MovePathId destination_path,
        mir.MirAggregateRvalue value,
        Int field_index
    ) {
        if (value.kind == .struct_value) {
            if (self.aggregate_field_projection(value, field_index) is .some(projection)) {
                return self.paths.child_for_projection(destination_path, projection);
            }
        }
        mir.MirPlaceElem projection = mir.constant_index_projection_elem(
            mir.MirConstantIndexProjection(offset: field_index)
        );
        return self.paths.child_for_projection(destination_path, projection);
    }

    mir.MirPlaceElem? aggregate_field_projection(self, mir.MirAggregateRvalue value, Int field_index) {
        guard value.def_id is .some(def_id) else { return null; }
        guard self.aggregate_field_def(def_id, field_index) is .some(field_def) else { return null; }
        return mir.field_projection_elem(mir.MirFieldProjection (
            field_def: field_def,
            field_type: self.aggregate_field_type(value, field_index),
            field_index: field_index
        ));
    }

    qid.DefId? aggregate_field_def(self, qid.DefId owner_def, Int field_index) {
        guard self.ctx.store.hirs.def(owner_def) is .some(hir_def) else { return null; }
        Int! field_count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.ctx.store.defs.get(member_def).kind == .field_def) {
                if (field_count == field_index) {
                    return member_def;
                }
                field_count = field_count + 1;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId aggregate_field_type(self, mir.MirAggregateRvalue value, Int field_index) {
        if (field_index >= 0 && field_index < value.fields.length) {
            if (self.operand_place(value.fields[field_index]) is .some(place)) {
                return self.place_type(place);
            }
        }
        return self.projected_type(
            value.type_id,
            mir.constant_index_projection_elem(mir.MirConstantIndexProjection(offset: field_index))
        );
    }

    () record_slice_loan(self, mir.MirPlace destination, mir.MirSliceRvalue value) {
        types.TypeInfo base_info = self.ctx.store.types.get(self.place_type(value.base));
        if (base_info.data is .array_type(_)) {
            self.add_loan(.reference_view, value.base, destination);
            return;
        }
        if (base_info.data is .handle_type(handle)) {
            if (handle.kind == .slice) {
                self.record_operand_loan(
                    destination,
                    mir.copy_operand_value(mir.MirCopyOperand (place: value.base))
                );
            }
        }
    }

    // 复制 `T&`/`T*` 值本身不会创建新 owner，但会把来源 loan 传播到目标 place。
    // 这让 `return_value.field = input_ref` 这类字段写入能在 return 检查时被看见。
    () record_operand_loan(self, mir.MirPlace destination, mir.MirOperand operand) {
        self.record_operand_loan_to_path(
            self.paths.path_for_place(destination),
            self.place_type(destination),
            operand
        );
    }

    () record_operand_loan_to_path(self,
        move_path.MovePathId destination_path,
        qid.TypeId destination_type,
        mir.MirOperand operand
    ) {
        if (!self.type_may_carry_borrow(destination_type)) { return; }
        if (!self.valid_move_path(destination_path)) { return; }
        guard self.operand_place(operand) is .some(source) else { return; }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (self.record_active_operand_loans(destination_path, source_path)) {
            return;
        }
        guard mir.place_local_id(source) is .some(source_local) else { return; }
        if (!self.local_is_param(source_local)) {
            return;
        }
        if (self.place_handle_loan_kind(source) is .some(kind)) {
            self.add_loan_from_paths(kind, self.paths.path_for_place(source), destination_path);
        }
    }

    Bool record_active_operand_loans(self,
        move_path.MovePathId destination_path,
        move_path.MovePathId source_path
    ) {
        if (!self.valid_move_path(source_path)) { return false; }
        Bool! recorded = false;
        Int original_len = self.dataflow.active_loans.len();
        Int! index = 0;
        while (index < original_len) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.loan_target_matches_path(fact.target, source_path)) {
                loan.Loan current = self.results.loans.get(fact.loan_id);
                self.add_loan_from_paths(current.kind, current.source, destination_path);
                recorded = true;
            }
            index = index + 1;
        }
        return recorded;
    }

    Bool loan_target_matches_path(self, move_path.MovePathId target_path, move_path.MovePathId use_path) {
        if (target_path == use_path) { return true; }
        if (self.is_descendant_of(use_path, target_path)) { return true; }
        return self.is_descendant_of(target_path, use_path);
    }

    Bool local_is_param(self, mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        if (!self.valid_local_index(index)) {
            return false;
        }
        return self.body.locals[index].kind == .param;
    }

    Bool place_type_may_carry_borrow(self, mir.MirPlace place) {
        return self.type_may_carry_borrow(self.place_type(place));
    }

    loan.LoanKind? place_handle_loan_kind(self, mir.MirPlace place) {
        types.TypeInfo info = self.ctx.store.types.get(self.place_type(place));
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any) { return loan.raw_pointer_view_kind(); }
            if (companion.kind == .receiver) { return loan.raw_pointer_view_kind(); }
            return null;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (types.is_reference_handle(handle)) { return loan.reference_view_kind(); }
        if (types.is_slice_handle(handle)) { return loan.reference_view_kind(); }
        if (types.is_raw_pointer_handle(handle)) { return loan.raw_pointer_view_kind(); }
        return null;
    }

    Bool type_may_carry_borrow(self, qid.TypeId type_id) {
        carry.BorrowCarryQuery! query = carry.BorrowCarryQuery(self.ctx, self.typeck);
        return query.type_may_carry_borrow(type_id);
    }

    Bool valid_local_index(self, Int index) {
        return index >= 0 && index < self.body.locals.length;
    }

    () add_loan(self, loan.LoanKind kind, mir.MirPlace source, mir.MirPlace target) {
        move_path.MovePathId source_path = self.canonical_loan_source(self.paths.path_for_place(source));
        move_path.MovePathId target_path = self.paths.path_for_place(target);
        if (!self.valid_move_path(source_path) || !self.valid_move_path(target_path)) { return; }
        self.add_loan_from_paths(kind, source_path, target_path);
    }

    () add_loan_from_paths(self, loan.LoanKind kind, move_path.MovePathId source, move_path.MovePathId target) {
        move_path.MovePathId canonical_source = self.canonical_loan_source(source);
        loan.LoanId loan_id = self.get_or_add_loan(kind, canonical_source, target);
        self.add_active_loan(target, loan_id);
    }

    loan.LoanId get_or_add_loan(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target
    ) {
        if (self.existing_loan(kind, source, target) is .some(loan_id)) {
            return loan_id;
        }
        return self.results.add_loan(kind, self.function_id, source, target);
    }

    loan.LoanId? existing_loan(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target
    ) {
        Int! index = 0;
        while (index < self.results.loans.len()) {
            loan.Loan current = self.results.loans.get(loan.LoanId(index));
            if (self.same_loan(current, kind, source, target)) {
                return current.id;
            }
            index = index + 1;
        }
        return null;
    }

    Bool same_loan(self,
        loan.Loan current,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target
    ) {
        if (current.function_id.to_index() != self.function_id.to_index()) { return false; }
        if (current.kind != kind) { return false; }
        if (current.source != source) { return false; }
        return current.target == target;
    }

    () add_active_loan(self, move_path.MovePathId target, loan.LoanId loan_id) {
        self.add_active_loan_fact(self.dataflow$.ref(), loan_facts.ActiveLoanFact(target, loan_id));
    }

    move_path.MovePathId canonical_loan_source(self, move_path.MovePathId source) {
        move_path.MovePathId! current_source = source;
        Int! depth = 0;
        while (depth < 32) {
            guard self.first_active_loan_for_path(current_source) is .some(loan_id) else {
                return current_source;
            }
            loan.Loan current = self.results.loans.get(loan_id);
            if (current.source == current_source) {
                return current_source;
            }
            current_source = current.source;
            depth = depth + 1;
        }
        return current_source;
    }

    () check_terminator(self, mir.MirTerminator terminator) {
        if (terminator.kind is .branch_term(branch)) {
            self.check_operand(branch.condition);
            return;
        }
        if (terminator.kind is .switch_term(switch_term)) {
            self.check_operand(switch_term.discriminator);
            return;
        }
        if (terminator.kind is .call_term(call_term)) {
            self.check_call(call_term);
            return;
        }
        if (terminator.kind is .drop_term(drop_term)) {
            self.check_drop(drop_term.place);
            return;
        }
        if (terminator.kind is .assert_term(assert_term)) {
            self.check_operand(assert_term.condition);
            return;
        }
        if (terminator.kind is .return_term(return_term)) {
            self.check_return(return_term);
            return;
        }
        if (terminator.kind is .throw_term(throw_term)) {
            self.check_operand(throw_term.error_value);
        }
    }

    () check_drop(self, mir.MirPlace place) {
        if (self.place_is_indirect_memory(place)) {
            return;
        }
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        self.check_place_use(place);
        self.mark_moved(path);
    }

    Bool place_needs_drop(self, mir.MirPlace place) {
        if (self.place_is_indirect_memory(place)) {
            return false;
        }
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.ctx);
        return query.type_needs_runtime_drop(self.place_type(place));
    }

    () check_return(self, mir.MirReturnTerminator return_term) {
        if (return_term.implicit_unit) {
            return;
        }
        self.check_return_path_escape(self.paths.root_for_local(self.body.return_local));
    }

    () check_return_path_escape(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.return_path_contains_target(path, fact.target)) {
                self.check_return_loan_escape(fact);
            }
            index = index + 1;
        }
    }

    () check_return_loan_escape(self, loan_facts.ActiveLoanFact fact) {
        if (!self.check_loan_valid_for_fact(fact)) {
            return;
        }
        return_lifetime.ReturnLifetimeStatus status = self.return_lifetime_status(fact.loan_id);
        if (status == .allowed) {
            return;
        }
        self.results.mark_error();
        self.add_return_lifetime_diagnostic(status);
    }

    Bool return_path_contains_target(self, move_path.MovePathId return_path, move_path.MovePathId target_path) {
        if (return_path == target_path) { return true; }
        return self.is_descendant_of(target_path, return_path);
    }

    return_lifetime.ReturnLifetimeStatus return_lifetime_status(self, loan.LoanId loan_id) {
        if (self.current_function_is_init()) {
            return .allowed;
        }
        loan.Loan current = self.results.loans.get(loan_id);
        guard self.source_root_param_symbol(current.source) is .some(source_symbol) else {
            return .source_not_allowed;
        }
        return self.return_lifetimes.check_source(source_symbol);
    }

    Bool is_return_local_path(self, move_path.MovePathId path_id) {
        move_path.MovePath path = self.paths.get(path_id);
        return path.local_id.to_index() == self.body.return_local.to_index();
    }

    qid.SymbolId? source_root_param_symbol(self, move_path.MovePathId source) {
        move_path.MovePath path = self.paths.get(source);
        Int local_index = path.local_id.to_index();
        if (local_index < 0 || local_index >= self.body.locals.length) {
            return null;
        }
        mir.MirLocalDecl local = self.body.locals[local_index];
        if (local.kind != .param) {
            return self.source_root_param_symbol_from_local_loan(path.local_id);
        }
        return local.name;
    }

    qid.SymbolId? source_root_param_symbol_from_local_loan(self, mir.MirLocalId local_id) {
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        guard self.first_active_loan_for_exact_path(root) is .some(loan_id) else {
            return null;
        }
        loan.Loan current = self.results.loans.get(loan_id);
        return self.source_root_param_symbol(current.source);
    }

    Bool source_symbol_is_self(self, qid.SymbolId source_symbol) {
        qid.SymbolId self_symbol = self.ctx.store.symbols.intern("self");
        return source_symbol == self_symbol;
    }

    () check_call(self, mir.MirCallTerminator call_term) {
        self.check_call_callee(call_term.callee);
        Int! index = 0;
        while (index < call_term.args.length) {
            self.check_operand(call_term.args[index]);
            index = index + 1;
        }
        self.check_unique_places_call(call_term);
        self.clear_place(call_term.destination);
        if (call_term.initialized_place is .some(initialized_place)) {
            self.clear_place(initialized_place);
        }
        self.record_call_return_loan(call_term);
    }

    () check_unique_places_call(self, mir.MirCallTerminator call_term) {
        Int! unique_index = 0;
        while (unique_index < call_term.unique_places.length) {
            self.check_unique_place_call(call_term, call_term.unique_places[unique_index]);
            unique_index = unique_index + 1;
        }
    }

    () check_unique_place_call(self, mir.MirCallTerminator call_term, mir.MirPlace unique_place) {
        self.check_unique_place_signature_requirement(unique_place);
        move_path.MovePathId unique_path = self.paths.path_for_place(unique_place);
        if (!self.valid_move_path(unique_path)) { return; }
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (self.unique_place_loan_conflicts(call_term, unique_path, current, fact.target)) {
                self.results.mark_error();
                self.add_unique_borrow_diagnostic();
            }
            index = index + 1;
        }
    }

    () check_unique_place_signature_requirement(self, mir.MirPlace unique_place) {
        move_path.MovePathId unique_path = self.paths.path_for_place(unique_place);
        if (!self.valid_move_path(unique_path)) { return; }
        if (!self.unique_place_requires_signature(unique_path)) { return; }
        guard self.source_root_param_symbol(unique_path) is .some(source_symbol) else { return; }
        if (self.current_function_is_init() && self.source_symbol_is_self(source_symbol)) { return; }
        if (self.current_signature_has_unique_symbol(source_symbol)) { return; }
        self.results.mark_error();
        self.add_unique_requirement_diagnostic();
    }

    Bool unique_place_requires_signature(self, move_path.MovePathId unique_path) {
        move_path.MovePath path = self.paths.get(unique_path);
        Int local_index = path.local_id.to_index();
        if (!self.valid_local_index(local_index)) { return false; }
        mir.MirLocalDecl local = self.body.locals[local_index];
        if (self.borrowed_handle_type(local.type_id)) { return true; }
        if (local.kind != .param) { return false; }
        return self.source_root_param_symbol_from_local_loan(path.local_id) != null;
    }

    Bool borrowed_handle_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        return handle.kind == .slice;
    }

    Bool current_signature_has_unique_symbol(self, qid.SymbolId symbol) {
        guard self.ctx.store.hirs.def(self.function_def) is .some(hir_def) else { return false; }
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        Int! index = 0;
        while (index < signature.unique_symbols.length) {
            if (signature.unique_symbols[index] == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool unique_place_loan_conflicts(self,
        mir.MirCallTerminator call_term,
        move_path.MovePathId unique_path,
        loan.Loan current,
        move_path.MovePathId target_path
    ) {
        if (!self.path_matches_or_contains(unique_path, current.source)) {
            return false;
        }
        table.HashTable<Int, Bool>! visiting = table.HashTable<Int, Bool>();
        return self.loan_target_future_used_from_successors(call_term, target_path, visiting$.ref());
    }

    Bool unique_call_uses_loan_target(self, mir.MirCallTerminator call_term, move_path.MovePathId target_path) {
        Int! index = 1;
        while (index < call_term.args.length) {
            if (self.operand_uses_loan_target(call_term.args[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool call_uses_loan_target(self, mir.MirCallTerminator call_term, move_path.MovePathId target_path) {
        if (self.call_callee_uses_loan_target(call_term.callee, target_path)) { return true; }
        Int! index = 0;
        while (index < call_term.args.length) {
            if (self.operand_uses_loan_target(call_term.args[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool call_callee_uses_loan_target(self, mir.MirCallCallee callee, move_path.MovePathId target_path) {
        if (callee is .indirect_operand(operand)) {
            return self.operand_uses_loan_target(operand, target_path);
        }
        return false;
    }

    Bool loan_target_future_used_from_successors(self,
        mir.MirCallTerminator call_term,
        move_path.MovePathId target_path,
        table.HashTable<Int, Bool>& visiting
    ) {
        mir.MirTerminator terminator = mir.MirTerminator (
            span: token.Span(),
            kind: mir.call_terminator_kind(call_term)
        );
        Int! index = 0;
        while (index < mir.terminator_successor_count(terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(terminator, index);
            if (self.loan_target_future_used_from_block(successor, target_path, visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool loan_target_future_used_from_block(self,
        mir.MirBlockId block_id,
        move_path.MovePathId target_path,
        table.HashTable<Int, Bool>& visiting
    ) {
        Int block_index = block_id.to_index();
        if (!self.valid_block_index(block_index)) { return false; }
        if (visiting.has(block_index)) {
            return false;
        }
        visiting.set(block_index, true);
        mir.MirBlock block = self.body.blocks[block_index];
        Int! index = 0;
        while (index < block.statements.length) {
            mir.MirStatement statement = block.statements[index];
            if (self.statement_uses_loan_target(statement, target_path)) {
                return true;
            }
            if (self.statement_kills_loan_target(statement, target_path)) {
                visiting.remove(block_index);
                return false;
            }
            index = index + 1;
        }
        if (self.terminator_uses_loan_target(block.terminator, target_path)) {
            return true;
        }
        Int! successor_index = 0;
        while (successor_index < mir.terminator_successor_count(block.terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(block.terminator, successor_index);
            if (self.loan_target_future_used_from_block(successor, target_path, visiting)) {
                return true;
            }
            successor_index = successor_index + 1;
        }
        visiting.remove(block_index);
        return false;
    }

    Bool statement_uses_loan_target(self, mir.MirStatement statement, move_path.MovePathId target_path) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            return self.rvalue_uses_loan_target(assign_stmt.value, target_path);
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            return self.place_uses_loan_target(forget_stmt.place, target_path);
        }
        return false;
    }

    Bool statement_kills_loan_target(self, mir.MirStatement statement, move_path.MovePathId target_path) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            return self.place_kills_loan_target(assign_stmt.destination, target_path);
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            move_path.MovePathId root = self.paths.root_for_local(storage_dead.local_id);
            return self.path_matches_or_contains(root, target_path);
        }
        return false;
    }

    Bool terminator_uses_loan_target(self, mir.MirTerminator terminator, move_path.MovePathId target_path) {
        if (terminator.kind is .branch_term(branch)) {
            return self.operand_uses_loan_target(branch.condition, target_path);
        }
        if (terminator.kind is .switch_term(switch_term)) {
            return self.operand_uses_loan_target(switch_term.discriminator, target_path);
        }
        if (terminator.kind is .call_term(call_term)) {
            return self.call_uses_loan_target(call_term, target_path);
        }
        if (terminator.kind is .drop_term(drop_term)) {
            return self.place_uses_loan_target(drop_term.place, target_path);
        }
        if (terminator.kind is .assert_term(assert_term)) {
            return self.operand_uses_loan_target(assert_term.condition, target_path);
        }
        if (terminator.kind is .throw_term(throw_term)) {
            return self.operand_uses_loan_target(throw_term.error_value, target_path);
        }
        return false;
    }

    Bool rvalue_uses_loan_target(self, mir.MirRvalue value, move_path.MovePathId target_path) {
        if (value is .use_value(use_value)) {
            return self.operand_uses_loan_target(use_value.value, target_path);
        }
        if (value is .unary_value(unary_value)) {
            return self.operand_uses_loan_target(unary_value.value, target_path);
        }
        if (value is .binary_value(binary_value)) {
            if (self.operand_uses_loan_target(binary_value.lhs, target_path)) { return true; }
            return self.operand_uses_loan_target(binary_value.rhs, target_path);
        }
        if (value is .cast_value(cast_value)) {
            return self.operand_uses_loan_target(cast_value.value, target_path);
        }
        if (value is .inline_asm_value(inline_asm)) {
            return self.inline_asm_uses_loan_target(inline_asm, target_path);
        }
        if (value is .borrow_value(borrow_value)) {
            return self.place_uses_loan_target(borrow_value.place, target_path);
        }
        if (value is .address_of_value(address_of_value)) {
            return self.place_uses_loan_target(address_of_value.place, target_path);
        }
        if (value is .alloc_value(alloc_value)) {
            return self.operand_uses_loan_target(alloc_value.value, target_path);
        }
        if (value is .alloc_array_value(alloc_array)) {
            return self.operand_uses_loan_target(alloc_array.count, target_path);
        }
        if (value is .free_value(free_value)) {
            return self.operand_uses_loan_target(free_value.pointer, target_path);
        }
        if (value is .slice_value(slice_value)) {
            if (self.place_uses_loan_target(slice_value.base, target_path)) { return true; }
            if (self.optional_operand_uses_loan_target(slice_value.start, target_path)) { return true; }
            return self.optional_operand_uses_loan_target(slice_value.end, target_path);
        }
        if (value is .len_value(len_value)) {
            return self.place_uses_loan_target(len_value.place, target_path);
        }
        if (value is .discriminant_value(discriminant_value)) {
            return self.place_uses_loan_target(discriminant_value.place, target_path);
        }
        if (value is .aggregate_value(aggregate_value)) {
            if (self.optional_operand_uses_loan_target(aggregate_value.tag, target_path)) { return true; }
            return self.operands_use_loan_target(aggregate_value.fields, target_path);
        }
        if (value is .optional_value(optional_value)) {
            return self.operand_uses_loan_target(optional_value.value, target_path);
        }
        if (value is .error_union_value(error_union_value)) {
            return self.operand_uses_loan_target(error_union_value.value, target_path);
        }
        return false;
    }

    Bool inline_asm_uses_loan_target(self, mir.MirInlineAsmRvalue value, move_path.MovePathId target_path) {
        Int! index = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                if (self.operand_uses_loan_target(input.value, target_path)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool operands_use_loan_target(self, mir.MirOperand[]& operands, move_path.MovePathId target_path) {
        Int! index = 0;
        while (index < operands.length) {
            if (self.operand_uses_loan_target(operands[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool optional_operand_uses_loan_target(self, mir.MirOperand? operand, move_path.MovePathId target_path) {
        if (operand is .some(value)) {
            return self.operand_uses_loan_target(value, target_path);
        }
        return false;
    }

    Bool operand_uses_loan_target(self, mir.MirOperand operand, move_path.MovePathId target_path) {
        guard self.operand_place(operand) is .some(place) else { return false; }
        return self.place_uses_loan_target(place, target_path);
    }

    Bool place_uses_loan_target(self, mir.MirPlace place, move_path.MovePathId target_path) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return false; }
        return self.loan_target_matches_path(target_path, path);
    }

    Bool place_kills_loan_target(self, mir.MirPlace place, move_path.MovePathId target_path) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return false; }
        return self.path_matches_or_contains(path, target_path);
    }

    () check_call_callee(self, mir.MirCallCallee callee) {
        if (callee is .indirect_operand(operand)) {
            self.check_operand(operand);
        }
    }

    () record_call_return_loan(self, mir.MirCallTerminator call_term) {
        guard self.callee_function_def(call_term.callee) is .some(callee_def) else { return; }
        guard self.ctx.store.hirs.def(callee_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            self.record_call_return_loan_for_constraint(call_term, hir_def, constraint);
            index = index + 1;
        }
    }

    qid.DefId? callee_function_def(self, mir.MirCallCallee callee) {
        guard callee is .direct_function(function_value) else { return null; }
        return function_value.function_def;
    }

    () record_call_return_loan_for_constraint(self,
        mir.MirCallTerminator call_term,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint
    ) {
        if (constraint.shorter.kind != .return_lifetime) {
            return;
        }
        guard self.constraint_source_arg_index(hir_def, constraint) is .some(arg_index) else {
            return;
        }
        if (arg_index < 0 || arg_index >= call_term.args.length) {
            return;
        }
        guard self.operand_place(call_term.args[arg_index]) is .some(source) else {
            return;
        }
        self.add_loan(.reference_view, source, call_term.destination);
    }

    Int? constraint_source_arg_index(self, hir.HirDef& hir_def, hir.HirLifetimeConstraint constraint) {
        guard hir_def.decl.function_signature is .some(signature) else { return null; }
        // HIR signature 的 params 不包含 receiver，但 MIR call args[0] 是 receiver。
        // lifetime source 映射到 call operand 时必须显式补这个 ABI offset。
        if (constraint.longer.kind == .self_lifetime) {
            if (signature.has_receiver) { return 0; }
            return null;
        }
        guard self.constraint_source_symbol(constraint) is .some(source_symbol) else { return null; }
        Int! arg_offset = 0;
        if (signature.has_receiver) {
            arg_offset = 1;
        }
        Int! index = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == source_symbol) {
                return index + arg_offset;
            }
            index = index + 1;
        }
        return null;
    }

    qid.SymbolId? constraint_source_symbol(self, hir.HirLifetimeConstraint constraint) {
        if (constraint.longer.kind == .self_lifetime) {
            return self.ctx.store.symbols.intern("self");
        }
        if (constraint.longer.kind != .named_lifetime) {
            return null;
        }
        return constraint.longer.symbol;
    }

    mir.MirPlace? operand_place(self, mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            return copy_operand.place;
        }
        if (operand is .move_operand(move_operand)) {
            return move_operand.place;
        }
        return null;
    }

    () check_rvalue(self, mir.MirRvalue value) {
        if (value is .use_value(use_value)) {
            self.check_operand(use_value.value);
            return;
        }
        if (value is .unary_value(unary_value)) {
            self.check_operand(unary_value.value);
            return;
        }
        if (value is .binary_value(binary_value)) {
            self.check_operand(binary_value.lhs);
            self.check_operand(binary_value.rhs);
            return;
        }
        if (value is .cast_value(cast_value)) {
            self.check_operand(cast_value.value);
            return;
        }
        if (value is .inline_asm_value(inline_asm)) {
            self.check_inline_asm_rvalue(inline_asm);
            return;
        }
        if (value is .borrow_value(borrow_value)) {
            self.check_place_use(borrow_value.place);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.check_place_use(address_of_value.place);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.check_slice_rvalue(slice_value);
            return;
        }
        if (value is .len_value(len_value)) {
            self.check_place_use(len_value.place);
            return;
        }
        if (value is .discriminant_value(discriminant_value)) {
            self.check_place_use(discriminant_value.place);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.check_operands(aggregate_value.fields);
            return;
        }
        if (value is .optional_value(optional_value)) {
            self.check_operand(optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.check_error_union_rvalue(error_union_value);
        }
    }

    () check_inline_asm_rvalue(self, mir.MirInlineAsmRvalue value) {
        Int! index = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                self.check_operand(input.value);
            }
            index = index + 1;
        }
    }

    () check_error_union_rvalue(self, mir.MirErrorUnionRvalue value) {
        if (value.op == .is_error) {
            self.check_operand_place_use(value.value);
            return;
        }
        self.check_operand(value.value);
    }

    () check_slice_rvalue(self, mir.MirSliceRvalue value) {
        self.check_place_use(value.base);
        self.check_optional_operand(value.start);
        self.check_optional_operand(value.end);
    }

    () check_optional_operand(self, mir.MirOperand? operand) {
        if (operand is .some(value)) {
            self.check_operand(value);
        }
    }

    () check_operands(self, mir.MirOperand[]& operands) {
        Int! index = 0;
        while (index < operands.length) {
            self.check_operand(operands[index]);
            index = index + 1;
        }
    }

    () check_operand(self, mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.consume_place(move_operand.place);
        }
    }

    () check_operand_place_use(self, mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.check_place_use(move_operand.place);
        }
    }

    () consume_place(self, mir.MirPlace place) {
        self.check_place_use(place);
        if (self.place_is_indirect_memory(place)) {
            return;
        }
        if (!self.is_implicit_copy_place(place)) {
            move_path.MovePathId path = self.paths.path_for_place(place);
            self.mark_moved(path);
        }
    }

    // raw pointer / many pointer 指向的是编译器无法静态枚举的外部内存。
    // 读取 `p[i]` 会移动元素值，但不能把保存指针的本地变量 `p` 本身标成 moved。
    Bool place_is_indirect_memory(self, mir.MirPlace place) {
        qid.TypeId! base_type = self.place_base_type(place);
        Int! index = 0;
        while (index < place.projection.length) {
            if (self.projection_enters_untracked_memory(base_type, place.projection[index])) {
                return true;
            }
            base_type = self.projected_type(base_type, place.projection[index]);
            index = index + 1;
        }
        return false;
    }

    Bool projection_enters_untracked_memory(self, qid.TypeId base_type, mir.MirPlaceElem projection) {
        if (projection is .index_projection || projection is .constant_index_projection) {
            return self.type_is_raw_or_many_pointer(base_type);
        }
        if (projection is .deref_projection(deref)) {
            return deref.raw_pointer || self.type_is_raw_or_many_pointer(base_type);
        }
        return false;
    }

    Bool type_is_raw_or_many_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else {
            return false;
        }
        return handle.kind == .many_pointer || handle.kind == .raw_pointer;
    }

    () check_place_use(self, mir.MirPlace place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        if (self.is_path_uninitialized(path)) {
            self.results.mark_error();
            self.add_use_after_move_diagnostic();
        }
        self.check_active_loan_valid(path);
    }

    () check_active_loan_valid(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.loan_target_matches_path(fact.target, path) && self.loan_source_is_dead(fact)) {
                self.report_dead_source_loan(fact.loan_id);
            }
            index = index + 1;
        }
    }

    Bool check_loan_valid_for_fact(self, loan_facts.ActiveLoanFact fact) {
        if (!self.loan_source_is_dead(fact)) {
            return true;
        }
        self.report_dead_source_loan(fact.loan_id);
        return false;
    }

    () report_dead_source_loan(self, loan.LoanId loan_id) {
        loan.Loan current = self.results.loans.get(loan_id);
        if (self.reported_dead_loan_sources.has(current.source)) {
            return;
        }
        self.reported_dead_loan_sources.set(current.source, true);
        self.results.mark_error();
        self.add_borrow_escape_diagnostic();
    }

    Bool loan_source_is_dead(self, loan_facts.ActiveLoanFact fact) {
        loan.Loan current = self.results.loans.get(fact.loan_id);
        if (self.loan_source_is_live(current)) {
            return false;
        }
        return true;
    }

    Bool loan_source_is_live(self, loan.Loan current) {
        move_path.MovePath source = self.paths.get(current.source);
        move_path.MovePathId root = self.paths.root_for_local(source.local_id);
        return self.dataflow.live_locals.has(root);
    }

    () add_use_after_move_diagnostic(self) {
        if (!self.record_diagnostic(1)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("use_after_move"),
                self.current_source_range(),
                "use of moved value"
            )
        );
    }

    () add_unique_borrow_diagnostic(self) {
        if (!self.record_diagnostic(5)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("unique_borrow_conflict"),
                self.current_source_range(),
                "unique call conflicts with a live borrow"
            )
        );
    }

    () add_unique_requirement_diagnostic(self) {
        if (!self.record_diagnostic(6)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("unique_requirement_not_declared"),
                self.current_source_range(),
                "call requires unique access; declare @unique on the root parameter"
            )
        );
    }

    () clear_place(self, mir.MirPlace place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        self.clear_path_and_descendants(path);
    }

    () add_borrow_escape_diagnostic(self) {
        if (!self.record_diagnostic(2)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("borrowed_value_escape"),
                self.current_source_range(),
                "borrowed value escapes its owner"
            )
        );
    }

    () add_return_lifetime_diagnostic(self, return_lifetime.ReturnLifetimeStatus status) {
        if (status == .needs_explicit_lifetime) {
            self.add_return_lifetime_needs_annotation_diagnostic();
            return;
        }
        if (status == .source_not_allowed) {
            self.add_return_lifetime_source_not_allowed_diagnostic();
        }
    }

    () add_return_lifetime_needs_annotation_diagnostic(self) {
        if (!self.record_diagnostic(3)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("return_lifetime_needs_annotation"),
                self.current_source_range(),
                "return lifetime cannot be inferred from multiple sources"
            )
        );
    }

    () add_return_lifetime_source_not_allowed_diagnostic(self) {
        if (!self.record_diagnostic(4)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("return_lifetime_source_not_allowed"),
                self.current_source_range(),
                "returned borrow source is not allowed by lifetime annotations"
            )
        );
    }

    // MIR 只保存 byte span，不重复保存 source_id。borrow check 诊断用当前
    // 函数 DefId 的 SourceMap 记录补回 source_id，再取当前 statement/terminator span。
    diagnostic.SourceRange current_source_range(self) {
        guard self.ctx.store.source_map.def_span(self.function_def) is .some(function_loc) else {
            return diagnostic.SourceRange();
        }
        guard function_loc.source_id is .some(source_id) else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, self.current_span());
    }

    token.Span current_span(self) {
        if (self.current_location.kind == .terminator) {
            return self.current_block().terminator.span;
        }
        return self.current_statement().span;
    }

    mir.MirBlock current_block(self) {
        return self.body.blocks[self.current_location.block_id.to_index()];
    }

    mir.MirStatement current_statement(self) {
        return self.current_block().statements[self.current_location.statement_index];
    }

    Bool record_diagnostic(self, Int code) {
        BorrowDiagnosticKey key = BorrowDiagnosticKey(self.current_location, code);
        if (self.reported_diagnostics.has(key)) {
            return false;
        }
        self.reported_diagnostics.set(key, true);
        return true;
    }

    Bool has_active_loan_for_path(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.loan_target_matches_path(fact.target, path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    // 只返回匹配 path 的第一个 loan，用于追踪代表性来源。
    // 完整校验必须遍历 active_loans facts。
    loan.LoanId? first_active_loan_for_path(self, move_path.MovePathId path) {
        if (self.first_active_loan_for_exact_path(path) is .some(loan_id)) {
            return loan_id;
        }
        if (self.first_active_loan_for_ancestor(path) is .some(loan_id)) {
            return loan_id;
        }
        return self.first_active_loan_for_descendant(path);
    }

    loan.LoanId? first_active_loan_for_exact_path(self, move_path.MovePathId path) {
        return self.dataflow.active_loans.first_exact(path);
    }

    loan.LoanId? first_active_loan_for_ancestor(self, move_path.MovePathId path) {
        move_path.MovePath! current = self.paths.get(path);
        while (current.has_parent) {
            if (self.first_active_loan_for_exact_path(current.parent) is .some(loan_id)) {
                return loan_id;
            }
            current = self.paths.get(current.parent);
        }
        return null;
    }

    loan.LoanId? first_active_loan_for_descendant(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.is_descendant_of(fact.target, path)) {
                return fact.loan_id;
            }
            index = index + 1;
        }
        return null;
    }

    () mark_moved(self, move_path.MovePathId path) {
        self.clear_descendants(path);
        self.dataflow.moved.set(path, true);
    }

    Bool is_path_uninitialized(self, move_path.MovePathId path) {
        if (self.dataflow.moved.has(path)) {
            return true;
        }
        if (self.has_moved_ancestor(path)) {
            return true;
        }
        return self.has_moved_descendant(path);
    }

    Bool has_moved_ancestor(self, move_path.MovePathId path) {
        move_path.MovePath! current = self.paths.get(path);
        while (current.has_parent) {
            if (self.dataflow.moved.has(current.parent)) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    Bool has_moved_descendant(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId candidate = move_path.MovePathId(index);
            if (self.dataflow.moved.has(candidate) && self.is_descendant_of(candidate, path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool is_descendant_of(self, move_path.MovePathId child, move_path.MovePathId parent) {
        move_path.MovePath! current = self.paths.get(child);
        while (current.has_parent) {
            if (current.parent == parent) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    () clear_path_and_descendants(self, move_path.MovePathId path) {
        self.dataflow.moved.remove(path);
        self.remove_active_loan_facts_under(path);
        self.clear_descendants(path);
    }

    () clear_descendants(self, move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId candidate = move_path.MovePathId(index);
            if (self.is_descendant_of(candidate, path)) {
                self.dataflow.moved.remove(candidate);
            }
            index = index + 1;
        }
    }

    () remove_active_loan_facts_under(self, move_path.MovePathId path) {
        loan_facts.ActiveLoanFacts! kept = loan_facts.ActiveLoanFacts(self.dataflow.active_loans.len());
        Int! index = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (!self.active_loan_target_under_path(fact, path)) {
                kept.add(fact);
            }
            index = index + 1;
        }
        self.dataflow.active_loans = kept$.move();
    }

    Bool active_loan_target_under_path(self, loan_facts.ActiveLoanFact fact, move_path.MovePathId path) {
        return self.path_matches_or_contains(path, fact.target);
    }

    Bool path_matches_or_contains(self, move_path.MovePathId parent, move_path.MovePathId candidate) {
        if (parent == candidate) { return true; }
        return self.is_descendant_of(candidate, parent);
    }

    Bool is_implicit_copy_place(self, mir.MirPlace place) {
        return self.is_implicit_copy_type(self.place_type(place));
    }

    qid.TypeId place_type(self, mir.MirPlace place) {
        qid.TypeId! type_id = self.place_base_type(place);
        Int! index = 0;
        while (index < place.projection.length) {
            type_id = self.projected_type(type_id, place.projection[index]);
            index = index + 1;
        }
        return type_id;
    }

    Bool same_local_base(self, mir.MirPlace lhs, mir.MirPlace rhs) {
        guard mir.place_local_id(lhs) is .some(left) else { return false; }
        guard mir.place_local_id(rhs) is .some(right) else { return false; }
        return left.to_index() == right.to_index();
    }

    Bool valid_move_path(self, move_path.MovePathId path) {
        return path.to_index() >= 0 && self.paths.valid_path_id(path);
    }

    qid.TypeId place_base_type(self, mir.MirPlace place) {
        if (place.base is .global(global_ref)) {
            return global_ref.type_id;
        }
        return self.local_type(place.local_id);
    }

    qid.TypeId local_type(self, mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        if (index >= 0 && index < self.body.locals.length) {
            return self.body.locals[index].type_id;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId projected_type(self, qid.TypeId base_type, mir.MirPlaceElem projection) {
        if (projection is .field_projection(field)) {
            return field.field_type;
        }
        if (projection is .deref_projection) {
            types.TypeInfo base_info = self.ctx.store.types.get(base_type);
            guard base_info.data is .handle_type(handle) else {
                return self.ctx.store.types.invalid_type();
            }
            return handle.element;
        }
        if (projection is .index_projection) {
            return self.indexed_type(base_type);
        }
        if (projection is .constant_index_projection(constant_index)) {
            return self.constant_indexed_type(base_type, constant_index.offset);
        }
        if (projection is .subslice_projection) {
            return base_type;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId indexed_type(self, qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            return handle.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .tuple_type(tuple_type)) {
            if (tuple_type.items.length > 0) {
                return tuple_type.items[0];
            }
        }
        return base_type;
    }

    qid.TypeId constant_indexed_type(self, qid.TypeId base_type, Int offset) {
        if (self.report_generic_param_layout_base(base_type)) {
            return self.ctx.store.types.invalid_type();
        }
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.ctx, base_type);
        layout.TypeLayout type_layout = self.ctx.store.layouts.layout(layout_id);
        if (offset >= 0 && offset < type_layout.fields.length) {
            return type_layout.fields[offset].field_type;
        }
        return self.indexed_type(base_type);
    }

    Bool report_generic_param_layout_base(self, qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        guard info.data is .named(named) else { return false; }
        if (self.ctx.store.defs.get(named.def_id).kind != .generic_param_def) {
            return false;
        }
        self.results.mark_error();
        qid.SymbolId symbol = self.ctx.store.defs.get(named.def_id).name.symbol;
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("borrow_generic_param_layout_base"),
                self.current_source_range(),
                self.ctx.store.symbols.text(symbol)
            )
        );
        return true;
    }

    Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.ctx.store$.ref());
        return query.is_implicit_copy_type(type_id);
    }
}
