// Borrow check 的函数体检查器。
//
// 当前先实现 move/use 的基础语义：MIR operand 读 place 时，根据类型决定
// 是 implicit copy 还是 move；move 后再次读取同一个 move path、祖先 path
// 或子 path 都会把 BorrowCheckStore 标成失败。完整 CFG dataflow 后续会
// 在这里替换线性扫描状态，而不是改 MIR 结构。

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import layout = "../layout/layout.jiang";
import layout_compute = "../layout/compute.jiang";
import mir = "../mir/mir.jiang";
import qid = "../store/id.jiang";
import copy_semantics = "../sema/copy.jiang";
import drop_semantics = "../sema/drop.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import loan = "./loan.jiang";
import location = "./location.jiang";
import move_path = "./move_path.jiang";
import borrow_store = "./store.jiang";

public struct PackageBorrowChecker {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;
    public layout.LayoutStore& layouts;
    public borrow_store.BorrowCheckStore& results;
    public init(
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
    }

    public () check_store(mir.MirStore& store) {
        Int! index = 0;
        while (index < store.functions.len()) {
            self.check_function(store.functions.get(index));
            index = index + 1;
        }
    }

    () check_function(mir.MirFunction function) {
        FunctionBorrowChecker! checker = FunctionBorrowChecker(
            self.ctx,
            self.typeck,
            self.layouts,
            self.results,
            function
        );
        checker.check();
    }
}

struct BorrowDataflowState: Movable {
    public table.HashTable<move_path.MovePathId, Bool>! moved;
    public table.HashTable<move_path.MovePathId, loan.LoanId>! active_loans;

    public init() {
        self.moved = table.HashTable<move_path.MovePathId, Bool>();
        self.active_loans = table.HashTable<move_path.MovePathId, loan.LoanId>();
    }
}

struct BorrowDiagnosticKey: Hashable, Equatable {
    public mir.MirFunctionId function_id;
    public mir.MirBlockId block_id;
    public location.MirLocationKind kind;
    public Int statement_index;
    public Int code;

    public init(location.MirLocation current, Int code) {
        self.function_id = current.function_id;
        self.block_id = current.block_id;
        self.kind = current.kind;
        self.statement_index = current.statement_index;
        self.code = code;
    }

    public UInt64 hash() {
        hash.WyHasher! hasher = hash.WyHasher();
        hasher.write_int(self.function_id.to_index());
        hasher.write_int(self.block_id.to_index());
        hasher.write_int(self.kind_index());
        hasher.write_int(self.statement_index);
        hasher.write_int(self.code);
        return hasher.finish();
    }

    Int kind_index() {
        if (self.kind == .statement) {
            return 1;
        }
        return 2;
    }

    public static Bool equal(BorrowDiagnosticKey& lhs, BorrowDiagnosticKey& rhs) {
        if (lhs.function_id.to_index() != rhs.function_id.to_index()) { return false; }
        if (lhs.block_id.to_index() != rhs.block_id.to_index()) { return false; }
        if (lhs.kind_index() != rhs.kind_index()) { return false; }
        if (lhs.statement_index != rhs.statement_index) { return false; }
        return lhs.code == rhs.code;
    }
}

struct FunctionBorrowChecker: Movable {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;
    public layout.LayoutStore& layouts;
    public borrow_store.BorrowCheckStore& results;
    public mir.MirFunctionId function_id;
    public qid.DefId function_def;
    public mir.MirBody body;
    public move_path.MovePathTree! paths;
    public BorrowDataflowState! dataflow;
    public location.MirLocation! current_location;
    public table.HashTable<BorrowDiagnosticKey, Bool>! reported_diagnostics;
    public list.ArrayList<qid.SymbolId>! return_lifetime_sources;

    public init(
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results,
        mir.MirFunction function
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
        self.function_id = function.id;
        self.function_def = function.def_id;
        self.body = function.body;
        mir.MirBody! body = function.body;
        self.paths = move_path.build_move_path_tree(body$.ref());
        self.dataflow = BorrowDataflowState();
        self.current_location = location.MirLocation(function.id, body.entry, .terminator, -1);
        self.reported_diagnostics = table.HashTable<BorrowDiagnosticKey, Bool>();
        self.return_lifetime_sources = list.ArrayList<qid.SymbolId>();
    }

    public () check() {
        Int block_count = self.body.blocks.length;
        if (block_count == 0) {
            return;
        }

        BorrowDataflowState![*] in_states = BorrowDataflowState!$.alloc_many(block_count);
        Bool![*] reachable = Bool!$.alloc_many(block_count);
        Bool![*] queued = Bool!$.alloc_many(block_count);
        self.init_dataflow_arrays(in_states, reachable, queued, block_count);

        list.ArrayList<Int>! worklist = list.ArrayList<Int>();
        Int entry_index = self.body.entry.to_index();
        if (!self.valid_block_index(entry_index)) {
            return;
        }
        self.enqueue_block(entry_index, reachable, queued, worklist$.ref());

        while (!worklist.empty()) {
            Int block_index = worklist.pop();
            queued[block_index] = false;
            self.dataflow = self.clone_state(in_states[block_index]$.ref());
            self.check_block(self.body.blocks[block_index]);
            self.propagate_successors(
                self.body.blocks[block_index],
                in_states,
                reachable,
                queued,
                worklist$.ref()
            );
        }
    }

    () init_dataflow_arrays(
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        Int block_count
    ) {
        Int! index = 0;
        while (index < block_count) {
            in_states[index] = BorrowDataflowState();
            reachable[index] = false;
            queued[index] = false;
            index = index + 1;
        }
    }

    Bool valid_block_index(Int block_index) {
        return block_index >= 0 && block_index < self.body.blocks.length;
    }

    () enqueue_block(
        Int block_index,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        reachable[block_index] = true;
        if (queued[block_index]) {
            return;
        }
        queued[block_index] = true;
        worklist.add(block_index);
    }

    () propagate_successors(
        mir.MirBlock block,
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        Int! successor_index = 0;
        while (successor_index < mir.terminator_successor_count(block.terminator)) {
            mir.MirBlockId successor = mir.terminator_successor_at(block.terminator, successor_index);
            self.propagate_successor(successor, in_states, reachable, queued, worklist);
            successor_index = successor_index + 1;
        }
    }

    () propagate_successor(
        mir.MirBlockId successor,
        BorrowDataflowState![*] in_states,
        Bool![*] reachable,
        Bool![*] queued,
        list.ArrayList<Int>& worklist
    ) {
        Int successor_index = successor.to_index();
        if (!self.valid_block_index(successor_index)) {
            return;
        }

        Bool was_reachable = reachable[successor_index];
        Bool changed = self.merge_state(in_states[successor_index]$.ref(), self.dataflow$.ref());
        if (!was_reachable || changed) {
            self.enqueue_block(successor_index, reachable, queued, worklist);
        }
    }

    BorrowDataflowState clone_state(BorrowDataflowState& source) {
        BorrowDataflowState! clone = BorrowDataflowState();
        self.merge_state(clone$.ref(), source);
        return clone$.move();
    }

    // CFG 合流采用 may-analysis：任一前驱 move/borrow 过的 path，在后继入口都视为可能存在。
    Bool merge_state(BorrowDataflowState& target, BorrowDataflowState& source) {
        Bool! changed = false;
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId path = move_path.MovePathId(index);
            changed = self.merge_moved_path(target, source, path) || changed;
            changed = self.merge_active_loan(target, source, path) || changed;
            index = index + 1;
        }
        return changed;
    }

    Bool merge_moved_path(
        BorrowDataflowState& target,
        BorrowDataflowState& source,
        move_path.MovePathId path
    ) {
        if (!source.moved.has(path)) {
            return false;
        }
        if (target.moved.has(path)) {
            return false;
        }
        target.moved.set(path, true);
        return true;
    }

    Bool merge_active_loan(
        BorrowDataflowState& target,
        BorrowDataflowState& source,
        move_path.MovePathId path
    ) {
        guard source.active_loans.get(path) is .some(loan_id) else {
            return false;
        }
        if (target.active_loans.get(path) is .some(existing_loan_id)) {
            return self.record_merged_return_lifetime_sources(path, existing_loan_id$.get(), loan_id$.get());
        }
        target.active_loans.set(path, loan_id$.get());
        return true;
    }

    Bool record_merged_return_lifetime_sources(
        move_path.MovePathId path,
        loan.LoanId existing_loan_id,
        loan.LoanId incoming_loan_id
    ) {
        if (!self.is_return_local_path(path)) {
            return false;
        }
        Bool! changed = self.add_return_lifetime_source_for_loan(existing_loan_id);
        return self.add_return_lifetime_source_for_loan(incoming_loan_id) || changed;
    }

    () check_block(mir.MirBlock block) {
        Int! stmt_index = 0;
        while (stmt_index < block.statements.length) {
            self.current_location = location.MirLocation(
                self.function_id,
                block.id,
                .statement,
                stmt_index
            );
            self.check_statement(block.statements[stmt_index]);
            stmt_index = stmt_index + 1;
        }
        self.current_location = location.MirLocation(self.function_id, block.id, .terminator, -1);
        self.check_terminator(block.terminator);
    }

    () check_statement(mir.MirStatement statement) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            self.check_rvalue(assign_stmt.value);
            self.check_assignment_escape(assign_stmt.destination, assign_stmt.value);
            self.clear_place(assign_stmt.destination);
            self.record_assignment_loan(assign_stmt.destination, assign_stmt.value);
            return;
        }
        if (statement.kind is .set_discriminant_stmt(discriminant_stmt)) {
            self.clear_place(discriminant_stmt.destination);
            return;
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            self.consume_place(forget_stmt.place);
            return;
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            self.clear_storage_dead_local(storage_dead.local_id);
        }
    }

    () clear_storage_dead_local(mir.MirLocalId local_id) {
        move_path.MovePathId path = self.paths.root_for_local(local_id);
        self.clear_path_and_descendants(path);
    }

    () check_assignment_escape(mir.MirPlace destination, mir.MirRvalue value) {
        if (!self.place_may_write_outside_current_body(destination)) {
            return;
        }
        if (self.rvalue_contains_borrowed_value(value)) {
            if (self.current_function_is_init() && self.destination_has_deref_projection(destination)) {
                return;
            }
            if (self.assignment_lifetime_allows_escape(destination, value)) {
                return;
            }
            self.results.mark_error();
            self.add_borrow_escape_diagnostic();
        }
    }

    Bool assignment_lifetime_allows_escape(mir.MirPlace destination, mir.MirRvalue value) {
        if (value is .borrow_value(borrow_value)) {
            return self.field_lifetime_allows_borrow_store(destination, borrow_value.place);
        }
        if (value is .address_of_value(address_of_value)) {
            return self.field_lifetime_allows_borrow_store(destination, address_of_value.place);
        }
        if (value is .use_value(use_value)) {
            return self.self_lifetime_allows_borrow_store(destination, use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.self_lifetime_allows_borrow_store(destination, cast_value.value);
        }
        return false;
    }

    Bool self_lifetime_allows_borrow_store(mir.MirPlace destination, mir.MirOperand operand) {
        guard self.operand_place(operand) is .some(source) else { return false; }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        return self.source_root_param_symbol(self.paths.path_for_place(source)) != null;
    }

    Bool destination_is_self_place(mir.MirPlace destination) {
        move_path.MovePath path = self.paths.get(self.paths.root_for_local(destination.local_id));
        Int local_index = path.local_id.to_index();
        if (local_index < 0 || local_index >= self.body.locals.length) {
            return false;
        }
        mir.MirLocalDecl local = self.body.locals[local_index];
        guard local.name is .some(symbol) else { return false; }
        return self.source_symbol_is_self(symbol);
    }

    Bool field_lifetime_allows_borrow_store(mir.MirPlace destination, mir.MirPlace source) {
        guard self.destination_field_def(destination) is .some(_) else {
            return false;
        }
        if (destination.local_id.to_index() == source.local_id.to_index()) {
            return true;
        }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        return self.source_root_param_symbol(self.paths.path_for_place(source)) != null;
    }

    Bool destination_may_be_initialized_self(mir.MirPlace destination) {
        if (self.destination_is_self_place(destination)) {
            return true;
        }
        return self.current_function_is_init() && self.destination_has_deref_projection(destination);
    }

    Bool current_function_is_init() {
        return self.ctx.store.defs.get(self.function_def).kind == .init_def;
    }

    Bool destination_has_deref_projection(mir.MirPlace destination) {
        Int! index = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? destination_field_def(mir.MirPlace destination) {
        qid.DefId?! field_def = null;
        Int! index = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .field_projection(field)) {
                field_def = field.field_def;
            }
            index = index + 1;
        }
        return field_def;
    }

    Bool place_may_write_outside_current_body(mir.MirPlace place) {
        Int! index = 0;
        while (index < place.projection.length) {
            if (place.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool rvalue_contains_borrowed_value(mir.MirRvalue value) {
        if (value is .borrow_value) {
            return true;
        }
        if (value is .address_of_value) {
            return true;
        }
        if (value is .slice_value(slice_value)) {
            return self.slice_rvalue_contains_active_loan(slice_value);
        }
        if (value is .use_value(use_value)) {
            return self.operand_contains_active_loan(use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.operand_contains_active_loan(cast_value.value);
        }
        if (value is .optional_value(optional_value)) {
            return self.operand_contains_active_loan(optional_value.value);
        }
        if (value is .error_union_value(error_union_value)) {
            return self.operand_contains_active_loan(error_union_value.value);
        }
        if (value is .aggregate_value(aggregate_value)) {
            return self.operands_contain_active_loan(aggregate_value.fields);
        }
        return false;
    }

    Bool slice_rvalue_contains_active_loan(mir.MirSliceRvalue value) {
        if (self.active_loan_for_path(self.paths.path_for_place(value.base)) != null) {
            return true;
        }
        if (self.optional_operand_contains_active_loan(value.start)) { return true; }
        return self.optional_operand_contains_active_loan(value.end);
    }

    Bool optional_operand_contains_active_loan(mir.MirOperand? operand) {
        if (operand is .some(value)) {
            return self.operand_contains_active_loan(value);
        }
        return false;
    }

    Bool operands_contain_active_loan(mir.MirOperand[]& operands) {
        Int! index = 0;
        while (index < operands.length) {
            if (self.operand_contains_active_loan(operands[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool operand_contains_active_loan(mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            if (!self.place_type_may_carry_borrow(copy_operand.place)) { return false; }
            return self.active_loan_for_path(self.paths.path_for_place(copy_operand.place)) != null;
        }
        if (operand is .move_operand(move_operand)) {
            if (!self.place_type_may_carry_borrow(move_operand.place)) { return false; }
            return self.active_loan_for_path(self.paths.path_for_place(move_operand.place)) != null;
        }
        return false;
    }

    () record_assignment_loan(mir.MirPlace destination, mir.MirRvalue value) {
        if (value is .borrow_value(borrow_value)) {
            self.add_loan(.reference_view, borrow_value.place, destination);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.add_loan(.raw_pointer_view, address_of_value.place, destination);
            return;
        }
        if (value is .use_value(use_value)) {
            self.record_operand_loan(destination, use_value.value);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.record_slice_loan(destination, slice_value);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.record_aggregate_loan(destination, aggregate_value);
        }
    }

    () record_aggregate_loan(mir.MirPlace destination, mir.MirAggregateRvalue value) {
        Int! index = 0;
        while (index < value.fields.length) {
            self.record_operand_loan(destination, value.fields[index]);
            index = index + 1;
        }
    }

    () record_slice_loan(mir.MirPlace destination, mir.MirSliceRvalue value) {
        types.TypeInfo base_info = self.ctx.store.types.get(self.place_type(value.base));
        if (base_info.data is .array_type(_)) {
            self.add_loan(.reference_view, value.base, destination);
            return;
        }
        if (base_info.data is .handle_type(handle)) {
            if (handle.kind == .slice) {
                self.record_operand_loan(
                    destination,
                    mir.copy_operand_value(mir.MirCopyOperand (place: value.base))
                );
            }
        }
    }

    // 复制 `T&`/`T*` 值本身不会创建新 owner，但会把来源 loan 传播到目标 place。
    // 这让 `return_value.field = input_ref` 这类字段写入能在 return 检查时被看见。
    () record_operand_loan(mir.MirPlace destination, mir.MirOperand operand) {
        if (!self.place_type_may_carry_borrow(destination)) { return; }
        guard self.operand_place(operand) is .some(source) else { return; }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (self.active_loan_for_path(source_path) is .some(loan_id)) {
            loan.Loan current = self.results.loans.get(loan_id);
            self.add_loan_from_paths(current.kind, current.source, self.paths.path_for_place(destination));
            return;
        }
        if (!self.local_is_param(source.local_id)) {
            return;
        }
        if (self.place_handle_loan_kind(source) is .some(kind)) {
            self.add_loan(kind, source, destination);
        }
    }

    Bool local_is_param(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        if (!self.valid_local_index(index)) {
            return false;
        }
        return self.body.locals[index].kind == .param;
    }

    Bool place_type_may_carry_borrow(mir.MirPlace place) {
        return self.type_may_carry_borrow(self.place_type(place));
    }

    loan.LoanKind? place_handle_loan_kind(mir.MirPlace place) {
        types.TypeInfo info = self.ctx.store.types.get(self.place_type(place));
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any) { return loan.raw_pointer_view_kind(); }
            return null;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (types.is_reference_handle(handle)) { return loan.reference_view_kind(); }
        if (types.is_slice_handle(handle)) { return loan.reference_view_kind(); }
        if (types.is_raw_pointer_handle(handle)) { return loan.raw_pointer_view_kind(); }
        return null;
    }

    Bool type_may_carry_borrow(qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .trait_companion(companion)) {
            return companion.kind == .any;
        }
        guard info.data is .handle_type(handle) else { return false; }
        if (types.is_reference_handle(handle)) { return true; }
        if (types.is_slice_handle(handle)) { return true; }
        return types.is_raw_pointer_handle(handle);
    }

    Bool valid_local_index(Int index) {
        return index >= 0 && index < self.body.locals.length;
    }

    () add_loan(loan.LoanKind kind, mir.MirPlace source, mir.MirPlace target) {
        move_path.MovePathId source_path = self.canonical_loan_source(self.paths.path_for_place(source));
        move_path.MovePathId target_path = self.paths.path_for_place(target);
        self.add_loan_from_paths(kind, source_path, target_path);
    }

    () add_loan_from_paths(loan.LoanKind kind, move_path.MovePathId source, move_path.MovePathId target) {
        move_path.MovePathId canonical_source = self.canonical_loan_source(source);
        loan.LoanId loan_id = self.results.add_loan(kind, self.function_id, canonical_source, target);
        self.dataflow.active_loans.set(target, loan_id);
    }

    move_path.MovePathId canonical_loan_source(move_path.MovePathId source) {
        move_path.MovePathId! current_source = source;
        Int! depth = 0;
        while (depth < 32) {
            guard self.active_loan_for_path(current_source) is .some(loan_id) else {
                return current_source;
            }
            loan.Loan current = self.results.loans.get(loan_id);
            if (current.source == current_source) {
                return current_source;
            }
            current_source = current.source;
            depth = depth + 1;
        }
        return current_source;
    }

    () check_terminator(mir.MirTerminator terminator) {
        if (terminator.kind is .branch_term(branch)) {
            self.check_operand(branch.condition);
            return;
        }
        if (terminator.kind is .switch_term(switch_term)) {
            self.check_operand(switch_term.discriminator);
            return;
        }
        if (terminator.kind is .call_term(call_term)) {
            self.check_call(call_term);
            return;
        }
        if (terminator.kind is .drop_term(drop_term)) {
            self.check_drop(drop_term.place);
            return;
        }
        if (terminator.kind is .assert_term(assert_term)) {
            self.check_operand(assert_term.condition);
            return;
        }
        if (terminator.kind is .return_term(return_term)) {
            self.check_return(return_term);
            return;
        }
        if (terminator.kind is .throw_term(throw_term)) {
            self.check_operand(throw_term.error_value);
        }
    }

    () check_drop(mir.MirPlace place) {
        if (!self.place_needs_drop(place)) {
            return;
        }
        move_path.MovePathId path = self.paths.path_for_place(place);
        self.check_place_use(place);
        self.mark_moved(path);
    }

    Bool place_needs_drop(mir.MirPlace place) {
        if (self.place_is_indirect_memory(place)) {
            return false;
        }
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.ctx);
        return query.type_needs_runtime_drop(self.place_type(place));
    }

    () check_return(mir.MirReturnTerminator return_term) {
        if (return_term.implicit_unit) {
            return;
        }
        self.check_return_path_escape(self.paths.root_for_local(self.body.return_local));
    }

    () check_return_path_escape(move_path.MovePathId path) {
        guard self.active_loan_for_path(path) is .some(loan_id) else { return; }
        if (self.return_lifetime_allows_loan(loan_id)) {
            return;
        }
        self.results.mark_error();
        self.add_borrow_escape_diagnostic();
    }

    Bool return_lifetime_allows_loan(loan.LoanId loan_id) {
        if (self.current_function_is_init()) {
            return true;
        }
        loan.Loan current = self.results.loans.get(loan_id);
        if (!self.return_target_lifetime_allows_loan(current)) {
            return false;
        }
        guard self.ctx.store.hirs.def(self.function_def) is .some(hir_def) else {
            return false;
        }
        guard self.source_root_param_symbol(current.source) is .some(source_symbol) else { return false; }
        self.add_return_lifetime_source(source_symbol);
        // 显式 return lifetime 出现后只允许标注中的来源；否则使用默认规则：
        // 本函数所有返回引用只能来自同一种输入来源。
        if (self.hir_has_explicit_return_lifetime(hir_def)) {
            return self.hir_allows_all_return_lifetime_sources(hir_def);
        }
        return self.return_lifetime_sources.len() == 1;
    }

    Bool add_return_lifetime_source_for_loan(loan.LoanId loan_id) {
        loan.Loan current = self.results.loans.get(loan_id);
        guard self.source_root_param_symbol(current.source) is .some(source_symbol) else {
            return false;
        }
        return self.add_return_lifetime_source(source_symbol);
    }

    Bool add_return_lifetime_source(qid.SymbolId source_symbol) {
        if (self.has_return_lifetime_source(source_symbol)) {
            return false;
        }
        self.return_lifetime_sources.add(source_symbol);
        return true;
    }

    Bool has_return_lifetime_source(qid.SymbolId source_symbol) {
        Int! index = 0;
        while (index < self.return_lifetime_sources.len()) {
            qid.SymbolId existing = self.return_lifetime_sources.get(index);
            if (qid.SymbolId.equal(existing$.ref(), source_symbol$.ref())) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool hir_allows_all_return_lifetime_sources(hir.HirDef& hir_def) {
        Int! index = 0;
        while (index < self.return_lifetime_sources.len()) {
            qid.SymbolId source_symbol = self.return_lifetime_sources.get(index);
            if (!self.hir_allows_return_lifetime(hir_def, source_symbol)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool return_target_lifetime_allows_loan(loan.Loan current) {
        if (!self.is_return_local_path(current.target)) {
            return true;
        }
        return true;
    }

    Bool is_return_local_path(move_path.MovePathId path_id) {
        move_path.MovePath path = self.paths.get(path_id);
        return path.local_id.to_index() == self.body.return_local.to_index();
    }

    qid.DefId? target_field_def(move_path.MovePathId path_id) {
        qid.DefId?! field_def = null;
        move_path.MovePath! current = self.paths.get(path_id);
        while (true) {
            if (current.has_projection) {
                if (current.projection is .field_projection(field)) {
                    field_def = field.field_def;
                }
            }
            if (!current.has_parent) {
                return field_def;
            }
            current = self.paths.get(current.parent);
        }
        return field_def;
    }

    Bool hir_has_explicit_return_lifetime(hir.HirDef& hir_def) {
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            if (constraint.shorter.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.SymbolId? source_root_param_symbol(move_path.MovePathId source) {
        move_path.MovePath path = self.paths.get(source);
        Int local_index = path.local_id.to_index();
        if (local_index < 0 || local_index >= self.body.locals.length) {
            return null;
        }
        mir.MirLocalDecl local = self.body.locals[local_index];
        if (local.kind != .param) {
            return self.source_root_param_symbol_from_local_loan(path.local_id);
        }
        return local.name;
    }

    qid.SymbolId? source_root_param_symbol_from_local_loan(mir.MirLocalId local_id) {
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        guard self.dataflow.active_loans.get(root) is .some(loan_id) else {
            return null;
        }
        loan.Loan current = self.results.loans.get(loan_id$.get());
        return self.source_root_param_symbol(current.source);
    }

    Bool hir_allows_return_lifetime(hir.HirDef& hir_def, qid.SymbolId source_symbol) {
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            if (self.is_return_lifetime_constraint(constraint, source_symbol)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool is_return_lifetime_constraint(hir.HirLifetimeConstraint constraint, qid.SymbolId source_symbol) {
        if (constraint.shorter.kind != .return_lifetime) {
            return false;
        }
        if (constraint.longer.kind == .self_lifetime) {
            return self.source_symbol_is_self(source_symbol);
        }
        if (constraint.longer.kind != .named_lifetime) { return false; }
        guard constraint.longer.symbol is .some(longer_symbol) else {
            return false;
        }
        return longer_symbol == source_symbol;
    }

    Bool source_symbol_is_self(qid.SymbolId source_symbol) {
        qid.SymbolId self_symbol = self.ctx.store.symbols.intern("self");
        return qid.SymbolId.equal(source_symbol$.ref(), self_symbol$.ref());
    }

    () check_call(mir.MirCallTerminator call_term) {
        self.check_call_callee(call_term.callee);
        Int! index = 0;
        while (index < call_term.args.length) {
            self.check_operand(call_term.args[index]);
            index = index + 1;
        }
        self.clear_place(call_term.destination);
        if (call_term.initialized_place is .some(initialized_place)) {
            self.clear_place(initialized_place);
        }
        self.record_call_return_loan(call_term);
    }

    () check_call_callee(mir.MirCallCallee callee) {
        if (callee is .indirect_operand(operand)) {
            self.check_operand(operand);
        }
    }

    () record_call_return_loan(mir.MirCallTerminator call_term) {
        guard self.callee_function_def(call_term.callee) is .some(callee_def) else { return; }
        guard self.ctx.store.hirs.def(callee_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            self.record_call_return_loan_for_constraint(call_term, hir_def, constraint);
            index = index + 1;
        }
    }

    qid.DefId? callee_function_def(mir.MirCallCallee callee) {
        guard callee is .direct_function(function_value) else { return null; }
        return function_value.function_def;
    }

    () record_call_return_loan_for_constraint(
        mir.MirCallTerminator call_term,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint
    ) {
        if (constraint.shorter.kind != .return_lifetime) {
            return;
        }
        guard self.constraint_source_arg_index(hir_def, constraint) is .some(arg_index) else {
            return;
        }
        if (arg_index < 0 || arg_index >= call_term.args.length) {
            return;
        }
        guard self.operand_place(call_term.args[arg_index]) is .some(source) else {
            return;
        }
        self.add_loan(.reference_view, source, call_term.destination);
    }

    Int? constraint_source_arg_index(hir.HirDef& hir_def, hir.HirLifetimeConstraint constraint) {
        guard hir_def.decl.function_signature is .some(signature) else { return null; }
        // HIR signature 的 params 不包含 receiver，但 MIR call args[0] 是 receiver。
        // lifetime source 映射到 call operand 时必须显式补这个 ABI offset。
        if (constraint.longer.kind == .self_lifetime) {
            if (signature.has_receiver) { return 0; }
            return null;
        }
        guard self.constraint_source_symbol(constraint) is .some(source_symbol) else { return null; }
        Int! arg_offset = 0;
        if (signature.has_receiver) {
            arg_offset = 1;
        }
        Int! index = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == source_symbol) {
                return index + arg_offset;
            }
            index = index + 1;
        }
        return null;
    }

    qid.SymbolId? constraint_source_symbol(hir.HirLifetimeConstraint constraint) {
        if (constraint.longer.kind == .self_lifetime) {
            return self.ctx.store.symbols.intern("self");
        }
        if (constraint.longer.kind != .named_lifetime) {
            return null;
        }
        return constraint.longer.symbol;
    }

    mir.MirPlace? operand_place(mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            return copy_operand.place;
        }
        if (operand is .move_operand(move_operand)) {
            return move_operand.place;
        }
        return null;
    }

    () check_rvalue(mir.MirRvalue value) {
        if (value is .use_value(use_value)) {
            self.check_operand(use_value.value);
            return;
        }
        if (value is .unary_value(unary_value)) {
            self.check_operand(unary_value.value);
            return;
        }
        if (value is .binary_value(binary_value)) {
            self.check_operand(binary_value.lhs);
            self.check_operand(binary_value.rhs);
            return;
        }
        if (value is .cast_value(cast_value)) {
            self.check_operand(cast_value.value);
            return;
        }
        if (value is .borrow_value(borrow_value)) {
            self.check_place_use(borrow_value.place);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.check_place_use(address_of_value.place);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.check_slice_rvalue(slice_value);
            return;
        }
        if (value is .len_value(len_value)) {
            self.check_place_use(len_value.place);
            return;
        }
        if (value is .discriminant_value(discriminant_value)) {
            self.check_place_use(discriminant_value.place);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.check_operands(aggregate_value.fields);
            return;
        }
        if (value is .optional_value(optional_value)) {
            self.check_operand(optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.check_error_union_rvalue(error_union_value);
        }
    }

    () check_error_union_rvalue(mir.MirErrorUnionRvalue value) {
        if (value.op == .is_error) {
            self.check_operand_place_use(value.value);
            return;
        }
        self.check_operand(value.value);
    }

    () check_slice_rvalue(mir.MirSliceRvalue value) {
        self.check_place_use(value.base);
        self.check_optional_operand(value.start);
        self.check_optional_operand(value.end);
    }

    () check_optional_operand(mir.MirOperand? operand) {
        if (operand is .some(value)) {
            self.check_operand(value);
        }
    }

    () check_operands(mir.MirOperand[]& operands) {
        Int! index = 0;
        while (index < operands.length) {
            self.check_operand(operands[index]);
            index = index + 1;
        }
    }

    () check_operand(mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.consume_place(move_operand.place);
        }
    }

    () check_operand_place_use(mir.MirOperand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.check_place_use(move_operand.place);
        }
    }

    () consume_place(mir.MirPlace place) {
        self.check_place_use(place);
        if (self.place_is_indirect_memory(place)) {
            return;
        }
        if (!self.is_implicit_copy_place(place)) {
            move_path.MovePathId path = self.paths.path_for_place(place);
            self.mark_moved(path);
        }
    }

    // raw pointer / many pointer 指向的是编译器无法静态枚举的外部内存。
    // 读取 `p[i]` 会移动元素值，但不能把保存指针的本地变量 `p` 本身标成 moved。
    Bool place_is_indirect_memory(mir.MirPlace place) {
        qid.TypeId! base_type = self.local_type(place.local_id);
        Int! index = 0;
        while (index < place.projection.length) {
            if (self.projection_enters_untracked_memory(base_type, place.projection[index])) {
                return true;
            }
            base_type = self.projected_type(base_type, place.projection[index]);
            index = index + 1;
        }
        return false;
    }

    Bool projection_enters_untracked_memory(qid.TypeId base_type, mir.MirPlaceElem projection) {
        if (projection is .index_projection || projection is .constant_index_projection) {
            return self.type_is_raw_or_many_pointer(base_type);
        }
        if (projection is .deref_projection(deref)) {
            return deref.raw_pointer || self.type_is_raw_or_many_pointer(base_type);
        }
        return false;
    }

    Bool type_is_raw_or_many_pointer(qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else {
            return false;
        }
        return handle.kind == .many_pointer || handle.kind == .raw_pointer;
    }

    () check_place_use(mir.MirPlace place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (self.is_path_uninitialized(path)) {
            self.results.mark_error();
            self.add_use_after_move_diagnostic();
        }
    }

    () add_use_after_move_diagnostic() {
        if (!self.record_diagnostic(1)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("use_after_move"),
                self.current_source_range(),
                "use of moved value"
            )
        );
    }

    () clear_place(mir.MirPlace place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        self.clear_path_and_descendants(path);
    }

    () add_borrow_escape_diagnostic() {
        if (!self.record_diagnostic(2)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("borrowed_value_escape"),
                self.current_source_range(),
                "borrowed value escapes its owner"
            )
        );
    }

    // MIR 只保存 byte span，不重复保存 source_id。borrow check 诊断用当前
    // 函数 DefId 的 SourceMap 记录补回 source_id，再取当前 statement/terminator span。
    diagnostic.SourceRange current_source_range() {
        guard self.ctx.store.source_map.def_span(self.function_def) is .some(function_loc) else {
            return diagnostic.SourceRange();
        }
        guard function_loc.source_id is .some(source_id) else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, self.current_span());
    }

    token.Span current_span() {
        if (self.current_location.kind == .terminator) {
            return self.current_block().terminator.span;
        }
        return self.current_statement().span;
    }

    mir.MirBlock current_block() {
        return self.body.blocks[self.current_location.block_id.to_index()];
    }

    mir.MirStatement current_statement() {
        return self.current_block().statements[self.current_location.statement_index];
    }

    Bool record_diagnostic(Int code) {
        BorrowDiagnosticKey key = BorrowDiagnosticKey(self.current_location, code);
        if (self.reported_diagnostics.has(key)) {
            return false;
        }
        self.reported_diagnostics.set(key, true);
        return true;
    }

    loan.LoanId? active_loan_for_path(move_path.MovePathId path) {
        if (self.dataflow.active_loans.get(path) is .some(loan_id)) {
            return loan_id$.get();
        }
        if (self.active_loan_for_ancestor(path) is .some(loan_id)) {
            return loan_id;
        }
        return self.active_loan_for_descendant(path);
    }

    loan.LoanId? active_loan_for_ancestor(move_path.MovePathId path) {
        move_path.MovePath! current = self.paths.get(path);
        while (current.has_parent) {
            if (self.dataflow.active_loans.get(current.parent) is .some(loan_id)) {
                return loan_id$.get();
            }
            current = self.paths.get(current.parent);
        }
        return null;
    }

    loan.LoanId? active_loan_for_descendant(move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId candidate = move_path.MovePathId(index);
            if (self.dataflow.active_loans.get(candidate) is .some(loan_id)) {
                if (self.is_descendant_of(candidate, path)) {
                    return loan_id$.get();
                }
            }
            index = index + 1;
        }
        return null;
    }

    () mark_moved(move_path.MovePathId path) {
        self.clear_descendants(path);
        self.dataflow.moved.set(path, true);
    }

    Bool is_path_uninitialized(move_path.MovePathId path) {
        if (self.dataflow.moved.has(path)) {
            return true;
        }
        if (self.has_moved_ancestor(path)) {
            return true;
        }
        return self.has_moved_descendant(path);
    }

    Bool has_moved_ancestor(move_path.MovePathId path) {
        move_path.MovePath! current = self.paths.get(path);
        while (current.has_parent) {
            if (self.dataflow.moved.has(current.parent)) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    Bool has_moved_descendant(move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId candidate = move_path.MovePathId(index);
            if (self.dataflow.moved.has(candidate) && self.is_descendant_of(candidate, path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool is_descendant_of(move_path.MovePathId child, move_path.MovePathId parent) {
        move_path.MovePath! current = self.paths.get(child);
        while (current.has_parent) {
            if (current.parent == parent) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    () clear_path_and_descendants(move_path.MovePathId path) {
        self.dataflow.moved.remove(path);
        self.dataflow.active_loans.remove(path);
        self.clear_descendants(path);
    }

    () clear_descendants(move_path.MovePathId path) {
        Int! index = 0;
        while (index < self.paths.len()) {
            move_path.MovePathId candidate = move_path.MovePathId(index);
            if (self.is_descendant_of(candidate, path)) {
                self.dataflow.moved.remove(candidate);
                self.dataflow.active_loans.remove(candidate);
            }
            index = index + 1;
        }
    }

    Bool is_implicit_copy_place(mir.MirPlace place) {
        return self.is_implicit_copy_type(self.place_type(place));
    }

    qid.TypeId place_type(mir.MirPlace place) {
        qid.TypeId! type_id = self.local_type(place.local_id);
        Int! index = 0;
        while (index < place.projection.length) {
            type_id = self.projected_type(type_id, place.projection[index]);
            index = index + 1;
        }
        return type_id;
    }

    qid.TypeId local_type(mir.MirLocalId local_id) {
        Int index = local_id.to_index();
        if (index >= 0 && index < self.body.locals.length) {
            return self.body.locals[index].type_id;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId projected_type(qid.TypeId base_type, mir.MirPlaceElem projection) {
        if (projection is .field_projection(field)) {
            return field.field_type;
        }
        if (projection is .deref_projection) {
            types.TypeInfo base_info = self.ctx.store.types.get(base_type);
            guard base_info.data is .handle_type(handle) else {
                return self.ctx.store.types.invalid_type();
            }
            return handle.element;
        }
        if (projection is .index_projection) {
            return self.indexed_type(base_type);
        }
        if (projection is .constant_index_projection(constant_index)) {
            return self.constant_indexed_type(base_type, constant_index.offset);
        }
        if (projection is .subslice_projection) {
            return base_type;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId indexed_type(qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            return handle.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .tuple_type(tuple_type)) {
            if (tuple_type.items.length > 0) {
                return tuple_type.items[0];
            }
        }
        return base_type;
    }

    qid.TypeId constant_indexed_type(qid.TypeId base_type, Int offset) {
        if (self.report_generic_param_layout_base(base_type)) {
            return self.ctx.store.types.invalid_type();
        }
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.ctx, base_type);
        layout.TypeLayout type_layout = self.ctx.store.layouts.layout(layout_id);
        if (offset >= 0 && offset < type_layout.fields.length) {
            return type_layout.fields[offset].field_type;
        }
        return self.indexed_type(base_type);
    }

    Bool report_generic_param_layout_base(qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        guard info.data is .named(named) else { return false; }
        if (self.ctx.store.defs.get(named.def_id).kind != .generic_param_def) {
            return false;
        }
        self.results.mark_error();
        qid.SymbolId symbol = self.ctx.store.defs.get(named.def_id).name.symbol;
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .borrow_check,
                diagnostic.DiagnosticCode("borrow_generic_param_layout_base"),
                self.current_source_range(),
                self.ctx.store.symbols.text(symbol)
            )
        );
        return true;
    }

    Bool is_implicit_copy_type(qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.ctx.store$.ref());
        return query.is_implicit_copy_type(type_id);
    }
}
