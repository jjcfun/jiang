// Borrow check 的函数体检查器。
//
// 当前先实现 move/use 的基础语义：JIL operand 读 place 时，根据类型决定
// 是 implicit copy 还是 move；move 后再次读取同一个 move path、祖先 path
// 或子 path 都会把 BorrowCheckStore 标成失败。完整 CFG dataflow 后续会
// 在这里替换线性扫描状态，而不是改 JIL 结构。

import context = "../context.jiang";
import core_traits = "../core/traits.jiang";
import diagnostic = "../diagnostic.jiang";
import sem = "../sema/model.jiang";
import layout = "../layout.jiang";
import layout_compute = "../layout/compute.jiang";
import jil = "../jil.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import copy_semantics = "../sema/copy.jiang";
import drop_semantics = "../sema/drop.jiang";
import generic_bindings = "../sema/generic/bindings.jiang";
import lifetime_shape_query = "../sema/lifetime_shape_query.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import loan = "./loan.jiang";
import location = "./location.jiang";
import move_path = "./move_path.jiang";
import borrow_store = "./store.jiang";
import loan_facts = "./loan_facts.jiang";

@region(a)
public struct PackageBorrowChecker: Copyable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public layout.LayoutStore& layouts;
    @life(a)
    public borrow_store.BorrowCheckStore& results;
    public init(self,
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
    }

    public () check_store(self, jil.Store& store) {
        unsafe {
            Int function_count = store.functions.len();
            Int*! states = Int$.alloc(function_count);
            Int index! = 0;
            while (index < function_count) {
                states[index] = 0;
                index = index + 1;
            }
            index = 0;
            while (index < function_count) {
                self.check_function_at(store, index, states);
                index = index + 1;
            }
            states$.dealloc();
        }
    }

    () check_function_at(self, jil.Store& store, Int index, Int*! states) {
        unsafe {
            if (states[index] == 2) { return; }
            if (states[index] == 1) { return; }
            states[index] = 1;
            jil.Function function! = store.functions.get(index);
            if (store.borrow_check_function(function.id) is .some(source)) {
                function = source;
            }
            self.check_direct_dependencies(store, function, states);
            if (!store.is_borrow_check_exempt(function.id)) {
                self.check_function(function);
            }
            states[index] = 2;
        }
    }

    () check_direct_dependencies(self, jil.Store& store, jil.Function function, Int*! states) {
        Int block_index! = 0;
        while (block_index < function.body.blocks.length) {
            jil.Terminator terminator = function.body.blocks[block_index].terminator;
            self.check_terminator_dependency(store, terminator, states);
            block_index = block_index + 1;
        }
    }

    () check_terminator_dependency(self, jil.Store& store, jil.Terminator terminator, Int*! states) {
        guard terminator.kind is .call_term(call_term) else { return; }
        guard call_term.callee is .direct_function(function_ref) else { return; }
        guard self.function_id_for_ref(store, function_ref) is .some(function_id) else { return; }
        Int index = function_id.to_index();
        if (index < 0 || index >= store.functions.len()) { return; }
        self.check_function_at(store, index, states);
    }

    jil.FunctionId? function_id_for_ref(self, jil.Store& store, jil.FunctionRef function_ref) {
        return store.function_id_for_ref(function_ref);
    }

    () check_function(self, jil.Function function) {
        FunctionBorrowChecker checker! = FunctionBorrowChecker(
            self.ctx,
            self.typeck,
            self.layouts,
            self.results,
            function
        );
        checker.check();
    }
}

struct TaskConsumeFact: Copyable {
    public move_path.MovePathId path;
    public Int site;
}

// BorrowBoundaryFact 不是第二条 provenance loan。它只表达一个已经存在的
// borrowed value 还受哪个 receiver storage 的作用域约束。
struct BorrowBoundaryFact: Copyable {
    public move_path.MovePathId boundary;
    public move_path.MovePathId target;
}

struct BorrowDataflowState: Movable {
    public UInt64*! moved;
    public list.ArrayList<TaskConsumeFact> consumed_tasks!;
    public loan_facts.ActiveLoanFacts active_loans!;
    public list.ArrayList<BorrowBoundaryFact> borrow_boundaries!;
    public UInt64*! live_locals;
    public Int path_count;
    public Int word_count;

    public init(self, Int path_count) {
        unsafe {
            self.path_count = path_count;
            self.word_count = (path_count + 63) / 64;
            self.moved = UInt64$.alloc(self.word_count);
            self.live_locals = UInt64$.alloc(self.word_count);
            Int index! = 0;
            while (index < self.word_count) {
                self.moved[index] = UInt64(0);
                self.live_locals[index] = UInt64(0);
                index = index + 1;
            }
        }
        self.consumed_tasks = list.ArrayList<TaskConsumeFact>();
        self.active_loans = loan_facts.ActiveLoanFacts();
        self.borrow_boundaries = list.ArrayList<BorrowBoundaryFact>();
    }

    deinit(self) {
        if (self.word_count > 0) {
            unsafe {
                self.moved$.dealloc();
                self.live_locals$.dealloc();
            }
        }
    }
}

struct LoanLivenessData: Movable {
    public UInt64*! live_after;
    public Int*! block_points;
    public Int*! path_bits;
    public Int*! tracked_paths;
    public Int point_count;
    public Int path_count;
    public Int tracked_path_count;
    public Int word_count;
    public Int block_count;

    public init(self,
        Int block_count,
        Int point_count,
        Int path_count,
        Int tracked_path_count
    ) {
        unsafe {
            self.block_count = block_count;
            self.point_count = point_count;
            self.path_count = path_count;
            self.tracked_path_count = tracked_path_count;
            self.word_count = (tracked_path_count + 63) / 64;
            self.live_after = UInt64$.alloc(point_count * self.word_count);
            self.block_points = Int$.alloc(block_count);
            self.path_bits = Int$.alloc(path_count);
            self.tracked_paths = Int$.alloc(tracked_path_count);
            Int index! = 0;
            while (index < point_count * self.word_count) {
                self.live_after[index] = UInt64(0);
                index = index + 1;
            }
            index = 0;
            while (index < path_count) {
                self.path_bits[index] = -1;
                index = index + 1;
            }
        }
    }

    deinit(self) {
        unsafe {
            if (self.point_count > 0 && self.word_count > 0) {
                self.live_after$.dealloc();
            }
            if (self.block_count > 0) { self.block_points$.dealloc(); }
            if (self.path_count > 0) { self.path_bits$.dealloc(); }
            if (self.tracked_path_count > 0) { self.tracked_paths$.dealloc(); }
        }
    }
}

struct BorrowDiagnosticKey: Copyable, Hashable, Equatable {
    public jil.FunctionId function_id;
    public jil.BlockId block_id;
    public location.LocationKind kind;
    public Int statement_index;
    public Int code;

    public init(self, location.Location current, Int code) {
        self.function_id = current.function_id;
        self.block_id = current.block_id;
        self.kind = current.kind;
        self.statement_index = current.statement_index;
        self.code = code;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.function_id.to_index()));
        hasher.write(Int(self.block_id.to_index()));
        hasher.write(Int(self.kind_index()));
        hasher.write(Int(self.statement_index));
        hasher.write(Int(self.code));
    }

    Int kind_index(self) {
        if (self.kind == .statement) {
            return 1;
        }
        return 2;
    }

    public Bool equal(BorrowDiagnosticKey& lhs, BorrowDiagnosticKey& rhs) {
        if (lhs.function_id.to_index() != rhs.function_id.to_index()) { return false; }
        if (lhs.block_id.to_index() != rhs.block_id.to_index()) { return false; }
        if (lhs.kind_index() != rhs.kind_index()) { return false; }
        if (lhs.statement_index != rhs.statement_index) { return false; }
        return lhs.code == rhs.code;
    }
}

@region(a)
struct FunctionBorrowChecker: Movable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public layout.LayoutStore& layouts;
    @life(a)
    public borrow_store.BorrowCheckStore& results;
    public jil.FunctionId function_id;
    public qid.DefId function_def;
    public types.EffectSet function_effects;
    public types.EffectSet current_effects!;
    @life(a)
    public jil.Body body;
    @life(a)
    public jil.CoroutineFrameLayout? coroutine_frame;
    public Int loan_start_index;
    public move_path.MovePathTree paths!;
    public BorrowDataflowState dataflow!;
    public LoanLivenessData loan_liveness!;
    public location.Location current_location!;
    public table.HashTable<BorrowDiagnosticKey, Bool> reported_diagnostics!;
    public table.HashTable<move_path.MovePathId, Bool> reported_dead_loan_sources!;

    public init(self,
        context.CompilerContext& ctx,
        typeck_store.TypeCheckStore& typeck,
        layout.LayoutStore& layouts,
        borrow_store.BorrowCheckStore& results,
        jil.Function function
    ) {
        self.ctx = ctx;
        self.typeck = typeck;
        self.layouts = layouts;
        self.results = results;
        self.function_id = function.id;
        qid.DefId provenance_def = jil.function_provenance_def(function.origin);
        self.function_def = provenance_def;
        self.function_effects = self.function_effects_for_def(provenance_def);
        self.current_effects = self.function_effects;
        self.body = function.body;
        self.coroutine_frame = function.coroutine_frame;
        self.loan_start_index = results.loans.len();
        jil.Body body! = function.body;
        self.paths = move_path.build_move_path_tree(body$.ref());
        self.dataflow = BorrowDataflowState(self.paths.len());
        self.loan_liveness = LoanLivenessData(0, 0, 0, 0);
        self.current_location = location.Location(function.id, body.entry, .terminator, -1);
        self.reported_diagnostics = table.HashTable<BorrowDiagnosticKey, Bool>();
        self.reported_dead_loan_sources = table.HashTable<move_path.MovePathId, Bool>();
    }

    types.EffectSet function_effects_for_def(self, qid.DefId function_def) {
        guard self.typeck.def_type(function_def) is .some(type_id) else {
            return types.EffectSet();
        }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else {
            return types.EffectSet();
        }
        return function_type.effects;
    }

    public () check(self) {
        unsafe {
            Int block_count = self.body.blocks.length;
            if (block_count == 0) {
                return;
            }
            self.prebuild_aggregate_move_paths();
            self.prebuild_function_lifetime_contract_paths();
            self.prebuild_local_lifetime_paths();
            self.prebuild_call_lifetime_paths();
            self.paths.freeze();
            self.build_loan_liveness();
            self.dataflow = BorrowDataflowState(self.paths.len());
            Int entry_index = self.body.entry.to_index();
            if (!self.valid_block_index(entry_index)) { return; }

            BorrowDataflowState*! in_states = unsafe {
                BorrowDataflowState$.alloc(block_count)
            };
            Bool*! reachable = unsafe {
                Bool$.alloc(block_count)
            };
            Bool*! queued = unsafe {
                Bool$.alloc(block_count)
            };
            self.init_dataflow_arrays(
                in_states, reachable, queued, block_count, self.paths.len()
            );

            list.ArrayList<Int> worklist! = list.ArrayList<Int>();
            self.init_entry_live_locals(in_states[entry_index]$.ref());
            self.enqueue_block(entry_index, reachable, queued, worklist$.ref());

            while (!worklist.empty()) {
                Int block_index = worklist.pop();
                queued[block_index] = false;
                self.dataflow = self.clone_state(in_states[block_index]$.ref());
                self.check_block(self.body.blocks[block_index]);
                self.propagate_successors(
                    self.body.blocks[block_index],
                    in_states,
                    reachable,
                    queued,
                    worklist$.ref()
                );
            }
            self.destroy_dataflow_arrays(in_states, block_count);
            reachable$.dealloc();
            queued$.dealloc();
        }
    }

    () prebuild_aggregate_move_paths(self) {
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            jil.Block block = self.body.blocks[block_index];
            Int statement_index! = 0;
            while (statement_index < block.statements.length) {
                self.prebuild_statement_aggregate_paths(block.statements[statement_index]);
                statement_index = statement_index + 1;
            }
            block_index = block_index + 1;
        }
    }

    () prebuild_local_lifetime_paths(self) {
        Int index! = 0;
        while (index < self.body.locals.length) {
            jil.LocalDecl local = self.body.locals[index];
            qid.TypeId type_id = local.type_id;
            if (self.type_may_carry_borrow(type_id)) {
                list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
                self.prebuild_type_lifetime_paths(
                    self.paths.root_for_local(local.id),
                    type_id,
                    visiting$.ref(),
                    false
                );
            }
            index = index + 1;
        }
    }

    () prebuild_type_lifetime_paths(
        self,
        move_path.MovePathId root,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting,
        Bool expand_transparent_handles
    ) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            self.prebuild_named_lifetime_paths(root, named, visiting);
            return;
        }
        if (self.type_has_atomic_lifetime(type_id)) { return; }
        if (info.data is .tuple_type(tuple_type)) {
            self.prebuild_tuple_lifetime_paths(
                root, tuple_type, visiting, expand_transparent_handles
            );
            return;
        }
        if (info.data is .optional(optional)) {
            self.prebuild_type_lifetime_paths(
                root, optional.element, visiting, expand_transparent_handles
            );
            return;
        }
        if (info.data is .handle_type(handle)) {
            if (types.is_reference_handle(handle)) {
                jil.PlaceElem deref =
                    jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
                move_path.MovePathId value = self.paths.ensure_child_for_projection(root, deref);
                self.prebuild_type_lifetime_paths(value, handle.element, visiting, true);
                return;
            }
            if (expand_transparent_handles
                && (types.is_slice_handle(handle) || types.is_owner_pointer_handle(handle))) {
                self.prebuild_type_lifetime_paths(
                    root, handle.element, visiting, true
                );
            }
            return;
        }
    }

    () prebuild_function_lifetime_contract_paths(self) {
        guard self.function_lifetime_contract() is .some(contract) else { return; }
        Int index! = 0;
        while (index < contract.flows.length) {
            types.LifetimeFlow flow = contract.flows[index];
            index = index + 1;
            self.prebuild_lifetime_flow_path(flow.source);
            self.prebuild_lifetime_flow_path(flow.target);
        }
    }

    () prebuild_lifetime_flow_path(self, types.LifetimePath path) {
        if (path.root_kind == .callable_result
            || path.root_kind == .callable_parameter) {
            return;
        }
        move_path.MovePathId? root! = null;
        if (path.root_kind == .result) {
            root = self.paths.root_for_local(self.body.return_local);
        } else {
            root = self.param_root_path_by_index(path.root_index);
        }
        guard root is .some(root_path) else { return; }
        move_path.MovePathId projection_root! = root_path;
        if (path.root_kind == .parameter) {
            projection_root = self.prebuild_lifetime_parameter_root(
                root_path, path.root_index, path.projection_path
            );
        }
        self.ensure_lifetime_move_path(projection_root, path.projection_path);
    }

    () prebuild_call_lifetime_paths(self) {
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            jil.Terminator terminator = self.body.blocks[block_index].terminator;
            block_index = block_index + 1;
            guard terminator.kind is .call_term(call_term) else { continue; }
            self.prebuild_call_lifetime_paths_for_call(call_term);
        }
    }

    () prebuild_call_lifetime_paths_for_call(self, jil.CallTerminator call_term) {
        if (self.callee_function_def(call_term.callee) is .some(callee_def)
            && self.callee_is_init(callee_def)) {
            self.prebuild_init_call_lifetime_paths(call_term, callee_def);
            return;
        }
        if (call_term.return_lifetime_flows is .some(flows)) {
            Int index! = 0;
            while (index < flows.length) {
                self.prebuild_call_lifetime_flow_path(call_term, flows[index]);
                index = index + 1;
            }
            index = 0;
            while (index < self.call_lifetime_arg_count(call_term)) {
                self.prebuild_callable_carried_call_paths(call_term, index);
                index = index + 1;
            }
            return;
        }
        guard self.call_lifetime_contract(call_term) is .some(contract) else { return; }
        Int index! = 0;
        while (index < contract.flows.length) {
            self.prebuild_call_lifetime_flow_path(call_term, contract.flows[index]);
            index = index + 1;
        }
    }

    () prebuild_init_call_lifetime_paths(
        self,
        jil.CallTerminator call_term,
        qid.DefId callee_def
    ) {
        guard call_term.initialized_place is .some(destination) else { return; }
        Int index! = 0;
        while (index < self.results.init_lifetime_sources.len()) {
            borrow_store.InitLifetimeSource source = self.results.init_lifetime_sources.get(index);
            index = index + 1;
            if (source.function_def != callee_def) { continue; }
            if (source.source_param_index < 0
                || source.source_param_index >= call_term.args.length) {
                continue;
            }
            guard self.operand_place(call_term.args[source.source_param_index])
                is .some(source_place) else {
                continue;
            }
            move_path.MovePathId source_root = self.paths.path_for_place(source_place);
            move_path.MovePathId target_root = self.paths.path_for_place(destination);
            move_path.MovePathId source_path =
                self.ensure_lifetime_move_path(source_root, source.source_projection);
            move_path.MovePathId target_path =
                self.ensure_lifetime_move_path(target_root, source.target_projection);
            self.prebuild_single_carried_lifetime_paths(
                source_path, self.move_path_type(source_path)
            );
            self.prebuild_single_carried_lifetime_paths(
                target_path, self.move_path_type(target_path)
            );
        }
    }

    () prebuild_call_lifetime_flow_path(
        self,
        jil.CallTerminator call_term,
        types.LifetimeFlow flow
    ) {
        if (flow.source.root_kind == .callable_result) {
            self.prebuild_callable_carried_call_paths(
                call_term,
                flow.source.root_index
            );
            return;
        }
        if (flow.source.root_kind != .parameter) { return; }
        if (flow.source.root_index < 0
            || flow.source.root_index >= self.call_lifetime_arg_count(call_term)) {
            return;
        }
        jil.Operand source_operand! = call_term.args[flow.source.root_index];
        if (call_term.lifetime_args is .some(args)) {
            source_operand = args[flow.source.root_index];
        }
        guard self.operand_place(source_operand) is .some(source) else { return; }
        move_path.MovePathId source_root! = self.paths.path_for_place(source);
        source_root = self.prebuild_call_lifetime_parameter_root(
            call_term,
            flow.source.root_index,
            flow.source.projection_path,
            source_root
        );
        self.ensure_lifetime_move_path(source_root, flow.source.projection_path);
        if (flow.target.root_kind == .result) {
            move_path.MovePathId target_root =
                self.paths.path_for_place(self.call_lifetime_destination(call_term));
            move_path.MovePathId target_path =
                self.ensure_lifetime_move_path(target_root, flow.target.projection_path);
            self.prebuild_single_carried_lifetime_paths(
                target_path, self.move_path_type(target_path)
            );
            return;
        }
        if (flow.target.root_kind != .parameter) { return; }
        if (flow.target.root_index < 0
            || flow.target.root_index >= self.call_lifetime_arg_count(call_term)) {
            return;
        }
        jil.Operand target_operand! = call_term.args[flow.target.root_index];
        if (call_term.lifetime_args is .some(args)) {
            target_operand = args[flow.target.root_index];
        }
        guard self.operand_place(target_operand) is .some(target) else { return; }
        move_path.MovePathId target_root! = self.paths.path_for_place(target);
        target_root = self.prebuild_call_lifetime_parameter_root(
            call_term,
            flow.target.root_index,
            flow.target.projection_path,
            target_root
        );
        move_path.MovePathId target_path =
            self.ensure_lifetime_move_path(target_root, flow.target.projection_path);
        self.prebuild_single_carried_lifetime_paths(
            target_path, self.move_path_type(target_path)
        );
    }

    () prebuild_callable_carried_call_paths(
        self,
        jil.CallTerminator call_term,
        Int source_index
    ) {
        move_path.MovePathId destination =
            self.paths.path_for_place(self.call_lifetime_destination(call_term));
        self.prebuild_single_carried_lifetime_paths(
            destination, self.move_path_type(destination)
        );
        if (source_index < 0 || source_index >= self.call_lifetime_arg_count(call_term)) {
            return;
        }
        jil.Operand operand! = call_term.args[source_index];
        if (call_term.lifetime_args is .some(args)) { operand = args[source_index]; }
        if (self.operand_place(operand) is .some(place)) {
            self.prebuild_callable_carried_source_paths(
                self.paths.path_for_place(place)
            );
        }
    }

    () prebuild_callable_carried_source_paths(
        self,
        move_path.MovePathId root
    ) {
        qid.TypeId root_type = self.move_path_type(root);
        types.TypeInfo info = self.ctx.store.types.get(root_type);
        if (info.data is .handle_type(handle) && types.is_reference_handle(handle)) {
            jil.PlaceElem deref =
                jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
            move_path.MovePathId pointee = self.paths.ensure_child_for_projection(root, deref);
            self.prebuild_single_carried_lifetime_paths(pointee, handle.element);
            return;
        }
        self.prebuild_single_carried_lifetime_paths(root, root_type);
    }

    move_path.MovePathId? param_root_path_by_index(self, Int param_index) {
        Int current! = 0;
        Int index! = 0;
        while (index < self.body.locals.length) {
            jil.LocalDecl local = self.body.locals[index];
            index = index + 1;
            if (local.kind != .param) { continue; }
            if (current == param_index) {
                return self.paths.root_for_local(local.id);
            }
            current = current + 1;
        }
        return null;
    }

    () prebuild_tuple_lifetime_paths(
        self,
        move_path.MovePathId root,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting,
        Bool expand_transparent_handles
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            jil.PlaceElem projection = jil.constant_index_projection_elem(
                jil.ConstantIndexProjection(offset: index)
            );
            move_path.MovePathId child = self.paths.ensure_child_for_projection(root, projection);
            self.prebuild_type_lifetime_paths(
                child, tuple_type.items[index], visiting, expand_transparent_handles
            );
            index = index + 1;
        }
    }

    () prebuild_named_lifetime_paths(
        self,
        move_path.MovePathId root,
        types.NamedType named,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.typeck.nominal_region_schema(named.def_id) is .some(schema)) {
            if (schema.params.length > 0) {
                Int index! = 0;
                while (index < schema.bindings.length) {
                    self.ensure_lifetime_move_path(root, schema.bindings[index].path);
                    index = index + 1;
                }
                return;
            }
        }
        if (!self.structural_nominal_def(named.def_id)) { return; }
        if (self.def_list_contains(visiting, named.def_id)) { return; }
        guard self.ctx.store.model.def(named.def_id) is .some(owner) else { return; }
        visiting.add(named.def_id);
        Int index! = 0;
        while (index < owner.members.len()) {
            qid.DefId field_def = owner.members.get(index);
            index = index + 1;
            if (!self.structural_lifetime_field(field_def)) { continue; }
            qid.TypeId field_type = self.structural_field_type(named, field_def);
            jil.PlaceElem projection = self.structural_field_projection(
                field_def,
                field_type
            );
            move_path.MovePathId child = self.paths.ensure_child_for_projection(root, projection);
            self.prebuild_type_lifetime_paths(child, field_type, visiting, false);
        }
        visiting.pop();
    }

    Bool structural_lifetime_field(self, qid.DefId field_def) {
        def.DefKind kind = self.ctx.store.defs.get(field_def).kind;
        return kind == .field_def || kind == .union_variant_def;
    }

    Bool structural_nominal_def(self, qid.DefId def_id) {
        def.DefKind kind = self.ctx.store.defs.get(def_id).kind;
        return kind == .struct_def || kind == .enum_def || kind == .union_def;
    }

    qid.TypeId structural_field_type(
        self,
        types.NamedType named,
        qid.DefId field_def
    ) {
        guard self.typeck.def_type(field_def) is .some(template) else {
            return self.ctx.store.types.invalid_type();
        }
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
            self.ctx.store$.ref(),
            named.def_id,
            named.args,
            caller$.ref()
        );
        return generic_bindings.substitute_type(
            self.ctx.store$.ref(),
            template,
            bindings$.ref()
        );
    }

    jil.PlaceElem structural_field_projection(
        self,
        qid.DefId field_def,
        qid.TypeId field_type
    ) {
        return jil.field_projection_elem(jil.FieldProjection(
            field_def: field_def,
            field_type: field_type,
            field_index: 0
        ));
    }

    () prebuild_statement_aggregate_paths(self, jil.Statement statement) {
        guard statement.kind is .assign_stmt(assign_stmt) else { return; }
        move_path.MovePathId destination = self.paths.path_for_place(assign_stmt.destination);
        if (!self.valid_move_path(destination)) { return; }
        if (self.logical_raw_storage_element_type(assign_stmt.destination)
            is .some(element_type)) {
            self.prebuild_single_carried_lifetime_paths(destination, element_type);
        }
        jil.Rvalue value = assign_stmt.value;
        if (value is .use_value(use_value)) {
            self.prebuild_carried_operand_lifetime_paths(destination, use_value.value);
            return;
        }
        if (value is .cast_value(cast_value)) {
            self.prebuild_carried_operand_lifetime_paths(destination, cast_value.value);
            return;
        }
        if (value is .optional_value(optional_value)) {
            self.prebuild_carried_operand_lifetime_paths(destination, optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.prebuild_carried_operand_lifetime_paths(
                destination, error_union_value.value
            );
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.prebuild_carried_place_lifetime_paths(
                destination,
                self.paths.path_for_place(slice_value.base),
                self.place_type(slice_value.base)
            );
            return;
        }
        if (value is .closure_value(closure_value)) {
            Int capture_index! = 0;
            while (capture_index < closure_value.captures.length) {
                self.prebuild_carried_operand_lifetime_paths(
                    destination,
                    closure_value.captures[capture_index]
                );
                capture_index = capture_index + 1;
            }
            return;
        }
        guard value is .aggregate_value(aggregate_value) else { return; }
        Int field_index! = 0;
        while (field_index < aggregate_value.fields.length) {
            move_path.MovePathId field_path =
                self.ensure_aggregate_field_path(destination, aggregate_value, field_index);
            if (self.aggregate_logical_raw_storage_type(aggregate_value, field_index)
                is .some(element_type)) {
                self.prebuild_single_carried_lifetime_paths(field_path, element_type);
            } else {
                self.prebuild_carried_operand_lifetime_paths(
                    field_path, aggregate_value.fields[field_index]
                );
            }
            field_index = field_index + 1;
        }
    }

    () prebuild_carried_operand_lifetime_paths(
        self,
        move_path.MovePathId destination,
        jil.Operand operand
    ) {
        guard self.operand_place(operand) is .some(source_place) else { return; }
        self.prebuild_carried_place_lifetime_paths(
            destination,
            self.paths.path_for_place(source_place),
            self.place_type(source_place)
        );
    }

    () prebuild_carried_place_lifetime_paths(
        self,
        move_path.MovePathId destination,
        move_path.MovePathId source,
        qid.TypeId type_id
    ) {
        if (!self.type_may_carry_borrow(type_id)) { return; }
        self.prebuild_single_carried_lifetime_paths(source, type_id);
        self.prebuild_single_carried_lifetime_paths(destination, type_id);
    }

    () prebuild_single_carried_lifetime_paths(
        self,
        move_path.MovePathId path,
        qid.TypeId type_id
    ) {
        if (!self.type_may_carry_borrow(type_id)) { return; }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.prebuild_type_lifetime_paths(
            path, type_id, visiting$.ref(), true
        );
    }

    () init_entry_live_locals(self, BorrowDataflowState& state) {
        Int local_index! = 0;
        while (local_index < self.body.locals.length) {
            jil.LocalDecl local = self.body.locals[local_index];
            if (self.local_is_live_at_entry(local)) {
                self.mark_state_local_live(state, local.id);
            }
            local_index = local_index + 1;
        }
    }

    Bool local_is_live_at_entry(self, jil.LocalDecl local) {
        if (local.id.to_index() == self.body.return_local.to_index()) {
            return true;
        }
        if (local.kind == .param) {
            return true;
        }
        return !self.local_has_storage_marker(local.id);
    }

    Bool local_has_storage_marker(self, jil.LocalId local_id) {
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            if (self.block_has_storage_marker(self.body.blocks[block_index], local_id)) {
                return true;
            }
            block_index = block_index + 1;
        }
        return false;
    }

    Bool block_has_storage_marker(self, jil.Block block, jil.LocalId local_id) {
        Int stmt_index! = 0;
        while (stmt_index < block.statements.length) {
            jil.Statement statement = block.statements[stmt_index];
            if (self.statement_is_storage_marker_for_local(statement, local_id)) {
                return true;
            }
            stmt_index = stmt_index + 1;
        }
        return false;
    }

    Bool statement_is_storage_marker_for_local(self, jil.Statement statement, jil.LocalId local_id) {
        if (statement.kind is .storage_live_stmt(storage_live)) {
            return storage_live.local_id.to_index() == local_id.to_index();
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            return storage_dead.local_id.to_index() == local_id.to_index();
        }
        return false;
    }

    () init_dataflow_arrays(self,
        BorrowDataflowState*! in_states,
        Bool*! reachable,
        Bool*! queued,
        Int block_count,
        Int path_count
    ) {
        unsafe {
            Int index! = 0;
            while (index < block_count) {
                in_states[index] = BorrowDataflowState(path_count);
                reachable[index] = false;
                queued[index] = false;
                index = index + 1;
            }
        }
    }

    () destroy_dataflow_arrays(self, BorrowDataflowState*! states, Int count) {
        unsafe {
            Int index! = 0;
            while (index < count) {
                states[index]$.addr()$.destroy();
                index = index + 1;
            }
            states$.dealloc();
        }
    }

    Bool valid_block_index(self, Int block_index) {
        return block_index >= 0 && block_index < self.body.blocks.length;
    }

    () enqueue_block(self,
        Int block_index,
        Bool*! reachable,
        Bool*! queued,
        list.ArrayList<Int>& worklist
    ) {
        unsafe {
            reachable[block_index] = true;
            if (queued[block_index]) {
                return;
            }
            queued[block_index] = true;
            worklist.add(block_index);
        }
    }

    () propagate_successors(self,
        jil.Block block,
        BorrowDataflowState*! in_states,
        Bool*! reachable,
        Bool*! queued,
        list.ArrayList<Int>& worklist
    ) {
        Int successor_index! = 0;
        while (successor_index < jil.terminator_successor_count(block.terminator)) {
            jil.BlockId successor = jil.terminator_successor_at(block.terminator, successor_index);
            self.propagate_successor(successor, in_states, reachable, queued, worklist);
            successor_index = successor_index + 1;
        }
    }

    () propagate_successor(self,
        jil.BlockId successor,
        BorrowDataflowState*! in_states,
        Bool*! reachable,
        Bool*! queued,
        list.ArrayList<Int>& worklist
    ) {
        unsafe {
            Int successor_index = successor.to_index();
            if (!self.valid_block_index(successor_index)) {
                return;
            }

            Bool was_reachable = reachable[successor_index];
            Bool changed = self.merge_state(
                in_states[successor_index]$.ref(),
                self.dataflow$.ref(),
                was_reachable
            );
            if (!was_reachable || changed) {
                self.enqueue_block(successor_index, reachable, queued, worklist);
            }
        }
    }

    BorrowDataflowState clone_state(self, BorrowDataflowState& source) {
        BorrowDataflowState clone! = BorrowDataflowState(self.paths.len());
        self.merge_state(clone$.ref(), source, false);
        return clone;
    }

    // CFG 合流采用 may-analysis：任一前驱 move/borrow 过的 path，在后继入口都视为可能存在。
    // live local 采用 must-analysis：只有所有前驱都 live 的 local，后继入口才视为 live。
    Bool merge_state(self, BorrowDataflowState& target, BorrowDataflowState& source, Bool target_reachable) {
        Bool changed! = self.merge_path_bits(target, source, target_reachable);
        changed = self.merge_consumed_tasks(target, source) || changed;
        changed = self.merge_active_loans(target, source) || changed;
        changed = self.merge_borrow_boundaries(target, source) || changed;
        return changed;
    }

    Bool merge_path_bits(
        self,
        BorrowDataflowState& target,
        BorrowDataflowState& source,
        Bool target_reachable
    ) {
        unsafe {
            Bool changed! = false;
            Int index! = 0;
            while (index < target.word_count) {
                UInt64 moved = target.moved[index] | source.moved[index];
                UInt64 live! = source.live_locals[index];
                if (target_reachable) { live = target.live_locals[index] & live; }
                changed = changed || moved != target.moved[index];
                changed = changed || live != target.live_locals[index];
                target.moved[index] = moved;
                target.live_locals[index] = live;
                index = index + 1;
            }
            return changed;
        }
    }

    Bool state_has_path(self, UInt64*! bits, move_path.MovePathId path) {
        if (!self.valid_move_path(path)) { return false; }
        unsafe {
            Int index = path.to_index();
            assert(index < self.dataflow.path_count);
            UInt64 mask = UInt64(1) << UInt64(index % 64);
            return (bits[index / 64] & mask) != UInt64(0);
        }
    }

    () state_set_path(self, UInt64*! bits, move_path.MovePathId path) {
        if (!self.valid_move_path(path)) { return; }
        unsafe {
            Int index = path.to_index();
            assert(index < self.dataflow.path_count);
            Int word = index / 64;
            bits[word] = bits[word] | (UInt64(1) << UInt64(index % 64));
        }
    }

    () state_clear_path(self, UInt64*! bits, move_path.MovePathId path) {
        if (!self.valid_move_path(path)) { return; }
        unsafe {
            Int index = path.to_index();
            assert(index < self.dataflow.path_count);
            Int word = index / 64;
            bits[word] = bits[word] & ~(UInt64(1) << UInt64(index % 64));
        }
    }

    Bool merge_consumed_tasks(self, BorrowDataflowState& target, BorrowDataflowState& source) {
        Bool changed! = false;
        Int index! = 0;
        while (index < source.consumed_tasks.len()) {
            TaskConsumeFact fact = source.consumed_tasks.get(index);
            if (!self.has_task_consume_fact(target, fact.path, fact.site)) {
                target.consumed_tasks.add(fact);
                changed = true;
            }
            index = index + 1;
        }
        return changed;
    }

    Bool merge_active_loans(self, BorrowDataflowState& target, BorrowDataflowState& source) {
        Bool changed! = false;
        Int index! = 0;
        while (index < source.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = source.active_loans.get(index);
            changed = self.merge_active_loan_fact(target, fact) || changed;
            index = index + 1;
        }
        return changed;
    }

    Bool merge_active_loan_fact(self, BorrowDataflowState& target, loan_facts.ActiveLoanFact fact) {
        return self.add_active_loan_fact(target, fact);
    }

    Bool add_active_loan_fact(self, BorrowDataflowState& state, loan_facts.ActiveLoanFact fact) {
        return state.active_loans.add(fact);
    }

    Bool merge_borrow_boundaries(
        self,
        BorrowDataflowState& target,
        BorrowDataflowState& source
    ) {
        Bool changed! = false;
        Int index! = 0;
        while (index < source.borrow_boundaries.len()) {
            changed = self.add_borrow_boundary_fact(
                target, source.borrow_boundaries.get(index)
            ) || changed;
            index = index + 1;
        }
        return changed;
    }

    Bool add_borrow_boundary_fact(
        self,
        BorrowDataflowState& state,
        BorrowBoundaryFact fact
    ) {
        Int index! = 0;
        while (index < state.borrow_boundaries.len()) {
            BorrowBoundaryFact current = state.borrow_boundaries.get(index);
            if (current.boundary == fact.boundary && current.target == fact.target) {
                return false;
            }
            index = index + 1;
        }
        state.borrow_boundaries.add(fact);
        return true;
    }

    () build_loan_liveness(self) {
        unsafe {
            Int block_count = self.body.blocks.length;
            Int point_count = self.loan_liveness_point_count();
            Int tracked_path_count = self.loan_liveness_tracked_path_count();
            self.loan_liveness = LoanLivenessData(
                block_count, point_count, self.paths.len(), tracked_path_count
            );
            self.initialize_liveness_path_bits();
            self.initialize_liveness_block_points();
            Int fact_word_count = point_count * self.loan_liveness.word_count;
            UInt64*! uses = UInt64$.alloc(fact_word_count);
            UInt64*! kills = UInt64$.alloc(fact_word_count);
            Int*! edge_points = Int$.alloc(block_count);
            Int edge_count = self.initialize_liveness_edge_points(edge_points);
            UInt64*! edge_kills = UInt64$.alloc(
                edge_count * self.loan_liveness.word_count
            );
            self.clear_liveness_words(uses, fact_word_count);
            self.clear_liveness_words(kills, fact_word_count);
            self.clear_liveness_words(
                edge_kills, edge_count * self.loan_liveness.word_count
            );
            self.build_liveness_facts(uses, kills, edge_points, edge_kills);
            self.solve_loan_liveness(uses, kills, edge_points, edge_kills);
            if (fact_word_count > 0) {
                uses$.dealloc();
                kills$.dealloc();
            }
            if (edge_count > 0 && self.loan_liveness.word_count > 0) {
                edge_kills$.dealloc();
            }
            if (block_count > 0) { edge_points$.dealloc(); }
        }
    }

    Int loan_liveness_tracked_path_count(self) {
        Int count! = 0;
        Int path_index! = 0;
        while (path_index < self.paths.len()) {
            if (self.loan_liveness_tracks_path(move_path.MovePathId(path_index))) {
                count = count + 1;
            }
            path_index = path_index + 1;
        }
        return count;
    }

    Bool loan_liveness_tracks_path(self, move_path.MovePathId path) {
        qid.TypeId type_id = self.move_path_type(path);
        if (self.type_may_carry_borrow(type_id)) { return true; }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return types.is_raw_pointer_handle(handle);
    }

    () initialize_liveness_path_bits(self) {
        unsafe {
            Int bit! = 0;
            Int path_index! = 0;
            while (path_index < self.paths.len()) {
                move_path.MovePathId path = move_path.MovePathId(path_index);
                if (self.loan_liveness_tracks_path(path)) {
                    self.loan_liveness.path_bits[path_index] = bit;
                    self.loan_liveness.tracked_paths[bit] = path_index;
                    bit = bit + 1;
                }
                path_index = path_index + 1;
            }
            assert(bit == self.loan_liveness.tracked_path_count);
        }
    }

    Int loan_liveness_point_count(self) {
        Int count! = 0;
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            count = count + self.body.blocks[block_index].statements.length + 1;
            block_index = block_index + 1;
        }
        return count;
    }

    () initialize_liveness_block_points(self) {
        unsafe {
            Int point! = 0;
            Int block_index! = 0;
            while (block_index < self.body.blocks.length) {
                self.loan_liveness.block_points[block_index] = point;
                point = point + self.body.blocks[block_index].statements.length + 1;
                block_index = block_index + 1;
            }
        }
    }

    Int initialize_liveness_edge_points(self, Int*! edge_points) {
        unsafe {
            Int edge! = 0;
            Int block_index! = 0;
            while (block_index < self.body.blocks.length) {
                edge_points[block_index] = edge;
                edge = edge + jil.terminator_successor_count(
                    self.body.blocks[block_index].terminator
                );
                block_index = block_index + 1;
            }
            return edge;
        }
    }

    () clear_liveness_words(self, UInt64*! words, Int count) {
        unsafe {
            Int index! = 0;
            while (index < count) {
                words[index] = UInt64(0);
                index = index + 1;
            }
        }
    }

    () build_liveness_facts(
        self,
        UInt64*! uses,
        UInt64*! kills,
        Int*! edge_points,
        UInt64*! edge_kills
    ) {
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            self.build_block_liveness_facts(
                self.body.blocks[block_index], uses, kills, edge_points, edge_kills
            );
            block_index = block_index + 1;
        }
    }

    () build_block_liveness_facts(
        self,
        jil.Block block,
        UInt64*! uses,
        UInt64*! kills,
        Int*! edge_points,
        UInt64*! edge_kills
    ) {
        Int block_index = block.id.to_index();
        Int point = unsafe { self.loan_liveness.block_points[block_index] };
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            self.record_statement_liveness_facts(
                block.statements[statement_index], point + statement_index, uses, kills
            );
            statement_index = statement_index + 1;
        }
        self.record_terminator_liveness_facts(
            block.terminator, point + block.statements.length, uses
        );
        self.record_edge_liveness_facts(block, edge_points, edge_kills);
    }

    () record_statement_liveness_facts(
        self,
        jil.Statement statement,
        Int point,
        UInt64*! uses,
        UInt64*! kills
    ) {
        Int tracked_index! = 0;
        while (tracked_index < self.loan_liveness.tracked_path_count) {
            Int target_index = unsafe {
                self.loan_liveness.tracked_paths[tracked_index]
            };
            move_path.MovePathId target = move_path.MovePathId(target_index);
            if (self.statement_uses_loan_target(statement, target)) {
                self.set_liveness_bit(uses, point, target_index);
            }
            if (self.statement_kills_loan_target(statement, target)) {
                self.set_liveness_bit(kills, point, target_index);
            }
            tracked_index = tracked_index + 1;
        }
    }

    () record_terminator_liveness_facts(
        self,
        jil.Terminator terminator,
        Int point,
        UInt64*! uses
    ) {
        Int tracked_index! = 0;
        while (tracked_index < self.loan_liveness.tracked_path_count) {
            Int target_index = unsafe {
                self.loan_liveness.tracked_paths[tracked_index]
            };
            move_path.MovePathId target = move_path.MovePathId(target_index);
            if (self.terminator_uses_loan_target(terminator, target)) {
                self.set_liveness_bit(uses, point, target_index);
            }
            tracked_index = tracked_index + 1;
        }
    }

    () record_edge_liveness_facts(
        self,
        jil.Block block,
        Int*! edge_points,
        UInt64*! edge_kills
    ) {
        Int successor_index! = 0;
        while (successor_index < jil.terminator_successor_count(block.terminator)) {
            self.record_edge_kill_facts(
                block, successor_index, edge_points, edge_kills
            );
            successor_index = successor_index + 1;
        }
    }

    () record_edge_kill_facts(
        self,
        jil.Block block,
        Int successor_index,
        Int*! edge_points,
        UInt64*! edge_kills
    ) {
        Int edge = unsafe {
            edge_points[block.id.to_index()] + successor_index
        };
        Int tracked_index! = 0;
        while (tracked_index < self.loan_liveness.tracked_path_count) {
            Int target_index = unsafe {
                self.loan_liveness.tracked_paths[tracked_index]
            };
            move_path.MovePathId target = move_path.MovePathId(target_index);
            if (self.terminator_kills_loan_target_on_edge(
                block.terminator, successor_index, target
            )) {
                self.set_liveness_bit(edge_kills, edge, target_index);
            }
            tracked_index = tracked_index + 1;
        }
    }

    () set_liveness_bit(
        self,
        UInt64*! rows,
        Int row,
        Int path_index
    ) {
        unsafe {
            Int bit = self.loan_liveness.path_bits[path_index];
            if (bit < 0) { return; }
            Int word = row * self.loan_liveness.word_count + bit / 64;
            rows[word] = rows[word] | (UInt64(1) << UInt64(bit % 64));
        }
    }

    Bool loan_liveness_tracks_target(self, move_path.MovePathId target) {
        if (!self.valid_move_path(target)) { return false; }
        unsafe {
            return self.loan_liveness.path_bits[target.to_index()] >= 0;
        }
    }

    () solve_loan_liveness(
        self,
        UInt64*! uses,
        UInt64*! kills,
        Int*! edge_points,
        UInt64*! edge_kills
    ) {
        unsafe {
            Int block_words = self.body.blocks.length * self.loan_liveness.word_count;
            UInt64*! live_in = UInt64$.alloc(block_words);
            UInt64*! live_out = UInt64$.alloc(block_words);
            self.clear_liveness_words(live_in, block_words);
            self.clear_liveness_words(live_out, block_words);
            self.solve_liveness_fixed_point(
                uses, kills, edge_points, edge_kills, live_in, live_out
            );
            self.cache_solved_liveness(uses, kills, live_out);
            if (block_words > 0) {
                live_in$.dealloc();
                live_out$.dealloc();
            }
        }
    }

    () solve_liveness_fixed_point(
        self,
        UInt64*! uses,
        UInt64*! kills,
        Int*! edge_points,
        UInt64*! edge_kills,
        UInt64*! live_in,
        UInt64*! live_out
    ) {
        Bool changed! = true;
        while (changed) {
            changed = false;
            Int block_index! = self.body.blocks.length;
            while (block_index > 0) {
                block_index = block_index - 1;
                if (self.solve_block_liveness(
                    self.body.blocks[block_index], uses, kills, edge_points,
                    edge_kills, live_in, live_out
                )) {
                    changed = true;
                }
            }
        }
    }

    Bool solve_block_liveness(
        self,
        jil.Block block,
        UInt64*! uses,
        UInt64*! kills,
        Int*! edge_points,
        UInt64*! edge_kills,
        UInt64*! live_in,
        UInt64*! live_out
    ) {
        unsafe {
            Bool changed! = false;
            Int word! = 0;
            while (word < self.loan_liveness.word_count) {
                UInt64 out = self.block_live_out_word(
                    block, word, edge_points, edge_kills, live_in
                );
                Int block_word =
                    block.id.to_index() * self.loan_liveness.word_count + word;
                live_out[block_word] = out;
                UInt64 input = self.transfer_block_liveness_word(
                    block, word, out, uses, kills
                );
                if (input != live_in[block_word]) {
                    live_in[block_word] = input;
                    changed = true;
                }
                word = word + 1;
            }
            return changed;
        }
    }

    UInt64 block_live_out_word(
        self,
        jil.Block block,
        Int word,
        Int*! edge_points,
        UInt64*! edge_kills,
        UInt64*! live_in
    ) {
        unsafe {
            UInt64 live! = UInt64(0);
            Int successor_index! = 0;
            while (successor_index < jil.terminator_successor_count(block.terminator)) {
                jil.BlockId successor = jil.terminator_successor_at(
                    block.terminator, successor_index
                );
                if (self.valid_block_index(successor.to_index())) {
                    Int successor_word =
                        successor.to_index() * self.loan_liveness.word_count + word;
                    Int edge = edge_points[block.id.to_index()] + successor_index;
                    Int edge_word = edge * self.loan_liveness.word_count + word;
                    live = live | (live_in[successor_word] & ~edge_kills[edge_word]);
                }
                successor_index = successor_index + 1;
            }
            return live;
        }
    }

    UInt64 transfer_block_liveness_word(
        self,
        jil.Block block,
        Int word,
        UInt64 live_out,
        UInt64*! uses,
        UInt64*! kills
    ) {
        unsafe {
            Int first_point = self.loan_liveness.block_points[block.id.to_index()];
            Int point! = first_point + block.statements.length;
            UInt64 live! = self.transfer_liveness_word(
                point, word, live_out, uses, kills
            );
            while (point > first_point) {
                point = point - 1;
                live = self.transfer_liveness_word(point, word, live, uses, kills);
            }
            return live;
        }
    }

    UInt64 transfer_liveness_word(
        self,
        Int point,
        Int word,
        UInt64 live_after,
        UInt64*! uses,
        UInt64*! kills
    ) {
        unsafe {
            Int index = point * self.loan_liveness.word_count + word;
            return uses[index] | (live_after & ~kills[index]);
        }
    }

    () cache_solved_liveness(
        self,
        UInt64*! uses,
        UInt64*! kills,
        UInt64*! live_out
    ) {
        Int block_index! = 0;
        while (block_index < self.body.blocks.length) {
            self.cache_block_liveness(
                self.body.blocks[block_index], uses, kills, live_out
            );
            block_index = block_index + 1;
        }
    }

    () cache_block_liveness(
        self,
        jil.Block block,
        UInt64*! uses,
        UInt64*! kills,
        UInt64*! live_out
    ) {
        unsafe {
            Int word! = 0;
            while (word < self.loan_liveness.word_count) {
                Int block_word =
                    block.id.to_index() * self.loan_liveness.word_count + word;
                self.cache_block_liveness_word(
                    block, word, live_out[block_word], uses, kills
                );
                word = word + 1;
            }
        }
    }

    () cache_block_liveness_word(
        self,
        jil.Block block,
        Int word,
        UInt64 live_out,
        UInt64*! uses,
        UInt64*! kills
    ) {
        unsafe {
            Int first_point = self.loan_liveness.block_points[block.id.to_index()];
            Int point! = first_point + block.statements.length;
            UInt64 live! = live_out;
            self.loan_liveness.live_after[
                point * self.loan_liveness.word_count + word
            ] = live;
            live = self.transfer_liveness_word(point, word, live, uses, kills);
            while (point > first_point) {
                point = point - 1;
                self.loan_liveness.live_after[
                    point * self.loan_liveness.word_count + word
                ] = live;
                live = self.transfer_liveness_word(point, word, live, uses, kills);
            }
        }
    }

    Bool loan_target_used_after_current_location(
        self,
        move_path.MovePathId target_path
    ) {
        return self.loan_liveness_has_target(
            self.loan_liveness.live_after, target_path
        );
    }

    Bool loan_liveness_has_target(
        self,
        UInt64*! rows,
        move_path.MovePathId target_path
    ) {
        if (!self.valid_move_path(target_path)) { return false; }
        unsafe {
            Int point = self.current_liveness_point();
            if (point < 0) { return false; }
            Int bit = self.loan_liveness.path_bits[target_path.to_index()];
            if (bit < 0) { return true; }
            Int word = point * self.loan_liveness.word_count + bit / 64;
            UInt64 mask = UInt64(1) << UInt64(bit % 64);
            return (rows[word] & mask) != UInt64(0);
        }
    }

    Int current_liveness_point(self) {
        unsafe {
            Int block_index = self.current_location.block_id.to_index();
            if (!self.valid_block_index(block_index)) { return -1; }
            Int first_point = self.loan_liveness.block_points[block_index];
            if (self.current_location.kind == .statement) {
                return first_point + self.current_location.statement_index;
            }
            return first_point + self.body.blocks[block_index].statements.length;
        }
    }

    () check_block(self, jil.Block block) {
        Int stmt_index! = 0;
        while (stmt_index < block.statements.length) {
            self.current_location = location.Location(
                self.function_id,
                block.id,
                .statement,
                stmt_index
            );
            self.check_statement(block.statements[stmt_index]);
            stmt_index = stmt_index + 1;
        }
        self.current_location = location.Location(self.function_id, block.id, .terminator, -1);
        self.check_terminator(block.terminator);
    }

    () check_statement(self, jil.Statement statement) {
        if (statement.kind is .storage_live_stmt(storage_live)) {
            self.mark_local_live(storage_live.local_id);
            return;
        }
        if (statement.kind is .assign_stmt(assign_stmt)) {
            self.check_rvalue(assign_stmt.value);
            self.check_assignment_escape(assign_stmt.destination, assign_stmt.value);
            self.check_place_write(assign_stmt.destination);
            self.clear_place(assign_stmt.destination);
            self.record_assignment_loan(assign_stmt.destination, assign_stmt.value);
            self.record_init_assignment_sources(assign_stmt.destination);
            return;
        }
        if (statement.kind is .capture_bind_stmt(bind)) {
            self.check_place_use(bind.environment);
            self.record_capture_environment_loans(bind.destination, bind.environment);
            return;
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            self.check_place_use(atomic_store.destination);
            self.check_operand(atomic_store.value);
            return;
        }
        if (statement.kind is .executor_leave_stmt(executor_leave)) {
            return;
        }
        if (statement.kind is .task_suspend_stmt(suspend)) {
            self.check_place_use(suspend.task);
            return;
        }
        if (statement.kind is .task_complete_stmt(complete)) {
            self.check_place_use(complete.task);
            return;
        }
        if (statement.kind is .task_owner_release_stmt(release)) {
            self.check_place_use(release.pointer);
            self.check_task_owner_release_loans(release.pointer);
            return;
        }
        if (statement.kind is .task_release_stmt(release)) {
            if (release.task is .some(task)) {
                move_path.MovePathId task_path = self.paths.path_for_place(task);
                self.remove_active_loan_facts_under(task_path);
                self.remove_borrow_boundaries_under(task_path);
            }
            return;
        }
        if (statement.kind is .task_consume_stmt(consume)) {
            self.check_task_consume(consume);
            return;
        }
        if (statement.kind is .set_discriminant_stmt(discriminant_stmt)) {
            self.clear_place(discriminant_stmt.destination);
            return;
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            self.consume_place(forget_stmt.place);
            return;
        }
        if (statement.kind is .exclusive_stmt(exclusive_stmt)) {
            self.check_exclusive_place_statement(exclusive_stmt.place);
            return;
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            self.clear_storage_dead_local(storage_dead.local_id);
        }
    }

    () clear_storage_dead_local(self, jil.LocalId local_id) {
        move_path.MovePathId path = self.paths.root_for_local(local_id);
        self.check_task_owner_storage_end(path);
        self.state_clear_path(self.dataflow.live_locals, path);
        self.clear_path_and_descendants(path);
    }

    () check_task_owner_storage_end(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (!self.active_loan_target_under_path(fact, path)) { continue; }
            if (!self.loan_target_has_task_owner_ancestor(fact.target, path)) { continue; }
            self.results.mark_error();
            self.add_borrow_escape_diagnostic();
            return;
        }
    }

    Bool loan_target_has_task_owner_ancestor(
        self,
        move_path.MovePathId target,
        move_path.MovePathId boundary
    ) {
        move_path.MovePathId current! = target;
        while (self.valid_move_path(current)) {
            if (self.type_is_task_owner(self.move_path_type(current))) {
                return !self.path_or_ancestor_is_moved(current);
            }
            if (current == boundary) { return false; }
            move_path.MovePath path = self.paths.get(current);
            if (!path.has_parent) { return false; }
            current = path.parent;
        }
        return false;
    }

    Bool type_is_task_owner(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (!types.is_owner_pointer_handle(handle)) { return false; }
        return self.ctx.store.types.get(handle.element).data is .task_type(_);
    }

    () check_task_consume(self, jil.TaskConsumeStatement consume) {
        if (!consume.user_visible) { return; }
        move_path.MovePathId path = self.paths.path_for_place(consume.task);
        if (!self.valid_move_path(path)) { return; }
        if (self.task_path_was_consumed(path, consume.site, consume.repeatable)) {
            self.results.mark_error();
            self.add_task_result_consumed_diagnostic();
            return;
        }
        if (!self.has_task_consume_fact(self.dataflow$.ref(), path, consume.site)) {
            self.dataflow.consumed_tasks.add(TaskConsumeFact(path: path, site: consume.site));
        }
    }

    Bool task_path_was_consumed(self, move_path.MovePathId path, Int site, Bool repeatable) {
        Int index! = 0;
        while (index < self.dataflow.consumed_tasks.len()) {
            TaskConsumeFact fact = self.dataflow.consumed_tasks.get(index);
            if ((fact.site != site || repeatable) && self.task_consume_paths_overlap(path, fact.path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool has_task_consume_fact(
        self,
        BorrowDataflowState& state,
        move_path.MovePathId path,
        Int site
    ) {
        Int index! = 0;
        while (index < state.consumed_tasks.len()) {
            TaskConsumeFact fact = state.consumed_tasks.get(index);
            if (fact.path == path && fact.site == site) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool task_consume_paths_overlap(self, move_path.MovePathId lhs, move_path.MovePathId rhs) {
        if (lhs == rhs) { return true; }
        return self.is_descendant_of(lhs, rhs) || self.is_descendant_of(rhs, lhs);
    }

    () mark_local_live(self, jil.LocalId local_id) {
        self.mark_state_local_live(self.dataflow$.ref(), local_id);
    }

    () mark_state_local_live(self, BorrowDataflowState& state, jil.LocalId local_id) {
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        self.state_set_path(state.live_locals, root);
    }

    () check_assignment_escape(self, jil.Place destination, jil.Rvalue value) {
        if (!self.place_may_write_outside_current_body(destination)) {
            return;
        }
        if (self.internal_coroutine_capture_allows_store(destination)) { return; }
        if (self.type_contains_stack_closure(self.place_type(destination))) {
            if (self.assignment_is_owned_closure_init(destination, value)) {
                return;
            }
            self.results.mark_error();
            self.add_stack_fn_escape_diagnostic();
            return;
        }
        if (self.rvalue_contains_borrowed_value(value)) {
            if (self.current_function_is_init() && self.destination_has_deref_projection(destination)) {
                return;
            }
            if (self.assignment_lifetime_allows_escape(destination, value)) {
                return;
            }
            self.results.mark_error();
            self.add_borrow_escape_diagnostic();
        }
    }

    Bool assignment_is_owned_closure_init(self, jil.Place destination, jil.Rvalue value) {
        if (!self.destination_is_owner_pointer_pointee(destination)) { return false; }
        if (value is .aggregate_value(aggregate)) {
            return self.type_contains_stack_closure(aggregate.type_id);
        }
        return false;
    }

    Bool destination_is_owner_pointer_pointee(self, jil.Place destination) {
        if (destination.projection.length == 0) { return false; }
        jil.PlaceElem last = destination.projection[destination.projection.length - 1];
        guard last is .deref_projection(deref) else { return false; }
        if (deref.raw_pointer) { return false; }
        qid.TypeId base_type = self.place_type_before_last_projection(destination);
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .owner_pointer;
    }

    qid.TypeId place_type_before_last_projection(self, jil.Place place) {
        qid.TypeId type_id! = self.place_base_type(place);
        Int index! = 0;
        while (index + 1 < place.projection.length) {
            type_id = self.projected_type(type_id, place.projection[index]);
            index = index + 1;
        }
        return type_id;
    }

    Bool assignment_lifetime_allows_escape(self, jil.Place destination, jil.Rvalue value) {
        if (value is .borrow_value(borrow_value)) {
            return self.field_lifetime_allows_borrow_store(destination, borrow_value.place);
        }
        if (value is .address_of_value(address_of_value)) {
            return self.field_lifetime_allows_borrow_store(destination, address_of_value.place);
        }
        if (value is .use_value(use_value)) {
            return self.self_lifetime_allows_borrow_store(destination, use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.self_lifetime_allows_borrow_store(destination, cast_value.value);
        }
        if (value is .optional_value(optional_value)) {
            return self.self_lifetime_allows_borrow_store(
                destination, optional_value.value
            );
        }
        if (value is .error_union_value(error_union_value)) {
            return self.self_lifetime_allows_borrow_store(
                destination, error_union_value.value
            );
        }
        if (value is .aggregate_value(aggregate_value)) {
            if (!self.optional_operand_lifetime_allows_escape(
                destination, aggregate_value.tag
            )) {
                return false;
            }
            return self.operands_lifetime_allow_escape(
                destination, aggregate_value.fields
            );
        }
        return false;
    }

    Bool optional_operand_lifetime_allows_escape(
        self,
        jil.Place destination,
        jil.Operand? operand
    ) {
        if (operand is .some(value)) {
            return self.operand_lifetime_allows_escape(destination, value);
        }
        return true;
    }

    Bool operands_lifetime_allow_escape(
        self,
        jil.Place destination,
        jil.Operand[]& operands
    ) {
        Int index! = 0;
        while (index < operands.length) {
            if (!self.operand_lifetime_allows_escape(destination, operands[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool operand_lifetime_allows_escape(
        self,
        jil.Place destination,
        jil.Operand operand
    ) {
        if (!self.type_may_carry_borrow(self.operand_type(operand))) { return true; }
        return self.self_lifetime_allows_borrow_store(destination, operand);
    }

    Bool internal_coroutine_capture_allows_store(self, jil.Place destination) {
        return self.coroutine_capture_task_for_place(destination) != null;
    }

    jil.LocalId? coroutine_capture_task_for_place(self, jil.Place place) {
        guard jil.place_local_id(place) is .some(local_id) else { return null; }
        return self.body.locals[local_id.to_index()].coroutine_capture_task;
    }

    Bool self_lifetime_allows_borrow_store(self, jil.Place destination, jil.Operand operand) {
        guard self.operand_place(operand) is .some(source) else { return false; }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (!self.valid_move_path(source_path)) { return false; }
        return self.all_loan_sources_come_from_receiver(source_path);
    }

    Bool all_loan_sources_come_from_receiver(self, move_path.MovePathId source_path) {
        Bool found! = false;
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, source_path)) { continue; }
            found = true;
            loan.Loan current = self.results.loans.get(fact.loan_id);
            guard self.source_root_param_index(current.source) is .some(param_index) else {
                return false;
            }
            if (!self.param_is_receiver(param_index)) { return false; }
        }
        if (found) { return true; }
        guard self.source_root_param_index(source_path) is .some(param_index) else {
            return false;
        }
        return self.param_is_receiver(param_index);
    }

    Bool destination_is_self_place(self, jil.Place destination) {
        guard jil.place_local_id(destination) is .some(local_id) else { return false; }
        move_path.MovePath path = self.paths.get(self.paths.root_for_local(local_id));
        Int local_index = path.local_id.to_index();
        if (local_index < 0 || local_index >= self.body.locals.length) {
            return false;
        }
        guard self.param_index_for_local(path.local_id) is .some(param_index) else { return false; }
        return self.param_is_receiver(param_index);
    }

    Bool field_lifetime_allows_borrow_store(self, jil.Place destination, jil.Place source) {
        guard self.destination_field_def(destination) is .some(_) else {
            return false;
        }
        if (self.same_local_base(destination, source)) {
            return true;
        }
        if (!self.destination_may_be_initialized_self(destination)) {
            return false;
        }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (!self.valid_move_path(source_path)) { return false; }
        return self.source_root_param_index(source_path) != null;
    }

    Bool destination_may_be_initialized_self(self, jil.Place destination) {
        if (self.destination_is_self_place(destination)) {
            return true;
        }
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        if (self.valid_move_path(destination_path)) {
            if (self.source_root_param_index(destination_path) is .some(param_index)) {
                if (self.param_is_receiver(param_index)) {
                    return true;
                }
            }
        }
        return self.current_function_is_init() && self.destination_has_deref_projection(destination);
    }

    Bool current_function_is_init(self) {
        if (!self.ctx.store.defs.has(self.function_def)) {
            return false;
        }
        return self.ctx.store.defs.get(self.function_def).kind == .init_def;
    }

    Bool destination_has_deref_projection(self, jil.Place destination) {
        Int index! = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? destination_field_def(self, jil.Place destination) {
        qid.DefId? field_def! = null;
        Int index! = 0;
        while (index < destination.projection.length) {
            if (destination.projection[index] is .field_projection(field)) {
                field_def = field.field_def;
            }
            index = index + 1;
        }
        return field_def;
    }

    Bool place_may_write_outside_current_body(self, jil.Place place) {
        Int index! = 0;
        while (index < place.projection.length) {
            if (place.projection[index] is .deref_projection) {
                return true;
            }
            index = index + 1;
        }
        guard jil.place_local_id(place) is .some(local_id) else { return false; }
        guard self.body.locals[local_id.to_index()].coroutine_capture_kind
            is .some(kind) else { return false; }
        return kind == .task_frame;
    }

    Bool rvalue_contains_borrowed_value(self, jil.Rvalue value) {
        if (value is .borrow_value) {
            return true;
        }
        if (value is .address_of_value) {
            return true;
        }
        if (value is .slice_value(slice_value)) {
            return self.slice_rvalue_contains_active_loan(slice_value);
        }
        if (value is .use_value(use_value)) {
            return self.operand_contains_active_loan(use_value.value);
        }
        if (value is .cast_value(cast_value)) {
            return self.operand_contains_active_loan(cast_value.value);
        }
        if (value is .inline_asm_value(inline_asm)) {
            return self.inline_asm_contains_active_loan(inline_asm);
        }
        if (value is .optional_value(optional_value)) {
            return self.operand_contains_active_loan(optional_value.value);
        }
        if (value is .error_union_value(error_union_value)) {
            return self.operand_contains_active_loan(error_union_value.value);
        }
        if (value is .aggregate_value(aggregate_value)) {
            return self.operands_contain_active_loan(aggregate_value.fields);
        }
        if (value is .closure_value(closure_value)) {
            return self.operands_contain_active_loan(closure_value.captures);
        }
        return false;
    }

    Bool inline_asm_contains_active_loan(self, jil.InlineAsmRvalue value) {
        Int index! = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                if (self.operand_contains_active_loan(input.value)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool slice_rvalue_contains_active_loan(self, jil.SliceRvalue value) {
        if (self.has_active_loan_for_path(self.paths.path_for_place(value.base))) {
            return true;
        }
        if (self.optional_operand_contains_active_loan(value.start)) { return true; }
        return self.optional_operand_contains_active_loan(value.end);
    }

    Bool optional_operand_contains_active_loan(self, jil.Operand? operand) {
        if (operand is .some(value)) {
            return self.operand_contains_active_loan(value);
        }
        return false;
    }

    Bool operands_contain_active_loan(self, jil.Operand[]& operands) {
        Int index! = 0;
        while (index < operands.length) {
            if (self.operand_contains_active_loan(operands[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool operand_contains_active_loan(self, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) {
            if (!self.place_type_may_carry_borrow(copy_operand.place)) { return false; }
            return self.has_active_loan_for_path(self.paths.path_for_place(copy_operand.place));
        }
        if (operand is .move_operand(move_operand)) {
            if (!self.place_type_may_carry_borrow(move_operand.place)) { return false; }
            return self.has_active_loan_for_path(self.paths.path_for_place(move_operand.place));
        }
        return false;
    }

    () record_assignment_loan(self, jil.Place destination, jil.Rvalue value) {
        self.record_assignment_loan_value(destination, value);
        self.record_nominal_lifetime_relations(destination);
    }

    () record_assignment_loan_value(self, jil.Place destination, jil.Rvalue value) {
        if (value is .borrow_value(borrow_value)) {
            self.add_loan(
                self.reference_loan_kind_for_type(self.place_type(destination)),
                borrow_value.place,
                destination
            );
            self.record_borrowed_place_carried_loans(
                destination, borrow_value.place
            );
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.add_loan(.raw_pointer_view, address_of_value.place, destination);
            if (self.logical_raw_storage_element_type(destination) is .some(element_type)) {
                self.record_logical_raw_storage_source(
                    self.paths.path_for_place(destination),
                    element_type,
                    self.paths.path_for_place(address_of_value.place)
                );
            }
            return;
        }
        if (value is .use_value(use_value)) {
            self.record_logical_raw_storage_operand(
                destination,
                use_value.value
            );
            self.record_operand_loan(destination, use_value.value);
            return;
        }
        if (value is .cast_value(cast_value)) {
            self.record_logical_raw_storage_operand(
                destination,
                cast_value.value
            );
            self.record_operand_loan(destination, cast_value.value);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.record_slice_loan(destination, slice_value);
            return;
        }
        if (value is .optional_value(optional_value)) {
            self.record_operand_loan(destination, optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.record_operand_loan(destination, error_union_value.value);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.record_aggregate_loan(destination, aggregate_value);
            return;
        }
        if (value is .closure_value(closure_value)) {
            self.record_closure_loans(destination, closure_value);
        }
    }

    () record_logical_raw_storage_operand(
        self,
        jil.Place destination,
        jil.Operand operand
    ) {
        guard self.logical_raw_storage_element_type(destination)
            is .some(element_type) else {
            return;
        }
        self.record_logical_raw_storage_loan(
            self.paths.path_for_place(destination),
            element_type,
            operand
        );
    }

    () record_borrowed_place_carried_loans(
        self,
        jil.Place destination,
        jil.Place source
    ) {
        qid.TypeId source_type = self.place_type(source);
        if (!self.type_may_carry_borrow(source_type)) { return; }
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        jil.PlaceElem deref =
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        guard self.paths.existing_child_for_projection(destination_path, deref)
            is .some(pointee) else {
            return;
        }
        self.record_active_operand_loans(
            pointee, self.paths.path_for_place(source)
        );
    }

    () record_closure_loans(self, jil.Place destination, jil.ClosureRvalue value) {
        self.record_capture_loans(destination, value.captures);
    }

    () record_capture_loans(self, jil.Place destination, jil.Operand[]& captures) {
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        qid.TypeId destination_type = self.place_type(destination);
        Int index! = 0;
        while (index < captures.length) {
            self.record_operand_loan_to_path(
                destination_path,
                destination_type,
                captures[index]
            );
            index = index + 1;
        }
    }

    () record_capture_environment_loans(
        self,
        jil.Place destination,
        jil.Place environment
    ) {
        self.record_operand_loan(
            destination,
            jil.copy_operand_value(jil.CopyOperand (place: environment))
        );
    }

    () check_task_owner_release_loans(self, jil.Place owner) {
        move_path.MovePathId path = self.paths.path_for_place(owner);
        if (!self.has_active_loan_fact_under(path)) { return; }
        self.results.mark_error();
        self.add_borrow_escape_diagnostic();
        self.remove_active_loan_facts_under(path);
        self.remove_borrow_boundaries_under(path);
    }

    () record_nominal_lifetime_relations(self, jil.Place destination) {
        move_path.MovePathId current! = self.paths.path_for_place(destination);
        while (self.valid_move_path(current)) {
            self.apply_nominal_region_schema(current);
            move_path.MovePath path = self.paths.get(current);
            if (!path.has_parent) { return; }
            current = path.parent;
        }
    }

    () apply_nominal_region_schema(self, move_path.MovePathId root_path) {
        types.TypeInfo info = self.ctx.store.types.get(self.move_path_type(root_path));
        guard info.data is .named(named) else { return; }
        guard self.typeck.nominal_region_schema(named.def_id) is .some(schema) else { return; }
        Int index! = 0;
        while (index < schema.flows.length) {
            types.NominalLifetimeFlow flow = schema.flows[index];
            move_path.MovePathId source =
                self.project_lifetime_move_path(root_path, flow.source);
            move_path.MovePathId target =
                self.project_lifetime_move_path(root_path, flow.target);
            self.record_active_operand_loans(target, source);
            index = index + 1;
        }
    }

    () record_init_assignment_sources(self, jil.Place destination) {
        if (!self.current_function_is_init()) { return; }
        if (!self.destination_may_be_initialized_self(destination)) { return; }
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        if (!self.valid_move_path(destination_path)) { return; }
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, destination_path)) { continue; }
            loan.Loan current = self.results.loans.get(fact.loan_id);
            guard self.source_root_param_index(current.source) is .some(source_index) else { continue; }
            if (self.param_is_receiver(source_index)) { continue; }
            guard self.param_root_path_by_index(source_index) is .some(source_root) else { continue; }
            guard self.receiver_param_index() is .some(receiver_index) else { continue; }
            guard self.param_root_path_by_index(receiver_index) is .some(target_root) else { continue; }
            self.results.infer_init_lifetime_source(
                self.function_def,
                source_index,
                self.move_path_lifetime_projection(source_root, current.source),
                self.move_path_lifetime_projection(target_root, fact.target)
            );
        }
    }

    types.LifetimeProjectionPathId? move_path_lifetime_projection(
        self,
        move_path.MovePathId root,
        move_path.MovePathId path_id
    ) {
        if (path_id == root) { return null; }
        if (!self.is_descendant_of(path_id, root)) { return null; }
        move_path.MovePath path = self.paths.get(path_id);
        types.LifetimeProjectionPathId? parent =
            self.move_path_lifetime_projection(root, path.parent);
        if (path.projection is .field_projection(field)) {
            return self.ctx.store.types.intern_lifetime_projection(
                parent,
                .field,
                field.field_def,
                0
            );
        }
        if (path.projection is .constant_index_projection(index)) {
            return self.ctx.store.types.intern_lifetime_projection(
                parent,
                .tuple_index,
                null,
                index.offset
            );
        }
        return parent;
    }

    () record_aggregate_loan(self, jil.Place destination, jil.AggregateRvalue value) {
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        if (!self.valid_move_path(destination_path)) { return; }
        Int index! = 0;
        while (index < value.fields.length) {
            move_path.MovePathId field_path = self.aggregate_field_path(destination_path, value, index);
            if (self.aggregate_logical_raw_storage_type(value, index) is .some(element_type)) {
                self.record_logical_raw_storage_loan(
                    field_path,
                    element_type,
                    value.fields[index]
                );
            } else {
                qid.TypeId field_type = self.aggregate_field_type(value, index);
                self.record_operand_loan_to_path(field_path, field_type, value.fields[index]);
            }
            index = index + 1;
        }
    }

    qid.TypeId? aggregate_logical_raw_storage_type(
        self,
        jil.AggregateRvalue value,
        Int field_index
    ) {
        if (value.kind != .struct_value) { return null; }
        guard self.aggregate_field_def(value.def_id$.some(), field_index)
            is .some(field_def) else {
            return null;
        }
        sem.Def& field = self.ctx.store.model.def_ref(field_def);
        if (field.life_clauses.len() == 0) { return null; }
        types.TypeInfo owner_info = self.ctx.store.types.get(value.type_id);
        guard owner_info.data is .named(named) else { return null; }
        qid.TypeId field_type = self.structural_field_type(named, field_def);
        types.TypeInfo field_info = self.ctx.store.types.get(field_type);
        guard field_info.data is .handle_type(handle) else { return null; }
        if (!types.is_raw_pointer_handle(handle)) { return null; }
        return handle.element;
    }

    () record_logical_raw_storage_loan(
        self,
        move_path.MovePathId destination,
        qid.TypeId element_type,
        jil.Operand operand
    ) {
        guard self.operand_place(operand) is .some(pointer) else { return; }
        move_path.MovePathId pointer_path = self.paths.path_for_place(pointer);
        Int original_len = self.dataflow.active_loans.len();
        Int index! = 0;
        while (index < original_len) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (fact.target != pointer_path) { continue; }
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (current.kind != .raw_pointer_view) { continue; }
            self.record_logical_raw_storage_source(
                destination,
                element_type,
                current.source
            );
        }
    }

    () record_logical_raw_storage_source(
        self,
        move_path.MovePathId destination,
        qid.TypeId element_type,
        move_path.MovePathId source
    ) {
        if (self.record_active_operand_loans(destination, source)) { return; }
        if (self.source_root_param_index(source) != null) {
            self.record_param_carried_loans(source, destination, element_type);
        }
    }

    qid.TypeId? logical_raw_storage_element_type(
        self,
        jil.Place destination
    ) {
        if (destination.projection.length == 0) { return null; }
        jil.PlaceElem projection = destination.projection[destination.projection.length - 1];
        guard projection is .field_projection(field) else { return null; }
        sem.Def& model_field = self.ctx.store.model.def_ref(field.field_def);
        if (model_field.life_clauses.len() == 0) { return null; }
        types.TypeInfo field_info = self.ctx.store.types.get(field.field_type);
        guard field_info.data is .handle_type(handle) else { return null; }
        if (!types.is_raw_pointer_handle(handle)) { return null; }
        return handle.element;
    }

    move_path.MovePathId aggregate_field_path(self,
        move_path.MovePathId destination_path,
        jil.AggregateRvalue value,
        Int field_index
    ) {
        if (value.kind == .struct_value) {
            if (self.aggregate_field_projection(value, field_index) is .some(projection)) {
                return self.paths.child_for_projection(destination_path, projection);
            }
        }
        if (value.kind == .union_variant) {
            if (self.union_variant_field_path(destination_path, value, field_index)
                is .some(variant_path)) {
                return variant_path;
            }
        }
        jil.PlaceElem projection = jil.constant_index_projection_elem(
            jil.ConstantIndexProjection(offset: field_index)
        );
        return self.paths.child_for_projection(destination_path, projection);
    }

    move_path.MovePathId ensure_aggregate_field_path(self,
        move_path.MovePathId destination_path,
        jil.AggregateRvalue value,
        Int field_index
    ) {
        if (value.kind == .struct_value) {
            if (self.aggregate_field_projection(value, field_index) is .some(projection)) {
                return self.paths.ensure_child_for_projection(destination_path, projection);
            }
        }
        if (value.kind == .union_variant) {
            if (self.ensure_union_variant_field_path(destination_path, value, field_index)
                is .some(variant_path)) {
                return variant_path;
            }
        }
        jil.PlaceElem projection = jil.constant_index_projection_elem(
            jil.ConstantIndexProjection(offset: field_index)
        );
        return self.paths.ensure_child_for_projection(destination_path, projection);
    }

    move_path.MovePathId? union_variant_field_path(
        self,
        move_path.MovePathId destination_path,
        jil.AggregateRvalue value,
        Int field_index
    ) {
        guard value.def_id is .some(variant_def) else { return null; }
        guard self.typeck.def_type(variant_def) is .some(payload_type) else { return null; }
        jil.PlaceElem variant_projection = jil.field_projection_elem(jil.FieldProjection (
            field_def: variant_def,
            field_type: payload_type,
            field_index: value.payload_field_index
        ));
        move_path.MovePathId variant_path =
            self.paths.child_for_projection(destination_path, variant_projection);
        types.TypeInfo payload_info = self.ctx.store.types.get(payload_type);
        if (!(payload_info.data is .tuple_type(_))) { return variant_path; }
        jil.PlaceElem item_projection = jil.constant_index_projection_elem(
            jil.ConstantIndexProjection(offset: field_index)
        );
        return self.paths.child_for_projection(variant_path, item_projection);
    }

    move_path.MovePathId? ensure_union_variant_field_path(
        self,
        move_path.MovePathId destination_path,
        jil.AggregateRvalue value,
        Int field_index
    ) {
        guard value.def_id is .some(variant_def) else { return null; }
        guard self.typeck.def_type(variant_def) is .some(payload_type) else { return null; }
        jil.PlaceElem variant_projection = jil.field_projection_elem(jil.FieldProjection (
            field_def: variant_def,
            field_type: payload_type,
            field_index: value.payload_field_index
        ));
        move_path.MovePathId variant_path = self.paths.ensure_child_for_projection(
            destination_path,
            variant_projection
        );
        types.TypeInfo payload_info = self.ctx.store.types.get(payload_type);
        if (!(payload_info.data is .tuple_type(_))) { return variant_path; }
        jil.PlaceElem item_projection = jil.constant_index_projection_elem(
            jil.ConstantIndexProjection(offset: field_index)
        );
        return self.paths.ensure_child_for_projection(variant_path, item_projection);
    }

    jil.PlaceElem? aggregate_field_projection(self, jil.AggregateRvalue value, Int field_index) {
        guard value.def_id is .some(def_id) else { return null; }
        guard self.aggregate_field_def(def_id, field_index) is .some(field_def) else { return null; }
        return jil.field_projection_elem(jil.FieldProjection (
            field_def: field_def,
            field_type: self.aggregate_field_type(value, field_index),
            field_index: field_index
        ));
    }

    qid.DefId? aggregate_field_def(self, qid.DefId owner_def, Int field_index) {
        guard self.ctx.store.model.def(owner_def) is .some(model_def) else { return null; }
        Int field_count! = 0;
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            if (self.ctx.store.defs.get(member_def).kind == .field_def) {
                if (field_count == field_index) {
                    return member_def;
                }
                field_count = field_count + 1;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId aggregate_field_type(self, jil.AggregateRvalue value, Int field_index) {
        if (field_index >= 0 && field_index < value.fields.length) {
            if (self.operand_place(value.fields[field_index]) is .some(place)) {
                return self.place_type(place);
            }
        }
        return self.projected_type(
            value.type_id,
            jil.constant_index_projection_elem(jil.ConstantIndexProjection(offset: field_index))
        );
    }

    () record_slice_loan(self, jil.Place destination, jil.SliceRvalue value) {
        types.TypeInfo base_info = self.ctx.store.types.get(self.place_type(value.base));
        if (base_info.data is .array_type(_)) {
            self.add_loan(self.reference_loan_kind_for_type(self.place_type(destination)), value.base, destination);
            return;
        }
        if (base_info.data is .handle_type(handle)) {
            if (handle.kind == .slice) {
                self.record_operand_loan(
                    destination,
                    jil.copy_operand_value(jil.CopyOperand (place: value.base))
                );
            }
        }
    }

    // 复制 `T&`/`T*` 值本身不会创建新 owner，但会把来源 loan 传播到目标 place。
    // 这让 `return_value.field = input_ref` 这类字段写入能在 return 检查时被看见。
    () record_operand_loan(self, jil.Place destination, jil.Operand operand) {
        self.record_operand_loan_to_path(
            self.paths.path_for_place(destination),
            self.place_type(destination),
            operand
        );
    }

    () record_operand_loan_to_path(self,
        move_path.MovePathId destination_path,
        qid.TypeId destination_type,
        jil.Operand operand
    ) {
        if (!self.type_may_carry_borrow(destination_type)) { return; }
        if (!self.valid_move_path(destination_path)) { return; }
        guard self.operand_place(operand) is .some(source) else { return; }
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (self.record_active_operand_loans(destination_path, source_path)) {
            return;
        }
        guard jil.place_local_id(source) is .some(source_local) else { return; }
        if (!self.local_is_param(source_local)) {
            return;
        }
        if (self.place_handle_loan_kind(source) is .some(kind)) {
            self.add_loan_from_paths(kind, self.paths.path_for_place(source), destination_path);
            return;
        }
        if (self.place_type_may_carry_borrow(source)) {
            move_path.MovePathId source_path = self.paths.path_for_place(source);
            if (self.source_root_param_index(source_path) != null) {
                self.record_param_carried_loans(source_path, destination_path, self.place_type(source));
            }
        }
    }

    () record_param_carried_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        qid.TypeId type_id
    ) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.record_param_carried_loans_inner(source, destination, type_id, visiting$.ref());
    }

    () record_param_carried_loans_inner(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (!self.type_may_carry_borrow(type_id)) { return; }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.record_named_param_loans(source, destination, named, visiting)) {
                return;
            }
        }
        if (self.type_has_atomic_lifetime(type_id)) {
            self.add_carried_loan_from_paths(.reference_view, source, destination);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.record_tuple_param_loans(source, destination, tuple_type, visiting);
            return;
        }
        if (info.data is .optional(optional)) {
            if (!self.move_path_has_children(source)
                && !self.move_path_has_children(destination)) {
                self.add_carried_loan_from_paths(.reference_view, source, destination);
                return;
            }
            self.record_param_carried_loans_inner(
                source, destination, optional.element, visiting
            );
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.record_handle_param_loans(source, destination, handle, visiting);
            return;
        }
        self.add_carried_loan_from_paths(.reference_view, source, destination);
    }

    () record_handle_param_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.HandleType handle,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (types.is_reference_handle(handle)) {
            self.add_carried_loan_from_paths(.reference_view, source, destination);
            if (!self.type_may_carry_borrow(handle.element)) { return; }
            move_path.MovePathId source_value = self.reference_value_path(source);
            move_path.MovePathId destination_value = self.reference_value_path(destination);
            self.record_param_carried_loans_inner(
                source_value, destination_value, handle.element, visiting
            );
            return;
        }
        if (types.is_owner_pointer_handle(handle)) {
            self.record_param_carried_loans_inner(
                source, destination, handle.element, visiting
            );
            return;
        }
        if (!types.is_slice_handle(handle)) { return; }
        self.add_carried_loan_from_paths(.reference_view, source, destination);
        if (!self.move_path_has_children(source)
            && !self.move_path_has_children(destination)) {
            return;
        }
        self.record_param_carried_loans_inner(
            source, destination, handle.element, visiting
        );
    }

    Bool move_path_has_children(self, move_path.MovePathId path) {
        list.ArrayList<move_path.MovePathId> children! =
            list.ArrayList<move_path.MovePathId>();
        self.paths.append_children(path, children$.ref());
        return !children.empty();
    }

    () record_tuple_param_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            jil.PlaceElem projection = jil.constant_index_projection_elem(
                jil.ConstantIndexProjection(offset: index)
            );
            move_path.MovePathId source_child =
                self.existing_lifetime_child(source, projection);
            move_path.MovePathId destination_child =
                self.existing_lifetime_child(destination, projection);
            self.record_param_carried_loans_inner(
                source_child,
                destination_child,
                tuple_type.items[index],
                visiting
            );
            index = index + 1;
        }
    }

    Bool record_named_param_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.NamedType named,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.typeck.nominal_region_schema(named.def_id) is .some(schema)) {
            if (schema.params.length > 0) {
                Int index! = 0;
                while (index < schema.bindings.length) {
                    typeck_store.NominalRegionBinding binding = schema.bindings[index];
                    self.add_carried_loan_from_paths(
                        .reference_view,
                        self.project_lifetime_move_path(source, binding.path),
                        self.project_lifetime_move_path(destination, binding.path)
                    );
                    index = index + 1;
                }
                return true;
            }
        }
        if (!self.structural_nominal_def(named.def_id)) { return false; }
        if (self.def_list_contains(visiting, named.def_id)) { return true; }
        guard self.ctx.store.model.def(named.def_id) is .some(owner) else {
            return false;
        }
        visiting.add(named.def_id);
        Int index! = 0;
        while (index < owner.members.len()) {
            qid.DefId field_def = owner.members.get(index);
            index = index + 1;
            if (!self.structural_lifetime_field(field_def)) { continue; }
            qid.TypeId field_type = self.structural_field_type(named, field_def);
            jil.PlaceElem projection = self.structural_field_projection(
                field_def,
                field_type
            );
            self.record_param_carried_loans_inner(
                self.existing_lifetime_child(source, projection),
                self.existing_lifetime_child(destination, projection),
                field_type,
                visiting
            );
        }
        visiting.pop();
        return true;
    }

    move_path.MovePathId existing_lifetime_child(
        self,
        move_path.MovePathId parent,
        jil.PlaceElem projection
    ) {
        if (self.paths.existing_child_for_projection(parent, projection) is .some(child)) {
            return child;
        }
        return parent;
    }

    Bool record_active_operand_loans(self,
        move_path.MovePathId destination_path,
        move_path.MovePathId source_path
    ) {
        if (!self.valid_move_path(source_path)) { return false; }
        self.record_active_borrow_boundaries(destination_path, source_path);
        Bool recorded! = false;
        Int original_len = self.dataflow.active_loans.len();
        Bool has_precise_targets =
            self.active_loans_have_descendant_target(source_path, original_len);
        Bool has_matching_precise_target = has_precise_targets
            || self.active_loans_have_exact_target(source_path, original_len);
        Int index! = 0;
        while (index < original_len) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, source_path)) { continue; }
            if (has_matching_precise_target
                && fact.target != source_path
                && self.is_descendant_of(source_path, fact.target)) {
                continue;
            }
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (fact.target == source_path && has_precise_targets) { continue; }
            if (fact.target == source_path
                && self.move_path_has_children(destination_path)) {
                self.record_whole_source_lifetime_loans(
                    current.source,
                    destination_path,
                    self.move_path_type(destination_path),
                    current.domain_type
                );
                recorded = true;
                continue;
            }
            move_path.MovePathId copied_target =
                self.copied_loan_target(source_path, fact.target, destination_path);
            self.add_loan_from_paths_with_domain_kind(
                current.kind,
                current.source,
                copied_target,
                current.domain_type,
                current.carried
            );
            recorded = true;
        }
        return recorded;
    }

    () record_active_borrow_boundaries(
        self,
        move_path.MovePathId destination_path,
        move_path.MovePathId source_path
    ) {
        Int original_len = self.dataflow.borrow_boundaries.len();
        Int index! = 0;
        while (index < original_len) {
            BorrowBoundaryFact fact = self.dataflow.borrow_boundaries.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, source_path)) { continue; }
            move_path.MovePathId copied_target = self.copied_loan_target(
                source_path, fact.target, destination_path
            );
            self.add_borrow_boundary_fact(
                self.dataflow$.ref(),
                BorrowBoundaryFact(boundary: fact.boundary, target: copied_target)
            );
        }
    }

    move_path.MovePathId copied_loan_target(
        self,
        move_path.MovePathId source_root,
        move_path.MovePathId source_target,
        move_path.MovePathId destination_root
    ) {
        if (source_target == source_root) { return destination_root; }
        if (!self.is_descendant_of(source_target, source_root)) {
            return destination_root;
        }
        return self.rebase_descendant_move_path(source_root, source_target, destination_root);
    }

    move_path.MovePathId rebase_descendant_move_path(
        self,
        move_path.MovePathId old_root,
        move_path.MovePathId old_path,
        move_path.MovePathId new_root
    ) {
        if (old_path == old_root) { return new_root; }
        move_path.MovePath path = self.paths.get(old_path);
        move_path.MovePathId parent =
            self.rebase_descendant_move_path(old_root, path.parent, new_root);
        if (self.paths.existing_child_for_projection(parent, path.projection) is .some(child)) {
            return child;
        }
        return parent;
    }

    Bool loan_target_matches_path(self, move_path.MovePathId target_path, move_path.MovePathId use_path) {
        if (target_path == use_path) { return true; }
        if (self.is_descendant_of(use_path, target_path)) { return true; }
        if (self.is_descendant_of(target_path, use_path)) { return true; }
        return self.move_paths_may_alias(target_path, use_path);
    }

    Bool move_paths_may_alias(
        self,
        move_path.MovePathId lhs_id,
        move_path.MovePathId rhs_id
    ) {
        if (!self.valid_move_path(lhs_id) || !self.valid_move_path(rhs_id)) {
            return false;
        }
        move_path.MovePathId lhs! = lhs_id;
        move_path.MovePathId rhs! = rhs_id;
        Int lhs_depth! = self.move_path_depth(lhs);
        Int rhs_depth! = self.move_path_depth(rhs);
        while (lhs_depth > rhs_depth) {
            lhs = self.paths.get(lhs).parent;
            lhs_depth = lhs_depth - 1;
        }
        while (rhs_depth > lhs_depth) {
            rhs = self.paths.get(rhs).parent;
            rhs_depth = rhs_depth - 1;
        }
        return self.same_depth_move_paths_may_alias(lhs, rhs);
    }

    Int move_path_depth(self, move_path.MovePathId path_id) {
        Int depth! = 0;
        move_path.MovePath current! = self.paths.get(path_id);
        while (current.has_parent) {
            depth = depth + 1;
            current = self.paths.get(current.parent);
        }
        return depth;
    }

    Bool same_depth_move_paths_may_alias(
        self,
        move_path.MovePathId lhs_id,
        move_path.MovePathId rhs_id
    ) {
        if (lhs_id == rhs_id) { return true; }
        move_path.MovePath lhs = self.paths.get(lhs_id);
        move_path.MovePath rhs = self.paths.get(rhs_id);
        if (!lhs.has_parent || !rhs.has_parent) { return false; }
        if (!self.same_depth_move_paths_may_alias(lhs.parent, rhs.parent)) { return false; }
        if (move_path.place_elem_equal(lhs.projection, rhs.projection)) { return true; }
        qid.TypeId parent_type = self.move_path_type(lhs.parent);
        if (self.ctx.store.types.get(parent_type).data is .tuple_type(_)) {
            return false;
        }
        return self.sequence_projections_may_alias(lhs.projection, rhs.projection);
    }

    Bool sequence_projections_may_alias(
        self,
        jil.PlaceElem lhs,
        jil.PlaceElem rhs
    ) {
        if (lhs is .index_projection(_)) {
            return self.sequence_projection(rhs);
        }
        if (rhs is .index_projection(_)) {
            return self.sequence_projection(lhs);
        }
        if (lhs is .subslice_projection(_)) {
            return self.sequence_projection(rhs);
        }
        if (rhs is .subslice_projection(_)) {
            return self.sequence_projection(lhs);
        }
        return false;
    }

    Bool sequence_projection(self, jil.PlaceElem projection) {
        if (projection is .index_projection(_)) { return true; }
        if (projection is .constant_index_projection(_)) { return true; }
        return projection is .subslice_projection(_);
    }

    Bool local_is_param(self, jil.LocalId local_id) {
        Int index = local_id.to_index();
        if (!self.valid_local_index(index)) {
            return false;
        }
        return self.body.locals[index].kind == .param;
    }

    Bool place_type_may_carry_borrow(self, jil.Place place) {
        return self.type_may_carry_borrow(self.place_type(place));
    }

    loan.LoanKind? place_handle_loan_kind(self, jil.Place place) {
        types.TypeInfo info = self.ctx.store.types.get(self.place_type(place));
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any) { return loan.raw_pointer_view_kind(); }
            if (companion.kind == .receiver) { return loan.raw_pointer_view_kind(); }
            return null;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (types.is_reference_handle(handle) || types.is_slice_handle(handle)) {
            return self.reference_loan_kind_for_type(self.place_type(place));
        }
        if (types.is_raw_pointer_handle(handle)) { return loan.raw_pointer_view_kind(); }
        return null;
    }

    loan.LoanKind reference_loan_kind_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return loan.reference_view_kind(); }
        if (info.is_mutable && (types.is_reference_handle(handle) || types.is_slice_handle(handle))) {
            return loan.mutable_reference_view_kind();
        }
        return loan.reference_view_kind();
    }

    Bool type_may_carry_borrow(self, qid.TypeId type_id) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.ctx, self.typeck);
        return query.type_may_carry_borrow(type_id);
    }

    Bool type_has_atomic_lifetime(self, qid.TypeId type_id) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.ctx, self.typeck);
        return query.lifetime_shape(type_id).index
            == self.typeck.lifetime_shapes.slot_shape().index;
    }

    Bool valid_local_index(self, Int index) {
        return index >= 0 && index < self.body.locals.length;
    }

    () add_loan(self, loan.LoanKind kind, jil.Place source, jil.Place target) {
        move_path.MovePathId original_source_path = self.paths.path_for_place(source);
        move_path.MovePathId source_path = self.canonical_loan_source(original_source_path);
        move_path.MovePathId target_path = self.paths.path_for_place(target);
        if (!self.valid_move_path(source_path) || !self.valid_move_path(target_path)) { return; }
        self.check_new_reference_loan(kind, original_source_path, source_path);
        self.add_loan_from_paths(kind, source_path, target_path);
    }

    () check_new_reference_loan(
        self,
        loan.LoanKind kind,
        move_path.MovePathId original_source,
        move_path.MovePathId canonical_source
    ) {
        if (kind == .raw_pointer_view) { return; }
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            index = index + 1;
            if (!self.reference_loan_kinds_conflict(kind, current.kind)) { continue; }
            if (self.loan_target_matches_path(fact.target, original_source)) { continue; }
            if (!self.loan_sources_overlap(canonical_source, current.source)) { continue; }
            if (!self.loan_target_used_after_current_location(fact.target)) { continue; }
            self.results.mark_error();
            self.add_mutable_borrow_diagnostic();
        }
    }

    Bool reference_loan_kinds_conflict(self, loan.LoanKind lhs, loan.LoanKind rhs) {
        if (lhs == .raw_pointer_view || rhs == .raw_pointer_view) { return false; }
        return lhs == .mutable_reference_view || rhs == .mutable_reference_view;
    }

    Bool loan_sources_overlap(self, move_path.MovePathId lhs, move_path.MovePathId rhs) {
        if (self.path_matches_or_contains(lhs, rhs)) { return true; }
        if (self.path_matches_or_contains(rhs, lhs)) { return true; }
        return self.move_paths_may_alias(lhs, rhs);
    }

    () add_loan_from_paths(self, loan.LoanKind kind, move_path.MovePathId source, move_path.MovePathId target) {
        self.add_loan_from_paths_with_domain(kind, source, target, self.effect_domain_binding(self.current_effects));
    }

    () add_carried_loan_from_paths(
        self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target
    ) {
        self.add_carried_loan_from_paths_with_domain(
            kind,
            source,
            target,
            self.effect_domain_binding(self.current_effects)
        );
    }

    qid.DefId? effect_domain_binding(self, types.EffectSet effects) {
        if (effects.domain is .some(domain)) { return domain.binding; }
        return null;
    }

    () add_loan_from_paths_with_domain(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type
    ) {
        self.add_loan_from_paths_with_domain_kind(
            kind, source, target, domain_type, false
        );
    }

    () add_carried_loan_from_paths_with_domain(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type
    ) {
        self.add_loan_from_paths_with_domain_kind(
            kind, source, target, domain_type, true
        );
    }

    () add_loan_from_paths_with_domain_kind(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type,
        Bool carried
    ) {
        move_path.MovePathId canonical_source = self.canonical_loan_source(source);
        loan.LoanId loan_id = self.get_or_add_loan(
            kind, canonical_source, target, domain_type, carried
        );
        self.add_active_loan(target, loan_id);
    }

    loan.LoanId get_or_add_loan(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type,
        Bool carried
    ) {
        if (self.existing_loan(kind, source, target, domain_type, carried) is .some(loan_id)) {
            return loan_id;
        }
        return self.results.add_loan(
            kind, self.function_id, source, target, domain_type, carried
        );
    }

    loan.LoanId? existing_loan(self,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type,
        Bool carried
    ) {
        Int index! = self.loan_start_index;
        while (index < self.results.loans.len()) {
            loan.Loan current = self.results.loans.get(loan.LoanId(index));
            if (self.same_loan(current, kind, source, target, domain_type, carried)) {
                return current.id;
            }
            index = index + 1;
        }
        return null;
    }

    Bool same_loan(self,
        loan.Loan current,
        loan.LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type,
        Bool carried
    ) {
        if (current.function_id.to_index() != self.function_id.to_index()) { return false; }
        if (current.kind != kind) { return false; }
        if (current.source != source) { return false; }
        if (current.target != target) { return false; }
        if (current.carried != carried) { return false; }
        return self.same_optional_def(current.domain_type, domain_type);
    }

    Bool same_optional_def(self, qid.DefId? lhs, qid.DefId? rhs) {
        if (lhs is .some(left)) {
            guard rhs is .some(right) else { return false; }
            return left.to_index() == right.to_index();
        }
        return rhs == null;
    }

    () add_active_loan(self, move_path.MovePathId target, loan.LoanId loan_id) {
        self.add_active_loan_fact(self.dataflow$.ref(), loan_facts.ActiveLoanFact(target, loan_id));
    }

    move_path.MovePathId canonical_loan_source(self, move_path.MovePathId source) {
        move_path.MovePathId current_source! = source;
        Int depth! = 0;
        while (depth < 32) {
            guard self.canonical_source_loan(current_source) is .some(loan_id) else {
                return current_source;
            }
            loan.Loan current = self.results.loans.get(loan_id);
            if (current.source == current_source) {
                return current_source;
            }
            current_source = self.canonical_source_through_loan(
                current_source, current
            );
            depth = depth + 1;
        }
        return current_source;
    }

    move_path.MovePathId canonical_source_through_loan(
        self,
        move_path.MovePathId source,
        loan.Loan current
    ) {
        if (!self.is_descendant_of(source, current.target)) {
            return current.source;
        }
        return self.rebase_descendant_move_path(
            current.target, source, current.source
        );
    }

    loan.LoanId? canonical_source_loan(self, move_path.MovePathId path) {
        if (self.borrowed_handle_type(self.move_path_type(path))) {
            if (self.first_active_loan_for_exact_path(path) is .some(loan_id)) {
                return loan_id;
            }
        }
        // 普通聚合根上的 exact loan 仅表示它携带借用，不表示整个聚合
        // 是该来源的别名；但祖先 loan 表示当前 place 经借用 handle 投影得到。
        return self.first_active_loan_for_ancestor(path);
    }

    () check_terminator(self, jil.Terminator terminator) {
        if (terminator.kind is .goto_term(goto_term)) {
            if (goto_term.initialized_place is .some(initialized_place)) {
                self.clear_place(initialized_place);
            }
            return;
        }
        if (terminator.kind is .branch_term(branch)) {
            self.check_operand(branch.condition);
            return;
        }
        if (terminator.kind is .switch_term(switch_term)) {
            self.check_operand(switch_term.discriminator);
            return;
        }
        if (terminator.kind is .call_term(call_term)) {
            self.check_call(call_term);
            return;
        }
        if (terminator.kind is .drop_term(drop_term)) {
            self.check_drop(drop_term.place);
            return;
        }
        if (terminator.kind is .assert_term(assert_term)) {
            self.check_operand(assert_term.condition);
            return;
        }
        if (terminator.kind is .return_term(return_term)) {
            self.check_return(return_term);
            return;
        }
        if (terminator.kind is .throw_term(throw_term)) {
            self.check_operand(throw_term.error_value);
        }
    }

    () check_drop(self, jil.Place place) {
        if (self.place_is_indirect_memory(place)) {
            return;
        }
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        // 部分移动后的 root 仍需析构剩余字段。只有 root 本身或祖先已经
        // 被移动时，当前 drop 才是无效使用。
        if (self.path_or_ancestor_is_moved(path)) {
            self.results.mark_error();
            self.add_use_after_move_diagnostic();
        }
        self.check_move_place_conflicts(path);
        self.mark_moved(path);
    }

    Bool path_or_ancestor_is_moved(self, move_path.MovePathId path) {
        if (self.state_has_path(self.dataflow.moved, path)) { return true; }
        return self.has_moved_ancestor(path);
    }

    Bool place_needs_drop(self, jil.Place place) {
        if (self.place_is_indirect_memory(place)) {
            return false;
        }
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.ctx);
        return query.type_needs_runtime_drop(self.place_type(place));
    }

    () check_return(self, jil.ReturnTerminator return_term) {
        if (return_term.implicit_unit) {
            return;
        }
        if (self.type_contains_stack_closure(self.local_type(self.body.return_local))) {
            self.results.mark_error();
            self.add_stack_fn_escape_diagnostic();
            return;
        }
        move_path.MovePathId return_path = self.paths.root_for_local(self.body.return_local);
        self.check_return_path_escape(return_path);
        self.check_borrow_boundaries_valid(return_path);
    }

    Bool type_contains_stack_closure(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.type_contains_stack_closure_inner(type_id, visiting$.ref());
    }

    Bool type_contains_stack_closure_inner(self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .function_type(function_type)) {
            if (function_type.kind != .closure) { return false; }
            return !function_type.effects.has_async
                || function_type.call_ownership != .consuming;
        }
        if (info.data is .optional(optional)) {
            return self.type_contains_stack_closure_inner(optional.element, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_contains_stack_closure_inner(error_union.value, visiting)
                || self.type_contains_stack_closure_inner(error_union.error, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_contains_stack_closure_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_contains_stack_closure(tuple_type, visiting);
        }
        if (info.data is .named(named)) {
            return self.named_contains_stack_closure(named.def_id, visiting);
        }
        return false;
    }

    Bool tuple_contains_stack_closure(self,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            if (self.type_contains_stack_closure_inner(tuple_type.items[index], visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool named_contains_stack_closure(self,
        qid.DefId def_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.def_list_contains(visiting, def_id)) {
            return false;
        }
        guard self.ctx.store.model.def(def_id) is .some(model_def) else { return false; }
        Int depth = visiting.len();
        visiting.add(def_id);
        Bool result = self.named_members_contain_stack_closure(model_def, visiting);
        visiting.truncate(depth);
        return result;
    }

    Bool named_members_contain_stack_closure(self,
        sem.Def& model_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            if (self.field_contains_stack_closure(member_def, visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool field_contains_stack_closure(self,
        qid.DefId member_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.ctx.store.defs.get(member_def).kind != .field_def) {
            return false;
        }
        table.HashTable<qid.DefId, qid.TypeId>& def_types = self.typeck.def_types$.ref();
        guard table.hash_table_get_value<qid.DefId, qid.TypeId>(def_types, member_def) is .some(field_type) else {
            return false;
        }
        return self.type_contains_stack_closure_inner(field_type, visiting);
    }

    Bool def_list_contains(self, list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () check_return_path_escape(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.return_path_contains_target(path, fact.target)) {
                self.check_return_loan_escape(fact);
            }
            index = index + 1;
        }
    }

    () check_return_loan_escape(self, loan_facts.ActiveLoanFact fact) {
        loan.Loan current = self.results.loans.get(fact.loan_id);
        if (self.current_lambda_has_empty_lifetime_contract() && !current.carried) {
            self.results.mark_error();
            self.add_return_lifetime_source_not_allowed_diagnostic();
            return;
        }
        if (!self.check_loan_valid_for_fact(fact)) {
            return;
        }
        if (self.return_lifetime_allowed(fact)) { return; }
        self.results.mark_error();
        self.add_return_lifetime_source_not_allowed_diagnostic();
    }

    Bool current_lambda_has_empty_lifetime_contract(self) {
        if (!self.current_function_is_lambda()) { return false; }
        guard self.function_lifetime_contract() is .some(contract) else { return true; }
        return contract.flows.length == 0;
    }

    Bool return_path_contains_target(self, move_path.MovePathId return_path, move_path.MovePathId target_path) {
        if (return_path == target_path) { return true; }
        return self.is_descendant_of(target_path, return_path);
    }

    Bool return_lifetime_allowed(
        self,
        loan_facts.ActiveLoanFact fact
    ) {
        if (self.current_function_is_init()) {
            return true;
        }
        loan.Loan current = self.results.loans.get(fact.loan_id);
        guard self.source_root_param_index(current.source) is .some(source_index) else { return false; }
        if (!self.loan_source_is_carried_from_param(current.source)) {
            return false;
        }
        if (current.carried
            && self.current_function_is_lambda()
            && self.callable_carried_return_source(source_index, current.source)) {
            return true;
        }
        return self.return_lifetime_contract_matches(
            source_index,
            current.source,
            fact.target,
            current.carried
        );
    }

    Bool current_function_is_lambda(self) {
        guard self.ctx.store.model.def(self.function_def) is .some(model_def) else {
            return false;
        }
        return model_def.decl.is_lambda_function;
    }

    Bool return_lifetime_contract_matches(
        self,
        Int source_index,
        move_path.MovePathId source_path,
        move_path.MovePathId target_path,
        Bool carried
    ) {
        guard self.function_lifetime_contract() is .some(contract) else { return false; }
        guard self.param_root_path_by_index(source_index) is .some(source_root) else { return false; }
        move_path.MovePathId target_root = self.paths.root_for_local(self.body.return_local);
        Int index! = 0;
        while (index < contract.flows.length) {
            types.LifetimeFlow flow = contract.flows[index];
            index = index + 1;
            if (flow.source.root_kind == .callable_result) {
                if (!carried
                    || !self.callable_carried_return_source(source_index, source_path)) {
                    continue;
                }
                move_path.MovePathId logical_target =
                    self.project_lifetime_move_path(target_root, flow.target.projection_path);
                if (self.return_target_matches_lifetime_path(
                    flow.target.projection_path,
                    logical_target,
                    target_path
                )) {
                    return true;
                }
                continue;
            }
            if (!self.return_flow_roots_match(flow, source_index)) { continue; }
            move_path.MovePathId source_projection_root = self.lifetime_parameter_root(
                source_root,
                source_index,
                flow.source.projection_path
            );
            move_path.MovePathId expected_source = self.project_lifetime_move_path(
                source_projection_root, flow.source.projection_path
            );
            move_path.MovePathId expected_target =
                self.project_lifetime_move_path(target_root, flow.target.projection_path);
            if (flow.source.projection_path != null
                && !self.move_path_matches_lifetime_path(expected_source, source_path)) {
                continue;
            }
            if (self.return_target_matches_lifetime_path(
                flow.target.projection_path,
                expected_target,
                target_path
            )) {
                return true;
            }
        }
        return false;
    }

    Bool callable_carried_return_source(
        self,
        Int source_index,
        move_path.MovePathId source_path
    ) {
        guard self.param_root_path_by_index(source_index) is .some(root) else {
            return false;
        }
        qid.TypeId source_type = self.move_path_type(source_path);
        if (self.borrowed_handle_type(source_type)) {
            if (!self.reference_handle_type(self.move_path_type(root))) { return true; }
            if (source_path == root) { return false; }
            return self.paths.get(source_path).parent != root;
        }
        if (source_path != root) { return false; }
        types.TypeInfo root_info = self.ctx.store.types.get(self.move_path_type(root));
        return root_info.data is .function_type(_);
    }

    Bool return_target_matches_lifetime_path(
        self,
        types.LifetimeProjectionPathId? projection_path,
        move_path.MovePathId expected,
        move_path.MovePathId actual
    ) {
        if (projection_path == null) { return true; }
        return self.move_path_matches_lifetime_path(expected, actual);
    }

    types.LifetimeContract? function_lifetime_contract(self) {
        guard self.typeck.def_type(self.function_def) is .some(type_id) else { return null; }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return null; }
        return function_type.lifetime_contract;
    }

    Bool return_flow_roots_match(self, types.LifetimeFlow flow, Int source_index) {
        return flow.source.root_kind == .parameter
            && flow.source.root_index == source_index
            && flow.target.root_kind == .result;
    }

    Bool move_path_matches_lifetime_path(
        self,
        move_path.MovePathId expected,
        move_path.MovePathId actual
    ) {
        Int expected_depth = self.move_path_depth(expected);
        Int actual_depth! = self.move_path_depth(actual);
        if (actual_depth < expected_depth) {
            return false;
        }
        move_path.MovePathId actual_prefix! = actual;
        while (actual_depth > expected_depth) {
            actual_prefix = self.paths.get(actual_prefix).parent;
            actual_depth = actual_depth - 1;
        }
        return self.same_depth_move_paths_may_alias(expected, actual_prefix);
    }

    Bool loan_source_is_carried_from_param(self, move_path.MovePathId source) {
        if (self.move_path_has_deref(source)) { return true; }
        return self.type_may_carry_borrow(self.move_path_type(source));
    }

    Bool move_path_has_deref(self, move_path.MovePathId path_id) {
        move_path.MovePathId current! = path_id;
        while (self.valid_move_path(current)) {
            move_path.MovePath path = self.paths.get(current);
            if (path.has_projection && path.projection is .deref_projection) { return true; }
            if (!path.has_parent) { return false; }
            current = path.parent;
        }
        return false;
    }

    qid.TypeId move_path_type(self, move_path.MovePathId path_id) {
        move_path.MovePath path = self.paths.get(path_id);
        if (!path.has_parent) { return self.local_type(path.local_id); }
        qid.TypeId parent_type = self.move_path_type(path.parent);
        return self.projected_type(parent_type, path.projection);
    }

    Bool is_return_local_path(self, move_path.MovePathId path_id) {
        move_path.MovePath path = self.paths.get(path_id);
        return path.local_id.to_index() == self.body.return_local.to_index();
    }

    Int? source_root_param_index(self, move_path.MovePathId source) {
        move_path.MovePath path = self.paths.get(source);
        if (self.param_index_for_local(path.local_id) is .some(param_index)) {
            return param_index;
        }
        return self.source_root_param_index_from_local_loan(path.local_id);
    }

    Int? source_root_param_index_from_local_loan(self, jil.LocalId local_id) {
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        guard self.first_active_loan_for_path(root) is .some(loan_id) else {
            return null;
        }
        loan.Loan current = self.results.loans.get(loan_id);
        return self.source_root_param_index(current.source);
    }

    Int? param_index_for_local(self, jil.LocalId local_id) {
        Int param_index! = 0;
        Int local_index! = 0;
        while (local_index < self.body.locals.length) {
            jil.LocalDecl local = self.body.locals[local_index];
            if (local.kind == .param) {
                if (local.id == local_id) { return param_index; }
                param_index = param_index + 1;
            }
            local_index = local_index + 1;
        }
        return null;
    }

    Int? receiver_param_index(self) {
        guard self.ctx.store.model.def(self.function_def) is .some(model_def) else { return null; }
        guard model_def.decl.function_signature is .some(signature) else { return null; }
        if (signature.has_receiver) { return 0; }
        return null;
    }

    Bool param_is_receiver(self, Int param_index) {
        guard self.receiver_param_index() is .some(receiver_index) else { return false; }
        return receiver_index == param_index;
    }

    Bool reference_receiver_param(self, Int param_index) {
        if (!self.param_is_receiver(param_index)) { return false; }
        guard self.ctx.store.model.def(self.function_def) is .some(model_def) else {
            return false;
        }
        guard model_def.decl.function_signature is .some(signature) else {
            return false;
        }
        return signature.receiver_mode != .move_receiver;
    }

    move_path.MovePathId prebuild_lifetime_parameter_root(
        self,
        move_path.MovePathId root,
        Int param_index,
        types.LifetimeProjectionPathId? projection_path
    ) {
        if (!self.lifetime_parameter_projects_pointee(root, param_index, projection_path)) {
            return root;
        }
        return self.paths.ensure_child_for_projection(
            root,
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false))
        );
    }

    move_path.MovePathId lifetime_parameter_root(
        self,
        move_path.MovePathId root,
        Int param_index,
        types.LifetimeProjectionPathId? projection_path
    ) {
        if (!self.lifetime_parameter_projects_pointee(root, param_index, projection_path)) {
            return root;
        }
        jil.PlaceElem deref =
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        if (self.paths.existing_child_for_projection(root, deref) is .some(child)) {
            return child;
        }
        return root;
    }

    Bool lifetime_parameter_projects_pointee(
        self,
        move_path.MovePathId root,
        Int param_index,
        types.LifetimeProjectionPathId? projection_path
    ) {
        if (projection_path == null) { return false; }
        return self.reference_receiver_param(param_index);
    }

    () check_call(self, jil.CallTerminator call_term) {
        self.check_call_callee(call_term.callee);
        Int index! = 0;
        while (index < call_term.args.length) {
            self.check_operand(call_term.args[index]);
            index = index + 1;
        }
        self.check_domain_call_args(call_term);
        self.check_exclusive_places_call(call_term);
        self.clear_place(call_term.destination);
        if (!call_term.deferred_initialization
            && call_term.initialized_place is .some(initialized_place)) {
            self.clear_place(initialized_place);
        }
        self.record_call_lifetime_loans(call_term);
    }

    () check_domain_call_args(self, jil.CallTerminator call_term) {
        types.EffectSet required = self.callee_effects(call_term.callee);
        guard required.domain is .some(required_domain) else { return; }
        Int index! = 0;
        while (index < call_term.args.length) {
            self.check_domain_call_arg(call_term, index, required_domain.binding);
            index = index + 1;
        }
    }

    () check_domain_call_arg(self, jil.CallTerminator call_term, Int index, qid.DefId required_domain) {
        jil.Operand operand = call_term.args[index];
        if (!self.type_is_mutable_borrowed_handle(self.operand_type(operand))) { return; }
        if (self.argument_domain_type(operand) is .some(arg_domain)) {
            if (arg_domain.to_index() == required_domain.to_index()) { return; }
        }
        self.results.mark_error();
        self.add_domain_borrow_diagnostic();
    }

    types.EffectSet callee_effects(self, jil.CallCallee callee) {
        qid.TypeId type_id! = self.ctx.store.types.invalid_type();
        if (callee is .direct_function(function_ref)) {
            type_id = function_ref.type_id;
        }
        if (callee is .indirect_operand(operand)) {
            type_id = self.operand_type(operand);
        }
        if (callee is .domain_enqueue(enqueue)) {
            type_id = self.operand_type(enqueue.resume);
        }
        if (callee is .dynamic_domain_enqueue(enqueue)) {
            type_id = self.operand_type(enqueue.resume);
        }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else {
            return types.EffectSet();
        }
        return function_type.effects;
    }

    qid.DefId? argument_domain_type(self, jil.Operand operand) {
        guard self.operand_place(operand) is .some(place) else { return null; }
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (self.first_active_loan_for_path(path) is .some(loan_id)) {
            return self.results.loans.get(loan_id).domain_type;
        }
        if (self.place_is_borrowed_param(place)) {
            return self.effect_domain_binding(self.function_effects);
        }
        return null;
    }

    Bool place_is_borrowed_param(self, jil.Place place) {
        guard jil.place_local_id(place) is .some(local_id) else { return false; }
        if (!self.local_is_param(local_id)) { return false; }
        return self.borrowed_handle_type(self.local_type(local_id));
    }

    qid.TypeId operand_type(self, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) { return self.place_type(copy_operand.place); }
        if (operand is .move_operand(move_operand)) { return self.place_type(move_operand.place); }
        if (operand is .out_operand(out_operand)) { return self.place_type(out_operand.place); }
        if (operand is .function_operand(function_ref)) { return function_ref.type_id; }
        if (operand is .global_operand(global_ref)) { return global_ref.type_id; }
        if (operand is .global_address_operand(global_ref)) { return global_ref.type_id; }
        if (operand is .const_operand(const_value)) { return const_value.type_id; }
        return self.ctx.store.types.invalid_type();
    }

    Bool type_is_mutable_borrowed_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference && handle.kind != .slice) { return false; }
        return info.is_mutable;
    }

    () check_exclusive_places_call(self, jil.CallTerminator call_term) {
        self.check_exclusive_place_pairs(call_term.exclusive_places);
        Int exclusive_index! = 0;
        while (exclusive_index < call_term.exclusive_places.length) {
            self.check_exclusive_place_call(call_term, call_term.exclusive_places[exclusive_index]);
            exclusive_index = exclusive_index + 1;
        }
    }

    () check_exclusive_place_pairs(self, jil.Place[]& places) {
        Int left_index! = 0;
        while (left_index < places.length) {
            move_path.MovePathId left = self.canonical_loan_source(self.paths.path_for_place(places[left_index]));
            Int right_index! = left_index + 1;
            while (right_index < places.length) {
                move_path.MovePathId right = self.canonical_loan_source(
                    self.paths.path_for_place(places[right_index])
                );
                if (self.loan_sources_overlap(left, right)) {
                    self.results.mark_error();
                    self.add_mutable_borrow_diagnostic();
                }
                right_index = right_index + 1;
            }
            left_index = left_index + 1;
        }
    }

    () check_exclusive_place_call(self, jil.CallTerminator call_term, jil.Place exclusive_place) {
        self.check_exclusive_place_signature_requirement(exclusive_place);
        move_path.MovePathId argument_path = self.paths.path_for_place(exclusive_place);
        move_path.MovePathId exclusive_path = self.canonical_loan_source(argument_path);
        if (!self.valid_move_path(exclusive_path)) { return; }
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (self.loan_target_matches_path(fact.target, argument_path)) {
                index = index + 1;
                continue;
            }
            if (self.exclusive_place_loan_conflicts(exclusive_path, current, fact.target)) {
                self.results.mark_error();
                self.add_mutable_borrow_diagnostic();
            }
            index = index + 1;
        }
    }

    () check_exclusive_place_statement(self, jil.Place exclusive_place) {
        self.check_exclusive_place_signature_requirement(exclusive_place);
        move_path.MovePathId exclusive_path = self.paths.path_for_place(exclusive_place);
        if (!self.valid_move_path(exclusive_path)) { return; }
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (self.exclusive_place_statement_loan_conflicts(exclusive_path, current, fact.target)) {
                self.results.mark_error();
                self.add_mutable_borrow_diagnostic();
            }
            index = index + 1;
        }
    }

    () check_exclusive_place_signature_requirement(self, jil.Place exclusive_place) {
        move_path.MovePathId argument_path = self.paths.path_for_place(exclusive_place);
        if (self.local_mutable_handle_grants_authority(argument_path)) { return; }
        move_path.MovePathId exclusive_path = self.canonical_loan_source(argument_path);
        if (!self.valid_move_path(exclusive_path)) { return; }
        if (!self.exclusive_place_requires_signature(exclusive_path)) { return; }
        guard self.source_root_param_index(exclusive_path) is .some(param_index) else { return; }
        if (self.current_function_is_init() && self.param_is_receiver(param_index)) { return; }
        if (self.current_signature_has_exclusive_param(param_index)) { return; }
        self.results.mark_error();
        self.add_mutable_reference_requirement_diagnostic();
    }

    Bool local_mutable_handle_grants_authority(self, move_path.MovePathId path_id) {
        if (!self.valid_move_path(path_id)) { return false; }
        move_path.MovePath path = self.paths.get(path_id);
        Int local_index = path.local_id.to_index();
        if (!self.valid_local_index(local_index)) { return false; }
        jil.LocalDecl local = self.body.locals[local_index];
        if (local.kind == .param) { return false; }
        return self.type_is_mutable_borrowed_handle(local.type_id);
    }

    Bool exclusive_place_requires_signature(self, move_path.MovePathId exclusive_path) {
        move_path.MovePath path = self.paths.get(exclusive_path);
        Int local_index = path.local_id.to_index();
        if (!self.valid_local_index(local_index)) { return false; }
        jil.LocalDecl local = self.body.locals[local_index];
        if (local.kind == .param && self.borrowed_handle_type(local.type_id)) { return true; }
        // 普通值即使携带引用字段，也只是在修改本地聚合槽，不会获得那些
        // 字段所指向位置的可变能力；只有借用 handle 本身需要签名声明。
        return false;
    }

    Bool borrowed_handle_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        return handle.kind == .slice;
    }

    Bool reference_handle_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .reference;
    }

    Bool current_signature_has_exclusive_param(self, Int param_index) {
        guard self.ctx.store.model.def(self.function_def) is .some(model_def) else { return false; }
        guard model_def.decl.function_signature is .some(signature) else {
            if (!model_def.decl.is_lambda_function) { return false; }
            return self.inferred_lambda_param_is_exclusive(param_index);
        }
        if (signature.has_receiver && param_index == 0) {
            return signature.receiver_mode == .mutable_ref_receiver;
        }
        Int explicit_index! = param_index;
        if (signature.has_receiver) { explicit_index = explicit_index - 1; }
        if (explicit_index < 0 || explicit_index >= signature.param_symbols.length) { return false; }
        qid.SymbolId symbol = signature.param_symbols[explicit_index];
        Int index! = 0;
        while (index < signature.exclusive_symbols.length) {
            if (signature.exclusive_symbols[index] == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool inferred_lambda_param_is_exclusive(self, Int param_index) {
        Int current! = 0;
        Int index! = 0;
        while (index < self.body.locals.length) {
            jil.LocalDecl local = self.body.locals[index];
            index = index + 1;
            if (local.kind != .param) { continue; }
            if (current != param_index) {
                current = current + 1;
                continue;
            }
            types.TypeInfo info = self.ctx.store.types.get(local.type_id);
            return info.is_mutable && self.borrowed_handle_type(local.type_id);
        }
        return false;
    }

    Bool exclusive_place_statement_loan_conflicts(self,
        move_path.MovePathId exclusive_path,
        loan.Loan current,
        move_path.MovePathId target_path
    ) {
        return self.exclusive_place_loan_conflicts(exclusive_path, current, target_path);
    }

    Bool exclusive_place_loan_conflicts(self,
        move_path.MovePathId place_path,
        loan.Loan current,
        move_path.MovePathId target_path
    ) {
        if (!self.exclusive_place_contains_loan_source(place_path, current)) { return false; }
        return self.loan_target_used_after_current_location(target_path);
    }

    Bool exclusive_place_contains_loan_source(self, move_path.MovePathId place_path, loan.Loan current) {
        return self.path_matches_or_contains(place_path, current.source);
    }

    Bool call_uses_loan_target(self, jil.CallTerminator call_term, move_path.MovePathId target_path) {
        if (self.call_callee_uses_loan_target(call_term.callee, target_path)) { return true; }
        if (self.place_write_uses_loan_target(call_term.destination, target_path)) {
            return true;
        }
        if (call_term.initialized_place is .some(initialized_place)) {
            if (self.place_write_uses_loan_target(initialized_place, target_path)) {
                return true;
            }
        }
        Int index! = 0;
        while (index < call_term.args.length) {
            if (self.operand_uses_loan_target(call_term.args[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return self.places_use_loan_target(
            call_term.exclusive_places, target_path
        );
    }

    Bool call_callee_uses_loan_target(self, jil.CallCallee callee, move_path.MovePathId target_path) {
        if (callee is .indirect_operand(operand)) {
            return self.operand_uses_loan_target(operand, target_path);
        }
        if (callee is .domain_enqueue(enqueue)) {
            if (self.optional_operand_uses_loan_target(enqueue.task, target_path)) { return true; }
            return self.operand_uses_loan_target(enqueue.resume, target_path);
        }
        if (callee is .dynamic_domain_enqueue(enqueue)) {
            if (self.operand_uses_loan_target(enqueue.executor, target_path)) { return true; }
            if (self.optional_operand_uses_loan_target(enqueue.task, target_path)) { return true; }
            return self.operand_uses_loan_target(enqueue.resume, target_path);
        }
        return false;
    }

    Bool statement_uses_loan_target(self, jil.Statement statement, move_path.MovePathId target_path) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            if (self.rvalue_uses_loan_target(assign_stmt.value, target_path)) {
                return true;
            }
            return self.place_write_uses_loan_target(
                assign_stmt.destination, target_path
            );
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            if (self.place_write_uses_loan_target(
                atomic_store.destination, target_path
            )) {
                return true;
            }
            return self.operand_uses_loan_target(atomic_store.value, target_path);
        }
        if (statement.kind is .executor_leave_stmt(executor_leave)) {
            return self.local_uses_loan_target(executor_leave.executor, target_path)
                || self.local_uses_loan_target(
                    executor_leave.previous_context, target_path
                );
        }
        if (statement.kind is .task_suspend_stmt(suspend)) {
            return self.place_uses_loan_target(suspend.task, target_path);
        }
        if (statement.kind is .task_complete_stmt(complete)) {
            return self.place_uses_loan_target(complete.task, target_path);
        }
        if (statement.kind is .forget_stmt(forget_stmt)) {
            return self.place_uses_loan_target(forget_stmt.place, target_path);
        }
        if (statement.kind is .set_discriminant_stmt(discriminant)) {
            return self.place_write_uses_loan_target(
                discriminant.destination, target_path
            );
        }
        if (statement.kind is .exclusive_stmt(exclusive_stmt)) {
            return self.place_uses_loan_target(exclusive_stmt.place, target_path);
        }
        if (statement.kind is .capture_bind_stmt(bind)) {
            return self.place_uses_loan_target(bind.destination, target_path)
                || self.place_uses_loan_target(bind.environment, target_path);
        }
        if (statement.kind is .task_consume_stmt(consume)) {
            return self.place_uses_loan_target(consume.task, target_path);
        }
        if (statement.kind is .task_release_stmt(release)) {
            return self.task_release_uses_loan_target(release, target_path);
        }
        if (statement.kind is .task_owner_release_stmt(release)) {
            return self.place_uses_loan_target(release.pointer, target_path);
        }
        if (statement.kind is .task_region_start_stmt(start)) {
            return self.place_uses_loan_target(start.task, target_path);
        }
        if (statement.kind is .task_wait_stmt(wait)) {
            if (self.place_uses_loan_target(wait.state, target_path)) { return true; }
            return self.operand_uses_loan_target(wait.expected, target_path);
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            move_path.MovePathId root = self.paths.root_for_local(storage_dead.local_id);
            if (!self.path_matches_or_contains(root, target_path)) { return false; }
            return self.loan_target_has_task_owner_ancestor(target_path, root);
        }
        return false;
    }

    Bool statement_kills_loan_target(self, jil.Statement statement, move_path.MovePathId target_path) {
        if (statement.kind is .assign_stmt(assign_stmt)) {
            return self.place_kills_loan_target(assign_stmt.destination, target_path);
        }
        if (statement.kind is .atomic_store_stmt(atomic_store)) {
            return self.place_kills_loan_target(atomic_store.destination, target_path);
        }
        if (statement.kind is .set_discriminant_stmt(discriminant)) {
            return self.place_kills_loan_target(discriminant.destination, target_path);
        }
        if (statement.kind is .storage_live_stmt(storage_live)) {
            move_path.MovePathId root = self.paths.root_for_local(storage_live.local_id);
            return self.path_matches_or_contains(root, target_path);
        }
        if (statement.kind is .storage_dead_stmt(storage_dead)) {
            move_path.MovePathId root = self.paths.root_for_local(storage_dead.local_id);
            return self.path_matches_or_contains(root, target_path);
        }
        return false;
    }

    Bool terminator_uses_loan_target(self, jil.Terminator terminator, move_path.MovePathId target_path) {
        if (terminator.kind is .goto_term(goto_term)) {
            if (goto_term.initialized_place is .some(initialized_place)) {
                return self.place_write_uses_loan_target(
                    initialized_place, target_path
                );
            }
            return false;
        }
        if (terminator.kind is .branch_term(branch)) {
            return self.operand_uses_loan_target(branch.condition, target_path);
        }
        if (terminator.kind is .switch_term(switch_term)) {
            return self.operand_uses_loan_target(switch_term.discriminator, target_path);
        }
        if (terminator.kind is .call_term(call_term)) {
            return self.call_uses_loan_target(call_term, target_path);
        }
        if (terminator.kind is .drop_term(drop_term)) {
            return self.place_uses_loan_target(drop_term.place, target_path);
        }
        if (terminator.kind is .assert_term(assert_term)) {
            return self.operand_uses_loan_target(assert_term.condition, target_path);
        }
        if (terminator.kind is .throw_term(throw_term)) {
            return self.operand_uses_loan_target(throw_term.error_value, target_path);
        }
        if (terminator.kind is .return_term(return_term)) {
            if (return_term.implicit_unit) { return false; }
            move_path.MovePathId return_path =
                self.paths.root_for_local(self.body.return_local);
            return self.loan_target_matches_path(target_path, return_path);
        }
        return false;
    }

    Bool terminator_kills_loan_target_on_edge(
        self,
        jil.Terminator terminator,
        Int successor_index,
        move_path.MovePathId target_path
    ) {
        if (successor_index != 0) { return false; }
        if (terminator.kind is .goto_term(goto_term)) {
            if (goto_term.initialized_place is .some(initialized_place)) {
                return self.place_kills_loan_target(initialized_place, target_path);
            }
            return false;
        }
        if (terminator.kind is .call_term(call_term)) {
            if (self.place_kills_loan_target(call_term.destination, target_path)) {
                return true;
            }
            if (call_term.deferred_initialization) { return false; }
            if (call_term.initialized_place is .some(initialized_place)) {
                return self.place_kills_loan_target(initialized_place, target_path);
            }
        }
        return false;
    }

    Bool rvalue_uses_loan_target(self, jil.Rvalue value, move_path.MovePathId target_path) {
        if (value is .use_value(use_value)) {
            return self.operand_uses_loan_target(use_value.value, target_path);
        }
        if (value is .unary_value(unary_value)) {
            return self.operand_uses_loan_target(unary_value.value, target_path);
        }
        if (value is .binary_value(binary_value)) {
            if (self.operand_uses_loan_target(binary_value.lhs, target_path)) { return true; }
            return self.operand_uses_loan_target(binary_value.rhs, target_path);
        }
        if (value is .cast_value(cast_value)) {
            return self.operand_uses_loan_target(cast_value.value, target_path);
        }
        if (value is .inline_asm_value(inline_asm)) {
            return self.inline_asm_uses_loan_target(inline_asm, target_path);
        }
        if (value is .borrow_value(borrow_value)) {
            return self.place_uses_loan_target(borrow_value.place, target_path);
        }
        if (value is .address_of_value(address_of_value)) {
            return self.place_uses_loan_target(address_of_value.place, target_path);
        }
        if (value is .coroutine_address_value(coroutine_address)) {
            return self.place_write_uses_loan_target(
                coroutine_address.place, target_path
            );
        }
        if (value is .executor_enter_value(executor_enter)) {
            return self.local_uses_loan_target(executor_enter.executor, target_path)
                || self.local_uses_loan_target(executor_enter.context, target_path);
        }
        if (value is .atomic_load_value(atomic_load)) {
            return self.place_uses_loan_target(atomic_load.place, target_path);
        }
        if (value is .atomic_exchange_value(exchange)) {
            if (self.place_uses_loan_target(exchange.place, target_path)) { return true; }
            return self.operand_uses_loan_target(exchange.desired, target_path);
        }
        if (value is .atomic_compare_exchange_value(compare_exchange)) {
            if (self.place_uses_loan_target(compare_exchange.place, target_path)) { return true; }
            if (self.operand_uses_loan_target(compare_exchange.expected, target_path)) { return true; }
            return self.operand_uses_loan_target(compare_exchange.desired, target_path);
        }
        if (value is .alloc_value(alloc_value)) {
            return self.operand_uses_loan_target(alloc_value.value, target_path);
        }
        if (value is .coroutine_frame_alloc_value(frame_alloc)) {
            return self.operand_uses_loan_target(frame_alloc.executor, target_path);
        }
        if (value is .alloc_array_value(alloc_array)) {
            return self.operand_uses_loan_target(alloc_array.count, target_path);
        }
        if (value is .free_value(free_value)) {
            return self.operand_uses_loan_target(free_value.pointer, target_path);
        }
        if (value is .coroutine_frame_free_value(frame_free)) {
            if (self.operand_uses_loan_target(frame_free.pointer, target_path)) { return true; }
            return self.operand_uses_loan_target(frame_free.executor, target_path);
        }
        if (value is .slice_value(slice_value)) {
            if (self.place_uses_loan_target(slice_value.base, target_path)) { return true; }
            if (self.optional_operand_uses_loan_target(slice_value.start, target_path)) { return true; }
            return self.optional_operand_uses_loan_target(slice_value.end, target_path);
        }
        if (value is .len_value(len_value)) {
            return self.place_uses_loan_target(len_value.place, target_path);
        }
        if (value is .discriminant_value(discriminant_value)) {
            return self.place_uses_loan_target(discriminant_value.place, target_path);
        }
        if (value is .aggregate_value(aggregate_value)) {
            if (self.optional_operand_uses_loan_target(aggregate_value.tag, target_path)) { return true; }
            return self.operands_use_loan_target(aggregate_value.fields, target_path);
        }
        if (value is .closure_value(closure_value)) {
            if (self.operands_use_loan_target(closure_value.captures, target_path)) { return true; }
            return self.operand_uses_loan_target(closure_value.vtable, target_path);
        }
        if (value is .optional_value(optional_value)) {
            return self.operand_uses_loan_target(optional_value.value, target_path);
        }
        if (value is .error_union_value(error_union_value)) {
            return self.operand_uses_loan_target(error_union_value.value, target_path);
        }
        return false;
    }

    Bool inline_asm_uses_loan_target(self, jil.InlineAsmRvalue value, move_path.MovePathId target_path) {
        Int index! = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                if (self.operand_uses_loan_target(input.value, target_path)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool operands_use_loan_target(self, jil.Operand[]& operands, move_path.MovePathId target_path) {
        Int index! = 0;
        while (index < operands.length) {
            if (self.operand_uses_loan_target(operands[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool places_use_loan_target(
        self,
        jil.Place[]& places,
        move_path.MovePathId target_path
    ) {
        Int index! = 0;
        while (index < places.length) {
            if (self.place_uses_loan_target(places[index], target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool optional_operand_uses_loan_target(self, jil.Operand? operand, move_path.MovePathId target_path) {
        if (operand is .some(value)) {
            return self.operand_uses_loan_target(value, target_path);
        }
        return false;
    }

    Bool task_release_uses_loan_target(
        self,
        jil.TaskReleaseStatement release,
        move_path.MovePathId target_path
    ) {
        if (release.task is .some(task)) {
            if (self.place_uses_loan_target(task, target_path)) { return true; }
        }
        if (self.place_uses_loan_target(release.task_pointer, target_path)) {
            return true;
        }
        if (self.place_uses_loan_target(release.frame, target_path)) { return true; }
        if (self.place_uses_loan_target(release.state, target_path)) { return true; }
        return self.place_uses_loan_target(release.result, target_path);
    }

    Bool local_uses_loan_target(
        self,
        jil.LocalId local_id,
        move_path.MovePathId target_path
    ) {
        Int local_index = local_id.to_index();
        if (!self.valid_local_index(local_index)) { return false; }
        move_path.MovePathId root = self.paths.root_for_local(local_id);
        return self.loan_target_matches_path(target_path, root);
    }

    Bool operand_uses_loan_target(self, jil.Operand operand, move_path.MovePathId target_path) {
        guard self.operand_place(operand) is .some(place) else { return false; }
        return self.place_uses_loan_target(place, target_path);
    }

    Bool place_uses_loan_target(self, jil.Place place, move_path.MovePathId target_path) {
        move_path.MovePathId path = self.paths.existing_path_for_place(place);
        if (!self.valid_move_path(path)) { return false; }
        return self.loan_target_matches_path(target_path, path);
    }

    Bool place_write_uses_loan_target(
        self,
        jil.Place place,
        move_path.MovePathId target_path
    ) {
        if (!self.destination_has_deref_projection(place)
            && !self.place_is_indirect_memory(place)) {
            return false;
        }
        return self.place_uses_loan_target(place, target_path);
    }

    Bool place_kills_loan_target(self, jil.Place place, move_path.MovePathId target_path) {
        move_path.MovePathId path = self.paths.existing_path_for_place(place);
        if (!self.valid_move_path(path)) { return false; }
        if (self.path_matches_or_contains(path, target_path)) { return true; }
        return self.move_paths_may_alias(path, target_path);
    }

    () check_call_callee(self, jil.CallCallee callee) {
        if (callee is .indirect_operand(operand)) {
            self.check_operand(operand);
        }
        if (callee is .domain_enqueue(enqueue)) {
            if (enqueue.task is .some(task)) { self.check_operand(task); }
            self.check_operand(enqueue.resume);
        }
        if (callee is .dynamic_domain_enqueue(enqueue)) {
            self.check_operand(enqueue.executor);
            if (enqueue.task is .some(task)) { self.check_operand(task); }
            self.check_operand(enqueue.resume);
        }
    }

    () record_call_lifetime_loans(self, jil.CallTerminator call_term) {
        if (call_term.lifetime_args != null && call_term.return_lifetime_flows != null) {
            self.record_indirect_call_return_loans(call_term);
            self.record_indirect_call_parameter_lifetime_loans(call_term);
            return;
        }
        guard self.callee_function_def(call_term.callee) is .some(callee_def) else {
            self.record_indirect_call_return_loans(call_term);
            self.record_indirect_call_parameter_lifetime_loans(call_term);
            return;
        }
        if (self.callee_is_init(callee_def)) {
            self.record_init_call_return_loans(call_term, callee_def);
            return;
        }
        guard self.call_lifetime_contract(call_term) is .some(contract) else { return; }
        Int index! = 0;
        while (index < contract.flows.length) {
            self.record_call_lifetime_loan_for_flow(call_term, contract.flows[index]);
            index = index + 1;
        }
    }

    types.LifetimeContract? call_lifetime_contract(self, jil.CallTerminator call_term) {
        guard call_term.callee is .direct_function(function_ref) else { return null; }
        types.TypeInfo info = self.ctx.store.types.get(function_ref.type_id);
        guard info.data is .function_type(function_type) else { return null; }
        return function_type.lifetime_contract;
    }

    () record_call_lifetime_loan_for_flow(
        self,
        jil.CallTerminator call_term,
        types.LifetimeFlow flow
    ) {
        if (flow.source.root_kind != .parameter
            && flow.source.root_kind != .callable_result) {
            return;
        }
        if (flow.target.root_kind == .result) {
            if (!self.place_type_may_carry_borrow(self.call_lifetime_destination(call_term))) {
                return;
            }
            self.record_call_result_lifetime_loan(call_term, flow);
            return;
        }
        if (flow.target.root_kind == .parameter) {
            self.record_call_parameter_lifetime_loan(call_term, flow);
        }
    }

    () record_call_result_lifetime_loan(
        self,
        jil.CallTerminator call_term,
        types.LifetimeFlow flow
    ) {
        if (flow.source.root_index < 0
            || flow.source.root_index >= self.call_lifetime_arg_count(call_term)) {
            return;
        }
        jil.Operand source_operand! = call_term.args[flow.source.root_index];
        if (call_term.lifetime_args is .some(args)) {
            source_operand = args[flow.source.root_index];
        }
        guard self.operand_place(source_operand) is .some(source) else { return; }
        move_path.MovePathId source_path! = self.paths.path_for_place(source);
        move_path.MovePathId destination_path! =
            self.paths.path_for_place(self.call_lifetime_destination(call_term));
        if (flow.source.root_kind == .callable_result) {
            self.record_callable_carried_call_loans(
                call_term,
                flow.source.root_index,
                destination_path,
                flow.target.projection_path
            );
            return;
        }
        source_path = self.call_lifetime_parameter_root(
            call_term,
            flow.source.root_index,
            flow.source.projection_path,
            source_path
        );
        source_path = self.project_lifetime_move_path(
            source_path, flow.source.projection_path
        );
        destination_path = self.project_lifetime_move_path(
            destination_path, flow.target.projection_path
        );
        self.record_call_return_loan_from_paths(source, source_path, destination_path);
        self.record_receiver_storage_boundary(
            call_term, flow, source, destination_path
        );
    }

    () record_callable_carried_call_loans(
        self,
        jil.CallTerminator call_term,
        Int source_index,
        move_path.MovePathId destination,
        types.LifetimeProjectionPathId? target_projection
    ) {
        list.ArrayList<move_path.MovePathId> targets! =
            list.ArrayList<move_path.MovePathId>();
        self.append_callable_result_targets(destination, targets$.ref());
        Int target_index = self.callable_result_target_index(
            destination,
            target_projection,
            targets$.ref()
        );
        if (source_index < 0 || source_index >= self.call_lifetime_arg_count(call_term)) {
            return;
        }
        jil.Operand operand! = call_term.args[source_index];
        if (call_term.lifetime_args is .some(args)) { operand = args[source_index]; }
        if (self.operand_place(operand) is .some(place)) {
            self.record_callable_carried_operand_loans(
                self.paths.path_for_place(place),
                targets$.ref(),
                target_index
            );
        }
    }

    Int callable_result_target_index(
        self,
        move_path.MovePathId destination,
        types.LifetimeProjectionPathId? projection,
        list.ArrayList<move_path.MovePathId>& targets
    ) {
        move_path.MovePathId expected =
            self.project_lifetime_move_path(destination, projection);
        Int index! = 0;
        while (index < targets.len()) {
            if (targets.get(index) == expected) { return index; }
            index = index + 1;
        }
        return -1;
    }

    () append_callable_result_targets(
        self,
        move_path.MovePathId root,
        list.ArrayList<move_path.MovePathId>& targets
    ) {
        if (self.type_has_atomic_lifetime(self.move_path_type(root))) {
            targets.add(root);
            return;
        }
        types.TypeInfo root_info = self.ctx.store.types.get(self.move_path_type(root));
        if (root_info.data is .handle_type(handle)
            && types.is_reference_handle(handle)) {
            targets.add(root);
            if (!self.type_may_carry_borrow(handle.element)) { return; }
            self.append_callable_result_targets(self.reference_value_path(root), targets);
            return;
        }
        list.ArrayList<move_path.MovePathId> children! =
            list.ArrayList<move_path.MovePathId>();
        self.paths.append_children(root, children$.ref());
        Int index! = 0;
        while (index < children.len()) {
            move_path.MovePathId child = children.get(index);
            if (self.type_may_carry_borrow(self.move_path_type(child))) {
                self.append_callable_result_targets(child, targets);
            }
            index = index + 1;
        }
        if (!children.empty()) { return; }
        if (self.type_may_carry_borrow(self.move_path_type(root))) {
            targets.add(root);
        }
    }

    () record_callable_carried_operand_loans(
        self,
        move_path.MovePathId root,
        list.ArrayList<move_path.MovePathId>& targets,
        Int requested_index
    ) {
        list.ArrayList<move_path.MovePathId> sources! =
            list.ArrayList<move_path.MovePathId>();
        self.append_callable_carried_source_targets(root, sources$.ref());
        if (sources.len() != targets.len()) { return; }
        Int fact_count = self.dataflow.active_loans.len();
        Int fact_index! = 0;
        while (fact_index < fact_count) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(fact_index);
            fact_index = fact_index + 1;
            Int source_index = self.callable_carried_source_index(
                fact.target,
                sources$.ref()
            );
            if (source_index < 0) { continue; }
            if (requested_index >= 0 && source_index != requested_index) { continue; }
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (!current.carried) { continue; }
            self.add_carried_loan_from_paths_with_domain(
                .reference_view,
                current.source,
                targets.get(source_index),
                current.domain_type
            );
        }
    }

    () append_callable_carried_source_targets(
        self,
        move_path.MovePathId root,
        list.ArrayList<move_path.MovePathId>& targets
    ) {
        types.TypeInfo info = self.ctx.store.types.get(self.move_path_type(root));
        if (info.data is .handle_type(handle) && types.is_reference_handle(handle)) {
            jil.PlaceElem deref =
                jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
            guard self.paths.existing_child_for_projection(root, deref)
                is .some(pointee) else {
                return;
            }
            self.append_callable_result_targets(pointee, targets);
            return;
        }
        self.append_callable_result_targets(root, targets);
    }

    Int callable_carried_source_index(
        self,
        move_path.MovePathId target,
        list.ArrayList<move_path.MovePathId>& sources
    ) {
        Int index! = 0;
        while (index < sources.len()) {
            if (self.loan_target_matches_path(target, sources.get(index))) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    () record_receiver_storage_boundary(
        self,
        jil.CallTerminator call_term,
        types.LifetimeFlow flow,
        jil.Place receiver_place,
        move_path.MovePathId destination_path
    ) {
        if (flow.source.projection_path != null) { return; }
        Int param_index = flow.source.root_index;
        if (!self.call_param_is_reference_receiver(call_term, param_index)) { return; }
        if (!self.valid_move_path(destination_path)) { return; }
        if (!self.borrowed_handle_type(self.move_path_type(destination_path))) { return; }
        move_path.MovePathId receiver_path = self.paths.path_for_place(receiver_place);
        if (!self.valid_move_path(receiver_path)) { return; }
        move_path.MovePathId boundary_path =
            self.immediate_receiver_storage_source(receiver_path);
        if (!self.valid_move_path(boundary_path)) { return; }
        move_path.MovePath receiver = self.paths.get(boundary_path);
        Int local_index = receiver.local_id.to_index();
        if (!self.valid_local_index(local_index)) { return; }
        if (self.body.locals[local_index].kind == .param) { return; }
        self.add_borrow_boundary_fact(
            self.dataflow$.ref(),
            BorrowBoundaryFact(boundary: boundary_path, target: destination_path)
        );
    }

    move_path.MovePathId immediate_receiver_storage_source(
        self,
        move_path.MovePathId receiver_path
    ) {
        guard self.canonical_source_loan(receiver_path) is .some(loan_id) else {
            return receiver_path;
        }
        return self.results.loans.get(loan_id).source;
    }

    () record_call_parameter_lifetime_loan(
        self,
        jil.CallTerminator call_term,
        types.LifetimeFlow flow
    ) {
        Int source_index = flow.source.root_index;
        Int target_index = flow.target.root_index;
        Int arg_count = self.call_lifetime_arg_count(call_term);
        if (source_index < 0 || source_index >= arg_count) { return; }
        if (target_index < 0 || target_index >= arg_count) { return; }
        jil.Operand source_operand! = call_term.args[source_index];
        jil.Operand target_operand! = call_term.args[target_index];
        if (call_term.lifetime_args is .some(args)) {
            source_operand = args[source_index];
            target_operand = args[target_index];
        }
        guard self.operand_place(source_operand) is .some(source) else { return; }
        guard self.operand_place(target_operand) is .some(target) else { return; }
        move_path.MovePathId source_path! = self.paths.path_for_place(source);
        move_path.MovePathId target_path! = self.paths.path_for_place(target);
        source_path = self.call_lifetime_parameter_root(
            call_term, source_index, flow.source.projection_path, source_path
        );
        target_path = self.call_lifetime_parameter_root(
            call_term, target_index, flow.target.projection_path, target_path
        );
        source_path = self.project_lifetime_move_path(
            source_path, flow.source.projection_path
        );
        target_path = self.project_lifetime_move_path(
            target_path, flow.target.projection_path
        );
        self.check_call_parameter_lifetime_coverage(call_term, source_path, target_path);
        self.record_call_return_loan_from_paths(source, source_path, target_path);
    }

    move_path.MovePathId call_lifetime_parameter_root(
        self,
        jil.CallTerminator call_term,
        Int param_index,
        types.LifetimeProjectionPathId? projection_path,
        move_path.MovePathId root
    ) {
        if (projection_path == null) { return root; }
        if (!self.call_lifetime_parameter_projects_pointee(call_term, param_index, root)) {
            return root;
        }
        jil.PlaceElem deref =
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        if (self.paths.existing_child_for_projection(root, deref) is .some(child)) {
            return child;
        }
        return root;
    }

    move_path.MovePathId prebuild_call_lifetime_parameter_root(
        self,
        jil.CallTerminator call_term,
        Int param_index,
        types.LifetimeProjectionPathId? projection_path,
        move_path.MovePathId root
    ) {
        if (projection_path == null) { return root; }
        if (!self.call_lifetime_parameter_projects_pointee(call_term, param_index, root)) {
            return root;
        }
        return self.paths.ensure_child_for_projection(
            root,
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false))
        );
    }

    Bool call_lifetime_parameter_projects_pointee(
        self,
        jil.CallTerminator call_term,
        Int param_index,
        move_path.MovePathId root
    ) {
        return self.call_param_is_reference_receiver(call_term, param_index);
    }

    Bool call_param_is_reference_receiver(
        self,
        jil.CallTerminator call_term,
        Int param_index
    ) {
        if (param_index != 0) { return false; }
        guard self.callee_function_def(call_term.callee) is .some(callee_def) else {
            return false;
        }
        guard self.ctx.store.model.def(callee_def) is .some(model_def) else {
            return false;
        }
        guard model_def.decl.function_signature is .some(signature) else {
            return false;
        }
        return signature.has_receiver && signature.receiver_mode != .move_receiver;
    }

    () check_call_parameter_lifetime_coverage(
        self,
        jil.CallTerminator call_term,
        move_path.MovePathId source_path,
        move_path.MovePathId target_path
    ) {
        move_path.MovePathId source = self.canonical_loan_source(source_path);
        move_path.MovePathId target = self.canonical_loan_source(target_path);
        move_path.MovePath source_info = self.paths.get(source);
        move_path.MovePath target_info = self.paths.get(target);
        if (source_info.local_id == target_info.local_id) { return; }
        if (self.param_index_for_local(source_info.local_id) is .some(source_index)) {
            if (self.function_param_lifetime_covers(
                source_index,
                source,
                target,
                target_info.local_id
            )) {
                return;
            }
            self.results.mark_error();
            self.add_lifetime_constraint_not_satisfied_diagnostic();
            return;
        }
        table.HashTable<Int, Bool> visiting! = table.HashTable<Int, Bool>();
        if (!self.source_dies_before_target_from_successors(
            call_term,
            source_info.local_id,
            target_info.local_id,
            visiting$.ref()
        )) {
            return;
        }
        self.results.mark_error();
        self.add_lifetime_constraint_not_satisfied_diagnostic();
    }

    Bool function_param_lifetime_covers(
        self,
        Int source_index,
        move_path.MovePathId source,
        move_path.MovePathId target,
        jil.LocalId target_local
    ) {
        guard self.param_index_for_local(target_local) is .some(target_index) else {
            return true;
        }
        guard self.param_root_path_by_index(source_index) is .some(source_root) else {
            return false;
        }
        guard self.param_root_path_by_index(target_index) is .some(target_root) else {
            return false;
        }
        types.LifetimePath source_path = types.LifetimePath (
            root_kind: .parameter,
            root_index: source_index,
            position_index: 0,
            projection_path: self.move_path_lifetime_projection(source_root, source)
        );
        types.LifetimePath target_path = types.LifetimePath (
            root_kind: .parameter,
            root_index: target_index,
            position_index: 0,
            projection_path: self.move_path_lifetime_projection(target_root, target)
        );
        guard self.function_lifetime_contract() is .some(contract) else { return false; }
        Int index! = 0;
        while (index < contract.flows.length) {
            types.LifetimeFlow flow = contract.flows[index];
            if (types.lifetime_path_equal(flow.source, source_path)
                && types.lifetime_path_equal(flow.target, target_path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool source_dies_before_target_from_successors(
        self,
        jil.CallTerminator call_term,
        jil.LocalId source_local,
        jil.LocalId target_local,
        table.HashTable<Int, Bool>& visiting
    ) {
        if (self.source_dies_before_target_in_block(
            call_term.target,
            source_local,
            target_local,
            visiting
        )) {
            return true;
        }
        guard call_term.cleanup is .some(cleanup) else { return false; }
        return self.source_dies_before_target_in_block(
            cleanup,
            source_local,
            target_local,
            visiting
        );
    }

    Bool source_dies_before_target_in_block(
        self,
        jil.BlockId block_id,
        jil.LocalId source_local,
        jil.LocalId target_local,
        table.HashTable<Int, Bool>& visiting
    ) {
        Int block_index = block_id.to_index();
        if (!self.valid_block_index(block_index)) { return false; }
        if (visiting.has(block_index)) { return false; }
        visiting.set(block_index, true);
        jil.Block block = self.body.blocks[block_index];
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            jil.Statement statement = block.statements[statement_index];
            if (statement.kind is .storage_dead_stmt(storage_dead)) {
                if (storage_dead.local_id == target_local) {
                    visiting.remove(block_index);
                    return false;
                }
                if (storage_dead.local_id == source_local) {
                    visiting.remove(block_index);
                    return true;
                }
            }
            statement_index = statement_index + 1;
        }
        Int successor_index! = 0;
        while (successor_index < jil.terminator_successor_count(block.terminator)) {
            jil.BlockId successor =
                jil.terminator_successor_at(block.terminator, successor_index);
            if (self.source_dies_before_target_in_block(
                successor,
                source_local,
                target_local,
                visiting
            )) {
                visiting.remove(block_index);
                return true;
            }
            successor_index = successor_index + 1;
        }
        visiting.remove(block_index);
        return false;
    }

    move_path.MovePathId project_lifetime_move_path(
        self,
        move_path.MovePathId root,
        types.LifetimeProjectionPathId? projection_path
    ) {
        guard projection_path is .some(path_id) else { return root; }
        types.LifetimeProjectionPathNode node = self.ctx.store.types.lifetime_projection_path(path_id);
        move_path.MovePathId parent = self.project_lifetime_move_path(root, node.parent);
        return self.existing_lifetime_child(parent, self.lifetime_place_projection(node));
    }

    move_path.MovePathId ensure_lifetime_move_path(
        self,
        move_path.MovePathId root,
        types.LifetimeProjectionPathId? projection_path
    ) {
        guard projection_path is .some(path_id) else { return root; }
        types.LifetimeProjectionPathNode node = self.ctx.store.types.lifetime_projection_path(path_id);
        move_path.MovePathId parent = self.ensure_lifetime_move_path(root, node.parent);
        jil.PlaceElem projection = self.lifetime_place_projection(node);
        return self.paths.ensure_child_for_projection(parent, projection);
    }

    move_path.MovePathId reference_value_path(self, move_path.MovePathId root) {
        jil.PlaceElem deref =
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        return self.existing_lifetime_child(root, deref);
    }

    jil.PlaceElem lifetime_place_projection(self, types.LifetimeProjectionPathNode node) {
        if (node.kind == .reference_value) {
            return jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        }
        if (node.kind == .tuple_index) {
            return jil.constant_index_projection_elem(
                jil.ConstantIndexProjection(offset: node.tuple_index)
            );
        }
        qid.DefId field_def = node.field_def$.some();
        qid.TypeId field_type! = self.ctx.store.types.invalid_type();
        if (self.typeck.def_type(field_def) is .some(type_id)) { field_type = type_id; }
        return jil.field_projection_elem(jil.FieldProjection (
            field_def: field_def,
            field_type: field_type,
            field_index: 0
        ));
    }

    () record_call_return_loan_from_paths(
        self,
        jil.Place source,
        move_path.MovePathId source_path,
        move_path.MovePathId destination_path
    ) {
        self.record_shared_reborrow_freeze(source_path, destination_path);
        if (self.record_active_call_return_loans(source_path, destination_path)) { return; }
        if (self.source_root_param_index(source_path) == null && !self.place_is_user_local(source)) {
            return;
        }
        qid.TypeId destination_type = self.move_path_type(destination_path);
        if (self.reference_handle_type(destination_type)) {
            self.add_loan_from_paths(.reference_view, source_path, destination_path);
            return;
        }
        if (self.type_may_carry_borrow(destination_type)) {
            self.record_whole_source_lifetime_loans(
                source_path,
                destination_path,
                destination_type,
                null
            );
            return;
        }
        self.add_loan_from_paths(.reference_view, source_path, destination_path);
    }

    Bool callee_is_init(self, qid.DefId callee_def) {
        if (!self.ctx.store.defs.has(callee_def)) { return false; }
        return self.ctx.store.defs.get(callee_def).kind == .init_def;
    }

    () record_init_call_return_loans(
        self,
        jil.CallTerminator call_term,
        qid.DefId callee_def
    ) {
        guard call_term.initialized_place is .some(destination) else { return; }
        if (!self.place_type_may_carry_borrow(destination)) { return; }
        Int index! = 0;
        while (index < self.results.init_lifetime_sources.len()) {
            borrow_store.InitLifetimeSource source = self.results.init_lifetime_sources.get(index);
            index = index + 1;
            if (source.function_def != callee_def) { continue; }
            self.record_init_call_return_loan_from_arg_to(
                call_term,
                source.source_param_index,
                destination,
                source.source_projection,
                source.target_projection
            );
        }
    }

    () record_indirect_call_return_loans(self, jil.CallTerminator call_term) {
        if (!self.place_type_may_carry_borrow(self.call_lifetime_destination(call_term))) {
            return;
        }
        guard call_term.return_lifetime_flows is .some(flows) else {
            assert(false);
            return;
        }
        Int index! = 0;
        while (index < flows.length) {
            types.LifetimeFlow flow = flows[index];
            index = index + 1;
            if (flow.source.root_kind != .parameter || flow.target.root_kind != .result) {
                continue;
            }
            self.record_call_result_lifetime_loan(call_term, flow);
        }
        move_path.MovePathId destination =
            self.paths.path_for_place(self.call_lifetime_destination(call_term));
        Int arg_index! = 0;
        while (arg_index < self.call_lifetime_arg_count(call_term)) {
            self.record_callable_carried_call_loans(
                call_term,
                arg_index,
                destination,
                null
            );
            arg_index = arg_index + 1;
        }
    }

    () record_indirect_call_parameter_lifetime_loans(
        self,
        jil.CallTerminator call_term
    ) {
        guard call_term.return_lifetime_flows is .some(flows) else { return; }
        Int index! = 0;
        while (index < flows.length) {
            types.LifetimeFlow flow = flows[index];
            index = index + 1;
            if (flow.source.root_kind != .parameter || flow.target.root_kind != .parameter) {
                continue;
            }
            self.record_call_parameter_lifetime_loan(call_term, flow);
        }
    }

    Int call_lifetime_arg_count(self, jil.CallTerminator call_term) {
        if (call_term.lifetime_args is .some(args)) { return args.length; }
        return call_term.args.length;
    }

    @life(return: call_term)
    jil.Place call_lifetime_destination(self, jil.CallTerminator call_term) {
        if (call_term.lifetime_destination is .some(destination)) { return destination; }
        return call_term.destination;
    }

    () record_call_return_loan_from_operand(
        self,
        jil.Operand operand,
        jil.Place destination,
        Bool allow_untracked_local
    ) {
        guard self.operand_place(operand) is .some(source) else { return; }
        if (!self.place_type_may_carry_borrow(source)) { return; }
        move_path.MovePathId destination_path = self.paths.path_for_place(destination);
        move_path.MovePathId source_path = self.paths.path_for_place(source);
        if (self.record_active_call_return_loans(source_path, destination_path)) { return; }
        if (self.source_root_param_index(source_path) == null
            && (!allow_untracked_local || !self.place_is_user_local(source))) {
            return;
        }
        self.add_loan(.reference_view, source, destination);
    }

    Bool place_is_user_local(self, jil.Place place) {
        guard jil.place_local_id(place) is .some(local_id) else { return false; }
        Int index = local_id.to_index();
        if (!self.valid_local_index(index)) { return false; }
        return self.body.locals[index].kind == .user_local;
    }

    Bool record_active_call_return_loans(
        self,
        move_path.MovePathId source_path,
        move_path.MovePathId destination_path
    ) {
        if (!self.valid_move_path(source_path) || !self.valid_move_path(destination_path)) {
            return false;
        }
        self.record_active_borrow_boundaries(destination_path, source_path);
        Bool recorded! = false;
        Int original_len = self.dataflow.active_loans.len();
        Bool has_precise_targets =
            self.active_loans_have_descendant_target(source_path, original_len);
        Bool has_matching_precise_target = has_precise_targets
            || self.active_loans_have_exact_target(source_path, original_len);
        Int index! = 0;
        while (index < original_len) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, source_path)) { continue; }
            if (has_matching_precise_target
                && fact.target != source_path
                && self.is_descendant_of(source_path, fact.target)) {
                continue;
            }
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (fact.target == source_path && has_precise_targets) { continue; }
            if (fact.target == source_path && self.move_path_has_children(destination_path)) {
                self.record_whole_source_lifetime_loans(
                    current.source,
                    destination_path,
                    self.move_path_type(destination_path),
                    current.domain_type
                );
                recorded = true;
                continue;
            }
            move_path.MovePathId copied_target =
                self.copied_loan_target(source_path, fact.target, destination_path);
            self.add_loan_from_paths_with_domain_kind(
                .reference_view,
                current.source,
                copied_target,
                current.domain_type,
                current.carried
            );
            recorded = true;
        }
        return recorded;
    }

    () record_shared_reborrow_freeze(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination
    ) {
        types.TypeInfo source_info = self.ctx.store.types.get(self.move_path_type(source));
        guard source_info.data is .handle_type(source_handle) else { return; }
        if (!source_info.is_mutable) { return; }
        if (!types.is_reference_handle(source_handle) && !types.is_slice_handle(source_handle)) { return; }
        types.TypeInfo destination_info = self.ctx.store.types.get(self.move_path_type(destination));
        guard destination_info.data is .handle_type(destination_handle) else { return; }
        if (destination_info.is_mutable) { return; }
        if (!types.is_reference_handle(destination_handle) && !types.is_slice_handle(destination_handle)) {
            return;
        }
        self.add_loan_from_paths_with_domain(
            .frozen_reference_view,
            source,
            destination,
            self.effect_domain_binding(self.current_effects)
        );
    }

    Bool active_loans_have_descendant_target(
        self,
        move_path.MovePathId root,
        Int limit
    ) {
        Int index! = 0;
        while (index < limit) {
            move_path.MovePathId target = self.dataflow.active_loans.get(index).target;
            if (target != root && self.is_descendant_of(target, root)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool active_loans_have_exact_target(
        self,
        move_path.MovePathId target,
        Int limit
    ) {
        Int index! = 0;
        while (index < limit) {
            if (self.dataflow.active_loans.get(index).target == target) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () record_whole_source_lifetime_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        qid.TypeId type_id,
        qid.DefId? domain_type
    ) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.record_whole_source_lifetime_loans_inner(
            source, destination, type_id, domain_type, visiting$.ref()
        );
    }

    () record_whole_source_lifetime_loans_inner(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        qid.TypeId type_id,
        qid.DefId? domain_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (!self.type_may_carry_borrow(type_id)) { return; }
        if (self.type_has_atomic_lifetime(type_id)) {
            self.add_loan_from_paths_with_domain(
                .reference_view, source, destination, domain_type
            );
            return;
        }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .tuple_type(tuple_type)) {
            self.record_whole_source_tuple_loans(
                source, destination, tuple_type, domain_type, visiting
            );
            return;
        }
        if (info.data is .optional(optional)) {
            self.record_whole_source_lifetime_loans_inner(
                source, destination, optional.element, domain_type, visiting
            );
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.record_whole_source_handle_loans(
                source, destination, handle, domain_type, visiting
            );
            return;
        }
        if (info.data is .named(named)
            && self.record_whole_source_named_loans(
                source,
                destination,
                named,
                domain_type,
                visiting
            )) {
            return;
        }
        self.add_loan_from_paths_with_domain(
            .reference_view, source, destination, domain_type
        );
    }

    () record_whole_source_tuple_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.TupleType tuple_type,
        qid.DefId? domain_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            jil.PlaceElem projection = jil.constant_index_projection_elem(
                jil.ConstantIndexProjection(offset: index)
            );
            self.record_whole_source_lifetime_loans_inner(
                source,
                self.existing_lifetime_child(destination, projection),
                tuple_type.items[index],
                domain_type,
                visiting
            );
            index = index + 1;
        }
    }

    () record_whole_source_handle_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.HandleType handle,
        qid.DefId? domain_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (types.is_reference_handle(handle)) {
            self.add_loan_from_paths_with_domain(
                .reference_view, source, destination, domain_type
            );
            if (!self.type_may_carry_borrow(handle.element)) { return; }
            move_path.MovePathId source_value! = source;
            if (self.reference_handle_type(self.move_path_type(source))) {
                guard self.existing_reference_value_path(source) is .some(value) else {
                    return;
                }
                source_value = value;
            }
            guard self.existing_reference_value_path(destination)
                is .some(destination_value) else {
                return;
            }
            self.record_whole_source_lifetime_loans_inner(
                source_value,
                destination_value,
                handle.element,
                domain_type,
                visiting
            );
            return;
        }
        if (types.is_owner_pointer_handle(handle)) {
            self.record_whole_source_lifetime_loans_inner(
                source, destination, handle.element, domain_type, visiting
            );
            return;
        }
        if (!types.is_slice_handle(handle)) { return; }
        self.add_loan_from_paths_with_domain(
            .reference_view, source, destination, domain_type
        );
        if (!self.move_path_has_children(destination)) { return; }
        self.record_whole_source_lifetime_loans_inner(
            source, destination, handle.element, domain_type, visiting
        );
    }

    move_path.MovePathId? existing_reference_value_path(
        self,
        move_path.MovePathId root
    ) {
        jil.PlaceElem deref =
            jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        return self.paths.existing_child_for_projection(root, deref);
    }

    Bool record_whole_source_named_loans(
        self,
        move_path.MovePathId source,
        move_path.MovePathId destination,
        types.NamedType named,
        qid.DefId? domain_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.typeck.nominal_region_schema(named.def_id) is .some(schema)) {
            if (schema.params.length > 0) {
                Int index! = 0;
                while (index < schema.bindings.length) {
                    typeck_store.NominalRegionBinding binding = schema.bindings[index];
                    index = index + 1;
                    self.add_loan_from_paths_with_domain(
                        .reference_view,
                        source,
                        self.project_lifetime_move_path(destination, binding.path),
                        domain_type
                    );
                }
                return true;
            }
        }
        if (!self.structural_nominal_def(named.def_id)) { return false; }
        if (self.def_list_contains(visiting, named.def_id)) { return true; }
        guard self.ctx.store.model.def(named.def_id) is .some(owner) else {
            return false;
        }
        visiting.add(named.def_id);
        Int index! = 0;
        while (index < owner.members.len()) {
            qid.DefId field_def = owner.members.get(index);
            index = index + 1;
            if (!self.structural_lifetime_field(field_def)) { continue; }
            qid.TypeId field_type = self.structural_field_type(named, field_def);
            jil.PlaceElem projection = self.structural_field_projection(
                field_def,
                field_type
            );
            self.record_whole_source_lifetime_loans_inner(
                source,
                self.existing_lifetime_child(destination, projection),
                field_type,
                domain_type,
                visiting
            );
        }
        visiting.pop();
        return true;
    }

    qid.DefId? callee_function_def(self, jil.CallCallee callee) {
        guard callee is .direct_function(function_value) else { return null; }
        return jil.function_target_provenance_def(function_value.target);
    }

    () record_call_return_loan_from_arg(self, jil.CallTerminator call_term, Int arg_index) {
        self.record_call_return_loan_from_arg_to(call_term, arg_index, call_term.destination);
    }

    () record_call_return_loan_from_arg_to(
        self,
        jil.CallTerminator call_term,
        Int arg_index,
        jil.Place destination
    ) {
        if (arg_index < 0 || arg_index >= call_term.args.length) { return; }
        self.record_call_return_loan_from_operand(
            call_term.args[arg_index],
            destination,
            true
        );
    }

    () record_init_call_return_loan_from_arg_to(
        self,
        jil.CallTerminator call_term,
        Int arg_index,
        jil.Place destination,
        types.LifetimeProjectionPathId? source_projection,
        types.LifetimeProjectionPathId? target_projection
    ) {
        if (arg_index < 0 || arg_index >= call_term.args.length) { return; }
        guard self.operand_place(call_term.args[arg_index]) is .some(source) else { return; }
        move_path.MovePathId source_path! = self.paths.path_for_place(source);
        move_path.MovePathId destination_path! = self.paths.path_for_place(destination);
        source_path = self.project_lifetime_move_path(
            source_path, source_projection
        );
        destination_path = self.project_lifetime_move_path(
            destination_path, target_projection
        );
        // init 只传播实参已经携带的借用。普通局部拥有值即使写入 self，
        // 也不能把该局部自身伪造为 initialized_place 的借用来源。
        if (self.record_active_call_return_loans(source_path, destination_path)) { return; }
        if (self.source_root_param_index(source_path) == null) { return; }
        self.add_loan_from_paths(.reference_view, source_path, destination_path);
    }

    @life(return: operand)
    jil.Place? operand_place(self, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) {
            return copy_operand.place;
        }
        if (operand is .move_operand(move_operand)) {
            return move_operand.place;
        }
        return null;
    }

    () check_rvalue(self, jil.Rvalue value) {
        if (value is .use_value(use_value)) {
            self.check_operand(use_value.value);
            return;
        }
        if (value is .unary_value(unary_value)) {
            self.check_operand(unary_value.value);
            return;
        }
        if (value is .binary_value(binary_value)) {
            self.check_operand(binary_value.lhs);
            self.check_operand(binary_value.rhs);
            return;
        }
        if (value is .cast_value(cast_value)) {
            self.check_operand(cast_value.value);
            return;
        }
        if (value is .inline_asm_value(inline_asm)) {
            self.check_inline_asm_rvalue(inline_asm);
            return;
        }
        if (value is .borrow_value(borrow_value)) {
            self.check_place_use(borrow_value.place);
            return;
        }
        if (value is .address_of_value(address_of_value)) {
            self.check_place_use(address_of_value.place);
            return;
        }
        if (value is .coroutine_address_value(coroutine_address)) {
            // Internal coroutine ABI addresses may target result storage that has not been
            // initialized yet. Forming the address does not read or move the pointee.
            self.check_place_write(coroutine_address.place);
            return;
        }
        if (value is .executor_enter_value(executor_enter)) {
            return;
        }
        if (value is .atomic_load_value(atomic_load)) {
            self.check_place_use(atomic_load.place);
            return;
        }
        if (value is .atomic_exchange_value(exchange)) {
            self.check_place_use(exchange.place);
            self.check_operand(exchange.desired);
            return;
        }
        if (value is .atomic_compare_exchange_value(compare_exchange)) {
            self.check_place_use(compare_exchange.place);
            self.check_operand(compare_exchange.expected);
            self.check_operand(compare_exchange.desired);
            return;
        }
        if (value is .slice_value(slice_value)) {
            self.check_slice_rvalue(slice_value);
            return;
        }
        if (value is .len_value(len_value)) {
            self.check_place_use(len_value.place);
            return;
        }
        if (value is .discriminant_value(discriminant_value)) {
            self.check_place_use(discriminant_value.place);
            return;
        }
        if (value is .aggregate_value(aggregate_value)) {
            self.check_operands(aggregate_value.fields);
            return;
        }
        if (value is .closure_value(closure_value)) {
            self.check_operands(closure_value.captures);
            self.check_operand(closure_value.vtable);
            return;
        }
        if (value is .optional_value(optional_value)) {
            self.check_operand(optional_value.value);
            return;
        }
        if (value is .error_union_value(error_union_value)) {
            self.check_error_union_rvalue(error_union_value);
        }
    }

    () check_inline_asm_rvalue(self, jil.InlineAsmRvalue value) {
        Int index! = 0;
        while (index < value.operands.length) {
            if (value.operands[index] is .input(input)) {
                self.check_operand(input.value);
            }
            index = index + 1;
        }
    }

    () check_error_union_rvalue(self, jil.ErrorUnionRvalue value) {
        if (value.op == .is_error) {
            self.check_operand_place_use(value.value);
            return;
        }
        self.check_operand(value.value);
    }

    () check_slice_rvalue(self, jil.SliceRvalue value) {
        self.check_place_use(value.base);
        self.check_optional_operand(value.start);
        self.check_optional_operand(value.end);
    }

    () check_optional_operand(self, jil.Operand? operand) {
        if (operand is .some(value)) {
            self.check_operand(value);
        }
    }

    () check_operands(self, jil.Operand[]& operands) {
        Int index! = 0;
        while (index < operands.length) {
            self.check_operand(operands[index]);
            index = index + 1;
        }
    }

    () check_operand(self, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.consume_place(move_operand.place);
        }
    }

    () check_operand_place_use(self, jil.Operand operand) {
        if (operand is .copy_operand(copy_operand)) {
            self.check_place_use(copy_operand.place);
            return;
        }
        if (operand is .move_operand(move_operand)) {
            self.check_place_use(move_operand.place);
        }
    }

    () consume_place(self, jil.Place place) {
        self.check_place_use(place);
        if (self.place_is_indirect_memory(place)) {
            return;
        }
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        self.check_move_place_conflicts(path);
        self.mark_moved(path);
    }

    () check_move_place_conflicts(self, move_path.MovePathId move_path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            if (self.exclusive_place_loan_conflicts(move_path, current, fact.target)) {
                self.results.mark_error();
                self.add_move_borrow_diagnostic();
            }
            index = index + 1;
        }
    }

    // raw pointer / many pointer 指向的是编译器无法静态枚举的外部内存。
    // 读取 `p[i]` 会移动元素值，但不能把保存指针的本地变量 `p` 本身标成 moved。
    Bool place_is_indirect_memory(self, jil.Place place) {
        qid.TypeId base_type! = self.place_base_type(place);
        Int index! = 0;
        while (index < place.projection.length) {
            if (self.projection_enters_untracked_memory(base_type, place.projection[index])) {
                return true;
            }
            base_type = self.projected_type(base_type, place.projection[index]);
            index = index + 1;
        }
        return false;
    }

    Bool projection_enters_untracked_memory(self, qid.TypeId base_type, jil.PlaceElem projection) {
        if (projection is .index_projection || projection is .constant_index_projection) {
            return self.type_is_raw_pointer(base_type);
        }
        if (projection is .deref_projection(deref)) {
            return deref.raw_pointer || self.type_is_raw_pointer(base_type);
        }
        return false;
    }

    Bool type_is_raw_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else {
            return false;
        }
        return handle.kind == .raw_pointer;
    }

    () check_place_use(self, jil.Place place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        if (self.is_path_uninitialized(path)) {
            self.results.mark_error();
            self.add_use_after_move_diagnostic();
        }
        self.check_active_loan_valid(path);
        self.check_borrowed_source_access(path, false);
    }

    () check_place_write(self, jil.Place place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        self.check_borrowed_source_access(path, true);
    }

    () check_borrowed_source_access(self, move_path.MovePathId path, Bool write) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            loan.Loan current = self.results.loans.get(fact.loan_id);
            index = index + 1;
            if (current.kind == .raw_pointer_view || current.kind == .reference_view) { continue; }
            if (!write && current.kind == .frozen_reference_view) { continue; }
            if (self.current_statement_kills_loan_target(fact.target)) { continue; }
            if (self.loan_target_matches_path(fact.target, path)) { continue; }
            if (!self.loan_sources_overlap(path, current.source)) { continue; }
            if (!self.loan_target_used_after_current_location(fact.target)) { continue; }
            self.results.mark_error();
            self.add_mutable_borrow_diagnostic();
        }
    }

    Bool current_statement_kills_loan_target(self, move_path.MovePathId target_path) {
        if (self.current_location.kind != .statement) { return false; }
        return self.statement_kills_loan_target(self.current_statement(), target_path);
    }

    () check_active_loan_valid(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.loan_target_matches_path(fact.target, path) && self.loan_source_is_dead(fact)) {
                self.report_dead_source_loan(fact.loan_id);
            }
            index = index + 1;
        }
        self.check_borrow_boundaries_valid(path);
    }

    () check_borrow_boundaries_valid(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.borrow_boundaries.len()) {
            BorrowBoundaryFact fact = self.dataflow.borrow_boundaries.get(index);
            index = index + 1;
            if (!self.loan_target_matches_path(fact.target, path)) { continue; }
            if (self.move_path_root_is_live(fact.boundary)) { continue; }
            self.report_dead_borrow_boundary(fact.boundary);
        }
    }

    Bool move_path_root_is_live(self, move_path.MovePathId path_id) {
        move_path.MovePath path = self.paths.get(path_id);
        move_path.MovePathId root = self.paths.root_for_local(path.local_id);
        return self.state_has_path(self.dataflow.live_locals, root);
    }

    () report_dead_borrow_boundary(self, move_path.MovePathId boundary) {
        if (self.reported_dead_loan_sources.has(boundary)) { return; }
        self.reported_dead_loan_sources.set(boundary, true);
        self.results.mark_error();
        self.add_borrow_escape_diagnostic();
    }

    Bool check_loan_valid_for_fact(self, loan_facts.ActiveLoanFact fact) {
        if (!self.loan_source_is_dead(fact)) {
            return true;
        }
        self.report_dead_source_loan(fact.loan_id);
        return false;
    }

    () report_dead_source_loan(self, loan.LoanId loan_id) {
        loan.Loan current = self.results.loans.get(loan_id);
        if (self.reported_dead_loan_sources.has(current.source)) {
            return;
        }
        self.reported_dead_loan_sources.set(current.source, true);
        self.results.mark_error();
        self.add_borrow_escape_diagnostic();
    }

    Bool loan_source_is_dead(self, loan_facts.ActiveLoanFact fact) {
        loan.Loan current = self.results.loans.get(fact.loan_id);
        if (self.loan_source_is_live(current)) {
            return false;
        }
        return true;
    }

    Bool loan_source_is_live(self, loan.Loan current) {
        move_path.MovePath source = self.paths.get(current.source);
        move_path.MovePathId root = self.paths.root_for_local(source.local_id);
        return self.state_has_path(self.dataflow.live_locals, root);
    }

    () add_use_after_move_diagnostic(self) {
        if (!self.record_diagnostic(1)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("use_after_move"),
                self.current_source_range(),
                "use of moved value"
            )
        );
    }

    () add_task_result_consumed_diagnostic(self) {
        if (!self.record_diagnostic(10)) { return; }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("task_result_already_consumed"),
                self.current_source_range(),
                "Task result has already been consumed"
            )
        );
    }

    () add_mutable_borrow_diagnostic(self) {
        if (!self.record_diagnostic(5)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("mutable_borrow_conflict"),
                self.current_source_range(),
                "mutable borrow conflicts with a live borrow"
            )
        );
    }

    () add_mutable_reference_requirement_diagnostic(self) {
        if (!self.record_diagnostic(6)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("mutable_reference_requirement_not_declared"),
                self.current_source_range(),
                "call requires mutable access; declare the root parameter as T&!"
            )
        );
    }

    () add_move_borrow_diagnostic(self) {
        if (!self.record_diagnostic(7)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("move_borrow_conflict"),
                self.current_source_range(),
                "move conflicts with a live borrow"
            )
        );
    }

    () add_domain_borrow_diagnostic(self) {
        if (!self.record_diagnostic(9)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("cross_domain_mutable_borrow"),
                self.current_source_range(),
                "mutable borrowed argument cannot cross domain boundary"
            )
        );
    }

    () clear_place(self, jil.Place place) {
        move_path.MovePathId path = self.paths.path_for_place(place);
        if (!self.valid_move_path(path)) { return; }
        self.clear_path_and_descendants(path);
    }

    () add_borrow_escape_diagnostic(self) {
        if (!self.record_diagnostic(2)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("borrowed_value_escape"),
                self.current_source_range(),
                "borrowed value escapes its owner"
            )
        );
    }

    () add_stack_fn_escape_diagnostic(self) {
        if (!self.record_diagnostic(8)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("stack_fn_escape"),
                self.current_source_range(),
                "stack Fn value escapes its stack closure environment"
            )
        );
    }

    () add_return_lifetime_source_not_allowed_diagnostic(self) {
        if (!self.record_diagnostic(4)) {
            return;
        }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("return_lifetime_source_not_allowed"),
                self.current_source_range(),
                "returned borrow source is not allowed by lifetime annotations"
            )
        );
    }

    () add_lifetime_constraint_not_satisfied_diagnostic(self) {
        if (!self.record_diagnostic(9)) { return; }
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("lifetime_constraint_not_satisfied"),
                self.current_source_range(),
                "call arguments do not satisfy the declared lifetime constraint"
            )
        );
    }

    // JIL 只保存 byte span，不重复保存 source_id。borrow check 诊断用当前
    // 函数 DefId 的 SourceMap 记录补回 source_id，再取当前 statement/terminator span。
    diagnostic.SourceRange current_source_range(self) {
        guard self.ctx.store.source_map.def_span(self.function_def) is .some(function_loc) else {
            return diagnostic.SourceRange();
        }
        guard function_loc.source_id is .some(source_id) else {
            return diagnostic.SourceRange();
        }
        return diagnostic.SourceRange(source_id, self.current_span());
    }

    diagnostic.DiagnosticSeverity current_diagnostic_severity(self) {
        diagnostic.SourceRange range = self.current_source_range();
        guard range.source_id is .some(source_id) else { return .error; }
        UInt8[]& source_name = self.ctx.store.sources.get(source_id).key.value;
        return self.results.diagnostic_severity(source_name);
    }

    token.Span current_span(self) {
        if (self.current_location.kind == .terminator) {
            return self.current_block().terminator.span;
        }
        return self.current_statement().span;
    }

    jil.Block current_block(self) {
        return self.body.blocks[self.current_location.block_id.to_index()];
    }

    jil.Statement current_statement(self) {
        return self.current_block().statements[self.current_location.statement_index];
    }

    Bool record_diagnostic(self, Int code) {
        BorrowDiagnosticKey key = BorrowDiagnosticKey(self.current_location, code);
        if (self.reported_diagnostics.has(key)) {
            return false;
        }
        self.reported_diagnostics.set(key, true);
        return true;
    }

    Bool has_active_loan_for_path(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.loan_target_matches_path(fact.target, path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    // 只返回匹配 path 的第一个 loan，用于追踪代表性来源。
    // 完整校验必须遍历 active_loans facts。
    loan.LoanId? first_active_loan_for_path(self, move_path.MovePathId path) {
        if (self.first_active_loan_for_exact_path(path) is .some(loan_id)) {
            return loan_id;
        }
        if (self.first_active_loan_for_ancestor(path) is .some(loan_id)) {
            return loan_id;
        }
        return self.first_active_loan_for_descendant(path);
    }

    loan.LoanId? first_active_loan_for_exact_path(self, move_path.MovePathId path) {
        return self.dataflow.active_loans.first_exact(path);
    }

    loan.LoanId? first_active_loan_for_ancestor(self, move_path.MovePathId path) {
        move_path.MovePath current! = self.paths.get(path);
        while (current.has_parent) {
            if (self.first_active_loan_for_exact_path(current.parent) is .some(loan_id)) {
                return loan_id;
            }
            current = self.paths.get(current.parent);
        }
        return null;
    }

    loan.LoanId? first_active_loan_for_descendant(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.is_descendant_of(fact.target, path)) {
                return fact.loan_id;
            }
            index = index + 1;
        }
        return null;
    }

    () mark_moved(self, move_path.MovePathId path) {
        self.clear_descendants(path);
        self.state_set_path(self.dataflow.moved, path);
    }

    Bool is_path_uninitialized(self, move_path.MovePathId path) {
        if (self.state_has_path(self.dataflow.moved, path)) {
            return true;
        }
        if (self.has_moved_ancestor(path)) {
            return true;
        }
        return self.has_moved_descendant(path);
    }

    Bool has_moved_ancestor(self, move_path.MovePathId path) {
        move_path.MovePath current! = self.paths.get(path);
        while (current.has_parent) {
            if (self.state_has_path(self.dataflow.moved, current.parent)) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    Bool has_moved_descendant(self, move_path.MovePathId path) {
        list.ArrayList<move_path.MovePathId> pending! = list.ArrayList<move_path.MovePathId>();
        self.paths.append_children(path, pending$.ref());
        while (!pending.empty()) {
            move_path.MovePathId candidate = pending.pop();
            if (self.state_has_path(self.dataflow.moved, candidate)) { return true; }
            self.paths.append_children(candidate, pending$.ref());
        }
        return false;
    }

    Bool is_descendant_of(self, move_path.MovePathId child, move_path.MovePathId parent) {
        move_path.MovePath parent_path = self.paths.get(parent);
        if (!parent_path.has_parent) {
            return child != parent && self.paths.get(child).local_id == parent_path.local_id;
        }
        move_path.MovePath current! = self.paths.get(child);
        while (current.has_parent) {
            if (current.parent == parent) {
                return true;
            }
            current = self.paths.get(current.parent);
        }
        return false;
    }

    () clear_path_and_descendants(self, move_path.MovePathId path) {
        self.state_clear_path(self.dataflow.moved, path);
        self.clear_consumed_tasks_under(path);
        self.remove_active_loan_facts_under(path);
        self.remove_borrow_boundaries_under(path);
        self.clear_descendants(path);
    }

    () clear_consumed_tasks_under(self, move_path.MovePathId path) {
        if (!self.has_consumed_task_under(path)) { return; }
        list.ArrayList<TaskConsumeFact> kept! = list.ArrayList<TaskConsumeFact>();
        Int index! = 0;
        while (index < self.dataflow.consumed_tasks.len()) {
            TaskConsumeFact fact = self.dataflow.consumed_tasks.get(index);
            if (!self.path_matches_or_contains(path, fact.path)) {
                kept.add(fact);
            }
            index = index + 1;
        }
        self.dataflow.consumed_tasks = kept;
    }

    Bool has_consumed_task_under(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.consumed_tasks.len()) {
            if (self.path_matches_or_contains(path, self.dataflow.consumed_tasks.get(index).path)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () clear_descendants(self, move_path.MovePathId path) {
        list.ArrayList<move_path.MovePathId> pending! = list.ArrayList<move_path.MovePathId>();
        self.paths.append_children(path, pending$.ref());
        while (!pending.empty()) {
            move_path.MovePathId candidate = pending.pop();
            self.state_clear_path(self.dataflow.moved, candidate);
            self.paths.append_children(candidate, pending$.ref());
        }
    }

    () remove_active_loan_facts_under(self, move_path.MovePathId path) {
        if (!self.has_active_loan_fact_under(path)) { return; }
        loan_facts.ActiveLoanFacts kept! = loan_facts.ActiveLoanFacts(self.dataflow.active_loans.len());
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (!self.active_loan_target_under_path(fact, path)) {
                kept.add(fact);
            }
            index = index + 1;
        }
        self.dataflow.active_loans = kept;
    }

    () remove_borrow_boundaries_under(self, move_path.MovePathId path) {
        list.ArrayList<BorrowBoundaryFact> kept! =
            list.ArrayList<BorrowBoundaryFact>();
        Int index! = 0;
        while (index < self.dataflow.borrow_boundaries.len()) {
            BorrowBoundaryFact fact = self.dataflow.borrow_boundaries.get(index);
            if (!self.path_matches_or_contains(path, fact.target)) {
                kept.add(fact);
            }
            index = index + 1;
        }
        self.dataflow.borrow_boundaries = kept;
    }

    Bool has_active_loan_fact_under(self, move_path.MovePathId path) {
        Int index! = 0;
        while (index < self.dataflow.active_loans.len()) {
            loan_facts.ActiveLoanFact fact = self.dataflow.active_loans.get(index);
            if (self.active_loan_target_under_path(fact, path)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool active_loan_target_under_path(self, loan_facts.ActiveLoanFact fact, move_path.MovePathId path) {
        return self.path_matches_or_contains(path, fact.target);
    }

    Bool path_matches_or_contains(self, move_path.MovePathId parent, move_path.MovePathId candidate) {
        if (parent == candidate) { return true; }
        return self.is_descendant_of(candidate, parent);
    }

    Bool is_implicit_copy_place(self, jil.Place place) {
        return self.is_implicit_copy_type(self.place_type(place));
    }

    qid.TypeId place_type(self, jil.Place place) {
        qid.TypeId type_id! = self.place_base_type(place);
        Int index! = 0;
        while (index < place.projection.length) {
            type_id = self.projected_type(type_id, place.projection[index]);
            index = index + 1;
        }
        return type_id;
    }

    Bool same_local_base(self, jil.Place lhs, jil.Place rhs) {
        guard jil.place_local_id(lhs) is .some(left) else { return false; }
        guard jil.place_local_id(rhs) is .some(right) else { return false; }
        return left.to_index() == right.to_index();
    }

    Bool valid_move_path(self, move_path.MovePathId path) {
        return path.to_index() >= 0 && self.paths.valid_path_id(path);
    }

    qid.TypeId place_base_type(self, jil.Place place) {
        if (place.base is .global(global_ref)) {
            return global_ref.type_id;
        }
        return self.local_type(place.local_id);
    }

    qid.TypeId local_type(self, jil.LocalId local_id) {
        Int index = local_id.to_index();
        if (index >= 0 && index < self.body.locals.length) {
            return self.body.locals[index].type_id;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId projected_type(self, qid.TypeId base_type, jil.PlaceElem projection) {
        if (projection is .field_projection(field)) {
            return field.field_type;
        }
        if (projection is .deref_projection) {
            types.TypeInfo base_info = self.ctx.store.types.get(base_type);
            guard base_info.data is .handle_type(handle) else {
                return self.ctx.store.types.invalid_type();
            }
            return handle.element;
        }
        if (projection is .index_projection) {
            return self.indexed_type(base_type);
        }
        if (projection is .constant_index_projection(constant_index)) {
            return self.constant_indexed_type(base_type, constant_index.offset);
        }
        if (projection is .subslice_projection) {
            return base_type;
        }
        return self.ctx.store.types.invalid_type();
    }

    qid.TypeId indexed_type(self, qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            return handle.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .tuple_type(tuple_type)) {
            if (tuple_type.items.length > 0) {
                return tuple_type.items[0];
            }
        }
        return base_type;
    }

    qid.TypeId constant_indexed_type(self, qid.TypeId base_type, Int offset) {
        if (self.report_generic_param_layout_base(base_type)) {
            return self.ctx.store.types.invalid_type();
        }
        layout.LayoutId layout_id = layout_compute.layout_of_type(self.ctx, base_type);
        layout.TypeLayout type_layout = self.ctx.store.layouts.layout(layout_id);
        if (offset >= 0 && offset < type_layout.fields.length) {
            return type_layout.fields[offset].field_type;
        }
        return self.indexed_type(base_type);
    }

    Bool report_generic_param_layout_base(self, qid.TypeId base_type) {
        types.TypeInfo info = self.ctx.store.types.get(base_type);
        guard info.data is .named(named) else { return false; }
        if (self.ctx.store.defs.get(named.def_id).kind != .generic_param_def) {
            return false;
        }
        self.results.mark_error();
        qid.SymbolId symbol = self.ctx.store.defs.get(named.def_id).name.symbol;
        self.ctx.store.diagnostics.add(
            diagnostic.Diagnostic(
                self.current_diagnostic_severity(),
                .borrow_check,
                diagnostic.DiagnosticCode("borrow_generic_param_layout_base"),
                self.current_source_range(),
                self.ctx.store.symbols.text(symbol)
            )
        );
        return true;
    }

    Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.ctx.store$.ref());
        return query.is_implicit_copy_type(type_id);
    }
}
