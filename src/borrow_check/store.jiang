// Borrow check 的输出表。
//
// 第一版结果只记录阶段是否成功。具体 move paths、loans 和 dataflow
// facts 会随着 P1/P2 增量加入这里，而不是写回 MIR 或 TypeCheckStore。

import table = "../support/table.jiang";
import list = "../support/list.jiang";
import loan = "./loan.jiang";
import mir = "../mir/mir.jiang";
import move_path = "./move_path.jiang";
import qid = "../store/id.jiang";

public struct InitLifetimeSource: Copyable {
    public qid.DefId function_def;
    public qid.SymbolId source_symbol;
}

public struct BorrowCheckStore: Movable {
    public Bool ok!;
    public table.ArrayTable<loan.LoanId, loan.Loan> loans!;
    public table.HashTable<qid.DefId, qid.SymbolId> inferred_return_lifetime_sources!;
    public list.ArrayList<InitLifetimeSource> init_lifetime_sources!;
    public table.HashTable<qid.DefId, Bool> return_lifetime_analyzed!;

    public init(self, Bool ok) {
        self.ok = ok;
        self.loans = table.ArrayTable<loan.LoanId, loan.Loan>();
        self.inferred_return_lifetime_sources = table.HashTable<qid.DefId, qid.SymbolId>();
        self.init_lifetime_sources = list.ArrayList<InitLifetimeSource>();
        self.return_lifetime_analyzed = table.HashTable<qid.DefId, Bool>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public loan.LoanId add_loan(self,
        loan.LoanKind kind,
        mir.MirFunctionId function_id,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type
    ) {
        loan.LoanId id = self.loans.next_id();
        self.loans.append(loan.Loan(id, function_id, kind, source, target, domain_type));
        return id;
    }

    public () infer_return_lifetime_source(self, qid.DefId function_def, qid.SymbolId source_symbol) {
        self.inferred_return_lifetime_sources.set(function_def, source_symbol);
    }

    public qid.SymbolId? inferred_return_lifetime_source(self, qid.DefId function_def) {
        return table.hash_table_get_value<qid.DefId, qid.SymbolId>(
            self.inferred_return_lifetime_sources$.ref(),
            function_def
        );
    }

    public () infer_init_lifetime_source(self, qid.DefId function_def, qid.SymbolId source_symbol) {
        Int index! = 0;
        while (index < self.init_lifetime_sources.len()) {
            InitLifetimeSource source = self.init_lifetime_sources.get(index);
            if (source.function_def == function_def && source.source_symbol == source_symbol) {
                return;
            }
            index = index + 1;
        }
        self.init_lifetime_sources.add(InitLifetimeSource(
            function_def: function_def,
            source_symbol: source_symbol
        ));
    }

    public () mark_return_lifetime_analyzed(self, qid.DefId function_def) {
        self.return_lifetime_analyzed.set(function_def, true);
    }

    public Bool has_analyzed_return_lifetime(self, qid.DefId function_def) {
        return self.return_lifetime_analyzed.has(function_def);
    }
}
