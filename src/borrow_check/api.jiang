// Borrow check 阶段入口。
//
// borrow_check 消费已经 lower 完成的 MIR、type check side table 和
// layout cache。这里不重新 resolve/type check，也不从 MIR 推导 layout。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import layout = "../layout/layout.jiang";
import mir = "../mir/mir.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import checker = "./checker.jiang";
import borrow_store = "./store.jiang";

public Bool run_package(context.CompilerContext& ctx, mir.MirStore& mir_store) {
    borrow_store.BorrowCheckStore^ results = check_package(ctx, mir_store);
    return results.ok;
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    mir.MirStore& mir_store
) {
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    layout.LayoutStore& layouts = ctx.store.layouts$.ref();
    return check_package(ctx, mir_store, typeck, layouts);
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    mir.MirStore& mir_store,
    typeck_store.TypeCheckStore& typeck,
    layout.LayoutStore& layouts
) {
    // BorrowCheckStore 后续会保存 loans/dataflow facts，按指针返回避免
    // 阶段边界复制大表，也避开当前 stage1 对含表结构体返回值的复制问题。
    borrow_store.BorrowCheckStore^ results = new borrow_store.BorrowCheckStore(
        mir_store.ok && typeck.ok && layouts.ok
    );
    if (!results.has_errors()) {
        checker.PackageBorrowChecker! package_checker = checker.PackageBorrowChecker(
            ctx,
            typeck,
            layouts,
            results$.ref()
        );
        package_checker.check_store(mir_store);
    }
    if (results.has_errors()) {
        diagnostic_helper.add_package_error(ctx, "borrow check failed", "borrow_check_failed");
    }
    return results$.move();
}
