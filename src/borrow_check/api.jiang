// Borrow check 阶段入口。
//
// borrow_check 消费已经 lower 完成的 MIR、type check side table 和
// layout cache。这里不重新 resolve/type check，也不从 MIR 推导 layout。

import context = "../context.jiang";
import layout = "../layout/layout.jiang";
import mir = "../mir/mir.jiang";
import sema_result = "../sema/result.jiang";
import checker = "./checker.jiang";
import result = "./result.jiang";

public result.BorrowCheckResults^ check_package(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    sema_result.TypeCheckResults& typeck,
    layout.LayoutStore& layouts
) {
    // BorrowCheckResults 后续会保存 loans/dataflow facts，按指针返回避免
    // 阶段边界复制大表，也避开当前 stage1 对含表结构体返回值的复制问题。
    result.BorrowCheckResults^ results = new result.BorrowCheckResults(
        store.ok && typeck.ok && layouts.ok
    );
    if (!results.has_errors()) {
        checker.PackageBorrowChecker! package_checker = checker.PackageBorrowChecker(
            ctx,
            typeck,
            layouts,
            results$.ref()
        );
        package_checker.check_store(store);
    }
    return results$.move();
}
