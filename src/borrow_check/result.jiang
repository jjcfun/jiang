// Borrow check 的输出表。
//
// 第一版结果只记录阶段是否成功。具体 move paths、loans 和 dataflow
// facts 会随着 P1/P2 增量加入这里，而不是写回 MIR 或 TypeCheckResults。

import table = "../support/table.jiang";
import loan = "./loan.jiang";
import mir = "../mir/mir.jiang";
import move_path = "./move_path.jiang";

public struct BorrowCheckResults: Movable {
    public Bool! ok;
    public table.ArrayTable<loan.LoanId, loan.Loan>! loans;

    public init(Bool ok) {
        self.ok = ok;
        self.loans = table.ArrayTable<loan.LoanId, loan.Loan>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public loan.LoanId add_loan(
        loan.LoanKind kind,
        mir.MirFunctionId function_id,
        move_path.MovePathId source,
        move_path.MovePathId target
    ) {
        loan.LoanId id = self.loans.next_id();
        self.loans.append(loan.Loan(id, function_id, kind, source, target));
        return id;
    }
}
