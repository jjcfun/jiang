// Move path tree。
//
// Move path 把 JIL place 拆成一棵树：local 是根，field/index/deref
// projection 是子节点。后续 use-after-move dataflow 只处理 MovePathId，
// 不直接比较完整 Place。

import jil = "../jil.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";

public struct MovePathId: Copyable, traits.Indexable, Hashable, Equatable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public MovePathId from_index(Int index) {
        return MovePathId(index);
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.index));
    }

    public Bool equal(MovePathId& lhs, MovePathId& rhs) {
        return lhs.index == rhs.index;
    }
}

public struct MovePath: Copyable {
    public MovePathId id;
    public MovePathId parent;
    public Bool has_parent;
    public jil.LocalId local_id;

    // has_projection=false 表示 local root；true 表示 parent place 后追加的一段 projection。
    public jil.PlaceElem projection;
    public Bool has_projection;

    public init(self, MovePathId id, jil.LocalId local_id) {
        self.id = id;
        self.parent = MovePathId.from_index(0);
        self.has_parent = false;
        self.local_id = local_id;
        self.projection = jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        self.has_projection = false;
    }

    public init(self, MovePathId id, MovePathId parent, jil.LocalId local_id, jil.PlaceElem projection) {
        self.id = id;
        self.parent = parent;
        self.has_parent = true;
        self.local_id = local_id;
        self.projection = projection;
        self.has_projection = true;
    }
}

public struct MovePathTree: Movable {
    public table.ArrayTable<MovePathId, MovePath> paths!;
    table.SideTable<jil.LocalId, MovePathId> local_roots!;
    table.MultiTable<MovePathId, MovePathId> children!;
    Bool frozen!;

    public init(self) {
        self.paths = table.ArrayTable<MovePathId, MovePath>();
        self.local_roots = table.SideTable<jil.LocalId, MovePathId>();
        self.children = table.MultiTable<MovePathId, MovePathId>();
        self.frozen = false;
    }

    public Int len(self) {
        return self.paths.len();
    }

    public MovePath get(self, MovePathId id) {
        return self.paths.get(id);
    }

    public Bool valid_path_id(self, MovePathId id) {
        Int index = id.to_index();
        return index >= 0 && index < self.paths.len();
    }

    public Void freeze(Self&! self) {
        self.frozen = true;
    }

    public MovePathId root_for_local(self, jil.LocalId local_id) {
        if (self.local_roots.has(local_id)) { return self.local_roots.get(local_id); }
        return MovePathId.from_index(-1);
    }

    public MovePathId ensure_root_for_local(Self&! self, jil.LocalId local_id) {
        MovePathId current = self.root_for_local(local_id);
        if (self.valid_path_id(current)) { return current; }
        assert(!self.frozen);
        MovePathId id = self.paths.next_id();
        table.ArrayTable<MovePathId, MovePath>&! paths = self.paths$.mut_ref();
        paths.append(MovePath(id, local_id));
        table.SideTable<jil.LocalId, MovePathId>&! local_roots = self.local_roots$.mut_ref();
        local_roots.set(local_id, id);
        return id;
    }

    public MovePathId path_for_place(self, jil.Place place) {
        return self.existing_path_for_place(place);
    }

    public MovePathId ensure_path_for_place(Self&! self, jil.Place place) {
        guard jil.place_local_id(place) is .some(local_id) else {
            return MovePathId.from_index(-1);
        }
        MovePathId current! = self.ensure_root_for_local(local_id);
        Int index! = 0;
        while (index < place.projection.length) {
            current = self.ensure_child_for_projection_for_local(
                current,
                local_id,
                place.projection[index]
            );
            index = index + 1;
        }
        return current;
    }

    public MovePathId existing_path_for_place(self, jil.Place place) {
        guard jil.place_local_id(place) is .some(local_id) else {
            return MovePathId.from_index(-1);
        }
        if (!self.local_roots.has(local_id)) { return MovePathId.from_index(-1); }
        MovePathId current! = self.local_roots.get(local_id);
        Int index! = 0;
        while (index < place.projection.length) {
            guard self.existing_child_for_projection(
                current, place.projection[index]
            ) is .some(child) else {
                return MovePathId.from_index(-1);
            }
            current = child;
            index = index + 1;
        }
        return current;
    }

    public MovePathId child_for_projection(self, MovePathId parent, jil.PlaceElem projection) {
        guard self.existing_child_for_projection(parent, projection) is .some(child) else {
            return MovePathId.from_index(-1);
        }
        return child;
    }

    public MovePathId ensure_child_for_projection(
        Self&! self,
        MovePathId parent,
        jil.PlaceElem projection
    ) {
        MovePath parent_path = self.paths.get(parent);
        return self.ensure_child_for_projection_for_local(
            parent,
            parent_path.local_id,
            projection
        );
    }

    public MovePathId? existing_child_for_projection(
        self,
        MovePathId parent,
        jil.PlaceElem projection
    ) {
        table.MultiTableCursor cursor! = self.children.first(parent);
        while (cursor.valid()) {
            MovePathId child_id = self.children.get(cursor);
            cursor = self.children.next(cursor);
            if (!self.valid_path_id(child_id)) { continue; }
            MovePath child = self.paths.get(child_id);
            if (child.has_projection && place_elem_equal(child.projection, projection)) {
                return child.id;
            }
        }
        return null;
    }

    public Void append_children(
        self,
        MovePathId parent,
        list.ArrayList<MovePathId>&! output
    ) {
        table.MultiTableCursor cursor! = self.children.first(parent);
        while (cursor.valid()) {
            MovePathId child = self.children.get(cursor);
            if (self.valid_path_id(child)) { output.add(child); }
            cursor = self.children.next(cursor);
        }
    }

    MovePathId ensure_child_for_projection_for_local(Self&! self,
        MovePathId parent,
        jil.LocalId local_id,
        jil.PlaceElem projection
    ) {
        if (self.existing_child_for_projection(parent, projection) is .some(child)) {
            return child;
        }

        assert(!self.frozen);
        MovePathId id = self.paths.next_id();
        table.ArrayTable<MovePathId, MovePath>&! paths = self.paths$.mut_ref();
        paths.append(MovePath(id, parent, local_id, projection));
        table.MultiTable<MovePathId, MovePathId>&! children = self.children$.mut_ref();
        children.add(parent, id);
        return id;
    }
}

public MovePathTree build_move_path_tree(jil.Body& body) {
    MovePathTree tree! = MovePathTree();
    Int local_index! = 0;
    while (local_index < body.locals.length) {
        tree.ensure_root_for_local(body.locals[local_index].id);
        local_index = local_index + 1;
    }

    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        add_block_places(tree$.mut_ref(), body.blocks[block_index]$.ref());
        block_index = block_index + 1;
    }
    return tree;
}

Void add_block_places(MovePathTree&! tree, jil.Block& block) {
    Int stmt_index! = 0;
    while (stmt_index < block.statements.length) {
        add_statement_places(tree, block.statements[stmt_index]);
        stmt_index = stmt_index + 1;
    }
    add_terminator_places(tree, block.terminator);
}

Void add_statement_places(MovePathTree&! tree, jil.Statement statement) {
    if (statement.kind is .assign_stmt(assign_stmt)) {
        tree.ensure_path_for_place(assign_stmt.destination);
        add_rvalue_places(tree, assign_stmt.value);
        return;
    }
    if (statement.kind is .atomic_store_stmt(atomic_store)) {
        tree.ensure_path_for_place(atomic_store.destination);
        add_operand_places(tree, atomic_store.value);
        return;
    }
    if (statement.kind is .executor_leave_stmt(executor_leave)) {
        return;
    }
    if (statement.kind is .task_suspend_stmt(suspend)) {
        tree.ensure_path_for_place(suspend.task);
        return;
    }
    if (statement.kind is .task_complete_stmt(complete)) {
        tree.ensure_path_for_place(complete.task);
        return;
    }
    if (statement.kind is .task_owner_release_stmt(release)) {
        tree.ensure_path_for_place(release.pointer);
        return;
    }
    if (statement.kind is .task_release_stmt(release)) {
        if (release.task is .some(task)) { tree.ensure_path_for_place(task); }
        tree.ensure_path_for_place(release.task_pointer);
        tree.ensure_path_for_place(release.frame);
        tree.ensure_path_for_place(release.state);
        tree.ensure_path_for_place(release.result);
        return;
    }
    if (statement.kind is .task_consume_stmt(consume)) {
        tree.ensure_path_for_place(consume.task);
        return;
    }
    if (statement.kind is .capture_bind_stmt(bind)) {
        tree.ensure_path_for_place(bind.destination);
        tree.ensure_path_for_place(bind.environment);
        return;
    }
    if (statement.kind is .set_discriminant_stmt(discriminant_stmt)) {
        tree.ensure_path_for_place(discriminant_stmt.destination);
        return;
    }
    if (statement.kind is .forget_stmt(forget_stmt)) {
        tree.ensure_path_for_place(forget_stmt.place);
        return;
    }
    if (statement.kind is .exclusive_stmt(exclusive_stmt)) {
        tree.ensure_path_for_place(exclusive_stmt.place);
    }
}

Void add_terminator_places(MovePathTree&! tree, jil.Terminator terminator) {
    if (terminator.kind is .goto_term(goto_term)) {
        if (goto_term.initialized_place is .some(initialized_place)) {
            tree.ensure_path_for_place(initialized_place);
        }
        return;
    }
    if (terminator.kind is .branch_term(branch)) {
        add_operand_places(tree, branch.condition);
        return;
    }
    if (terminator.kind is .switch_term(switch_term)) {
        add_operand_places(tree, switch_term.discriminator);
        return;
    }
    if (terminator.kind is .call_term(call_term)) {
        add_call_places(tree, call_term);
        return;
    }
    if (terminator.kind is .drop_term(drop_term)) {
        tree.ensure_path_for_place(drop_term.place);
        return;
    }
    if (terminator.kind is .assert_term(assert_term)) {
        add_operand_places(tree, assert_term.condition);
        return;
    }
    if (terminator.kind is .throw_term(throw_term)) {
        add_operand_places(tree, throw_term.error_value);
    }
}

Void add_call_places(MovePathTree&! tree, jil.CallTerminator call_term) {
    add_call_callee_places(tree, call_term.callee);
    Int index! = 0;
    while (index < call_term.args.length) {
        add_operand_places(tree, call_term.args[index]);
        index = index + 1;
    }
    tree.ensure_path_for_place(call_term.destination);
    if (call_term.lifetime_args is .some(lifetime_args)) {
        add_operand_array_places(tree, lifetime_args);
    }
    if (call_term.lifetime_destination is .some(lifetime_destination)) {
        tree.ensure_path_for_place(lifetime_destination);
    }
    if (call_term.initialized_place is .some(initialized_place)) {
        tree.ensure_path_for_place(initialized_place);
    }
    Int exclusive_index! = 0;
    while (exclusive_index < call_term.exclusive_places.length) {
        tree.ensure_path_for_place(call_term.exclusive_places[exclusive_index]);
        exclusive_index = exclusive_index + 1;
    }
}

Void add_call_callee_places(MovePathTree&! tree, jil.CallCallee callee) {
    if (callee is .indirect_operand(operand)) {
        add_operand_places(tree, operand);
    }
    if (callee is .domain_enqueue(enqueue)) {
        if (enqueue.task is .some(task)) { add_operand_places(tree, task); }
        add_operand_places(tree, enqueue.resume);
    }
    if (callee is .dynamic_domain_enqueue(enqueue)) {
        add_operand_places(tree, enqueue.executor);
        if (enqueue.task is .some(task)) { add_operand_places(tree, task); }
        add_operand_places(tree, enqueue.resume);
    }
}

Void add_rvalue_places(MovePathTree&! tree, jil.Rvalue value) {
    if (value is .use_value(use_value)) {
        add_operand_places(tree, use_value.value);
        return;
    }
    if (value is .unary_value(unary_value)) {
        add_operand_places(tree, unary_value.value);
        return;
    }
    if (value is .binary_value(binary_value)) {
        add_operand_places(tree, binary_value.lhs);
        add_operand_places(tree, binary_value.rhs);
        return;
    }
    if (value is .cast_value(cast_value)) {
        add_operand_places(tree, cast_value.value);
        return;
    }
    if (value is .inline_asm_value(inline_asm)) {
        add_inline_asm_operand_places(tree, inline_asm);
        return;
    }
    if (value is .borrow_value(borrow_value)) {
        tree.ensure_path_for_place(borrow_value.place);
        return;
    }
    if (value is .address_of_value(address_of_value)) {
        tree.ensure_path_for_place(address_of_value.place);
        return;
    }
    if (value is .coroutine_address_value(coroutine_address)) {
        tree.ensure_path_for_place(coroutine_address.place);
        return;
    }
    if (value is .executor_enter_value(executor_enter)) {
        return;
    }
    if (value is .atomic_load_value(atomic_load)) {
        tree.ensure_path_for_place(atomic_load.place);
        return;
    }
    if (value is .atomic_exchange_value(exchange)) {
        tree.ensure_path_for_place(exchange.place);
        add_operand_places(tree, exchange.desired);
        return;
    }
    if (value is .atomic_compare_exchange_value(compare_exchange)) {
        tree.ensure_path_for_place(compare_exchange.place);
        add_operand_places(tree, compare_exchange.expected);
        add_operand_places(tree, compare_exchange.desired);
        return;
    }
    if (value is .slice_value(slice_value)) {
        tree.ensure_path_for_place(slice_value.base);
        add_optional_operand_places(tree, slice_value.start);
        add_optional_operand_places(tree, slice_value.end);
        return;
    }
    if (value is .len_value(len_value)) {
        tree.ensure_path_for_place(len_value.place);
        return;
    }
    if (value is .discriminant_value(discriminant_value)) {
        tree.ensure_path_for_place(discriminant_value.place);
        return;
    }
    if (value is .aggregate_value(aggregate_value)) {
        add_operand_array_places(tree, aggregate_value.fields);
        return;
    }
    if (value is .closure_value(closure_value)) {
        add_operand_array_places(tree, closure_value.captures);
        add_operand_places(tree, closure_value.vtable);
        return;
    }
    if (value is .optional_value(optional_value)) {
        add_operand_places(tree, optional_value.value);
        return;
    }
    if (value is .error_union_value(error_union_value)) {
        add_operand_places(tree, error_union_value.value);
    }
}

Void add_inline_asm_operand_places(MovePathTree&! tree, jil.InlineAsmRvalue value) {
    Int index! = 0;
    while (index < value.operands.length) {
        if (value.operands[index] is .input(input)) {
            add_operand_places(tree, input.value);
        }
        index = index + 1;
    }
}

Void add_optional_operand_places(MovePathTree&! tree, jil.Operand? operand) {
    if (operand is .some(value)) {
        add_operand_places(tree, value);
    }
}

Void add_operand_array_places(MovePathTree&! tree, jil.Operand[]& operands) {
    Int index! = 0;
    while (index < operands.length) {
        add_operand_places(tree, operands[index]);
        index = index + 1;
    }
}

Void add_operand_places(MovePathTree&! tree, jil.Operand operand) {
    if (operand is .copy_operand(copy_operand)) {
        tree.ensure_path_for_place(copy_operand.place);
        return;
    }
    if (operand is .move_operand(move_operand)) {
        tree.ensure_path_for_place(move_operand.place);
        return;
    }
    if (operand is .out_operand(out_operand)) {
        tree.ensure_path_for_place(out_operand.place);
    }
}

public Bool place_elem_equal(jil.PlaceElem lhs, jil.PlaceElem rhs) {
    if (lhs is .deref_projection(lhs_deref)) {
        if (rhs is .deref_projection(rhs_deref)) {
            return lhs_deref.raw_pointer == rhs_deref.raw_pointer;
        }
        return false;
    }
    if (lhs is .field_projection(lhs_field)) {
        return field_projection_equal(lhs_field, rhs);
    }
    if (lhs is .frame_field_projection(lhs_field)) {
        if (rhs is .frame_field_projection(rhs_field)) {
            return lhs_field.field_index == rhs_field.field_index
                && lhs_field.field_type == rhs_field.field_type;
        }
        return false;
    }
    if (lhs is .index_projection(lhs_index)) {
        if (rhs is .index_projection(rhs_index)) {
            return lhs_index.index_local.to_index() == rhs_index.index_local.to_index();
        }
        return false;
    }
    if (lhs is .constant_index_projection(lhs_const)) {
        if (rhs is .constant_index_projection(rhs_const)) {
            return lhs_const.offset == rhs_const.offset;
        }
        return false;
    }
    if (lhs is .subslice_projection(lhs_subslice)) {
        if (rhs is .subslice_projection(rhs_subslice)) {
            return lhs_subslice.from == rhs_subslice.from && lhs_subslice.to == rhs_subslice.to;
        }
    }
    return false;
}

Bool field_projection_equal(jil.FieldProjection lhs, jil.PlaceElem rhs) {
    if (rhs is .field_projection(rhs_field)) {
        // 同一个 root 下 field_def 已唯一标识字段。泛型 aggregate 和后续
        // member access 可能分别携带模板/实例 TypeId，不能据此拆成两条 path。
        return lhs.field_def == rhs_field.field_def;
    }
    return false;
}
