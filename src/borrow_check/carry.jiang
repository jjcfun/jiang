// 判断类型值中是否可能携带 borrow。
//
// checker 只关心一个 place 的值是否可能把 active loan 传播到另一个 place；
// named/tuple/array 等类型结构的递归细节集中放在这里。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct BorrowCarryQuery {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;

    public init(context.CompilerContext& ctx, typeck_store.TypeCheckStore& typeck) {
        self.ctx = ctx;
        self.typeck = typeck;
    }

    public Bool type_may_carry_borrow(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId>! visiting = list.ArrayList<qid.DefId>();
        return self.type_may_carry_borrow_inner(type_id, visiting$.ref());
    }

    Bool type_may_carry_borrow_inner(self, qid.TypeId type_id, list.ArrayList<qid.DefId>& visiting) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any) { return true; }
            return companion.kind == .receiver;
        }
        if (info.data is .handle_type(handle)) {
            return self.handle_type_may_carry_borrow(handle);
        }
        if (info.data is .optional(optional)) {
            return self.type_may_carry_borrow_inner(optional.element, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_may_carry_borrow_inner(error_union.value, visiting)
                || self.type_may_carry_borrow_inner(error_union.error, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_may_carry_borrow_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_type_may_carry_borrow(tuple_type, visiting);
        }
        if (info.data is .named(named)) {
            return self.named_type_may_carry_borrow(named, visiting);
        }
        return false;
    }

    Bool handle_type_may_carry_borrow(self, types.HandleType handle) {
        if (types.is_reference_handle(handle)) { return true; }
        if (types.is_slice_handle(handle)) { return true; }
        return types.is_raw_pointer_handle(handle);
    }

    Bool tuple_type_may_carry_borrow(self, types.TupleType tuple_type, list.ArrayList<qid.DefId>& visiting) {
        Int! index = 0;
        while (index < tuple_type.items.length) {
            if (self.type_may_carry_borrow_inner(tuple_type.items[index], visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool named_type_may_carry_borrow(self, types.NamedType named, list.ArrayList<qid.DefId>& visiting) {
        if (self.borrow_type_stack_has(visiting, named.def_id)) {
            return false;
        }
        Int depth = visiting.len();
        visiting.add(named.def_id);
        Bool result = self.named_members_may_carry_borrow(named.def_id, visiting);
        visiting.truncate(depth);
        return result;
    }

    Bool named_members_may_carry_borrow(self, qid.DefId def_id, list.ArrayList<qid.DefId>& visiting) {
        guard self.ctx.store.hirs.def(def_id) is .some(hir_def) else { return false; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.field_def_may_carry_borrow(member_def, visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool field_def_may_carry_borrow(self, qid.DefId member_def, list.ArrayList<qid.DefId>& visiting) {
        if (self.ctx.store.defs.get(member_def).kind != .field_def) {
            return false;
        }
        table.HashTable<qid.DefId, qid.TypeId>& def_types = self.typeck.def_types$.ref();
        guard table.hash_table_get_value<qid.DefId, qid.TypeId>(def_types, member_def) is .some(field_type) else {
            return false;
        }
        return self.type_may_carry_borrow_inner(field_type, visiting);
    }

    Bool borrow_type_stack_has(self, list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int! index = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
}
