// Loan facts。
//
// Loan 表示某个 MIR place 被借用或取地址后形成的约束。MovePathId 只在
// 单个 MirFunction 内有效，所以 Loan 同时保存 function_id。后续 lifetime
// 检查会基于这些 facts 做逃逸和活跃区间分析。

import mir = "../mir/mir.jiang";
import qid = "../store/id.jiang";
import traits = "../support/traits.jiang";
import move_path = "./move_path.jiang";

public struct LoanId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public LoanId from_index(Int index) {
        return LoanId(index);
    }
}

public enum LoanKind {
    reference_view,
    mutable_reference_view,
    raw_pointer_view,
}

public LoanKind reference_view_kind() {
    return .reference_view;
}

public LoanKind mutable_reference_view_kind() {
    return .mutable_reference_view;
}

public LoanKind raw_pointer_view_kind() {
    return .raw_pointer_view;
}

public struct Loan: Copyable {
    public LoanId id;
    public mir.MirFunctionId function_id;
    public LoanKind kind;
    public move_path.MovePathId source;
    public move_path.MovePathId target;
    public qid.DefId? domain_type;

    public init(self,
        LoanId id,
        mir.MirFunctionId function_id,
        LoanKind kind,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type
    ) {
        self.id = id;
        self.function_id = function_id;
        self.kind = kind;
        self.source = source;
        self.target = target;
        self.domain_type = domain_type;
    }
}
