// MIR 内部位置。
//
// Borrow check 的诊断和 dataflow 都以 basic block 为 CFG 单元。
// statement_index 只在 kind == .statement 时有效；terminator 用 block
// 末尾的位置表示，不和 statement 共用一个伪 index。

import mir = "../mir/mir.jiang";

public enum MirLocationKind {
    statement,
    terminator,
}

public struct MirLocation {
    public mir.MirFunctionId function_id;
    public mir.MirBlockId block_id;
    public MirLocationKind kind;
    public Int statement_index;

    public init(self,
        mir.MirFunctionId function_id,
        mir.MirBlockId block_id,
        MirLocationKind kind,
        Int statement_index
    ) {
        self.function_id = function_id;
        self.block_id = block_id;
        self.kind = kind;
        self.statement_index = statement_index;
    }

}
