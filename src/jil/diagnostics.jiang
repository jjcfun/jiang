// JIL lowering 诊断，集中维护源码定位与稳定诊断文本。
//
// lower.jiang 只决定何时报错；具体 SourceMap 查询和诊断文本在这里集中维护。

import compiler_store = "../store.jiang";
import diagnostic = "../diagnostic.jiang";
import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import source_map = "../source/source_map.jiang";
import types = "../sema/type.jiang";
import std;

public Void add_unsupported_model(
    compiler_store.CompilerStore& store,
    diagnostic.DiagnosticStore&! diagnostics,
    sem.NodeId node_id,
    sem.Node node
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (store.source_map.model_span(node_id) is .some(loc)) {
        range = source_range(loc);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("unsupported Semantic Model node for JIL lowering: ");
    builder.append(sem.node_kind_name(node));
    if (node.data is .member_access(member_access)) {
        builder.append(".");
        builder.append(store.symbols.text(member_access.member_symbol));
    }
    if (store.defs.has(node_id.owner_def)) {
        builder.append(" in ");
        builder.append(store.symbols.text(store.defs.get(node_id.owner_def).name.symbol));
    }
    std.String message = builder.into_string();
    diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .lowering,
            diagnostic.DiagnosticCode("jil_unsupported_model"),
            range,
            message.bytes()
        )
    );
}

public Void add_field_projection_layout_mismatch(
    compiler_store.CompilerStore& store,
    diagnostic.DiagnosticStore&! diagnostics,
    qid.TypeId owner_type,
    qid.DefId field_def
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (store.source_map.def_span(field_def) is .some(loc)) {
        range = source_range(loc);
    }
    diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .lowering,
            diagnostic.DiagnosticCode("jil_field_projection_layout_mismatch"),
            range,
            field_projection_layout_message(store, owner_type, field_def)
        )
    );
}

public Void add_unresolved_static_dispatch(
    compiler_store.CompilerStore& store,
    diagnostic.DiagnosticStore&! diagnostics,
    qid.DefId function_def,
    qid.DefId? caller_def,
    qid.TypeId dispatch_type,
    Int caller_arg_count,
    qid.TypeId? caller_first_type_arg,
    qid.DefId? caller_first_type_param,
    Int caller_template_arg_count
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (store.source_map.def_span(function_def) is .some(loc)) {
        range = source_range(loc);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("concrete JIL contains an unresolved static dispatch: ");
    builder.append(store.symbols.text(store.defs.get(function_def).name.symbol));
    builder.append(" in ");
    if (caller_def is .some(def_id)) {
        builder.append(store.symbols.text(store.defs.get(def_id).name.symbol));
        builder.append(" DefId ");
        builder.append(def_id.to_index());
        if (store.source_map.def_span(def_id) is .some(caller_loc)) {
            builder.append(" at ");
            if (caller_loc.source_id is .some(source_id)) {
                builder.append(store.sources.get(source_id).key.value);
                builder.append(":");
            }
            builder.append(caller_loc.span.start);
        }
    } else {
        builder.append("generated function");
    }
    builder.append(" (receiver ");
    append_dispatch_type(store, builder$.mut_ref(), dispatch_type);
    builder.append(", caller args ");
    builder.append(caller_arg_count);
    builder.append(", template args ");
    builder.append(caller_template_arg_count);
    if (caller_first_type_arg is .some(type_arg)) {
        builder.append(", first TypeId ");
        builder.append(type_arg.to_index());
    }
    if (caller_first_type_param is .some(param_def)) {
        builder.append(", param DefId ");
        builder.append(param_def.to_index());
    }
    builder.append(")");
    std.String message = builder.into_string();
    diagnostics.add(diagnostic.Diagnostic(
        .error,
        .lowering,
        diagnostic.DiagnosticCode("jil_unresolved_static_dispatch"),
        range,
        message.bytes()
    ));
}

public Void add_missing_generic_arguments(
    compiler_store.CompilerStore& store,
    diagnostic.DiagnosticStore&! diagnostics,
    qid.DefId function_def,
    qid.DefId? caller_def
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (store.source_map.def_span(function_def) is .some(loc)) {
        range = source_range(loc);
    }
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("concrete JIL instance is missing generic arguments for ");
    builder.append(store.symbols.text(store.defs.get(function_def).name.symbol));
    if (caller_def is .some(caller)) {
        builder.append(" referenced by ");
        builder.append(store.symbols.text(store.defs.get(caller).name.symbol));
    }
    std.String message = builder.into_string();
    diagnostics.add(diagnostic.Diagnostic(
        .error,
        .lowering,
        diagnostic.DiagnosticCode("jil_missing_generic_arguments"),
        range,
        message.bytes()
    ));
}

Void append_dispatch_type(
    compiler_store.CompilerStore& store,
    std.StringBuilder&! builder,
    qid.TypeId type_id
) {
    types.TypeInfo info = store.types.get(type_id);
    if (info.data is .handle_type(handle)) {
        append_dispatch_type(store, builder, handle.element);
        builder.append("&");
        return;
    }
    if (info.data is .named(named)) {
        builder.append(store.symbols.text(store.defs.get(named.def_id).name.symbol));
        return;
    }
    builder.append("TypeId ");
    builder.append(type_id.to_index());
}

public Void add_temporary_probe(
    compiler_store.CompilerStore& store,
    diagnostic.DiagnosticStore&! diagnostics,
    sem.NodeId node_id,
    UInt8[]& code,
    UInt8[]& message
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (store.source_map.model_span(node_id) is .some(loc)) {
        range = source_range(loc);
    }
    diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .lowering,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}

UInt8[]& field_projection_layout_message(
    compiler_store.CompilerStore& store,
    qid.TypeId owner_type,
    qid.DefId field_def
) {
    types.TypeInfo owner_info = store.types.get(owner_type);
    guard owner_info.data is .named(named) else {
        return "field projection owner is not a nominal type";
    }
    if (store.defs.get(field_def).owner_def is .some(field_owner)) {
        if (field_owner.to_index() != named.def_id.to_index()) {
            return "field projection owner type does not match the field owner";
        }
    }
    return "field projection does not exist in the nominal owner layout";
}

diagnostic.SourceRange source_range(source_map.SourceLoc loc) {
    guard loc.source_id is .some(source_id) else {
        return diagnostic.SourceRange();
    }
    return diagnostic.SourceRange(source_id, loc.span);
}
