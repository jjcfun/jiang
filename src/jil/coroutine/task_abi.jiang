@life(return: output)
public jil.Place task_field_place(
    jil.Store& output,
    jil.Place task_place,
    jil.SyntheticField field
) {
    list.ArrayList<jil.PlaceElem> projection! =
        list.ArrayList<jil.PlaceElem>(task_place.projection.length + 2);
    Int index! = 0;
    while (index < task_place.projection.length) {
        projection.add(task_place.projection[index]);
        index = index + 1;
    }
    projection.add(jil.constant_index_projection_elem(jil.ConstantIndexProjection (offset: 0)));
    projection.add(jil.field_projection_elem(jil.FieldProjection (
        field_def: field.def_id,
        field_type: field.type_id,
        field_index: field.index
    )));
    if (task_place.base is .global(global_ref)) {
        return jil.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return jil.local_place(task_place.local_id, output.projection_array(projection$.ref()));
}

@life(return: output)
public jil.Place task_state_storage_place(
    jil.Store& output,
    jil.Place task_place
) {
    return projected_field_place(output, task_place, 0);
}

@life(return: output)
public jil.Place task_state_field_place(
    jil.Store& output,
    jil.Place task_state_place,
    jil.SyntheticField field
) {
    list.ArrayList<jil.PlaceElem> projection! =
        list.ArrayList<jil.PlaceElem>(task_state_place.projection.length + 1);
    Int index! = 0;
    while (index < task_state_place.projection.length) {
        projection.add(task_state_place.projection[index]);
        index = index + 1;
    }
    projection.add(jil.field_projection_elem(jil.FieldProjection (
        field_def: field.def_id,
        field_type: field.type_id,
        field_index: field.index
    )));
    if (task_state_place.base is .global(global_ref)) {
        return jil.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return jil.local_place(task_state_place.local_id, output.projection_array(projection$.ref()));
}

@life(return: output)
public jil.Place projected_field_place(
    jil.Store& output,
    jil.Place base_place,
    Int field_index
) {
    list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(base_place.projection.length + 1);
    Int index! = 0;
    while (index < base_place.projection.length) {
        projection.add(base_place.projection[index]);
        index = index + 1;
    }
    projection.add(jil.constant_index_projection_elem(jil.ConstantIndexProjection (offset: field_index)));
    if (base_place.base is .global(global_ref)) {
        return jil.global_place(global_ref, output.projection_array(projection$.ref()));
    }
    return jil.local_place(base_place.local_id, output.projection_array(projection$.ref()));
}

@life(return: destination & value)
jil.Statement assign_statement(jil.Place destination, jil.Operand value, token.Span span) {
    return assign_rvalue_statement(destination, jil.use_rvalue(jil.UseRvalue (value: value)), span);
}

@life(return: destination & value)
jil.Statement assign_rvalue_statement(jil.Place destination, jil.Rvalue value, token.Span span) {
    return jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: destination,
            value: value
        ))
    );
}

jil.Const state_const(jil.CoroutineFrameLayout& layout, token.Span span, Int state_id) {
    return jil.Const (
        type_id: layout.fields[layout.state_field_index].type_id,
        span: span,
        value: jil.int_const_kind(jil.IntConst (
            bits: UInt64(state_id),
            signed_value: true
        ))
    );
}
