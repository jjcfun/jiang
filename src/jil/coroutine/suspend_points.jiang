// 收集无栈协程 lowering 所需的 JIL suspend point。

import list = "../../support/list.jiang";
import jil = "../../jil.jiang";

@life(return: output)
public jil.CoroutineSuspendPoint[]& collect(
    jil.Store& output,
    jil.Body body
) {
    list.ArrayList<jil.CoroutineSuspendPoint> points! =
        list.ArrayList<jil.CoroutineSuspendPoint>();
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        collect_block(points$.ref(), body.blocks[block_index]);
        block_index = block_index + 1;
    }
    return output.coroutine_suspend_point_array(points$.ref());
}

() collect_block(
    list.ArrayList<jil.CoroutineSuspendPoint>& points,
    jil.Block block
) {
    if (block.terminator.kind is .suspend_pending_term(suspend_pending)) {
        points.add(jil.CoroutineSuspendPoint (
            state_id: points.len() + 1,
            block_id: block.id,
            resume_target: suspend_pending.target
        ));
        return;
    }
    guard block.terminator.kind is .call_term(call_term) else { return; }
    if (!call_term.is_suspend_point) { return; }
    points.add(jil.CoroutineSuspendPoint (
        state_id: points.len() + 1,
        block_id: block.id,
        resume_target: call_term.target
    ));
}
