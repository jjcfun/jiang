// 构造无栈协程的 JIL state dispatch 骨架。

import list = "../../support/list.jiang";
import jil = "../model.jiang";

@life(return: output)
public jil.CoroutineStateDispatch build(
    jil.Storage& output,
    jil.CoroutineSuspendPoint[]& suspend_points
) {
    list.ArrayList<jil.CoroutineResumeCase> cases! =
        list.ArrayList<jil.CoroutineResumeCase>(suspend_points.length);
    Int index! = 0;
    while (index < suspend_points.length) {
        jil.CoroutineSuspendPoint point = suspend_points[index];
        cases.add(jil.CoroutineResumeCase (
            state_id: point.state_id,
            target: point.resume_target
        ));
        index = index + 1;
    }
    return jil.CoroutineStateDispatch (
        entry_state_id: 0,
        completed_state_id: suspend_points.length + 1,
        resume_cases: output.coroutine_resume_case_array(cases$.ref())
    );
}
