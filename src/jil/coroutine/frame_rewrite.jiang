    statements.add(assign_copy_statement(
        output,
        state,
        frame_field_place(output, layout, frame_place, layout.cancellation_enabled_field_index),
        body.span
    ));
    return switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: state)),
        state_const(layout, body.span, 1),
