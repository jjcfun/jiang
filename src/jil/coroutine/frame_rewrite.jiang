// 将协程局部变量改写为 frame field place，并提供对应查询。

import qid = "../../id.jiang";
import jil = "../model.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import token = "../../syntax/token.jiang";
import task_abi = "./task_abi.jiang";

public struct FrameRewritePlan: Copyable {
    public Int read_count!;
    public Int write_count!;
    public Int move_count!;
    public Int borrow_count!;
    public Int address_count!;
    public Int call_destination_count!;
    public Int exclusive_count!;
}

@region(a)
public struct FrameRewriteResult: Copyable {
    @life(a)
    public jil.Body body;
    public jil.LocalId frame_local_id;
}

@region(a)
public struct ResumeRewriteResult: Copyable {
    @life(a)
    public jil.Body body;
    public jil.LocalId frame_local_id;
    public jil.LocalId resume_return_local_id;
}

@region(a)
struct BlockSlice: Copyable {
    @life(a, a)
    jil.Block[]& values;
}

@region(a, b, c, d)
public struct ResumeFunctionLowering: Copyable {
    @life(a, b, c, d)
    public jil.Function function;
    public jil.LocalId frame_local_id;
    public jil.LocalId resume_return_local_id;
}

@region(a, b, c, d)
public struct CompletionFunctionLowering: Copyable {
    @life(a, b, c, d)
    public jil.Function function;
}

public FrameRewritePlan build_plan(
    jil.Body body,
    jil.CoroutineFrameLayout& layout
) {
    FrameRewritePlan plan! = FrameRewritePlan (
        read_count: 0,
        write_count: 0,
        move_count: 0,
        borrow_count: 0,
        address_count: 0,
        call_destination_count: 0,
        exclusive_count: 0
    );
    FrameRewritePlan&! plan_ref = plan$.mut_ref();
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        collect_block(body.blocks[block_index], layout, plan_ref);
        block_index = block_index + 1;
    }
    return plan;
}

@life(return: output & source.d)
public ResumeRewriteResult lower_resume_body(
    jil.Storage& output,
    jil.Function source,
    jil.CoroutineFrameLayout& layout
) {
    FrameRewriteResult frame_result = rewrite_body_with_frame_local(output, source.body, layout);
    FrameRewriteResult state_result = add_state_machine_skeleton(output, frame_result, layout);
    return add_resume_return_skeleton(output, state_result, source, layout);
}

@life(return: (output, output, output, output & source.d))
public ResumeFunctionLowering lower_rtc_resume_function(
    jil.Storage& output,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId resume_function_id
) {
    FrameRewriteResult frame_result = rewrite_body_with_frame_local(
        output, source.body, layout
    );
    ResumeRewriteResult lowered = add_rtc_return_skeleton(
        output, frame_result, layout
    );
    return ResumeFunctionLowering (
        function: resume_function_for_body(
            output,
            source,
            resume_function_id,
            body_with_id(lowered.body, resume_function_id)
        ),
        frame_local_id: lowered.frame_local_id,
        resume_return_local_id: lowered.resume_return_local_id
    );
}

@life(return: output & result)
ResumeRewriteResult add_rtc_return_skeleton(
    jil.Storage& output,
    FrameRewriteResult result,
    jil.CoroutineFrameLayout& layout
) {
    jil.LocalId return_local = jil.LocalId.from_index(
        result.body.locals.length
    );
    jil.LocalDecl[]& locals = locals_with_rtc_return(
        output, result.body, layout, return_local
    );
    jil.Body body = body_with_return_local(
        body_with_locals(result.body, locals), return_local
    );
    jil.Place frame_place = deref_frame_pointer_place(
        output, result.frame_local_id
    );
    return ResumeRewriteResult (
        body: body_with_blocks(
            body,
            BlockSlice(values: blocks_with_rtc_returns(output, body, layout, frame_place))
        ),
        frame_local_id: result.frame_local_id,
        resume_return_local_id: return_local
    );
}

@life()
jil.LocalDecl[]& locals_with_rtc_return(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId return_local
) {
    unsafe {
        jil.LocalDecl*! locals = output.alloc_local_array(
            body.locals.length + 1
        );
        Int index! = 0;
        while (index < body.locals.length) {
            locals[index] = body.locals[index];
            index = index + 1;
        }
        locals[body.locals.length] = generated_local(
            return_local,
            jil.LocalKind.return_place,
            layout.task_abi.resume_return_type_id,
            body.span
        );
        return locals[0..body.locals.length + 1];
    }
}

@life(return: (output, output))
jil.Block[]& blocks_with_rtc_returns(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    list.ArrayList<jil.Block> blocks! =
        list.ArrayList<jil.Block>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        blocks.add(rtc_return_block(
            output, body.blocks[index], layout, frame_place
        ));
        index = index + 1;
    }
    return output.block_array(blocks$.ref());
}

@life(return: output & block)
jil.Block rtc_return_block(
    jil.Storage& output,
    jil.Block block,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    if (block.terminator.kind is .return_term(_)) {
        jil.Place result_place = frame_field_place(
            output, layout, frame_place, layout.return_field_index
        );
        return block_with_added_statements(
            output,
            block,
            completion_statements(
                output, layout, frame_place, result_place, block.terminator.span
            ),
            unit_return_terminator(block.terminator.span)
        );
    }
    if (block.terminator.kind is .cancel_term(_)) {
        return block_with_terminator(
            block, unit_return_terminator(block.terminator.span)
        );
    }
    return block;
}

@life()
jil.Terminator unit_return_terminator(token.Span span) {
    return jil.Terminator (
        span: span,
        kind: jil.return_terminator_kind(jil.ReturnTerminator (
            implicit_unit: true
        ))
    );
}

@life(return: (output, output, output, output & source.d))
public ResumeFunctionLowering lower_resume_function(
    jil.Storage& output,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId resume_function_id
) {
    ResumeRewriteResult lowered = lower_resume_body(output, source, layout);
    return ResumeFunctionLowering (
        function: resume_function_for_body(
            output,
            source,
            resume_function_id,
            body_with_id(lowered.body, resume_function_id)
        ),
        frame_local_id: lowered.frame_local_id,
        resume_return_local_id: lowered.resume_return_local_id
    );
}

@life(return: (output, output, output, output & source.d))
public ResumeFunctionLowering add_resume_function(
    jil.Storage& output,
    jil.Program&! program,
    jil.Function source,
    jil.CoroutineFrameLayout& layout
) {
    jil.FunctionId resume_function_id = jil.FunctionId.from_index(program.functions.len());
    ResumeFunctionLowering lowered = lower_resume_function(output, source, layout, resume_function_id);
    program.add_generated_function(lowered.function);
    program.copy_monomorph_owners(source.id, resume_function_id);
    return lowered;
}

@life(return: (output, output, output, output & source.d))
public CompletionFunctionLowering add_completion_function(
    jil.Storage& output,
    jil.Program&! program,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionRef? env_drop
) {
    jil.FunctionId function_id = jil.FunctionId.from_index(program.functions.len());
    CompletionFunctionLowering lowered = CompletionFunctionLowering (
        function: completion_function(
            output, source, layout, function_id, env_drop, false
        )
    );
    program.add_generated_function(lowered.function);
    program.copy_monomorph_owners(source.id, function_id);
    return lowered;
}

@life(return: (
    output & program,
    output & program,
    output & program,
    output & program & source.d
))
public CompletionFunctionLowering add_serial_completion_function(
    jil.Storage& output,
    jil.Program&! program,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionRef? env_drop,
    jil.FunctionId function_id
) {
    jil.Function reserved = program.function(function_id);
    guard jil.function_generated_origin(reserved.origin) is .some(origin) else {
        return CompletionFunctionLowering(function: reserved);
    }
    CompletionFunctionLowering lowered = CompletionFunctionLowering (
        function: serial_completion_function(
            output, source, layout, function_id, env_drop, origin, reserved
        )
    );
    program.finish_generated_function(lowered.function);
    program.copy_monomorph_owners(source.id, function_id);
    return lowered;
}

@life(return: (output, output, output, output & source.d))
public CompletionFunctionLowering add_detached_completion_function(
    jil.Storage& output,
    jil.Program&! program,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionRef? env_drop
) {
    jil.FunctionId function_id = jil.FunctionId.from_index(program.functions.len());
    CompletionFunctionLowering lowered = CompletionFunctionLowering (
        function: completion_function(
            output, source, layout, function_id, env_drop, true
        )
    );
    program.add_generated_function(lowered.function);
    program.copy_monomorph_owners(source.id, function_id);
    return lowered;
}

@life(return: (output, output, output, output))
jil.Function completion_function(
    jil.Storage& output,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId function_id,
    jil.FunctionRef? env_drop,
    Bool detached
) {
    return jil.Function (
        id: function_id,
        origin: source.origin,
        type_args: output.type_arg_array(source.type_args),
        const_args: output.const_arg_array(source.const_args),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: false,
        is_coroutine_completion: true,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: true,
        naked: false,
        span: source.span,
        body: completion_body_for_kind(
            output, layout, function_id, source.span, env_drop, detached
        )
    );
}

@life(return: output)
jil.Body completion_body_for_kind(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId function_id,
    token.Span span,
    jil.FunctionRef? env_drop,
    Bool detached
) {
    if (detached) {
        return detached_completion_body(
            output, layout, function_id, span, env_drop
        );
    }
    return completion_body(output, layout, function_id, span, env_drop, true);
}

@life(return: (output, output, output, output))
jil.Function serial_completion_function(
    jil.Storage& output,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId function_id,
    jil.FunctionRef? env_drop,
    jil.GeneratedFunctionOrigin origin,
    jil.Function reserved
) {
    return jil.Function (
        id: function_id,
        origin: .generated(origin),
        type_args: output.type_arg_array(reserved.type_args),
        const_args: output.const_arg_array(reserved.const_args),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: true,
        naked: false,
        span: source.span,
        body: completion_body(
            output, layout, function_id, source.span, env_drop, false
        )
    );
}

@life(return: output)
jil.Body detached_completion_body(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId function_id,
    token.Span span,
    jil.FunctionRef? env_drop
) {
    unsafe {
        jil.LocalId return_local = jil.LocalId.from_index(0);
        jil.LocalId context_local = jil.LocalId.from_index(1);
        jil.LocalId frame_pointer_local = jil.LocalId.from_index(2);
        jil.LocalId allocation_executor_local = jil.LocalId.from_index(3);
        jil.LocalDecl*! locals = output.alloc_local_array(4);
        locals[0] = generated_local(
            return_local,
            jil.LocalKind.return_place,
            layout.task_abi.resume_return_type_id,
            span
        );
        locals[1] = generated_local(
            context_local,
            jil.LocalKind.param,
            layout.fields[layout.continuation_context_field_index].type_id,
            span
        );
        locals[2] = generated_local(
            frame_pointer_local,
            jil.LocalKind.compiler_temp,
            layout.task_abi.frame_pointer_type_id,
            span
        );
        locals[3] = generated_local(
            allocation_executor_local,
            jil.LocalKind.compiler_temp,
            layout.fields[layout.current_executor_field_index].type_id,
            span
        );
        jil.Place frame_pointer_place = jil.local_place(frame_pointer_local, output.empty_projection());
        list.ArrayList<jil.Statement> entry_statements! = list.ArrayList<jil.Statement>(1);
        entry_statements.add(jil.Statement (
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement (
                destination: frame_pointer_place,
                value: jil.cast_rvalue(jil.CastRvalue (
                    kind: jil.CastKind.ptr_to_ptr,
                    value: jil.copy_operand_value(jil.CopyOperand (
                        place: jil.local_place(context_local, output.empty_projection())
                    )),
                    target_type: layout.task_abi.frame_pointer_type_id
                ))
            ))
        ));
        jil.Place frame_place = deref_frame_pointer_place(output, frame_pointer_local);
        entry_statements.add(jil.Statement (
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement (
                destination: jil.local_place(
                    allocation_executor_local, output.empty_projection()
                ),
                value: jil.use_rvalue(jil.UseRvalue (
                    value: jil.copy_operand_value(jil.CopyOperand (
                        place: frame_field_place(
                            output,
                            layout,
                            frame_place,
                            layout.current_executor_field_index
                        )
                    ))
                ))
            ))
        ));
        jil.BlockId result_drop_id = jil.BlockId.from_index(1);
        jil.BlockId free_id = jil.BlockId.from_index(2);
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(3);
        if (env_drop is .some(drop_function)) {
            blocks.add(detached_env_drop_block(
                output,
                layout,
                frame_place,
                return_local,
                drop_function,
                result_drop_id,
                entry_statements$.ref(),
                span
            ));
        } else {
            blocks.add(jil.Block (
                id: jil.BlockId.from_index(0),
                span: span,
                statements: output.statement_array(entry_statements$.ref()),
                terminator: goto_terminator(span, result_drop_id)
            ));
        }
        blocks.add(jil.Block (
            id: result_drop_id,
            span: span,
            statements: output.empty_statements(),
            terminator: jil.Terminator (
                span: span,
                kind: jil.drop_terminator_kind(jil.DropTerminator (
                    place: frame_field_place(output, layout, frame_place, layout.return_field_index),
                    target: free_id,
                    cleanup: null
                ))
            )
        ));
        list.ArrayList<jil.Statement> free_statements! = list.ArrayList<jil.Statement>(1);
        free_statements.add(jil.Statement (
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement (
                destination: jil.local_place(return_local, output.empty_projection()),
                value: jil.coroutine_frame_free_rvalue(jil.CoroutineFrameFreeRvalue (
                    pointer: jil.copy_operand_value(jil.CopyOperand (place: frame_pointer_place)),
                    executor: jil.copy_operand_value(jil.CopyOperand (
                        place: jil.local_place(
                            allocation_executor_local, output.empty_projection()
                        )
                    ))
                ))
            ))
        ));
        blocks.add(jil.Block (
            id: free_id,
            span: span,
            statements: output.statement_array(free_statements$.ref()),
            terminator: jil.Terminator (
                span: span,
                kind: jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: true))
            )
        ));
        return jil.Body (
            id: jil.BodyId.from_index(function_id.to_index()),
            span: span,
            locals: locals[0..4],
            blocks: output.block_array(blocks$.ref()),
            entry: jil.BlockId.from_index(0),
            return_local: return_local
        );
    }
}

@life(return: output & layout & frame_place & drop_function & statements)
jil.Block detached_env_drop_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId return_local,
    jil.FunctionRef drop_function,
    jil.BlockId target,
    list.ArrayList<jil.Statement>& statements,
    token.Span span
) {
    guard field_index_for_local(layout, jil.LocalId.from_index(1)) is .some(env_field_index) else {
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: output.statement_array(statements),
            terminator: goto_terminator(span, target)
        );
    }
    jil.Place env_place = frame_field_place(output, layout, frame_place, env_field_index);
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
    args.add(jil.copy_operand_value(jil.CopyOperand (place: env_place)));
    return jil.Block (
        id: jil.BlockId.from_index(0),
        span: span,
        statements: output.statement_array(statements),
        terminator: jil.Terminator (
            span: span,
            kind: jil.call_terminator_kind(jil.CallTerminator (
                callee: jil.direct_function_callee(drop_function),
                args: output.operand_array(args$.ref()),
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: jil.local_place(return_local, output.empty_projection()),
                target: target,
                initialized_place: null,
                exclusive_places: output.empty_places(),
                cleanup: null
            ))
        )
    );
}

@life()
jil.LocalDecl[]& completion_local_declarations(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    token.Span span,
    Bool concurrent
) {
    unsafe {
        Int local_count! = 7;
        if (concurrent) { local_count = 9; }
        jil.LocalDecl*! locals = output.alloc_local_array(local_count);
        locals[0] = generated_local(
            jil.LocalId.from_index(0),
            .return_place,
            layout.task_abi.resume_return_type_id,
            span
        );
        locals[1] = generated_local(
            jil.LocalId.from_index(1),
            .param,
            layout.fields[layout.continuation_context_field_index].type_id,
            span
        );
        locals[2] = generated_local(
            jil.LocalId.from_index(2),
            .compiler_temp,
            layout.task_abi.frame_pointer_type_id,
            span
        );
        locals[3] = generated_local(
            jil.LocalId.from_index(3),
            .compiler_temp,
            layout.fields[layout.state_field_index].type_id,
            span
        );
        locals[4] = generated_local(
            jil.LocalId.from_index(4),
            .compiler_temp,
            layout.task_abi.state_field.type_id,
            span
        );
        locals[5] = generated_local(
            jil.LocalId.from_index(5),
            .compiler_temp,
            layout.task_abi.state_field.type_id,
            span
        );
        locals[6] = generated_local(
            jil.LocalId.from_index(6),
            .compiler_temp,
            layout.task_abi.waiter_layout.pointer_type_id,
            span
        );
        if (concurrent) {
            locals[7] = generated_local(
                jil.LocalId.from_index(7),
                .compiler_temp,
                layout.task_abi.state_field.type_id,
                span
            );
            locals[8] = generated_local(
                jil.LocalId.from_index(8),
                .compiler_temp,
                layout.task_abi.blocking_ack_pointer_type_id,
                span
            );
        }
        return locals[0..local_count];
    }
}

Void append_completion_result_blocks(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place task_place,
    jil.LocalId return_local,
    jil.LocalId frame_pointer_local,
    jil.LocalId cancellation_state_local,
    jil.LocalId completion_state_local,
    jil.FunctionRef? env_drop,
    jil.BlockId initialize_select_id,
    jil.BlockId result_present_id,
    jil.BlockId result_absent_id,
    jil.BlockId publish_id,
    Bool concurrent,
    token.Span span,
    list.ArrayList<jil.Block>&! blocks
) {
    if (env_drop is .some(drop_function)) {
        blocks.add(completion_env_drop_block(
            output,
            layout,
            task_place,
            return_local,
            frame_pointer_local,
            drop_function,
            initialize_select_id,
            span
        ));
    }
    jil.Place cancellation_state_place = jil.local_place(
        cancellation_state_local, output.empty_projection()
    );
    blocks.add(completion_result_initialize_select_block(
        output,
        layout,
        task_place,
        cancellation_state_place,
        initialize_select_id,
        result_present_id,
        result_absent_id,
        concurrent,
        span
    ));
    blocks.add(completion_result_state_block(
        output, layout, completion_state_local, result_present_id, publish_id, 1, span
    ));
    blocks.add(completion_result_state_block(
        output, layout, completion_state_local, result_absent_id, publish_id, 3, span
    ));
}

// standard 与 fully-confined completion 共享结果/drop CFG。concurrent 只控制
// 最终 completion word 的原子发布、blocking waiter 唤醒和 executor handoff。
@life(return: output)
jil.Body completion_body(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.FunctionId function_id,
    token.Span span,
    jil.FunctionRef? env_drop,
    Bool concurrent
) {
    unsafe {
        jil.LocalId return_local = jil.LocalId.from_index(0);
        jil.LocalId context_local = jil.LocalId.from_index(1);
        jil.LocalId frame_pointer_local = jil.LocalId.from_index(2);
        jil.LocalId cancellation_state_local = jil.LocalId.from_index(3);
        jil.LocalId completion_state_local = jil.LocalId.from_index(4);
        jil.LocalId previous_state_local = jil.LocalId.from_index(5);
        jil.LocalId waiter_pointer_local = jil.LocalId.from_index(6);
        jil.LocalId waiter_tag_local = jil.LocalId.from_index(7);
        jil.LocalId blocking_ack_pointer_local = jil.LocalId.from_index(8);
        jil.LocalDecl[]& locals = completion_local_declarations(
            output, layout, span, concurrent
        );
        jil.Place task_place = deref_frame_pointer_place(output, context_local);
        jil.Place task_pointer = jil.local_place(context_local, output.empty_projection());
        jil.Place completed_place = task_abi.task_state_field_place(
            output,
            task_place,
            layout.task_abi.state_field
        );
        Int completion_offset! = 0;
        if (env_drop != null) { completion_offset = 1; }
        jil.BlockId initialize_select_id = jil.BlockId.from_index(completion_offset);
        jil.BlockId result_present_id = jil.BlockId.from_index(completion_offset + 1);
        jil.BlockId result_absent_id = jil.BlockId.from_index(completion_offset + 2);
        jil.BlockId publish_id = jil.BlockId.from_index(completion_offset + 3);
        jil.BlockId classify_id = jil.BlockId.from_index(completion_offset + 4);
        jil.BlockId wake_id = jil.BlockId.from_index(completion_offset + 6);
        Int notify_offset! = 4;
        Int return_offset! = 5;
        Int invalid_offset! = 6;
        Int block_count! = 7;
        if (concurrent) {
            notify_offset = 5;
            return_offset = 7;
            invalid_offset = 8;
            block_count = 9;
        }
        jil.BlockId notify_id = jil.BlockId.from_index(
            completion_offset + notify_offset
        );
        jil.BlockId return_id = jil.BlockId.from_index(
            completion_offset + return_offset
        );
        jil.BlockId invalid_id = jil.BlockId.from_index(
            completion_offset + invalid_offset
        );
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(
            completion_offset + block_count
        );
        append_completion_result_blocks(
            output,
            layout,
            task_place,
            return_local,
            frame_pointer_local,
            cancellation_state_local,
            completion_state_local,
            env_drop,
            initialize_select_id,
            result_present_id,
            result_absent_id,
            publish_id,
            concurrent,
            span,
            blocks$.mut_ref()
        );
        if (concurrent) {
            blocks.add(completion_publish_exchange_block(
                output,
                layout,
                task_pointer,
                completed_place,
                completion_state_local,
                previous_state_local,
                publish_id,
                return_id,
                classify_id,
                invalid_id,
                span
            ));
            blocks.add(completion_classify_waiter_block(
                output,
                layout,
                previous_state_local,
                waiter_tag_local,
                classify_id,
                notify_id,
                wake_id,
                span
            ));
            blocks.add(completion_notify_waiter_block(
                output,
                layout,
                previous_state_local,
                waiter_pointer_local,
                return_local,
                notify_id,
                return_id,
                false,
                span
            ));
            blocks.add(completion_wake_block(
                output,
                layout,
                completed_place,
                previous_state_local,
                waiter_tag_local,
                blocking_ack_pointer_local,
                wake_id,
                return_id,
                span
            ));
        } else {
            blocks.add(serial_completion_publish_block(
                output,
                layout,
                task_pointer,
                completed_place,
                completion_state_local,
                previous_state_local,
                publish_id,
                return_id,
                notify_id,
                invalid_id,
                span
            ));
            blocks.add(completion_notify_waiter_block(
                output,
                layout,
                previous_state_local,
                waiter_pointer_local,
                return_local,
                notify_id,
                return_id,
                true,
                span
            ));
        }
        blocks.add(completion_return_block(
            output, return_id, span
        ));
        blocks.add(invalid_state_block(output, span, invalid_id));
        return jil.Body (
            id: jil.BodyId.from_index(function_id.to_index()),
            span: span,
            locals: locals,
            blocks: output.block_array(blocks$.ref()),
            entry: jil.BlockId.from_index(0),
            return_local: return_local
        );
    }
}

@life(return: output)
jil.Block serial_completion_publish_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place task_pointer,
    jil.Place completed_place,
    jil.LocalId completion_state_local,
    jil.LocalId previous_state_local,
    jil.BlockId id,
    jil.BlockId return_id,
    jil.BlockId notify_id,
    jil.BlockId invalid_id,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(4);
    statements.add(task_schedule_complete_store(task_pointer, span));
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(previous_state_local, output.empty_projection()),
            value: jil.use_rvalue(jil.UseRvalue (
                value: jil.copy_operand_value(jil.CopyOperand (place: completed_place))
            ))
        ))
    ));
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: completed_place,
            value: jil.use_rvalue(jil.UseRvalue (
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(completion_state_local, output.empty_projection())
                ))
            ))
        ))
    ));
    statements.add(task_owner_complete_store(task_pointer, span));
    return completion_publish_switch_block(
        output,
        layout,
        statements$.ref(),
        previous_state_local,
        id,
        return_id,
        notify_id,
        invalid_id,
        span
    );
}

@life(return: output)
jil.Block completion_publish_exchange_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place task_pointer,
    jil.Place completed_place,
    jil.LocalId completion_state_local,
    jil.LocalId previous_state_local,
    jil.BlockId id,
    jil.BlockId return_id,
    jil.BlockId classify_id,
    jil.BlockId invalid_id,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(3);
    statements.add(task_schedule_complete_store(task_pointer, span));
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(previous_state_local, output.empty_projection()),
            value: jil.atomic_exchange_rvalue(jil.AtomicExchangeRvalue (
                place: completed_place,
                desired: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(completion_state_local, output.empty_projection())
                )),
                mode: .coroutine_atomic
            ))
        ))
    ));
    statements.add(task_owner_complete_store(task_pointer, span));
    return completion_publish_switch_block(
        output,
        layout,
        statements$.ref(),
        previous_state_local,
        id,
        return_id,
        classify_id,
        invalid_id,
        span
    );
}

@life(return: output)
jil.Block completion_publish_switch_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    list.ArrayList<jil.Statement>& statements,
    jil.LocalId previous_state_local,
    jil.BlockId id,
    jil.BlockId return_id,
    jil.BlockId waiter_id,
    jil.BlockId invalid_id,
    token.Span span
) {
    list.ArrayList<jil.SwitchCase> cases! =
        list.ArrayList<jil.SwitchCase>(5);
    cases.add(jil.SwitchCase (
        value: state_const(layout, span, 0), target: return_id
    ));
    Int invalid_state! = 1;
    while (invalid_state <= 4) {
        cases.add(jil.SwitchCase (
            value: state_const(layout, span, invalid_state),
            target: invalid_id
        ));
        invalid_state = invalid_state + 1;
    }
    return jil.Block (
        id: id,
        span: span,
        statements: output.statement_array(statements),
        terminator: jil.Terminator (
            span: span,
            kind: jil.switch_terminator_kind(jil.SwitchTerminator (
                discriminator: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(previous_state_local, output.empty_projection())
                )),
                cases: output.switch_case_array(cases$.ref()),
                default_target: waiter_id
            ))
        )
    );
}

@life(return: output)
jil.Block completion_classify_waiter_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId previous_state_local,
    jil.LocalId tag_local,
    jil.BlockId id,
    jil.BlockId notify_id,
    jil.BlockId wake_id,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(tag_local, output.empty_projection()),
            value: jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_and,
                lhs: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(previous_state_local, output.empty_projection())
                )),
                rhs: jil.const_operand_value(state_const(layout, span, 1))
            ))
        ))
    ));
    return switch_block(
        output,
        id,
        span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (
            place: jil.local_place(tag_local, output.empty_projection())
        )),
        state_const(layout, span, 1),
        wake_id,
        notify_id
    );
}

@life(return: output)
jil.Block completion_notify_waiter_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId previous_state_local,
    jil.LocalId pointer_local,
    jil.LocalId return_local,
    jil.BlockId id,
    jil.BlockId target,
    Bool handoff,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(pointer_local, output.empty_projection()),
            value: jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(previous_state_local, output.empty_projection())
                )),
                target_type: layout.task_abi.waiter_layout.pointer_type_id
            ))
        ))
    ));
    jil.Place waiter = deref_frame_pointer_place(output, pointer_local);
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
    args.add(waiter_field_operand(
        output, waiter, layout.task_abi.waiter_layout.context_field_index
    ));
    jil.CallCallee callee = jil.dynamic_task_enqueue_callee(
        waiter_field_operand(output, waiter, layout.task_abi.waiter_layout.executor_field_index),
        waiter_field_operand(output, waiter, layout.task_abi.waiter_layout.task_field_index),
        waiter_field_operand(output, waiter, layout.task_abi.waiter_layout.resume_field_index),
        handoff
    );
    jil.CallTerminator call = jil.CallTerminator (
        callee: callee,
        args: output.operand_array(args$.ref()),
        current_effects: types.EffectSet(),
        is_suspend_point: false,
        destination: jil.local_place(return_local, output.empty_projection()),
        target: target,
        initialized_place: null,
        exclusive_places: output.empty_places(),
        cleanup: null
    );
    return jil.Block (
        id: id,
        span: span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: span,
            kind: jil.call_terminator_kind(call)
        )
    );
}

@life(return: output)
jil.Operand waiter_field_operand(
    jil.Storage& output,
    jil.Place waiter,
    Int field_index
) {
    return jil.copy_operand_value(jil.CopyOperand (
        place: task_abi.projected_field_place(output, waiter, field_index)
    ));
}

@life(return: output)
jil.Block completion_wake_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place completed_place,
    jil.LocalId previous_state_local,
    jil.LocalId untagged_word_local,
    jil.LocalId ack_pointer_local,
    jil.BlockId id,
    jil.BlockId target,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(4);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(untagged_word_local, output.empty_projection()),
            value: jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_xor,
                lhs: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(previous_state_local, output.empty_projection())
                )),
                rhs: jil.const_operand_value(state_const(layout, span, 1))
            ))
        ))
    ));
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(ack_pointer_local, output.empty_projection()),
            value: jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(untagged_word_local, output.empty_projection())
                )),
                target_type: layout.task_abi.blocking_ack_pointer_type_id
            ))
        ))
    ));
    statements.add(jil.Statement (
        span: span,
        kind: jil.task_wait_statement_kind(jil.TaskWaitStatement (
            state: completed_place,
            wake: true,
            expected: jil.const_operand_value(state_const(layout, span, 0))
        ))
    ));
    statements.add(jil.Statement (
        span: span,
        kind: jil.atomic_store_statement_kind(jil.AtomicStoreStatement (
            destination: deref_frame_pointer_place(output, ack_pointer_local),
            value: jil.const_operand_value(state_const(layout, span, 1)),
            mode: .coroutine_atomic
        ))
    ));
    return jil.Block (
        id: id,
        span: span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(span, target)
    );
}

jil.Statement task_schedule_complete_store(
    jil.Place task_pointer,
    token.Span span
) {
    return jil.Statement (
        span: span,
        kind: jil.task_complete_statement_kind(jil.TaskCompleteStatement (
            task: task_pointer
        ))
    );
}

jil.Statement task_owner_complete_store(
    jil.Place task_pointer,
    token.Span span
) {
    return jil.Statement (
        span: span,
        kind: jil.task_complete_statement_kind(jil.TaskCompleteStatement (
            task: task_pointer,
            owner_lifecycle: true
        ))
    );
}

jil.Block completion_return_block(
    jil.Storage& output,
    jil.BlockId id,
    token.Span span
) {
    return jil.Block (
        id: id,
        span: span,
        statements: output.empty_statements(),
        terminator: jil.Terminator (
            span: span,
            kind: jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: true))
        )
    );
}

@life(return: output & task_place & cancellation_state_place)
jil.Block completion_result_initialize_select_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place task_place,
    jil.Place cancellation_state_place,
    jil.BlockId id,
    jil.BlockId initialize_id,
    jil.BlockId state_id,
    Bool concurrent,
    token.Span span
) {
    jil.Place request = task_abi.task_state_field_place(
        output, task_place, layout.task_abi.cancellation_requested_field
    );
    jil.Rvalue request_value! = jil.use_rvalue(jil.UseRvalue (
        value: jil.copy_operand_value(jil.CopyOperand (place: request))
    ));
    if (concurrent) {
        request_value = jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
            place: request,
            mode: .coroutine_atomic
        ));
    }
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: cancellation_state_place,
            value: request_value
        ))
    ));
    return switch_block(
        output,
        id,
        span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: cancellation_state_place)),
        state_const(layout, span, 2),
        state_id,
        initialize_id
    );
}

@life(return: output)
jil.Block completion_result_state_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId completion_state_local,
    jil.BlockId id,
    jil.BlockId target,
    Int value,
    token.Span span
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: jil.local_place(completion_state_local, output.empty_projection()),
            value: jil.use_rvalue(jil.UseRvalue (
                value: jil.const_operand_value(state_const(layout, span, value))
            ))
        ))
    ));
    return jil.Block (
        id: id,
        span: span,
        statements: output.statement_array(statements$.ref()),
        terminator: goto_terminator(span, target)
    );
}

@life(return: output & layout & task_place & drop_function)
jil.Block completion_env_drop_block(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place task_place,
    jil.LocalId return_local,
    jil.LocalId frame_pointer_local,
    jil.FunctionRef drop_function,
    jil.BlockId target,
    token.Span span
) {
    jil.Place frame_pointer = task_abi.task_state_field_place(
        output,
        task_place,
        layout.task_abi.frame_field
    );
    jil.Place typed_frame_pointer = jil.local_place(frame_pointer_local, output.empty_projection());
    jil.Place frame_place = deref_frame_pointer_place(output, frame_pointer_local);
    guard field_index_for_local(layout, jil.LocalId.from_index(1)) is .some(env_field_index) else {
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: output.empty_statements(),
            terminator: goto_terminator(span, target)
        );
    }
    jil.Place env_place = frame_field_place(output, layout, frame_place, env_field_index);
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: typed_frame_pointer,
            value: jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (place: frame_pointer)),
                target_type: layout.task_abi.frame_pointer_type_id
            ))
        ))
    ));
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
    args.add(jil.copy_operand_value(jil.CopyOperand (place: env_place)));
    return jil.Block (
        id: jil.BlockId.from_index(0),
        span: span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: span,
            kind: jil.call_terminator_kind(jil.CallTerminator (
                callee: jil.direct_function_callee(drop_function),
                args: output.operand_array(args$.ref()),
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: jil.local_place(return_local, output.empty_projection()),
                target: target,
                initialized_place: null,
                exclusive_places: output.empty_places(),
                cleanup: null
            ))
        )
    );
}

jil.LocalDecl generated_local(
    jil.LocalId id,
    jil.LocalKind kind,
    qid.TypeId type_id,
    token.Span span
) {
    return jil.LocalDecl (
        id: id,
        kind: kind,
        type_id: type_id,
        span: span,
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

@life(return: output & body)
public FrameRewriteResult rewrite_body_with_frame_local(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout
) {
    jil.LocalId frame_local_id = jil.LocalId.from_index(body.locals.length);
    jil.LocalDecl[]& locals = locals_with_frame_local(output, body, layout, frame_local_id);
    jil.Place frame_place = deref_frame_pointer_place(output, frame_local_id);
    jil.Body rewritten! = rewrite_body_places_to_frame(
        output,
        body_with_locals(body, locals),
        layout,
        frame_place
    );
    rewritten = body_with_blocks(
        rewritten,
        BlockSlice(
            values: blocks_with_frame_initializers(output, rewritten, layout, frame_place)
        )
    );
    return FrameRewriteResult (
        body: rewritten,
        frame_local_id: frame_local_id
    );
}

jil.Place deref_frame_pointer_place(jil.Storage& output, jil.LocalId frame_local_id) {
    list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(1);
    projection.add(jil.deref_projection_elem(jil.DerefProjection (raw_pointer: true)));
    return jil.local_place(frame_local_id, output.projection_array(projection$.ref()));
}

@life(return: output)
public jil.Place resume_current_executor_place(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId frame_local_id
) {
    return frame_field_place(
        output,
        layout,
        deref_frame_pointer_place(output, frame_local_id),
        layout.current_executor_field_index
    );
}

@life(return: output & result)
public FrameRewriteResult add_state_machine_skeleton(
    jil.Storage& output,
    FrameRewriteResult result,
    jil.CoroutineFrameLayout& layout
) {
    jil.Place frame_place = deref_frame_pointer_place(output, result.frame_local_id);
    jil.LocalId cancellation_state_local = jil.LocalId.from_index(result.body.locals.length);
    jil.LocalId cancellation_claimed_local = jil.LocalId.from_index(result.body.locals.length + 1);
    jil.LocalId cancellation_context_local = jil.LocalId.from_index(result.body.locals.length + 2);
    jil.LocalId cancellation_result_local = jil.LocalId.from_index(result.body.locals.length + 3);
    jil.LocalId cancellation_tag_local = jil.LocalId.from_index(result.body.locals.length + 4);
    jil.LocalId cancellation_target_local = jil.LocalId.from_index(result.body.locals.length + 5);
    jil.LocalDecl[]& locals = locals_with_cancellation_check(
        output,
        result.body,
        layout,
        cancellation_state_local,
        cancellation_claimed_local,
        cancellation_context_local,
        cancellation_result_local,
        cancellation_tag_local,
        cancellation_target_local
    );
    jil.BlockId dispatch_id = jil.BlockId.from_index(result.body.blocks.length);
    jil.Body body = body_with_blocks(
        body_with_locals(result.body, locals),
        BlockSlice(
            values: state_machine_blocks(
                output,
                result.body,
                layout,
                frame_place,
                cancellation_state_local,
                cancellation_claimed_local,
                cancellation_context_local,
                cancellation_result_local,
                cancellation_tag_local,
                cancellation_target_local,
                dispatch_id
            )
        )
    );
    return FrameRewriteResult (
        body: body_with_entry(body, jil.BlockId.from_index(result.body.blocks.length + 2)),
        frame_local_id: result.frame_local_id
    );
}

@life()
jil.LocalDecl[]& locals_with_cancellation_check(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId claimed_local,
    jil.LocalId context_local,
    jil.LocalId result_local,
    jil.LocalId tag_local,
    jil.LocalId target_local
) {
    unsafe {
        jil.LocalDecl*! locals = output.alloc_local_array(body.locals.length + 6);
        Int index! = 0;
        while (index < body.locals.length) {
            locals[index] = body.locals[index];
            index = index + 1;
        }
        locals[body.locals.length] = generated_local(
            state_local,
            jil.LocalKind.compiler_temp,
            layout.fields[layout.state_field_index].type_id,
            body.span
        );
        locals[body.locals.length + 1] = generated_local(
            claimed_local, jil.LocalKind.compiler_temp, layout.task_abi.bool_type_id, body.span
        );
        locals[body.locals.length + 2] = generated_local(
            context_local,
            jil.LocalKind.compiler_temp,
            layout.fields[layout.cancellation_context_field_index].type_id,
            body.span
        );
        locals[body.locals.length + 3] = generated_local(
            result_local, jil.LocalKind.compiler_temp, layout.task_abi.resume_return_type_id, body.span
        );
        locals[body.locals.length + 4] = generated_local(
            tag_local,
            jil.LocalKind.compiler_temp,
            layout.task_abi.cancel_target_word_field.type_id,
            body.span
        );
        locals[body.locals.length + 5] = generated_local(
            target_local,
            jil.LocalKind.compiler_temp,
            layout.task_abi.suspend_layout.pointer_type_id,
            body.span
        );
        return locals[0..body.locals.length + 6];
    }
}

@life(return: output & result)
public ResumeRewriteResult add_resume_return_skeleton(
    jil.Storage& output,
    FrameRewriteResult result,
    jil.Function source,
    jil.CoroutineFrameLayout& layout
) {
    jil.LocalId resume_return_local_id = jil.LocalId.from_index(result.body.locals.length);
    jil.LocalId previous_context_local_id = jil.LocalId.from_index(result.body.locals.length + 1);
    jil.LocalId executor_local_id = jil.LocalId.from_index(result.body.locals.length + 2);
    jil.LocalDecl[]& locals = locals_with_resume_return(
        output,
        result.body,
        layout,
        resume_return_local_id,
        previous_context_local_id,
        executor_local_id
    );
    jil.Body body! = body_with_return_local(
        body_with_locals(result.body, locals),
        resume_return_local_id
    );
    jil.BlockId resume_return_id = jil.BlockId.from_index(body.blocks.length);
    jil.BlockId suspend_return_id = jil.BlockId.from_index(body.blocks.length + 1);
    jil.BlockId handoff_return_id = jil.BlockId.from_index(body.blocks.length + 2);
    body = body_with_blocks(
        body,
        BlockSlice(
            values: blocks_with_resume_returns(
                output,
                body,
                source,
                layout,
                result.frame_local_id,
                previous_context_local_id,
                executor_local_id,
                resume_return_id,
                suspend_return_id,
                handoff_return_id
            )
        )
    );
    return ResumeRewriteResult (
        body: body,
        frame_local_id: result.frame_local_id,
        resume_return_local_id: resume_return_local_id
    );
}

public Int? field_index_for_local(
    jil.CoroutineFrameLayout& layout,
    jil.LocalId local_id
) {
    Int index! = 0;
    while (index < layout.local_mappings.length) {
        jil.CoroutineLocalFrameField mapping = layout.local_mappings[index];
        if (mapping.local_id.to_index() == local_id.to_index()) {
            return mapping.field_index;
        }
        index = index + 1;
    }
    return null;
}

@life(return: (output, output, output, body))
jil.Function resume_function_for_body(
    jil.Storage& output,
    jil.Function source,
    jil.FunctionId resume_function_id,
    jil.Body body
) {
    return jil.Function (
        id: resume_function_id,
        origin: source.origin,
        type_args: output.type_arg_array(source.type_args),
        const_args: output.const_arg_array(source.const_args),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: true,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: source.inline_always,
        naked: false,
        span: source.span,
        body: body
    );
}

public Bool local_is_frame_backed(
    jil.CoroutineFrameLayout& layout,
    jil.LocalId local_id
) {
    return field_index_for_local(layout, local_id) != null;
}

public Int? field_index_for_place(
    jil.CoroutineFrameLayout& layout,
    jil.Place place
) {
    guard jil.place_local_id(place) is .some(local_id) else { return null; }
    return field_index_for_local(layout, local_id);
}

public Bool place_is_frame_backed(
    jil.CoroutineFrameLayout& layout,
    jil.Place place
) {
    return field_index_for_place(layout, place) != null;
}

@life(return: output & source_place)
public jil.Place rewrite_place_to_frame(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.Place source_place
) {
    guard field_index_for_place(layout, source_place) is .some(field_index) else {
        return source_place;
    }
    jil.CoroutineFrameField field = layout.fields[field_index];
    list.ArrayList<jil.PlaceElem> projection! =
        list.ArrayList<jil.PlaceElem>(frame_place.projection.length + 1 + source_place.projection.length);
    copy_projection(frame_place.projection, projection$.mut_ref());
    projection.add(jil.frame_field_projection_elem(jil.FrameFieldProjection (
        field_index: field_index,
        field_type: field.type_id
    )));
    copy_projection(source_place.projection, projection$.mut_ref());
    return place_with_projection(output, frame_place, projection$.ref());
}

Void copy_projection(
    jil.PlaceElem[]& source,
    list.ArrayList<jil.PlaceElem>&! destination
) {
    Int index! = 0;
    while (index < source.length) {
        destination.add(source[index]);
        index = index + 1;
    }
}

@life(return: output)
jil.Place place_with_projection(
    jil.Storage& output,
    jil.Place base_place,
    list.ArrayList<jil.PlaceElem>& projection
) {
    if (base_place.base is .global(global_ref)) {
        return jil.global_place(global_ref, output.projection_array(projection));
    }
    return jil.local_place(base_place.local_id, output.projection_array(projection));
}

@life()
jil.LocalDecl[]& locals_with_frame_local(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId frame_local_id
) {
    unsafe {
        jil.LocalDecl*! locals = output.alloc_local_array(body.locals.length + 1);
        Int index! = 0;
        while (index < body.locals.length) {
            locals[index] = resume_body_source_local(body.locals[index]);
            index = index + 1;
        }
        locals[body.locals.length] = jil.LocalDecl (
            id: frame_local_id,
            kind: jil.LocalKind.param,
            type_id: layout.task_abi.frame_pointer_type_id,
            span: body.span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
        return locals[0..body.locals.length + 1];
    }
}

jil.LocalDecl resume_body_source_local(jil.LocalDecl local) {
    if (local.kind != jil.LocalKind.param) {
        return local;
    }
    return jil.LocalDecl (
        id: local.id,
        kind: jil.LocalKind.compiler_temp,
        type_id: local.type_id,
        span: local.span,
        name: local.name,
        def_id: local.def_id,
        mutable_local: local.mutable_local,
        address_taken: local.address_taken,
        coroutine_capture_task: local.coroutine_capture_task,
        coroutine_capture_kind: local.coroutine_capture_kind
    );
}

@life()
jil.LocalDecl[]& locals_with_resume_return(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId resume_return_local_id,
    jil.LocalId previous_context_local_id,
    jil.LocalId executor_local_id
) {
    unsafe {
        jil.LocalDecl*! locals = output.alloc_local_array(body.locals.length + 3);
        Int index! = 0;
        while (index < body.locals.length) {
            locals[index] = body.locals[index];
            index = index + 1;
        }
        locals[body.locals.length] = jil.LocalDecl (
            id: resume_return_local_id,
            kind: jil.LocalKind.compiler_temp,
            type_id: layout.task_abi.resume_return_type_id,
            span: body.span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
        locals[body.locals.length + 1] = generated_local(
            previous_context_local_id,
            jil.LocalKind.compiler_temp,
            layout.fields[layout.current_executor_field_index].type_id,
            body.span
        );
        locals[body.locals.length + 2] = generated_local(
            executor_local_id,
            jil.LocalKind.compiler_temp,
            layout.fields[layout.current_executor_field_index].type_id,
            body.span
        );
        return locals[0..body.locals.length + 3];
    }
}

@life()
jil.LocalDecl[]& locals_with_return_type(
    jil.Storage& output,
    jil.Body body,
    qid.TypeId return_type
) {
    unsafe {
        jil.LocalDecl*! locals = output.alloc_local_array(body.locals.length);
        Int index! = 0;
        while (index < body.locals.length) {
            locals[index] = body.locals[index];
            index = index + 1;
        }
        jil.LocalDecl return_local = locals[body.return_local.to_index()];
        locals[body.return_local.to_index()] = jil.LocalDecl (
            id: return_local.id,
            kind: return_local.kind,
            type_id: return_type,
            span: return_local.span,
            name: return_local.name,
            def_id: return_local.def_id,
            mutable_local: return_local.mutable_local,
            address_taken: return_local.address_taken,
            coroutine_capture_task: return_local.coroutine_capture_task,
            coroutine_capture_kind: return_local.coroutine_capture_kind
        );
        return locals[0..body.locals.length];
    }
}

@life(return: body & locals)
jil.Body body_with_locals(jil.Body body, jil.LocalDecl[]& locals) {
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: locals,
        blocks: body.blocks,
        entry: body.entry,
        return_local: body.return_local
    );
}

@life(return: body)
jil.Body body_with_id(jil.Body body, jil.FunctionId function_id) {
    return jil.Body (
        id: jil.BodyId.from_index(function_id.to_index()),
        span: body.span,
        locals: body.locals,
        blocks: body.blocks,
        entry: body.entry,
        return_local: body.return_local
    );
}

@life(return: output & body)
jil.Body body_with_return_local_type(
    jil.Storage& output,
    jil.Body body,
    qid.TypeId return_type
) {
    return body_with_locals(body, locals_with_return_type(output, body, return_type));
}

@life(return: body)
jil.Body body_with_return_local(jil.Body body, jil.LocalId return_local) {
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: body.blocks,
        entry: body.entry,
        return_local: return_local
    );
}

@life(return: body & blocks)
jil.Body body_with_blocks(jil.Body body, BlockSlice blocks) {
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: blocks.values,
        entry: body.entry,
        return_local: body.return_local
    );
}

@life(return: (output, output))
jil.Block[]& blocks_with_frame_initializers(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        jil.Block block! = body.blocks[index];
        if (block.id.to_index() == body.entry.to_index()) {
            block = block_with_frame_initializers(output, block, layout, frame_place);
        }
        blocks.add(block);
        index = index + 1;
    }
    return output.block_array(blocks$.ref());
}

@life(return: output & block & layout & frame_place)
jil.Block block_with_frame_initializers(
    jil.Storage& output,
    jil.Block block,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(
        block.statements.length + 1
    );
    statements.add(frame_state_initializer(output, block.span, layout, frame_place));
    Int index! = 0;
    while (index < block.statements.length) {
        statements.add(block.statements[index]);
        index = index + 1;
    }
    return jil.Block (
        id: block.id,
        span: block.span,
        statements: output.statement_array(statements$.ref()),
        terminator: block.terminator
    );
}

@life(return: body)
jil.Body body_with_entry(jil.Body body, jil.BlockId entry) {
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: body.blocks,
        entry: entry,
        return_local: body.return_local
    );
}

@life(return: output)
jil.Statement frame_state_initializer(
    jil.Storage& output,
    token.Span span,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    qid.TypeId state_type = layout.fields[layout.state_field_index].type_id;
    return jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: frame_field_place(output, layout, frame_place, layout.state_field_index),
            value: jil.use_rvalue(jil.UseRvalue (
                value: jil.const_operand_value(jil.Const (
                    type_id: state_type,
                    span: span,
                    value: jil.int_const_kind(jil.IntConst (
                        bits: UInt64(layout.state_dispatch.entry_state_id),
                        signed_value: true
                    ))
                ))
            ))
        ))
    );
}

@life(return: output)
jil.Place frame_field_place(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    Int field_index
) {
    list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(frame_place.projection.length + 1);
    copy_projection(frame_place.projection, projection$.mut_ref());
    projection.add(jil.frame_field_projection_elem(jil.FrameFieldProjection (
        field_index: field_index,
        field_type: layout.fields[field_index].type_id
    )));
    return place_with_projection(output, frame_place, projection$.ref());
}

@life(return: (output, output))
jil.Block[]& state_machine_blocks(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId cancellation_state_local,
    jil.LocalId cancellation_claimed_local,
    jil.LocalId cancellation_context_local,
    jil.LocalId cancellation_result_local,
    jil.LocalId cancellation_tag_local,
    jil.LocalId cancellation_target_local,
    jil.BlockId dispatch_id
) {
    jil.BlockId invalid_state_id = jil.BlockId.from_index(body.blocks.length + 1);
    jil.BlockId state_check_id = jil.BlockId.from_index(body.blocks.length + 2);
    jil.BlockId enabled_check_id = jil.BlockId.from_index(body.blocks.length + 3);
    jil.BlockId observed_request_check_id = jil.BlockId.from_index(body.blocks.length + 4);
    jil.BlockId inherited_context_check_id = jil.BlockId.from_index(body.blocks.length + 5);
    jil.BlockId inherited_request_check_id = jil.BlockId.from_index(body.blocks.length + 6);
    jil.BlockId target_check_id = jil.BlockId.from_index(body.blocks.length + 7);
    jil.BlockId target_claim_id = jil.BlockId.from_index(body.blocks.length + 8);
    jil.BlockId target_dispatch_id = jil.BlockId.from_index(body.blocks.length + 9);
    jil.BlockId target_invoke_id = jil.BlockId.from_index(body.blocks.length + 10);
    jil.BlockId child_enqueue_id = jil.BlockId.from_index(body.blocks.length + 11);
    jil.BlockId child_schedule_id = jil.BlockId.from_index(body.blocks.length + 12);
    jil.BlockId cancel_return_id = jil.BlockId.from_index(body.blocks.length + 13);
    jil.BlockId target_cancel_id = jil.BlockId.from_index(body.blocks.length + 14);
    jil.BlockId claim_id = jil.BlockId.from_index(body.blocks.length + 15);
    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(body.blocks.length + 16);
    Int index! = 0;
    while (index < body.blocks.length) {
        blocks.add(state_machine_block(output, body.blocks[index], layout, frame_place));
        index = index + 1;
    }
    blocks.add(dispatch_block(output, body, layout, frame_place, dispatch_id, invalid_state_id));
    blocks.add(invalid_state_block(output, body.span, invalid_state_id));
    blocks.add(cancellation_state_check_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_state_local,
        state_check_id,
        enabled_check_id,
        dispatch_id
    ));
    blocks.add(cancellation_enabled_check_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_state_local,
        enabled_check_id,
        observed_request_check_id,
        inherited_context_check_id,
        dispatch_id
    ));
    blocks.add(cancellation_request_check_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_state_local,
        observed_request_check_id,
        target_check_id,
        dispatch_id
    ));
    blocks.add(inherited_cancellation_context_check_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_claimed_local,
        cancellation_context_local,
        inherited_context_check_id,
        inherited_request_check_id,
        dispatch_id
    ));
    blocks.add(inherited_cancellation_request_check_block(
        output,
        body,
        layout,
        cancellation_state_local,
        cancellation_context_local,
        inherited_request_check_id,
        target_check_id,
        dispatch_id
    ));
    blocks.add(cancellation_target_check_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_state_local,
        cancellation_context_local,
        target_check_id,
        target_claim_id,
        target_cancel_id
    ));
    blocks.add(cancellation_target_claim_block(
        output,
        body,
        layout,
        cancellation_state_local,
        cancellation_context_local,
        cancellation_claimed_local,
        target_claim_id,
        target_dispatch_id,
        target_check_id
    ));
    blocks.add(cancellation_target_dispatch_block(
        output,
        body,
        layout,
        cancellation_state_local,
        cancellation_tag_local,
        target_dispatch_id,
        target_invoke_id,
        child_enqueue_id
    ));
    blocks.add(cancellation_target_invoke_block(
        output,
        body,
        layout,
        cancellation_state_local,
        cancellation_tag_local,
        cancellation_target_local,
        cancellation_result_local,
        target_invoke_id,
        cancel_return_id
    ));
    blocks.add(cancellation_child_enqueue_block(
        output,
        body,
        layout,
        cancellation_state_local,
        cancellation_context_local,
        child_enqueue_id,
        child_schedule_id,
        target_cancel_id
    ));
    blocks.add(cancellation_child_schedule_block(
        output,
        body,
        layout,
        cancellation_context_local,
        cancellation_result_local,
        child_schedule_id,
        cancel_return_id
    ));
    blocks.add(cancellation_return_block(output, body, cancel_return_id));
    blocks.add(cancellation_target_cancel_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_state_local,
        target_cancel_id,
        claim_id
    ));
    blocks.add(cancellation_claim_block(
        output,
        body,
        layout,
        frame_place,
        cancellation_claimed_local,
        claim_id,
        dispatch_id
    ));
    return output.block_array(blocks$.ref());
}

@life(return: output & block & layout & frame_place)
jil.Block state_machine_block(
    jil.Storage& output,
    jil.Block block,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place
) {
    if (block.terminator.kind is .call_term(call_term)) {
        if (call_term.is_suspend_point) {
            return block_with_state_write(
                output, block, layout, frame_place, suspend_state_for_block(layout, block.id)
            );
        }
    }
    if (block.terminator.kind is .suspend_pending_term(_)) {
        return block_with_state_write(output, block, layout, frame_place, suspend_state_for_block(layout, block.id));
    }
    if (block.terminator.kind is .return_term(_)) {
        return block_with_state_write(output, block, layout, frame_place, layout.state_dispatch.completed_state_id);
    }
    if (block.terminator.kind is .cancel_term(_)) {
        return block_with_state_write(output, block, layout, frame_place, layout.state_dispatch.completed_state_id);
    }
    return block;
}

Int suspend_state_for_block(jil.CoroutineFrameLayout& layout, jil.BlockId block_id) {
    Int index! = 0;
    while (index < layout.suspend_points.length) {
        jil.CoroutineSuspendPoint point = layout.suspend_points[index];
        if (point.block_id.to_index() == block_id.to_index()) {
            return point.state_id;
        }
        index = index + 1;
    }
    return layout.state_dispatch.completed_state_id;
}

@life(return: output & block & layout & frame_place)
jil.Block block_with_state_write(
    jil.Storage& output,
    jil.Block block,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    Int state_id
) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(block.statements.length + 1);
    Int index! = 0;
    while (index < block.statements.length) {
        statements.add(block.statements[index]);
        index = index + 1;
    }
    statements.add(frame_state_write(output, block.terminator.span, layout, frame_place, state_id));
    return jil.Block (
        id: block.id,
        span: block.span,
        statements: output.statement_array(statements$.ref()),
        terminator: block.terminator
    );
}

@life(return: output)
jil.Statement frame_state_write(
    jil.Storage& output,
    token.Span span,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    Int state_id
) {
    return jil.Statement (
        span: span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: frame_field_place(output, layout, frame_place, layout.state_field_index),
            value: jil.use_rvalue(jil.UseRvalue (
                value: jil.const_operand_value(state_const(layout, span, state_id))
            ))
        ))
    );
}

@life(return: output)
jil.Block dispatch_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.BlockId dispatch_id,
    jil.BlockId invalid_state_id
) {
    return jil.Block (
        id: dispatch_id,
        span: body.span,
        statements: output.empty_statements(),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.switch_terminator_kind(jil.SwitchTerminator (
                discriminator: jil.copy_operand_value(jil.CopyOperand (
                    place: frame_field_place(output, layout, frame_place, layout.state_field_index)
                )),
                cases: dispatch_cases(output, body, layout),
                default_target: invalid_state_id
            ))
        )
    );
}

@life(return: output)
jil.Block cancellation_state_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId state_local,
    jil.BlockId id,
    jil.BlockId enabled_check_id,
    jil.BlockId dispatch_id
) {
    jil.Place state_place = jil.local_place(state_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(assign_copy_statement(
        output,
        state_place,
        frame_field_place(output, layout, frame_place, layout.state_field_index),
        body.span
    ));
    return switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: state_place)),
        state_const(layout, body.span, layout.state_dispatch.completed_state_id),
        dispatch_id,
        enabled_check_id
    );
}

@life(return: output)
jil.Block cancellation_request_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId state_local,
    jil.BlockId id,
    jil.BlockId claim_id,
    jil.BlockId dispatch_id
) {
    jil.Place state_place = jil.local_place(state_local, output.empty_projection());
    jil.Place request_place = cancellation_request_place(output, layout, frame_place);
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: state_place,
            value: jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: request_place,
                mode: .coroutine_atomic
            ))
        ))
    ));
    return switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: state_place)),
        state_const(layout, body.span, 1),
        claim_id,
        dispatch_id
    );
}

@life(return: output)
jil.Block cancellation_enabled_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId state_local,
    jil.BlockId id,
    jil.BlockId observed_request_check_id,
    jil.BlockId inherited_context_check_id,
    jil.BlockId dispatch_id
) {
    jil.Place state_place = jil.local_place(state_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(assign_copy_statement(
        output,
        state_place,
        frame_field_place(output, layout, frame_place, layout.cancellation_enabled_field_index),
        body.span
    ));
    list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(3);
    cases.add(jil.SwitchCase (
        value: state_const(layout, body.span, 1),
        target: observed_request_check_id
    ));
    cases.add(jil.SwitchCase (
        value: state_const(layout, body.span, 2),
        target: inherited_context_check_id
    ));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.switch_terminator_kind(jil.SwitchTerminator (
                discriminator: jil.copy_operand_value(jil.CopyOperand (place: state_place)),
                cases: output.switch_case_array(cases$.ref()),
                default_target: dispatch_id
            ))
        )
    );
}

@life(return: output)
jil.Block inherited_cancellation_context_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId present_local,
    jil.LocalId context_local,
    jil.BlockId id,
    jil.BlockId request_check_id,
    jil.BlockId dispatch_id
) {
    jil.Place present_place = jil.local_place(present_local, output.empty_projection());
    jil.Place context_place = jil.local_place(context_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(2);
    statements.add(assign_copy_statement(
        output,
        context_place,
        frame_field_place(output, layout, frame_place, layout.cancellation_context_field_index),
        body.span
    ));
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: present_place,
            value: jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.ne,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: context_place)),
                rhs: jil.const_operand_value(cancellation_context_null_const(layout, body.span))
            ))
        ))
    ));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.branch_terminator_kind(jil.BranchTerminator (
                condition: jil.copy_operand_value(jil.CopyOperand (place: present_place)),
                then_target: request_check_id,
                else_target: dispatch_id
            ))
        )
    );
}

@life(return: output)
jil.Block inherited_cancellation_request_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId context_local,
    jil.BlockId id,
    jil.BlockId target_check_id,
    jil.BlockId dispatch_id
) {
    jil.Place state_place = jil.local_place(state_local, output.empty_projection());
    jil.Place request_place = cancellation_request_place_from_context(
        output, layout, context_local
    );
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: state_place,
            value: jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: request_place,
                mode: .coroutine_atomic
            ))
        ))
    ));
    return switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: state_place)),
        state_const(layout, body.span, 1),
        target_check_id,
        dispatch_id
    );
}

jil.Const cancellation_context_null_const(
    jil.CoroutineFrameLayout& layout,
    token.Span span
) {
    return jil.Const (
        type_id: layout.fields[layout.cancellation_context_field_index].type_id,
        span: span,
        value: jil.null_const_kind(jil.NullConst (typed_null: true))
    );
}

@life(return: output)
jil.Place cancellation_request_place_from_context(
    jil.Storage& output,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId local_id
) {
    return task_state_field_from_context(
        output, local_id, layout.task_abi.cancellation_requested_field
    );
}

jil.Place task_state_field_from_context(
    jil.Storage& output,
    jil.LocalId local_id,
    jil.AggregateField field
) {
    list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(2);
    projection.add(jil.deref_projection_elem(jil.DerefProjection (raw_pointer: true)));
    projection.add(jil.constant_index_projection_elem(jil.ConstantIndexProjection (
        offset: field.index
    )));
    return jil.local_place(local_id, output.projection_array(projection$.ref()));
}

@life(return: output)
jil.Block cancellation_target_check_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
    jil.LocalId state_local,
    jil.LocalId context_local,
    jil.BlockId id,
    jil.BlockId target_claim_id,
    jil.BlockId cancellation_claim_id
) {
    jil.Place state = jil.local_place(state_local, output.empty_projection());
    jil.Place context = jil.local_place(context_local, output.empty_projection());
    jil.Place target = task_state_field_from_context(
        output, context_local, layout.task_abi.cancel_target_word_field
    );
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(2);
    statements.add(assign_copy_statement(
        output,
        context,
        frame_field_place(output, layout, frame_place, layout.cancellation_context_field_index),
        body.span
    ));
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: state,
            value: jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: target,
                mode: .coroutine_atomic
            ))
        ))
    ));
    list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(2);
    cases.add(jil.SwitchCase (
        value: state_const(layout, body.span, 0), target: cancellation_claim_id
    ));
    cases.add(jil.SwitchCase (
        value: state_const(layout, body.span, 2), target: cancellation_claim_id
    ));
    cases.add(jil.SwitchCase (
        value: state_const(layout, body.span, 3), target: cancellation_claim_id
    ));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.switch_terminator_kind(jil.SwitchTerminator (
                discriminator: jil.copy_operand_value(jil.CopyOperand (place: state)),
                cases: output.switch_case_array(cases$.ref()),
                default_target: target_claim_id
            ))
        )
    );
}

@life(return: output)
jil.Block cancellation_target_claim_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId context_local,
    jil.LocalId claimed_local,
    jil.BlockId id,
    jil.BlockId dispatch_id,
    jil.BlockId retry_id
) {
    jil.Place state = jil.local_place(state_local, output.empty_projection());
    jil.Place claimed = jil.local_place(claimed_local, output.empty_projection());
    jil.Place target = task_state_field_from_context(
        output, context_local, layout.task_abi.cancel_target_word_field
    );
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: claimed,
            value: jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: target,
                expected: jil.copy_operand_value(jil.CopyOperand (place: state)),
                desired: jil.const_operand_value(state_const(layout, body.span, 2)),
                mode: .coroutine_atomic
            ))
        ))
    ));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.branch_terminator_kind(jil.BranchTerminator (
                condition: jil.copy_operand_value(jil.CopyOperand (place: claimed)),
                then_target: dispatch_id,
                else_target: retry_id
            ))
        )
    );
}

@life(return: output)
jil.Block cancellation_target_dispatch_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId tag_local,
    jil.BlockId id,
    jil.BlockId invoke_id,
    jil.BlockId child_id
) {
    jil.Place tag = jil.local_place(tag_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: tag,
            value: jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_and,
                lhs: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(state_local, output.empty_projection())
                )),
                rhs: jil.const_operand_value(state_const(layout, body.span, 1))
            ))
        ))
    ));
    return switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: tag)),
        state_const(layout, body.span, 1),
        invoke_id,
        child_id
    );
}

@life(return: output)
jil.Block cancellation_target_invoke_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId tag_local,
    jil.LocalId target_local,
    jil.LocalId result_local,
    jil.BlockId id,
    jil.BlockId return_id
) {
    jil.Place tag = jil.local_place(tag_local, output.empty_projection());
    jil.Place target = jil.local_place(target_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(2);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: tag,
            value: jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.sub,
                lhs: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(state_local, output.empty_projection())
                )),
                rhs: jil.const_operand_value(state_const(layout, body.span, 1))
            ))
        ))
    ));
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: target,
            value: jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (place: tag)),
                target_type: layout.task_abi.suspend_layout.pointer_type_id
            ))
        ))
    ));
    jil.Place record = deref_frame_pointer_place(output, target_local);
    jil.Place function = task_abi.projected_field_place(
        output, record, layout.task_abi.suspend_layout.handler_function_field_index
    );
    jil.Place context = task_abi.projected_field_place(
        output, record, layout.task_abi.suspend_layout.handler_context_field_index
    );
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
    args.add(jil.copy_operand_value(jil.CopyOperand (place: context)));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.call_terminator_kind(jil.CallTerminator (
                callee: jil.indirect_operand_callee(
                    jil.copy_operand_value(jil.CopyOperand (place: function))
                ),
                args: output.operand_array(args$.ref()),
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: jil.local_place(result_local, output.empty_projection()),
                target: return_id,
                initialized_place: null,
                exclusive_places: output.empty_places(),
                cleanup: null
            ))
        )
    );
}

@life(return: output & body & layout)
jil.Block cancellation_child_enqueue_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId state_local,
    jil.LocalId context_local,
    jil.BlockId id,
    jil.BlockId schedule_id,
    jil.BlockId completed_id
) {
    jil.Place state = jil.local_place(state_local, output.empty_projection());
    jil.Place child = jil.local_place(context_local, output.empty_projection());
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(3);
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: child,
            value: jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: jil.local_place(state_local, output.empty_projection())
                )),
                target_type: layout.fields[layout.cancellation_context_field_index].type_id
            ))
        ))
    ));
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.atomic_store_statement_kind(jil.AtomicStoreStatement (
            destination: task_state_field_from_context(
                output, context_local, layout.task_abi.cancellation_requested_field
            ),
            value: jil.const_operand_value(state_const(layout, body.span, 1)),
            mode: .coroutine_atomic
        ))
    ));
    // 子 Task 可能在父级取得目标后完成；此时不能再等待一次不会发生的唤醒。
    statements.add(jil.Statement (
        span: body.span,
        kind: jil.assign_statement_kind(jil.AssignStatement (
            destination: state,
            value: jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: task_state_field_from_context(
                    output, context_local, layout.task_abi.state_field
                ),
                mode: .coroutine_atomic
            ))
        ))
    ));
    return completed_state_switch_block(
        output,
        id,
        body.span,
        statements$.ref(),
        jil.copy_operand_value(jil.CopyOperand (place: state)),
        layout,
        completed_id,
        schedule_id
    );
}

@life(return: output)
jil.Block cancellation_child_schedule_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.LocalId context_local,
    jil.LocalId result_local,
    jil.BlockId id,
    jil.BlockId return_id
) {
    jil.Place frame = task_state_field_from_context(
        output, context_local, layout.task_abi.frame_field
    );
    jil.Place resume = task_state_field_from_context(
        output, context_local, layout.task_abi.resume_function_field
    );
    jil.Place executor = task_state_field_from_context(
        output, context_local, layout.task_abi.execution_executor_field
    );
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
    args.add(jil.copy_operand_value(jil.CopyOperand (place: frame)));
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.empty_statements(),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.call_terminator_kind(jil.CallTerminator (
                callee: jil.dynamic_task_enqueue_callee(
                    jil.copy_operand_value(jil.CopyOperand (place: executor)),
                    jil.copy_operand_value(jil.CopyOperand (
                        place: jil.local_place(context_local, output.empty_projection())
                    )),
                    jil.copy_operand_value(jil.CopyOperand (place: resume)),
                    false
                ),
                args: output.operand_array(args$.ref()),
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: jil.local_place(result_local, output.empty_projection()),
                target: return_id,
                initialized_place: null,
                exclusive_places: output.empty_places(),
                cleanup: null
            ))
        )
    );
}

@life(return: output)
jil.Block cancellation_return_block(
    jil.Storage& output,
    jil.Body body,
    jil.BlockId id
) {
    return jil.Block (
        id: id,
        span: body.span,
        statements: output.empty_statements(),
        terminator: jil.Terminator (
            span: body.span,
            kind: jil.suspend_pending_terminator_kind(jil.SuspendPendingTerminator (
                target: id,
                suspend_wake: .none
            ))
        )
    );
}

@life(return: output)
jil.Block cancellation_target_cancel_block(
    jil.Storage& output,
    jil.Body body,
    jil.CoroutineFrameLayout& layout,
    jil.Place frame_place,
