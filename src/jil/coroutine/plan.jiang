// 保存每个 JIL 协程实例的代码生成计划。
//
// 分析阶段只在这里记录可选执行入口，后续 frame layout、Task root 选择和
// resume 生成消费同一份计划，避免为同一个函数维护多张并行 shim 表。

import table = "../../support/table.jiang";
import jil = "../model.jiang";

public struct FunctionPlan: Copyable {
    public jil.FunctionId? confined_resume;
    public jil.FunctionId? rtc_resume;
}

public struct Store: Movable {
    table.HashTable<jil.FunctionKey, FunctionPlan> functions;

    public init(self) {
        self.functions = table.HashTable<jil.FunctionKey, FunctionPlan>();
    }

    public FunctionPlan get(self, jil.FunctionKey key) {
        if (table.hash_table_get_value<jil.FunctionKey, FunctionPlan>(
                self.functions$.ref(), key
            ) is .some(value)
        ) {
            return value;
        }
        return FunctionPlan (
            confined_resume: null,
            rtc_resume: null
        );
    }

    public () set_confined_resume(
        self,
        jil.FunctionKey key,
        jil.FunctionId resume
    ) {
        FunctionPlan value! = self.get(key);
        value.confined_resume = resume;
        self.functions.set(key, value);
    }

    public () set_rtc_resume(
        self,
        jil.FunctionKey key,
        jil.FunctionId resume
    ) {
        FunctionPlan value! = self.get(key);
        value.rtc_resume = resume;
        self.functions.set(key, value);
    }

}
