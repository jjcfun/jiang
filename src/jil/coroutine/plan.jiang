// 保存每个 JIL 协程实例的代码生成计划。
//
// 分析阶段只在这里记录可选执行入口，后续 frame layout、Task root 选择和
// resume 生成消费同一份计划，避免为同一个函数维护多张并行 shim 表。

import map = "../../support/map.jiang";
import jil = "../model.jiang";

public struct FunctionPlan: Copyable {
    public jil.MonoItem? confined_resume;
    public jil.MonoItem? rtc_resume;
}

public struct Store: Movable {
    map.WyHashMap<Int, FunctionPlan> functions!;

    public init(self) {
        self.functions = map.WyHashMap<Int, FunctionPlan>();
    }

    public FunctionPlan get(self, jil.MonoItem item) {
        if (self.functions.get(jil.mono_item_identity(item)) is .some(value)) {
            return value$.get();
        }
        return FunctionPlan (
            confined_resume: null,
            rtc_resume: null
        );
    }

    public Void set_confined_resume(
        Self&! self,
        jil.MonoItem item,
        jil.MonoItem resume
    ) {
        FunctionPlan previous = self.get(item);
        self.functions.set(jil.mono_item_identity(item), FunctionPlan (
            confined_resume: resume,
            rtc_resume: previous.rtc_resume
        ));
    }

    public Void set_rtc_resume(
        Self&! self,
        jil.MonoItem item,
        jil.MonoItem resume
    ) {
        FunctionPlan previous = self.get(item);
        self.functions.set(jil.mono_item_identity(item), FunctionPlan (
            confined_resume: previous.confined_resume,
            rtc_resume: resume
        ));
    }

}
