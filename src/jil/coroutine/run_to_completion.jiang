// 构造无等待 coroutine DAG 的同步执行变体。
//
// RTC resume 仍接收现有 frame pointer 并把结果写入 continuation_result，
// 但完成时直接返回调用者。这样静态 direct child 可以成为普通可内联调用；
// recursive start shim、Task suspend 和任何真实 wake 边都不会进入该 ABI。

import list = "../../support/list.jiang";
import compiler_store = "../../store.jiang";
import qid = "../../id.jiang";
import jil = "../model.jiang";
import instance_reader = "../instance_reader.jiang";
import plan = "./plan.jiang";

public list.ArrayList<Bool> analyze(
    compiler_store.CompilerStore& store,
    jil.Program& program,
    jil.Storage& storage
) {
    list.ArrayList<Bool> eligible! = initial_eligibility(store, program, storage);
    Bool changed! = true;
    while (changed) {
        changed = refine_eligibility(
            store, program, storage, eligible$.mut_ref()
        );
    }
    return eligible;
}

list.ArrayList<Bool> initial_eligibility(
    compiler_store.CompilerStore& store,
    jil.Program& program,
    jil.Storage& storage
) {
    list.ArrayList<Bool> eligible! =
        list.ArrayList<Bool>(program.mono_item_count());
    Int index! = 0;
    while (index < program.mono_item_count()) {
        jil.MonoItem item = program.mono_item_at(index);
        eligible.add(mono_item_has_rtc_shape(
            store, program, storage, item
        ));
        index = index + 1;
    }
    return eligible;
}

Bool mono_item_has_rtc_shape(
    compiler_store.CompilerStore& store,
    jil.Program& program,
    jil.Storage& storage,
    jil.MonoItem item
) {
    if (item is .source_instance(identity)) {
        return function_has_rtc_shape(
            program,
            storage,
            item,
            instance_reader.source_instance_function(store, program, identity)
        );
    }
    guard item is .generated_function(function_id) else { return false; }
    return function_has_rtc_shape(
        program, storage, item, program.function(function_id)
    );
}

Bool function_has_rtc_shape(
    jil.Program& program,
    jil.Storage& storage,
    jil.MonoItem item,
    jil.Function function
) {
    if (!function.is_coroutine || function.is_external) { return false; }
    guard program.coroutine_frame_for_mono_item(item) is .some(frame) else {
        return false;
    }
    if (frame.may_defer) { return false; }
    Int index! = 0;
    while (index < function.body.blocks.length) {
        if (!terminator_has_rtc_shape(
                program, storage, frame$.ref(), function.body.blocks[index].terminator
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool terminator_has_rtc_shape(
    jil.Program& program,
    jil.Storage& storage,
    jil.CoroutineFrameLayout& frame,
    jil.Terminator terminator
) {
    if (terminator.kind is .suspend_pending_term(suspend)) {
        return task_suspend_completes_inline(program, storage, frame, suspend);
    }
    guard terminator.kind is .call_term(call) else { return true; }
    if (!call.is_suspend_point) {
        return observed_task_has_static_child(call);
    }
    guard call.suspend_child is .some(child) else { return false; }
    if (call.suspend_wake != .direct_child && call.suspend_wake != .cross_executor) {
        return false;
    }
    return call_directly_names_child(call.callee, child);
}

Bool observed_task_has_static_child(jil.CallTerminator call) {
    guard call.async_start is .some(kind) else { return true; }
    if (kind != .observed_task) { return true; }
    guard call.suspend_child is .some(child) else { return false; }
    return call_directly_names_child(call.callee, child);
}

Bool refine_eligibility(
    compiler_store.CompilerStore& store,
    jil.Program& program,
    jil.Storage& storage,
    list.ArrayList<Bool>&! eligible
) {
    Bool changed! = false;
    Int index! = 0;
    while (index < program.mono_item_count()) {
        jil.MonoItem item = program.mono_item_at(index);
        if (eligible.get(index) && !children_are_eligible(
                store, program, storage, item, eligible
            )
        ) {
            eligible.set(index, false);
            changed = true;
        }
        index = index + 1;
    }
    return changed;
}

Bool children_are_eligible(
    compiler_store.CompilerStore& store,
    jil.Program& program,
    jil.Storage& storage,
    jil.MonoItem item,
    list.ArrayList<Bool>& eligible
) {
    if (item is .source_instance(identity)) {
        return function_children_are_eligible(
            program,
            storage,
            item,
            instance_reader.source_instance_function(store, program, identity),
            eligible
        );
    }
    guard item is .generated_function(function_id) else { return false; }
    return function_children_are_eligible(
        program, storage, item, program.function(function_id), eligible
    );
}

Bool function_children_are_eligible(
    jil.Program& program,
    jil.Storage& storage,
    jil.MonoItem item,
    jil.Function function,
    list.ArrayList<Bool>& eligible
) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        jil.Terminator terminator = function.body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (!call_child_is_eligible(program, storage, call, eligible)) { return false; }
        }
        if (terminator.kind is .suspend_pending_term(suspend)) {
            if (!task_suspend_child_is_eligible(
                    program, storage, item, suspend, eligible
                )
            ) { return false; }
        }
        index = index + 1;
    }
    return true;
}

Bool call_child_is_eligible(
    jil.Program& program,
    jil.Storage& storage,
    jil.CallTerminator call,
    list.ArrayList<Bool>& eligible
) {
    Bool observed! = false;
    if (call.async_start is .some(kind)) { observed = kind == .observed_task; }
    if (!call.is_suspend_point && !observed) { return true; }
    guard call.suspend_child is .some(child) else { return false; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(item) else { return false; }
    return function_is_eligible(program, eligible, item);
}

Bool task_suspend_child_is_eligible(
    jil.Program& program,
    jil.Storage& storage,
    jil.MonoItem item,
    jil.SuspendPendingTerminator suspend,
    list.ArrayList<Bool>& eligible
) {
    if (suspend.suspend_wake != .task_child) { return false; }
    guard program.coroutine_frame_for_mono_item(item) is .some(frame) else {
        return false;
    }
    guard task_region(frame$.ref(), suspend) is .some(region) else { return false; }
    guard region.child_resume is .some(child) else { return false; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(child_item) else { return false; }
    return function_is_eligible(program, eligible, child_item);
}

public Bool function_is_eligible(
    jil.Program& program,
    list.ArrayList<Bool>& eligible,
    jil.MonoItem item
) {
    guard program.mono_item_index(item) is .some(index) else { return false; }
    return index >= 0 && index < eligible.len() && eligible.get(index);
}

@life(return: call)
public jil.FunctionRef? eligible_child(
    jil.Program& program,
    jil.Storage& storage,
    list.ArrayList<Bool>& eligible,
    jil.CallTerminator call
) {
    if (!call.is_suspend_point) { return null; }
    guard call.suspend_child is .some(child) else { return null; }
    if (!call_directly_names_child(call.callee, child)) { return null; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(item) else { return null; }
    if (!function_is_eligible(program, eligible, item)) { return null; }
    return child;
}

@life(return: storage & body)
public jil.Body rewrite_body(
    jil.Program& program,
    jil.Storage& storage,
    jil.Body body,
    jil.CoroutineFrameLayout& frame,
    plan.Store& plans
) {
    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        blocks.add(rewrite_block(program, storage, body.blocks[index], frame, plans));
        index = index + 1;
    }
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: storage.block_array(blocks$.ref()),
        entry: body.entry,
        return_local: body.return_local
    );
}

public Bool body_uses_rtc(
    jil.Program& program,
    jil.Storage& storage,
    jil.Body body,
    jil.CoroutineFrameLayout& frame,
    plan.Store& plans
) {
    Int index! = 0;
    while (index < body.blocks.length) {
        jil.Terminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (call_uses_rtc(program, call, plans)) { return true; }
        }
        if (terminator.kind is .suspend_pending_term(suspend)) {
            if (task_suspend_completes_inline(program, storage, frame, suspend)) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

public Bool body_has_direct_rtc_child(
    jil.Program& program,
    jil.Body body,
    plan.Store& plans
) {
    Int index! = 0;
    while (index < body.blocks.length) {
        jil.Terminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (direct_call_uses_rtc(program, call, plans)) { return true; }
        }
        index = index + 1;
    }
    return false;
}

public Bool body_has_cross_executor_child(jil.Body body) {
    Int index! = 0;
    while (index < body.blocks.length) {
        jil.Terminator terminator = body.blocks[index].terminator;
        if (terminator.kind is .call_term(call)) {
            if (call.is_suspend_point && call.suspend_wake == .cross_executor) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

@life(return: storage & body)
public jil.Body rewrite_direct_rtc_children(
    jil.Program& program,
    jil.Storage& storage,
    jil.Body body,
    plan.Store& plans
) {
    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(body.blocks.length);
    Int index! = 0;
    while (index < body.blocks.length) {
        jil.Block block = body.blocks[index];
        blocks.add(jil.Block (
            id: block.id,
            span: block.span,
            statements: block.statements,
            terminator: direct_rtc_terminator(program, storage, block.terminator, plans)
        ));
        index = index + 1;
    }
    return jil.Body (
        id: body.id,
        span: body.span,
        locals: body.locals,
        blocks: storage.block_array(blocks$.ref()),
        entry: body.entry,
        return_local: body.return_local
    );
}

Bool direct_call_uses_rtc(
    jil.Program& program,
    jil.CallTerminator call,
    plan.Store& plans
) {
    if (call.suspend_wake != .direct_child) { return false; }
    return call_uses_rtc(program, call, plans);
}

@life(return: storage & terminator & plans)
jil.Terminator direct_rtc_terminator(
    jil.Program& program,
    jil.Storage& storage,
    jil.Terminator terminator,
    plan.Store& plans
) {
    guard terminator.kind is .call_term(call) else { return terminator; }
    if (!direct_call_uses_rtc(program, call, plans)) { return terminator; }
    return rewrite_rtc_call(program, storage, terminator, plans);
}

Bool call_uses_rtc(
    jil.Program& program,
    jil.CallTerminator call,
    plan.Store& plans
) {
    guard call.suspend_child is .some(child) else { return false; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(item) else { return false; }
    return plans.get(item).rtc_resume != null;
}

@life(return: storage & block & frame & plans)
jil.Block rewrite_block(
    jil.Program& program,
    jil.Storage& storage,
    jil.Block block,
    jil.CoroutineFrameLayout& frame,
    plan.Store& plans
) {
    return jil.Block (
        id: block.id,
        span: block.span,
        statements: block.statements,
        terminator: rewrite_terminator(
            program, storage, block.terminator, frame, plans
        )
    );
}

@life(return: storage & terminator & frame & plans)
jil.Terminator rewrite_terminator(
    jil.Program& program,
    jil.Storage& storage,
    jil.Terminator terminator,
    jil.CoroutineFrameLayout& frame,
    plan.Store& plans
) {
    if (terminator.kind is .suspend_pending_term(suspend)) {
        if (task_suspend_completes_inline(program, storage, frame, suspend)) {
            return jil.Terminator (
                span: terminator.span,
                kind: jil.goto_terminator_kind(jil.GotoTerminator (
                    target: suspend.target
                ))
            );
        }
        return terminator;
    }
    return rewrite_rtc_call(program, storage, terminator, plans);
}

@life(return: storage & terminator & plans)
jil.Terminator rewrite_rtc_call(
    jil.Program& program,
    jil.Storage& storage,
    jil.Terminator terminator,
    plan.Store& plans
) {
    guard terminator.kind is .call_term(call) else { return terminator; }
    guard call.suspend_child is .some(child) else { return terminator; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(item) else { return terminator; }
    guard plans.get(item).rtc_resume is .some(variant_item) else { return terminator; }
    jil.FunctionRef variant = rtc_variant_function_ref(
        program, storage, child, variant_item
    );
    return jil.Terminator (
        span: terminator.span,
        kind: jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.direct_function_callee(variant),
            args: call.args,
            current_effects: call.current_effects,
            is_suspend_point: false,
            destination: call.destination,
            target: call.target,
            initialized_place: call.initialized_place,
            exclusive_places: call.exclusive_places,
            cleanup: call.cleanup
        ))
    );
}

@life(return: storage)
jil.FunctionRef rtc_variant_function_ref(
    jil.Program& program,
    jil.Storage& storage,
    jil.FunctionRef source,
    jil.MonoItem variant
) {
    if (variant is .source_resume_instance(resume)) {
        return jil.FunctionRef(
            target: source.target,
            dispatch_type: source.dispatch_type,
            args: storage.generic_arg_array(source.args),
            coroutine_resume: true,
            coroutine_resume_mode: resume.mode,
            coroutine_completion: false,
            type_id: source.type_id
        );
    }
    guard variant is .generated_function(variant_id) else {
        assert(false, "invalid RTC coroutine variant");
        return jil.FunctionRef(
            target: source.target,
            dispatch_type: source.dispatch_type,
            args: storage.generic_arg_array(source.args),
            coroutine_resume: source.coroutine_resume,
            coroutine_resume_mode: source.coroutine_resume_mode,
            coroutine_completion: source.coroutine_completion,
            coroutine_serial_completion: source.coroutine_serial_completion,
            type_id: source.type_id
        );
    }
    jil.Function reserved = program.function(variant_id);
    return jil.FunctionRef(
        target: .generated(program.generated_function_target(variant_id)),
        args: storage.generic_arg_array(reserved.args),
        coroutine_resume: false,
        coroutine_completion: false,
        type_id: source.type_id
    );
}

Bool task_suspend_completes_inline(
    jil.Program& program,
    jil.Storage& storage,
    jil.CoroutineFrameLayout& frame,
    jil.SuspendPendingTerminator suspend
) {
    if (suspend.suspend_wake != .task_child) { return false; }
    guard task_region(frame, suspend) is .some(region) else { return false; }
    if (region.storage.sync != .local_serial) { return false; }
    guard region.child_resume is .some(child) else { return false; }
    guard program.coroutine_source_item_for_ref(child)
        is .some(item) else { return false; }
    guard program.coroutine_frame_for_mono_item(item) is .some(child_frame) else {
        return false;
    }
    return !child_frame.may_defer;
}

jil.TaskRegion? task_region(
    jil.CoroutineFrameLayout& frame,
    jil.SuspendPendingTerminator suspend
) {
    guard suspend.task_local is .some(task_local) else { return null; }
    Int index! = 0;
    while (index < frame.task_regions.length) {
        jil.TaskRegion region = frame.task_regions[index];
        if (region.task_local == task_local) { return region; }
        index = index + 1;
    }
    return null;
}

Bool call_directly_names_child(
    jil.CallCallee callee,
    jil.FunctionRef child
) {
    if (callee is .direct_function(function_ref)) {
        return function_ref_equal(function_ref, child);
    }
    if (callee is .domain_enqueue(enqueue)) {
        guard enqueue.resume is .function_operand(function_ref) else { return false; }
        return function_ref_equal(function_ref, child);
    }
    return false;
}

Bool function_ref_equal(jil.FunctionRef lhs, jil.FunctionRef rhs) {
    if (lhs.coroutine_start != rhs.coroutine_start) { return false; }
    if (lhs.coroutine_sync != rhs.coroutine_sync) { return false; }
    if (lhs.coroutine_resume != rhs.coroutine_resume) { return false; }
    if (lhs.coroutine_resume_mode != rhs.coroutine_resume_mode) { return false; }
    if (lhs.coroutine_completion != rhs.coroutine_completion) { return false; }
    if (lhs.coroutine_serial_completion != rhs.coroutine_serial_completion) {
        return false;
    }
    if (!jil.function_target_equal(lhs.target, rhs.target)) { return false; }
    qid.DefId lhs_def = jil.function_target_provenance_def(lhs.target);
    qid.DefId rhs_def = jil.function_target_provenance_def(rhs.target);
    jil.InstanceKey left = jil.InstanceKey(lhs_def, lhs.args);
    jil.InstanceKey right = jil.InstanceKey(rhs_def, rhs.args);
    return jil.InstanceKey.equal(left$.ref(), right$.ref());
}
