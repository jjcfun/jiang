// 收集 JIL 中结构化 Task 的词法 origin、消费和 cleanup 位置。
// storage plan 是编译期事实，backend 不再从 allocation pointer 猜测所有权。

import list = "../../support/list.jiang";
import jil = "../model.jiang";

public struct DisjointnessCache: Movable {
    Int*! states!;
    Int region_count;

    public init(self, Int region_count) {
        unsafe {
            self.region_count = region_count;
            self.states = Int$.alloc(region_count * region_count);
            Int index! = 0;
            while (index < region_count * region_count) {
                self.states[index] = -1;
                index = index + 1;
            }
        }
    }

    public Bool regions_do_not_overlap(
        Self&! self,
        jil.Body body,
        jil.TaskRegion[]& regions,
        Int lhs_index,
        Int rhs_index
    ) {
        unsafe {
            Int index = lhs_index * self.region_count + rhs_index;
            Int state = self.states[index];
            if (state >= 0) { return state == 1; }
            Bool disjoint = regions_do_not_overlap(body, regions[lhs_index], regions[rhs_index]);
            Int value! = 0;
            if (disjoint) { value = 1; }
            self.states[index] = value;
            self.states[rhs_index * self.region_count + lhs_index] = value;
            return disjoint;
        }
    }

    deinit(self) {
        if (self.region_count > 0) {
            unsafe { self.states$.dealloc(); }
        }
    }
}

@life(return: (output, output))
public jil.TaskRegion[]& analyze(jil.Store& output, jil.Body body) {
    list.ArrayList<jil.TaskRegion> regions! = list.ArrayList<jil.TaskRegion>();
    collect_origins(body, regions$.mut_ref());
    collect_uses(body, regions$.mut_ref());
    return output.task_region_array(regions$.ref());
}

Void collect_origins(jil.Body body, list.ArrayList<jil.TaskRegion>&! regions) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        jil.Block block = body.blocks[block_index];
        collect_block_origins(block, regions);
        block_index = block_index + 1;
    }
}

Void collect_block_origins(jil.Block block, list.ArrayList<jil.TaskRegion>&! regions) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        jil.Statement statement = block.statements[statement_index];
        if (statement.kind is .task_region_start_stmt(start)) {
            append_origin(block.id, statement_index, start, regions);
        }
        statement_index = statement_index + 1;
    }
}

Void append_origin(
    jil.BlockId block_id,
    Int statement_index,
    jil.TaskRegionStartStatement start,
    list.ArrayList<jil.TaskRegion>&! regions
) {
    regions.add(jil.TaskRegion (
        task_local: start.task_local,
        origin_block: block_id,
        origin_statement_index: statement_index,
        release_block: null,
        release_statement_index: -1,
        consume_count: 0,
        release_count: 0,
        storage: start.storage,
        child_resume: start.child_resume
    ));
}

Void collect_uses(jil.Body body, list.ArrayList<jil.TaskRegion>&! regions) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        jil.Block block = body.blocks[block_index];
        collect_block_uses(block, regions);
        block_index = block_index + 1;
    }
}

Void collect_block_uses(jil.Block block, list.ArrayList<jil.TaskRegion>&! regions) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        collect_statement_use(
            block.id, statement_index, block.statements[statement_index], regions
        );
        statement_index = statement_index + 1;
    }
}

Void collect_statement_use(
    jil.BlockId block_id,
    Int statement_index,
    jil.Statement statement,
    list.ArrayList<jil.TaskRegion>&! regions
) {
    if (statement.kind is .task_consume_stmt(consume)) {
        increment_region(regions, consume.task_local, true);
        return;
    }
    if (statement.kind is .task_release_stmt(release)) {
        record_release(regions, release.task_local, block_id, statement_index);
    }
}

Void increment_region(
    list.ArrayList<jil.TaskRegion>&! regions,
    jil.LocalId? task,
    Bool consumed
) {
    guard task is .some(task_local) else { return; }
    Int index! = 0;
    while (index < regions.len()) {
        jil.TaskRegion region! = regions.get(index);
        if (region.task_local == task_local) {
            if (consumed) { region.consume_count = region.consume_count + 1; }
            else { region.release_count = region.release_count + 1; }
            regions.set(index, region);
            return;
        }
        index = index + 1;
    }
}

Void record_release(
    list.ArrayList<jil.TaskRegion>&! regions,
    jil.LocalId? task,
    jil.BlockId block_id,
    Int statement_index
) {
    guard task is .some(task_local) else { return; }
    Int index! = 0;
    while (index < regions.len()) {
        jil.TaskRegion region! = regions.get(index);
        if (region.task_local == task_local) {
            region.release_count = region.release_count + 1;
            if (region.release_count == 1) {
                region.release_block = block_id;
                region.release_statement_index = statement_index;
            }
            regions.set(index, region);
            return;
        }
        index = index + 1;
    }
}

public Bool regions_do_not_overlap(
    jil.Body body,
    jil.TaskRegion lhs,
    jil.TaskRegion rhs
) {
    if (region_precedes(body, lhs, rhs)) { return true; }
    return region_precedes(body, rhs, lhs);
}

Bool region_precedes(
    jil.Body body,
    jil.TaskRegion earlier,
    jil.TaskRegion later
) {
    if (earlier.release_count == 0) { return false; }
    if (earlier.release_count == 1) {
        guard earlier.release_block is .some(release_block) else { return false; }
        return release_precedes_origin(
            body, release_block, earlier.release_statement_index, later
        );
    }
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        if (block_has_preceding_release(body, body.blocks[block_index], earlier, later)) {
            return true;
        }
        block_index = block_index + 1;
    }
    return false;
}

Bool block_has_preceding_release(
    jil.Body body,
    jil.Block block,
    jil.TaskRegion earlier,
    jil.TaskRegion later
) {
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        jil.Statement statement = block.statements[statement_index];
        if (statement_releases_task(statement, earlier.task_local)) {
            if (release_precedes_origin(body, block.id, statement_index, later)) { return true; }
        }
        statement_index = statement_index + 1;
    }
    return false;
}

Bool statement_releases_task(jil.Statement statement, jil.LocalId task_local) {
    guard statement.kind is .task_release_stmt(release) else { return false; }
    guard release.task_local is .some(released_task) else { return false; }
    return released_task == task_local;
}

Bool release_precedes_origin(
    jil.Body body,
    jil.BlockId release_block,
    Int release_statement_index,
    jil.TaskRegion later
) {
    if (release_block == later.origin_block) {
        return release_statement_index < later.origin_statement_index;
    }
    if (!block_dominates(body, release_block, later.origin_block)) { return false; }
    // 循环回边会让同一物理 region 的不同迭代重叠，存在环时不复用。
    return !block_reaches(body, later.origin_block, release_block);
}

Bool block_dominates(
    jil.Body body,
    jil.BlockId dominator,
    jil.BlockId target
) {
    if (dominator == body.entry || dominator == target) { return true; }
    // 删除候选 dominator 后 target 不可达，等价于 dominator 支配 target。
    return !block_reaches_without(body, body.entry, target, dominator);
}

Bool block_reaches(
    jil.Body body,
    jil.BlockId start,
    jil.BlockId target
) {
    return block_reaches_without(body, start, target, null);
}

Bool block_reaches_without(
    jil.Body body,
    jil.BlockId start,
    jil.BlockId target,
    jil.BlockId? excluded
) {
    unsafe {
        if (excluded is .some(block) && start == block) { return false; }
        Bool*! visited = Bool$.alloc(body.blocks.length);
        init_visited(visited, body.blocks.length);
        list.ArrayList<jil.BlockId> worklist! = list.ArrayList<jil.BlockId>();
        visited[start.to_index()] = true;
        worklist.add(start);
        while (!worklist.empty()) {
            jil.BlockId current = worklist.pop();
            if (current == target) { return true; }
            push_successors(body, current, excluded, visited, worklist$.mut_ref());
        }
        return false;
    }
}

Void init_visited(Bool*! visited, Int count) {
    unsafe {
        Int index! = 0;
        while (index < count) {
            visited[index] = false;
            index = index + 1;
        }
    }
}

Void push_successors(
    jil.Body body,
    jil.BlockId current,
    jil.BlockId? excluded,
    Bool*! visited,
    list.ArrayList<jil.BlockId>&! worklist
) {
    unsafe {
        jil.Terminator terminator = body.blocks[current.to_index()].terminator;
        Int index! = 0;
        while (index < jil.terminator_successor_count(terminator)) {
            jil.BlockId successor = jil.terminator_successor_at(terminator, index);
            if (!is_excluded(successor, excluded)) {
                push_unvisited(successor, visited, worklist);
            }
            index = index + 1;
        }
    }
}

Bool is_excluded(jil.BlockId block, jil.BlockId? excluded) {
    guard excluded is .some(excluded_block) else { return false; }
    return block == excluded_block;
}

Void push_unvisited(
    jil.BlockId block,
    Bool*! visited,
    list.ArrayList<jil.BlockId>&! worklist
) {
    unsafe {
        if (visited[block.to_index()]) { return; }
        visited[block.to_index()] = true;
        worklist.add(block);
    }
}
