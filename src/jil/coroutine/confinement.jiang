// 分析 JIL 协程体保持当前 Job 单 executor 独占性所需的入口约束。
//
// 固定点使用三态格：unconstrained -> binding -> escaping。继承 executor
// 的 async wrapper 可以得到 binding(X)，调用点在 X 上时仍可选择零原子变体。

import list = "../../support/list.jiang";
import jil = "../../jil.jiang";
import qid = "../../store/id.jiang";

public enum SummaryKind {
    unconstrained,
    binding,
    escaping,
}

public struct Summary: Copyable {
    public SummaryKind kind;
    public qid.DefId? binding;
    public Bool may_defer;
}

public list.ArrayList<Summary> analyze(jil.Store& output) {
    list.ArrayList<Summary> states! = initial_states(output);
    Bool changed! = true;
    while (changed) {
        changed = refine(output, states$.mut_ref());
    }
    return states;
}

list.ArrayList<Summary> initial_states(jil.Store& output) {
    list.ArrayList<Summary> states! = list.ArrayList<Summary>(output.functions.len());
    Int index! = 0;
    while (index < output.functions.len()) {
        jil.Function function = output.functions.get(index);
        if (function.is_coroutine && !function.is_external) {
            states.add(unconstrained());
        } else {
            states.add(deferred(escaping()));
        }
        index = index + 1;
    }
    return states;
}

Bool refine(jil.Store& output, list.ArrayList<Summary>&! states) {
    Bool changed! = false;
    Int index! = 0;
    while (index < output.functions.len()) {
        Summary next = function_summary(output, output.functions.get(index), states);
        if (!summary_equal(states.get(index), next)) {
            states.set(index, next);
            changed = true;
        }
        index = index + 1;
    }
    return changed;
}

Summary function_summary(
    jil.Store& output,
    jil.Function function,
    list.ArrayList<Summary>& states
) {
    if (!function.is_coroutine || function.is_external) { return deferred(escaping()); }
    Summary result! = unconstrained();
    Int index! = 0;
    while (index < function.body.blocks.length) {
        Summary requirement = terminator_summary(
            output, function, function.body.blocks[index].terminator, states
        );
        result = merge(result, requirement);
        index = index + 1;
    }
    return normalize_declared_domain(function, result);
}

Summary terminator_summary(
    jil.Store& output,
    jil.Function function,
    jil.Terminator terminator,
    list.ArrayList<Summary>& states
) {
    if (terminator.kind is .call_term(call)) {
        return call_summary(output, call, states);
    }
    if (terminator.kind is .suspend_pending_term(suspend)) {
        return suspend_summary(output, function, suspend, states);
    }
    return unconstrained();
}

Summary call_summary(
    jil.Store& output,
    jil.CallTerminator call,
    list.ArrayList<Summary>& states
) {
    if (!call.is_suspend_point || call.suspend_wake == .none) {
        if (!call.is_suspend_point) { return unconstrained(); }
        return deferred(unconstrained());
    }
    if (call.suspend_wake == .direct_child) {
        return direct_child_summary(output, call, states);
    }
    if (call.suspend_wake == .cross_executor) {
        return cross_executor_summary(output, call, states);
    }
    return deferred(escaping());
}

Summary direct_child_summary(
    jil.Store& output,
    jil.CallTerminator call,
    list.ArrayList<Summary>& states
) {
    guard call.suspend_child is .some(child) else { return deferred(escaping()); }
    return child_summary(output, child, states);
}

Summary cross_executor_summary(
    jil.Store& output,
    jil.CallTerminator call,
    list.ArrayList<Summary>& states
) {
    guard call.suspend_child is .some(child) else { return deferred(escaping()); }
    guard call.callee is .domain_enqueue(enqueue) else { return deferred(escaping()); }
    Summary nested = child_summary(output, child, states);
    if (nested.kind == .escaping) { return deferred(nested); }
    if (nested.kind == .binding) {
        guard nested.binding is .some(binding) else { return deferred(escaping()); }
        if (binding != enqueue.domain_def) { return deferred(escaping()); }
    }
    // 这条边在普通变体中需要 enqueue，但 binding 正是生成 confined 变体的
    // 前置条件。条件成立时 local_variant 会将 enqueue 改成直接 resume，因此
    // 这里只传播 child 的真实等待能力，不能把名义上的跨域边算作 defer。
    return with_defer(requires_binding(enqueue.domain_def), nested.may_defer);
}

Summary suspend_summary(
    jil.Store& output,
    jil.Function function,
    jil.SuspendPendingTerminator suspend,
    list.ArrayList<Summary>& states
) {
    if (suspend.suspend_wake == .none) { return deferred(unconstrained()); }
    if (suspend.suspend_wake != .task_child) { return deferred(escaping()); }
    guard suspend.task_local is .some(task_local) else { return deferred(escaping()); }
    guard function.coroutine_frame is .some(frame) else { return deferred(escaping()); }
    return task_child_summary(output, frame.task_regions, task_local, states);
}

Summary task_child_summary(
    jil.Store& output,
    jil.TaskRegion[]& regions,
    jil.LocalId task_local,
    list.ArrayList<Summary>& states
) {
    Int index! = 0;
    while (index < regions.length) {
        jil.TaskRegion region = regions[index];
        if (region.task_local == task_local) {
            return region_summary(output, region, states);
        }
        index = index + 1;
    }
    return deferred(escaping());
}

Summary region_summary(
    jil.Store& output,
    jil.TaskRegion region,
    list.ArrayList<Summary>& states
) {
    if (region.storage.sync != .local_serial) { return deferred(escaping()); }
    guard region.child_resume is .some(child) else { return deferred(escaping()); }
    return child_summary(output, child, states);
}

Summary child_summary(
    jil.Store& output,
    jil.FunctionRef child,
    list.ArrayList<Summary>& states
) {
    guard function_id(output, child) is .some(function_id) else { return deferred(escaping()); }
    Int index = function_id.to_index();
    if (index < 0 || index >= states.len()) { return deferred(escaping()); }
    return states.get(index);
}

jil.FunctionId? function_id(jil.Store& output, jil.FunctionRef child) {
    if (child.type_args.length == 0 && child.const_args.length == 0) {
        return output.function_id_for_def(child.function_def);
    }
    return output.function_id_for_instance(
        child.function_def, child.type_args, child.const_args
    );
}

Summary normalize_declared_domain(jil.Function function, Summary summary) {
    if (summary.kind != .binding) { return summary; }
    guard function.effects.domain is .some(domain) else { return summary; }
    guard summary.binding is .some(binding) else {
        return with_defer(escaping(), summary.may_defer);
    }
    if (binding == domain.binding) {
        return with_defer(unconstrained(), summary.may_defer);
    }
    // 声明域与所需域不同，调用必然真的跨 executor，不能生成消除 enqueue
    // 的 confined 变体。
    return deferred(escaping());
}

Summary merge(Summary lhs, Summary rhs) {
    Bool may_defer = lhs.may_defer || rhs.may_defer;
    if (lhs.kind == .escaping || rhs.kind == .escaping) {
        return with_defer(escaping(), may_defer);
    }
    if (lhs.kind == .unconstrained) { return with_defer(rhs, may_defer); }
    if (rhs.kind == .unconstrained) { return with_defer(lhs, may_defer); }
    if (lhs.binding == rhs.binding) { return with_defer(lhs, may_defer); }
    return with_defer(escaping(), may_defer);
}

Bool summary_equal(Summary lhs, Summary rhs) {
    return lhs.kind == rhs.kind && lhs.binding == rhs.binding
        && lhs.may_defer == rhs.may_defer;
}

Summary unconstrained() {
    return Summary (kind: .unconstrained, binding: null, may_defer: false);
}

Summary requires_binding(qid.DefId binding) {
    return Summary (kind: .binding, binding: binding, may_defer: false);
}

Summary escaping() {
    return Summary (kind: .escaping, binding: null, may_defer: false);
}

Summary deferred(Summary summary) {
    return with_defer(summary, true);
}

Summary with_defer(Summary summary, Bool may_defer) {
    return Summary (
        kind: summary.kind,
        binding: summary.binding,
        may_defer: may_defer
    );
}
