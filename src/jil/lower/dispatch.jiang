// 成员派发、泛型调用参数、receiver 和 intrinsic 选择 lowering。
//
// 本模块是 lower/body 实现族的一部分，只在 Semantic Model -> JIL 阶段内使用。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import jil_diagnostics = "../diagnostics.jiang";
import std;
import * = "./model.jiang";
import * = "./context.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import expression = "./expression.jiang";
import control_flow = "./control_flow.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import closure = "./closure.jiang";
import call = "./call.jiang";
import builder = "./builder.jiang";

public extend body_context.BodyLowerer {
    public Bool def_is_payload_enum_case(self, qid.DefId case_def) {
        def.DefRecord record = self.lowerer.store.defs.get(case_def);
        if (record.kind != .enum_case_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        return self.lowerer.store.model.def_enum_has_payload_variants(owner_def);
    }

    public qid.DefId direct_call_target(self, sem.NodeId node_id, qid.DefId resolved_def) {
        // Semantic Model 的 call.target/member_selection 是 resolve 阶段得到的原始目标。
        // type check 只在重载、trait 静态分派、构造器等场景把它细化为最终目标。
        if (self.lowerer.typeck.call_target(node_id) is .some(target_def)) {
            return target_def;
        }
        return resolved_def;
    }

    public Bool lower_subscript_get(
        Self&! self,
        sem.NodeId node_id,
        sem.IndexAccess index_access,
        jil.Place destination
    ) {
        guard self.lowerer.typeck.member_selection(node_id) is .some(function_def) else {
            return false;
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(function_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(index_access.base, mutable_reference));
        args.add(self.lower_to_operand(index_access.index));
        self.lower_direct_function_call(node_id, function_def, args$.ref(), destination);
        return true;
    }

    public Bool lower_subscript_assignment(Self&! self, sem.Assign assign_stmt) {
        if (assign_stmt.op != .assign) {
            return false;
        }
        sem.Node target = self.lowerer.model.node(assign_stmt.target);
        guard target.data is .index_access(index_access) else {
            return false;
        }
        guard self.subscript_set_def(assign_stmt.target) is .some(function_def) else {
            return false;
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(3);
        Bool mutable_reference = self.function_self_receiver_mode(function_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(index_access.base, mutable_reference));
        args.add(self.lower_to_operand(index_access.index));
        args.add(self.lower_to_operand(assign_stmt.value));
        jil.LocalId unit_temp = self.add_temp(
            self.lowerer.store.types.unit_type(),
            self.lowerer.model_span(assign_stmt.target)
        );
        self.lower_direct_function_call(assign_stmt.target, function_def, args$.ref(), self.place_for_local(unit_temp));
        return true;
    }

    public qid.DefId? subscript_set_def(self, sem.NodeId index_id) {
        guard self.lowerer.typeck.member_selection(index_id) is .some(get_def) else {
            return null;
        }
        guard self.lowerer.store.defs.get(get_def).owner_def is .some(owner_def) else {
            return null;
        }
        guard self.lowerer.store.symbols.find("subscript_set") is .some(symbol) else {
            return null;
        }
        return self.member_def_by_symbol(owner_def, symbol);
    }

    public qid.DefId? member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.lowerer.model.def(owner_def) is .some(owner_model) else {
            return null;
        }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (self.lowerer.store.defs.get(member_def).name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public qid.DefId? function_member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.lowerer.model.def(owner_def) is .some(owner_model) else {
            return null;
        }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            def.DefRecord record = self.lowerer.store.defs.get(member_def);
            if (record.kind == .function_def && record.name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public Void lower_direct_function_call(Self&! self,
        sem.NodeId node_id,
        qid.DefId function_def,
        list.ArrayList<jil.Operand>& args,
        jil.Place destination,
        qid.TypeId? receiver_type = null
    ) {
        def.DefKind function_kind = self.lowerer.store.defs.get(function_def).kind;
        if (self.is_assert_call(function_def, function_kind)) {
            self.lower_assert_operands(node_id, args);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId next_block = self.builder.reserve_block(span);
        FunctionRefArgs function_args = self.function_call_args_for_receiver(
            node_id, node_id, function_def, receiver_type
        );
        qid.TypeId function_type = self.function_type_for_ref(function_def, function_args.args);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: self.function_callee_with_args(
                node_id,
                function_def,
                function_type,
                function_args
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void lower_direct_function_call_with_args(Self&! self,
        qid.DefId function_def,
        types.GenericArg[]& generic_args,
        list.ArrayList<jil.Operand>& args,
        jil.Place destination,
        token.Span span
    ) {
        jil.BlockId next_block = self.builder.reserve_block(span);
        qid.TypeId function_type = self.function_type_for_ref(function_def, generic_args);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: self.direct_function_callee(
                function_def, function_type, generic_args, span
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public jil.CallCallee direct_function_callee(self,
        qid.DefId function_def,
        qid.TypeId function_type,
        types.GenericArg[]& args,
        token.Span span
    ) {
        return jil.direct_function_callee(jil.FunctionRef (
            target: .source(function_def),
            args: self.lowerer.storage.generic_arg_array(args),
            type_id: function_type
        ));
    }

    @life(return: self.d)
    public types.GenericArg[]& method_generic_args_for_receiver(
        self,
        qid.TypeId receiver_type,
        qid.DefId function_def
    ) {
        guard self.lowerer.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return self.lowerer.storage.empty_generic_args();
        }
        if (self.receiver_generic_args_for_owner(receiver_type, owner_def)
            is .some(args)) {
            return args;
        }
        return self.lowerer.storage.empty_generic_args();
    }

    public list.ArrayList<jil.Operand> lower_call_operands(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId target_def,
        qid.TypeId function_type
    ) {
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>();
        self.add_receiver_call_operand(call, target_def, args$.mut_ref());
        Int param_offset = args.len();
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(_)) {
            Int ordered_count = self.lowerer.typeck.ordered_call_arg_count(node_id);
            Int ordered_index! = 0;
            while (ordered_index < ordered_count) {
                sem.NodeId value = self.lowerer.typeck.ordered_call_arg_at(node_id, ordered_index);
                jil.Operand operand = self.lower_call_arg_operand(
                    value, function_type, ordered_index + param_offset
                );
                args.add(operand);
                ordered_index = ordered_index + 1;
            }
            return args;
        }
        Int index! = 0;
        while (index < call.args.length) {
            sem.NodeId value = call.args[index].value;
            jil.Operand operand = self.lower_call_arg_operand(
                value, function_type, index + param_offset
            );
            args.add(operand);
            index = index + 1;
        }
        return args;
    }

    public Void add_receiver_call_operand(Self&! self,
        sem.Call call,
        qid.DefId target_def,
        list.ArrayList<jil.Operand>&! args
    ) {
        if (!self.function_has_receiver_abi(target_def)) {
            return;
        }
        sem.Node callee = self.lowerer.model.node(call.callee);
        guard callee.data is .member_access(member_access) else {
            return;
        }
        if (self.function_self_receiver_mode(target_def) == .move_receiver) {
            args.add(self.lower_move_receiver_operand(member_access.base));
            return;
        }
        Bool mutable_reference = self.function_self_receiver_mode(target_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(member_access.base, mutable_reference));
    }

    public sem.SelfReceiverMode function_self_receiver_mode(self, qid.DefId function_def) {
        guard self.lowerer.model.def(function_def) is .some(model_def) else {
            return .ref_receiver;
        }
        guard model_def.decl.function_signature is .some(signature) else {
            return .ref_receiver;
        }
        return signature.receiver_mode;
    }

    public jil.Operand lower_move_receiver_operand(Self&! self, sem.NodeId receiver) {
        token.Span span = self.lowerer.model_span(receiver);
        jil.Place source = self.receiver_source_place(receiver, span);
        if (source.projection.length != 0) {
            self.mark_unsupported(receiver);
            return self.lower_to_operand(receiver);
        }
        return jil.move_operand_value(jil.MoveOperand (place: source));
    }

    public jil.Operand lower_receiver_operand(Self&! self, sem.NodeId receiver, Bool mutable_reference) {
        token.Span span = self.lowerer.model_span(receiver);
        if (self.reference_receiver_place(receiver) is .some(reference_place)) {
            return jil.copy_operand_value(jil.CopyOperand (place: reference_place));
        }
        qid.TypeId receiver_type = self.type_for_node(receiver);
        if (self.type_is_reference(receiver_type)) {
            return self.lower_to_operand(receiver);
        }
        if (self.receiver_pointee_place(receiver) is .some(pointee)) {
            return self.borrow_receiver_place(pointee, self.jil_place_type(pointee), mutable_reference, span);
        }
        jil.Place source = self.receiver_source_place(receiver, span);
        return self.borrow_receiver_place(source, receiver_type, mutable_reference, span);
    }

    public jil.Operand borrow_receiver_place(
        Self&! self,
        jil.Place source,
        qid.TypeId value_type,
        Bool mutable_reference,
        token.Span span
    ) {
        qid.TypeId reference_type! = self.lowerer.store.types.reference_type(value_type, span);
        if (mutable_reference) {
            reference_type = self.lowerer.store.types.mutable_type(reference_type, span);
        }
        jil.LocalId reference_local = self.add_temp(reference_type, span);
        self.builder.push_assign(
            self.place_for_local(reference_local),
            jil.borrow_rvalue(jil.BorrowRvalue (place: source)),
            span
        );
        return jil.copy_operand_value(jil.CopyOperand (
            place: self.place_for_local(reference_local)
        ));
    }

    public jil.Place? receiver_pointee_place(Self&! self, sem.NodeId receiver) {
        qid.TypeId receiver_type = self.type_for_node(receiver);
        types.TypeInfo info = self.lowerer.store.types.get(receiver_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (!self.handle_receiver_needs_deref(handle.kind)) {
            return null;
        }
        return self.pointer_deref_place(receiver);
    }

    public Bool handle_receiver_needs_deref(self, types.HandleTypeKind kind) {
        if (kind == .owner_pointer) { return true; }
        return kind == .raw_pointer;
    }

    public jil.Place? reference_receiver_place(Self&! self, sem.NodeId receiver) {
        guard self.place_for_expr(receiver) is .some(place) else {
            return null;
        }
        if (self.type_is_reference(self.jil_place_type(place))) {
            return place;
        }
        return null;
    }

    public Bool type_is_reference(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .reference;
    }

    public jil.Place receiver_source_place(Self&! self, sem.NodeId receiver, token.Span span) {
        if (self.place_for_expr(receiver) is .some(place)) {
            return place;
        }
        jil.LocalId local = self.add_temp(self.type_for_node(receiver), span);
        self.lower_into_place(receiver, self.place_for_local(local));
        return self.place_for_local(local);
    }

    public Bool function_has_receiver_abi(self, qid.DefId function_def) {
        // JIL function ABI 由 signature 决定。body lower 会在 Semantic Model 没有显式
        // `self` local 时合成 receiver local，所以 call 侧不能再用 body.locals
        // 反推，否则会漏传 receiver 并导致所有后续参数错位。
        guard self.lowerer.model.def(function_def) is .some(model_def) else {
            return false;
        }
        guard model_def.decl.function_signature is .some(signature) else {
            return false;
        }
        return signature.has_receiver;
    }

    @life(return: self.d)
    public jil.Operand lower_call_arg_operand(
        Self&! self,
        sem.NodeId value,
        qid.TypeId function_type,
        Int param_index
    ) {
        guard self.lowerer.store.types.function_type_head(function_type)
            is .some(signature) else {
            return self.lower_to_operand(value);
        }
        if (param_index < 0 || param_index >= signature.param_count) {
            return self.lower_to_operand(value);
        }
        qid.TypeId param_type = self.lowerer.store.types.function_type_param_at(
            function_type, param_index
        );
        if (self.mutable_reference_reborrow_operand(value, param_type) is .some(operand)) {
            return operand;
        }
        token.Span span = self.lowerer.model_span(value);
        jil.LocalId local = self.add_temp(param_type, span);
        self.lower_into_place(value, self.place_for_local(local));
        return self.operand_for_place(self.place_for_local(local));
    }

    public jil.Operand? mutable_reference_reborrow_operand(Self&! self, sem.NodeId value, qid.TypeId param_type) {
        if (!self.type_is_reference_or_slice(param_type)) { return null; }
        guard self.place_for_expr(value) is .some(place) else { return null; }
        if (!self.type_is_mutable_reference_or_slice(self.jil_place_type(place))) { return null; }
        return jil.copy_operand_value(jil.CopyOperand (place: place));
    }

    public Bool type_is_reference_or_slice(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return types.is_reference_handle(handle) || types.is_slice_handle(handle);
    }

    public Bool type_is_mutable_reference_or_slice(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (!info.is_mutable) { return false; }
        return types.is_reference_handle(handle) || types.is_slice_handle(handle);
    }

    public types.FunctionType function_type_or_empty(self, qid.TypeId function_type) {
        types.TypeInfo info = self.lowerer.store.types.get(function_type);
        if (info.data is .function_type(signature)) {
            return signature;
        }
        return types.FunctionType (
            params: self.lowerer.storage.empty_type_args(),
            result: self.lowerer.store.types.unit_type(),
            lifetime_contract: self.lowerer.store.types.empty_lifetime_contract(),
            effects: types.EffectSet(),
            kind: .raw,
            call_ownership: .borrowed
        );
    }

    @life(return: self.d)
    public jil.Operand function_operand(
        self,
        sem.NodeId node_id,
        qid.DefId function_def,
        qid.TypeId function_type
    ) {
        types.GenericArg[]& args! = self.lowerer.storage.empty_generic_args();
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                args = self.lowerer.storage.generic_arg_array(instance.args);
            }
        }
        qid.TypeId function_ref_type = self.function_type_for_ref(function_def, args);
        return jil.function_operand_value(
            self.function_ref(
                node_id,
                function_def,
                function_ref_type,
                FunctionRefArgs(args: args)
            )
        );
    }

    @life(return: self.d)
    public jil.CallCallee function_callee_with_args(self,
        sem.NodeId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        FunctionRefArgs args
    ) {
        return jil.direct_function_callee(jil.FunctionRef(
            target: .source(function_def),
            dispatch_type: args.dispatch_type,
            args: self.lowerer.storage.generic_arg_array(args.args),
            type_id: function_type
        ));
    }

    @life(return: self.d)
    public jil.FunctionRef function_ref(self,
        sem.NodeId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        FunctionRefArgs args
    ) {
        return jil.FunctionRef (
            target: .source(function_def),
            dispatch_type: args.dispatch_type,
            args: self.lowerer.storage.generic_arg_array(args.args),
            type_id: function_type
        );
    }

    @life(return: self.d)
    public FunctionRefArgs function_call_args(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId callee_id,
        qid.DefId function_def
    ) {
        qid.TypeId? receiver_type = self.function_call_receiver_type(callee_id, function_def);
        return self.function_call_args_for_receiver(
            node_id, callee_id, function_def, receiver_type
        );
    }

    public qid.TypeId? function_call_receiver_type(
        Self&! self,
        sem.NodeId callee_id,
        qid.DefId function_def
    ) {
        sem.Node callee = self.lowerer.model.node(callee_id);
        if (self.lowerer.store.defs.get(function_def).owner_def == null) { return null; }
        sem.NodeId receiver_id!;
        if (callee.data is .member_access(member_access)) {
            receiver_id = member_access.base;
        } else if (callee.data is .index_access(index_access)) {
            receiver_id = index_access.base;
        } else {
            return null;
        }
        return self.member_lookup_value_type(self.receiver_expr_type(receiver_id));
    }

    @life(return: self.d)
    public FunctionRefArgs function_call_args_for_receiver(
        self,
        sem.NodeId node_id,
        sem.NodeId callee_id,
        qid.DefId function_def,
        qid.TypeId? receiver_type
    ) {
        qid.TypeId? dispatch_type! = null;
        if (self.lowerer.def_is_trait_member(function_def)) {
            dispatch_type = self.function_call_dispatch_type(callee_id);
            if (dispatch_type == null) { dispatch_type = receiver_type; }
        }
        return FunctionRefArgs (
            dispatch_type: dispatch_type,
            args: self.function_call_generic_args(node_id, callee_id, function_def)
        );
    }

    qid.TypeId? function_call_dispatch_type(self, sem.NodeId callee_id) {
        sem.Node callee = self.lowerer.model.node(callee_id);
        sem.NodeId receiver_id!;
        if (callee.data is .member_access(member_access)) {
            receiver_id = member_access.base;
        } else if (callee.data is .index_access(index_access)) {
            receiver_id = index_access.base;
        } else {
            return null;
        }
        return self.type_for_node(receiver_id);
    }

    @life(return: self.d)
    public types.GenericArg[]& function_call_generic_args(
        self,
        sem.NodeId node_id,
        sem.NodeId callee_id,
        qid.DefId function_def
    ) {
        if (self.lowerer.typeck.generic_instance(node_id) is .some(instance)) {
            return self.lowerer.storage.generic_arg_array(instance.args);
        }
        if (self.lowerer.typeck.generic_instance(callee_id) is .some(instance)) {
            if (instance.def_id == function_def) {
                return self.lowerer.storage.generic_arg_array(instance.args);
            }
        }
        return self.lowerer.storage.empty_generic_args();
    }

    @life(return: self.d)
    public types.GenericArg[]&? receiver_generic_args_for_owner(
        self,
        qid.TypeId receiver_type,
        qid.DefId owner_def
    ) {
        types.TypeInfo info = self.lowerer.store.types.get(receiver_type);
        if (info.data is .named(named)) {
            if (named.def_id != owner_def) { return null; }
            return self.lowerer.storage.generic_args_from_values(
                named.type_args, named.const_args
            );
        }
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>();
        list.ArrayList<comptime_value.ComptimeValue> const_args! =
            list.ArrayList<comptime_value.ComptimeValue>();
        if (info.data is .array_type(array_type)) {
            if (!self.array_type_matches_owner(owner_def, array_type)) { return null; }
            type_args.add(array_type.element);
            const_args.add(self.array_count_comptime_value(array_type));
            if (self.is_sentinel_array_owner(owner_def)) {
                guard array_type.sentinel is .some(sentinel) else { return null; }
                const_args.add(self.sentinel_comptime_value(sentinel));
            }
            return self.lowerer.storage.generic_args_from_values(
                type_args.slice(), const_args.slice()
            );
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (!self.slice_type_matches_owner(owner_def, slice_type)) { return null; }
            type_args.add(slice_type.element);
            if (self.is_sentinel_slice_owner(owner_def)) {
                guard slice_type.sentinel is .some(sentinel) else { return null; }
                const_args.add(self.sentinel_comptime_value(sentinel));
            }
            return self.lowerer.storage.generic_args_from_values(
                type_args.slice(), const_args.slice()
            );
        }
        return null;
    }

    public qid.TypeId receiver_expr_type(Self&! self, sem.NodeId receiver_id) {
        qid.TypeId node_type = self.type_for_node(receiver_id);
        if (node_type.to_index() != self.lowerer.store.types.invalid_type().to_index()
            && !self.type_contains_generic_param(node_type)) {
            return node_type;
        }
        if (self.place_for_expr(receiver_id) is .some(place)) {
            return self.jil_place_type(place);
        }
        return node_type;
    }

    public qid.DefId? namespace_provider_def_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (self.lowerer.store.types.type_owner_def(type_id) is .some(owner_def)) { return owner_def; }
        if (info.data is .named(named)) { return named.def_id; }
        if (info.data is .array_type(array_type)) {
            if (array_type.sentinel != null) { return self.lowerer.store.resolve.core_types.sentinel_array_type; }
            return self.lowerer.store.resolve.core_types.array_type;
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (slice_type.sentinel != null) { return self.lowerer.store.resolve.core_types.sentinel_slice_type; }
            return self.lowerer.store.resolve.core_types.slice_type;
        }
        return null;
    }

    public Bool array_type_matches_owner(self, qid.DefId owner_def, types.ArrayType array_type) {
        if (array_type.sentinel != null) {
            return self.is_sentinel_array_owner(owner_def);
        }
        return self.is_array_owner(owner_def);
    }

    public Bool slice_type_matches_owner(self, qid.DefId owner_def, types.SliceValueType slice_type) {
        if (slice_type.sentinel != null) {
            return self.is_sentinel_slice_owner(owner_def);
        }
        return self.is_slice_owner(owner_def);
    }

    public Bool is_array_owner(self, qid.DefId owner_def) {
        guard self.lowerer.store.resolve.core_types.array_type is .some(array_def) else { return false; }
        return owner_def == array_def;
    }

    public Bool is_sentinel_array_owner(self, qid.DefId owner_def) {
        guard self.lowerer.store.resolve.core_types.sentinel_array_type is .some(array_def) else { return false; }
        return owner_def == array_def;
    }

    public Bool is_slice_owner(self, qid.DefId owner_def) {
        guard self.lowerer.store.resolve.core_types.slice_type is .some(slice_def) else { return false; }
        return owner_def == slice_def;
    }

    public Bool is_sentinel_slice_owner(self, qid.DefId owner_def) {
        guard self.lowerer.store.resolve.core_types.sentinel_slice_type is .some(slice_def) else { return false; }
        return owner_def == slice_def;
    }

    public comptime_value.ComptimeValue array_count_comptime_value(self, types.ArrayType array_type) {
        qid.TypeId int_type = self.lowerer.store.types.int_type();
        if (array_type.count_param is .some(param_def)) {
            return comptime_value.ComptimeValue(type_id: int_type, data: .const_param_value(param_def));
        }
        return comptime_value.ComptimeValue(type_id: int_type, data: .int_value(array_type.count));
    }

    public comptime_value.ComptimeValue sentinel_comptime_value(self, types.Sentinel sentinel) {
        return sentinel.value;
    }

    public qid.TypeId function_type_for_ref(
        self,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        guard self.lowerer.typeck.def_type(function_def) is .some(raw_type) else {
            return self.lowerer.store.types.invalid_type();
        }
        return self.function_type_with_args(function_def, args, raw_type);
    }

    public qid.TypeId function_type_with_args(
        self,
        qid.DefId function_def,
        types.GenericArg[]& args,
        qid.TypeId raw_type
    ) {
        if (args.length == 0) { return raw_type; }
        guard self.lowerer.model.def(function_def) is .some(_) else {
            return self.lowerer.store.types.invalid_type();
        }
        generic_bindings.GenericBindings caller_bindings! =
            generic_bindings.GenericBindings();
        generic_bindings.GenericBindings substitutions = generic_bindings.bindings_for_instance(
            self.lowerer.store.defs$.ref(),
            self.lowerer.store.model$.ref(),
            self.lowerer.store.types$.ref(),
            function_def,
            args,
            caller_bindings$.ref()
        );
        return self.lowerer.substitute_type(raw_type, substitutions$.ref());
    }

    public Bool type_args_contain_generic_params(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            if (self.type_contains_generic_param(type_args[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public Bool type_contains_generic_param(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.lowerer.store.defs.get(named.def_id).kind == .generic_param_def) {
                return true;
            }
            Int index! = 0;
            while (index < named.type_args.length) {
                if (self.type_contains_generic_param(named.type_args[index])) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        if (info.data is .optional(optional)) {
            return self.type_contains_generic_param(optional.element);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_contains_generic_param(handle.element);
        }
        if (info.data is .slice_value_type(slice_type)) {
            return self.type_contains_generic_param(slice_type.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_contains_generic_param(array_type.element);
        }
        return false;
    }

    public Bool is_builtin_call(self, qid.DefId def_id, UInt8[]& name) {
        def.DefRecord def_record = self.lowerer.store.defs.get(def_id);
        return string.equal(self.lowerer.store.symbols.text(def_record.name.symbol), name);
    }

    public AtomicBuiltin? atomic_builtin(self, sem.Call call, qid.DefId def_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return null; }
        if (model_def.decl.extern_kind != .builtin) { return null; }
        UInt8[]& name = self.lowerer.store.symbols.text(
            self.lowerer.store.defs.get(def_id).name.symbol
        );
        if (string.equal(name, "atomic_load") && call.args.length == 2) {
            guard self.atomic_ordering(call.args[1].value) is .some(ordering) else { return null; }
            return AtomicBuiltin(.load, ordering, .relaxed);
        }
        if (string.equal(name, "atomic_store") && call.args.length == 3) {
            guard self.atomic_ordering(call.args[2].value) is .some(ordering) else { return null; }
            return AtomicBuiltin(.store, ordering, .relaxed);
        }
        if (string.equal(name, "atomic_exchange") && call.args.length == 3) {
            guard self.atomic_ordering(call.args[2].value) is .some(ordering) else { return null; }
            return AtomicBuiltin(.exchange, ordering, .relaxed);
        }
        if (string.equal(name, "atomic_compare_exchange") && call.args.length == 5) {
            guard self.atomic_ordering(call.args[3].value) is .some(success) else { return null; }
            guard self.atomic_ordering(call.args[4].value) is .some(failure) else { return null; }
            return AtomicBuiltin(.compare_exchange, success, failure);
        }
        return null;
    }

    public jil.AtomicOrdering? atomic_ordering(self, sem.NodeId value_id) {
        guard self.enum_case_def_for_value(value_id) is .some(case_def) else { return null; }
        UInt8[]& name = self.lowerer.store.symbols.text(
            self.lowerer.store.defs.get(case_def).name.symbol
        );
        if (string.equal(name, "relaxed")) { return jil.AtomicOrdering.relaxed; }
        if (string.equal(name, "acquire")) { return jil.AtomicOrdering.acquire; }
        if (string.equal(name, "release")) { return jil.AtomicOrdering.release; }
        if (string.equal(name, "acquire_release")) { return jil.AtomicOrdering.acquire_release; }
        if (string.equal(name, "sequential")) {
            return jil.AtomicOrdering.sequentially_consistent;
        }
        return null;
    }

    public qid.DefId? call_callee_def(self, sem.NodeId callee) {
        if (self.lowerer.store.typeck.member_selection(callee) is .some(member_def)) {
            return member_def;
        }
        sem.Node node = self.lowerer.model.node(callee);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    public Bool is_assert_call(self, qid.DefId def_id, def.DefKind kind) {
        if (kind != .function_def || !self.is_builtin_call(def_id, "assert")) {
            return false;
        }
        return !self.lowerer.model.has_body(def_id);
    }

    public Void lower_builtin_assert(Self&! self, sem.NodeId node_id, sem.Call call) {
        if (call.args.length < 1 || call.args.length > 2) {
            self.mark_unsupported(node_id);
            return;
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(call.args.length);
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        self.lower_assert_operands(node_id, args$.ref());
    }

    public Void lower_assert_operands(
        Self&! self,
        sem.NodeId node_id,
        list.ArrayList<jil.Operand>& args
    ) {
        if (args.len() < 1 || args.len() > 2) {
            self.mark_unsupported(node_id);
            return;
        }
        jil.Operand? message! = null;
        if (args.len() == 2) { message = args.get(1); }
        self.lower_assert_operand(node_id, args.get(0), message);
    }

    public Void lower_assert_operand(
        Self&! self,
        sem.NodeId node_id,
        jil.Operand condition,
        jil.Operand? message
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        source.SourceId? source_id! = null;
        if (self.lowerer.store.source_map.model_span(node_id) is .some(location)) {
            source_id = location.source_id;
        }
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.assert_terminator_kind(jil.AssertTerminator (
            condition: condition,
            expected: true,
            source_id: source_id,
            source_offset: span.start,
            message: message,
            target: next_block,
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void lower_enum_variant_constructor(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId variant_def,
        jil.Place destination
    ) {
        list.ArrayList<jil.Operand> fields! = list.ArrayList<jil.Operand>(call.args.length);
        Int index! = 0;
        while (index < call.args.length) {
            fields.add(self.lower_to_operand(call.args[index].value));
            index = index + 1;
        }
        qid.TypeId type_id = self.type_for_node(node_id);
        jil.Operand tag = self.enum_variant_tag_operand(node_id, variant_def);
        self.builder.push_assign(
            destination,
            jil.aggregate_rvalue(jil.AggregateRvalue (
                kind: jil.AggregateKind.enum_variant,
                def_id: variant_def,
                type_id: type_id,
                tag: tag,
                fields: self.lowerer.storage.operand_array(fields$.ref())
            )),
            self.lowerer.model_span(node_id)
        );
    }

    @life()
    public jil.Operand unsupported_operand(Self&! self, sem.NodeId node_id) {
        self.mark_unsupported(node_id);
        return jil.const_operand_value(jil.Const (
            type_id: self.lowerer.store.types.invalid_type(),
            span: self.lowerer.model_span(node_id),
            value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
        ));
    }

    public jil.Operand enum_variant_tag_operand(self, sem.NodeId node_id, qid.DefId variant_def) {
        return jil.const_operand_value(self.variant_tag_const(
            node_id,
            variant_def,
            self.lowerer.store.types.int_type()
        ));
    }

    public Void mark_unsupported(Self&! self, sem.NodeId node_id) {
        self.lowerer.program.mark_error();
        self.add_unsupported_diagnostic(node_id);
    }

    public Void add_unsupported_diagnostic(Self&! self, sem.NodeId node_id) {
        jil_diagnostics.add_unsupported_model(
            self.lowerer.store,
            self.lowerer.diagnostics$.mut_ref(),
            node_id,
            self.lowerer.model.node(node_id)
        );
    }

    public Void add_field_projection_layout_diagnostic(
        Self&! self,
        qid.TypeId owner_type,
        qid.DefId field_def
    ) {
        jil_diagnostics.add_field_projection_layout_mismatch(
            self.lowerer.store,
            self.lowerer.diagnostics$.mut_ref(),
            owner_type,
            field_def
        );
    }

    public Void push_exclusive(Self&! self, jil.Place place, token.Span span) {
        if (self.builder.terminated) { return; }
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.exclusive_statement_kind(jil.ExclusiveStatement (place: place))
        ));
    }

}
