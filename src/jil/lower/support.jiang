// JIL lowering 的无状态辅助结构和映射函数。
//
// 这里不持有 lowering state，只放可以被多个 lower 文件共享的轻量类型
// 和纯映射逻辑，避免 `lower.jiang` 继续堆积通用工具代码。

import sem = "../../sema/model.jiang";
import qid = "../../store/id.jiang";
import list = "../../support/list.jiang";
import jil = "../model.jiang";

public struct LoopTargets: Copyable {
    public jil.BlockId continue_target;
    public jil.BlockId break_target;
    public Int active_depth;
    public Int defer_depth;
}

public struct SwitchPayloadEntry: Copyable {
    public sem.NodeId pattern_id;
    public jil.BlockId entry_block;
    public jil.BlockId body_block;
}

@region(a)
public struct PatternConditionBinding: Copyable {
    public sem.NodeId pattern_id;

    @life(a)
    public jil.Place subject_place;
    public qid.TypeId subject_type;
}

@region(a)
public struct IfConditionLowerResult: Movable {
    @life(a)
    public jil.Operand condition;

    @life(a)
    public PatternConditionBinding? binding;
    public list.ArrayList<jil.LocalId> active_locals!;
}

public enum TypeInfoValueKind {
    size,
    align,
    max_align,
}

public jil.UnaryOp? unary_op(sem.UnaryOp op) {
    if (op == .negate) { return jil.UnaryOp.neg; }
    if (op == .not) { return jil.UnaryOp.logic_not; }
    if (op == .bit_not) { return jil.UnaryOp.bit_not; }
    return null;
}

public jil.BinaryOp? binary_op_for_assign(sem.AssignOp op) {
    if (op == .add_assign) { return jil.BinaryOp.add; }
    if (op == .sub_assign) { return jil.BinaryOp.sub; }
    if (op == .mul_assign) { return jil.BinaryOp.mul; }
    if (op == .div_assign) { return jil.BinaryOp.div; }
    if (op == .mod_assign) { return jil.BinaryOp.rem; }
    if (op == .bit_and_assign) { return jil.BinaryOp.bit_and; }
    if (op == .bit_or_assign) { return jil.BinaryOp.bit_or; }
    if (op == .bit_xor_assign) { return jil.BinaryOp.bit_xor; }
    if (op == .shift_left_assign) { return jil.BinaryOp.shl; }
    if (op == .shift_right_assign) { return jil.BinaryOp.shr; }
    return null;
}

public jil.BinaryOp? binary_op(sem.BinaryOp op) {
    if (op == .add) { return jil.BinaryOp.add; }
    if (op == .sub) { return jil.BinaryOp.sub; }
    if (op == .mul) { return jil.BinaryOp.mul; }
    if (op == .div) { return jil.BinaryOp.div; }
    if (op == .mod) { return jil.BinaryOp.rem; }
    if (op == .bit_and) { return jil.BinaryOp.bit_and; }
    if (op == .bit_or) { return jil.BinaryOp.bit_or; }
    if (op == .bit_xor) { return jil.BinaryOp.bit_xor; }
    if (op == .shift_left) { return jil.BinaryOp.shl; }
    if (op == .shift_right) { return jil.BinaryOp.shr; }
    if (op == .equal) { return jil.BinaryOp.eq; }
    if (op == .not_equal) { return jil.BinaryOp.ne; }
    if (op == .less) { return jil.BinaryOp.lt; }
    if (op == .less_equal) { return jil.BinaryOp.le; }
    if (op == .greater) { return jil.BinaryOp.gt; }
    if (op == .greater_equal) { return jil.BinaryOp.ge; }
    return null;
}
