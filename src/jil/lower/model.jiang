// Semantic Model 到 JIL lowering 期间使用的阶段内模型。
//
// 这些类型只保存 lowering 的选择结果、临时切片和生成物缓存键，不进入稳定 JIL，
// 也不由 borrow check 或 backend 直接消费。

import core_traits = "../../core/traits.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import qid = "../../id.jiang";
import jil = "../model.jiang";
import std;

public const Int suspend_registering = 0;
public const Int suspend_parked = 1;
public const Int suspend_resuming = 2;
public const Int suspend_resumed = 3;

public std.String build_text_int(UInt8[]& prefix, Int value) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix);
    builder.append(value);
    return builder.into_string();
}

public Bool async_start_is_detached(jil.AsyncStartKind? value) {
    if (value is .some(kind)) { return kind == .detached; }
    return false;
}

public enum AtomicBuiltinKind {
    load,
    store,
    exchange,
    compare_exchange,
}

public struct AtomicBuiltin: Copyable {
    public AtomicBuiltinKind kind;
    public jil.AtomicOrdering success;
    public jil.AtomicOrdering failure;

    public init(
        self,
        AtomicBuiltinKind kind,
        jil.AtomicOrdering success,
        jil.AtomicOrdering failure
    ) {
        self.kind = kind;
        self.success = success;
        self.failure = failure;
    }
}

@region(a)
public struct FunctionRefArgs: Copyable {
    @life(a)
    public qid.TypeId[]& type_args;

    @life(a, a)
    public comptime_value.ComptimeValue[]& const_args;
}

@region(a)
public struct StatementSlice: Copyable {
    @life(a, a)
    public jil.Statement[]& values;
}

@region(a)
public struct ComptimeFields: Copyable {
    @life(a, a)
    public comptime_value.ComptimeAggregateField[]& values;
}

public struct TraitVTableGlobalKey: Copyable, Hashable, Equatable {
    public qid.DefId trait_def;
    public qid.TypeId subject_type;

    public init(self, qid.DefId trait_def, qid.TypeId subject_type) {
        self.trait_def = trait_def;
        self.subject_type = subject_type;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.trait_def.to_index()));
        hasher.write(Int(self.subject_type.to_index()));
    }

    public Bool equal(TraitVTableGlobalKey& lhs, TraitVTableGlobalKey& rhs) {
        if (lhs.trait_def != rhs.trait_def) {
            return false;
        }
        return lhs.subject_type == rhs.subject_type;
    }
}

@region(a, b, c)
public struct LambdaVTableGlobalKey: Copyable, Hashable, Equatable {
    @life(a, b, c)
    public jil.FunctionKey function;
    public Bool heap_env;

    public init(self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        Bool heap_env
    ) {
        self.function = jil.FunctionKey(function_def, type_args, const_args);
        self.heap_env = heap_env;
    }

    public () hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.function.hash(hasher);
        Bool heap_env = self.heap_env;
        hasher.write(heap_env);
    }

    public Bool equal(LambdaVTableGlobalKey& lhs, LambdaVTableGlobalKey& rhs) {
        if (lhs.heap_env != rhs.heap_env) { return false; }
        return jil.FunctionKey.equal(lhs.function$.ref(), rhs.function$.ref());
    }
}
