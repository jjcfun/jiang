// Slice、struct、Tuple、array literal 与目标类型提升 lowering。
//
// 本模块负责把 aggregate 值按目标类型写入 JIL place。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import monomorph = "../../sema/monomorph.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import std;
import * = "./model.jiang";
import * = "./context.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import expression = "./expression.jiang";
import place = "./place.jiang";
import constant = "./constant.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";
import support = "./support.jiang";


public extend body_context.BodyLowerer {
    public Void lower_slice(Self&! self, sem.NodeId node_id, sem.SliceAccess slice_access, jil.Place destination) {
        jil.Place base = self.slice_base_place(slice_access.base);
        support.StablePlaceLocation base_location = self.stable_place_location(base);
        token.Span span = self.lowerer.model_span(node_id);
        jil.LocalId? start_local = self.lower_optional_slice_bound(slice_access.start, span);
        jil.LocalId? end_local = self.lower_optional_slice_bound(slice_access.end, span);
        jil.Operand? start! = null;
        if (start_local is .some(start_id)) {
            start = jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(start_id)));
        }
        jil.Operand? end! = null;
        if (end_local is .some(end_id)) {
            end = jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(end_id)));
        } else {
            end = self.array_to_slice_end(self.type_for_node(slice_access.base), span);
        }
        self.push_assign(
            destination,
            jil.slice_rvalue(jil.SliceRvalue (
                base: self.stable_place(base_location$.ref()),
                start: start,
                end: end
            )),
            span
        );
    }

    public jil.Place slice_base_place(Self&! self, sem.NodeId base_id) {
        jil.Place base = self.pointer_base_place(base_id);
        qid.TypeId base_type = self.type_for_node(base_id);
        if (self.type_is_reference_to_array(base_type)) {
            return self.project_deref(base, false);
        }
        return base;
    }

    public Bool type_is_reference_to_array(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference) { return false; }
        types.TypeInfo element_info = self.lowerer.store.types.get(handle.element);
        return element_info.data is .array_type(_);
    }

    public Void lower_struct_literal(
        Self&! self,
        sem.NodeId node_id,
        sem.StructLiteral literal,
        jil.Place destination
    ) {
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.store.types.named_type_def(type_id) is .some(owner_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        monomorph.SubstitutionMap substitutions =
            self.nominal_substitution_for_type(type_id, owner_def);
        if (self.lower_nominal_literal_as_field_assignments(
            node_id,
            literal,
            destination,
            owner_def,
            substitutions$.ref()
        )) {
            return;
        }
        list.ArrayList<jil.Operand> fields! = list.ArrayList<jil.Operand>();
        guard self.append_struct_literal_fields(
            literal,
            owner_def,
            substitutions$.ref(),
            fields$.mut_ref()
        ) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.push_assign(
            destination,
            self.aggregate_rvalue(jil.AggregateRvalue (
                kind: self.struct_literal_aggregate_kind(owner_def),
                def_id: owner_def,
                type_id: type_id,
                tag: null,
                payload_field_index: -1,
                fields: self.lowerer.storage.operand_array(fields$.ref())
            ), self.lowerer.model_span(node_id)),
            self.lowerer.model_span(node_id)
        );
    }

    // struct literal 在 JIL 中直接降成字段 assignment。这样 borrow check
    // 看到的是 `dest.field = value`，不需要重新解释 aggregate 的字段语义。
    public Bool lower_nominal_literal_as_field_assignments(Self&! self,
        sem.NodeId node_id,
        sem.StructLiteral literal,
        jil.Place destination,
        qid.DefId owner_def,
        monomorph.SubstitutionMap& substitutions
    ) {
        def.DefKind kind = self.lowerer.store.defs.get(owner_def).kind;
        if (kind != .struct_def) {
            return false;
        }
        if (self.lowerer.model.def(owner_def) == null) {
            self.mark_unsupported(node_id);
            return true;
        }
        Int member_count = self.lowerer.model.def_member_count(owner_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.lowerer.model.def_member_at(owner_def, index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                guard self.lower_nominal_literal_field(
                    literal,
                    destination,
                    member_def,
                    substitutions
                ) else {
                    self.mark_unsupported(node_id);
                    return true;
                }
            }
            index = index + 1;
        }
        return true;
    }

    public Bool lower_nominal_literal_field(Self&! self,
        sem.StructLiteral literal,
        jil.Place destination,
        qid.DefId field_def,
        monomorph.SubstitutionMap& substitutions
    ) {
        guard self.struct_literal_field_value(literal, field_def) is .some(value) else { return false; }
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        jil.Place field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(value, field_place, field_type);
        return true;
    }

    public Void lower_into_place_as_type(Self&! self, sem.NodeId node_id, jil.Place destination, qid.TypeId expected) {
        qid.TypeId actual = self.type_for_node(node_id);
        if (self.type_needs_optional_lift(actual, expected) || self.type_needs_error_union_lift(actual, expected)) {
            jil.Operand value = self.lower_to_operand_as_type(node_id, expected);
            self.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (value: value)),
                self.lowerer.model_span(node_id)
            );
            return;
        }
        self.lower_into_place(node_id, destination);
    }

    public Bool append_struct_literal_fields(Self&! self,
        sem.StructLiteral literal,
        qid.DefId owner_def,
        monomorph.SubstitutionMap& substitutions,
        list.ArrayList<jil.Operand>&! fields
    ) {
        if (self.lowerer.model.def(owner_def) == null) { return false; }
        Int member_count = self.lowerer.model.def_member_count(owner_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.lowerer.model.def_member_at(owner_def, index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                guard self.struct_literal_field_value(literal, member_def) is .some(value) else { return false; }
                guard self.field_expected_type(member_def, substitutions) is .some(field_type) else { return false; }
                jil.Operand field_value = self.lower_to_operand_as_type(value, field_type);
                fields.add(field_value);
            }
            index = index + 1;
        }
        return true;
    }

    public qid.TypeId? field_expected_type(self, qid.DefId field_def, monomorph.SubstitutionMap& substitutions) {
        guard self.lowerer.typeck.def_type(field_def) is .some(type_id) else { return null; }
        return self.lowerer.substitute_type(type_id, substitutions);
    }

    public jil.Operand lower_to_operand_as_type(Self&! self, sem.NodeId node_id, qid.TypeId expected) {
        jil.Operand value = self.lower_to_operand(node_id);
        if (self.value_needs_optional_lift(value, expected)) {
            return self.lower_optional_lift_operand(node_id, value, expected);
        }
        return self.lower_error_union_lift_if_needed(node_id, value, expected);
    }

    public Bool value_needs_optional_lift(self, jil.Operand value, qid.TypeId expected) {
        return self.type_needs_optional_lift(self.jil_operand_type(value), expected);
    }

    public Bool type_needs_optional_lift(self, qid.TypeId actual, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.store.types.get(expected);
        guard expected_info.data is .optional(_) else { return false; }
        return self.type_can_be_lifted(actual, expected);
    }

    public jil.Operand lower_optional_lift_operand(
        Self&! self,
        sem.NodeId node_id,
        jil.Operand value,
        qid.TypeId expected
    ) {
        jil.LocalId temp = self.add_temp(expected, self.lowerer.model_span(node_id));
        jil.Place temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            jil.optional_rvalue(jil.OptionalRvalue (
                op: jil.OptionalOp.make_some,
                value: value
            )),
            self.lowerer.model_span(node_id)
        );
        jil.Place result_place = self.place_for_local(temp);
        return jil.copy_operand_value(jil.CopyOperand (place: result_place));
    }

    @life(return: self & value)
    public jil.Operand lower_error_union_lift_if_needed(Self&! self,
        sem.NodeId node_id,
        jil.Operand value,
        qid.TypeId expected
    ) {
        if (self.value_needs_error_union_lift(value, expected)) {
            return self.lower_error_union_lift_operand(node_id, value, expected);
        }
        return value;
    }

    public Bool value_needs_error_union_lift(self, jil.Operand value, qid.TypeId expected) {
        return self.type_needs_error_union_lift(self.jil_operand_type(value), expected);
    }

    public Bool type_needs_error_union_lift(self, qid.TypeId actual, qid.TypeId expected) {
        types.TypeInfo expected_info = self.lowerer.store.types.get(expected);
        guard expected_info.data is .error_union(_) else { return false; }
        return self.type_can_be_lifted(actual, expected);
    }

    public Bool type_can_be_lifted(self, qid.TypeId actual, qid.TypeId expected) {
        if (self.lowerer.store.types.same_type_ignoring_mutability(actual, expected)) {
            return false;
        }
        types.TypeInfo actual_info = self.lowerer.store.types.get(actual);
        if (actual_info.data is .invalid) { return false; }
        if (actual_info.data is .never) { return false; }
        return true;
    }

    public jil.Operand lower_error_union_lift_operand(
        Self&! self,
        sem.NodeId node_id,
        jil.Operand value,
        qid.TypeId expected
    ) {
        jil.LocalId temp = self.add_temp(expected, self.lowerer.model_span(node_id));
        jil.Place temp_place = self.place_for_local(temp);
        self.push_assign(
            temp_place,
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.make_value,
                value: value
            )),
            self.lowerer.model_span(node_id)
        );
        jil.Place result_place = self.place_for_local(temp);
        return jil.copy_operand_value(jil.CopyOperand (place: result_place));
    }

    public qid.TypeId jil_operand_type(self, jil.Operand value) {
        if (value is .const_operand(const_value)) {
            return const_value.type_id;
        }
        if (value is .copy_operand(copy_value)) {
            return self.jil_place_type(copy_value.place);
        }
        if (value is .move_operand(move_value)) {
            return self.jil_place_type(move_value.place);
        }
        if (value is .global_operand(global_value)) {
            return global_value.type_id;
        }
        if (value is .global_address_operand(global_value)) {
            return global_value.type_id;
        }
        if (value is .function_operand(function_value)) {
            return function_value.type_id;
        }
        return self.lowerer.store.types.invalid_type();
    }

    public sem.NodeId? struct_literal_field_value(self, sem.StructLiteral literal, qid.DefId field_def) {
        qid.SymbolId field_symbol = self.lowerer.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < literal.fields.length) {
            if (literal.fields[index].field_symbol == field_symbol) {
                return literal.fields[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    public jil.AggregateKind struct_literal_aggregate_kind(self, qid.DefId def_id) {
        return jil.AggregateKind.struct_value;
    }

    public Void lower_tuple_literal(Self&! self, sem.NodeId node_id, sem.TupleLiteral literal, jil.Place destination) {
        Int index! = 0;
        while (index < literal.items.length) {
            qid.TypeId item_type = self.tuple_item_type(node_id, index);
            jil.Place item_place = self.project_constant_index(destination, index);
            self.lower_into_place_as_type(literal.items[index], item_place, item_type);
            index = index + 1;
        }
    }

    public qid.TypeId tuple_item_type(self, sem.NodeId node_id, Int index) {
        qid.TypeId type_id = self.type_for_node(node_id);
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .tuple_type(tuple_type) else {
            return self.lowerer.store.types.invalid_type();
        }
        if (index >= 0 && index < tuple_type.items.length) { return tuple_type.items[index]; }
        return self.lowerer.store.types.invalid_type();
    }

    public Void lower_array_literal(Self&! self, sem.NodeId node_id, sem.ArrayLiteral literal, jil.Place destination) {
        qid.TypeId element_type = self.array_element_type(node_id, destination);
        Int index! = 0;
        while (index < literal.items.length) {
            jil.Place element_place = self.project_constant_index(destination, index);
            self.lower_into_place_as_type(literal.items[index], element_place, element_type);
            index = index + 1;
        }
        self.lower_array_sentinel_storage(destination, element_type, self.lowerer.model_span(node_id));
    }

    public Void lower_array_sentinel_storage(
        Self&! self,
        jil.Place destination,
        qid.TypeId element_type,
        token.Span span
    ) {
        qid.TypeId destination_type = self.jil_place_type(destination);
        types.TypeInfo info = self.lowerer.store.types.get(destination_type);
        guard info.data is .array_type(array_type) else { return; }
        guard array_type.sentinel is .some(sentinel) else { return; }
        jil.Place sentinel_place = self.project_constant_index(destination, array_type.count);
        self.lower_comptime_value_into_place_at_span(sentinel.value, sentinel_place, span);
    }

    public qid.TypeId array_element_type(self, sem.NodeId node_id, jil.Place destination) {
        qid.TypeId destination_type = self.jil_place_type(destination);
        types.TypeInfo info = self.lowerer.store.types.get(destination_type);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        sem.Node node = self.lowerer.model.node(node_id);
        guard node.data is .array_literal(literal) else {
            return self.lowerer.store.types.invalid_type();
        }
        qid.TypeId source_type = self.array_literal_source_type(node_id, literal);
        types.TypeInfo source_info = self.lowerer.store.types.get(source_type);
        if (source_info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.lowerer.store.types.invalid_type();
    }

    public jil.LocalId? lower_optional_slice_bound(
        Self&! self,
        sem.NodeId? bound,
        token.Span span
    ) {
        guard bound is .some(bound_id) else { return null; }
        jil.LocalId local = self.add_temp(self.type_for_node(bound_id), span);
        self.lower_into_place(bound_id, self.place_for_local(local));
        return local;
    }

}
