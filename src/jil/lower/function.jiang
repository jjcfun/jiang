// 函数树、泛型实例和外部函数的 JIL lowering。
//
// 本模块负责从 Semantic Model 声明生成具体 JIL Function。

import context = "../../context.jiang";
import database = "../../db.jiang";
import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import monomorph = "../../sema/monomorph.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import layout = "../../layout.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import drop_elaborate = "../drop_elaborate.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import std;
import * = "./model.jiang";
import lower_context = "./context.jiang";
import * = "./body.jiang";
import * = "./context.jiang";
import expression = "./expression.jiang";
import lower_coroutine = "./coroutine.jiang";
import lower_entry = "./entry.jiang";
import lower_local = "./local.jiang";
import lower_type_support = "./type_support.jiang";

public extend lower_context.Context {
    public Void lower_def_tree(Self&! self, qid.DefId def_id) {
        self.lower_def_tree_with_generics(def_id, 0);
    }

    public Void lower_def_tree_with_generics(Self&! self, qid.DefId def_id, Int inherited_generic_count) {
        guard self.model.def(def_id) is .some(model_def) else {
            return;
        }
        Int generic_count = self.lowering_generic_param_count(model_def, inherited_generic_count);
        sem.DeclKind decl_kind = model_def.decl.kind;
        Int member_count = model_def.members.len();
        self.lower_async_lambda_members(def_id, member_count, generic_count);
        if (self.is_lowerable_function_decl(decl_kind)) {
            if (self.omit_process_entry_function(model_def)) {
                // Dynamic libraries share runtime facilities but do not own a process entry.
            } else if (self.model.has_body(def_id)
                && generic_count == 0
                && self.function_signature_is_concrete(def_id)
            ) {
                self.lower_function(def_id);
            } else if (self.is_external_function_decl(def_id)) {
                self.lower_external_function(def_id);
            }
        }
        Int index! = 0;
        while (index < member_count) {
            guard self.model.def(def_id) is .some(current_def) else { return; }
            qid.DefId member_def = current_def.members.get(index);
            self.lower_def_tree_with_generics(member_def, generic_count);
            index = index + 1;
        }
    }

    public Bool omit_process_entry_function(self, sem.Def& model_def) {
        if (self.ctx.output != .dynamic_library) { return false; }
        if (model_def.decl.link_symbol == null) { return false; }
        guard self.ctx.store.resolve.target_startup_module is .some(startup_module) else {
            return false;
        }
        def.DefRecord record = self.ctx.store.defs.get(model_def.def_id);
        guard record.module_id is .some(module_id) else { return false; }
        return module_id == startup_module;
    }

    public Void lower_async_lambda_members(
        Self&! self,
        qid.DefId def_id,
        Int member_count,
        Int inherited_generic_count
    ) {
        Int index! = 0;
        while (index < member_count) {
            guard self.model.def(def_id) is .some(model_def) else { return; }
            qid.DefId member_def = model_def.members.get(index);
            if (self.typeck.is_async_lambda_function(member_def)) {
                self.lower_def_tree_with_generics(member_def, inherited_generic_count);
            }
            index = index + 1;
        }
    }

    public Int lowering_generic_param_count(self, sem.Def& model_def, Int inherited_generic_count) {
        Int tree_count = inherited_generic_count + self.generic_param_count_for_def(model_def.def_id);
        Int owner_count = self.generic_param_count(model_def);
        if (owner_count > tree_count) {
            // Extension members can be discovered from their module even though
            // their semantic owner is the extended type. Use the owner chain so
            // methods on `extend <T, N: const Int> T[N]` stay instance-only.
            return owner_count;
        }
        return tree_count;
    }

    public Void lower_function(Self&! self, qid.DefId function_def) {
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        self.lower_function_with_substitution(
            function_def,
            empty$.ref(),
            self.output.empty_type_args(),
            self.output.empty_const_args()
        );
    }

    public Bool is_lowerable_function_decl(self, sem.DeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    public Bool function_signature_is_concrete(self, qid.DefId function_def) {
        guard self.typeck.def_type(function_def) is .some(type_id) else {
            return false;
        }
        return self.type_is_concrete(type_id);
    }

    public Bool is_external_function_decl(self, qid.DefId function_def) {
        guard self.model.def(function_def) is .some(model_def) else { return false; }
        if (self.model.has_body(function_def) || self.generic_param_count(model_def) != 0) {
            return false;
        }
        guard self.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        def.DefKind owner_kind = self.ctx.store.defs.get(owner_def).kind;
        if (owner_kind == .module_def) { return true; }
        return owner_kind == .package_def;
    }

    // 第二阶段 lower concrete generic instances。它们不会出现在 Semantic Model ownership
    // tree 里，只存在于 MonomorphStore 中。
    public Void lower_instances(Self&! self) {
        Int index! = 0;
        while (index < self.instances.len()) {
            self.lower_instance(self.instances.get(index));
            index = index + 1;
        }
    }

    public Void lower_instance(Self&! self, monomorph.InstanceKey instance) {
        if (monomorph.instance_kind(self.ctx.store$.ref(), instance) != .function_body) {
            return;
        }
        if (!self.type_args_are_concrete(instance.type_args)) {
            return;
        }
        guard self.model.def(instance.def_id) is .some(model_def) else {
            return;
        }
        if (!self.model.has_body(model_def.def_id)) {
            return;
        }
        // instance.type_args 先绑定到泛型参数 DefId，body lowering 后续所有
        // 类型读取都通过 substitutions 转成 concrete TypeId。
        monomorph.SubstitutionMap substitutions = monomorph.build_substitution(
            self.ctx.store$.ref(),
            model_def,
            instance
        );
        self.lower_function_with_substitution(
            instance.def_id,
            substitutions$.ref(),
            instance.type_args,
            instance.const_args
        );
    }

    public Void lower_function_with_substitution(Self&! self,
        qid.DefId function_def,
        monomorph.SubstitutionMap& substitutions,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        guard self.model.def(function_def) is .some(model_def) else { return; }
        database.JilBodyKey query_key = self.jil_body_query_key(
            function_def,
            type_args,
            const_args
        );
        database.jil_body(
            self.ctx.query$.ref(),
            query_key,
            {
                [
                    ref! self,
                    function_def,
                    ref model_def,
                    ref substitutions,
                    ref type_args,
                    ref const_args
                ] => self.compute_lowered_function(
                    function_def,
                    model_def,
                    substitutions,
                    type_args,
                    const_args
                )
            }
        );
    }

    jil.FunctionId compute_lowered_function(
        Self&! self,
        qid.DefId function_def,
        sem.Def& model_def,
        monomorph.SubstitutionMap& substitutions,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        Bool inline_always = model_def.decl.inline_mode == .always;
        Bool naked = model_def.decl.naked;
        Int provisional_function_index = self.output.functions.len();
        // Semantic Model 不再直接携带 span；诊断位置后续通过 SourceMap 查询。
        token.Span span = self.def_span(function_def);
        BodyLowerer body_lowerer! = BodyLowerer(
            self,
            jil.BodyId.from_index(provisional_function_index),
            model_def,
            substitutions,
            type_args,
            const_args,
            span
        );
        jil.BlockId cancellation_entry = body_lowerer.cancellation_entry;
        qid.TypeId? capture_env_type = body_lowerer.coroutine_capture_env_type();
        jil.Body jil_body! = body_lowerer.lower();
        Int function_index = self.output.functions.len();
        jil_body = self.body_with_id(jil_body, jil.BodyId.from_index(function_index));
        types.EffectSet effects = self.function_effects_for_def(function_def, substitutions);
        jil.Function function! = jil.Function (
            id: jil.FunctionId.from_index(function_index),
            origin: .source(function_def),
            type_args: self.output.type_arg_array(type_args),
            const_args: self.output.const_arg_array(const_args),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: null,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: self.def_is_language_entry(function_def),
            is_runtime_entry: false,
            is_external: false,
            inline_always: inline_always,
            naked: naked,
            span: span,
            body: jil_body
        );
        if (effects.has_async) {
            jil.Function borrow_check_source! = function;
            function = drop_elaborate.elaborate_function(self.ctx, self.output$.ref(), function);
            jil.CoroutineFrameLayout? coroutine_frame = self.coroutine_frame_layout_for_body(
                function_def,
                function.body,
                effects,
                cancellation_entry,
                capture_env_type
            );
            function = jil.function_with_coroutine_frame(function, coroutine_frame);
            borrow_check_source = jil.function_with_coroutine_frame(
                borrow_check_source, coroutine_frame
            );
            self.output.set_borrow_check_override(borrow_check_source);
            self.output.mark_drop_elaborated(function.id);
        }
        jil.FunctionId function_id = self.output.add_function(function);
        list.ArrayList<qid.ModuleId> owners = self.function_monomorph_owners(
            function_def,
            type_args,
            const_args
        );
        self.output.add_monomorph_owners(function.id, owners$.ref());
        return function_id;
    }

    public database.JilBodyKey jil_body_query_key(
        self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.length == 0 && const_args.length == 0) {
            return database.JilBodyKey(
                self.output.query_identity,
                function_def,
                -1
            );
        }
        Int identity = self.output.jil_body_query_identity(
            function_def,
            type_args,
            const_args
        );
        return database.JilBodyKey(
            self.output.query_identity,
            function_def,
            identity
        );
    }

    public list.ArrayList<qid.ModuleId> function_monomorph_owners(
        self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.length == 0 && const_args.length == 0) {
            return list.ArrayList<qid.ModuleId>();
        }
        guard self.instances.instance_for_codegen_args(
            function_def,
            type_args,
            const_args
        ) is .some(instance) else {
            return list.ArrayList<qid.ModuleId>();
        }
        guard self.instances.instance_index_with_const_args(
            function_def,
            instance.args,
            type_args,
            const_args
        ) is .some(instance_index) else {
            return list.ArrayList<qid.ModuleId>();
        }
        return self.instances.owners(instance_index);
    }

    public Bool function_is_lowering(
        self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        database.JilBodyKey query_key = self.jil_body_query_key(
            function_def,
            type_args,
            const_args
        );
        return database.jil_body_is_active(self.ctx.query$.ref(), query_key);
    }

    @life(return: body)
    public jil.Body body_with_id(self, jil.Body body, jil.BodyId body_id) {
        return jil.Body (
            id: body_id,
            span: body.span,
            locals: body.locals,
            blocks: body.blocks,
            entry: body.entry,
            return_local: body.return_local
        );
    }

    public Void lower_external_function(Self&! self, qid.DefId function_def) {
        if (self.output.function_id_for_def(function_def) != null) {
            return;
        }
        guard self.model.def(function_def) is .some(model_def) else { return; }
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(function_def);
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        types.EffectSet effects = self.function_effects_for_def(function_def, empty$.ref());
        jil.Body jil_body = self.external_function_body(jil.BodyId.from_index(function_index), model_def, span);
        jil.CoroutineFrameLayout? coroutine_frame = self.external_coroutine_frame_layout(
            jil.BodyId.from_index(function_index), function_def, effects, span
        );
        self.output.add_function(jil.Function (
            id: jil.FunctionId.from_index(function_index),
            origin: .source(function_def),
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: coroutine_frame,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: true,
            inline_always: false,
            naked: false,
            span: span,
            body: jil_body
        ));
    }

    public jil.CoroutineFrameLayout? external_coroutine_frame_layout(
        Self&! self,
        jil.BodyId body_id,
        qid.DefId function_def,
        types.EffectSet effects,
        token.Span span
    ) {
        if (!effects.has_async) { return null; }
        jil.Body source_body = self.external_source_function_body(body_id, function_def, span);
        return self.coroutine_frame_layout_for_body(
            function_def, source_body, effects, source_body.entry, null
        );
    }

    public Void ensure_external_function(Self&! self, qid.DefId function_def) {
        if (self.output.function_id_for_def(function_def) != null) {
            return;
        }
        if (self.def_is_trait_member(function_def)) {
            return;
        }
        if (self.model.def(function_def) is .some(model_def)) {
            if (self.model.has_body(model_def.def_id)) { return; }
            self.lower_external_function(function_def);
            return;
        }
        self.lower_external_function_def(function_def);
    }

    public Bool def_is_trait_member(self, qid.DefId def_id) {
        guard self.ctx.store.defs.get(def_id).owner_def is .some(owner_def) else {
            return false;
        }
        return self.ctx.store.defs.get(owner_def).kind == .trait_def;
    }

    public Void ensure_function_instance(Self&! self, qid.DefId function_def, qid.TypeId[]& type_args) {
        self.ensure_function_instance_with_const_args(function_def, type_args, self.output.empty_const_args());
    }

    public Void ensure_function_instance_with_const_args(Self&! self,
        qid.DefId function_def,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.length == 0 && const_args.length == 0) {
            return;
        }
        if (!self.type_args_are_concrete(type_args)) {
            return;
        }
        if (self.output.function_id_for_instance(function_def, type_args, const_args) != null) {
            return;
        }
        if (self.instances.instance_for_codegen_args(function_def, type_args, const_args) is .some(instance)) {
            self.lower_instance(instance);
            return;
        }
        self.lower_instance(monomorph.InstanceKey(function_def, type_args, const_args));
    }

    public Bool type_args_are_concrete(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(type_args[index])) { return false; }
            index = index + 1;
        }
        return true;
    }

    public Bool type_is_concrete(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (self.ctx.store.defs.get(named.def_id).kind == .generic_param_def) {
                return false;
            }
            return self.type_args_are_concrete(named.type_args);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(handle.element);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(optional.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(tuple_type.items);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.type_args_are_concrete(environment.capture_types);
        }
        return true;
    }

    Bool type_has_concrete_nominal_layout(self, types.NamedType named) {
        def.DefKind kind = self.ctx.store.defs.get(named.def_id).kind;
        if (kind != .struct_def && kind != .enum_def && kind != .union_def) {
            return false;
        }
        return self.generic_args_are_fully_concrete(named.args);
    }

    Bool generic_args_are_fully_concrete(self, types.GenericArg[]& args) {
        Int index! = 0;
        while (index < args.length) {
            types.GenericArg arg = args[index];
            if (arg is .type_arg(type_arg)) {
                if (!self.type_is_fully_concrete(type_arg.value)) { return false; }
            }
            if (arg is .const_arg(const_arg)) {
                if (const_arg.value.data is .const_param_value(_)) { return false; }
                if (!self.type_is_fully_concrete(const_arg.value.type_id)) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_fully_concrete(self, qid.TypeId type_id) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .trait_companion(_)) { return false; }
        if (info.data is .named(named)) {
            def.DefKind kind = self.ctx.store.defs.get(named.def_id).kind;
            if (kind == .generic_param_def || kind == .associated_type_def) { return false; }
            return self.generic_args_are_fully_concrete(named.args);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_fully_concrete(handle.element);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_fully_concrete(optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_fully_concrete(error_union.value)
                && self.type_is_fully_concrete(error_union.error);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_fully_concrete(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            Int index! = 0;
            while (index < tuple_type.items.length) {
                if (!self.type_is_fully_concrete(tuple_type.items[index])) { return false; }
                index = index + 1;
            }
        }
        return true;
    }

    public Void ensure_custom_deinit_instances(Self&! self) {
        // drop elaboration 会把 concrete nominal local/field 改写成 deinit 调用。
        // 这些调用目标必须在 JIL 阶段就补齐，backend 只能消费完整 JIL。
        Int function_index! = 0;
        while (function_index < self.output.functions.len()) {
            jil.Function& function = self.output.functions.ref_at(function_index);
            self.ensure_custom_deinit_instances_for_body(function.body);
            function_index = function_index + 1;
        }
    }

    public Void ensure_custom_deinit_instances_for_body(Self&! self, jil.Body body) {
        table.HashTable<Int, Bool> visited! = table.HashTable<Int, Bool>();
        Int local_index! = 0;
        while (local_index < body.locals.length) {
            self.ensure_custom_deinit_instance_for_type(
                body.locals[local_index].type_id,
                visited$.mut_ref()
            );
            local_index = local_index + 1;
        }
    }

    public Void ensure_custom_deinit_instance_for_type(Self&! self, qid.TypeId type_id) {
        table.HashTable<Int, Bool> visited! = table.HashTable<Int, Bool>();
        self.ensure_custom_deinit_instance_for_type(type_id, visited$.mut_ref());
    }

    Void ensure_custom_deinit_instance_for_type(
        Self&! self,
        qid.TypeId type_id,
        table.HashTable<Int, Bool>&! visited
    ) {
        Int type_index = type_id.to_index();
        if (visited.has(type_index)) { return; }
        visited.set(type_index, true);
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            self.ensure_custom_deinit_instance_for_named(named);
            self.ensure_custom_deinit_instances_for_type_args(named.type_args, visited);
            if (self.type_has_concrete_nominal_layout(named)) {
                self.ensure_custom_deinit_instances_for_fields(type_id, visited);
            }
            return;
        }
        if (info.data is .handle_type(handle)) {
            if (types.is_owner_pointer_handle(handle)) {
                self.ensure_custom_deinit_instance_for_type(handle.element, visited);
            }
            return;
        }
        if (info.data is .optional(optional)) {
            self.ensure_custom_deinit_instance_for_type(optional.element, visited);
            return;
        }
        if (info.data is .array_type(array_type)) {
            self.ensure_custom_deinit_instance_for_type(array_type.element, visited);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.ensure_custom_deinit_instances_for_type_args(tuple_type.items, visited);
            return;
        }
        if (info.data is .closure_environment_type(environment)) {
            self.ensure_custom_deinit_instances_for_type_args(
                environment.capture_types,
                visited
            );
        }
    }

    Void ensure_custom_deinit_instances_for_fields(
        Self&! self,
        qid.TypeId type_id,
        table.HashTable<Int, Bool>&! visited
    ) {
        layout.LayoutId layout_id = database.layout_of_type(
            self.ctx.query$.mut_ref(), self.ctx.store$.ref(), type_id
        );
        layout.TypeLayout type_layout = self.ctx.query.layout.layout(layout_id);
        Int index! = 0;
        while (index < type_layout.fields.length) {
            self.ensure_custom_deinit_instance_for_type(
                type_layout.fields[index].field_type,
                visited
            );
            index = index + 1;
        }
    }

    public Void ensure_custom_deinit_instances_for_type_args(Self&! self, qid.TypeId[]& type_args) {
        table.HashTable<Int, Bool> visited! = table.HashTable<Int, Bool>();
        self.ensure_custom_deinit_instances_for_type_args(
            type_args,
            visited$.mut_ref()
        );
    }

    Void ensure_custom_deinit_instances_for_type_args(
        Self&! self,
        qid.TypeId[]& type_args,
        table.HashTable<Int, Bool>&! visited
    ) {
        Int index! = 0;
        while (index < type_args.length) {
            self.ensure_custom_deinit_instance_for_type(type_args[index], visited);
            index = index + 1;
        }
    }

    public Void ensure_custom_deinit_instance_for_named(Self&! self, types.NamedType named) {
        guard self.model.def(named.def_id) is .some(model_def) else {
            return;
        }
        guard model_def.custom_deinit_def is .some(deinit_def) else {
            return;
        }
        if (named.type_args.length == 0) {
            // interface-only nominal 的实现由缓存 object 提供；当前 unit 仍需
            // 一个 JIL external declaration，LLVM 才能声明并调用其 deinit。
            self.ensure_external_function(deinit_def);
            return;
        }
        if (!self.type_args_are_concrete(named.type_args)) {
            return;
        }
        self.ensure_function_instance(deinit_def, named.type_args);
    }

    public Void lower_external_function_def(Self&! self, qid.DefId function_def) {
        Int function_index = self.output.functions.len();
        token.Span span = self.def_span(function_def);
        monomorph.SubstitutionMap empty! = monomorph.SubstitutionMap();
        types.EffectSet effects = self.function_effects_for_def(function_def, empty$.ref());
        jil.Body body = self.external_function_body_for_def(
            jil.BodyId.from_index(function_index), function_def, span
        );
        self.output.add_function(jil.Function (
            id: jil.FunctionId.from_index(function_index),
            origin: .source(function_def),
            type_args: self.output.empty_type_args(),
            const_args: self.output.empty_const_args(),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_frame: self.external_coroutine_frame_layout(
                jil.BodyId.from_index(function_index), function_def, effects, span
            ),
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: true,
            inline_always: false,
            naked: false,
            span: span,
            body: body
        ));
    }

}
