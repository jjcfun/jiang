// 普通调用、间接调用、constructor、raw function 和 builtin lowering。
//
// 本模块是 lower/body 实现族的一部分，只在 Semantic Model -> JIL 阶段内使用。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import callable_abi = "../callable_abi.jiang";
import std;
import * = "./model.jiang";
import * = "./context.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import expression = "./expression.jiang";
import control_flow = "./control_flow.jiang";
import task = "./task.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import closure = "./closure.jiang";
import suspend = "./suspend.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";
import support = "./support.jiang";

public extend body_context.BodyLowerer {
    public Void lower_call(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        sem.NodeId callee_id = call.callee;
        if (self.is_enum_init_call(node_id, call) || self.is_enum_type_constructor_call(node_id, call)) {
            self.lower_enum_init_call(node_id, call, destination);
            return;
        }
        if (self.lowerer.typeck.expr_lowering(node_id) is .some(lowering_kind)) {
            self.lower_special_call(node_id, call, lowering_kind, destination);
            return;
        }
        if (self.call_can_lower_core_contiguous(call)) {
            self.lower_core_contiguous_call(node_id, call, destination);
            return;
        }
        if (self.lowerer.store.typeck.member_selection(call.callee) is .some(member_def)) {
            def.DefKind kind = self.lowerer.store.defs.get(member_def).kind;
            if (kind == .init_def) {
                self.lower_init_constructor_call(node_id, call, member_def, destination);
                return;
            }
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, member_def, destination);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, member_def, destination);
                return;
            }
        }
        if (call.target is .some(target)) {
            def.DefKind kind = self.lowerer.store.defs.get(target.def_id).kind;
            if (self.is_assert_call(target.def_id, kind)) {
                self.lower_builtin_assert(node_id, call);
                return;
            }
            if (kind == .union_variant_def) {
                self.lower_union_variant_constructor(node_id, call, target.def_id, destination);
                return;
            }
            if (kind == .init_def) {
                self.lower_init_constructor_call(node_id, call, target.def_id, destination);
                return;
            }
            if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
                self.lower_call_to_function_def(node_id, call, target.def_id, destination);
                return;
            }
        }
        if (self.call_callee_def(call.callee) is .some(callee_def)) {
            def.DefKind callee_kind = self.lowerer.store.defs.get(callee_def).kind;
            if (self.is_assert_call(callee_def, callee_kind)) {
                self.lower_builtin_assert(node_id, call);
                return;
            }
        }
        if (self.type_is_closure_callable(self.type_for_node(callee_id))) {
            self.lower_closure_call(node_id, destination);
            return;
        }
        if (self.function_type_is_async(self.type_for_node(callee_id))) {
            self.lower_async_raw_fn_call(node_id, destination);
            return;
        }
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        Bool is_suspend_point = self.function_type_is_async(self.type_for_node(callee_id));
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId next_block = self.builder.reserve_block(span);
        jil.LocalId callee_local = self.add_temp(self.type_for_node(callee_id), span);
        self.lower_into_place(callee_id, self.place_for_local(callee_local));
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId value = self.lowerer.model.call_arg_at(node_id, index).value;
            args.add(self.lower_to_operand(value));
            index = index + 1;
        }
        types.LifetimeFlow[]& return_lifetime_flows =
            self.call_return_lifetime_flows(callee_id, 0);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.indirect_operand_callee(
                self.operand_for_place(self.place_for_local(callee_local))
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: is_suspend_point,
            destination: destination,
            target: next_block,
            initialized_place: null,
            return_lifetime_flows: return_lifetime_flows,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void consume_closure_callee_if_needed(
        Self&! self,
        sem.NodeId callee_id,
        token.Span span
    ) {
        support.StablePlaceLocation owner = self.stable_place_location(
            self.pointer_base_place(callee_id)
        );
        self.consume_closure_callee_at(callee_id, owner$.ref(), span);
    }

    public Void consume_closure_callee_at(
        Self&! self,
        sem.NodeId callee_id,
        support.StablePlaceLocation& owner,
        token.Span span
    ) {
        types.TypeInfo callable_info = self.lowerer.store.types.get(self.type_for_node(callee_id));
        types.TypeInfo function_info! = callable_info;
        Bool heap! = false;
        if (callable_info.data is .handle_type(handle)) {
            if (handle.kind == .owner_pointer) { heap = true; }
            function_info = self.lowerer.store.types.get(handle.element);
        }
        guard function_info.data is .function_type(function_type) else { return; }
        if (function_type.call_ownership != .consuming) { return; }
        Bool async_call = function_type.effects.has_async;
        if (heap) {
            if (!async_call) {
                support.StablePlaceLocation closure = self.stable_place_location(
                    self.project_deref(self.stable_place(owner), false)
                );
                self.free_consumed_closure_environment(
                    self.stable_place(closure$.ref()), span
                );
            }
            self.free_consumed_closure_owner(self.stable_place(owner), span);
        }
        self.push_forget_place_at_span(self.stable_place(owner), span);
    }

    Void free_consumed_closure_environment(Self&! self, jil.Place closure_place, token.Span span) {
        jil.Place env_place = self.project_constant_index(closure_place, 0);
        self.push_free_operand(
            jil.copy_operand_value(jil.CopyOperand (place: env_place)),
            span
        );
    }

    Void free_consumed_closure_owner(Self&! self, jil.Place owner_place, token.Span span) {
        self.push_free_operand(
            jil.copy_operand_value(jil.CopyOperand (place: owner_place)),
            span
        );
    }

    Void push_free_operand(Self&! self, jil.Operand pointer, token.Span span) {
        qid.TypeId unit_type = self.lowerer.store.types.unit_type();
        jil.LocalId result = self.add_temp(unit_type, span);
        self.builder.push_assign(
            self.place_for_local(result),
            jil.free_rvalue(jil.FreeRvalue (pointer: pointer)),
            span
        );
    }

    Void push_forget_place_at_span(Self&! self, jil.Place place, token.Span span) {
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.forget_statement_kind(jil.ForgetStatement (place: place))
        ));
    }

    public Void lower_async_raw_fn_call(Self&! self, sem.NodeId node_id, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        sem.NodeId callee_id = self.lowerer.model.call_callee(node_id);
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        qid.TypeId source_type = self.type_for_node(callee_id);
        qid.TypeId abi_type = self.lowerer.external_async_abi_function_type(source_type, span);
        jil.LocalId source_callee = self.add_temp(source_type, span);
        self.lower_into_place(callee_id, self.place_for_local(source_callee));
        jil.LocalId abi_callee = self.add_temp(abi_type, span);
        self.builder.push_assign(
            self.place_for_local(abi_callee),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_ptr,
                value: self.operand_for_place(self.place_for_local(source_callee)),
                target_type: abi_type
            )),
            span
        );
        jil.ExternalContinuationLayout layout = self.lowerer.external_async_continuation_layout(
            self.jil_place_type(destination), span
        );
        jil.LocalId continuation = self.add_temp(layout.type_id, span);
        self.initialize_current_async_continuation(
            layout, self.place_for_local(continuation), destination, span
        );
        jil.LocalId continuation_pointer = self.add_temp(layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(continuation_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(continuation),
                frame_root: false
            )),
            span
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(arg_count + 1);
        list.ArrayList<jil.Operand> lifetime_args! =
            list.ArrayList<jil.Operand>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId value = self.lowerer.model.call_arg_at(node_id, index).value;
            jil.Operand argument = self.lower_to_operand(value);
            args.add(argument);
            lifetime_args.add(argument);
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        types.LifetimeFlow[]& return_lifetime_flows =
            self.type_return_lifetime_flows(source_type, 0);
        jil.Operand[]& lifetime_operands =
            self.lowerer.storage.operand_array(lifetime_args$.ref());
        self.finish_async_indirect_start(
            self.operand_for_place(self.place_for_local(abi_callee)),
            args$.ref(),
            return_lifetime_flows,
            lifetime_operands,
            destination,
            span
        );
    }

    public Void lower_closure_call(Self&! self, sem.NodeId node_id, jil.Place destination) {
        sem.NodeId callee_id = self.lowerer.model.call_callee(node_id);
        if (self.function_type_is_async(self.type_for_node(callee_id))) {
            self.lower_async_closure_call(node_id, destination);
            return;
        }
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId next_block = self.builder.reserve_block(span);
        support.StablePlaceLocation owner = self.stable_place_location(
            self.pointer_base_place(callee_id)
        );
        jil.Place closure_place = self.closure_callee_place_from_owner(
            self.stable_place(owner$.ref())
        );
        jil.Place call_place = self.project_constant_index(
            self.project_deref(self.project_constant_index(closure_place, 1), true), 0
        );
        qid.TypeId call_type = self.jil_place_type(call_place);
        support.StablePlaceLocation call_location = self.stable_place_location(call_place);
        jil.Place env_place = self.project_constant_index(closure_place, 0);
        qid.TypeId env_type = self.jil_place_type(env_place);
        support.StablePlaceLocation env_location = self.stable_place_location(env_place);
        jil.LocalId call_local = self.add_temp(call_type, span);
        jil.LocalId env_local = self.add_temp(env_type, span);
        self.builder.push_assign(
            self.place_for_local(call_local),
            jil.use_rvalue(jil.UseRvalue (value: self.operand_for_place(
                self.stable_place(call_location$.ref())
            ))),
            span
        );
        self.builder.push_assign(
            self.place_for_local(env_local),
            jil.use_rvalue(jil.UseRvalue (value: self.operand_for_place(
                self.stable_place(env_location$.ref())
            ))),
            span
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(arg_count + 1);
        args.add(self.operand_for_place(self.place_for_local(env_local)));
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId value = self.lowerer.model.call_arg_at(node_id, index).value;
            args.add(self.lower_to_operand(value));
            index = index + 1;
        }
        types.LifetimeFlow[]& return_lifetime_flows =
            self.call_return_lifetime_flows(callee_id, 1);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.indirect_operand_callee(
                self.operand_for_place(self.place_for_local(call_local))
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: destination,
            target: next_block,
            initialized_place: null,
            return_lifetime_flows: return_lifetime_flows,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
        self.consume_closure_callee_at(callee_id, owner$.ref(), span);
    }

    @life(return: self.d)
    public types.LifetimeFlow[]& call_return_lifetime_flows(
        self,
        sem.NodeId callee,
        Int arg_offset
    ) {
        return self.type_return_lifetime_flows(self.type_for_node(callee), arg_offset);
    }

    @life(return: self.d)
    public types.LifetimeFlow[]& type_return_lifetime_flows(
        self,
        qid.TypeId type_id,
        Int arg_offset
    ) {
        guard self.lowerer.store.types.function_type_head(type_id) is .some(function_type) else {
            list.ArrayList<types.LifetimeFlow> empty! = list.ArrayList<types.LifetimeFlow>();
            return self.lowerer.storage.lifetime_flow_array(empty$.ref());
        }
        return self.function_return_lifetime_flows(
            type_id, function_type.lifetime_flow_count, arg_offset
        );
    }

    @life(return: self.d)
    public types.LifetimeFlow[]& function_return_lifetime_flows(
        self,
        qid.TypeId function_type,
        Int flow_count,
        Int arg_offset
    ) {
        list.ArrayList<types.LifetimeFlow> flows! =
            list.ArrayList<types.LifetimeFlow>(flow_count);
        Int index! = 0;
        while (index < flow_count) {
            guard self.lowerer.store.types.function_type_lifetime_flow_at(function_type, index)
                is .some(flow) else {
                assert(false);
                return self.lowerer.storage.lifetime_flow_array(flows$.ref());
            }
            types.LifetimePath source! = flow.source;
            types.LifetimePath target! = flow.target;
            if (flow.source.root_kind != .result) {
                source = types.LifetimePath (
                    root_kind: source.root_kind,
                    root_index: source.root_index + arg_offset,
                    position_index: source.position_index,
                    projection_path: source.projection_path
                );
            }
            if (flow.target.root_kind != .result) {
                target = types.LifetimePath (
                    root_kind: target.root_kind,
                    root_index: target.root_index + arg_offset,
                    position_index: target.position_index,
                    projection_path: target.projection_path
                );
            }
            flows.add(types.LifetimeFlow (source: source, target: target));
            index = index + 1;
        }
        return self.lowerer.storage.lifetime_flow_array(flows$.ref());
    }

    public Void lower_async_closure_call(Self&! self, sem.NodeId node_id, jil.Place destination) {
        sem.NodeId callee_id = self.lowerer.model.call_callee(node_id);
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        if (!self.closure_call_consumes_callee(callee_id)
            && self.known_async_lambda_function(callee_id) is .some(function_def)) {
            token.Span direct_span = self.lowerer.model_span(node_id);
            list.ArrayList<jil.Operand> direct_args! =
                list.ArrayList<jil.Operand>(arg_count + 1);
            direct_args.add(self.closure_env_operand(callee_id));
            Int direct_index! = 0;
            while (direct_index < arg_count) {
                sem.NodeId value = self.lowerer.model.call_arg_at(node_id, direct_index).value;
                direct_args.add(self.lower_to_operand(value));
                direct_index = direct_index + 1;
            }
            list.ArrayList<types.GenericArg> function_args! =
                self.owned_generic_args(self.function_args.slice());
            self.lower_async_direct_call(
                function_def,
                function_args.slice(),
                self.lowerer.storage.operand_array(direct_args$.ref()),
                destination,
                direct_span
            );
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        jil.ExternalContinuationLayout layout = self.lowerer.external_async_continuation_layout(
            self.jil_place_type(destination), span
        );
        jil.LocalId continuation = self.add_temp(layout.type_id, span);
        self.initialize_current_async_continuation(
            layout, self.place_for_local(continuation), destination, span
        );
        jil.LocalId continuation_pointer = self.add_temp(layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(continuation_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(continuation),
                frame_root: false
            )),
            span
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(arg_count + 2);
        list.ArrayList<jil.Operand> lifetime_args! =
            list.ArrayList<jil.Operand>(arg_count);
        support.StablePlaceLocation owner = self.stable_place_location(
            self.pointer_base_place(callee_id)
        );
        jil.Place closure_place = self.closure_callee_place_from_owner(
            self.stable_place(owner$.ref())
        );
        jil.Place call_place = self.project_constant_index(
            self.project_deref(self.project_constant_index(closure_place, 1), true), 0
        );
        qid.TypeId call_type = self.jil_place_type(call_place);
        support.StablePlaceLocation call_location = self.stable_place_location(call_place);
        jil.Place env_place = self.project_constant_index(closure_place, 0);
        qid.TypeId env_type = self.jil_place_type(env_place);
        support.StablePlaceLocation env_location = self.stable_place_location(env_place);
        jil.LocalId call_local = self.add_temp(call_type, span);
        jil.LocalId env_local = self.add_temp(env_type, span);
        self.builder.push_assign(
            self.place_for_local(call_local),
            jil.use_rvalue(jil.UseRvalue (value: self.operand_for_place(
                self.stable_place(call_location$.ref())
            ))),
            span
        );
        self.builder.push_assign(
            self.place_for_local(env_local),
            jil.use_rvalue(jil.UseRvalue (value: self.operand_for_place(
                self.stable_place(env_location$.ref())
            ))),
            span
        );
        Bool consumes_callee = self.closure_call_consumes_callee(callee_id);
        args.add(self.operand_for_place(self.place_for_local(env_local)));
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId value = self.lowerer.model.call_arg_at(node_id, index).value;
            jil.Operand argument = self.lower_to_operand(value);
            args.add(argument);
            lifetime_args.add(argument);
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        if (consumes_callee) {
            self.consume_closure_callee_if_needed(callee_id, span);
        }
        self.finish_async_indirect_start(
            self.operand_for_place(self.place_for_local(call_local)),
            args$.ref(),
            self.call_return_lifetime_flows(callee_id, 0),
            self.lowerer.storage.operand_array(lifetime_args$.ref()),
            destination,
            span
        );
    }

    Bool closure_call_consumes_callee(self, sem.NodeId callee_id) {
        types.TypeInfo info! = self.lowerer.store.types.get(self.type_for_node(callee_id));
        if (info.data is .handle_type(handle)) {
            info = self.lowerer.store.types.get(handle.element);
        }
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.call_ownership == .consuming;
    }

    public qid.DefId? known_async_lambda_function(self, sem.NodeId callee_id) {
        sem.Node callee = self.lowerer.model.node(callee_id);
        guard callee.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .local(local_id) else { return null; }
        guard self.known_lambda_initializers.get(local_id.to_index())
            is .some(initializer) else { return null; }
        sem.NodeId initializer_id = initializer$.get();
        sem.Node node = self.lowerer.model.node(initializer_id);
        guard node.data is .lambda_expr(lambda) else { return null; }
        if (!self.function_type_is_async(self.type_for_node(callee_id))) { return null; }
        return lambda.function_def;
    }

    public Void initialize_current_async_continuation(
        Self&! self,
        jil.ExternalContinuationLayout layout,
        jil.Place continuation_place,
        jil.Place destination,
        token.Span span
    ) {
        jil.Rvalue context = jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
            place: self.place_for_local(self.return_local()),
            frame_root: true
        ));
        qid.TypeId context_type = self.lowerer.coroutine_context_pointer_type(span);
        jil.Operand resume = jil.function_operand_value(jil.FunctionRef (
            target: .source(self.def_id),
            args: self.lowerer.storage.generic_arg_array(self.function_args.slice()),
            coroutine_resume: true,
            coroutine_completion: false,
            type_id: self.lowerer.coroutine_continuation_type(context_type, span)
        ));
        self.initialize_external_async_continuation(
            layout,
            continuation_place,
            destination,
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            context,
            resume,
            span
        );
    }

    public Void finish_async_indirect_start(
        Self&! self,
        jil.Operand callee,
        list.ArrayList<jil.Operand>& args,
        types.LifetimeFlow[]& lifetime_flows,
        jil.Operand[]& lifetime_args,
        jil.Place lifetime_destination,
        token.Span span
    ) {
        self.finish_async_start(
            jil.indirect_operand_callee(callee),
            args,
            .dynamic,
            null,
            lifetime_flows,
            lifetime_args,
            lifetime_destination,
            span
        );
    }

    public Void finish_async_direct_start(
        Self&! self,
        jil.FunctionRef callee,
        jil.FunctionRef child_resume,
        list.ArrayList<jil.Operand>& args,
        types.LifetimeFlow[]& lifetime_flows,
        jil.Operand[]& lifetime_args,
        jil.Place lifetime_destination,
        token.Span span
    ) {
        self.finish_async_start(
            jil.direct_function_callee(callee),
            args,
            .direct_child,
            child_resume,
            lifetime_flows,
            lifetime_args,
            lifetime_destination,
            span
        );
    }

    public Void finish_async_start(
        Self&! self,
        jil.CallCallee callee,
        list.ArrayList<jil.Operand>& args,
        jil.SuspendWakeKind suspend_wake,
        jil.FunctionRef? suspend_child,
        types.LifetimeFlow[]& lifetime_flows,
        jil.Operand[]& lifetime_args,
        jil.Place lifetime_destination,
        token.Span span
    ) {
        jil.LocalId unit_result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.compare_exchange_passive_cancel_target(0, 3, span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: callee,
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: suspend_wake,
            suspend_child: suspend_child,
            task_handoff: true,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: lifetime_destination,
            deferred_initialization: true,
            return_lifetime_flows: lifetime_flows,
            lifetime_args: lifetime_args,
            lifetime_destination: lifetime_destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
        self.complete_deferred_async_initialization(lifetime_destination, span);
        self.compare_exchange_passive_cancel_target(3, 0, span);
    }

    @life(return: self.d)
    public jil.Operand closure_call_operand(Self&! self, sem.NodeId callee_id) {
        jil.Place closure_place = self.closure_callee_place(callee_id);
        jil.Place vtable_ptr = self.project_constant_index(closure_place, 1);
        jil.Place vtable = self.project_deref(vtable_ptr, true);
        jil.Place call_place = self.project_constant_index(vtable, 0);
        return jil.copy_operand_value(jil.CopyOperand (place: call_place));
    }

    @life(return: self.d)
    public jil.Operand closure_env_operand(Self&! self, sem.NodeId callee_id) {
        jil.Place closure_place = self.closure_callee_place(callee_id);
        jil.Place env_place = self.project_constant_index(closure_place, 0);
        return jil.copy_operand_value(jil.CopyOperand (place: env_place));
    }

    public jil.Place closure_callee_place(Self&! self, sem.NodeId callee_id) {
        return self.closure_callee_place_from_owner(
            self.pointer_base_place(callee_id)
        );
    }

    @life(return: self & owner)
    public jil.Place closure_callee_place_from_owner(self, jil.Place owner) {
        jil.Place place! = owner;
        types.TypeInfo info = self.lowerer.store.types.get(self.jil_place_type(place));
        guard info.data is .handle_type(handle) else {
            return place;
        }
        if (handle.kind == .owner_pointer || handle.kind == .reference) {
            if (self.type_is_closure(handle.element)) {
                return self.project_deref(place, false);
            }
        }
        return place;
    }

    public list.ArrayList<support.StablePlaceLocation> exclusive_place_locations_for_call(
        Self&! self,
        sem.NodeId node_id,
        qid.DefId target_def
    ) {
        list.ArrayList<support.StablePlaceLocation> locations! =
            list.ArrayList<support.StablePlaceLocation>();
        if (!self.lowerer.model.has_function_signature(target_def)) {
            return locations;
        }
        if (self.lowerer.model.function_signature_receiver_mode(target_def) == .move_receiver) {
            self.append_exclusive_self_place(
                self.lowerer.model.call_callee(node_id), locations$.mut_ref()
            );
        }
        Int exclusive_count = self.lowerer.model.function_signature_exclusive_symbol_count(target_def);
        Int index! = 0;
        while (index < exclusive_count) {
            qid.SymbolId symbol = self.lowerer.model.function_signature_exclusive_symbol_at(
                target_def, index
            );
            self.append_exclusive_symbol_place(
                node_id,
                target_def,
                symbol,
                locations$.mut_ref()
            );
            index = index + 1;
        }
        return locations;
    }

    public Void append_exclusive_self_place(
        Self&! self,
        sem.NodeId callee_id,
        list.ArrayList<support.StablePlaceLocation>&! locations
    ) {
        sem.Node callee_node = self.lowerer.model.node(callee_id);
        guard callee_node.data is .member_access(member_access) else {
            return;
        }
        if (self.place_for_expr(member_access.base) is .some(place)) {
            locations.add(self.stable_place_location(place));
        }
    }

    public Void append_exclusive_symbol_place(Self&! self,
        sem.NodeId node_id,
        qid.DefId target_def,
        qid.SymbolId symbol,
        list.ArrayList<support.StablePlaceLocation>&! locations
    ) {
        if (self.symbol_text_equal(symbol, "self")) {
            self.append_exclusive_self_place(
                self.lowerer.model.call_callee(node_id), locations
            );
            return;
        }
        guard self.param_index_for_symbol(target_def, symbol) is .some(param_index) else {
            return;
        }
        guard self.exclusive_arg_expr(node_id, param_index) is .some(arg_id) else {
            return;
        }
        if (self.exclusive_place_for_expr(arg_id) is .some(place)) {
            locations.add(self.stable_place_location(place));
        }
    }

    @life(return: (self.a, self.a))
    public jil.Place[]& freeze_exclusive_places(
        self,
        list.ArrayList<support.StablePlaceLocation>& locations
    ) {
        list.ArrayList<jil.Place> places! = list.ArrayList<jil.Place>(locations.len());
        Int index! = 0;
        while (index < locations.len()) {
            places.add(self.stable_place(locations.ref_at(index)));
            index = index + 1;
        }
        return self.lowerer.storage.place_array(places$.ref());
    }

    public Int? param_index_for_symbol(self, qid.DefId target_def, qid.SymbolId symbol) {
        Int param_count = self.lowerer.model.function_signature_param_symbol_count(target_def);
        Int index! = 0;
        while (index < param_count) {
            if (self.lowerer.model.function_signature_param_symbol_at(target_def, index) == symbol) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    public sem.NodeId? exclusive_arg_expr(self, sem.NodeId node_id, Int param_index) {
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(_)) {
            Int arg_count = self.lowerer.typeck.ordered_call_arg_count(node_id);
            if (param_index >= 0 && param_index < arg_count) {
                return self.lowerer.typeck.ordered_call_arg_at(node_id, param_index);
            }
            return null;
        }
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        if (param_index >= 0 && param_index < arg_count) {
            return self.lowerer.model.call_arg_at(node_id, param_index).value;
        }
        return null;
    }

    public jil.Place? exclusive_place_for_expr(Self&! self, sem.NodeId node_id) {
        if (self.place_for_expr(node_id) is .some(place)) {
            return place;
        }
        sem.Node node = self.lowerer.model.node(node_id);
        guard node.data is .implicit_call(call) else { return null; }
        guard self.lowerer.typeck.intrinsic_operation(node_id) is .some(operation) else { return null; }
        if (operation == .borrow_ref
            || operation == .mutable_borrow_ref
            || operation == .address_of
            || operation == .mutable_address_of) {
            return self.place_for_expr(call.base);
        }
        return null;
    }

    public Void lower_planned_trait_object_method_call(Self&! self,
        sem.NodeId node_id,
        jil.Place destination
    ) {
        sem.NodeId callee_id = self.lowerer.model.call_callee(node_id);
        sem.Node callee_node = self.lowerer.model.node(callee_id);
        guard callee_node.data is .member_access(member_access) else {
            self.mark_unsupported(node_id);
            return;
        }
        sem.NodeId receiver_id = member_access.base;
        guard self.lowerer.store.typeck.member_selection(callee_id) is .some(trait_member) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.lowerer.store.defs.get(trait_member).owner_def is .some(trait_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.lowerer.store.typeck.def_type(trait_member) is .some(method_type) else {
            self.mark_unsupported(node_id);
            return;
        }
        if (!self.function_has_receiver_abi(trait_member)) {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.trait_vtable_slot_index(trait_def, trait_member) is .some(slot_index) else {
            self.mark_unsupported(node_id);
            return;
        }
        Int arg_count = self.lowerer.model.call_arg_count(node_id);
        Bool is_suspend_point = self.function_type_is_async(self.type_for_node(node_id));
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId next_block = self.builder.reserve_block(span);
        jil.Place any_place = self.member_lookup_base_place(receiver_id);
        jil.Place receiver_place = self.project_constant_index(any_place, 0);
        jil.Place vtable_place = self.project_constant_index(any_place, 1);
        jil.Place slot_place = self.project_constant_index(vtable_place, slot_index + 1);
        support.StablePlaceLocation receiver_location = self.stable_place_location(receiver_place);
        support.StablePlaceLocation slot_location = self.stable_place_location(slot_place);
        list.ArrayList<jil.Operand> user_args! = list.ArrayList<jil.Operand>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId value = self.lowerer.model.call_arg_at(node_id, index).value;
            user_args.add(self.lower_to_operand(value));
            index = index + 1;
        }
        types.LifetimeFlow[]& return_lifetime_flows =
            self.type_return_lifetime_flows(method_type, 0);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(arg_count + 1);
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: support.stable_place(self.lowerer.storage, receiver_location$.ref())
        )));
        index = 0;
        while (index < user_args.len()) {
            args.add(user_args.get(index));
            index = index + 1;
        }
        jil.CallCallee call_callee = jil.indirect_operand_callee(
            jil.copy_operand_value(jil.CopyOperand (
                place: support.stable_place(self.lowerer.storage, slot_location$.ref())
            ))
        );
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: call_callee,
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: is_suspend_point,
            destination: destination,
            target: next_block,
            initialized_place: null,
            return_lifetime_flows: return_lifetime_flows,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    @life(return: self.d)
    public jil.Operand trait_object_method_value_operand(Self&! self, sem.NodeId node_id) {
        sem.Node node = self.lowerer.model.node(node_id);
        guard node.data is .member_access(member_access) else {
            return self.unsupported_operand(node_id);
        }
        guard self.lowerer.store.typeck.member_selection(node_id) is .some(trait_member) else {
            return self.unsupported_operand(node_id);
        }
        guard self.lowerer.store.defs.get(trait_member).owner_def is .some(trait_def) else {
            return self.unsupported_operand(node_id);
        }
        guard self.trait_vtable_slot_index(trait_def, trait_member) is .some(slot_index) else {
            return self.unsupported_operand(node_id);
        }
        jil.Place any_place = self.member_lookup_base_place(member_access.base);
        jil.Place vtable_place = self.project_constant_index(any_place, 1);
        jil.Place slot_place = self.project_constant_index(vtable_place, slot_index + 1);
        return jil.copy_operand_value(jil.CopyOperand (place: slot_place));
    }

    public Void lower_init_constructor_call(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId init_def,
        jil.Place destination
    ) {
        qid.DefId target_def = self.direct_call_target(node_id, init_def);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>();
        qid.TypeId function_type = self.function_type_for_call_target(
            node_id, call.callee, target_def, null
        );
        args.add(self.borrow_destination_operand(destination, self.lowerer.model_span(node_id)));
        self.add_constructor_call_operands(node_id, call, args$.mut_ref(), function_type);
        jil.LocalId unit_local = self.add_temp(
            self.lowerer.store.types.unit_type(),
            self.lowerer.model_span(node_id)
        );
        jil.BlockId next_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        FunctionRefArgs callee_args = self.function_call_args(
            node_id, call.callee, target_def
        );
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: self.function_callee_with_args(
                call.callee,
                target_def,
                function_type,
                callee_args
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: self.place_for_local(unit_local),
            target: next_block,
            initialized_place: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), self.lowerer.model_span(node_id));
        self.builder.start_block(next_block);
    }

    @life(return: destination)
    public jil.Operand borrow_destination_operand(self, jil.Place destination, token.Span span) {
        return jil.out_operand_value(jil.OutOperand (place: destination));
    }

    public Void add_constructor_call_operands(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        list.ArrayList<jil.Operand>&! args,
        qid.TypeId function_type
    ) {
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(_)) {
            Int ordered_count = self.lowerer.typeck.ordered_call_arg_count(node_id);
            Int ordered_index! = 0;
            while (ordered_index < ordered_count) {
                sem.NodeId value = self.lowerer.typeck.ordered_call_arg_at(node_id, ordered_index);
                jil.Operand operand = self.lower_call_arg_operand(
                    value, function_type, ordered_index + 1
                );
                args.add(operand);
                ordered_index = ordered_index + 1;
            }
            return;
        }
        Int index! = 0;
        while (index < call.args.length) {
            sem.NodeId value = call.args[index].value;
            jil.Operand operand = self.lower_call_arg_operand(
                value, function_type, index + 1
            );
            args.add(operand);
            index = index + 1;
        }
    }

    public Bool is_enum_init_call(self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.lowerer.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return false; }
        if (!self.symbol_text_equal(member_access.member_symbol, "init?")) { return false; }
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        guard self.nominal_def_kind(enum_type) is .some(kind) else { return false; }
        return kind == .enum_def;
    }

    public Bool is_enum_type_constructor_call(self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.lowerer.model.node(call.callee);
        if (!self.is_type_ref_data(callee.data)) { return false; }
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        guard self.nominal_def_kind(enum_type) is .some(kind) else { return false; }
        return kind == .enum_def;
    }

    public Bool is_type_ref_data(self, sem.NodeData data) {
        if (data is .named_type_ref(_)) { return true; }
        if (data is .layered_type_ref(_)) { return true; }
        if (data is .array_type_ref(_)) { return true; }
        if (data is .errorable_type_ref(_)) { return true; }
        if (data is .function_type_ref(_)) { return true; }
        if (data is .tuple_type_ref(_)) { return true; }
        if (data is .unit_type_ref()) { return true; }
        if (data is .infer_type_ref()) { return true; }
        return data is .invalid_type_ref;
    }

    public Void lower_enum_init_call(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId enum_type = self.optional_payload_type(self.type_for_node(node_id));
        qid.TypeId value_type = self.type_for_node(call.args[0].value);
        jil.LocalId value_local = self.add_temp(value_type, span);
        self.lower_into_place(call.args[0].value, self.place_for_local(value_local));

        jil.BlockId default_block = self.builder.reserve_block(span);
        jil.BlockId join_block = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>();
        self.add_enum_init_cases(enum_type, value_type, span, cases$.mut_ref());
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: jil.copy_operand_value(jil.CopyOperand (
                place: self.place_for_local(value_local)
            )),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: default_block
        )), span);

        self.lower_enum_init_case_blocks(enum_type, destination, join_block, cases$.ref(), span);
        self.builder.start_block(default_block);
        self.builder.push_assign(destination, self.optional_none_rvalue(span), span);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)), span);
        self.builder.start_block(join_block);
    }

    public Void add_enum_init_cases(Self&! self,
        qid.TypeId enum_type,
        qid.TypeId value_type,
        token.Span span,
        list.ArrayList<jil.SwitchCase>&! cases
    ) {
        guard self.nominal_type_data(enum_type) is .some(named) else { return; }
        qid.DefId enum_def = named.def_id;
        Int index! = 0;
        while (index < self.lowerer.model.def_member_count(enum_def)) {
            qid.DefId case_def = self.lowerer.model.def_member_at(enum_def, index);
            index = index + 1;
            if (self.lowerer.store.defs.get(case_def).kind != .enum_case_def) { continue; }
            jil.Const value = self.enum_case_int_const(case_def, value_type, span);
            jil.BlockId target = self.builder.reserve_block(span);
            cases.add(jil.SwitchCase (value: value, target: target));
        }
    }

    public Void lower_enum_init_case_blocks(Self&! self,
        qid.TypeId enum_type,
        jil.Place destination,
        jil.BlockId join_block,
        list.ArrayList<jil.SwitchCase>& cases,
        token.Span span
    ) {
        Int index! = 0;
        while (index < cases.len()) {
            jil.SwitchCase switch_case = cases.get(index);
            self.builder.start_block(switch_case.target);
            self.builder.push_assign(
                destination,
                self.optional_some_enum_rvalue(enum_type, switch_case.value, span),
                span
            );
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)), span);
            index = index + 1;
        }
    }

    public jil.Rvalue optional_some_enum_rvalue(self,
        qid.TypeId enum_type,
        jil.Const switch_value,
        token.Span span
    ) {
        return jil.optional_rvalue(jil.OptionalRvalue (
            op: jil.OptionalOp.make_some,
            value: jil.const_operand_value(jil.Const (
                type_id: enum_type,
                span: span,
                value: switch_value.value
            ))
        ));
    }

    public jil.Rvalue optional_none_rvalue(self, token.Span span) {
        return jil.optional_rvalue(jil.OptionalRvalue (
            op: jil.OptionalOp.make_none,
            value: self.unit_operand(span)
        ));
    }

    public jil.Operand unit_operand(self, token.Span span) {
        return jil.const_operand_value(jil.Const (
            type_id: self.lowerer.store.types.unit_type(),
            span: span,
            value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
        ));
    }

    public jil.Const enum_case_int_const(self, qid.DefId case_def, qid.TypeId value_type, token.Span span) {
        return jil.Const (
            type_id: value_type,
            span: span,
            value: jil.int_const_kind(jil.IntConst (
                bits: UInt64(self.enum_case_value_or_error(case_def)),
                signed_value: true
            ))
        );
    }

    public qid.TypeId optional_payload_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        return self.lowerer.store.types.invalid_type();
    }

    public Void lower_special_call(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        typeck_store.ExprLoweringKind lowering_kind,
        jil.Place destination
    ) {
        if (lowering_kind == .builtin_numeric) {
            self.lower_builtin_numeric_init(node_id, call, destination);
            return;
        }
        if (lowering_kind == .enum_discriminant) {
            self.lower_enum_discriminant_init(node_id, call, destination);
            return;
        }
        if (lowering_kind == .raw_fn_to_fn) {
            self.lower_raw_fn_to_fn(node_id, call, destination);
            return;
        }
        if (lowering_kind == .coroutine_sync) {
            self.lower_coroutine_sync(node_id, call, destination);
            return;
        }
        if (lowering_kind == .trait_object_method_call) {
            self.lower_planned_trait_object_method_call(node_id, destination);
            return;
        }
        self.lower_default_nominal_init(node_id, call, destination);
    }

    public Void lower_coroutine_sync(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        jil.Place destination
    ) {
        sem.NodeId closure_id = call.args[1].value;
        sem.Node closure_node = self.lowerer.model.node(closure_id);
        guard closure_node.data is .lambda_expr(lambda) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        qid.DefId function_def = lambda.function_def;
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(self.lambda_env_operand(closure_id, lambda, span));
        list.ArrayList<types.GenericArg> function_args! =
            self.owned_generic_args(self.function_args.slice());
        if (!self.current_effects.has_async) {
            self.lower_symbolic_async_sync_call(
                function_def,
                function_args.slice(),
                self.lowerer.storage.operand_array(args$.ref()),
                destination,
                span
            );
            return;
        }
        self.lower_async_direct_call(
            function_def,
            function_args.slice(),
            self.lowerer.storage.operand_array(args$.ref()),
            destination,
            span
        );
    }

    public Void lower_symbolic_async_sync_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId function_type = self.function_type_for_ref(
            target_def, function_args
        );
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.direct_function_callee(jil.FunctionRef (
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                coroutine_sync: true,
                coroutine_resume: false,
                coroutine_completion: false,
                type_id: function_type
            )),
            args: self.lowerer.storage.operand_slice(args),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: destination,
            target: next_block,
            initialized_place: null,
            return_lifetime_flows: self.type_return_lifetime_flows(function_type, 0),
            lifetime_args: args,
            lifetime_destination: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void lower_raw_fn_to_fn(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId raw_type = self.type_for_node(call.args[0].value);
        qid.TypeId closure_type = self.type_for_node(node_id);
        token.Span span = self.lowerer.model_span(node_id);
        jil.GlobalId vtable_id = self.ensure_raw_fn_vtable_global(
            node_id, raw_type, closure_type
        );
        qid.TypeId vtable_type = self.closure_vtable_pointer_type(closure_type, span);
        jil.Operand environment = self.erased_raw_fn_env_operand(
            call.args[0].value, raw_type, span
        );
        self.push_closure_assign(
            node_id,
            destination,
            closure_type,
            environment,
            self.raw_fn_vtable_operand_for_id(vtable_id, vtable_type)
        );
    }

    public jil.Operand raw_fn_vtable_operand(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId raw_type,
        qid.TypeId closure_type,
        token.Span span
    ) {
        jil.GlobalId global_id = self.ensure_raw_fn_vtable_global(node_id, raw_type, closure_type);
        qid.TypeId vtable_type = self.closure_vtable_pointer_type(closure_type, span);
        return self.raw_fn_vtable_operand_for_id(global_id, vtable_type);
    }

    public jil.Operand raw_fn_vtable_operand_for_id(
        self,
        jil.GlobalId id,
        qid.TypeId vtable_type
    ) {
        return jil.global_address_operand_value(jil.GlobalRef (
            id: id,
            type_id: vtable_type
        ));
    }

    public jil.GlobalId ensure_raw_fn_vtable_global(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId raw_type,
        qid.TypeId closure_type
    ) {
        Int key = raw_type.to_index();
        if (self.lowerer.raw_fn_vtable_globals.get(key) is .some(existing)) {
            return existing$.get();
        }
        token.Span span = self.lowerer.model_span(node_id);
        std.String name = build_text_int("__raw_fn_vtable_", raw_type.to_index());
        jil.GlobalId id = jil.GlobalId.from_index(self.lowerer.program.globals.len());
        self.lowerer.program.add_global(jil.Global (
            id: id,
            origin: .generated(self.generated_global_origin(
                name.bytes(), .raw_fn_vtable, self.def_id, raw_type
            )),
            type_id: self.closure_vtable_type(closure_type, span),
            span: span,
            read_only: true,
            is_external: false,
            initializer: self.raw_fn_vtable_static_value(node_id, raw_type, closure_type)
        ));
        self.lowerer.raw_fn_vtable_globals.set(key, id);
        return id;
    }

    public jil.StaticValue raw_fn_vtable_static_value(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId raw_type,
        qid.TypeId closure_type
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId code_type = self.closure_code_type(closure_type);
        list.ArrayList<jil.StaticField> fields! = list.ArrayList<jil.StaticField>(2);
        jil.FunctionId shim_id = self.ensure_raw_fn_to_fn_shim(node_id, raw_type);
        fields.add(jil.StaticField (
            type_id: code_type,
            value: jil.function_static_value(jil.FunctionRef (
                target: .generated(self.lowerer.program.generated_function_target(shim_id)),
                args: self.lowerer.storage.empty_generic_args(),
                coroutine_resume: false,
            coroutine_completion: false,
                type_id: code_type
            ))
        ));
        fields.add(jil.StaticField (
            type_id: self.closure_drop_env_type(span),
            value: self.closure_noop_drop_static_value(span)
        ));
        return jil.StaticValue.aggregate(
            self.lowerer.storage.static_field_array(fields$.ref())
        );
    }

    public jil.Operand erased_raw_fn_env_operand(
        Self&! self,
        sem.NodeId raw_fn_id,
        qid.TypeId raw_type,
        token.Span span
    ) {
        qid.TypeId erased_type = self.closure_env_type(span);
        jil.LocalId raw_local = self.add_temp(raw_type, span);
        self.lower_into_place(raw_fn_id, self.place_for_local(raw_local));
        jil.LocalId erased_local = self.add_temp(erased_type, span);
        self.builder.push_assign(
            self.place_for_local(erased_local),
            jil.cast_rvalue(jil.CastRvalue (
                kind: self.cast_kind(raw_type, erased_type),
                value: self.operand_for_place(self.place_for_local(raw_local)),
                target_type: erased_type
            )),
            span
        );
        return self.operand_for_place(self.place_for_local(erased_local));
    }

    public jil.FunctionId ensure_raw_fn_to_fn_shim(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId raw_type
    ) {
        Int key = raw_type.to_index();
        if (self.lowerer.raw_fn_to_fn_shims.get(key) is .some(existing)) {
            return existing$.get();
        }
        token.Span span = self.lowerer.model_span(node_id);
        std.String name = build_text_int("__raw_fn_to_fn_", raw_type.to_index());
        jil.GeneratedFunctionOrigin origin = self.generated_function_origin(
            name.bytes(), .raw_fn_to_fn, self.def_id, raw_type
        );
        jil.FunctionId shim_id = self.add_raw_fn_to_fn_shim_function(origin, raw_type, span);
        self.lowerer.raw_fn_to_fn_shims.set(key, shim_id);
        return shim_id;
    }

    public jil.FunctionId add_raw_fn_to_fn_shim_function(
        Self&! self,
        jil.GeneratedFunctionOrigin origin,
        qid.TypeId raw_type,
        token.Span span
    ) {
        guard self.lowerer.store.types.function_type_head(raw_type) is .some(function_type) else {
            return jil.FunctionId.from_index(0);
        }
        if (function_type.effects.has_async) {
            return self.add_async_raw_fn_to_fn_shim_function(
                origin, raw_type, function_type, span
            );
        }
        Int function_index = self.lowerer.program.functions.len();
        jil.LocalId raw_local = jil.LocalId.from_index(function_type.param_count + 2);
        list.ArrayList<jil.LocalDecl> locals! = list.ArrayList<jil.LocalDecl>(function_type.param_count + 3);
        locals.add(self.raw_fn_to_fn_local(0, .return_place, function_type.result, span, null));
        locals.add(self.raw_fn_to_fn_local(
            1,
            .param,
            self.closure_env_type(span),
            span,
            self.lowerer.closure_env_symbol
        ));
        Int param_index! = 0;
        while (param_index < function_type.param_count) {
            locals.add(self.raw_fn_to_fn_local(
                param_index + 2,
                .param,
                self.lowerer.store.types.function_type_param_at(raw_type, param_index),
                span,
                null
            ));
            param_index = param_index + 1;
        }
        locals.add(self.raw_fn_to_fn_local(raw_local.to_index(), .compiler_temp, raw_type, span, null));

        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
        statements.add(self.raw_fn_to_fn_cast_statement(raw_local, raw_type, span));
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(2);
        blocks.add(self.raw_fn_to_fn_call_block(
            raw_local, raw_type, function_type.param_count, statements$.ref(), span
        ));
        blocks.add(self.raw_fn_to_fn_return_block(function_type.result, span));
        jil.Body body = jil.Body(
            id: jil.BodyId.from_index(function_index),
            span: span,
            locals: self.raw_fn_to_fn_locals(locals$.ref()),
            blocks: self.lowerer.storage.block_array(blocks$.ref()),
            entry: jil.BlockId.from_index(0),
            return_local: jil.LocalId.from_index(0)
        );
        jil.FunctionId function_id = jil.FunctionId.from_index(function_index);
        self.lowerer.program.add_generated_function(jil.Function(
            id: function_id,
            origin: .generated(origin),
            args: self.lowerer.storage.empty_generic_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
        is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: false,
            naked: false,
            span: span,
            body: body
        ));
        self.mark_current_shared_codegen_function(function_id);
        self.lowerer.program.mark_borrow_check_exempt(function_id);
        return function_id;
    }

    public jil.FunctionId add_async_raw_fn_to_fn_shim_function(
        Self&! self,
        jil.GeneratedFunctionOrigin origin,
        qid.TypeId raw_type,
        types.FunctionTypeHead function_type,
        token.Span span
    ) {
        Int function_index = self.lowerer.program.functions.len();
        Int param_count = function_type.param_count;
        jil.LocalId continuation_local = jil.LocalId.from_index(param_count + 2);
        jil.LocalId raw_local = jil.LocalId.from_index(param_count + 3);
        qid.TypeId abi_type = self.lowerer.external_async_abi_function_type(raw_type, span);
        list.ArrayList<jil.LocalDecl> locals! = list.ArrayList<jil.LocalDecl>(param_count + 4);
        locals.add(self.raw_fn_to_fn_local(
            0, .return_place, self.lowerer.store.types.unit_type(), span, null
        ));
        locals.add(self.raw_fn_to_fn_local(
            1,
            .param,
            self.closure_env_type(span),
            span,
            self.lowerer.closure_env_symbol
        ));
        Int param_index! = 0;
        while (param_index < param_count) {
            locals.add(self.raw_fn_to_fn_local(
                param_index + 2,
                .param,
                self.lowerer.store.types.function_type_param_at(raw_type, param_index),
                span,
                null
            ));
            param_index = param_index + 1;
        }
        jil.ExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(function_type.result, span);
        locals.add(self.raw_fn_to_fn_local(
            continuation_local.to_index(), .param, continuation_layout.pointer_type_id, span, null
        ));
        locals.add(self.raw_fn_to_fn_local(
            raw_local.to_index(), .compiler_temp, abi_type, span, null
        ));
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
        statements.add(self.raw_fn_to_fn_cast_statement(raw_local, abi_type, span));
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(2);
        blocks.add(self.async_raw_fn_to_fn_call_block(
            raw_local,
            continuation_local,
            raw_type,
            param_count,
            statements$.ref(),
            span
        ));
        blocks.add(self.raw_fn_to_fn_return_block(self.lowerer.store.types.unit_type(), span));
        jil.FunctionId function_id = jil.FunctionId.from_index(function_index);
        self.lowerer.program.add_generated_function(jil.Function (
            id: function_id,
            origin: .generated(origin),
            args: self.lowerer.storage.empty_generic_args(),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: jil.Body (
                id: jil.BodyId.from_index(function_index),
                span: span,
                locals: self.raw_fn_to_fn_locals(locals$.ref()),
                blocks: self.lowerer.storage.block_array(blocks$.ref()),
                entry: jil.BlockId.from_index(0),
                return_local: jil.LocalId.from_index(0)
            )
        ));
        self.mark_current_shared_codegen_function(function_id);
        self.lowerer.program.mark_borrow_check_exempt(function_id);
        return function_id;
    }

    public jil.Block async_raw_fn_to_fn_call_block(
        Self&! self,
        jil.LocalId raw_local,
        jil.LocalId continuation_local,
        qid.TypeId source_type,
        Int param_count,
        list.ArrayList<jil.Statement>& statements,
        token.Span span
    ) {
        types.LifetimeFlow[]& return_lifetime_flows = self.type_return_lifetime_flows(
            source_type, 0
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(
            param_count + 1
        );
        Int index! = 0;
        while (index < param_count) {
            args.add(jil.copy_operand_value(jil.CopyOperand (
                place: self.place_for_local(jil.LocalId.from_index(index + 2))
            )));
            index = index + 1;
        }
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: self.place_for_local(continuation_local)
        )));
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.lowerer.storage.statement_array(statements),
            terminator: jil.Terminator (
                span: span,
                kind: jil.call_terminator_kind(jil.CallTerminator (
                    callee: jil.indirect_operand_callee(jil.copy_operand_value(jil.CopyOperand (
                        place: self.place_for_local(raw_local)
                    ))),
                    args: self.lowerer.storage.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: self.place_for_local(jil.LocalId.from_index(0)),
                    target: jil.BlockId.from_index(1),
                    initialized_place: null,
                    return_lifetime_flows: return_lifetime_flows,
                    exclusive_places: self.lowerer.storage.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    public jil.LocalDecl raw_fn_to_fn_local(
        self,
        Int index,
        jil.LocalKind kind,
        qid.TypeId type_id,
        token.Span span,
        qid.SymbolId? name
    ) {
        return jil.LocalDecl(
            id: jil.LocalId.from_index(index),
            kind: kind,
            type_id: type_id,
            span: span,
            name: name,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    public jil.LocalDecl[]& raw_fn_to_fn_locals(self, list.ArrayList<jil.LocalDecl>& locals) {
        unsafe {
            jil.LocalDecl*! stored = self.lowerer.storage.alloc_local_array(locals.len());
            Int index! = 0;
            while (index < locals.len()) {
                stored[index] = locals.get(index);
                index = index + 1;
            }
            return stored[0..locals.len()];
        }
    }

    public jil.Statement raw_fn_to_fn_cast_statement(
        self,
        jil.LocalId raw_local,
        qid.TypeId raw_type,
        token.Span span
    ) {
        return jil.Statement(
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement(
                destination: self.place_for_local(raw_local),
                value: jil.cast_rvalue(jil.CastRvalue(
                    kind: jil.CastKind.ptr_to_ptr,
                    value: jil.copy_operand_value(jil.CopyOperand(place: self.place_for_local(jil.LocalId(1)))),
                    target_type: raw_type
                ))
            ))
        );
    }

    public jil.Block raw_fn_to_fn_call_block(
        Self&! self,
        jil.LocalId raw_local,
        qid.TypeId source_type,
        Int param_count,
        list.ArrayList<jil.Statement>& statements,
        token.Span span
    ) {
        types.LifetimeFlow[]& return_lifetime_flows = self.type_return_lifetime_flows(
            source_type, 0
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(param_count);
        Int index! = 0;
        while (index < param_count) {
            args.add(jil.copy_operand_value(jil.CopyOperand(
                place: self.place_for_local(jil.LocalId.from_index(index + 2))
            )));
            index = index + 1;
        }
        return jil.Block(
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.lowerer.storage.statement_array(statements),
            terminator: jil.Terminator(
                span: span,
                kind: jil.call_terminator_kind(jil.CallTerminator(
                    callee: jil.indirect_operand_callee(jil.copy_operand_value(jil.CopyOperand(
                        place: self.place_for_local(raw_local)
                    ))),
                    args: self.lowerer.storage.operand_slice(args.slice()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: self.place_for_local(jil.LocalId(0)),
                    target: jil.BlockId.from_index(1),
                    initialized_place: null,
                    return_lifetime_flows: return_lifetime_flows,
                    exclusive_places: self.lowerer.storage.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    public jil.Block raw_fn_to_fn_return_block(self, qid.TypeId result_type, token.Span span) {
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>();
        return jil.Block(
            id: jil.BlockId.from_index(1),
            span: span,
            statements: self.lowerer.storage.statement_array(statements$.ref()),
            terminator: jil.Terminator(
                span: span,
                kind: jil.return_terminator_kind(jil.ReturnTerminator(
                    implicit_unit: result_type == self.lowerer.store.types.unit_type()
                ))
            )
        );
    }

    public qid.TypeId closure_code_type(self, qid.TypeId raw_type) {
        return callable_abi.closure_code_type(self.lowerer.store.types$.ref(), raw_type);
    }

    public Bool call_can_lower_core_contiguous(Self&! self, sem.Call call) {
        guard self.lowerer.store.typeck.member_selection(call.callee) is .some(member_def) else {
            return false;
        }
        if (!self.is_core_contiguous_method(member_def)) {
            return false;
        }
        guard self.contiguous_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        return self.receiver_has_builtin_contiguous_storage(receiver);
    }

    public Bool lower_core_contiguous_call(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        guard self.contiguous_receiver_node(call.callee) is .some(receiver) else {
            return false;
        }
        guard self.lowerer.store.typeck.member_selection(call.callee) is .some(member_def) else {
            return false;
        }
        qid.SymbolId symbol = self.lowerer.store.defs.get(member_def).name.symbol;
        if (self.symbol_text_equal(symbol, "ptr")) {
            return self.lower_core_contiguous_pointer(node_id, receiver, destination);
        }
        if (self.symbol_text_equal(symbol, "length")) {
            return self.lower_core_contiguous_length(node_id, receiver, destination);
        }
        return false;
    }

    public Bool lower_core_contiguous_pointer(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId receiver,
        jil.Place destination
    ) {
        qid.TypeId value_type = self.contiguous_receiver_value_type(receiver);
        types.TypeInfo info = self.lowerer.store.types.get(value_type);
        if (info.data is .array_type(_)) {
            self.lower_array_place_ptr(
                node_id,
                self.contiguous_receiver_storage_place(receiver),
                self.jil_place_type(destination),
                destination
            );
            return true;
        }
        if (self.contiguous_data_place(receiver, value_type) is .some(data_place)) {
            self.builder.push_assign(
                destination,
                jil.cast_rvalue(jil.CastRvalue (
                    kind: jil.CastKind.ptr_to_ptr,
                    value: jil.copy_operand_value(jil.CopyOperand (place: data_place)),
                    target_type: self.jil_place_type(destination)
                )),
                self.lowerer.model_span(node_id)
            );
            return true;
        }
        return false;
    }

    public Bool lower_core_contiguous_length(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId receiver,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId value_type = self.contiguous_receiver_value_type(receiver);
        types.TypeInfo info = self.lowerer.store.types.get(value_type);
        if (info.data is .array_type(array_type)) {
            self.builder.push_assign(destination, self.int_const_rvalue(array_type.count, span), span);
            return true;
        }
        if (self.contiguous_length_place(receiver, value_type) is .some(length_place)) {
            self.builder.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (
                    value: jil.copy_operand_value(jil.CopyOperand (place: length_place))
                )),
                span
            );
            return true;
        }
        return false;
    }

    public Bool is_core_contiguous_method(self, qid.DefId function_def) {
        guard self.lowerer.store.resolve.core_traits.contiguous_trait is .some(contiguous_def) else {
            return false;
        }
        guard self.lowerer.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def.to_index() != contiguous_def.to_index()) {
            return false;
        }
        qid.SymbolId symbol = self.lowerer.store.defs.get(function_def).name.symbol;
        return self.symbol_text_equal(symbol, "ptr") || self.symbol_text_equal(symbol, "length");
    }

    public sem.NodeId? contiguous_receiver_node(self, sem.NodeId callee_id) {
        sem.Node callee = self.lowerer.model.node(callee_id);
        if (callee.data is .member_access(member_access)) {
            return member_access.base;
        }
        return null;
    }

    public Bool receiver_has_builtin_contiguous_storage(Self&! self, sem.NodeId receiver) {
        return self.type_has_builtin_contiguous_storage(self.contiguous_receiver_value_type(receiver));
    }

    public Bool type_has_builtin_contiguous_storage(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .slice_value_type(_)) { return true; }
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .slice) { return true; }
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.lowerer.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    public qid.TypeId contiguous_receiver_value_type(Self&! self, sem.NodeId receiver) {
        return self.member_lookup_value_type(self.receiver_expr_type(receiver));
    }

    public jil.Place contiguous_receiver_storage_place(Self&! self, sem.NodeId receiver) {
        jil.Place place! = self.pointer_base_place(receiver);
        if (self.contiguous_place_needs_deref(place)) {
            place = self.project_deref(place, self.place_is_raw_pointer(place));
        }
        return place;
    }

    public Bool contiguous_place_needs_deref(self, jil.Place place) {
        types.TypeInfo info = self.lowerer.store.types.get(self.jil_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .raw_pointer;
    }

    public jil.Place? contiguous_data_place(Self&! self, sem.NodeId receiver, qid.TypeId value_type) {
        if (!self.type_has_contiguous_slice_layout(value_type)) {
            return null;
        }
        return self.project_constant_index(self.contiguous_receiver_storage_place(receiver), 0);
    }

    public jil.Place? contiguous_length_place(Self&! self, sem.NodeId receiver, qid.TypeId value_type) {
        if (!self.type_has_contiguous_slice_layout(value_type)) {
            return null;
        }
        return self.project_constant_index(self.contiguous_receiver_storage_place(receiver), 1);
    }

    public Bool type_has_contiguous_slice_layout(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .slice_value_type(_)) { return true; }
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .slice) { return true; }
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.lowerer.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    public Void lower_builtin_numeric_init(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId source_type = self.type_for_node(call.args[0].value);
        qid.TypeId target_type = self.type_for_node(node_id);
        // builtin numeric init 目前没有用户可见函数体；JIL 用 cast_value
        // 表达底层转换，仍由 type check 的 constructor side table 触发。
        self.builder.push_assign(
            destination,
            jil.cast_rvalue(jil.CastRvalue (
                kind: self.cast_kind(source_type, target_type),
                value: self.lower_to_operand(call.args[0].value),
                target_type: target_type
            )),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_enum_discriminant_init(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        if (call.args.length != 1) {
            self.mark_unsupported(node_id);
            return;
        }
        qid.TypeId target_type = self.type_for_node(node_id);
        qid.TypeId source_type = self.type_for_node(call.args[0].value);
        qid.TypeId underlying_type = self.enum_underlying_type(source_type);
        self.builder.push_assign(
            destination,
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_int,
                value: self.enum_discriminant_operand(call.args[0].value, source_type, underlying_type),
                target_type: target_type
            )),
            self.lowerer.model_span(node_id)
        );
    }

    public jil.Operand enum_discriminant_operand(Self&! self,
        sem.NodeId value_id,
        qid.TypeId enum_type,
        qid.TypeId underlying_type
    ) {
        if (self.enum_case_def_for_value(value_id) is .some(case_def)) {
            jil.Const value = self.enum_case_int_const(case_def, underlying_type, self.lowerer.model_span(value_id));
            return jil.const_operand_value(value);
        }
        jil.LocalId temp = self.add_temp(underlying_type, self.lowerer.model_span(value_id));
        jil.Place place = self.enum_value_place(value_id, enum_type);
        self.builder.push_assign(
            self.place_for_local(temp),
            jil.discriminant_rvalue(jil.DiscriminantRvalue (place: place)),
            self.lowerer.model_span(value_id)
        );
        return jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(temp)));
    }

    public jil.Place enum_value_place(Self&! self, sem.NodeId value_id, qid.TypeId enum_type) {
        if (self.place_for_expr(value_id) is .some(place)) {
            return place;
        }
        jil.LocalId temp = self.add_temp(enum_type, self.lowerer.model_span(value_id));
        self.lower_into_place(value_id, self.place_for_local(temp));
        return self.place_for_local(temp);
    }

    public qid.TypeId enum_underlying_type(self, qid.TypeId enum_type) {
        guard self.nominal_type_data(enum_type) is .some(named) else {
            return self.lowerer.store.types.invalid_type();
        }
        if (self.lowerer.store.typeck.enum_underlying_type(named.def_id) is .some(type_id)) {
            return type_id;
        }
        return self.lowerer.store.types.int32_type();
    }

    public qid.DefId? enum_case_def_for_value(self, sem.NodeId value_id) {
        sem.Node node = self.lowerer.model.node(value_id);
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .def_ref(def_id)) {
                if (self.lowerer.store.defs.get(def_id).kind == .enum_case_def) {
                    return def_id;
                }
            }
        }
        if (node.data is .member_access(_)) {
            if (self.lowerer.typeck.member_selection(value_id) is .some(member_def)) {
                if (self.lowerer.store.defs.get(member_def).kind == .enum_case_def) {
                    return member_def;
                }
            }
        }
        return null;
    }

    public Void lower_default_nominal_init(Self&! self, sem.NodeId node_id, sem.Call call, jil.Place destination) {
        qid.TypeId type_id = self.type_for_node(node_id);
        guard self.lowerer.store.types.get(type_id).data is .named(named) else {
            self.mark_unsupported(node_id);
            return;
        }
        qid.DefId owner_def = named.def_id;
        generic_bindings.GenericBindings substitutions = self.nominal_substitution(
            owner_def, named.args
        );
        guard self.lowerer.model.def(owner_def) is .some(owner_model) else {
            self.mark_unsupported(node_id);
            return;
        }
        Int member_count = owner_model.members.len();
        if (self.lowerer.typeck.ordered_call_args(node_id) is .some(_)) {
            self.lower_default_nominal_ordered_fields(
                node_id,
                owner_def,
                member_count,
                destination,
                substitutions$.ref()
            );
            return;
        }
        Int index! = 0;
        while (index < member_count) {
            guard self.lowerer.model.def(owner_def) is .some(current_owner) else { return; }
            qid.DefId member_def = current_owner.members.get(index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                guard self.lower_default_nominal_field(
                        node_id, destination, member_def, substitutions$.ref()
                    ) else {
                    self.mark_unsupported(node_id);
                    return;
                }
            }
            index = index + 1;
        }
    }

    public Void lower_default_nominal_ordered_fields(Self&! self,
        sem.NodeId node_id,
        qid.DefId owner_def,
        Int member_count,
        jil.Place destination,
        generic_bindings.GenericBindings& substitutions
    ) {
        Int field_index! = 0;
        Int member_index! = 0;
        while (member_index < member_count) {
            guard self.lowerer.model.def(owner_def) is .some(owner_model) else { return; }
            qid.DefId member_def = owner_model.members.get(member_index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                if (!self.lower_default_nominal_ordered_field(
                    destination,
                    member_def,
                    substitutions,
                    node_id,
                    field_index
                )) {
                    self.mark_unsupported(node_id);
                    return;
                }
                field_index = field_index + 1;
            }
            member_index = member_index + 1;
        }
    }

    public Bool lower_default_nominal_ordered_field(Self&! self,
        jil.Place destination,
        qid.DefId field_def,
        generic_bindings.GenericBindings& substitutions,
        sem.NodeId call_id,
        Int field_index
    ) {
        if (field_index >= self.lowerer.typeck.ordered_call_arg_count(call_id)) { return false; }
        sem.NodeId value = self.lowerer.typeck.ordered_call_arg_at(call_id, field_index);
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        jil.Place field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(value, field_place, field_type);
        return true;
    }

    public Bool lower_default_nominal_field(Self&! self,
        sem.NodeId call_id,
        jil.Place destination,
        qid.DefId field_def,
        generic_bindings.GenericBindings& substitutions
    ) {
        guard self.default_constructor_field_value(call_id, field_def) is .some(value) else {
            return false;
        }
        guard self.field_expected_type(field_def, substitutions) is .some(field_type) else { return false; }
        jil.Place field_place = self.project_field(destination, field_def, field_type);
        self.lower_into_place_as_type(value, field_place, field_type);
        return true;
    }

    public sem.NodeId? default_constructor_field_value(
        self,
        sem.NodeId call_id,
        qid.DefId field_def
    ) {
        qid.SymbolId symbol = self.lowerer.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < self.lowerer.model.call_arg_count(call_id)) {
            sem.CallArg arg = self.lowerer.model.call_arg_at(call_id, index);
            if (arg.label is .some(label)) {
                if (label == symbol) {
                    return arg.value;
                }
            }
            index = index + 1;
        }
        guard self.lowerer.model.def(field_def) is .some(field_model) else { return null; }
        if (field_model.decl.field_default is .some(default_value)) {
            return default_value;
        }
        return null;
    }

    public Void lower_call_to_function_def(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId function_def,
        jil.Place destination
    ) {
        qid.DefId target_def = self.direct_call_target(node_id, function_def);
        def.DefKind target_kind = self.lowerer.store.defs.get(target_def).kind;
        if (self.is_assert_call(target_def, target_kind)) {
            self.lower_builtin_assert(node_id, call);
            return;
        }
        if (self.is_coroutine_suspend_def(target_def)) {
            self.lower_coroutine_suspend(node_id, call, destination);
            return;
        }
        if (self.is_coroutine_check_cancelled_def(target_def)) {
            self.lower_coroutine_check_cancelled(node_id, destination);
            return;
        }
        if (self.is_continuation_resume_def(target_def)) {
            self.lower_continuation_resume(node_id, call, destination);
            return;
        }
        if (self.is_continuation_on_cancel_def(target_def)) {
            self.lower_continuation_on_cancel(node_id, call, destination);
            return;
        }
        if (self.atomic_builtin(call, target_def) is .some(builtin)) {
            self.lower_atomic_builtin_call(node_id, builtin, destination);
            return;
        }
        qid.TypeId? call_receiver_type = self.function_call_receiver_type(
            call.callee, target_def
        );
        qid.TypeId function_type = self.function_type_for_call_target(
            node_id, call.callee, target_def, call_receiver_type
        );
        if (self.function_type_is_async(function_type)) {
            list.ArrayList<jil.Operand> args! = self.lower_call_operands(
                node_id, call, target_def, function_type
            );
            FunctionRefArgs async_callee_args = self.function_call_args_for_receiver(
                node_id, call.callee, target_def, call_receiver_type
            );
            list.ArrayList<types.GenericArg> async_function_args! =
                self.owned_generic_args(async_callee_args.args);
            self.lower_async_direct_call(
                target_def,
                async_function_args.slice(),
                self.lowerer.storage.operand_array(args$.ref()),
                destination,
                self.lowerer.model_span(node_id)
            );
            return;
        }
        list.ArrayList<support.StablePlaceLocation> exclusive_locations =
            self.exclusive_place_locations_for_call(node_id, target_def);
        list.ArrayList<jil.Operand> args! = self.lower_call_operands(
            node_id, call, target_def, function_type
        );
        jil.BlockId next_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        FunctionRefArgs callee_args = self.function_call_args_for_receiver(
            node_id, call.callee, target_def, call_receiver_type
        );
        jil.Place[]& exclusive_places = self.freeze_exclusive_places(exclusive_locations$.ref());
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: self.function_callee_with_args(
                call.callee,
                target_def,
                function_type,
                callee_args
            ),
            args: self.lowerer.storage.operand_slice(args.slice()),
            current_effects: self.current_effects,
            is_suspend_point: self.function_type_is_async(function_type),
            destination: destination,
            target: next_block,
            initialized_place: null,
            exclusive_places: exclusive_places,
            cleanup: null
        )), self.lowerer.model_span(node_id));
        self.builder.start_block(next_block);
    }

    qid.TypeId function_type_for_call_target(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId callee_id,
        qid.DefId target_def,
        qid.TypeId? receiver_type
    ) {
        FunctionRefArgs args = self.function_call_args_for_receiver(
            node_id, callee_id, target_def, receiver_type
        );
        if (self.function_owner_is_trait(target_def)
            && self.lowerer.typeck.node_type(callee_id) is .some(checked_type)) {
            return self.function_type_with_args(
                target_def, args.args, checked_type
            );
        }
        return self.function_type_for_ref(target_def, args.args);
    }

    Bool function_owner_is_trait(self, qid.DefId function_def) {
        guard self.lowerer.store.defs.get(function_def).owner_def
            is .some(owner_def) else { return false; }
        return self.lowerer.store.defs.get(owner_def).kind == .trait_def;
    }

    public Void lower_atomic_builtin_call(
        Self&! self,
        sem.NodeId node_id,
        AtomicBuiltin builtin,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        sem.NodeId storage_value = self.lowerer.model.call_arg_at(node_id, 0).value;
        jil.LocalId storage_reference = self.atomic_builtin_storage_local(storage_value, span);
        if (builtin.kind == .load) {
            self.builder.push_assign(
                destination,
                jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                    place: self.project_deref(self.place_for_local(storage_reference), true),
                    ordering: builtin.success
                )),
                span
            );
            return;
        }
        sem.NodeId value_id = self.lowerer.model.call_arg_at(node_id, 1).value;
        jil.LocalId value_local = self.add_temp(self.type_for_node(value_id), span);
        self.lower_into_place(value_id, self.place_for_local(value_local));
        if (builtin.kind == .store) {
            jil.Place storage_place = self.project_deref(
                self.place_for_local(storage_reference), true
            );
            jil.Operand value = self.operand_for_place(self.place_for_local(value_local));
            self.builder.push_statement(jil.Statement (
                span: span,
                kind: jil.atomic_store_statement_kind(jil.AtomicStoreStatement (
                    destination: storage_place,
                    value: value,
                    ordering: builtin.success
                ))
            ));
            self.builder.push_assign(destination, self.unit_rvalue(span), span);
            return;
        }
        if (builtin.kind == .exchange) {
            self.builder.push_assign(
                destination,
                jil.atomic_exchange_rvalue(jil.AtomicExchangeRvalue (
                    place: self.project_deref(
                        self.place_for_local(storage_reference), true
                    ),
                    desired: self.operand_for_place(self.place_for_local(value_local)),
                    ordering: builtin.success
                )),
                span
            );
            return;
        }
        sem.NodeId desired_id = self.lowerer.model.call_arg_at(node_id, 2).value;
        jil.LocalId desired_local = self.add_temp(self.type_for_node(desired_id), span);
        self.lower_into_place(desired_id, self.place_for_local(desired_local));
        self.builder.push_assign(
            destination,
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_deref(self.place_for_local(storage_reference), true),
                expected: self.operand_for_place(self.place_for_local(value_local)),
                desired: self.operand_for_place(self.place_for_local(desired_local)),
                success_ordering: builtin.success,
                failure_ordering: builtin.failure
            )),
            span
        );
    }

    public jil.LocalId atomic_builtin_storage_local(
        Self&! self,
        sem.NodeId value_id,
        token.Span span
    ) {
        qid.TypeId reference_type = self.type_for_node(value_id);
        jil.LocalId reference = self.add_temp(reference_type, span);
        self.lower_into_place(value_id, self.place_for_local(reference));
        return reference;
    }

}
