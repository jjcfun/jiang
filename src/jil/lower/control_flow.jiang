// 条件、模式、循环、switch 和比较控制流 lowering。
//
// 本模块是 lower/body 实现族的一部分，只在 Semantic Model -> JIL 阶段内使用。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import database = "../../db.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import std;
import support = "./support.jiang";
import * = "./model.jiang";
import * = "./context.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import expression = "./expression.jiang";
import task = "./task.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import closure = "./closure.jiang";
import constant = "./constant.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";
import pattern = "./pattern.jiang";

public extend body_context.BodyLowerer {
    public Void lower_if(Self&! self, sem.NodeId node_id, sem.If if_expr, jil.Place destination) {
        list.ArrayList<jil.LocalId> condition_locals! = list.ArrayList<jil.LocalId>();
        support.IfConditionLowerResult condition_result = self.lower_if_condition(if_expr.condition);
        jil.BlockId then_block = self.builder.reserve_block(self.lowerer.model_span(if_expr.then_body));
        jil.BlockId else_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        jil.BlockId join_block = self.builder.reserve_block(self.lowerer.model_span(node_id));

        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.if_condition_operand(condition_result$.ref()),
            then_target: then_block,
            else_target: else_block
        )), self.lowerer.model_span(if_expr.condition));

        Int active_depth = self.active_locals.len();
        self.builder.start_block(then_block);
        self.lower_if_condition_bindings(condition_result$.ref(), condition_locals$.mut_ref());
        self.lower_into_place(if_expr.then_body, destination);
        if (!self.builder.terminated) {
            self.end_scope(condition_locals$.ref(), self.lowerer.model_span(if_expr.then_body));
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)),
                self.lowerer.model_span(node_id)
            );
        }
        self.restore_active_locals(active_depth);

        self.builder.start_block(else_block);
        if (if_expr.else_body is .some(else_body)) {
            self.lower_into_place(else_body, destination);
        } else {
            self.builder.push_assign(
                destination,
                self.unit_rvalue(self.lowerer.model_span(node_id)),
                self.lowerer.model_span(node_id)
            );
        }
        if (!self.builder.terminated) {
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)),
                self.lowerer.model_span(node_id)
            );
        }
        self.restore_active_locals(active_depth);

        self.builder.start_block(join_block);
    }

    public Void lower_guard(Self&! self, sem.NodeId node_id, sem.Guard guard_stmt) {
        support.IfConditionLowerResult condition = self.lower_if_condition(guard_stmt.condition);
        jil.BlockId continue_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        jil.BlockId else_block = self.builder.reserve_block(self.lowerer.model_span(guard_stmt.else_body));
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.if_condition_operand(condition$.ref()),
            then_target: continue_block,
            else_target: else_block
        )), self.lowerer.model_span(guard_stmt.condition));

        self.builder.start_block(else_block);
        self.lower_expr_statement(guard_stmt.else_body);
        if (!self.builder.terminated) {
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: continue_block)),
                self.lowerer.model_span(node_id)
            );
        }

        self.builder.start_block(continue_block);
        list.ArrayList<jil.LocalId> condition_locals! = list.ArrayList<jil.LocalId>();
        self.lower_if_condition_bindings(condition$.ref(), condition_locals$.mut_ref());
    }

    public support.IfConditionLowerResult lower_logic_and_condition(
        Self&! self,
        sem.NodeId node_id,
        sem.Binary binary
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.LocalId result_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        support.IfConditionLowerResult left = self.lower_if_condition(binary.left);
        jil.BlockId rhs_block = self.builder.reserve_block(self.lowerer.model_span(binary.right));
        jil.BlockId false_block = self.builder.reserve_block(span);
        jil.BlockId join_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.if_condition_operand(left$.ref()),
            then_target: rhs_block,
            else_target: false_block
        )), self.lowerer.model_span(binary.left));

        Int active_depth = self.active_locals.len();
        self.builder.start_block(rhs_block);
        list.ArrayList<jil.LocalId> materialized! = list.ArrayList<jil.LocalId>();
        self.lower_if_condition_bindings(left$.ref(), materialized$.mut_ref());
        support.IfConditionLowerResult right = self.lower_if_condition(binary.right);
        self.builder.push_assign(
            self.place_for_local(result_local),
            jil.use_rvalue(jil.UseRvalue (value: self.if_condition_operand(right$.ref()))),
            span
        );
        if (!self.builder.terminated) {
            self.builder.finish_block(self.goto_terminator(join_block), span);
        }
        self.append_condition_active_locals(materialized$.mut_ref(), right.active_locals$.ref());
        self.restore_active_locals(active_depth);

        self.builder.start_block(false_block);
        self.builder.push_assign(self.place_for_local(result_local), self.bool_rvalue(false, span), span);
        self.builder.finish_block(self.goto_terminator(join_block), span);
        self.builder.start_block(join_block);

        return support.IfConditionLowerResult (
            condition_local: result_local,
            binding: right.binding,
            active_locals: materialized
        );
    }

    public Void lower_loop(Self&! self, sem.NodeId node_id, sem.Loop loop_expr, jil.Place destination) {
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            self.lower_for_loop(node_id, loop_expr, destination);
            return;
        }
        jil.BlockId header_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        jil.BlockId body_block = self.builder.reserve_block(self.lowerer.model_span(loop_expr.body));
        jil.BlockId exit_block = self.builder.reserve_block(self.lowerer.model_span(node_id));

        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)),
            self.lowerer.model_span(node_id)
        );
        self.builder.start_block(header_block);
        support.IfConditionLowerResult condition_result! = self.bool_if_condition_result(
            true, self.lowerer.model_span(node_id)
        );
        if (loop_expr.condition is .some(condition)) {
            condition_result = self.lower_if_condition(condition);
            self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
                condition: self.if_condition_operand(condition_result$.ref()),
                then_target: body_block,
                else_target: exit_block
            )), self.lowerer.model_span(condition));
        } else {
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: body_block)),
                self.lowerer.model_span(node_id)
            );
        }

        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(support.LoopTargets (
            continue_target: header_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.builder.start_block(body_block);
        list.ArrayList<jil.LocalId> condition_locals! = list.ArrayList<jil.LocalId>();
        self.lower_if_condition_bindings(condition_result$.ref(), condition_locals$.mut_ref());
        self.lower_expr_statement(loop_expr.body);
        if (!self.builder.terminated) {
            self.end_scope(condition_locals$.ref(), self.lowerer.model_span(loop_expr.body));
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)),
                self.lowerer.model_span(node_id)
            );
        }
        support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);

        self.builder.start_block(exit_block);
        self.builder.push_assign(
            destination,
            self.unit_rvalue(self.lowerer.model_span(node_id)),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_for_loop(Self&! self, sem.NodeId node_id, sem.Loop loop_expr, jil.Place destination) {
        guard loop_expr.iterable is .some(iterable) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard loop_expr.pattern is .some(pattern) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        sem.Node iterable_node = self.lowerer.model.node(iterable);
        if (iterable_node.data is .range_expr(range_expr)) {
            self.lower_range_for_loop(loop_expr, pattern, range_expr, destination, span);
            return;
        }
        if (self.lowerer.typeck.for_loop_contiguous_plan(node_id) is .some(plan)) {
            self.lower_contiguous_for_loop(loop_expr, pattern, iterable, plan, destination, span);
            return;
        }
        if (self.lowerer.typeck.for_loop_sequence_plan(node_id) is .some(plan)) {
            self.lower_sequence_for_loop(loop_expr, pattern, iterable, plan, destination, span);
            return;
        }
        self.mark_unsupported(node_id);
    }

    public Void lower_contiguous_for_loop(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        sem.NodeId iterable,
        typeck_store.ForLoopContiguousPlan plan,
        jil.Place destination,
        token.Span span
    ) {
        if (self.lower_contiguous_trait_for_loop(loop_expr, pattern, iterable, plan, destination, span)) {
            return;
        }
        jil.LocalId index_local = self.add_loop_index_local(span);
        jil.LocalId len_local = self.add_loop_len_local(span);
        support.StablePlaceLocation iterable_location =
            self.stable_place_location(self.pointer_base_place(iterable));
        self.init_for_loop_counters(iterable_location$.ref(), index_local, len_local, span);
        self.lower_for_loop_cfg(
            loop_expr,
            pattern,
            iterable_location$.ref(),
            index_local,
            len_local,
            destination,
            span
        );
    }

    public Bool lower_contiguous_trait_for_loop(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        sem.NodeId iterable,
        typeck_store.ForLoopContiguousPlan plan,
        jil.Place destination,
        token.Span span
    ) {
        guard plan.pointer_def is .some(pointer_def) else { return false; }
        guard plan.length_def is .some(length_def) else { return false; }
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        qid.TypeId pointer_type = self.lowerer.store.types.raw_pointer_type(element_type, span);
        jil.LocalId pointer_local = self.add_temp(pointer_type, span);
        jil.LocalId len_local = self.add_loop_len_local(span);
        qid.TypeId receiver_type = self.type_for_node(iterable);
        support.StablePlaceLocation receiver = self.stable_place_location(
            self.contiguous_receiver_place(iterable, span)
        );
        self.lower_contiguous_method_call(
            receiver$.ref(),
            receiver_type,
            pointer_def,
            pointer_local,
            span
        );
        self.lower_contiguous_method_call(
            receiver$.ref(),
            receiver_type,
            length_def,
            len_local,
            span
        );
        if (self.builder.terminated) { return true; }
        jil.LocalId index_local = self.add_loop_index_local(span);
        self.builder.push_assign(self.place_for_local(index_local), self.int_const_rvalue(0, span), span);
        support.StablePlaceLocation pointer =
            self.stable_place_location(self.place_for_local(pointer_local));
        self.lower_for_loop_cfg(
            loop_expr,
            pattern,
            pointer$.ref(),
            index_local,
            len_local,
            destination,
            span
        );
        return true;
    }

    public jil.Place contiguous_receiver_place(Self&! self, sem.NodeId iterable, token.Span span) {
        if (self.place_for_expr(iterable) is .some(place)) {
            return place;
        }
        qid.TypeId receiver_type = self.type_for_node(iterable);
        jil.LocalId receiver_local = self.add_temp(receiver_type, span);
        self.lower_into_place(iterable, self.place_for_local(receiver_local));
        return self.place_for_local(receiver_local);
    }

    public Void lower_contiguous_method_call(Self&! self,
        support.StablePlaceLocation& receiver,
        qid.TypeId receiver_type,
        qid.DefId method_def,
        jil.LocalId destination,
        token.Span span
    ) {
        jil.Place receiver_place = self.stable_place(receiver);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(method_def) == .mutable_ref_receiver;
        args.add(self.receiver_operand_for_place(receiver_place, receiver_type, mutable_reference, span));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(receiver_type, method_def);
        self.lower_direct_function_call_with_type_args(
            method_def,
            type_args,
            args$.ref(),
            self.place_for_local(destination),
            span
        );
    }

    @life(return: self & receiver_place)
    public jil.Operand receiver_operand_for_place(
        Self&! self,
        jil.Place receiver_place,
        qid.TypeId receiver_type,
        Bool mutable_reference,
        token.Span span
    ) {
        if (self.type_is_reference(receiver_type)) {
            return jil.copy_operand_value(jil.CopyOperand (place: receiver_place));
        }
        return self.borrow_receiver_place(receiver_place, receiver_type, mutable_reference, span);
    }

    public Void lower_range_for_loop(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        sem.Range range_expr,
        jil.Place destination,
        token.Span span
    ) {
        jil.LocalId index_local = self.add_loop_index_local(span);
        jil.LocalId end_local = self.add_loop_len_local(span);
        self.lower_into_place(range_expr.start, self.place_for_local(index_local));
        self.lower_into_place(range_expr.end, self.place_for_local(end_local));
        if (self.builder.terminated) {
            return;
        }
        self.lower_range_for_loop_cfg(loop_expr, pattern, index_local, end_local, destination, span);
    }

    public Void lower_sequence_for_loop(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        sem.NodeId iterable,
        typeck_store.ForLoopSequencePlan plan,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId iterator_type = self.lowerer.substitute_type(plan.iterator_type, self.substitutions);
        jil.LocalId iterator_local = self.add_temp(iterator_type, span);
        self.lower_sequence_make_iterator(iterable, plan, iterator_local, span);
        if (self.builder.terminated) { return; }
        self.lower_sequence_for_loop_cfg(loop_expr, pattern, plan, iterator_local, destination, span);
    }

    public Void lower_sequence_make_iterator(Self&! self,
        sem.NodeId iterable,
        typeck_store.ForLoopSequencePlan plan,
        jil.LocalId iterator_local,
        token.Span span
    ) {
        qid.TypeId receiver_type = self.type_for_node(iterable);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(plan.make_iterator_def) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(iterable, mutable_reference));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(receiver_type, plan.make_iterator_def);
        self.lower_direct_function_call_with_type_args(
            plan.make_iterator_def,
            type_args,
            args$.ref(),
            self.place_for_local(iterator_local),
            span
        );
    }

    public Void lower_sequence_for_loop_cfg(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        typeck_store.ForLoopSequencePlan plan,
        jil.LocalId iterator_local,
        jil.Place destination,
        token.Span span
    ) {
        jil.BlockId header_block = self.builder.reserve_block(span);
        jil.BlockId body_block = self.builder.reserve_block(self.lowerer.model_span(loop_expr.body));
        jil.BlockId increment_block = self.builder.reserve_block(span);
        jil.BlockId exit_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)), span);
        jil.LocalId next_local = self.lower_sequence_for_loop_header(
            header_block,
            body_block,
            exit_block,
            plan,
            iterator_local,
            span
        );
        self.lower_sequence_for_loop_body(
            loop_expr,
            pattern,
            plan,
            next_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.builder.start_block(increment_block);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)), span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    public jil.LocalId lower_sequence_for_loop_header(Self&! self,
        jil.BlockId header_block,
        jil.BlockId body_block,
        jil.BlockId exit_block,
        typeck_store.ForLoopSequencePlan plan,
        jil.LocalId iterator_local,
        token.Span span
    ) {
        self.builder.start_block(header_block);
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        qid.TypeId next_type = self.lowerer.store.types.optional_type(element_type, span);
        jil.LocalId next_local = self.add_temp(next_type, span);
        self.lower_sequence_next_call(plan, iterator_local, next_local, span);
        jil.LocalId cond_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(cond_local),
            jil.optional_rvalue(jil.OptionalRvalue (
                op: jil.OptionalOp.is_some,
                value: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(next_local)))
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(cond_local))),
            then_target: body_block,
            else_target: exit_block
        )), span);
        return next_local;
    }

    public Void lower_sequence_next_call(Self&! self,
        typeck_store.ForLoopSequencePlan plan,
        jil.LocalId iterator_local,
        jil.LocalId next_local,
        token.Span span
    ) {
        qid.TypeId iterator_type = self.lowerer.substitute_type(plan.iterator_type, self.substitutions);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        Bool mutable_reference = self.function_self_receiver_mode(plan.next_def) == .mutable_ref_receiver;
        args.add(self.borrow_receiver_place(
            self.place_for_local(iterator_local),
            iterator_type,
            mutable_reference,
            span
        ));
        qid.TypeId[]& type_args = self.method_type_args_for_receiver(iterator_type, plan.next_def);
        self.lower_direct_function_call_with_type_args(
            plan.next_def,
            type_args,
            args$.ref(),
            self.place_for_local(next_local),
            span
        );
    }

    public Void lower_sequence_for_loop_body(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        typeck_store.ForLoopSequencePlan plan,
        jil.LocalId next_local,
        jil.BlockId body_block,
        jil.BlockId increment_block,
        jil.BlockId exit_block,
        jil.Place destination
    ) {
        qid.TypeId element_type = self.lowerer.substitute_type(plan.element_type, self.substitutions);
        jil.LocalId item_local = self.add_temp(element_type, self.lowerer.model_span(loop_expr.body));
        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(support.LoopTargets (
            continue_target: increment_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.builder.start_block(body_block);
        self.builder.push_assign(
            self.place_for_local(item_local),
            jil.optional_rvalue(jil.OptionalRvalue (
                op: jil.OptionalOp.unwrap_some,
                value: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(next_local)))
            )),
            self.lowerer.model_span(loop_expr.body)
        );
        list.ArrayList<jil.LocalId> item_locals! = list.ArrayList<jil.LocalId>();
        self.lower_payload_pattern(pattern, self.place_for_local(item_local), item_locals$.mut_ref());
        self.lower_expr_statement(loop_expr.body);
        self.finish_for_loop_body(increment_block, loop_expr, item_locals$.ref());
        support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);
    }

    public jil.LocalId add_loop_index_local(Self&! self, token.Span span) {
        qid.TypeId int_type = self.lowerer.store.types.int_type();
        return self.add_temp(int_type, span);
    }

    public jil.LocalId add_loop_len_local(Self&! self, token.Span span) {
        qid.TypeId int_type = self.lowerer.store.types.int_type();
        return self.add_temp(int_type, span);
    }

    public Void init_for_loop_counters(Self&! self,
        support.StablePlaceLocation& iterable,
        jil.LocalId index_local,
        jil.LocalId len_local,
        token.Span span
    ) {
        self.builder.push_assign(self.place_for_local(index_local), self.int_const_rvalue(0, span), span);
        jil.Place iterable_place = self.stable_place(iterable);
        self.builder.push_assign(
            self.place_for_local(len_local),
            jil.len_rvalue(jil.LenRvalue (place: iterable_place)),
            span
        );
    }

    public Void lower_for_loop_cfg(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        support.StablePlaceLocation& iterable,
        jil.LocalId index_local,
        jil.LocalId len_local,
        jil.Place destination,
        token.Span span
    ) {
        jil.BlockId header_block = self.builder.reserve_block(span);
        jil.BlockId body_block = self.builder.reserve_block(self.lowerer.model_span(loop_expr.body));
        jil.BlockId increment_block = self.builder.reserve_block(span);
        jil.BlockId exit_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, len_local, span);
        support.StablePlaceLocation item = self.stable_place_location(
            self.project_index(self.stable_place(iterable), index_local)
        );
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            item$.ref(),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    public Void lower_range_for_loop_cfg(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        jil.LocalId index_local,
        jil.LocalId end_local,
        jil.Place destination,
        token.Span span
    ) {
        jil.BlockId header_block = self.builder.reserve_block(span);
        jil.BlockId body_block = self.builder.reserve_block(self.lowerer.model_span(loop_expr.body));
        jil.BlockId increment_block = self.builder.reserve_block(span);
        jil.BlockId exit_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)), span);
        self.lower_for_loop_header(header_block, body_block, exit_block, index_local, end_local, span);
        support.StablePlaceLocation item =
            self.stable_place_location(self.place_for_local(index_local));
        self.lower_for_loop_body(
            loop_expr,
            pattern,
            item$.ref(),
            index_local,
            body_block,
            increment_block,
            exit_block,
            destination
        );
        self.lower_for_loop_increment(increment_block, index_local, header_block, span);
        self.lower_for_loop_exit(exit_block, destination, span);
    }

    public Void lower_for_loop_header(Self&! self,
        jil.BlockId header_block,
        jil.BlockId body_block,
        jil.BlockId exit_block,
        jil.LocalId index_local,
        jil.LocalId len_local,
        token.Span span
    ) {
        self.builder.start_block(header_block);
        jil.LocalId cond_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(cond_local),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.lt,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(index_local))),
                rhs: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(len_local)))
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(cond_local))),
            then_target: body_block,
            else_target: exit_block
        )), span);
    }

    public Void lower_for_loop_body(Self&! self,
        sem.Loop loop_expr,
        sem.NodeId pattern,
        support.StablePlaceLocation& item,
        jil.LocalId index_local,
        jil.BlockId body_block,
        jil.BlockId increment_block,
        jil.BlockId exit_block,
        jil.Place destination
    ) {
        Int active_depth = self.active_locals.len();
        Int defer_depth = self.active_defers.len();
        self.loop_targets.add(support.LoopTargets (
            continue_target: increment_block,
            break_target: exit_block,
            active_depth: active_depth,
            defer_depth: defer_depth
        ));
        self.builder.start_block(body_block);
        list.ArrayList<jil.LocalId> item_locals! = list.ArrayList<jil.LocalId>();
        self.lower_payload_pattern(
            pattern,
            self.stable_place(item),
            item_locals$.mut_ref()
        );
        self.lower_expr_statement(loop_expr.body);
        self.finish_for_loop_body(increment_block, loop_expr, item_locals$.ref());
        support.LoopTargets unused = self.loop_targets.pop();
        self.restore_active_locals(active_depth);
        self.restore_active_defers(defer_depth);
    }

    public Void finish_for_loop_body(Self&! self,
        jil.BlockId increment_block,
        sem.Loop loop_expr,
        list.ArrayList<jil.LocalId>& item_locals
    ) {
        if (self.builder.terminated) { return; }
        token.Span span = self.lowerer.model_span(loop_expr.body);
        self.end_scope(item_locals, span);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: increment_block)), span);
    }

    public Void lower_for_loop_increment(Self&! self,
        jil.BlockId increment_block,
        jil.LocalId index_local,
        jil.BlockId header_block,
        token.Span span
    ) {
        self.builder.start_block(increment_block);
        self.builder.push_assign(
            self.place_for_local(index_local),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.add,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(index_local))),
                rhs: jil.const_operand_value(self.int_const(1, span))
            )),
            span
        );
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: header_block)), span);
    }

    public Void lower_for_loop_exit(Self&! self, jil.BlockId exit_block, jil.Place destination, token.Span span) {
        self.builder.start_block(exit_block);
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
    }

    public Void lower_switch(Self&! self, sem.NodeId node_id, sem.Switch switch_expr, jil.Place destination) {
        qid.TypeId value_type = self.type_for_node(switch_expr.value);
        support.StablePlaceLocation? subject! = null;
        if (self.switch_subject_place(switch_expr, value_type) is .some(place)) {
            subject = self.stable_place_location(place);
        }
        qid.TypeId discriminator_type = self.switch_discriminator_type(value_type);
        jil.BlockId join_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        jil.BlockId default_block = self.builder.reserve_block(self.lowerer.model_span(node_id));
        jil.BlockId default_target! = default_block;
        list.ArrayList<jil.BlockId> body_blocks! = list.ArrayList<jil.BlockId>(switch_expr.cases.length);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>();
        list.ArrayList<support.SwitchPayloadEntry> payload_entries! =
            list.ArrayList<support.SwitchPayloadEntry>();

        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            token.Span body_span = self.lowerer.model_span(
                switch_expr.cases[case_index].body
            );
            jil.BlockId body_block = self.builder.reserve_block(body_span);
            body_blocks.add(body_block);
            default_target = self.add_switch_patterns(
                switch_expr.cases[case_index],
                body_block,
                default_target,
                value_type,
                discriminator_type,
                cases$.mut_ref(),
                payload_entries$.mut_ref()
            );
            case_index = case_index + 1;
        }

        self.finish_switch_dispatch(
            node_id,
            switch_expr.value,
            value_type,
            subject$.ref(),
            cases$.ref(),
            default_target
        );

        Int active_depth = self.active_locals.len();
        self.lower_switch_payload_entries(payload_entries$.ref(), subject$.ref(), value_type);
        self.restore_active_locals(active_depth);
        self.lower_switch_case_bodies(
            switch_expr,
            body_blocks$.ref(),
            destination,
            join_block,
            active_depth
        );
        self.restore_active_locals(active_depth);
        if (default_target.to_index() == default_block.to_index()) {
            self.builder.start_block(default_block);
            self.builder.finish_block(
                jil.unreachable_terminator_kind(jil.UnreachableTerminator (generated_by_check: true)),
                self.lowerer.model_span(node_id)
            );
        }
        self.builder.start_block(join_block);
    }

    public Void finish_switch_dispatch(Self&! self,
        sem.NodeId node_id,
        sem.NodeId value,
        qid.TypeId value_type,
        support.StablePlaceLocation?& subject,
        list.ArrayList<jil.SwitchCase>& cases,
        jil.BlockId default_target
    ) {
        types.TypeInfo value_info = self.lowerer.store.types.get(self.pattern_subject_type(value_type));
        if (value_info.data is .tuple_type(_)) {
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: default_target)),
                self.lowerer.model_span(node_id)
            );
            return;
        }
        jil.Place? subject_place! = null;
        if (subject is .some(ref _ location)) {
            subject_place = self.stable_place(location$.ref());
        }
        jil.Operand discriminator = self.lower_switch_discriminator(value, value_type, subject_place);
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: discriminator,
            cases: self.lowerer.storage.switch_case_array(cases),
            default_target: default_target
        )), self.lowerer.model_span(node_id));
    }

    public Void lower_catch(Self&! self, sem.NodeId node_id, sem.Catch catch_expr, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.LocalId error_union_local = self.add_temp(self.type_for_node(catch_expr.value), span);
        self.lower_into_place(catch_expr.value, self.place_for_local(error_union_local));
        if (self.builder.terminated) { return; }

        jil.LocalId is_error_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(is_error_local),
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.is_error,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.place_for_local(error_union_local)
                ))
            )),
            span
        );

        jil.BlockId success_block = self.builder.reserve_block(span);
        jil.BlockId catch_block = self.builder.reserve_block(span);
        jil.BlockId join_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(is_error_local))),
            then_target: catch_block,
            else_target: success_block
        )), span);

        Int active_depth = self.active_locals.len();
        self.lower_catch_success_block(success_block, error_union_local, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.lower_catch_error_block(catch_block, catch_expr, error_union_local, destination, join_block, span);
        self.restore_active_locals(active_depth);
        self.builder.start_block(join_block);
    }

    public Void lower_propagate_error_expr(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId value,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.LocalId result_local = self.add_temp(self.type_for_node(value), span);
        self.lower_into_place(value, self.place_for_local(result_local));
        if (self.builder.terminated) { return; }
        jil.LocalId is_error_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(is_error_local),
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.is_error,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.place_for_local(result_local)
                ))
            )),
            span
        );
        jil.BlockId error_block = self.builder.reserve_block(span);
        jil.BlockId success_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: jil.copy_operand_value(jil.CopyOperand (
                place: self.place_for_local(is_error_local)
            )),
            then_target: error_block,
            else_target: success_block
        )), span);
        self.lower_propagate_error_block(error_block, result_local, span);
        self.builder.start_block(success_block);
        self.builder.push_assign(
            destination,
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.unwrap_value,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.place_for_local(result_local)
                ))
            )),
            span
        );
    }

    public Void lower_propagate_error_block(
        Self&! self,
        jil.BlockId block_id,
        jil.LocalId result_local,
        token.Span span
    ) {
        self.builder.start_block(block_id);
        qid.TypeId return_type = self.locals.get(self.return_local().to_index()).type_id;
        jil.LocalId error_local = self.add_temp(self.error_union_error_type(return_type), span);
        self.builder.push_assign(
            self.place_for_local(error_local),
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.unwrap_error,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.place_for_local(result_local)
                ))
            )),
            span
        );
        self.builder.push_assign(
            self.place_for_local(self.return_local()),
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.make_error,
                value: self.operand_for_place(self.place_for_local(error_local))
            )),
            span
        );
        self.run_deferred_from(0, span);
        self.push_active_storage_dead_from(0, span);
        self.finish_return(false, span);
    }

    public Void lower_catch_success_block(Self&! self,
        jil.BlockId block_id,
        jil.LocalId error_union_local,
        jil.Place destination,
        jil.BlockId join_block,
        token.Span span
    ) {
        self.builder.start_block(block_id);
        self.builder.push_assign(
            destination,
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.unwrap_value,
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.place_for_local(error_union_local)
                ))
            )),
            span
        );
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)), span);
    }

    public Void lower_catch_error_block(Self&! self,
        jil.BlockId block_id,
        sem.Catch catch_expr,
        jil.LocalId error_union_local,
        jil.Place destination,
        jil.BlockId join_block,
        token.Span span
    ) {
        self.builder.start_block(block_id);
        list.ArrayList<jil.LocalId> catch_locals! = list.ArrayList<jil.LocalId>();
        self.lower_catch_pattern(
            catch_expr.pattern,
            self.place_for_local(error_union_local),
            catch_locals$.mut_ref(),
            span
        );
        if (!self.builder.terminated) {
            self.lower_into_place(catch_expr.body, destination);
        }
        if (!self.builder.terminated) {
            self.end_scope(catch_locals$.ref(), span);
            self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)), span);
        }
    }

    public Void lower_break(Self&! self, sem.NodeId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        support.LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.model_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.model_span(node_id));
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: target.break_target)),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_continue(Self&! self, sem.NodeId node_id) {
        if (self.loop_targets.empty()) {
            self.mark_unsupported(node_id);
            return;
        }
        support.LoopTargets target = self.loop_targets.last();
        self.run_deferred_from(target.defer_depth, self.lowerer.model_span(node_id));
        self.push_active_storage_dead_from(target.active_depth, self.lowerer.model_span(node_id));
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: target.continue_target)),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_unary(Self&! self, sem.NodeId node_id, sem.Unary unary, jil.Place destination) {
        if (unary.op == .new_value) {
            self.lower_new_value(node_id, unary, destination);
            return;
        }
        guard support.unary_op(unary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.builder.push_assign(
            destination,
            jil.unary_rvalue(jil.UnaryRvalue (op: op, value: self.lower_to_operand(unary.value))),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_new_value(Self&! self, sem.NodeId node_id, sem.Unary unary, jil.Place destination) {
        if (self.place_is_owned_slice_value(destination)) {
            self.lower_owned_slice_value_new(node_id, unary.value, destination);
            return;
        }
        sem.Node value = self.lowerer.model.node(unary.value);
        if (value.data is .lambda_expr(lambda)) {
            if (self.place_is_owned_closure(destination)) {
                self.lower_new_lambda_closure(node_id, unary.value, lambda, destination);
                return;
            }
        }
        token.Span span = self.lowerer.model_span(node_id);
        self.builder.push_assign(
            destination,
            jil.alloc_box_rvalue(jil.AllocBoxRvalue (value_type: self.type_for_node(unary.value))),
            span
        );
        // `new T(expr)` 的 initializer 必须直接写进 heap pointee。不能先把
        // 拥有资源的 aggregate 构造成 rvalue 再复制到 heap，否则会破坏所有权。
        self.lower_into_place(unary.value, self.project_deref(destination, false));
    }

    public Bool place_is_owned_closure(self, jil.Place place) {
        types.TypeInfo info = self.lowerer.store.types.get(self.jil_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .owner_pointer) { return false; }
        return self.type_is_closure(handle.element);
    }

    public Void lower_new_lambda_closure(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId lambda_id,
        sem.Lambda lambda,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        self.push_lambda_closure_assign(
            lambda_id,
            lambda,
            destination,
            .heap,
            span
        );
    }

    public Void lower_owned_slice_value_new(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId value_id,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId element_type = self.owned_slice_value_element_type(self.jil_place_type(destination));
        Int count = self.owned_slice_value_initializer_count(value_id);
        self.builder.push_assign(
            destination,
            jil.alloc_array_rvalue(jil.AllocArrayRvalue (
                element_type: element_type,
                count: self.int_operand(count, span)
            )),
            span
        );

        sem.Node value = self.lowerer.model.node(value_id);
        if (value.data is .array_literal(array_literal)) {
            self.lower_owned_slice_value_literal(array_literal, destination, element_type, span);
            self.lower_owned_slice_value_sentinel(destination, count, element_type, span);
            return;
        }
        if (value.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                self.lower_owned_unsized_string_literal(symbol_id, destination, element_type, span);
                self.lower_owned_slice_value_sentinel(destination, count, element_type, span);
                return;
            }
        }
        self.mark_unsupported(value_id);
    }

    public Void lower_owned_slice_value_literal(Self&! self,
        sem.ArrayLiteral literal,
        jil.Place destination,
        qid.TypeId element_type,
        token.Span span
    ) {
        Int index! = 0;
        while (index < literal.items.length) {
            jil.Place element_place = self.project_runtime_index(destination, index, span);
            self.lower_into_place_as_type(literal.items[index], element_place, element_type);
            index = index + 1;
        }
    }

    public Void lower_owned_slice_value_sentinel(Self&! self,
        jil.Place destination,
        Int count,
        qid.TypeId element_type,
        token.Span span
    ) {
        qid.TypeId destination_type = self.jil_place_type(destination);
        types.TypeInfo info = self.lowerer.store.types.get(destination_type);
        guard info.data is .handle_type(handle) else { return; }
        types.TypeInfo element_info = self.lowerer.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(slice_type) else { return; }
        guard slice_type.sentinel is .some(sentinel) else { return; }
        jil.Place sentinel_place = self.project_runtime_index(destination, count, span);
        self.lower_comptime_value_into_place_at_span(sentinel.value, sentinel_place, span);
    }

    public Void lower_owned_unsized_string_literal(Self&! self,
        qid.SymbolId symbol_id,
        jil.Place destination,
        qid.TypeId element_type,
        token.Span span
    ) {
        Int byte_count = self.lowerer.store.symbols.text_length(symbol_id);
        Int index! = 0;
        while (index < byte_count) {
            UInt8 byte = self.lowerer.store.symbols.text_byte_at(symbol_id, index);
            self.builder.push_assign(
                self.project_runtime_index(destination, index, span),
                self.uint8_rvalue(Int(byte), span),
                span
            );
            index = index + 1;
        }
    }

    public Int owned_slice_value_initializer_count(self, sem.NodeId value_id) {
        sem.Node value = self.lowerer.model.node(value_id);
        if (value.data is .array_literal(array_literal)) {
            return array_literal.items.length;
        }
        if (value.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                return self.lowerer.store.symbols.text(symbol_id).length;
            }
        }
        return 0;
    }

    public jil.Place project_runtime_index(Self&! self, jil.Place base, Int offset, token.Span span) {
        jil.LocalId index_local = self.add_temp(self.lowerer.store.types.int_type(), span);
        self.builder.push_assign(self.place_for_local(index_local), self.int_const_rvalue(offset, span), span);
        return self.project_index(base, index_local);
    }

    public qid.TypeId owned_slice_value_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else {
            return self.lowerer.store.types.invalid_type();
        }
        types.TypeInfo element_info = self.lowerer.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(array_type) else {
            return self.lowerer.store.types.invalid_type();
        }
        return array_type.element;
    }

    public Bool place_is_owned_slice_value(self, jil.Place place) {
        types.TypeInfo info = self.lowerer.store.types.get(self.jil_place_type(place));
        guard info.data is .handle_type(handle) else { return false; }
        return self.handle_is_owned_slice_value(handle);
    }

    public Void lower_binary(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        if (self.string_concat_const(node_id) is .some(symbol_id)) {
            self.builder.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (
                    value: jil.const_operand_value(jil.Const (
                        type_id: self.type_for_node(node_id),
                        span: self.lowerer.model_span(node_id),
                        value: jil.string_const_kind(jil.StringConst (
                            symbol_id: symbol_id,
                            nul_terminated: false
                        ))
                    ))
                )),
                self.lowerer.model_span(node_id)
            );
            return;
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.lower_logic_binary(node_id, binary, destination);
            return;
        }
        if (binary.op == .equal || binary.op == .not_equal) {
            self.lower_equal_binary(node_id, binary, destination);
            return;
        }
        guard support.binary_op(binary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        jil.LocalId lhs_local = self.add_temp(self.type_for_node(binary.left), self.lowerer.model_span(binary.left));
        self.lower_into_place(binary.left, self.place_for_local(lhs_local));
        jil.Operand rhs = self.lower_to_operand(binary.right);
        self.builder.push_assign(
            destination,
            jil.binary_rvalue(jil.BinaryRvalue (
                op: op,
                lhs: self.operand_for_place(self.place_for_local(lhs_local)),
                rhs: rhs
            )),
            self.lowerer.model_span(node_id)
        );
    }

    public qid.SymbolId? string_concat_const(Self&! self, sem.NodeId node_id) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .literal(literal)) {
            if (literal.value is .string_value(symbol_id)) {
                return symbol_id;
            }
            return null;
        }
        guard node.data is .binary(binary) else {
            return null;
        }
        if (binary.op != .add) {
            return null;
        }
        guard self.string_concat_const(binary.left) is .some(left_symbol) else {
            return null;
        }
        guard self.string_concat_const(binary.right) is .some(right_symbol) else {
            return null;
        }
        UInt8[]& left = self.lowerer.store.symbols.text(left_symbol);
        UInt8[]& right = self.lowerer.store.symbols.text(right_symbol);
        std.String text = string.concat(left, right);
        return self.lowerer.store.symbols.intern(text.bytes());
    }

    public Void lower_equal_binary(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId compare_type = self.receiver_expr_type(binary.left);
        if (self.lower_null_handle_equal_binary(binary, compare_type, destination, span)) {
            return;
        }
        if (self.lower_trait_equal_binary(node_id, binary, compare_type, destination, span)) {
            return;
        }
        if (self.lower_reference_equal_binary(node_id, binary, compare_type, destination, span)) {
            return;
        }
        if (!self.has_aggregate_equality_plan(node_id) && !self.type_has_aggregate_equality(compare_type)) {
            self.lower_scalar_equal_binary(node_id, binary, destination);
            return;
        }
        jil.LocalId lhs = self.lower_equality_operand(binary.left, compare_type, span);
        jil.LocalId rhs = self.lower_equality_operand(binary.right, compare_type, span);
        self.lower_equal_places(
            compare_type,
            self.place_for_local(lhs),
            self.place_for_local(rhs),
            destination,
            binary.op == .not_equal,
            span
        );
    }

    public Bool lower_null_handle_equal_binary(Self&! self,
        sem.Binary binary,
        qid.TypeId compare_type,
        jil.Place destination,
        token.Span span
    ) {
        if (self.is_null_literal(binary.right)) {
            return self.lower_null_handle_compare(
                binary.left,
                compare_type,
                destination,
                binary.op == .not_equal,
                span
            );
        }
        if (self.is_null_literal(binary.left)) {
            qid.TypeId right_type = self.receiver_expr_type(binary.right);
            return self.lower_null_handle_compare(binary.right, right_type, destination, binary.op == .not_equal, span);
        }
        return false;
    }

    public Bool lower_null_handle_compare(Self&! self,
        sem.NodeId value_id,
        qid.TypeId handle_type,
        jil.Place destination,
        Bool not_equal,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.store.types.get(handle_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (!self.handle_can_compare_null(handle)) {
            return false;
        }
        support.StablePlaceLocation handle_location =
            self.null_compare_handle_location(value_id, handle_type, span);
        Bool has_payload = self.layout_for_type(handle_type).fields.length > 0;
        jil.Place handle_place = self.stable_place(handle_location$.ref());
        jil.Place compare_place! = handle_place;
        if (has_payload) {
            compare_place = self.project_constant_index(handle_place, 0);
        }
        qid.TypeId compare_type = self.jil_place_type(compare_place);
        jil.BinaryOp op! = jil.BinaryOp.eq;
        if (not_equal) {
            op = jil.BinaryOp.ne;
        }
        self.builder.push_assign(
            destination,
            jil.binary_rvalue(jil.BinaryRvalue (
                op: op,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: compare_place)),
                rhs: self.null_operand(compare_type, span)
            )),
            span
        );
        return true;
    }

    public Bool handle_can_compare_null(self, types.HandleType handle) {
        return handle.kind == .raw_pointer;
    }

    public support.StablePlaceLocation null_compare_handle_location(
        Self&! self,
        sem.NodeId value_id,
        qid.TypeId handle_type,
        token.Span span
    ) {
        if (self.place_for_expr(value_id) is .some(place)) {
            return self.stable_place_location(place);
        }
        jil.LocalId local = self.add_temp(handle_type, span);
        self.lower_into_place(value_id, self.place_for_local(local));
        return self.stable_place_location(self.place_for_local(local));
    }

    public jil.Operand null_operand(self, qid.TypeId type_id, token.Span span) {
        return jil.const_operand_value(jil.Const (
            type_id: type_id,
            span: span,
            value: jil.null_const_kind(jil.NullConst (typed_null: true))
        ));
    }

    public Bool is_null_literal(self, sem.NodeId node_id) {
        sem.Node node = self.lowerer.model.node(node_id);
        guard node.data is .literal(literal) else { return false; }
        return literal.value is .null_value;
    }

    public Void lower_scalar_equal_binary(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        guard support.binary_op(binary.op) is .some(op) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId compare_type = self.receiver_expr_type(binary.left);
        jil.LocalId lhs = self.lower_equality_operand(binary.left, compare_type, span);
        jil.LocalId rhs = self.lower_equality_operand(binary.right, compare_type, span);
        self.builder.push_assign(
            destination,
            jil.binary_rvalue(jil.BinaryRvalue (
                op: op,
                lhs: self.operand_for_place(self.place_for_local(lhs)),
                rhs: self.operand_for_place(self.place_for_local(rhs))
            )),
            span
        );
    }

    public Bool lower_trait_equal_binary(Self&! self,
        sem.NodeId node_id,
        sem.Binary binary,
        qid.TypeId compare_type,
        jil.Place destination,
        token.Span span
    ) {
        guard self.lowerer.typeck.member_selection(node_id) is .some(trait_member) else {
            return false;
        }
        guard self.concrete_member_for_type(trait_member, compare_type) is .some(target) else {
            return false;
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(target) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(binary.left, mutable_reference));
        args.add(self.lower_receiver_operand(binary.right, mutable_reference));
        if (binary.op == .equal) {
            self.lower_direct_function_call(node_id, target, args$.ref(), destination);
            return true;
        }
        jil.LocalId result = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.lower_direct_function_call(node_id, target, args$.ref(), self.place_for_local(result));
        self.finish_equal_places(result, destination, true, span);
        return true;
    }

    public Bool lower_reference_equal_binary(Self&! self,
        sem.NodeId node_id,
        sem.Binary binary,
        qid.TypeId compare_type,
        jil.Place destination,
        token.Span span
    ) {
        guard self.reference_element_type(compare_type) is .some(element_type) else {
            return false;
        }
        guard self.lowerer.store.resolve.core_traits.equatable_trait is .some(equatable_def) else {
            return false;
        }
        guard self.trait_member_by_name(equatable_def, "equal") is .some(equal_def) else {
            return false;
        }
        guard self.concrete_member_for_type(equal_def, element_type) is .some(target) else {
            return false;
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(2);
        Bool mutable_reference = self.function_self_receiver_mode(target) == .mutable_ref_receiver;
        args.add(self.lower_receiver_operand(binary.left, mutable_reference));
        args.add(self.lower_receiver_operand(binary.right, mutable_reference));
        if (binary.op == .equal) {
            self.lower_direct_function_call(node_id, target, args$.ref(), destination);
            return true;
        }
        jil.LocalId result = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.lower_direct_function_call(node_id, target, args$.ref(), self.place_for_local(result));
        self.finish_equal_places(result, destination, true, span);
        return true;
    }

    public qid.TypeId? reference_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .reference) { return null; }
        return handle.element;
    }

    public qid.DefId? trait_member_by_name(self, qid.DefId trait_def, UInt8[]& name) {
        guard self.lowerer.model.def(trait_def) is .some(trait_model) else { return null; }
        Int index! = 0;
        while (index < trait_model.members.len()) {
            qid.DefId member_def = trait_model.members.get(index);
            if (self.symbol_text_equal(self.lowerer.store.defs.get(member_def).name.symbol, name)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public qid.DefId? concrete_member_for_type(self, qid.DefId trait_member_def, qid.TypeId type_id) {
        qid.SymbolId member_symbol = self.lowerer.store.defs.get(trait_member_def).name.symbol;
        guard self.nominal_type_data(self.member_lookup_value_type(type_id)) is .some(named) else {
            return null;
        }
        qid.DefId? member_def = self.function_member_def_by_symbol(named.def_id, member_symbol);
        guard member_def is .some(concrete_def) else {
            return null;
        }
        if (self.lowerer.def_is_trait_member(concrete_def)) {
            return null;
        }
        return concrete_def;
    }

    public qid.TypeId member_lookup_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (self.handle_is_trait_object(handle)) {
                return handle.element;
            }
            if (handle.kind == .reference) {
                return handle.element;
            }
        }
        return type_id;
    }

    public Bool has_aggregate_equality_plan(self, sem.NodeId node_id) {
        guard self.lowerer.typeck.expr_lowering(node_id) is .some(lowering) else {
            return false;
        }
        return lowering == .aggregate_equality;
    }

    public Bool type_has_aggregate_equality(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (info.data is .tuple_type(_)) { return true; }
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .optional(_)) { return true; }
        if (info.data is .error_union(_)) { return true; }
        if (info.data is .handle_type(handle)) { return handle.kind == .slice; }
        if (info.data is .named(named)) { return self.named_type_has_aggregate_equality(named.def_id); }
        return false;
    }

    public Bool named_type_has_aggregate_equality(self, qid.DefId def_id) {
        def.DefKind kind = self.lowerer.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return kind == .union_def;
    }

    public jil.LocalId lower_equality_operand(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId compare_type,
        token.Span span
    ) {
        jil.LocalId local = self.add_temp(compare_type, span);
        self.lower_into_place(node_id, self.place_for_local(local));
        return local;
    }

    public Void lower_equal_places(Self&! self,
        qid.TypeId type_id,
        jil.Place lhs,
        jil.Place rhs,
        jil.Place destination,
        Bool invert,
        token.Span span
    ) {
        Int field_count = self.layout_for_type(type_id).fields.length;
        if (field_count == 0) {
            self.lower_scalar_equal_places(lhs, rhs, destination, invert, span);
            return;
        }
        jil.LocalId result = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(self.place_for_local(result), self.bool_rvalue(true, span), span);
        Int index! = 0;
        while (index < field_count) {
            layout.FieldLayout field = self.layout_for_type(type_id).fields[index];
            if (!self.type_has_abi_value(field.field_type)) {
                index = index + 1;
                continue;
            }
            self.lower_equal_field(type_id, field, index, lhs, rhs, result, span);
            index = index + 1;
        }
        self.finish_equal_places(result, destination, invert, span);
    }

    public Void lower_equal_field(Self&! self,
        qid.TypeId owner_type,
        layout.FieldLayout field,
        Int field_index,
        jil.Place lhs,
        jil.Place rhs,
        jil.LocalId result,
        token.Span span
    ) {
        jil.LocalId field_result = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.lower_equal_places(
            field.field_type,
            self.project_layout_field(lhs, field, field_index),
            self.project_layout_field(rhs, field, field_index),
            self.place_for_local(field_result),
            false,
            span
        );
        self.builder.push_assign(
            self.place_for_local(result),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_and,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(result))),
                rhs: jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(field_result)))
            )),
            span
        );
    }

    public Void finish_equal_places(
        Self&! self,
        jil.LocalId result,
        jil.Place destination,
        Bool invert,
        token.Span span
    ) {
        jil.Operand result_operand = jil.copy_operand_value(jil.CopyOperand (
            place: self.place_for_local(result)
        ));
        if (invert) {
            self.builder.push_assign(
                destination,
                jil.unary_rvalue(jil.UnaryRvalue (op: jil.UnaryOp.logic_not, value: result_operand)),
                span
            );
            return;
        }
        self.builder.push_assign(destination, jil.use_rvalue(jil.UseRvalue (value: result_operand)), span);
    }

    public Void lower_scalar_equal_places(Self&! self,
        jil.Place lhs,
        jil.Place rhs,
        jil.Place destination,
        Bool invert,
        token.Span span
    ) {
        jil.BinaryOp op! = jil.BinaryOp.eq;
        if (invert) {
            op = jil.BinaryOp.ne;
        }
        self.builder.push_assign(
            destination,
            jil.binary_rvalue(jil.BinaryRvalue (
                op: op,
                lhs: jil.copy_operand_value(jil.CopyOperand (place: lhs)),
                rhs: jil.copy_operand_value(jil.CopyOperand (place: rhs))
            )),
            span
        );
    }

    public jil.Place project_layout_field(
        self,
        jil.Place base,
        layout.FieldLayout field,
        Int field_index
    ) {
        if (field.field_def is .some(field_def)) {
            return self.project_field_at_index(base, field_def, field.field_type, field_index);
        }
        return self.project_constant_index(base, field_index);
    }

    public Bool type_has_abi_value(self, qid.TypeId type_id) {
        layout.TypeLayout type_layout = self.layout_for_type(type_id);
        return type_layout.kind != .invalid && type_layout.kind != .zero_sized;
    }

    public layout.TypeLayout layout_for_type(self, qid.TypeId type_id) {
        layout.LayoutId layout_id = self.layouts.evaluate(
            self.lowerer.store$.ref(), type_id
        );
        return self.layouts.layout(layout_id);
    }

    public Void lower_logic_binary(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        if (binary.op == .logic_and) {
            self.lower_logic_and(node_id, binary, destination);
            return;
        }
        self.lower_logic_or(node_id, binary, destination);
    }

    public Void lower_logic_and(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId rhs_block = self.builder.reserve_block(self.lowerer.model_span(binary.right));
        jil.BlockId false_block = self.builder.reserve_block(span);
        jil.BlockId join_block = self.builder.reserve_block(span);
        jil.Operand condition = self.lower_to_operand(binary.left);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: condition,
            then_target: rhs_block,
            else_target: false_block
        )), self.lowerer.model_span(binary.left));

        self.builder.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.builder.terminated) {
            self.builder.finish_block(self.goto_terminator(join_block), span);
        }

        self.builder.start_block(false_block);
        self.builder.push_assign(destination, self.bool_rvalue(false, span), span);
        self.builder.finish_block(self.goto_terminator(join_block), span);
        self.builder.start_block(join_block);
    }

    public Void lower_logic_or(Self&! self, sem.NodeId node_id, sem.Binary binary, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.BlockId true_block = self.builder.reserve_block(span);
        jil.BlockId rhs_block = self.builder.reserve_block(self.lowerer.model_span(binary.right));
        jil.BlockId join_block = self.builder.reserve_block(span);
        jil.Operand condition = self.lower_to_operand(binary.left);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: condition,
            then_target: true_block,
            else_target: rhs_block
        )), self.lowerer.model_span(binary.left));

        self.builder.start_block(true_block);
        self.builder.push_assign(destination, self.bool_rvalue(true, span), span);
        self.builder.finish_block(self.goto_terminator(join_block), span);

        self.builder.start_block(rhs_block);
        self.lower_into_place(binary.right, destination);
        if (!self.builder.terminated) {
            self.builder.finish_block(self.goto_terminator(join_block), span);
        }
        self.builder.start_block(join_block);
    }
}
