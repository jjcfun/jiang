// package lowering 共享的类型、effect 与源码位置查询。
//
// 这些辅助只依赖 lower Context，不承载具体表达式 lowering。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import monomorph = "../../sema/monomorph.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";
import std;
import * = "./model.jiang";
import lower_context = "./context.jiang";
import * = "./body.jiang";
import * = "./context.jiang";

public extend lower_context.Context {
    public types.EffectSet effect_set_for_model(self, sem.EffectSet effects) {
        return types.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: self.effect_domain(effects)
        );
    }

    public types.DomainEffect? effect_domain(self, sem.EffectSet effects) {
        guard effects.domain is .some(domain) else { return null; }
        sem.Node node = self.model.node(domain);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(raw_binding_def) else { return null; }
        qid.DefId binding_def = self.resolve_alias_target(raw_binding_def);
        guard self.typeck.def_type(binding_def) is .some(binding_type) else { return null; }
        return types.DomainEffect(binding: binding_def, domain_type: binding_type);
    }

    public qid.DefId resolve_alias_target(self, qid.DefId def_id) {
        qid.DefId current! = def_id;
        Int depth! = 0;
        while (depth < 64) {
            if (self.store.defs.get(current).kind != .alias_def) { return current; }
            guard self.model.def(current) is .some(model_def) else { return current; }
            guard model_def.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    public types.EffectSet merge_effects(self, types.EffectSet base, types.EffectSet added) {
        types.DomainEffect? domain! = base.domain;
        if (added.domain is .some(_)) {
            domain = added.domain;
        }
        return types.EffectSet(
            has_unsafe: base.has_unsafe || added.has_unsafe,
            has_async: base.has_async || added.has_async,
            domain: domain
        );
    }

    public qid.TypeId substitute_type(self, qid.TypeId type_id, monomorph.SubstitutionMap& substitutions) {
        if (substitutions.len() == 0) {
            return type_id;
        }
        // TypeCheckStore 保存的是泛型模板视角的 TypeId；具体实例的 JIL
        // local/const/temp 必须在这里替换成 concrete TypeId。
        return monomorph.substitute_type(self.store$.ref(), type_id, substitutions);
    }

    public token.Span def_span(self, qid.DefId def_id) {
        if (self.store.source_map.def_span(def_id) is .some(loc)) {
            return loc.span;
        }
        return token.Span();
    }

    public token.Span model_span(self, sem.NodeId model_id) {
        if (self.store.source_map.model_span(model_id) is .some(loc)) {
            return loc.span;
        }
        return token.Span();
    }

}
