// comptime value、静态值和普通常量 lowering。
//
// 本模块是 lower/body 实现族的一部分，只在 Semantic Model -> JIL 阶段内使用。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import monomorph = "../../sema/monomorph.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import memory = "../../support/memory.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import drop_elaborate = "../drop_elaborate.jiang";
import std;
import support = "./support.jiang";
import * = "./model.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import control_flow = "./control_flow.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import call = "./call.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";

public extend body_context.BodyLowerer {
    public jil.Operand? const_global_operand(self, sem.NodeId node_id, qid.DefId def_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else {
            return null;
        }
        if (model_def.decl.kind != .global_decl || !model_def.decl.is_const) {
            return null;
        }
        qid.TypeId expected_type = self.type_for_node(node_id);
        // const initializer 的真实语义由 Semantic Model comptime interpreter 记录到
        // ComptimeStore。JIL 这里只把已解释出的标量值转成运行期可用常量，
        // 避免旧 lower_const_expr 被迫支持完整 comptime Semantic Model。
        if (self.lowerer.ctx.store.comptime_store.const_value(def_id) is .some(const_value)) {
            if (self.jil_const_from_comptime_value(node_id, const_value, expected_type) is .some(value)) {
                return jil.const_operand_value(value);
            }
            if (self.ensure_comptime_const_global(node_id, def_id, const_value, expected_type)) {
                return jil.global_operand_value(jil.GlobalRef (
                    target: .source(def_id),
                    type_id: expected_type,
                    is_external: false,
                    span: self.lowerer.model_span(node_id)
                ));
            }
        }
        guard model_def.body is .some(ref _ body) else {
            return null;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        visiting.add(def_id);
        if (self.lower_const_expr(body.root, self.type_for_node(node_id), visiting$.ref()) is .some(value)) {
            return jil.const_operand_value(value);
        }
        self.mark_unsupported(body.root);
        return null;
    }

    public Bool is_const_global_def(self, qid.DefId def_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return false; }
        return model_def.decl.kind == .global_decl && model_def.decl.is_const;
    }

    public Bool ensure_runtime_global_storage(self, sem.NodeId node_id, qid.DefId def_id, qid.TypeId type_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return false; }
        if (model_def.decl.kind != .global_decl || model_def.decl.is_const) {
            return false;
        }
        if (self.lowerer.output.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.model_span(node_id);
        jil.StaticValue? initializer! = null;
        if (model_def.body is .some(ref _ body)) {
            initializer = self.static_value_from_model(body.root, type_id, span);
        }
        jil.GlobalId id = jil.GlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(jil.Global (
            id: id,
            origin: .source(def_id),
            type_id: type_id,
            span: span,
            read_only: false,
            is_external: self.global_is_external_definition(def_id, model_def),
            initializer: initializer
        ));
        return true;
    }

    public Bool global_is_external_definition(self, qid.DefId def_id, sem.Def& model_def) {
        if (model_def.decl.is_external) { return true; }
        guard self.lowerer.ctx.store.defs.get(def_id).module_id is .some(module_id) else {
            return false;
        }
        return self.lowerer.ctx.store.resolve.module_ref(module_id).interface_only;
    }

    public jil.Const? lower_comptime_const_value(self, sem.NodeId node_id, qid.DefId def_id, qid.TypeId expected_type) {
        guard self.lowerer.ctx.store.comptime_store.const_value(def_id) is .some(const_value) else {
            return null;
        }
        return self.jil_const_from_comptime_value(node_id, const_value, expected_type);
    }

    public Bool ensure_comptime_const_global(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        if (!self.comptime_value_needs_global_storage(const_value)) {
            return false;
        }
        if (self.lowerer.output.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.model_span(node_id);
        guard self.static_value_from_comptime(const_value, expected_type, span) is .some(initializer) else {
            return false;
        }
        jil.GlobalId id = jil.GlobalId.from_index(self.lowerer.output.globals.len());
        self.lowerer.output.add_global(jil.Global (
            id: id,
            origin: .source(def_id),
            type_id: expected_type,
            span: span,
            read_only: true,
            is_external: false,
            initializer: initializer
        ));
        return true;
    }

    public jil.StaticValue? static_value_from_model(
        self,
        sem.NodeId node_id,
        qid.TypeId expected_type,
        token.Span span
    ) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .literal(literal)) {
            return self.static_literal_value(node_id, literal, expected_type, span);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.static_array_literal_value(array_literal, expected_type, span);
        }
        return null;
    }

    public jil.StaticValue? static_literal_value(self,
        sem.NodeId node_id,
        sem.Literal literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        return jil.scalar_static_value(self.lower_literal_as_const(node_id, literal, expected_type));
    }

    public jil.StaticValue? static_array_literal_value(self,
        sem.ArrayLiteral array_literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        list.ArrayList<jil.StaticField> fields! = list.ArrayList<jil.StaticField>(array_literal.items.length);
        Int index! = 0;
        while (index < array_literal.items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.static_value_from_model(array_literal.items[index], item_type, span) is .some(value) else {
                return null;
            }
            fields.add(jil.StaticField(type_id: item_type, value: value));
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.output.static_field_array(fields$.ref())
        );
    }

    public Bool comptime_value_needs_global_storage(self, comptime_value.ComptimeValue const_value) {
        if (const_value.data is .struct_value(_)) { return true; }
        if (const_value.data is .tuple_value(_)) { return true; }
        return const_value.data is .array_value(_);
    }

    public jil.StaticValue? static_value_from_comptime(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar)) {
            return jil.scalar_static_value(scalar);
        }
        if (const_value.data is .struct_value(fields)) {
            return self.static_struct_value(fields, expected_type, span);
        }
        if (const_value.data is .tuple_value(items)) {
            return self.static_sequence_value(items, expected_type, span);
        }
        if (const_value.data is .array_value(items)) {
            return self.static_sequence_value(items, expected_type, span);
        }
        return null;
    }

    public jil.StaticValue? static_struct_value(self,
        comptime_value.ComptimeAggregateField[]& fields,
        qid.TypeId expected_type,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(expected_type);
        guard info.data is .named(named) else { return null; }
        guard self.lowerer.model.def(named.def_id) is .some(owner_model) else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        list.ArrayList<jil.StaticField> static_fields! = list.ArrayList<jil.StaticField>();
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(
                    ComptimeFields(values: fields),
                    member_def
                ) is .some(field_value) else {
                    return null;
                }
                guard self.field_expected_type(
                    member_def,
                    substitutions$.ref()
                ) is .some(field_type) else {
                    return null;
                }
                guard self.static_value_from_comptime(field_value, field_type, span) is .some(static_value) else {
                    return null;
                }
                static_fields.add(jil.StaticField(type_id: field_type, value: static_value));
            }
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.output.static_field_array(static_fields$.ref())
        );
    }

    public jil.StaticValue? static_sequence_value(self,
        comptime_value.ComptimeValue[]& items,
        qid.TypeId expected_type,
        token.Span span
    ) {
        list.ArrayList<jil.StaticField> static_fields! = list.ArrayList<jil.StaticField>(items.length);
        Int index! = 0;
        while (index < items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.static_value_from_comptime(items[index], item_type, span) is .some(static_value) else {
                return null;
            }
            static_fields.add(jil.StaticField(type_id: item_type, value: static_value));
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.output.static_field_array(static_fields$.ref())
        );
    }

    public jil.Const? jil_const_from_comptime_value(self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        if (const_value.data is .unit_value) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
            );
        }
        if (const_value.data is .bool_value(bool_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.bool_const_kind(jil.BoolConst (value: bool_value))
            );
        }
        if (const_value.data is .int_value(int_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: unsafe { int_value$.as(UInt64) },
                    signed_value: true
                ))
            );
        }
        if (const_value.data is .uint_value(uint_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: uint_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .char_value(char_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: char_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .float_bits(float_bits)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.float_const_kind(jil.FloatConst (value: self.float64_from_bits(float_bits)))
            );
        }
        if (const_value.data is .symbol_value(symbol_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.string_const_kind(jil.StringConst (
                    symbol_id: symbol_value,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .enum_case_value(case_def)) {
            return self.enum_case_int_const(case_def, expected_type, span);
        }
        return null;
    }

    public comptime_value.ComptimeValue? comptime_value_for_expr(self, sem.NodeId node_id) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.substitutions.const_binding(def_id) is .some(const_value)) {
                return const_value;
            }
            return self.lowerer.ctx.store.comptime_store.const_value(def_id);
        }
        if (node.data is .member_access(member_access)) {
            guard self.lowerer.typeck.member_selection(node_id) is .some(member_def) else { return null; }
            if (self.lowerer.ctx.store.defs.get(member_def).kind != .field_def) {
                return null;
            }
            guard self.comptime_value_for_expr(member_access.base) is .some(base_value) else { return null; }
            return self.comptime_field_value(node_id, base_value, member_def);
        }
        return null;
    }

    @life(return: base_value)
    public comptime_value.ComptimeValue? comptime_field_value(self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue base_value,
        qid.DefId field_def
    ) {
        guard base_value.data is .struct_value(fields) else { return null; }
        Int index! = 0;
        while (index < fields.length) {
            if (fields[index].field_def.to_index() == field_def.to_index()) {
                comptime_value.ComptimeValue field_value = fields[index].value;
                return comptime_value.ComptimeValue(type_id: self.type_for_node(node_id), data: field_value.data);
            }
            index = index + 1;
        }
        return null;
    }

    public Bool lower_comptime_value_into_place(self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue const_value,
        jil.Place destination
    ) {
        qid.TypeId expected_type = self.jil_place_type(destination);
        token.Span span = self.lowerer.model_span(node_id);
        if (self.jil_const_from_comptime_value(node_id, const_value, expected_type) is .some(scalar_const)) {
            self.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (value: jil.const_operand_value(scalar_const))),
                span
            );
            return true;
        }
        if (const_value.data is .struct_value(fields)) {
            guard self.comptime_struct_aggregate(fields, expected_type, span) is .some(aggregate) else {
                return false;
            }
            self.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .tuple_value(items)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.tuple,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        if (const_value.data is .array_value(items)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.array,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        return false;
    }

    public jil.AggregateRvalue? comptime_struct_aggregate(self,
        comptime_value.ComptimeAggregateField[]& fields,
        qid.TypeId expected_type,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.ctx.store.types.get(expected_type);
        guard info.data is .named(named) else { return null; }
        guard self.lowerer.model.def(named.def_id) is .some(owner_model) else { return null; }
        monomorph.SubstitutionMap substitutions = self.nominal_substitution(named.def_id, named.type_args);
        list.ArrayList<jil.Operand> operands! = list.ArrayList<jil.Operand>();
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (self.lowerer.ctx.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(
                    ComptimeFields(values: fields),
                    member_def
                ) is .some(field_value) else {
                    return null;
                }
                guard self.field_expected_type(
                    member_def,
                    substitutions$.ref()
                ) is .some(field_type) else {
                    return null;
                }
                guard self.comptime_value_operand(field_value, field_type, span) is .some(operand) else { return null; }
                operands.add(operand);
            }
            index = index + 1;
        }
        return jil.AggregateRvalue (
            kind: jil.AggregateKind.struct_value,
            def_id: named.def_id,
            type_id: expected_type,
            tag: null,
            payload_field_index: -1,
            fields: self.lowerer.output.operand_array(operands$.ref())
        );
    }

    @life(return: fields)
    public comptime_value.ComptimeValue? comptime_struct_field(self,
        ComptimeFields fields,
        qid.DefId field_def
    ) {
        Int index! = 0;
        while (index < fields.values.length) {
            if (fields.values[index].field_def.to_index() == field_def.to_index()) {
                return fields.values[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    public jil.AggregateRvalue? comptime_sequence_aggregate(self,
        jil.AggregateKind kind,
        qid.DefId? def_id,
        qid.TypeId expected_type,
        comptime_value.ComptimeValue[]& items,
        token.Span span
    ) {
        list.ArrayList<jil.Operand> operands! = list.ArrayList<jil.Operand>(items.length);
        Int index! = 0;
        while (index < items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.comptime_value_operand(items[index], item_type, span) is .some(operand) else { return null; }
            operands.add(operand);
            index = index + 1;
        }
        return jil.AggregateRvalue (
            kind: kind,
            def_id: def_id,
            type_id: expected_type,
            tag: null,
            payload_field_index: -1,
            fields: self.lowerer.output.operand_array(operands$.ref())
        );
    }

    public jil.Operand? comptime_value_operand(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            return jil.const_operand_value(scalar_const);
        }
        jil.LocalId temp = self.add_temp(expected_type, span);
        guard self.lower_comptime_value_into_place_at_span(const_value, self.place_for_local(temp), span) else {
            return null;
        }
        return jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(temp)));
    }

    public Bool lower_comptime_value_into_place_at_span(self,
        comptime_value.ComptimeValue const_value,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId expected_type = self.jil_place_type(destination);
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            self.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (value: jil.const_operand_value(scalar_const))),
                span
            );
            return true;
        }
        if (const_value.data is .struct_value(fields)) {
            guard self.comptime_struct_aggregate(fields, expected_type, span) is .some(aggregate) else {
                return false;
            }
            self.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .tuple_value(items)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.tuple,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        if (const_value.data is .array_value(items)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.array,
                null,
                expected_type,
                items,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        return false;
    }

    public jil.Const? jil_const_from_comptime_value_for_span(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (const_value.data is .unit_value) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
            );
        }
        if (const_value.data is .bool_value(bool_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.bool_const_kind(jil.BoolConst (value: bool_value))
            );
        }
        if (const_value.data is .int_value(int_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: unsafe { int_value$.as(UInt64) },
                    signed_value: true
                ))
            );
        }
        if (const_value.data is .uint_value(uint_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: uint_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .char_value(char_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: char_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .float_bits(float_bits)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.float_const_kind(jil.FloatConst (value: self.float64_from_bits(float_bits)))
            );
        }
        if (const_value.data is .symbol_value(symbol_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.string_const_kind(jil.StringConst (
                    symbol_id: symbol_value,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .enum_case_value(case_def)) {
            return self.enum_case_int_const(case_def, expected_type, span);
        }
        return null;
    }

    public () finish_return(self, Bool implicit_unit, token.Span span) {
        self.finish_block(jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: implicit_unit)), span);
    }

    public jil.Const lower_const(self, sem.NodeId node_id, sem.Literal literal) {
        token.Span span = self.lowerer.model_span(node_id);
        // literal 的目标类型也可能是泛型参数，例如 T id<T>(T value)
        // 内部的返回值；type_for_node 会自动套用当前 instance substitution。
        qid.TypeId type_id = self.type_for_node(node_id);
        return self.lower_literal_as_const(node_id, literal, type_id);
    }

    public jil.Const lower_literal_as_const(self, sem.NodeId node_id, sem.Literal literal, qid.TypeId type_id) {
        token.Span span = self.lowerer.model_span(node_id);
        if (literal.value is .int_value(int_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.int_const_kind(jil.IntConst (bits: int_value.bits, signed_value: int_value.signed_value))
            );
        }
        if (literal.value is .float_value(float_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.float_const_kind(jil.FloatConst (value: float_value.value))
            );
        }
        if (literal.value is .bool_value(bool_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.bool_const_kind(jil.BoolConst (value: bool_value))
            );
        }
        if (literal.value is .string_value(symbol_id)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.string_const_kind(jil.StringConst (
                    symbol_id: symbol_id,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(type_id)
                ))
            );
        }
        if (literal.value is .char_value(char_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.int_const_kind(jil.IntConst (bits: UInt64(char_value), signed_value: false))
            );
        }
        if (literal.value is .null_value) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.null_const_kind(jil.NullConst (typed_null: true))
            );
        }
        return jil.Const (
            type_id: type_id,
            span: span,
            value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
        );
    }

    public jil.Const? lower_const_expr(self,
        sem.NodeId node_id,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .literal(literal)) {
            return self.lower_literal_as_const(node_id, literal, expected_type);
        }
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.lowerer.ctx.store.defs.get(def_id).kind == .enum_case_def) {
                return self.enum_case_int_const(def_id, expected_type, self.lowerer.model_span(node_id));
            }
            return self.lower_const_def_ref(node_id, def_id, visiting);
        }
        if (node.data is .member_access(_)) {
            if (self.enum_case_def_for_value(node_id) is .some(case_def)) {
                return self.enum_case_int_const(case_def, expected_type, self.lowerer.model_span(node_id));
            }
            return null;
        }
        if (node.data is .unary(unary)) {
            return self.lower_const_unary(node_id, unary, expected_type, visiting);
        }
        if (node.data is .binary(binary)) {
            return self.lower_const_binary(node_id, binary, expected_type, visiting);
        }
        return null;
    }

    public jil.Const? lower_const_def_ref(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return null; }
        if (model_def.decl.kind != .global_decl || !model_def.decl.is_const) {
            return null;
        }
        if (self.const_visiting_contains(visiting, def_id)) {
            return null;
        }
        guard model_def.body is .some(ref _ body) else { return null; }
        visiting.add(def_id);
        jil.Const? result = self.lower_const_expr(body.root, self.type_for_node(node_id), visiting);
        visiting.pop();
        return result;
    }

    public Bool const_visiting_contains(self, list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public jil.Const? lower_const_unary(self,
        sem.NodeId node_id,
        sem.Unary unary,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        qid.TypeId value_type = self.type_for_node(unary.value);
        guard self.lower_const_expr(unary.value, value_type, visiting) is .some(value) else {
            return null;
        }
        if (unary.op == .not) {
            guard value.value is .bool_value(bool_value) else { return null; }
            return self.bool_const_for_node(node_id, !bool_value.value);
        }
        guard value.value is .int_value(int_value) else { return null; }
        if (unary.op == .negate) {
            return self.int_const_for_node(node_id, expected_type, UInt64(0) - int_value.bits, int_value.signed_value);
        }
        if (unary.op == .bit_not) {
            return self.int_const_for_node(node_id, expected_type, ~int_value.bits, int_value.signed_value);
        }
        return null;
    }

    public jil.Const? lower_const_binary(self,
        sem.NodeId node_id,
        sem.Binary binary,
        qid.TypeId expected_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        qid.TypeId left_type = self.type_for_node(binary.left);
        qid.TypeId right_type = self.type_for_node(binary.right);
        guard self.lower_const_expr(binary.left, left_type, visiting) is .some(left) else { return null; }
        guard self.lower_const_expr(binary.right, right_type, visiting) is .some(right) else { return null; }
        if (left.value is .bool_value(left_bool)) {
            guard right.value is .bool_value(right_bool) else { return null; }
            return self.lower_const_bool_binary(node_id, binary.op, left_bool.value, right_bool.value);
        }
        guard left.value is .int_value(left_int) else { return null; }
        guard right.value is .int_value(right_int) else { return null; }
        return self.lower_const_int_binary(node_id, binary.op, expected_type, left_int, right_int);
    }

    public jil.Const? lower_const_bool_binary(self, sem.NodeId node_id, sem.BinaryOp op, Bool left, Bool right) {
        if (op == .logic_and) { return self.bool_const_for_node(node_id, left && right); }
        if (op == .logic_or) { return self.bool_const_for_node(node_id, left || right); }
        if (op == .equal) { return self.bool_const_for_node(node_id, left == right); }
        if (op == .not_equal) { return self.bool_const_for_node(node_id, left != right); }
        return null;
    }

    public jil.Const? lower_const_int_binary(self,
        sem.NodeId node_id,
        sem.BinaryOp op,
        qid.TypeId expected_type,
        jil.IntConst left,
        jil.IntConst right
    ) {
        if (op == .equal) { return self.bool_const_for_node(node_id, left.bits == right.bits); }
        if (op == .not_equal) { return self.bool_const_for_node(node_id, left.bits != right.bits); }
        if (op == .less) { return self.bool_const_for_node(node_id, left.bits < right.bits); }
        if (op == .less_equal) { return self.bool_const_for_node(node_id, left.bits <= right.bits); }
        if (op == .greater) { return self.bool_const_for_node(node_id, left.bits > right.bits); }
        if (op == .greater_equal) { return self.bool_const_for_node(node_id, left.bits >= right.bits); }
        if (op == .add) {
            return self.int_const_for_node(node_id, expected_type, left.bits + right.bits, left.signed_value);
        }
        if (op == .sub) {
            return self.int_const_for_node(node_id, expected_type, left.bits - right.bits, left.signed_value);
        }
        if (op == .mul) {
            return self.int_const_for_node(node_id, expected_type, left.bits * right.bits, left.signed_value);
        }
        if (op == .div) {
            if (right.bits == UInt64(0)) { return null; }
            return self.int_const_for_node(node_id, expected_type, left.bits / right.bits, left.signed_value);
        }
        if (op == .mod) {
            if (right.bits == UInt64(0)) { return null; }
            return self.int_const_for_node(node_id, expected_type, left.bits % right.bits, left.signed_value);
        }
        if (op == .bit_and) {
            return self.int_const_for_node(node_id, expected_type, left.bits & right.bits, left.signed_value);
        }
        if (op == .bit_or) {
            return self.int_const_for_node(node_id, expected_type, left.bits | right.bits, left.signed_value);
        }
        if (op == .bit_xor) {
            return self.int_const_for_node(node_id, expected_type, left.bits ^ right.bits, left.signed_value);
        }
        if (op == .shift_left) {
            return self.int_const_for_node(node_id, expected_type, left.bits << right.bits, left.signed_value);
        }
        if (op == .shift_right) {
            return self.int_const_for_node(node_id, expected_type, left.bits >> right.bits, left.signed_value);
        }
        return null;
    }

    public jil.Const bool_const_for_node(self, sem.NodeId node_id, Bool value) {
        return jil.Const (
            type_id: self.type_for_node(node_id),
            span: self.lowerer.model_span(node_id),
            value: jil.bool_const_kind(jil.BoolConst (value: value))
        );
    }

    public jil.Const int_const_for_node(self, sem.NodeId node_id, qid.TypeId type_id, UInt64 bits, Bool signed_value) {
        return jil.Const (
            type_id: type_id,
            span: self.lowerer.model_span(node_id),
            value: jil.int_const_kind(jil.IntConst (bits: bits, signed_value: signed_value))
        );
    }

}
