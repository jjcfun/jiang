// Semantic Model package 到 JIL Store 的 lowering。
//
// 本模块只提供稳定入口和 package 调度；具体 lowering 由同目录职责模块实现。

import context = "../../context.jiang";
import compiler_store = "../../store.jiang";
import database = "../../db.jiang";
import type_lifetime_shape = "../../db/type_lifetime_shape.jiang";
import diagnostic = "../../diagnostic.jiang";
import sem_store = "../../sema/model/store.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import store = "../../resolve/store.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import qid = "../../id.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import system_target = "../../system/target.jiang";
import jil = "../model.jiang";
import drop_elaborate = "../drop_elaborate.jiang";
import std;
import coroutine_confinement = "../coroutine/confinement.jiang";
import coroutine_rtc = "../coroutine/run_to_completion.jiang";
import lower_context = "./context.jiang";
public import lower_coroutine = "./coroutine.jiang";
public import lower_derived = "./derived.jiang";
public import lower_function = "./function.jiang";
public import lower_entry = "./entry.jiang";
public import lower_local = "./local.jiang";
public import lower_type_support = "./type_support.jiang";
public import lower_pattern = "./pattern.jiang";
public import lower_domain_executor = "./domain_executor.jiang";

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    sem_store.Store& model = ctx.store.model$.ref();
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    return lower_package(ctx, model, typeck, graph);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph
) {
    jil.Store^ output! = new jil.Store(model.ok && typeck.ok);
    if (!output.program.has_query_identity()) {
        output.program.bind_query_identity(ctx.query.allocate_jil_store_identity());
    }
    output.program.main_domain_def = ctx.store.resolve.core_values.main_domain;
    if (model.has_errors() || typeck.has_errors()) {
        return output;
    }

    qid.SymbolId closure_env_symbol = ctx.store.symbols.intern("__env");
    Int semantic_def_count = model.def_len();
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    lower_package_into(
        ctx.store$.ref(),
        ctx.query.source_jil$.ref(),
        ctx.query.trait_vtable$.ref(),
        ctx.query.lifetime_shape$.mut_ref(),
        ctx.query.jil_instance$.ref(),
        ctx.query.layout$.mut_ref(),
        ctx.output,
        model,
        typeck,
        graph,
        closure_env_symbol,
        output$.mut_ref(),
        diagnostics$.mut_ref()
    );
    if (model.def_len() != semantic_def_count) {
        output.program.mark_error();
        add_lowering_error(
            diagnostics$.mut_ref(),
            "JIL lowering mutated the Semantic Model",
            "jil_semantic_model_mutation"
        );
    }
    if (output.program.has_errors()) {
        add_lowering_error(diagnostics$.mut_ref(), "JIL lowering failed", "jil_lowering_failed");
    }
    ctx.store.diagnostics.append(diagnostics$.move());
    return output;
}

Void lower_package_into(
    compiler_store.CompilerStore& store,
    database.SourceJilQuery& template_query,
    database.TraitVTableQuery& trait_vtable_query,
    type_lifetime_shape.TypeLifetimeShapeQuery&! lifetime_shape_query,
    database.JilInstanceQuery& instance_query,
    database.LayoutQuery&! layouts,
    system_target.BuildOutputKind output_kind,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph,
    qid.SymbolId closure_env_symbol,
    jil.Store&! output,
    diagnostic.DiagnosticStore&! diagnostics
) {
    lower_context.Context lowerer! = lower_context.Context(
        store,
        output_kind,
        model,
        typeck,
        graph,
        template_query,
        trait_vtable_query,
        lifetime_shape_query,
        closure_env_symbol,
        output.storage$.ref(),
        output.program$.mut_ref(),
        output.drop_elaboration$.mut_ref(),
        diagnostics
    );
    lowerer.lower_package(instance_query, layouts);
}

public Void lower_drop_references(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! output,
    Int mono_item_cursor
) {
    qid.SymbolId closure_env_symbol = ctx.store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    {
        lower_context.Context lowerer! = lower_context.Context(
            ctx.store$.ref(),
            ctx.output,
            ctx.store.model$.ref(),
            ctx.store.typeck$.ref(),
            graph,
            ctx.query.source_jil$.ref(),
            ctx.query.trait_vtable$.ref(),
            ctx.query.lifetime_shape$.mut_ref(),
            closure_env_symbol,
            output.storage$.ref(),
            output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(),
            diagnostics$.mut_ref()
        );
        lowerer.close_drop_references(
            ctx.query.jil_instance$.ref(),
            ctx.query.layout$.mut_ref(),
            mono_item_cursor
        );
    }
    ctx.store.diagnostics.append(diagnostics$.move());
}

public extend lower_context.Context {
    public Void lower_package(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts
    ) {
        // 先为 source function 建立可含泛型参数的 generic JIL。具体实例由
        // runtime roots 和实例视图中的函数引用驱动，不再维护全量实例集合。
        Int module_index! = 0;
        while (module_index < self.graph.module_count()) {
            store.ModuleRecord& module = self.store.resolve.module_ref(self.graph.module_at(module_index));
            self.lower_def_tree(instance_query, layouts, module.def_id);
            module_index = module_index + 1;
        }
        self.materialize_template_async_operations(instance_query, layouts);
        self.prepare_template_coroutine_resume_functions();
        self.lower_runtime_entry(instance_query, layouts);
        Int referenced_global_cursor! = 0;
        Int mono_item_cursor! = 0;
        Int finalization_cursor! = 0;
        list.ArrayList<jil.MonoItem> pending_finalization! =
            list.ArrayList<jil.MonoItem>();
        self.close_referenced_instances(
            instance_query,
            layouts,
            referenced_global_cursor$.mut_ref(),
            mono_item_cursor$.mut_ref(),
            finalization_cursor$.mut_ref(),
            pending_finalization$.mut_ref()
        );
        list.ArrayList<coroutine_confinement.Summary> confinement! =
            coroutine_confinement.analyze(self.store, self.program);
        self.apply_coroutine_confinement(confinement$.ref());
        self.rtc_eligible = coroutine_rtc.analyze(
            self.store, self.program, self.storage
        );
        self.prepare_coroutine_plans();
        self.prepare_generated_coroutine_variant_sources();
        self.lower_coroutine_resume_functions();
        self.close_referenced_instances(
            instance_query,
            layouts,
            referenced_global_cursor$.mut_ref(),
            mono_item_cursor$.mut_ref(),
            finalization_cursor$.mut_ref(),
            pending_finalization$.mut_ref()
        );
        while (self.finish_async_callable_abi_functions()) {
            self.close_referenced_instances(
                instance_query,
                layouts,
                referenced_global_cursor$.mut_ref(),
                mono_item_cursor$.mut_ref(),
                finalization_cursor$.mut_ref(),
                pending_finalization$.mut_ref()
            );
        }
        self.publish_template_coroutine_resume_functions();
        self.source_resume_templates.clear();
        if (self.program.has_pending_generated_functions()) {
            self.program.mark_error();
            std.String message! = std.String(
                "JIL lowering left generated functions unfinished"
            );
            if (self.program.first_pending_generated_function()
                is .some(function_id)) {
                std.StringBuilder builder! = std.StringBuilder();
                builder.append("JIL lowering left generated FunctionId unfinished: ");
                builder.append(function_id.to_index());
                jil.Function pending = self.program.function(function_id);
                if (pending.origin is .generated(origin)) {
                    builder.append(" (");
                    builder.append(self.program.generated_name(origin.name));
                    builder.append(")");
                }
                message = builder.into_string();
            }
            add_lowering_error(
                self.diagnostics$.mut_ref(),
                message.bytes(),
                "jil_unfinished_generated_function"
            );
        }
    }

    Void close_referenced_instances(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        Int&! referenced_global_cursor,
        Int&! mono_item_cursor,
        Int&! finalization_cursor,
        list.ArrayList<jil.MonoItem>&! pending_finalization
    ) {
        Bool continue_closure! = true;
        while (continue_closure) {
            self.lower_global_references(
                instance_query, layouts, referenced_global_cursor
            );
            while (mono_item_cursor$.get() < self.program.mono_item_count()) {
                jil.MonoItem item = self.program.mono_item_at(
                    mono_item_cursor$.get()
                );
                mono_item_cursor$.set(mono_item_cursor$.get() + 1);
                self.lower_mono_item_references(instance_query, layouts, item);
            }
            Bool finalized = self.finalize_instance_functions(
                instance_query,
                layouts,
                finalization_cursor,
                pending_finalization
            );
            continue_closure = mono_item_cursor$.get() < self.program.mono_item_count()
                || referenced_global_cursor$.get() < self.program.globals.len()
                || (finalized && !pending_finalization.empty());
        }
    }

    Void close_drop_references(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        Int mono_item_cursor
    ) {
        Int cursor! = mono_item_cursor;
        while (cursor < self.program.mono_item_count()) {
            jil.MonoItem item = self.program.mono_item_at(cursor);
            cursor = cursor + 1;
            self.lower_mono_item_references(instance_query, layouts, item);
            if (item is .source_instance(identity)) {
                drop_elaborate.ensure_source_instance_drop_glue(
                    self.store,
                    layouts,
                    self.storage,
                    self.program,
                    self.drop_elaboration,
                    identity
                );
            }
        }
    }

}

Void add_lowering_error(
    diagnostic.DiagnosticStore&! diagnostics,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostics.add(diagnostic.Diagnostic(
        .error,
        .lowering,
        diagnostic.DiagnosticCode(code),
        diagnostic.SourceRange(),
        message
    ));
}
