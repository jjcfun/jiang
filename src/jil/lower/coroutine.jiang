// package 级协程规划、变体生成和 task 状态布局。
//
// 本模块处理函数体 lowering 之后的协程产物，不承担表达式或语句 lowering。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import types = "../../sema/type.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import instance_reader = "../instance_reader.jiang";
import std;
import coroutine_frame_layout = "../coroutine/frame_layout.jiang";
import coroutine_frame_rewrite = "../coroutine/frame_rewrite.jiang";
import coroutine_task_abi = "../coroutine/task_abi.jiang";
import coroutine_confinement = "../coroutine/confinement.jiang";
import coroutine_local_variant = "../coroutine/local_variant.jiang";
import coroutine_rtc = "../coroutine/run_to_completion.jiang";
import coroutine_variant = "./coroutine_variant.jiang";
import * = "./model.jiang";
import lower_context = "./context.jiang";
import * = "./body.jiang";
import * = "./context.jiang";
import lower_entry = "./entry.jiang";

public extend lower_context.Context {
    @life(return: (self.b, self.b))
    jil.CoroutineResumeTemplate source_resume_template(
        self,
        qid.DefId function_def,
        jil.CoroutineResumeMode mode
    ) {
        return self.source_resume_templates.get(jil.SourceResumeTemplateKey(
            def_id: function_def, mode: mode
        ))$.some()$.get();
    }

    public Void prepare_template_coroutine_resume_functions(Self&! self) {
        Int index! = 0;
        while (index < self.program.source_function_count()) {
            jil.Function source = self.program.source_function_at(index);
            index = index + 1;
            if (!source.effects.has_async || source.is_external) { continue; }
            guard source.origin is .source(function_def) else { continue; }
            guard source.coroutine_frame is .some(frame) else {
                self.program.mark_error();
                continue;
            }
            coroutine_frame_rewrite.ResumeFunctionLowering resume =
                coroutine_frame_rewrite.lower_resume_function(
                    self.storage, source, frame$.ref(), source.id
                );
            self.source_resume_templates.set(
                jil.SourceResumeTemplateKey(
                    def_id: function_def, mode: .standard
                ),
                jil.CoroutineResumeTemplate(
                    function: resume.function,
                    frame_local_id: resume.frame_local_id,
                    resume_return_local_id: resume.resume_return_local_id
                )
            );
        }
    }

    public Void publish_template_coroutine_resume_functions(Self&! self) {
        Int index! = 0;
        while (index < self.program.source_function_count()) {
            jil.Function source = self.program.source_function_at(index);
            index = index + 1;
            guard source.origin is .source(function_def) else { continue; }
            self.publish_source_resume_template(function_def, .standard);
            self.publish_source_resume_template(function_def, .confined);
            self.publish_source_resume_template(
                function_def, .run_to_completion
            );
        }
    }

    Void publish_source_resume_template(
        Self&! self,
        qid.DefId function_def,
        jil.CoroutineResumeMode mode
    ) {
        guard self.source_resume_templates.get(jil.SourceResumeTemplateKey(
            def_id: function_def, mode: mode
        )) is .some(template) else { return; }
        self.program.add_source_resume_template(
            function_def, mode, template$.get()
        );
    }

    public Void apply_coroutine_confinement(
        Self&! self,
        list.ArrayList<coroutine_confinement.Summary>& states
    ) {
        Int index! = 0;
        while (index < self.program.mono_item_count()) {
            jil.MonoItem item = self.program.mono_item_at(index);
            coroutine_confinement.Summary summary = states.get(index);
            jil.CoroutineConfinement confinement! = .preserving;
            if (summary.kind == .escaping) { confinement = .escaping; }
            if (item is .source_instance(identity)) {
                self.program.set_instance_coroutine_properties(
                    identity, confinement, summary.binding
                );
                self.program.update_instance_coroutine_may_defer(
                    identity, summary.may_defer
                );
                index = index + 1;
                continue;
            }
            if (item is .generated_function(function_id)) {
                jil.Function function! = self.program.function(function_id);
                function = jil.function_with_confinement(
                    function, confinement, summary.binding
                );
                if (function.coroutine_frame is .some(frame)) {
                    jil.CoroutineFrameLayout updated =
                        jil.coroutine_frame_with_runtime_properties(
                            frame, frame.domain_kind, summary.may_defer
                        );
                    function = jil.function_with_coroutine_frame(function, updated);
                }
                self.program.set_function(function);
            }
            index = index + 1;
        }
    }

    public Void prepare_coroutine_plans(Self&! self) {
        list.ArrayList<jil.MonoItem> worklist! = list.ArrayList<jil.MonoItem>();
        list.ArrayList<jil.MonoItem> confined! = list.ArrayList<jil.MonoItem>();
        list.ArrayList<jil.MonoItem> rtc! = list.ArrayList<jil.MonoItem>();
        Int item_count = self.program.mono_item_count();
        Int index! = 0;
        while (index < item_count) {
            self.collect_coroutine_plan_roots(
                self.program.mono_item_at(index),
                confined$.mut_ref(),
                rtc$.mut_ref()
            );
            index = index + 1;
        }
        self.publish_confined_candidates(confined$.mut_ref(), worklist$.mut_ref());
        self.publish_rtc_candidates(rtc$.mut_ref());
        index = 0;
        while (index < worklist.len()) {
            confined.clear();
            self.collect_mono_item_confined_children(
                worklist.get(index), confined$.mut_ref()
            );
            self.publish_confined_candidates(confined$.mut_ref(), worklist$.mut_ref());
            index = index + 1;
        }
        self.prepare_rtc_resume_shims(worklist$.ref());
    }

    Void collect_coroutine_plan_roots(
        self,
        jil.MonoItem item,
        list.ArrayList<jil.MonoItem>&! confined,
        list.ArrayList<jil.MonoItem>&! rtc
    ) {
        if (item is .source_instance(identity)) {
            jil.Function function = instance_reader.source_instance_function(
                self.store, self.program$.ref(), identity
            );
            self.collect_confined_task_roots(item, confined);
            self.collect_direct_rtc_children(function, confined, rtc);
            return;
        }
        guard item is .generated_function(function_id) else { return; }
        jil.Function function = self.program.function(function_id);
        self.collect_confined_task_roots(item, confined);
        self.collect_direct_rtc_children(function, confined, rtc);
    }

    public Void collect_direct_rtc_children(
        self,
        jil.Function function,
        list.ArrayList<jil.MonoItem>&! confined,
        list.ArrayList<jil.MonoItem>&! rtc
    ) {
        Int block_index! = 0;
        while (block_index < function.body.blocks.length) {
            jil.Terminator terminator = function.body.blocks[block_index].terminator;
            if (terminator.kind is .call_term(call)) {
                self.collect_direct_rtc_candidates(call, confined, rtc);
            }
            block_index = block_index + 1;
        }
    }

    public Void collect_direct_rtc_candidates(
        self,
        jil.CallTerminator call,
        list.ArrayList<jil.MonoItem>&! confined,
        list.ArrayList<jil.MonoItem>&! rtc
    ) {
        if (call.suspend_wake != .direct_child) { return; }
        guard coroutine_rtc.eligible_child(
            self.program, self.storage, self.rtc_eligible$.ref(), call
        ) is .some(child) else { return; }
        guard self.program.coroutine_source_item_for_ref(child)
            is .some(item) else { return; }
        if (!self.mono_item_rtc_binding_is_satisfied(call, item)) { return; }
        if (self.mono_item_has_cross_executor_child(item)) { confined.add(item); }
        rtc.add(item);
    }

    Bool mono_item_rtc_binding_is_satisfied(
        self,
        jil.CallTerminator call,
        jil.MonoItem item
    ) {
        if (item is .source_instance(identity)) {
            return self.direct_rtc_binding_is_satisfied(
                call,
                instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                )
            );
        }
        guard item is .generated_function(function_id) else { return false; }
        return self.direct_rtc_binding_is_satisfied(
            call, self.program.function(function_id)
        );
    }

    Bool mono_item_has_cross_executor_child(self, jil.MonoItem item) {
        if (item is .source_instance(identity)) {
            jil.Function function = instance_reader.source_instance_function(
                self.store, self.program$.ref(), identity
            );
            return coroutine_rtc.body_has_cross_executor_child(function.body);
        }
        guard item is .generated_function(function_id) else { return false; }
        return coroutine_rtc.body_has_cross_executor_child(
            self.program.function(function_id).body
        );
    }

    public Bool direct_rtc_binding_is_satisfied(
        self,
        jil.CallTerminator call,
        jil.Function child
    ) {
        guard child.confinement_domain is .some(required) else { return true; }
        guard call.current_effects.domain is .some(domain) else { return false; }
        return domain.binding == required;
    }

    public Void prepare_generated_coroutine_variant_sources(Self&! self) {
        Int item_count = self.program.mono_item_count();
        Int index! = 0;
        while (index < item_count) {
            jil.MonoItem item = self.program.mono_item_at(index);
            if (item is .generated_function(function_id)) {
                jil.Function prepared = self.prepare_coroutine_variant_source(
                    item, self.program.function(function_id)
                );
                self.program.set_function(prepared);
            }
            index = index + 1;
        }
    }

    @life(return: (source.a, self.b & source.b))
    public jil.Function prepare_coroutine_variant_source(
        Self&! self,
        jil.MonoItem item,
        jil.Function source
    ) {
        if (self.program.coroutine_frame_for_mono_item(item) == null) {
            jil.Function selected = coroutine_local_variant.select_task_roots(
                self.storage, self.program, source, self.coroutine_plans$.ref()
            );
            return selected;
        }
        guard self.program.coroutine_frame_for_mono_item(item) is .some(frame) else {
            return source;
        }
        Bool has_direct_child = coroutine_rtc.body_has_direct_rtc_child(
            self.program, source.body, self.coroutine_plans$.ref()
        );
        if (!has_direct_child) {
            jil.Function selected = coroutine_local_variant.select_task_roots(
                self.storage, self.program, source, self.coroutine_plans$.ref()
            );
            return selected;
        }
        jil.Function selected = coroutine_local_variant.select_task_roots(
            self.storage, self.program, source, self.coroutine_plans$.ref()
        );
        jil.Body body = coroutine_rtc.rewrite_direct_rtc_children(
            self.program, self.storage, selected.body, self.coroutine_plans$.ref()
        );
        return jil.function_with_body(selected, body);
    }

    public qid.TypeId? coroutine_capture_env_type(self, jil.CoroutineFrameLayout& layout) {
        if (layout.capture_env_field_index < 0) { return null; }
        return layout.fields[layout.capture_env_field_index].type_id;
    }

    public Void prepare_rtc_resume_shims(
        Self&! self,
        list.ArrayList<jil.MonoItem>& confined
    ) {
        list.ArrayList<jil.MonoItem> candidates! = list.ArrayList<jil.MonoItem>();
        Int function_index! = 0;
        while (function_index < confined.len()) {
            self.collect_mono_item_rtc_children(
                confined.get(function_index), candidates$.mut_ref()
            );
            function_index = function_index + 1;
        }
        self.publish_rtc_candidates(candidates$.mut_ref());
    }

    public Void collect_rtc_children(
        self,
        jil.Function function,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        Int block_index! = 0;
        while (block_index < function.body.blocks.length) {
            jil.Terminator terminator = function.body.blocks[block_index].terminator;
            if (terminator.kind is .call_term(call)) {
                if (coroutine_rtc.eligible_child(
                        self.program, self.storage, self.rtc_eligible$.ref(), call
                    ) is .some(child)
                ) {
                    if (self.program.coroutine_source_item_for_ref(child)
                        is .some(item)) {
                        candidates.add(item);
                    }
                }
            }
            block_index = block_index + 1;
        }
    }

    Void collect_mono_item_rtc_children(
        self,
        jil.MonoItem item,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        if (item is .source_instance(identity)) {
            self.collect_rtc_children(
                instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                ),
                candidates
            );
            return;
        }
        guard item is .generated_function(function_id) else { return; }
        self.collect_rtc_children(self.program.function(function_id), candidates);
    }

    public Void publish_rtc_candidates(
        Self&! self,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        Int index! = 0;
        while (index < candidates.len()) {
            self.create_rtc_resume_shim(candidates.get(index));
            index = index + 1;
        }
    }

    public Void create_rtc_resume_shim(Self&! self, jil.MonoItem item) {
        if (self.coroutine_plans.get(item).rtc_resume != null) { return; }
        if (item is .source_instance(identity)) {
            self.coroutine_plans.set_rtc_resume(
                item,
                jil.source_resume_mono_item(identity, .run_to_completion)
            );
            return;
        }
        jil.FunctionId resume_id = self.reserve_coroutine_variant(
            item, "__rtc_resume_", .coroutine_resume_rtc
        );
        self.coroutine_plans.set_rtc_resume(
            item, jil.generated_function_mono_item(resume_id)
        );
    }

    public Void collect_confined_task_roots(
        self,
        jil.MonoItem item,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        guard self.program.coroutine_frame_for_mono_item(item) is .some(frame) else {
            return;
        }
        Int index! = 0;
        while (index < frame.task_regions.length) {
            jil.TaskRegion region = frame.task_regions[index];
            if (region.storage.sync == .local_serial) {
                self.collect_confined_candidate(region.child_resume, candidates);
            }
            index = index + 1;
        }
    }

    public Void collect_confined_children(
        self,
        jil.Function function,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        Int index! = 0;
        while (index < function.body.blocks.length) {
            jil.Terminator terminator = function.body.blocks[index].terminator;
            if (terminator.kind is .call_term(call)) {
                if (!async_start_is_detached(call.async_start)) {
                    self.collect_confined_candidate(call.suspend_child, candidates);
                }
            }
            index = index + 1;
        }
    }

    Void collect_mono_item_confined_children(
        self,
        jil.MonoItem item,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        self.collect_confined_task_roots(item, candidates);
        if (item is .source_instance(identity)) {
            self.collect_confined_children(
                instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                ),
                candidates
            );
            return;
        }
        guard item is .generated_function(function_id) else { return; }
        self.collect_confined_children(
            self.program.function(function_id), candidates
        );
    }

    public Void collect_confined_candidate(
        self,
        jil.FunctionRef? candidate,
        list.ArrayList<jil.MonoItem>&! candidates
    ) {
        guard candidate is .some(function_ref) else { return; }
        if (!(function_ref.variant is .coroutine_resume(_))) { return; }
        guard self.program.coroutine_source_item_for_ref(function_ref)
            is .some(item) else { return; }
        candidates.add(item);
    }

    public Void publish_confined_candidates(
        Self&! self,
        list.ArrayList<jil.MonoItem>&! candidates,
        list.ArrayList<jil.MonoItem>&! worklist
    ) {
        Int index! = 0;
        while (index < candidates.len()) {
            self.demand_confined_variant(candidates.get(index), worklist);
            index = index + 1;
        }
    }

    public Void demand_confined_variant(
        Self&! self,
        jil.MonoItem item,
        list.ArrayList<jil.MonoItem>&! worklist
    ) {
        if (self.coroutine_plans.get(item).confined_resume != null) { return; }
        if (!self.mono_item_has_confined_variant(item)) { return; }
        self.create_confined_coroutine_shims(item);
        worklist.add(item);
    }

    public Bool function_has_confined_variant(self, jil.Function function) {
        if (!function.is_coroutine || function.is_external) { return false; }
        if (function.confinement == .escaping) { return false; }
        return !self.async_lambda_function_is_detached(jil.function_provenance_def(function.origin));
    }

    Bool mono_item_has_confined_variant(self, jil.MonoItem item) {
        if (item is .source_instance(identity)) {
            return self.function_has_confined_variant(
                instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                )
            );
        }
        guard item is .generated_function(function_id) else { return false; }
        return self.function_has_confined_variant(
            self.program.function(function_id)
        );
    }

    public Void create_confined_coroutine_shims(
        Self&! self,
        jil.MonoItem item
    ) {
        if (item is .source_instance(identity)) {
            self.coroutine_plans.set_confined_resume(
                item, jil.source_resume_mono_item(identity, .confined)
            );
            return;
        }
        jil.FunctionId resume_id = self.reserve_coroutine_variant(
            item, "__confined_resume_", .coroutine_resume_confined
        );
        self.coroutine_plans.set_confined_resume(
            item, jil.generated_function_mono_item(resume_id)
        );
    }

    public jil.FunctionId ensure_serial_completion_shim(
        Self&! self,
        qid.DefId source_def,
        types.GenericArg[]& args,
        token.Span span
    ) {
        Int identity = self.program.function_instance_identity(
            self.storage, source_def, args
        );
        jil.GeneratedKey key = jil.GeneratedKey(
            .serial_completion,
            parent: jil.source_instance_mono_item(identity)
        );
        if (self.program.generated_function(key) is .some(existing)) {
            return existing;
        }
        jil.GeneratedFunctionOrigin origin = self.coroutine_variant_origin(
            source_def,
            "__serial_task_complete_",
            .serial_completion,
            span
        );
        jil.FunctionId shim_id = self.program.reserve_generated_function(
            self.storage, key, origin, args, span
        );
        return shim_id;
    }

    jil.FunctionId reserve_coroutine_variant(
        Self&! self,
        jil.MonoItem item,
        UInt8[]& prefix,
        jil.GeneratedFunctionKind kind
    ) {
        if (item is .source_instance(identity)) {
            jil.InstanceKey instance = self.program.function_instance_at(identity);
            token.Span span = self.program.source_function(instance.def_id).span;
            types.GenericArg[]& args = self.storage.generic_arg_array(instance.args);
            return self.reserve_coroutine_variant_for(
                item, instance.def_id, args, span, prefix, kind
            );
        }
        guard item is .generated_function(function_id) else {
            assert(false, "unknown coroutine mono item");
            return jil.FunctionId.from_index(0);
        }
        jil.Function function = self.program.function(function_id);
        qid.DefId provenance = jil.function_provenance_def(function.origin);
        token.Span span = function.span;
        types.GenericArg[]& args = self.storage.generic_arg_array(function.args);
        return self.reserve_coroutine_variant_for(
            item, provenance, args, span, prefix, kind
        );
    }

    jil.FunctionId reserve_coroutine_variant_for(
        Self&! self,
        jil.MonoItem parent,
        qid.DefId provenance,
        types.GenericArg[]& args,
        token.Span span,
        UInt8[]& prefix,
        jil.GeneratedFunctionKind kind
    ) {
        jil.GeneratedKey key = jil.GeneratedKey(kind, parent: parent);
        if (self.program.generated_function(key) is .some(existing)) {
            return existing;
        }
        jil.GeneratedFunctionOrigin origin = self.coroutine_variant_origin(
            provenance, prefix, kind, span
        );
        jil.FunctionId function_id = self.program.reserve_generated_function(
            self.storage, key, origin, args, span
        );
        return function_id;
    }

    public jil.GeneratedFunctionOrigin coroutine_variant_origin(
        Self&! self,
        qid.DefId source_def,
        UInt8[]& prefix,
        jil.GeneratedFunctionKind kind,
        token.Span span
    ) {
        def.DefRecord source = self.store.defs.get(source_def);
        std.String name = build_text_int(prefix, source_def.to_index());
        return jil.GeneratedFunctionOrigin(
            name: self.program.add_generated_name(name.bytes()),
            module_id: source.module_id,
            kind: kind,
            provenance_def: source_def,
            identity_type: null
        );
    }

    public Void lower_coroutine_resume_functions(Self&! self) {
        Int item_count = self.program.mono_item_count();
        Int index! = 0;
        while (index < item_count) {
            jil.MonoItem item = self.program.mono_item_at(index);
            if (item is .source_instance(identity)) {
                jil.Function source = instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                );
                jil.Function prepared = self.prepare_coroutine_variant_source(
                    item, source
                );
                self.lower_coroutine_resume_function(item, prepared);
            } else if (item is .generated_function(function_id)) {
                self.lower_coroutine_resume_function(
                    item, self.program.function(function_id)
                );
            }
            index = index + 1;
        }
    }

    public Bool finish_async_callable_abi_functions(Self&! self) {
        Bool finished! = false;
        Int item_count = self.program.mono_item_count();
        Int index! = 0;
        while (index < item_count) {
            jil.MonoItem item = self.program.mono_item_at(index);
            finished = self.finish_async_callable_abi_for_item(item) || finished;
            index = index + 1;
        }
        return finished;
    }

    Bool finish_async_callable_abi_for_item(
        Self&! self,
        jil.MonoItem item
    ) {
        guard self.program.coroutine_frame_for_mono_item(item)
            is .some(frame) else { return false; }
        if (item is .source_instance(identity)) {
            return self.add_async_callable_abi_functions(
                item,
                instance_reader.source_instance_function(
                    self.store, self.program$.ref(), identity
                ),
                frame$.ref()
            );
        }
        guard item is .generated_function(function_id) else { return false; }
        return self.add_async_callable_abi_functions(
            item, self.program.function(function_id), frame$.ref()
        );
    }

    public Void lower_coroutine_resume_function(
        Self&! self,
        jil.MonoItem item,
        jil.Function function
    ) {
        if (!function.is_coroutine || function.is_coroutine_resume) {
            return;
        }
        guard self.program.coroutine_frame_for_mono_item(item) is .some(frame) else {
            return;
        }
        self.add_async_callable_abi_functions(item, function, frame$.ref());
        jil.FunctionRef? env_drop = self.async_lambda_env_drop_function(
            function, frame$.ref(), function.span
        );
        if (function.is_external) {
            coroutine_frame_rewrite.add_completion_function(
                self.storage, self.program, item, function, frame$.ref(), env_drop
            );
            self.finish_serial_completion_function(
                item, function, frame$.ref(), env_drop
            );
            return;
        }
        Bool detached = self.async_lambda_function_is_detached(
            jil.function_provenance_def(function.origin)
        );
        if (detached) {
            coroutine_frame_rewrite.add_detached_completion_function(
                self.storage, self.program, item, function, frame$.ref(), env_drop
            );
        } else {
            coroutine_frame_rewrite.add_completion_function(
                self.storage, self.program, item, function, frame$.ref(), env_drop
            );
        }
        coroutine_frame_rewrite.ResumeFunctionLowering resume!;
        if (item is .source_instance(identity)) {
            qid.DefId source_def = jil.function_provenance_def(function.origin);
            self.prepare_source_resume_templates(source_def);
            jil.CoroutineResumeTemplate template =
                self.source_resume_template(source_def, .standard);
            resume = coroutine_frame_rewrite.ResumeFunctionLowering(
                function: jil.Function(
                    id: template.function.id,
                    origin: template.function.origin,
                    args: self.storage.generic_arg_array(function.args),
                    signature_id: template.function.signature_id,
                    effects: function.effects,
                    is_coroutine: false,
                    coroutine_capture_env_type: null,
                    coroutine_frame: null,
                    confinement: function.confinement,
                    confinement_domain: function.confinement_domain,
                    is_coroutine_resume: true,
                    is_coroutine_completion: false,
                    is_language_entry: false,
                    is_runtime_entry: false,
                    is_external: false,
                    inline_always: template.function.inline_always,
                    naked: false,
                    span: template.function.span,
                    body: template.function.body
                ),
                frame_local_id: template.frame_local_id,
                resume_return_local_id: template.resume_return_local_id
            );
        } else {
            resume = coroutine_frame_rewrite.add_generated_resume_function(
                self.storage, self.program, item, function, frame$.ref()
            );
            self.drop_elaboration.mark(resume.function.id);
            self.program.mark_borrow_check_exempt(resume.function.id);
        }
        if (detached) { return; }
        if (item is .source_instance(_)) {
            self.add_source_confined_resume_template(item, function);
            self.add_source_rtc_resume_template(item, function);
        } else {
            coroutine_variant.add_confined(
                item,
                function,
                frame$.ref(),
                resume,
                self.storage,
                self.coroutine_plans$.ref(),
                self.program,
                self.drop_elaboration$.mut_ref()
            );
        }
        coroutine_variant.add_rtc(
            item,
            function,
            frame$.ref(),
            self.storage,
            self.coroutine_plans$.ref(),
            self.program,
            self.drop_elaboration$.mut_ref()
        );
        self.finish_serial_completion_function(
            item, function, frame$.ref(), env_drop
        );
    }

    Void finish_serial_completion_function(
        Self&! self,
        jil.MonoItem item,
        jil.Function function,
        jil.CoroutineFrameLayout& frame,
        jil.FunctionRef? env_drop
    ) {
        qid.DefId source_def = jil.function_provenance_def(function.origin);
        guard self.program.serial_completion_function(
            source_def, function.args
        ) is .some(serial_id) else { return; }
        coroutine_frame_rewrite.add_serial_completion_function(
            self.storage,
            self.program,
            function,
            frame,
            env_drop,
            serial_id
        );
    }

    Void prepare_source_resume_templates(
        Self&! self,
        qid.DefId source_def
    ) {
        jil.Function source = self.program.source_function(source_def);
        guard source.coroutine_frame is .some(frame) else { return; }
        jil.Function prepared! = coroutine_local_variant.select_task_roots(
            self.storage, self.program, source, self.coroutine_plans$.ref()
        );
        if (coroutine_rtc.body_has_direct_rtc_child(
                self.program, prepared.body, self.coroutine_plans$.ref()
            )
        ) {
            jil.Body body = coroutine_rtc.rewrite_direct_rtc_children(
                self.program,
                self.storage,
                prepared.body,
                self.coroutine_plans$.ref()
            );
            prepared = jil.function_with_body(prepared, body);
        }
        coroutine_frame_rewrite.ResumeFunctionLowering resume =
            coroutine_frame_rewrite.lower_resume_function(
                self.storage, prepared, frame$.ref(), source.id
            );
        self.source_resume_templates.set(
            jil.SourceResumeTemplateKey(
                def_id: source_def, mode: .standard
            ),
            jil.CoroutineResumeTemplate(
                function: resume.function,
                frame_local_id: resume.frame_local_id,
                resume_return_local_id: resume.resume_return_local_id
            )
        );
    }

    Void add_source_rtc_resume_template(
        Self&! self,
        jil.MonoItem item,
        jil.Function instance
    ) {
        guard self.coroutine_plans.get(item).rtc_resume
            is .some(variant) else { return; }
        guard variant is .source_resume_instance(_) else { return; }
        qid.DefId source_def = jil.function_provenance_def(instance.origin);
        jil.SourceResumeTemplateKey key = jil.SourceResumeTemplateKey(
            def_id: source_def, mode: .run_to_completion
        );
        if (self.source_resume_templates.has(key)) { return; }
        jil.Function source = self.program.source_function(source_def);
        guard source.coroutine_frame is .some(frame) else { return; }
        jil.Function optimized = coroutine_variant.source_with_rtc_calls(
            source,
            frame$.ref(),
            self.program,
            self.storage,
            self.coroutine_plans$.ref()
        );
        coroutine_frame_rewrite.ResumeFunctionLowering resume =
            coroutine_frame_rewrite.lower_rtc_resume_function(
                self.storage, optimized, frame$.ref(), source.id
            );
        jil.Place current_executor =
            coroutine_frame_rewrite.resume_current_executor_place(
                self.storage, frame$.ref(), resume.frame_local_id
            );
        jil.Body body = coroutine_local_variant.local_body(
            self.storage,
            self.program,
            resume.function.body,
            resume.function.body.id,
            current_executor,
            self.coroutine_plans$.ref()
        );
        jil.Function function = jil.function_with_coroutine_resume_mode(
            jil.function_with_body(resume.function, body),
            .run_to_completion
        );
        self.source_resume_templates.set(key, jil.CoroutineResumeTemplate(
            function: function,
            frame_local_id: resume.frame_local_id,
            resume_return_local_id: resume.resume_return_local_id
        ));
    }

    Void add_source_confined_resume_template(
        Self&! self,
        jil.MonoItem item,
        jil.Function instance
    ) {
        guard self.coroutine_plans.get(item).confined_resume
            is .some(variant) else { return; }
        guard variant is .source_resume_instance(_) else { return; }
        qid.DefId source_def = jil.function_provenance_def(instance.origin);
        jil.SourceResumeTemplateKey key = jil.SourceResumeTemplateKey(
            def_id: source_def, mode: .confined
        );
        if (self.source_resume_templates.has(key)) { return; }
        jil.Function source = self.program.source_function(source_def);
        guard source.coroutine_frame is .some(frame) else { return; }
        coroutine_frame_rewrite.ResumeFunctionLowering resume! =
            coroutine_frame_rewrite.lower_resume_function(
                self.storage, source, frame$.ref(), source.id
            );
        if (coroutine_rtc.body_uses_rtc(
                self.program, self.storage, source.body, frame$.ref(),
                self.coroutine_plans$.ref()
            )
        ) {
            jil.Function optimized = coroutine_variant.source_with_rtc_calls(
                source,
                frame$.ref(),
                self.program,
                self.storage,
                self.coroutine_plans$.ref()
            );
            resume = coroutine_frame_rewrite.lower_resume_function(
                self.storage, optimized, frame$.ref(), source.id
            );
        }
        jil.Place current_executor =
            coroutine_frame_rewrite.resume_current_executor_place(
                self.storage, frame$.ref(), resume.frame_local_id
            );
        jil.Body body = coroutine_local_variant.local_body(
            self.storage,
            self.program,
            resume.function.body,
            resume.function.body.id,
            current_executor,
            self.coroutine_plans$.ref()
        );
        jil.Function function = jil.function_with_coroutine_resume_mode(
            jil.function_with_body(resume.function, body), .confined
        );
        self.source_resume_templates.set(key, jil.CoroutineResumeTemplate(
            function: function,
            frame_local_id: resume.frame_local_id,
            resume_return_local_id: resume.resume_return_local_id
        ));
    }

    public Bool async_lambda_function_is_detached(self, qid.DefId function_def) {
        guard self.typeck.async_lambda_function_usage(function_def) is .some(usage) else { return false; }
        return usage == typeck_store.AsyncStartUsage.detached;
    }

    public jil.FunctionRef? async_lambda_env_drop_function(
        self,
        jil.Function function,
        jil.CoroutineFrameLayout& frame,
        token.Span span
    ) {
        qid.DefId function_def = jil.function_provenance_def(function.origin);
        if (self.async_lambda_function_consumes_env(function_def)) { return null; }
        if (frame.capture_env_field_index < 0) { return null; }
        qid.TypeId env_type = frame.fields[frame.capture_env_field_index].type_id;
        guard self.program.generated_function(jil.GeneratedKey(
            .closure_env_drop_stack,
            identity_type: env_type
        )) is .some(shim_id) else { return null; }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.store.types.opaque_pointer_type(span));
        qid.TypeId function_type = self.store.types.function_type(
            params,
            self.store.types.unit_type(),
            span
        );
        return jil.FunctionRef (
            target: .generated(self.program.generated_function_target(shim_id)),
            args: self.storage.empty_generic_args(),
            type_id: function_type
        );
    }

    Bool async_lambda_function_consumes_env(self, qid.DefId function_def) {
        guard self.typeck.def_type(function_def) is .some(type_id) else { return false; }
        types.TypeInfo info = self.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.call_ownership == .consuming;
    }

    public Bool add_async_callable_abi_functions(
        Self&! self,
        jil.MonoItem source_item,
        jil.Function source,
        jil.CoroutineFrameLayout& layout
    ) {
        guard self.program.existing_function_instance_identity(
            jil.function_provenance_def(source.origin), source.args
        ) is .some(identity) else { return false; }
        jil.MonoItem parent = jil.source_instance_mono_item(identity);
        Bool finished! = false;
        if (self.program.generated_function(jil.GeneratedKey(
            .async_callable_start, parent: parent
        )) is .some(start)
            && self.program.generated_function(jil.GeneratedKey(
                .async_callable_completion, parent: parent
            )) is .some(completion)) {
            if (self.program.generated_function_is_pending(start)) {
                self.add_async_callable_start_function(
                    source, layout, start, completion
                );
                finished = true;
            }
            if (self.program.generated_function_is_pending(completion)) {
                self.add_async_callable_completion_function(
                    source, layout, completion
                );
                finished = true;
            }
        }
        if (self.program.generated_function(jil.GeneratedKey(
            .async_callable_sync, parent: parent
        )) is .some(sync)) {
            if (self.program.generated_function_is_pending(sync)) {
                self.add_async_callable_sync_function(source, layout, sync);
                finished = true;
            }
        }
        return finished;
    }

    public Void add_async_callable_start_function(
        Self&! self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId id,
        jil.FunctionId completion_id
    ) {
        jil.Function reserved = self.program.function(id);
        guard jil.function_generated_origin(reserved.origin) is .some(origin) else { return; }
        token.Span span = source.span;
        jil.Body body = self.async_callable_start_body(
            source, layout, completion_id, id
        );
        self.program.finish_generated_function(jil.Function (
            id: id,
            origin: .generated(origin),
            args: self.storage.generic_arg_array(reserved.args),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: body
        ));
        self.program.mark_borrow_check_exempt(id);
    }

    generic_bindings.GenericBindings async_callable_bindings(
        self,
        jil.Function source
    ) {
        generic_bindings.GenericBindings empty! =
            generic_bindings.GenericBindings();
        return generic_bindings.bindings_for_instance(
            self.store.defs$.ref(),
            self.store.model$.ref(),
            self.store.types$.ref(),
            jil.function_provenance_def(source.origin),
            source.args,
            empty$.ref()
        );
    }

    Int async_callable_param_count(self, jil.Function source) {
        Int count! = 0;
        Int index! = 0;
        while (index < source.body.locals.length) {
            if (source.body.locals[index].kind == .param) { count = count + 1; }
            index = index + 1;
        }
        return count;
    }

    public jil.Body async_callable_start_body(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId completion_id,
        jil.FunctionId function_id
    ) {
        unsafe {
            token.Span span = source.span;
            generic_bindings.GenericBindings bindings =
                self.async_callable_bindings(source);
            instance_reader.InstanceReader reader =
                instance_reader.InstanceReader(self.store, bindings$.ref());
            Int param_count = self.async_callable_param_count(source);
            qid.TypeId result_type = reader.type_id(
                source.body.locals[source.body.return_local.to_index()].type_id
            );
            jil.LocalId continuation_local = jil.LocalId.from_index(param_count + 1);
            jil.LocalId frame_pointer_local = jil.LocalId.from_index(param_count + 2);
            jil.LocalId erased_frame_local = jil.LocalId.from_index(param_count + 3);
            jil.LocalId allocation_executor_local = jil.LocalId.from_index(param_count + 4);
            Bool consumes_env = self.async_lambda_function_consumes_env(
                jil.function_provenance_def(source.origin)
            )
                && layout.capture_env_field_index >= 0;
            Int local_count! = param_count + 5;
            if (consumes_env) { local_count = local_count + 1; }
            jil.LocalDecl*! locals = self.storage.alloc_local_array(local_count);
            locals[0] = self.generated_local(
                jil.LocalId.from_index(0), .return_place, self.store.types.unit_type(), span
            );
            Int source_index! = 0;
            Int param_index! = 0;
            while (source_index < source.body.locals.length) {
                jil.LocalDecl source_local = source.body.locals[source_index];
                source_index = source_index + 1;
                if (source_local.kind != .param) { continue; }
                param_index = param_index + 1;
                locals[param_index] = self.generated_local(
                    jil.LocalId.from_index(param_index),
                    .param,
                    reader.type_id(source_local.type_id),
                    span
                );
            }
            jil.ExternalContinuationLayout continuation_layout =
                self.external_async_continuation_layout(result_type, span);
            locals[continuation_local.to_index()] = self.generated_local(
                continuation_local, .param, continuation_layout.pointer_type_id, span
            );
            locals[frame_pointer_local.to_index()] = self.generated_local(
                frame_pointer_local, .compiler_temp, layout.task_abi.frame_pointer_type_id, span
            );
            locals[erased_frame_local.to_index()] = self.generated_local(
                erased_frame_local, .compiler_temp, self.store.types.opaque_pointer_type(span), span
            );
            locals[allocation_executor_local.to_index()] = self.generated_local(
                allocation_executor_local,
                .compiler_temp,
                self.store.types.opaque_pointer_type(span),
                span
            );
            jil.LocalId consuming_env_pointer_local = jil.LocalId.from_index(param_count + 5);
            if (consumes_env) {
                qid.TypeId env_type = layout.fields[layout.capture_env_field_index].type_id;
                locals[consuming_env_pointer_local.to_index()] = self.generated_local(
                    consuming_env_pointer_local,
                    .compiler_temp,
                    self.store.types.raw_pointer_type(env_type, span),
                    span
                );
            }
            jil.Place frame_pointer = jil.local_place(frame_pointer_local, self.storage.empty_projection());
            jil.Place frame = self.generated_deref_place(frame_pointer, true);
            list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>();
            jil.Place continuation = self.generated_deref_place(
                jil.local_place(continuation_local, self.storage.empty_projection()), true
            );
            jil.Rvalue allocation_executor! = jil.use_rvalue(jil.UseRvalue (
                value: jil.copy_operand_value(jil.CopyOperand (
                    place: self.generated_constant_index_place(
                        continuation,
                        continuation_layout.executor_field_index,
                        self.store.types.tuple_type_item_at(
                            continuation_layout.type_id, continuation_layout.executor_field_index
                        )
                    )
                ))
            ));
            if (layout.effects.domain is .some(domain)) {
                allocation_executor = jil.domain_executor_rvalue(jil.DomainExecutorRvalue (
                    domain_def: domain.binding,
                    domain_kind: layout.domain_kind
                ));
            }
            statements.add(self.generated_assign(
                jil.local_place(allocation_executor_local, self.storage.empty_projection()),
                allocation_executor,
                span
            ));
            statements.add(self.generated_assign(
                frame_pointer,
                jil.coroutine_frame_alloc_rvalue(jil.CoroutineFrameAllocRvalue (
                    value_type: layout.frame_type_id,
                    executor: jil.copy_operand_value(jil.CopyOperand (
                        place: jil.local_place(
                            allocation_executor_local, self.storage.empty_projection()
                        )
                    ))
                )),
                span
            ));
            self.append_async_callable_frame_initializers(
                source,
                layout,
                result_type,
                consumes_env,
                frame,
                continuation_local,
                frame_pointer_local,
                erased_frame_local,
                consuming_env_pointer_local,
                completion_id,
                span,
                statements$.mut_ref()
            );
            list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(2);
            blocks.add(self.async_callable_start_call_block(
                source,
                layout,
                frame_pointer_local,
                erased_frame_local,
                statements$.ref(),
                span
            ));
            blocks.add(self.generated_return_block(1, span));
            return jil.Body (
                id: jil.BodyId.from_index(function_id.to_index()),
                span: span,
                locals: locals[0..local_count],
                blocks: self.storage.block_array(blocks$.ref()),
                entry: jil.BlockId.from_index(0),
                return_local: jil.LocalId.from_index(0)
            );
        }
    }

    public Void append_async_callable_frame_initializers(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        qid.TypeId result_type,
        Bool consumes_env,
        jil.Place frame,
        jil.LocalId continuation_local,
        jil.LocalId frame_pointer_local,
        jil.LocalId erased_frame_local,
        jil.LocalId consuming_env_pointer_local,
        jil.FunctionId completion_id,
        token.Span span,
        list.ArrayList<jil.Statement>&! statements
    ) {
        Int source_local_index! = 1;
        Int abi_param_index! = 0;
        while (source_local_index < source.body.locals.length) {
            jil.LocalDecl source_local = source.body.locals[source_local_index];
            if (source_local.kind == .param) {
                if (self.coroutine_frame_field_index(layout, source_local.id) is .some(field_index)) {
                    if (abi_param_index == 0
                        && consumes_env) {
                        self.append_consuming_async_env_initializers(
                            layout,
                            frame,
                            field_index,
                            consuming_env_pointer_local,
                            span,
                            statements
                        );
                    } else {
                        statements.add(self.generated_assign_operand(
                            self.generated_constant_index_place(
                                frame, field_index, layout.fields[field_index].type_id
                            ),
                            jil.copy_operand_value(jil.CopyOperand (
                                place: jil.local_place(
                                    jil.LocalId.from_index(abi_param_index + 1),
                                    self.storage.empty_projection()
                                )
                            )),
                            span
                        ));
                    }
                }
                abi_param_index = abi_param_index + 1;
            }
            source_local_index = source_local_index + 1;
        }
        statements.add(coroutine_task_abi.frame_state_initializer(self.storage, layout, frame, span));
        jil.Statement[]& domain = coroutine_task_abi.frame_domain_initializers(
            self.storage, layout, frame, span
        );
        Int index! = 0;
        while (index < domain.length) {
            statements.add(domain[index]);
            index = index + 1;
        }
        statements.add(coroutine_task_abi.cancellation_enabled_initializer(
            self.storage, layout, frame, 2, span
        ));
        jil.ExternalContinuationLayout continuation_layout =
            self.external_async_continuation_layout(result_type, span);
        jil.Place continuation = self.generated_deref_place(
            jil.local_place(continuation_local, self.storage.empty_projection()), true
        );
        statements.add(self.generated_assign_operand(
            self.generated_constant_index_place(
                frame,
                layout.cancellation_context_field_index,
                layout.fields[layout.cancellation_context_field_index].type_id
            ),
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    continuation,
                    continuation_layout.cancellation_context_field_index,
                    self.store.types.tuple_type_item_at(
                        continuation_layout.type_id,
                        continuation_layout.cancellation_context_field_index
                    )
                )
            )),
            span
        ));
        if (layout.effects.domain == null) {
            statements.add(self.generated_assign_operand(
                self.generated_constant_index_place(
                    frame,
                    layout.current_executor_field_index,
                    layout.fields[layout.current_executor_field_index].type_id
                ),
                jil.copy_operand_value(jil.CopyOperand (
                    place: self.generated_constant_index_place(
                        continuation,
                        continuation_layout.executor_field_index,
                        self.store.types.tuple_type_item_at(
                            continuation_layout.type_id,
                            continuation_layout.executor_field_index
                        )
                    )
                )),
                span
            ));
        }
        self.append_async_callable_continuation_initializers(
            layout,
            result_type,
            frame,
            continuation_local,
            frame_pointer_local,
            erased_frame_local,
            completion_id,
            span,
            statements
        );
    }

    Void append_consuming_async_env_initializers(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame,
        Int param_field_index,
        jil.LocalId env_pointer_local,
        token.Span span,
        list.ArrayList<jil.Statement>&! statements
    ) {
        jil.Place erased_env = jil.local_place(
            jil.LocalId.from_index(1), self.storage.empty_projection()
        );
        jil.Place env_pointer = jil.local_place(
            env_pointer_local, self.storage.empty_projection()
        );
        qid.TypeId env_type = layout.fields[layout.capture_env_field_index].type_id;
        qid.TypeId env_pointer_type = self.store.types.raw_pointer_type(env_type, span);
        statements.add(self.generated_pointer_cast_assign(
            env_pointer, erased_env, env_pointer_type, span
        ));
        jil.Place frame_env = self.generated_constant_index_place(
            frame,
            layout.capture_env_field_index,
            layout.fields[layout.capture_env_field_index].type_id
        );
        statements.add(self.generated_assign_operand(
            frame_env,
            jil.move_operand_value(jil.MoveOperand (
                place: self.generated_deref_place(env_pointer, true)
            )),
            span
        ));
        statements.add(self.generated_assign(
            jil.local_place(jil.LocalId.from_index(0), self.storage.empty_projection()),
            jil.free_rvalue(jil.FreeRvalue (
                pointer: jil.copy_operand_value(jil.CopyOperand (place: env_pointer))
            )),
            span
        ));
        statements.add(self.generated_assign(
            env_pointer,
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: frame_env,
                frame_root: true
            )),
            span
        ));
        statements.add(self.generated_pointer_cast_assign(
            self.generated_constant_index_place(
                frame, param_field_index, layout.fields[param_field_index].type_id
            ),
            env_pointer,
            layout.fields[param_field_index].type_id,
            span
        ));
    }

    public Void append_async_callable_continuation_initializers(
        self,
        jil.CoroutineFrameLayout& layout,
        qid.TypeId result_type,
        jil.Place frame,
        jil.LocalId continuation_local,
        jil.LocalId frame_pointer_local,
        jil.LocalId erased_frame_local,
        jil.FunctionId completion_id,
        token.Span span,
        list.ArrayList<jil.Statement>&! statements
    ) {
        jil.Function completion = self.program.function(completion_id);
        jil.ExternalContinuationLayout continuation_layout =
            self.external_async_continuation_layout(result_type, span);
        jil.Place continuation = self.generated_deref_place(
            jil.local_place(continuation_local, self.storage.empty_projection()), true
        );
        statements.add(self.generated_assign_operand(
            self.generated_constant_index_place(
                frame,
                layout.continuation_result_field_index,
                layout.fields[layout.continuation_result_field_index].type_id
            ),
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    continuation,
                    continuation_layout.result_field_index,
                    self.store.types.tuple_type_item_at(
                        continuation_layout.type_id, continuation_layout.result_field_index
                    )
                )
            )),
            span
        ));
        statements.add(self.generated_pointer_cast_assign(
            self.generated_constant_index_place(
                frame,
                layout.external_continuation_field_index,
                layout.fields[layout.external_continuation_field_index].type_id
            ),
            jil.local_place(continuation_local, self.storage.empty_projection()),
            layout.fields[layout.external_continuation_field_index].type_id,
            span
        ));
        statements.add(self.generated_pointer_cast_assign(
            jil.local_place(erased_frame_local, self.storage.empty_projection()),
            jil.local_place(frame_pointer_local, self.storage.empty_projection()),
            self.store.types.opaque_pointer_type(span),
            span
        ));
        statements.add(self.generated_pointer_cast_assign(
            self.generated_constant_index_place(
                frame,
                layout.continuation_context_field_index,
                layout.fields[layout.continuation_context_field_index].type_id
            ),
            jil.local_place(frame_pointer_local, self.storage.empty_projection()),
            layout.fields[layout.continuation_context_field_index].type_id,
            span
        ));
        statements.add(coroutine_task_abi.continuation_function_initializer(
            self.storage,
            layout,
            frame,
            jil.FunctionRef (
                target: .generated(self.program.generated_function_target(completion_id)),
                args: self.storage.generic_arg_array(completion.args),
                type_id: layout.fields[layout.continuation_function_field_index].type_id
            ),
            span
        ));
        statements.add(coroutine_task_abi.continuation_executor_null_initializer(
            self.storage, layout, frame, span
        ));
    }

    @life(return: self & source.a & source.b & layout)
    public jil.Block async_callable_start_call_block(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.LocalId frame_pointer_local,
        jil.LocalId erased_frame_local,
        list.ArrayList<jil.Statement>& statements,
        token.Span span
    ) {
        jil.FunctionRef resume = jil.FunctionRef (
            target: .source(jil.function_provenance_def(source.origin)),
            args: self.storage.generic_arg_array(source.args),
            variant: .coroutine_resume(.standard),
            type_id: layout.task_abi.resume_function_type_id
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: jil.local_place(erased_frame_local, self.storage.empty_projection())
        )));
        jil.Place frame = self.generated_deref_place(
            jil.local_place(frame_pointer_local, self.storage.empty_projection()), true
        );
        jil.Operand task = jil.copy_operand_value(jil.CopyOperand (
            place: self.generated_constant_index_place(
                frame,
                layout.cancellation_context_field_index,
                layout.fields[layout.cancellation_context_field_index].type_id
            )
        ));
        jil.CallCallee callee! = jil.dynamic_task_enqueue_callee(
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    frame,
                    layout.current_executor_field_index,
                    layout.fields[layout.current_executor_field_index].type_id
                )
            )),
            task,
            jil.function_operand_value(resume),
            true
        );
        if (layout.effects.domain is .some(domain)) {
            callee = jil.domain_task_enqueue_callee(
                domain.binding,
                layout.domain_kind,
                task,
                jil.function_operand_value(resume),
                true
            );
        }
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.storage.statement_array(statements),
            terminator: jil.Terminator (
                span: span,
                kind: jil.call_terminator_kind(jil.CallTerminator (
                    callee: callee,
                    args: self.storage.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    task_handoff: true,
                    destination: jil.local_place(jil.LocalId.from_index(0), self.storage.empty_projection()),
                    target: jil.BlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.storage.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    public Void add_async_callable_completion_function(
        Self&! self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId id
    ) {
        jil.Function reserved = self.program.function(id);
        guard jil.function_generated_origin(reserved.origin) is .some(origin) else { return; }
        self.program.finish_generated_function(jil.Function (
            id: id,
            origin: .generated(origin),
            args: self.storage.generic_arg_array(reserved.args),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: source.span,
            body: self.async_callable_completion_body(source, layout, id)
        ));
        self.program.mark_borrow_check_exempt(id);
    }

    public jil.Body async_callable_completion_body(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId function_id
    ) {
        unsafe {
            token.Span span = source.span;
            generic_bindings.GenericBindings bindings =
                self.async_callable_bindings(source);
            instance_reader.InstanceReader reader =
                instance_reader.InstanceReader(self.store, bindings$.ref());
            qid.TypeId result_type = reader.type_id(
                source.body.locals[source.body.return_local.to_index()].type_id
            );
            jil.ExternalContinuationLayout continuation_layout =
                self.external_async_continuation_layout(result_type, span);
            jil.LocalId return_local = jil.LocalId.from_index(0);
            jil.LocalId context_local = jil.LocalId.from_index(1);
            jil.LocalId frame_pointer_local = jil.LocalId.from_index(2);
            jil.LocalId continuation_local = jil.LocalId.from_index(3);
            jil.LocalId allocation_executor_local = jil.LocalId.from_index(4);
            jil.LocalDecl*! locals = self.storage.alloc_local_array(5);
            locals[0] = self.generated_local(
                return_local, .return_place, self.store.types.unit_type(), span
            );
            locals[1] = self.generated_local(
                context_local,
                .param,
                layout.fields[layout.continuation_context_field_index].type_id,
                span
            );
            locals[2] = self.generated_local(
                frame_pointer_local, .compiler_temp, layout.task_abi.frame_pointer_type_id, span
            );
            locals[3] = self.generated_local(
                continuation_local, .compiler_temp, continuation_layout.pointer_type_id, span
            );
            locals[4] = self.generated_local(
                allocation_executor_local,
                .compiler_temp,
                self.store.types.opaque_pointer_type(span),
                span
            );
            jil.Place frame_pointer = jil.local_place(frame_pointer_local, self.storage.empty_projection());
            jil.Place frame = self.generated_deref_place(frame_pointer, true);
            list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(4);
            statements.add(self.generated_pointer_cast_assign(
                frame_pointer,
                jil.local_place(context_local, self.storage.empty_projection()),
                layout.task_abi.frame_pointer_type_id,
                span
            ));
            statements.add(self.generated_pointer_cast_assign(
                jil.local_place(continuation_local, self.storage.empty_projection()),
                self.generated_constant_index_place(
                    frame,
                    layout.external_continuation_field_index,
                    layout.fields[layout.external_continuation_field_index].type_id
                ),
                continuation_layout.pointer_type_id,
                span
            ));
            statements.add(self.generated_assign_operand(
                jil.local_place(allocation_executor_local, self.storage.empty_projection()),
                jil.copy_operand_value(jil.CopyOperand (
                    place: self.generated_constant_index_place(
                        frame,
                        layout.current_executor_field_index,
                        layout.fields[layout.current_executor_field_index].type_id
                    )
                )),
                span
            ));
            statements.add(self.generated_assign(
                jil.local_place(return_local, self.storage.empty_projection()),
                jil.coroutine_frame_free_rvalue(jil.CoroutineFrameFreeRvalue (
                    pointer: jil.copy_operand_value(jil.CopyOperand (place: frame_pointer)),
                    executor: jil.copy_operand_value(jil.CopyOperand (
                        place: jil.local_place(
                            allocation_executor_local, self.storage.empty_projection()
                        )
                    ))
                )),
                span
            ));
            list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(2);
            blocks.add(self.async_callable_completion_call_block(
                continuation_layout, continuation_local, statements$.ref(), span
            ));
            blocks.add(self.generated_return_block(1, span));
            return jil.Body (
                id: jil.BodyId.from_index(function_id.to_index()),
                span: span,
                locals: locals[0..5],
                blocks: self.storage.block_array(blocks$.ref()),
                entry: jil.BlockId.from_index(0),
                return_local: return_local
            );
        }
    }

    public jil.Block async_callable_completion_call_block(
        self,
        jil.ExternalContinuationLayout layout,
        jil.LocalId continuation_local,
        list.ArrayList<jil.Statement>& statements,
        token.Span span
    ) {
        jil.Place continuation = self.generated_deref_place(
            jil.local_place(continuation_local, self.storage.empty_projection()), true
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: self.generated_constant_index_place(
                continuation,
                layout.target_context_field_index,
                self.store.types.tuple_type_item_at(
                    layout.type_id, layout.target_context_field_index
                )
            )
        )));
        // completion shim 正在当前 Task 的 Job 上运行；恢复调用方是执行权转移，
        // 必须直接 handoff，不能经 scheduled-continuation wrapper 退化成普通 request。
        jil.CallCallee callee = jil.dynamic_task_enqueue_callee(
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    continuation,
                    layout.executor_field_index,
                    self.store.types.tuple_type_item_at(layout.type_id, layout.executor_field_index)
                )
            )),
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    continuation,
                    layout.cancellation_context_field_index,
                    self.store.types.tuple_type_item_at(
                        layout.type_id, layout.cancellation_context_field_index
                    )
                )
            )),
            jil.copy_operand_value(jil.CopyOperand (
                place: self.generated_constant_index_place(
                    continuation,
                    layout.target_resume_field_index,
                    self.store.types.tuple_type_item_at(
                        layout.type_id, layout.target_resume_field_index
                    )
                )
            )),
            true
        );
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.storage.statement_array(statements),
            terminator: jil.Terminator (
                span: span,
                kind: jil.call_terminator_kind(jil.CallTerminator (
                    callee: callee,
                    args: self.storage.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    destination: jil.local_place(jil.LocalId.from_index(0), self.storage.empty_projection()),
                    target: jil.BlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.storage.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    public Void add_async_callable_sync_function(
        Self&! self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId id
    ) {
        jil.Function reserved = self.program.function(id);
        guard jil.function_generated_origin(reserved.origin) is .some(origin) else { return; }
        self.program.finish_generated_function(jil.Function (
            id: id,
            origin: .generated(origin),
            args: self.storage.generic_arg_array(reserved.args),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: source.span,
            body: self.async_callable_sync_body(source, layout, id)
        ));
    }

    @life(return: self & source.a & source.b & layout)
    public jil.Body async_callable_sync_body(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.FunctionId function_id
    ) {
        generic_bindings.GenericBindings bindings =
            self.async_callable_bindings(source);
        instance_reader.InstanceReader reader =
            instance_reader.InstanceReader(self.store, bindings$.ref());
        token.Span span = source.span;
        Int param_count = self.async_sync_param_count(source);
        list.ArrayList<jil.LocalDecl> locals = self.async_sync_locals(
            source, reader$.ref(), layout, span
        );
        jil.Place task = self.async_sync_local(param_count, 1);
        jil.Place frame = self.async_sync_local(param_count, 2);
        list.ArrayList<jil.Statement> start! = list.ArrayList<jil.Statement>();
        self.append_async_sync_param_initializers(
            source, layout, frame, span, start$.mut_ref()
        );
        jil.FunctionRef resume = self.runtime_coroutine_function_ref(
            source, layout, true, span
        );
        jil.FunctionRef completion = self.runtime_coroutine_function_ref(
            source, layout, false, span
        );
        jil.Statement[]& initializers = coroutine_task_abi.initializers(
            self.storage,
            layout,
            task,
            frame,
            resume,
            completion,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            start.add(initializers[index]);
            index = index + 1;
        }
        self.append_async_sync_runtime_executor_initializer(
            source, layout, task, frame, param_count, span, start$.mut_ref()
        );
        start.add(self.async_sync_task_pointer_initializer(layout, task, param_count, span));
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(6);
        blocks.add(self.async_sync_start_block(
            layout, task, resume, param_count, start$.ref(), span
        ));
        blocks.add(self.async_sync_check_block(layout, task, param_count, span));
        blocks.add(self.async_sync_register_block(layout, task, param_count, span));
        blocks.add(self.async_sync_wait_block(layout, task, param_count, span));
        blocks.add(self.async_sync_ack_check_block(param_count, span));
        blocks.add(self.async_sync_return_block(layout, task, span));
        return jil.Body (
            id: jil.BodyId.from_index(function_id.to_index()),
            span: span,
            locals: self.freeze_async_sync_locals(locals$.ref()),
            blocks: self.storage.block_array(blocks$.ref()),
            entry: jil.BlockId.from_index(0),
            return_local: jil.LocalId.from_index(0)
        );
    }

    list.ArrayList<jil.LocalDecl> async_sync_locals(
        self,
        jil.Function source,
        instance_reader.InstanceReader& reader,
        jil.CoroutineFrameLayout& layout,
        token.Span span
    ) {
        Int source_param_count = self.async_callable_param_count(source);
        Int param_count = self.async_sync_param_count(source);
        qid.TypeId result_type = reader.type_id(
            source.body.locals[source.body.return_local.to_index()].type_id
        );
        list.ArrayList<jil.LocalDecl> locals! =
            list.ArrayList<jil.LocalDecl>(param_count + 11);
        locals.add(self.generated_local(
            jil.LocalId.from_index(0), .return_place, result_type, span
        ));
        Int source_index! = 0;
        Int param_index! = 0;
        while (source_index < source.body.locals.length) {
            jil.LocalDecl source_local = source.body.locals[source_index];
            source_index = source_index + 1;
            if (source_local.kind != .param) { continue; }
            param_index = param_index + 1;
            locals.add(self.generated_local(
                jil.LocalId.from_index(param_index),
                .param,
                reader.type_id(source_local.type_id),
                span
            ));
        }
        if (param_count != source_param_count) {
            locals.add(self.generated_local(
                jil.LocalId.from_index(param_count),
                .param,
                self.store.types.opaque_pointer_type(span),
                span
            ));
        }
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 1), .compiler_temp, layout.task_abi.task_type_id, span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 2), .compiler_temp, layout.frame_type_id, span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 3), .compiler_temp,
            layout.task_abi.resume_return_type_id, span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 4), .compiler_temp,
            self.store.types.int_type(), span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 5), .compiler_temp,
            self.store.types.int_type(), span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 6), .compiler_temp,
            layout.task_abi.blocking_ack_pointer_type_id, span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 7), .compiler_temp,
            self.store.types.int_type(), span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 8), .compiler_temp,
            self.store.types.int_type(), span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 9), .compiler_temp,
            self.store.types.bool_type(), span
        ));
        locals.add(self.generated_local(
            jil.LocalId.from_index(param_count + 10), .compiler_temp,
            layout.task_abi.task_state_pointer_type_id, span
        ));
        return locals;
    }

    Int async_sync_param_count(self, jil.Function source) {
        Int count = self.async_callable_param_count(source);
        if (source.effects.domain == null) { return count + 1; }
        return count;
    }

    Void append_async_sync_runtime_executor_initializer(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        jil.Place frame,
        Int param_count,
        token.Span span,
        list.ArrayList<jil.Statement>&! statements
    ) {
        if (source.effects.domain != null) { return; }
        jil.Operand executor = jil.copy_operand_value(jil.CopyOperand(
            place: jil.local_place(
                jil.LocalId.from_index(param_count),
                self.storage.empty_projection()
            )
        ));
        statements.add(self.generated_assign_operand(
            self.generated_constant_index_place(
                frame,
                layout.current_executor_field_index,
                layout.fields[layout.current_executor_field_index].type_id
            ),
            executor,
            span
        ));
        statements.add(self.generated_assign_operand(
            coroutine_task_abi.task_field_place(
                self.storage,
                layout.task_abi.task_state_type_id,
                task,
                layout.task_abi.execution_executor_field
            ),
            executor,
            span
        ));
    }

    Void append_async_sync_param_initializers(
        self,
        jil.Function source,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame,
        token.Span span,
        list.ArrayList<jil.Statement>&! statements
    ) {
        Int source_index! = 1;
        Int param_index! = 0;
        while (source_index < source.body.locals.length) {
            jil.LocalDecl source_local = source.body.locals[source_index];
            if (source_local.kind == .param) {
                Int wrapper_param_index = param_index;
                param_index = param_index + 1;
                if (self.coroutine_frame_field_index(layout, source_local.id)
                    is .some(field_index)) {
                    statements.add(self.generated_assign_operand(
                        self.generated_constant_index_place(
                            frame, field_index, layout.fields[field_index].type_id
                        ),
                        jil.move_operand_value(jil.MoveOperand (
                            place: jil.local_place(
                                jil.LocalId.from_index(wrapper_param_index + 1),
                                self.storage.empty_projection()
                            )
                        )),
                        span
                    ));
                }
            }
            source_index = source_index + 1;
        }
    }

    jil.Statement async_sync_task_pointer_initializer(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        Int param_count,
