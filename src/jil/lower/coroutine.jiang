        token.Span span
    ) {
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
        statements.add(jil.Statement (
            span: span,
            kind: jil.task_wait_statement_kind(jil.TaskWaitStatement (
                state: coroutine_task_abi.task_field_place(
                    self.storage, task, layout.task_abi.state_field
                ),
                wake: false,
                expected: jil.copy_operand_value(jil.CopyOperand (
                    place: self.async_sync_local(param_count, 8)
                ))
            ))
        ));
        return jil.Block (
            id: jil.BlockId.from_index(3),
