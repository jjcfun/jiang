        ));
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase(value: self.async_sync_int_const(1, span), target: jil.BlockId.from_index(1)));
        return jil.Block (
            id: jil.BlockId.from_index(4),
            span: span,
            statements: self.storage.statement_array(statements$.ref()),
