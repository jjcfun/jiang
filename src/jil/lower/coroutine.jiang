                kind: jil.return_terminator_kind(jil.ReturnTerminator(implicit_unit: false))
            )
        );
    }

    jil.Place async_sync_local(self, Int param_count, Int offset) {
        return jil.local_place(
            jil.LocalId.from_index(param_count + offset),
            self.storage.empty_projection()
        );
    }

    @life(return: self.b)
    jil.LocalDecl[]& freeze_async_sync_locals(
        self,
        list.ArrayList<jil.LocalDecl>& locals
    ) {
        unsafe {
            jil.LocalDecl*! stored = self.storage.alloc_local_array(locals.len());
            Int index! = 0;
            while (index < locals.len()) {
                stored[index] = locals.get(index);
                index = index + 1;
            }
            return stored[0..locals.len()];
        }
    }

    jil.Const async_sync_int_const(self, Int value, token.Span span) {
        return jil.Const (
            type_id: self.store.types.int_type(),
            span: span,
            value: jil.int_const_kind(jil.IntConst (
                bits: UInt64(value),
                signed_value: true
            ))
        );
    }

    public jil.LocalDecl generated_local(
        self,
        jil.LocalId id,
        jil.LocalKind kind,
        qid.TypeId type_id,
        token.Span span
    ) {
        return jil.LocalDecl (
            id: id,
            kind: kind,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false
        );
    }

    @life(return: destination & value)
    public jil.Statement generated_assign(
        self,
        jil.Place destination,
        jil.Rvalue value,
        token.Span span
    ) {
        return jil.Statement (
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement (
                destination: destination,
                value: value
            ))
        );
    }

    @life(return: self & destination & value)
    public jil.Statement generated_assign_operand(
        self,
        jil.Place destination,
        jil.Operand value,
        token.Span span
    ) {
        return self.generated_assign(
            destination,
            jil.use_rvalue(jil.UseRvalue (value: value)),
            span
        );
    }

    @life(return: self & destination & source)
    public jil.Statement generated_pointer_cast_assign(
        self,
        jil.Place destination,
        jil.Place source,
        qid.TypeId target_type,
        token.Span span
    ) {
        return self.generated_assign(
            destination,
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_ptr,
                value: jil.copy_operand_value(jil.CopyOperand (place: source)),
                target_type: target_type
            )),
            span
        );
    }

    public jil.Place generated_deref_place(self, jil.Place base, Bool raw_pointer) {
        list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            projection.add(base.projection[index]);
            index = index + 1;
        }
        projection.add(jil.deref_projection_elem(jil.DerefProjection (raw_pointer: raw_pointer)));
        return jil.local_place(base.local_id, self.storage.projection_array(projection$.ref()));
    }

    public jil.Place generated_constant_index_place(self, jil.Place base, Int field_index) {
        list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(base.projection.length + 1);
        Int index! = 0;
        while (index < base.projection.length) {
            projection.add(base.projection[index]);
            index = index + 1;
        }
        projection.add(jil.constant_index_projection_elem(jil.ConstantIndexProjection (offset: field_index)));
        return jil.local_place(base.local_id, self.storage.projection_array(projection$.ref()));
    }

    public Int? coroutine_frame_field_index(self, jil.CoroutineFrameLayout& layout, jil.LocalId local_id) {
        Int index! = 0;
        while (index < layout.local_mappings.length) {
            if (layout.local_mappings[index].local_id == local_id) {
                return layout.local_mappings[index].field_index;
            }
            index = index + 1;
        }
        return null;
    }

    public jil.Block generated_return_block(self, Int index, token.Span span) {
        return jil.Block (
            id: jil.BlockId.from_index(index),
            span: span,
            statements: self.storage.empty_statements(),
            terminator: jil.Terminator (
                span: span,
                kind: jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: true))
            )
        );
    }

    public jil.CoroutineFrameLayout? coroutine_frame_layout_for_body(
        self,
        jil.Body body,
        types.EffectSet effects,
        jil.TaskStateLayout task_state,
        jil.BlockId cancellation_entry,
        qid.TypeId? capture_env_type
    ) {
        if (!effects.has_async) { return null; }
        guard coroutine_frame_layout.build_frame_layout(
            self.storage,
            self.store.types$.ref(),
            body,
            effects,
            self.store.types.int_type(),
            task_state$.ref(),
            cancellation_entry,
            capture_env_type
        ) is .some(layout) else {
            return null;
        }
        jil.CoroutineFrameLayout result! = layout;
        if (effects.domain is .some(domain)) {
            result = jil.coroutine_frame_with_runtime_properties(
                result, self.domain_kind_for_type(domain.domain_type), result.may_defer
            );
        }
        return result;
    }

    public jil.TaskStateLayout create_task_state_layout(
        Self&! self,
        qid.TypeId result_type,
        token.Span span
    ) {
        if (self.task_state_layouts.get(result_type.to_index()) is .some(layout)) {
            return layout$.get();
        }
        qid.TypeId state_type = self.store.types.task_state_type(result_type, span);
        jil.TaskStateLayout result = jil.TaskStateLayout (
            type_id: state_type,
            schedule_state: self.task_state_field(state_type, 0),
            schedule_executor: self.task_state_field(state_type, 1),
            schedule_context: self.task_state_field(state_type, 2),
            schedule_resume: self.task_state_field(state_type, 3),
            schedule_active_executor: self.task_state_field(state_type, 4),
            state: self.task_state_field(state_type, 5),
            frame: self.task_state_field(state_type, 6),
            resume_function: self.task_state_field(state_type, 7),
            execution_executor: self.task_state_field(state_type, 8),
            cancellation_requested: self.task_state_field(state_type, 9),
            cancel_target_word: self.task_state_field(state_type, 10),
            lifetime_state: self.task_state_field(state_type, 11),
            cleanup_function: self.task_state_field(state_type, 12),
            executor_job_group: self.task_state_field(state_type, 13),
            executor_job_context: self.task_state_field(state_type, 14),
            executor_job_callback: self.task_state_field(state_type, 15),
            executor_job_executor: self.task_state_field(state_type, 16),
            executor_job_next: self.task_state_field(state_type, 17),
            executor_job_storage_kind: self.task_state_field(state_type, 18),
            result: self.task_state_field(state_type, 19)
        );
        self.task_state_layouts.set(result_type.to_index(), result);
        return result;
    }

    public jil.AggregateField task_state_field(self, qid.TypeId state_type, Int index) {
        types.TypeInfo info = self.store.types.get(state_type);
        guard info.data is .task_state_type(state) else {
            return jil.AggregateField(
                type_id: self.store.types.invalid_type(), index: index
            );
        }
        return jil.AggregateField(type_id: state.field_types[index], index: index);
    }

    public Int domain_kind_for_def(self, qid.DefId domain_def) {
        guard self.store.resolve.core_traits.domain_trait is .some(domain_trait) else { return -1; }
        guard self.store.symbols.find("kind") is .some(kind_symbol) else { return -1; }
        guard self.model.def(domain_trait) is .some(domain_model) else { return -1; }
        Int index! = 0;
        while (index < domain_model.members.len()) {
            qid.DefId kind_assoc = domain_model.members.get(index);
            index = index + 1;
            if (self.store.defs.get(kind_assoc).name.symbol.to_index() != kind_symbol.to_index()) { continue; }
            return self.domain_kind_for_member(domain_def, kind_assoc);
        }
        return -1;
    }

    public Int domain_kind_for_type(self, qid.TypeId domain_type) {
        types.TypeInfo info = self.store.types.get(domain_type);
        guard info.data is .named(named) else { return -1; }
        return self.domain_kind_for_def(named.def_id);
    }

    public Int domain_kind_for_member(self, qid.DefId domain_def, qid.DefId kind_assoc) {
        guard self.model.def(domain_def) is .some(domain_model) else { return -1; }
        Int index! = 0;
        while (index < domain_model.members.len()) {
            qid.DefId member_def = domain_model.members.get(index);
            index = index + 1;
            def.DefRecord record = self.store.defs.get(member_def);
            guard record.associated_trait_member is .some(trait_member) else { continue; }
            if (trait_member != kind_assoc) { continue; }
            guard self.store.comptime_store.const_value(member_def) is .some(value) else { return -1; }
            guard value.data is .enum_case_value(case_def) else { return -1; }
            if (self.typeck.enum_case_value(case_def) is .some(kind)) { return kind; }
            return -1;
        }
        return -1;
    }

}
