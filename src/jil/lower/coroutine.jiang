    @life(return: self)
    jil.Block async_sync_return_block(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        token.Span span
    ) {
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
        statements.add(self.generated_assign_operand(
            jil.local_place(jil.LocalId.from_index(0), self.storage.empty_projection()),
            jil.move_operand_value(jil.MoveOperand (place: coroutine_task_abi.task_field_place(
                self.storage, task, layout.task_abi.result_field
            ))),
            span
        ));
        return jil.Block (
