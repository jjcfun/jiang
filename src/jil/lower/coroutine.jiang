            statements: self.storage.statement_array(statements$.ref()),
            terminator: jil.Terminator (
                span: span,
                kind: jil.goto_terminator_kind(jil.GotoTerminator (
                    target: jil.BlockId.from_index(4)
                ))
            )
        );
    }

    @life(return: self)
    jil.Block async_sync_ack_check_block(
        self,
