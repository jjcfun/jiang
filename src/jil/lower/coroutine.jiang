    ) {
        return self.generated_assign(
            self.async_sync_local(param_count, 10),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: coroutine_task_abi.task_state_storage_place(
                    self.storage, layout.task_abi.task_state_type_id, task
                ),
                frame_root: false
            )),
            span
        );
    }

    @life(return: self & resume.a & statements)
    jil.Block async_sync_start_block(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        jil.FunctionRef resume,
        Int param_count,
        list.ArrayList<jil.Statement>& statements,
        token.Span span
    ) {
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: coroutine_task_abi.task_field_place(
                self.storage, layout.task_abi.task_state_type_id, task,
                layout.task_abi.frame_field
            )
        )));
        jil.CallCallee callee = jil.dynamic_task_enqueue_callee(
            jil.copy_operand_value(jil.CopyOperand (place: coroutine_task_abi.task_field_place(
                self.storage, layout.task_abi.task_state_type_id, task,
                layout.task_abi.execution_executor_field
            ))),
            jil.copy_operand_value(jil.CopyOperand (
                place: self.async_sync_local(param_count, 10)
            )),
            jil.copy_operand_value(jil.CopyOperand (place: coroutine_task_abi.task_field_place(
                self.storage, layout.task_abi.task_state_type_id, task,
                layout.task_abi.resume_function_field
            ))),
            false
        );
        return jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.storage.statement_array(statements),
            terminator: jil.Terminator (
                span: span,
                kind: jil.call_terminator_kind(jil.CallTerminator (
                    callee: callee,
                    args: self.storage.operand_array(args$.ref()),
                    current_effects: types.EffectSet(),
                    is_suspend_point: false,
                    suspend_child: resume,
                    async_start: jil.AsyncStartKind.observed_task,
                    destination: self.async_sync_local(param_count, 3),
                    target: jil.BlockId.from_index(1),
                    initialized_place: null,
                    exclusive_places: self.storage.empty_places(),
                    cleanup: null
                ))
            )
        );
    }

    @life(return: self)
    jil.Block async_sync_check_block(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        Int param_count,
        token.Span span
    ) {
        jil.Place state = coroutine_task_abi.task_field_place(
            self.storage, layout.task_abi.task_state_type_id, task, layout.task_abi.state_field
        );
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(1);
        statements.add(self.generated_assign(
            self.async_sync_local(param_count, 4),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: state,
                mode: .coroutine_atomic
            )),
            span
        ));
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(2);
        cases.add(jil.SwitchCase(value: self.async_sync_int_const(1, span), target: jil.BlockId.from_index(5)));
        cases.add(jil.SwitchCase(value: self.async_sync_int_const(3, span), target: jil.BlockId.from_index(5)));
        return jil.Block (
            id: jil.BlockId.from_index(1),
            span: span,
            statements: self.storage.statement_array(statements$.ref()),
            terminator: jil.Terminator (
                span: span,
                kind: jil.switch_terminator_kind(jil.SwitchTerminator (
                    discriminator: jil.copy_operand_value(jil.CopyOperand (
                        place: self.async_sync_local(param_count, 4)
                    )),
                    cases: self.storage.switch_case_array(cases$.ref()),
                    default_target: jil.BlockId.from_index(2)
                ))
            )
        );
    }

    @life(return: self)
    jil.Block async_sync_register_block(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        Int param_count,
        token.Span span
    ) {
        jil.Place acknowledged = self.async_sync_local(param_count, 5);
        jil.Place ack_pointer = self.async_sync_local(param_count, 6);
        jil.Place ack_word = self.async_sync_local(param_count, 7);
        jil.Place tagged_word = self.async_sync_local(param_count, 8);
        jil.Place registered = self.async_sync_local(param_count, 9);
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(5);
        statements.add(self.generated_assign_operand(
            acknowledged, jil.const_operand_value(self.async_sync_int_const(0, span)), span
        ));
        statements.add(self.generated_assign(
            ack_pointer,
            jil.address_of_rvalue(jil.AddressOfRvalue(mutable_pointer: true, place: acknowledged)),
            span
        ));
        statements.add(self.generated_assign(
            ack_word,
            jil.cast_rvalue(jil.CastRvalue (
                kind: .ptr_to_int,
                value: jil.copy_operand_value(jil.CopyOperand(place: ack_pointer)),
                target_type: self.store.types.int_type()
            )),
            span
        ));
        statements.add(self.generated_assign(
            tagged_word,
            jil.binary_rvalue(jil.BinaryRvalue (
                op: .bit_or,
                lhs: jil.copy_operand_value(jil.CopyOperand(place: ack_word)),
                rhs: jil.const_operand_value(self.async_sync_int_const(1, span))
            )),
            span
        ));
        statements.add(self.generated_assign(
            registered,
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_field_place(
                    self.storage, layout.task_abi.task_state_type_id, task,
                    layout.task_abi.state_field
                ),
                expected: jil.const_operand_value(self.async_sync_int_const(0, span)),
                desired: jil.copy_operand_value(jil.CopyOperand(place: tagged_word)),
                mode: .coroutine_atomic
            )),
            span
        ));
        return jil.Block (
            id: jil.BlockId.from_index(2),
            span: span,
            statements: self.storage.statement_array(statements$.ref()),
            terminator: jil.Terminator (
                span: span,
                kind: jil.branch_terminator_kind(jil.BranchTerminator (
                    condition: jil.copy_operand_value(jil.CopyOperand(place: registered)),
                    then_target: jil.BlockId.from_index(3),
                    else_target: jil.BlockId.from_index(1)
                ))
            )
        );
    }

    @life(return: self)
