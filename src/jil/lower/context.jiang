// JIL package lowering 的共享可变上下文。
//
// Context 保存 package 调度、函数实例和 generated function 所需状态；
// 单个函数体的状态由 body 模块独立维护。

import compiler_store = "../../store.jiang";
import database = "../../db.jiang";
import diagnostic = "../../diagnostic.jiang";
import sem_store = "../../sema/model/store.jiang";
import qid = "../../id.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import monomorph = "../../sema/monomorph.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import system_target = "../../system/target.jiang";
import jil = "../model.jiang";
import coroutine_plan = "../coroutine/plan.jiang";
import * = "./model.jiang";

@region(a, b, c, d, e)
public struct Context: Movable {
    @life(a)
    public compiler_store.CompilerStore& store;
    @life(a)
    public database.QueryEngine&! query;
    public system_target.BuildOutputKind output_kind;
    @life(a)
    public sem_store.Store& model;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public monomorph.MonomorphStore& instances;
    @life(a)
    public module_graph.ModuleGraph& graph;
    public qid.SymbolId closure_env_symbol;
    @life(b)
    public jil.Storage& storage;
    @life(c)
    public jil.Program&! program;
    @life(d)
    public jil.DropElaborationState&! drop_elaboration;
    @life(e)
    public diagnostic.DiagnosticStore&! diagnostics;
    public map.WyHashMap<TraitVTableGlobalKey, jil.GlobalId> trait_vtable_globals!;
    public map.WyHashMap<Int, jil.GlobalId> receiver_type_globals!;
    public map.WyHashMap<Int, jil.FunctionId> receiver_drop_shims!;
    public map.WyHashMap<Int, jil.FunctionId> raw_fn_to_fn_shims!;
    public map.WyHashMap<Int, jil.GlobalId> raw_fn_vtable_globals!;
    public map.WyHashMap<LambdaVTableGlobalKey, jil.GlobalId> lambda_vtable_globals!;
    public map.WyHashMap<Int, qid.TypeId> lambda_env_types!;
    public map.WyHashMap<Int, jil.FunctionId> lambda_env_drop_shims!;
    public map.WyHashMap<Int, jil.FunctionId> async_callable_start_shims!;
    public map.WyHashMap<Int, jil.FunctionId> async_callable_completion_shims!;
    public map.WyHashMap<Int, jil.FunctionId> serial_completion_shims!;
    public coroutine_plan.Store coroutine_plans!;
    public list.ArrayList<Bool> rtc_eligible!;
    public map.WyHashMap<Int, jil.FunctionId> cancel_handler_shims!;
    public map.WyHashMap<Int, jil.FunctionId> async_lambda_env_drop_shims!;
    public map.WyHashMap<Int, jil.TaskStateLayout> task_state_layouts!;
    public map.WyHashMap<Int, jil.FunctionId> task_cleanup_shims!;
    public jil.FunctionId? closure_noop_drop_shim!;

    public init(self,
        compiler_store.CompilerStore& store,
        database.QueryEngine&! query,
        system_target.BuildOutputKind output_kind,
        sem_store.Store& model,
        typeck_store.TypeCheckStore& typeck,
        monomorph.MonomorphStore& instances,
        module_graph.ModuleGraph& graph,
        qid.SymbolId closure_env_symbol,
        jil.Storage& storage,
        jil.Program&! program,
        jil.DropElaborationState&! drop_elaboration,
        diagnostic.DiagnosticStore&! diagnostics
    ) {
        self.store = store;
        self.query = query;
        self.output_kind = output_kind;
        self.model = model;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.closure_env_symbol = closure_env_symbol;
        self.storage = storage;
        self.program = program;
        self.drop_elaboration = drop_elaboration;
        self.diagnostics = diagnostics;
        self.trait_vtable_globals = map.WyHashMap<TraitVTableGlobalKey, jil.GlobalId>();
        self.receiver_type_globals = map.WyHashMap<Int, jil.GlobalId>();
        self.receiver_drop_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.raw_fn_to_fn_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.raw_fn_vtable_globals = map.WyHashMap<Int, jil.GlobalId>();
        self.lambda_vtable_globals = map.WyHashMap<LambdaVTableGlobalKey, jil.GlobalId>();
        self.lambda_env_types = map.WyHashMap<Int, qid.TypeId>();
        self.lambda_env_drop_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.async_callable_start_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.async_callable_completion_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.serial_completion_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.coroutine_plans = coroutine_plan.Store();
        self.rtc_eligible = list.ArrayList<Bool>();
        self.cancel_handler_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.async_lambda_env_drop_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.task_state_layouts = map.WyHashMap<Int, jil.TaskStateLayout>();
        self.task_cleanup_shims = map.WyHashMap<Int, jil.FunctionId>();
        self.closure_noop_drop_shim = null;
    }

}
