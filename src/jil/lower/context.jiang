// JIL package lowering 的共享可变上下文。
//
// Context 保存 package 调度、函数实例和 generated function 所需状态；
// 单个函数体的状态由 body 模块独立维护。

import context = "../../context.jiang";
import sem_store = "../../sema/model/store.jiang";
import qid = "../../id.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import monomorph = "../../sema/monomorph.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import jil = "../model.jiang";
import coroutine_plan = "../coroutine/plan.jiang";
import * = "./model.jiang";

@region(a)
public struct Context: Movable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(a)
    public sem_store.Store& model;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public monomorph.MonomorphStore& instances;
    @life(a)
    public module_graph.ModuleGraph& graph;
    @life(a)
    public jil.Store& output;
    public table.HashTable<TraitVTableGlobalKey, qid.DefId> trait_vtable_globals;
    public table.HashTable<Int, qid.DefId> receiver_type_globals;
    public table.HashTable<Int, qid.DefId> receiver_drop_shims;
    public table.HashTable<Int, qid.DefId> raw_fn_to_fn_shims;
    public table.HashTable<Int, qid.DefId> raw_fn_vtable_globals;
    public table.HashTable<LambdaVTableGlobalKey, qid.DefId> lambda_vtable_globals;
    public table.HashTable<jil.FunctionKey, qid.TypeId> lambda_env_types;
    public table.HashTable<Int, qid.DefId> lambda_env_drop_shims;
    public table.HashTable<jil.FunctionKey, qid.DefId> async_callable_start_shims;
    public table.HashTable<jil.FunctionKey, qid.DefId> async_callable_completion_shims;
    public table.HashTable<jil.FunctionKey, qid.DefId> serial_completion_shims;
    public coroutine_plan.Store coroutine_plans;
    public list.ArrayList<Bool> rtc_eligible!;
    public table.HashTable<jil.FunctionKey, Bool> lowering_functions;
    public table.HashTable<Int, qid.DefId> cancel_handler_shims;
    public table.HashTable<jil.FunctionKey, qid.DefId> async_block_env_drop_shims;
    public table.HashTable<Int, jil.TaskStateLayout> task_state_layouts;
    public table.HashTable<Int, qid.DefId> task_cleanup_shims;
    public qid.DefId? closure_noop_drop_shim!;

    public init(self,
        context.CompilerContext& ctx,
        sem_store.Store& model,
        typeck_store.TypeCheckStore& typeck,
        monomorph.MonomorphStore& instances,
        module_graph.ModuleGraph& graph,
        jil.Store& output
    ) {
        self.ctx = ctx;
        self.model = model;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.output = output;
        self.trait_vtable_globals = table.HashTable<TraitVTableGlobalKey, qid.DefId>();
        self.receiver_type_globals = table.HashTable<Int, qid.DefId>();
        self.receiver_drop_shims = table.HashTable<Int, qid.DefId>();
        self.raw_fn_to_fn_shims = table.HashTable<Int, qid.DefId>();
        self.raw_fn_vtable_globals = table.HashTable<Int, qid.DefId>();
        self.lambda_vtable_globals = table.HashTable<LambdaVTableGlobalKey, qid.DefId>();
        self.lambda_env_types = table.HashTable<jil.FunctionKey, qid.TypeId>();
        self.lambda_env_drop_shims = table.HashTable<Int, qid.DefId>();
        self.async_callable_start_shims = table.HashTable<jil.FunctionKey, qid.DefId>();
        self.async_callable_completion_shims = table.HashTable<jil.FunctionKey, qid.DefId>();
        self.serial_completion_shims = table.HashTable<jil.FunctionKey, qid.DefId>();
        self.coroutine_plans = coroutine_plan.Store();
        self.rtc_eligible = list.ArrayList<Bool>();
        self.lowering_functions = table.HashTable<jil.FunctionKey, Bool>();
        self.cancel_handler_shims = table.HashTable<Int, qid.DefId>();
        self.async_block_env_drop_shims = table.HashTable<jil.FunctionKey, qid.DefId>();
        self.task_state_layouts = table.HashTable<Int, jil.TaskStateLayout>();
        self.task_cleanup_shims = table.HashTable<Int, qid.DefId>();
        self.closure_noop_drop_shim = null;
    }
}
