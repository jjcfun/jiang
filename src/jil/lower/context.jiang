// JIL package lowering 的共享可变上下文。
//
// Context 保存 package 调度、函数实例和 generated function 所需状态；
// 单个函数体的状态由 body 模块独立维护。

import context = "../../context.jiang";
import sem_store = "../../sema/model/store.jiang";
import qid = "../../id.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import monomorph = "../../sema/monomorph.jiang";
import typeck_store = "../../sema/type_check/store.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import jil = "../model.jiang";
import coroutine_plan = "../coroutine/plan.jiang";
import * = "./model.jiang";

@region(a)
public struct Context: Movable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(a)
    public sem_store.Store& model;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public monomorph.MonomorphStore& instances;
    @life(a)
    public module_graph.ModuleGraph& graph;
    @life(a)
    public jil.Store& output;
    public table.HashTable<TraitVTableGlobalKey, jil.GlobalId> trait_vtable_globals;
    public table.HashTable<Int, jil.GlobalId> receiver_type_globals;
    public table.HashTable<Int, jil.FunctionId> receiver_drop_shims;
    public table.HashTable<Int, jil.FunctionId> raw_fn_to_fn_shims;
    public table.HashTable<Int, jil.GlobalId> raw_fn_vtable_globals;
    public table.HashTable<LambdaVTableGlobalKey, jil.GlobalId> lambda_vtable_globals;
    public table.HashTable<jil.FunctionKey, qid.TypeId> lambda_env_types;
    public table.HashTable<Int, jil.FunctionId> lambda_env_drop_shims;
    public table.HashTable<jil.FunctionKey, jil.FunctionId> async_callable_start_shims;
    public table.HashTable<jil.FunctionKey, jil.FunctionId> async_callable_completion_shims;
    public table.HashTable<jil.FunctionKey, jil.FunctionId> serial_completion_shims;
    public coroutine_plan.Store coroutine_plans;
    public list.ArrayList<Bool> rtc_eligible!;
    public table.HashTable<Int, jil.FunctionId> cancel_handler_shims;
    public table.HashTable<jil.FunctionKey, jil.FunctionId> async_lambda_env_drop_shims;
    public table.HashTable<Int, jil.TaskStateLayout> task_state_layouts;
    public table.HashTable<Int, jil.FunctionId> task_cleanup_shims;
    public jil.FunctionId? closure_noop_drop_shim!;

    public init(self,
        context.CompilerContext& ctx,
        sem_store.Store& model,
        typeck_store.TypeCheckStore& typeck,
        monomorph.MonomorphStore& instances,
        module_graph.ModuleGraph& graph,
        jil.Store& output
    ) {
        self.ctx = ctx;
        self.model = model;
        self.typeck = typeck;
        self.instances = instances;
        self.graph = graph;
        self.output = output;
        self.trait_vtable_globals = table.HashTable<TraitVTableGlobalKey, jil.GlobalId>();
        self.receiver_type_globals = table.HashTable<Int, jil.GlobalId>();
        self.receiver_drop_shims = table.HashTable<Int, jil.FunctionId>();
        self.raw_fn_to_fn_shims = table.HashTable<Int, jil.FunctionId>();
        self.raw_fn_vtable_globals = table.HashTable<Int, jil.GlobalId>();
        self.lambda_vtable_globals = table.HashTable<LambdaVTableGlobalKey, jil.GlobalId>();
        self.lambda_env_types = table.HashTable<jil.FunctionKey, qid.TypeId>();
        self.lambda_env_drop_shims = table.HashTable<Int, jil.FunctionId>();
        self.async_callable_start_shims = table.HashTable<jil.FunctionKey, jil.FunctionId>();
        self.async_callable_completion_shims = table.HashTable<jil.FunctionKey, jil.FunctionId>();
        self.serial_completion_shims = table.HashTable<jil.FunctionKey, jil.FunctionId>();
        self.coroutine_plans = coroutine_plan.Store();
        self.rtc_eligible = list.ArrayList<Bool>();
        self.cancel_handler_shims = table.HashTable<Int, jil.FunctionId>();
        self.async_lambda_env_drop_shims = table.HashTable<jil.FunctionKey, jil.FunctionId>();
        self.task_state_layouts = table.HashTable<Int, jil.TaskStateLayout>();
        self.task_cleanup_shims = table.HashTable<Int, jil.FunctionId>();
        self.closure_noop_drop_shim = null;
    }
}
