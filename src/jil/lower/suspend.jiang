// coroutine suspend、continuation、resume 和 cancellation lowering。
//
// 本模块是 lower/body 实现族的一部分，只在 Semantic Model -> JIL 阶段内使用。

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import std;
import coroutine_task_abi = "../coroutine/task_abi.jiang";
import * = "./model.jiang";
import * = "./context.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import expression = "./expression.jiang";
import task = "./task.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import closure = "./closure.jiang";
import call = "./call.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";
import support = "./support.jiang";

public enum SuspendRecordLocation: Copyable {
    local(jil.LocalId),
    pointer(jil.LocalId),
}

jil.AggregateField? coroutine_frame_field_for_local(
    jil.CoroutineFrameLayout& layout,
    jil.LocalId local_id
) {
    Int index! = 0;
    while (index < layout.local_mappings.length) {
        jil.CoroutineLocalFrameField mapping = layout.local_mappings[index];
        if (mapping.local_id == local_id) {
            return jil.AggregateField(
                type_id: layout.fields[mapping.field_index].type_id,
                index: mapping.field_index
            );
        }
        index = index + 1;
    }
    return null;
}

public jil.AggregateField? coroutine_frame_param_field(
    jil.CoroutineFrameLayout& layout,
    Int param_index
) {
    Int field_index! = 0;
    Int current_param! = 0;
    while (field_index < layout.fields.length) {
        jil.CoroutineFrameField field = layout.fields[field_index];
        field_index = field_index + 1;
        if (field.kind != .param) { continue; }
        if (current_param == param_index) {
            return jil.AggregateField(
                type_id: field.type_id,
                index: field_index - 1
            );
        }
        current_param = current_param + 1;
    }
    return null;
}

public extend body_context.BodyLowerer {
    public Bool is_coroutine_suspend_def(self, qid.DefId target_def) {
        guard self.lowerer.store.resolve.core_functions.coroutine_suspend
            is .some(suspend_def) else { return false; }
        return target_def == suspend_def;
    }

    public Bool is_coroutine_check_cancelled_def(self, qid.DefId target_def) {
        guard self.lowerer.store.resolve.core_functions.coroutine_check_cancelled
            is .some(check_def) else { return false; }
        return target_def == check_def;
    }

    public Void lower_coroutine_check_cancelled(
        Self&! self,
        sem.NodeId node_id,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.TaskStateLayout state = self.current_task_state_layout();
        jil.LocalId pointer = self.current_task_cancellation_state_pointer(state, span);
        jil.BlockId check = self.builder.reserve_block(span);
        jil.BlockId observe = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(pointer), check, complete, span
        );
        self.builder.start_block(check);
        qid.TypeId request_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(pointer), true),
                state.cancellation_requested
            )
        );
        jil.LocalId claimed = self.add_temp(
            self.lowerer.store.types.bool_type(), span
        );
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancellation_requested
                ),
                expected: jil.const_operand_value(self.int_const(1, span)),
                desired: jil.const_operand_value(self.int_const(2, span)),
                // A confined direct child can still observe its concurrent root Task context.
                // Keep this claim atomic when local coroutine protocol operations are specialized.
                mode: .user_atomic
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: self.builder.cancellation_entry,
            else_target: observe
        )), span);
        self.builder.start_block(observe);
        jil.LocalId request_state = self.add_temp(request_type, span);
        self.builder.push_assign(
            self.place_for_local(request_state),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancellation_requested
                ),
                mode: .user_atomic
            )),
            span
        );
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (
            value: self.int_const(2, span),
            target: self.builder.cancellation_entry
        ));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(request_state)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.builder.start_block(complete);
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
    }

    public Bool is_continuation_resume_def(self, qid.DefId target_def) {
        guard self.lowerer.store.resolve.core_functions.continuation_resume
            is .some(resume_def) else { return false; }
        return target_def == resume_def;
    }

    public Bool is_continuation_on_cancel_def(self, qid.DefId target_def) {
        guard self.lowerer.store.resolve.core_functions.continuation_on_cancel
            is .some(on_cancel_def) else { return false; }
        return target_def == on_cancel_def;
    }

    public Void lower_coroutine_suspend(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        jil.Place destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        sem.NodeId registration_id = call.args[0].value;
        qid.TypeId registration_type = self.type_for_node(registration_id);
        types.TypeInfo registration_info = self.lowerer.store.types.get(registration_type);
        guard registration_info.data is .function_type(registration_fn) else {
            self.mark_unsupported(node_id);
            return;
        }
        guard registration_fn.params.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_coroutine_suspend_registration(
            node_id,
            registration_id,
            registration_type,
            registration_fn.params[0],
            destination
        );
    }

    public Void lower_coroutine_suspend_registration(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId registration_id,
        qid.TypeId registration_type,
        qid.TypeId continuation_type,
        jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        jil.SuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            self.jil_place_type(destination), span
        );
        jil.LocalId record_local = self.add_temp(layout.type_id, span);
        SuspendRecordLocation record_pointer = .local(record_local);
        self.initialize_suspend_continuation(layout, record_pointer, destination, span);
        self.check_cancellation_before_suspend_registration(record_pointer, layout, span);
        jil.LocalId continuation_local = self.add_temp(continuation_type, span);
        if (!self.initialize_suspend_handle(
            layout, record_pointer, continuation_local, span
        )) {
            self.mark_unsupported(node_id);
            return;
        }
        if (self.call_suspend_registration_lambda(
                registration_id, continuation_local, record_pointer, layout, span
            )
        ) {
            return;
        }
        jil.LocalId registration_local = self.add_temp(registration_type, span);
        self.lower_into_place(registration_id, self.place_for_local(registration_local));
        self.call_suspend_registration(
            registration_local, continuation_local, record_pointer, layout, span
        );
    }

    @life(return: self.d)
    public jil.Place suspend_record_place(self, SuspendRecordLocation record_pointer) {
        if (record_pointer is .local(record)) {
            return self.place_for_local(record);
        }
        if (record_pointer is .pointer(pointer)) {
            return self.project_deref(self.place_for_local(pointer), true);
        }
        assert(false);
        return self.place_for_local(jil.LocalId.from_index(0));
    }

    public Void check_cancellation_before_suspend_registration(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.Place request = self.project_deref(
            self.project_constant_index(
                self.suspend_record_place(record_pointer),
                layout.cancel_request_pointer_field_index
            ),
            true
        );
        qid.TypeId request_type = self.jil_place_type(request);
        jil.LocalId requested = self.add_temp(request_type, span);
        self.builder.push_assign(
            self.place_for_local(requested),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: self.project_deref(
                    self.project_constant_index(
                        self.suspend_record_place(record_pointer),
                        layout.cancel_request_pointer_field_index
                    ),
                    true
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId cancelled = self.builder.reserve_block(span);
        jil.BlockId registration = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (
            value: self.int_const(1, span),
            target: cancelled
        ));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(requested)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: registration
        )), span);
        self.builder.start_block(cancelled);
        self.clear_suspend_registration_target(record_pointer, layout, span);
        jil.BlockId parked = self.builder.reserve_block(span);
        // 当前协程即将挂起，新的 continuation 接替当前执行链。
        // 取消路径可能已经发布父 continuation，因此这里必须允许 handoff 覆盖旧目标。
        self.call_suspend_resume(record_pointer, layout, parked, true, span);
        self.builder.start_block(parked);
        self.builder.finish_block(jil.suspend_pending_terminator_kind(jil.SuspendPendingTerminator (
            target: parked,
            suspend_wake: .external
        )), span);
        self.builder.start_block(registration);
    }

    public Void clear_suspend_registration_target(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.LocalId cleared = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Const expected = self.int_const(3, span);
        jil.Const desired = self.int_const(0, span);
        self.builder.push_assign(
            self.place_for_local(cleared),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_deref(
                    self.project_constant_index(
                        self.suspend_record_place(record_pointer),
                        layout.cancel_word_pointer_field_index
                    ),
                    true
                ),
                expected: jil.const_operand_value(expected),
                desired: jil.const_operand_value(desired),
                mode: .coroutine_atomic
            )),
            span
        );
    }

    public Void initialize_suspend_continuation(
        Self&! self,
        jil.SuspendContinuationLayout layout,
        SuspendRecordLocation record_pointer,
        jil.Place destination,
        token.Span span
    ) {
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.result_field_index
            ),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: destination,
                frame_root: false
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.context_field_index
            ),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.resume_field_index
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.function_operand_value(jil.FunctionRef (
                    target: .source(self.def_id),
                    args: self.lowerer.storage.generic_arg_array(
                        self.function_args.slice()
                    ),
                    variant: .coroutine_resume(.standard),
                    type_id: self.lowerer.coroutine_continuation_type(
                        self.lowerer.coroutine_context_pointer_type(span), span
                    )
                ))
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.executor_field_index
            ),
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.task_field_index
            ),
            jil.current_task_rvalue(jil.CurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        self.push_atomic_store(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.phase_field_index
            ),
            self.int_operand(suspend_registering, span),
            span
        );
        self.initialize_suspend_cancel_target(layout, record_pointer, span);
    }

    public Void initialize_suspend_cancel_target(
        Self&! self,
        jil.SuspendContinuationLayout layout,
        SuspendRecordLocation record_pointer,
        token.Span span
    ) {
        jil.TaskStateLayout state = self.current_task_state_layout();
        jil.LocalId pointer = self.current_task_cancellation_state_pointer(state, span);
        jil.BlockId inherited = self.builder.reserve_block(span);
        jil.BlockId fallback = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(pointer), inherited, fallback, span
        );
        self.builder.start_block(inherited);
        self.store_suspend_field_address(
            record_pointer,
            layout.cancel_request_pointer_field_index,
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(pointer), true),
                state.cancellation_requested
            ),
            span
        );
        self.store_suspend_field_address(
            record_pointer,
            layout.cancel_word_pointer_field_index,
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(pointer), true),
                state.cancel_target_word
            ),
            span
        );
        self.push_atomic_store(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(pointer), true),
                state.cancel_target_word
            ),
            jil.const_operand_value(self.int_const(3, span)),
            span
        );
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(fallback);
        self.push_atomic_store(
            self.project_constant_index(
                self.suspend_record_place(record_pointer),
                layout.fallback_cancel_request_field_index
            ),
            jil.const_operand_value(self.int_const(0, span)),
            span
        );
        self.push_atomic_store(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.fallback_cancel_word_field_index
            ),
            jil.const_operand_value(self.int_const(3, span)),
            span
        );
        self.store_suspend_field_address(
            record_pointer,
            layout.cancel_request_pointer_field_index,
            self.project_constant_index(
                self.suspend_record_place(record_pointer),
                layout.fallback_cancel_request_field_index
            ),
            span
        );
        self.store_suspend_field_address(
            record_pointer,
            layout.cancel_word_pointer_field_index,
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.fallback_cancel_word_field_index
            ),
            span
        );
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void store_suspend_field_address(
        Self&! self,
        SuspendRecordLocation record_pointer,
        Int field_index,
        jil.Place value,
        token.Span span
    ) {
        self.builder.push_assign(
            self.project_constant_index(self.suspend_record_place(record_pointer), field_index),
            jil.address_of_rvalue(jil.AddressOfRvalue (
                mutable_pointer: true,
                place: value
            )),
            span
        );
    }

    public jil.Operand suspend_cancel_target_word(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.LocalId pointer = self.add_temp(layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.suspend_record_place(record_pointer),
                frame_root: false
            )),
            span
        );
        qid.TypeId int_type = self.lowerer.store.types.int_type();
        jil.LocalId address = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(address),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(pointer)),
                target_type: int_type
            )),
            span
        );
        jil.LocalId tagged = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(tagged),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_or,
                lhs: self.operand_for_place(self.place_for_local(address)),
                rhs: self.int_operand(1, span)
            )),
            span
        );
        return self.operand_for_place(self.place_for_local(tagged));
    }

    public Bool initialize_suspend_handle(
        Self&! self,
        jil.SuspendContinuationLayout layout,
        SuspendRecordLocation record_pointer,
        jil.LocalId continuation,
        token.Span span
    ) {
        jil.LocalId pointer = self.add_temp(layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.suspend_record_place(record_pointer),
                frame_root: false
            )),
            span
        );
        qid.TypeId state_type = self.lowerer.store.types.uint_type();
        guard self.project_nominal_field_at(self.place_for_local(continuation), 0)
            is .some(state_place) else {
            return false;
        }
        self.builder.push_assign(
            state_place,
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(pointer)),
                target_type: state_type
            )),
            span
        );
        return true;
    }

    public Void call_suspend_registration(
        Self&! self,
        jil.LocalId registration,
        jil.LocalId continuation,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.Place vtable = self.project_deref(
            self.project_constant_index(self.place_for_local(registration), 1), true
        );
        jil.Place function = self.project_constant_index(vtable, 0);
        jil.CallCallee callee = jil.indirect_operand_callee(self.operand_for_place(function));
        jil.Operand environment = self.operand_for_place(
            self.project_constant_index(self.place_for_local(registration), 0)
        );
        self.finish_suspend_registration_call(
            callee, environment, continuation, record_pointer, layout, span
        );
    }

    public Bool call_suspend_registration_lambda(
        Self&! self,
        sem.NodeId registration_id,
        jil.LocalId continuation,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        sem.Node node = self.lowerer.model.node(registration_id);
        guard node.data is .lambda_expr(lambda) else { return false; }
        qid.DefId function_def = lambda.function_def;
        qid.TypeId closure_type = self.type_for_node(registration_id);
        qid.TypeId code_type = self.closure_code_type(closure_type);
        sem.Node refreshed_node = self.lowerer.model.node(registration_id);
        guard refreshed_node.data is .lambda_expr(refreshed_lambda) else { return false; }
        jil.Operand environment = self.lambda_env_operand(
            registration_id, refreshed_lambda, span
        );
        jil.FunctionRef function = jil.FunctionRef (
            target: .source(function_def),
            args: self.lowerer.storage.generic_arg_array(self.function_args.slice()),
            type_id: code_type
        );
        self.finish_suspend_registration_call(
            jil.direct_function_callee(function),
            environment,
            continuation,
            record_pointer,
            layout,
            span
        );
        return true;
    }

    public Void finish_suspend_registration_call(
        Self&! self,
        jil.CallCallee callee,
        jil.Operand environment,
        jil.LocalId continuation,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(2);
        args.add(environment);
        args.add(self.operand_for_place(self.place_for_local(continuation)));
        jil.LocalId result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        jil.BlockId next = self.builder.reserve_block(span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: callee,
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: next,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next);
        self.finish_suspend_registration(record_pointer, layout, span);
    }

    public Void finish_suspend_registration(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        qid.TypeId phase_type = self.jil_place_type(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.phase_field_index
            )
        );
        jil.LocalId parked = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(parked),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.phase_field_index
                ),
                expected: self.int_operand(suspend_registering, span),
                desired: self.int_operand(suspend_parked, span),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId suspend = self.builder.reserve_block(span);
        jil.BlockId await_publish = self.builder.reserve_block(span);
        jil.BlockId check_cancel = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(parked)),
            then_target: suspend,
            else_target: await_publish
        )), span);
        self.builder.start_block(suspend);
        self.builder.finish_block(jil.suspend_pending_terminator_kind(jil.SuspendPendingTerminator (
            target: complete,
            suspend_wake: .external
        )), span);
        self.builder.start_block(await_publish);
        jil.LocalId observed = self.add_temp(phase_type, span);
        self.builder.push_assign(
            self.place_for_local(observed),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.phase_field_index
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(2);
        cases.add(jil.SwitchCase (
            value: self.int_const(suspend_resumed, span),
            target: check_cancel
        ));
        cases.add(jil.SwitchCase (value: self.int_const(suspend_parked, span), target: suspend));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: await_publish
        )), span);
        self.builder.start_block(check_cancel);
        self.check_cancellation_before_suspend_registration(record_pointer, layout, span);
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void lower_continuation_resume(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        jil.Place destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.call_member_receiver(call) is .some(receiver_id) else {
            self.mark_unsupported(node_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        sem.NodeId value_id = call.args[0].value;
        jil.SuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            self.type_for_node(value_id), span
        );
        guard self.suspend_record_for_receiver(receiver_id, layout, span)
            is .some(record_pointer) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
        self.resume_suspend_record(value_id, record_pointer, layout, span);
    }

    public Void lower_continuation_on_cancel(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        jil.Place destination
    ) {
        guard call.args.length == 1 else {
            self.mark_unsupported(node_id);
            return;
        }
        guard self.call_member_receiver(call) is .some(receiver_id) else {
            self.mark_unsupported(node_id);
            return;
        }
        sem.NodeId handler_id = call.args[0].value;
        sem.Node handler_node = self.lowerer.model.node(handler_id);
        guard handler_node.data is .lambda_expr(_) else {
            self.mark_unsupported(handler_id);
            return;
        }
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId result_type = self.continuation_result_type(receiver_id);
        jil.SuspendContinuationLayout layout = self.lowerer.suspend_continuation_layout(
            result_type, span
        );
        guard self.suspend_record_for_receiver(receiver_id, layout, span)
            is .some(record_pointer) else {
            self.mark_unsupported(node_id);
            return;
        }
        sem.Node refreshed_handler_node = self.lowerer.model.node(handler_id);
        guard refreshed_handler_node.data is .lambda_expr(handler) else {
            self.mark_unsupported(handler_id);
            return;
        }
        self.register_suspend_cancel_handler(
            handler_id, handler, record_pointer, layout, span
        );
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
    }

    public qid.TypeId continuation_result_type(self, sem.NodeId receiver_id) {
        qid.TypeId type_id! = self.type_for_node(receiver_id);
        types.TypeInfo info! = self.lowerer.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            type_id = handle.element;
            info = self.lowerer.store.types.get(type_id);
        }
        guard info.data is .named(named) else {
            return self.lowerer.store.types.invalid_type();
        }
        guard named.type_args.length == 1 else {
            return self.lowerer.store.types.invalid_type();
        }
        return named.type_args[0];
    }

    public Void register_suspend_cancel_handler(
        Self&! self,
        sem.NodeId handler_id,
        sem.Lambda handler,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        qid.DefId handler_def = handler.function_def;
        jil.FunctionId drop_id = self.cancel_handler_drop_function_id(
            handler_id, handler_def, span
        );
        jil.FunctionId invoke_id = self.ensure_cancel_handler_shim(
            handler_id, handler_def, drop_id, span
        );
        jil.LocalId context_local = self.add_temp(self.closure_env_type(span), span);
        jil.Operand context = self.heap_lambda_env_operand(handler_id, handler, null, span);
        self.builder.push_assign(
            self.place_for_local(context_local),
            jil.use_rvalue(jil.UseRvalue (value: context)),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.handler_context_field_index
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: self.operand_for_place(self.place_for_local(context_local))
            )),
            span
        );
        jil.FunctionRef drop_function = self.cancel_handler_runtime_function_ref(
            drop_id, span
        );
        jil.FunctionRef invoke_function = self.cancel_handler_runtime_function_ref(
            invoke_id, span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.handler_drop_field_index
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.function_operand_value(
                    drop_function
                )
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.handler_function_field_index
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.function_operand_value(
                    invoke_function
                )
            )),
            span
        );
        jil.Operand cancel_target = self.suspend_cancel_target_word(
            record_pointer, layout, span
        );
        self.push_atomic_store(
            self.project_deref(
                self.project_constant_index(
                    self.suspend_record_place(record_pointer),
                    layout.cancel_word_pointer_field_index
                ),
                true
            ),
            cancel_target,
            span
        );
        self.invoke_suspend_cancel_handler_if_requested(record_pointer, layout, span);
    }

    public Void invoke_suspend_cancel_handler_if_requested(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.Place request = self.project_deref(
            self.project_constant_index(
                self.suspend_record_place(record_pointer),
                layout.cancel_request_pointer_field_index
            ),
            true
        );
        qid.TypeId request_type = self.jil_place_type(request);
        jil.LocalId requested = self.add_temp(request_type, span);
        self.builder.push_assign(
            self.place_for_local(requested),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: self.project_deref(
                    self.project_constant_index(
                        self.suspend_record_place(record_pointer),
                        layout.cancel_request_pointer_field_index
                    ),
                    true
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId invoke = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (value: self.int_const(1, span), target: invoke));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(requested)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.builder.start_block(invoke);
        self.invoke_suspend_cancel_handler(record_pointer, layout, span);
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void invoke_suspend_cancel_handler(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.LocalId claimed = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Operand expected = self.suspend_cancel_target_word(record_pointer, layout, span);
        jil.Const desired = self.int_const(2, span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_deref(
                    self.project_constant_index(
                        self.suspend_record_place(record_pointer),
                        layout.cancel_word_pointer_field_index
                    ),
                    true
                ),
                expected: expected,
                desired: jil.const_operand_value(desired),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId invoke = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: invoke,
            else_target: complete
        )), span);
        self.builder.start_block(invoke);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.handler_context_field_index
            )
        ));
        jil.LocalId result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.indirect_operand_callee(self.operand_for_place(
                self.project_constant_index(
                    self.suspend_record_place(record_pointer),
                    layout.handler_function_field_index
                )
            )),
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(complete);
    }

    public jil.FunctionId cancel_handler_drop_function_id(
        Self&! self,
        sem.NodeId handler_id,
        qid.DefId handler_def,
        token.Span span
    ) {
        jil.FunctionId drop_id! = self.ensure_closure_noop_drop_shim(span);
        if (self.known_lambda_capture_count(handler_def) is .some(capture_count)) {
            if (capture_count > 0) {
                qid.TypeId env_type = self.lambda_env_type_for_def(
                    handler_def, capture_count, span
                );
                drop_id = self.ensure_lambda_env_drop_shim(handler_id, env_type, true);
            }
        }
        return drop_id;
    }

    public sem.NodeId? call_member_receiver(self, sem.Call call) {
        sem.Node callee = self.lowerer.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        return member_access.base;
    }

    public SuspendRecordLocation? suspend_record_for_receiver(
        Self&! self,
        sem.NodeId receiver_id,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.Place receiver! = self.receiver_source_place(receiver_id, span);
        if (self.type_is_reference(self.jil_place_type(receiver))) {
            receiver = self.project_deref(receiver, false);
        }
        guard self.project_nominal_field_at(receiver, 0) is .some(state_place) else {
            return null;
        }
        support.StablePlaceLocation state = self.stable_place_location(state_place);
        jil.LocalId pointer = self.add_temp(layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.int_to_ptr,
                value: self.operand_for_place(self.stable_place(state$.ref())),
                target_type: layout.pointer_type_id
            )),
            span
        );
        SuspendRecordLocation location = .pointer(pointer);
        return location;
    }

    public Void resume_suspend_record(
        Self&! self,
        sem.NodeId value_id,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        qid.TypeId phase_type = self.jil_place_type(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.phase_field_index
            )
        );
        jil.LocalId observed = self.add_temp(phase_type, span);
        jil.LocalId claimed = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.LocalId schedule = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.BlockId inspect = self.builder.reserve_block(span);
        jil.BlockId claim_registering = self.builder.reserve_block(span);
        jil.BlockId claim_parked = self.builder.reserve_block(span);
        jil.BlockId publish = self.builder.reserve_block(span);
        jil.BlockId enqueue = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.builder.finish_block(self.goto_terminator(inspect), span);
        self.builder.start_block(inspect);
        self.builder.push_assign(
            self.place_for_local(observed),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.phase_field_index
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(2);
        cases.add(jil.SwitchCase (
            value: self.int_const(suspend_registering, span),
            target: claim_registering
        ));
        cases.add(jil.SwitchCase (
            value: self.int_const(suspend_parked, span),
            target: claim_parked
        ));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.builder.start_block(claim_registering);
        self.builder.push_assign(self.place_for_local(schedule), self.bool_rvalue(false, span), span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.phase_field_index
                ),
                expected: self.int_operand(suspend_registering, span),
                desired: self.int_operand(suspend_resuming, span),
                mode: .coroutine_atomic
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: publish,
            else_target: inspect
        )), span);
        self.builder.start_block(claim_parked);
        self.builder.push_assign(self.place_for_local(schedule), self.bool_rvalue(true, span), span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.phase_field_index
                ),
                expected: self.int_operand(suspend_parked, span),
                desired: self.int_operand(suspend_resuming, span),
                mode: .coroutine_atomic
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: publish,
            else_target: inspect
        )), span);
        self.builder.start_block(publish);
        self.clear_suspend_cancel_handler(record_pointer, layout, span);
        self.lower_into_place(
            value_id,
            self.project_deref(
                self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.result_field_index
                ),
                true
            )
        );
        self.push_atomic_store(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.phase_field_index
            ),
            self.int_operand(suspend_resumed, span),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(schedule)),
            then_target: enqueue,
            else_target: complete
        )), span);
        self.builder.start_block(enqueue);
        self.call_suspend_resume(record_pointer, layout, complete, false, span);
        self.builder.start_block(complete);
    }

    public Void clear_suspend_cancel_handler(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        token.Span span
    ) {
        jil.LocalId claimed = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Operand expected = self.suspend_cancel_target_word(record_pointer, layout, span);
        jil.Const desired = self.int_const(0, span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: self.project_deref(
                    self.project_constant_index(
                        self.suspend_record_place(record_pointer),
                        layout.cancel_word_pointer_field_index
                    ),
                    true
                ),
                expected: expected,
                desired: jil.const_operand_value(desired),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId drop = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(claimed)),
            then_target: drop,
            else_target: complete
        )), span);
        self.builder.start_block(drop);
        self.call_suspend_handler_drop(record_pointer, layout, complete, span);
        self.builder.start_block(complete);
        self.clear_suspend_registration_target(record_pointer, layout, span);
    }

    public Void call_suspend_handler_drop(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        jil.BlockId complete,
        token.Span span
    ) {
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.handler_context_field_index
            )
        ));
        jil.LocalId result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.indirect_operand_callee(self.operand_for_place(
                self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.handler_drop_field_index
                )
            )),
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
    }

    public Void call_suspend_resume(
        Self&! self,
        SuspendRecordLocation record_pointer,
        jil.SuspendContinuationLayout layout,
        jil.BlockId complete,
        Bool handoff,
        token.Span span
    ) {
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(self.operand_for_place(
            self.project_constant_index(
                self.suspend_record_place(record_pointer), layout.context_field_index
            )
        ));
        jil.LocalId result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.dynamic_task_enqueue_callee(
                self.operand_for_place(self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.executor_field_index
                )),
                self.operand_for_place(self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.task_field_index
                )),
                self.operand_for_place(self.project_constant_index(
                    self.suspend_record_place(record_pointer), layout.resume_field_index
                )),
                handoff
            ),
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
    }

    public Void lower_async_direct_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.Place destination,
        jil.RuntimeDomainLease&? runtime_lease,
        token.Span span
    ) {
        if (self.lowerer.is_external_function_decl(target_def)) {
            self.lower_external_async_continuation_call(
                target_def, function_args, args, destination, span
            );
            return;
        }
        self.lower_symbolic_async_direct_call(
            target_def, function_args, args, destination, runtime_lease, span
        );
    }

    public Void lower_symbolic_async_direct_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.Place destination,
        jil.RuntimeDomainLease&? runtime_lease,
        token.Span span
    ) {
        qid.TypeId source_type = self.function_type_for_ref(
            target_def, function_args
        );
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.direct_function_callee(jil.FunctionRef(
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                type_id: source_type
            )),
            args: self.lowerer.storage.operand_slice(args),
            current_effects: self.current_effects,
            is_suspend_point: true,
            deferred_async_direct: true,
            deferred_runtime_domain_lease: runtime_lease,
            destination: destination,
            target: next_block,
            initialized_place: destination,
            deferred_initialization: true,
            return_lifetime_flows: self.type_return_lifetime_flows(source_type, 0),
            lifetime_args: args,
            lifetime_destination: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void lower_recursive_async_direct_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.Place destination,
        token.Span span
    ) {
        jil.ExternalContinuationLayout layout =
            self.lowerer.external_async_continuation_layout(
                self.jil_place_type(destination), span
        );
        jil.LocalId continuation = self.add_temp(layout.type_id, span);
        self.initialize_current_async_continuation(
            layout, self.place_for_local(continuation), destination, span
        );
        jil.LocalId continuation_pointer = self.add_temp(
            layout.pointer_type_id, span
        );
        self.builder.push_assign(
            self.place_for_local(continuation_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(continuation),
                frame_root: false
            )),
            span
        );
        qid.TypeId source_type = self.function_type_for_ref(
            target_def, function_args
        );
        qid.TypeId context_type = self.lowerer.coroutine_context_pointer_type(span);
        qid.TypeId child_resume_type = self.lowerer.coroutine_continuation_type(
            context_type, span
        );
        qid.TypeId start_type = self.lowerer.external_async_abi_function_type(
            source_type, span
        );
        types.LifetimeFlow[]& return_lifetime_flows =
            self.type_return_lifetime_flows(source_type, 0);
        list.ArrayList<jil.Operand> start_args! = list.ArrayList<jil.Operand>(args.length + 1);
        Int arg_index! = 0;
        while (arg_index < args.length) {
            start_args.add(args[arg_index]);
            arg_index = arg_index + 1;
        }
        start_args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        jil.FunctionRef child_resume = jil.FunctionRef (
            target: .source(target_def),
            args: self.lowerer.storage.generic_arg_array(function_args),
            variant: .coroutine_resume(.standard),
            type_id: child_resume_type
        );
        self.finish_async_direct_start(
            jil.FunctionRef(
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                variant: .coroutine_start(),
                type_id: start_type
            ),
            child_resume,
            start_args$.ref(),
            return_lifetime_flows,
            args,
            destination,
            span
        );
    }

    public Void lower_external_async_continuation_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& source_args,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId context_type = self.lowerer.coroutine_context_pointer_type(span);
        qid.TypeId continuation_type = self.lowerer.coroutine_continuation_type(context_type, span);
        jil.ExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(
                self.jil_place_type(destination), span
        );
        jil.LocalId continuation_record = self.add_temp(continuation_layout.type_id, span);
        jil.Rvalue context =
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            ));
        jil.Operand resume = jil.function_operand_value(jil.FunctionRef (
            target: .source(self.def_id),
            args: self.lowerer.storage.generic_arg_array(self.function_args.slice()),
            variant: .coroutine_resume(.standard),
            type_id: continuation_type
        ));
        self.initialize_external_async_continuation(
            continuation_layout,
            self.place_for_local(continuation_record),
            destination,
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            context,
            resume,
            span
        );
        jil.LocalId continuation_pointer = self.add_temp(
            continuation_layout.pointer_type_id,
            span
        );
        self.builder.push_assign(
            self.place_for_local(continuation_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(continuation_record),
                frame_root: false
            )),
            span
        );
        jil.LocalId unit_result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.compare_exchange_passive_cancel_target(0, 3, span);
        qid.TypeId source_type = self.function_type_for_ref(target_def, function_args);
        qid.TypeId abi_type = self.lowerer.external_async_abi_function_type(
            source_type, span
        );
        types.LifetimeFlow[]& return_lifetime_flows =
            self.type_return_lifetime_flows(source_type, 0);
        list.ArrayList<jil.Operand> abi_args! = list.ArrayList<jil.Operand>(source_args.length + 1);
        Int index! = 0;
        while (index < source_args.length) {
            abi_args.add(source_args[index]);
            index = index + 1;
        }
        abi_args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.direct_function_callee(jil.FunctionRef (
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                type_id: abi_type
            )),
            args: self.lowerer.storage.operand_array(abi_args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: .external,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: null,
            return_lifetime_flows: return_lifetime_flows,
            lifetime_args: source_args,
            lifetime_destination: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
        self.compare_exchange_passive_cancel_target(3, 0, span);
    }

    public Void lower_async_direct_continuation_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.Place destination,
        jil.CoroutineFrameLayout& layout,
        jil.Place? prepared_frame,
        jil.RuntimeDomainLease&? runtime_lease,
        token.Span span
    ) {
        // 普通 async 调用属于当前 Task：
        // callee frame 保存在父 frame 中，完成后直接恢复父协程。
        jil.Place frame_place = self.direct_continuation_frame_place(
            layout,
            prepared_frame,
            span
        );
        self.lower_async_operands_into_frame(
            args, layout, frame_place, span
        );
        jil.FunctionRef parent_resume = jil.FunctionRef (
            target: .source(self.def_id),
            args: self.lowerer.storage.generic_arg_array(self.function_args.slice()),
            variant: .coroutine_resume(.standard),
            type_id: layout.fields[layout.continuation_function_field_index].type_id
        );
        jil.Statement[]& initializers = coroutine_task_abi.direct_continuation_initializers(
            self.lowerer.storage,
            layout,
            frame_place,
            destination,
            self.place_for_local(self.return_local()),
            parent_resume,
            span
        );
        Int index! = 0;
        while (index < initializers.length) {
            self.builder.push_statement(initializers[index]);
            index = index + 1;
        }
        if (runtime_lease is .some(lease)) {
            self.builder.push_assign(
                self.project_constant_index(
                    frame_place, layout.current_executor_field_index
                ),
                jil.use_rvalue(jil.UseRvalue(value: lease.executor)),
                span
            );
        } else {
            self.push_inherited_frame_domain(layout, frame_place, span);
        }
        jil.LocalId frame_pointer = self.add_temp(layout.task_abi.frame_pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(frame_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: frame_place,
                frame_root: false
            )),
            span
        );
        list.ArrayList<jil.Operand> resume_args! = list.ArrayList<jil.Operand>(1);
        resume_args.add(self.operand_for_place(self.place_for_local(frame_pointer)));
        jil.LocalId resume_result = self.add_temp(layout.task_abi.resume_return_type_id, span);
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.compare_exchange_passive_cancel_target(0, 3, span);
        jil.FunctionRef resume_function = self.lowerer.storage.source_coroutine_function_ref(
            target_def,
            function_args,
            layout.task_abi.resume_function_type_id,
            true,
            span
        );
        jil.CallCallee callee! = jil.direct_function_callee(resume_function);
        jil.SuspendWakeKind suspend_wake! = .direct_child;
        if (runtime_lease is .some(lease)) {
            callee = jil.dynamic_task_enqueue_callee(
                lease.executor,
                self.operand_for_place(self.project_constant_index(
                    frame_place, layout.cancellation_context_field_index
                )),
                jil.function_operand_value(resume_function),
                true
            );
            suspend_wake = .cross_executor;
        } else if (layout.effects.domain is .some(domain)) {
            if (!types.effect_domain_equal(self.current_effects.domain, layout.effects.domain)) {
                callee = jil.domain_task_enqueue_callee(
                    domain.binding,
                    layout.domain_kind,
                    self.operand_for_place(self.project_constant_index(
                        frame_place, layout.cancellation_context_field_index
                    )),
                    jil.function_operand_value(resume_function),
                    true
                );
                suspend_wake = .cross_executor;
            }
        }
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: callee,
            args: self.lowerer.storage.operand_array(resume_args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: true,
            suspend_wake: suspend_wake,
            suspend_child: resume_function,
            task_handoff: true,
            destination: self.place_for_local(resume_result),
            target: next_block,
            initialized_place: destination,
            deferred_initialization: true,
            return_lifetime_flows: self.type_return_lifetime_flows(
                self.function_type_for_ref(target_def, function_args),
                0
            ),
            lifetime_args: args,
            lifetime_destination: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
        self.complete_deferred_async_initialization(destination, span);
        if (runtime_lease is .some(lease) && lease.owns_lease) {
            self.release_runtime_domain_lease(lease, span);
        }
    }

    Void release_runtime_domain_lease(
        Self&! self,
        jil.RuntimeDomainLease& lease,
        token.Span span
    ) {
        qid.TypeId pointer_type = self.lowerer.store.types.opaque_pointer_type(span);
        jil.LocalId released = self.add_temp(pointer_type, span);
        self.builder.push_assign(
            self.place_for_local(released),
            jil.runtime_domain_executor_rvalue(jil.RuntimeDomainExecutorRvalue(
                operation: .release_lease,
                domain: null,
                owner: lease.executor,
                domain_type: lease.domain_type,
                domain_kind: 0
            )),
            span
        );
    }

    @life(return: self.d)
    public jil.Place direct_continuation_frame_place(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place? prepared_frame,
        token.Span span
    ) {
        if (prepared_frame is .some(frame_place)) {
            return self.copy_place_projection(frame_place);
        }
        jil.LocalId frame_local = self.add_temp(layout.frame_type_id, span);
        return self.place_for_local(frame_local);
    }

    public Void compare_exchange_passive_cancel_target(
        Self&! self,
        Int expected,
        Int desired,
        token.Span span
    ) {
        jil.TaskStateLayout state = self.current_task_state_layout();
        jil.LocalId pointer = self.current_task_cancellation_state_pointer(state, span);
        jil.BlockId exchange = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(pointer), exchange, complete, span
        );
        self.builder.start_block(exchange);
        jil.LocalId claimed = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Const expected_value = self.int_const(expected, span);
        jil.Const desired_value = self.int_const(desired, span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancel_target_word
                ),
                expected: jil.const_operand_value(expected_value),
                desired: jil.const_operand_value(desired_value),
                mode: .coroutine_atomic
            )),
            span
        );
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void complete_deferred_async_initialization(
        Self&! self,
        jil.Place destination,
        token.Span span
    ) {
        jil.TaskStateLayout state = self.current_task_state_layout();
        jil.LocalId pointer = self.current_task_cancellation_state_pointer(state, span);
        jil.BlockId exchange = self.builder.reserve_block(span);
        jil.BlockId initialized = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(pointer), exchange, initialized, span
        );
        self.builder.start_block(exchange);
        jil.LocalId claimed = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Const expected_value = self.int_const(3, span);
        jil.Const desired_value = self.int_const(0, span);
        self.builder.push_assign(
            self.place_for_local(claimed),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancel_target_word
                ),
                expected: jil.const_operand_value(expected_value),
                desired: jil.const_operand_value(desired_value),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.LocalId requested = self.add_temp(state.cancellation_requested.type_id, span);
        self.builder.push_assign(
            self.place_for_local(requested),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancellation_requested
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (
            value: self.int_const(0, span),
            target: initialized
        ));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(requested)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.builder.start_block(initialized);
        self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (
            target: complete,
            initialized_place: destination
        )), span);
        self.builder.start_block(complete);
    }

    public Void lower_async_operands_into_frame(
        Self&! self,
        jil.Operand[]& args,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame_place,
        token.Span span
    ) {
        Int arg_index! = 0;
        while (arg_index < args.length) {
            if (coroutine_frame_param_field(layout, arg_index) is .some(field)) {
                jil.Place param_place = self.project_frame_field(frame_place, field);
                self.builder.push_assign(
                    param_place,
                    jil.use_rvalue(jil.UseRvalue (value: args[arg_index])),
                    span
                );
            }
            arg_index = arg_index + 1;
        }
    }

    public Void push_inherited_frame_domain(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame_place,
        token.Span span
    ) {
        if (layout.effects.domain != null || !self.current_effects.has_async) { return; }
        self.builder.push_assign(
            self.project_constant_index(frame_place, layout.current_executor_field_index),
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            span
        );
    }

    public Void push_structured_task_frame_domain(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame_place,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        if (storage.sync != .local_serial) {
            self.push_inherited_frame_domain(layout, frame_place, span);
            return;
        }
        self.builder.push_assign(
            self.project_constant_index(frame_place, layout.current_executor_field_index),
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            span
        );
    }

    public Void push_task_execution_domain_initializers(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task,
        jil.Place frame,
        token.Span span
    ) {
        coroutine_task_abi.append_task_execution_domain_initializers(
            self.lowerer.storage,
            layout,
            task,
            frame,
            span,
            self.builder.statements$.mut_ref()
        );
    }

    @life(return: self.d)
    public jil.FunctionRef coroutine_generated_function_ref(
        self,
        qid.DefId target_def,
        types.GenericArg[]& args,
        jil.CoroutineFrameLayout& layout,
        Bool resume,
        token.Span span
    ) {
        qid.TypeId function_type! = layout.fields[layout.continuation_function_field_index].type_id;
        if (resume) { function_type = layout.task_abi.resume_function_type_id; }
        return self.lowerer.storage.source_coroutine_function_ref(
            target_def,
            args,
            function_type,
            resume,
            span
        );
    }

    @life(return: self.d)
    public jil.FunctionRef task_completion_function_ref(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& args,
        jil.CoroutineFrameLayout& layout,
        jil.TaskSyncMode sync,
        token.Span span
    ) {
        if (sync == .concurrent) {
            return self.coroutine_generated_function_ref(
                target_def, args, layout, false, span
            );
        }
        return self.lowerer.storage.source_serial_completion_function_ref(
            target_def,
            args,
            layout.fields[layout.continuation_function_field_index].type_id
        );
    }

}
