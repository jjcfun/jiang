// 从 JIL dataflow 与类型语义证明 LLVM 可消费的参数事实。
//
// 每项事实使用独立条件：nocapture 来自参数级 escape analysis，noalias 来自
// 唯一引用语义，readonly 来自写入与调用边界，dereferenceable 来自安全引用
// 和 concrete pointee layout。backend 只能翻译这里已经证明的结果。

import context = "../../context.jiang";
import jil = "../model.jiang";
import database = "../../db.jiang";
import provenance = "./provenance.jiang";
import qid = "../../id.jiang";
import types = "../../sema/type.jiang";
import list = "../../support/list.jiang";

public struct ParameterFacts: Copyable {
    public jil.LocalId local_id;
    public Bool nocapture!;
    public Bool noalias!;
    public Bool readonly!;
    public Int dereferenceable_bytes!;

    public init(self, jil.LocalId local_id) {
        self.local_id = local_id;
        self.nocapture = false;
        self.noalias = false;
        self.readonly = false;
        self.dereferenceable_bytes = 0;
    }
}

public struct FunctionFacts: Movable {
    public jil.FunctionId function_id;
    public list.ArrayList<ParameterFacts> parameters!;

    public init(self, jil.FunctionId function_id) {
        self.function_id = function_id;
        self.parameters = list.ArrayList<ParameterFacts>();
    }
}

public struct Store: Movable {
    public list.ArrayList<FunctionFacts> functions!;

    public init(self) {
        self.functions = list.ArrayList<FunctionFacts>();
    }

    public FunctionFacts& function(self, jil.FunctionId function_id) {
        return self.functions.ref_at(function_id.to_index());
    }
}

public Store analyze(context.CompilerContext&! ctx, jil.Store& store) {
    Store result! = Store();
    Int index! = 0;
    while (index < store.program.functions.len()) {
        result.functions.add(analyze_function(ctx, store.program.functions.get(index)));
        index = index + 1;
    }
    return result;
}

// debug codegen 不消费数据流证明，只维持与函数参数一一对应的保守事实。
// release 再调用 analyze 生成 LLVM 优化 attributes。
public Store conservative(jil.Store& store) {
    Store result! = Store();
    Int index! = 0;
    while (index < store.program.functions.len()) {
        jil.Function function = store.program.functions.get(index);
        FunctionFacts facts! = FunctionFacts(function.id);
        add_conservative_parameters(facts$.mut_ref(), function);
        result.functions.add(facts);
        index = index + 1;
    }
    return result;
}

// whole-package LLVM 可以从完整函数体推导 escape/write facts。这里只提供
// Jiang 类型系统直接保证的属性，避免在 O2 前重复运行一次全包 dataflow。
public Store semantic(context.CompilerContext&! ctx, jil.Store& store) {
    Store result! = Store();
    Int index! = 0;
    while (index < store.program.functions.len()) {
        result.functions.add(semantic_function(ctx, store.program.functions.get(index)));
        index = index + 1;
    }
    return result;
}

FunctionFacts semantic_function(
    context.CompilerContext&! ctx,
    jil.Function function
) {
    FunctionFacts result! = FunctionFacts(function.id);
    Int index! = 0;
    while (index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[index];
        if (local.kind == .param) {
            result.parameters.add(semantic_parameter(ctx, local));
        }
        index = index + 1;
    }
    return result;
}

ParameterFacts semantic_parameter(
    context.CompilerContext&! ctx,
    jil.LocalDecl parameter
) {
    ParameterFacts result! = ParameterFacts(parameter.id);
    types.TypeInfo type_info = ctx.store.types.get(parameter.type_id);
    guard type_info.data is .handle_type(handle) else { return result; }
    if (!types.is_reference_handle(handle)) { return result; }
    result.noalias = type_info.is_mutable;
    result.dereferenceable_bytes = pointee_size(ctx, handle.element);
    return result;
}

Void add_conservative_parameters(FunctionFacts&! facts, jil.Function function) {
    Int index! = 0;
    while (index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[index];
        if (local.kind == .param) {
            facts.parameters.add(ParameterFacts(local.id));
        }
        index = index + 1;
    }
}

FunctionFacts analyze_function(
    context.CompilerContext&! ctx,
    jil.Function function
) {
    FunctionFacts result! = FunctionFacts(function.id);
    if (function.is_external || !has_reference_parameter(ctx, function)) {
        add_conservative_parameters(result$.mut_ref(), function);
        return result;
    }
    provenance.FunctionFacts flow =
        provenance.analyze_function(function);
    Int index! = 0;
    while (index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[index];
        if (local.kind == .param) {
            result.parameters.add(analyze_parameter(
                ctx,
                function,
                local,
                flow$.ref()
            ));
        }
        index = index + 1;
    }
    return result;
}

Bool has_reference_parameter(
    context.CompilerContext&! ctx,
    jil.Function function
) {
    Int index! = 0;
    while (index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[index];
        if (local.kind == .param && is_reference_parameter(ctx, local)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool is_reference_parameter(
    context.CompilerContext&! ctx,
    jil.LocalDecl parameter
) {
    types.TypeInfo type_info = ctx.store.types.get(parameter.type_id);
    if (type_info.data is .handle_type(handle)) {
        return types.is_reference_handle(handle);
    }
    return false;
}

ParameterFacts analyze_parameter(
    context.CompilerContext&! ctx,
    jil.Function function,
    jil.LocalDecl parameter,
    provenance.FunctionFacts& flow
) {
    ParameterFacts result! = ParameterFacts(parameter.id);
    types.TypeInfo type_info = ctx.store.types.get(parameter.type_id);
    guard type_info.data is .handle_type(handle) else { return result; }
    if (!types.is_reference_handle(handle)) { return result; }

    if (!provenance.tracks_parameter_separately(parameter.id)) {
        provenance.FunctionFacts exact =
            provenance.analyze_parameter(function, parameter.id);
        return proven_parameter_facts(ctx, parameter, handle, exact$.ref());
    }
    return proven_parameter_facts(ctx, parameter, handle, flow);
}

ParameterFacts proven_parameter_facts(
    context.CompilerContext&! ctx,
    jil.LocalDecl parameter,
    types.HandleType handle,
    provenance.FunctionFacts& flow
) {
    ParameterFacts result! = ParameterFacts(parameter.id);
    types.TypeInfo type_info = ctx.store.types.get(parameter.type_id);
    result.nocapture = parameter_does_not_escape(flow, parameter.id);
    result.noalias = type_info.is_mutable;
    result.readonly = parameter_is_readonly(flow, parameter.id);
    result.dereferenceable_bytes = pointee_size(ctx, handle.element);
    return result;
}

Bool parameter_does_not_escape(
    provenance.FunctionFacts& facts,
    jil.LocalId parameter
) {
    return !facts.returned.contains_parameter(parameter)
        && !facts.stored_externally.contains_parameter(parameter)
        && !facts.passed_to_call.contains_parameter(parameter)
        && !facts.captured_by_coroutine.contains_parameter(parameter);
}

Bool parameter_is_readonly(
    provenance.FunctionFacts& facts,
    jil.LocalId parameter
) {
    return !facts.written_through.contains_parameter(parameter)
        && !facts.passed_to_call.contains_parameter(parameter)
        && !facts.captured_by_coroutine.contains_parameter(parameter);
}

Int pointee_size(context.CompilerContext&! ctx, qid.TypeId type_id) {
    if (!pointee_has_concrete_layout(ctx, type_id)) { return 0; }
    database.layout_of_type(ctx.query$.mut_ref(), ctx.store$.ref(), type_id);
    guard ctx.query.layout.layout_id_for_type(type_id) is .some(layout_id) else {
        return 0;
    }
    Int size = ctx.query.layout.layout(layout_id).size;
    if (size <= 0) { return 0; }
    return size;
}

Bool pointee_has_concrete_layout(
    context.CompilerContext&! ctx,
    qid.TypeId type_id
) {
    types.TypeInfo info = ctx.store.types.get(type_id);
    if (info.data is .invalid || info.data is .never) { return false; }
    if (info.data is .slice_value_type(_)) { return false; }
    if (info.data is .trait_companion(companion)) {
        return companion.kind != .any;
    }
    return true;
}
