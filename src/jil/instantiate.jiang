// 泛型 JIL template 到单个 concrete function body 的替换。

import compiler_store = "../store.jiang";
import def = "../resolve/def.jiang";
import generic_bindings = "../sema/generic/bindings.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import types = "../sema/type.jiang";
import qid = "../id.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import token = "../syntax/token.jiang";
import jil = "./model.jiang";
import std;

@region(a, b)
public struct Instantiator: Movable {
    @life(a)
    compiler_store.CompilerStore& store;
    @life(a)
    generic_bindings.GenericBindings& bindings;
    @life(b)
    jil.Storage& storage;
    @life(a)
    map.WyHashMap<jil.TraitVTableKey, jil.GlobalId>& trait_vtables;
    list.ArrayList<jil.LocalDecl> locals!;
    list.ArrayList<qid.TypeId> local_types!;

    public init(
        self,
        compiler_store.CompilerStore& store,
        generic_bindings.GenericBindings& bindings,
        jil.Storage& storage,
        map.WyHashMap<jil.TraitVTableKey, jil.GlobalId>& trait_vtables
    ) {
        self.store = store;
        self.bindings = bindings;
        self.storage = storage;
        self.trait_vtables = trait_vtables;
        self.locals = list.ArrayList<jil.LocalDecl>();
        self.local_types = list.ArrayList<qid.TypeId>();
    }

    qid.TypeId type_id(self, qid.TypeId value) {
        return generic_bindings.substitute_type(
            self.store.types$.ref(), value, self.bindings
        );
    }

    types.EffectSet effects(self, types.EffectSet value) {
        return generic_bindings.substitute_effects(
            self.store.types$.ref(), value, self.bindings
        );
    }

    qid.DefId const_binding_def(self, qid.DefId value) {
        if (self.bindings.const_binding_def(value) is .some(concrete)) {
            return concrete;
        }
        return value;
    }

    qid.DefId? optional_const_binding_def(self, qid.DefId? value) {
        guard value is .some(binding) else { return null; }
        return self.const_binding_def(binding);
    }

    comptime_value.ComptimeValue comptime_value(
        self,
        comptime_value.ComptimeValue value
    ) {
        if (value.data is .const_param_value(param_def)) {
            if (self.bindings.const_binding(param_def) is .some(concrete)) {
                return concrete;
            }
        }
        return value;
    }

    @life(return: self.b)
    qid.TypeId[]& type_args(self, qid.TypeId[]& values) {
        list.ArrayList<qid.TypeId> result! = list.ArrayList<qid.TypeId>(values.length);
        Int index! = 0;
        while (index < values.length) {
            result.add(self.type_id(values[index]));
            index = index + 1;
        }
        return self.storage.type_arg_array(result.slice());
    }

    @life(return: self.b)
    comptime_value.ComptimeValue[]& const_args(
        self,
        comptime_value.ComptimeValue[]& values
    ) {
        list.ArrayList<comptime_value.ComptimeValue> result! =
            list.ArrayList<comptime_value.ComptimeValue>(values.length);
        Int index! = 0;
        while (index < values.length) {
            result.add(self.comptime_value(values[index]));
            index = index + 1;
        }
        return self.storage.const_arg_array(result.slice());
    }

    @life(return: self.b)
    public types.GenericArg[]& generic_args(self, types.GenericArg[]& raw_args) {
        list.ArrayList<types.GenericArg> result! =
            list.ArrayList<types.GenericArg>(raw_args.length);
        Int index! = 0;
        while (index < raw_args.length) {
            types.GenericArg arg = raw_args[index];
            if (arg is .type_arg(type_arg)) {
                qid.TypeId concrete_type = self.type_id(type_arg.value);
                if (type_arg.param_def is .some(param_def)) {
                    result.add(types.generic_type_param_arg(param_def, concrete_type));
                } else {
                    result.add(types.generic_type_arg(concrete_type));
                }
            } else if (arg is .const_arg(const_arg)) {
                comptime_value.ComptimeValue concrete_value =
                    self.comptime_value(const_arg.value);
                qid.DefId? binding_def = self.optional_const_binding_def(
                    const_arg.binding_def
                );
                if (const_arg.param_def is .some(param_def)) {
                    result.add(types.generic_const_param_arg(
                        param_def, concrete_value, binding_def
                    ));
                } else {
                    result.add(types.generic_const_arg(
                        concrete_value, binding_def
                    ));
                }
            }
            index = index + 1;
        }
        return self.storage.generic_arg_array(result.slice());
    }

    @life(return: self.b)
    jil.Body body(Self&! self, jil.Body source, jil.BodyId body_id) {
        self.locals.clear();
        self.local_types.clear();
        Int index! = 0;
        while (index < source.locals.length) {
            jil.LocalDecl local = source.locals[index];
            qid.TypeId concrete_type = self.type_id(local.type_id);
            self.local_types.add(concrete_type);
            self.locals.add(jil.LocalDecl(
                id: local.id,
                kind: local.kind,
                type_id: concrete_type,
                span: local.span,
                name: local.name,
                def_id: local.def_id,
                mutable_local: local.mutable_local,
                address_taken: local.address_taken,
                coroutine_capture_task: local.coroutine_capture_task,
                coroutine_capture_kind: local.coroutine_capture_kind
            ));
            index = index + 1;
        }
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(source.blocks.length);
        index = 0;
        while (index < source.blocks.length) {
            blocks.add(self.block(source.blocks[index]));
            index = index + 1;
        }
        unsafe {
            jil.LocalDecl*! stored_locals = self.storage.alloc_local_array(self.locals.len());
            index = 0;
            while (index < self.locals.len()) {
                stored_locals[index] = self.locals.get(index);
                index = index + 1;
            }
            return jil.Body(
                id: body_id,
                span: source.span,
                locals: stored_locals[0..self.locals.len()],
                blocks: self.storage.block_array(blocks$.ref()),
                entry: source.entry,
                return_local: source.return_local
            );
        }
    }

    @life(return: self.b)
    jil.Block block(Self&! self, jil.Block source) {
        list.ArrayList<jil.Statement> statements! =
            list.ArrayList<jil.Statement>(source.statements.length);
        Int index! = 0;
        while (index < source.statements.length) {
            statements.add(self.statement(source.statements[index]));
            index = index + 1;
        }
        jil.Terminator terminator!;
        if (self.builtin_contiguous_terminator(source.terminator, statements$.mut_ref())
            is .some(specialized)) {
            terminator = specialized;
        } else if (self.builtin_equality_terminator(source.terminator, statements$.mut_ref())
            is .some(specialized)) {
            terminator = specialized;
        } else {
            terminator = self.terminator(source.terminator);
        }
        jil.Statement[]& stored_statements =
            self.storage.statement_array(statements$.ref());
        return jil.Block(
            id: source.id,
            span: source.span,
            statements: stored_statements,
            terminator: terminator
        );
    }

    @life(return: self.b)
    jil.Terminator? builtin_contiguous_terminator(
        Self&! self,
        jil.Terminator source,
        list.ArrayList<jil.Statement>&! statements
    ) {
        guard source.kind is .call_term(call) else { return null; }
        guard call.callee is .direct_function(function_ref) else { return null; }
        guard function_ref.target is .source(trait_member) else { return null; }
        guard function_ref.dispatch_type is .some(raw_receiver_type) else { return null; }
        qid.TypeId receiver_type = self.type_id(raw_receiver_type);
        guard self.is_builtin_contiguous_dispatch(trait_member, receiver_type) else {
            return null;
        }
        if (call.args.length == 0) { return null; }
        guard self.contiguous_storage_place(call.args[0]) is .some(storage_place) else {
            return null;
        }
        qid.TypeId value_type = self.reference_value_type(receiver_type);
        guard self.store.types.get(value_type).data is .array_type(array_type) else {
            return null;
        }
        qid.SymbolId symbol = self.store.defs.get(trait_member).name.symbol;
        if (self.store.symbols.find("ptr") is .some(ptr_symbol) && symbol == ptr_symbol) {
            self.append_array_pointer(
                source, call, storage_place, value_type, statements
            );
        } else if (self.store.symbols.find("length") is .some(length_symbol)
            && symbol == length_symbol) {
            self.append_array_length(source, call, array_type.count, statements);
        } else {
            return null;
        }
        return jil.Terminator(
            span: source.span,
            kind: jil.goto_terminator_kind(jil.GotoTerminator(
                target: call.target,
                initialized_place: self.optional_place(call.initialized_place)
            ))
        );
    }

    Bool is_builtin_contiguous_dispatch(
        self,
        qid.DefId trait_member,
        qid.TypeId receiver_type
    ) {
        guard self.store.resolve.core_traits.contiguous_trait is .some(contiguous_trait)
            else {
            return false;
        }
        guard self.store.defs.get(trait_member).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def != contiguous_trait) { return false; }
        if (self.resolve_static_dispatch(trait_member, receiver_type) != null) {
            return false;
        }
        qid.TypeId value_type = self.reference_value_type(receiver_type);
        return self.store.types.get(value_type).data is .array_type(_);
    }

    @life(return: self.b)
    jil.Place? contiguous_storage_place(self, jil.Operand source) {
        jil.Operand concrete = self.operand(source);
        guard concrete is .copy_operand(copy) else { return null; }
        list.ArrayList<jil.PlaceElem> projection! =
            list.ArrayList<jil.PlaceElem>(copy.place.projection.length + 1);
        Int index! = 0;
        while (index < copy.place.projection.length) {
            projection.add(copy.place.projection[index]);
            index = index + 1;
        }
        projection.add(jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false)));
        if (copy.place.base is .global(global_ref)) {
            return jil.global_place(
                global_ref, self.storage.projection_array(projection$.ref())
            );
        }
        return jil.local_place(
            copy.place.local_id, self.storage.projection_array(projection$.ref())
        );
    }

    Void append_array_pointer(
        Self&! self,
        jil.Terminator source,
        jil.CallTerminator call,
        jil.Place storage_place,
        qid.TypeId array_type,
        list.ArrayList<jil.Statement>&! statements
    ) {
        qid.TypeId pointer_type = self.store.types.raw_pointer_type(
            array_type, source.span
        );
        guard self.store.types.get(array_type).data is .array_type(array) else {
            return;
        }
        qid.TypeId result_type = self.store.types.raw_pointer_type(
            array.element, source.span
        );
        self.set_local_place_type(call.destination, result_type);
        jil.LocalId temp = self.add_temp(pointer_type, source.span);
        jil.Place temp_place = jil.local_place(
            temp, self.storage.empty_projection()
        );
        statements.add(jil.Statement(
            span: source.span,
            kind: jil.assign_statement_kind(jil.AssignStatement(
                destination: temp_place,
                value: jil.address_of_rvalue(jil.AddressOfRvalue(
                    mutable_pointer: false,
                    place: storage_place
                ))
            ))
        ));
        statements.add(jil.Statement(
            span: source.span,
            kind: jil.assign_statement_kind(jil.AssignStatement(
                destination: self.place(call.destination),
                value: jil.cast_rvalue(jil.CastRvalue(
                    kind: jil.CastKind.ptr_to_ptr,
                    value: jil.copy_operand_value(jil.CopyOperand(place: temp_place)),
                    target_type: result_type
                ))
            ))
        ));
    }

    Void append_array_length(
        self,
        jil.Terminator source,
        jil.CallTerminator call,
        Int count,
        list.ArrayList<jil.Statement>&! statements
    ) {
        statements.add(jil.Statement(
            span: source.span,
            kind: jil.assign_statement_kind(jil.AssignStatement(
                destination: self.place(call.destination),
                value: jil.use_rvalue(jil.UseRvalue(
                    value: jil.const_operand_value(jil.Const(
                        type_id: self.store.types.int_type(),
                        span: source.span,
                        value: jil.int_const_kind(jil.IntConst(
                            bits: UInt64(count),
                            signed_value: true
                        ))
                    ))
                ))
            ))
        ));
    }

    jil.LocalId add_temp(Self&! self, qid.TypeId type_id, token.Span span) {
        jil.LocalId local_id = jil.LocalId.from_index(self.locals.len());
        self.locals.add(jil.LocalDecl(
            id: local_id,
            kind: jil.LocalKind.compiler_temp,
            type_id: type_id,
            span: span,
            name: null,
            def_id: null,
            mutable_local: true,
            address_taken: false,
            coroutine_capture_task: null
        ));
        self.local_types.add(type_id);
        return local_id;
    }

    Void set_local_place_type(Self&! self, jil.Place place, qid.TypeId type_id) {
        if (place.base is .global(_) || place.projection.length != 0) { return; }
        Int index = place.local_id.to_index();
        if (index < 0 || index >= self.locals.len()) { return; }
        jil.LocalDecl local = self.locals.get(index);
        self.locals.set(index, jil.LocalDecl(
            id: local.id,
            kind: local.kind,
            type_id: type_id,
            span: local.span,
            name: local.name,
            def_id: local.def_id,
            mutable_local: local.mutable_local,
            address_taken: local.address_taken,
            coroutine_capture_task: local.coroutine_capture_task,
            coroutine_capture_kind: local.coroutine_capture_kind
        ));
        self.local_types.set(index, type_id);
    }

    @life(return: self.b)
    jil.Terminator? builtin_equality_terminator(
        self,
        jil.Terminator source,
        list.ArrayList<jil.Statement>&! statements
    ) {
        guard source.kind is .call_term(call) else { return null; }
        guard call.callee is .direct_function(function_ref) else { return null; }
        guard function_ref.target is .source(trait_member) else { return null; }
        guard function_ref.dispatch_type is .some(raw_receiver_type) else { return null; }
        qid.TypeId receiver_type = self.type_id(raw_receiver_type);
        if (!self.is_builtin_equality_dispatch(trait_member, receiver_type)) {
            return null;
        }
        if (call.args.length != 2) { return null; }
        guard self.equality_value_operand(call.args[0]) is .some(lhs) else { return null; }
        guard self.equality_value_operand(call.args[1]) is .some(rhs) else { return null; }
        statements.add(jil.Statement(
            span: source.span,
            kind: jil.assign_statement_kind(jil.AssignStatement(
                destination: self.place(call.destination),
                value: jil.binary_rvalue(jil.BinaryRvalue(
                    op: jil.BinaryOp.eq,
                    lhs: lhs,
                    rhs: rhs
                ))
            ))
        ));
        return jil.Terminator(
            span: source.span,
            kind: jil.goto_terminator_kind(jil.GotoTerminator(
                target: call.target,
                initialized_place: self.optional_place(call.initialized_place)
            ))
        );
    }

    Bool is_builtin_equality_dispatch(
        self,
        qid.DefId trait_member,
        qid.TypeId receiver_type
    ) {
        guard self.store.resolve.core_traits.equatable_trait is .some(equatable_trait)
            else {
            return false;
        }
        guard self.store.defs.get(trait_member).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def != equatable_trait) {
            return false;
        }
        if (self.resolve_static_dispatch(trait_member, receiver_type) != null) {
            return false;
        }
        types.TypeInfo info = self.store.types.get(receiver_type);
        if (info.data is .bool_type || info.data is .char_type
            || info.data is .int_type(_) || info.data is .float_type(_)) {
            return true;
        }
        guard info.data is .named(named) else { return false; }
        return self.store.defs.get(named.def_id).kind == .enum_def;
    }

    @life(return: self.b)
    jil.Operand? equality_value_operand(self, jil.Operand source) {
        jil.Operand concrete = self.operand(source);
        guard concrete is .copy_operand(copy) else { return null; }
        list.ArrayList<jil.PlaceElem> projection! =
            list.ArrayList<jil.PlaceElem>(copy.place.projection.length + 1);
        Int index! = 0;
        while (index < copy.place.projection.length) {
            projection.add(copy.place.projection[index]);
            index = index + 1;
        }
        projection.add(jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false)));
        jil.Place value_place!;
        if (copy.place.base is .global(global_ref)) {
            value_place = jil.global_place(
                global_ref, self.storage.projection_array(projection$.ref())
            );
        } else {
            value_place = jil.local_place(
                copy.place.local_id, self.storage.projection_array(projection$.ref())
            );
        }
        return jil.copy_operand_value(jil.CopyOperand(place: value_place));
    }

    @life(return: self.b)
    jil.Statement statement(self, jil.Statement source) {
        return jil.Statement(span: source.span, kind: self.statement_kind(source.kind));
    }

    @life(return: self.b)
    jil.StatementKind statement_kind(self, jil.StatementKind source) {
        if (source is .assign_stmt(value)) {
            return jil.assign_statement_kind(jil.AssignStatement(
                destination: self.place(value.destination),
                value: self.rvalue(value.value)
            ));
        }
        if (source is .atomic_store_stmt(value)) {
            return jil.atomic_store_statement_kind(jil.AtomicStoreStatement(
                destination: self.place(value.destination),
                value: self.operand(value.value),
                ordering: value.ordering,
                mode: value.mode
            ));
        }
        if (source is .task_suspend_stmt(value)) {
            return jil.task_suspend_statement_kind(jil.TaskSuspendStatement(
                task: self.place(value.task), mode: value.mode
            ));
        }
        if (source is .task_complete_stmt(value)) {
            return jil.task_complete_statement_kind(jil.TaskCompleteStatement(
                task: self.place(value.task),
                mode: value.mode,
                owner_lifecycle: value.owner_lifecycle
            ));
        }
        if (source is .set_discriminant_stmt(value)) {
            return jil.set_discriminant_statement_kind(jil.SetDiscriminantStatement(
                destination: self.place(value.destination),
                discriminant: value.discriminant
            ));
        }
        if (source is .forget_stmt(value)) {
            return jil.forget_statement_kind(jil.ForgetStatement(place: self.place(value.place)));
        }
        if (source is .exclusive_stmt(value)) {
            return jil.exclusive_statement_kind(jil.ExclusiveStatement(place: self.place(value.place)));
        }
        if (source is .task_consume_stmt(value)) {
            return jil.task_consume_statement_kind(jil.TaskConsumeStatement(
                task: self.place(value.task),
                task_local: value.task_local,
                user_visible: value.user_visible,
                site: value.site,
                repeatable: value.repeatable
            ));
        }
        if (source is .task_region_start_stmt(value)) {
            return jil.task_region_start_statement_kind(jil.TaskRegionStartStatement(
                task: self.place(value.task),
                task_local: value.task_local,
                storage: value.storage,
                child_resume: self.optional_function_ref(value.child_resume)
            ));
        }
        if (source is .capture_bind_stmt(value)) {
            return jil.capture_bind_statement_kind(jil.CaptureBindStatement(
                destination: self.place(value.destination),
                environment: self.place(value.environment)
            ));
        }
        if (source is .task_wait_stmt(value)) {
            return jil.task_wait_statement_kind(jil.TaskWaitStatement(
                state: self.place(value.state),
                wake: value.wake,
                expected: self.operand(value.expected)
            ));
        }
        if (source is .task_release_stmt(value)) {
            return jil.task_release_statement_kind(jil.TaskReleaseStatement(
                task: self.optional_place(value.task),
                task_pointer: self.place(value.task_pointer),
                task_local: value.task_local,
                frame: self.place(value.frame),
                state: self.place(value.state),
                result: self.place(value.result),
                result_drop: self.function_ref(value.result_drop),
                result_consumed: value.result_consumed,
                storage: value.storage
            ));
        }
        if (source is .task_owner_release_stmt(value)) {
            return jil.task_owner_release_statement_kind(jil.TaskOwnerReleaseStatement(
                pointer: self.place(value.pointer)
            ));
        }
        if (source is .executor_leave_stmt(value)) {
            return jil.executor_leave_statement_kind(value);
        }
        if (source is .storage_live_stmt(value)) {
            return jil.storage_live_statement_kind(value);
        }
        guard source is .storage_dead_stmt(value) else {
            return jil.storage_dead_statement_kind(jil.StorageDeadStatement(
                local_id: jil.LocalId.from_index(0)
            ));
        }
        return jil.storage_dead_statement_kind(value);
    }

    @life(return: self.b)
    jil.Terminator terminator(self, jil.Terminator source) {
        return jil.Terminator(span: source.span, kind: self.terminator_kind(source.kind));
    }

    @life(return: self.b)
    jil.TerminatorKind terminator_kind(self, jil.TerminatorKind source) {
        if (source is .goto_term(value)) {
            return jil.goto_terminator_kind(jil.GotoTerminator(
                target: value.target,
                initialized_place: self.optional_place(value.initialized_place)
            ));
        }
        if (source is .branch_term(value)) {
            return jil.branch_terminator_kind(jil.BranchTerminator(
                condition: self.operand(value.condition),
                then_target: value.then_target,
                else_target: value.else_target
            ));
        }
        if (source is .switch_term(value)) {
            jil.Operand discriminator = self.operand(value.discriminator);
            jil.SwitchCase[]& cases = self.switch_cases(value.cases);
            return jil.switch_terminator_kind(jil.SwitchTerminator(
                discriminator: discriminator,
                cases: cases,
                default_target: value.default_target
            ));
        }
        if (source is .call_term(value)) {
            jil.CallCallee callee = self.callee(value.callee);
            jil.Operand[]& args = self.operands(value.args);
            jil.FunctionRef? suspend_child = self.optional_function_ref(value.suspend_child);
            jil.Place destination = self.place(value.destination);
            jil.Place? initialized_place = self.optional_place(value.initialized_place);
            types.LifetimeFlow[]&? lifetime_flows =
                self.optional_lifetime_flows(value.return_lifetime_flows);
            jil.Operand[]&? lifetime_args = self.optional_operands(value.lifetime_args);
            jil.Place? lifetime_destination = self.optional_place(value.lifetime_destination);
            jil.Place[]& exclusive_places = self.places(value.exclusive_places);
            jil.DeferredAsyncTask? deferred_async_task! = null;
            if (value.deferred_async_task is .some(task)) {
                qid.TypeId? environment_type! = null;
                if (task.environment_type is .some(type_id)) {
                    environment_type = self.type_id(type_id);
                }
                deferred_async_task = jil.DeferredAsyncTask(
                    task_local: task.task_local,
                    storage: task.storage,
                    environment_type: environment_type,
                    captures: self.operands(task.captures)
                );
            }
            return jil.call_terminator_kind(jil.CallTerminator(
                callee: callee,
                args: args,
                current_effects: self.effects(value.current_effects),
                is_suspend_point: value.is_suspend_point,
                suspend_wake: value.suspend_wake,
                suspend_child: suspend_child,
                task_handoff: value.task_handoff,
                async_start: value.async_start,
                deferred_async_direct: value.deferred_async_direct,
                deferred_async_task: deferred_async_task,
                destination: destination,
                target: value.target,
                initialized_place: initialized_place,
                deferred_initialization: value.deferred_initialization,
                return_lifetime_flows: lifetime_flows,
                lifetime_args: lifetime_args,
                lifetime_destination: lifetime_destination,
                exclusive_places: exclusive_places,
                cleanup: value.cleanup
            ));
        }
        if (source is .drop_term(value)) {
            return jil.drop_terminator_kind(jil.DropTerminator(
                place: self.place(value.place), target: value.target, cleanup: value.cleanup
            ));
        }
        if (source is .assert_term(value)) {
            jil.Operand condition = self.operand(value.condition);
            jil.Operand? message = self.optional_operand(value.message);
            return jil.assert_terminator_kind(jil.AssertTerminator(
                condition: condition,
                expected: value.expected,
                source_id: value.source_id,
                source_offset: value.source_offset,
                message: message,
                target: value.target,
                cleanup: value.cleanup
            ));
        }
        if (source is .throw_term(value)) {
            return .throw_term(jil.ThrowTerminator(error_value: self.operand(value.error_value)));
        }
        if (source is .suspend_pending_term(value)) {
            return jil.suspend_pending_terminator_kind(value);
        }
        if (source is .return_term(value)) { return jil.return_terminator_kind(value); }
        if (source is .cancel_term(value)) { return jil.cancel_terminator_kind(value); }
        guard source is .unreachable_term(value) else {
            return jil.unreachable_terminator_kind(jil.UnreachableTerminator(
                generated_by_check: false
            ));
        }
        return jil.unreachable_terminator_kind(value);
    }

    @life(return: self.b)
    jil.CallCallee callee(self, jil.CallCallee source) {
        if (source is .direct_function(value)) {
            return jil.direct_function_callee(self.function_ref(value));
        }
        if (source is .indirect_operand(value)) {
            return jil.indirect_operand_callee(self.operand(value));
        }
        if (source is .domain_enqueue(value)) {
            jil.Operand? task = self.optional_operand(value.task);
            jil.Operand resume = self.operand(value.resume);
            return .domain_enqueue(jil.DomainEnqueueCallee(
                domain_def: self.const_binding_def(value.domain_def),
                domain_kind: value.domain_kind,
                task: task,
                resume: resume,
                handoff: value.handoff
            ));
        }
        guard source is .dynamic_domain_enqueue(value) else {
            return jil.indirect_operand_callee(jil.const_operand_value(jil.Const(
                type_id: qid.TypeId.from_index(0),
                span: token.Span(),
                value: jil.unit_const_kind(jil.UnitConst(unit_value: true))
            )));
        }
        jil.Operand executor = self.operand(value.executor);
        jil.Operand? task = self.optional_operand(value.task);
        jil.Operand resume = self.operand(value.resume);
        return .dynamic_domain_enqueue(jil.DynamicDomainEnqueueCallee(
            executor: executor,
            task: task,
            resume: resume,
            handoff: value.handoff,
            mode: value.mode
        ));
    }

    @life(return: self.b)
    jil.Rvalue rvalue(self, jil.Rvalue source) {
        if (source is .use_value(value)) {
            return jil.use_rvalue(jil.UseRvalue(value: self.operand(value.value)));
        }
        if (source is .unary_value(value)) {
            return jil.unary_rvalue(jil.UnaryRvalue(
                op: value.op, value: self.operand(value.value)
            ));
        }
        if (source is .binary_value(value)) {
            jil.Operand lhs = self.operand(value.lhs);
            jil.Operand rhs = self.operand(value.rhs);
            return jil.binary_rvalue(jil.BinaryRvalue(
                op: value.op,
                lhs: lhs,
                rhs: rhs
            ));
        }
        if (source is .cast_value(value)) {
            return jil.cast_rvalue(jil.CastRvalue(
                kind: value.kind,
                value: self.operand(value.value),
                target_type: self.type_id(value.target_type)
            ));
        }
        if (source is .inline_asm_value(value)) {
            return jil.inline_asm_rvalue(jil.InlineAsmRvalue(
                result_type: self.type_id(value.result_type),
                code_symbol: value.code_symbol,
                operands: self.inline_asm_operands(value.operands),
                clobbers: self.storage.symbol_id_slice(value.clobbers),
                volatile: value.volatile,
                memory: value.memory,
                noreturn: value.noreturn
            ));
        }
        if (source is .borrow_value(value)) {
            return jil.borrow_rvalue(jil.BorrowRvalue(place: self.place(value.place)));
        }
        if (source is .address_of_value(value)) {
            return jil.address_of_rvalue(jil.AddressOfRvalue(
                mutable_pointer: value.mutable_pointer, place: self.place(value.place)
            ));
        }
        if (source is .coroutine_address_value(value)) {
            return jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue(
                place: self.place(value.place), frame_root: value.frame_root
            ));
        }
        if (source is .atomic_load_value(value)) {
            return jil.atomic_load_rvalue(jil.AtomicLoadRvalue(
                place: self.place(value.place), ordering: value.ordering, mode: value.mode
            ));
        }
        if (source is .atomic_exchange_value(value)) {
            return jil.atomic_exchange_rvalue(jil.AtomicExchangeRvalue(
                place: self.place(value.place),
                desired: self.operand(value.desired),
                ordering: value.ordering,
                mode: value.mode
            ));
        }
        if (source is .atomic_compare_exchange_value(value)) {
            jil.Place place = self.place(value.place);
            jil.Operand expected = self.operand(value.expected);
            jil.Operand desired = self.operand(value.desired);
            return jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue(
                place: place,
                expected: expected,
                desired: desired,
                success_ordering: value.success_ordering,
                failure_ordering: value.failure_ordering,
                mode: value.mode
            ));
        }
        if (source is .alloc_box_value(value)) {
            return jil.alloc_box_rvalue(jil.AllocBoxRvalue(
                value_type: self.type_id(value.value_type)
            ));
        }
        if (source is .coroutine_frame_alloc_value(value)) {
            return jil.coroutine_frame_alloc_rvalue(jil.CoroutineFrameAllocRvalue(
                value_type: self.type_id(value.value_type),
                executor: self.operand(value.executor)
            ));
        }
        if (source is .alloc_value(value)) {
            return jil.alloc_rvalue(jil.AllocValueRvalue(
                value_type: self.type_id(value.value_type),
                value: self.operand(value.value)
            ));
        }
        if (source is .alloc_array_value(value)) {
            return jil.alloc_array_rvalue(jil.AllocArrayRvalue(
                element_type: self.type_id(value.element_type),
                count: self.operand(value.count)
            ));
        }
        if (source is .free_value(value)) {
            return jil.free_rvalue(jil.FreeRvalue(pointer: self.operand(value.pointer)));
        }
        if (source is .coroutine_frame_free_value(value)) {
            jil.Operand pointer = self.operand(value.pointer);
            jil.Operand executor = self.operand(value.executor);
            return jil.coroutine_frame_free_rvalue(jil.CoroutineFrameFreeRvalue(
                pointer: pointer,
                executor: executor
            ));
        }
        if (source is .slice_value(value)) {
            jil.Place base = self.place(value.base);
            jil.Operand? start = self.optional_operand(value.start);
            jil.Operand? end = self.optional_operand(value.end);
            return jil.slice_rvalue(jil.SliceRvalue(
                base: base,
                start: start,
                end: end
            ));
        }
        if (source is .len_value(value)) {
            return jil.len_rvalue(jil.LenRvalue(place: self.place(value.place)));
        }
        if (source is .discriminant_value(value)) {
            return jil.discriminant_rvalue(jil.DiscriminantRvalue(
                place: self.place(value.place)
            ));
        }
        if (source is .layout_value(value)) {
            return jil.layout_rvalue(jil.LayoutValueRvalue(
                kind: value.kind, type_id: self.type_id(value.type_id)
            ));
        }
        if (source is .aggregate_value(value)) {
            jil.Operand? tag = self.optional_operand(value.tag);
            jil.Operand[]& fields = self.operands(value.fields);
            return jil.aggregate_rvalue(jil.AggregateRvalue(
                kind: value.kind,
                def_id: value.def_id,
                type_id: self.type_id(value.type_id),
                tag: tag,
                fields: fields
            ));
        }
        if (source is .closure_value(value)) {
            jil.Place? stack_environment = self.optional_place(value.stack_environment);
            jil.Operand[]& captures = self.operands(value.captures);
            return jil.closure_rvalue(jil.ClosureRvalue(
                lambda_def: value.lambda_def,
                args: self.generic_args(value.args),
                closure_type: self.type_id(value.closure_type),
                environment_type: self.type_id(value.environment_type),
                vtable_type: self.type_id(value.vtable_type),
                storage: value.storage,
                environment_storage: value.environment_storage,
                stack_environment: stack_environment,
                captures: captures
            ));
        }
        if (source is .optional_value(value)) {
            return jil.optional_rvalue(jil.OptionalRvalue(
                op: value.op, value: self.operand(value.value)
            ));
        }
        if (source is .error_union_value(value)) {
            return jil.error_union_rvalue(jil.ErrorUnionRvalue(
                op: value.op, value: self.operand(value.value)
            ));
        }
        if (source is .domain_executor_value(value)) {
            return jil.domain_executor_rvalue(jil.DomainExecutorRvalue(
                domain_def: self.const_binding_def(value.domain_def),
                domain_kind: value.domain_kind
            ));
        }
        if (source is .current_executor_value(value)) { return jil.current_executor_rvalue(value); }
        if (source is .scheduled_continuation_resume_value(value)) {
            return jil.scheduled_continuation_resume_rvalue(value);
        }
        if (source is .executor_enter_value(value)) { return jil.executor_enter_rvalue(value); }
        guard source is .current_task_value(value) else {
            return jil.current_task_rvalue(jil.CurrentTaskRvalue(
                observed: false, cancellation_context: false
            ));
        }
        return jil.current_task_rvalue(value);
    }

    @life(return: self.b)
    jil.Operand operand(self, jil.Operand source) {
        if (source is .copy_operand(value)) {
            return jil.copy_operand_value(jil.CopyOperand(place: self.place(value.place)));
        }
        if (source is .move_operand(value)) {
            return jil.move_operand_value(jil.MoveOperand(place: self.place(value.place)));
        }
        if (source is .out_operand(value)) {
            return jil.out_operand_value(jil.OutOperand(place: self.place(value.place)));
        }
        if (source is .function_operand(value)) {
            return jil.function_operand_value(self.function_ref(value));
        }
        if (source is .global_operand(value)) {
            return jil.global_operand_value(self.global_ref(value));
        }
        if (source is .global_address_operand(value)) {
            return jil.global_address_operand_value(self.global_ref(value));
        }
        if (source is .trait_vtable_operand(value)) {
            qid.TypeId subject_type = self.type_id(value.key.subject_type);
            jil.TraitVTableKey key = jil.TraitVTableKey(
                value.key.trait_def, subject_type
            );
            if (self.trait_vtables.get(key) is .some(global_id)) {
                return jil.global_address_operand_value(jil.GlobalRef(
                    id: global_id$.get(),
                    type_id: self.type_id(value.type_id)
                ));
            }
            return jil.trait_vtable_operand_value(jil.TraitVTableRef(
                key: key,
                type_id: self.type_id(value.type_id),
                span: value.span
            ));
        }
        guard source is .const_operand(value) else {
            return jil.const_operand_value(jil.Const(
                type_id: qid.TypeId.from_index(0),
                span: token.Span(),
                value: jil.unit_const_kind(jil.UnitConst(unit_value: true))
            ));
        }
        return jil.const_operand_value(self.constant(value));
    }

    jil.Const constant(self, jil.Const source) {
        qid.TypeId concrete_type = self.type_id(source.type_id);
        if (source.value is .const_param(param)) {
            if (self.bindings.const_binding(param.def_id) is .some(value)) {
                return self.constant_from_comptime(value, concrete_type, source.span);
            }
        }
        return jil.Const(type_id: concrete_type, span: source.span, value: source.value);
    }

    jil.Const constant_from_comptime(
        self,
        comptime_value.ComptimeValue source,
        qid.TypeId type_id,
        token.Span span
    ) {
        if (source.data is .unit_value) {
            return jil.Const(type_id: type_id, span: span,
                value: jil.unit_const_kind(jil.UnitConst(unit_value: true)));
        }
        if (source.data is .bool_value(value)) {
            return jil.Const(type_id: type_id, span: span,
                value: jil.bool_const_kind(jil.BoolConst(value: value)));
        }
        if (source.data is .int_value(value)) {
            return jil.Const(type_id: type_id, span: span, value: jil.int_const_kind(
                jil.IntConst(bits: unsafe { value$.as(UInt64) }, signed_value: true)
            ));
        }
        if (source.data is .uint_value(value)) {
            return jil.Const(type_id: type_id, span: span,
                value: jil.int_const_kind(jil.IntConst(bits: value, signed_value: false)));
        }
        if (source.data is .char_value(value)) {
            return jil.Const(type_id: type_id, span: span,
                value: jil.int_const_kind(jil.IntConst(bits: value, signed_value: false)));
        }
        if (source.data is .const_param_value(param_def)) {
            return jil.Const(type_id: type_id, span: span,
                value: jil.const_param_kind(jil.ConstParam(def_id: param_def)));
        }
        return jil.Const(type_id: type_id, span: span,
            value: jil.unit_const_kind(jil.UnitConst(unit_value: true)));
    }

    @life(return: self.b)
    jil.FunctionRef function_ref(self, jil.FunctionRef source) {
        qid.TypeId? dispatch_type! = null;
        jil.FunctionTarget target! = source.target;
        Bool uses_trait_default! = false;
        types.GenericArg[]& concrete_args! = self.generic_args(source.args);
        if (source.dispatch_type is .some(raw_dispatch_type)) {
            qid.TypeId concrete_dispatch_type = self.type_id(raw_dispatch_type);
            dispatch_type = concrete_dispatch_type;
            if (source.target is .source(trait_member)) {
                if (self.resolve_static_dispatch(trait_member, concrete_dispatch_type)
                    is .some(impl_member)) {
                    target = .source(impl_member);
                    dispatch_type = null;
                    uses_trait_default = impl_member == trait_member;
                    if (!uses_trait_default) {
                        concrete_args = self.retarget_trait_args(
                            trait_member,
                            impl_member,
                            concrete_dispatch_type,
                            concrete_args
                        );
                    }
                }
            }
        }
        qid.TypeId concrete_function_type = self.function_ref_type(
            target, concrete_args, self.type_id(source.type_id)
        );
        return jil.FunctionRef(
            target: target,
            dispatch_type: dispatch_type,
            args: concrete_args,
            coroutine_start: source.coroutine_start,
            coroutine_sync: source.coroutine_sync,
            coroutine_resume: source.coroutine_resume,
            coroutine_completion: source.coroutine_completion,
            type_id: concrete_function_type
        );
    }

    qid.TypeId function_ref_type(
        self,
        jil.FunctionTarget target,
        types.GenericArg[]& args,
        qid.TypeId caller_type
    ) {
        guard target is .source(function_def) else { return caller_type; }
        return generic_bindings.type_for_instance(
            self.store.defs$.ref(),
            self.store.model$.ref(),
            self.store.types$.ref(),
            function_def,
            caller_type,
            args
        );
    }

    @life(return: self.b)
    types.GenericArg[]& retarget_trait_args(
        self,
        qid.DefId trait_member,
        qid.DefId impl_member,
        qid.TypeId receiver_type,
        types.GenericArg[]& args
    ) {
        list.ArrayList<types.GenericArg> result! = list.ArrayList<types.GenericArg>();
        self.append_receiver_args(impl_member, receiver_type, result$.mut_ref());
        Int index! = 0;
        while (index < self.store.model.def_generic_param_count(trait_member)
            && index < self.store.model.def_generic_param_count(impl_member)) {
            qid.DefId source_param =
                self.store.model.def_generic_param_at(trait_member, index);
            qid.DefId target_param =
                self.store.model.def_generic_param_at(impl_member, index);
            if (self.generic_arg_for_param(args, source_param) is .some(arg)) {
                result.add(self.retarget_arg(target_param, arg));
            }
            index = index + 1;
        }
        return self.storage.generic_arg_array(result.slice());
    }

    types.GenericArg? generic_arg_for_param(
        self,
        types.GenericArg[]& args,
        qid.DefId param_def
    ) {
        Int index! = 0;
        while (index < args.length) {
            types.GenericArg arg = args[index];
            if (arg is .type_arg(type_arg)) {
                if (type_arg.param_def is .some(source_param)
                    && source_param == param_def) {
                    return arg;
                }
            }
            if (arg is .const_arg(const_arg)) {
                if (const_arg.param_def is .some(source_param)
                    && source_param == param_def) {
                    return arg;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Void append_receiver_args(
        self,
        qid.DefId impl_member,
        qid.TypeId receiver_type,
        list.ArrayList<types.GenericArg>&! result
    ) {
        guard self.store.defs.get(impl_member).owner_def is .some(owner_def) else {
            return;
        }
        qid.TypeId value_type = self.reference_value_type(receiver_type);
        types.TypeInfo info = self.store.types.get(value_type);
        guard info.data is .named(named) else { return; }
        if (named.def_id != owner_def) { return; }
        Int index! = 0;
        while (index < named.args.length
            && index < self.store.model.def_generic_param_count(owner_def)) {
            qid.DefId param_def =
                self.store.model.def_generic_param_at(owner_def, index);
            result.add(self.retarget_arg(param_def, named.args[index]));
            index = index + 1;
        }
    }

    qid.TypeId reference_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .handle_type(handle) && handle.kind == .reference) {
            return handle.element;
        }
        return type_id;
    }

    types.GenericArg retarget_arg(self, qid.DefId param_def, types.GenericArg arg) {
        if (arg is .type_arg(type_arg)) {
            return types.generic_type_param_arg(param_def, type_arg.value);
        }
        guard arg is .const_arg(const_arg) else { return arg; }
        return types.generic_const_param_arg(
            param_def, const_arg.value, const_arg.binding_def
        );
    }

    qid.DefId? resolve_static_dispatch(
        self,
        qid.DefId trait_member,
        qid.TypeId receiver_type
    ) {
        guard self.namespace_provider(receiver_type) is .some(provider_def) else {
            return null;
        }
        Int index! = 0;
        while (index < self.store.model.def_member_count(provider_def)) {
            qid.DefId member_def = self.store.model.def_member_at(provider_def, index);
            def.DefRecord member = self.store.defs.get(member_def);
            if (member.associated_trait_member is .some(implemented)) {
                if (implemented == trait_member) { return member_def; }
            }
            index = index + 1;
        }
        index = 0;
        while (index < self.store.defs.len()) {
            qid.DefId candidate = qid.DefId.from_index(index);
            def.DefRecord member = self.store.defs.get(candidate);
            if (member.owner_def is .some(owner_def) && owner_def == provider_def) {
                if (member.associated_trait_member is .some(implemented)) {
                    if (implemented == trait_member) { return candidate; }
                }
            }
            index = index + 1;
        }
        if (self.store.model.has_body(trait_member)) { return trait_member; }
        return null;
    }

    qid.DefId? namespace_provider(self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .named(named)) { return named.def_id; }
        if (info.data is .handle_type(handle) && handle.kind == .reference) {
            return self.namespace_provider(handle.element);
        }
        if (info.data is .bool_type) { return self.store.resolve.core_types.bool_type; }
        if (info.data is .char_type) { return self.store.resolve.core_types.char_type; }
        if (info.data is .int_type(int_type)) {
            return self.integer_namespace_provider(int_type);
        }
        if (info.data is .float_type(float_type)) {
            return self.float_namespace_provider(float_type);
        }
        if (info.data is .array_type(array_type)) {
            if (array_type.sentinel != null) {
                return self.store.resolve.core_types.sentinel_array_type;
            }
            return self.store.resolve.core_types.array_type;
        }
        if (info.data is .slice_value_type(slice_type)) {
            if (slice_type.sentinel != null) {
                return self.store.resolve.core_types.sentinel_slice_type;
            }
            return self.store.resolve.core_types.slice_type;
        }
        if (self.store.types.type_owner_def(type_id) is .some(owner_def)) {
            return owner_def;
        }
        return null;
    }

    qid.DefId? integer_namespace_provider(self, types.IntType int_type) {
        if (int_type.bits == 0) {
            if (int_type.signed) { return self.store.resolve.core_types.int_type; }
            return self.store.resolve.core_types.uint_type;
        }
        if (int_type.bits == 8) {
            if (int_type.signed) { return self.store.resolve.core_types.int8_type; }
            return self.store.resolve.core_types.uint8_type;
        }
        if (int_type.bits == 16) {
            if (int_type.signed) { return self.store.resolve.core_types.int16_type; }
            return self.store.resolve.core_types.uint16_type;
        }
        if (int_type.bits == 32) {
            if (int_type.signed) { return self.store.resolve.core_types.int32_type; }
            return self.store.resolve.core_types.uint32_type;
        }
        if (int_type.bits == 64) {
            if (int_type.signed) { return self.store.resolve.core_types.int64_type; }
            return self.store.resolve.core_types.uint64_type;
        }
        return null;
    }

    qid.DefId? float_namespace_provider(self, types.FloatType float_type) {
        if (float_type.bits == 16) {
            return self.store.resolve.core_types.float16_type;
        }
        if (float_type.bits == 32) {
            return self.store.resolve.core_types.float_type;
        }
        if (float_type.bits == 64) {
            return self.store.resolve.core_types.double_type;
        }
        return null;
    }

    jil.GlobalRef global_ref(self, jil.GlobalRef source) {
        return jil.GlobalRef(id: source.id, type_id: self.type_id(source.type_id));
    }

    @life(return: self.b)
    jil.Place place(self, jil.Place source) {
        list.ArrayList<jil.PlaceElem> projections! =
            list.ArrayList<jil.PlaceElem>(source.projection.length);
        qid.TypeId current_type! = self.place_base_type(source);
        Int index! = 0;
        while (index < source.projection.length) {
            jil.PlaceElem projection = self.projection_for_owner(
                source.projection[index], current_type
            );
            projections.add(projection);
            current_type = self.projection_result_type(current_type, projection);
            index = index + 1;
        }
        if (source.base is .global(value)) {
            return jil.global_place(self.global_ref(value),
                self.storage.projection_array(projections$.ref()));
        }
        return jil.local_place(source.local_id,
            self.storage.projection_array(projections$.ref()));
    }

    qid.TypeId place_base_type(self, jil.Place source) {
        if (source.base is .global(value)) { return self.type_id(value.type_id); }
        Int index = source.local_id.to_index();
        if (index < 0 || index >= self.local_types.len()) {
            return self.store.types.invalid_type();
        }
        return self.local_types.get(index);
    }

    jil.PlaceElem projection_for_owner(
        self,
        jil.PlaceElem source,
        qid.TypeId owner_type
    ) {
        if (source is .field_projection(value)) {
            return jil.field_projection_elem(jil.FieldProjection(
                field_def: value.field_def,
                field_type: self.field_type_for_owner(
                    owner_type, value.field_def, value.field_type
                )
            ));
        }
        return self.projection(source);
    }

    qid.TypeId field_type_for_owner(
        self,
        qid.TypeId owner_type,
        qid.DefId field_def,
        qid.TypeId fallback
    ) {
        types.TypeInfo owner_info = self.store.types.get(owner_type);
        guard owner_info.data is .named(named) else { return self.type_id(fallback); }
        guard self.store.typeck.def_type(field_def) is .some(field_type) else {
            return self.type_id(fallback);
        }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings field_bindings =
            generic_bindings.bindings_for_instance(
                self.store.defs$.ref(),
                self.store.model$.ref(),
                self.store.types$.ref(),
                field_def,
                named.args,
                empty$.ref()
            );
        return generic_bindings.substitute_type(
            self.store.types$.ref(), field_type, field_bindings$.ref()
        );
    }

    qid.TypeId projection_result_type(
        self,
        qid.TypeId owner_type,
        jil.PlaceElem projection
    ) {
        if (projection is .field_projection(field)) { return field.field_type; }
        if (projection is .frame_field_projection(field)) { return field.field_type; }
        types.TypeInfo info = self.store.types.get(owner_type);
        if (projection is .deref_projection(_)) {
            guard info.data is .handle_type(handle) else {
                return self.store.types.invalid_type();
            }
            return handle.element;
        }
        if (projection is .index_projection(_)
            || projection is .constant_index_projection(_)) {
            if (info.data is .array_type(array)) { return array.element; }
            if (info.data is .slice_value_type(slice)) { return slice.element; }
        }
        return owner_type;
    }

    jil.PlaceElem projection(self, jil.PlaceElem source) {
        if (source is .field_projection(value)) {
            return jil.field_projection_elem(jil.FieldProjection(
                field_def: value.field_def,
                field_type: self.type_id(value.field_type)
            ));
        }
        if (source is .frame_field_projection(value)) {
            return jil.frame_field_projection_elem(jil.FrameFieldProjection(
                field_index: value.field_index,
                field_type: self.type_id(value.field_type)
            ));
        }
        if (source is .deref_projection(value)) { return jil.deref_projection_elem(value); }
        if (source is .index_projection(value)) { return jil.index_projection_elem(value); }
        if (source is .constant_index_projection(value)) {
            return jil.constant_index_projection_elem(value);
        }
        guard source is .subslice_projection(value) else {
            return jil.deref_projection_elem(jil.DerefProjection(raw_pointer: false));
        }
        return jil.subslice_projection_elem(value);
    }

    @life(return: (self.b, self.b))
    jil.Operand[]& operands(self, jil.Operand[]& source) {
        list.ArrayList<jil.Operand> result! = list.ArrayList<jil.Operand>(source.length);
        Int index! = 0;
        while (index < source.length) {
            result.add(self.operand(source[index]));
            index = index + 1;
        }
        return self.storage.operand_array(result$.ref());
    }

    @life(return: (self.b, self.b))
    jil.Operand[]&? optional_operands(self, jil.Operand[]&? source) {
        if (source is .some(value)) { return self.operands(value); }
        return null;
    }

    @life(return: self.b)
    jil.Operand? optional_operand(self, jil.Operand? source) {
        if (source is .some(value)) { return self.operand(value); }
        return null;
    }

    @life(return: (self.b, self.b))
    jil.Place[]& places(self, jil.Place[]& source) {
        list.ArrayList<jil.Place> result! = list.ArrayList<jil.Place>(source.length);
        Int index! = 0;
        while (index < source.length) {
            result.add(self.place(source[index]));
            index = index + 1;
        }
        return self.storage.place_array(result$.ref());
    }

    @life(return: self.b)
    jil.Place? optional_place(self, jil.Place? source) {
        if (source is .some(value)) { return self.place(value); }
        return null;
    }

    @life(return: self.b)
    jil.FunctionRef? optional_function_ref(self, jil.FunctionRef? source) {
        if (source is .some(value)) { return self.function_ref(value); }
        return null;
    }

    @life(return: self.b)
    jil.SwitchCase[]& switch_cases(self, jil.SwitchCase[]& source) {
        list.ArrayList<jil.SwitchCase> result! = list.ArrayList<jil.SwitchCase>(source.length);
        Int index! = 0;
        while (index < source.length) {
            result.add(jil.SwitchCase(
                value: self.constant(source[index].value), target: source[index].target
            ));
            index = index + 1;
        }
        return self.storage.switch_case_array(result$.ref());
    }

    @life(return: (self.b, self.b))
    jil.InlineAsmOperand[]& inline_asm_operands(
        self,
        jil.InlineAsmOperand[]& source
    ) {
        list.ArrayList<jil.InlineAsmOperand> result! =
            list.ArrayList<jil.InlineAsmOperand>(source.length);
        Int index! = 0;
        while (index < source.length) {
            jil.InlineAsmOperand value = source[index];
            if (value is .input(input)) {
                result.add(.input(jil.InlineAsmInput(
                    constraint_symbol: input.constraint_symbol,
                    value: self.operand(input.value)
                )));
            } else if (value is .output(output)) {
                result.add(.output(jil.InlineAsmOutput(
                    constraint_symbol: output.constraint_symbol,
                    type_id: self.type_id(output.type_id)
                )));
            }
            index = index + 1;
        }
        return self.storage.inline_asm_operand_array(result$.ref());
    }

    @life(return: self.b)
    types.LifetimeFlow[]&? optional_lifetime_flows(
        self,
        types.LifetimeFlow[]&? source
    ) {
        if (source is .none) { return null; }
        list.ArrayList<types.LifetimeFlow> result! = list.ArrayList<types.LifetimeFlow>();
        types.LifetimeFlow[]& values = source$.some();
        Int index! = 0;
        while (index < values.length) {
            result.add(values[index]);
            index = index + 1;
        }
        return self.storage.lifetime_flow_array(result$.ref());
    }
}

@life(return: (storage, storage))
public jil.Function instantiate_function(
    compiler_store.CompilerStore& store,
    generic_bindings.GenericBindings& bindings,
    jil.Storage& storage,
    map.WyHashMap<jil.TraitVTableKey, jil.GlobalId>& trait_vtables,
    jil.Function template,
    jil.FunctionId function_id,
    types.GenericArg[]& args
) {
    Instantiator instantiator! = Instantiator(
        store, bindings, storage, trait_vtables
    );
    qid.TypeId? capture_env_type! = null;
    if (template.coroutine_capture_env_type is .some(type_id)) {
        capture_env_type = instantiator.type_id(type_id);
    }
    return jil.Function(
        id: function_id,
        origin: template.origin,
        args: storage.generic_arg_array(args),
        signature_id: template.signature_id,
        effects: instantiator.effects(template.effects),
        is_coroutine: template.is_coroutine,
        coroutine_capture_env_type: capture_env_type,
        coroutine_frame: null,
        confinement: template.confinement,
        confinement_domain: instantiator.optional_const_binding_def(
            template.confinement_domain
        ),
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: template.is_language_entry,
        is_runtime_entry: template.is_runtime_entry,
        is_external: template.is_external,
        inline_always: template.inline_always,
        naked: template.naked,
        span: template.span,
        body: instantiator.body(
            template.body, jil.BodyId.from_index(function_id.to_index())
        )
    );
}
