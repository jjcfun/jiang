// JIL package、Function、Global、Body、Local 与 Block 模型。

import * = "./id.jiang";
import * = "./place.jiang";
import * = "./coroutine.jiang";
import * = "./control_flow.jiang";
import qid = "../../id.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";

@region(a)
public struct Module: Copyable {
    public qid.ModuleId module_id;

    @life(a, a, a)
    public Function[]& functions;

    @life(a, a)
    public Global[]& globals;
}

@region(a, b)
public struct Function: Copyable {
    public FunctionId id;
    public FunctionOrigin origin;

    @life(a)
    public types.GenericArg[]& args;
    public qid.SignatureId? signature_id;
    public types.EffectSet effects;
    public Bool is_coroutine;
    // Source lowering 已知的 closure capture environment。它可以含泛型参数，
    // concrete frame 固化时使用实例化后的类型，不能从擦除后的 env parameter 反推。
    public qid.TypeId? coroutine_capture_env_type = null;

    @life(b)
    public CoroutineFrameLayout? coroutine_frame;
    public CoroutineConfinement confinement = .escaping;
    public qid.DefId? confinement_domain = null;
    public Bool is_coroutine_resume;
    public CoroutineResumeMode coroutine_resume_mode = .standard;
    public Bool is_coroutine_completion;
    public Bool is_language_entry;
    public Bool is_runtime_entry;
    public Bool is_external;
    public Bool inline_always;
    public Bool naked;
    public token.Span span;
    @life(b)
    public Body body;
}

@region(a, b)
public struct CoroutineResumeTemplate: Copyable {
    @life(a, b)
    public Function function;
    public LocalId frame_local_id;
    public LocalId resume_return_local_id;
}

@life(return: (source.a, source.b & body))
public Function function_with_body(Function source, Body body) {
    return Function(
        id: source.id,
        origin: source.origin,
        args: source.args,
        signature_id: source.signature_id,
        effects: source.effects,
        is_coroutine: source.is_coroutine,
        coroutine_capture_env_type: source.coroutine_capture_env_type,
        coroutine_frame: source.coroutine_frame,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: source.is_coroutine_resume,
        coroutine_resume_mode: source.coroutine_resume_mode,
        is_coroutine_completion: source.is_coroutine_completion,
        is_language_entry: source.is_language_entry,
        is_runtime_entry: source.is_runtime_entry,
        is_external: source.is_external,
        inline_always: source.inline_always,
        naked: source.naked,
        span: source.span,
        body: body
    );
}

@life(return: (source.a, source.b & coroutine_frame))
public Function function_with_coroutine_frame(
    Function source,
    CoroutineFrameLayout? coroutine_frame
) {
    return Function(
        id: source.id,
        origin: source.origin,
        args: source.args,
        signature_id: source.signature_id,
        effects: source.effects,
        is_coroutine: source.is_coroutine,
        coroutine_capture_env_type: source.coroutine_capture_env_type,
        coroutine_frame: coroutine_frame,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: source.is_coroutine_resume,
        coroutine_resume_mode: source.coroutine_resume_mode,
        is_coroutine_completion: source.is_coroutine_completion,
        is_language_entry: source.is_language_entry,
        is_runtime_entry: source.is_runtime_entry,
        is_external: source.is_external,
        inline_always: source.inline_always,
        naked: source.naked,
        span: source.span,
        body: source.body
    );
}

@life(return: (source.a, source.b))
public Function function_with_confinement(
    Function source,
    CoroutineConfinement confinement,
    qid.DefId? confinement_domain
) {
    return Function(
        id: source.id,
        origin: source.origin,
        args: source.args,
        signature_id: source.signature_id,
        effects: source.effects,
        is_coroutine: source.is_coroutine,
        coroutine_capture_env_type: source.coroutine_capture_env_type,
        coroutine_frame: source.coroutine_frame,
        confinement: confinement,
        confinement_domain: confinement_domain,
        is_coroutine_resume: source.is_coroutine_resume,
        coroutine_resume_mode: source.coroutine_resume_mode,
        is_coroutine_completion: source.is_coroutine_completion,
        is_language_entry: source.is_language_entry,
        is_runtime_entry: source.is_runtime_entry,
        is_external: source.is_external,
        inline_always: source.inline_always,
        naked: source.naked,
        span: source.span,
        body: source.body
    );
}

@life(return: (source.a, source.b))
public Function function_with_coroutine_resume_mode(
    Function source,
    CoroutineResumeMode mode
) {
    return Function(
        id: source.id,
        origin: source.origin,
        args: source.args,
        signature_id: source.signature_id,
        effects: source.effects,
        is_coroutine: source.is_coroutine,
        coroutine_capture_env_type: source.coroutine_capture_env_type,
        coroutine_frame: source.coroutine_frame,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: source.is_coroutine_resume,
        coroutine_resume_mode: mode,
        is_coroutine_completion: source.is_coroutine_completion,
        is_language_entry: source.is_language_entry,
        is_runtime_entry: source.is_runtime_entry,
        is_external: source.is_external,
        inline_always: source.inline_always,
        naked: source.naked,
        span: source.span,
        body: source.body
    );
}

public union FunctionOrigin: Copyable {
    qid.DefId source;
    GeneratedFunctionOrigin generated;
}

public struct GeneratedFunctionOrigin: Copyable {
    public GeneratedNameId name;
    public qid.ModuleId? module_id;
    public GeneratedFunctionKind kind;
    public qid.DefId provenance_def;
    public qid.TypeId? identity_type;
}

public qid.DefId function_provenance_def(FunctionOrigin origin) {
    if (origin is .source(def_id)) { return def_id; }
    guard origin is .generated(generated) else {
        return qid.DefId.from_index(0);
    }
    return generated.provenance_def;
}

public qid.DefId? function_source_def(FunctionOrigin origin) {
    if (origin is .source(def_id)) { return def_id; }
    return null;
}

public GeneratedFunctionOrigin? function_generated_origin(FunctionOrigin origin) {
    if (origin is .generated(generated)) { return generated; }
    return null;
}


@region(a)
public struct Global: Copyable {
    public GlobalId id;
    public GlobalOrigin origin;
    public qid.TypeId type_id;
    public token.Span span;
    public Bool read_only;
    public Bool is_external;

    // null 表示外部 global 或无需静态 initializer。
    @life(a)
    public StaticValue? initializer;
}

public union GlobalOrigin: Copyable {
    qid.DefId source;
    GeneratedGlobalOrigin generated;
}

public struct GeneratedGlobalOrigin: Copyable {
    public GeneratedNameId name;
    public qid.ModuleId? module_id;
    public GeneratedGlobalKind kind;
    public qid.DefId provenance_def;
    public qid.TypeId? identity_type;
}


// canonical Domain binding 对应的 compiler-generated descriptor 与 const config。
public struct DomainExecutorDescriptor: Copyable {
    public GlobalRef descriptor;
    public GlobalRef domain_config;
}

@region(a)
public struct StaticField: Copyable {
    public qid.TypeId type_id;

    @life(a)
    public StaticValue value;
}

@region(a)
public union StaticValue: Copyable {
    public Const scalar;

    @life(a, a)
    public StaticField[]& aggregate;

    @life(a)
    public FunctionRef function;
    public GlobalRef global_address;
}

@life()
public StaticValue scalar_static_value(Const value) {
    return .scalar(value);
}

@life(return: value)
public StaticValue function_static_value(FunctionRef value) {
    return .function(value);
}

@life()
public StaticValue global_address_static_value(GlobalRef value) {
    return .global_address(value);
}

@region(a)
public struct Body: Copyable {
    public BodyId id;
    public token.Span span;

    @life(a)
    public LocalDecl[]& locals;

    @life(a, a)
    public Block[]& blocks;
    public BlockId entry;
    public LocalId return_local;
}

public enum LocalKind {
    return_place,
    param,
    user_local,
    compiler_temp,
}

public enum CoroutineCaptureKind {
    task_frame,
    task_waiter,
    task_external_continuation,
    auxiliary,
}

public struct LocalDecl: Copyable {
    public LocalId id;
    public LocalKind kind;
    public qid.TypeId type_id;
    public token.Span span;

    // 有源码名字的 param/local 指向 name interner；临时值和返回位置为 null。
    public qid.SymbolId? name;

    // 有对应声明或绑定的 local 指向 DefId；编译器临时值为 null。
    public qid.DefId? def_id;

    // true 表示这个 local 可以被重新赋值或通过可变 place 写入。
    public Bool mutable_local;

    // true 表示这个 local 可能被取地址、借用或捕获，后续优化不能随意替换为纯值。
    public Bool address_taken;

    // 编译器生成的 async capture 指针链所属 Task；用户 local 永远为 null。
    public LocalId? coroutine_capture_task = null;

    // capture 在 scoped Task storage 中的角色，用于 region 级 frame slot 规划。
    public CoroutineCaptureKind? coroutine_capture_kind = null;

}

@region(a)
public struct Block: Copyable {
    public BlockId id;
    public token.Span span;

    @life(a, a)
    public Statement[]& statements;

    @life(a)
    public Terminator terminator;
}
