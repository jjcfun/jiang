// JIL package、Function、Global、Body、Local 与 Block 模型。

import * = "./id.jiang";
import * = "./place.jiang";
import * = "./coroutine.jiang";
import * = "./control_flow.jiang";
import qid = "../../id.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";

@region(a)
public struct Module: Copyable {
    public qid.ModuleId module_id;

    @life(a, a, a, a, a)
    public Function[]& functions;

    @life(a, a)
    public Global[]& globals;
}

@region(a, b, c, d)
public struct Function: Copyable {
    public FunctionId id;
    public qid.DefId def_id;

    // 空数组表示普通非泛型函数；非空表示这个 Function 是泛型函数的
    // concrete instance。
    @life(a)
    public qid.TypeId[]& type_args;

    @life(b, c)
    public comptime_value.ComptimeValue[]& const_args;
    public qid.SignatureId? signature_id;
    public types.EffectSet effects;
    public Bool is_coroutine;

    @life(d)
    public CoroutineFrameLayout? coroutine_frame;
    public CoroutineConfinement confinement = .escaping;
    public qid.DefId? confinement_domain = null;
    public Bool is_coroutine_resume;
    public Bool is_coroutine_completion;
    public Bool is_language_entry;
    public Bool is_runtime_entry;
    public Bool is_external;
    public Bool inline_always;
    public Bool naked;
    public token.Span span;
    @life(d)
    public Body body;
}


@region(a)
public struct Global: Copyable {
    public GlobalId id;
    public qid.DefId def_id;
    public qid.TypeId type_id;
    public token.Span span;
    public Bool read_only;
    public Bool is_external;

    // null 表示外部 global 或无需静态 initializer。
    @life(a)
    public StaticValue? initializer;
}

@region(a)
public struct StaticField: Copyable {
    public qid.TypeId type_id;

    @life(a)
    public StaticValue value;
}

@region(a)
public union StaticValue: Copyable {
    public Const scalar;

    @life(a, a)
    public StaticField[]& aggregate;

    @life(a)
    public FunctionRef function;
    public GlobalRef global_address;
}

@life()
public StaticValue scalar_static_value(Const value) {
    return .scalar(value);
}

@life(return: value)
public StaticValue function_static_value(FunctionRef value) {
    return .function(value);
}

@life()
public StaticValue global_address_static_value(GlobalRef value) {
    return .global_address(value);
}

@region(a)
public struct Body: Copyable {
    public BodyId id;
    public token.Span span;

    @life(a)
    public LocalDecl[]& locals;

    @life(a, a)
    public Block[]& blocks;
    public BlockId entry;
    public LocalId return_local;
}

public enum LocalKind {
    return_place,
    param,
    user_local,
    compiler_temp,
}

public enum CoroutineCaptureKind {
    task_frame,
    task_waiter,
    task_external_continuation,
    auxiliary,
}

public struct LocalDecl: Copyable {
    public LocalId id;
    public LocalKind kind;
    public qid.TypeId type_id;
    public token.Span span;

    // 有源码名字的 param/local 指向 name interner；临时值和返回位置为 null。
    public qid.SymbolId? name;

    // 有对应声明或绑定的 local 指向 DefId；编译器临时值为 null。
    public qid.DefId? def_id;

    // true 表示这个 local 可以被重新赋值或通过可变 place 写入。
    public Bool mutable_local;

    // true 表示这个 local 可能被取地址、借用或捕获，后续优化不能随意替换为纯值。
    public Bool address_taken;

    // 编译器生成的 async capture 指针链所属 Task；用户 local 永远为 null。
    public LocalId? coroutine_capture_task = null;

    // capture 在 scoped Task storage 中的角色，用于 region 级 frame slot 规划。
    public CoroutineCaptureKind? coroutine_capture_kind = null;

}

@region(a)
public struct Block: Copyable {
    public BlockId id;
    public token.Span span;

    @life(a, a)
    public Statement[]& statements;

    @life(a)
    public Terminator terminator;
}
