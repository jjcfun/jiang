// JIL coroutine frame、Task storage、ABI 与恢复状态模型。

import * = "./id.jiang";
import * = "./place.jiang";
import qid = "../../id.jiang";
import types = "../../sema/type.jiang";

public enum CoroutineFrameFieldKind {
    state,
    return_slot,
    continuation_result,
    continuation_context,
    continuation_function,
    continuation_executor,
    current_executor,
    external_continuation,
    capture_env,
    param,
    local,
    temp,
}

public struct CoroutineFrameField: Copyable {
    public CoroutineFrameFieldKind kind;
    public qid.TypeId type_id;
    public LocalId? local_id;
    public Bool live_across_suspend;
    public Bool needs_drop;
}

@region(a)
public struct CoroutineFrameLayout: Copyable {
    public qid.TypeId frame_type_id;
    public TaskAbiLayout task_abi;
    @life(a)
    public CoroutineFrameField[]& fields;

    @life(a)
    public CoroutineLocalFrameField[]& local_mappings;

    @life(a)
    public CoroutineSuspendPoint[]& suspend_points;

    @life(a, a)
    public TaskRegion[]& task_regions;

    @life(a)
    public CoroutineStateDispatch state_dispatch;
    public BlockId cancellation_entry;
    public Int state_field_index;
    public Int return_field_index;
    public Int continuation_result_field_index;
    public Int continuation_context_field_index;
    public Int continuation_function_field_index;
    public Int continuation_executor_field_index;
    public Int current_executor_field_index;
    public Int cancellation_enabled_field_index;
    public Int cancellation_context_field_index;
    public Int external_continuation_field_index;
    public Int capture_env_field_index;
    public Int domain_kind;
    public types.EffectSet effects;
    // false 表示该协程及其传递 child 不会等待未来事件，可以整体同步执行。
    public Bool may_defer = true;
}

@life(return: source)
public CoroutineFrameLayout coroutine_frame_with_runtime_properties(
    CoroutineFrameLayout source,
    Int domain_kind,
    Bool may_defer
) {
    return CoroutineFrameLayout (
        frame_type_id: source.frame_type_id,
        task_abi: source.task_abi,
        fields: source.fields,
        local_mappings: source.local_mappings,
        suspend_points: source.suspend_points,
        task_regions: source.task_regions,
        state_dispatch: source.state_dispatch,
        cancellation_entry: source.cancellation_entry,
        state_field_index: source.state_field_index,
        return_field_index: source.return_field_index,
        continuation_result_field_index: source.continuation_result_field_index,
        continuation_context_field_index: source.continuation_context_field_index,
        continuation_function_field_index: source.continuation_function_field_index,
        continuation_executor_field_index: source.continuation_executor_field_index,
        current_executor_field_index: source.current_executor_field_index,
        cancellation_enabled_field_index: source.cancellation_enabled_field_index,
        cancellation_context_field_index: source.cancellation_context_field_index,
        external_continuation_field_index: source.external_continuation_field_index,
        capture_env_field_index: source.capture_env_field_index,
        domain_kind: domain_kind,
        effects: source.effects,
        may_defer: may_defer
    );
}

// preserving 表示：如果当前 Job 进入函数时已经由单一串行 executor
// 独占，那么函数及其全部可达 suspend 边不会把该 Job 暴露给其他线程。
// 这只是函数体摘要，不代表每个调用上下文本身都 fully-confined。
public enum CoroutineConfinement {
    preserving,
    escaping,
}

public struct CoroutineInstanceProperties: Copyable {
    public CoroutineConfinement confinement;
    public qid.DefId? confinement_domain;
}

public enum TaskAllocationStorage {
    local,
    heap,
}

public enum TaskFrameStorage {
    local,
    heap,
    external,
}

public enum TaskSyncMode {
    local_serial,
    concurrent,
}

// 描述 suspend 后谁可能让当前 Job 再次运行。它与 Task completion 的
// local_serial/concurrent 正交：完成通知可以是本地的，但被调用协程仍可能
// 经由外部线程或其他 executor 唤醒同一个 Job。
public enum SuspendWakeKind {
    none,
    direct_child,
    task_child,
    cross_executor,
    external,
    dynamic,
    arbitrary,
}

public enum TaskReclaimPolicy {
    parent,
    self_owned,
}

public struct TaskStoragePlan: Copyable {
    public TaskAllocationStorage allocation;
    public TaskFrameStorage frame;
    public TaskSyncMode sync;
    public TaskReclaimPolicy reclaim;
}

@region(a)
public struct TaskRegion: Copyable {
    public LocalId task_local;
    public BlockId origin_block;
    public Int origin_statement_index;
    public BlockId? release_block!;
    public Int release_statement_index!;
    public Int consume_count!;
    public Int release_count!;
    public TaskStoragePlan storage;
    // 已知内部 Task 的 resume 函数。fully-confined 分析沿此边做固定点；
    // external/dynamic Task 保持 null，并按保守路径处理。
    @life(a)
    public FunctionRef? child_resume;
}

public struct ExternalContinuationLayout: Copyable {
    public qid.TypeId type_id;
    public qid.TypeId pointer_type_id;
    public Int result_field_index;
    public Int context_field_index;
    public Int resume_field_index;
    public Int executor_field_index;
    public Int target_context_field_index;
    public Int target_resume_field_index;
    public Int cancellation_context_field_index;
}

public struct SuspendContinuationLayout: Copyable {
    public qid.TypeId type_id;
    public qid.TypeId pointer_type_id;
    public Int result_field_index;
    public Int context_field_index;
    public Int resume_field_index;
    public Int executor_field_index;
    public Int phase_field_index;
    public Int cancel_request_pointer_field_index;
    public Int cancel_word_pointer_field_index;
    public Int handler_context_field_index;
    public Int handler_function_field_index;
    public Int handler_drop_field_index;
    public Int fallback_cancel_request_field_index;
    public Int fallback_cancel_word_field_index;
    public Int task_field_index;
}

public struct TaskAbiLayout: Copyable {
    public qid.TypeId task_type_id;
    public qid.TypeId task_state_type_id;
    public qid.TypeId task_state_pointer_type_id;
    public qid.TypeId result_type_id;
    public qid.TypeId frame_pointer_type_id;
    public qid.TypeId resume_return_type_id;
    public qid.TypeId resume_function_type_id;
    public TaskWaiterLayout waiter_layout;
    public SuspendContinuationLayout suspend_layout;
    public qid.TypeId blocking_ack_pointer_type_id;
    public qid.TypeId bool_type_id;
    // 0 running，1 completed-with-result，3 completed-without-result；其余值为 waiter 指针，
    // 低位 0 表示 async waiter record，低位 1 表示 blocking ack word。
    public AggregateField state_field;
    public AggregateField frame_field;
    public AggregateField resume_function_field;
    public AggregateField execution_executor_field;
    public AggregateField result_field;
    public AggregateField cancellation_requested_field;
    // Pointer-sized atomic word: 0 inactive, 1 handler, 2 claimed, 3 passive suspend, otherwise TaskState*.
    public AggregateField cancel_target_word_field;
    // 0 stack, 1 heap-running+owner, 2 heap-completed+owner,
    // 3 heap-running-ownerless, 4 heap-consumed+owner, 5 cleanup claimed;
    // 6 stack+execution-lease, 7/8 heap-running+execution-lease with owner/ownerless.
    public AggregateField lifetime_state_field;
    public AggregateField cleanup_function_field;
    public AggregateField schedule_state_field;
    public AggregateField schedule_executor_field;
    public AggregateField schedule_context_field;
    public AggregateField schedule_resume_field;
    public AggregateField schedule_active_executor_field;
}

public struct TaskWaiterLayout: Copyable {
    public qid.TypeId type_id;
    public qid.TypeId pointer_type_id;
    public Int context_field_index;
    public Int resume_field_index;
    public Int executor_field_index;
    public Int task_field_index;
}

public struct TaskStateLayout: Copyable {
    public qid.TypeId type_id;
    // runtime 直接把 TaskState* 解释为此前缀；result 之前的字段顺序属于内部 ABI。
    public AggregateField schedule_state;
    public AggregateField schedule_executor;
    public AggregateField schedule_context;
    public AggregateField schedule_resume;
    public AggregateField schedule_active_executor;
    public AggregateField state;
    public AggregateField frame;
    public AggregateField resume_function;
    public AggregateField execution_executor;
    public AggregateField cancellation_requested;
    public AggregateField cancel_target_word;
    public AggregateField lifetime_state;
    public AggregateField cleanup_function;
    // custom ExecutorJob 复用的固定 storage，避免 Task 每次入队再分配 wrapper。
    public AggregateField executor_job_group;
    public AggregateField executor_job_context;
    public AggregateField executor_job_callback;
    public AggregateField executor_job_executor;
    public AggregateField executor_job_next;
    public AggregateField executor_job_storage_kind;
    public AggregateField result;
}

public struct AggregateField: Copyable {
    public qid.TypeId type_id;
    public Int index;
}

public struct CoroutineLocalFrameField: Copyable {
    public LocalId local_id;
    public Int field_index;
}

public struct CoroutineSuspendPoint: Copyable {
    public Int state_id;
    public BlockId block_id;
    public BlockId resume_target;
}

@region(a)
public struct CoroutineStateDispatch: Copyable {
    public Int entry_state_id;
    public Int completed_state_id;
    @life(a)
    public CoroutineResumeCase[]& resume_cases;
}

public struct CoroutineResumeCase: Copyable {
    public Int state_id;
    public BlockId target;
}
