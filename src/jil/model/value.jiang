// JIL Rvalue 及其运算、分配、原子操作和聚合模型。

import * = "./id.jiang";
import * = "./place.jiang";
import qid = "../../id.jiang";
import types = "../../sema/type.jiang";

public enum AtomicOrdering {
    relaxed,
    acquire,
    release,
    acquire_release,
    sequentially_consistent,
}

public enum AtomicMode {
    // 用户 Atomic<T> 语义，任何协程特化都不得改写。
    user_atomic,
    // 编译器生成的 Job/cancel/continuation 同步；并发变体保留原子操作。
    coroutine_atomic,
    // fully-confined 变体中的同一协议，backend 生成普通 load/store/RMW。
    coroutine_local,
}

@region(a)
public union Rvalue: Copyable {
    @life(a)
    UseRvalue use_value;

    @life(a)
    UnaryRvalue unary_value;

    @life(a)
    BinaryRvalue binary_value;

    @life(a)
    CastRvalue cast_value;

    @life(a)
    InlineAsmRvalue inline_asm_value;

    @life(a)
    BorrowRvalue borrow_value;

    @life(a)
    AddressOfRvalue address_of_value;

    @life(a)
    CoroutineAddressRvalue coroutine_address_value;
    DomainExecutorRvalue domain_executor_value;
    CurrentExecutorRvalue current_executor_value;
    ScheduledContinuationResumeRvalue scheduled_continuation_resume_value;
    ExecutorEnterRvalue executor_enter_value;
    CurrentTaskRvalue current_task_value;

    @life(a)
    AtomicLoadRvalue atomic_load_value;

    @life(a)
    AtomicExchangeRvalue atomic_exchange_value;

    @life(a)
    AtomicCompareExchangeRvalue atomic_compare_exchange_value;
    AllocBoxRvalue alloc_box_value;

    @life(a)
    CoroutineFrameAllocRvalue coroutine_frame_alloc_value;

    @life(a)
    AllocValueRvalue alloc_value;

    @life(a)
    AllocArrayRvalue alloc_array_value;

    @life(a)
    FreeRvalue free_value;

    @life(a)
    CoroutineFrameFreeRvalue coroutine_frame_free_value;

    @life(a)
    SliceRvalue slice_value;

    @life(a)
    LenRvalue len_value;

    @life(a)
    DiscriminantRvalue discriminant_value;

    LayoutValueRvalue layout_value;

    @life(a)
    AggregateRvalue aggregate_value;

    @life(a)
    ClosureRvalue closure_value;

    @life(a)
    OptionalRvalue optional_value;

    @life(a)
    ErrorUnionRvalue error_union_value;
}

public Rvalue use_rvalue(UseRvalue value) {
    return .use_value(value);
}

public Rvalue unary_rvalue(UnaryRvalue value) {
    return .unary_value(value);
}

public Rvalue binary_rvalue(BinaryRvalue value) {
    return .binary_value(value);
}

public Rvalue cast_rvalue(CastRvalue value) {
    return .cast_value(value);
}

public Rvalue inline_asm_rvalue(InlineAsmRvalue value) {
    return .inline_asm_value(value);
}

public Rvalue borrow_rvalue(BorrowRvalue value) {
    return .borrow_value(value);
}

public Rvalue address_of_rvalue(AddressOfRvalue value) {
    return .address_of_value(value);
}

public Rvalue coroutine_address_rvalue(CoroutineAddressRvalue value) {
    return .coroutine_address_value(value);
}

@life()
public Rvalue domain_executor_rvalue(DomainExecutorRvalue value) {
    return .domain_executor_value(value);
}

@life()
public Rvalue current_executor_rvalue(CurrentExecutorRvalue value) {
    return .current_executor_value(value);
}

@life()
public Rvalue scheduled_continuation_resume_rvalue(ScheduledContinuationResumeRvalue value) {
    return .scheduled_continuation_resume_value(value);
}

@life()
public Rvalue executor_enter_rvalue(ExecutorEnterRvalue value) {
    return .executor_enter_value(value);
}

@life()
public Rvalue current_task_rvalue(CurrentTaskRvalue value) {
    return .current_task_value(value);
}

public Rvalue atomic_load_rvalue(AtomicLoadRvalue value) {
    return .atomic_load_value(value);
}

public Rvalue atomic_exchange_rvalue(AtomicExchangeRvalue value) {
    return .atomic_exchange_value(value);
}

public Rvalue atomic_compare_exchange_rvalue(AtomicCompareExchangeRvalue value) {
    return .atomic_compare_exchange_value(value);
}

@life()
public Rvalue alloc_box_rvalue(AllocBoxRvalue value) {
    return .alloc_box_value(value);
}

public Rvalue coroutine_frame_alloc_rvalue(CoroutineFrameAllocRvalue value) {
    return .coroutine_frame_alloc_value(value);
}

public Rvalue alloc_rvalue(AllocValueRvalue value) {
    return .alloc_value(value);
}

public Rvalue alloc_array_rvalue(AllocArrayRvalue value) {
    return .alloc_array_value(value);
}

public Rvalue free_rvalue(FreeRvalue value) {
    return .free_value(value);
}

public Rvalue coroutine_frame_free_rvalue(CoroutineFrameFreeRvalue value) {
    return .coroutine_frame_free_value(value);
}

public Rvalue slice_rvalue(SliceRvalue value) {
    return .slice_value(value);
}

public Rvalue len_rvalue(LenRvalue value) {
    return .len_value(value);
}

public Rvalue discriminant_rvalue(DiscriminantRvalue value) {
    return .discriminant_value(value);
}

@life()
public Rvalue layout_rvalue(LayoutValueRvalue value) {
    return .layout_value(value);
}

public Rvalue error_union_rvalue(ErrorUnionRvalue value) {
    return .error_union_value(value);
}

public Rvalue optional_rvalue(OptionalRvalue value) {
    return .optional_value(value);
}

public Rvalue aggregate_rvalue(AggregateRvalue value) {
    return .aggregate_value(value);
}

public Rvalue closure_rvalue(ClosureRvalue value) {
    return .closure_value(value);
}

@region(a)
public struct UseRvalue: Copyable {
    @life(a)
    public Operand value;
}

public enum UnaryOp {
    neg,
    bit_not,
    logic_not,
}

@region(a)
public struct UnaryRvalue: Copyable {
    public UnaryOp op;

    @life(a)
    public Operand value;
}

public enum BinaryOp {
    add,
    sub,
    mul,
    div,
    rem,
    bit_and,
    bit_or,
    bit_xor,
    shl,
    shr,
    eq,
    ne,
    lt,
    le,
    gt,
    ge,
    structural_eq,
    structural_ne,
}

@region(a)
public struct BinaryRvalue: Copyable {
    public BinaryOp op;

    @life(a)
    public Operand lhs;

    @life(a)
    public Operand rhs;
}

public enum CastKind {
    int_to_int,
    int_to_float,
    float_to_int,
    float_to_float,
    ptr_to_ptr,
    ptr_to_int,
    int_to_ptr,
    bitcast,
}

@region(a)
public struct CastRvalue: Copyable {
    public CastKind kind;

    @life(a)
    public Operand value;
    public qid.TypeId target_type;
}

@region(a)
public struct InlineAsmRvalue: Copyable {
    public qid.TypeId result_type;
    public qid.SymbolId code_symbol;

    @life(a, a)
    public InlineAsmOperand[]& operands;

    @life(a)
    public qid.SymbolId[]& clobbers;
    public Bool volatile;
    public Bool memory;
    public Bool noreturn;
}

@region(a)
public union InlineAsmOperand: Copyable {
    @life(a)
    InlineAsmInput input;
    InlineAsmOutput output;
}

@region(a)
public struct InlineAsmInput: Copyable {
    public qid.SymbolId constraint_symbol;

    @life(a)
    public Operand value;
}

public struct InlineAsmOutput: Copyable {
    public qid.SymbolId constraint_symbol;
    public qid.TypeId type_id;
}

@region(a)
public struct BorrowRvalue: Copyable {
    @life(a)
    public Place place;
}

@region(a)
public struct AddressOfRvalue: Copyable {
    public Bool mutable_pointer;

    @life(a)
    public Place place;
}

@region(a)
public struct CoroutineAddressRvalue: Copyable {
    @life(a)
    public Place place;
    // frame_root 由 coroutine rewrite 解析为当前协程 frame 根地址，place 仅用于携带源位置。
    public Bool frame_root;
}

public struct DomainExecutorRvalue: Copyable {
    public qid.DefId domain_def;
    public Int domain_kind;
}

public struct CurrentExecutorRvalue: Copyable {
}

public struct ScheduledContinuationResumeRvalue: Copyable {
}

public struct ExecutorEnterRvalue: Copyable {
    public LocalId executor;
    public LocalId context;
}

public struct CurrentTaskRvalue: Copyable {
    public Bool observed;
    public Bool cancellation_context;
}

@region(a)
public struct AtomicLoadRvalue: Copyable {
    @life(a)
    public Place place;
    public AtomicOrdering ordering = .acquire;
    public AtomicMode mode = .user_atomic;
}

@region(a)
public struct AtomicExchangeRvalue: Copyable {
    @life(a)
    public Place place;

    @life(a)
    public Operand desired;
    public AtomicOrdering ordering = .acquire_release;
    public AtomicMode mode = .user_atomic;
}

@region(a)
public struct AtomicCompareExchangeRvalue: Copyable {
    @life(a)
    public Place place;

    @life(a)
    public Operand expected;

    @life(a)
    public Operand desired;
    public AtomicOrdering success_ordering = .acquire_release;
    public AtomicOrdering failure_ordering = .acquire;
    public AtomicMode mode = .user_atomic;
}

public struct AllocBoxRvalue: Copyable {
    public qid.TypeId value_type;
}

@region(a)
public struct CoroutineFrameAllocRvalue: Copyable {
    public qid.TypeId value_type;

    @life(a)
    public Operand executor;
}

@region(a)
public struct AllocValueRvalue: Copyable {
    public qid.TypeId value_type;

    @life(a)
    public Operand value;
}

@region(a)
public struct AllocArrayRvalue: Copyable {
    public qid.TypeId element_type;

    @life(a)
    public Operand count;
}

@region(a)
public struct FreeRvalue: Copyable {
    @life(a)
    public Operand pointer;
}

@region(a)
public struct CoroutineFrameFreeRvalue: Copyable {
    @life(a)
    public Operand pointer;

    @life(a)
    public Operand executor;
}

@region(a)
public struct SliceRvalue: Copyable {
    @life(a)
    public Place base;

    @life(a)
    public Operand? start;

    @life(a)
    public Operand? end;
}

@region(a)
public struct LenRvalue: Copyable {
    @life(a)
    public Place place;
}

@region(a)
public struct DiscriminantRvalue: Copyable {
    @life(a)
    public Place place;
}

public enum LayoutValueKind {
    size,
    align,
    max_align,
}

public struct LayoutValueRvalue: Copyable {
    public LayoutValueKind kind;
    public qid.TypeId type_id;
}

public enum AggregateKind {
    tuple,
    array,
    struct_value,
    enum_case,
    union_variant,
}

@region(a)
public struct AggregateRvalue: Copyable {
    public AggregateKind kind;
    public qid.DefId? def_id;
    public qid.TypeId type_id;

    @life(a)
    public Operand? tag;

    @life(a, a)
    public Operand[]& fields;
}

public enum ClosureEnvironmentStorage {
    stack,
    heap,
}

@region(a)
public struct ClosureRvalue: Copyable {
    public qid.DefId lambda_def;

    @life(a)
    public types.GenericArg[]& args;

    public qid.TypeId closure_type;
    public qid.TypeId environment_type;
    public qid.TypeId vtable_type;
    public ClosureEnvironmentStorage storage;
    public ClosureEnvironmentStorage environment_storage;

    @life(a)
    public Place? stack_environment;

    @life(a, a)
    public Operand[]& captures;

}

public enum OptionalOp {
    make_some,
    make_none,
    unwrap_some,
    is_some,
}

@region(a)
public struct OptionalRvalue: Copyable {
    public OptionalOp op;

    @life(a)
    public Operand value;
}

public enum ErrorUnionOp {
    make_value,
    make_error,
    unwrap_value,
    unwrap_error,
    is_error,
}

@region(a)
public struct ErrorUnionRvalue: Copyable {
    public ErrorUnionOp op;

    @life(a)
    public Operand value;
}
