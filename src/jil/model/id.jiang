// JIL 的稳定 ID 与 concrete function instance key。

import qid = "../../id.jiang";
import core_traits = "../../core/traits.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import traits = "../../support/traits.jiang";

@region(a)
public struct FunctionKey: Copyable, Hashable, Equatable {
    // concrete JIL instance 的 session-local key。
    public qid.DefId def_id;
    @life(a)
    public types.GenericArg[]& args;

    public init(self, qid.DefId def_id, types.GenericArg[]& args) {
        self.def_id = def_id;
        self.args = args;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.def_id.to_index()));
        hasher.write(Int(self.args.length));
        Int index! = 0;
        while (index < self.args.length) {
            write_generic_arg_hash(hasher, self.args[index]);
            index = index + 1;
        }
    }

    public Bool equal(FunctionKey& lhs, FunctionKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.args.length != rhs.args.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.args.length) {
            if (!generic_arg_equal(lhs.args[index], rhs.args[index])) { return false; }
            index = index + 1;
        }
        return true;
    }
}

public Void write_generic_arg_hash<H: core_traits.Hasher>(H&! hasher, types.GenericArg arg) {
    if (arg is .type_arg(value)) {
        hasher.write(UInt8(0));
        write_optional_def_hash(hasher, value.param_def);
        hasher.write(Int(value.value.to_index()));
        return;
    }
    guard arg is .const_arg(value) else { return; }
    hasher.write(UInt8(1));
    write_optional_def_hash(hasher, value.param_def);
    write_optional_def_hash(hasher, value.binding_def);
    comptime_value.write_hash(hasher, value.value);
}

Void write_optional_def_hash<H: core_traits.Hasher>(H&! hasher, qid.DefId? value) {
    if (value is .some(def_id)) {
        hasher.write(UInt8(1));
        hasher.write(Int(def_id.to_index()));
        return;
    }
    hasher.write(UInt8(0));
}

public Bool generic_arg_equal(types.GenericArg lhs, types.GenericArg rhs) {
    if (lhs is .type_arg(lhs_type)) {
        guard rhs is .type_arg(rhs_type) else { return false; }
        return lhs_type.param_def == rhs_type.param_def
            && lhs_type.value == rhs_type.value;
    }
    guard lhs is .const_arg(lhs_const) else { return false; }
    guard rhs is .const_arg(rhs_const) else { return false; }
    return lhs_const.param_def == rhs_const.param_def
        && lhs_const.binding_def == rhs_const.binding_def
        && comptime_value.equal(lhs_const.value, rhs_const.value);
}

public struct FunctionId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public FunctionId from_index(Int index) {
        return FunctionId(index);
    }
}

// TemplateId 只索引 Program.templates，不能传给 concrete function API。
public struct TemplateId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public TemplateId from_index(Int index) {
        return TemplateId(index);
    }
}

