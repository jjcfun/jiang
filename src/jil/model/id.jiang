// JIL 的稳定 ID 与 concrete function instance key。

import qid = "../../id.jiang";
import core_traits = "../../core/traits.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import traits = "../../support/traits.jiang";

@region(a, b)
public struct FunctionKey: Copyable, Hashable, Equatable {
    // JIL 层自己的 instance key，避免 jil.jiang 依赖 sema/monomorph。
    // 形状和 monomorph.InstanceKey 保持一致，backend 后续也会从这里派生符号。
    public qid.DefId def_id;
    @life(a)
    public qid.TypeId[]& type_args;

    @life(b)
    public comptime_value.ComptimeValue[]& const_args;

    public init(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        unsafe {
            comptime_value.ComptimeValue*! empty = unsafe {
                comptime_value.ComptimeValue$.alloc(1)
            };
            self.def_id = def_id;
            self.type_args = type_args;
            self.const_args = empty[0..0];
        }
    }

    public init(self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        self.def_id = def_id;
        self.type_args = type_args;
        self.const_args = const_args;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.def_id.to_index()));
        hasher.write(Int(self.type_args.length));
        Int index! = 0;
        while (index < self.type_args.length) {
            hasher.write(Int(self.type_args[index].to_index()));
            index = index + 1;
        }
        hasher.write(Int(self.const_args.length));
        index = 0;
        while (index < self.const_args.length) {
            write_comptime_value_hash(hasher, self.const_args[index]);
            index = index + 1;
        }
    }

    public Bool equal(FunctionKey& lhs, FunctionKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return comptime_value_slices_equal(lhs.const_args, rhs.const_args);
    }
}

Void write_comptime_value_hash<H: core_traits.Hasher>(H&! hasher, comptime_value.ComptimeValue value) {
    comptime_value.write_hash(hasher, value);
}

Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    return comptime_value.equal(lhs, rhs);
}

public struct FunctionId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public FunctionId from_index(Int index) {
        return FunctionId(index);
    }
}

