// JIL Statement、Terminator 与 CFG successor 模型。

import * = "./id.jiang";
import * = "./place.jiang";
import * = "./value.jiang";
import * = "./coroutine.jiang";
import qid = "../../store/id.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";

@region(a)
public struct Statement: Copyable {
    public token.Span span;

    @life(a)
    public StatementKind kind;
}

@region(a)
public union StatementKind: Copyable {
    @life(a)
    AssignStatement assign_stmt;

    @life(a)
    AtomicStoreStatement atomic_store_stmt;
    ExecutorLeaveStatement executor_leave_stmt;

    @life(a)
    TaskSuspendStatement task_suspend_stmt;

    @life(a)
    TaskCompleteStatement task_complete_stmt;
    StorageLiveStatement storage_live_stmt;
    StorageDeadStatement storage_dead_stmt;

    @life(a)
    SetDiscriminantStatement set_discriminant_stmt;

    @life(a)
    ForgetStatement forget_stmt;

    @life(a)
    ExclusiveStatement exclusive_stmt;

    @life(a)
    TaskConsumeStatement task_consume_stmt;

    @life(a)
    TaskRegionStartStatement task_region_start_stmt;

    @life(a)
    TaskReleaseStatement task_release_stmt;

    @life(a)
    TaskOwnerReleaseStatement task_owner_release_stmt;

    @life(a)
    TaskWaitStatement task_wait_stmt;
}

public StatementKind assign_statement_kind(AssignStatement statement) {
    return .assign_stmt(statement);
}

public StatementKind atomic_store_statement_kind(AtomicStoreStatement statement) {
    return .atomic_store_stmt(statement);
}

@life()
public StatementKind executor_leave_statement_kind(ExecutorLeaveStatement statement) {
    return .executor_leave_stmt(statement);
}

public StatementKind task_suspend_statement_kind(TaskSuspendStatement statement) {
    return .task_suspend_stmt(statement);
}

public StatementKind task_complete_statement_kind(TaskCompleteStatement statement) {
    return .task_complete_stmt(statement);
}

@life()
public StatementKind storage_live_statement_kind(StorageLiveStatement statement) {
    return .storage_live_stmt(statement);
}

@life()
public StatementKind storage_dead_statement_kind(StorageDeadStatement statement) {
    return .storage_dead_stmt(statement);
}

public StatementKind set_discriminant_statement_kind(SetDiscriminantStatement statement) {
    return .set_discriminant_stmt(statement);
}

public StatementKind forget_statement_kind(ForgetStatement statement) {
    return .forget_stmt(statement);
}

public StatementKind exclusive_statement_kind(ExclusiveStatement statement) {
    return .exclusive_stmt(statement);
}

public StatementKind task_consume_statement_kind(TaskConsumeStatement statement) {
    return .task_consume_stmt(statement);
}

public StatementKind task_region_start_statement_kind(TaskRegionStartStatement statement) {
    return .task_region_start_stmt(statement);
}

public StatementKind task_wait_statement_kind(TaskWaitStatement statement) {
    return .task_wait_stmt(statement);
}

@region(a)
public struct TaskWaitStatement: Copyable {
    @life(a)
    public Place state;
    public Bool wake;

    @life(a)
    public Operand expected;
}

@region(a)
public struct TaskConsumeStatement: Copyable {
    @life(a)
    public Place task;
    // 与 Task storage place 分离的编译期 identity。嵌套 Task 字段使用 synthetic local，
    // 避免同一聚合中的多个 Task 被 region/frame planner 合并。
    public LocalId? task_local = null;
    // 只有源程序中的 await/cancel_and_await 参与“结果只能消费一次”诊断。
    // 编译器生成的结构化清理 join 不应被当成第二次用户消费。
    public Bool user_visible;
    // 同一个 await site 因协程恢复 CFG 被再次分析时不构成第二次源码消费。
    public Int site;
    public Bool repeatable;
}

@region(a)
public struct TaskRegionStartStatement: Copyable {
    @life(a)
    public Place task;
    public LocalId task_local;
    public TaskStoragePlan storage;

    @life(a)
    public FunctionRef? child_resume;
}

public StatementKind task_release_statement_kind(TaskReleaseStatement statement) {
    return .task_release_stmt(statement);
}

public StatementKind task_owner_release_statement_kind(
    TaskOwnerReleaseStatement statement
) {
    return .task_owner_release_stmt(statement);
}

@region(a)
public struct TaskReleaseStatement: Copyable {
    @life(a)
    public Place task_pointer;
    public LocalId? task_local = null;

    @life(a)
    public Place frame;
    // 完成字同时发布 readiness 与结果是否存在，释放路径无需第二个原子标记。
    @life(a)
    public Place state;

    @life(a)
    public Place result;

    @life(a)
    public FunctionRef result_drop;
    public Bool result_consumed;
    public TaskStoragePlan storage;
}

@region(a)
public struct TaskOwnerReleaseStatement: Copyable {
    @life(a)
    public Place pointer;
}

@region(a)
public struct AssignStatement: Copyable {
    @life(a)
    public Place destination;

    @life(a)
    public Rvalue value;
}

@region(a)
public struct AtomicStoreStatement: Copyable {
    @life(a)
    public Place destination;

    @life(a)
    public Operand value;
    public AtomicOrdering ordering = .release;
    public AtomicMode mode = .user_atomic;
}

public struct ExecutorLeaveStatement: Copyable {
    public LocalId executor;
    public LocalId previous_context;
}

public enum CoroutineTaskMode {
    concurrent,
    local,
}

@region(a)
public struct TaskSuspendStatement: Copyable {
    @life(a)
    public Place task;
    public CoroutineTaskMode mode = .concurrent;
}

@region(a)
public struct TaskCompleteStatement: Copyable {
    @life(a)
    public Place task;
    public CoroutineTaskMode mode = .concurrent;
    public Bool owner_lifecycle = false;
}

@region(a)
public struct ExclusiveStatement: Copyable {
    @life(a)
    public Place place;
}

@region(a)
public struct ForgetStatement: Copyable {
    @life(a)
    public Place place;
}

public struct StorageLiveStatement: Copyable {
    public LocalId local_id;
}

public struct StorageDeadStatement: Copyable {
    public LocalId local_id;
}

@region(a)
public struct SetDiscriminantStatement: Copyable {
    @life(a)
    public Place destination;
    public Int discriminant;
}

@region(a)
public struct Terminator: Copyable {
    public token.Span span;

    @life(a)
    public TerminatorKind kind;
}

@region(a)
public union TerminatorKind: Copyable {
    GotoTerminator goto_term;

    @life(a)
    BranchTerminator branch_term;

    @life(a)
    SwitchTerminator switch_term;

    @life(a)
    CallTerminator call_term;

    @life(a)
    DropTerminator drop_term;

    @life(a)
    AssertTerminator assert_term;
    SuspendPendingTerminator suspend_pending_term;
    ReturnTerminator return_term;
    CancelTerminator cancel_term;

    @life(a)
    ThrowTerminator throw_term;
    UnreachableTerminator unreachable_term;
}

@life()
public TerminatorKind goto_terminator_kind(GotoTerminator terminator) {
    return .goto_term(terminator);
}

public TerminatorKind branch_terminator_kind(BranchTerminator terminator) {
    return .branch_term(terminator);
}

public TerminatorKind call_terminator_kind(CallTerminator terminator) {
    return .call_term(terminator);
}

public TerminatorKind switch_terminator_kind(SwitchTerminator terminator) {
    return .switch_term(terminator);
}

public TerminatorKind drop_terminator_kind(DropTerminator terminator) {
    return .drop_term(terminator);
}

public TerminatorKind assert_terminator_kind(AssertTerminator terminator) {
    return .assert_term(terminator);
}

@life()
public TerminatorKind suspend_pending_terminator_kind(SuspendPendingTerminator terminator) {
    return .suspend_pending_term(terminator);
}

@life()
public TerminatorKind return_terminator_kind(ReturnTerminator terminator) {
    return .return_term(terminator);
}

@life()
public TerminatorKind cancel_terminator_kind(CancelTerminator terminator) {
    return .cancel_term(terminator);
}

@life()
public TerminatorKind unreachable_terminator_kind(UnreachableTerminator terminator) {
    return .unreachable_term(terminator);
}

public struct GotoTerminator: Copyable {
    public BlockId target;
}

@region(a)
public struct BranchTerminator: Copyable {
    @life(a)
    public Operand condition;
    public BlockId then_target;
    public BlockId else_target;
}

@region(a)
public struct SwitchTerminator: Copyable {
    @life(a)
    public Operand discriminator;

    @life(a)
    public SwitchCase[]& cases;
    public BlockId default_target;
}

public struct SwitchCase: Copyable {
    public Const value;
    public BlockId target;
}

@region(a)
public struct CallTerminator: Copyable {
    @life(a)
    public CallCallee callee;

    @life(a, a)
    public Operand[]& args;
    public types.EffectSet current_effects;
    public Bool is_suspend_point;
    public SuspendWakeKind suspend_wake = .none;
    // direct_child 的源码实例。callee 可能是递归 start shim，因此不能从
    // 实际调用符号反推这条固定点边。
    @life(a)
    public FunctionRef? suspend_child = null;
    // handoff 只保存 continuation state；当前 resume 返回时不能再次发布 Task suspend。
    public Bool task_handoff = false;
    public AsyncStartKind? async_start = null;

    // 返回值写入 destination，然后跳到 target。
    @life(a)
    public Place destination;
    public BlockId target;

    // init call 会通过 hidden out operand 初始化调用方传入的 storage；
    // 它不是普通返回值，但 borrow check 需要知道这个 place 已初始化。
    @life(a)
    public Place? initialized_place;

    // 间接 callable 的 LifetimeContract 已解析为 JIL 实参数路径。
    // null 表示没有需传播的 flow。
    @life(a)
    public types.LifetimeFlow[]&? return_lifetime_flows = null;

    // async ABI 调用的实际 args/destination 是 frame pointer 与 unit 临时值。
    // 这两个字段保留源码 callable 的逻辑实参和结果 place，仅供 borrow check 应用 LifetimeContract。
    @life(a, a)
    public Operand[]&? lifetime_args = null;

    @life(a)
    public Place? lifetime_destination = null;

    // exclusive 参数签名约束会在 call lowering 时解析成调用点 place；
    // borrow check 在这些 place 上验证没有未来仍会使用的派生 borrow。
    @life(a, a)
    public Place[]& exclusive_places;

    // 可抛错、可 panic 或有析构路径的 call 可以跳到 cleanup block。
    public BlockId? cleanup;
}

public enum AsyncStartKind {
    observed_task,
    detached,
}

@region(a)
public union CallCallee: Copyable {
    @life(a)
    public FunctionRef direct_function;

    @life(a)
    public Operand indirect_operand;

    @life(a)
    public DomainEnqueueCallee domain_enqueue;

    @life(a)
    public DynamicDomainEnqueueCallee dynamic_domain_enqueue;
}

@region(a)
public struct DomainEnqueueCallee: Copyable {
    public qid.DefId domain_def;
    public Int domain_kind;

    @life(a)
    public Operand? task;

    @life(a)
    public Operand resume;
    public Bool handoff;
}

@region(a)
public struct DynamicDomainEnqueueCallee: Copyable {
    @life(a)
    public Operand executor;

    @life(a)
    public Operand? task;

    @life(a)
    public Operand resume;
    public Bool handoff;
    public TaskScheduleMode mode = .concurrent;
}

public enum TaskScheduleMode {
    concurrent,
    local,
}

public CallCallee direct_function_callee(FunctionRef value) {
    return .direct_function(value);
}

public CallCallee indirect_operand_callee(Operand value) {
    return .indirect_operand(value);
}

@life(return: resume)
public CallCallee domain_enqueue_callee(qid.DefId domain_def, Int domain_kind, Operand resume) {
    return .domain_enqueue(DomainEnqueueCallee(
        domain_def: domain_def,
        domain_kind: domain_kind,
        task: null,
        resume: resume,
        handoff: false
    ));
}

@life(return: task & resume)
public CallCallee domain_task_enqueue_callee(
    qid.DefId domain_def,
    Int domain_kind,
    Operand task,
    Operand resume,
    Bool handoff
) {
    return .domain_enqueue(DomainEnqueueCallee(
        domain_def: domain_def,
        domain_kind: domain_kind,
        task: task,
        resume: resume,
        handoff: handoff
    ));
}

@life(return: executor & resume)
public CallCallee dynamic_domain_enqueue_callee(Operand executor, Operand resume) {
    return .dynamic_domain_enqueue(DynamicDomainEnqueueCallee (
        executor: executor,
        task: null,
        resume: resume,
        handoff: false
    ));
}

@life(return: executor & task & resume)
public CallCallee dynamic_task_enqueue_callee(
    Operand executor,
    Operand task,
    Operand resume,
    Bool handoff
) {
    return .dynamic_domain_enqueue(DynamicDomainEnqueueCallee (
        executor: executor,
        task: task,
        resume: resume,
        handoff: handoff
    ));
}

@region(a)
public struct DropTerminator: Copyable {
    @life(a)
    public Place place;
    public BlockId target;

    // drop/deinit 出错或 panic 时进入 cleanup；无异常语义时为 null。
    public BlockId? cleanup;
}

@region(a)
public struct AssertTerminator: Copyable {
    @life(a)
    public Operand condition;
    public Bool expected;
    public qid.SymbolId? message;
    public BlockId target;
    public BlockId? cleanup;
}

public struct SuspendPendingTerminator: Copyable {
    public BlockId target;
    public SuspendWakeKind suspend_wake;
    public LocalId? task_local = null;
}

public struct ReturnTerminator: Copyable {
    // 返回值固定从 body.return_local 读取。
    public Bool implicit_unit;
}

// Coroutine-only terminal used while building the cancellation cleanup path.
// Frame rewriting replaces it with completion notification before codegen.
public struct CancelTerminator: Copyable {
}

@region(a)
public struct ThrowTerminator: Copyable {
    @life(a)
    public Operand error_value;
}

public struct UnreachableTerminator: Copyable {
    public Bool generated_by_check;
}

// CFG dataflow 不直接 pattern match terminator。统一通过这两个 helper 读取
// successor，避免 borrow check、drop elaboration 和后端各自复制控制流规则。
public Int terminator_successor_count(Terminator terminator) {
    if (terminator.kind is .goto_term(_)) { return 1; }
    if (terminator.kind is .branch_term(_)) { return 2; }
    if (terminator.kind is .switch_term(switch_term)) { return switch_term.cases.length + 1; }
    if (terminator.kind is .call_term(call_term)) {
        if (call_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (drop_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (assert_term.cleanup != null) { return 2; }
        return 1;
    }
    if (terminator.kind is .suspend_pending_term(_)) { return 1; }
    return 0;
}

public BlockId terminator_successor_at(Terminator terminator, Int index) {
    assert(index >= 0 && index < terminator_successor_count(terminator));
    if (terminator.kind is .goto_term(goto_term)) { return goto_term.target; }
    if (terminator.kind is .branch_term(branch_term)) {
        if (index == 0) { return branch_term.then_target; }
        return branch_term.else_target;
    }
    if (terminator.kind is .switch_term(switch_term)) {
        if (index < switch_term.cases.length) {
            return switch_term.cases[index].target;
        }
        return switch_term.default_target;
    }
    if (terminator.kind is .call_term(call_term)) {
        if (index == 0) { return call_term.target; }
        return call_term.cleanup$.some();
    }
    if (terminator.kind is .drop_term(drop_term)) {
        if (index == 0) { return drop_term.target; }
        return drop_term.cleanup$.some();
    }
    if (terminator.kind is .assert_term(assert_term)) {
        if (index == 0) { return assert_term.target; }
        return assert_term.cleanup$.some();
    }
    if (terminator.kind is .suspend_pending_term(suspend_pending)) { return suspend_pending.target; }
    return BlockId(0);
}
