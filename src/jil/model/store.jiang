// JIL Store 与 arena-backed 模型固化 API。

import * = "./id.jiang";
import * = "./place.jiang";
import * = "./value.jiang";
import * = "./coroutine.jiang";
import * = "./control_flow.jiang";
import * = "./program.jiang";
import qid = "../../id.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import memory = "../../support/memory.jiang";
import table = "../../support/table.jiang";

public struct Store: Movable {
    public Bool ok!;
    public arena.Arena storage!;
    public list.ArrayList<Function> functions;
    public list.ArrayList<Global> globals;
    public qid.DefId? main_domain_def!;
    Int pending_generated_function_count!;

    // 非泛型函数仍可直接用 DefId 查找。
    public table.HashTable<qid.DefId, FunctionId> function_for_def;
    public table.HashTable<qid.DefId, GlobalId> global_for_def;
    public table.HashTable<qid.DefId, DomainExecutorDescriptor> domain_executor_descriptors;

    // 泛型函数 concrete JIL 需要同时区分 DefId 和 type args。
    // 不能写进 function_for_def，否则 id<Int> 和 id<Bool> 会互相覆盖。
    public table.HashTable<FunctionKey, FunctionId> function_for_instance;
    public table.HashTable<Int, Bool> drop_elaborated_functions;
    public table.HashTable<Int, Function> borrow_check_overrides;
    public table.HashTable<Int, Bool> borrow_check_exempt_functions;
    table.MultiTable<Int, qid.ModuleId> monomorph_owners;

    public init(self, Bool ok) {
        self.ok = ok;
        self.storage = arena.Arena();
        self.functions = list.ArrayList<Function>();
        self.globals = list.ArrayList<Global>();
        self.main_domain_def = null;
        self.pending_generated_function_count = 0;
        self.function_for_def = table.HashTable<qid.DefId, FunctionId>();
        self.global_for_def = table.HashTable<qid.DefId, GlobalId>();
        self.domain_executor_descriptors =
            table.HashTable<qid.DefId, DomainExecutorDescriptor>();
        self.function_for_instance = table.HashTable<FunctionKey, FunctionId>();
        self.drop_elaborated_functions = table.HashTable<Int, Bool>();
        self.borrow_check_overrides = table.HashTable<Int, Function>();
        self.borrow_check_exempt_functions = table.HashTable<Int, Bool>();
        self.monomorph_owners = table.MultiTable<Int, qid.ModuleId>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public FunctionId add_function(self, Function function) {
        FunctionId id = function.id;
        self.functions.add(function);
        guard function.origin is .source(def_id) else { return id; }
        if (function.type_args.length == 0 && function.const_args.length == 0) {
            if (!function.is_runtime_entry) {
                self.function_for_def.set(def_id, id);
            }
        } else {
            self.function_for_instance.set(
                FunctionKey(def_id, function.type_args, function.const_args),
                id
            );
        }
        return id;
    }

    public FunctionId add_generated_function(self, Function function) {
        FunctionId id = function.id;
        self.functions.add(function);
        return id;
    }

    public FunctionId reserve_generated_function(
        self,
        GeneratedFunctionOrigin origin,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        token.Span span
    ) {
        FunctionId id = FunctionId.from_index(self.functions.len());
        self.functions.add(Function(
            id: id,
            origin: .generated(origin),
            type_args: self.type_arg_array(type_args),
            const_args: self.const_arg_array(const_args),
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: Body(
                id: BodyId.from_index(id.to_index()),
                span: span,
                locals: self.empty_locals(),
                blocks: self.empty_blocks(),
                entry: BlockId.from_index(0),
                return_local: LocalId.from_index(0)
            )
        ));
        self.pending_generated_function_count =
            self.pending_generated_function_count + 1;
        return id;
    }

    public () finish_generated_function(self, Function function) {
        assert(self.pending_generated_function_count > 0);
        self.functions.set(function.id.to_index(), function);
        self.pending_generated_function_count =
            self.pending_generated_function_count - 1;
    }

    public Bool has_pending_generated_functions(self) {
        return self.pending_generated_function_count != 0;
    }

    public FunctionId? function_id_for_ref(
        self,
        FunctionRef value
    ) {
        if (value.target is .generated(generated)) { return generated.id; }
        guard value.target is .source(function_def) else { return null; }
        if (value.type_args.length == 0 && value.const_args.length == 0) {
            return self.function_id_for_def(function_def);
        }
        return self.function_id_for_instance(
            function_def, value.type_args, value.const_args
        );
    }

    public GeneratedFunctionTarget generated_function_target(self, FunctionId id) {
        Function& value = self.functions.ref_at(id.to_index());
        guard value.origin is .generated(origin) else {
            return GeneratedFunctionTarget(
                id: id,
                symbol: qid.SymbolId(0),
                module_id: null,
                kind: .raw_fn_to_fn,
                provenance_def: qid.DefId.from_index(0),
                identity_type: null
            );
        }
        return GeneratedFunctionTarget(
            id: id,
            symbol: origin.symbol,
            module_id: origin.module_id,
            kind: origin.kind,
            provenance_def: origin.provenance_def,
            identity_type: origin.identity_type
        );
    }

    public () add_monomorph_owner(self, FunctionId function_id, qid.ModuleId owner) {
        Int key = function_id.to_index();
        table.MultiTableCursor cursor! = self.monomorph_owners.first(key);
        while (cursor.valid()) {
            if (self.monomorph_owners.get(cursor) == owner) { return; }
            cursor = self.monomorph_owners.next(cursor);
        }
        self.monomorph_owners.add(key, owner);
    }

    public () add_monomorph_owners(
        self,
        FunctionId function_id,
        list.ArrayList<qid.ModuleId>& owners
    ) {
        Int index! = 0;
        while (index < owners.len()) {
            self.add_monomorph_owner(function_id, owners.get(index));
            index = index + 1;
        }
    }

    public () copy_monomorph_owners(self, FunctionId source, FunctionId target) {
        table.MultiTableCursor cursor! =
            self.monomorph_owners.first(source.to_index());
        while (cursor.valid()) {
            self.add_monomorph_owner(target, self.monomorph_owners.get(cursor));
            cursor = self.monomorph_owners.next(cursor);
        }
    }

    public list.ArrayList<qid.ModuleId> function_monomorph_owners(
        self,
        FunctionId function_id
    ) {
        list.ArrayList<qid.ModuleId> result! = list.ArrayList<qid.ModuleId>();
        table.MultiTableCursor cursor! =
            self.monomorph_owners.first(function_id.to_index());
        while (cursor.valid()) {
            result.add(self.monomorph_owners.get(cursor));
            cursor = self.monomorph_owners.next(cursor);
        }
        return result;
    }

    public () mark_drop_elaborated(self, FunctionId function_id) {
        self.drop_elaborated_functions.set(function_id.to_index(), true);
    }

    public Bool is_drop_elaborated(self, FunctionId function_id) {
        return table.hash_table_get_value<Int, Bool>(
            self.drop_elaborated_functions$.ref(), function_id.to_index()
        ) != null;
    }

    public () set_borrow_check_override(self, Function function) {
        self.borrow_check_overrides.set(function.id.to_index(), function);
    }

    @life(return: (self, self, self, self))
    public Function? borrow_check_function(self, FunctionId function_id) {
        return table.hash_table_get_value<Int, Function>(
            self.borrow_check_overrides$.ref(), function_id.to_index()
        );
    }

    public () mark_borrow_check_exempt(self, FunctionId function_id) {
        self.borrow_check_exempt_functions.set(function_id.to_index(), true);
    }

    public Bool is_borrow_check_exempt(self, FunctionId function_id) {
        return table.hash_table_get_value<Int, Bool>(
            self.borrow_check_exempt_functions$.ref(), function_id.to_index()
        ) != null;
    }

    @life(return: (self, self, self, self))
    public Function function(self, FunctionId id) {
        return self.functions.get(id.to_index());
    }

    public GlobalId add_global(self, Global global) {
        GlobalId id = global.id;
        self.globals.add(global);
        if (global.origin is .source(def_id)) {
            self.global_for_def.set(def_id, id);
        }
        return id;
    }

    public GlobalId? global_id_for_target(self, GlobalTarget target) {
        if (target is .generated(generated)) { return generated.id; }
        guard target is .source(def_id) else { return null; }
        return self.global_id_for_def(def_id);
    }

    public GeneratedGlobalTarget generated_global_target(self, GlobalId id) {
        Global& value = self.globals.ref_at(id.to_index());
        guard value.origin is .generated(origin) else {
            return GeneratedGlobalTarget(
                id: id,
                symbol: qid.SymbolId(0),
                module_id: null,
                kind: .raw_fn_vtable,
                provenance_def: qid.DefId.from_index(0),
                identity_type: null
            );
        }
        return GeneratedGlobalTarget(
            id: id,
            symbol: origin.symbol,
            module_id: origin.module_id,
            kind: origin.kind,
            provenance_def: origin.provenance_def,
            identity_type: origin.identity_type
        );
    }

    public FunctionId? function_id_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, FunctionId>(self.function_for_def$.ref(), def_id);
    }

    public GlobalId? global_id_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, GlobalId>(self.global_for_def$.ref(), def_id);
    }

    public DomainExecutorDescriptor? domain_executor_descriptor(self, qid.DefId domain_def) {
        return table.hash_table_get_value<qid.DefId, DomainExecutorDescriptor>(
            self.domain_executor_descriptors$.ref(), domain_def
        );
    }

    public FunctionId? function_id_for_instance(self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return table.hash_table_get_value<FunctionKey, FunctionId>(
            self.function_for_instance$.ref(),
            FunctionKey(def_id, type_args, const_args)
        );
    }

    public qid.TypeId[]& empty_type_args(self) {
        unsafe {
            qid.TypeId*! values = self.storage.alloc_array<qid.TypeId>(1);
            return values[0..0];
        }
    }

    public qid.TypeId[]& type_arg_array(self, qid.TypeId[]& type_args) {
        unsafe {
            Int count = type_args.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            qid.TypeId*! values = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = type_args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    public comptime_value.ComptimeValue[]& empty_const_args(self) {
        unsafe {
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(1);
            return values[0..0];
        }
    }

    @life(return: (self, self))
    public comptime_value.ComptimeValue[]& const_arg_array(self,
        comptime_value.ComptimeValue[]& const_args
    ) {
        unsafe {
            Int count = const_args.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = const_args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public LocalDecl[]& empty_locals(self) {
        unsafe {
            LocalDecl*! values = self.storage.alloc_array<LocalDecl>(1);
            return values[0..0];
        }
    }

    public LocalDecl*! alloc_local_array(self, Int count) {
        Int capacity! = count;
        if (capacity == 0) {
            capacity = 1;
        }
        return self.storage.alloc_array<LocalDecl>(capacity);
    }

    @life(return: (self, self))
    public Statement[]& empty_statements(self) {
        unsafe {
            Statement*! values = self.storage.alloc_array<Statement>(1);
            return values[0..0];
        }
    }

    @life(return: (self, self))
    public Block[]& empty_blocks(self) {
        unsafe {
            Block*! values = self.storage.alloc_array<Block>(1);
            return values[0..0];
        }
    }

    @life(return: (self, self))
    public Statement[]& statement_array(self, list.ArrayList<Statement>& statements) {
        return self.statement_slice(statements.slice());
    }

    @life(return: (self, self))
    public Statement[]& statement_slice(self, Statement[]& statements) {
        unsafe {
            Int count = statements.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Statement*! values = self.storage.alloc_array<Statement>(capacity);
            Int index! = 0;
            while (index < count) {
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        statements[index]$.ptr()$.as(UInt8*),
                        Statement$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    public Block[]& block_array(self, list.ArrayList<Block>& blocks) {
        unsafe {
            Int count = blocks.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Block*! values = self.storage.alloc_array<Block>(capacity);
            Block[]& source = blocks.slice();
            Int index! = 0;
            while (index < count) {
                // Block 内含 Terminator 大 union。这里是在把临时 block 列表
                // 固化进 JIL arena，按字节复制可以避开大 union/大 struct 按值赋值路径。
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        source[index]$.ptr()$.as(UInt8*),
                        Block$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    public Operand[]& operand_array(self, list.ArrayList<Operand>& operands) {
        return self.operand_slice(operands.slice());
    }

    @life(return: (self, self))
    public Operand[]& operand_slice(self, Operand[]& operands) {
        unsafe {
            Int count = operands.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Operand*! values = self.storage.alloc_array<Operand>(capacity);
            Int index! = 0;
            while (index < count) {
                // Operand 是 backend 前最频繁复制的大 union。这里是在把临时
                // ArrayList/slice 固化进 JIL arena，直接按元素字节复制可以避免
                // 自举阶段反复经过 union 按值赋值路径。
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        operands[index]$.ptr()$.as(UInt8*),
                        Operand$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public Int[]& empty_ints(self) {
        unsafe {
            Int*! values = self.storage.alloc_array<Int>(1);
            return values[0..0];
        }
    }

    public Int[]& int_array(self, list.ArrayList<Int>& values) {
        unsafe {
            Int count = values.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            Int*! stored = self.storage.alloc_array<Int>(capacity);
            Int index! = 0;
            while (index < count) {
                stored[index] = values.get(index);
                index = index + 1;
            }
            return stored[0..count];
        }
    }

