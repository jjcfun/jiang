    @life(return: (self, self))
    public InlineAsmOperand[]& inline_asm_operand_slice(self, InlineAsmOperand[]& operands) {
        list.ArrayList<InlineAsmOperand> values! = list.ArrayList<InlineAsmOperand>(operands.length);
        Int index! = 0;
        while (index < operands.length) {
            values.add(operands[index]);
