    @life(return: (self, self))
    public Place[]& empty_places(self) {
        list.ArrayList<Place> places! = list.ArrayList<Place>();
        return self.place_array(places$.ref());
    }

    @life(return: (self, self))
    public Place[]& single_place_array(self, Place place) {
        list.ArrayList<Place> places! = list.ArrayList<Place>(1);
        places.add(place);
        return self.place_array(places$.ref());
    }

