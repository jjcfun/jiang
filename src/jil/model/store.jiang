    public PlaceElem[]& empty_projection(self) {
        unsafe {
            PlaceElem*! values = self.storage.alloc_array<PlaceElem>(1);
            return values[0..0];
        }
    }

    public PlaceElem[]& projection_array(self, list.ArrayList<PlaceElem>& elems) {
        return self.projection_slice(elems.slice());
    }

    public PlaceElem[]& projection_slice(self, PlaceElem[]& elems) {
        unsafe {
            Int count = elems.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            PlaceElem*! values = self.storage.alloc_array<PlaceElem>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = elems[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

}
