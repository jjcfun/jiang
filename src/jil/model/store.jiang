// JIL Store 与 arena-backed 模型固化 API。

import * = "./id.jiang";
import * = "./place.jiang";
import * = "./value.jiang";
import * = "./coroutine.jiang";
import * = "./control_flow.jiang";
import * = "./program.jiang";
import qid = "../../id.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import token = "../../syntax/token.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import memory = "../../support/memory.jiang";
import std;

// arena-backed JIL 数据发布后保持不可变；Storage 只提供固化能力，
// functions、globals 和索引仍由 Store 独立发布。
public struct Storage: Movable {
    public arena.Arena arena!;

    public init(self) {
        self.arena = arena.Arena();
    }
}

public struct DropElaborationState: Movable {
    map.WyHashMap<Int, Bool> functions!;

    public init(self) {
        self.functions = map.WyHashMap<Int, Bool>();
    }

    public Void mark(Self&! self, FunctionId function_id) {
        self.functions.set(function_id.to_index(), true);
    }

    public Bool contains(self, FunctionId function_id) {
        return self.functions.has(function_id.to_index());
    }
}

@region(a, b, c)
public struct Program: Movable {
    public Bool ok!;
    public Int query_identity!;
    @life((a, b))
    public list.ArrayList<Function> functions!;
    @life((a, b))
    list.ArrayList<Function> source_functions!;
    @life(c)
    public list.ArrayList<Global> globals!;
    list.ArrayList<std.String> generated_names!;
    public qid.DefId? main_domain_def!;
    Int pending_generated_function_count!;

    // 非泛型函数仍可直接用 DefId 查找。
    map.WyHashMap<qid.DefId, FunctionId> function_for_def!;
    map.WyHashMap<qid.DefId, Int> source_function_indexes!;
    map.WyHashMap<qid.DefId, GlobalId> global_for_def!;
    map.WyHashMap<qid.DefId, DomainExecutorDescriptor> domain_executor_descriptors!;

    // 泛型函数 concrete JIL 需要同时区分 DefId 和 type args。
    // 不能写进 function_for_def，否则 id<Int> 和 id<Bool> 会互相覆盖。
    map.WyHashMap<Int, FunctionId> function_for_instance!;
    map.WyHashMap<Int, FunctionId> async_start_for_instance!;
    map.WyHashMap<Int, FunctionId> async_sync_for_instance!;
    @life(a)
    map.WyHashMap<InstanceKey, Int> function_instance_identities!;
    @life(a)
    list.ArrayList<InstanceKey> function_instances!;
    list.ArrayList<Int> source_instance_identities!;
    map.WyHashMap<Int, Bool> source_instances!;
    map.WyHashMap<Int, GlobalId> closure_vtable_globals!;
    @life((), (a, b))
    map.WyHashMap<Int, Function> borrow_check_overrides!;
    map.WyHashMap<Int, Bool> borrow_check_exempt_functions!;
    map.WyHashMap<Int, Bool> shared_codegen_functions!;
    map.WyHashMap<qid.TypeId, FunctionId> drop_glue_for_type!;

    public init(self, Bool ok) {
        self.ok = ok;
        self.query_identity = -1;
        self.functions = list.ArrayList<Function>();
        self.source_functions = list.ArrayList<Function>();
        self.globals = list.ArrayList<Global>();
        self.generated_names = list.ArrayList<std.String>();
        self.main_domain_def = null;
        self.pending_generated_function_count = 0;
        self.function_for_def = map.WyHashMap<qid.DefId, FunctionId>();
        self.source_function_indexes = map.WyHashMap<qid.DefId, Int>();
        self.global_for_def = map.WyHashMap<qid.DefId, GlobalId>();
        self.domain_executor_descriptors =
            map.WyHashMap<qid.DefId, DomainExecutorDescriptor>();
        self.function_for_instance = map.WyHashMap<Int, FunctionId>();
        self.async_start_for_instance = map.WyHashMap<Int, FunctionId>();
        self.async_sync_for_instance = map.WyHashMap<Int, FunctionId>();
        self.function_instance_identities = map.WyHashMap<InstanceKey, Int>();
        self.function_instances = list.ArrayList<InstanceKey>();
        self.source_instance_identities = list.ArrayList<Int>();
        self.source_instances = map.WyHashMap<Int, Bool>();
        self.closure_vtable_globals = map.WyHashMap<Int, GlobalId>();
        self.borrow_check_overrides = map.WyHashMap<Int, Function>();
        self.borrow_check_exempt_functions = map.WyHashMap<Int, Bool>();
        self.shared_codegen_functions = map.WyHashMap<Int, Bool>();
        self.drop_glue_for_type = map.WyHashMap<qid.TypeId, FunctionId>();
    }
}

public struct Store: Movable {
    public Storage storage!;
    public Program program!;
    public DropElaborationState drop_elaboration!;

    public init(self, Bool ok) {
        self.storage = Storage();
        self.program = Program(ok);
        self.drop_elaboration = DropElaborationState();
    }
}

public extend Program {
    public Bool has_errors(self) {
        return !self.ok;
    }

    public GeneratedNameId add_generated_name(Self&! self, UInt8[]& name) {
        GeneratedNameId id = GeneratedNameId.from_index(self.generated_names.len());
        self.generated_names.add(std.String(name));
        return id;
    }

    public UInt8[]& generated_name(self, GeneratedNameId id) {
        return self.generated_names.ref_at(id.to_index()).bytes();
    }

    public Void mark_error(Self&! self) {
        self.ok = false;
    }

    public Bool has_query_identity(self) {
        return self.query_identity >= 0;
    }

    public Void bind_query_identity(Self&! self, Int identity) {
        assert(self.query_identity < 0);
        assert(identity >= 0);
        self.query_identity = identity;
    }

    public FunctionId add_function(Self&! self, Function function) {
        FunctionId id = function.id;
        self.functions.add(function);
        guard function.origin is .source(def_id) else { return id; }
        if (function.args.length == 0) {
            if (!function.is_runtime_entry) {
                self.function_for_def.set(def_id, id);
            }
        } else {
            Int identity = self.existing_function_instance_identity(
                def_id, function.args
            )$.some();
            self.function_for_instance.set(identity, id);
        }
        return id;
    }

    public Void add_source_function(
        Self&! self,
        qid.DefId def_id,
        Function function
    ) {
        Int index = self.source_functions.len();
        self.source_functions.add(function);
        self.source_function_indexes.set(def_id, index);
    }

    @life(return: (self.a, self.b))
    public Function source_function(self, qid.DefId def_id) {
        return self.source_functions.get(self.source_function_index(def_id));
    }

    @life(return: (self.a, self.b))
    public Function source_function_at(self, Int index) {
        return self.source_functions.get(index);
    }

    public Void set_source_function(
        Self&! self,
        qid.DefId def_id,
        Function function
    ) {
        Int index = self.source_function_index(def_id);
        self.source_functions.set(index, function);
    }

    public Int? source_function_index_for_def(self, qid.DefId def_id) {
        guard self.source_function_indexes.get(def_id) is .some(index) else { return null; }
        return index$.get();
    }

    public Int source_function_index(self, qid.DefId def_id) {
        return self.source_function_index_for_def(def_id)$.some();
    }

    public Bool has_source_function(self, qid.DefId def_id) {
        return self.source_function_indexes.has(def_id);
    }

    public Int source_function_count(self) {
        return self.source_functions.len();
    }

    public FunctionId add_generated_function(Self&! self, Function function) {
        FunctionId id = function.id;
        self.functions.add(function);
        return id;
    }

    public FunctionId? drop_glue(self, qid.TypeId type_id) {
        if (self.drop_glue_for_type.get(type_id) is .some(value)) {
            FunctionId function_id = value$.get();
            return function_id;
        }
        return null;
    }

    public Void bind_drop_glue(
        Self&! self,
        qid.TypeId type_id,
        FunctionId function_id
    ) {
        self.drop_glue_for_type.set(type_id, function_id);
    }

    public FunctionId reserve_generated_function(
        Self&! self,
        Storage& storage,
        GeneratedFunctionOrigin origin,
        types.GenericArg[]& args,
        token.Span span
    ) {
        FunctionId id = FunctionId.from_index(self.functions.len());
        types.GenericArg[]& stored_args = storage.generic_arg_array(args);
        LocalDecl[]& locals = storage.empty_locals();
        Block[]& blocks = storage.empty_blocks();
        self.functions.add(Function(
            id: id,
            origin: .generated(origin),
            args: stored_args,
            signature_id: null,
            effects: types.EffectSet(),
            is_coroutine: false,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: false,
            inline_always: true,
            naked: false,
            span: span,
            body: Body(
                id: BodyId.from_index(id.to_index()),
                span: span,
                locals: locals,
                blocks: blocks,
                entry: BlockId.from_index(0),
                return_local: LocalId.from_index(0)
            )
        ));
        self.pending_generated_function_count =
            self.pending_generated_function_count + 1;
        return id;
    }

    public Void finish_generated_function(Self&! self, Function function) {
        assert(self.pending_generated_function_count > 0);
        self.functions.set(function.id.to_index(), function);
        self.pending_generated_function_count =
            self.pending_generated_function_count - 1;
    }

    public Void set_function(Self&! self, Function function) {
        self.functions.set(function.id.to_index(), function);
    }

    public Bool has_pending_generated_functions(self) {
        return self.pending_generated_function_count != 0;
    }

    public FunctionId? first_pending_generated_function(self) {
        Int index! = 0;
        while (index < self.functions.len()) {
            Function& function = self.functions.ref_at(index);
            if (function.origin is .generated(_)
                && function.body.blocks.length == 0
                && function.inline_always) {
                return function.id;
            }
            index = index + 1;
        }
        return null;
    }

    public FunctionId? function_id_for_ref(
        self,
        FunctionRef value
    ) {
        if (value.target is .generated(generated)) { return generated.id; }
        guard value.target is .source(function_def) else { return null; }
        if (value.coroutine_start) {
            return self.async_start_function(function_def, value.args);
        }
        if (value.coroutine_sync) {
            return self.async_sync_function(function_def, value.args);
        }
        if (value.args.length == 0) {
            return self.function_id_for_def(function_def);
        }
        return self.function_id_for_instance(function_def, value.args);
    }

    public Void set_async_start_function(
        Self&! self,
        Storage& storage,
        qid.DefId function_def,
        types.GenericArg[]& args,
        FunctionId function_id
    ) {
        Int identity = self.function_instance_identity(
            storage, function_def, args
        );
        self.async_start_for_instance.set(identity, function_id);
    }

    public FunctionId? async_start_function(
        self,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        guard self.existing_function_instance_identity(function_def, args)
            is .some(identity) else { return null; }
        guard self.async_start_for_instance.get(identity) is .some(function_id) else {
            return null;
        }
        return function_id$.get();
    }

    public Void set_async_sync_function(
        Self&! self,
        Storage& storage,
        qid.DefId function_def,
        types.GenericArg[]& args,
        FunctionId function_id
    ) {
        Int identity = self.function_instance_identity(
            storage, function_def, args
        );
        self.async_sync_for_instance.set(identity, function_id);
    }

    public FunctionId? async_sync_function(
        self,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        guard self.existing_function_instance_identity(function_def, args)
            is .some(identity) else { return null; }
        guard self.async_sync_for_instance.get(identity) is .some(function_id) else {
            return null;
        }
        return function_id$.get();
    }

    public GeneratedFunctionTarget generated_function_target(self, FunctionId id) {
        Function& value = self.functions.ref_at(id.to_index());
        guard value.origin is .generated(origin) else {
            return GeneratedFunctionTarget(
                id: id,
                provenance_def: qid.DefId.from_index(0)
            );
        }
        return GeneratedFunctionTarget(
            id: id,
            provenance_def: origin.provenance_def
        );
    }

    public Void mark_shared_codegen_function(Self&! self, FunctionId function_id) {
        self.shared_codegen_functions.set(function_id.to_index(), true);
    }

    public Void copy_shared_codegen_status(
        Self&! self,
        FunctionId source,
        FunctionId target
    ) {
        if (self.function_is_shared_codegen(source)) {
            self.mark_shared_codegen_function(target);
        }
    }

    public Bool function_is_shared_codegen(self, FunctionId function_id) {
        return self.shared_codegen_functions.has(function_id.to_index());
    }

    public Void set_borrow_check_override(Self&! self, Function function) {
        self.borrow_check_overrides.set(function.id.to_index(), function);
    }

    @life(return: (self.a, self.b))
    public Function? borrow_check_function(self, FunctionId function_id) {
        guard self.borrow_check_overrides.get(function_id.to_index()) is .some(function) else {
            return null;
        }
        return function$.get();
    }

    public Void mark_borrow_check_exempt(Self&! self, FunctionId function_id) {
        self.borrow_check_exempt_functions.set(function_id.to_index(), true);
    }

    public Bool is_borrow_check_exempt(self, FunctionId function_id) {
        return self.borrow_check_exempt_functions.has(function_id.to_index());
    }

    @life(return: (self.a, self.b))
    public Function function(self, FunctionId id) {
        return self.functions.get(id.to_index());
    }

    public AggregateField? coroutine_frame_field_for_local(
        self,
        FunctionId function_id,
        LocalId local_id
    ) {
        Function function = self.function(function_id);
        guard function.coroutine_frame is .some(layout) else { return null; }
        Int index! = 0;
        while (index < layout.local_mappings.length) {
            CoroutineLocalFrameField mapping = layout.local_mappings[index];
            if (mapping.local_id == local_id) {
                return AggregateField(
                    type_id: layout.fields[mapping.field_index].type_id,
                    index: mapping.field_index
                );
            }
            index = index + 1;
        }
        return null;
    }

    public GlobalId add_global(Self&! self, Global global) {
        GlobalId id = global.id;
        self.globals.add(global);
        if (global.origin is .source(def_id)) {
            self.global_for_def.set(def_id, id);
        }
        return id;
    }

    public FunctionId? function_id_for_def(self, qid.DefId def_id) {
        guard self.function_for_def.get(def_id) is .some(function_id) else { return null; }
        return function_id$.get();
    }

    public GlobalId? global_id_for_def(self, qid.DefId def_id) {
        guard self.global_for_def.get(def_id) is .some(global_id) else { return null; }
        return global_id$.get();
    }

    public DomainExecutorDescriptor? domain_executor_descriptor(self, qid.DefId domain_def) {
        guard self.domain_executor_descriptors.get(domain_def) is .some(descriptor) else {
            return null;
        }
        return descriptor$.get();
    }

    public Void set_domain_executor_descriptor(
        Self&! self,
        qid.DefId domain_def,
        DomainExecutorDescriptor descriptor
    ) {
        self.domain_executor_descriptors.set(domain_def, descriptor);
    }

    public FunctionId? function_id_for_instance(self,
        qid.DefId def_id,
        types.GenericArg[]& args
    ) {
        if (args.length == 0) { return self.function_id_for_def(def_id); }
        guard self.existing_function_instance_identity(def_id, args)
            is .some(identity) else { return null; }
        guard self.function_for_instance.get(identity) is .some(function_id) else {
            return null;
        }
        return function_id$.get();
    }

    public Int? existing_function_instance_identity(
        self,
        qid.DefId def_id,
        types.GenericArg[]& args
    ) {
        InstanceKey key = InstanceKey(def_id, args);
        guard self.function_instance_identities.get(key) is .some(identity) else { return null; }
        return identity$.get();
    }

    public Int function_instance_identity(
        Self&! self,
        Storage& storage,
        qid.DefId def_id,
        types.GenericArg[]& args
    ) {
        InstanceKey lookup = InstanceKey(def_id, args);
        if (self.function_instance_identities.get(lookup) is .some(identity)) {
            return identity$.get();
        }
        types.GenericArg[]& stored_args = storage.generic_arg_array(args);
        InstanceKey stored = InstanceKey(def_id, stored_args);
        Int identity = self.function_instances.len();
        self.function_instances.add(stored);
        self.function_instance_identities.set(stored, identity);
        return identity;
    }

    public Void mark_source_instance(Self&! self, Int identity) {
        if (self.source_instances.has(identity)) { return; }
        self.source_instances.set(identity, true);
        self.source_instance_identities.add(identity);
    }

    public Int source_instance_count(self) {
        return self.source_instance_identities.len();
    }

    public Int source_instance_identity_at(self, Int index) {
        return self.source_instance_identities.get(index);
    }

    @life(return: self.a)
    public InstanceKey function_instance_at(self, Int index) {
        return self.function_instances.get(index);
    }

    public Void set_closure_vtable_global(
        Self&! self,
        qid.DefId lambda_def,
        types.GenericArg[]& args,
        Bool heap_environment,
        GlobalId global_id
    ) {
        guard self.existing_function_instance_identity(lambda_def, args)
            is .some(identity) else { return; }
        self.closure_vtable_globals.set(
            closure_vtable_key(identity, heap_environment), global_id
        );
    }

    public GlobalId? closure_vtable_global(
        self,
        qid.DefId lambda_def,
        types.GenericArg[]& args,
        Bool heap_environment
    ) {
        guard self.existing_function_instance_identity(lambda_def, args)
            is .some(identity) else { return null; }
        guard self.closure_vtable_globals.get(
            closure_vtable_key(identity, heap_environment)
        ) is .some(global_id) else { return null; }
        return global_id$.get();
    }
}

Int closure_vtable_key(Int function_identity, Bool heap_environment) {
    Int key = function_identity * 2;
    if (heap_environment) { return key + 1; }
    return key;
}

public extend Storage {
    @life(return: self)
    public FunctionRef source_coroutine_function_ref(
        self,
        qid.DefId target_def,
        types.GenericArg[]& args,
        qid.TypeId function_type,
        Bool resume,
        token.Span span
    ) {
        return FunctionRef(
            target: .source(target_def),
            args: self.generic_arg_array(args),
            coroutine_resume: resume,
            coroutine_completion: !resume,
            type_id: function_type
        );
    }

    public qid.TypeId[]& empty_type_args(self) {
        return store_empty_type_args(self.arena$.ref());
    }

    public qid.TypeId[]& type_arg_array(self, qid.TypeId[]& type_args) {
        return store_type_arg_array(self.arena$.ref(), type_args);
    }

    @life(return: self)
    public types.GenericArg[]& generic_arg_array(self, types.GenericArg[]& args) {
        unsafe {
            Int count = args.length;
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            types.GenericArg*! values = self.arena.alloc_array<types.GenericArg>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: self)
    public types.GenericArg[]& empty_generic_args(self) {
        unsafe {
            types.GenericArg*! values = self.arena.alloc_array<types.GenericArg>(1);
            return values[0..0];
        }
    }

    @life(return: self)
    public types.GenericArg[]& generic_args_from_values(
        self,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(
            type_args.length + const_args.length
        );
        Int index! = 0;
        while (index < type_args.length) {
            args.add(types.generic_type_arg(type_args[index]));
            index = index + 1;
        }
        index = 0;
        while (index < const_args.length) {
            args.add(types.generic_const_arg(const_args[index]));
            index = index + 1;
        }
        return self.generic_arg_array(args.slice());
    }

    @life(return: self)
    public comptime_value.ComptimeValue[]& empty_const_args(self) {
        return store_empty_const_args(self.arena$.ref());
    }

    @life(return: self)
    public comptime_value.ComptimeValue[]& const_arg_array(self,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return store_const_arg_array(self.arena$.ref(), const_args);
    }

    public LocalDecl[]& empty_locals(self) {
        return store_empty_locals(self.arena$.ref());
    }

    public LocalDecl*! alloc_local_array(self, Int count) {
        Int capacity! = count;
        if (capacity == 0) {
            capacity = 1;
        }
        return self.arena.alloc_array<LocalDecl>(capacity);
    }

    @life(return: (self, self))
    public Statement[]& empty_statements(self) {
        unsafe {
            Statement*! values = self.arena.alloc_array<Statement>(1);
            return values[0..0];
        }
    }

    @life(return: (self, self))
    public Block[]& empty_blocks(self) {
        return store_empty_blocks(self.arena$.ref());
    }

    @life(return: (self, self))
    public Statement[]& statement_array(self, list.ArrayList<Statement>& statements) {
        return self.statement_slice(statements.slice());
    }

    @life(return: (self, self))
    public Statement[]& statement_slice(self, Statement[]& statements) {
        unsafe {
            Int count = statements.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Statement*! values = self.arena.alloc_array<Statement>(capacity);
            Int index! = 0;
            while (index < count) {
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        statements[index]$.ptr()$.as(UInt8*),
                        Statement$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    public Block[]& block_array(self, list.ArrayList<Block>& blocks) {
        unsafe {
            Int count = blocks.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Block*! values = self.arena.alloc_array<Block>(capacity);
            Block[]& source = blocks.slice();
            Int index! = 0;
            while (index < count) {
                // Block 内含 Terminator 大 union。这里是在把临时 block 列表
                // 固化进 JIL arena，按字节复制可以避开大 union/大 struct 按值赋值路径。
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        source[index]$.ptr()$.as(UInt8*),
                        Block$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    public Operand[]& operand_array(self, list.ArrayList<Operand>& operands) {
        return self.operand_slice(operands.slice());
    }

    @life(return: (self, self))
    public Operand[]& operand_slice(self, Operand[]& operands) {
        unsafe {
            Int count = operands.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            Operand*! values = self.arena.alloc_array<Operand>(capacity);
            Int index! = 0;
            while (index < count) {
                // Operand 是 backend 前最频繁复制的大 union。这里是在把临时
                // ArrayList/slice 固化进 JIL arena，直接按元素字节复制可以避免
                // 自举阶段反复经过 union 按值赋值路径。
                unsafe {
                    memory.copy_bytes(
                        values[index]$.ptr()$.as(UInt8*),
                        operands[index]$.ptr()$.as(UInt8*),
                        Operand$.size()
                    );
                }
                index = index + 1;
            }
            return values[0..count];
        }
    }

