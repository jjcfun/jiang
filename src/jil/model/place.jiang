// JIL 的 Place、projection、Operand、常量与 callable 引用模型。

import * = "./id.jiang";
import qid = "../../id.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import token = "../../syntax/token.jiang";

@region(a)
public struct Place: Copyable {
    public PlaceBase base;
    public LocalId local_id;
    @life(a)
    public PlaceElem[]& projection;
}

public union PlaceBase: Copyable {
    LocalId local;
    GlobalRef global;
}

public PlaceBase local_place_base(LocalId local_id) {
    return .local(local_id);
}

public PlaceBase global_place_base(GlobalRef global_ref) {
    return .global(global_ref);
}

@life(return: projection)
public Place local_place(LocalId local_id, PlaceElem[]& projection) {
    return Place(
        base: local_place_base(local_id),
        local_id: local_id,
        projection: projection
    );
}

@life(return: projection)
public Place global_place(GlobalRef global_ref, PlaceElem[]& projection) {
    return Place(
        base: global_place_base(global_ref),
        local_id: LocalId.from_index(0),
        projection: projection
    );
}

public LocalId? place_local_id(Place place) {
    if (place.base is .local(local_id)) {
        return local_id;
    }
    return null;
}

public union PlaceElem: Copyable {
    DerefProjection deref_projection;
    FieldProjection field_projection;
    FrameFieldProjection frame_field_projection;
    IndexProjection index_projection;
    ConstantIndexProjection constant_index_projection;
    SubsliceProjection subslice_projection;
}

public PlaceElem deref_projection_elem(DerefProjection projection) {
    return .deref_projection(projection);
}

public PlaceElem field_projection_elem(FieldProjection projection) {
    return .field_projection(projection);
}

public PlaceElem frame_field_projection_elem(FrameFieldProjection projection) {
    return .frame_field_projection(projection);
}

public PlaceElem index_projection_elem(IndexProjection projection) {
    return .index_projection(projection);
}

public PlaceElem constant_index_projection_elem(ConstantIndexProjection projection) {
    return .constant_index_projection(projection);
}

public PlaceElem subslice_projection_elem(SubsliceProjection projection) {
    return .subslice_projection(projection);
}

public struct DerefProjection: Copyable {
    public Bool raw_pointer;
}

public struct FieldProjection: Copyable {
    public qid.DefId field_def;
    public qid.TypeId field_type;
    public Int field_index;
}

public struct FrameFieldProjection: Copyable {
    public Int field_index;
    public qid.TypeId field_type;
}

public struct IndexProjection: Copyable {
    // 为了避免 place/operand 递归过深，index 先要求是 local。
    public LocalId index_local;
}

public struct ConstantIndexProjection: Copyable {
    public Int offset;
}

public struct SubsliceProjection: Copyable {
    public Int from;
    public Int to;
}

@region(a)
public union Operand: Copyable {
    @life(a)
    CopyOperand copy_operand;

    @life(a)
    MoveOperand move_operand;

    @life(a)
    OutOperand out_operand;

    @life(a)
    FunctionRef function_operand;
    GlobalRef global_operand;
    GlobalRef global_address_operand;
    Const const_operand;
}

public Operand copy_operand_value(CopyOperand operand) {
    return .copy_operand(operand);
}

public Operand move_operand_value(MoveOperand operand) {
    return .move_operand(operand);
}

public Operand out_operand_value(OutOperand operand) {
    return .out_operand(operand);
}

public Operand function_operand_value(FunctionRef operand) {
    return .function_operand(operand);
}

@life()
public Operand global_operand_value(GlobalRef operand) {
    return .global_operand(operand);
}

@life()
public Operand global_address_operand_value(GlobalRef operand) {
    return .global_address_operand(operand);
}

@life()
public Operand const_operand_value(Const constant) {
    return .const_operand(constant);
}

@region(a)
public struct CopyOperand: Copyable {
    @life(a)
    public Place place;
}

@region(a)
public struct MoveOperand: Copyable {
    @life(a)
    public Place place;
}

@region(a)
public struct OutOperand: Copyable {
    @life(a)
    public Place place;
}

public struct Const: Copyable {
    public qid.TypeId type_id;
    public token.Span span;
    public ConstValue value;
}

@region(a)
public struct FunctionRef: Copyable {
    public FunctionTarget target;

    @life(a)
    public qid.TypeId[]& type_args;

    @life(a, a)
    public comptime_value.ComptimeValue[]& const_args;
    public Bool coroutine_resume;
    public Bool coroutine_completion;
    public qid.TypeId type_id;
    public token.Span span;
}

public enum GeneratedFunctionKind {
    raw_fn_to_fn,
    closure_noop_drop,
    closure_env_drop_stack,
    closure_env_drop_heap,
    trait_cancel,
    trait_receiver_drop,
    domain_create,
    domain_enqueue,
    domain_destroy,
    async_callable_start,
    async_callable_completion,
    serial_completion,
    coroutine_resume,
    coroutine_resume_confined,
    coroutine_resume_rtc,
    coroutine_completion,
    runtime_entry,
    task_cleanup,
}

public union FunctionTarget: Copyable {
    qid.DefId source;
    GeneratedFunctionTarget generated;
}

public struct GeneratedFunctionTarget: Copyable {
    public FunctionId id;
    public qid.SymbolId symbol;
    public qid.ModuleId? module_id;
    public GeneratedFunctionKind kind;
    public qid.DefId provenance_def;
    public qid.TypeId? identity_type;
}

public qid.DefId function_target_provenance_def(FunctionTarget target) {
    if (target is .source(def_id)) { return def_id; }
    guard target is .generated(generated) else { return qid.DefId.from_index(0); }
    return generated.provenance_def;
}

public qid.DefId? function_target_source_def(FunctionTarget target) {
    if (target is .source(def_id)) { return def_id; }
    return null;
}

public GeneratedFunctionTarget? function_target_generated(FunctionTarget target) {
    if (target is .generated(generated)) { return generated; }
    return null;
}

public Bool function_target_equal(FunctionTarget lhs, FunctionTarget rhs) {
    if (lhs is .source(lhs_def)) {
        if (rhs is .source(rhs_def)) { return lhs_def == rhs_def; }
        return false;
    }
    guard lhs is .generated(lhs_generated) else { return false; }
    guard rhs is .generated(rhs_generated) else { return false; }
    return lhs_generated.id == rhs_generated.id;
}

public struct GlobalRef: Copyable {
    public GlobalTarget target;
    public qid.TypeId type_id;
    public Bool is_external;
    public token.Span span;
}

public enum GeneratedGlobalKind {
    raw_fn_vtable,
    lambda_vtable_stack,
    lambda_vtable_heap,
    trait_vtable,
    receiver_type,
    domain_config,
    domain_descriptor,
}

public union GlobalTarget: Copyable {
    qid.DefId source;
    GeneratedGlobalTarget generated;
}

public struct GeneratedGlobalTarget: Copyable {
    public GlobalId id;
    public qid.SymbolId symbol;
    public qid.ModuleId? module_id;
    public GeneratedGlobalKind kind;
    public qid.DefId provenance_def;
    public qid.TypeId? identity_type;
}

public Bool global_targets_equal(GlobalTarget lhs, GlobalTarget rhs) {
    if (lhs is .source(lhs_def)) {
        guard rhs is .source(rhs_def) else { return false; }
        return lhs_def == rhs_def;
    }
    guard lhs is .generated(lhs_target) else { return false; }
    guard rhs is .generated(rhs_target) else { return false; }
    return lhs_target.id.to_index() == rhs_target.id.to_index();
}

public union ConstValue: Copyable {
    public BoolConst bool_value;
    public IntConst int_value;
    public FloatConst float_value;
    public StringConst string_value;
    public NullConst null_value;
    public UnitConst unit_value;
}

public struct BoolConst: Copyable {
    public Bool value;
}

public struct IntConst: Copyable {
    public UInt64 bits;
    public Bool signed_value;
}

public struct FloatConst: Copyable {
    public Float64 value;
}

public struct StringConst: Copyable {
    public qid.SymbolId symbol_id;
    public Bool nul_terminated;
}

public struct NullConst: Copyable {
    public Bool typed_null;
}

public struct UnitConst: Copyable {
    public Bool unit_value;
}

public BoolConst? bool_const_value(ConstValue value) {
    if (value is .bool_value(bool_value)) { return bool_value; }
    return null;
}

public IntConst? int_const_value(ConstValue value) {
    if (value is .int_value(int_value)) { return int_value; }
    return null;
}

public FloatConst? float_const_value(ConstValue value) {
    if (value is .float_value(float_value)) { return float_value; }
    return null;
}

public StringConst? string_const_value(ConstValue value) {
    if (value is .string_value(string_value)) { return string_value; }
    return null;
}

public ConstValue bool_const_kind(BoolConst value) {
    return .bool_value(value);
}

public ConstValue int_const_kind(IntConst value) {
    return .int_value(value);
}

public ConstValue float_const_kind(FloatConst value) {
    return .float_value(value);
}

public ConstValue string_const_kind(StringConst value) {
    return .string_value(value);
}

public ConstValue null_const_kind(NullConst value) {
    return .null_value(value);
}

public ConstValue unit_const_kind(UnitConst value) {
    return .unit_value(value);
}

public Bool is_unit_const_value(ConstValue value) {
    return value is .unit_value(_);
}

public Bool is_null_const_value(ConstValue value) {
    return value is .null_value(_);
}
