// JIL 优化阶段的稳定入口。
//
// 这里编排依赖 Jiang 语义事实的优化；通用指令选择和目标相关优化仍交给 backend。
// 任一 CFG mutation 后都立即重算分析，调用方不能继续消费旧 facts。

import analysis = "./analysis/provenance.jiang";
import context = "../context.jiang";
import jil = "./model.jiang";
import tail_recursion = "./optimize/tail_recursion.jiang";

public tail_recursion.Statistics optimize_package(
    context.CompilerContext& ctx,
    jil.Store&! store
) {
    analysis.Store facts! = analysis.analyze(store);
    tail_recursion.Statistics statistics = tail_recursion.optimize_package(
        ctx,
        store,
        facts$.ref()
    );
    if (statistics.transformed > 0) {
        facts = analysis.analyze(store);
    }
    return statistics;
}
