// Semantic Model -> JIL lowering 的稳定入口。
//
// 阶段外代码只通过这里调用 lowering；具体 package、函数和表达式实现位于 lower/。

import context = "../context.jiang";
import jil = "./model.jiang";
import module_graph = "../resolve/module_graph.jiang";
import sem_store = "../sema/model/store.jiang";
import monomorph = "../sema/monomorph.jiang";
import typeck_store = "../sema/type_check/store.jiang";
import package = "./lower/package.jiang";

public jil.Store^ lower_package(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, instances, graph);
}

public jil.Store^ lower_package(
    context.CompilerContext& ctx,
    sem_store.Store& sem_store,
    typeck_store.TypeCheckStore& typeck,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph
) {
    return package.lower_package(ctx, sem_store, typeck, instances, graph);
}

public Void lower_package_into(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph,
    jil.Store& output
) {
    sem_store.Store& model = ctx.store.model$.ref();
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    package.lower_package_into(
        ctx,
        model,
        typeck,
        instances,
        graph,
        output
    );
}
