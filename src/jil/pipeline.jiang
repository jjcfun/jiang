// JIL 阶段编排入口，串联 lowering 与 drop elaboration。
//
// pipeline 只通过这里进入 JIL lowering 和 drop elaboration。具体 pass 的
// 实现文件仍可被阶段 smoke 直接测试。

import context = "../context.jiang";
import monomorph = "../sema/monomorph.jiang";
import module_graph = "../resolve/module_graph.jiang";
import jil = "./model.jiang";
import drop_elaborate = "./drop_elaborate.jiang";
import lower = "./lower.jiang";
import optimize = "../jil/optimize.jiang";
import verifier = "./verifier.jiang";
import database = "../db.jiang";

public jil.Store^ lower_package(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph,
    Bool verify_output
) {
    jil.Store^ lowered = lower.lower_package(ctx, instances, graph);
    if (verify_output && !lowered.has_errors()) {
        verifier.verify(ctx, lowered$.ref(), .lower_output);
    }
    return lowered;
}

public Void lower_package_into(
    context.CompilerContext& ctx,
    monomorph.MonomorphStore& instances,
    module_graph.ModuleGraph& graph,
    jil.Store& output,
    Bool verify_output
) {
    lower.lower_package_into(ctx, instances, graph, output);
    if (verify_output && !output.has_errors()) {
        verifier.verify(ctx, output, .lower_output);
    }
}

public jil.Store^ elaborate_drops(
    context.CompilerContext& ctx,
    jil.Store^ lowered,
    Bool verify_output
) {
    if (!lowered.has_query_identity()) {
        return elaborate_drops_uncached(ctx, lowered, verify_output);
    }
    Int store_identity = lowered.query_identity;
    return database.drop_elaboration(
        ctx.query$.ref(),
        store_identity,
        lowered,
        { [ref ctx, verify_output] input =>
            elaborate_drops_uncached(ctx, input, verify_output)
        }
    );
}

jil.Store^ elaborate_drops_uncached(
    context.CompilerContext& ctx,
    jil.Store^ lowered,
    Bool verify_output
) {
    jil.Store^ dropped = drop_elaborate.elaborate_package(ctx, lowered);
    if (verify_output && !dropped.has_errors()) {
        verifier.verify(ctx, dropped$.ref(), .drop_output);
    }
    return dropped;
}

public jil.Store^ optimize_for_backend(
    context.CompilerContext& ctx,
    jil.Store^ dropped,
    Bool verify_output
) {
    jil.Store^ result! = dropped;
    optimize.optimize_package(ctx, result$.mut_ref());
    if (verify_output && !result.has_errors()) {
        verifier.verify(ctx, result$.ref(), .backend_input);
    }
    return result;
}
