// 编译器 core 模块源码。
//
// module graph 会先于用户 root 加载这个入口。这里保持为较小的聚合文件；
// 各个 core 领域仍放在相邻文件中。

public import * = "core/primitives.jiang";
public import * = "core/traits.jiang";
public import * = "core/executor.jiang";
public import * = "core/contiguous.jiang";
public import * = "core/value.jiang";
public import atomic = "core/atomic.jiang";
public import mutex = "core/mutex.jiang";
public import coroutine = "core/coroutine.jiang";
