// Public query API facade.
//
// Compiler code should ask questions through this layer instead of reading
// resolve/sema/ir internal tables directly. Implementations live behind providers.

import qid = "./id.jiang";
import qdb = "./db.jiang";
import token = "../syntax/token.jiang";

public struct QuerySystem {
    qdb.QueryDb db;

    public init() {
        self.db = qdb.QueryDb();
    }

    public qid.SymbolId intern_symbol(UInt8[] text) {
        return self.db.symbols.intern(text);
    }

    public UInt8[] symbol_text(qid.SymbolId symbol) {
        return self.db.symbols.text(symbol);
    }

    public token.Keyword? keyword(qid.SymbolId symbol) {
        return self.db.keywords.find(symbol);
    }
}
