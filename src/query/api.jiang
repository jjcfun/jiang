// Public query system state.
//
// QuerySystem owns global compiler facts for one compilation session. Stages use
// the owned stores directly; higher-level query evaluation can be layered on top
// when cache-backed evaluation is implemented.

import cache = "./cache.jiang";
import ast_store = "./ast_store.jiang";
import def = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import store = "../resolve/store.jiang";
import source_store = "../source/store.jiang";
import builtin = "../sema/builtin.jiang";
import types = "../sema/type.jiang";

public struct QuerySystem {
    public cache.QueryCache cache;
    public source_store.SourceStore sources;
    public ast_store.AstStore asts;
    public interner.SymbolTable symbols;
    public interner.KeywordTable keywords;
    public def.DefTable defs;
    public types.TypeTable types;
    public store.ResolveStore resolve;

    public init() {
        self.cache = cache.QueryCache();
        self.sources = source_store.SourceStore();
        self.asts = ast_store.AstStore();
        self.symbols = interner.SymbolTable();
        self.keywords = interner.KeywordTable(self.symbols$.ref());
        self.defs = def.DefTable();
        self.types = types.TypeTable();
        self.resolve = store.ResolveStore();
        builtin.init_builtins(self.symbols$.ref(), self.defs$.ref(), self.resolve$.ref(), self.types$.ref());
    }
}
