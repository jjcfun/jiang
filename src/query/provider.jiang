// Query provider registration and dispatch metadata.
//
// resolve/sema/ir/backend can each provide query implementations without exposing
// their internal tables to ordinary compiler code.

import qkey = "./key.jiang";

public enum QueryProviderKind {
    name_provider,
    sema_provider,
    ir_provider,
    backend_provider,
}

public struct QueryProviderId {
    public Int index;
}

public struct QueryProvider {
    public QueryProviderId id;
    public QueryProviderKind kind;
    public qkey.QueryKind[] handled_queries;
}
