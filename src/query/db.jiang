// Query database.
//
// QueryDb 是全局事实表的聚合点。具体 record/key 类型仍由 owner 模块定义，
// 这里负责集中生命周期和初始化顺序。

import qengine = "./engine.jiang";
import resolve = "../resolve/interner.jiang";

public struct QueryDb {
    public qengine.QueryEngine engine;
    public resolve.SymbolTable symbols;
    public resolve.KeywordTable keywords;

    public init() {
        self.engine = qengine.QueryEngine();
        self.symbols = resolve.SymbolTable();
        self.keywords = resolve.KeywordTable(self.symbols$.ref());
    }
}
