// AstStore 保存一次 package 编译中的 AST 阶段产物。
//
// AstId 仍然只在单个 AstFile 内有效；这里按 SourceId 保存 AstFile，
// 让 import discovery 和 HIR lowering 共享 root/import closure 的解析结果。
// 这张表不挂在 QuerySystem 上，HIR 生成完成后即可释放。

import table = "../support/table.jiang";
import source = "../source/source.jiang";
import ast = "../syntax/ast.jiang";

public struct AstRecord {
    public source.SourceId source_id;
    public Int source_revision;
    public ast.AstFile^ file;
}

public struct AstStore {
    table.HashTable<source.SourceId, AstRecord> files;

    public init() {
        self.files = table.HashTable<source.SourceId, AstRecord>();
    }

    public () set_file(ast.AstFile^ file, Int source_revision) {
        self.files.set(file.source_id, AstRecord {
            source_id: file.source_id,
            source_revision: source_revision,
            file: file
        });
    }

    public ast.AstFile&? file(source.SourceId source_id, Int source_revision) {
        guard self.files.get_ref(source_id) is some entry else {
            return null;
        }
        if (entry.source_revision != source_revision) {
            return null;
        }
        return entry.file$.ref();
    }
}
