// Stable and cacheable keys used by the query engine.

import hash = "../support/hash.jiang";
import blake3 = "../support/blake3.jiang";
import list = "../support/list.jiang";
import qid = "./id.jiang";
import rdef = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import ast = "../syntax/ast.jiang";
import source = "../source/source.jiang";

public struct StableSymbolId: Hashable, Equatable {
    public UInt64 low;
    public UInt64 high;

    public init() {
        self.low = 0;
        self.high = 0;
    }

    public init(UInt64 low, UInt64 high) {
        self.low = low;
        self.high = high;
    }

    public UInt64 hash() {
        return hash.combine(self.low, self.high);
    }

    public static Bool equal(StableSymbolId& lhs, StableSymbolId& rhs) {
        return lhs.low == rhs.low && lhs.high == rhs.high;
    }
}

public struct Fingerprint128: Hashable, Equatable {
    public UInt64 low;
    public UInt64 high;

    public init() {
        self.low = 0;
        self.high = 0;
    }

    public init(UInt64 low, UInt64 high) {
        self.low = low;
        self.high = high;
    }

    public UInt64 hash() {
        return hash.combine(self.low, self.high);
    }

    public static Bool equal(Fingerprint128& lhs, Fingerprint128& rhs) {
        return lhs.low == rhs.low && lhs.high == rhs.high;
    }
}

public enum StableSymbolKind {
    package_symbol,
    module_symbol,
    type_symbol,
    trait_symbol,
    function_symbol,
    global_symbol,
    field_symbol,
    enum_case_symbol,
    union_variant_symbol,
    associated_type_symbol,
    local_symbol,
}

public struct StableSymbolKey: Hashable, Equatable {
    public StableSymbolKind kind;
    public qid.SymbolId package_name;
    public qid.SymbolId module_path;
    public StableSymbolId? owner;
    public qid.SymbolId name;
    public rdef.NameDomain domain;

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.kind.value);
        hasher.write_int(self.domain.value);
        hasher.write_int(self.package_name.to_index());
        hasher.write_int(self.module_path.to_index());
        hasher.write_int(self.name.to_index());
        write_stable_owner(hasher$.ref(), self.owner);
        return hasher.finish();
    }

    public static Bool equal(StableSymbolKey& lhs, StableSymbolKey& rhs) {
        if (lhs.kind.value != rhs.kind.value) {
            return false;
        }
        if (lhs.domain.value != rhs.domain.value) {
            return false;
        }
        if (lhs.package_name != rhs.package_name) {
            return false;
        }
        if (lhs.module_path != rhs.module_path) {
            return false;
        }
        if (lhs.name != rhs.name) {
            return false;
        }
        return stable_owner_equal(lhs.owner, rhs.owner);
    }
}

public Bool stable_symbol_key_matches_owner_name(
    StableSymbolKey key,
    StableSymbolId owner,
    qid.SymbolId name,
    StableSymbolKind kind,
    rdef.NameDomain domain
) {
    if (key.owner is some record_owner) {
        return record_owner == owner
            && key.name == name
            && key.kind == kind
            && key.domain == domain;
    }
    return false;
}

// StableSymbolId 是跨 session 复用的语义身份。它必须由 stable key 的确定性
// 字节流生成，不能依赖 SymbolId index 或临时 HashTable hasher。
public StableSymbolId stable_symbol_id_for_key(interner.SymbolTable& symbols, StableSymbolKey key) {
    list.ArrayList<UInt8>! bytes = list.ArrayList<UInt8>();
    write_stable_symbol_key_bytes(bytes$.ref(), symbols, key);
    blake3.Blake3Hash digest = blake3.blake3_hash(bytes.slice());
    return StableSymbolId(digest.a, digest.b);
}

// stable symbol id 的输入必须是确定性字节流，不能复用 HashTable 的临时
// hasher。这里写文本而不是 SymbolId index，保证跨进程/跨 session 稳定。
() write_stable_symbol_key_bytes(
    list.ArrayList<UInt8>& bytes,
    interner.SymbolTable& symbols,
    StableSymbolKey key
) {
    write_stable_int(bytes, key.kind.value);
    write_stable_int(bytes, key.domain.value);
    write_stable_symbol_text(bytes, symbols, key.package_name);
    write_stable_symbol_text(bytes, symbols, key.module_path);
    write_stable_symbol_text(bytes, symbols, key.name);
    write_stable_owner_bytes(bytes, key.owner);
}

() write_stable_symbol_text(
    list.ArrayList<UInt8>& bytes,
    interner.SymbolTable& symbols,
    qid.SymbolId symbol
) {
    UInt8[] text = symbols.text(symbol);
    write_stable_int(bytes, text.length);
    write_stable_bytes(bytes, text);
}

() write_stable_owner_bytes(list.ArrayList<UInt8>& bytes, StableSymbolId? owner) {
    if (owner is some owner_id) {
        write_stable_bool(bytes, true);
        write_stable_uint64(bytes, owner_id.low);
        write_stable_uint64(bytes, owner_id.high);
        return;
    }
    write_stable_bool(bytes, false);
}

() write_stable_bool(list.ArrayList<UInt8>& bytes, Bool value) {
    if (value) {
        bytes.add(1);
        return;
    }
    bytes.add(0);
}

() write_stable_int(list.ArrayList<UInt8>& bytes, Int value) {
    write_stable_uint64(bytes, UInt64(value));
}

() write_stable_uint64(list.ArrayList<UInt8>& bytes, UInt64 value) {
    UInt64! current = value;
    Int! index = 0;
    while (index < 8) {
        bytes.add(UInt8(current & 255));
        current = current >> 8;
        index = index + 1;
    }
}

() write_stable_bytes(list.ArrayList<UInt8>& bytes, UInt8[] value) {
    Int! index = 0;
    while (index < value.length) {
        bytes.add(value[index]);
        index = index + 1;
    }
}

public () write_stable_symbol_key(
    hash.WyHasher& hasher,
    interner.SymbolTable& symbols,
    StableSymbolKey key
) {
    hasher.write_int(key.kind.value);
    hasher.write_int(key.domain.value);
    write_symbol_text(hasher, symbols, key.package_name);
    write_symbol_text(hasher, symbols, key.module_path);
    write_symbol_text(hasher, symbols, key.name);
    write_stable_owner(hasher, key.owner);
}

() write_session_symbol_key(hash.WyHasher& hasher, StableSymbolKey& key) {
    hasher.write_int(key.kind.value);
    hasher.write_int(key.domain.value);
    hasher.write_int(key.package_name.to_index());
    hasher.write_int(key.module_path.to_index());
    hasher.write_int(key.name.to_index());
    write_stable_owner(hasher, key.owner);
}

() write_symbol_text(hash.WyHasher& hasher, interner.SymbolTable& symbols, qid.SymbolId symbol) {
    UInt8[] text = symbols.text(symbol);
    hasher.write_int(text.length);
    hasher.write_bytes(text);
}

() write_stable_owner(hash.WyHasher& hasher, StableSymbolId? owner) {
    if (owner is some owner_id) {
        hasher.write_bool(true);
        hasher.write_uint64(owner_id.low);
        hasher.write_uint64(owner_id.high);
        return;
    }
    hasher.write_bool(false);
}

Bool stable_owner_equal(StableSymbolId? lhs, StableSymbolId? rhs) {
    if (lhs is some lhs_id) {
        if (rhs is some rhs_id) {
            return lhs_id == rhs_id;
        }
        return false;
    }
    return rhs == null;
}

public struct AstRef {
    public source.SourceId source_id;
    public ast.AstId ast_id;
}

public enum QueryKind {
    resolve_name,
    resolve_path,
    def_info,
    type_of_expr,
    type_of_def,
    signature_of,
    fields_of,
    trait_info,
    impl_info,
    hir_of_module,
    jir_of_module,
}

public union QuerySubject {
    qid.ModuleId module_id;
    qid.NamespaceId namespace_id;
    qid.DefId def_id;
    AstRef ast_ref;
    qid.TypeId type_id;
}

public struct QueryKey {
    public QueryKind kind;
    public QuerySubject subject;
}

public enum DependencyKind {
    source_file,
    module_surface,
    def_signature,
    def_body,
    semantic_fact,
    ir_fact,
    artifact,
}

public struct DependencyKey {
    public DependencyKind kind;
    public StableSymbolId? stable_symbol;
    public qid.ModuleId? module_id;
}
