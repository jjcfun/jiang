// Public result shapes returned by query/api.jiang.

import qid = "./id.jiang";
import token = "../syntax/token.jiang";

public enum QueryStatus {
    missing,
    found,
    ambiguous,
    inaccessible,
    invalid,
    cycle,
}

public struct NameLookupRequest {
    public qid.ScopeId start_scope;
    public qid.SymbolId symbol;
    public qid.NameNamespace name_space;
    public Bool search_parents;
}

public struct NameLookupResult {
    public QueryStatus status;
    public qid.DefId? def_id;
    public qid.ScopeId? found_scope;
}

public struct ResolvedName {
    public QueryStatus status;
    public qid.SymbolId symbol;
    public qid.NameNamespace name_space;
    public qid.DefId? def_id;
    public token.Span span;
}

public struct DefInfo {
    public qid.DefId id;
    public qid.DefKind kind;
    public qid.SymbolId name;
    public qid.NameNamespace name_space;
    public qid.Visibility visibility;
    public qid.DefId? owner;
    public qid.ModuleId module_id;
    public token.Span span;
}

public struct TypeQueryResult {
    public QueryStatus status;
    public qid.TypeId? type_id;
}

public struct SignatureQueryResult {
    public QueryStatus status;
    public qid.SignatureId? signature_id;
}
