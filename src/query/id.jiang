// Cross-stage IDs shared by query API, name, sema, IR, and incremental layers.
//
// Rule: if an ID can cross a phase boundary, define it here. Phase-private
// array indexes stay in that phase's internal files.

import "../support/traits.jiang";

public struct QuerySessionId {
    public Int index;
}

public struct QueryId {
    public Int index;
}

public struct SymbolId: traits.Indexable, Hashable {
    // SymbolId is always a valid 0-based interned symbol index.
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public UInt64 hash() {
        return UInt64(self.index);
    }

    public static Bool equal(SymbolId& lhs, SymbolId& rhs) {
        return lhs.index == rhs.index;
    }

    public static SymbolId from_index(Int index) {
        return SymbolId(index);
    }
}

public struct PackageId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static PackageId from_index(Int index) {
        return PackageId(index);
    }
}

public struct ModuleId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static ModuleId from_index(Int index) {
        return ModuleId(index);
    }
}

public struct NamespaceId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static NamespaceId from_index(Int index) {
        return NamespaceId(index);
    }
}

public struct DefId: traits.Indexable, Hashable, Equatable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static DefId from_index(Int index) {
        return DefId(index);
    }

    public UInt64 hash() {
        return UInt64(self.index + 1);
    }

    public static Bool equal(DefId& lhs, DefId& rhs) {
        return lhs.index == rhs.index;
    }
}

public struct TypeId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static TypeId from_index(Int index) {
        return TypeId(index);
    }
}

public struct TypeParamId {
    public Int index;
}

public struct TraitId {
    public Int index;
}

public struct ImplId {
    public Int index;
}

public struct ExprId {
    public Int index;
}

public struct TypeRefId {
    public Int index;
}

public struct SignatureId {
    public Int index;
}
