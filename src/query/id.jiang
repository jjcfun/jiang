// Cross-stage IDs shared by query API, name, sema, IR, and incremental layers.
//
// Rule: if an ID can cross a phase boundary, define it here. Phase-private
// array indexes stay in that phase's internal files.

import "../support/traits.jiang";

public struct QuerySessionId {
    public Int index;
}

public struct QueryId {
    public Int index;
}

public struct SymbolId: traits.Indexable, Hashable {
    // SymbolId is always a valid 0-based interned symbol index.
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public UInt64 hash() {
        return UInt64(self.index);
    }

    public static Bool equal(SymbolId& lhs, SymbolId& rhs) {
        return lhs.index == rhs.index;
    }

    public static SymbolId from_index(Int index) {
        return SymbolId(index);
    }
}

public struct PackageId {
    public Int index;
}

public struct ModuleId {
    public Int index;
}

public struct ScopeId {
    public Int index;
}

public struct DefId {
    public Int index;
}

public struct TypeId {
    public Int index;
}

public struct TypeParamId {
    public Int index;
}

public struct TraitId {
    public Int index;
}

public struct ImplId {
    public Int index;
}

public struct ExprId {
    public Int index;
}

public struct TypeRefId {
    public Int index;
}

public struct SignatureId {
    public Int index;
}

public enum NameNamespace {
    type_name,
    value_name,
    member_name,
    label_name,
}

public enum Visibility {
    private_visibility,
    public_visibility,
}

public enum DefKind {
    package_def,
    module_def,
    import_alias_def,
    type_def,
    trait_def,
    function_def,
    global_def,
    field_def,
    enum_case_def,
    union_variant_def,
    associated_type_def,
    generic_param_def,
    parameter_def,
    local_def,
    builtin_type_def,
    builtin_value_def,
    error_def,
}
