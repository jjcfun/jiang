// Query cache, dependency tracking, and invalidation.

import qid = "./id.jiang";
import qkey = "./key.jiang";
import qresult = "./result.jiang";

public enum QueryState {
    empty,
    running,
    cached,
    poisoned,
}

public struct QueryCacheEntry {
    public qid.QueryId id;
    public qkey.QueryKey key;
    public qresult.QueryStatus status;
    public QueryState state;
    public Int result_index;
}

public struct QueryDependency {
    public qid.QueryId query_id;
    public qkey.DependencyKey dependency;
}

public struct QueryEngine {
    public QueryCacheEntry[] cache_entries;
    public QueryDependency[] dependencies;
    public Int cache_entry_count;
    public Int dependency_count;
    public Int generation;
}
