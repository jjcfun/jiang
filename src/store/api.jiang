// Public compiler store state.
//
// CompilerStore 统一持有跨阶段事实集合。各阶段通过明确的 store API 访问事实；
// cache-backed query evaluation 等 0.2 自举链路稳定后再接入。

import source_map = "../source/source_map.jiang";
import hir_store = "../hir/store.jiang";
import layout = "../layout/layout.jiang";
import def = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import store = "../resolve/store.jiang";
import source_store = "../source/store.jiang";
import artifact = "../artifact/source.jiang";
import object_artifact = "../artifact/object.jiang";
import query_dependency = "../incremental/query_dependency.jiang";
import incremental_store = "../incremental/symbol_store.jiang";
import builtin = "../builtin/api.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import types = "../sema/type.jiang";
import typeck_store = "../sema/type_check/store.jiang";

public struct CompilerStore: Movable {
    public diagnostic.DiagnosticStore diagnostics;
    public source_store.SourceStore sources;
    public source_map.SourceMap! source_map;
    public interner.SymbolStore symbols;
    public def.DefStore! defs;
    public types.TypeStore! types;
    public typeck_store.TypeCheckStore! typeck;
    public store.ResolveStore! resolve;
    public hir_store.HirStore! hirs;
    public layout.LayoutStore! layouts;
    public artifact.SourceArtifactCache artifacts;
    public object_artifact.ObjectArtifactCache object_artifacts;
    public query_dependency.QueryDependencyGraph query_dependencies;
    public incremental_store.IncrementalSymbolStore incremental;

    public init() {
        self.diagnostics = diagnostic.DiagnosticStore();
        self.sources = source_store.SourceStore();
        self.source_map = source_map.SourceMap();
        self.symbols = interner.SymbolStore();
        self.defs = def.DefStore();
        self.types = types.TypeStore();
        self.typeck = typeck_store.TypeCheckStore();
        self.resolve = store.ResolveStore();
        self.hirs = hir_store.HirStore();
        self.layouts = layout.LayoutStore();
        self.artifacts = artifact.SourceArtifactCache();
        self.object_artifacts = object_artifact.ObjectArtifactCache();
        self.query_dependencies = query_dependency.QueryDependencyGraph();
        self.incremental = incremental_store.IncrementalSymbolStore();
        self.init_builtin_compilation_state();
    }

    // 开始新一轮 package 编译时，保留 sources/symbols/artifacts/incremental，
    // 重建所有 session-local 语义表。这样同一个 CompilerContext 可以服务
    // 多轮编译，而不会复用旧 DefId/HirId/TypeId。
    public () begin_compilation() {
        self.diagnostics.clear();
        self.incremental.begin_generation();
        self.artifacts.reset_stats();
        self.object_artifacts.reset_stats();
        self.source_map = source_map.SourceMap();
        self.defs = def.DefStore();
        self.types = types.TypeStore();
        self.typeck = typeck_store.TypeCheckStore();
        self.resolve = store.ResolveStore();
        self.hirs = hir_store.HirStore();
        self.layouts = layout.LayoutStore();
        self.init_builtin_compilation_state();
    }

    () init_builtin_compilation_state() {
        builtin.init_builtins(
            self.symbols$.ref(),
            self.defs$.ref(),
            self.resolve$.ref(),
            self.hirs$.ref(),
            self.source_map$.ref(),
            self.types$.ref(),
            self.incremental$.ref()
        );
    }
}
