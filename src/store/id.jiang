// 跨阶段共享的 session-local handle。
//
// 能跨阶段传递的 ID 统一定义在这里；阶段私有数组下标留在该阶段内部文件。

import std;
import "../support/traits.jiang";

public alias SymbolId = std.jiang.syntax.SymbolId;

public struct PackageId: traits.Indexable, Hashable, Equatable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public static PackageId from_index(Int index) {
        return PackageId(index);
    }

    public UInt64 hash(self) {
        return UInt64(self.index + 1);
    }

    public static Bool equal(PackageId& lhs, PackageId& rhs) {
        return lhs.index == rhs.index;
    }
}

