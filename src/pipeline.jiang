// Compile pipeline orchestration across source, syntax, resolve, sema, lower, backend.

import context = "./context.jiang";
import diagnostic = "./diagnostic/diagnostic.jiang";
import resolve = "./resolve/module_resolver.jiang";
import result = "./resolve/result.jiang";
import syntax = "./syntax/api.jiang";
import fs = "./support/fs.jiang";
import path = "./support/path.jiang";
import string = "./support/string.jiang";
import package_manifest = "./source/package_manifest.jiang";
import source = "./source/source.jiang";

public () compile_source(context.CompilerContext& ctx, UInt8[] text) {
    source.SourceId source_id = ctx.query.sources.add_anonymous(source.content_hash(text));
    self_compile_source(ctx, text, source_id);
}

public () compile_file(context.CompilerContext& ctx, UInt8[] file_path) {
    UInt8[] normalized = path.normalize(file_path);
    guard fs.read_all(normalized) is some text else {
        add_package_error(ctx, string.append("failed to read source file: ", normalized), "source_file_not_found");
        return;
    }
    source.SourceId source_id = ctx.query.sources.intern_path(normalized, source.content_hash(text));
    self_compile_source(ctx, text, source_id);
}

public () compile_path(context.CompilerContext& ctx, UInt8[] input_path) {
    UInt8[] normalized = path.normalize(input_path);
    if (fs.read_all(normalized) is some text) {
        source.SourceId source_id = ctx.query.sources.intern_path(normalized, source.content_hash(text));
        self_compile_source(ctx, text, source_id);
        return;
    }

    package_manifest.PackageManifest manifest = package_manifest.read(normalized);
    if (!manifest.ok) {
        add_package_error(ctx, manifest.error, "invalid_package_manifest");
        return;
    }
    compile_file(ctx, package_manifest.root_file_path(normalized, manifest$.ref()));
}

() self_compile_source(context.CompilerContext& ctx, UInt8[] text, source.SourceId source_id) {
    syntax.SyntaxResult syntax_result = syntax.parse_source(ctx, text, source_id);
    if (syntax_result.has_errors()) {
        return;
    }
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    result.ResolvedFile^ resolved = resolver.resolve_file(syntax_result.file$.ref());
}

() add_package_error(context.CompilerContext& ctx, UInt8[] message, UInt8[] code) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
