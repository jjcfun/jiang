// Compile pipeline orchestration across source, syntax, resolve, sema, lower, backend.

import context = "./context.jiang";
import diagnostic = "./diagnostic/diagnostic.jiang";
import syntax_store = "./syntax/store.jiang";
import qid = "./store/id.jiang";
import object_artifact = "./artifact/object.jiang";
import object_hash = "./artifact/object_hash.jiang";
import object_plan = "./artifact/object_plan.jiang";
import artifact_path = "./artifact/path.jiang";
import source_ji = "./artifact/source_ji.jiang";
import backend = "./backend/api.jiang";
import codegen_unit = "./backend/codegen_unit.jiang";
import link_plan = "./backend/link_plan.jiang";
import linker = "./backend/linker.jiang";
import borrow_check = "./borrow_check/api.jiang";
import borrow_store = "./borrow_check/store.jiang";
import driver_options = "./driver/options.jiang";
import mir = "./mir/mir.jiang";
import mir_drop = "./mir/drop_elaborate.jiang";
import mir_lower = "./mir/lower.jiang";
import resolve = "./resolve/module_resolver.jiang";
import module_graph = "./resolve/module_graph.jiang";
import resolve_store = "./resolve/store.jiang";
import syntax = "./syntax/api.jiang";
import fs = "./support/fs.jiang";
import list = "./support/list.jiang";
import path = "./support/path.jiang";
import string = "./support/string.jiang";
import package_manifest = "./source/package_manifest.jiang";
import monomorph = "./sema/monomorph.jiang";
import type_check = "./sema/type_check/api.jiang";
import source = "./source/source.jiang";

// 编译器唯一公开入口。driver 负责把命令行整理成 CompileOptions，
// pipeline 只按 options 串联 source 到 backend 的阶段。
public () compile(context.CompilerContext& ctx, driver_options.CompileOptions& options) {
    ctx.begin_compilation();
    UInt8[] root_path = package_root_file_path(options.input_path);
    UInt8[] normalized = path.normalize(root_path);
    guard fs.read_all(normalized) is some source_text else {
        add_package_error(ctx, string.append("failed to read source file: ", normalized), "source_file_not_found");
        return;
    }
    source.SourceId source_id = ctx.store.sources.intern_path(normalized, source.content_hash(source_text));
    compile_package_with_emit(
        ctx,
        source_id,
        source_text,
        options.emit,
        options.output_path,
        options.artifact_cache_dir,
        options.target_triple,
        options.compiler_version,
        options.linker_path,
        options.link_args$.ref(),
        options.mode
    );
}

// 将输入路径归一化为 package root source。这里只处理入口文件选择，
// 不读取 source，也不创建任何语义 store。
UInt8[] package_root_file_path(UInt8[] input_path) {
    UInt8[] normalized = path.normalize(input_path);
    if (package_manifest.exists(normalized)) {
        return package_manifest_root_file_path(normalized);
    }
    return normalized;
}

// 从 package manifest 中解析 root source 路径。manifest 只影响入口文件，
// 后续 import closure 仍由 resolve 阶段负责发现。
UInt8[] package_manifest_root_file_path(UInt8[] package_dir) {
    package_manifest.PackageManifest manifest = package_manifest.read(package_dir);
    return package_manifest.root_file_path(package_dir, manifest$.ref());
}

// package 编译主干。这个函数只编排阶段顺序和早停条件；
// 具体语义检查、MIR 改写和 backend lowering 必须留在各自阶段内。
() compile_package_with_emit(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    UInt8[] source_text,
    driver_options.EmitKind emit,
    UInt8[] output_path,
    UInt8[] artifact_cache_dir,
    UInt8[] target_triple,
    UInt8[] compiler_version,
    UInt8[] linker_path,
    list.ArrayList<UInt8[]>& link_args,
    driver_options.CompileMode mode
) {
    // syntax.Store 是本次 package 编译的临时 parse cache。resolve/HIR 完成后，
    // AST 不再进入 CompilerStore 的长期状态。
    syntax_store.Store! asts = syntax_store.Store();
    syntax.SyntaxResult! syntax_result = syntax.parse_source(ctx, source_text, source_id);
    if (syntax_result.has_errors()) {
        return;
    }
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(syntax_result.take_unit(), source_revision);
    guard asts.unit(source_id, source_revision) is some root_unit else {
        add_package_error(ctx, "failed to load parsed root file", "root_ast_missing");
        return;
    }
    UInt64 compiler_version_hash = source_artifact_version_hash(compiler_version);
    Bool use_source_artifacts = emit != .llvm_ir;
    resolve.ModuleResolver resolver = resolve.ModuleResolver(
        ctx,
        asts$.ref(),
        artifact_cache_dir,
        compiler_version_hash,
        use_source_artifacts
    );
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    if (!graph.ok) {
        return;
    }
    if (!resolver.lower_module_graph_to_hir(graph$.ref())) {
        return;
    }
    if (!type_check.check_hir_package(ctx, graph$.ref())) {
        return;
    }
    if (use_source_artifacts) {
        write_source_artifact_cache(ctx, graph$.ref(), artifact_cache_dir, compiler_version);
    }
    monomorph.MonomorphStore^ instances = monomorph.collect_reachable_instances(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        graph$.ref()
    );
    mir.MirStore^ lowered = mir_lower.lower_package(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        instances$.ref(),
        graph$.ref()
    );
    if (lowered.has_errors()) {
        add_package_error(ctx, "MIR lowering failed", "mir_lowering_failed");
        return;
    }
    borrow_store.BorrowCheckStore^ borrow_check_results = borrow_check.check_package(
        ctx,
        lowered$.ref(),
        ctx.store.typeck$.ref(),
        ctx.store.layouts$.ref()
    );
    if (!borrow_check_results.ok) {
        add_package_error(ctx, "borrow check failed", "borrow_check_failed");
        return;
    }
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx, lowered$.move(), ctx.store.layouts$.ref());
    if (dropped.has_errors()) {
        add_package_error(ctx, "drop elaboration failed", "drop_elaboration_failed");
        return;
    }
    if (emit == .check_only) {
        return;
    }
    if (!prepare_artifact_cache(ctx, emit, artifact_cache_dir)) {
        return;
    }
    backend.BackendResult result = emit_backend(
        ctx,
        dropped$.ref(),
        emit,
        output_path,
        artifact_cache_dir,
        target_triple,
        compiler_version,
        linker_path,
        link_args,
        ctx.store.sources.get(source_id).content_hash,
        mode
    );
    if (result.has_errors()) {
        add_package_error(ctx, "backend emission failed", "backend_emit_failed");
        return;
    }
}

// 确保需要 object cache 的 emit 模式有 cache 目录。check/llvm-ir 不产生 object，
// 因此不创建 artifact 目录。
Bool prepare_artifact_cache(
    context.CompilerContext& ctx,
    driver_options.EmitKind emit,
    UInt8[] artifact_cache_dir
) {
    if (emit == .check_only || emit == .llvm_ir) {
        return true;
    }
    UInt8[] object_dir = artifact_path.object_dir(artifact_cache_dir);
    if (fs.create_dirs(object_dir)) {
        return true;
    }
    add_package_error(
        ctx,
        string.append("failed to create artifact cache directory: ", object_dir),
        "cache_dir_failed"
    );
    return false;
}

// 写入 source interface cache。source artifact 只缓存跨编译可复用的公开事实，
// 不能写入 session-local HIR/Type/MIR 对象。
() write_source_artifact_cache(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    UInt8[] artifact_cache_dir,
    UInt8[] compiler_version
) {
    UInt8[] source_dir = artifact_path.source_dir(artifact_cache_dir);
    if (!fs.create_dirs(source_dir)) {
        return;
    }

    UInt64 version_hash = source_artifact_version_hash(compiler_version);
    Int! index = 0;
    while (index < graph.module_count()) {
        write_module_source_artifact(ctx, graph.module_at(index), artifact_cache_dir, version_hash);
        index = index + 1;
    }
}

// 为单个 module 写入 `.ji` interface。没有 stable def id 的 module 不具备
// 跨编译身份，不能进入本地 artifact cache。
() write_module_source_artifact(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[] artifact_cache_dir,
    UInt64 compiler_version
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    guard ctx.store.incremental.stable_id_for_def(module.def_id) is some stable_id else {
        return;
    }
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    UInt8[] artifact_file = artifact_path.source_ji_path(
        artifact_cache_dir,
        stable_id,
        source_record.content_hash
    );
    source_ji.write_source_ji_file(
        ctx,
        ctx.store.artifacts$.ref(),
        module.source_id,
        compiler_version,
        artifact_file
    );
}

// source interface 的版本 hash 统一委托给 artifact 层，pipeline 不定义格式。
UInt64 source_artifact_version_hash(UInt8[] compiler_version) {
    return source_ji.artifact_version_hash(compiler_version);
}

// 根据 emit kind 分发 backend 输出。executable/object 可以使用 object cache；
// llvm-ir 是调试输出，直接消费最终 MIR。
backend.BackendResult emit_backend(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    driver_options.EmitKind emit,
    UInt8[] output_path,
    UInt8[] artifact_cache_dir,
    UInt8[] target_triple,
    UInt8[] compiler_version,
    UInt8[] linker_path,
    list.ArrayList<UInt8[]>& link_args,
    UInt64 root_source_hash,
    driver_options.CompileMode mode
) {
    if (emit == .object_file) {
        return emit_object_with_cache(
            ctx,
            lowered,
            output_path,
            artifact_cache_dir,
            target_triple,
            compiler_version,
            root_source_hash,
            mode
        );
    }
    if (emit == .llvm_ir) {
        if (output_path.length == 0) {
            backend.BackendTextResult text = backend.emit_llvm_ir_text(ctx, lowered);
            if (!text.ok) {
                return backend.BackendResult(false);
            }
            return backend.BackendResult(fs.write_stdout(text.text));
        }
        UInt8![*] c_output_path = backend_output_buffer(output_path);
        return backend.emit_llvm_ir(ctx, lowered, c_output_path$.as(UInt8[*]));
    }
    if (mode == .release) {
        return emit_release_executable(
            ctx,
            lowered,
            output_path,
            artifact_cache_dir,
            target_triple,
            compiler_version,
            linker_path,
            link_args,
            root_source_hash
        );
    }
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx, lowered);
    object_plan.ObjectReusePlan plan = object_plan.build_object_reuse_plan(
        ctx,
        lowered,
        units$.ref(),
        artifact_cache_dir,
        target_triple,
        compiler_version,
        mode
    );
    record_object_plan_stats(ctx, plan$.ref());
    if (!emit_plan_cache_objects(ctx, lowered, units$.ref(), plan$.ref(), mode)) {
        return backend.BackendResult(false);
    }
    link_plan.LinkPlan links = link_plan.link_plan_from_object_plan(plan$.ref());
    linker.LinkResult result = linker.link(links$.ref(), linker_path, output_path, link_args);
    if (!result.ok) {
        add_package_error(ctx, linker_failure_message(result, linker_path, output_path, links$.ref()), "linker_execution_failed");
    }
    return backend.BackendResult(result.ok);
}

backend.BackendResult emit_release_executable(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[] output_path,
    UInt8[] artifact_cache_dir,
    UInt8[] target_triple,
    UInt8[] compiler_version,
    UInt8[] linker_path,
    list.ArrayList<UInt8[]>& link_args,
    UInt64 root_source_hash
) {
    UInt8[] object_path = artifact_path.release_package_object_path(
        artifact_cache_dir,
        target_triple,
        compiler_version,
        root_source_hash
    );
    if (!emit_release_package_object(ctx, lowered, object_path)) {
        return backend.BackendResult(false);
    }
    link_plan.LinkPlan! links = link_plan.LinkPlan();
    links.add_object(object_path);
    linker.LinkResult result = linker.link(links$.ref(), linker_path, output_path, link_args);
    if (!result.ok) {
        add_package_error(ctx, linker_failure_message(result, linker_path, output_path, links$.ref()), "linker_execution_failed");
    }
    return backend.BackendResult(result.ok);
}

Bool emit_release_package_object(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[] output_path
) {
    UInt8![*] c_output_path = backend_output_buffer(output_path);
    backend.BackendResult emitted = backend.emit_object(
        ctx,
        lowered,
        c_output_path$.as(UInt8[*]),
        driver_options.CompileMode.release
    );
    return !emitted.has_errors();
}

UInt8[] linker_failure_message(
    linker.LinkResult result,
    UInt8[] linker_path,
    UInt8[] output_path,
    link_plan.LinkPlan& links
) {
    UInt8[]! message = "linker execution failed: linker=";
    message = string.append(message, linker_path);
    if (result.started) {
        message = string.append(message, ", exit_code=");
    } else {
        message = string.append(message, ", spawn_errno=");
    }
    message = string.append(message, string.int_text(result.exit_code));
    message = string.append(message, ", output=");
    message = string.append(message, linker_output_path(output_path));
    message = string.append(message, ", inputs=");
    return string.append(message, string.int_text(links.len()));
}

UInt8[] linker_output_path(UInt8[] output_path) {
    if (output_path.length == 0) {
        return "a.out";
    }
    return output_path;
}

// 生成单个 object 输出。能复用单个 cache object 时直接复制；多 codegen unit
// 当前仍回退为整包 object 输出，避免输出路径语义不清。
backend.BackendResult emit_object_with_cache(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    UInt8[] output_path,
    UInt8[] artifact_cache_dir,
    UInt8[] target_triple,
    UInt8[] compiler_version,
    UInt64 root_source_hash,
    driver_options.CompileMode mode
) {
    if (mode == .release) {
        UInt8[]! final_path = output_path;
        if (final_path.length == 0) {
            final_path = artifact_path.release_package_object_path(
                artifact_cache_dir,
                target_triple,
                compiler_version,
                root_source_hash
            );
        }
        if (emit_release_package_object(ctx, lowered, final_path)) {
            return backend.BackendResult(true);
        }
        return backend.BackendResult(false);
    }
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx, lowered);
    object_plan.ObjectReusePlan plan = object_plan.build_object_reuse_plan(
        ctx,
        lowered,
        units$.ref(),
        artifact_cache_dir,
        target_triple,
        compiler_version,
        mode
    );
    record_object_plan_stats(ctx, plan$.ref());
    if (plan.len() == 1) {
        return emit_single_object_unit_with_cache(
            ctx,
            lowered,
            units$.ref(),
            plan$.ref(),
            plan.entry_at(0),
            output_path,
            mode
        );
    }
    if (!emit_plan_cache_objects(ctx, lowered, units$.ref(), plan$.ref(), mode)) {
        return backend.BackendResult(false);
    }
    UInt8![*] c_output_path = backend_output_buffer(output_path);
    return backend.emit_object(ctx, lowered, c_output_path$.as(UInt8[*]), mode);
}

// 将 object reuse plan 的命中情况记录到 store，供 smoke 和后续增量诊断使用。
() record_object_plan_stats(context.CompilerContext& ctx, object_plan.ObjectReusePlan& plan) {
    Int! index = 0;
    while (index < plan.len()) {
        object_plan.ObjectPlanEntry& entry = plan.entry_at(index);
        if (entry.kind == .unsupported) {
            ctx.store.object_artifacts.record_unsupported_unit();
        } else if (entry.kind == .source_object) {
            ctx.store.object_artifacts.record_source_lookup(entry.lookup_status);
        } else {
            ctx.store.object_artifacts.record_monomorph_lookup(entry.lookup_status);
        }
        index = index + 1;
    }
}

// 按 object plan 补齐所有缺失 cache object。命中的 entry 不触发 backend。
Bool emit_plan_cache_objects(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    driver_options.CompileMode mode
) {
    Int! index = 0;
    while (index < plan.len()) {
        if (!emit_plan_cache_object(ctx, lowered, units, plan, plan.entry_at(index), mode)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// 为一个 codegen unit 生成 cache object，并在成功后登记实际文件 hash。
Bool emit_plan_cache_object(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    driver_options.CompileMode mode
) {
    if (entry.kind == .unsupported || entry.can_reuse()) {
        return true;
    }
    UInt8[] cache_path = plan.path_at(entry.path_index);
    UInt8![*] c_cache_path = backend_output_buffer(cache_path);
    backend.BackendResult emitted = backend.emit_object_for_unit(
        ctx,
        lowered,
        units.unit_at(entry.unit_index),
        c_cache_path$.as(UInt8[*]),
        mode
    );
    if (emitted.has_errors()) {
        return false;
    }
    record_emitted_object(ctx, plan, entry);
    return true;
}

// 单 codegen unit 的 object 输出路径可以直接使用 cache artifact。这个路径同时覆盖
// `--emit-obj` 未指定 `-o` 时的默认输出行为。
backend.BackendResult emit_single_object_unit_with_cache(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    codegen_unit.CodegenUnitSet& units,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry,
    UInt8[] output_path,
    driver_options.CompileMode mode
) {
    if (entry.kind == .unsupported) {
        UInt8![*] c_output_path = backend_output_buffer(output_path);
        return backend.emit_object(ctx, lowered, c_output_path$.as(UInt8[*]), mode);
    }

    UInt8[] cache_path = plan.path_at(entry.path_index);
    UInt8[] final_path = final_object_path(output_path, cache_path);
    if (entry.can_reuse()) {
        return backend.BackendResult(copy_cached_object(ctx, cache_path, final_path));
    }

    if (!emit_plan_cache_object(ctx, lowered, units, plan, entry, mode)) {
        return backend.BackendResult(false);
    }
    return backend.BackendResult(copy_cached_object(ctx, cache_path, final_path));
}

// 没有显式 output path 时，cache path 就是最终 object path。
UInt8[] final_object_path(UInt8[] output_path, UInt8[] cache_path) {
    if (output_path.length == 0) {
        return cache_path;
    }
    return output_path;
}

// 将 cache object 复制到用户指定输出路径。源和目标相同时直接视为成功。
Bool copy_cached_object(context.CompilerContext& ctx, UInt8[] cache_path, UInt8[] output_path) {
    if (string.equal(cache_path, output_path)) {
        return true;
    }
    if (fs.copy_file(cache_path, output_path)) {
        return true;
    }
    add_package_error(ctx, "failed to copy cached object file", "cached_object_copy_failed");
    return false;
}

// 记录刚生成的 object artifact。source object 和 monomorph object 使用不同 key，
// 但都只保存文件 hash 和路径，不保存 backend 内存对象。
() record_emitted_object(
    context.CompilerContext& ctx,
    object_plan.ObjectReusePlan& plan,
    object_plan.ObjectPlanEntry& entry
) {
    UInt8[] cache_path = plan.path_at(entry.path_index);
    guard object_hash.hash_file(cache_path) is some emitted_hash else {
        return;
    }
    if (entry.kind == .source_object && entry.source_key_index >= 0) {
        ctx.store.object_artifacts.store_source_object(
            plan.source_key_at(entry.source_key_index),
            object_artifact.ObjectArtifactRecord(.source_object, emitted_hash, cache_path)
        );
        return;
    }
    if (entry.kind == .monomorph_object && entry.monomorph_key_index >= 0) {
        ctx.store.object_artifacts.store_monomorph_object(
            plan.monomorph_key_at(entry.monomorph_key_index),
            object_artifact.ObjectArtifactRecord(.monomorph_object, emitted_hash, cache_path)
        );
    }
}

// backend FFI 需要 C string buffer，pipeline 只负责路径格式转换。
UInt8![*] backend_output_buffer(UInt8[] output_path) {
    return fs.c_string(output_path);
}

// pipeline 只产生 package 级错误；具体阶段错误应在对应阶段写入自己的 category/code。
() add_package_error(context.CompilerContext& ctx, UInt8[] message, UInt8[] code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
