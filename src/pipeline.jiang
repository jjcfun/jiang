// Compile pipeline orchestration across source, syntax, resolve, sema, lower, backend.

import context = "./context.jiang";
import diagnostic = "./diagnostic/diagnostic.jiang";
import ast_store = "./query/ast_store.jiang";
import backend = "./backend/api.jiang";
import borrow_check = "./borrow_check/api.jiang";
import borrow_result = "./borrow_check/result.jiang";
import driver_options = "./driver/options.jiang";
import mir = "./mir/mir.jiang";
import mir_drop = "./mir/drop_elaborate.jiang";
import mir_lower = "./mir/lower.jiang";
import resolve = "./resolve/module_resolver.jiang";
import module_graph = "./resolve/module_graph.jiang";
import syntax = "./syntax/api.jiang";
import syntax_diagnostics = "./syntax/diagnostics.jiang";
import fs = "./support/fs.jiang";
import path = "./support/path.jiang";
import string = "./support/string.jiang";
import package_manifest = "./source/package_manifest.jiang";
import incremental_fingerprint = "./incremental/fingerprint.jiang";
import monomorph = "./sema/monomorph.jiang";
import type_check = "./sema/type_check/api.jiang";
import source = "./source/source.jiang";

public () compile_source(context.CompilerContext& ctx, UInt8[] text) {
    source.SourceId source_id = ctx.query.sources.add_anonymous(source.content_hash(text));
    compile_package(ctx, source_id, text);
}

public () compile_file(context.CompilerContext& ctx, UInt8[] file_path) {
    UInt8[] normalized = path.normalize(file_path);
    guard fs.read_all(normalized) is some text else {
        add_package_error(ctx, string.append("failed to read source file: ", normalized), "source_file_not_found");
        return;
    }
    compile_path_text(ctx, normalized, text);
}

() compile_path_text(context.CompilerContext& ctx, UInt8[] file_path, UInt8[] text) {
    source.SourceId source_id = ctx.query.sources.intern_path(file_path, source.content_hash(text));
    compile_package(ctx, source_id, text);
}

public () compile_package_path(context.CompilerContext& ctx, UInt8[] input_path) {
    compile_file(ctx, package_root_file_path(input_path));
}

public () compile_with_options(context.CompilerContext& ctx, driver_options.CompileOptions options) {
    UInt8[] root_path = package_root_file_path(options.input_path);
    UInt8[] normalized = path.normalize(root_path);
    guard fs.read_all(normalized) is some text else {
        add_package_error(ctx, string.append("failed to read source file: ", normalized), "source_file_not_found");
        return;
    }
    source.SourceId source_id = ctx.query.sources.intern_path(normalized, source.content_hash(text));
    compile_package_with_emit(ctx, source_id, text, options.emit, options.output_path);
}

UInt8[] package_root_file_path(UInt8[] input_path) {
    UInt8[] normalized = path.normalize(input_path);
    if (package_manifest.exists(normalized)) {
        return package_manifest_root_file_path(normalized);
    }
    return normalized;
}

UInt8[] package_manifest_root_file_path(UInt8[] package_dir) {
    package_manifest.PackageManifest manifest = package_manifest.read(package_dir);
    return package_manifest.root_file_path(package_dir, manifest$.ref());
}

() compile_package(context.CompilerContext& ctx, source.SourceId source_id, UInt8[] text) {
    compile_package_with_emit(ctx, source_id, text, .executable, "");
}

() compile_package_with_emit(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    UInt8[] text,
    driver_options.EmitKind emit,
    UInt8[] output_path
) {
    // AstStore 是本次 package 编译的临时 parse cache。resolve/HIR 完成后，
    // AST 不再进入 QuerySystem 的长期状态。
    ast_store.AstStore! asts = ast_store.AstStore();
    syntax.SyntaxResult! syntax_result = syntax.parse_source(ctx, text, source_id);
    if (syntax_result.has_errors()) {
        syntax_diagnostics.record_errors(ctx.diagnostics$.ref(), source_id, syntax_result$.ref());
        return;
    }
    Int source_revision = ctx.query.sources.get(source_id).revision;
    asts.set_file(syntax_result.file$.move(), source_revision);
    guard asts.file(source_id, source_revision) is some root_file else {
        add_package_error(ctx, "failed to load parsed root file", "root_ast_missing");
        return;
    }
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_file);
    if (!graph.ok) {
        return;
    }
    if (!resolver.lower_module_graph_to_hir(graph$.ref())) {
        return;
    }
    if (!type_check.check_hir_package(ctx, graph$.ref())) {
        return;
    }
    incremental_fingerprint.fingerprint_type_check_results(ctx, graph$.ref());
    monomorph.MonomorphInstances^ instances = monomorph.collect_reachable_instances(
        ctx.query$.ref(),
        ctx.query.hirs$.ref(),
        ctx.query.typeck$.ref(),
        graph$.ref()
    );
    mir.MirStore^ lowered = mir_lower.lower_package(
        ctx,
        ctx.query.hirs$.ref(),
        ctx.query.typeck$.ref(),
        instances$.ref(),
        graph$.ref()
    );
    if (lowered.has_errors()) {
        add_package_error(ctx, "MIR lowering failed", "mir_lowering_failed");
        return;
    }
    borrow_result.BorrowCheckResults^ borrow_check_results = borrow_check.check_package(
        ctx,
        lowered$.ref(),
        ctx.query.typeck$.ref(),
        ctx.query.layouts$.ref()
    );
    if (!borrow_check_results.ok) {
        add_package_error(ctx, "borrow check failed", "borrow_check_failed");
        return;
    }
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx, lowered$.move(), ctx.query.layouts$.ref());
    if (dropped.has_errors()) {
        add_package_error(ctx, "drop elaboration failed", "drop_elaboration_failed");
        return;
    }
    incremental_fingerprint.fingerprint_mir_store(ctx, dropped$.ref());
    if (emit == .check_only) {
        return;
    }
    backend.BackendResult result = emit_backend(ctx, dropped$.ref(), emit, output_path);
    if (result.has_errors()) {
        add_package_error(ctx, "backend emission failed", "backend_emit_failed");
        return;
    }
}

backend.BackendResult emit_backend(
    context.CompilerContext& ctx,
    mir.MirStore& lowered,
    driver_options.EmitKind emit,
    UInt8[] output_path
) {
    if (emit == .object_file) {
        UInt8![*] c_output_path = fs.c_string(output_path);
        UInt8[*] raw_output_path = c_output_path$.as(UInt8[*]);
        return backend.emit_object(ctx, lowered, raw_output_path);
    }
    if (emit == .llvm_ir) {
        UInt8![*] c_output_path = fs.c_string(output_path);
        UInt8[*] raw_output_path = c_output_path$.as(UInt8[*]);
        return backend.emit_llvm_ir(ctx, lowered, raw_output_path);
    }
    return backend.emit(ctx, lowered);
}

() add_package_error(context.CompilerContext& ctx, UInt8[] message, UInt8[] code) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
