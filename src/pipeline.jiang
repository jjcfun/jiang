// 编译流水线负责串联 source、syntax、resolve、sema、lower、backend。

import context = "./context.jiang";
import diagnostic = "./diagnostic/diagnostic.jiang";
import syntax_store = "./syntax/store.jiang";
import qid = "./store/id.jiang";
import artifact_path = "./artifact/path.jiang";
import package_fingerprint = "./artifact/package_fingerprint.jiang";
import source_ji = "./artifact/source_ji.jiang";
import backend = "./backend/api.jiang";
import borrow_check = "./borrow_check/api.jiang";
import borrow_store = "./borrow_check/store.jiang";
import driver_options = "./driver/options.jiang";
import lang = "./lang/api.jiang";
import mir = "./mir/mir.jiang";
import mir_drop = "./mir/drop_elaborate.jiang";
import mir_lower = "./mir/lower.jiang";
import resolve = "./resolve/module_resolver.jiang";
import module_graph = "./resolve/module_graph.jiang";
import resolve_store = "./resolve/store.jiang";
import syntax = "./syntax/api.jiang";
import path = "./support/path.jiang";
import string = "./support/string.jiang";
import system_fs = "./system/fs.jiang";
import system_target = "./system/target.jiang";
import package_manifest = "./source/package_manifest.jiang";
import monomorph = "./sema/monomorph.jiang";
import type_check = "./sema/type_check/api.jiang";
import source = "./source/source.jiang";

// 编译器唯一公开入口。driver 负责把命令行整理成 CompileOptions，
// pipeline 只按 options 串联 source 到 backend 的阶段。
public () compile(context.CompilerContext& ctx, driver_options.CompileOptions& options) {
    ctx.begin_compilation();
    UInt8[]& root_path = package_root_file_path(options.input_path);
    UInt8[]& normalized = path.normalize(root_path);
    guard system_fs.read_all(normalized) is .some(source_text) else {
        add_package_error(ctx, string.append("failed to read source file: ", normalized), "source_file_not_found");
        return;
    }
    source.SourceId source_id = ctx.store.sources.intern_path(normalized, source.content_hash(source_text));
    compile_package_with_emit(
        ctx,
        source_id,
        normalized,
        source_text,
        options
    );
}

// 将输入路径归一化为 package root source。这里只处理入口文件选择，
// 不读取 source，也不创建任何语义 store。
UInt8[]& package_root_file_path(UInt8[]& input_path) {
    UInt8[]& normalized = path.normalize(input_path);
    if (package_manifest.exists(normalized)) {
        return package_manifest_root_file_path(normalized);
    }
    return normalized;
}

// 从 package manifest 中解析 root source 路径。manifest 只影响入口文件，
// 后续 import closure 仍由 resolve 阶段负责发现。
UInt8[]& package_manifest_root_file_path(UInt8[]& package_dir) {
    package_manifest.PackageManifest manifest = package_manifest.read(package_dir);
    return package_manifest.root_file_path(package_dir, manifest$.ref());
}

// package 编译主干。这个函数只编排阶段顺序和早停条件；
// 具体语义检查、MIR 改写和 backend lowering 必须留在各自阶段内。
() compile_package_with_emit(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    UInt8[]& root_path,
    UInt8[]& source_text,
    driver_options.CompileOptions& options
) {
    if (!backend.validate_output_request(ctx, options)) {
        return;
    }
    system_target.TargetInfo& target_info = ctx.target$.ref();
    UInt8[]& llvm_triple = target_info.llvm_triple;
    UInt8[]& target_cache_key = system_target.cache_key(target_info);
    UInt64 compiler_version_hash = source_artifact_version_hash(options.compiler_version);
    // syntax.Store 是本次 package 编译的临时 parse cache。resolve/HIR 完成后，
    // AST 不再进入 CompilerStore 的长期状态。
    syntax_store.Store! asts = syntax_store.Store();
    lang.registry_builder.BuildResult! lang_registry = lang.registry_builder.build_for_source_path(
        ctx,
        root_path,
        options.artifact_cache_dir,
        compiler_version_hash,
        options.mode
    );
    if (!lang_registry.ok) {
        return;
    }
    if (options.emit != .dynamic_library && !lang.dylib_builder.ensure_provider_dylibs(
        ctx,
        lang_registry.registry$.ref(),
        options.artifact_cache_dir,
        options.compiler_version,
        options.linker_path,
        options.mode
    )) {
        return;
    }
    syntax.SyntaxResult! syntax_result = syntax.parse_source_with_lang(
        ctx,
        source_text,
        source_id,
        lang_registry.registry$.ref()
    );
    if (syntax_result.has_errors()) {
        return;
    }
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(syntax_result.take_unit(), source_revision);
    guard asts.unit(source_id, source_revision) is .some(root_unit) else {
        add_package_error(ctx, "failed to load parsed root file", "root_ast_missing");
        return;
    }
    Bool use_source_artifacts = options.emit != .llvm_ir;
    resolve.ModuleResolver resolver = resolve.ModuleResolver(
        ctx,
        asts$.ref(),
        options.artifact_cache_dir,
        compiler_version_hash,
        use_source_artifacts,
        options.mode
    );
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    if (!graph.ok) {
        return;
    }
    lang.registry_builder.BuildResult! graph_lang_registry = lang.registry_builder.build_for_package(
        ctx,
        graph.package_id,
        options.artifact_cache_dir,
        compiler_version_hash,
        options.mode
    );
    if (!graph_lang_registry.ok) {
        return;
    }
    if (!resolver.lower_module_graph_to_hir(graph$.ref())) {
        return;
    }
    if (!type_check.check_hir_package(ctx, graph$.ref())) {
        return;
    }
    if (use_source_artifacts) {
        write_source_artifact_cache(ctx, graph$.ref(), options.artifact_cache_dir, options.compiler_version);
    }
    monomorph.MonomorphStore^ instances = monomorph.collect_reachable_instances(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        graph$.ref()
    );
    mir.MirStore^ lowered = mir_lower.lower_package(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        instances$.ref(),
        graph$.ref()
    );
    if (lowered.has_errors()) {
        add_package_error(ctx, "MIR lowering failed", "mir_lowering_failed");
        return;
    }
    borrow_store.BorrowCheckStore^ borrow_check_results = borrow_check.check_package(
        ctx,
        lowered$.ref(),
        ctx.store.typeck$.ref(),
        ctx.store.layouts$.ref()
    );
    if (!borrow_check_results.ok) {
        add_package_error(ctx, "borrow check failed", "borrow_check_failed");
        return;
    }
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx, lowered$.move(), ctx.store.layouts$.ref());
    if (dropped.has_errors()) {
        add_package_error(ctx, "drop elaboration failed", "drop_elaboration_failed");
        return;
    }
    UInt64 package_hash = package_fingerprint.from_package(ctx, graph.package_id);
    if (backend.emit_package(
        ctx,
        dropped$.ref(),
        options,
        llvm_triple,
        target_cache_key,
        target_info,
        package_hash,
        target_info.link_libc
    ).has_errors()) {
        return;
    }
}

// 写入 source interface cache。source artifact 只缓存跨编译可复用的公开事实，
// 不能写入 session-local HIR/Type/MIR 对象。
() write_source_artifact_cache(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version
) {
    UInt8[]& source_dir = artifact_path.source_dir(artifact_cache_dir);
    if (!system_fs.create_dirs(source_dir)) {
        return;
    }

    UInt64 version_hash = source_artifact_version_hash(compiler_version);
    Int! index = 0;
    while (index < graph.module_count()) {
        write_module_source_artifact(ctx, graph.module_at(index), artifact_cache_dir, version_hash);
        index = index + 1;
    }
}

// 为单个 module 写入 `.ji` interface。没有 stable def id 的 module 不具备
// 跨编译身份，不能进入本地 artifact cache。
() write_module_source_artifact(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& artifact_cache_dir,
    UInt64 compiler_version
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    guard ctx.store.incremental.stable_id_for_def(module.def_id) is .some(stable_id) else {
        return;
    }
    source.SourceRecord source_record = ctx.store.sources.get(module.source_id);
    UInt8[]& artifact_file = artifact_path.source_ji_path(
        artifact_cache_dir,
        stable_id,
        source_record.content_hash,
        compiler_version
    );
    source_ji.write_source_ji_file(
        ctx,
        ctx.store.artifacts$.ref(),
        module.source_id,
        compiler_version,
        artifact_file
    );
}

// source interface 的版本 hash 统一委托给 artifact 层，pipeline 不定义格式。
UInt64 source_artifact_version_hash(UInt8[]& compiler_version) {
    return source_ji.artifact_version_hash(compiler_version);
}

// pipeline 只产生 package 级错误；具体阶段错误应在对应阶段写入自己的 category/code。
() add_package_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
