// Compiler-internal `$` intrinsic operations.
//
// The compiler loads this file into every module graph. These declarations are
// not ordinary methods and are only visible through explicit `$` lookup.

@intrinsic(value, _)
{
    () move();
    () ref();
    () addr();
    () as();
}

@intrinsic(value, <T>)
@where(T: Movable)
{
    () forget();
}

@intrinsic(value, Reference<_>)
{
    () get();
    () set();
}

@intrinsic(value, RawPointer<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, Box<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, ManyPointer<_>)
{
    () get();
    () set();
    () free();
}

@intrinsic(value, Option<RawPointer<_>>)
{
    () free();
}

@intrinsic(value, Option<Box<_>>)
{
    () free();
}

@intrinsic(value, Option<ManyPointer<_>>)
{
    () free();
}

@intrinsic(value, Option<_>)
{
    () some();
}

@intrinsic(value, Reference<Slice<_>>)
{
    () ptr();
}

@intrinsic(value, Reference<SentinelSlice<_, _>>)
{
    () ptr();
}

@intrinsic(type, _)
{
    () alloc_array();
    () size();
    () align();
    () max_align();
}
