// Compiler-internal `$` intrinsic operations.
//
// The compiler loads this file into every module graph. These declarations are
// not ordinary methods and are only visible through explicit `$` lookup.

@intrinsic(value, _)
{
    () get();
    () set();
    () move();
    () ref();
    () addr();
    () as();
    () ptr();
    () free();
    () forget();
    () some();
}

@intrinsic(type, _)
{
    () alloc_array();
    () size();
    () align();
    () max_align();
}
