public struct CString: FromStringLiteral {
    UInt8![]*! bytes;
    Int byte_length;

    public init(UInt8[] bytes) {
        Int! i = 0;

        self.bytes = new UInt8![] { capacity: bytes.length + 1 };
        self.byte_length = bytes.length;

        while (i < bytes.length) {
            self.bytes[i] = bytes[i];
            i = i + 1;
        }

        self.bytes[bytes.length] = 0$.as(UInt8);
    }

    deinit() {
        self.bytes$.free();
    }
}
