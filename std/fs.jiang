// 可移植的同步文件系统操作。

import file = "file.jiang";
import path = "path.jiang";
import vector = "collection/vector.jiang";
import system_fs = "../src/system/fs.jiang";

// 唯一拥有文件或 stream handle 的 move-only value。
public alias File = file.File;
// 可移植文件错误分类。
public alias FileError = file.FileError;
// 文件大小和修改时间 metadata。
public alias FileMetadata = file.FileMetadata;

// Regular-file IO runs on a shared concurrent Domain so the caller's Domain is not blocked.
// Cancellation is cooperative: an operation already inside a blocking provider call finishes,
// drops its File/result, and only then completes cancellation.
struct FileIoDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) {
        ConcurrentExecutor()
    }
}

const FileIoDomain file_io_domain = FileIoDomain();

async [file_io_domain] UInt8[]^@FileError read_all_on_io_domain(UInt8[]& path) {
    coroutine.check_cancelled();
    UInt8[]^ bytes = read_all(path);
    coroutine.check_cancelled();
    bytes
}

// 打开已有文件用于读取。
public File@FileError open(UInt8[]& path) {
    return file.wrap(system_fs.open_checked(path));
}

// 创建或截断文件用于写入。
public File@FileError create(UInt8[]& path) {
    return file.wrap(system_fs.create_checked(path));
}

// 把完整文件读入独立 owned bytes，复杂度为 O(file size)。
public UInt8[]^@FileError read_all(UInt8[]& path) {
    File opened! = open(path);
    UInt8[]^ bytes = opened.read_all();
    opened.close();
    return bytes;
}

// 在共享文件 IO Domain 读取完整文件；调用者 Domain 不执行阻塞 provider call。
// 返回独立 owned bytes。取消会等待已开始的 provider call 收尾并释放 File/result。
public async UInt8[]^@FileError read_all_async(UInt8[]& path) {
    read_all_on_io_domain(path)
}

// 从 offset 读取恰好 length 个 byte 到独立 owned bytes，复杂度为 O(length)。
public UInt8[]^@FileError read_at(UInt8[]& path, Int offset, Int length) {
    File opened! = open(path);
    UInt8[]^ bytes = opened.read_at(offset, length);
    opened.close();
    return bytes;
}

// 用 bytes 替换文件内容，文件不存在时创建。
public Void@FileError write_all(UInt8[]& path, UInt8[]& bytes) {
    File created! = create(path);
    created.write_all(bytes);
    created.close();
}

// 存在性查询把不可访问和不存在都表示为 false。
// 返回 path 是否可作为文件或目录访问；只执行常数次 provider 调用。
public alias exists = system_fs.exists;
// 返回 path 是否可作为非目录文件访问；只执行常数次 provider 调用。
public alias file_exists = system_fs.file_exists;
// 返回 path 是否可作为目录访问；只执行常数次 provider 调用。
public alias dir_exists = system_fs.dir_exists;

// 返回文件大小或可移植错误，复杂度为 O(1)。
public Int@FileError file_size(UInt8[]& path) {
    return file_metadata(path).size;
}

// 返回 path metadata 或可移植错误，复杂度为 O(1)。
public FileMetadata@FileError file_metadata(UInt8[]& path) {
    File opened! = open(path);
    FileMetadata metadata = opened.metadata();
    opened.close();
    return metadata;
}

// 创建一层目录；parent 不存在时返回错误。
public Void@FileError create_dir(UInt8[]& path) {
    if (!system_fs.create_dir(path)) { throw system_fs.last_file_error(); }
}

// 创建全部缺失目录组件，复杂度为 O(path components)。
public Void@FileError create_dirs(UInt8[]& path) {
    if (!system_fs.create_dirs(path)) { throw system_fs.last_file_error(); }
}

// 把文件复制到新建或截断的目标，复杂度为 O(file size)。
public Void@FileError copy_file(UInt8[]& from_path, UInt8[]& to_path) {
    UInt8[]^ bytes = read_all(from_path);
    write_all(to_path, bytes[..]);
}

// provider 支持 rename 时，把 temporary_path 原子发布到 final_path。
public Void@FileError atomic_replace(UInt8[]& temporary_path, UInt8[]& final_path) {
    if (!system_fs.atomic_replace(temporary_path, final_path)) {
        throw system_fs.last_file_error();
    }
}

// 删除单个文件，不把它作为目录递归跟随。
public Void@FileError remove_file(UInt8[]& path) {
    if (!system_fs.remove_file(path)) { throw system_fs.last_file_error(); }
}

// eager 返回完整子路径；顺序未指定，复杂度为 O(entries + path bytes)。
public vector.Vector<path.Path>@FileError list_dir(UInt8[]& directory) {
    _ entries! = system_fs.list_dir_checked(directory);
    vector.Vector<path.Path> result! = vector.Vector<path.Path>(entries.len());
    while (!entries.empty()) {
        UInt8[]^ bytes = entries.pop();
        result.append(path.Path(bytes[..]));
    }
    return result;
}
