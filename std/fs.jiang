// Internal std filesystem incubator.
//
// 0.3.1 只提供 system/fs 的薄封装，先给编译器和 smoke 使用；这里还不是
// 稳定公开标准库 API。

import system_fs = "../src/system/fs.jiang";

public alias File = system_fs.File;
public alias open = system_fs.open;
public alias create = system_fs.create;
public alias read_all = system_fs.read_all;
public alias write_all = system_fs.write_all;
public alias exists = system_fs.exists;
public alias file_exists = system_fs.file_exists;
public alias dir_exists = system_fs.dir_exists;
public alias create_dir = system_fs.create_dir;
public alias create_dirs = system_fs.create_dirs;
public alias copy_file = system_fs.copy_file;
