// 面向普通程序的最小 debug 工具。
//
// 输出复用标准 stderr，终止路径复用 system abort provider；本模块不承担 debugger 或 profiler。

import io = "../src/system/io.jiang";
import abort = "../src/system/abort.jiang";

public Bool write(UInt8[]& message) {
    return io.stderr().write_all(message);
}

public Bool write_line(UInt8[]& message) {
    if (!write(message)) {
        return false;
    }
    return write("\n");
}

public Void panic(UInt8[]& message) {
    abort.panic(message);
}

public Void trap() {
    abort.trap();
}
