import string = "string.jiang";
import vector = "vector.jiang";

public trait Formattable {
    () format(self, StringBuilder& out);
}

public struct StringBuilder: Movable {
    vector.Vector<UInt8>! bytes;

    public init(self) {
        self.bytes = vector.Vector<UInt8>();
    }

    @unique(self)
    public () append(self, UInt8[]& value) {
        self.write_bytes(value);
    }

    @unique(self)
    public () append(self, string.String& value) {
        self.write_bytes(value.bytes());
    }

    @unique(self)
    public () append(self, Bool value) {
        if (value) {
            self.append("true");
            return;
        }
        self.append("false");
    }

    @unique(self)
    public () append(self, Int value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    @unique(self)
    public () append(self, Int8 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    @unique(self)
    public () append(self, Int16 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    @unique(self)
    public () append(self, Int32 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    @unique(self)
    public () append(self, Int64 value, Int radix = 10) {
        self.write_signed(value, radix);
    }

    @unique(self)
    public () append(self, UInt value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    @unique(self)
    public () append(self, UInt8 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    @unique(self)
    public () append(self, UInt16 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    @unique(self)
    public () append(self, UInt32 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    @unique(self)
    public () append(self, UInt64 value, Int radix = 10) {
        self.write_unsigned(value, radix);
    }

    @unique(self)
    public () append(self, Float16 value, Int precision = 6) {
        self.write_float(Float64(value), precision);
    }

    @unique(self)
    public () append(self, Float32 value, Int precision = 6) {
        self.write_float(Float64(value), precision);
    }

    @unique(self)
    public () append(self, Float64 value, Int precision = 6) {
        self.write_float(value, precision);
    }

    public string.String into_string(Self self) {
        return string.String(self.bytes.slice());
    }

    public UInt8[]^ into_slice(Self self) {
        vector.Vector<UInt8>! result = vector.Vector<UInt8>(self.bytes.length());
        UInt8[]& source = self.bytes.slice();
        Int! index = 0;
        while (index < source.length) {
            result.append(source[index]);
            index = index + 1;
        }
        return result$.move().into_slice();
    }

    public UInt8[]& slice(self) {
        return self.bytes.slice();
    }

    @unique(self)
    () write_bytes(self, UInt8[]& value) {
        Int! index = 0;
        while (index < value.length) {
            self.bytes.append(value[index]);
            index = index + 1;
        }
    }

    @unique(self)
    () write_signed(self, Int64 value, Int radix) {
        self.check_radix(radix);
        if (value < Int64(0)) {
            self.write_byte(45);
            self.write_unsigned(UInt64(-(value + Int64(1))) + UInt64(1), radix);
            return;
        }
        self.write_unsigned(UInt64(value), radix);
    }

    @unique(self)
    () write_unsigned(self, UInt64 value, Int radix) {
        self.check_radix(radix);
        UInt64! remaining = value;
        if (remaining == UInt64(0)) {
            self.write_byte(48);
            return;
        }
        UInt8![*]! digits = UInt8!$.alloc_many(64);
        Int! digit_count = 0;
        while (remaining > UInt64(0)) {
            UInt64 digit = remaining % UInt64(radix);
            digits[digit_count] = self.digit_byte(digit);
            digit_count = digit_count + 1;
            remaining = remaining / UInt64(radix);
        }
        while (digit_count > 0) {
            digit_count = digit_count - 1;
            self.write_byte(digits[digit_count]);
        }
        do [unsafe] {
            digits$.dealloc();
        }
    }

    @unique(self)
    () write_float(self, Float64 value, Int precision) {
        assert(precision >= 0);
        Float64! current = value;
        if (current < Float64(0)) {
            self.write_byte(45);
            current = Float64(0) - current;
        }
        Int64 whole = Int64(current);
        self.write_signed(whole, 10);
        if (precision == 0) {
            return;
        }
        self.write_byte(46);
        Float64! fraction = current - Float64(whole);
        Int! index = 0;
        while (index < precision) {
            fraction = fraction * Float64(10);
            Int digit = Int(fraction);
            self.write_byte(UInt8(48 + digit));
            fraction = fraction - Float64(digit);
            index = index + 1;
        }
    }

    () check_radix(self, Int radix) {
        assert(radix >= 2 && radix <= 36);
    }

    UInt8 digit_byte(self, UInt64 digit) {
        if (digit < UInt64(10)) {
            return UInt8(48) + UInt8(digit);
        }
        return UInt8(97) + UInt8(digit - UInt64(10));
    }

    @unique(self)
    () write_byte(self, UInt8 value) {
        self.bytes.append(value);
    }
}
