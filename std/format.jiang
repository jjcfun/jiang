import string = "string.jiang";
import vector = "vector.jiang";

public trait Displayable {
    () format(Formatter& out);
}

public struct Formatter: Movable {
    vector.Vector<UInt8>! bytes;

    public init() {
        self.bytes = vector.Vector<UInt8>();
    }

    public () write(UInt8[:0]& value) {
        Int! index = 0;
        while (index < value.length) {
            self.bytes.append(value[index]);
            index = index + 1;
        }
    }

    public () write(string.String& value) {
        self.write_bytes(value.bytes());
    }

    public () write(Bool value) {
        if (value) {
            self.write("true");
            return;
        }
        self.write("false");
    }

    public () write(Int value) {
        self.write(value, radix: 10);
    }

    public () write(Int value, Int radix) {
        self.write_signed(Int64(value), radix);
    }

    public () write(Int8 value) {
        self.write(value, radix: 10);
    }

    public () write(Int8 value, Int radix) {
        self.write_signed(Int64(value), radix);
    }

    public () write(Int16 value) {
        self.write(value, radix: 10);
    }

    public () write(Int16 value, Int radix) {
        self.write_signed(Int64(value), radix);
    }

    public () write(Int32 value) {
        self.write(value, radix: 10);
    }

    public () write(Int32 value, Int radix) {
        self.write_signed(Int64(value), radix);
    }

    public () write(Int64 value) {
        self.write(value, radix: 10);
    }

    public () write(Int64 value, Int radix) {
        self.write_signed(value, radix);
    }

    public () write(UInt value) {
        self.write(value, radix: 10);
    }

    public () write(UInt value, Int radix) {
        self.write_unsigned(UInt64(value), radix);
    }

    public () write(UInt8 value) {
        self.write(value, radix: 10);
    }

    public () write(UInt8 value, Int radix) {
        self.write_unsigned(UInt64(value), radix);
    }

    public () write(UInt16 value) {
        self.write(value, radix: 10);
    }

    public () write(UInt16 value, Int radix) {
        self.write_unsigned(UInt64(value), radix);
    }

    public () write(UInt32 value) {
        self.write(value, radix: 10);
    }

    public () write(UInt32 value, Int radix) {
        self.write_unsigned(UInt64(value), radix);
    }

    public () write(UInt64 value) {
        self.write(value, radix: 10);
    }

    public () write(UInt64 value, Int radix) {
        self.write_unsigned(value, radix);
    }

    public () write(Float64 value) {
        self.write(value, precision: 6);
    }

    public () write(Float64 value, Int precision) {
        self.write_float(value, precision);
    }

    public string.String to_string() {
        return string.String(self.bytes.slice());
    }

    public UInt8[]& slice() {
        return self.bytes.slice();
    }

    () write_bytes(UInt8[]& value) {
        Int! index = 0;
        while (index < value.length) {
            self.bytes.append(value[index]);
            index = index + 1;
        }
    }

    () write_signed(Int64 value, Int radix) {
        self.check_radix(radix);
        if (value < Int64(0)) {
            self.write_byte(45);
            self.write_unsigned(UInt64(-(value + Int64(1))) + UInt64(1), radix);
            return;
        }
        self.write_unsigned(UInt64(value), radix);
    }

    () write_unsigned(UInt64 value, Int radix) {
        self.check_radix(radix);
        vector.Vector<UInt8>! digits = vector.Vector<UInt8>();
        UInt64! remaining = value;
        if (remaining == UInt64(0)) {
            self.write_byte(48);
            return;
        }
        while (remaining > UInt64(0)) {
            UInt64 digit = remaining % UInt64(radix);
            digits.append(self.digit_byte(digit));
            remaining = remaining / UInt64(radix);
        }
        Int! count = digits.length;
        while (count > 0) {
            count = count - 1;
            self.write_byte(digits[count]);
        }
    }

    () write_float(Float64 value, Int precision) {
        assert(precision >= 0);
        Float64! current = value;
        if (current < Float64(0)) {
            self.write_byte(45);
            current = Float64(0) - current;
        }
        Int64 whole = Int64(current);
        self.write_signed(whole, 10);
        if (precision == 0) {
            return;
        }
        self.write_byte(46);
        Float64! fraction = current - Float64(whole);
        Int! index = 0;
        while (index < precision) {
            fraction = fraction * Float64(10);
            Int digit = Int(fraction);
            self.write_byte(UInt8(48 + digit));
            fraction = fraction - Float64(digit);
            index = index + 1;
        }
    }

    () check_radix(Int radix) {
        assert(radix >= 2 && radix <= 36);
    }

    UInt8 digit_byte(UInt64 digit) {
        if (digit < UInt64(10)) {
            return UInt8(48) + UInt8(digit);
        }
        return UInt8(97) + UInt8(digit - UInt64(10));
    }

    () write_byte(UInt8 value) {
        self.bytes.append(value);
    }
}
