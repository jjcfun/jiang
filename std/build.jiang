// 编译期构建上下文。

// 当前编译目标的 CPU architecture。
public enum TargetArch {
    arm64,
    x86_64,
    wasm32,
}

// 当前编译目标的操作系统类别。
public enum TargetOs {
    macos,
    linux,
    windows,
    wasm,
}

// 当前编译目标的 ABI 类别。
public enum TargetAbi {
    darwin,
    gnu,
    msvc,
    wasi,
    none,
}

// 当前 compilation 的优化模式；普通代码只能查询，不能修改。
// 当前程序的 debug 或 release 构建模式。
public enum BuildMode {
    debug,
    release,
}

// 只读编译目标信息；字段均可在 comptime 中检查。
public struct TargetInfo: Copyable {
    // 目标 CPU architecture。
    public TargetArch arch;
    // 目标操作系统。
    public TargetOs os;
    // 目标 ABI。
    public TargetAbi abi;
    // 当前构建是否链接 hosted C library。
    public Bool link_libc;
}

// 当前目标的只读编译期信息。
public extern [builtin] const TargetInfo target;

// 由编译器按 --mode 注入，可用于 comptime 选择 debug/release 实现。
// 当前 debug/release mode 的只读编译期值。
public extern [builtin] const BuildMode mode;
