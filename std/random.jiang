// 系统 entropy 与可复现实验用伪随机序列。
//
// Generator 不是密码学随机数生成器；需要安全随机字节时必须使用 fill_entropy。

import system_random = "../src/system/random.jiang";

// 使用操作系统 entropy 填满 buffer；失败时返回 false。
// buffer 可能已被部分修改，复杂度为 O(n)。
public Bool fill_entropy(UInt8[]&! buffer) {
    return system_random.fill_entropy(buffer);
}

// 可复制、可复现且不保证算法稳定的伪随机数生成器。
// 同一实例不得由多个线程并发修改。
public struct Generator: Copyable {
    UInt64 state!;

    // 使用 seed 建立可复现实验序列；复制 Generator 会复制其当前序列位置。
    public init(self, UInt64 seed) {
        self.state = seed;
    }

    // 返回序列中的下一个 UInt64，复杂度为 O(1)。
    public UInt64 next_u64(Self&! self) {
        self.state = self.state + UInt64(11400714819323198485);
        UInt64 value! = self.state;
        value = (value ^ (value >> UInt64(30))) * UInt64(13787848793156543929);
        value = (value ^ (value >> UInt64(27))) * UInt64(10723151780598845931);
        return value ^ (value >> UInt64(31));
    }

    // 用当前可复现序列填满 buffer，复杂度为 O(n)。
    public Void fill(Self&! self, UInt8[]&! buffer) {
        Int index! = 0;
        while (index < buffer.length) {
            UInt64 value = self.next_u64();
            Int byte_index! = 0;
            while (byte_index < 8 && index < buffer.length) {
                UInt64 shift = UInt64(byte_index * 8);
                buffer[index] = UInt8((value >> shift) & UInt64(255));
                byte_index = byte_index + 1;
                index = index + 1;
            }
        }
    }
}
