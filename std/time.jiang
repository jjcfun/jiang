// 可移植的时间间隔与 hosted clock 值。
//
// monotonic instant 只在同一进程内可比较；SystemTime 使用 Unix epoch，系统校时时可能倒退。

import system_time = "../src/system/time.jiang";

public struct Duration: Copyable, Equatable {
    UInt64 value;

    init(self, UInt64 nanoseconds) {
        self.value = nanoseconds;
    }

    public UInt64 nanoseconds(self) { self.value }
    public UInt64 microseconds(self) { self.value / UInt64(1000) }
    public UInt64 milliseconds(self) { self.value / UInt64(1000000) }
    public UInt64 seconds(self) { self.value / UInt64(1000000000) }

    public Bool equal(Duration& left, Duration& right) {
        left.value == right.value
    }
}

public struct Instant: Copyable, Equatable {
    UInt64 value;

    init(self, UInt64 nanoseconds) {
        self.value = nanoseconds;
    }

    public Duration? duration_since(self, Instant earlier) {
        if (self.value < earlier.value) { return null; }
        return Duration(self.value - earlier.value);
    }

    public Bool equal(Instant& left, Instant& right) {
        left.value == right.value
    }
}

public struct SystemTime: Copyable, Equatable {
    UInt64 value;

    init(self, UInt64 nanoseconds) {
        self.value = nanoseconds;
    }

    public Duration since_unix_epoch(self) {
        Duration(self.value)
    }

    public Duration? duration_since(self, SystemTime earlier) {
        if (self.value < earlier.value) { return null; }
        return Duration(self.value - earlier.value);
    }

    public Bool equal(SystemTime& left, SystemTime& right) {
        left.value == right.value
    }
}

public Duration nanoseconds(UInt64 value) {
    Duration(value)
}

public Duration microseconds(UInt64 value) {
    Duration(scale(value, UInt64(1000)))
}

public Duration milliseconds(UInt64 value) {
    Duration(scale(value, UInt64(1000000)))
}

public Duration seconds(UInt64 value) {
    Duration(scale(value, UInt64(1000000000)))
}

public Instant? monotonic_now() {
    guard system_time.monotonic_time_ns_checked() is .some(value) else { return null; }
    return Instant(value);
}

public SystemTime? wall_now() {
    guard system_time.wall_time_ns_checked() is .some(value) else { return null; }
    return SystemTime(value);
}

UInt64 scale(UInt64 value, UInt64 factor) {
    UInt64 maximum = UInt64(18446744073709551615);
    assert(value <= maximum / factor);
    return value * factor;
}
