// 基于 HashMap 的无序集合。
//
// HashSet 与 HashMap 共享查找、扩容和析构语义，迭代顺序不属于公开契约。

import map = "./map.jiang";

@region(k: K)
@where(K: Hashable & Equatable & Copyable)
public struct HashSet<K>: Movable {
    @life(k)
    map.HashMap<K, Bool> items!;

    // load_percent 是触发扩容的装载率百分比，有效范围为 1-99。
    public init(self, Int capacity = 0, Int load_percent = 80) {
        self.items = map.HashMap<K, Bool>(capacity, load_percent);
    }

    public Int length(self) { return self.items.length(); }
    public Int capacity(self) { return self.items.capacity(); }
    public Bool is_empty(self) { return self.items.is_empty(); }
    public Bool contains(self, K value) { return self.items.contains(value); }

    // 插入新元素时返回 true；元素已经存在时返回 false。
    @life(self.k: value)
    public Bool insert(Self&! self, K value) {
        return self.items.insert(value, true) == null;
    }

    // 删除存在的元素时返回 true，否则返回 false。
    public Bool remove(Self&! self, K value) {
        return self.items.remove(value) != null;
    }

    public Void reserve(Self&! self, Int additional) {
        self.items.reserve(additional);
    }

    public Void clear(Self&! self) {
        self.items.clear();
    }
}
