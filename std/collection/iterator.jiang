// 连续 storage 的共享借用 iterator。
//
// owner 绑定 storage，element 绑定 T 携带的 lifetime shape；next 不移动底层元素。

@region(owner, element: T)
public struct SliceIterator<T>: Copyable, Iterator {
    @life(owner, element)
    T[]& values;
    Int index!;

    public init(self, T[]& values) {
        self.values = values;
        self.index = 0;
    }

    associated Element = T&;

    @life(return: self.owner, return.value: self.element)
    public (T value)&? next(Self&! self) {
        if (self.index >= self.values.length) { return null; }
        Int index = self.index;
        self.index = self.index + 1;
        return self.values[index]$.ref();
    }
}
