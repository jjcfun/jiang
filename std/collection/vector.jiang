// Vector 是拥有连续 storage 的可增长 collection。
// 只有 length 范围内的元素已初始化并参与析构。

import core;
import iterator = "iterator.jiang";
import system_memory = "../../src/system/memory.jiang";

// 拥有连续 storage 的可增长 collection；只有 length 区间参与析构。
@region(a: T)
public struct Vector<T>: Movable, core.Collection, core.Contiguous<Element = T> {
    @life(a)
    T*! data!;
    Int capacity!;
    Int length!;

    // 以可选初始 capacity 建立空 Vector；负值或 allocation failure 会 trap。
    public init(self, Int capacity = 0) {
        self.length = 0;
        if (capacity > 0) {
            self.data = unsafe {
                T$.alloc(capacity)
            };
            self.capacity = capacity;
            return;
        }
        self.data = null;
        self.capacity = 0;
    }

    // O(1) 转移当前 storage，并把 source 恢复为空 Vector。
    @life(return.a: self.a)
    public Vector<T> take(Self&! self) {
        Vector<T> result! = Vector<T>();
        unsafe {
            system_memory.copy(
                result$.addr()$.as(UInt8*),
                self$.ptr()$.as(UInt8*),
                self.storage_size()
            );
            system_memory.set(self$.ptr()$.as(UInt8*), 0, self.storage_size());
        }
        return result;
    }

    Int storage_size(self) {
        return Void*$.size() + Int$.size() + Int$.size();
    }

    // 消耗 value 并追加到末尾；必要时移动既有元素扩容，均摊复杂度为 O(1)。
    @life(self.a: value)
    public Void append(Self&! self, T value) {
        unsafe {
            self.ensure_capacity(self.add_capacity(self.length, 1));
            self.data[self.length] = value;
            self.length = self.length + 1;
        }
    }

    // 返回只覆盖已初始化元素的借用 view，复杂度为 O(1)。
    @life(return: (self, self.a))
    public T[]& slice(self) {
        unsafe {
            return self.data[0..self.length];
        }
    }

    // 返回连续 storage 起点；只在 Vector 未修改且仍存活时有效，复杂度为 O(1)。
    @inline
    public T* ptr(self) {
        return unsafe {
            self.data$.as(T*)
        };
    }

    // 返回已初始化元素数，复杂度为 O(1)。
    @inline
    public Int length(self) {
        return self.length;
    }

    // 返回无需重新分配即可容纳的元素数，复杂度为 O(1)。
    @inline
    public Int capacity(self) {
        return self.capacity;
    }

    // 返回 Vector 是否没有元素，复杂度为 O(1)。
    @inline
    public Bool is_empty(self) {
        return self.length == 0;
    }

    // 借用首元素；空 Vector 返回 null。返回引用不能活过 Vector，复杂度为 O(1)。
    @life(return: self, return.value: self.a)
    public (T value)&? first(self) {
        if (self.length == 0) {
            return null;
        }
        unsafe {
            return self.data[0]$.ref();
        }
    }

    // 借用末元素；空 Vector 返回 null。返回引用不能活过 Vector，复杂度为 O(1)。
    @life(return: self, return.value: self.a)
    public (T value)&? last(self) {
        unsafe {
            if (self.length == 0) {
                return null;
            }
            return self.data[self.length - 1]$.ref();
        }
    }

    // 依次借用每个元素调用 action；不修改 Vector，复杂度为 O(n)。
    public Void for_each(self, Fn<Void, T&> action) {
        _ cursor! = self.make_iterator();
        while (cursor.next() is .some(item)) {
            action(item);
        }
    }

    // 依次转换借用元素并返回新的 owned Vector，复杂度为 O(n)。
    public Vector<R> map<R: Movable>(self, Fn<R, T&> transform) {
        Vector<R> result! = Vector<R>(self.length);
        _ cursor! = self.make_iterator();
        while (cursor.next() is .some(item)) {
            R mapped = transform(item);
            result.append(mapped$.move());
        }
        return result;
    }

    // 消耗 Vector，保留满足 predicate 的元素并析构其余元素。
    // 结果保持原顺序，复杂度为 O(n)。
    @life(return.a: self.a)
    public Vector<T> filter(Self self!, Fn<Bool, T&> predicate) {
        Vector<T> result! = Vector<T>(self.length);
        Int index! = 0;
        while (index < self.length) {
            unsafe {
                if (predicate(self.data[index]$.ref())) {
                    T value = self.data[index];
                    result.append(value);
                } else {
                    self.data[index]$.addr()$.destroy();
                }
            }
            index = index + 1;
        }
        self.length = 0;
        return result;
    }

    // 按顺序把借用元素合并进 accumulator，复杂度为 O(n)。
    @life(return: initial & combine & self)
    public R reduce<R: Movable>(self, R initial, Fn<R, R, T&> combine) {
        R accumulator! = initial;
        _ cursor! = self.make_iterator();
        while (cursor.next() is .some(item)) {
            accumulator = combine(accumulator$.move(), item);
        }
        return accumulator;
    }

    // 返回是否存在满足 predicate 的元素；找到后提前结束，复杂度为 O(n)。
    public Bool contains_where(self, Fn<Bool, T&> predicate) {
        _ cursor! = self.make_iterator();
        while (cursor.next() is .some(item)) {
            if (predicate(item)) { return true; }
        }
        return false;
    }

    // 返回是否包含与 value 相等的元素；找到后提前结束，复杂度为 O(n)。
    @where(T: Equatable)
    public Bool contains(self, T& value) {
        _ cursor! = self.make_iterator();
        while (cursor.next() is .some(item)) {
            if (item == value) { return true; }
        }
        return false;
    }

    associated Sequence.Element = T&;
    associated Sequence.Iter = iterator.SliceIterator<T>;

    // 建立借用 iterator；iterator 不能活过 Vector，元素以 T& 返回。
    @life(return.owner: self, return.element: self.a)
    public iterator.SliceIterator<T> make_iterator(self) {
        return iterator.SliceIterator<T>(self.slice());
    }

    // 消耗 Vector，把 storage 与全部已初始化元素的所有权转移给 owned slice，复杂度为 O(1)。
    @life(return: self.a)
    public T[]^ into_slice(Self self!) {
        T*! data = self.data;
        Int length = self.length;
        self.data = null;
        self.length = 0;
        self.capacity = 0;
        return unsafe {
            data[0..length]$.as(T[]^)
        };
    }

    // 保证还能追加至少 additional 个元素；capacity 溢出或 allocation failure 会 trap。
    public Void reserve(Self&! self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.add_capacity(self.length, additional));
    }

    // 移除并返回最后一个元素。调用者必须保证 Vector 非空；复杂度为 O(1)。
    public T remove_last(Self&! self) {
        unsafe {
            assert(self.length > 0);
            self.length = self.length - 1;
            return self.data[self.length];
        }
    }

    // 移除并返回最后一个元素；空 Vector 返回 null。复杂度为 O(1)。
    public T? pop(Self&! self) {
        if (self.length == 0) {
            return null;
        }
        return self.remove_last();
    }

    // 析构全部当前元素并保留 storage，复杂度为 O(n)。
    public Void clear(Self&! self) {
        self.truncate(0);
    }

    // 把 length 缩短到 len，并逆序析构被移除元素，复杂度为 O(removed)。
    public Void truncate(Self&! self, Int len) {
        assert(len >= 0 && len <= self.length);
        Int index! = self.length;
        while (index > len) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = len;
    }

    // 消耗 value 并插入指定位置；后续元素保持顺序，复杂度为 O(n)。
    @life(self.a: value)
    public Void insert(Self&! self, Int index, T value) {
        assert(index >= 0 && index <= self.length);
        self.ensure_capacity(self.add_capacity(self.length, 1));
        unsafe {
            Int current! = self.length;
            while (current > index) {
                self.data[current] = self.data[current - 1];
                current = current - 1;
            }
            self.data[index] = value;
        }
        self.length = self.length + 1;
    }

    // 移除并返回指定位置的元素，同时保持其余元素顺序。复杂度为 O(n)。
    public T remove(Self&! self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            T result = self.data[index];
            self.shift_left_from(index + 1);
            self.length = self.length - 1;
            return result;
        }
    }

    // 用最后一个元素填补指定位置后返回被移除元素；不保持顺序，复杂度为 O(1)。
    public T swap_remove(Self&! self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            T result = self.data[index];
            self.length = self.length - 1;
            if (index != self.length) {
                self.data[index] = self.data[self.length];
            }
            return result;
        }
    }

    // 返回 index 处元素；越界会 assert。
    // Copyable 结果复制，move-only 结果由 place 语义借用处理。
    public T subscript_get(self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            return self.data[index];
        }
    }

    // 消耗 value 替换 index 处元素；先析构旧值，越界会 assert，复杂度为 O(1)。
    public Void subscript_set(Self&! self, Int index, T value) {
        unsafe {
            assert(index >= 0 && index < self.length);
            // slot 始终已初始化；写入新值前必须析构其当前 owner。
            self.data[index]$.addr()$.destroy();
            self.data[index] = value;
        }
    }

    Void shift_left_from(Self&! self, Int start) {
        unsafe {
            Int index! = start;
            while (index < self.length) {
                self.data[index - 1] = self.data[index];
                index = index + 1;
            }
        }
    }

    Void ensure_capacity(Self&! self, Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T*! new_data! = unsafe {
            T$.alloc(new_capacity)
        };
        self.move_items_to(new_data);
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
        self.data = new_data;
        self.capacity = new_capacity;
    }

    Int next_capacity(self, Int min_capacity) {
        Int new_capacity! = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            Int doubled = new_capacity * 2;
            assert(doubled > new_capacity);
            new_capacity = doubled;
        }
        return new_capacity;
    }

    Int add_capacity(self, Int current, Int additional) {
        assert(current >= 0 && additional >= 0);
        Int result = current + additional;
        assert(result >= current);
        return result;
    }

    Void move_items_to(Self&! self, T*! new_data!) {
        unsafe {
            Int index! = 0;
            while (index < self.length) {
                new_data[index] = self.data[index];
                index = index + 1;
            }
        }
    }

    deinit(self) {
        Int index! = self.length;
        while (index > 0) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = 0;
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
    }
}
