public trait Numbric;

public trait FromStringLiteral;
public trait Mutable;
public trait MaybeMutable;

public trait Hashable {
    UInt64 hash();
}

public trait Equatable {
    Bool equal(Self other);
}

public trait SubscriptGet {
    type Index: Equatable;
    type Value;

    Value subscript_get(Index index);
}

public trait SubscriptSet: SubscriptGet {
    () subscript_set(Index index, Value value);
}


public struct Range {
    Int start;
    Int end;
}
