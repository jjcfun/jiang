// Lightweight automatic prelude.
//
// Keep this file narrow: it is loaded for every root module. The full `std`
// package root still exposes fs/io/process and explicit stable paths.

import string = "string.jiang";
import vector = "vector.jiang";
import numeric = "numeric.jiang";
import format = "format.jiang";
import path_impl = "path.jiang";
import core;

public alias String = string.String;
public alias Vector = vector.Vector;
public alias Path = path_impl.Path;
public alias PathBuilder = path_impl.PathBuilder;
public alias Integer = numeric.Integer;
public alias SignedInteger = numeric.SignedInteger;
public alias UnsignedInteger = numeric.UnsignedInteger;
public alias FloatingPoint = numeric.FloatingPoint;
public alias StringBuilder = string.StringBuilder;
public alias Formattable = format.Formattable;
public alias Atomic = core.atomic.Atomic;
public alias AtomicValue = core.atomic.AtomicValue;
public alias AtomicLoadOrder = core.atomic.AtomicLoadOrder;
public alias AtomicStoreOrder = core.atomic.AtomicStoreOrder;
public alias AtomicUpdateOrder = core.atomic.AtomicUpdateOrder;
public alias Mutex = core.mutex.Mutex;
