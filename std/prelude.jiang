public trait Numbric;

public trait FromStringLiteral;
public trait Mutable;

public trait SubscriptGet {
    associated Item;
    Item subscript_get(Int index);
}

public trait SubscriptSet: SubscriptGet {
    () subscript_set(Int index, Item value);
}

public trait Equatable {
    static Bool equal(Self& lhs, Self& rhs);
}

public trait Hashable: Equatable {
    UInt64 hash();
}

public struct Range {
    Int start;
    Int end;
}
