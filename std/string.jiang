import vector = "collection/vector.jiang";
import panic_impl = "panic.jiang";

extend Char {
    public init(self, UInt32 code) {
        self = unsafe {
            code$.as(Char)
        };
    }
}

public enum Utf8Error: Copyable {
    invalid_leading_byte(Int index),
    invalid_continuation(Int index),
    truncated_sequence(Int index),
    overlong_encoding(Int index),
    surrogate(Int index),
    codepoint_out_of_range(Int index),
}

public struct String: Movable, Sequence, Hashable, Equatable {
    UInt8[]^ storage!;

    // Compiler string-literal conversion hook. Dynamic bytes must use from_utf8
    // or explicitly uphold the invariant through from_utf8_unchecked.
    init(self, UInt8[]& bytes) {
        self.storage = copy_utf8_bytes(bytes);
    }

    init(self, UInt8[]& bytes, Bool assume_valid) {
        self.storage = copy_utf8_bytes(bytes);
    }

    public String@Utf8Error from_utf8(UInt8[]& bytes) {
        Int byte_length = validate_utf8(bytes);
        return unsafe {
            String.from_utf8_unchecked(bytes[0..byte_length])
        };
    }

    public unsafe String from_utf8_unchecked(UInt8[]& bytes) {
        return String(bytes, true);
    }

    @life(return: self)
    public UInt8[]& bytes(self) {
        return self.storage[..];
    }

    @life(return: self)
    public StringChars chars(self) {
        return StringChars(self.bytes());
    }

    public Int char_count(self) {
        StringChars iterator! = self.chars();
        Int count! = 0;
        while (iterator.next() is .some(_)) {
            count = count + 1;
        }
        return count;
    }

    public Int byte_length(self) {
        return self.storage.length;
    }

    public Bool equal(String& lhs, String& rhs) {
        if (lhs.storage.length != rhs.storage.length) {
            return false;
        }
        UInt8[]& lhs_bytes = lhs.bytes();
        UInt8[]& rhs_bytes = rhs.bytes();
        Int index! = 0;
        while (index < lhs.storage.length) {
            if (lhs_bytes[index] != rhs_bytes[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    // 把 UTF-8 bytes 写入 hasher；相等 String 产生相同输入序列，复杂度为 O(n)。
    public Void hash<H: Hasher>(self, H&! hasher) {
        hasher.write(self.bytes());
    }

    // 返回 needle 首次出现的 byte offset；未找到时返回 null，复杂度为 O(n*m)。
    public Int? byte_index_of(self, UInt8[]& needle, Int start = 0) {
        UInt8[]& source = self.bytes();
        assert(start >= 0 && start <= source.length);
        if (needle.length == 0) { return start; }
        Int last_start = source.length - needle.length;
        Int index! = start;
        while (index <= last_start) {
            if (bytes_equal_at(source, needle, index)) { return index; }
            index = index + 1;
        }
        return null;
    }

    public Bool contains(self, UInt8[]& needle) {
        return self.byte_index_of(needle) != null;
    }

    public Bool starts_with(self, UInt8[]& prefix) {
        UInt8[]& source = self.bytes();
        if (prefix.length > source.length) { return false; }
        return bytes_equal_at(source, prefix, 0);
    }

    public Bool ends_with(self, UInt8[]& suffix) {
        UInt8[]& source = self.bytes();
        if (suffix.length > source.length) { return false; }
        return bytes_equal_at(source, suffix, source.length - suffix.length);
    }

    // 返回追加 UTF-8 suffix 的新 String，不修改 receiver，复杂度为 O(n+m)。
    public String appending(self, UInt8[]& suffix) {
        StringBuilder builder! = StringBuilder();
        builder.append(self$.ref());
        builder.append(suffix);
        return builder.into_string();
    }

    // 按非空 UTF-8 separator eager 拆分并复制各部分；默认省略空结果，复杂度为 O(n*m)。
    public vector.Vector<String> split(self, UInt8[]& separator, Bool omit_empty = true) {
        UInt8[]& source = self.bytes();
        Int separator_length = try validate_utf8(separator) catch {
            panic_impl.panic("String.split received invalid UTF-8");
            0
        };
        assert(separator_length > 0);
        vector.Vector<String> result! = vector.Vector<String>();
        Int part_start! = 0;
        Int search_start! = 0;
        while (self.byte_index_of(separator, search_start) is .some(index)) {
            append_split_part(result$.mut_ref(), source, part_start, index, omit_empty);
            part_start = index + separator_length;
            search_start = part_start;
        }
        append_split_part(result$.mut_ref(), source, part_start, source.length, omit_empty);
        return result;
    }

    associated Element = Char;
    associated Iter = StringChars;

    @life(return: self)
    public StringChars make_iterator(self) {
        return self.chars();
    }
}

Bool bytes_equal_at(UInt8[]& source, UInt8[]& expected, Int start) {
    if (start < 0 || start + expected.length > source.length) { return false; }
    Int index! = 0;
    while (index < expected.length) {
        if (source[start + index] != expected[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Void append_split_part(
    vector.Vector<String>&! result,
    UInt8[]& source,
    Int start,
    Int end,
    Bool omit_empty
) {
    if (omit_empty && start == end) { return; }
    result.append(String(source[start..end]));
}

UInt8[]^ copy_utf8_bytes(UInt8[]& bytes) {
    vector.Vector<UInt8> result! = vector.Vector<UInt8>(bytes.length);
    Int index! = 0;
    while (index < bytes.length) {
        result.append(bytes[index]);
        index = index + 1;
    }
    return result.into_slice();
}

Int@Utf8Error validate_utf8(UInt8[]& bytes) {
    Int index! = 0;
    while (index < bytes.length) {
        UInt32 first = UInt32(bytes[index]);
        if (first < 128) {
            index = index + 1;
        } else {
            index = index + validate_utf8_sequence(bytes, index, first);
        }
    }
    return index;
}

Int@Utf8Error validate_utf8_sequence(UInt8[]& bytes, Int start, UInt32 first) {
    Int sequence_length! = 0;
    if (first >= 194 && first <= 223) {
        sequence_length = 2;
    } else if (first >= 224 && first <= 239) {
        sequence_length = 3;
    } else if (first >= 240 && first <= 244) {
        sequence_length = 4;
    }
    if (sequence_length == 0) {
        if (first == 192 || first == 193) {
            throw Utf8Error.overlong_encoding(start);
        }
        if (first >= 245 && first <= 247) {
            throw Utf8Error.codepoint_out_of_range(start);
        }
        throw Utf8Error.invalid_leading_byte(start);
    }

    UInt32 second! = 0;
    Int offset! = 1;
    while (offset < sequence_length) {
        Int index = start + offset;
        if (index >= bytes.length) {
            throw Utf8Error.truncated_sequence(start);
        }
        UInt32 value = UInt32(bytes[index]);
        if (value < 128 || value > 191) {
            throw Utf8Error.invalid_continuation(index);
        }
        if (offset == 1) { second = value; }
        offset = offset + 1;
    }
    if (first == 224 && second < 160) {
        throw Utf8Error.overlong_encoding(start);
    }
    if (first == 240 && second < 144) {
        throw Utf8Error.overlong_encoding(start);
    }
    if (first == 237 && second >= 160) {
        throw Utf8Error.surrogate(start);
    }
    if (first == 244 && second >= 144) {
        throw Utf8Error.codepoint_out_of_range(start);
    }
    return sequence_length;
}

public String concat(String& first, String& second) {
    StringBuilder builder! = StringBuilder();
    builder.append(first);
    builder.append(second);
    return builder.into_string();
}

public struct StringBuilder: Movable {
    vector.Vector<UInt8> bytes!;

    public init(self) {
        self.bytes = vector.Vector<UInt8>();
    }

    // 借用并追加已有 String，不消耗 value。
    public Void append(Self&! self, String& value) {
        self.write_bytes(value.bytes());
    }

    // 追加字符串字面量兼容的 bytes；动态输入应使用可恢复的 append_utf8。
    public Void append(Self&! self, UInt8[]& value) {
        Int byte_length = try validate_utf8(value) catch {
            panic_impl.panic("StringBuilder.append received invalid UTF-8");
            0
        };
        self.write_bytes(value);
    }

    // 验证并追加 UTF-8 bytes；验证失败时 builder 保持不变，错误 offset 相对于 value。
    public Void@Utf8Error append_utf8(Self&! self, UInt8[]& value) {
        validate_utf8(value);
        self.write_bytes(value);
    }

    // 追加调用者已保证为合法 UTF-8 的 bytes；错误输入会破坏 StringBuilder invariant。
    public unsafe Void append_utf8_unchecked(Self&! self, UInt8[]& value) {
        self.write_bytes(value);
    }

    public Void append(Self&! self, Bool value) {
        if (value) {
            self.write_bytes("true");
            return;
        }
        self.write_bytes("false");
    }

    public Void append(Self&! self, Int value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    public Void append(Self&! self, Int8 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    public Void append(Self&! self, Int16 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    public Void append(Self&! self, Int32 value, Int radix = 10) {
        self.write_signed(Int64(value), radix);
    }

    public Void append(Self&! self, Int64 value, Int radix = 10) {
        self.write_signed(value, radix);
    }

    public Void append(Self&! self, UInt value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    public Void append(Self&! self, UInt8 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    public Void append(Self&! self, UInt16 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    public Void append(Self&! self, UInt32 value, Int radix = 10) {
        self.write_unsigned(UInt64(value), radix);
    }

    public Void append(Self&! self, UInt64 value, Int radix = 10) {
        self.write_unsigned(value, radix);
    }

    public Void append(Self&! self, Float16 value, Int precision = 6) {
        self.write_float(Float64(value), precision);
    }

    public Void append(Self&! self, Float32 value, Int precision = 6) {
        self.write_float(Float64(value), precision);
    }

    public Void append(Self&! self, Float64 value, Int precision = 6) {
        self.write_float(value, precision);
    }

    // 消耗 builder 并把 storage 直接转移给 String，复杂度为 O(1)。
    public String into_string(Self self!) {
        String result! = String("");
        vector.Vector<UInt8> bytes = self.bytes;
        result.storage = bytes.into_slice();
        return result;
    }

    // 消耗 builder 并把 UTF-8 storage 转移为 owned byte slice，复杂度为 O(1)。
    public UInt8[]^ into_slice(Self self!) {
        vector.Vector<UInt8> bytes = self.bytes;
        return bytes.into_slice();
    }

    @life(return: self)
    public UInt8[]& slice(self) {
        return self.bytes.slice();
    }

    Void write_bytes(Self&! self, UInt8[]& value) {
        Int index! = 0;
        while (index < value.length) {
            self.bytes.append(value[index]);
            index = index + 1;
        }
    }

    Void write_signed(Self&! self, Int64 value, Int radix) {
        self.check_radix(radix);
        if (value < Int64(0)) {
            self.write_byte(45);
            self.write_unsigned(UInt64(-(value + Int64(1))) + UInt64(1), radix);
            return;
        }
        self.write_unsigned(UInt64(value), radix);
    }

    Void write_unsigned(Self&! self, UInt64 value, Int radix) {
        unsafe {
            self.check_radix(radix);
            UInt64 remaining! = value;
            if (remaining == UInt64(0)) {
                self.write_byte(48);
                return;
            }
            UInt8*! digits! = unsafe {
                UInt8$.alloc(64)
            };
            Int digit_count! = 0;
            while (remaining > UInt64(0)) {
                UInt64 digit = remaining % UInt64(radix);
                digits[digit_count] = self.digit_byte(digit);
                digit_count = digit_count + 1;
                remaining = remaining / UInt64(radix);
            }
            while (digit_count > 0) {
                digit_count = digit_count - 1;
                self.write_byte(digits[digit_count]);
            }
            unsafe {
                digits$.dealloc();
            }
        }
    }

    Void write_float(Self&! self, Float64 value, Int precision) {
        assert(precision >= 0);
        Float64 current! = value;
        if (current < Float64(0)) {
            self.write_byte(45);
            current = Float64(0) - current;
        }
        Int64 whole = Int64(current);
        self.write_signed(whole, 10);
        if (precision == 0) {
            return;
        }
        self.write_byte(46);
        Float64 fraction! = current - Float64(whole);
        Int index! = 0;
        while (index < precision) {
            fraction = fraction * Float64(10);
            Int digit = Int(fraction);
            self.write_byte(UInt8(48 + digit));
            fraction = fraction - Float64(digit);
            index = index + 1;
        }
    }

    Void check_radix(self, Int radix) {
        assert(radix >= 2 && radix <= 36);
    }

    UInt8 digit_byte(self, UInt64 digit) {
        if (digit < UInt64(10)) {
            return UInt8(48) + UInt8(digit);
        }
        return UInt8(97) + UInt8(digit - UInt64(10));
    }

    Void write_byte(Self&! self, UInt8 value) {
        self.bytes.append(value);
    }
}

@region(a)
public struct StringChars: Copyable, Iterator {
    @life(a)
    UInt8[]& bytes;
    Int index!;

    public init(self, UInt8[]& bytes) {
        self.bytes = bytes;
        self.index = 0;
    }

    associated Element = Char;

    public Char? next(Self&! self) {
        if (self.index >= self.bytes.length) {
            return null;
        }
        UInt32 first = UInt32(self.bytes[self.index]);
        if (first < 128) {
            self.index = self.index + 1;
            return Char(first);
        }
        return self.next_non_ascii(first);
    }

    Char next_non_ascii(Self&! self, UInt32 first) {
        if ((first & 224) == 192) {
            return self.next_two_byte(first);
        }
        if ((first & 240) == 224) {
            return self.next_three_byte(first);
        }
        return self.next_four_byte(first);
    }

    Char next_two_byte(Self&! self, UInt32 first) {
        UInt32 code! = (first & 31) << 6;
        code = code | self.continuation(1);
        self.index = self.index + 2;
        return Char(code);
    }

    Char next_three_byte(Self&! self, UInt32 first) {
        UInt32 code! = (first & 15) << 12;
        code = code | (self.continuation(1) << 6);
        code = code | self.continuation(2);
        self.index = self.index + 3;
        return Char(code);
    }

    Char next_four_byte(Self&! self, UInt32 first) {
        UInt32 code! = (first & 7) << 18;
        code = code | (self.continuation(1) << 12);
        code = code | (self.continuation(2) << 6);
        code = code | self.continuation(3);
        self.index = self.index + 4;
        return Char(code);
    }

    UInt32 continuation(self, Int offset) {
        return UInt32(self.bytes[self.index + offset]) & 63;
    }
}
