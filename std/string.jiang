import vector = "vector.jiang";

extend Char {
    public init(UInt32 code) {
        self = code$.as(Char);
    }
}

public struct String: Movable, Sequence, Equatable {
    vector.Vector<UInt8>! storage;
    public(get) Int! byte_length;

    public init(UInt8[]& bytes) {
        self.storage = vector.Vector<UInt8>(bytes.length);
        self.byte_length = 0;
        Int! index = 0;
        while (index < bytes.length) {
            self.storage.append(bytes[index]);
            index = index + 1;
        }
        self.byte_length = self.storage.length;
    }

    @life(self > return)
    public UInt8[]& bytes() {
        return self.storage.slice();
    }

    @life(self > return)
    public StringChars chars() {
        return StringChars(self.bytes());
    }

    public Int char_count() {
        StringChars! iterator = self.chars();
        Int! count = 0;
        while (iterator.next() is .some(_)) {
            count = count + 1;
        }
        return count;
    }

    public static Bool equal(String& lhs, String& rhs) {
        if (lhs.byte_length != rhs.byte_length) {
            return false;
        }
        UInt8[]& lhs_bytes = lhs.bytes();
        UInt8[]& rhs_bytes = rhs.bytes();
        Int! index = 0;
        while (index < lhs.byte_length) {
            if (lhs_bytes[index] != rhs_bytes[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    associated Element = Char;
    associated Iter = StringChars;

    @life(self > return)
    public StringChars make_iterator() {
        return self.chars();
    }
}

public struct StringChars: Iterator {
    @life(bytes > self)
    UInt8[]& bytes;
    Int! index;

    public init(UInt8[]& bytes) {
        self.bytes = bytes;
        self.index = 0;
    }

    associated Element = Char;

    public Char? next() {
        if (self.index >= self.bytes.length) {
            return null;
        }
        UInt32 first = UInt32(self.bytes[self.index]);
        if (first < UInt32(128)) {
            self.index = self.index + 1;
            return Char(first);
        }
        return self.next_non_ascii(first);
    }

    Char next_non_ascii(UInt32 first) {
        if ((first & UInt32(224)) == UInt32(192)) {
            return self.next_two_byte(first);
        }
        if ((first & UInt32(240)) == UInt32(224)) {
            return self.next_three_byte(first);
        }
        return self.next_four_byte(first);
    }

    Char next_two_byte(UInt32 first) {
        UInt32! code = (first & UInt32(31)) << UInt32(6);
        code = code | self.continuation(1);
        self.index = self.index + 2;
        return Char(code);
    }

    Char next_three_byte(UInt32 first) {
        UInt32! code = (first & UInt32(15)) << UInt32(12);
        code = code | (self.continuation(1) << UInt32(6));
        code = code | self.continuation(2);
        self.index = self.index + 3;
        return Char(code);
    }

    Char next_four_byte(UInt32 first) {
        UInt32! code = (first & UInt32(7)) << UInt32(18);
        code = code | (self.continuation(1) << UInt32(12));
        code = code | (self.continuation(2) << UInt32(6));
        code = code | self.continuation(3);
        self.index = self.index + 4;
        return Char(code);
    }

    UInt32 continuation(Int offset) {
        return UInt32(self.bytes[self.index + offset]) & UInt32(63);
    }
}
