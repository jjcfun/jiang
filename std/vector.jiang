// Growable contiguous array for std users.
//
// `Vector<T>` owns spare capacity. `as_slice()` only exposes initialized items.

public struct Vector<T>: Movable {
    T![*]! data;
    Int! capacity;
    Int! length;

    public init() {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(Int initial_capacity) {
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = T!$.alloc_array(initial_capacity);
            self.capacity = initial_capacity;
            return;
        }
        self.data = null;
        self.capacity = 0;
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public T[]& as_slice() {
        return self.data[0..self.length];
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    public () append(T value) {
        self.ensure_capacity(self.length + 1);
        self.data[self.length] = value$.move();
        self.length = self.length + 1;
    }

    public T pop() {
        assert(self.length > 0);
        self.length = self.length - 1;
        return self.data[self.length];
    }

    public () clear() {
        self.length = 0;
    }

    public () truncate(Int len) {
        assert(len >= 0 && len <= self.length);
        self.length = len;
    }

    public T remove(Int index) {
        assert(index >= 0 && index < self.length);
        T result = self.data[index];
        self.shift_left_from(index + 1);
        self.length = self.length - 1;
        return result$.move();
    }

    public T swap_remove(Int index) {
        assert(index >= 0 && index < self.length);
        T result = self.data[index];
        self.length = self.length - 1;
        if (index != self.length) {
            self.data[index] = self.data[self.length];
        }
        return result$.move();
    }

    public T subscript_get(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index];
    }

    public () subscript_set(Int index, T value) {
        assert(index >= 0 && index < self.length);
        self.data[index] = value$.move();
    }

    () shift_left_from(Int start) {
        Int! index = start;
        while (index < self.length) {
            self.data[index - 1] = self.data[index];
            index = index + 1;
        }
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = T!$.alloc_array(new_capacity);
        self.move_items_to(new_data);
        if (self.capacity > 0) {
            self.data$.free();
        }
        self.data = new_data$.move();
        self.capacity = new_capacity;
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    () move_items_to(T![*]! new_data) {
        Int! index = 0;
        while (index < self.length) {
            new_data[index] = self.data[index];
            index = index + 1;
        }
    }

    deinit() {
        if (self.capacity > 0) {
            self.data$.free();
        }
    }
}
