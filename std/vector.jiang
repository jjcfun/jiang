// Growable contiguous array for std users.
//
// `Vector<T>` owns spare capacity. `slice()` only exposes initialized items.

public struct Vector<T>: Movable {
    T![*]! data;
    public(get) Int! capacity;
    Int! count;

    public init(Int capacity = 0) {
        self.count = 0;
        if (capacity > 0) {
            self.data = T!$.alloc_array(capacity);
            self.capacity = capacity;
            return;
        }
        self.data = null;
        self.capacity = 0;
    }

    public () append(T value) {
        self.ensure_capacity(self.count + 1);
        self.data[self.count] = value$.move();
        self.count = self.count + 1;
    }

    public T[]& slice() {
        return self.data[0..self.count];
    }

    public T[*] many_pointer() {
        return self.slice()$.ptr();
    }

    public Int length() {
        return self.count;
    }

    @self(move)
    public T[]^ into_array() {
        T[]^ result = self.slice()$.as(T[]^);
        self$.forget();
        return result$.move();
    }

    () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.count + additional);
    }

    T pop() {
        assert(self.count > 0);
        self.count = self.count - 1;
        return self.data[self.count];
    }

    () clear() {
        self.count = 0;
    }

    () truncate(Int len) {
        assert(len >= 0 && len <= self.count);
        self.count = len;
    }

    T remove(Int index) {
        assert(index >= 0 && index < self.count);
        T result = self.data[index];
        self.shift_left_from(index + 1);
        self.count = self.count - 1;
        return result$.move();
    }

    T swap_remove(Int index) {
        assert(index >= 0 && index < self.count);
        T result = self.data[index];
        self.count = self.count - 1;
        if (index != self.count) {
            self.data[index] = self.data[self.count];
        }
        return result$.move();
    }

    T subscript_get(Int index) {
        assert(index >= 0 && index < self.count);
        return self.data[index];
    }

    () subscript_set(Int index, T value) {
        assert(index >= 0 && index < self.count);
        self.data[index] = value$.move();
    }

    () shift_left_from(Int start) {
        Int! index = start;
        while (index < self.count) {
            self.data[index - 1] = self.data[index];
            index = index + 1;
        }
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = T!$.alloc_array(new_capacity);
        self.move_items_to(new_data);
        if (self.capacity > 0) {
            self.data$.free();
        }
        self.data = new_data$.move();
        self.capacity = new_capacity;
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    () move_items_to(T![*]! new_data) {
        Int! index = 0;
        while (index < self.count) {
            new_data[index] = self.data[index];
            index = index + 1;
        }
    }

    deinit() {
        if (self.capacity > 0) {
            self.data$.free();
        }
    }
}
