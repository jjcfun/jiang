// Growable contiguous array for std users.
//
// `Vector<T>` owns spare capacity. `slice()` only exposes initialized items.

public struct Vector<T>: Movable, Contiguous {
    T*! data!;
    Int capacity!;
    Int length!;

    public init(self, Int capacity = 0) {
        self.length = 0;
        if (capacity > 0) {
            self.data = unsafe {
                T$.alloc(capacity)
            };
            self.capacity = capacity;
            return;
        }
        self.data = null;
        self.capacity = 0;
    }

    public () append(Self&! self, T value) {
        unsafe {
            self.ensure_capacity(self.length + 1);
            self.data[self.length] = value;
            self.length = self.length + 1;
        }
    }

    @life(return: (self, self))
    public T[]& slice(self) {
        unsafe {
            return self.data[0..self.length];
        }
    }

    @inline
    public T* ptr(self) {
        return unsafe {
            self.data$.as(T*)
        };
    }

    @inline
    public Int length(self) {
        return self.length;
    }

    @inline
    public Int capacity(self) {
        return self.capacity;
    }

    public T? last(self) {
        unsafe {
            if (self.length == 0) {
                return null;
            }
            return self.data[self.length - 1];
        }
    }

    associated Element = T;

    @life()
    public T[]^ into_slice(Self self) {
        T[]^ result = unsafe {
            self.slice()$.as(T[]^)
        };
        unsafe {
            self$.forget();
        }
        return result;
    }

    () reserve(Self&! self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    T pop(Self&! self) {
        unsafe {
            assert(self.length > 0);
            self.length = self.length - 1;
            return self.data[self.length];
        }
    }

    public () clear(Self&! self) {
        self.truncate(0);
    }

    public () truncate(Self&! self, Int len) {
        assert(len >= 0 && len <= self.length);
        Int index! = self.length;
        while (index > len) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = len;
    }

    T remove(Self&! self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            T result = self.data[index];
            self.shift_left_from(index + 1);
            self.length = self.length - 1;
            return result;
        }
    }

    T swap_remove(Self&! self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            T result = self.data[index];
            self.length = self.length - 1;
            if (index != self.length) {
                self.data[index] = self.data[self.length];
            }
            return result;
        }
    }

    public T subscript_get(self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length);
            return self.data[index];
        }
    }

    public () subscript_set(Self&! self, Int index, T value) {
        unsafe {
            assert(index >= 0 && index < self.length);
            self.data[index] = value;
        }
    }

    () shift_left_from(Self&! self, Int start) {
        unsafe {
            Int index! = start;
            while (index < self.length) {
                self.data[index - 1] = self.data[index];
                index = index + 1;
            }
        }
    }

    () ensure_capacity(Self&! self, Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T*! new_data! = unsafe {
            T$.alloc(new_capacity)
        };
        self.move_items_to(new_data);
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
        self.data = new_data;
        self.capacity = new_capacity;
    }

    Int next_capacity(self, Int min_capacity) {
        Int new_capacity! = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    () move_items_to(Self&! self, T*! new_data!) {
        unsafe {
            Int index! = 0;
            while (index < self.length) {
                new_data[index] = self.data[index];
                index = index + 1;
            }
        }
    }

    deinit(self) {
        Int index! = self.length;
        while (index > 0) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = 0;
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
    }
}
