// Growable contiguous array for std users.
//
// `Vector<T>` owns spare capacity. `slice()` only exposes initialized items.

public struct Vector<T>: Movable, Contiguous {
    T![*]! data;
    Int! capacity;
    Int! length;

    public init(self, Int capacity = 0) {
        self.length = 0;
        if (capacity > 0) {
            self.data = do [unsafe] {
                T!$.alloc_many(capacity)
            };
            self.capacity = capacity;
            return;
        }
        self.data = null;
        self.capacity = 0;
    }

    public () append(unique self, T value) {
        self.ensure_capacity(self.length + 1);
        self.data[self.length] = value$.move();
        self.length = self.length + 1;
    }

    public T[]& slice(self) {
        return self.data[0..self.length];
    }

    @inline
    public T[*] many_pointer(self) {
        return do [unsafe] {
            self.data$.as(T[*])
        };
    }

    @inline
    public Int length(self) {
        return self.length;
    }

    @inline
    public Int capacity(self) {
        return self.capacity;
    }

    public T? last(self) {
        if (self.length == 0) {
            return null;
        }
        return self.data[self.length - 1];
    }

    associated Element = T;

    public T[]^ into_slice(Self self) {
        T[]^ result = do [unsafe] {
            self.slice()$.as(T[]^)
        };
        do [unsafe] {
            self$.forget();
        }
        return result$.move();
    }

    () reserve(unique self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    T pop(unique self) {
        assert(self.length > 0);
        self.length = self.length - 1;
        return self.data[self.length];
    }

    public () clear(unique self) {
        self.truncate(0);
    }

    public () truncate(unique self, Int len) {
        assert(len >= 0 && len <= self.length);
        Int! index = self.length;
        while (index > len) {
            index = index - 1;
            do [unsafe] {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = len;
    }

    T remove(unique self, Int index) {
        assert(index >= 0 && index < self.length);
        T result = self.data[index];
        self.shift_left_from(index + 1);
        self.length = self.length - 1;
        return result$.move();
    }

    T swap_remove(unique self, Int index) {
        assert(index >= 0 && index < self.length);
        T result = self.data[index];
        self.length = self.length - 1;
        if (index != self.length) {
            self.data[index] = self.data[self.length];
        }
        return result$.move();
    }

    public T subscript_get(self, Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index];
    }

    public () subscript_set(unique self, Int index, T value) {
        assert(index >= 0 && index < self.length);
        self.data[index] = value$.move();
    }

    () shift_left_from(unique self, Int start) {
        Int! index = start;
        while (index < self.length) {
            self.data[index - 1] = self.data[index];
            index = index + 1;
        }
    }

    () ensure_capacity(unique self, Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = do [unsafe] {
            T!$.alloc_many(new_capacity)
        };
        self.move_items_to(new_data);
        if (self.capacity > 0) {
            do [unsafe] {
                self.data$.dealloc();
            }
        }
        self.data = new_data$.move();
        self.capacity = new_capacity;
    }

    Int next_capacity(self, Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    () move_items_to(unique self, T![*]! new_data) {
        Int! index = 0;
        while (index < self.length) {
            new_data[index] = self.data[index];
            index = index + 1;
        }
    }

    deinit(self) {
        Int! index = self.length;
        while (index > 0) {
            index = index - 1;
            do [unsafe] {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = 0;
        if (self.capacity > 0) {
            do [unsafe] {
                self.data$.dealloc();
            }
        }
    }
}
