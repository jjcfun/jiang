import string = "string.jiang";
import vector = "vector.jiang";

public struct Path: Movable {
    vector.Vector<UInt8> bytes!;

    public init(self, UInt8[]& text) {
        self.bytes = vector.Vector<UInt8>(text.length);
        append_bytes(self.bytes$.mut_ref(), text);
    }

    @life(self > return)
    public UInt8[]& text(self) {
        return self.bytes.slice();
    }

    public Bool is_absolute(self) {
        return is_absolute(self.text());
    }

    @life(self > return)
    public UInt8[]& dirname(self) {
        return dirname(self.text());
    }

    public UInt8[]^ into_slice(Self self) {
        vector.Vector<UInt8> result! = vector.Vector<UInt8>(self.bytes.length());
        append_bytes(result$.mut_ref(), self.bytes.slice());
        return result$.move().into_slice();
    }
}

public struct PathBuilder: Movable {
    string.StringBuilder bytes!;

    public init(self) {
        self.bytes = string.StringBuilder();
    }

    public init(self, UInt8[]& base) {
        self.bytes = string.StringBuilder();
        self.bytes.append(base);
    }

    public () append(unique self, UInt8[]& segment) {
        if (segment.length == 0) {
            return;
        }
        UInt8[]& current = self.bytes.slice();
        if (current.length > 0 && current[current.length - 1] != '/') {
            self.bytes.append("/");
        }
        self.bytes.append(segment);
    }

    public Path finish(Self self) {
        return Path(self.bytes.slice());
    }
}

public Bool is_absolute(UInt8[]& path) {
    return path.length > 0 && path[0] == '/';
}

public Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public UInt8[]& dirname(UInt8[]& path) {
    Int slash! = -1;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            slash = index;
        }
        index = index + 1;
    }
    if (slash < 0) {
        return "";
    }
    if (slash == 0) {
        return "/";
    }
    return path[0..slash];
}

public Path join(UInt8[]& base, UInt8[]& relative) {
    if (relative.length == 0) {
        return Path(relative);
    }
    if (is_absolute(relative)) {
        return Path(relative);
    }
    if (base.length == 0) {
        return Path(relative);
    }
    PathBuilder builder! = PathBuilder(base);
    builder.append(relative);
    return builder.finish();
}

public Bool has_extension(UInt8[]& path) {
    Int index! = path.length - 1;
    while (index >= 0) {
        if (path[index] == '/') {
            return false;
        }
        if (path[index] == '.') {
            return true;
        }
        index = index - 1;
    }
    return false;
}

public Path with_extension(UInt8[]& path, UInt8[]& extension) {
    vector.Vector<UInt8> bytes! = vector.Vector<UInt8>(path.length + extension.length);
    append_bytes(bytes$.mut_ref(), path);
    append_bytes(bytes$.mut_ref(), extension);
    return Path(bytes.slice());
}

public Path normalize(UInt8[]& input) {
    return Path(normalized(input));
}

UInt8[]& normalized(UInt8[]& input) {
    if (input.length == 0) {
        return input;
    }

    Bool absolute = is_absolute(input);
    UInt8[*]! bytes = unsafe {
        UInt8!$.alloc_many(input.length + 1)
    };
    Int write! = 0;
    if (absolute) {
        bytes[0] = '/';
        write = 1;
    }

    Int index! = 0;
    while (index < input.length) {
        while (index < input.length && input[index] == '/') {
            index = index + 1;
        }
        Int segment_start = index;
        while (index < input.length && input[index] != '/') {
            index = index + 1;
        }
        Int segment_len = index - segment_start;
        if (segment_len == 0 || segment_is(input, segment_start, segment_len, ".")) {
            continue;
        }
        if (segment_is(input, segment_start, segment_len, "..")) {
            if (can_pop_segment(bytes, write, absolute)) {
                write = pop_segment(bytes, write);
            } else if (!absolute) {
                write = append_segment(bytes, write, input, segment_start, segment_len);
            }
            continue;
        }
        write = append_segment(bytes, write, input, segment_start, segment_len);
    }

    if (absolute && write == 0) {
        bytes[0] = '/';
        write = 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = unsafe {
        bytes$.as(UInt8[*])
    };
    return frozen[0..write];
}

() append_bytes(unique vector.Vector<UInt8>&! bytes, UInt8[]& text) {
    Int index! = 0;
    while (index < text.length) {
        bytes.append(text[index]);
        index = index + 1;
    }
}

Bool segment_is(UInt8[]& input, Int start, Int len, UInt8[]& expected) {
    if (len != expected.length) {
        return false;
    }
    Int index! = 0;
    while (index < len) {
        if (input[start + index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int append_segment(UInt8[*]! bytes, Int write, UInt8[]& input, Int start, Int len) {
    Int out! = write;
    if (out > 0 && bytes[out - 1] != '/') {
        bytes[out] = '/';
        out = out + 1;
    }
    Int index! = 0;
    while (index < len) {
        bytes[out] = input[start + index];
        out = out + 1;
        index = index + 1;
    }
    return out;
}

Bool can_pop_segment(UInt8[*]! bytes, Int write, Bool absolute) {
    if (write == 0) {
        return false;
    }
    if (absolute && write == 1) {
        return false;
    }
    return !last_segment_is_dot_dot(bytes, write, absolute);
}

Bool last_segment_is_dot_dot(UInt8[*]! bytes, Int write, Bool absolute) {
    Int start! = write - 1;
    while (start >= 0 && bytes[start] != '/') {
        start = start - 1;
    }
    start = start + 1;
    if (write - start != 2) {
        return false;
    }
    return bytes[start] == '.' && bytes[start + 1] == '.';
}

Int pop_segment(UInt8[*]! bytes, Int write) {
    Int out! = write - 1;
    while (out >= 0 && bytes[out] != '/') {
        out = out - 1;
    }
    if (out < 0) {
        return 0;
    }
    return out;
}
