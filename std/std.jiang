// Internal std incubator entry point.
//
// 入口重新导出稳定 API。fs/io/process 先保留 namespace；Vector/String
// 作为常用类型直接暴露，隐藏对应实现子模块 namespace。compiler
// builtin named types 也在 std 下提供显式路径，避免被用户局部同名定义遮蔽后
// 找不到稳定名字。

import core;
public import fs = "fs.jiang";
public import io = "io.jiang";
public import process = "process.jiang";
public import jiang = "jiang.jiang";

import string = "string.jiang";
import vector = "vector.jiang";
import numeric = "numeric.jiang";
import format = "format.jiang";

public alias String = string.String;
public alias Vector = vector.Vector;
public alias Integer = numeric.Integer;
public alias SignedInteger = numeric.SignedInteger;
public alias UnsignedInteger = numeric.UnsignedInteger;
public alias FloatingPoint = numeric.FloatingPoint;
public alias StringFormatter = format.StringFormatter;
public alias Displayable = format.Displayable;

public alias Bool;
public alias Int;
public alias UInt;
public alias Int8;
public alias Int16;
public alias Int32;
public alias Int64;
public alias UInt8;
public alias UInt16;
public alias UInt32;
public alias UInt64;
public alias Float16;
public alias Float;
public alias Float32;
public alias Float64;
public alias Double;
public alias Char;
public alias Option;
public alias Result;
public alias Fn;
public alias Reference;
public alias Box;
public alias RawPointer;
public alias ManyPointer;
public alias SentinelPointer;
public alias Slice;
public alias SentinelSlice;
public alias Array;
public alias SentinelArray;
public alias Movable;
public alias Mutable;
public alias Equatable;
public alias Hashable;
public alias Iterator;
public alias Sequence;
public alias Contiguous;
