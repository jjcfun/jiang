// Internal std incubator entry point.
//
// 入口重新导出稳定 API。fs/io/process 先保留 namespace；Vector/String
// 作为常用类型直接暴露，隐藏对应实现子模块 namespace。compiler
// builtin named types 也在 std 下提供显式路径，避免被用户局部同名定义遮蔽后
// 找不到稳定名字。

public import fs = "fs.jiang";
public import io = "io.jiang";
public import process = "process.jiang";
import string = "string.jiang";
import vector = "vector.jiang";

public alias String = string.String;
public alias Vector = vector.Vector;

public alias Bool = Bool;
public alias Int = Int;
public alias UInt = UInt;
public alias Int8 = Int8;
public alias Int16 = Int16;
public alias Int32 = Int32;
public alias Int64 = Int64;
public alias UInt8 = UInt8;
public alias UInt16 = UInt16;
public alias UInt32 = UInt32;
public alias UInt64 = UInt64;
public alias Float = Float;
public alias Float32 = Float32;
public alias Float64 = Float64;
public alias Double = Double;
public alias Char = Char;
public alias CString = CString;
public alias Option = Option;
public alias Result = Result;
public alias Reference = Reference;
public alias Box = Box;
public alias RawPointer = RawPointer;
public alias ManyPointer = ManyPointer;
