// Jiang standard library entry point.
//
// Vector/String 等常用类型直接暴露；filesystem、process 和 debug API 通过独立 namespace 组织。
// compiler-owned 后缀类型只使用表面语法，不在 std 下重新导出内部 constructor 名。

import core;
public import jiang = "jiang.jiang";
public import build = "build.jiang";
public import debug = "debug.jiang";
public import fs = "fs.jiang";
public import io = "io.jiang";
public import path = "path.jiang";
public import process = "process.jiang";
public import collection = "collection.jiang";

import string = "string.jiang";
public import * = "numeric.jiang";
import path_impl = "path.jiang";
import format = "format.jiang";

public alias String = string.String;
public alias Vector = collection.Vector;
public alias Path = path_impl.Path;
public alias PathBuilder = path_impl.PathBuilder;
public alias StringBuilder = string.StringBuilder;
public alias Formattable = format.Formattable;
public alias Atomic = core.atomic.Atomic;
public alias AtomicValue = core.atomic.AtomicValue;
public alias MemoryOrder = core.atomic.MemoryOrder;
public alias Mutex = core.mutex.Mutex;

public alias Bool;
public alias Int;
public alias UInt;
public alias Int8;
public alias Int16;
public alias Int32;
public alias Int64;
public alias UInt8;
public alias UInt16;
public alias UInt32;
public alias UInt64;
public alias Float16;
public alias Float;
public alias Float32;
public alias Float64;
public alias Double;
public alias Char;
public alias Fn;
public alias FnOnce;
public alias Movable;
public alias Mutable;
public alias Equatable;
public alias Hashable;
public alias Iterator;
public alias Sequence;
public alias Contiguous;
