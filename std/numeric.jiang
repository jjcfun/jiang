// 格式化与 generic std API 使用的数值类型族。

// 全部 builtin 整数共同满足的 marker trait。
public trait Integer;

// signed builtin 整数 marker trait。
public trait SignedInteger: Integer;

// unsigned builtin 整数 marker trait。
public trait UnsignedInteger: Integer;

// builtin 浮点数 marker trait。
public trait FloatingPoint;

// Int 是 signed integer。
public extend Int: SignedInteger;

// Int8 是 signed integer。
public extend Int8: SignedInteger;

// Int16 是 signed integer。
public extend Int16: SignedInteger;

// Int32 是 signed integer。
public extend Int32: SignedInteger;

// Int64 是 signed integer。
public extend Int64: SignedInteger;

// UInt 是 unsigned integer。
public extend UInt: UnsignedInteger;

// UInt8 是 unsigned integer。
public extend UInt8: UnsignedInteger;

// UInt16 是 unsigned integer。
public extend UInt16: UnsignedInteger;

// UInt32 是 unsigned integer。
public extend UInt32: UnsignedInteger;

// UInt64 是 unsigned integer。
public extend UInt64: UnsignedInteger;

// Float16 是 floating-point 类型。
public extend Float16: FloatingPoint;

// Float32 是 floating-point 类型。
public extend Float32: FloatingPoint;

// Float64 是 floating-point 类型。
public extend Float64: FloatingPoint;

// Double 是 floating-point 类型。
public extend Double: FloatingPoint;
