import source = "../syntax/source.jiang";
import symbol = "../syntax/symbol.jiang";

public alias Span = source.Span;

// `TokenTag` 是 parser 友好的扁平 token 标签。
//
// `TokenKind` 会按 Rust 风格把 token 分成 name/literal/delimiter 等大类；
// parser 的 lookahead 和错误恢复通常只需要扁平标签，所以通过 `token_tag`
// 从 `TokenKind` 派生 `TokenTag`。
public enum TokenTag {
    // 文件结束。
    eof,

    // lexer 无法识别或未闭合的 token。
    error,

    // 普通标识符。
    ident,

    // 反引号转义标识符。
    escaped_ident,

    // 整数字面量。
    int_lit,

    // 浮点数字面量。
    float_lit,

    // 字符字面量。
    char_lit,

    // 字符串字面量。
    string_lit,

    // `#lang { ... }` 中的原始 block。
    raw_block,

    // `(`。
    left_paren,

    // `)`。
    right_paren,

    // `{`。
    left_brace,

    // `}`。
    right_brace,

    // `[`。
    left_bracket,

    // `]`。
    right_bracket,

    // `@`。
    at,

    // `#`。
    hash,

    // `,`。
    comma,

    // `:`。
    colon,

    // `;`。
    semicolon,

    // `.`。
    dot,

    // `..`。
    dot_dot,

    // `$`。
    dollar,

    // 独立 `_`。
    underscore,

    // `?`。
    question,

    // `?.`。
    question_dot,

    // `??`。
    question_question,

    // `!`。
    bang,

    // `=`。
    assign,

    // `+=`。
    plus_assign,

    // `-=`。
    minus_assign,

    // `*=`。
    star_assign,

    // `/=`。
    slash_assign,

    // `%=`。
    percent_assign,

    // `&=`。
    amp_assign,

    // `|=`。
    pipe_assign,

    // `^=`。
    caret_assign,

    // `<<=`。
    lt_lt_assign,

    // `>>=`。
    gt_gt_assign,

    // `=>`。
    fat_arrow,

    // `+`。
    plus,

    // `-`。
    minus,

    // `*`。
    star,

    // `/`。
    slash,

    // `%`。
    percent,

    // `&`。
    amp,

    // `&&`。
    amp_amp,

    // `|`。
    pipe,

    // `||`。
    pipe_pipe,

    // `^`。
    caret,

    // `~`。
    tilde,

    // `<`。
    lt,

    // `<=`。
    lt_eq,

    // `<<`。
    lt_lt,

    // `>`。
    gt,

    // `>=`。
    gt_eq,

    // `>>`。
    gt_gt,

    // `==`。
    eq_eq,

    // `!=`。
    bang_eq,
}

// Jiang token 的语义分类。
//
// 分类结构减少平铺 token kind 的数量；带文本身份的 token 只通过
// `SymbolId` 引用文本，具体 symbol 表由调用方的 `Builder` 管理。
public union TokenKind: Copyable {
    // 文件结束。
    () eof;

    // lexer 无法识别或未闭合的 token。
    () error;

    // 标识符类 token。
    Name name;

    // 字面量类 token。
    Literal literal;

    // 成对分隔符。
    Delimiter delimiter;

    // 无结合语义的标点。
    Punctuation punctuation;

    // 操作符。
    Operator operator;

    // `#lang { ... }` 的原始 block。
    RawBlock raw_block;
}

// 标识符 token payload。
public struct Name: Copyable {
    // Builder intern 后的标识符文本。
    public symbol.SymbolId symbol;

    // 是否来自反引号转义标识符。
    public Bool escaped;

    public init(self, symbol.SymbolId symbol, Bool escaped = false) {
        self.symbol = symbol;
        self.escaped = escaped;
    }
}

// 字面量 token payload。
public struct Literal: Copyable {
    public enum Kind: Copyable {
        // 整数字面量。
        int_lit,

        // 浮点数字面量。
        float_lit,

        // 字符字面量。
        char_lit,

        // 字符串字面量。
        string_lit,
    }

    // 字面量种类。
    public Kind kind;

    // Builder intern 后的规范文本；字符串和字符不包含外层引号。
    public symbol.SymbolId symbol;

    public init(self, Kind kind, symbol.SymbolId symbol) {
        self.kind = kind;
        self.symbol = symbol;
    }
}

// 原始 DSL block token payload。
public struct RawBlock: Copyable {
    // Compiler-owned lang block table id. Standalone tokenizers that do not
    // attach provider state use 0.
    public Int block_id;

    public init(self, Int block_id = 0) {
        self.block_id = block_id;
    }
}

// 成对分隔符 token payload。
public struct Delimiter: Copyable {
    public enum Kind: Copyable {
        // 圆括号。
        paren,

        // 花括号。
        brace,

        // 方括号。
        bracket,
    }

    public enum Side: Copyable {
        // 左分隔符。
        left,

        // 右分隔符。
        right,
    }

    // 分隔符种类。
    public Kind kind;

    // 分隔符方向。
    public Side side;

    public init(self, Kind kind, Side side) {
        self.kind = kind;
        self.side = side;
    }
}

// 无结合语义的标点 token。
public enum Punctuation {
    // `@`。
    at,

    // `#`。
    hash,

    // `,`。
    comma,

    // `:`。
    colon,

    // `;`。
    semicolon,

    // `.`。
    dot,

    // `..`。
    dot_dot,

    // `$`。
    dollar,

    // 独立 `_`。
    underscore,
}

// 操作符 token。
public enum Operator {
    // `?`。
    question,

    // `?.`。
    question_dot,

    // `??`。
    question_question,

    // `!`。
    bang,

    // `=`。
    assign,

    // `+=`。
    plus_assign,

    // `-=`。
    minus_assign,

    // `*=`。
    star_assign,

    // `/=`。
    slash_assign,

    // `%=`。
    percent_assign,

    // `&=`。
    amp_assign,

    // `|=`。
    pipe_assign,

    // `^=`。
    caret_assign,

    // `<<=`。
    lt_lt_assign,

    // `>>=`。
    gt_gt_assign,

    // `=>`。
    fat_arrow,

    // `+`。
    plus,

    // `-`。
    minus,

    // `*`。
    star,

    // `/`。
    slash,

    // `%`。
    percent,

    // `&`。
    amp,

    // `&&`。
    amp_amp,

    // `|`。
    pipe,

    // `||`。
    pipe_pipe,

    // `^`。
    caret,

    // `~`。
    tilde,

    // `<`。
    lt,

    // `<=`。
    lt_eq,

    // `<<`。
    lt_lt,

    // `>`。
    gt,

    // `>=`。
    gt_eq,

    // `>>`。
    gt_gt,

    // `==`。
    eq_eq,

    // `!=`。
    bang_eq,
}

public TokenTag token_tag(TokenKind kind) {
    if (kind is .eof()) { return .eof; }
    if (kind is .error()) { return .error; }
    if (kind is .name(name)) { return name_tag(name); }
    if (kind is .literal(literal)) { return literal_tag(literal); }
    if (kind is .delimiter(delimiter)) { return delimiter_tag(delimiter); }
    if (kind is .punctuation(punctuation)) { return punctuation_tag(punctuation); }
    if (kind is .operator(operator)) { return operator_tag(operator); }
    if (kind is .raw_block(_)) { return .raw_block; }
    return .error;
}

public TokenTag name_tag(Name name) {
    if (name.escaped) { return .escaped_ident; }
    return .ident;
}

public TokenTag literal_tag(Literal literal) {
    if (literal.kind == .int_lit) { return .int_lit; }
    if (literal.kind == .float_lit) { return .float_lit; }
    if (literal.kind == .char_lit) { return .char_lit; }
    return .string_lit;
}

public TokenTag delimiter_tag(Delimiter delimiter) {
    if (delimiter.kind == .paren && delimiter.side == .left) { return .left_paren; }
    if (delimiter.kind == .paren) { return .right_paren; }
    if (delimiter.kind == .brace && delimiter.side == .left) { return .left_brace; }
    if (delimiter.kind == .brace) { return .right_brace; }
    if (delimiter.side == .left) { return .left_bracket; }
    return .right_bracket;
}

public TokenTag punctuation_tag(Punctuation punctuation) {
    if (punctuation == .at) { return .at; }
    if (punctuation == .hash) { return .hash; }
    if (punctuation == .comma) { return .comma; }
    if (punctuation == .colon) { return .colon; }
    if (punctuation == .semicolon) { return .semicolon; }
    if (punctuation == .dot) { return .dot; }
    if (punctuation == .dot_dot) { return .dot_dot; }
    if (punctuation == .dollar) { return .dollar; }
    return .underscore;
}

public TokenTag operator_tag(Operator operator) {
    if (operator == .question) { return .question; }
    if (operator == .question_dot) { return .question_dot; }
    if (operator == .question_question) { return .question_question; }
    if (operator == .bang) { return .bang; }
    if (operator == .assign) { return .assign; }
    if (operator == .plus_assign) { return .plus_assign; }
    if (operator == .minus_assign) { return .minus_assign; }
    if (operator == .star_assign) { return .star_assign; }
    if (operator == .slash_assign) { return .slash_assign; }
    if (operator == .percent_assign) { return .percent_assign; }
    if (operator == .amp_assign) { return .amp_assign; }
    if (operator == .pipe_assign) { return .pipe_assign; }
    if (operator == .caret_assign) { return .caret_assign; }
    if (operator == .lt_lt_assign) { return .lt_lt_assign; }
    if (operator == .gt_gt_assign) { return .gt_gt_assign; }
    if (operator == .fat_arrow) { return .fat_arrow; }
    if (operator == .plus) { return .plus; }
    if (operator == .minus) { return .minus; }
    if (operator == .star) { return .star; }
    if (operator == .slash) { return .slash; }
    if (operator == .percent) { return .percent; }
    if (operator == .amp) { return .amp; }
    if (operator == .amp_amp) { return .amp_amp; }
    if (operator == .pipe) { return .pipe; }
    if (operator == .pipe_pipe) { return .pipe_pipe; }
    if (operator == .caret) { return .caret; }
    if (operator == .tilde) { return .tilde; }
    if (operator == .lt) { return .lt; }
    if (operator == .lt_eq) { return .lt_eq; }
    if (operator == .lt_lt) { return .lt_lt; }
    if (operator == .gt) { return .gt; }
    if (operator == .gt_eq) { return .gt_eq; }
    if (operator == .gt_gt) { return .gt_gt; }
    if (operator == .eq_eq) { return .eq_eq; }
    return .bang_eq;
}

public TokenKind token_kind(TokenTag tag) {
    symbol.SymbolId empty = symbol.SymbolId(0);
    if (tag == .eof) { return .eof(); }
    if (tag == .error) { return .error(); }
    if (tag == .ident) { return .name(Name(empty)); }
    if (tag == .escaped_ident) { return .name(Name(empty, true)); }
    if (tag == .int_lit) { return .literal(Literal(.int_lit, empty)); }
    if (tag == .float_lit) { return .literal(Literal(.float_lit, empty)); }
    if (tag == .char_lit) { return .literal(Literal(.char_lit, empty)); }
    if (tag == .string_lit) { return .literal(Literal(.string_lit, empty)); }
    if (tag == .raw_block) { return .raw_block(RawBlock()); }
    if (tag == .left_paren) { return .delimiter(Delimiter(.paren, .left)); }
    if (tag == .right_paren) { return .delimiter(Delimiter(.paren, .right)); }
    if (tag == .left_brace) { return .delimiter(Delimiter(.brace, .left)); }
    if (tag == .right_brace) { return .delimiter(Delimiter(.brace, .right)); }
    if (tag == .left_bracket) { return .delimiter(Delimiter(.bracket, .left)); }
    if (tag == .right_bracket) { return .delimiter(Delimiter(.bracket, .right)); }
    if (is_punctuation_tag(tag)) { return .punctuation(punctuation_from_tag(tag)); }
    return .operator(operator_from_tag(tag));
}

public Bool is_punctuation_tag(TokenTag tag) {
    if (tag == .at || tag == .hash || tag == .comma) { return true; }
    if (tag == .colon || tag == .semicolon || tag == .dot) { return true; }
    return tag == .dot_dot || tag == .dollar || tag == .underscore;
}

public Punctuation punctuation_from_tag(TokenTag tag) {
    if (tag == .at) { return .at; }
    if (tag == .hash) { return .hash; }
    if (tag == .comma) { return .comma; }
    if (tag == .colon) { return .colon; }
    if (tag == .semicolon) { return .semicolon; }
    if (tag == .dot) { return .dot; }
    if (tag == .dot_dot) { return .dot_dot; }
    if (tag == .dollar) { return .dollar; }
    return .underscore;
}

public Operator operator_from_tag(TokenTag tag) {
    if (tag == .question) { return .question; }
    if (tag == .question_dot) { return .question_dot; }
    if (tag == .question_question) { return .question_question; }
    if (tag == .bang) { return .bang; }
    if (tag == .assign) { return .assign; }
    if (tag == .plus_assign) { return .plus_assign; }
    if (tag == .minus_assign) { return .minus_assign; }
    if (tag == .star_assign) { return .star_assign; }
    if (tag == .slash_assign) { return .slash_assign; }
    if (tag == .percent_assign) { return .percent_assign; }
    if (tag == .amp_assign) { return .amp_assign; }
    if (tag == .pipe_assign) { return .pipe_assign; }
    if (tag == .caret_assign) { return .caret_assign; }
    if (tag == .lt_lt_assign) { return .lt_lt_assign; }
    if (tag == .gt_gt_assign) { return .gt_gt_assign; }
    if (tag == .fat_arrow) { return .fat_arrow; }
    if (tag == .plus) { return .plus; }
    if (tag == .minus) { return .minus; }
    if (tag == .star) { return .star; }
    if (tag == .slash) { return .slash; }
    if (tag == .percent) { return .percent; }
    if (tag == .amp) { return .amp; }
    if (tag == .amp_amp) { return .amp_amp; }
    if (tag == .pipe) { return .pipe; }
    if (tag == .pipe_pipe) { return .pipe_pipe; }
    if (tag == .caret) { return .caret; }
    if (tag == .tilde) { return .tilde; }
    if (tag == .lt) { return .lt; }
    if (tag == .lt_eq) { return .lt_eq; }
    if (tag == .lt_lt) { return .lt_lt; }
    if (tag == .gt) { return .gt; }
    if (tag == .gt_eq) { return .gt_eq; }
    if (tag == .gt_gt) { return .gt_gt; }
    if (tag == .eq_eq) { return .eq_eq; }
    return .bang_eq;
}

public symbol.SymbolId? token_symbol(TokenKind kind) {
    if (kind is .name(name)) { return name.symbol; }
    if (kind is .literal(literal)) { return literal.symbol; }
    return null;
}

public Int? raw_block_id(TokenKind kind) {
    if (kind is .raw_block(raw_block)) { return raw_block.block_id; }
    return null;
}

public Bool token_kind_is(TokenKind kind, TokenTag tag) {
    return token_tag(kind) == tag;
}

// token 前导 trivia 摘要。
//
// 这里只记录 parser 需要的事实，不保存 trivia 文本本身。
public struct Trivia: Copyable {
    // 前导 trivia 中是否存在空白字符。
    public Bool has_whitespace = false;

    // 前导 trivia 中是否存在换行。
    public Bool has_newline = false;

    // 前导 trivia 中是否存在行注释。
    public Bool has_comment = false;

    public Bool has_any(self) {
        return self.has_whitespace || self.has_comment;
    }
}

// token 是否真实存在于源码中。
public enum TokenPresence {
    // 源码中存在的 token。
    present,

    // parser 为错误恢复合成的 token。
    missing,
}

// lexer 输出的 token。
public struct Token: Copyable {
    // token 语义分类。
    public TokenKind kind;

    // token 在 source 中覆盖的范围。
    public Span span;

    // token 前面的 trivia 摘要。
    public Trivia leading;

    // token 是否为 parser 合成。
    public TokenPresence presence;

    public init(self,
        TokenKind kind,
        Span span,
        Trivia leading,
        TokenPresence presence
    ) {
        self.kind = kind;
        self.span = span;
        self.leading = leading;
        self.presence = presence;
    }

    public Token missing(TokenTag tag, Span span) {
        return Token(token_kind(tag), span, Trivia(), .missing);
    }

    public TokenTag tag(self) {
        return token_tag(self.kind);
    }

    public symbol.SymbolId? symbol_id(self) {
        return token_symbol(self.kind);
    }

    public Int? raw_block_id(self) {
        return raw_block_id(self.kind);
    }
}
