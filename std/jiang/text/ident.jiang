// Jiang identifier predicates.

import utf8 = "utf8.jiang";
import xid = "generated/xid.jiang";

public Bool is_ascii_ident_start(UInt8 value) {
    return (value >= 65 && value <= 90) ||
        (value >= 97 && value <= 122) ||
        value == 95;
}

public Bool is_ascii_ident_continue(UInt8 value) {
    return is_ascii_ident_start(value) || (value >= 48 && value <= 57);
}

public Bool is_utf8_ident_at(UInt8[]& text, Int index) {
    return is_utf8_ident_start_at(text, index);
}

public Bool is_utf8_ident_start_at(UInt8[]& text, Int index) {
    if (!utf8.is_valid_utf8_at(text, index)) { return false; }
    return xid.is_xid_start(utf8.utf8_scalar_at(text, index));
}

public Bool is_utf8_ident_continue_at(UInt8[]& text, Int index) {
    if (!utf8.is_valid_utf8_at(text, index)) { return false; }
    return xid.is_xid_continue(utf8.utf8_scalar_at(text, index));
}

public Int utf8_len_at(UInt8[]& text, Int index) {
    return utf8.utf8_len_at(text, index);
}

public Bool is_ident_name(UInt8[]& text) {
    if (text.length == 0) { return false; }

    Int! index = 0;
    if (is_ascii_ident_start(text[index])) {
        index = index + 1;
    } else if (is_utf8_ident_start_at(text, index)) {
        index = index + utf8_len_at(text, index);
    } else {
        return false;
    }

    while (index < text.length) {
        if (is_ascii_ident_continue(text[index])) {
            index = index + 1;
            continue;
        }
        if (is_utf8_ident_continue_at(text, index)) {
            index = index + utf8_len_at(text, index);
            continue;
        }
        return false;
    }
    return true;
}
