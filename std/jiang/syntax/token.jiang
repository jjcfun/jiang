import source = "source.jiang";
import symbol = "symbol.jiang";

alias SymbolId = symbol.SymbolId;

// Jiang 默认 tokenizer 产生的完整 token kind。
//
// identifier、literal 和 raw block 的内部 identity 跟随对应 case；判断
// token 类别时无需构造 payload，可使用 `is .ident` 或下面的分类方法。
public enum TokenKind: Copyable, Equatable {
    // 文件结束。
    eof,

    // tokenizer 无法识别或未闭合的 token。
    error,

    // 普通标识符；payload 是 intern 后的文本。
    ident(SymbolId),

    // 反引号转义标识符；payload 不包含外层反引号。
    escaped_ident(SymbolId),

    // 整数字面量；payload 是规范文本。
    int_lit(SymbolId),

    // 浮点数字面量；payload 是规范文本。
    float_lit(SymbolId),

    // 字符字面量；payload 是解码后的文本，不包含外层引号。
    char_lit(SymbolId),

    // 字符串字面量；payload 是解码后的文本，不包含外层引号。
    string_lit(SymbolId),

    // `#lang { ... }` 中的原始 block；payload 是 compiler-owned block id。
    raw_block(Int),

    // `(`。
    left_paren,

    // `)`。
    right_paren,

    // `{`。
    left_brace,

    // `}`。
    right_brace,

    // `[`。
    left_bracket,

    // `]`。
    right_bracket,

    // `@`。
    at,

    // `#`。
    hash,

    // `,`。
    comma,

    // `:`。
    colon,

    // `;`。
    semicolon,

    // `.`。
    dot,

    // `..`。
    dot_dot,

    // `$`。
    dollar,

    // 独立 `_`。
    underscore,

    // `?`。
    question,

    // `?.`。
    question_dot,

    // `??`。
    question_question,

    // `!`。
    bang,

    // `=`。
    assign,

    // `+=`。
    plus_assign,

    // `-=`。
    minus_assign,

    // `*=`。
    star_assign,

    // `/=`。
    slash_assign,

    // `%=`。
    percent_assign,

    // `&=`。
    amp_assign,

    // `|=`。
    pipe_assign,

    // `^=`。
    caret_assign,

    // `<<=`。
    lt_lt_assign,

    // `>>=`。
    gt_gt_assign,

    // `=>`。
    fat_arrow,

    // `+`。
    plus,

    // `-`。
    minus,

    // `*`。
    star,

    // `/`。
    slash,

    // `%`。
    percent,

    // `&`。
    amp,

    // `&&`。
    amp_amp,

    // `|`。
    pipe,

    // `||`。
    pipe_pipe,

    // `^`。
    caret,

    // `~`。
    tilde,

    // `<`。
    lt,

    // `<=`。
    lt_eq,

    // `<<`。
    lt_lt,

    // `>`。
    gt,

    // `>=`。
    gt_eq,

    // `>>`。
    gt_gt,

    // `==`。
    eq_eq,

    // `!=`。
    bang_eq;

    public Bool is_identifier(self) {
        return self is .ident || self is .escaped_ident;
    }

    public Bool is_literal(self) {
        return self is .int_lit || self is .float_lit ||
            self is .char_lit || self is .string_lit;
    }

    public Bool is_opening_delimiter(self) {
        return self is .left_paren || self is .left_brace || self is .left_bracket;
    }

    public Bool is_closing_delimiter(self) {
        return self is .right_paren || self is .right_brace || self is .right_bracket;
    }

    // 只比较 enum case，不读取或比较 payload。
    public Bool same_case(self, TokenKind other) {
        TokenKind kind = self$.get();
        return switch kind {
            .eof => other is .eof,
            .error => other is .error,
            .ident(_) => other is .ident,
            .escaped_ident(_) => other is .escaped_ident,
            .int_lit(_) => other is .int_lit,
            .float_lit(_) => other is .float_lit,
            .char_lit(_) => other is .char_lit,
            .string_lit(_) => other is .string_lit,
            .raw_block(_) => other is .raw_block,
            .left_paren => other is .left_paren,
            .right_paren => other is .right_paren,
            .left_brace => other is .left_brace,
            .right_brace => other is .right_brace,
            .left_bracket => other is .left_bracket,
            .right_bracket => other is .right_bracket,
            .at => other is .at,
            .hash => other is .hash,
            .comma => other is .comma,
            .colon => other is .colon,
            .semicolon => other is .semicolon,
            .dot => other is .dot,
            .dot_dot => other is .dot_dot,
            .dollar => other is .dollar,
            .underscore => other is .underscore,
            .question => other is .question,
            .question_dot => other is .question_dot,
            .question_question => other is .question_question,
            .bang => other is .bang,
            .assign => other is .assign,
            .plus_assign => other is .plus_assign,
            .minus_assign => other is .minus_assign,
            .star_assign => other is .star_assign,
            .slash_assign => other is .slash_assign,
            .percent_assign => other is .percent_assign,
            .amp_assign => other is .amp_assign,
            .pipe_assign => other is .pipe_assign,
            .caret_assign => other is .caret_assign,
            .lt_lt_assign => other is .lt_lt_assign,
            .gt_gt_assign => other is .gt_gt_assign,
            .fat_arrow => other is .fat_arrow,
            .plus => other is .plus,
            .minus => other is .minus,
            .star => other is .star,
            .slash => other is .slash,
            .percent => other is .percent,
            .amp => other is .amp,
            .amp_amp => other is .amp_amp,
            .pipe => other is .pipe,
            .pipe_pipe => other is .pipe_pipe,
            .caret => other is .caret,
            .tilde => other is .tilde,
            .lt => other is .lt,
            .lt_eq => other is .lt_eq,
            .lt_lt => other is .lt_lt,
            .gt => other is .gt,
            .gt_eq => other is .gt_eq,
            .gt_gt => other is .gt_gt,
            .eq_eq => other is .eq_eq,
            .bang_eq => other is .bang_eq,
        };
    }

    public symbol.SymbolId? symbol(self) {
        TokenKind kind = self$.get();
        return switch kind {
            .ident(value) => value,
            .escaped_ident(value) => value,
            .int_lit(value) => value,
            .float_lit(value) => value,
            .char_lit(value) => value,
            .string_lit(value) => value,
            else => null,
        };
    }

    public Int? block_id(self) {
        TokenKind kind = self$.get();
        return switch kind {
            .raw_block(value) => value,
            else => null,
        };
    }

    public Bool equal(TokenKind& lhs, TokenKind& rhs) {
        TokenKind left = lhs$.get();
        TokenKind right = rhs$.get();
        if (!left.same_case(right)) { return false; }
        return switch left {
            .ident(value) => equal_ident(value, right),
            .escaped_ident(value) => equal_escaped_ident(value, right),
            .int_lit(value) => equal_int_lit(value, right),
            .float_lit(value) => equal_float_lit(value, right),
            .char_lit(value) => equal_char_lit(value, right),
            .string_lit(value) => equal_string_lit(value, right),
            .raw_block(value) => equal_raw_block(value, right),
            else => true,
        };
    }
}

Bool equal_ident(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .ident(value) else { return false; }
    return expected == value;
}

Bool equal_escaped_ident(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .escaped_ident(value) else { return false; }
    return expected == value;
}

Bool equal_int_lit(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .int_lit(value) else { return false; }
    return expected == value;
}

Bool equal_float_lit(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .float_lit(value) else { return false; }
    return expected == value;
}

Bool equal_char_lit(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .char_lit(value) else { return false; }
    return expected == value;
}

Bool equal_string_lit(symbol.SymbolId expected, TokenKind actual) {
    guard actual is .string_lit(value) else { return false; }
    return expected == value;
}

Bool equal_raw_block(Int expected, TokenKind actual) {
    guard actual is .raw_block(value) else { return false; }
    return expected == value;
}

// Token 前导 trivia 摘要；不保存 trivia 文本本身。
public struct Trivia: Copyable {
    public Bool has_whitespace! = false;
    public Bool has_newline! = false;
    public Bool has_comment! = false;

    public Bool has_any(self) {
        return self.has_whitespace || self.has_comment;
    }
}

public enum TokenPresence {
    present,
    missing,
}

// K 是 provider 定义的 token kind；Jiang 默认 lexer 使用 TokenKind。
@region(k: K)
@where(K: Copyable)
public struct Token<K>: Copyable {
    @life(k)
    public K kind;

    public source.Span span;
    public Trivia leading;
    public TokenPresence presence;

    public init(self, K kind, source.Span span) {
        self.kind = kind;
        self.span = span;
        self.leading = Trivia();
        self.presence = .present;
    }

    public init(self, K kind, source.Span span, Trivia leading) {
        self.kind = kind;
        self.span = span;
        self.leading = leading;
        self.presence = .present;
    }

    public init(self, K kind, source.Span span, Trivia leading, TokenPresence presence) {
        self.kind = kind;
        self.span = span;
        self.leading = leading;
        self.presence = presence;
    }

    public Token<K> missing(K kind, source.Span span) {
        return Token<K>(kind, span, Trivia(), .missing);
    }

    public Bool is_present(self) {
        return self.presence == .present;
    }

    public Bool is_missing(self) {
        return self.presence == .missing;
    }
}

public Token<TokenKind> missing_token(TokenKind kind, source.Span span) {
    return Token<TokenKind>.missing(kind, span);
}
