// 源码位置基础结构。
//
// 这些类型面向 DSL、parser 和编译器源码共享使用，只描述稳定的 source/span
// 契约，不绑定编译器内部 source map 实现。

public struct SourceId: Equatable {
    // Opaque source handle. Absence should be represented with SourceId?.
    public Int value;

    public init(Int value = 0) {
        self.value = value;
    }

    public Bool is_valid() {
        return self.value >= 0;
    }

    public Int to_index() {
        return self.value;
    }

    public static Bool equal(SourceId& lhs, SourceId& rhs) {
        return lhs.value == rhs.value;
    }
}

public struct Span: Equatable {
    public Int start;
    public Int length;

    public init(Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end() {
        return self.start + self.length;
    }

    public Bool is_empty() {
        return self.length == 0;
    }

    public Bool empty() {
        return self.is_empty();
    }

    public Bool contains(Int offset) {
        return offset >= self.start && offset < self.end();
    }

    public Span join(Span other) {
        Int! joined_start = self.start;
        if (other.start < joined_start) {
            joined_start = other.start;
        }
        Int! joined_end = self.end();
        if (other.end() > joined_end) {
            joined_end = other.end();
        }
        return Span(joined_start, joined_end - joined_start);
    }

    public static Bool equal(Span& lhs, Span& rhs) {
        return lhs.start == rhs.start && lhs.length == rhs.length;
    }
}

public struct Source {
    public SourceId source_id;
    @life(bytes > self)
    public UInt8[]& bytes;

    public init(SourceId source_id, UInt8[]& bytes) {
        self.source_id = source_id;
        self.bytes = bytes;
    }

    public Int length() {
        return self.bytes.length;
    }

    public Span span() {
        return Span(0, self.bytes.length);
    }

    public Bool is_empty() {
        return self.bytes.length == 0;
    }
}
