// 源码位置基础结构。
//
// 这些类型面向 DSL、parser 和编译器源码共享使用，只描述稳定的 source/span
// 契约，不绑定编译器内部 source map 实现。

public struct SourceId: Copyable, Equatable {
    // Opaque source handle. Absence should be represented with SourceId?.
    public Int value;

    public init(self, Int value = 0) {
        self.value = value;
    }

    public Bool is_valid(self) {
        return self.value >= 0;
    }

    public Int to_index(self) {
        return self.value;
    }

    public Bool equal(SourceId& lhs, SourceId& rhs) {
        return lhs.value == rhs.value;
    }
}

public struct Span: Copyable, Equatable {
    public Int start;
    public Int length;

    public init(self, Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end(self) {
        return self.start + self.length;
    }

    public Bool is_empty(self) {
        return self.length == 0;
    }

    public Bool empty(self) {
        return self.is_empty();
    }

    public Bool contains(self, Int offset) {
        return offset >= self.start && offset < self.end();
    }

    public Span join(self, Span other) {
        Int joined_start! = self.start;
        if (other.start < joined_start) {
            joined_start = other.start;
        }
        Int joined_end! = self.end();
        if (other.end() > joined_end) {
            joined_end = other.end();
        }
        return Span(joined_start, joined_end - joined_start);
    }

    public Bool equal(Span& lhs, Span& rhs) {
        return lhs.start == rhs.start && lhs.length == rhs.length;
    }
}

@region(a)
public struct Source: Copyable {
    public SourceId source_id;

    @life(a)
    public UInt8[]& bytes;

    public init(self, SourceId source_id, UInt8[]& bytes) {
        self.source_id = source_id;
        self.bytes = bytes;
    }

    public Int length(self) {
        return self.bytes.length;
    }

    public Span span(self) {
        return Span(0, self.bytes.length);
    }

    public Bool is_empty(self) {
        return self.bytes.length == 0;
    }
}
