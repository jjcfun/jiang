import builder = "builder.jiang";
import source = "source.jiang";
import tree = "tree.jiang";

public trait Provider {
    static tree.NodeId parse(builder.Builder.Any& builder, Input input);
}

public struct Input {

    public source.Source source;
    
    public source.Span whole_span;
    
    public source.Span body_span;
    
    public tree.Root.Kind entry_kind;

    public init(
        source.Source source,
        source.Span whole_span,
        source.Span body_span,
        tree.Root.Kind entry_kind
    ) {
        self.source = source;
        self.whole_span = whole_span;
        self.body_span = body_span;
        self.entry_kind = entry_kind;
    }
}
