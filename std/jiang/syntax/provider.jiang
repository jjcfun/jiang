import builder = "builder.jiang";
import source = "source.jiang";
import tree = "tree.jiang";

public enum Delimiter {
    // The provider scans until the end of the source. This is used for
    // file-level DSL sources such as `main.foo`.
    none,

    // The provider scans a `{ ... }` invocation body.
    brace,

    // Reserved for future `#lang(self, ...)` style invocations.
    paren,

    // Reserved for future `#lang[...]` style invocations.
    bracket,
}

public struct ScanResult {

    public enum Status {
        ok,
        error,
    }

    public Status status;

    public source.Span body_span;

    public init(
        Status status,
        source.Span body_span
    ) {
        self.status = status;
        self.body_span = body_span;
    }

    public static ScanResult ok(source.Span body_span) {
        return ScanResult(.ok, body_span);
    }

    public static ScanResult error(source.Span body_span) {
        return ScanResult(.error, body_span);
    }
}

public trait Provider {
    // Scans the provider-owned source range and may cache private tokens on
    // `self`. A successful scan defines the body/full spans and the byte offset
    // where the host parser should resume.
    ScanResult scan(self, Input input, builder.Builder.Any& builder);

    // Returns the root node built into `builder`.
    //
    // The caller owns the backing syntax store through `builder`. Provider
    // implementations should consume state prepared by `scan`, rather than
    // forcing the host to understand provider-specific token structures.
    tree.NodeId parse(self, Input input, tree.Root.Kind entry_kind, builder.Builder.Any& builder);
}

public struct Input {

    public source.Source source;

    public source.Span name_span;

    // Provider body 起始位置。带 delimiter 的调用从起始 delimiter 开始；
    // `.none` 调用从 provider source body 的第一个字节开始。
    public Int body_start;

    public Delimiter delimiter;

    public init(
        source.Source source,
        source.Span name_span,
        Int body_start,
        Delimiter delimiter
    ) {
        self.source = source;
        self.name_span = name_span;
        self.body_start = body_start;
        self.delimiter = delimiter;
    }
}
