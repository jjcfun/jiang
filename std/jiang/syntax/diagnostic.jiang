import source = "source.jiang";

@region(a)
public struct Diagnostic: Copyable {
    public enum Severity: Copyable {
        note,
        warning,
        error,
    }

    public Severity severity;

    public source.Span span;

    @life(a)
    public UInt8[]& code;

    @life(a)
    public UInt8[]& message;

    public init(self,
        Severity severity,
        source.Span span,
        UInt8[]& code,
        UInt8[]& message
    ) {
        self.severity = severity;
        self.span = span;
        self.code = code;
        self.message = message;
    }

    @life(return: code & message)
    public Diagnostic note(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.note, span, code, message);
    }

    @life(return: code & message)
    public Diagnostic warning(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.warning, span, code, message);
    }

    @life(return: code & message)
    public Diagnostic error(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.error, span, code, message);
    }
}
