import source = "source.jiang";

public struct Diagnostic {
    public enum Severity {
        note,
        warning,
        error,
    }

    public Severity severity;

    public source.Span span;

    @life(code > self)
    public UInt8[]& code;

    @life(message > self)
    public UInt8[]& message;

    public init(self,
        Severity severity,
        source.Span span,
        UInt8[]& code,
        UInt8[]& message
    ) {
        self.severity = severity;
        self.span = span;
        self.code = code;
        self.message = message;
    }

    public static Diagnostic note(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.note, span, code, message);
    }

    public static Diagnostic warning(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.warning, span, code, message);
    }

    public static Diagnostic error(source.Span span, UInt8[]& code, UInt8[]& message) {
        return Diagnostic(.error, span, code, message);
    }
}
