    Int add_node(
        Self&! self,
        Int operation,
        source.Span span,
        Int first,
        Int second,
        Int third,
        UInt8[]& text
    ) {
        Int[3] arguments = [first, second, third];
        return self.add_node_arguments(operation, span, arguments[..], text);
    }

    Int add_node_arguments(
        Self&! self,
        Int operation,
        source.Span span,
        Int[]& arguments,
        UInt8[]& text
    ) {
        return abi.add_node(self.context, operation, span, arguments, text);
    }

    Int mark_children(self) {
        return abi.mark_children(self.context);
    }

    Void add_child(Self&! self, Int node_identity) {
        abi.add_child(self.context, node_identity);
    }

    Int add_expr_children(Self&! self, Expr[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Expr value = values[index];
            self.require_handle(value.context_identity, value.node_identity);
            self.add_child(value.node_identity);
            index = index + 1;
        }
        return start;
    }

