public enum Expansion: Copyable {
    expression(Expr),
    statement(Stmt),
    declarations(DeclarationList),
    type_syntax(TypeSyntax),
    pattern(SyntaxPattern),
}

public Bool finish_expansion(
    SyntaxContext& syntax,
    Expansion expansion!,
    ExpansionKind expected
) {
    return switch expansion {
        .expression(node) => finish_one(syntax, expected, .expression, node.context_identity, node.node_identity),
        .statement(node) => finish_one(syntax, expected, .statement, node.context_identity, node.node_identity),
        .type_syntax(node) => finish_one(
            syntax, expected, .type_syntax, node.context_identity, node.node_identity
        ),
        .pattern(node) => finish_one(syntax, expected, .pattern, node.context_identity, node.node_identity),
        .declarations(nodes) => finish_declarations(syntax, expected, nodes),
    };
}

Bool finish_one(
    SyntaxContext& syntax,
    ExpansionKind expected,
    ExpansionKind actual,
    Void* context_identity,
    Int node_identity
) {
    assert(context_identity == abi.identity(syntax));
    assert(node_identity >= 0);
    return abi.finish(syntax, expected, actual, node_identity, 1);
}

Bool finish_declarations(
    SyntaxContext& syntax,
    ExpansionKind expected,
    DeclarationList nodes
) {
    assert(nodes.context_identity == abi.identity(syntax));
    return abi.finish(syntax, expected, .declarations, nodes.children_start, nodes.length);
}

// Parser 同时是 typed syntax factory；所有节点必须归属当前 parse invocation。
public extend <K: Copyable & Equatable> Parser<K> {
    public Expr name(Self&! self, source.Span span, UInt8[]& name) {
        return Expr(self.identity(), self.add_node(0, span, -1, -1, -1, name));
    }

    public SyntaxName identifier(Self&! self, source.Span span, UInt8[]& text) {
        return SyntaxName(self.identity(), self.add_node(39, span, -1, -1, -1, text));
    }

    public SyntaxPath path(Self&! self, source.Span span, SyntaxName[]& segments) {
        assert(segments.length > 0);
        Int start = self.add_name_children(segments);
        Int[2] arguments = [start, segments.length];
        return SyntaxPath(self.identity(), self.add_node_arguments(40, span, arguments[..], ""));
    }

    public Expr path_expression(Self&! self, source.Span span, SyntaxPath path) {
        self.require_handle(path.context_identity, path.node_identity);
        Int[1] arguments = [path.node_identity];
        return Expr(self.identity(), self.add_node_arguments(41, span, arguments[..], ""));
    }

    public Expr int_literal(Self&! self, source.Span span, UInt8[]& text) {
        return Expr(self.identity(), self.add_node(1, span, -1, -1, -1, text));
    }

    public GenericArgument type_argument(
        Self&! self,
        source.Span span,
        TypeSyntax value,
        SyntaxName? contract_name = null
    ) {
        self.require_handle(value.context_identity, value.node_identity);
        return GenericArgument(
            self.identity(),
            value.node_identity,
            self.optional_name(contract_name),
            span
        );
    }

    public GenericArgument value_argument(
        Self&! self,
        source.Span span,
        Expr value,
        SyntaxName? contract_name = null
    ) {
        self.require_handle(value.context_identity, value.node_identity);
        return GenericArgument(
            self.identity(),
            value.node_identity,
            self.optional_name(contract_name),
            span
        );
    }

    public GenericArgument associated_type_argument(
        Self&! self,
        source.Span span,
        SyntaxName name,
        TypeSyntax value
    ) {
        self.require_handle(name.context_identity, name.node_identity);
        self.require_handle(value.context_identity, value.node_identity);
        Int[2] arguments = [name.node_identity, value.node_identity];
        Int node_identity = self.add_node_arguments(77, span, arguments[..], "");
        return GenericArgument(self.identity(), node_identity, -1, span);
    }

    public GenericParameter generic_parameter(
        Self&! self,
        source.Span span,
        SyntaxName name,
        TypeBound? bound = null
    ) {
        self.require_handle(name.context_identity, name.node_identity);
        Int[4] arguments = [name.node_identity, -1, self.optional_type_bound(bound), 0];
        return GenericParameter(self.identity(), self.add_node_arguments(75, span, arguments[..], ""));
    }

    public GenericParameter const_generic_parameter(
        Self&! self,
        source.Span span,
        SyntaxName name,
        TypeSyntax type_syntax
    ) {
        self.require_handle(name.context_identity, name.node_identity);
        self.require_handle(type_syntax.context_identity, type_syntax.node_identity);
        Int[4] arguments = [name.node_identity, type_syntax.node_identity, -1, 1];
        return GenericParameter(self.identity(), self.add_node_arguments(75, span, arguments[..], ""));
    }

    public GenericParameters generic_parameters(
        Self&! self,
        source.Span span,
        GenericParameter[]& parameters
    ) {
        Int start = self.add_generic_parameter_children(parameters);
        Int[2] arguments = [start, parameters.length];
        return GenericParameters(self.identity(), self.add_node_arguments(76, span, arguments[..], ""));
    }

    public TypeBound trait_bound(
        Self&! self,
        source.Span span,
        SyntaxPath path,
        Bool negative = false
    ) {
        GenericArgument[0] arguments = [];
        return self.trait_bound(span, path, arguments[..], negative);
    }

    public TypeBound trait_bound(
        Self&! self,
        source.Span span,
        SyntaxPath path,
        GenericArgument[]& values,
        Bool negative = false
    ) {
        self.require_handle(path.context_identity, path.node_identity);
        self.require_no_contract_names(values);
        Int start = self.add_generic_argument_children(values);
        Int[4] arguments = [path.node_identity, start, values.length, bool_int(negative)];
        return TypeBound(self.identity(), self.add_node_arguments(78, span, arguments[..], ""));
    }

    public TypeBound type_bound_intersection(
        Self&! self,
        source.Span span,
        TypeBound left,
        TypeBound right
    ) {
        self.require_handle(left.context_identity, left.node_identity);
        self.require_handle(right.context_identity, right.node_identity);
        Int[2] arguments = [left.node_identity, right.node_identity];
        return TypeBound(self.identity(), self.add_node_arguments(79, span, arguments[..], ""));
    }

    public SyntaxAnnotation where_const(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        TypeSyntax type_syntax
    ) {
        self.require_handle(parameter.context_identity, parameter.node_identity);
        self.require_handle(type_syntax.context_identity, type_syntax.node_identity);
        Int[2] arguments = [parameter.node_identity, type_syntax.node_identity];
        return SyntaxAnnotation(self.identity(), self.add_node_arguments(94, span, arguments[..], ""));
    }

    public SyntaxAnnotation where_type_bound(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        TypeBound bound
    ) {
        self.require_handle(parameter.context_identity, parameter.node_identity);
        self.require_handle(bound.context_identity, bound.node_identity);
        Int[2] arguments = [parameter.node_identity, bound.node_identity];
        return SyntaxAnnotation(self.identity(), self.add_node_arguments(95, span, arguments[..], ""));
    }

    public SyntaxAnnotation where_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        TypeSyntax value
    ) {
        return self.add_where_equal(span, parameter, value.context_identity, value.node_identity, false);
    }

    public SyntaxAnnotation where_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        Expr value
    ) {
        return self.add_where_equal(span, parameter, value.context_identity, value.node_identity, false);
    }

    public SyntaxAnnotation where_not_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        TypeSyntax value
    ) {
        return self.add_where_equal(span, parameter, value.context_identity, value.node_identity, true);
    }

    public SyntaxAnnotation where_not_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        Expr value
    ) {
        return self.add_where_equal(span, parameter, value.context_identity, value.node_identity, true);
    }

    SyntaxAnnotation add_where_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        Void* value_context,
        Int value,
        Bool negative
    ) {
        self.require_handle(parameter.context_identity, parameter.node_identity);
        self.require_handle(value_context, value);
        Int[2] arguments = [parameter.node_identity, value];
        Int operation! = 96;
        if (negative) { operation = 97; }
        return SyntaxAnnotation(self.identity(), self.add_node_arguments(operation, span, arguments[..], ""));
    }

    public SyntaxAnnotation where_projection_equal(
        Self&! self,
        source.Span span,
        SyntaxName parameter,
        SyntaxPath trait_path,
        SyntaxName associated_name,
        TypeSyntax value
    ) {
