    Decl add_generic_nominal_declaration(
        Self&! self,
        source.Span span,
        SyntaxName name,
        GenericParameters? generics,
        TypeSyntax? underlying_type,
        TypeBound[]& traits,
        SyntaxMember[]& members,
        Bool public_flag,
        Bool packed,
        Int align,
        Bool enum_flag
    ) {
        assert(align >= 0);
        self.require_handle(name.context_identity, name.node_identity);
        Int trait_start = self.add_type_bound_children(traits);
        Int member_start = self.add_member_children(members);
        Int[11] arguments = [
            bool_int(enum_flag),
            name.node_identity,
            self.optional_generic_parameters(generics),
            self.optional_type(underlying_type),
            trait_start,
            traits.length,
            member_start,
            members.length,
            bool_int(public_flag),
            bool_int(packed),
            align,
        ];
        return Decl(self.identity(), self.add_node_arguments(80, span, arguments[..], ""));
    }

    Decl add_nominal_declaration(
