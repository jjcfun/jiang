    Expr add_call_arguments(
        Self&! self,
        source.Span span,
        Expr callee,
        Int type_start,
        Int type_length,
        Argument[]& arguments
    ) {
        Int argument_start = self.mark_children();
        Int index! = 0;
        while (index < arguments.length) {
            Argument argument = arguments[index];
            self.require_handle(argument.context_identity, argument.node_identity);
            self.add_child(argument.node_identity);
            index = index + 1;
        }
        Int[5] factory_arguments = [
            callee.node_identity,
            type_start,
            type_length,
            argument_start,
            arguments.length,
        ];
        return Expr(
            self.identity(),
            self.add_node_arguments(3, span, factory_arguments[..], "")
        );
    }

