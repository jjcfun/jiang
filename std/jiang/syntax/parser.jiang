    Int add_contract_name_children(Self&! self, GenericArgument[]& values) {
        Int start = self.mark_children();
        if (!self.generic_arguments_have_contract_names(values)) { return start; }
        Int index! = 0;
        while (index < values.length) {
            GenericArgument value = values[index];
            Int name_identity! = value.contract_name_identity;
            if (name_identity < 0) {
                name_identity = self.add_node(72, value.span, -1, -1, -1, "");
            }
            self.add_child(name_identity);
            index = index + 1;
        }
        return start;
    }

    Bool generic_arguments_have_contract_names(self, GenericArgument[]& values) {
        Int index! = 0;
        while (index < values.length) {
            if (values[index].contract_name_identity >= 0) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void require_no_contract_names(self, GenericArgument[]& values) {
        assert(!self.generic_arguments_have_contract_names(values));
    }

    Int add_pattern_children(Self&! self, SyntaxPattern[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            SyntaxPattern value = values[index];
            self.require_handle(value.context_identity, value.node_identity);
            self.add_child(value.node_identity);
            index = index + 1;
        }
        return start;
    }

    Int add_parameter_children(Self&! self, Parameter[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Parameter value = values[index];
            self.require_handle(value.context_identity, value.node_identity);
            self.add_child(value.node_identity);
            index = index + 1;
        }
        return start;
    }

    Int optional_expr(Self&! self, Expr? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_name(Self&! self, SyntaxName? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_type(Self&! self, TypeSyntax? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_generic_parameters(Self&! self, GenericParameters? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_type_bound(Self&! self, TypeBound? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_pattern(Self&! self, SyntaxPattern? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Int optional_decl(Self&! self, Decl? value) {
        guard value is .some(actual) else { return -1; }
        self.require_handle(actual.context_identity, actual.node_identity);
        return actual.node_identity;
    }

    Void require_handle(Self& self, Void* context_identity, Int node_identity) {
        self.require_context(context_identity);
        assert(node_identity >= 0);
    }

    Void require_context(Self& self, Void* context_identity) {
        assert(context_identity == self.identity());
    }

    Void* identity(Self& self) {
        return abi.identity(self.context);
    }

}

Int bool_int(Bool value) {
    if (value) { return 1; }
    return 0;
}

Int declaration_flags(Bool public_flag, Bool unsafe_flag, SyntaxExternKind extern_kind) {
    return bool_int(public_flag) | (bool_int(unsafe_flag) << 1) | (Int(extern_kind) << 2);
}
