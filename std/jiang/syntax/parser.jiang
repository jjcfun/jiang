        Bool packed,
        Int align,
        Bool enum_flag
    ) {
        assert(align >= 0);
        self.require_handle(name.context_identity, name.node_identity);
        Int start = self.add_member_children(members);
        Int[8] arguments = [
            bool_int(enum_flag),
            name.node_identity,
            self.optional_type(underlying_type),
            start,
            members.length,
            bool_int(public_flag),
            bool_int(packed),
            align,
        ];
        return Decl(self.identity(), self.add_node_arguments(66, span, arguments[..], ""));
    }

