// Parser<K> 是自定义语法的通用 token cursor。
// 本阶段只固定静态 cursor 与 span 行为；诊断和 typed factory 随 SyntaxContext 接入。

import context = "context.jiang";
import * = "context.jiang";
import abi = "abi.jiang";
import vector = "../../collection/vector.jiang";
import source = "source.jiang";
import token = "token.jiang";

@region(c, s, k: K)
@where(K: Copyable & Equatable)
public struct Parser<K>: Movable {
    @life(c)
    context.SyntaxContext& context;

    @life(s)
    source.Source source;

    @life(k)
    vector.Vector<token.Token<K>> tokens!;

    @life(k)
    K eof_kind;

    Int current!;

    public init(
        self,
        context.SyntaxContext& context,
        source.Source source,
        vector.Vector<token.Token<K>> tokens,
        K eof_kind
    ) {
        assert(tokens.length() > 0, "Parser requires an EOF token");
        assert(tokens[tokens.length() - 1].kind == eof_kind, "Parser EOF token kind mismatch");
        self.context = context;
        self.source = source;
        self.tokens = tokens;
        self.eof_kind = eof_kind;
        self.current = 0;
    }

    public Bool at(self, K kind) {
        return self.current_token().kind == kind;
    }

    public Bool match(Self&! self, K kind) {
        if (!self.at(kind)) { return false; }
        self.advance();
        return true;
    }

    @life(return.k: self & self.k & kind)
    public token.Token<K> expect(Self&! self, K kind) {
        if (self.at(kind)) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_token, span, "");
        return token.Token<K>.missing(kind, span);
    }

    @life(return.k: self & self.k & kind)
    public token.Token<K> expect(Self&! self, K kind, UInt8[]& message) {
        if (self.at(kind)) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_token, span, message);
        return token.Token<K>.missing(kind, span);
    }

    @life(return.k: self & self.k)
    public token.Token<K> advance(Self&! self) {
        token.Token<K> value = self.current_token();
        if (value.kind != self.eof_kind) {
            self.current = self.current + 1;
        }
        return value;
    }

    @life(return.k: self & self.k)
    public token.Token<K> current_token(self) {
        assert(self.current >= 0 && self.current < self.tokens.length());
        return self.tokens[self.current];
    }

    @life(return.k: self & self.k)
    public token.Token<K> previous_token(self) {
        assert(self.current > 0);
        return self.tokens[self.current - 1];
    }

    public Bool at_end(self) {
        return self.at(self.eof_kind);
    }

    public Void recover_until(Self&! self, K[]& kinds) {
        while (!self.at_end() && !contains_kind<K>(kinds, self.current_token().kind)) {
            self.advance();
        }
    }

    public Void error(Self&! self, source.Span span) {
        abi.add_diagnostic(self.context, .syntax_error, span, "");
    }

    public Void error(Self&! self, source.Span span, UInt8[]& message) {
        abi.add_diagnostic(self.context, .syntax_error, span, message);
    }

    public source.Span insertion_span(self) {
        return source.Span(self.current_token().span.start, 0);
    }

    public source.Span span_from(self, token.Token<K> start) {
        Int end! = self.current_token().span.start;
        if (self.current > 0) {
            end = self.previous_token().span.end();
        }
        assert(start.span.start <= end);
        return source.Span(start.span.start, end - start.span.start);
    }

    @life(return: self.s)
    public UInt8[]& token_text(self, token.Token<K> value) {
        assert(value.span.start >= 0 && value.span.end() <= self.source.length());
        return self.source.bytes[value.span.start..value.span.end()];
    }

}

@life(return.c: syntax, return.s: input)
public Parser<token.TokenKind> default_parser(
    context.SyntaxContext& syntax,
    context.Input input
) {
    vector.Vector<token.Token<token.TokenKind>> tokens! = abi.take_default_tokens(syntax);
    return Parser<token.TokenKind>(syntax, input.source, tokens$.move(), .eof());
}

@where(K: Copyable & Equatable)
Bool contains_kind<K>(K[]& kinds, K expected) {
    Int index! = 0;
    while (index < kinds.length) {
        if (kinds[index] == expected) { return true; }
        index = index + 1;
    }
    return false;
}

// 默认 Jiang token helper 只解释 TokenKind；custom K 仍使用上面的通用 cursor API。
public extend Parser<token.TokenKind> {
    public Expr parse_expression(Self&! self) {
        return Expr(self.identity(), self.parse_fragment(.expression));
    }

    public Stmt parse_statement(Self&! self) {
        return Stmt(self.identity(), self.parse_fragment(.statement));
    }

    public TypeSyntax parse_type(Self&! self) {
        return TypeSyntax(self.identity(), self.parse_fragment(.type_syntax));
    }

    public SyntaxPattern parse_pattern(Self&! self) {
        return SyntaxPattern(self.identity(), self.parse_fragment(.pattern));
    }

    public Decl parse_declaration(Self&! self) {
        return Decl(self.identity(), self.parse_fragment(.declarations));
    }

    public token.Token<token.TokenKind> expect_identifier(Self&! self) {
        if (self.current_token().kind.is_identifier()) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_identifier, span, "");
        return token.missing_token(.error(), span);
    }

    public token.Token<token.TokenKind> expect_literal(Self&! self) {
        if (self.current_token().kind.is_literal()) { return self.advance(); }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_literal, span, "");
        return token.missing_token(.error(), span);
    }

    public token.Token<token.TokenKind> expect_keyword(Self&! self, UInt8[]& keyword) {
        token.Token<token.TokenKind> current = self.current_token();
        if (current.kind is .ident && bytes_equal(self.token_text(current), keyword)) {
            return self.advance();
        }
        source.Span span = self.insertion_span();
        abi.add_diagnostic(self.context, .expected_keyword, span, "");
        return token.missing_token(.error(), span);
    }

    public Void synchronize(Self&! self, token.TokenKind[]& boundaries) {
        while (!self.at_end() && !contains_token_case(boundaries, self.current_token().kind)) {
            self.advance();
        }
    }

    Int parse_fragment(Self&! self, abi.ExpansionKind kind) {
        token.Token<token.TokenKind>[]& values = self.tokens.slice();
        Int start = self.current;
        Int next! = self.current;
        Int node_identity = abi.parse_fragment(
            self.context,
            kind,
            self.source,
            values,
            next$.mut_ref()
        );
        self.current = next;
        assert(self.current >= start && self.current < self.tokens.length());
        assert(node_identity >= 0, "Jiang fragment parser did not produce requested syntax");
        return node_identity;
    }
}

Bool contains_token_case(token.TokenKind[]& kinds, token.TokenKind expected) {
    Int index! = 0;
    while (index < kinds.length) {
        if (kinds[index].same_case(expected)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

public enum LiteralKind: Copyable {
    int_literal,
    float_literal,
    char_literal,
    string_literal,
    bool_literal,
    null_literal,
}

public enum UnaryOperator: Copyable {
    negative,
    logical_not,
    bit_not,
    address_of,
    dereference,
    new_value,
}

public enum BinaryOperator: Copyable {
    add,
    subtract,
    multiply,
    divide,
    remainder,
    bit_and,
    bit_or,
    bit_xor,
    logical_and,
    logical_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public enum AssignmentOperator: Copyable {
    assign,
    add,
    subtract,
    multiply,
    divide,
    remainder,
    bit_and,
    bit_or,
    bit_xor,
    shift_left,
    shift_right,
}

public enum ControlStatementKind: Copyable {
    return_value,
    break_loop,
    continue_loop,
    throw_value,
}

public enum TypeLayer: Copyable {
    optional,
    mutable_type,
    reference,
    owner_pointer,
    raw_pointer,
    slice,
}

public enum SyntaxExternKind: Copyable {
    none,
    native,
    c_abi,
    builtin,
}

