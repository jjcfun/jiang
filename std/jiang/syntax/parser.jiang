    public ExternItem extern_function(
        Self&! self,
        source.Span span,
        SyntaxName name,
        GenericParameters? generics,
        Parameter[]& parameters,
        TypeSyntax result_type,
        Bool public_flag = false,
        Bool unsafe_flag = false,
        Bool async_flag = false,
        Expr? domain = null,
        Expr? async_context = null
    ) {
        self.require_handle(name.context_identity, name.node_identity);
        self.require_handle(result_type.context_identity, result_type.node_identity);
        Int start = self.add_parameter_children(parameters);
        Int[10] arguments = [
            name.node_identity,
            self.optional_generic_parameters(generics),
            result_type.node_identity,
            start,
            parameters.length,
            bool_int(public_flag),
            bool_int(unsafe_flag),
            bool_int(async_flag),
            self.optional_expr(domain),
            self.optional_expr(async_context),
        ];
        return ExternItem(self.identity(), self.add_node_arguments(88, span, arguments[..], ""));
    }

