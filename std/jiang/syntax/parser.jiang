    public Expr call(
        Self&! self,
        source.Span span,
        Expr callee,
        GenericArgument[]& type_arguments,
        Argument[]& arguments
    ) {
        self.require_no_contract_names(type_arguments);
        self.require_handle(callee.context_identity, callee.node_identity);
        Int type_start = self.add_generic_argument_children(type_arguments);
        return self.add_call_arguments(
            span,
            callee,
            type_start,
            type_arguments.length,
            arguments
