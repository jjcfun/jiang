        Int parameter_start = self.add_lambda_parameter_children(parameters);
        Int capture_start = self.add_lambda_capture_children(captures);
        Int[5] arguments = [
            parameter_start,
            parameters.length,
            capture_start,
            captures.length,
            body.node_identity,
        ];
        return Expr(self.identity(), self.add_node_arguments(57, span, arguments[..], ""));
    }

