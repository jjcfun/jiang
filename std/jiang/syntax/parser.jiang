    SyntaxMember add_associated_type(
        Self&! self,
        source.Span span,
        Int name,
        Int value,
        Int const_value,
        Bool is_const,
        Int type_ref,
        Int constraint_start,
        Int constraint_length,
        Bool member,
        Bool public_flag
    ) {
        Int[9] arguments = [
            name, value, const_value, bool_int(is_const), type_ref,
            constraint_start, constraint_length, bool_int(member), bool_int(public_flag),
        ];
        return SyntaxMember(self.identity(), self.add_node_arguments(85, span, arguments[..], ""));
    }

    public DeclarationList declaration_list(Self&! self, Decl[]& values) {
        Int start = self.mark_children();
        Int index! = 0;
        while (index < values.length) {
            Decl value = values[index];
            self.require_handle(value.context_identity, value.node_identity);
            self.add_child(value.node_identity);
            index = index + 1;
        }
        return DeclarationList(self.identity(), start, values.length);
    }

