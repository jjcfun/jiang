    TypeSyntax add_function_type(
        Self&! self,
        source.Span span,
        TypeSyntax[]& parameters,
        TypeSyntax result,
        Bool unsafe_flag,
        Bool async_flag,
        Expr? domain,
        Expr? async_context
    ) {
        self.require_handle(result.context_identity, result.node_identity);
        Int start = self.add_type_children(parameters);
        Int[7] arguments = [
            start,
            parameters.length,
