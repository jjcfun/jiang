// Public Jiang syntax tree for lang providers.
//
// This tree is the construction target for DSL parsers. It describes syntax
// that Jiang can parse and type-check, not HIR, MIR, backend IR, or a
// language-neutral tree.

import source = "source.jiang";
import symbol = "symbol.jiang";

public struct NodeId: Copyable, Equatable {
    public Int index;

    public init(self, Int index) {
        assert(index >= 0);
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public NodeId from_index(Int index) {
        return NodeId(index);
    }

    public Bool equal(NodeId& lhs, NodeId& rhs) {
        return lhs.index == rhs.index;
    }
}

public struct Range: Copyable {
    public Int start;
    public Int length;

    public init(self, Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end(self) {
        return self.start + self.length;
    }

    public Bool is_empty(self) {
        return self.length == 0;
    }
}

public struct Name: Copyable {
    public symbol.SymbolId symbol;
    public Bool escaped;

    public init(self, symbol.SymbolId symbol, Bool escaped = false) {
        self.symbol = symbol;
        self.escaped = escaped;
    }
}

@region(a)
public struct Tree: Copyable {
    @life(a)
    public source.Source source;

    @life(a)
    public Node[]& nodes;

    @life(a)
    public NodeId[]& children;
    public NodeId root;

    public init(self, source.Source source, Node[]& nodes, NodeId[]& children, NodeId root) {
        self.source = source;
        self.nodes = nodes;
        self.children = children;
        self.root = root;
    }

    public Bool is_empty(self) {
        return self.nodes.length == 0;
    }

    public Node& node(self, NodeId id) {
        return self.nodes[id.to_index()]$.ref();
    }

    public NodeId child_at(self, Range range, Int offset) {
        return self.children[range.start + offset];
    }
}

public struct Node: Copyable {
    public source.Span span;
    public Data data;

    public init(self, source.Span span, Data data) {
        self.span = span;
        self.data = data;
    }
}

public enum Data: Copyable {
    root(Root),
    top_level_declaration(TopLevelDeclaration),
    member_declaration(MemberDeclaration),
    item(Item),
    member(Member),
    path(Path),
    statement(Statement),
    expression(Expression),
    type_reference(TypeReference),
    pattern(Pattern),
    generic_parameter(GenericParameter),
    constraint(Constraint),
    attribute(Attribute),
    path_segment(PathSegment),
    function_parameter(FunctionParameter),
    field_declarator(FieldDeclarator),
    extern_item(ExternItem),
    switch_case(SwitchCase),
    catch_clause(CatchClause),
    call_argument(CallArgument),
    field_initializer(FieldInitializer),
    inline_asm_operand(InlineAsmExpression.Operand),
    inline_asm_clobber(InlineAsmExpression.Clobber),
}

public struct Root: Copyable {
    public enum Kind: Copyable {
        file,
        top_level_declaration,
        member_declaration,
        statement,
        expression,
        type_reference,
        pattern,
    }

    public Kind kind;
    public Range nodes;

    public init(self, Kind kind, Range nodes) {
        self.kind = kind;
        self.nodes = nodes;
    }
}

public enum Item: Copyable {
    import_declaration(ImportDeclaration),
    alias_declaration(AliasDeclaration),
    nominal_declaration(NominalDeclaration),
    function_declaration(FunctionDeclaration),
    global_declaration(GlobalDeclaration),
    global_destructure_declaration(GlobalDestructureDeclaration),
    extend_declaration(ExtendDeclaration),
    trait_declaration(TraitDeclaration),
    extern_block(ExternBlock),
}

public enum Member: Copyable {
    field_declaration(FieldDeclaration),
    enum_case(EnumCase),
    function_declaration(FunctionDeclaration),
    initializer_declaration(InitializerDeclaration),
    deinitializer_declaration(DeinitializerDeclaration),
    associated_type_declaration(AssociatedTypeDeclaration),
    nominal_declaration(NominalDeclaration),
    alias_declaration(AliasDeclaration),
}

public struct TopLevelDeclaration: Copyable {
    public DeclarationModifiers modifiers;
    public Range attributes;
    public NodeId body;
}

public enum ExternKind {
    none,
    native,
    c_abi,
    builtin,
}

public struct DeclarationModifiers: Copyable {
    public Bool public_flag;
    public ExternKind extern_kind;
    public Bool unsafe_flag = false;
}

public struct MemberDeclaration: Copyable {
    public MemberModifiers modifiers;
    public Range attributes;
    public NodeId body;
}

public struct MemberModifiers: Copyable {
    public MemberVisibility visibility;
    public Bool static_flag;
}

public enum MemberVisibility: Copyable {
    private_visibility,
    public_visibility(PublicAccess);

    public enum PublicAccess: Copyable {
        all,
    }
}

public struct ImportDeclaration: Copyable {
    public enum Kind: Copyable {
        string_path,
        package_name,
    }

    public Kind kind;
    public Bool flatten;
    public NodeId? alias_name;
    public NodeId path;
}

public struct AliasDeclaration: Copyable {
    public Name name;
    public NodeId? target;
}

public struct NominalDeclaration: Copyable {
    public enum Kind: Copyable {
        struct_kind,
        enum_kind,
    }

    public Kind kind;
    public Name name;
    public Range generic_parameters;
    public NodeId? enum_underlying_type;
    public Bool has_payload_variants = false;
    public LayoutOptions layout_options;
    public Range traits;
    public Range members;
}

public struct LayoutOptions: Copyable {
    public Bool packed;
    public Int align;

    public init(self, Bool packed = false, Int align = 0) {
        self.packed = packed;
        self.align = align;
    }
}

public struct FunctionDeclaration: Copyable {
    public Name name;
    public Range generic_parameters;
    public Range parameters;
    public NodeId result_type;
    public NodeId? body;
}

public struct FunctionParameter: Copyable {
    public Name name;
    public NodeId type_reference;
    public NodeId? default_value;
}

public struct GlobalDeclaration: Copyable {
    public Name name;
    public NodeId type_reference;
    public Bool is_const;
    public NodeId? initializer;
}

public struct GlobalDestructureDeclaration: Copyable {
    public NodeId pattern;
    public NodeId initializer;
}

public struct ExtendDeclaration: Copyable {
    public Range generic_parameters;
    public NodeId target_type;
    public NodeId? trait_path;
    public Range members;
}

public struct TraitDeclaration: Copyable {
    public Name name;
    public Range generic_parameters;
    public Range parents;
    public Bool has_body;
    public Range members;
}

public struct FieldDeclaration: Copyable {
    public NodeId type_reference;
    public Range declarators;
}

public struct FieldDeclarator: Copyable {
    public Name name;
    public NodeId? default_value;
}

public struct EnumCase: Copyable {
    public Name name;
    public NodeId? value;
    public NodeId? payload_type = null;
}

public struct InitializerDeclaration: Copyable {
    public Bool failable;
    public Name? name;
    public Range parameters;
    public NodeId body;
}

public struct DeinitializerDeclaration: Copyable {
    public NodeId body;
}

public struct AssociatedTypeDeclaration: Copyable {
    public Name name;
    public NodeId? default_type;
    public NodeId? default_value;
    public Bool is_const;
    public NodeId? type_reference;
    public Range constraints;
}

public struct ExternBlock: Copyable {
    public Range items;
}

public struct ExternItem: Copyable {
    public MemberModifiers modifiers;
    public NodeId body;
}

public struct Path: Copyable {
    public Range segments;
}

public enum Statement: Copyable {
    let_statement(LetStatement),
    destructure_statement(DestructureStatement),
    assignment_statement(AssignmentStatement),
    defer_statement(DeferStatement),
    expression_statement(ExpressionStatement),
    control_statement(ControlStatement),
    guard_statement(GuardStatement),
}

public struct LetStatement: Copyable {
    public NodeId? type_reference;
    public Name name;
    public NodeId? initializer;
    public Bool mutable_binding;
}

public struct DestructureStatement: Copyable {
    public NodeId pattern;
    public NodeId initializer;
}

public struct AssignmentStatement: Copyable {
    public enum Operator: Copyable {
        assign,
        plus_assign,
        minus_assign,
        star_assign,
        slash_assign,
        percent_assign,
        amp_assign,
        pipe_assign,
        caret_assign,
        left_shift_assign,
        right_shift_assign,
    }

    public Operator op;
    public NodeId destination;
    public NodeId value;
}

public struct DeferStatement: Copyable {
    public NodeId body;
}

public struct ExpressionStatement: Copyable {
    public NodeId expression;
}

public struct ControlStatement: Copyable {
    public enum Kind: Copyable {
        return_kind,
        break_kind,
        continue_kind,
        throw_kind,
    }

    public Kind kind;
    public NodeId? value;
}

public struct GuardStatement: Copyable {
    public NodeId condition;
    public NodeId else_body;
}

public enum Expression: Copyable {
    name(NameExpression),
    path(PathExpression),
    literal(LiteralExpression),
    tuple(TupleExpression),
    array(ArrayExpression),
    struct_literal(StructLiteralExpression),
    call(CallExpression),
    member(MemberExpression),
    index(IndexExpression),
    slice(SliceExpression),
    unary(UnaryExpression),
    binary(BinaryExpression),
    range(RangeExpression),
    is_pattern(IsPatternExpression),
    cast(CastExpression),
    inline_asm(InlineAsmExpression),
    block(BlockExpression),
    if_expression(IfExpression),
    loop(LoopExpression),
    switch_expression(SwitchExpression),
    catch_expression(CatchExpression),
}

public struct NameExpression: Copyable {
    public Name name;
}

public struct PathExpression: Copyable {
    public NodeId path;
}

public struct LiteralExpression: Copyable {
    public Literal literal;
}

public struct TupleExpression: Copyable {
    public Range elements;
}

public struct ArrayExpression: Copyable {
    public Range elements;
}

public struct StructLiteralExpression: Copyable {
    public NodeId? type_reference;
    public Range type_arguments;
    public Range fields;
}

public struct CallExpression: Copyable {
    public NodeId callee;
    public Range type_arguments;
    public Range arguments;
}

public struct CallArgument: Copyable {
    public Name? name;
    public NodeId value;
}

public struct MemberExpression: Copyable {
    public NodeId base;
    public Name member;
    public Bool optional_chain;
}

public struct IndexExpression: Copyable {
    public NodeId base;
    public NodeId index;
    public Bool optional_chain;
}

public struct SliceExpression: Copyable {
    public NodeId base;
    public NodeId? start;
    public NodeId? end;
    public Bool optional_chain;
}

public struct UnaryExpression: Copyable {
    public enum Operator: Copyable {
        positive,
        negative,
        bit_not,
        logical_not,
        ref,
        mutable_ref,
        deref,
        move_value,
    }

    public Operator op;
    public NodeId value;
}

public struct BinaryExpression: Copyable {
    public enum Operator: Copyable {
        add,
        subtract,
        multiply,
        divide,
        remainder,
        bit_and,
        bit_or,
        bit_xor,
        left_shift,
        right_shift,
        equal,
        not_equal,
        less,
        less_equal,
        greater,
        greater_equal,
        logical_and,
        logical_or,
        coalesce,
    }

    public Operator op;
    public NodeId left;
    public NodeId right;
}

public struct RangeExpression: Copyable {
    public NodeId start;
    public NodeId end;
}

public struct IsPatternExpression: Copyable {
    public NodeId value;
    public NodeId pattern;
}

public struct CastExpression: Copyable {
    public NodeId value;
    public NodeId type_reference;
}

public struct InlineAsmExpression: Copyable {
    public NodeId result_type;
    public symbol.SymbolId code;
    public Range operands;
    public Range clobbers;
    public Options options;

    public enum Operand: Copyable {
        input(Input),
        output(Output),
    }

    public struct Input: Copyable {
        public Name name;
        public symbol.SymbolId constraint;
        public NodeId value;
    }

    public struct Output: Copyable {
        public Name name;
        public symbol.SymbolId constraint;
        public NodeId? type_reference;
    }

    public struct Clobber: Copyable {
        public symbol.SymbolId name;
    }

    public struct Options: Copyable {
        public Bool volatile;
        public Bool memory;
        public Bool noreturn;

        public init(self, Bool volatile = false, Bool memory = false, Bool noreturn = false) {
            self.volatile = volatile;
            self.memory = memory;
            self.noreturn = noreturn;
        }
    }
}

public struct BlockExpression: Copyable {
    public Range statements;
    public NodeId? tail_expression;
}

public struct IfExpression: Copyable {
    public NodeId condition;
    public NodeId then_body;
    public NodeId? else_body;
}

public struct LoopExpression: Copyable {
    public NodeId? condition;
    public NodeId? pattern;
    public NodeId? iterable;
    public NodeId body;
}

public struct SwitchExpression: Copyable {
    public NodeId value;
    public Range cases;
}

public struct SwitchCase: Copyable {
    public Range patterns;
    public NodeId body;
}

public struct CatchExpression: Copyable {
    public NodeId value;
    public NodeId catch_clause;
}

public struct CatchClause: Copyable {
    public NodeId? pattern;
    public NodeId body;
}

public enum TypeReference: Copyable {
    infer,
    unit,
    named(NamedTypeReference),
    tuple(TupleTypeReference),
    array(ArrayTypeReference),
    function(FunctionTypeReference),
    layered(LayeredTypeReference),
    errorable(ErrorableTypeReference),
}

public struct NamedTypeReference: Copyable {
    public NodeId path;
    public Range arguments;
}

public struct TupleTypeReference: Copyable {
    public Range elements;
}

public struct ArrayTypeReference: Copyable {
    public NodeId element;
    public ArrayCount count;
    public TypeSentinel sentinel;
}

public struct FunctionTypeReference: Copyable {
    public Range parameters;
    public NodeId result;
}

public struct LayeredTypeReference: Copyable {
    public enum Layer: Copyable {
        optional,
        mutable_type,
        reference,
        owner_pointer,
        raw_pointer,
        slice,
    }

    public Layer layer;
    public NodeId base;
    public TypeSentinel sentinel;
}

public struct ErrorableTypeReference: Copyable {
    public NodeId value_type;
    public NodeId? error_type;
}

public struct PathSegment: Copyable {
    public Name name;
    public Range type_arguments;
}

public enum ArrayCount: Copyable {
    inferred,
    int_literal(IntLiteral),
    const_name(Name),
}

public enum TypeSentinel: Copyable {
    none,
    literal(Literal),
    const_name(Name),
    wildcard,
}

public enum Pattern: Copyable {
    wildcard,
    name(NamePattern),
    literal(LiteralPattern),
    tuple(TuplePattern),
    variant(VariantPattern),
    optional_some(OptionalSomePattern),
}

public struct NamePattern: Copyable {
    public Name name;
    public NodeId? type_pattern;
    public Bool mutable_binding;
    public Bool borrowed_binding;
    public Bool mutable_borrow;
}

public struct LiteralPattern: Copyable {
    public Literal literal;
}

public struct TuplePattern: Copyable {
    public Range elements;
}

public struct VariantPattern: Copyable {
    public NodeId path;
    public Range payloads;
}

public struct OptionalSomePattern: Copyable {
    public NodeId payload;
}

public enum Literal: Copyable {
    int_literal(IntLiteral),
    float_literal(FloatLiteral),
    char_literal(CharLiteral),
    string_literal(StringLiteral),
    bool_literal(BoolLiteral),
    null_literal,
}

public struct IntLiteral: Copyable {
    public symbol.SymbolId symbol;

    public init(self, symbol.SymbolId symbol) {
        self.symbol = symbol;
    }
}

public struct FloatLiteral: Copyable {
    public symbol.SymbolId symbol;

    public init(self, symbol.SymbolId symbol) {
        self.symbol = symbol;
    }
}

public struct CharLiteral: Copyable {
    public symbol.SymbolId symbol;

    public init(self, symbol.SymbolId symbol) {
        self.symbol = symbol;
    }
}

public struct StringLiteral: Copyable {
    public symbol.SymbolId symbol;

    public init(self, symbol.SymbolId symbol) {
        self.symbol = symbol;
    }
}

public struct BoolLiteral: Copyable {
    public Bool value;
}

public struct FieldInitializer: Copyable {
    public Name name;
    public NodeId value;
}

public struct GenericParameter: Copyable {
    public Name name;
    public Bool is_const;
    public NodeId? type_reference;
    public NodeId? type_bound;
}

public enum Constraint: Copyable {
    const_type(ConstConstraint),
    type_bound(TypeBoundConstraint),
    type_equal(TypeEqualConstraint),
    type_not_equal(TypeNotEqualConstraint),
    projection_equal(ProjectionEqualConstraint),
    lifetime(LifetimeConstraint),
}

public struct ConstConstraint: Copyable {
    public NodeId parameter;
    public NodeId type_reference;
}

public struct TypeBoundConstraint: Copyable {
    public NodeId target_type;
    public NodeId bound;
}

public struct TypeEqualConstraint: Copyable {
    public NodeId left;
    public NodeId right;
}

public struct TypeNotEqualConstraint: Copyable {
    public NodeId left;
    public NodeId right;
}

public struct ProjectionEqualConstraint: Copyable {
    public NodeId target_type;
    public NodeId trait_path;
    public Name associated_type;
    public NodeId value;
}

public struct LifetimeConstraint: Copyable {
    public LifetimeName longer;
    public LifetimeName shorter;
}

public enum Attribute: Copyable {
    where_attribute(WhereAttribute),
    life_attribute(LifeAttribute),
    inline_attribute(InlineAttribute),
    naked_attribute(NakedAttribute),
    self_attribute(SelfAttribute),
    link_symbol_attribute(LinkSymbolAttribute),
}

public struct WhereAttribute: Copyable {
    public Range constraints;
}

public struct LifeAttribute: Copyable {
    public Range constraints;
}

public struct InlineAttribute: Copyable {
    public Bool always;
}

public struct NakedAttribute: Copyable {
}

public struct LinkSymbolAttribute: Copyable {
    public symbol.SymbolId? symbol;
}

public struct SelfAttribute: Copyable {
    public enum ReceiverMode: Copyable {
        ref_receiver,
        move_receiver,
        mutable_ref_receiver,
    }

    public ReceiverMode mode;
}

public enum LifetimeName: Copyable {
    named(Name),
    self_lifetime,
    return_lifetime,
}
