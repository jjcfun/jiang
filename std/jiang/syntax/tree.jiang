// Public Jiang syntax tree for lang providers.
//
// This tree is the construction target for DSL parsers. It describes syntax
// that Jiang can parse and type-check, not HIR, MIR, backend IR, or a
// language-neutral tree.

import source = "source.jiang";

public struct NodeId: Equatable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public static Bool equal(NodeId& lhs, NodeId& rhs) {
        return lhs.index == rhs.index;
    }
}

public struct NodeRange {
    public Int start;
    public Int length;

    public init(Int start = 0, Int length = 0) {
        self.start = start;
        self.length = length;
    }

    public Int end() {
        return self.start + self.length;
    }

    public Bool is_empty() {
        return self.length == 0;
    }
}

public struct Name {
    @life(text > self)
    public UInt8[]& text;
    public Bool escaped;

    public init(UInt8[]& text, Bool escaped = false) {
        self.text = text;
        self.escaped = escaped;
    }
}

public struct Tree {
    public source.Source source;
    @life(nodes > self)
    public Node[]& nodes;
    @life(children > self)
    public NodeId[]& children;
    public NodeId root;

    public init(source.Source source, Node[]& nodes, NodeId[]& children, NodeId root) {
        self.source = source;
        self.nodes = nodes;
        self.children = children;
        self.root = root;
    }

    public Bool is_empty() {
        return self.nodes.length == 0;
    }

    public Node& node(NodeId id) {
        return self.nodes[id.index]$.ref();
    }

    public NodeId child_at(NodeRange range, Int offset) {
        return self.children[range.start + offset];
    }
}

public struct Node {
    public source.Span span;
    public Data data;

    public init(source.Span span, Data data) {
        self.span = span;
        self.data = data$.move();
    }
}

public union Data {
    Root root;
    TopLevelDeclaration top_level_declaration;
    MemberDeclaration member_declaration;
    Item item;
    Member member;
    Path path;
    Statement statement;
    Expression expression;
    TypeReference type_reference;
    Pattern pattern;
    GenericParameter generic_parameter;
    Constraint constraint;
    Attribute attribute;
    PathSegment path_segment;
    FunctionParameter function_parameter;
    FieldDeclarator field_declarator;
    ExternItem extern_item;
    SwitchCase switch_case;
    CatchClause catch_clause;
    CallArgument call_argument;
    FieldInitializer field_initializer;
}

public struct Root {
    public enum Kind {
        file,
        top_level_declaration,
        member_declaration,
        statement,
        expression,
        type_reference,
        pattern,
    }

    public Kind kind;
    public NodeRange nodes;

    public init(Kind kind, NodeRange nodes) {
        self.kind = kind;
        self.nodes = nodes;
    }
}

public union Item {
    ImportDeclaration import_declaration;
    AliasDeclaration alias_declaration;
    NominalDeclaration nominal_declaration;
    FunctionDeclaration function_declaration;
    GlobalDeclaration global_declaration;
    GlobalDestructureDeclaration global_destructure_declaration;
    ExtendDeclaration extend_declaration;
    TraitDeclaration trait_declaration;
    ExternBlock extern_block;
}

public union Member {
    FieldDeclaration field_declaration;
    EnumCase enum_case;
    TypedUnionVariants typed_union_variants;
    FunctionDeclaration function_declaration;
    InitializerDeclaration initializer_declaration;
    DeinitializerDeclaration deinitializer_declaration;
    AssociatedTypeDeclaration associated_type_declaration;
    NominalDeclaration nominal_declaration;
    AliasDeclaration alias_declaration;
}

public struct TopLevelDeclaration {
    public DeclarationModifiers modifiers;
    public NodeRange attributes;
    public NodeId body;
}

public struct DeclarationModifiers {
    public Bool public_flag;
    public Bool extern_flag;
}

public struct MemberDeclaration {
    public MemberModifiers modifiers;
    public NodeRange attributes;
    public NodeId body;
}

public struct MemberModifiers {
    public MemberVisibility visibility;
    public Bool static_flag;
}

public union MemberVisibility {
    () private_visibility;
    PublicAccess public_visibility;

    public enum PublicAccess {
        all,
        get,
    }
}

public struct ImportDeclaration {
    public enum Kind {
        string_path,
        package_name,
    }

    public Kind kind;
    public Bool flatten;
    public NodeId? alias_name;
    public NodeId path;
}

public struct AliasDeclaration {
    public Name name;
    public NodeId? target;
}

public struct NominalDeclaration {
    public enum Kind {
        struct_kind,
        union_kind,
        enum_kind,
    }

    public Kind kind;
    public Name name;
    public NodeRange generic_parameters;
    public NodeId? enum_underlying_type;
    public NodeRange traits;
    public NodeRange members;
}

public struct FunctionDeclaration {
    public Name name;
    public NodeRange generic_parameters;
    public NodeRange parameters;
    public NodeId result_type;
    public NodeId? body;
}

public struct FunctionParameter {
    public Name name;
    public NodeId type_reference;
    public NodeId? default_value;
}

public struct GlobalDeclaration {
    public Name name;
    public NodeId type_reference;
    public Bool is_const;
    public NodeId? initializer;
}

public struct GlobalDestructureDeclaration {
    public NodeRange bindings;
    public NodeId initializer;
}

public struct ExtendDeclaration {
    public NodeId target_type;
    public NodeId? trait_path;
    public NodeRange members;
}

public struct TraitDeclaration {
    public Name name;
    public NodeRange generic_parameters;
    public NodeRange parents;
    public Bool has_body;
    public NodeRange members;
}

public struct FieldDeclaration {
    public NodeId type_reference;
    public NodeRange declarators;
}

public struct FieldDeclarator {
    public Name name;
    public NodeId? default_value;
}

public struct EnumCase {
    public Name name;
    public NodeId? value;
}

public struct TypedUnionVariants {
    public NodeId type_reference;
    public NodeRange names;
}

public struct InitializerDeclaration {
    public Bool failable;
    public Name? name;
    public NodeRange parameters;
    public NodeId body;
}

public struct DeinitializerDeclaration {
    public NodeId body;
}

public struct AssociatedTypeDeclaration {
    public Name name;
    public NodeId? default_type;
    public NodeRange constraints;
}

public struct ExternBlock {
    public NodeRange items;
}

public struct ExternItem {
    public MemberModifiers modifiers;
    public NodeId body;
}

public struct Path {
    public NodeRange segments;
}

public union Statement {
    LetStatement let_statement;
    DestructureStatement destructure_statement;
    AssignmentStatement assignment_statement;
    DeferStatement defer_statement;
    ExpressionStatement expression_statement;
    ControlStatement control_statement;
    GuardStatement guard_statement;
}

public struct LetStatement {
    public NodeId? type_reference;
    public Name name;
    public NodeId? initializer;
    public Bool mutable_binding;
    public Bool borrow_binding;
}

public struct DestructureStatement {
    public NodeRange bindings;
    public NodeId initializer;
}

public struct AssignmentStatement {
    public enum Operator {
        assign,
        plus_assign,
        minus_assign,
        star_assign,
        slash_assign,
        percent_assign,
        amp_assign,
        pipe_assign,
        caret_assign,
        left_shift_assign,
        right_shift_assign,
    }

    public Operator op;
    public NodeId destination;
    public NodeId value;
}

public struct DeferStatement {
    public NodeId body;
}

public struct ExpressionStatement {
    public NodeId expression;
}

public struct ControlStatement {
    public enum Kind {
        return_kind,
        break_kind,
        continue_kind,
        throw_kind,
    }

    public Kind kind;
    public NodeId? value;
}

public struct GuardStatement {
    public NodeId condition;
    public NodeId else_body;
}

public union Expression {
    NameExpression name;
    PathExpression path;
    LiteralExpression literal;
    TupleExpression tuple;
    ArrayExpression array;
    StructLiteralExpression struct_literal;
    CallExpression call;
    MemberExpression member;
    IndexExpression index;
    SliceExpression slice;
    UnaryExpression unary;
    BinaryExpression binary;
    RangeExpression range;
    IsPatternExpression is_pattern;
    CastExpression cast;
    BlockExpression block;
    IfExpression if_expression;
    LoopExpression loop;
    SwitchExpression switch_expression;
    CatchExpression catch_expression;
}

public struct NameExpression {
    public Name name;
}

public struct PathExpression {
    public NodeId path;
}

public struct LiteralExpression {
    public Literal literal;
}

public struct TupleExpression {
    public NodeRange elements;
}

public struct ArrayExpression {
    public NodeRange elements;
}

public struct StructLiteralExpression {
    public NodeId? type_reference;
    public NodeRange type_arguments;
    public NodeRange fields;
}

public struct CallExpression {
    public NodeId callee;
    public NodeRange type_arguments;
    public NodeRange arguments;
}

public struct CallArgument {
    public Name? name;
    public NodeId value;
}

public struct MemberExpression {
    public NodeId base;
    public Name member;
    public Bool optional_chain;
}

public struct IndexExpression {
    public NodeId base;
    public NodeId index;
    public Bool optional_chain;
}

public struct SliceExpression {
    public NodeId base;
    public NodeId? start;
    public NodeId? end;
    public Bool optional_chain;
}

public struct UnaryExpression {
    public enum Operator {
        positive,
        negative,
        bit_not,
        logical_not,
        ref,
        mutable_ref,
        deref,
        move_value,
    }

    public Operator op;
    public NodeId value;
}

public struct BinaryExpression {
    public enum Operator {
        add,
        subtract,
        multiply,
        divide,
        remainder,
        bit_and,
        bit_or,
        bit_xor,
        left_shift,
        right_shift,
        equal,
        not_equal,
        less,
        less_equal,
        greater,
        greater_equal,
        logical_and,
        logical_or,
        coalesce,
    }

    public Operator op;
    public NodeId left;
    public NodeId right;
}

public struct RangeExpression {
    public NodeId start;
    public NodeId end;
}

public struct IsPatternExpression {
    public NodeId value;
    public NodeId pattern;
}

public struct CastExpression {
    public NodeId value;
    public NodeId type_reference;
}

public struct BlockExpression {
    public NodeRange statements;
    public NodeId? tail_expression;
}

public struct IfExpression {
    public NodeId condition;
    public NodeId then_body;
    public NodeId? else_body;
}

public struct LoopExpression {
    public NodeId? condition;
    public NodeId? pattern;
    public NodeId? iterable;
    public NodeId body;
}

public struct SwitchExpression {
    public NodeId value;
    public NodeRange cases;
}

public struct SwitchCase {
    public NodeRange patterns;
    public NodeId body;
}

public struct CatchExpression {
    public NodeId value;
    public NodeId catch_clause;
}

public struct CatchClause {
    public NodeId? pattern;
    public NodeId body;
}

public union TypeReference {
    () infer;
    () unit;
    NamedTypeReference named;
    TupleTypeReference tuple;
    ArrayTypeReference array;
    FunctionTypeReference function;
    LayeredTypeReference layered;
    ErrorableTypeReference errorable;
}

public struct NamedTypeReference {
    public NodeId path;
    public NodeRange arguments;
}

public struct TupleTypeReference {
    public NodeRange elements;
}

public struct ArrayTypeReference {
    public NodeId element;
    public ArrayCount count;
    public TypeSentinel sentinel;
}

public struct FunctionTypeReference {
    public NodeRange parameters;
    public NodeId result;
}

public struct LayeredTypeReference {
    public enum Layer {
        optional,
        mutable_type,
        reference,
        owner_pointer,
        raw_pointer,
        many_pointer,
        slice,
    }

    public Layer layer;
    public NodeId base;
    public TypeSentinel sentinel;
}

public struct ErrorableTypeReference {
    public NodeId value_type;
    public NodeId? error_type;
}

public struct PathSegment {
    public Name name;
    public NodeRange type_arguments;
}

public union ArrayCount {
    () inferred;
    IntLiteral int_literal;
    Name const_name;
}

public union TypeSentinel {
    () none;
    Literal literal;
    Name const_name;
    () wildcard;
}

public union Pattern {
    () wildcard;
    NamePattern name;
    LiteralPattern literal;
    TuplePattern tuple;
    VariantPattern variant;
    OptionalSomePattern optional_some;
}

public struct NamePattern {
    public Name name;
    public Bool mutable_binding;
    public Bool borrowed_binding;
}

public struct LiteralPattern {
    public Literal literal;
}

public struct TuplePattern {
    public NodeRange elements;
}

public struct VariantPattern {
    public NodeId path;
    public NodeRange payloads;
}

public struct OptionalSomePattern {
    public NodeId payload;
}

public union Literal {
    IntLiteral int_literal;
    FloatLiteral float_literal;
    CharLiteral char_literal;
    StringLiteral string_literal;
    BoolLiteral bool_literal;
    () null_literal;
}

public struct IntLiteral {
    @life(text > self)
    public UInt8[]& text;

    public init(UInt8[]& text) {
        self.text = text;
    }
}

public struct FloatLiteral {
    @life(text > self)
    public UInt8[]& text;

    public init(UInt8[]& text) {
        self.text = text;
    }
}

public struct CharLiteral {
    @life(text > self)
    public UInt8[]& text;

    public init(UInt8[]& text) {
        self.text = text;
    }
}

public struct StringLiteral {
    @life(text > self)
    public UInt8[]& text;

    public init(UInt8[]& text) {
        self.text = text;
    }
}

public struct BoolLiteral {
    public Bool value;
}

public struct FieldInitializer {
    public Name name;
    public NodeId value;
}

public struct GenericParameter {
    public Name name;
    public Bool is_const;
    public NodeId? type_reference;
}

public union Constraint {
    TypeBoundConstraint type_bound;
    TypeEqualConstraint type_equal;
    TypeNotEqualConstraint type_not_equal;
    ProjectionEqualConstraint projection_equal;
    LifetimeConstraint lifetime;
}

public struct TypeBoundConstraint {
    public NodeId target_type;
    public NodeId bound;
}

public struct TypeEqualConstraint {
    public NodeId left;
    public NodeId right;
}

public struct TypeNotEqualConstraint {
    public NodeId left;
    public NodeId right;
}

public struct ProjectionEqualConstraint {
    public NodeId target_type;
    public NodeId trait_path;
    public Name associated_type;
    public NodeId value;
}

public struct LifetimeConstraint {
    public LifetimeName longer;
    public LifetimeName shorter;
}

public union Attribute {
    WhereAttribute where_attribute;
    LifeAttribute life_attribute;
    InlineAttribute inline_attribute;
    SelfAttribute self_attribute;
}

public struct WhereAttribute {
    public NodeRange constraints;
}

public struct LifeAttribute {
    public NodeRange constraints;
}

public struct InlineAttribute {
    public Bool always;
}

public struct SelfAttribute {
    public enum ReceiverMode {
        ref_receiver,
        move_receiver,
    }

    public ReceiverMode mode;
}

public union LifetimeName {
    Name named;
    () self_lifetime;
    () return_lifetime;
}
