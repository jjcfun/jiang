import diagnostic = "diagnostic.jiang";
import source = "source.jiang";
import symbol = "symbol.jiang";
import tree = "tree.jiang";
import token = "../lex/token.jiang";

public trait Builder {
    tree.NodeId add_node(self, source.Span span, tree.Data data);

    // Marks the current end of the child list before appending a node's children.
    Int mark_children(self);

    // Appends one child node to the builder's pending child list.
    () add_child(self, tree.NodeId id);

    // Converts children appended after `start` into a stable range for a node.
    tree.Range take_children(self, Int start);

    // Marks the current end of the token list before appending provider-owned tokens.
    Int mark_tokens(self);

    // Appends one provider-owned token to the builder's pending token list.
    () add_token(self, token.Token value);

    // Converts tokens appended after `start` into a stable range for provider parsing.
    tree.Range take_tokens(self, Int start);

    token.Token token_at(self, Int index);

    symbol.SymbolId intern_symbol(self, UInt8[]& text);
    UInt8[]& symbol_text(self, symbol.SymbolId symbol);

    () add_diagnostic(self, diagnostic.Diagnostic value);
    () add_error(self, source.Span span, UInt8[]& code, UInt8[]& message);
}

public alias BuilderAny = Builder.Any;
