public struct SymbolId: Copyable, Hashable, Equatable {
    // Opaque symbol handle. The host/provider owns the symbol table.
    public Int value;

    public init(self, Int value) {
        self.value = value;
    }

    public Int to_index(self) {
        return self.value;
    }

    public () hash<H: Hasher>(self, H&! hasher) {
        hasher.write(Int(self.value));
    }

    public Bool equal(SymbolId& lhs, SymbolId& rhs) {
        return lhs.value == rhs.value;
    }
}
