public struct SymbolId: Hashable, Equatable {
    // Opaque symbol handle. The host/provider owns the symbol table.
    public Int value;

    public init(Int value) {
        self.value = value;
    }

    public Int to_index() {
        return self.value;
    }

    public UInt64 hash() {
        return UInt64(self.value);
    }

    public static Bool equal(SymbolId& lhs, SymbolId& rhs) {
        return lhs.value == rhs.value;
    }
}
